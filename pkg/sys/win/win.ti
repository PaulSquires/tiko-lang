#pragma once
#ifndef TIKO_OS_WINDOWS
#error "sys/win is Windows-only: build for -target windows-x86_64"
#endif

#INCLUDE ONCE "windows.bi"
#include once "win/commctrl.bi"
#include once "win/ole2.bi"
#include once "win/psapi.bi"
#include once "win/shlobj.bi"
#include once "win/shlwapi.bi"
#include once "win/knownfolders.bi"
#include once "win/commdlg.bi"
#include once "win/cderr.bi"
#include once "win/iphlpapi.bi"
#include once "win/secext.bi"
#include once "crt/string.bi"
#include once "crt/wchar.bi"
#include once "win/ShellScalingApi.bi"
#include once "win/windowsx.bi"
#include once "win/DwmApi.bi"
#include once "win/wininet.bi"
#include once "win/unknwnbase.bi"
#include once "win/ocidl.bi"
#include once "win/propvarutil.bi"

' crt/win32/stdio.bi (which windows.bi pulls in) defines stdin, stdout and stderr as
' object-like macros, and macros are case-blind: they would reach every importer and swallow
' members such as std/process's Child.Stdin( ) / Child.Stdout( ). Nothing in sys/win uses them;
' a program that wants crt's FILE pointers calls __acrt_iob_func( ) itself.
#undef stdin
#undef stdout
#undef stderr


#ifndef WBSTR
   #define WBSTR WSTRING PTR
#endif
