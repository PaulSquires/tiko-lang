	HistogramFormatB = 4
	HistogramFormatG = 5
	HistogramFormatR = 6
	HistogramFormatA = 7
end enum

PUBLIC type ColorMap_
	oldColor as Color_
	newColor as Color_
end type
PUBLIC TYPE GpColorMap
	oldColor AS ARGB
	newColor AS ARGB
END TYPE

PUBLIC type ColorMatrix
	m(0 to 4, 0 to 4) AS SINGLE
end type
PUBLIC type GpColorMatrix AS ColorMatrix
' // Use an array (0 TO 4, 0 TO 4) AS SINGLE, and pass @array(0, 0)

