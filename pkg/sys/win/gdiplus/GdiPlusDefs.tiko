' #define __GDIPLUS_INIT_H

PUBLIC type GdiplusStartupInput
	GdiplusVersion as UINT32
	DebugEventCallback as DebugEventProc
	SuppressBackgroundThread as BOOL
	SuppressExternalCodecs as BOOL
end type

PUBLIC type NotificationHookProc as function (byval token as ULONG_PTR PTR) AS GpStatus
PUBLIC type NotificationUnhookProc as sub (byval token as ULONG_PTR)

PUBLIC type GdiplusStartupOutput
	NotificationHook as NotificationHookProc
	NotificationUnhook as NotificationUnhookProc
end type

PUBLIC DECLARE FUNCTION GdiplusStartup (BYVAL token AS ULONG_PTR PTR, BYVAL input AS CONST GdiplusStartupInput PTR, BYVAL output AS GdiplusStartupOutput PTR) AS GpStatus
PUBLIC DECLARE SUB GdiplusShutdown (BYVAL token AS ULONG_PTR)
PUBLIC DECLARE FUNCTION GdiplusNotificationHook (BYVAL token AS ULONG_PTR PTR) AS GpStatus
PUBLIC DECLARE SUB GdiplusNotificationUnhook (BYVAL token AS ULONG_PTR)

'#define __GDIPLUS_MEM_H
PUBLIC DECLARE FUNCTION GdipAlloc (BYVAL size AS size_t) AS ANY PTR
PUBLIC DECLARE SUB GdipFree (BYVAL AS ANY PTR)

' // AdjustableArroCap APIs
PUBLIC DECLARE FUNCTION GdipCreateAdjustableArrowCap (BYVAL height AS SINGLE, BYVAL Width AS SINGLE, BYVAL isFilled AS BOOL, BYVAL cap AS GpAdjustableArrowCap PTR PTR) AS GpStatus
PUBLIC DECLARE FUNCTION GdipSetAdjustableArrowCapHeight (BYVAL cap AS GpAdjustableArrowCap PTR, BYVAL height AS SINGLE) AS GpStatus
PUBLIC DECLARE FUNCTION GdipGetAdjustableArrowCapHeight (BYVAL cap AS GpAdjustableArrowCap PTR, BYVAL height AS SINGLE PTR) AS GpStatus
PUBLIC DECLARE FUNCTION GdipSetAdjustableArrowCapWidth (BYVAL cap AS GpAdjustableArrowCap PTR, BYVAL width AS SINGLE) AS GpStatus
PUBLIC DECLARE FUNCTION GdipGetAdjustableArrowCapWidth (BYVAL cap AS GpAdjustableArrowCap PTR, BYVAL width AS SINGLE PTR) AS GpStatus
PUBLIC DECLARE FUNCTION GdipSetAdjustableArrowCapMiddleInset (BYVAL cap AS GpAdjustableArrowCap PTR, BYVAL middleInset AS SINGLE) AS GpStatus
PUBLIC DECLARE FUNCTION GdipGetAdjustableArrowCapMiddleInset (BYVAL cap AS GpAdjustableArrowCap PTR, BYVAL middleInset AS SINGLE PTR) AS GpStatus
PUBLIC DECLARE FUNCTION GdipSetAdjustableArrowCapFillState (BYVAL cap AS GpAdjustableArrowCap PTR, BYVAL fillState AS BOOL) AS GpStatus
PUBLIC DECLARE FUNCTION GdipGetAdjustableArrowCapFillState (BYVAL cap AS GpAdjustableArrowCap PTR, BYVAL fillState AS BOOL PTR) AS GpStatus

' // Bitmap APIs
PUBLIC DECLARE FUNCTION GdipCreateBitmapFromStream (BYVAL stream AS IStream PTR, BYVAL bmp AS GpBitmap PTR PTR) AS GpStatus
PUBLIC DECLARE FUNCTION GdipCreateBitmapFromFile (BYVAL filename AS CONST WSTRING PTR, BYVAL bmp AS GpBitmap PTR PTR) AS GpStatus
PUBLIC DECLARE FUNCTION GdipCreateBitmapFromStreamICM (BYVAL stream AS IStream PTR, BYVAL bmp AS GpBitmap PTR PTR) AS GpStatus
PUBLIC DECLARE FUNCTION GdipCreateBitmapFromFileICM (BYVAL filename AS CONST WSTRING PTR, BYVAL bmp AS GpBitmap PTR PTR) AS GpStatus
PUBLIC DECLARE FUNCTION GdipCreateBitmapFromScan0 (BYVAL width AS LONG, BYVAL height AS LONG, BYVAL stride AS LONG, _
                 BYVAL format AS PixelFormat, BYVAL scan0 AS BYTE PTR, BYVAL bmp AS GpBitmap PTR PTR) AS GpStatus
PUBLIC DECLARE FUNCTION GdipCreateBitmapFromGraphics (BYVAL width AS LONG, BYVAL height AS LONG, _
                 BYVAL target AS GpGraphics PTR, BYVAL bmp AS GpBitmap PTR PTR) AS GpStatus
PUBLIC DECLARE FUNCTION GdipCreateBitmapFromDirectDrawSurface (BYVAL surface AS IDirectDrawSurface7 PTR, BYVAL bmp AS GpBitmap PTR PTR) AS GpStatus
PUBLIC DECLARE FUNCTION GdipCreateBitmapFromGdiDib (BYVAL gdiBitmapInfo AS CONST BITMAPINFO PTR, _
                 BYVAL gdiBitmapData AS ANY PTR, BYVAL bmp AS GpBitmap PTR PTR) AS GpStatus
PUBLIC DECLARE FUNCTION GdipCreateBitmapFromHBITMAP (BYVAL hbm AS HBITMAP, BYVAL hpal AS HPALETTE, BYVAL bmp AS GpBitmap PTR PTR) AS GpStatus
PUBLIC DECLARE FUNCTION GdipCreateHBITMAPFromBitmap (BYVAL bmp AS GpBitmap PTR, BYVAL hbmReturn AS HBITMAP PTR, BYVAL background AS ARGB) AS GpStatus
PUBLIC DECLARE FUNCTION GdipCreateBitmapFromHICON (BYVAL hicon AS HICON, BYVAL bmp AS GpBitmap PTR PTR) AS GpStatus
PUBLIC DECLARE FUNCTION GdipCreateHICONFromBitmap (BYVAL bmp AS GpBitmap PTR, BYVAL hbmReturn AS HICON PTR) AS GpStatus
PUBLIC DECLARE FUNCTION GdipCreateBitmapFromResource (BYVAL hInst AS HINSTANCE, BYVAL lpBitmapName AS CONST WSTRING PTR, BYVAL bmp AS GpBitmap PTR PTR) AS GpStatus
PUBLIC DECLARE FUNCTION GdipCloneBitmapArea (BYVAL x AS SINGLE, BYVAL y AS SINGLE, BYVAL width AS SINGLE, BYVAL height AS SINGLE, _
                 BYVAL format AS PixelFormat, BYVAL srcBitmap AS GpBitmap PTR, BYVAL dstBitmap AS GpBitmap PTR PTR) AS GpStatus
PUBLIC DECLARE FUNCTION GdipCloneBitmapAreaI (BYVAL x AS LONG, BYVAL y AS LONG, BYVAL width AS LONG, BYVAL height AS LONG, _
                 BYVAL format AS PixelFormat, BYVAL srcBitmap AS GpBitmap PTR, BYVAL dstBitmap AS GpBitmap PTR PTR) AS GpStatus
PUBLIC DECLARE FUNCTION GdipBitmapLockBits (BYVAL bmp AS GpBitmap PTR, BYVAL rc AS CONST GpRect PTR, BYVAL flags AS UINT, _
                 BYVAL format AS PixelFormat, BYVAL lockedBitmapData AS BitmapData PTR) AS GpStatus
PUBLIC DECLARE FUNCTION GdipBitmapUnlockBits (BYVAL bmp AS GpBitmap PTR, BYVAL lockedBitmapData AS BitmapData PTR) AS GpStatus
PUBLIC DECLARE FUNCTION GdipBitmapGetPixel (BYVAL bmp AS GpBitmap PTR, BYVAL x AS LONG, BYVAL y AS LONG, BYVAL color AS ARGB PTR) AS GpStatus
PUBLIC DECLARE FUNCTION GdipBitmapSetPixel (BYVAL bmp AS GpBitmap PTR, BYVAL x AS LONG, BYVAL y AS LONG, BYVAL color AS ARGB) AS GpStatus
