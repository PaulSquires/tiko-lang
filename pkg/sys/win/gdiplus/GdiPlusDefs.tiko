#module "gdiplus"
#include once "gdiplus.ti"

extern "Windows" LIB "gdiplus.dll"

PUBLIC TYPE GraphicsContainer AS DWORD
PUBLIC TYPE GraphicsState AS DWORD
PUBLIC CONST FlatnessDefault = CAST(SINGLE, 0.25f)

PUBLIC FUNCTION ObjectTypeIsValid (BYVAL type_ as ObjectType) AS BOOLEAN
   FUNCTION = -((type_ >= ObjectTypeMin) AND (type_ <= ObjectTypeMax))
END FUNCTION

PUBLIC type DebugEventProc as any ptr
PUBLIC type EnumerateMetafileProc as function (BYVAL AS EmfPlusRecordType, BYVAL AS UINT, BYVAL AS UINT, BYVAL AS const UBYTE PTR, BYVAL AS any PTR) as BOOL
PUBLIC type DrawImageAbort as any ptr
PUBLIC type GetThumbnailImageAbort as any ptr

