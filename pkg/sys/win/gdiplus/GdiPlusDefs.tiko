' #define __GDIPLUS_EFFECTS_H

PUBLIC type CurveAdjustments as long
PUBLIC enum
	AdjustExposure = 0
	AdjustDensity = 1
	AdjustContrast = 2
	AdjustHighlight = 3
	AdjustShadow = 4
	AdjustMidtone = 5
	AdjustWhiteSaturation = 6
	AdjustBlackSaturation = 7
end enum

PUBLIC type CurveChannel as long
PUBLIC enum
	CurveChannelAll = 0
	CurveChannelRed = 1
	CurveChannelGreen = 2
	CurveChannelBlue = 3
end enum

PUBLIC type BlurParams
	radius AS SINGLE
	expandEdge as BOOL
end type

PUBLIC type BrightnessContrastParams
	brightnessLevel AS LONG
	contrastLevel AS LONG
end type

PUBLIC type ColorBalanceParams
	cyanRed AS LONG
	magentaGreen AS LONG
	yellowBlue AS LONG
end type

PUBLIC type ColorCurveParams
	adjustment as CurveAdjustments
	channel as CurveChannel
	adjustValue AS LONG
end type

PUBLIC type ColorLUTParams
	lutB(0 TO 255) AS BYTE
	lutG(0 TO 255) AS BYTE
	lutR(0 TO 255) AS BYTE
	lutA(0 TO 255) AS BYTE
end type

PUBLIC type HueSaturationLightnessParams
	hueLevel AS LONG
	saturationLevel AS LONG
	lightnessLevel AS LONG
end type

PUBLIC type LevelsParams
	highlight AS LONG
	midtone AS LONG
	shadow AS LONG
end type

PUBLIC type RedEyeCorrectionParams
	numberOfAreas as UINT
	areas as RECT ptr
end type

PUBLIC type SharpenParams
	radius AS SINGLE
	amount AS SINGLE
end type

PUBLIC type TintParams
	hue AS LONG
	amount AS LONG
end type

