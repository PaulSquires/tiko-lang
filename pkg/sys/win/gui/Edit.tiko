#module "gui"
#include once "gui.ti"

#include once "windows.bi"
#include once "win/commctrl.bi"
#include once "win/uxtheme.bi"

NAMESPACE Edit
' ========================================================================================
' * Scales an horizontal coordinate according the DPI (dots per pixel) being used by the desktop.
' ========================================================================================
PUBLIC FUNCTION Scale (BYVAL cx AS SINGLE) AS SINGLE
   DIM hDC AS HDC = GetDC(HWND_DESKTOP)
   FUNCTION = cx * (GetDeviceCaps(hDC, LOGPIXELSX) / 96)
   ReleaseDC HWND_DESKTOP, hDC
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Determines whether there are any actions in an edit control's undo queue. You can send
' this message to either an edit control or a rich edit control.
' ========================================================================================
PUBLIC FUNCTION CanUndo (BYVAL hEdit AS HWND) AS BOOLEAN
   RETURN SendMessageW(hEdit, EM_CANUNDO, 0, 0)
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Gets information about the character closest to a specified point in the client area of
' an edit control. You can send this message to either an edit control or a rich edit control.
' Return value: The LOWORD specifies the zero-based index of the character nearest the
' specified point. This index is relative to the beginning of the control, not the beginning
' of the line. If the specified point is beyond the last character in the edit control, the
' return value indicates the last character in the control. The HIWORD specifies the
' zero-based index of the line that contains the character. For single-line edit controls,
' this value is zero. The index indicates the line delimiter if the specified point is
' beyond the last visible character in a line.
' ========================================================================================
PUBLIC FUNCTION CharFromPos (BYVAL hEdit AS HWND, BYVAL x AS SHORT, BYVAL y AS SHORT) AS DWORD
   RETURN SendMessageW(hEdit, EM_CHARFROMPOS, 0, cast(LPARAM, MAKELONG(x, y)))
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Deletes (clears) the current selection, if any, from the edit control.
' ========================================================================================
PUBLIC SUB Clear (BYVAL hEdit AS HWND)
   SendMessageW(hEdit, WM_CLEAR, 0, 0)
END SUB
' ========================================================================================

' ========================================================================================
' * Copies the current selection to the clipboard in CF_TEXT format.
' ========================================================================================
PUBLIC SUB Copy (BYVAL hEdit AS HWND)
   SendMessageW(hEdit, WM_COPY, 0, 0)
END SUB
' ========================================================================================

' ========================================================================================
' * Deletes (cuts) the current selection, if any, in the edit control and copy the deleted
' text to the clipboard in CF_TEXT format.
' ========================================================================================
PUBLIC SUB Cut (BYVAL hEdit AS HWND)
   SendMessageW(hEdit, WM_CUT, 0, 0)
END SUB
' ========================================================================================

' ========================================================================================
' * Resets the undo flag of an edit control. The undo flag is set whenever an operation
' within the edit control can be undone.
' ========================================================================================
PUBLIC SUB EmptyUndoBuffer (BYVAL hEdit AS HWND)
   SendMessageW hEdit, EM_EMPTYUNDOBUFFER, 0, 0
END SUB
' ========================================================================================

' ========================================================================================
' * Enables the control.
' Return value: False if the control was previous enabled; otherwise TRUE
' ========================================================================================
PUBLIC FUNCTION Enable (BYVAL hEdit AS HWND) AS BOOLEAN
   RETURN EnableWindow(hEdit, CTRUE)
END FUNCTION
' ========================================================================================
' ========================================================================================
' * Disables the control.
' Return value: False if the control was previous disabled; otherwise TRUE
' ========================================================================================
PUBLIC FUNCTION Disable (BYVAL hEdit AS HWND) AS BOOLEAN
   DIM res AS LONG = EnableWindow(hEdit, FALSE)
   DIM bEnable AS BOOLEAN
   IF res = 0 THEN bEnable = TRUE ELSE bEnable = FALSE
   RETURN bEnable
END FUNCTION
' ========================================================================================

' ========================================================================================
' Sets a flag that determines whether a multiline edit control includes soft line-break
' characters. A soft line break consists of two carriage returns and a line feed and is
' inserted at the end of a line that is broken because of wordwrapping.
' ========================================================================================
PUBLIC FUNCTION FmtLines (BYVAL hEdit AS HWND, BYVAL AddEolFlag AS BOOLEAN) AS BOOLEAN
   SendMessageW(hEdit, EM_FMTLINES, CAST(WPARAM, AddEolFlag), 0)
   RETURN AddEolFlag
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Gets the text that is displayed as the textual cue, or tip, in an edit control.
' To use this method, you must provide a manifest specifying Comctl32.dll version 6.0.
' ========================================================================================
PUBLIC FUNCTION GetCueBannerText OVERLOAD (BYVAL hEdit AS HWND, BYVAL pwszText AS WSTRING PTR, BYVAL cchText AS DWORD) AS BOOLEAN
   RETURN SendMessageW(hEdit, EM_GETCUEBANNER, cast(WPARAM, pwszText), cchText)
END FUNCTION
' ========================================================================================
' ========================================================================================
PUBLIC FUNCTION GetCueBannerText OVERLOAD (BYVAL hEdit AS HWND, BYVAL cchText AS DWORD) AS USTRING
   DIM ustrText AS USTRING = WSPACE(cchText + 1)
   SetLastError(SendMessageW(hEdit, EM_GETCUEBANNER, cast(WPARAM, STRPTR(ustrText)), LEN(ustrText)))
   RETURN ustrText
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Gets the zero-based index of the uppermost visible line in a multiline edit control.
' ========================================================================================
PUBLIC FUNCTION GetFirstVisibleLine (BYVAL hEdit AS HWND) AS LONG
   RETURN SendMessageW(hEdit, EM_GETFIRSTVISIBLELINE, 0, 0)
END FUNCTION
' ========================================================================================

' ========================================================================================
' Gets a handle of the memory currently allocated for a multiline edit control's text.
' ========================================================================================
PUBLIC FUNCTION GetHandle (BYVAL hEdit AS HWND) AS ..HLOCAL
   RETURN CAST(..HLOCAL, SendMessageW(hEdit, EM_GETHANDLE, 0, 0))
END FUNCTION
' ========================================================================================

' ========================================================================================
' Not implemented.
' ========================================================================================
'PRIVATE FUNCTION tkEdit_GetHilite (BYVAL hEdit AS HWND) AS LONG
'   RETURN SendMessageW(hEdit, EM_GETHILITE, 0, 0)
'END FUNCTION
' ========================================================================================

' ========================================================================================
' Retrieves a set of status flags that indicate how the edit control interacts with the
' Input Method Editor (IME).
' ========================================================================================
PUBLIC FUNCTION GetIMEStatus (BYVAL hEdit AS HWND, BYVAL nStatusType AS LONG) AS LONG
   RETURN SendMessageW(hEdit, EM_GETIMESTATUS, cast(WPARAM, nStatusType), 0)
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Gets the current text limit for an edit control. The return value is the text limit.
' ========================================================================================
PUBLIC FUNCTION GetLimitText (BYVAL hEdit AS HWND) AS DWORD
   RETURN SendMessageW(hEdit, EM_GETLIMITTEXT, 0, 0)
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Copies a line of text from an edit control.
' ========================================================================================
PUBLIC FUNCTION GetLine (BYVAL hEdit AS HWND, BYVAL which AS DWORD) AS USTRING
   DIM buffer AS USTRING
   buffer = MKI(32765) + WSTRING(32765, 0)
   DIM nLen AS LONG = SendMessageW(hEdit, EM_GETLINE, which, CAST(LPARAM, STRPTR(buffer)))
   IF nLen = 0 THEN RETURN ""
   RETURN LEFT(buffer, nLen)
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Gets the number of lines in a multiline edit control.
' ========================================================================================
PUBLIC FUNCTION GetLineCount (BYVAL hEdit AS HWND) AS LONG
   RETURN SendMessageW(hEdit, EM_GETLINECOUNT, 0, 0)
END FUNCTION
' ========================================================================================

' ========================================================================================
' Returns the width of the left margin in the LOWORD, and the width of the right margin in the HIWORD.
'' ========================================================================================
'PUBLIC FUNCTION Edit.GetMargins (BYVAL hEdit AS HWND) AS DWORD
'   RETURN SendMessageW(hEdit, EM_GETMARGINS, 0, 0)
'END FUNCTION
'' ========================================================================================
' Usage example:
' var(l, r) = Edit.GetMargins(hEdit)
' print l, r
' ========================================================================================
PUBLIC FUNCTION GetMargins (BYVAL hEdit AS HWND) AS (WORD, WORD)
   DIM margins AS DWORD = SendMessageW(hEdit, EM_GETMARGINS, 0, 0)
   RETURN (LOWORD(margins), HIWORD(margins))
END FUNCTION
' ========================================================================================

' ========================================================================================
' Returns the width of the left margin for an edit control.
' ========================================================================================
PUBLIC FUNCTION GetLeftMargin (BYVAL hEdit AS HWND) AS WORD
   RETURN LOWORD(SendMessageW(hEdit, EM_GETMARGINS, 0, 0))
END FUNCTION
' ========================================================================================

' ========================================================================================
' Gets the width of the right margin for an edit control.
' ========================================================================================
PUBLIC FUNCTION GetRightMargin (BYVAL hEdit AS HWND) AS WORD
   RETURN HIWORD(SendMessageW(hEdit, EM_GETMARGINS, 0, 0))
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Gets the state of an edit control's modification flag. The flag indicates whether the
' contents of the edit control have been modified.
' ========================================================================================
PUBLIC FUNCTION GetModify (BYVAL hEdit AS HWND) AS BOOLEAN
   RETURN SendMessageW(hEdit, EM_GETMODIFY, 0, 0)
END FUNCTION
' ========================================================================================

' ========================================================================================
' Gets the password character that an edit control displays when the user enters text.
' ========================================================================================
PUBLIC FUNCTION GetPasswordChar (BYVAL hEdit AS HWND) AS LONG
   RETURN SendMessageW(hEdit, EM_GETPASSWORDCHAR, 0, 0)
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Gets the formatting rectangle of an edit control. The formatting rectangle is the
' limiting rectangle into which the control draws the text. The limiting rectangle is
' independent of the size of the edit-control window.
' ========================================================================================
PUBLIC SUB GetRect OVERLOAD (BYVAL hEdit AS HWND, BYREF rc AS RECT)
   SendMessageW hEdit, EM_GETRECT, 0, CAST(LPARAM, @rc)
END SUB
' ========================================================================================
' ========================================================================================
PUBLIC SUB GetRect OVERLOAD (BYVAL hEdit AS HWND, BYVAL prc AS RECT PTR)
   SendMessageW hEdit, EM_GETRECT, 0, CAST(LPARAM, prc)
END SUB
' ========================================================================================
' ========================================================================================
'PUBLIC FUNCTION Edit.GetRect OVERLOAD (BYVAL hEdit AS HWND) AS RECT
'   DIM rc AS RECT
'   SendMessageW hEdit, EM_GETRECT, 0, CAST(LPARAM, @rc)
'   RETURN rc
'END FUNCTION
' ========================================================================================
' ========================================================================================
' Usage example:
' var(l, t, r, b) = Edit.GetRect(hEdit)
' IF GetLastError = 1 THEN PRINT l, t, t, b
' ========================================================================================
PUBLIC FUNCTION GetRect OVERLOAD (BYVAL hEdit AS HWND) AS (LONG, LONG, LONG, LONG)
   DIM rc AS RECT
   SetLastError(SendMessageW(hEdit, EM_GETRECT, 0, CAST(LPARAM, @rc)))
   RETURN (rc.left, rc.top, rc.right, rc.bottom)
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Gets the starting and ending character positions of the current selection in an edit control.
' ========================================================================================
PUBLIC FUNCTION GetSel OVERLOAD (BYVAL hEdit AS HWND, BYREF dwStartPos AS DWORD, BYREF dwEndPos AS DWORD) AS LONG
   RETURN SendMessageW(hEdit, EM_GETSEL, CAST(WPARAM, @dwStartPos), cast(LPARAM, @dwEndPos))
END FUNCTION
' ========================================================================================
' ========================================================================================
PUBLIC FUNCTION GetSel OVERLOAD (BYVAL hEdit AS HWND, BYVAL pdwStartPos AS DWORD PTR, BYVAL pdwEndPos AS DWORD PTR) AS LONG
   RETURN SendMessageW(hEdit, EM_GETSEL, CAST(WPARAM, pdwStartPos), cast(LPARAM, pdwEndPos))
END FUNCTION
' ========================================================================================
' ========================================================================================
PUBLIC FUNCTION GetSel OVERLOAD (BYVAL hEdit AS HWND) AS ..POINTL
   DIM dwStartPos AS DWORD, dwEndPos AS DWORD, pt AS .POINTL
   SetLastError(SendMessageW(hEdit, EM_GETSEL, CAST(WPARAM, @dwStartPos), cast(LPARAM, @dwEndPos)))
   pt.x = dwStartPos : pt.y = dwEndPos
   RETURN pt
END FUNCTION
' ========================================================================================
' ========================================================================================
' * Gets the starting character position of the current selection in an edit control.
' ========================================================================================
PUBLIC FUNCTION GetSelStart (BYVAL hEdit AS HWND) AS DWORD
   DIM dwStartPos AS DWORD, dwEndPos AS DWORD
   SetLastError(SendMessageW(hEdit, EM_GETSEL, CAST(WPARAM, @dwStartPos), cast(LPARAM, @dwEndPos)))
   RETURN dwStartPos
END FUNCTION
' ========================================================================================
' ========================================================================================
' * Gets the ending character position of the current selection in an edit control.
' ========================================================================================
PUBLIC FUNCTION GetSelEnd (BYVAL hEdit AS HWND) AS DWORD
   DIM dwStartPos AS DWORD, dwEndPos AS DWORD
   SetLastError(SendMessageW(hEdit, EM_GETSEL, CAST(WPARAM, @dwStartPos), cast(LPARAM, @dwEndPos)))
   RETURN dwEndPos
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Retrieves the text length from an edit control.
' ========================================================================================
PUBLIC FUNCTION GetTextLength (BYVAL hEdit AS HWND) AS LONG
   RETURN GetWindowTextLengthW(hEdit)
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Retrieves the text in a button control.
' ========================================================================================
PUBLIC FUNCTION GetText (BYVAL hEdit AS HWND) AS USTRING
   DIM nLen AS LONG = GetWindowTextLengthW(hEdit)
   DIM ustrText AS USTRING = WSPACE(nLen + 1)
   SetLastError(GetWindowTextW(hEdit, ustrText, nLen +  1))
   RETURN ustrText
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Gets the position of the scroll box (thumb) in the vertical scroll bar of a multiline
' edit control. Note: With multiline edit controls always returns 0, so we are using
' GetScrollPos as an alternative.
' ========================================================================================
PUBLIC FUNCTION GetThumb (BYVAL hEdit AS HWND) AS LONG
'   RETURN SendMessageW(hEdit, EM_GETTHUMB, 0, 0)
   RETURN GetScrollPos(hEdit, SB_VERT)
END FUNCTION
' ========================================================================================

' ========================================================================================
' Gets the address of the currently registered word-break procedure.
' ========================================================================================
PUBLIC FUNCTION GetWordBreakProc (BYVAL hEdit AS HWND) AS LONG_PTR
   RETURN SendMessageW(hEdit, EM_GETWORDBREAKPROC, 0, 0)
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Hides any balloon tip associated with an edit control.
' ========================================================================================
PUBLIC FUNCTION HideBalloonTip (BYVAL hEdit AS HWND) AS BOOLEAN
   RETURN SendMessageW(hEdit, EM_HIDEBALLOONTIP, 0, 0)
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Sets the text limit of an edit control. The text limit is the maximum amount of text, in
' bytes, that the user can type into the edit control.
' ========================================================================================
PUBLIC SUB LimitText (BYVAL hEdit AS HWND, BYVAL chMax AS DWORD)
   SendMessageW hEdit, EM_LIMITTEXT, chMax, 0
END SUB
' ========================================================================================

' ========================================================================================
' Gets the index of the line that contains the specified character index in a multiline
' edit control. A character index is the zero-based index of the character from the
' beginning of the edit control.
' ========================================================================================
PUBLIC FUNCTION LineFromChar (BYVAL hEdit AS HWND, BYVAL index AS LONG) AS LONG
   RETURN SendMessageW(hEdit, EM_LINEFROMCHAR, index, 0)
END FUNCTION
' ========================================================================================

' ========================================================================================
' Gets the character index of the first character of a specified line in a multiline edit control. 
' ========================================================================================
PUBLIC FUNCTION LineIndex (BYVAL hEdit AS HWND, BYVAL nLine AS LONG) AS LONG
   RETURN SendMessageW(hEdit, EM_LINEINDEX, nLine, 0)
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Retrieves the length, in characters, of a line in an edit control.
' ========================================================================================
PUBLIC FUNCTION LineLength (BYVAL hEdit AS HWND, BYVAL index AS LONG) AS LONG
   RETURN SendMessageW(hEdit, EM_LINELENGTH, index, 0)
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Scrolls the text in a multiline edit control.
' If the message is sent to a multiline edit control, the return value is TRUE.
' If the message is sent to a single-line edit control, the return value is FALSE.
' ========================================================================================
PUBLIC FUNCTION LineScroll (BYVAL hEdit AS HWND, BYVAL x AS LONG, BYVAL y AS LONG) AS BOOLEAN
   RETURN SendMessageW(hEdit, EM_LINESCROLL, cast(WPARAM, x), cast(LPARAM, y))
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Copies the current content of the clipboard to the edit control at the current caret
' position. Data is inserted only if the clipboard contains data in CF_TEXT format.
' ========================================================================================
PUBLIC SUB Paste (BYVAL hEdit AS HWND)
   SendMessageW(hEdit, WM_PASTE, 0, 0)
END SUB
' ========================================================================================

' ========================================================================================
' Retrieves the client area coordinates of a specified character in an edit control.
' The return value contains the client area coordinates of the character. The LOWORD
' contains the horizontal coordinate and the HIWORD contains the vertical coordinate.
' ========================================================================================
PUBLIC FUNCTION PosFromChar (BYVAL hEdit AS HWND, BYVAL index AS LONG) AS LONG
   RETURN SendMessageW(hEdit, EM_POSFROMCHAR, cast(WPARAM, index), 0)
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Replaces the current selection in an edit control with the specified text.
' ========================================================================================
PUBLIC SUB ReplaceSel (BYVAL hEdit AS HWND, BYVAL bCanBeUndone AS BOOLEAN, BYVAL pwszText AS WSTRING PTR)
   SendMessageW hEdit, EM_REPLACESEL, CAST(WPARAM, bCanBeUndone), CAST(LPARAM, pwszText)
END SUB
' ========================================================================================

' ========================================================================================
' * Scrolls the text vertically in a multiline edit control.
' ========================================================================================
PUBLIC FUNCTION Scroll (BYVAL hEdit AS HWND, BYVAL nAction AS LONG) AS DWORD
   RETURN SendMessageW(hEdit, EM_SCROLL, nAction, 0)
END FUNCTION
' ========================================================================================

' ========================================================================================
' Scrolls the caret into view in an edit control.
' ========================================================================================
PUBLIC SUB ScrollCaret (BYVAL hEdit AS HWND)
   SendMessageW hEdit, EM_SCROLLCARET, 0, 0
END SUB
' ========================================================================================

' ========================================================================================
' * Sets the text that is displayed as the textual cue, or tip, for an edit control.
' - pwszText: A pointer to a Unicode string that contains the text to display as the textual cue.
' - bDrawFocused: TRUE if the cue banner should show even when the edit control has focus;
'   otherwise, FALSE. FALSE is the default behavior—the cue banner disappears when the user
'   clicks in the control.
' If the message succeeds, it returns TRUE. Otherwise it returns FALSE.
' ========================================================================================
PUBLIC FUNCTION SetCueBannerText (BYVAL hEdit AS HWND, BYVAL pwszText AS WSTRING PTR, BYVAL fDrawFocused AS BOOLEAN = FALSE) AS LONG
   RETURN SendMessageW(hEdit, EM_SETCUEBANNER, fDrawFocused, cast(LPARAM, pwszText))
END FUNCTION
' ========================================================================================

' ========================================================================================
' Sets the handle of the memory that will be used by a multiline edit control.
' ========================================================================================
PUBLIC SUB SetHandle (BYVAL hEdit AS HWND, BYVAL hLocal AS ..HLOCAL)
   SendMessageW hEdit, EM_SETHANDLE, cast(WPARAM, hLocal), 0
END SUB
' ========================================================================================

' ========================================================================================
' Not implemented.
' ========================================================================================
'PRIVATE FUNCTION tkEdit_SetHilite (BYVAL hEdit AS HWND, BYVAL ichStart AS LONG, BYVAL ichEnd AS LONG) AS LONG
'   RETURN SendMessageW(hEdit, EM_SETHILITE, ichStart, ichEnd)
'END FUNCTION
' ========================================================================================

' ========================================================================================
' Sets the status flags that determine how an edit control interacts with the Input Method
' Editor (IME).
' - nStatusType: The type of status to set. This parameter can be EMSIS_COMPOSITIONSTRING.
' - flags: Data specific to the status type. If wParam is EMSIS_COMPOSITIONSTRING, this
'   parameter can be one or more of the following values: EIMES_GETCOMPSTRATONCE,
'   EIMES_CANCELCOMPSTRINFOCUS, EIMES_COMPLETECOMPSTRKILLFOCUS.
' Returns the previous value of the flags parameter.
' ========================================================================================
PUBLIC FUNCTION SetIMEStatus (BYVAL hEdit AS HWND, BYVAL nStatusType AS LONG, BYVAL flags AS DWORD) AS DWORD
   RETURN SendMessageW(hEdit, EM_SETIMESTATUS, cast(WPARAM, nStatusType), cast(LPARAM, flags))
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Sets the text limit of an edit control. The text limit is the maximum amount of text, in
' TCHARs, that the user can type into the edit control.
' ========================================================================================
PUBLIC SUB SetLimitText (BYVAL hEdit AS HWND, BYVAL chMax AS DWORD)
   SendMessageW hEdit, EM_LIMITTEXT, chMax, 0
END SUB
' ========================================================================================

' ========================================================================================
' * Sets the widths of the left and right margins for an edit control. The message redraws
' the control to reflect the new margins.
' - leftMarginWidth : The with of the left margin, in pixels
' - rightMarginWidth : The with of the left margin, in pixels
' Usage example:
' Edit.SetMargins(hEdit1, Edit.Scale(30), Edit.Scale(100))
' ========================================================================================
PUBLIC SUB SetMargins (BYVAL hEdit AS HWND, BYVAL leftMarginWidth AS LONG, BYVAL rightMarginWidth AS LONG)
   SendMessageW(hEdit, EM_SETMARGINS, EC_LEFTMARGIN OR EC_RIGHTMARGIN, MAKELONG(leftMarginWidth, rightMarginWidth))
END SUB
' ========================================================================================
' Sets the margins scaled according the DPI (dots per pixel) being used by the desktop.
' Usage example:
' Edit.SetMargins(hEdit1, 30, 100)
' ========================================================================================
PUBLIC SUB SetMarginsForDpi (BYVAL hEdit AS HWND, BYVAL leftMarginWidth AS LONG, BYVAL rightMarginWidth AS LONG)
   SendMessageW(hEdit, EM_SETMARGINS, EC_LEFTMARGIN OR EC_RIGHTMARGIN, MAKELONG(Edit.Scale(leftMarginWidth), Edit.Scale(rightMarginWidth)))
END SUB
' ========================================================================================

' ========================================================================================
' * Sets the width of the left margin for an edit control. The message redraws the control
' to reflect the new margin.
' ========================================================================================
PUBLIC SUB SetLeftMargin (BYVAL hEdit AS HWND, BYVAL nWidth AS WORD)
   SendMessageW(hEdit, EM_SETMARGINS, EC_LEFTMARGIN, MAKELONG(nWidth, 0))
END SUB
' ========================================================================================
' ========================================================================================
' * Sets the width of the right margin for an edit control. The message redraws the control
' to reflect the new margin.
' ========================================================================================
PUBLIC SUB SetRightMargin (BYVAL hEdit AS HWND, BYVAL nWidth AS WORD)
   SendMessageW(hEdit, EM_SETMARGINS, EC_RIGHTMARGIN, MAKELONG(0, nWidth))
END SUB
' ========================================================================================

' ========================================================================================
' * Sets or clears the modification flag for an edit control. The modification flag
' indicates whether the text within the edit control has been modified.
' ========================================================================================
PUBLIC SUB SetModify (BYVAL hEdit AS HWND, BYVAL fModify AS BOOLEAN)
   SendMessageW hEdit, EM_SETMODIFY, cast(WPARAM, fModify), 0
END SUB
' ========================================================================================

' ========================================================================================
' Sets or removes the password character for an edit control. When a password character is
' set, that character is displayed in place of the characters typed by the user.
' ========================================================================================
PUBLIC SUB SetPasswordChar (BYVAL hEdit AS HWND, BYVAL dwchar AS DWORD)
   SendMessageW hEdit, EM_SETPASSWORDCHAR, dwchar, 0
END SUB
' ========================================================================================

' ========================================================================================
' * Sets or removes the read-only style (ES_READONLY) of an edit control.
' ========================================================================================
PUBLIC FUNCTION SetReadOnly (BYVAL hEdit AS HWND, BYVAL fReadOnly AS BOOLEAN) AS LONG
   RETURN SendMessageW(hEdit, EM_SETREADONLY, cast(WPARAM, fReadOnly), 0)
END FUNCTION
' ========================================================================================

' ========================================================================================
' Sets the formatting rectangle of a multiline edit control. The formatting rectangle is
' the limiting rectangle into which the control draws the text. The limiting rectangle is
' independent of the size of the edit control window. This message is processed only by
' multiline edit controls.
' ========================================================================================
PUBLIC SUB SetRect OVERLOAD (BYVAL hEdit AS HWND, BYREF rc AS RECT)
   SendMessageW hEdit, EM_SETRECT, 0, cast(LPARAM, @rc)
END SUB
' ========================================================================================
' ========================================================================================
PUBLIC SUB SetRect OVERLOAD (BYVAL hEdit AS HWND, BYVAL prc AS RECT PTR)
   SendMessageW hEdit, EM_SETRECT, 0, cast(LPARAM, prc)
END SUB
' ========================================================================================
' ========================================================================================
PUBLIC SUB SetRect OVERLOAD (BYVAL hEdit AS HWND, BYVAL nLeft AS LONG, BYVAL nTop AS LONG, BYVAL nRight AS LONG, BYVAL nBottom AS LONG)
   DIM rc AS RECT = (nLeft, nTop, nRight, nBottom)
   SendMessageW hEdit, EM_SETRECT, 0, cast(LPARAM, @rc)
END SUB
' ========================================================================================

' ========================================================================================
' Sets the formatting rectangle of a multiline edit control. The EM_SETRECTNP message is
' identical to the EM_SETRECT message, except that EM_SETRECTNP does not redraw the edit
' control window. The formatting rectangle is the limiting rectangle into which the
' control draws the text. The limiting rectangle is independent of the size of the edit
' control window. This message is processed only by multiline edit controls.
' ========================================================================================
PUBLIC SUB SetRectNoPaint OVERLOAD (BYVAL hEdit AS HWND, BYREF rc AS RECT)
   SendMessageW hEdit, EM_SETRECTNP, 0, CAST(LPARAM, @rc)
END SUB
' ========================================================================================
' ========================================================================================
PUBLIC SUB SetRectNoPaint OVERLOAD (BYVAL hEdit AS HWND, BYVAL prc AS RECT PTR)
   SendMessageW hEdit, EM_SETRECTNP, 0, CAST(LPARAM, prc)
END SUB
' ========================================================================================
' ========================================================================================
PUBLIC SUB SetRectNoPaint OVERLOAD (BYVAL hEdit AS HWND, BYVAL nLeft AS LONG, BYVAL nTop AS LONG, BYVAL nRight AS LONG, BYVAL nBottom AS LONG)
   DIM rc AS RECT = (nLeft, nTop, nRight, nBottom)
   SendMessageW hEdit, EM_SETRECTNP, 0, CAST(LPARAM, @rc)
END SUB
' ========================================================================================

' ========================================================================================
' * Selects a range of characters in an edit control.
' ========================================================================================
PUBLIC SUB SetSel (BYVAL hEdit AS HWND, BYVAL nStart AS LONG, BYVAL nEnd AS LONG)
   SendMessageW hEdit, EM_SETSEL, nStart, nEnd
END SUB
' ========================================================================================

' ========================================================================================
' Sets the tab stops in a multiline edit control. When text is copied to the control, any
' tab character in the text causes space to be generated up to the next tab stop. This
' message is processed only by multiline edit controls.
' ========================================================================================
PUBLIC FUNCTION SetTabStops (BYVAL hEdit AS HWND, BYVAL cTabs AS LONG, BYVAL prgTabStops AS LONG PTR) AS BOOLEAN
   RETURN SendMessageW(hEdit, EM_SETTABSTOPS, cTabs, cast(LPARAM, prgTabStops))
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Sets the text of an edit control.
' ========================================================================================
PUBLIC FUNCTION SetText (BYVAL hEdit AS HWND, BYVAL pwszText AS WSTRING PTR) AS BOOLEAN
   RETURN SetWindowTextW(hEdit, pwszText)
END FUNCTION
' ========================================================================================

' ========================================================================================
' Replaces an edit control's default Wordwrap function with an application-defined
' Wordwrap function.
' ========================================================================================
PUBLIC SUB SetWordBreakProc (BYVAL hEdit AS HWND, BYVAL pfn AS LONG_PTR)
   SendMessageW hEdit, EM_SETWORDBREAKPROC, 0, pfn
END SUB
' ========================================================================================

' ========================================================================================
' * Displays a balloon tip associated with an edit control.
' Can be used, for example, to display warning or error messages like "Invalud input",
' instead of a message box.
' ========================================================================================
PUBLIC FUNCTION ShowBalloonTip OVERLOAD (BYVAL hEdit AS HWND, BYVAL peditballoontip AS EDITBALLOONTIP PTR) AS BOOLEAN
   IF peditballoontip = NULL THEN RETURN FALSE
   peditballoontip->cbStruct = SIZEOF(EDITBALLOONTIP)
   RETURN SendMessageW(hEdit, EM_SHOWBALLOONTIP, 0, cast(LPARAM, peditballoontip))
END FUNCTION
' ========================================================================================
' ========================================================================================
PUBLIC FUNCTION ShowBalloonTip OVERLOAD (BYVAL hEdit AS HWND, BYREF edittip AS EDITBALLOONTIP) AS BOOLEAN
   IF VARPTR(edittip) = NULL THEN RETURN FALSE
   edittip.cbStruct = SIZEOF(EDITBALLOONTIP)
   RETURN SendMessageW(hEdit, EM_SHOWBALLOONTIP, 0, cast(LPARAM, @edittip))
END FUNCTION
' ========================================================================================
' ========================================================================================
PUBLIC FUNCTION ShowBalloonTip OVERLOAD (BYVAL hEdit AS HWND, BYVAL pwszTitle AS WSTRING PTR, BYVAL pwszText AS WSTRING PTR, BYVAL iIcon AS LONG) AS BOOLEAN
   DIM bt AS EDITBALLOONTIP
   bt.cbStruct = SIZEOF(EDITBALLOONTIP)
   bt.pszTitle = pwszTitle
   bt.pszText = pwszText
   bt.ttiIcon = iIcon
   RETURN SendMessageW(hEdit, EM_SHOWBALLOONTIP, 0, cast(LPARAM, @bt))
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Undoes the last edit control operation in the control's undo queue.
' ========================================================================================
PUBLIC FUNCTION Undo (BYVAL hEdit AS HWND) AS BOOLEAN
   RETURN SendMessageW(hEdit, EM_UNDO, 0, 0)
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Sets the zoom ratio anywhere between 1/64 and 64.
' Only works with multiline edit controls.
' Example:
'   Edit.SetZoomable(hEditMulti)
'   Edit.SetZoom(hEditMulti, 150, 100)
' ========================================================================================
PUBLIC FUNCTION SetZoom (BYVAL hEdit AS HWND, BYVAL zNum AS DWORD, BYVAL zDen AS DWORD) AS BOOLEAN
   RETURN SendMessageW(hEdit, EM_SETZOOM, zNum, zDen)
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Makes a multiline edit control zoomable.
' ========================================================================================
PUBLIC FUNCTION SetZoomable (BYVAL hEdit AS HWND) AS HRESULT
   RETURN SendMessageW(hEdit, EM_SETEXTENDEDSTYLE, ES_EX_ZOOMABLE, ES_EX_ZOOMABLE)
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Sets the edit control dark mode.
' Only affects the scroll bars of a multiline edit control.
' ========================================================================================
PUBLIC FUNCTION SetDarkMode (BYVAL hEdit AS HWND) AS HRESULT
   RETURN SetWindowTheme(hEdit, "DarkMode_Explorer", NULL)
END FUNCTION
' ========================================================================================
' ========================================================================================
' * Remove the edit control dark mode.
' Only affects the scroll bars of a multiline edit control.
' ========================================================================================
PUBLIC FUNCTION RemoveDarkMode (BYVAL hEdit AS HWND) AS HRESULT
   RETURN SetWindowTheme(hEdit, NULL, NULL)
END FUNCTION
' ========================================================================================

' *** Updates for Windows 10 ***

' ========================================================================================
' * Sets the extended style.
' Example: Set a multi edit control zoomable
' Edit.SetExtendedStyle(hEditMulti, ES_EX_ZOOMABLE, ES_EX_ZOOMABLE)
' ========================================================================================
PUBLIC FUNCTION SetExtendedStyle (BYVAL hEdit AS HWND, BYVAL dwExStyle AS DWORD, BYVAL dwMask AS DWORD) AS HRESULT
   RETURN SendMessageW(hEdit, EM_SETEXTENDEDSTYLE, dwMask, dwExStyle)
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Gets the extended style.
' ========================================================================================
PUBLIC FUNCTION GetExtendedStyle (BYVAL hEdit AS HWND) AS DWORD
   RETURN SendMessageW(hEdit, EM_GETEXTENDEDSTYLE, 0, 0)
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Sets the end of line character used for the content of the edit control.
' ========================================================================================
PUBLIC FUNCTION SetEndOfLine (BYVAL hEdit AS HWND, BYVAL eoltype AS EC_ENDOFLINE) AS BOOLEAN
   RETURN SendMessageW(hEdit, EM_SETENDOFLINE, eoltype, 0)
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Gets the end of line character used for the content of the edit control.
' ========================================================================================
PUBLIC FUNCTION GetEndOfLine (BYVAL hEdit AS HWND) AS EC_ENDOFLINE
   RETURN SendMessageW(hEdit, EM_GETENDOFLINE, 0, 0)
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Enables or disables the "Search with Bing…" context menu item in edit controls.
' ========================================================================================
PUBLIC FUNCTION EnableSearchWeb (BYVAL hEdit AS HWND, BYVAL fEnable AS BOOLEAN) AS BOOLEAN
   RETURN CBOOL(SendMessageW(hEdit, EM_ENABLESEARCHWEB, cast(WPARAM, fEnable), 0))
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Invokes the "Search with Bing…" context menu item in edit controls.
' ========================================================================================
PUBLIC FUNCTION SearchWeb (BYVAL hEdit AS HWND) AS BOOLEAN
   RETURN CBOOL(SendMessageW(hEdit, EM_SEARCHWEB, 0, 0))
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Sets the character index at which to locate the caret.
' ========================================================================================
PUBLIC FUNCTION SetCaretIndex (BYVAL hEdit AS HWND, BYVAL newCaretPosition AS LONG) AS BOOLEAN
   RETURN CBOOL(SendMessageW(hEdit, EM_SETCARETINDEX, cast(WPARAM, newCaretPosition), 0))
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Gets the zero-based index of the position of the caret in an edit control.
' ========================================================================================
PUBLIC FUNCTION GetCaretIndex (BYVAL hEdit AS HWND) AS LONG
   RETURN SendMessageW(hEdit, EM_GETCARETINDEX, 0, 0)
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Gets the current zoom ratio of an edit control (the zoom ratio is always between 1/64 and 64)
' ========================================================================================
PUBLIC FUNCTION GetZoom OVERLOAD (BYVAL hEdit AS HWND, BYVAL numerator AS LONG PTR, BYVAL denominator AS LONG PTR) AS BOOLEAN
   RETURN SendMessageW(hEdit, EM_GETZOOM, cast(WPARAM, numerator), cast(LPARAM, denominator))
END FUNCTION
' ========================================================================================
' ========================================================================================
PUBLIC FUNCTION GetZoom OVERLOAD (BYVAL hEdit AS HWND, BYREF numerator AS LONG, BYREF denominator AS LONG) AS BOOLEAN
   RETURN CBOOL(SendMessageW(hEdit, EM_GETZOOM, cast(WPARAM, @numerator), cast(LPARAM, @denominator)))
END FUNCTION
' ========================================================================================
' Usage example:
' var(n, d) = Edit.GetZoom(hEditMulti)
' print n, d
' ========================================================================================
PUBLIC FUNCTION GetZoom OVERLOAD (BYVAL hEdit AS HWND) AS (LONG, LONG)
   DIM AS LONG numerator, denominator
   SetLastError(SendMessageW(hEdit, EM_GETZOOM, cast(WPARAM, @numerator), cast(LPARAM, @denominator)))
   RETURN (numerator, denominator)
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Gets the index of the file (or logical) line of text that includes the specified character
' index (text wrap delimiters are ignored).
' ========================================================================================
PUBLIC FUNCTION GetFileLineFromChar (BYVAL hEdit AS HWND, BYVAL characterIndex AS UINT) AS UINT
   RETURN SendMessageW(hEdit, EM_FILELINEFROMCHAR, cast(WPARAM, characterIndex), 0)
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Gets the index of the file (or logical) line of text based on the specified visible line.
' ========================================================================================
PUBLIC FUNCTION GetFileLineIndex (BYVAL hEdit AS HWND, BYVAL lineNumber AS UINT) AS UINT
   RETURN SendMessageW(hEdit, EM_FILELINEINDEX, cast(WPARAM, lineNumber), 0)
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Gets the length of the file (or logical) line of text from the specified character index
' (text wrap delimiters are ignored).
' ========================================================================================
PUBLIC FUNCTION GetFileLineLength (BYVAL hEdit AS HWND, BYVAL characterIndex AS UINT) AS UINT
   RETURN SendMessageW(hEdit, EM_FILELINELENGTH, cast(WPARAM, characterIndex), 0)
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Copies a line of text from an edit control, independently of how lines are displayed on
' the screen, and places it in a specified buffer.
' ========================================================================================
PUBLIC FUNCTION GetFileLine OVERLOAD (BYVAL hEdit AS HWND, BYVAL lineNumber AS UINT, BYVAL textBuffer AS WSTRING PTR) AS UINT
   RETURN SendMessageW(hEdit, EM_GETFILELINE, cast(WPARAM, lineNumber), cast(LPARAM, textBuffer))
END FUNCTION
' ========================================================================================
' ========================================================================================
PUBLIC FUNCTION GetFileLine OVERLOAD (BYVAL hEdit AS HWND, BYVAL lineNumber AS UINT) AS USTRING
   DIM characterIndex AS LONG = Edit.LineIndex(hEdit, lineNumber)
   IF characterIndex = -1 THEN RETURN ""
   DIM cbLen AS LONG = SendMessageW(hEdit, EM_FILELINELENGTH, cast(WPARAM, characterIndex), 0)
   IF cbLen <= 0 THEN RETURN ""
   DIM ustrbufer AS USTRING = WSPACE(cbLen)
   SetLastError(SendMessageW(hEdit, EM_GETFILELINE, cast(WPARAM, lineNumber), cast(LPARAM, STRPTR(ustrbufer))))
   RETURN ustrbufer
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Gets the number of file (or logical) lines (text wrap delimiters are ignored).
' ========================================================================================
PUBLIC FUNCTION GetFileLineCount (BYVAL hEdit AS HWND) AS UINT
   RETURN SendMessageW(hEdit, EM_GETFILELINECOUNT, 0, 0)
END FUNCTION
' ========================================================================================
END NAMESPACE
