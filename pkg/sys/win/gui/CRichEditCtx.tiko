#module "gui"
#import "sys/win"
#import "sys/win/gdiplus"
#include once "richedit.ti"
using win, gdiplus

' ========================================================================================
' Custom structure used by the CRichEditCtx.LoadRtfFromResource method.
' ========================================================================================
#ifndef TK_CRichEditCtx_CUSTOMDATA
PUBLIC TYPE TK_CRichEditCtx_CUSTOMDATA
   pData  AS BYTE PTR
   nLen   AS LONG
   curPos AS LONG
END TYPE
#endif
' ========================================================================================

' ========================================================================================
' CRichEditCtx class
' ========================================================================================
PUBLIC TYPE CRichEditCtx EXTENDS CTextObjectBase

   Private:
      DIM m_hRichEdit AS HWND                      ' // Rich Edit cotroll handle
      DIM m_hInstance AS HINSTANCE                 ' // Instance handle
