' ========================================================================================
FUNCTION CRichEditCtx.GetPreferredFont (BYVAL cp AS LONG, BYVAL CharRep AS LONG, BYVAL nOptions AS LONG, _
BYVAL curCharRep AS LONG, BYVAL curFontSize AS LONG, BYREF ustrFontName AS USTRING, _
BYREF PitchAndFamily AS LONG, BYREF NewFontSize AS LONG) AS HRESULT
   DIM bstrFontName AS TK_BSTR
   m_Result = m_pTextDocument2->lpvtbl->GetPreferredFont(m_pTextDocument2, cp, CharRep, _
   nOptions, curCharRep, curFontSize, @bstrFontName, @PitchAndFamily, @NewFontSize)
   ustrFontName = *bstrFontName
   SysFreeString bstrFontName
   RETURN m_Result
END FUNCTION
