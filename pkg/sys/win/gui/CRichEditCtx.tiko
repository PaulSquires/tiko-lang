' ########################################################################################
' Wrapper methods and properties for the ITexDocument2 interface
' ########################################################################################

' ========================================================================================
' Retrieves a pointer to the ITextDocument2 interface
' ========================================================================================
FUNCTION CRichEditCtx.GetDocumentInterface () AS ITextDocument2 PTR
   ' // Retrieve a pointer to the IRichEditOle interface of the rich edit control
   DIM pUnk AS IUnknown PTR, pTextDocument2 AS ITextDocument2 PTR
   m_Result = SendMessageW(hRichEdit, EM_GETOLEINTERFACE, 0, cast(LPARAM, @pUnk))
   ' // Retrieve a pointer to its ITextDocument2 interface
   IF pUnk THEN
      DIM IID_ITextDocument2_ AS IID = tkGuid(IID_ITextDocument2)
      m_Result = IUnknown_QueryInterface(pUnk, @IID_ITextDocument2_, @pTextDocument2)
      tkSafeRelease(pUnk)
   END IF
   RETURN pTextDocument2
END FUNCTION
' ========================================================================================

' ========================================================================================
' Opens a new document. If another document is open, this method saves any current changes
' and closes the current document before opening a new one.
' ========================================================================================
' ========================================================================================
FUNCTION CRichEditCtx.NewDoc () AS HRESULT
   m_Result = m_pTextDocument2->lpvtbl->New_(m_pTextDocument2)
   RETURN m_Result
END FUNCTION
' ========================================================================================

' ========================================================================================
' Opens a new document. If another document is open, this method saves any current changes
' and closes the current document before opening a new one.
' Example:
' DIM dv AS DVARIANT = tkGetExePath & $"\Test.rtf"
' pRichEditCtrl.OpenDoc(dv)
' Default code page is CP_UNICODE (1200).
' If it is an ansi text file, pass CP_ANSI.
' If it UTF8 pass CP_UTF8.
' ========================================================================================
FUNCTION CRichEditCtx.OpenDoc (BYVAL pVar AS VARIANT PTR, BYVAL Flags AS LONG = 0, BYVAL CodePage AS LONG = CP_ACP) AS HRESULT
   m_Result = m_pTextDocument2->lpvtbl->Open(m_pTextDocument2, pVar, Flags, CodePage)
   RETURN m_Result
END FUNCTION
' ========================================================================================
FUNCTION CRichEditCtx.OpenDoc (BYREF dv AS DVARIANT, BYVAL Flags AS LONG = 0, BYVAL CodePage AS LONG = CP_ACP) AS HRESULT
   m_Result = m_pTextDocument2->lpvtbl->Open(m_pTextDocument2, dv, Flags, CodePage)
   RETURN m_Result
END FUNCTION
' ========================================================================================

' ========================================================================================
' Saves the document to a file in the specified format.
' pVar = Path and file name, e.g. 
'    DIM dv AS DVARIANT = AfxGetExePath & $"\Test.rtf"
'    pRichEdit->SaveDoc(dv, tomCreateAlways OR tomRTF)
' Pass NULL to overwrite the file if it already exists.
' ========================================================================================
FUNCTION CRichEditCtx.SaveDoc (BYVAL pVar AS VARIANT PTR, BYVAL Flags AS LONG = tomRTF, BYVAL CodePage AS LONG = CP_ACP) AS HRESULT
   m_Result = m_pTextDocument2->lpvtbl->Save(m_pTextDocument2, pVar, Flags, CodePage)
   RETURN m_Result
END FUNCTION
' ========================================================================================
' ========================================================================================
FUNCTION CRichEditCtx.SaveDoc (BYREF dv AS DVARIANT, BYVAL Flags AS LONG = tomRTF, BYVAL CodePage AS LONG = CP_ACP) AS HRESULT
   m_Result = m_pTextDocument2->lpvtbl->Save(m_pTextDocument2, dv, Flags, CodePage)
   RETURN m_Result
END FUNCTION
' ========================================================================================

' ========================================================================================
' Gets the file name of this document. This is the ITextDocument2 default property.
' ========================================================================================
FUNCTION CRichEditCtx.DocName () AS USTRING
   DIM ustr AS USTRING, bstr AS TK_BSTR
   m_Result = m_pTextDocument2->lpvtbl->GetName(m_pTextDocument2, @bstr)
   ustr = *bstr
   SysFreeString(bstr)
   RETURN ustr
END FUNCTION
' ========================================================================================
' ========================================================================================
FUNCTION CRichEditCtx.GetDocName () AS USTRING
   DIM ustr AS USTRING, bstr AS TK_BSTR
   m_Result = m_pTextDocument2->lpvtbl->GetName(m_pTextDocument2, @bstr)
   ustr = *bstr
   SysFreeString(bstr)
   RETURN ustr
END FUNCTION
