FUNCTION CRichEditCtx.SetTextEx (BYREF stex AS .SETTEXTEX, BYREF strText AS STRING) AS DWORD
   m_Result = 0
   RETURN SendMessageW(m_hRichEdit, EM_SETTEXTEX, cast(WPARAM, @stex), cast(LPARAM, STRPTR(strText)))
END FUNCTION
