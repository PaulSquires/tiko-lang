' ========================================================================================
' Subclassed window procedure
' ========================================================================================
FUNCTION CRichEditCtx.CRichEditCtxProc ( _
   BYVAL hwnd   AS HWND, _                 ' // Control window handle
   BYVAL uMsg   AS UINT, _                 ' // Type of message
   BYVAL wParam AS WPARAM, _               ' // First message parameter
   BYVAL lParam AS LPARAM, _               ' // Second message parameter
   BYVAL uIdSubclass AS UINT_PTR, _        ' // The subclass ID
   BYVAL dwRefData AS DWORD_PTR _          ' // Pointer to reference data
   ) AS LRESULT

   SELECT CASE uMsg

      CASE WM_GETDLGCODE
         ' // Needed to allow keyboard navigation with the TAB key
         ' // without the rich edit control inserting a tab in the text
         IF wParam = VK_TAB THEN
            DIM pRichEdit AS CRichEditCtx PTR = cast(CRichEditCtx PTR, dwRefData)
            IF pRichEdit = NULL THEN RETURN 0
            '// Eat the TAB key
            IF pRichEdit->AcceptTab = FALSE THEN RETURN 0
         END IF
         ' // Process all keyboard input
         RETURN DLGC_WANTALLKEYS

      CASE WM_KEYDOWN
         ' // Keyboard navigation
         SELECT CASE LOWORD(wParam)
            ' // Rich Edit multiline controls send a WM_CLOSE message to its parent window,
            ' // when the ESC key is pressed, causing the application to shut down.
            ' // Avoid it by cancelling the message.
            CASE VK_ESCAPE
               RETURN 0
            CASE VK_TAB
               DIM pRichEdit AS CRichEditCtx PTR = cast(CRichEditCtx PTR, dwRefData)
               IF pRichEdit = NULL THEN RETURN 0
               IF pRichEdit->AcceptTab = FALSE THEN
                  IF HIWORD(.GetKeyState(VK_SHIFT)) = 0 THEN
                     '// Set the focus in the previous control that has the WS_TABSTOP style
                     .SetFocus .GetNextDlgTabItem(GetParent(hwnd), hwnd, 0)
                  ELSE
                     '// Set the focus in the next control that has the WS_TABSTOP style
                     .SetFocus .GetNextDlgTabItem(GetParent(hwnd), hwnd, -1)
                  END IF
               END IF
               RETURN 0
         END SELECT

      CASE WM_DESTROY
         ' // REQUIRED: Remove control subclassing
         RemoveWindowSubclass hwnd, @CRichEditCtxProc, uIdSubclass
         EXIT FUNCTION

      ' // Returns the class pointer
      CASE WM_USER + 100
         RETURN dwRefData

   END SELECT

   ' // Default processing for other messages
   RETURN DefSubclassProc(hwnd, uMsg, wParam, lParam)

END FUNCTION
' ========================================================================================

' ========================================================================================
' CRichEditCtx class constructor (CWindow)
' ========================================================================================
CONSTRUCTOR CRichEditCtx (BYVAL pWindow AS CWindow PTR, BYVAL cID AS LONG_PTR, BYREF wszTitle AS WSTRING = "", _
   BYVAL x AS LONG = 0, BYVAL y AS LONG = 0, BYVAL nWidth AS LONG = 0, BYVAL nHeight AS LONG = 0, _
   BYVAL dwStyle AS LONG = -1, BYVAL dwExStyle AS LONG = -1, BYVAL lpParam AS LONG_PTR = NULL)

   ' // Create the control
   IF pWindow = NULL THEN EXIT CONSTRUCTOR
   m_hRichEdit = pWindow->AddControl("RICHEDIT", pWindow->hWindow, cID, wszTitle, _
                 x, y, nWidth, nHeight, dwStyle, dwExStyle, lpParam)
   IF m_hRichEdit = NULL THEN EXIT CONSTRUCTOR
   ' // Subclass the control
   SetWindowSubclass m_hRichEdit, CAST(SUBCLASSPROC, @CRichEditCtxProc), cID, CAST(DWORD_PTR, @this)
     
   m_hInstance = pWindow->InstanceHandle
   m_ScalingRatio = pWindow->rxRatio
   ' // Set the ES_EX_ZOOMABLE (&H0010) extended style
   ' // EM_SETEXTENDEDSTYLE = ECM_FIRST + 10
   ' // EM_GETEXTENDEDSTYLE = ECM_FIRST + 11
   DIM _dwExStyle AS DWORD = SendMessageW(m_hRichEdit, ECM_FIRST + 11, 0, 0)
   SendMessageW(m_hRichEdit, ECM_FIRST + 10, _dwExStyle, &H0010)
   ' // Get a pointer to the ITextDocument2 interface
   m_pTextDocument2 = this.GetDocumentInterface
   IF m_pTextDocument2 = NULL THEN EXIT CONSTRUCTOR

END CONSTRUCTOR
' ========================================================================================

' ========================================================================================
' CRichEditCtx class destructor
' ========================================================================================
DESTRUCTOR CRichEditCtx
   ' // Release the ITextDocument2 interface
   DIM dwRefCount AS DWORD = tkSafeRelease(m_pTextDocument2)
   ' // Destroy the Rich Edit control
   DestroyWindow m_hRichEdit
   m_hRichEdit = NULL
END DESTRUCTOR
