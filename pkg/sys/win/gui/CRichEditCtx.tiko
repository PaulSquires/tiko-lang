' ========================================================================================
' Gets/sets the Saved property
' ========================================================================================
PROPERTY CRichEditCtx.Saved () AS BOOLEAN
   m_Result = 0
   DIM value AS LONG
   m_pTextDocument2->lpvtbl->GetSaved(m_pTextDocument2, @value)
   IF value <> tomTrue THEN RETURN FALSE
   RETURN TRUE
END PROPERTY
' ========================================================================================
' ========================================================================================
PROPERTY CRichEditCtx.Saved (BYVAL value AS BOOLEAN)
   m_Result = 0
   m_pTextDocument2->lpvtbl->SetSaved(m_pTextDocument2, IIF(value = TRUE, tomTrue, tomFalse))
END PROPERTY
' ========================================================================================
' ========================================================================================
FUNCTION CRichEditCtx.GetSaved () AS BOOLEAN
   m_Result = 0
   DIM value AS LONG
   m_pTextDocument2->lpvtbl->GetSaved(m_pTextDocument2, @value)
   IF value <> tomTrue THEN RETURN FALSE
   RETURN TRUE
END FUNCTION
' ========================================================================================
' ========================================================================================
FUNCTION CRichEditCtx.SetSaved (BYVAL value AS BOOLEAN) AS HRESULT
   m_Result = 0
   RETURN m_pTextDocument2->lpvtbl->SetSaved(m_pTextDocument2, IIF(value = TRUE, tomTrue, tomFalse))
END FUNCTION
