PUBLIC FUNCTION GetItemPosition OVERLOAD (BYVAL hListView AS HWND, BYVAL i AS LONG, BYVAL ppt AS POINT PTR) AS BOOLEAN
   RETURN SendMessageW(hListView, LVM_GETITEMPOSITION, i, CAST(LPARAM, ppt))
END FUNCTION
' ========================================================================================
' ========================================================================================
PUBLIC FUNCTION GetItemPosition OVERLOAD (BYVAL hListView AS HWND, BYVAL i AS LONG, BYREF pt AS POINT) AS BOOLEAN
   RETURN SendMessageW(hListView, LVM_GETITEMPOSITION, i, CAST(LPARAM, @pt))
END FUNCTION
' ========================================================================================
' ========================================================================================
PUBLIC FUNCTION GetItemPosition OVERLOAD (BYVAL hListView AS HWND, BYVAL i AS LONG) AS POINT
   DIM pt AS POINT
   SendMessageW(hListView, LVM_GETITEMPOSITION, i, CAST(LPARAM, @pt))
   RETURN pt
END FUNCTION
' ========================================================================================

' ========================================================================================
' Gets the bounding rectangle for all or part of an item in the current view.
' ========================================================================================
PUBLIC FUNCTION GetItemRect OVERLOAD (BYVAL hListView AS HWND, BYVAL i AS LONG, BYVAL prc AS RECT PTR) AS BOOLEAN
   RETURN SendMessageW(hListView, LVM_GETITEMRECT, i, CAST(LPARAM, prc))
END FUNCTION
' ========================================================================================
' ========================================================================================
PUBLIC FUNCTION GetItemRect OVERLOAD (BYVAL hListView AS HWND, BYVAL i AS LONG, BYREF rc AS RECT) AS BOOLEAN
   RETURN SendMessageW(hListView, LVM_GETITEMRECT, i, CAST(LPARAM, @rc))
END FUNCTION
' ========================================================================================
' ========================================================================================
'PUBLIC FUNCTION ListView.GetItemRect OVERLOAD (BYVAL hListView AS HWND, BYVAL i AS LONG, BYVAL code AS LONG) AS RECT
'   DIM rc AS RECT : rc.Left = code
'   SendMessageW(hListView, LVM_GETITEMRECT, i, CAST(LPARAM, @rc))
'   RETURN rc
'END FUNCTION
' ========================================================================================
' ========================================================================================
PUBLIC FUNCTION GetItemRect OVERLOAD (BYVAL hListView AS HWND, BYVAL i AS LONG, BYVAL code AS LONG) AS (LONG, LONG, LONG, LONG)
   DIM rc AS RECT : rc.Left = code
   SetLastError(SendMessageW(hListView, LVM_GETITEMRECT, i, CAST(LPARAM, @rc)))
   RETURN (rc.left, rc.top, rc.right, rc.bottom)
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Determines the spacing between items in a list-view control.
' ========================================================================================
PUBLIC FUNCTION GetItemSpacing (BYVAL hListView AS HWND, BYVAL fSmall AS BOOLEAN) AS DWORD
   RETURN SendMessageW(hListView, LVM_GETITEMSPACING, fSmall, 0)
END FUNCTION
' ========================================================================================
' ========================================================================================
PUBLIC FUNCTION GetItemHorizontalSpacing (BYVAL hListView AS HWND, BYVAL fSmall AS BOOLEAN) AS DWORD
   RETURN LOWORD(SendMessageW(hListView, LVM_GETITEMSPACING, fSmall, 0))
END FUNCTION
' ========================================================================================
' ========================================================================================
PUBLIC FUNCTION GetItemVerticalSpacing (BYVAL hListView AS HWND, BYVAL fSmall AS BOOLEAN) AS DWORD
   RETURN HIWORD(SendMessageW(hListView, LVM_GETITEMSPACING, fSmall, 0))
END FUNCTION
' ========================================================================================

' ========================================================================================
' Gets the state of a list-view item.
' ========================================================================================
PUBLIC FUNCTION GetItemState (BYVAL hListView AS HWND, BYVAL i AS LONG, BYVAL mask AS LONG) AS UINT
   RETURN SendMessageW(hListView, LVM_GETITEMSTATE, i, mask)
END FUNCTION
' ========================================================================================

' ========================================================================================
' Gets the text of a list-view item or subitem.
' ========================================================================================
PUBLIC SUB GetItemText (BYVAL hListView AS HWND, BYVAL i AS LONG, BYVAL iSubItem AS LONG, BYVAL pwszText AS WSTRING PTR, BYVAL cchTextMax AS LONG  = MAX_PATH + 1)
   DIM lvi AS LVITEMW
   lvi.iSubItem = iSubItem
   lvi.cchTextMax = cchTextMax
   lvi.pszText = pwszText
   SetLastError(SendMessageW(hListView, LVM_GETITEMTEXTW, i, CAST(LPARAM, @lvi)))
END SUB
' ========================================================================================
' ========================================================================================
' * Gets the text of a list-view item or subitem.
' ========================================================================================
PUBLIC FUNCTION GetText (BYVAL hListView AS HWND, BYVAL item AS LONG, BYVAL iSubItem AS LONG, BYVAL cchTextMax AS LONG = MAX_PATH + 1) AS USTRING
   DIM ustrText AS USTRING
   DIM lvi AS LVITEMW
   DIM nLen AS LONG
   IF cchTextMax < 1 THEN cchTextMax = MAX_PATH + 1
   ustrText = WSPACE(cchTextMax + 1)
   lvi.mask = LVIF_TEXT
   lvi.iItem = item
   lvi.iSubItem = iSubItem
   lvi.cchTextMax = cchTextMax + 1
   lvi.pszText = STRPTR(ustrText)
   nLen = SendMessageW(hListView, LVM_GETITEMTEXTW, 0, CAST(LPARAM, @lvi))
   IF nLen = 0 THEN RETURN ""
   RETURN LEFT(ustrText, nLen)
END FUNCTION
