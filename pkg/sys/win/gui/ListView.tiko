' ========================================================================================
' Gets information about the rectangle that surrounds a subitem in a list-view control.
' This function is intended to be used only on list-view controls that use the LVS_REPORT style.
' ========================================================================================
PUBLIC FUNCTION GetSubItemRect OVERLOAD (BYVAL hListView AS HWND, BYVAL iItem AS LONG, BYVAL iSubItem AS LONG, BYVAL nCode AS LONG, BYVAL prc AS RECT PTR) AS BOOLEAN
   IF prc = NULL THEN RETURN FALSE
   prc->Top = iSubItem
   prc->Left = nCode
   RETURN SendMessageW(hListView, LVM_GETSUBITEMRECT, iItem, CAST(LPARAM, prc))
END FUNCTION
' ========================================================================================
' ========================================================================================
PUBLIC FUNCTION GetSubItemRect OVERLOAD (BYVAL hListView AS HWND, BYVAL iItem AS LONG, BYVAL iSubItem AS LONG, BYVAL nCode AS LONG, BYREF rc AS RECT) AS BOOLEAN
   IF VARPTR(rc) = NULL THEN RETURN FALSE
   rc.Top = iSubItem
   rc.Left = nCode
   RETURN SendMessageW(hListView, LVM_GETSUBITEMRECT, iItem, CAST(LPARAM, @rc))
END FUNCTION
' ========================================================================================
' ========================================================================================
'PUBLIC FUNCTION ListView.GetSubItemRect OVERLOAD (BYVAL hListView AS HWND, BYVAL iItem AS LONG, BYVAL iSubItem AS LONG, BYVAL nCode AS LONG) AS RECT
'   DIM rc AS RECT
'   rc.Top = iSubItem
'   rc.Left = nCode
'   SendMessageW(hListView, LVM_GETSUBITEMRECT, iItem, CAST(LPARAM, @rc))
'   RETURN rc
'END FUNCTION
' ========================================================================================
' ========================================================================================
PUBLIC FUNCTION GetSubItemRect OVERLOAD (BYVAL hListView AS HWND, BYVAL iItem AS LONG, BYVAL iSubItem AS LONG, BYVAL nCode AS LONG) AS (LONG, LONG, LONG, LONG)
   DIM rc AS RECT
   rc.Top = iSubItem
   rc.Left = nCode
   SetLastError(SendMessageW(hListView, LVM_GETSUBITEMRECT, iItem, CAST(LPARAM, @rc)))
   RETURN (rc.left, rc.top, rc.right, rc.bottom)
END FUNCTION
