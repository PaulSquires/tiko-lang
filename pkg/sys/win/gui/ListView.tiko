END FUNCTION
' ========================================================================================

' ========================================================================================
' Gets the position of the insertion point.
' ========================================================================================
PUBLIC FUNCTION GetInsertMark OVERLOAD (BYVAL hListView AS HWND, BYVAL pvim AS LVINSERTMARK PTR) AS BOOLEAN
   IF pvim = NULL THEN RETURN FALSE
   pvim->cbSize = SIZEOF(LVINSERTMARK)
   RETURN SendMessageW(hListView, LVM_GETINSERTMARK, 0, CAST(LPARAM, pvim))
END FUNCTION
' ========================================================================================
' ========================================================================================
PUBLIC FUNCTION GetInsertMark OVERLOAD (BYVAL hListView AS HWND, BYREF vim AS LVINSERTMARK) AS BOOLEAN
   IF VARPTR(vim) = NULL THEN RETURN FALSE
   vim.cbSize = SIZEOF(LVINSERTMARK)
   RETURN SendMessageW(hListView, LVM_GETINSERTMARK, 0, CAST(LPARAM, @vim))
END FUNCTION
' ========================================================================================
' ========================================================================================
PUBLIC FUNCTION GetInsertMark OVERLOAD (BYVAL hListView AS HWND) AS LVINSERTMARK
   DIM vim AS LVINSERTMARK
   vim.cbSize = SIZEOF(LVINSERTMARK)
   SetLastError(SendMessageW(hListView, LVM_GETINSERTMARK, 0, CAST(LPARAM, @vim)))
   RETURN vim
END FUNCTION
' ========================================================================================

' ========================================================================================
' Gets the color of the insertion point.
' ========================================================================================
PUBLIC FUNCTION GetInsertMarkColor (BYVAL hListView AS HWND) AS COLORREF
   RETURN SendMessageW(hListView, LVM_GETINSERTMARKCOLOR, 0, 0)
END FUNCTION
' ========================================================================================

' ========================================================================================
' Gets the rectangle that bounds the insertion point.
' ========================================================================================
PUBLIC FUNCTION GetInsertMarkRect OVERLOAD (BYVAL hListView AS HWND, BYVAL prc AS RECT PTR) AS LONG
   RETURN SendMessageW(hListView, LVM_GETINSERTMARKRECT, 0, CAST(LPARAM, prc))
END FUNCTION
' ========================================================================================
' ========================================================================================
PUBLIC FUNCTION GetInsertMarkRect OVERLOAD (BYVAL hListView AS HWND, BYREF rc AS RECT) AS LONG
   RETURN SendMessageW(hListView, LVM_GETINSERTMARKRECT, 0, CAST(LPARAM, @rc))
END FUNCTION
' ========================================================================================
' ========================================================================================
'PUBLIC FUNCTION ListView.GetInsertMarkRect OVERLOAD (BYVAL hListView AS HWND) AS RECT
'   DIM rc AS RECT
'   SendMessageW(hListView, LVM_GETINSERTMARKRECT, 0, CAST(LPARAM, @rc))
'   RETURN rc
'END FUNCTION
' ========================================================================================
' ========================================================================================
PUBLIC FUNCTION GetInsertMarkRect OVERLOAD (BYVAL hListView AS HWND) AS (LONG, LONG, LONG, LONG)
   DIM rc AS RECT
   SetLastError(SendMessageW(hListView, LVM_GETINSERTMARKRECT, 0, CAST(LPARAM, @rc)))
   RETURN (rc.left, rc.top, rc.right, rc.bottom)
END FUNCTION
' ========================================================================================

' ========================================================================================
' Gets the length of the incremental search string of a list-view control.
' ========================================================================================
PUBLIC FUNCTION GetISearchStringLen (BYVAL hListView AS HWND) AS LONG
   RETURN SendMessageW(hListView, LVM_GETISEARCHSTRINGW, 0, NULL)
END FUNCTION
' ========================================================================================

' ========================================================================================
' Gets the incremental search string of a list-view control.
' ========================================================================================
PUBLIC FUNCTION GetISearchString (BYVAL hListView AS HWND) AS USTRING
   DIM nLen AS LONG = SendMessageW(hListView, LVM_GETISEARCHSTRINGW, 0, BYVAL NULL)
   DIM ustrSearch AS USTRING = WSPACE(nLen + 1)
   nLen = SendMessageW(hListView, LVM_GETISEARCHSTRINGW, 0, BYVAL CAST(LPARAM, STRPTR(ustrSearch)))
   IF nLen = 0 THEN RETURN ""
   RETURN LEFT(ustrSearch, nLen)
END FUNCTION
' ========================================================================================

' ========================================================================================
' Gets some or all of a list-view item's attributes.
' ========================================================================================
PUBLIC FUNCTION GetItem OVERLOAD (BYVAL hListView AS HWND, BYVAL pitem AS LVITEMW PTR) AS BOOLEAN
   RETURN SendMessageW(hListView, LVM_GETITEM, 0, CAST(LPARAM, pitem))
END FUNCTION
' ========================================================================================
' ========================================================================================
PUBLIC FUNCTION GetItem OVERLOAD (BYVAL hListView AS HWND, BYREF item AS LVITEMW) AS BOOLEAN
   RETURN SendMessageW(hListView, LVM_GETITEM, 0, CAST(LPARAM, @item))
END FUNCTION
' ========================================================================================

' ========================================================================================
