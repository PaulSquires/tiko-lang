' ========================================================================================
' Gets the bounding rectangle for all or part of a subitem in the current view of a
' specified list-view control.
' ========================================================================================
PUBLIC FUNCTION GetItemIndexRect OVERLOAD (BYVAL hListView AS HWND, BYVAL pvii AS LVITEMINDEX PTR, BYVAL iSubItem AS LONG, BYVAL code AS LONG, BYVAL prc AS RECT PTR) AS BOOLEAN
   prc->Top = iSubItem : prc->Left = Code
   RETURN SendMessageW(hListView, LVM_GETITEMINDEXRECT, CAST(WPARAM, pvii), CAST(LPARAM, prc))
END FUNCTION
' ========================================================================================
' ========================================================================================
PUBLIC FUNCTION GetItemIndexRect OVERLOAD (BYVAL hListView AS HWND, BYREF lvii AS LVITEMINDEX, BYVAL iSubItem AS LONG, BYVAL code AS LONG, BYREF rc AS RECT) AS BOOLEAN
   rc.Top = iSubItem : rc.Left = Code
   RETURN SendMessageW(hListView, LVM_GETITEMINDEXRECT, CAST(WPARAM, @lvii), CAST(LPARAM, @rc))
END FUNCTION
