#module "gui"
#include once "gui.ti"

#include once "windows.bi"
#include once "win/uxtheme.bi"

NAMESPACE ListView
' ========================================================================================
' Calculates the approximate width and height required to display a given number of items.
' ========================================================================================
PUBLIC FUNCTION ApproximateViewRect (BYVAL hListView AS HWND, BYVAL iWidth AS SHORT, BYVAL iHeight AS SHORT, BYVAL iCount AS LONG) AS DWORD
   RETURN SendMessageW(hListView, LVM_APPROXIMATEVIEWRECT, iCount, MAKELONG(iWidth, iHeight))
END FUNCTION
' ========================================================================================

' ========================================================================================
' Arranges items in icon view.
' ========================================================================================
PUBLIC FUNCTION Arrange (BYVAL hListView AS HWND, BYVAL code AS UINT) AS BOOLEAN
   RETURN SendMessageW(hListView, LVM_ARRANGE, code, 0)
END FUNCTION
' ========================================================================================

' ========================================================================================
' Cancels an item text editing operation.
' ========================================================================================
PUBLIC SUB CancelEditLabel (BYVAL hListView AS HWND)
   SendMessageW hListView, LVM_CANCELEDITLABEL, 0, 0
END SUB
' ========================================================================================

' ========================================================================================
' Creates a drag image list for the specified item.
' ========================================================================================
PUBLIC FUNCTION CreateDragImage OVERLOAD (BYVAL hListView AS HWND, BYVAL i AS LONG, BYVAL lpptUpLeft AS POINT PTR) AS HIMAGELIST
   RETURN CAST(HIMAGELIST, SendMessageW(hListView, LVM_CREATEDRAGIMAGE, i, CAST(LPARAM, lpptUpLeft)))
END FUNCTION
' ========================================================================================
' ========================================================================================
PUBLIC FUNCTION CreateDragImage OVERLOAD (BYVAL hListView AS HWND, BYVAL i AS LONG, BYREF tUpLeft AS POINT) AS HIMAGELIST
   RETURN CAST(HIMAGELIST, SendMessageW(hListView, LVM_CREATEDRAGIMAGE, i, CAST(LPARAM, @tUpLeft)))
END FUNCTION
' ========================================================================================
' ========================================================================================
PUBLIC FUNCTION CreateDragImage OVERLOAD (BYVAL hListView AS HWND, BYVAL i AS LONG, BYVAL x AS LONG, BYVAL y AS LONG) AS HIMAGELIST
   DIM tUpLeft AS POINT = TYPE<POINT>(x, y)
   RETURN CAST(HIMAGELIST, SendMessageW(hListView, LVM_CREATEDRAGIMAGE, i, CAST(LPARAM, @tUpLeft)))
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Removes all items from a list-view control.
' ========================================================================================
PUBLIC FUNCTION DeleteAllItems (BYVAL hListView AS HWND) AS BOOLEAN
   RETURN SendMessageW(hListView, LVM_DELETEALLITEMS, 0, 0)
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Removes a column from a list-view control.
' ========================================================================================
PUBLIC FUNCTION DeleteColumn (BYVAL hListView AS HWND, BYVAL iCol AS LONG) AS BOOLEAN
   RETURN SendMessageW(hListView, LVM_DELETECOLUMN, iCol, 0)
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Removes an item from a list-view control.
' ========================================================================================
PUBLIC FUNCTION DeleteItem (BYVAL hListView AS HWND, BYVAL i AS LONG) AS BOOLEAN
   RETURN SendMessageW(hListView, LVM_DELETEITEM, i, 0)
END FUNCTION
' ========================================================================================

' ========================================================================================
' Begins in-place editing of the specified list-view item's text. The message implicitly
' selects and focuses the specified item.
' ========================================================================================
PUBLIC FUNCTION EditLabel (BYVAL hListView AS HWND, BYVAL i AS LONG) AS HWND
   RETURN CAST(HWND, SendMessageW(hListView, LVM_EDITLABEL, i, 0))
END FUNCTION
' ========================================================================================

' ========================================================================================
' Enables or disables whether the items in a list-view control display as a group.
' ========================================================================================
PUBLIC FUNCTION EnableGroupView (BYVAL hListView AS HWND, BYVAL fEnable AS BOOLEAN) AS LONG
   RETURN SendMessageW(hListView, LVM_ENABLEGROUPVIEW, fEnable, 0)
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Ensures that a list-view item is either entirely or partially visible, scrolling the
' list-view control if necessary.
' ========================================================================================
PUBLIC FUNCTION EnsureVisible (BYVAL hListView AS HWND, BYVAL i AS LONG, BYVAL fPartialOK AS BOOLEAN) AS BOOLEAN
   RETURN SendMessageW(hListView, LVM_ENSUREVISIBLE, i, MAKELONG(fPartialOK, 0))
END FUNCTION
' ========================================================================================

' ========================================================================================
' Searches for a list-view item with the specified characteristics.
' ========================================================================================
PUBLIC FUNCTION FindItem OVERLOAD (BYVAL hListView AS HWND, BYVAL iStart AS LONG, BYVAL pvfi AS LVFINDINFOW PTR) AS LONG
   RETURN SendMessageW(hListView, LVM_FINDITEMW, iStart, CAST(LPARAM, pvfi))
END FUNCTION
' ========================================================================================
' ========================================================================================
PUBLIC FUNCTION FindItem OVERLOAD (BYVAL hListView AS HWND, BYVAL iStart AS LONG, BYREF vfi AS LVFINDINFOW) AS LONG
   RETURN SendMessageW(hListView, LVM_FINDITEMW, iStart, CAST(LPARAM, @vfi))
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Searches for a list-view item with the specified text.
' Returns the index of the item if successful, or -1 otherwise.
' ========================================================================================
PUBLIC FUNCTION FindString (BYVAL hListView AS HWND, BYVAL pwszText AS WSTRING PTR) AS LONG
   DIM lvf AS LVFINDINFOW
   lvf.flags = LVFI_STRING OR LVFI_PARTIAL
   lvf.psz = pwszText
   RETURN SendMessageW(hListView, LVM_FINDITEMW, -1, CAST(LPARAM, @lvf))
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Gets the background color of a list-view control.
' ========================================================================================
PUBLIC FUNCTION GetBkColor (BYVAL hListView AS HWND) AS COLORREF
   RETURN SendMessageW(hListView, LVM_GETBKCOLOR, 0, 0)
END FUNCTION
' ========================================================================================

' ========================================================================================
' Gets the background image in a list-view control.
' ========================================================================================
PUBLIC FUNCTION GetBkImage OVERLOAD (BYVAL hListView AS HWND, BYVAL pvbki AS LVBKIMAGEW PTR) AS BOOLEAN
   RETURN SendMessageW(hListView, LVM_GETBKIMAGE, 0, CAST(LPARAM, pvbki))
END FUNCTION
' ========================================================================================
' ========================================================================================
PUBLIC FUNCTION GetBkImage OVERLOAD (BYVAL hListView AS HWND, BYREF vbki AS LVBKIMAGEW) AS BOOLEAN
   RETURN SendMessageW(hListView, LVM_GETBKIMAGE, 0, CAST(LPARAM, @vbki))
END FUNCTION
' ========================================================================================
' ========================================================================================
PUBLIC FUNCTION GetBkImage OVERLOAD (BYVAL hListView AS HWND) AS LVBKIMAGEW
   DIM vbki AS LVBKIMAGEW
   SendMessageW(hListView, LVM_GETBKIMAGEW, 0, CAST(LPARAM, @vbki))
   RETURN vbki
END FUNCTION
' ========================================================================================

' ========================================================================================
' Gets the callback mask for a list-view control.
' ========================================================================================
PUBLIC FUNCTION GetCallbackMask (BYVAL hListView AS HWND) AS UINT
   RETURN SendMessageW(hListView, LVM_GETCALLBACKMASK, 0, 0)
END FUNCTION
' ========================================================================================

' ========================================================================================
' Determines if an item in a list-view control is selected. This should be used only for
' list-view controls that have the LVS_EX_CHECKBOXES style.
' ========================================================================================
PUBLIC FUNCTION GetCheckState (BYVAL hListView AS HWND, BYVAL i AS LONG) AS UINT
   DIM nCheck AS LONG
   nCheck = SendMessageW(hListView, LVM_GETITEMSTATE, i, LVIS_STATEIMAGEMASK)
   RETURN BIT(nCheck, 12) - 1
END FUNCTION
' ========================================================================================

' ========================================================================================
' Gets the attributes of a list-view control's column.
' ========================================================================================
PUBLIC FUNCTION GetColumn OVERLOAD (BYVAL hListView AS HWND, BYVAL iCol AS LONG, BYVAL pcol AS LVCOLUMNW PTR) AS BOOLEAN
   RETURN SendMessageW(hListView, LVM_GETCOLUMNW, iCol, CAST(LPARAM, pcol))
END FUNCTION
' ========================================================================================
' ========================================================================================
PUBLIC FUNCTION GetColumn OVERLOAD (BYVAL hListView AS HWND, BYVAL iCol AS LONG, BYREF col AS LVCOLUMNW) AS BOOLEAN
   RETURN SendMessageW(hListView, LVM_GETCOLUMNW, iCol, CAST(LPARAM, @col))
END FUNCTION
' ========================================================================================
' ========================================================================================
PUBLIC FUNCTION GetColumn OVERLOAD (BYVAL hListView AS HWND, BYVAL iCol AS LONG) AS LVCOLUMNW
   DIM pcol AS LVCOLUMNW
   SendMessageW(hListView, LVM_GETCOLUMNW, iCol, CAST(LPARAM, @pcol))
   RETURN pcol
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Gets the text of a list-view control's column.
' ========================================================================================
PUBLIC FUNCTION GetColumnText (BYVAL hListView AS HWND, BYVAL iCol AS LONG, BYVAL cchTextMax AS LONG = MAX_PATH + 1) AS USTRING
   DIM ustrText AS USTRING
   IF cchTextMax < 1 THEN cchTextMax = MAX_PATH + 1
   ustrText = WSPACE(cchTextMax + 1)
   DIM lvc AS LVCOLUMNW
   lvc.mask = LVCF_TEXT
   lvc.cchTextMax = cchTextMax + 1
   lvc.pszText = STRPTR(ustrText)
   IF SendMessageW(hListView, LVM_GETCOLUMNW, iCol, CAST(LPARAM, @lvc)) THEN RETURN ustrText
END FUNCTION
' ========================================================================================

' ========================================================================================
' Gets the current left-to-right order of columns in a list-view control.
' ========================================================================================
PUBLIC FUNCTION GetColumnOrderArray (BYVAL hListView AS HWND, BYVAL iCount AS LONG, BYVAL lpiArray AS LONG PTR) AS LONG
   RETURN SendMessageW(hListView, LVM_GETCOLUMNORDERARRAY, iCount, CAST(LPARAM, lpiArray))
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Gets the width of a column in report or list view.
' ========================================================================================
PUBLIC FUNCTION GetColumnWidth (BYVAL hListView AS HWND, BYVAL iCol AS LONG) AS LONG
   RETURN SendMessageW(hListView, LVM_GETCOLUMNWIDTH, iCol, 0)
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Calculates the number of items that can fit vertically in the visible area of a
' list-view control when in list or report view.
' ========================================================================================
PUBLIC FUNCTION GetCountPerPage (BYVAL hListView AS HWND) AS LONG
   RETURN SendMessageW(hListView, LVM_GETCOUNTPERPAGE, 0, 0)
END FUNCTION
' ========================================================================================

' ========================================================================================
' Gets the handle to the edit control being used to edit a list-view item's text.
' ========================================================================================
PUBLIC FUNCTION GetEditControl (BYVAL hListView AS HWND) AS HWND
   RETURN CAST(HWND, SendMessageW(hListView, LVM_GETEDITCONTROL, 0, 0))
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Gets the extended styles that are currently in use for a given list-view control.
' ========================================================================================
PUBLIC FUNCTION GetExtendedStyle (BYVAL hListView AS HWND) AS DWORD
   RETURN SendMessageW(hListView, LVM_GETEXTENDEDLISTVIEWSTYLE, 0, 0)
END FUNCTION
' ========================================================================================

' ========================================================================================
' Gets the group that has the focus.
' ========================================================================================
PUBLIC FUNCTION GetFocusedGroup (BYVAL hListView AS HWND) AS LONG
   RETURN SendMessageW(hListView, LVM_GETFOCUSEDGROUP, 0, 0)
END FUNCTION
' ========================================================================================

' ========================================================================================
' Gets the number of groups.
' ========================================================================================
PUBLIC FUNCTION GetGroupCount (BYVAL hListView AS HWND) AS LONG
   RETURN SendMessageW(hListView, LVM_GETGROUPCOUNT, 0, 0)
END FUNCTION
' ========================================================================================

' ========================================================================================
' Gets the group header image list that has been set for an existing list-view control.
' ========================================================================================
PUBLIC FUNCTION GetGroupHeaderImageList (BYVAL hListView AS HWND) AS HIMAGELIST
   RETURN CAST(HIMAGELIST, SendMessageW(hListView, LVM_GETIMAGELIST, LVSIL_GROUPHEADER, 0))
END FUNCTION
' ========================================================================================

' ========================================================================================
' Gets group information.
' ========================================================================================
PUBLIC FUNCTION GetGroupInfo OVERLOAD (BYVAL hListView AS HWND, BYVAL iGroupId AS LONG, BYVAL pgrp AS LVGROUP PTR) AS LONG
   IF pgrp = NULL THEN RETURN -1
   pgrp->cbSize = SIZEOF(LVGROUP)
   RETURN SendMessageW(hListView, LVM_GETGROUPINFO, iGroupId, CAST(LPARAM, pgrp))
END FUNCTION
' ========================================================================================
' ========================================================================================
PUBLIC FUNCTION GetGroupInfo OVERLOAD (BYVAL hListView AS HWND, BYVAL iGroupId AS LONG, BYREF grp AS LVGROUP) AS LONG
   IF VARPTR(grp) = NULL THEN RETURN -1
   grp.cbSize = SIZEOF(LVGROUP)
   RETURN SendMessageW(hListView, LVM_GETGROUPINFO, iGroupId, CAST(LPARAM, @grp))
END FUNCTION
' ========================================================================================

' ========================================================================================
' Gets information on a specified group.
' ========================================================================================
PUBLIC FUNCTION GetGroupInfoByIndex OVERLOAD (BYVAL hListView AS HWND, BYVAL iIndex AS LONG, BYREF pgrp AS LVGROUP PTR) AS BOOLEAN
   IF pgrp = NULL THEN RETURN FALSE
   pgrp->cbSize = SIZEOF(LVGROUP)
   RETURN SendMessageW(hListView, LVM_GETGROUPINFOBYINDEX, iIndex, CAST(LPARAM, pgrp))
END FUNCTION
' ========================================================================================
' ========================================================================================
PUBLIC FUNCTION GetGroupInfoByIndex OVERLOAD (BYVAL hListView AS HWND, BYVAL iIndex AS LONG, BYREF grp AS LVGROUP) AS BOOLEAN
   IF VARPTR(grp) = NULL THEN RETURN FALSE
   grp.cbSize = SIZEOF(LVGROUP)
   RETURN SendMessageW(hListView, LVM_GETGROUPINFOBYINDEX, iIndex, CAST(LPARAM, @grp))
END FUNCTION
' ========================================================================================

' ========================================================================================
' Gets information about the display of groups.
' ========================================================================================
PUBLIC SUB GetGroupMetrics OVERLOAD (BYVAL hListView AS HWND, BYVAL pGroupMetrics AS LVGROUPMETRICS PTR)
   IF pGroupMetrics = NULL THEN EXIT SUB
   pGroupMetrics->cbSize = SIZEOF(LVGROUPMETRICS)
   SendMessageW hListView, LVM_GETGROUPMETRICS, 0, CAST(LPARAM, pGroupMetrics)
END SUB
' ========================================================================================
' ========================================================================================
PUBLIC SUB GetGroupMetrics OVERLOAD (BYVAL hListView AS HWND, BYREF GroupMetrics AS LVGROUPMETRICS)
   IF VARPTR(GroupMetrics) = NULL THEN EXIT SUB
   GroupMetrics.cbSize = SIZEOF(LVGROUPMETRICS)
   SendMessageW hListView, LVM_GETGROUPMETRICS, 0, CAST(LPARAM, @GroupMetrics)
END SUB
' ========================================================================================

' ========================================================================================
' Gets the rectangle for a specified group.
' ========================================================================================
PUBLIC FUNCTION GetGroupRect OVERLOAD (BYVAL hListView AS HWND, BYVAL iGroupId AS LONG, BYVAL nType AS LONG, BYVAL prc AS RECT PTR) AS BOOLEAN
   RETURN SendMessageW(hListView, LVM_GETGROUPRECT, iGroupId, CAST(LPARAM, prc))
END FUNCTION
' ========================================================================================
' ========================================================================================
PUBLIC FUNCTION GetGroupRect OVERLOAD (BYVAL hListView AS HWND, BYVAL iGroupId AS LONG, BYVAL nType AS LONG, BYREF rc AS RECT) AS BOOLEAN
   rc.Top = nType
   RETURN SendMessageW(hListView, LVM_GETGROUPRECT, iGroupId, CAST(LPARAM, @rc))
END FUNCTION
' ========================================================================================
' ========================================================================================
'PUBLIC FUNCTION ListView.GetGroupRect OVERLOAD (BYVAL hListView AS HWND, BYVAL iGroupId AS LONG, BYVAL nType AS LONG) AS RECT
'   DIM rc AS RECT
'   rc.Top = nType
'   SendMessageW(hListView, LVM_GETGROUPRECT, iGroupId, CAST(LPARAM, @rc))
'   RETURN rc
'END FUNCTION
' ========================================================================================
' ========================================================================================
PUBLIC FUNCTION GetGroupRect OVERLOAD (BYVAL hListView AS HWND, BYVAL iGroupId AS LONG, BYVAL nType AS LONG) AS (LONG, LONG, LONG, LONG)
   DIM rc AS RECT
   rc.Top = nType
   SetLastError(SendMessageW(hListView, LVM_GETGROUPRECT, iGroupId, CAST(LPARAM, @rc)))
   RETURN (rc.left, rc.top, rc.right, rc.bottom)
END FUNCTION
' ========================================================================================

' ========================================================================================
' Gets the state for a specified group.
' ========================================================================================
PUBLIC FUNCTION GetGroupState (BYVAL hListView AS HWND, BYVAL dwGroupId AS UINT, BYVAL dwMask AS UINT) AS UINT
   RETURN SendMessageW(hListView, LVM_GETGROUPSTATE, dwGroupId, dwMask)
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Gets the handle to the header control used by a list-view control.
' ========================================================================================
PUBLIC FUNCTION GetHeader (BYVAL hListView AS HWND) AS HWND
   RETURN CAST(HWND, SendMessageW(hListView, LVM_GETHEADER, 0, 0))
END FUNCTION
' ========================================================================================

' ========================================================================================
' Gets the HCURSOR used when the pointer is over an item while hot tracking is enabled.
' ========================================================================================
PUBLIC FUNCTION GetHotCursor (BYVAL hListView AS HWND) AS HCURSOR
   RETURN CAST(HCURSOR, SendMessageW(hListView, LVM_GETHOTCURSOR, 0, 0))
END FUNCTION
' ========================================================================================

' ========================================================================================
' Gets the index of the hot item.
' ========================================================================================
PUBLIC FUNCTION GetHotItem (BYVAL hListView AS HWND) AS LONG
   RETURN SendMessageW(hListView, LVM_GETHOTITEM, 0, 0)
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Gets the amount of time that the mouse cursor must hover over an item before it is selected.
' ========================================================================================
PUBLIC FUNCTION GetHoverTime (BYVAL hListView AS HWND) AS DWORD
   RETURN SendMessageW(hListView, LVM_GETHOVERTIME, 0, 0)
END FUNCTION
' ========================================================================================

' ========================================================================================
' Gets the handle to an image list used for drawing list-view items.
' ========================================================================================
PUBLIC FUNCTION GetImageList (BYVAL hListView AS HWND, BYVAL iImageList AS LONG) AS HIMAGELIST
