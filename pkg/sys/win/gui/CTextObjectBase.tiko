#module "gui"
#import "sys/win"
#include once "richedit.ti"
using win

#include once "windows.bi"
#include once "win/ole2.bi"
#include once "win/richedit.bi"
#include once "win/richole.bi"

' ########################################################################################
' CTextObjectBase class
' ########################################################################################
PUBLIC TYPE CTextObjectBase

   DIM m_Result AS LONG

   DECLARE CONSTRUCTOR
   DECLARE DESTRUCTOR
   DECLARE FUNCTION GetLastResult () AS LONG
   DECLARE FUNCTION SetResult (BYVAL Result AS LONG) AS LONG
   DECLARE FUNCTION GetErrorInfo (BYVAL dwError AS LONG = -1) AS USTRING

END TYPE
' ########################################################################################

' ========================================================================================
' Default constructor
' ========================================================================================
CONSTRUCTOR CTextObjectBase
END CONSTRUCTOR
' ========================================================================================

' ===========================================================================================
' Destructor
' ===========================================================================================
DESTRUCTOR CTextObjectBase
END DESTRUCTOR
' ===========================================================================================

' ========================================================================================
' Returns the last result code
' ========================================================================================
FUNCTION CTextObjectBase.GetLastResult () AS HRESULT
   RETURN m_Result
END FUNCTION
' ========================================================================================

' ========================================================================================
' Sets the last result code.
' ========================================================================================
FUNCTION CTextObjectBase.SetResult (BYVAL Result AS HRESULT) AS HRESULT
   m_Result = Result
   RETURN m_Result
END FUNCTION
' ========================================================================================

' ========================================================================================
' Returns a description of the last result code.
' ========================================================================================
FUNCTION CTextObjectBase.GetErrorInfo (BYVAL nError AS LONG = -1) AS USTRING
   IF nError = -1 THEN nError = m_Result
   DIM cbLen AS DWORD, pBuffer AS WSTRING PTR, ustrMsg AS USTRING
   cbLen = FormatMessageW(FORMAT_MESSAGE_ALLOCATE_BUFFER OR _
           FORMAT_MESSAGE_FROM_SYSTEM OR FORMAT_MESSAGE_IGNORE_INSERTS, _
           NULL, nError, BYVAL MAKELANGID(LANG_NEUTRAL, SUBLANG_DEFAULT), _
           cast(LPWSTR, @pBuffer), 0, NULL)
   IF cbLen THEN
      ustrMsg = *pBuffer
      LocalFree pBuffer
   END IF
   IF nError THEN ustrMsg = "Error &h" & HEX(nError) & CHR(13, 10) & ustrMsg
   RETURN ustrMsg
END FUNCTION
' ========================================================================================
