' fbx/richedit (pkg/fbx): every header the module's files include, and the
' macros more than one of its files uses.
#pragma once

#include once "windows.bi"
#include once "win/richole.bi"
#include once "win/ole2.bi"
#include once "win/richedit.bi"

#ifndef _CREC_DEBUG_
   #define _CREC_DEBUG_ 0
#endif
#ifndef _CREC_DP_
   #MACRO CREC_DP(st)
      #IF (_CREC_DEBUG_ = 1)
         OutputDebugStringW(__FUNCTION__ + ": " + st)
      #ENDIF
   #ENDMACRO
#endif
