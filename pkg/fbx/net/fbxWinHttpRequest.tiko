' ########################################################################################

#ifndef __IWinHttpRequestEvents_INTERFACE_DEFINED__
#define __IWinHttpRequestEvents_INTERFACE_DEFINED__

PUBLIC TYPE IWinHttpRequestEvents_ EXTENDS fbx_IUnknown

   DECLARE ABSTRACT SUB OnResponseStart (BYVAL Status AS LONG, BYVAL ContentType AS FBX_BSTR)
   DECLARE ABSTRACT SUB OnResponseDataAvailable (BYVAL pData AS SAFEARRAY PTR)
   DECLARE ABSTRACT SUB OnResponseFinished ()
   DECLARE ABSTRACT SUB OnError (BYVAL ErrorNumber AS LONG, BYVAL ErrorDescription AS FBX_BSTR)

END TYPE

PUBLIC TYPE LPWINHTTPREQUESTEVENTS AS IWinHttpRequestEvents_ PTR
#endif
