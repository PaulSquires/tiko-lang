#module "adodb"
#import "fbx/com"
#import "fbx/core"
#include once "adodb.ti"
using com
using core

#include once "windows.bi"
#include once "win/ole2.bi"
#include once "win/unknwnbase.bi"
#include once "win/ocidl.bi"

#ifndef __IDataSource_INTERFACE_DEFINED__
#define __IDataSource_INTERFACE_DEFINED__

PUBLIC TYPE IDataSource_ EXTENDS fbx_IDispatch
   DECLARE ABSTRACT FUNCTION get_SourceClass (BYVAL varSourceClass AS FBX_BSTR PTR) AS HRESULT
   DECLARE ABSTRACT FUNCTION get_Source (BYVAL varSource AS fbx_IUnknown PTR PTR) AS HRESULT
   DECLARE ABSTRACT FUNCTION get_IsDirty (BYVAL pIsDirty AS VARIANT_BOOL PTR) AS HRESULT
   DECLARE ABSTRACT FUNCTION put_IsDirty (BYVAL pIsDirty AS VARIANT_BOOL) AS HRESULT
   DECLARE ABSTRACT FUNCTION get_SourceURL (BYVAL varSourceURL AS FBX_BSTR PTR) AS HRESULT
   DECLARE ABSTRACT FUNCTION get_ActiveConnection (BYVAL varActiveConnection AS AdoConnection PTR PTR) AS HRESULT
   DECLARE ABSTRACT FUNCTION SaveToObject (BYVAL Source AS fbx_IUnknown PTR, BYVAL InterfaceName AS FBX_BSTR) AS HRESULT
   DECLARE ABSTRACT FUNCTION OpenObject (BYVAL Source AS fbx_IUnknown PTR, BYVAL InterfaceName AS FBX_BSTR) AS HRESULT
   DECLARE ABSTRACT FUNCTION SaveTo (BYVAL SourceURL AS FBX_BSTR, BYVAL ActiveConnection AS fbx_IDispatch PTR, BYVAL Mode AS ConnectModeEnum, BYVAL CreateOptions AS RecordCreateOptionsEnum, BYVAL Options AS RecordOpenOptionsEnum, BYVAL UserName AS FBX_BSTR, BYVAL Password AS FBX_BSTR) AS HRESULT
   DECLARE ABSTRACT FUNCTION Open (BYVAL SourceURL AS FBX_BSTR, BYVAL ActiveConnection AS fbx_IDispatch PTR, BYVAL Mode AS ConnectModeEnum, BYVAL CreateOptions AS RecordCreateOptionsEnum = -1, BYVAL Options AS RecordOpenOptionsEnum, BYVAL UserName AS FBX_BSTR, BYVAL Password AS FBX_BSTR) AS HRESULT
   DECLARE ABSTRACT FUNCTION Save () AS HRESULT
   DECLARE ABSTRACT FUNCTION SaveToContainer (BYVAL ContainerURL AS FBX_BSTR, BYVAL ActiveConnection AS fbx_IDispatch PTR, BYVAL Mode AS ConnectModeEnum, BYVAL CreateOptions AS RecordCreateOptionsEnum, BYVAL Options AS RecordOpenOptionsEnum, BYVAL UserName AS FBX_BSTR, BYVAL Password AS FBX_BSTR) AS HRESULT
END TYPE

#endif
