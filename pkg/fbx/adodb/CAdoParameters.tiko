' ########################################################################################
' CAdoParameter class
' ########################################################################################
#module "adodb"
#import "fbx/com"
#import "fbx/core"
#include once "adodb.ti"
using com
using core

PUBLIC TYPE CAdoParameter EXTENDS CAdoBase

   m_Result AS HRESULT
   m_pParameter AS ADOParameter PTR

   DECLARE CONSTRUCTOR
   DECLARE CONSTRUCTOR (BYVAL pParameter AS ADOParameter PTR, BYVAL fAddRef AS BOOLEAN = FALSE)
   DECLARE DESTRUCTOR
'   DECLARE OPERATOR @ () AS ADOParameter PTR PTR
   DECLARE FUNCTION vptr () AS ADOParameter PTR PTR

   ' // Attaches a reference to an ADOParameter object to the class
   DECLARE SUB Attach (BYVAL pParameter AS ADOParameter PTR, BYVAL fAddRef AS BOOLEAN = FALSE)
   ' // Sets or retrieves the name of a parameter
   DECLARE PROPERTY Name () AS USTRING
   DECLARE PROPERTY Name (BYREF wszName AS WSTRING)
   ' // Sets or returns a Variant value that indicates the value of the object
   DECLARE PROPERTY Value () AS DVARIANT
   DECLARE PROPERTY Value (BYREF dvValue AS DVARIANT)
   ' // Indicates the operational type or data type of a Property object.
   DECLARE PROPERTY Type_ () AS DataTypeEnum
   ' // Indicates one or more characteristics of an object.
   DECLARE PROPERTY Attributes () AS LONG
   DECLARE PROPERTY Attributes (BYVAL lAttr AS LONG)
   ' // Appends data to a parameter object
   DECLARE FUNCTION AppendChunk (BYREF dvData AS DVARIANT) AS HRESULT
   ' // Indicates whether the Parameter represents an input parameter, an output parameter,
   ' // an input and an output parameter, or if the parameter is the Return value from a stored procedure.
   DECLARE PROPERTY Direction (BYVAL lParmDirection AS ParameterDirectionEnum)
   DECLARE PROPERTY Direction () AS ParameterDirectionEnum
   ' // Indicates the scale of numeric values in a parameter.
   DECLARE PROPERTY NumericScale () AS BYTE
   DECLARE PROPERTY NumericScale (BYVAL bScale AS BYTE)
   ' // Indicates the degree of precision for numeric values in a Parameter object.
   DECLARE PROPERTY Precision () AS BYTE
   DECLARE PROPERTY Precision (BYVAL bPrecision AS BYTE)
   ' // Returns a reference to the Properties collection.
   DECLARE PROPERTY Properties () AS ADOProperties PTR
   ' // Sets or returns a Long value that indicates the maximum size in bytes or characters of a value in a Parameter object.
   DECLARE PROPERTY Size () AS LONG
   DECLARE PROPERTY Size (BYVAL lSize AS LONG)

END TYPE
' ########################################################################################

' ========================================================================================
' Default constructor
' ========================================================================================
CONSTRUCTOR CAdoParameter
   CADODB_DP("BEGIN - Default")
   ' // Create an instance of the Record object
   m_pParameter = fbxNewCom("ADODB.Parameter")
   CADODB_DP("END - " & WSTR(m_pParameter))
END CONSTRUCTOR
' ========================================================================================
' ========================================================================================
CONSTRUCTOR CAdoParameter (BYVAL pParameter AS ADOParameter PTR, BYVAL fAddRef AS BOOLEAN = FALSE)
   CADODB_DP("ADOParameter")
   m_pParameter = pParameter
   IF fAddRef THEN
      IF m_pParameter THEN m_pParameter->AddRef
   END IF
END CONSTRUCTOR
' ========================================================================================

' ===========================================================================================
' Cleanup
' ===========================================================================================
DESTRUCTOR CAdoParameter
   CADODB_DP(WSTR(m_pParameter))
   IF m_pParameter THEN m_pParameter->Release
END DESTRUCTOR
' ===========================================================================================

' ========================================================================================
' Returns the address of the connection pointer
' ========================================================================================
'PRIVATE OPERATOR CAdoParameter.@ () AS ADOParameter PTR PTR
'   OPERATOR = @m_pParameter
'END OPERATOR
' ========================================================================================
' ========================================================================================
FUNCTION CAdoParameter.vptr () AS ADOParameter PTR PTR
   CADODB_DP("")
   IF m_pParameter THEN m_pParameter->Release   ' ???
   RETURN @m_pParameter
END FUNCTION
' ========================================================================================

' ========================================================================================
' Returns the encapsulated IDispatch pointer
' ========================================================================================
PUBLIC OPERATOR * (BYREF cProperty AS CAdoParameter) AS ADOParameter PTR
   OPERATOR = cProperty.m_pParameter
END OPERATOR
' ========================================================================================

' ===========================================================================================
' Attaches a reference to an ADOCommand object to the class
' ===========================================================================================
SUB CAdoParameter.Attach (BYVAL pParameter AS ADOParameter PTR, BYVAL fAddRef AS BOOLEAN = FALSE)
   CADODB_DP("")
   IF m_pParameter THEN m_pParameter->Release
   m_pParameter = pParameter
   ' // Increase the reference count
   IF fAddRef THEN
      IF m_pParameter THEN m_pParameter->AddRef
   END IF
END SUB
' ===========================================================================================

' ===========================================================================================
' Sets or tetrieves the name of a parameter
' ===========================================================================================
PROPERTY CAdoParameter.Name () AS USTRING
   CADODB_DP("")
   DIM bstrName AS FBX_BSTR
   IF m_pParameter THEN SetResult(m_pParameter->get_Name(@bstrName))
   DIM ustrName AS USTRING = *bstrName
   RETURN ustrName
END PROPERTY
' ===========================================================================================
' ===========================================================================================
PROPERTY CAdoParameter.Name (BYREF wszName AS WSTRING)
   CADODB_DP("")
   DIM bstrName AS FBX_BSTR = SysAllocString(wszName)
   IF m_pParameter THEN SetResult(m_pParameter->put_Name(bstrName))
   SysFreeString bstrName
END PROPERTY
' ===========================================================================================

' ===========================================================================================
' Indicates the operational type or data type of a parameter.
' ===========================================================================================
PROPERTY CAdoParameter.Value () AS DVARIANT
   CADODB_DP("")
   DIM dvValue AS DVARIANT
   IF m_pParameter THEN SetResult(m_pParameter->get_Value(dvValue))
   RETURN dvValue
END PROPERTY
' ===========================================================================================

' ===========================================================================================
' Indicates the operational type or data type of a parameter.
' ===========================================================================================
PROPERTY CAdoParameter.Value (BYREF dvValue AS DVARIANT)
   CADODB_DP("")
   IF m_pParameter THEN SetResult(m_pParameter->put_Value(dvValue))
END PROPERTY
' ===========================================================================================

' ===========================================================================================
' Indicates the operational type or data type of a Parameter object.
' ===========================================================================================
PROPERTY CAdoParameter.Type_ () AS DataTypeEnum
   CADODB_DP("")
   DIM nType AS DataTypeEnum
   IF m_pParameter THEN SetResult(m_pParameter->get_Type(@nType))
   RETURN nType
END PROPERTY
' ===========================================================================================

' ===========================================================================================
' Indicates the operational type or data type of a parameter.
' ===========================================================================================
PROPERTY CAdoParameter.Attributes () AS LONG
   CADODB_DP("")
   DIM lAttr AS LONG
   IF m_pParameter THEN SetResult(m_pParameter->get_Attributes(@lAttr))
   RETURN lAttr
END PROPERTY
' ===========================================================================================

' ===========================================================================================
' Indicates the operational type or data type of a parameter.
' ===========================================================================================
PROPERTY CAdoParameter.Attributes (BYVAL lAttr AS LONG)
   CADODB_DP("")
   IF m_pParameter THEN SetResult(m_pParameter->put_Attributes(lAttr))
END PROPERTY
' ===========================================================================================

' ===========================================================================================
' Appends data to a Parameter object.
' ===========================================================================================
FUNCTION CAdoParameter.AppendChunk (BYREF dvData AS DVARIANT) AS HRESULT
   CADODB_DP("")
   IF m_pParameter THEN SetResult(m_pParameter->AppendChunk(dvData))
   RETURN m_Result
END FUNCTION
' ===========================================================================================

' ===========================================================================================
' // Indicates whether the Parameter represents an input parameter, an output parameter,
' // an input and an output parameter, or if the parameter is the Return value from a stored procedure.
' ===========================================================================================
PROPERTY CAdoParameter.Direction (BYVAL lParmDirection AS ParameterDirectionEnum)
   CADODB_DP("")
   IF m_pParameter THEN SetResult(m_pParameter->put_Direction(lParmDirection))
END PROPERTY
' ===========================================================================================
' ===========================================================================================
PROPERTY CAdoParameter.Direction () AS ParameterDirectionEnum
   CADODB_DP("")
   DIM lParmDirection AS ParameterDirectionEnum
   IF m_pParameter THEN SetResult(m_pParameter->get_Direction(@lParmDirection))
   RETURN lParmDirection
END PROPERTY
' ===========================================================================================

' ===========================================================================================
' Indicates the data capacity of a parameter.
' ===========================================================================================
PROPERTY CAdoParameter.NumericScale () AS BYTE
   CADODB_DP("")
   DIM bScale AS BYTE
   IF m_pParameter THEN SetResult(m_pParameter->get_NumericScale(@bScale))
   RETURN bScale
END PROPERTY
' ===========================================================================================

' ===========================================================================================
' Indicates the data capacity of a parameter.
' ===========================================================================================
PROPERTY CAdoParameter.NumericScale (BYVAL bScale AS BYTE)
   CADODB_DP("")
   IF m_pParameter THEN SetResult(m_pParameter->put_NumericScale(bScale))
END PROPERTY
' ===========================================================================================

' ===========================================================================================
' Indicates the degree of precision for numeric values in a Parameter object.
' ===========================================================================================
PROPERTY CAdoParameter.Precision () AS BYTE
   CADODB_DP("")
   DIM bPrecision AS BYTE
   IF m_pParameter THEN SetResult(m_pParameter->get_Precision(@bPrecision))
   RETURN bPrecision
END PROPERTY
' ===========================================================================================

' ===========================================================================================
' Indicates the degree of precision for numeric values for numeric parameters.
' ===========================================================================================
PROPERTY CAdoParameter.Precision (BYVAL bPrecision AS BYTE)
   CADODB_DP("")
   IF m_pParameter THEN SetResult(m_pParameter->put_Precision(bPrecision))
END PROPERTY
' ===========================================================================================

' ===========================================================================================
' Returns a reference to the Properties collection.
' ===========================================================================================
PROPERTY CAdoParameter.Properties () AS ADOProperties PTR
   CADODB_DP("")
   DIM pProperties AS ADOProperties PTR
   IF m_pParameter THEN SetResult(m_pParameter->get_Properties(@pProperties))
   RETURN pProperties
END PROPERTY
' ===========================================================================================

' ===========================================================================================
' Sets or returns a Long value that indicates the maximum size in bytes or characters of a
' value in a Parameter object.
' ===========================================================================================
PROPERTY CAdoParameter.Size () AS LONG
   CADODB_DP("")
   DIM lSize AS LONG
   IF m_pParameter THEN SetResult(m_pParameter->get_Size(@lSize))
   RETURN lSize
END PROPERTY
' ===========================================================================================
' ===========================================================================================
PROPERTY CAdoParameter.Size (BYVAL lSize AS LONG)
   CADODB_DP("")
   IF m_pParameter THEN SetResult(m_pParameter->put_Size(lSize))
END PROPERTY
' ===========================================================================================


' ########################################################################################
' CAdoParameters class
' ########################################################################################
PUBLIC TYPE CAdoParameters EXTENDS CAdoBase

   m_Result AS HRESULT
   m_pParameters AS ADOParameters PTR

   DECLARE CONSTRUCTOR
   DECLARE CONSTRUCTOR (BYVAL pParameters AS ADOParameters PTR, BYVAL fAddRef AS BOOLEAN = FALSE)
   DECLARE DESTRUCTOR
'   DECLARE OPERATOR @ () AS ADOParameters PTR PTR
   DECLARE FUNCTION vptr () AS ADOParameters PTR PTR

   ' // Attaches a reference to an ADOParameters object to the class
   DECLARE SUB Attach (BYVAL pParameters AS ADOParameters PTR, BYVAL fAddRef AS BOOLEAN = FALSE)
   ' // Retrieves the number of parameters
   DECLARE PROPERTY Count () AS LONG
   ' // Indicates a specific member of the Parameters collection, by name or ordinal number.
   DECLARE PROPERTY Item (BYREF dvIndex AS DVARIANT) AS ADOParameter PTR
   ' // Returns a reference to the collection's enumerator.
   DECLARE FUNCTION NewEnum () AS fbx_IUnknown PTR
   ' // Refreshes the contents of the Properties collection.
   DECLARE FUNCTION Refresh () AS HRESULT
   ' // Appends an object to the Parameters collection.
   DECLARE FUNCTION Append (BYVAL pObject AS fbx_IDispatch PTR) AS HRESULT
   DECLARE FUNCTION Append (BYREF pParam AS CAdoParameter) AS HRESULT
   ' // Deletes an object from the Parameters collection.
   DECLARE FUNCTION Delete_ (BYREF dvIndex AS DVARIANT) AS HRESULT

END TYPE
' ########################################################################################

' ========================================================================================
' Default constructor
' ========================================================================================
CONSTRUCTOR CAdoParameters
   CADODB_DP("Default")
END CONSTRUCTOR
' ========================================================================================

' ========================================================================================
' Default constructor
' ========================================================================================
CONSTRUCTOR CAdoParameters (BYVAL pParameters AS ADOParameters PTR, BYVAL fAddRef AS BOOLEAN = FALSE)
   CADODB_DP("ADOParameters")
   IF pParameters THEN
      m_pParameters = pParameters
      IF fAddRef THEN m_pParameters->AddRef
   END IF
END CONSTRUCTOR
' ========================================================================================

' ===========================================================================================
' Cleanup
' ===========================================================================================
DESTRUCTOR CAdoParameters
   CADODB_DP(WSTR(m_pParameters))
   IF m_pParameters THEN m_pParameters->Release
END DESTRUCTOR
' ===========================================================================================

' ========================================================================================
' Returns the address of the connection pointer
' ========================================================================================
'PRIVATE OPERATOR CAdoParameters.@ () AS ADOParameters PTR PTR
'   OPERATOR = @m_pParameters
'END OPERATOR
' ========================================================================================
' ========================================================================================
FUNCTION CAdoParameters.vptr () AS ADOParameters PTR PTR
   CADODB_DP("")
   IF m_pParameters THEN m_pParameters->Release
   RETURN @m_pParameters
END FUNCTION
' ========================================================================================

' ========================================================================================
' Returns the encapsulated IDispatch pointer
' ========================================================================================
PUBLIC OPERATOR * (BYREF cParameters AS CAdoParameters) AS ADOParameters PTR
   OPERATOR = cParameters.m_pParameters
END OPERATOR
' ========================================================================================

' ===========================================================================================
' Attaches a reference to an ADOParameters object to the class
' ===========================================================================================
SUB CAdoParameters.Attach (BYVAL pParameters AS ADOParameters PTR, BYVAL fAddRef AS BOOLEAN = FALSE)
   CADODB_DP("")
   IF m_pParameters THEN m_pParameters->Release
   m_pParameters = pParameters
   ' // Increase the reference count
   IF fAddRef THEN
      IF m_pParameters THEN m_pParameters->AddRef
   END IF
END SUB
' ===========================================================================================

' ===========================================================================================
' Retrieves the number of parameters
' ===========================================================================================
PROPERTY CAdoParameters.Count () AS LONG
   CADODB_DP("")
   DIM nCount AS LONG
   IF m_pParameters THEN SetResult(m_pParameters->get_Count(@nCount))
   RETURN nCount
END PROPERTY
' ===========================================================================================

' ===========================================================================================
' Indicates a specific member of the Parameters collection, by name or ordinal number.
' ===========================================================================================
PROPERTY CAdoParameters.Item (BYREF dvIndex AS DVARIANT) AS ADOParameter PTR
   CADODB_DP("")
   DIM pParameter AS ADOParameter PTR
   IF m_pParameters THEN SetResult(m_pParameters->get_Item(dvIndex, @pParameter))
   RETURN pParameter
END PROPERTY
' ===========================================================================================

' ===========================================================================================
' Returns a reference to the collection's enumerator.
' ===========================================================================================
FUNCTION CAdoParameters.NewEnum () AS fbx_IUnknown PTR
   CADODB_DP("")
   DIM pUnk AS fbx_IUnknown PTR
   IF m_pParameters THEN SetResult(m_pParameters->_NewEnum(@pUnk))
   RETURN pUnk
END FUNCTION
' ===========================================================================================

' ===========================================================================================
' Refreshes the contents of the Properties collection.
' ===========================================================================================
FUNCTION CAdoParameters.Refresh () AS HRESULT
   CADODB_DP("")
   IF m_pParameters THEN RETURN(SetResult(m_pParameters->Refresh))
END FUNCTION
' ===========================================================================================

' ===========================================================================================
' Appends an object to the collection.
' ===========================================================================================
FUNCTION CAdoParameters.Append (BYVAL pObject AS fbx_IDispatch PTR) AS HRESULT
   CADODB_DP("pObject")
   IF m_pParameters THEN RETURN(SetResult(m_pParameters->Append(pObject)))
END FUNCTION
' ===========================================================================================
' ===========================================================================================
' Appends a parameter to the collection.
' ===========================================================================================
FUNCTION CAdoParameters.Append (BYREF pParam AS CAdoParameter) AS HRESULT
   CADODB_DP("CAdoParameter")
   IF m_pParameters THEN RETURN(SetResult(m_pParameters->Append(cast(ANY PTR, pParam.m_pParameter))))
END FUNCTION
' ===========================================================================================

' ===========================================================================================
' Deletes an object from the Parameters collection.
' ===========================================================================================
FUNCTION CAdoParameters.Delete_ (BYREF dvIndex AS DVARIANT) AS HRESULT
   CADODB_DP("")
   IF m_pParameters THEN RETURN(SetResult(m_pParameters->Delete_(dvIndex)))
END FUNCTION
' ===========================================================================================
