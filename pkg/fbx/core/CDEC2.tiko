#module "core"
#include once "core.ti"

#include once "windows.bi"
#include once "win/ole2.bi"

' ========================================================================================
' Helper to round the internal decimal to 2 decimals
' ========================================================================================
PUBLIC SUB CDEC2_Round2Decimals(BYREF dec AS DECIMAL)
   DIM rounded AS DECIMAL
   VarDecRound(@dec, 2, @rounded)
   dec = rounded
END SUB
' ========================================================================================

PUBLIC TYPE CDEC2

Public:
   m_dec AS DECIMAL   ' // The underlying DECIMAL structure
   m_lcid AS LCID     ' // The locale id

Public:
   DECLARE CONSTRUCTOR ' (BYVAL lcid AS LCID = 0)
   DECLARE CONSTRUCTOR (BYREF cSrc AS CDEC2, BYVAL lcid AS LCID = 0)
   DECLARE CONSTRUCTOR (BYREF decSrc AS DECIMAL, BYVAL lcid AS LCID = 0)
   DECLARE CONSTRUCTOR (BYVAL cySrc AS CURRENCY, BYVAL lcid AS LCID = 0)
   DECLARE CONSTRUCTOR (BYVAL nInteger AS LONGINT, BYVAL lcid AS LCID = 0)
   DECLARE CONSTRUCTOR (BYVAL nUInteger AS ULONGINT, BYVAL lcid AS LCID = 0)
   DECLARE CONSTRUCTOR (BYVAL dSrc AS DOUBLE, BYVAL lcid AS LCID = 0)
   DECLARE CONSTRUCTOR (BYREF wszSrc AS WSTRING, BYVAL lcid AS LCID = 0, BYVAL dwFlags AS ULONG = 0)
   DECLARE CONSTRUCTOR (BYVAL pDispSrc AS IDispatch PTR, BYVAL lcid AS LCID = 0)
   DECLARE CONSTRUCTOR (BYVAL varSrc AS VARIANT, BYVAL lcid AS LCID = 0)
   DECLARE DESTRUCTOR
   DECLARE OPERATOR LET (BYREF cSrc AS CDEC2)
   DECLARE OPERATOR += (BYREF dec AS CDEC2)
   DECLARE OPERATOR -= (BYREF dec AS CDEC2)
   DECLARE OPERATOR *= (BYREF dec AS CDEC2)
   DECLARE OPERATOR /= (BYREF cOperand AS CDEC2)
   DECLARE OPERATOR CAST () AS CURRENCY
   DECLARE OPERATOR CAST () AS VARIANT
   DECLARE OPERATOR CAST () AS STRING
   DECLARE FUNCTION DecAbs () AS CDEC2
   DECLARE FUNCTION DecFix () AS CDEC2
   DECLARE FUNCTION DecInt () AS CDEC2
   DECLARE FUNCTION DecRound (BYVAL nDecimals AS LONG) AS CDEC2
   DECLARE FUNCTION ToVar () AS VARIANT
   DECLARE FUNCTION Scale () AS UBYTE
   DECLARE FUNCTION Sign () AS UBYTE
   DECLARE FUNCTION IsSigned () AS BOOLEAN
   DECLARE FUNCTION IsUnsigned () AS BOOLEAN

END TYPE
' ========================================================================================

' ========================================================================================
' CDEC2 constructors
' ========================================================================================
CONSTRUCTOR CDEC2 ' (BYVAL lcid AS LCID = 0)
'   m_lcid = lcid
'   m_lcid = LOCALE_USER_DEFAULT
END CONSTRUCTOR
' ========================================================================================
CONSTRUCTOR CDEC2 (BYREF cSrc AS CDEC2, BYVAL lcid AS LCID = 0)
   m_lcid = lcid
   m_dec = cSrc.m_dec
   CDEC2_Round2Decimals(m_dec)
END CONSTRUCTOR
' ========================================================================================
CONSTRUCTOR CDEC2 (BYREF decSrc AS DECIMAL, BYVAL lcid AS LCID = 0)
   m_lcid = lcid
   m_dec = decSrc
   CDEC2_Round2Decimals(m_dec)
END CONSTRUCTOR
' ========================================================================================
CONSTRUCTOR CDEC2 (BYVAL cySrc AS CURRENCY, BYVAL lcid AS LCID = 0)
   m_lcid = lcid
   SetLastError(VarDecFromCy(cySrc, @m_dec))
   CDEC2_Round2Decimals(m_dec)
END CONSTRUCTOR
' ========================================================================================
CONSTRUCTOR CDEC2 (BYVAL nInteger AS LONGINT, BYVAL lcid AS LCID = 0)
   m_lcid = lcid
   SetLastError(VarDecFromI8(nInteger, @m_dec))
   CDEC2_Round2Decimals(m_dec)
END CONSTRUCTOR
' ========================================================================================
CONSTRUCTOR CDEC2 (BYVAL nUInteger AS ULONGINT, BYVAL lcid AS LCID = 0)
   m_lcid = lcid
   SetLastError(VarDecFromUI8(nUInteger, @m_dec))
   CDEC2_Round2Decimals(m_dec)
END CONSTRUCTOR
' ========================================================================================
CONSTRUCTOR CDEC2 (BYVAL dSrc AS DOUBLE, BYVAL lcid AS LCID = 0)
   m_lcid = lcid
   SetLastError(VarDecFromR8(dSrc, @m_dec))
   CDEC2_Round2Decimals(m_dec)
END CONSTRUCTOR
' ========================================================================================
CONSTRUCTOR CDEC2 (BYREF wszSrc AS WSTRING, BYVAL lcid AS LCID = 0, BYVAL dwFlags AS ULONG = 0)
   m_lcid = lcid
   SetLastError(VarDecFromStr(@wszSrc, lcid, dwFlags, @m_dec))
   CDEC2_Round2Decimals(m_dec)
END CONSTRUCTOR
' ========================================================================================
CONSTRUCTOR CDEC2 (BYVAL pDispSrc AS IDispatch PTR, BYVAL lcid AS LCID = 0)
   m_lcid = lcid
   SetLastError(VarDecFromDisp(pDispSrc, lcid, @m_dec))
   CDEC2_Round2Decimals(m_dec)
END CONSTRUCTOR
' ========================================================================================
CONSTRUCTOR CDEC2 (BYVAL varSrc AS VARIANT, BYVAL lcid AS LCID = 0)
   m_lcid = lcid
   DIM v AS VARIANT
   DIM hr AS HRESULT = VariantChangeType(@v, @varSrc, 0, VT_DECIMAL)
   IF FAILED(hr) THEN EXIT CONSTRUCTOR
   m_dec = v.decVal
   CDEC2_Round2Decimals(m_dec)
END CONSTRUCTOR
' ========================================================================================

DESTRUCTOR CDEC2
END DESTRUCTOR

' ========================================================================================
' Assignment and arithmetic operators
' ========================================================================================
OPERATOR CDEC2.LET (BYREF cSrc AS CDEC2)
   m_dec = cSrc.m_dec
   CDEC2_Round2Decimals(m_dec)
END OPERATOR
OPERATOR CDEC2.+= (BYREF decSrc AS CDEC2)
   SetLastError(VarDecAdd(@m_dec, @decSrc.m_dec, @m_dec))
   CDEC2_Round2Decimals(m_dec)
END OPERATOR
OPERATOR CDEC2.-= (BYREF decSrc AS CDEC2)
   SetLastError(VarDecSub(@m_dec, @decSrc.m_dec, @m_dec))
   CDEC2_Round2Decimals(m_dec)
END OPERATOR
OPERATOR CDEC2.*= (BYREF decSrc AS CDEC2)
   SetLastError(VarDecMul(@m_dec, @decSrc.m_dec, @m_dec))
   CDEC2_Round2Decimals(m_dec)
END OPERATOR
OPERATOR CDEC2./= (BYREF cOperand AS CDEC2)
   SetLastError(VarDecDiv(@m_dec, @cOperand.m_dec, @m_dec))
   CDEC2_Round2Decimals(m_dec)
END OPERATOR

' ========================================================================================
' Cast operators.
' ========================================================================================
OPERATOR CDEC2.CAST () AS CURRENCY
   DIM cy AS CURRENCY
   VarCyFromDec(@m_dec, @cy)
   OPERATOR = cy
END OPERATOR
OPERATOR CDEC2.CAST () AS VARIANT
   DIM v AS VARIANT
   v.decVal = m_dec
   v.vt = VT_DECIMAL
   RETURN v
END OPERATOR
OPERATOR CDEC2.CAST () AS STRING
   DIM bstrOut AS BSTR
   VarBstrFromDec(@m_dec, m_lcid, 0, @bstrOut)
   DIM s AS STRING = *cast(WSTRING PTR, bstrOut)
   SysFreeString(bstrOut)
   OPERATOR = s
END OPERATOR

' ========================================================================================
' All returning functions/operators round result to 2 decimals
' ========================================================================================
FUNCTION CDEC2.DecAbs () AS CDEC2
   DIM dec AS DECIMAL
   SetLastError(VarDecAbs(@m_dec, @dec))
   CDEC2_Round2Decimals(dec)
   RETURN dec
END FUNCTION

FUNCTION CDEC2.DecFix () AS CDEC2
   DIM dec AS DECIMAL
   SetLastError(VarDecFix(@m_dec, @dec))
   CDEC2_Round2Decimals(dec)
   RETURN dec
END FUNCTION

FUNCTION CDEC2.DecInt () AS CDEC2
   DIM dec AS DECIMAL
   SetLastError(VarDecInt(@m_dec, @dec))
   CDEC2_Round2Decimals(dec)
   RETURN dec
END FUNCTION

FUNCTION CDEC2.DecRound (BYVAL nDecimals AS LONG) AS CDEC2
   ' Ignore nDecimals, always round to 2
   DIM dec AS DECIMAL
   SetLastError(VarDecRound(@m_dec, 2, @dec))
   RETURN dec
END FUNCTION

FUNCTION CDEC2.ToVar () AS VARIANT
   DIM v AS VARIANT
   v.decVal = m_dec
   v.vt = VT_DECIMAL
   RETURN v
END FUNCTION

FUNCTION CDEC2.Scale () AS UBYTE
   RETURN m_dec.scale
END FUNCTION
FUNCTION CDEC2.Sign () AS UBYTE
   RETURN m_dec.sign
END FUNCTION
FUNCTION CDEC2.IsSigned () AS BOOLEAN
   IF m_dec.sign THEN RETURN TRUE ELSE RETURN FALSE
END FUNCTION
FUNCTION CDEC2.IsUnsigned () AS BOOLEAN
   IF m_dec.sign = 0 THEN RETURN TRUE ELSE RETURN FALSE
END FUNCTION

' ========================================================================================
' All global operators round result to 2 decimals
' ========================================================================================
PUBLIC OPERATOR - (BYREF decSrc AS CDEC2) AS CDEC2
   DIM dec AS DECIMAL
   VarDecNeg(@decSrc.m_dec, @dec)
   CDEC2_Round2Decimals(dec)
   RETURN dec
END OPERATOR

PUBLIC OPERATOR * (BYREF dec AS CDEC2) AS DECIMAL PTR
   OPERATOR = VARPTR(dec.m_dec)
END OPERATOR

PUBLIC OPERATOR * (BYREF dec1 AS CDEC2, BYREF dec2 AS CDEC2) AS CDEC2
   DIM dec AS DECIMAL
   VarDecMul(@dec1.m_dec, @dec2.m_dec, @dec)
   CDEC2_Round2Decimals(dec)
   RETURN dec
END OPERATOR

PUBLIC OPERATOR / (BYREF decSrc AS CDEC2, BYREF cOperand AS CDEC2) AS CDEC2
   DIM dec AS DECIMAL
   VarDecDiv(@decSrc.m_dec, @cOperand.m_dec, @dec)
   CDEC2_Round2Decimals(dec)
   RETURN dec
END OPERATOR

PRIVATE OPERATOR = (BYREF dec1 AS CDEC2, BYREF dec2 AS CDEC2) AS BOOLEAN
   RETURN (VarDecCmp(@dec1.m_dec, @dec2.m_dec) = VARCMP_EQ)
END OPERATOR
PUBLIC OPERATOR <> (BYREF dec1 AS CDEC2, BYREF dec2 AS CDEC2) AS BOOLEAN
   RETURN (VarDecCmp(@dec1.m_dec, @dec2.m_dec) <> VARCMP_EQ)
END OPERATOR
PUBLIC OPERATOR < (BYREF dec1 AS CDEC2, BYREF dec2 AS CDEC2) AS BOOLEAN
   RETURN (VarDecCmp(@dec1.m_dec, @dec2.m_dec) = VARCMP_LT)
END OPERATOR
PUBLIC OPERATOR > (BYREF dec1 AS CDEC2, BYREF dec2 AS CDEC2) AS BOOLEAN
   RETURN (VarDecCmp(@dec1.m_dec, @dec2.m_dec) = VARCMP_GT)
END OPERATOR
PUBLIC OPERATOR <= (BYREF dec1 AS CDEC2, BYREF dec2 AS CDEC2) AS BOOLEAN
   DIM hr AS HRESULT = VarDecCmp(@dec1.m_dec, @dec2.m_dec)
   RETURN (hr = VARCMP_LT) OR (hr = VARCMP_EQ)
END OPERATOR
PUBLIC OPERATOR >= (BYREF dec1 AS CDEC2, BYREF dec2 AS CDEC2) AS BOOLEAN
   DIM hr AS HRESULT = VarDecCmp(@dec1.m_dec, @dec2.m_dec)
   RETURN (hr = VARCMP_GT) OR (hr = VARCMP_EQ)
END OPERATOR

PUBLIC OPERATOR + (BYREF dec1 AS CDEC2, BYREF dec2 AS CDEC2) AS CDEC2
   DIM dec AS DECIMAL
   SetLastError(VarDecAdd(@dec1.m_dec, @dec2.m_dec, @dec))
   CDEC2_Round2Decimals(dec)
   RETURN dec
END OPERATOR

PUBLIC OPERATOR - (BYREF dec1 AS CDEC2, BYREF dec2 AS CDEC2) AS CDEC2
   DIM dec AS DECIMAL
   SetLastError(VarDecSub(@dec1.m_dec, @dec2.m_dec, @dec))
   CDEC2_Round2Decimals(dec)
   RETURN dec
END OPERATOR

PUBLIC OPERATOR Abs (BYREF dec AS CDEC2) AS CDEC2
   DIM decOut AS DECIMAL
   SetLastError(VarDecAbs(@dec.m_dec, @decOut))
   CDEC2_Round2Decimals(decOut)
   RETURN decOut
END OPERATOR

PUBLIC OPERATOR Fix (BYREF dec AS CDEC2) AS CDEC2
   DIM decOut AS DECIMAL
   VarDecFix(@dec.m_dec, @decOut)
   CDEC2_Round2Decimals(decOut)
   RETURN decOut
END OPERATOR

' ========================================================================================
