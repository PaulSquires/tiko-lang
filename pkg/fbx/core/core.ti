#define fbxAbs(x) iif((x) < 0, -(x), (x))
#define fbxAcos(x) Acos(x)
#define fbxAcosh(x) (Log(x + Sqrt(x * x - 1)))
#define fbxAsin(x) Asin(x)
#define fbxAsinh(x) (Log(x + Sqrt(x * x + 1)))
#define fbxAtan(x) Atn(x)
#define fbxAtan2(t, c) Atan2(t, c)
#define fbxAtanh(x) (Log((1 + x) / (1 - x)) / 2)
#define fbxBesselJ0(x) _j0(x)
#define fbxBesselJ1(x) _j1(x)
#define fbxBesselJn(n, x) _jn(n, x)
#define fbxBesselY0(x) _y0(x)
#define fbxBesselY1(x) _y1(x)
#define fbxBesselYn(n, x) _yn(n, x)
#define fbxCbrt(x) cbrt(x)
#define fbxChangeSign(x) (-(x))
#define fbxCeil(x) Ceil(x)
#define fbxClamp(v, min, max) iif((v) < (min), (min), iif((v) > (max), (max), (v)))
#define fbxCopySign(x, y) copysign(x, y)
#define fbxCos(x) Cos(x)
#define fbxCosh(x) Cosh(x)
#define fbxDegToRad(deg) ((deg) * (Atn(1) * 4) / 180)
#define fbxErf(x) (erf(x))
#define fbxErfc(x) (erfc(x))
#define fbxExp(x) Exp((x))
#define fbxExp2(x) exp2(x)
#define fbxExpm1(x) Exp(x) - 1.0
#define fbxExp2m1(x) Exp(x * Log(2.0)) - 1.0
#define fbxFdim(x, y) fdim(x, y)
#define fbxFix(x) Fix(x)
#define fbxTruncate(x) Fix(x)
#define fbxFloor(x) Floor(x)
#define fbxFma(x, y, z) fma(x, y, z)
#define fbxFpClassify(x) (_fpclass(x))
#define fbxFrac(x) Frac(x)
#define fbxHypot(x, y) Sqr(((x) * (x)) + ((y) * (y)))
#define fbxILogB(x) (ilogb(x))
#define fbxInt(x) Int(x)
#define fbxIsFinite(x) CBOOL((_finite(x) <> 0))
#define fbxIsInf fbxIsInfinity
#define fbxIsNaN(x) CBOOL((_isnan(x) <> 0))
#define fbxIsNormal(x) CBOOL((ABS(x) >= 2.2250738585072014e-308) AND (ABS(x) < 1.7976931348623157e+308))
#define fbxIsSubnormal(x) CBOOL(((Abs(x) > 0.0) And (Abs(x) < 2.2250738585072014e-308)))
#define fbxLdexp(x, e) ldexp(x, e)
#define fbxLerp(a,b,t) (a + (b - a) * t)
#define fbxLgamma(x) (lgamma(x))
#define fbxLog(x) Log(x)
#define fbxLog2(x) Log(x) / Log(2.0)
#define fbxLog10(x) Log(x) / Log(10.0)
#define fbxLog1p(x) Log(1.0 + x)
#define fbxLogB(x) (logb(x))
#define fbxLogBase(x, dBase) Log(x) / Log(dBase)
#define fbxMax(x, y) iif((x) > (y), (x), (y))
#define fbxMin(x, y) iif((x) < (y), (x), (y))
#define fbxMod(x, y) (fmod((x), (y)))
#define fbxModf(x, intptr) (modf(x, intptr))
#define fbxNextAfter(x, y) nextafter(x, y)
#define fbxPow(x, y) ((x) ^ (y))
#define fbxRadToDeg(rad) ((rad) * 180 / (Atn(1) * 4))
#define fbxRemainder fbxIEEERemainder
#define fbxRemap(v,inLo,inHi,outLo,outHi) (outLo + (v - inLo) * (outHi - outLo) / (inHi - inLo))
#define fbxScalb(x, e) _scalb(x, e)
#define fbxScalbn(x, e) scalbn(x, e)
#define fbxSign(x) iif((x) < 0, -1, iif((x) > 0, 1, 0))
#define fbxSignbit(x) CBOOL(__signbit(x) <> 0)
#define fbxSin(x) Sin(x)
#define fbxSinh(x) Sinh(x)
#define fbxSqrt(x) Sqr((x))
#define fbxTan(x) Tan(x)
#define fbxTanh(x) Tanh(x)
#define fbxTgamma(x) (tgamma(x))
#define fbxSec(x) (1 / Cos(x))
#define fbxCsc(x) (1 / Sin(x))
#define fbxCtan(x) (1 / Tan(x))
#define fbxAsec(x) (2 * Atn(1) - Atn(Sgn(x) / Sqrt(x * x - 1)))
#define fbxAcsc(x) (Atn(Sgn(x) / Sqrt(x * x - 1)))
#define fbxAcot(x) (2 * Atn(1) - Atn(x))
#define fbxSech(x) (2 / (Exp(x) + Exp(-x)))
#define fbxCsch(x) (2 / (Exp(x) - Exp(-x)))
#define fbxCoth(x) (Exp(x) + Exp(-x)) / (Exp(x) - Exp(-x))
#define fbxAsech(x) (Log((Sqrt(-x * x + 1) + 1) / x))
#define fbxAcsch(x) (Log((Sgn(x) * Sqrt(x * x + 1) + 1) / x))
#define fbxAcoth(x) (Log((x + 1) / (x - 1)) / 2)
