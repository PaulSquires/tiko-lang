#ifndef _BSTRING_DEBUG_
   #define _BSTRING_DEBUG_ 0
#endif
#ifndef _BSTRING_DP_
   #MACRO BSTRING_DP(st)
      #IF (_BSTRING_DEBUG_ = 1)
         OutputDebugStringW(__FUNCTION__ + ": " + st)
      #ENDIF
   #ENDMACRO
#endif
