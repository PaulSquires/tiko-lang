#define fbxExePathName fbxGetExePathName
#define fbxExeFileName fbxGetExeFileName
#define fbxExeFileNameX fbxGetExeFileNameX
#define fbxExeFileExt fbxGetExeFileExt
#define fbxExeFullPath fbxGetExeFullPath
#define fbxFileName fbxGetFileName
#define fbxFileNameX fbxGetFileNameX
#define fbxFileExt fbxGetFileExt
#define fbxPathName fbxGetPathName
#define fbxFolderName fbxGetFolderName
#define fbxSetCurDir fbxSetCurrentDirectory
