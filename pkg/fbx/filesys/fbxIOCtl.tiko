' ########################################################################################
'                    *** IOCTL - Device Input and Output Control ***
'                          STORAGE_ACCESS_ALIGNMENT_DESCRIPTOR
' ########################################################################################

' ========================================================================================
' Retrieves the storage access alignment device descriptor.
' Parameter:
' wszPath: The name of the file or device to be created or opened.
'          You may use either forward slashes (/) or backslashes (\) in this name.
' - Drives  : "//./PhysicalDrive0" -> "//./C:"
'             "//./PhysicalDrive1" -> "//./D:"
' - Volumes : "//./C:"
' - Drivers : "//./DriverName"
' Return values:
'   PSTORAGE_ACCESS_ALIGNMENT_DESCRIPTOR: Pointer to as STORAGE_ACCESS_ALIGNMENT_DESCRIPTOR structure
'   DWORD : Error code
'   USTRING : Localized description of the error
' Usage example:
'   var (pDesc, dwError, errInfo) = IOCtl_StorageAccess_Alignment_Descriptor()
'   IF dwError THEN PRINT errInfo
'   ...
'   IF pDesc THEN Deallocate(pDesc)
' ========================================================================================
PUBLIC FUNCTION IOCtl_StorageAccess_Alignment_Descriptor (BYREF wszPath AS WSTRING = "//./PhysicalDrive0") AS (PSTORAGE_ACCESS_ALIGNMENT_DESCRIPTOR, DWORD, USTRING)
   ' // Open the device to be queried
   DIM hDevice AS HANDLE = CreateFileW(wszPath, 0, FILE_SHARE_READ OR FILE_SHARE_WRITE, NULL, OPEN_EXISTING, 0, NULL)
   IF hDevice = INVALID_HANDLE_VALUE THEN RETURN (NULL, GetLastError, fbxGetErrorInfo(GetLastError))
   defer CloseHandle(hDevice)
   ' // Query the device
   DIM query AS STORAGE_PROPERTY_QUERY = (StorageAccessAlignmentProperty, PropertyStandardQuery)
   ' // First call: get the need size for the full descriptor
   DIM header AS STORAGE_DESCRIPTOR_HEADER, bytesReturned AS DWORD
   DIM bRes AS BOOLEAN = DeviceIoControl (hDevice, IOCTL_STORAGE_QUERY_PROPERTY, @query, sizeof(query), _
                                          @header, sizeof(header), @bytesReturned, NULL)
   IF bRes = FALSE THEN RETURN(NULL, GetLastError, fbxGetErrorInfo(GetLastError))
   ' // Allocate the device descriptor
   DIM pDesc AS PSTORAGE_ACCESS_ALIGNMENT_DESCRIPTOR = cast(PSTORAGE_ACCESS_ALIGNMENT_DESCRIPTOR, Allocate(header.Size))
   ' // Second call: Get the descriptor
   bRes = DeviceIoControl(hDevice, IOCTL_STORAGE_QUERY_PROPERTY, @query, sizeof(query), _
                          pDesc, header.Size, @bytesReturned, NULL)
   IF bRes = FALSE THEN RETURN(NULL, GetLastError, fbxGetErrorInfo(GetLastError))
   RETURN (pDesc, 0, fbxGetErrorInfo(0))
END FUNCTION
