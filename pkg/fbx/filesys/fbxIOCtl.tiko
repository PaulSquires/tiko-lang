   defer Deallocate(pDesc)
   IF pDesc->ProductIdOffset > 0 THEN
      DIM pstr AS ZSTRING PTR = cast(ZSTRING PTR, cast(BYTE PTR, pDesc) + pDesc->ProductIdOffset)
