' ========================================================================================
' Specifies the SCSI request block (SRB) type used by the HBA.
' SRB_TYPE_SCSI_REQUEST_BLOCK (0) The HBA uses SCSI request blocks.
' SRB_TYPE_STORAGE_REQUEST_BLOCK (1) The HBA uses extended SCSI request blocks.
' Usage example: print IOCtl_Storage_Adapter_SrbType("//./PhysicalDrive0")
' - Member not included in the FreeBasic headers.
' Return values:
'   BYTE : Specifies the SCSI request block (SRB) type used by the HBA.
'   DWORD : Error code
'   USTRING : Localized description of the error
' Usage example:
'   var (srbType, dwError, errInfo) = IOCtl_StorageAdapter_SrbType()
'   IF dwError THEN PRINT errInfo
'   print srbType
' ========================================================================================
' ========================================================================================
PUBLIC FUNCTION IOCtl_StorageAdapter_SrbType (BYREF wszFileName AS WSTRING = "//./PhysicalDrive0") AS (BYTE, DWORD, USTRING)
   var (pDesc, dwError, errInfo) = IOCtl_StorageAdapter_Descriptor(wszFileName)
   IF pDesc = NULL THEN RETURN(-1, dwError, errInfo)
   defer Deallocate(pDesc)
   RETURN (pDesc->SrbType, 0, fbxGetErrorInfo(0))
END FUNCTION
' ========================================================================================

' ========================================================================================
' Retrieves the physical location of a specified volume on one or more disks.
' wszVolume: Volume path, e.g. "//./C:"
' Returns: Disk number on success, or -1 on failure.
' Usage example:
' DIM disk AS LONG = IOCtl_GetVolumeDiskNumber("//./C:")
' PRINT "C: is in PhysicalDrive" & STR(disk)
' ========================================================================================
PUBLIC FUNCTION IOCtl_GetVolumeDiskNumber (BYREF wszVolume AS WSTRING) AS LONG
   DIM hVolume AS HANDLE = CreateFileW (wszVolume, 0, FILE_SHARE_READ OR FILE_SHARE_WRITE, NULL, OPEN_EXISTING, 0, NULL)
   IF hVolume = INVALID_HANDLE_VALUE THEN RETURN -1
   defer CloseHandle(hVolume)
   ' // First try with a small buffer
   DIM smallBuf AS VOLUME_DISK_EXTENTS, bytesReturned AS DWORD
   DIM bResult AS BOOLEAN = DeviceIoControl (hVolume, IOCTL_VOLUME_GET_VOLUME_DISK_EXTENTS, NULL, 0, _
                            @smallBuf, sizeof(smallBuf), @bytesReturned, NULL)
   IF bResult = FALSE THEN RETURN -1
   ' // If only one extent, no need to allocate more
   IF smallBuf.NumberOfDiskExtents = 1 THEN RETURN smallBuf.Extents(0).DiskNumber
   ' // Allocate buffer for multiple extents
   DIM bufSize AS DWORD = sizeof(VOLUME_DISK_EXTENTS) + (smallBuf.NumberOfDiskExtents - 1) * sizeof(DISK_EXTENT)
   DIM pExt AS VOLUME_DISK_EXTENTS PTR = cast(VOLUME_DISK_EXTENTS PTR, Allocate(bufSize))
   defer Deallocate(pExt)
   bResult = DeviceIoControl (hVolume, IOCTL_VOLUME_GET_VOLUME_DISK_EXTENTS, NULL, 0, pExt, bufSize, @bytesReturned, NULL)
   IF bResult = FALSE THEN RETURN -1
   DIM diskNum AS LONG = pExt->Extents(0).DiskNumber
   RETURN diskNum
END FUNCTION
' ========================================================================================
