' ########################################################################################
'                    *** IOCTL - Device Input and Output Control ***
'                           IOCTL_STORAGE_DEVICE_DESCRIPTOR
' ########################################################################################

' ========================================================================================
' Retrieves the storage device descriptor.
' Parameter:
' wszPath: The name of the file or device to be created or opened.
'          You may use either forward slashes (/) or backslashes (\) in this name.
' - Drives  : "//./PhysicalDrive0" -> "//./C:"
'             "//./PhysicalDrive1" -> "//./D:"
' - Volumes : "//./C:"
' - Drivers : "//./DriverName"
' Return values:
'   PSTORAGE_DEVICE_DESCRIPTOR : The retrieved descriptor pointer on success or NULL on failure.
'   DWORD : Error code
'   USTRING : Localized description of the error
' Usage example:
'   DIM pDesc AS PSTORAGE_DEVICE_DESCRIPTOR = IOCtl_StorageDevice_Descriptor()
'   ...
'   IF pDesc THEN Deallocate(pDesc)
' ========================================================================================
PUBLIC FUNCTION IOCtl_StorageDevice_Descriptor (BYREF wszPath AS WSTRING = "//./PhysicalDrive0") AS (PSTORAGE_DEVICE_DESCRIPTOR, DWORD, USTRING)
   ' // Open the device to be queried
   DIM hDevice AS HANDLE = CreateFileW(wszPath, 0, FILE_SHARE_READ OR FILE_SHARE_WRITE, NULL, OPEN_EXISTING, 0, NULL)
   IF hDevice = INVALID_HANDLE_VALUE THEN RETURN (NULL, GetLastError, fbxGetErrorInfo(GetLastError))
   defer CloseHandle(hDevice)
   ' // Query the device
   DIM query AS STORAGE_PROPERTY_QUERY = (StorageDeviceProperty, PropertyStandardQuery)
   ' // First call: get the need size for the full descriptor
   DIM header AS STORAGE_DESCRIPTOR_HEADER, bytesReturned AS DWORD
   DIM bRes AS BOOLEAN = DeviceIoControl (hDevice, IOCTL_STORAGE_QUERY_PROPERTY, @query, sizeof(query), _
                                          @header, sizeof(header), @bytesReturned, NULL)
   IF bRes = FALSE THEN RETURN (NULL, GetLastError, fbxGetErrorInfo(GetLastError))
   ' // Allocate the device descriptor
   DIM pDesc AS PSTORAGE_DEVICE_DESCRIPTOR = cast(PSTORAGE_DEVICE_DESCRIPTOR, Allocate(header.Size))
   ' // Second call: Get the descriptor
   bRes = DeviceIoControl(hDevice, IOCTL_STORAGE_QUERY_PROPERTY, @query, sizeof(query), _
                          pDesc, header.Size, @bytesReturned, NULL)
   IF bRes = FALSE THEN RETURN (NULL, GetLastError, fbxGetErrorInfo(GetLastError))
   RETURN (pDesc, 0, fbxGetErrorInfo(0))
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Returns an ASCII string that contains the device's vendor ID.
' Parameter:
' wszPath: The name of the file or device to be created or opened.
'          You may use either forward slashes (/) or backslashes (\) in this name.
' - Drives  : "//./PhysicalDrive0" -> "//./C:"
'             "//./PhysicalDrive1" -> "//./D:"
' - Volumes : "//./C:"
' - Drivers : "//./DriverName"
' Return values:
'   STRING : The retrieved serial number on success or an empty string on failure.
'   DWORD : Error code
'   USTRING : Localized description of the error
' Usage example:
'   var (vendorId, dwError, errInfo) = IOCtl_StorageDevice_VendorId()
'   IF dwError THEN PRINT errInfo
'   print vendorId
' ========================================================================================
PUBLIC FUNCTION IOCtl_StorageDevice_VendorId (BYREF wszFileName AS WSTRING = "//./PhysicalDrive0") AS (STRING, DWORD, USTRING)
   var (pDesc, dwError, errInfo) = IOCtl_StorageDevice_Descriptor(wszFileName)
   IF pDesc = NULL THEN RETURN("", dwError, errInfo)
   defer Deallocate(pDesc)
   IF pDesc->VendorIdOffset > 0 THEN
      DIM pstr AS ZSTRING PTR = cast(ZSTRING PTR, cast(BYTE PTR, pDesc) + pDesc->VendorIdOffset)
      IF *pstr <> "" THEN RETURN(*pstr, 0, fbxGetErrorInfo(0))
   END IF
   RETURN("", 0, "")
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Retrieves the device's product ID.
' Parameter:
' wszPath: The name of the file or device to be created or opened.
'          You may use either forward slashes (/) or backslashes (\) in this name.
