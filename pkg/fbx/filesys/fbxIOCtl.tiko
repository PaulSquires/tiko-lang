'   print bytesPerCacheLine
' ========================================================================================
PUBLIC FUNCTION IOCtl_StorageAccess_BytesPerCacheLine (BYREF wszFileName AS WSTRING = "//./PhysicalDrive0") AS (DWORD, DWORD, USTRING)
   var (pDesc, dwError, errInfo) = IOCtl_StorageAccess_Alignment_Descriptor(wszFileName)
   IF pDesc = NULL THEN RETURN(0, dwError, errInfo)
   defer Deallocate(pDesc)
   RETURN (pDesc->BytesPerCacheLine, 0, fbxGetErrorInfo(0))
END FUNCTION
