' ########################################################################################
'                    *** IOCTL - Device Input and Output Control ***
'                           IOCTL_DISK_GET_DRIVE_GEOMETRY_EX
' ########################################################################################

' ========================================================================================
' * Retrieves the number of cylinders of the specified disk.
' Parameter:
'   wszPath = Drive to open.
' Return values:
'   LONGLONG : Number of cylinders
'   DWORD : Error code
'   USTRING : Localized description of the error
' Usage example:
'   var (cylinders, dwError, errInfo) = IOCtl_Disk_Cylinders()
'   --- or ---
'   DIM cylinders AS LONGLONG
'   DIM dwError AS DWORD
'   DIM errInfo AS USTRING
'   (cylinders, dwError, errInfo) = IOCtl_Disk_Cylinders()
'   ----------
'   if dwError then print errInfo
'   print cylinders
' ========================================================================================
PUBLIC FUNCTION IOCtl_Disk_Cylinders (BYREF wszPath AS WSTRING = "//./PhysicalDrive0") AS (LONGLONG, DWORD, USTRING)
   ' // Open the device to be queried
   DIM hDevice AS HANDLE = CreateFileW(wszPath, 0, FILE_SHARE_READ OR FILE_SHARE_WRITE, NULL, OPEN_EXISTING, 0, NULL)
   IF hDevice = INVALID_HANDLE_VALUE THEN RETURN (0, GetLastError, fbxGetErrorInfo(GetLastError))
   defer CloseHandle(hDevice)
   ' // Query the device
   DIM pdg AS DISK_GEOMETRY_EX, bytesReturned AS DWORD
   DIM bRes AS BOOLEAN = DeviceIoControl(hDevice, IOCTL_DISK_GET_DRIVE_GEOMETRY_EX, NULL, 0, @pdg, sizeof(pdg), @bytesReturned, NULL)
   IF bRes = FALSE THEN RETURN(0, GetLastError, fbxGetErrorInfo(GetLastError))
   RETURN (pdg.Geometry.Cylinders.QuadPart, 0, fbxGetErrorInfo(0))
END FUNCTION

' ========================================================================================
' * Retrieves the size of the specified disk.
' Parameter:
'   wszPath = Drive to open.
' Return values:
'   LONGLONG : Disk size in bytes
'   DWORD : Error code
'   USTRING : Localized description of the error
' Usage example:
'   var (size, dwError, errInfo) = IOCtl_Disk_Size()
'   if dwError then print hex(dwError), errInfo
'   print size
' ========================================================================================
PUBLIC FUNCTION IOCtl_Disk_Size (BYREF wszPath AS WSTRING = "//./PhysicalDrive0") AS (LONGLONG, DWORD, USTRING)
   ' // Open the device to be queried
   DIM hDevice AS HANDLE = CreateFileW(wszPath, 0, FILE_SHARE_READ OR FILE_SHARE_WRITE, NULL, OPEN_EXISTING, 0, NULL)
   IF hDevice = INVALID_HANDLE_VALUE THEN RETURN (0, GetLastError, fbxGetErrorInfo(GetLastError))
   defer CloseHandle(hDevice)
   ' // Query the device
   DIM pdg AS DISK_GEOMETRY_EX, bytesReturned AS DWORD
   DIM bRes AS BOOLEAN = DeviceIoControl(hDevice, IOCTL_DISK_GET_DRIVE_GEOMETRY_EX, NULL, 0, @pdg, sizeof(pdg), @bytesReturned, NULL)
   IF bRes = FALSE THEN RETURN(0, GetLastError, fbxGetErrorInfo(GetLastError))
   RETURN (pdg.DiskSize.QuadPart, 0, fbxGetErrorInfo(0))
END FUNCTION
' ========================================================================================

