' ========================================================================================
' Retrieves the logical sector offset within the first physical sector where the first
' logical sector is placed, in bytes.
' Return values:
'   DWORD : The logical sector offset within the first physical sector where the first logical sector is placed, in bytes.
'   DWORD : Error code
'   USTRING : Localized description of the error
' Usage example:
'   var (BytesOffsetForSectorAlignment, dwError, errInfo) = IOCtl_StorageAccess_BytesOffsetForSectorAlignment()
'   IF dwError THEN PRINT errInfo
'   print BytesOffsetForSectorAlignment
' ========================================================================================
PUBLIC FUNCTION IOCtl_StorageAccess_BytesOffsetForSectorAlignment (BYREF wszFileName AS WSTRING = "//./PhysicalDrive0") AS (DWORD, DWORD, USTRING)
   var (pDesc, dwError, errInfo) = IOCtl_StorageAccess_Alignment_Descriptor(wszFileName)
   IF pDesc = NULL THEN RETURN(0, dwError, errInfo)
   defer Deallocate(pDesc)
   RETURN (pDesc->BytesOffsetForSectorAlignment, 0, fbxGetErrorInfo(0))
END FUNCTION
' ========================================================================================


' ########################################################################################
'                    *** IOCTL - Device Input and Output Control ***
'                            STORAGE_ADAPTER_DESCRIPTOR
' ########################################################################################

' ========================================================================================
' Retrieves the storage storage adapter descriptor data for a device.
' Parameter:
' wszPath: The name of the file or device to be created or opened.
'          You may use either forward slashes (/) or backslashes (\) in this name.
' - Drives  : "//./PhysicalDrive0" -> "//./C:"
'             "//./PhysicalDrive1" -> "//./D:"
' - Volumes : "//./C:"
' - Drivers : "//./DriverName"
' Return values:
'   PSTORAGE_ADAPTER_DESCRIPTOR: Pointer to as STORAGE_ADAPTER_DESCRIPTOR structure
'   DWORD : Error code
'   USTRING : Localized description of the error
' Usage example:
'   var (pDesc, dwError, errInfo) = IOCtl_Storageadapter_Alignment_Descriptor()
'   IF dwError THEN PRINT errInfo
'   ...
'   IF pDesc THEN Deallocate(pDesc)
' ========================================================================================
PUBLIC FUNCTION IOCtl_StorageAdapter_Descriptor (BYREF wszPath AS WSTRING = "//./PhysicalDrive0") AS (PSTORAGE_ADAPTER_DESCRIPTOR, DWORD, USTRING)
   ' // Open the device to be queried
   DIM hDevice AS HANDLE = CreateFileW(wszPath, 0, FILE_SHARE_READ OR FILE_SHARE_WRITE, NULL, OPEN_EXISTING, 0, NULL)
   IF hDevice = INVALID_HANDLE_VALUE THEN RETURN (NULL, GetLastError, fbxGetErrorInfo(GetLastError))
   defer CloseHandle(hDevice)
   ' // Query the device
   DIM query AS STORAGE_PROPERTY_QUERY = (StorageAdapterProperty, PropertyStandardQuery)
   ' // First call: get the need size for the full descriptor
   DIM header AS STORAGE_DESCRIPTOR_HEADER, bytesReturned AS DWORD
   DIM bRes AS BOOLEAN = DeviceIoControl (hDevice, IOCTL_STORAGE_QUERY_PROPERTY, @query, sizeof(query), _
                                          @header, sizeof(header), @bytesReturned, NULL)
   IF bRes = FALSE THEN RETURN(NULL, GetLastError, fbxGetErrorInfo(GetLastError))
   ' // Allocate the device descriptor
   DIM pDesc AS PSTORAGE_ADAPTER_DESCRIPTOR = cast(PSTORAGE_ADAPTER_DESCRIPTOR, Allocate(header.Size))
   ' // Second call: Get the descriptor
   bRes = DeviceIoControl(hDevice, IOCTL_STORAGE_QUERY_PROPERTY, @query, sizeof(query), _
                          pDesc, header.Size, @bytesReturned, NULL)
   IF bRes = FALSE THEN RETURN(NULL, GetLastError, fbxGetErrorInfo(GetLastError))
   RETURN (pDesc, 0, fbxGetErrorInfo(0))
END FUNCTION
' ========================================================================================

' ========================================================================================
' Retrieves the maximum number of bytes the storage adapter can transfer in a single operation.
' Return values:
'   DWORD : The maximum number of bytes the storage adapter can transfer in a single operation.
'   DWORD : Error code
'   USTRING : Localized description of the error
' Usage example:
'   var (transferLen, dwError, errInfo) = IOCtl_StorageAdapter_MaximumTransferLength()
'   IF dwError THEN PRINT errInfo
'   print transferLen
' ========================================================================================
PUBLIC FUNCTION IOCtl_StorageAdapter_MaximumTransferLength (BYREF wszFileName AS WSTRING = "//./PhysicalDrive0") AS (DWORD, DWORD, USTRING)
   var (pDesc, dwError, errInfo) = IOCtl_StorageAdapter_Descriptor(wszFileName)
   IF pDesc = NULL THEN RETURN(0, dwError, errInfo)
   defer Deallocate(pDesc)
   RETURN (pDesc->MaximumTransferLength, 0, fbxGetErrorInfo(0))
END FUNCTION
' ========================================================================================

' ========================================================================================
' Retrieves the maximum number of discontinuous physical pages the storage adapter can manage
' in a single transfer (in other words, the extent of its scatter/gather support).
' Return values:
'   DWORD : The maximum number of discontinuous physical pages the storage adapter can manage
'           in a single transfer (in other words, the extent of its scatter/gather support).
'   DWORD : Error code
'   USTRING : Localized description of the error
' Usage example:
'   var (maxPages, dwError, errInfo) = IOCtl_StorageAdapter_MaximumPhysicalPages()
'   IF dwError THEN PRINT errInfo
'   print maxPages
' ========================================================================================
PUBLIC FUNCTION IOCtl_StorageAdapter_MaximumPhysicalPages (BYREF wszFileName AS WSTRING = "//./PhysicalDrive0") AS (DWORD, DWORD, USTRING)
   var (pDesc, dwError, errInfo) = IOCtl_StorageAdapter_Descriptor(wszFileName)
   IF pDesc = NULL THEN RETURN(0, dwError, errInfo)
   defer Deallocate(pDesc)
   RETURN (pDesc->MaximumPhysicalPages, 0, fbxGetErrorInfo(0))
END FUNCTION
' ========================================================================================

' ========================================================================================
' Retrieves storage adapter's alignment requirements for transfers. The alignment mask
' indicates alignment restrictions for buffers required by the storage adapter for transfer
' operations. Valid mask values are also restricted by characteristics of the memory managers
' on different versions of Windows.
' Return values:
'   DWORD : The maximum number of discontinuous physical pages the storage adapter can manage
'           in a single transfer (in other words, the extent of its scatter/gather support).
'   DWORD : Error code
'   USTRING : Localized description of the error
' Usage example:
'   var (mask, dwError, errInfo) = IOCtl_StorageAdapter_AlignmentMask()
'   IF dwError THEN PRINT errInfo
'   print mask
' ========================================================================================
PUBLIC FUNCTION IOCtl_StorageAdapter_AlignmentMask (BYREF wszFileName AS WSTRING = "//./PhysicalDrive0") AS (DWORD, DWORD, USTRING)
   var (pDesc, dwError, errInfo) = IOCtl_StorageAdapter_Descriptor(wszFileName)
   IF pDesc = NULL THEN RETURN(0, dwError, errInfo)
   defer Deallocate(pDesc)
   RETURN (pDesc->AlignmentMask, 0, fbxGetErrorInfo(0))
END FUNCTION
' ========================================================================================

' ========================================================================================
' If this member is TRUE, the storage adapter uses programmed I/O (PIO) and requires the
' use of system-space virtual addresses mapped to physical memory for data buffers. When
' this member is FALSE, the storage adapter does not use PIO.
' Return values:
'   BOOLEAN : TRUE or FALSE
'   DWORD : Error code
'   USTRING : Localized description of the error
' Usage example:
'   var (usesPio, dwError, errInfo) = IOCtl_StorageAdapter_AdapterUsesPio()
'   IF dwError THEN PRINT errInfo
'   print usesPio
' ========================================================================================
PUBLIC FUNCTION IOCtl_StorageAdapter_AdapterUsesPio (BYREF wszFileName AS WSTRING = "//./PhysicalDrive0") AS (BOOLEAN, DWORD, USTRING)
   var (pDesc, dwError, errInfo) = IOCtl_StorageAdapter_Descriptor(wszFileName)
   IF pDesc = NULL THEN RETURN(0, dwError, errInfo)
   defer Deallocate(pDesc)
   RETURN (pDesc->AdapterUsesPio, 0, fbxGetErrorInfo(0))
END FUNCTION
' ========================================================================================

' ========================================================================================
' If this member is TRUE, the storage adapter scans down for BIOS devices, that is, the
' storage adapter begins scanning with the highest device number rather than the lowest.
' When this member is FALSE, the storage adapter begins scanning with the lowest device
' number. This member is reserved for legacy miniport drivers.
' Usage example: print IOCtl_Storage_Adapter_AdapterScansDown("//./PhysicalDrive0")
' Return values:
'   BOOLEAN : TRUE or FALSE
'   DWORD : Error code
'   USTRING : Localized description of the error
' Usage example:
'   var (scansDown, dwError, errInfo) = IOCtl_StorageAdapter_AdapterScansDown()
'   IF dwError THEN PRINT errInfo
'   print scansDown
' ========================================================================================
PUBLIC FUNCTION IOCtl_StorageAdapter_AdapterScansDown (BYREF wszFileName AS WSTRING = "//./PhysicalDrive0") AS (BOOLEAN, DWORD, USTRING)
   var (pDesc, dwError, errInfo) = IOCtl_StorageAdapter_Descriptor(wszFileName)
   IF pDesc = NULL THEN RETURN(0, dwError, errInfo)
   defer Deallocate(pDesc)
   RETURN (pDesc->AdapterScansDown, 0, fbxGetErrorInfo(0))
END FUNCTION
' ========================================================================================

' ========================================================================================
' If this member is TRUE, the storage adapter supports SCSI tagged queuing and/or per-logical-unit
' internal queues, or the non-SCSI equivalent. When this member is FALSE, the storage adapter
' neither supports SCSI-tagged queuing nor per-logical-unit internal queues.
' Return values:
'   BOOLEAN : TRUE or FALSE
'   DWORD : Error code
'   USTRING : Localized description of the error
' Usage example:
'   var (queueing, dwError, errInfo) = IOCtl_StorageAdapter_CommandQueueing()
'   IF dwError THEN PRINT errInfo
'   print queueing
' ========================================================================================
PUBLIC FUNCTION IOCtl_StorageAdapter_CommandQueueing (BYREF wszFileName AS WSTRING = "//./PhysicalDrive0") AS (BOOLEAN, DWORD, USTRING)
   var (pDesc, dwError, errInfo) = IOCtl_StorageAdapter_Descriptor(wszFileName)
   IF pDesc = NULL THEN RETURN(0, dwError, errInfo)
   defer Deallocate(pDesc)
   RETURN (pDesc->CommandQueueing, 0, fbxGetErrorInfo(0))
END FUNCTION
' ========================================================================================

' ========================================================================================
' If this member is TRUE, the storage adapter supports synchronous transfers as a way of
' speeding up I/O. When this member is FALSE, the storage adapter does not support synchronous
' transfers as a way of speeding up I/O.
' Return values:
'   BOOLEAN : TRUE or FALSE
'   DWORD : Error code
'   USTRING : Localized description of the error
' Usage example:
'   var (transfer, dwError, errInfo) = IOCtl_StorageAdapter_AcceleratedTransfer()
'   IF dwError THEN PRINT errInfo
'   print transfer
' ========================================================================================
PUBLIC FUNCTION IOCtl_StorageAdapter_AcceleratedTransfer (BYREF wszFileName AS WSTRING = "//./PhysicalDrive0") AS (BOOLEAN, DWORD, USTRING)
   var (pDesc, dwError, errInfo) = IOCtl_StorageAdapter_Descriptor(wszFileName)
   IF pDesc = NULL THEN RETURN(0, dwError, errInfo)
   defer Deallocate(pDesc)
   RETURN (pDesc->AcceleratedTransfer, 0, fbxGetErrorInfo(0))
END FUNCTION
