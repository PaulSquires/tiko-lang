'   print busType
' ========================================================================================
PUBLIC FUNCTION IOCtl_StorageDevice_BusType (BYREF wszFileName AS WSTRING = "//./PhysicalDrive0") AS (STORAGE_BUS_TYPE, DWORD, USTRING)
   var (pDesc, dwError, errInfo) = IOCtl_StorageDevice_Descriptor(wszFileName)
   IF pDesc = NULL THEN RETURN(0, dwError, errInfo)
   defer Deallocate(pDesc)
   RETURN (pDesc->BusType, 0, fbxGetErrorInfo(0))
