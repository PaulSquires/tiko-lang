   DECLARE ABSTRACT FUNCTION CreateTextFile (BYVAL FileName AS FBX_BSTR, BYVAL Overwrite AS VARIANT_BOOL = -1, BYVAL bUnicode AS VARIANT_BOOL = FALSE, BYVAL ppts AS ITextStream PTR PTR) AS HRESULT
