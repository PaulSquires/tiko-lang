' fbx/scripting (pkg/fbx): every header the module's files include, and the
' macros more than one of its files uses.
#pragma once

#include once "windows.bi"
#include once "win/ole2.bi"
#include once "win/unknwnbase.bi"
#include once "win/control.bi"
#include once "win/wbemcli.bi"

#ifndef _CDICOBJ_DEBUG_
   #define _CDICOBJ_DEBUG_ 0
#endif
#ifndef _CDICOBJ_DP_
   #MACRO CDICOBJ_DP(st)
      #IF (_CDICOBJ_DEBUG_ = 1)
         OutputDebugStringW(__FUNCTION__ + ": " + st)
      #ENDIF
   #ENDMACRO
#endif
#define ISWbemLastError AS ISWbemObject_
