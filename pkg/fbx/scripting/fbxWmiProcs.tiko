      IF hr THEN EXIT DO
      dv = pServices.PropValue("FreePhysicalMemory")
      hr = pServices.GetLastResult
      EXIT DO
   LOOP
   RETURN(dv, hr, fbxWmiGetErrorCodeText(hr))
END FUNCTION
