   DO
      hr = pServices.GetLastResult
      IF hr THEN EXIT DO
      hr = pServices.ExecQuery("SELECT Capabilities FROM Win32_CDROMDrive")
      IF hr THEN EXIT DO
      hr = pServices.GetNamedProperties
      IF hr THEN EXIT DO
      dv = pServices.PropValue("Capabilities")
      hr = pServices.GetLastResult
      EXIT DO
   LOOP
   RETURN(dv, hr, fbxWmiGetErrorCodeText(hr))
END FUNCTION
