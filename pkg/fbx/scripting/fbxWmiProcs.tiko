' ========================================================================================
' Retrieves the manufacturer serial number.
' Contrarily to the serial number returned by fbxGetDiskDriveSerialNumber, this one won't
' change even if you format your hard drive.
' Requires Windows Vista+.
' Usage example:
' var (serialNumber, hr, errInfo) = wmiGetManufacturerSerialNumber()
' print serialNumber
' if hr then print errInfo
' ========================================================================================
PUBLIC FUNCTION wmiGetManufacturerSerialNumber (BYREF wszServerName AS WSTRING = ".") AS (DVARIANT, HRESULT, USTRING)
   DIM hr AS HRESULT, dv AS DVARIANT
   DIM pServices AS CWmiServices = $"winmgmts:{impersonationLevel=impersonate}!\\" & wszServerName & $"\root\cimv2"
   DO
      hr = pServices.GetLastResult
      IF hr THEN EXIT DO
      hr = pServices.ExecQuery("SELECT SerialNumber FROM Win32_PhysicalMedia")
      IF hr THEN EXIT DO
      hr = pServices.GetNamedProperties
      IF hr THEN EXIT DO
      dv = pServices.PropValue("SerialNumber")
      hr = pServices.GetLastResult
      EXIT DO
   LOOP
   RETURN(dv, hr, fbxWmiGetErrorCodeText(hr))
END FUNCTION
' ========================================================================================

' ========================================================================================
' Retrieves the disk drive serial number.
' Contrarily to the serial number returned by fbxGetManufacturerSerialNumber, that does not
' change, this one will change every time the hard drive is formatted.
' Requires Windows Vista+.
' Usage example:
' var (serialNumber, hr, errInfo) = wmiGetDiskDriveSerialNumber()
' print serialNumber
' if hr then print errInfo
' ========================================================================================
PUBLIC FUNCTION wmiGetDiskDriveSerialNumber (BYREF wszServerName AS WSTRING = ".") AS (DVARIANT, HRESULT, USTRING)
   DIM hr AS HRESULT, dv AS DVARIANT
   DIM pServices AS CWmiServices = $"winmgmts:{impersonationLevel=impersonate}!\\" & wszServerName & $"\root\cimv2"
   DO
      hr = pServices.GetLastResult
      IF hr THEN EXIT DO
      hr = pServices.ExecQuery("SELECT SerialNumber FROM Win32_DiskDrive")
      IF hr THEN EXIT DO
      hr = pServices.GetNamedProperties
      IF hr THEN EXIT DO
      dv = pServices.PropValue("SerialNumber")
      hr = pServices.GetLastResult
      EXIT DO
   LOOP
   RETURN(dv, hr, fbxWmiGetErrorCodeText(hr))
END FUNCTION
' ========================================================================================

' ========================================================================================
' Retrieves the system running on the Windows-based computer. The following list identifiers
' the returned value: "X86-based PC", "MIPS-based PC", "Alpha-based PC", "Power PC",
' "SH-x PC", "StrongARM PC", "64-bit Intel PC", "64-bit Alpha PC", "Unknown", "X86-Nec98 PC".
' Usage example:
' var (systemType, hr, errInfo) = wmiGetSystemType()
' print systemType
' if hr then print errInfo
' ========================================================================================
PUBLIC FUNCTION wmiGetSystemType (BYREF wszServerName AS WSTRING = ".") AS (DVARIANT, HRESULT, USTRING)
   DIM hr AS HRESULT, dv AS DVARIANT
   DIM pServices AS CWmiServices = $"winmgmts:{impersonationLevel=impersonate}!\\" & wszServerName & $"\root\cimv2"
   DO
      hr = pServices.GetLastResult
      IF hr THEN EXIT DO
      hr = pServices.ExecQuery("SELECT SystemType FROM Win32_ComputerSystem")
      IF hr THEN EXIT DO
      hr = pServices.GetNamedProperties
      IF hr THEN EXIT DO
      dv = pServices.PropValue("SystemType")
      hr = pServices.GetLastResult
      EXIT DO
   LOOP
   RETURN(dv, hr, fbxWmiGetErrorCodeText(hr))
END FUNCTION
' ========================================================================================

' ========================================================================================
' Retrieves the type of the computer in use, such as laptop, desktop, or Tablet.
' Not available in Windows Server 2003, Windows XP, Windows 2000, Windows NT 4.0, and Windows Me/98/95.
' Value   Meaning
' ------- --------------------------------------------
' 0 (&H0) Unspecified
' 1 (&H1) Desktop
' 2 (&H2) Mobile
' 3 (&H3) Workstation
' 4 (&H4) Enterprise Server
' 5 (&H5) Small Office and Home Office (SOHO) Server
' 6 (&H6) Appliance PC
' 7 (&H7) Performance Server
' 8 (&H8) Maximum
' Usage example:
' var (systemType, hr, errInfo) = wmiGetPCSystemType()
' print systemType
' if hr then print errInfo
' ========================================================================================
PUBLIC FUNCTION wmiGetPCSystemType (BYREF wszServerName AS WSTRING = ".") AS (DVARIANT, HRESULT, USTRING)
   DIM hr AS HRESULT, dv AS DVARIANT
   DIM pServices AS CWmiServices = $"winmgmts:{impersonationLevel=impersonate}!\\" & wszServerName & $"\root\cimv2"
   DO
      hr = pServices.GetLastResult
      IF hr THEN EXIT DO
      hr = pServices.ExecQuery("SELECT PCSystemType FROM Win32_ComputerSystem")
      IF hr THEN EXIT DO
      hr = pServices.GetNamedProperties
      IF hr THEN EXIT DO
      dv = pServices.PropValue("PCSystemType")
      hr = pServices.GetLastResult
      EXIT DO
   LOOP
   RETURN(dv, hr, fbxWmiGetErrorCodeText(hr))
END FUNCTION
