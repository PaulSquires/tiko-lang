      hr = pServices.ExecQuery("SELECT Size FROM MSFT_PhysicalDisk")
      IF hr THEN EXIT DO
      hr = pServices.GetNamedProperties
      IF hr THEN EXIT DO
      dv = pServices.PropValue("Size")
      hr = pServices.GetLastResult
      EXIT DO
   LOOP
   RETURN(dv, hr, fbxWmiGetErrorCodeText(hr))
END FUNCTION
