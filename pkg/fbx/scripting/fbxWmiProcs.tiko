' ========================================================================================
' Short description of the object—a one-line string. The string includes the operating
' system version. For example, "Microsoft Windows 7 Enterprise ". This property can be localized.
' Windows Vista and Windows 7: This property may contain trailing characters. For example,
' the string "Microsoft Windows 7 Enterprise " (trailing space included) may be necessary
' to retrieve information using this property.
' Usage example:
' var (caption, hr, errInfo) = wmiGetOSCaption()
' print caption
' if hr then print errInfo
' ========================================================================================
PUBLIC FUNCTION wmiGetOSCaption (BYREF wszServerName AS WSTRING = ".") AS (DVARIANT, HRESULT, USTRING)
   DIM hr AS HRESULT, dv AS DVARIANT
   DIM pServices AS CWmiServices = $"winmgmts:{impersonationLevel=impersonate}!\\" & wszServerName & $"\root\cimv2"
   DO
      hr = pServices.GetLastResult
      IF hr THEN EXIT DO
      hr = pServices.ExecQuery("SELECT Caption FROM Win32_OperatingSystem")
      IF hr THEN EXIT DO
      hr = pServices.GetNamedProperties
      IF hr THEN EXIT DO
      dv = pServices.PropValue("Caption")
      hr = pServices.GetLastResult
      EXIT DO
   LOOP
   RETURN(dv, hr, fbxWmiGetErrorCodeText(hr))
END FUNCTION
