#import "fbx/com"
#import "fbx/core"
#include once "scripting.ti"
using com
using core

#INCLUDE ONCE "windows.bi"

' ========================================================================================
' * Retrieves the baseboard (also known as a motherboard or system board) serial number.
' Usage example:
' var (serialNumber, hr, errInfo) = wmiGetBaseBoardSerialNumber()
' print serialNumber
' if hr then print errInfo
' ========================================================================================
PUBLIC FUNCTION wmiGetBaseBoardSerialNumber (BYREF wszServerName AS WSTRING = ".") AS (DVARIANT, HRESULT, USTRING)
   DIM hr AS HRESULT, dv AS DVARIANT
   DIM pServices AS CWmiServices = $"winmgmts:{impersonationLevel=impersonate}!\\" & wszServerName & $"\root\cimv2"
   DO
      hr = pServices.GetLastResult
      IF hr THEN EXIT DO
      hr = pServices.ExecQuery("SELECT SerialNumber FROM Win32_BaseBoard")
      IF hr THEN EXIT DO
      hr = pServices.GetNamedProperties
      IF hr THEN EXIT DO
      dv = pServices.PropValue("SerialNumber")
      hr = pServices.GetLastResult
      EXIT DO
   LOOP
   RETURN(dv, hr, fbxWmiGetErrorCodeText(hr))
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Retrieves the Bios serial number.
' Usage example:
' var (serialNumber, hr, errInfo) = wmiGetBiosSerialNumber()
