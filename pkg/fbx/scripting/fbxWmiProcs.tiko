' ========================================================================================

' ========================================================================================
' Maximum number of process contexts the operating system can support. The default value
' set by the provider is 4294967295 (0xFFFFFFFF). If there is no fixed maximum, the value
' should be 0 (zero). On systems that have a fixed maximum, this object can help diagnose
' failures that occur when the maximum is reached—if unknown, enter 4294967295 (0xFFFFFFFF).
' Usage example:
' var (processes, hr, errInfo) = wmiGetOSMaxNumberOfProcesses()
' print processes
' if hr then print errInfo
' ========================================================================================
PUBLIC FUNCTION wmiGetOSMaxNumberOfProcesses (BYREF wszServerName AS WSTRING = ".") AS (DVARIANT, HRESULT, USTRING)
   DIM hr AS HRESULT, dv AS DVARIANT
   DIM pServices AS CWmiServices = $"winmgmts:{impersonationLevel=impersonate}!\\" & wszServerName & $"\root\cimv2"
   DO
      hr = pServices.GetLastResult
      IF hr THEN EXIT DO
      hr = pServices.ExecQuery("SELECT MaxNumberOfProcesses FROM Win32_OperatingSystem")
      IF hr THEN EXIT DO
      hr = pServices.GetNamedProperties
      IF hr THEN EXIT DO
      dv = pServices.PropValue("MaxNumberOfProcesses")
      hr = pServices.GetLastResult
      EXIT DO
   LOOP
   RETURN(dv, hr, fbxWmiGetErrorCodeText(hr))
END FUNCTION
' ========================================================================================

' ========================================================================================
' Maximum number, in kilobytes, of memory that can be allocated to a process.
