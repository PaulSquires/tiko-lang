' ========================================================================================
' Array of capabilities of the media access device. For example, the device may support
' random access (3), removable media (7), and automatic cleaning (9).
' Usage example:
' var (capabilities, hr, errInfo) = wmiGetCDROMDriveCapabilities()
' print capabilities
' if hr then print errInfo
' ========================================================================================
PUBLIC FUNCTION wmiGetCDROMDriveCapabilities (BYREF wszServerName AS WSTRING = ".") AS (DVARIANT, HRESULT, USTRING)
