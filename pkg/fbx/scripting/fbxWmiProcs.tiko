' ========================================================================================

' ========================================================================================
' Number, in kilobytes, of virtual memory. For example, this may be calculated by adding
' the amount of total RAM to the amount of paging space, that is, adding the amount of
' memory in or aggregated by the computer system to the property, SizeStoredInPagingFiles.
' Usage exampke:
' var (size, hr, errInfo) = wmiGetOSTotalVirtualMemorySize()
' print size
' if hr then print errInfo
' ========================================================================================
PUBLIC FUNCTION wmiGetOSTotalVirtualMemorySize (BYREF wszServerName AS WSTRING = ".") AS (DVARIANT, HRESULT, USTRING)
   DIM hr AS HRESULT, dv AS DVARIANT
   DIM pServices AS CWmiServices = $"winmgmts:{impersonationLevel=impersonate}!\\" & wszServerName & $"\root\cimv2"
   DO
      hr = pServices.GetLastResult
      IF hr THEN EXIT DO
      hr = pServices.ExecQuery("SELECT TotalVirtualMemorySize FROM Win32_OperatingSystem")
      IF hr THEN EXIT DO
      hr = pServices.GetNamedProperties
      IF hr THEN EXIT DO
      dv = pServices.PropValue("TotalVirtualMemorySize")
      hr = pServices.GetLastResult
      EXIT DO
   LOOP
   RETURN(dv, hr, fbxWmiGetErrorCodeText(hr))
END FUNCTION
' ========================================================================================

' ========================================================================================
' Total amount, in kilobytes, of physical memory available to the operating system. This
' value does not necessarily indicate the true amount of physical memory, but what is
' reported to the operating system as available to it.
' Usage example:
' var (size, hr, errInfo) = wmiGetOSTotalVisibleMemorySize()
' print size
' if hr then print errInfo
' ========================================================================================
PUBLIC FUNCTION wmiGetOSTotalVisibleMemorySize (BYREF wszServerName AS WSTRING = ".") AS (DVARIANT, HRESULT, USTRING)
   DIM hr AS HRESULT, dv AS DVARIANT
   DIM pServices AS CWmiServices = $"winmgmts:{impersonationLevel=impersonate}!\\" & wszServerName & $"\root\cimv2"
   DO
      hr = pServices.GetLastResult
      IF hr THEN EXIT DO
      hr = pServices.ExecQuery("SELECT TotalVisibleMemorySize FROM Win32_OperatingSystem")
      IF hr THEN EXIT DO
      hr = pServices.GetNamedProperties
      IF hr THEN EXIT DO
      dv = pServices.PropValue("TotalVisibleMemorySize")
      hr = pServices.GetLastResult
      EXIT DO
   LOOP
   RETURN(dv, hr, fbxWmiGetErrorCodeText(hr))
END FUNCTION
' ========================================================================================

' ========================================================================================
' Media Access Control (MAC) address of the network adapter. A MAC address is assigned by
' the manufacturer to uniquely identify the network adapter. Example: "00:80:C7:8F:6C:96".
' Usage example:
' var (addr, hr, errInfo) = wmiGetNetworkAdapterMACAddress()
' print addr
' if hr then print errInfo
' ========================================================================================
PUBLIC FUNCTION wmiGetNetworkAdapterMACAddress (BYREF wszServerName AS WSTRING = ".") AS (DVARIANT, HRESULT, USTRING)
   DIM hr AS HRESULT, dv AS DVARIANT
   DIM pServices AS CWmiServices = $"winmgmts:{impersonationLevel=impersonate}!\\" & wszServerName & $"\root\cimv2"
   DO
      hr = pServices.GetLastResult
      IF hr THEN EXIT DO
      hr = pServices.ExecQuery("SELECT MACAddress FROM Win32_NetworkAdapterConfiguration")
      IF hr THEN EXIT DO
      hr = pServices.GetNamedProperties
      IF hr THEN EXIT DO
      dv = pServices.PropValue("MACAddress")
      hr = pServices.GetLastResult
      EXIT DO
   LOOP
   RETURN(dv, hr, fbxWmiGetErrorCodeText(hr))
END FUNCTION
' ========================================================================================

' ========================================================================================
' Gets the physical sector size of the physical disk, in bytes. For example: for 4K native
' and 512-byte emulated disks, the value of this property should be 4096.
' Usage example:
' var (size, hr, errInfo) = wmiGetPhysicalDiskSectorSize()
' print size
' if hr then print errInfo
' ========================================================================================
PUBLIC FUNCTION wmiGetPhysicalDiskSectorSize (BYREF wszServerName AS WSTRING = ".") AS (DVARIANT, HRESULT, USTRING)
   DIM hr AS HRESULT, dv AS DVARIANT
   DIM pServices AS CWmiServices = $"winmgmts:{impersonationLevel=impersonate}!\\" & wszServerName & $"\root\Microsoft\Windows\Storage"
   DO
      hr = pServices.GetLastResult
      IF hr THEN EXIT DO
      hr = pServices.ExecQuery("SELECT PhysicalSectorSize FROM MSFT_PhysicalDisk")
      IF hr THEN EXIT DO
      hr = pServices.GetNamedProperties
      IF hr THEN EXIT DO
      dv = pServices.PropValue("PhysicalSectorSize")
      hr = pServices.GetLastResult
      EXIT DO
   LOOP
   RETURN(dv, hr, fbxWmiGetErrorCodeText(hr))
END FUNCTION
' ========================================================================================

' ========================================================================================
' Gets the total physical storage size of the disk, in bytes.
' Usage example:
' var (size, hr, errInfo) = wmiGetPhysicalDiskSize()
