' ========================================================================================
' Retrieves the localized name of the specified month.
' Already available in fbxWin.
' ========================================================================================
'PRIVATE FUNCTION fbxMonthName (BYVAL nMonth AS LONG, BYVAL lcid AS LCID = LOCALE_USER_DEFAULT) AS USTRING
'   DIM ST AS SYSTEMTIME, wszDate AS WSTRING * 260
'   GetLocalTime(@ST)
'   ST.wMonth = nMonth
'   GetDateFormatW(lcid, NULL, @ST, "MMMM", wszDate, SIZEOF(wszDate) \ 2)
'   RETURN wszDate
'END FUNCTION
' ========================================================================================

' ========================================================================================
' Retrieves the localized name of today's month.
' ========================================================================================
PUBLIC FUNCTION fbxLocalMonthName (BYVAL lcid AS LCID = LOCALE_USER_DEFAULT) AS USTRING
   DIM ST AS SYSTEMTIME, wszDate AS WSTRING * 260
   GetLocalTime(@ST)
   GetDateFormatW(lcid, NULL, @ST, "MMMM", wszDate, SIZEOF(wszDate) \ 2)
   RETURN wszDate
END FUNCTION
' ========================================================================================
' ========================================================================================
PUBLIC FUNCTION fbxSystemMonthName (BYVAL lcid AS LCID = LOCALE_USER_DEFAULT) AS USTRING
   DIM ST AS SYSTEMTIME, wszDate AS WSTRING * 260
   GetSystemTime(@ST)
   GetDateFormatW(lcid, NULL, @ST, "MMMM", wszDate, SIZEOF(wszDate) \ 2)
   RETURN wszDate
END FUNCTION
' ========================================================================================

' ========================================================================================
' Retrieves the localized short name of the specified month.
' ========================================================================================
PUBLIC FUNCTION fbxShortMonthName (BYVAL nMonth AS LONG, BYVAL lcid AS LCID = LOCALE_USER_DEFAULT) AS USTRING
   DIM ST AS SYSTEMTIME, wszDate AS WSTRING * 260
   GetLocalTime(@ST)
   ST.wMonth = nMonth
   GetDateFormatW(lcid, NULL, @ST, "MMM", wszDate, SIZEOF(wszDate) \ 2)
   RETURN wszDate
END FUNCTION
' ========================================================================================

' ========================================================================================
' Retrieves the localized short name of today's month.
' ========================================================================================
PUBLIC FUNCTION fbxLocalShortMonthName (BYVAL lcid AS LCID = LOCALE_USER_DEFAULT) AS USTRING
   DIM ST AS SYSTEMTIME, wszDate AS WSTRING * 260
   GetLocalTime(@ST)
   GetDateFormatW(lcid, NULL, @ST, "MMM", wszDate, SIZEOF(wszDate) \ 2)
   RETURN wszDate
END FUNCTION
' ========================================================================================
' ========================================================================================
PUBLIC FUNCTION fbxSystemShortMonthName (BYVAL lcid AS LCID = LOCALE_USER_DEFAULT) AS USTRING
   DIM ST AS SYSTEMTIME, wszDate AS WSTRING * 260
   GetSystemTime(@ST)
   GetDateFormatW(lcid, NULL, @ST, "MMM", wszDate, SIZEOF(wszDate) \ 2)
   RETURN wszDate
END FUNCTION
' ========================================================================================

' ========================================================================================
' Retrieves the localized name of today.
' ========================================================================================
PUBLIC FUNCTION fbxLocalDayName (BYVAL lcid AS LCID = LOCALE_USER_DEFAULT) AS USTRING
   DIM ST AS SYSTEMTIME, wszDate AS WSTRING * 260
   GetLocalTime(@ST)
   IF lcid = 0 THEN lcid = LOCALE_USER_DEFAULT
   GetDateFormatW(lcid, NULL, @ST, "dddd", wszDate, SIZEOF(wszDate) \ 2)
   RETURN wszDate
END FUNCTION
' ========================================================================================
' ========================================================================================
PUBLIC FUNCTION fbxSystemDayName (BYVAL lcid AS LCID = LOCALE_USER_DEFAULT) AS USTRING
   DIM ST AS SYSTEMTIME, wszDate AS WSTRING * 260
   GetSystemTime(@ST)
   IF lcid = 0 THEN lcid = LOCALE_USER_DEFAULT
   GetDateFormatW(lcid, NULL, @ST, "dddd", wszDate, SIZEOF(wszDate) \ 2)
   RETURN wszDate
END FUNCTION
' ========================================================================================

' ========================================================================================
' Retrieves the localized short name of today.
' ========================================================================================
PUBLIC FUNCTION fbxLocalDayShortName (BYVAL lcid AS LCID = LOCALE_USER_DEFAULT) AS USTRING
   DIM ST AS SYSTEMTIME, wszDate AS WSTRING * 260
   GetLocalTime(@ST)
   GetDateFormatW(lcid, NULL, @ST, "ddd", wszDate, SIZEOF(wszDate) \ 2)
   RETURN wszDate
END FUNCTION
' ========================================================================================
' ========================================================================================
PUBLIC FUNCTION fbxSystemDayShortName (BYVAL lcid AS LCID = LOCALE_USER_DEFAULT) AS USTRING
   DIM ST AS SYSTEMTIME, wszDate AS WSTRING * 260
   GetSystemTime(@ST)
   GetDateFormatW(lcid, NULL, @ST, "ddd", wszDate, SIZEOF(wszDate) \ 2)
   RETURN wszDate
END FUNCTION
' ========================================================================================

' ========================================================================================
' Returns the current day of week. It is a numeric value in the range of 0-6 representing
' Sunday through Saturday: 0 = Sunday, 1 = Monday, etc.
' ========================================================================================
PUBLIC FUNCTION fbxLocalDayOfWeek () AS WORD
   DIM ST AS SYSTEMTIME
   GetLocalTime @ST
   RETURN ST.wDayOfWeek
END FUNCTION
' ========================================================================================
' ========================================================================================
PUBLIC FUNCTION fbxSystemDayOfWeek () AS WORD
   DIM ST AS SYSTEMTIME
   GetSystemTime @ST
   RETURN ST.wDayOfWeek
END FUNCTION
' ========================================================================================

' ========================================================================================
' Returns the localized name of the day of the week.
' Parameters:
' - nDay: A number between 1-31.
' - nMonth: A number between 1-12.
' - nYear: A four digit year, e.g. 2011.
' Return Value:
' - The localized day of week name.
' ========================================================================================
PUBLIC FUNCTION fbxLocalDayOfWeekName (BYVAL nDay AS LONG, BYVAL nMonth AS LONG, BYVAL nYear AS LONG, BYVAL lcid AS LCID = LOCALE_USER_DEFAULT) AS USTRING
   DIM ST AS SYSTEMTIME
   DIM wszDate AS WSTRING * 260
   ST.wYear = nYear
   ST.wMonth = nMonth
   ST.wDay = nDay
   GetDateFormatW(lcid, NULL, @ST, "dddd", wszDate, SIZEOF(wszDate) \ 2)
   RETURN wszDate
END FUNCTION
' ========================================================================================

' ========================================================================================
' Retrieves the localized short name of the day of the week.
' Parameters:
' - nDay: A number between 1-31.
' - nMonth; A number between 1-12.
' - nYear: A four digit year, e.g. 2011.
' Return Value:
' - The localized day of week short name.
' ========================================================================================
PUBLIC FUNCTION fbxLocalDayOfWeekShortName (BYVAL nDay AS LONG, BYVAL nMonth AS LONG, BYVAL nYear AS LONG, BYVAL lcid AS LCID = LOCALE_USER_DEFAULT) AS USTRING
   DIM ST AS SYSTEMTIME
   DIM wszDate AS WSTRING * 260
   ST.wYear = nYear
   ST.wMonth = nMonth
   ST.wDay = nDay
   GetDateFormatW(lcid, NULL, @ST, "ddd", wszDate, SIZEOF(wszDate) \ 2)
   RETURN wszDate
END FUNCTION
' ========================================================================================

' ========================================================================================
' Retuns the current local date based on the specified mask, e.g. "dd-MM-yyyy".
' ========================================================================================
PUBLIC FUNCTION fbxLocalDateStr (BYREF wszMask AS WSTRING, BYVAL lcid AS LCID = LOCALE_USER_DEFAULT) AS USTRING
   DIM wszDateStr AS WSTRING * 260
   GetDateFormatW(lcid, NULL, NULL, wszMask, wszDateStr, SIZEOF(wszDateStr) \ 2)
   RETURN wszDateStr
END FUNCTION
' ========================================================================================

' ========================================================================================
' Retuns the current local time based on the specified mask, e.g. "hh':'mm':'ss".
' ========================================================================================
PUBLIC FUNCTION fbxLocalTimeStr (BYREF wszMask AS WSTRING, BYVAL lcid AS LCID = LOCALE_USER_DEFAULT) AS USTRING
   DIM wszDateStr AS WSTRING * 260
   GetTimeFormatW(lcid, NULL, NULL, wszMask, wszDateStr, SIZEOF(wszDateStr) \ 2)
   RETURN wszDateStr
END FUNCTION
' ========================================================================================

' ========================================================================================
' Retuns the current UTC date based on the specified mask, e.g. "dd-MM-yyyy".
' ========================================================================================
PUBLIC FUNCTION fbxUtcDateStr (BYREF wszMask AS WSTRING, BYVAL lcid AS LCID = LOCALE_USER_DEFAULT) AS USTRING
   DIM utctime AS SYSTEMTIME
   GetSystemTime(@utctime)
   DIM wszDateStr AS WSTRING * 260
   GetDateFormatW(lcid, NULL, @utctime, wszMask, wszDateStr, SIZEOF(wszDateStr) \ 2)
   RETURN wszDateStr
END FUNCTION
' ========================================================================================

' ========================================================================================
' Retuns the current UTC time based on the specified mask, e.g. "hh':'mm':'ss".
' ========================================================================================
PUBLIC FUNCTION fbxUtcTimeStr (BYREF wszMask AS WSTRING, BYVAL lcid AS LCID = LOCALE_USER_DEFAULT) AS USTRING
   DIM utctime AS SYSTEMTIME
   GetSystemTime(@utctime)
   DIM wszTimeStr AS WSTRING * 260
   GetTimeFormatW(lcid, NULL, @utctime, wszMask, wszTimeStr, SIZEOF(wszTimeStr) \ 2)
   RETURN wszTimeStr
END FUNCTION
' ========================================================================================

' ========================================================================================
' Returns the Astronomical Day for any given date.
' Parameters:
' - nDay: A number between 1-31.
' - nMonth; A number between 1-12.
' - nYear: A four digit year, e.g. 2011.
' Return Value:
' - The Astronomical Day.
' See: http://support.microsoft.com/kb/109451/en-us
' Note: Among other things, can be used to find the number of days between any two dates, e.g.:
' PRINT fbxAstroDay(1, 3, -12400) - fbxAstroDay(28, 2, -12400)  ' Prints 2
' PRINT fbxAstroDay(1, 3, 12000) - fbxAstroDay(28, 2, -12000) ' Prints 8765822
' PRINT fbxAstroDay(28, 2, 1902) - fbxAstroDay(1, 3, 1898)  ' Prints 1459 days
' ========================================================================================
PUBLIC FUNCTION fbxAstroDay (BYVAL nDay AS LONG, BYVAL nMonth AS LONG, BYVAL nYear AS LONG) AS LONG
   DIM y AS DOUBLE = nYear + (nMonth - 2.85) / 12
   RETURN INT(INT(INT(367 * y) - 1.75 * INT(y) + nDay) - 0.75 * INT(0.01 * y)) + 1721119
END FUNCTION
' ========================================================================================

' ========================================================================================
' Calculates the day of the week, Sunday through Monday, of a given date.
' Parameters:
' - nDay: A number between 1-31.
' - nMonth; A number between 1-12.
' - nYear: A four digit year, e.g. 2011.
' Return Value:
' - A number between 0-6, where 0 = Sunday, 1 = Monday, 2 = Tuesday, 3 = Wednesday,
'   4 = Thursday, 5 = Friday, 6 = Saturday.
' ========================================================================================
PUBLIC FUNCTION fbxAstroDayOfWeek (BYVAL nDay AS LONG, BYVAL nMonth AS LONG, BYVAL nYear AS LONG) AS LONG
   RETURN fbxAstroDay(nDay, nMonth, nYear) MOD 7
END FUNCTION
' ========================================================================================

' ========================================================================================
' Converts a Gregorian date to a Julian date.
' Parameters:
' - nDay: A number between 1-31.
' - nMonth: A number between 1-12.
' - nYear: A four digit year, e.g. 2011.
' Return Value:
' - The converted date.
' ========================================================================================
PUBLIC FUNCTION fbxGregorianToJulian (BYVAL nDay AS LONG, BYVAL nMonth AS LONG, BYVAL nYear AS LONG) AS LONG

   DIM DaysElapsed AS LONG
   DIM InvalidLeapYears AS LONG
   DIM ValidLeapYears AS LONG
   DIM DaysOfMonths AS LONG

   ' // January or February? 13 or 14th month of the previous year.
   IF nMonth < 3 THEN nMonth += 12 : nYear -=1
   ' // Day 1 of julian calendar is 1/1/-4712 and there are 365.25 days per year
   DaysElapsed = INT((nYear + 4712) * 365.25)
   ' // Subtract invalid leap years
   InvalidLeapYears = nYear \ 100
   ' // Add valid leap years
   ValidLeapYears = nYear \ 400
   ' // Days of months
   DaysOfMonths = INT(30.6 * (nMonth - 1) + .2)

   RETURN DaysElapsed - InvalidLeapYears + ValidLeapYears + DaysOfMonths + nDay

END FUNCTION
' ========================================================================================

' ========================================================================================
' Calculates the days of difference between two dates.
' Parameters:
' - nDay1, nMonth1, nYear1 : The first date
' - nDay2, nMonth2, nYear2 : The second date
' Return Value:
' - The days of difference.
' ========================================================================================
PUBLIC FUNCTION fbxDateDiff (BYVAL nDay1 AS LONG, BYVAL nMonth1 AS LONG, BYVAL nYear1 AS LONG, _
   BYVAL nDay2 AS LONG, BYVAL nMonth2 AS LONG, BYVAL nYear2 AS LONG) AS LONG
   DIM t1 AS LONG = fbxGregorianToJulian(nDay1, nMonth1, nYear1)
   DIM t2 AS LONG = fbxGregorianToJulian(nDay2, nMonth2, nYear2)
   RETURN t2 - t1
END FUNCTION
' ========================================================================================

' ========================================================================================
' Adds the specified number of days to a given date.
' Parameters:
' - nDay: A number between 1-31.
' - nMonth:s A number between 1-12.
' - nYear: A four digit year, e.g. 2011.
' - nDays: The number of days to add (or subtract, if the number is negative).
' Return Value:
' - The new date in Julian format. To convert it to Gregorian, call functions such
'   fbxJulianToGregorian or fbxJulianToGregorianStr.
' ========================================================================================
PUBLIC FUNCTION fbxDateAddDays (BYVAL nDay AS LONG, BYVAL nMonth AS LONG, BYVAL nYear AS LONG, BYVAL nDays AS LONG) AS LONG
   RETURN fbxGregorianToJulian(nDay, nMonth, nYear) + nDays
END FUNCTION
' ========================================================================================

' ========================================================================================
' Returns the first day of the first week of a year. The year must be a 4 digit year.
' Please note that the result can be one of the last days of the previous year, e.g. the
' first day of the first week of year 2002 is 31 December 2001.
' To convert the returned julian date to gregorian use fbxJulianToGregorian or fbxJulianToGreorianStr.
' ========================================================================================
PUBLIC FUNCTION fbxWeekOne (BYVAL nYear AS LONG) AS LONG
   DIM nFirstDay AS LONG = fbxGregorianToJulian(1, 1, nYear) - 1  ' Dec. 31 of prev. year
   DO
      nFirstDay += 1
   LOOP UNTIL (nFirstDay MOD 7 + 1) = 4    ' until first Thursday of the year is found
   RETURN nFirstDay - 3                ' first day of week 1 is a Monday
END FUNCTION
' ========================================================================================

' ========================================================================================
' Returns the week number for a given date. The year must be a 4 digit year.
' ========================================================================================
PUBLIC FUNCTION fbxWeekNumber (BYVAL nDay AS LONG, BYVAL nMonth AS LONG, BYVAL nYear AS LONG) AS LONG
   DIM nFirstDay AS LONG = fbxWeekOne(nYear)
   DIM nFinalDay AS LONG = fbxWeekOne(nYear + 1) - 1
   DIM nToDay AS LONG = fbxGregorianToJulian(nDay, nMonth, nYear)
   SELECT CASE nToDay
      CASE IS < nFirstDay
         ' it is week 52 or 53, but which one?
         ' therefore we need week one of previous year as a starting point
         nFirstDay = fbxWeekOne(nYear - 1)
      CASE IS > nFinalDay
         ' there is only one possibility: week number 1
         RETURN 1
   END SELECT
   RETURN ((nToDay - nFirstDay) \ 7) + 1
END FUNCTION
' ========================================================================================

' ========================================================================================
' Returns the number of weeks in the year, where weeks are taken to start on Monday. Will be 52 or 53.
' ========================================================================================
PUBLIC FUNCTION fbxWeeksInYear (BYVAL nYear AS LONG) AS LONG
   DIM nWeeks AS LONG = fbxWeekNumber(31, 12, nYear)
   IF nWeeks = 53 THEN RETURN 53 ELSE RETURN 52
END FUNCTION
' ========================================================================================

' ========================================================================================
' Determines if a given year is a leap year or not.
' Parameters:
' - nYear: A four digit year, e.g. 2011.
' Return Value:
' - TRUE or FALSE.
' Note: A leap year is defined as all years divisible by 4, except for years divisible by
' 100 that are not also divisible by 400. Years divisible by 400 are leap years. 2000 is a
' leap year. 1900 is not a leap year.
' ========================================================================================
PUBLIC FUNCTION fbxIsLeapYear (BYVAL nYear AS LONG) AS BOOLEAN
   IF (nYear MOD 4 = 0 AND nYear MOD 100 <> 0) OR nYear MOD 400 = 0 THEN RETURN TRUE
END FUNCTION
' ========================================================================================

' ========================================================================================
' Calculaates the number of leap years between two years
' ========================================================================================
PUBLIC FUNCTION fbxNumberOfLeapYears (BYVAL year1 AS LONG, BYVAL year2 AS LONG) AS LONG
   ' // Normalize order
   IF year1 > year2 THEN SWAP year1, year2
   DIM count AS LONG
   FOR i AS LONG = year1 TO year2
      IF (i MOD 4 = 0 AND (i MOD 100 <> 0 OR i MOD 400 = 0)) THEN count += 1
   NEXT
   RETURN count
END FUNCTION
' ========================================================================================

' ========================================================================================
' Returns the number of days in the specified month.
' Parameters:
' - nMonth: A two digit month (1-12).
' - nYear: A four digit year, e.g. 2011.
' Return Value:
' - The number of days.
' ========================================================================================
PUBLIC FUNCTION fbxDaysInMonth (BYVAL nMonth AS LONG, BYVAL nYear AS LONG) AS LONG
   SELECT CASE nMonth
      CASE 2 : IF fbxIsLeapYear(nYear) THEN RETURN 29 ELSE RETURN 28
      CASE 4, 6, 9, 11 : RETURN 30
      CASE 1, 3, 5, 7, 8, 10, 12 : RETURN 31
   END SELECT
END FUNCTION
' ========================================================================================

' ========================================================================================
' Returns the number of weeks in the specified month. Will be 4 or 5.
' ========================================================================================
PUBLIC FUNCTION fbxWeeksInMonth (BYVAL nMonth AS LONG, BYVAL nYear AS LONG) AS LONG
   DIM wim AS LONG = fbxAstroDayOfWeek(1, nMonth, nYear) - 1
   IF wim = -1 THEN wim = 6
   DIM nWeeks AS LONG = (fbxDaysInMonth(nMonth, nYear) + wim) \ 7
   RETURN nWeeks
END FUNCTION
' ========================================================================================

' ========================================================================================
' Returns the number of days in the specified year.
' Parameters:
' - nYear: A four digit year, e.g. 2011.
' Return Value:
' - The number of days. Will be 365 or 366 (for leap years).
' ========================================================================================
PUBLIC FUNCTION fbxDaysInYear (BYVAL nYear AS LONG) AS LONG
   IF fbxIsLeapYear(nYear) THEN RETURN 366 ELSE RETURN 365
END FUNCTION
' ========================================================================================

' ========================================================================================
' Returns TRUE if today is the first day of the month; False, otherwise.
' ========================================================================================
PUBLIC FUNCTION fbxIsFirstDayOfMonth () AS BOOLEAN
   DIM ST AS SYSTEMTIME
   GetLocalTime @ST
   RETURN (ST.wDay = 1)
END FUNCTION
' ========================================================================================

' ========================================================================================
' Returns TRUE if the date is the last day of the month; False, otherwise.
' ========================================================================================
PUBLIC FUNCTION fbxIsLastDayOfMonth () AS BOOLEAN
   DIM ST AS SYSTEMTIME
   GetLocalTime @ST
   RETURN (ST.wDay = fbxDaysInMonth(ST.wMonth, ST.wYear))
END FUNCTION
' ========================================================================================

' ========================================================================================
' Given a Julian date, returns the day of week.
' ========================================================================================
PUBLIC FUNCTION fbxJulianDayOfWeek (BYVAL nJulian AS LONG) AS LONG
   DIM dow AS LONG = (nJulian + 1) MOD 7
   IF dow >= 0 THEN RETURN dow ELSE RETURN dow + 7
END FUNCTION
' ========================================================================================

' ========================================================================================
' Converts a Julian date to a Gregorian date.
' Parameters:
' - nJulian [in] = The julian date to convert
' - nDay [out] = The day
' - nMonth [out] = The month
' - nYear [out] = The year
' ========================================================================================
PUBLIC SUB fbxJulianToGregorian (BYVAL nJulian AS LONG, BYREF wDay AS WORD, BYREF wMonth AS WORD, BYREF wYear AS WORD)
   nJulian = nJulian + 68569
   DIM nHelp AS LONG = 4 * nJulian \ 146097
   nJulian = nJulian - ((146097 * nHelp + 3) \ 4)
   DIM nTmpYear AS LONG = 4000 * (nJulian + 1) \ 1461001
   nJulian = nJulian - (1461 * nTmpYear \ 4) + 31
   DIM nTmpMonth AS LONG = 80 * nJulian \ 2447
   wDay = nJulian - (2447 * nTmpMonth \ 80)
   wMonth = nTmpMonth + 2 - (12 * (nTmpMonth \ 11))
   wYear = 100 * (nHelp - 49) + nTmpYear + (nTmpMonth \ 11)
END SUB
' ========================================================================================

' ========================================================================================
' Converts a Julian date to a Gregorian date based on the specified mask, e.g. "dd-MM-yyyy".
' Parameters:
' - bstrMask = The format string.
' - nJulian = The Julian date to convert.
' Return Value:
' - The converted date.
' ========================================================================================
PUBLIC FUNCTION fbxJulianToGregorianStr (BYREF wszMask AS WSTRING, BYVAL nJulian AS LONG, BYVAL lcid AS LCID = LOCALE_USER_DEFAULT) AS USTRING
   DIM ST AS SYSTEMTIME
   DIM wszDate AS WSTRING * 260
   fbxJulianToGregorian(nJulian, ST.wDay, ST.wMonth, ST.wYear)
   GetDateFormatW(lcid, NULL, @ST, wszMask, wszDate, SIZEOF(wszDate) \ 2)
   RETURN wszDate
END FUNCTION
' ========================================================================================

' ========================================================================================
' Returns the day of the year, where Jan 1 is the first day of the year.
' ========================================================================================
PUBLIC FUNCTION fbxDayOfYear (BYVAL nDay AS LONG, BYVAL nMonth AS LONG, BYVAL nYear AS LONG) AS LONG
   RETURN fbxAstroDay(nDay, nMonth, nYear) - fbxAstroDay(1, 1, nYear) + 1
END FUNCTION
' ========================================================================================

' ========================================================================================
' Returns the number of days between two given dates.
' ========================================================================================
PUBLIC FUNCTION fbxDaysBetween (BYVAL nDay1 AS LONG, BYVAL nMonth1 AS LONG, BYVAL nYear1 AS LONG, BYVAL nDay2 AS LONG, BYVAL nMonth2 AS LONG, BYVAL nYear2 AS LONG) AS LONG
   RETURN fbxAstroDay(nDay1, nMonth1, nYear1) - fbxAstroDay(nDay2, nMonth2, nYear2)
END FUNCTION
' ========================================================================================

' ========================================================================================
' Returns the current date in long format.
' ========================================================================================
PUBLIC FUNCTION fbxLongDate (BYVAL lcid AS LCID = LOCALE_USER_DEFAULT) AS USTRING
   DIM ST AS SYSTEMTIME
   DIM wszDate AS WSTRING * 260
   GetLocalTime @ST
   GetDateFormatW(lcid, DATE_LONGDATE, @ST, BYVAL NULL, wszDate, SIZEOF(wszDate) \ 2)
   RETURN wszDate
END FUNCTION
' ========================================================================================

' ========================================================================================
' Returns the current date in short format.
' ========================================================================================
PUBLIC FUNCTION fbxShortDate (BYVAL lcid AS LCID = LOCALE_USER_DEFAULT) AS USTRING
   DIM ST AS SYSTEMTIME
   DIM wszDate AS WSTRING * 260
   GetLocalTime @ST
   GetDateFormatW(lcid, DATE_SHORTDATE, @ST, NULL, wszDate, SIZEOF(wszDate) \ 2)
   RETURN wszDate
END FUNCTION
' ========================================================================================

' ========================================================================================
' Returns the curent date and time as a QUAD (8 bytes). IN FB, a QUAD is an ULONGLONG.
' ========================================================================================
PUBLIC FUNCTION fbxQuadDateTime () AS ULONGLONG
   DIM ST AS SYSTEMTIME, FT AS FILETIME
   GetLocalTime @ST
   SystemTimeToFileTime @ST, @FT
   DIM uli AS ULARGE_INTEGER
   uli.LowPart = FT.dwLowDateTime
   uli.HighPart = FT.dwHighDateTime
   RETURN uli.QuadPart
END FUNCTION
' ========================================================================================

' ========================================================================================
' Converts a date stored in a QUAD into a formatted date string. For example, to get a date
' string formated like "Wed, Aug 31 2016" use the following picture string: "ddd',' MMM dd yyy".
' IN FB, a QUAD is an ULONGLONG.
' ========================================================================================
PUBLIC FUNCTION fbxQuadDateToStr (BYREF wszMask AS WSTRING, BYVAL ullTime AS ULONGLONG, BYVAL lcid AS LCID = LOCALE_USER_DEFAULT) AS USTRING
   DIM ST AS SYSTEMTIME, FT AS FILETIME
   DIM uli AS ULARGE_INTEGER
   uli.QuadPart = ullTime
   FT.dwLowDateTime = uli.LowPart
   FT.dwHighDateTime = uli.HighPart
   FileTimeToSystemTime(@FT, @ST)
   DIM wszDate AS WSTRING * 260
   GetDateFormatW(lcid, NULL, @ST, wszMask, wszDate, SIZEOF(wszDate) \ 2)
   RETURN wszDate
END FUNCTION
' ========================================================================================

' ========================================================================================
' Converts a time stored in a QUAD into a formatted time string. For example, to get a time
' string like "11:29:40 PM" use the following picture string: "hh':'mm':'ss tt".
' IN FB, a QUAD is an ULONGLONG.
' ========================================================================================
PUBLIC FUNCTION fbxQuadTimeToStr (BYREF wszMask AS WSTRING, BYVAL ullTime AS ULONGLONG, BYVAL lcid AS LCID = LOCALE_USER_DEFAULT) AS USTRING
   DIM ST AS SYSTEMTIME, FT AS FILETIME
   DIM uli AS ULARGE_INTEGER
   uli.QuadPart = ullTime
   FT.dwLowDateTime = uli.LowPart
   FT.dwHighDateTime = uli.HighPart
   FileTimeToSystemTime(@FT, @ST)
   DIM wszDate AS WSTRING * 260
   GetTimeFormatW(lcid, NULL, @ST, wszMask, wszDate, SIZEOF(wszDate) \ 2)
   RETURN wszDate
END FUNCTION
' ========================================================================================

' ========================================================================================
' Returns the time zone identifier.
' Return values:
' - TIME_ZONE_ID_UNKNOWN (0)
'     Daylight saving time is not used in the current time zone, because there are no
'     transition dates or automatic adjustment for daylight saving time is disabled.
' - TIME_ZONE_ID_STANDARD (1)
'     The system is operating in the range covered by the StandardDate member of the
'     TIME_ZONE_INFORMATION structure.
' - TIME_ZONE_ID_DAYLIGHT (2)
'     The system is operating in the range covered by the DaylightDate member of the
'     TIME_ZONE_INFORMATION structure.
' If the function fails for other reasons, such as an out of memory error, it returns
' TIME_ZONE_ID_INVALID. To get extended error information, call GetLastError.
' ========================================================================================
PUBLIC FUNCTION fbxTimeZoneId () AS DWORD
   DIM tzi AS TIME_ZONE_INFORMATION
   RETURN GetTimeZoneInformation(@tzi)
END FUNCTION
' ========================================================================================

' ========================================================================================
' Indicates whether the the system is operating in the range covered by the StandardDate
' member of the TIME_ZONE_INFORMATION structure.
' ========================================================================================
PUBLIC FUNCTION fbxTimeZoneIsStandardSavingTime () AS BOOLEAN
   DIM tzi AS TIME_ZONE_INFORMATION
   DIM r AS DWORD = GetTimeZoneInformation(@tzi)
   RETURN (r = TIME_ZONE_ID_STANDARD)
END FUNCTION
' ========================================================================================

' ========================================================================================
' Indicates whether the the system is operating in the range covered by the DaylightDate
' member of the TIME_ZONE_INFORMATION structure.
' ========================================================================================
PUBLIC FUNCTION fbxTimeZoneIsDaylightSavingTime () AS BOOLEAN
   DIM tzi AS TIME_ZONE_INFORMATION
   DIM r AS DWORD = GetTimeZoneInformation(@tzi)
   RETURN (r = TIME_ZONE_ID_DAYLIGHT)
END FUNCTION
' ========================================================================================

' ========================================================================================
' Current bias for local time translation. The bias is the difference between Coordinated
' Universal Time (UTC) and local time. All translations between UTC and local time are
' based on the following formula: UTC = local time + bias. Units = minutes.
' ========================================================================================
PUBLIC FUNCTION fbxTimeZoneBias () AS LONG
   DIM tzi AS TIME_ZONE_INFORMATION
   DIM r AS DWORD = GetTimeZoneInformation(@tzi)
   IF r = TIME_ZONE_ID_INVALID THEN RETURN 0
   RETURN tzi.Bias
END FUNCTION
' ========================================================================================

' ========================================================================================
' Bias value to be used during local time translations that occur during daylight saving
' time. This property is ignored if a value for the DaylightDay property is not supplied.
' The value of this property is added to the Bias property to form the bias used during
' daylight time. In most time zones, the value of this property is 60. Units = minutes.
' ========================================================================================
PUBLIC FUNCTION fbxTimeZoneDaylightBias () AS LONG
   DIM tzi AS TIME_ZONE_INFORMATION
   DIM r AS DWORD = GetTimeZoneInformation(@tzi)
   IF r = TIME_ZONE_ID_INVALID THEN RETURN 0
   RETURN tzi.DaylightBias
END FUNCTION
' ========================================================================================

' ========================================================================================
' A description for standard time. For example, "EST" could indicate Eastern Standard Time.
' The string will be returned unchanged by the GetTimeZoneInformation function.
' This string can be empty.
' ========================================================================================
PUBLIC FUNCTION fbxTimeZoneStandardName () AS USTRING
   DIM tzi AS TIME_ZONE_INFORMATION
   DIM r AS DWORD = GetTimeZoneInformation(@tzi)
   IF r = TIME_ZONE_ID_INVALID THEN RETURN ""
   RETURN tzi.StandardName
END FUNCTION
' ========================================================================================

' ========================================================================================
' A description for daylight saving time. For example, "PDT" could indicate Pacific
' Daylight Time. The string will be returned unchanged by the GetTimeZoneInformation
' function. This string can be empty.
' ========================================================================================
PUBLIC FUNCTION fbxTimeZoneDaylightName () AS USTRING
   DIM tzi AS TIME_ZONE_INFORMATION
   DIM r AS DWORD = GetTimeZoneInformation(@tzi)
   IF r = TIME_ZONE_ID_INVALID THEN RETURN ""
   RETURN tzi.DaylightName
END FUNCTION
' ========================================================================================

' ========================================================================================
' DaylightDayOfWeek of the DaylightMonth when the transition from standard time to daylight
' saving time occurs on this operating system.
' Example: If the transition day (DaylightDayOfWeek) occurs on a Sunday, then the value
' "1" indicates the first Sunday of the DaylightMonth, "2" indicates the second Sunday,
' and so on. The value "5" indicates the last DaylightDayOfWeek in the month.
' ========================================================================================
PUBLIC FUNCTION fbxTimeZoneDaylightDay () AS WORD
   DIM tzi AS TIME_ZONE_INFORMATION
   DIM r AS DWORD = GetTimeZoneInformation(@tzi)
   IF r = TIME_ZONE_ID_INVALID THEN RETURN 0
   RETURN tzi.DaylightDate.wDay
END FUNCTION
' ========================================================================================

' ========================================================================================
' Day of the week when the transition from standard time to daylight saving time occurs on
' an operating system. 0 = Sunday, 1 = Monday, and so on.
' ========================================================================================
PUBLIC FUNCTION fbxTimeZoneDaylightDayOfWeek () AS WORD
   DIM tzi AS TIME_ZONE_INFORMATION
   DIM r AS DWORD = GetTimeZoneInformation(@tzi)
   IF r = TIME_ZONE_ID_INVALID THEN RETURN 0
   RETURN tzi.DaylightDate.wDayOfWeek
END FUNCTION
' ========================================================================================

' ========================================================================================
' Hour of the day when the transition from standard time to daylight saving time occurs on
' an operating system.
' ========================================================================================
PUBLIC FUNCTION fbxTimeZoneDaylightHour () AS WORD
   DIM tzi AS TIME_ZONE_INFORMATION
   DIM r AS DWORD = GetTimeZoneInformation(@tzi)
   IF r = TIME_ZONE_ID_INVALID THEN RETURN 0
   RETURN tzi.DaylightDate.wHour
END FUNCTION
' ========================================================================================

' ========================================================================================
' Month when the transition from standard time to daylight saving time occurs on an
' operating system.
' ========================================================================================
PUBLIC FUNCTION fbxTimeZoneDaylightMonth () AS WORD
   DIM tzi AS TIME_ZONE_INFORMATION
   DIM r AS DWORD = GetTimeZoneInformation(@tzi)
   IF r = TIME_ZONE_ID_INVALID THEN RETURN 0
   RETURN tzi.DaylightDate.wMonth
END FUNCTION
' ========================================================================================

' ========================================================================================
' Minute of the DaylightHour when the transition from standard time to daylight saving
' time occurs on an operating system.
' ========================================================================================
PUBLIC FUNCTION fbxTimeZoneDaylightMinute () AS WORD
   DIM tzi AS TIME_ZONE_INFORMATION
   DIM r AS DWORD = GetTimeZoneInformation(@tzi)
   IF r = TIME_ZONE_ID_INVALID THEN RETURN 0
   RETURN tzi.DaylightDate.wMinute
END FUNCTION
' ========================================================================================

' ========================================================================================
' StandardDayOfWeek of the StandardMonth when the transition from daylight saving time to
' standard time occurs on an operating system.
' If the transition day (StandardDayOfWeek) occurs on a Sunday, then the value "1" indicates
' the first Sunday of the StandardMonth, "2" indicates the second Sunday, and so on.
' The value "5" indicates the last StandardDayOfWeek in the month.
' ========================================================================================
PUBLIC FUNCTION fbxTimeZoneStandardDay () AS WORD
   DIM tzi AS TIME_ZONE_INFORMATION
   DIM r AS DWORD = GetTimeZoneInformation(@tzi)
   IF r = TIME_ZONE_ID_INVALID THEN RETURN 0
   RETURN tzi.StandardDate.wDay
END FUNCTION
' ========================================================================================

' ========================================================================================
' Day of the week when the transition from daylight saving time to standard time occurs on
' an operating system.
' Sunday (0), Monday (1), Tuesday (2), Wednesday (3), Thursday (4), Friday (5), Saturday (6)
' ========================================================================================
PUBLIC FUNCTION fbxTimeZoneStandardDayOfWeek () AS WORD
   DIM tzi AS TIME_ZONE_INFORMATION
   DIM r AS DWORD = GetTimeZoneInformation(@tzi)
   IF r = TIME_ZONE_ID_INVALID THEN RETURN 0
   RETURN tzi.StandardDate.wDayOfWeek
END FUNCTION
' ========================================================================================

' ========================================================================================
' Hour of the day when the transition from daylight saving time to standard time occurs on
' an operating system. Example: 11
' ========================================================================================
PUBLIC FUNCTION fbxTimeZoneStandardHour () AS WORD
   DIM tzi AS TIME_ZONE_INFORMATION
   DIM r AS DWORD = GetTimeZoneInformation(@tzi)
   IF r = TIME_ZONE_ID_INVALID THEN RETURN 0
   RETURN tzi.StandardDate.wHour
END FUNCTION
' ========================================================================================

' ========================================================================================
' Month when the transition from daylight saving time to standard time occurs on an operating system.
' January (1), February (2), and so on.
' ========================================================================================
PUBLIC FUNCTION fbxTimeZoneStandardMonth () AS WORD
   DIM tzi AS TIME_ZONE_INFORMATION
   DIM r AS DWORD = GetTimeZoneInformation(@tzi)
   IF r = TIME_ZONE_ID_INVALID THEN RETURN 0
   RETURN tzi.StandardDate.wMonth
END FUNCTION
' ========================================================================================

' ========================================================================================
' Minute of the StandardHour when the transition from daylight saving time to standard time
' occurs on an operating system.
' ========================================================================================
PUBLIC FUNCTION fbxTimeZoneStandardMinute () AS WORD
   DIM tzi AS TIME_ZONE_INFORMATION
   DIM r AS DWORD = GetTimeZoneInformation(@tzi)
   IF r = TIME_ZONE_ID_INVALID THEN RETURN 0
   RETURN tzi.StandardDate.wMinute
END FUNCTION
' ========================================================================================

' ========================================================================================
' Returns the local date and time as a DATE_ (double).
' ========================================================================================
PUBLIC FUNCTION fbxLocalVariantTime () AS DATE_
   DIM ST AS SYSTEMTIME, dt AS DATE_
   GetLocalTime @ST
   SystemTimeToVariantTime @ST, @dt
   RETURN dt
END FUNCTION
' ========================================================================================

' ========================================================================================
' Converts a SYSTEMTIME to a DATE_ (double).
' ========================================================================================
PUBLIC FUNCTION fbxSystemTimeToVariantTime (BYREF ST AS SYSTEMTIME) AS DATE_
   DIM dt AS DATE_
   SystemTimeToVariantTime @ST, @dt
   RETURN dt
END FUNCTION
' ========================================================================================

' ========================================================================================
' Converts a DATE_ (double) to a SYSTEMTIME.
' ========================================================================================
PUBLIC FUNCTION fbxVariantTimeToSystemTime (BYVAL dt AS DATE_) AS SYSTEMTIME
   DIM ST AS SYSTEMTIME
   VariantTimeToSystemTime dt, @ST
   RETURN ST
END FUNCTION
' ========================================================================================

' ========================================================================================
' Converts a FILETIME to a DATE_ (double).
' ========================================================================================
PUBLIC FUNCTION fbxFileTimeToVariantTime (BYREF FT AS FILETIME) AS DATE_
   DIM dt AS DATE_, ST AS SYSTEMTIME
   FileTimeToSystemTime(@FT, @ST)
   SystemTimeToVariantTime @ST, @dt
   RETURN dt
END FUNCTION
' ========================================================================================

' ========================================================================================
' Converts a DATE_ type to a string containing the date and the time.
' ========================================================================================
PUBLIC FUNCTION fbxVariantDateTimeToStr (BYVAL vbDate AS DATE_, BYVAL lcid AS LCID = LOCALE_USER_DEFAULT, BYVAL dwFlags AS DWORD = 0) AS USTRING
   DIM bstrOut AS FBX_BSTR
   VarBstrFromDate(vbDate, lcid, dwFlags, @bstrOut)
   DIM ustrOut AS USTRING = *bstrOut
   SysFreeString bstrOut
   RETURN ustrOut
END FUNCTION
' ========================================================================================

' ========================================================================================
' Converts a DATE_ type to a string containing only the date.
' ========================================================================================
PUBLIC FUNCTION fbxVariantDateToStr (BYVAL vbDate AS DATE_, BYVAL lcid AS LCID = LOCALE_USER_DEFAULT) AS USTRING
   DIM bstrOut AS FBX_BSTR
   VarBstrFromDate(vbDate, lcid, VAR_DATEVALUEONLY, @bstrOut)
   DIM ustrOut AS USTRING = *bstrOut
   SysFreeString bstrOut
   RETURN ustrOut
END FUNCTION
' ========================================================================================

' ========================================================================================
' Converts a DATE_ type to a string containing only the time.
' ========================================================================================
PUBLIC FUNCTION fbxVariantTimeToStr (BYVAL vbDate AS DATE_, BYVAL lcid AS LCID = LOCALE_USER_DEFAULT) AS USTRING
   DIM bstrOut AS fbx_BSTR
   VarBstrFromDate(vbDate, lcid, VAR_TIMEVALUEONLY, @bstrOut)
   DIM ustrOut AS USTRING = *bstrOut
   SysFreeString bstrOut
   RETURN ustrOut
END FUNCTION
' ========================================================================================

' ========================================================================================
' Converts a FILETIME type to a string containing the date based on the specified mask, e.g. "dd-MM-yyyy"
' ========================================================================================
PUBLIC FUNCTION fbxFileTimeToDateStr (BYREF FT AS FILETIME, BYREF wszMask AS WSTRING, BYVAL lcid AS LCID = LOCALE_USER_DEFAULT) AS USTRING
   DIM ST AS SYSTEMTIME, wszDateStr AS WSTRING * 260
   FileTimeToSystemTime(@FT, @ST)
   GetDateFormatW(lcid, NULL, @ST, wszMask, wszDateStr, SIZEOF(wszDateStr) \ 2)
   RETURN wszDateStr
END FUNCTION
' ========================================================================================

' ========================================================================================
' Converts a FILETIME type to a string containing the time based on the specified mask, e.g. "hh':'mm':'ss".
' ========================================================================================
PUBLIC FUNCTION fbxFileTimeToTimeStr (BYREF FT AS FILETIME, BYREF wszMask AS WSTRING, BYVAL lcid AS LCID = LOCALE_USER_DEFAULT) AS USTRING
   DIM ST AS SYSTEMTIME, wszDateStr AS WSTRING * 260
   FileTimeToSystemTime(@FT, @ST)
   GetTimeFormatW(lcid, NULL, @ST, wszMask, wszDateStr, SIZEOF(wszDateStr) \ 2)
   RETURN wszDateStr
END FUNCTION
' ========================================================================================

' ========================================================================================
' Converts a SYSTEMTIME type to a string containing the date and the time based on the
' specified mask, e.g. "dd-MM-yyyy"
' ========================================================================================
PUBLIC FUNCTION fbxSystemTimeToDateStr (BYREF ST AS SYSTEMTIME, BYREF wszMask AS WSTRING, BYVAL lcid AS LCID = LOCALE_USER_DEFAULT) AS USTRING
   DIM wszDateStr AS WSTRING * 260
   GetDateFormatW(lcid, NULL, @ST, wszMask, wszDateStr, SIZEOF(wszDateStr) \ 2)
   RETURN wszDateStr
END FUNCTION
' ========================================================================================

' ========================================================================================
' Converts a FILETIME type to a string containing the date and the time. based on the
' specified mask, e.g. "hh':'mm':'ss".
' ========================================================================================
PUBLIC FUNCTION fbxSystemTimeToTimeStr (BYREF ST AS SYSTEMTIME, BYREF wszMask AS WSTRING, BYVAL lcid AS LCID = LOCALE_USER_DEFAULT) AS USTRING
   DIM wszDateStr AS WSTRING * 260
   GetTimeFormatW(lcid, NULL, @ST, wszMask, wszDateStr, SIZEOF(wszDateStr) \ 2)
   RETURN wszDateStr
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Converts a __time64_t (LONGLONG) value to a FILETIME structure.
' ========================================================================================
PUBLIC FUNCTION fbxTime64ToFileTime (BYVAL t64 AS LONGLONG) AS FILETIME
   DIM ft AS FILETIME, uli AS ULARGE_INTEGER
   uli.QuadPart = t64 * 10000000
   ' 10000000 = ticks per second
   ft.dwLowDateTime = uli.LowPart
   ft.dwHighDateTime = uli.HighPart
   RETURN ft
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Converts a FILETIME to a __time64_t (LONGLONG) value.
' ========================================================================================
PUBLIC FUNCTION fbxFileTimeToTime64 (BYREF ft AS FILETIME) AS LONGLONG
   DIM uli AS ULARGE_INTEGER
   uli.LowPart = ft.dwLowDateTime
   uli.HighPart = ft.dwHighDateTime
   DIM t64 AS LONGLONG = uli.QuadPart / 10000000
   ' 10000000 = ticks per second
   RETURN t64
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Converts a system time to a __time64_t (LONGLONG).
' ========================================================================================
PUBLIC FUNCTION fbxSystemTimeToTime64 (BYREF st AS SYSTEMTIME) AS LONGLONG
   DIM ft AS FILETIME
   SystemTimeToFileTime(@st, @ft)
   DIM t64 AS LONGLONG = fbxFileTimeToTime64(ft) - 11644473600
   ' 11644473600 = number of days from 1 Jan 1970
   RETURN t64
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Converts a __time64_t (LONGLONG) to a system time.
' ========================================================================================
PUBLIC FUNCTION fbxTime64ToSystemTime (BYVAL t64 AS LONGLONG) AS SYSTEMTIME
   DIM ft AS FILETIME
   t64 += 11644473600
   ft = fbxTime64ToFileTime(t64)
   DIM st AS SYSTEMTIME
   FileTimeToSystemTime(@ft, @st)
   RETURN st
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Converts a __time64_t (LONGLONG) to a GMT time.
' t64 : A __time64_t (LONGLONG) value.  The time is represented as seconds elapsed since
' midnight (00:00:00), January 1, 1970, coordinated universal time (UTC).
' Returns a tm structure. The fields of the returned structure hold the evaluated value of
' the time argument in UTC rather than in local time. 
' Note: Replacement for _gmtime64, not available in msvcrt.dll.
' The fields of the structure type tm store the following values, each of which is an int:
' tm_sec : Seconds after minute (0 – 59).
' tm_min : Minutes after hour (0 – 59).
' tm_hour : Hours after midnight (0 – 23).
' tm_mday : Day of month (1 – 31).
' tm_mon : Month (0 – 11; January = 0).
' tm_year : Year (current year minus 1900).
' tm_wday : Day of week (0 – 6; Sunday = 0).
' tm_yday : Day of year (0 – 365; January 1 = 0).
' tm_isdst : Positive value if daylight saving time is in effect; 0 if daylight saving
' time is not in effect; negative value if status of daylight saving time is unknown.
' ========================================================================================
PUBLIC FUNCTION fbxGmtTime64 (BYVAL t64 AS LONGLONG) AS tm
   DIM st AS SYSTEMTIME
   st = fbxTime64ToSystemTime(t64)
   DIM _tm AS tm
   _tm.tm_wday = st.wDayOfWeek
   _tm.tm_min = st.wMinute
   _tm.tm_sec = st.wSecond
   _tm.tm_mon = st.wMonth - 1
   _tm.tm_mday = st.wDay
   _tm.tm_hour = st.wHour
   _tm.tm_year = st.wYear - 1900
   DIM stYear AS SYSTEMTIME
   DIM t64Year AS LONGLONG
   stYear.wYear = st.wYear
   stYear.wMonth = 1
   stYear.wDay = 1
   t64Year = fbxSystemTimeToTime64(stYear)
   _tm.tm_yday = (t64 - t64Year) / 60*60*24   ' 60*60*24 = day in seconds
   _tm.tm_isdst = 0
   RETURN _tm
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Returns a UTC time as a local time.
' Converts a time value and corrects for the local time zone.
' Note: Replacement for _localtime64, not available in msvcrt.dll.
' The fields of the structure type tm store the following values, each of which is an int:
' tm_sec : Seconds after minute (0 – 59).
' tm_min : Minutes after hour (0 – 59).
' tm_hour : Hours after midnight (0 – 23).
' tm_mday : Day of month (1 – 31).
' tm_mon : Month (0 – 11; January = 0).
' tm_year : Year (current year minus 1900).
' tm_wday : Day of week (0 – 6; Sunday = 0).
' tm_yday : Day of year (0 – 365; January 1 = 0).
' tm_isdst : Positive value if daylight saving time is in effect; 0 if daylight saving
' time is not in effect; negative value if status of daylight saving time is unknown.
' ========================================================================================
PUBLIC FUNCTION fbxLocalTime64 (BYVAL t64 AS LONGLONG) AS tm
   DIM AS FILETIME ft, ftLocal
   ft = fbxTime64ToFileTime(t64)
   FileTimeToLocalFiletime(@ft, @ftLocal)
   t64 = fbxFileTimeToTime64(ftLocal)
   DIM _tm AS tm = fbxGmtTime64(t64)
   DIM tzi AS TIME_ZONE_INFORMATION
   SELECT CASE GetTimeZoneInformation(@tzi)
      CASE TIME_ZONE_ID_DAYLIGHT : _tm.tm_isdst = 1
      CASE TIME_ZONE_ID_STANDARD : _tm.tm_isdst = 0
      CASE TIME_ZONE_ID_UNKNOWN  : _tm.tm_isdst = -1
   END SELECT
   RETURN _tm
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Converts the local time to a calendar value.
' Note: Replacemenet for _mktime64, not available in msvcrt.dll.
' Caveat: It does not support the tm_isdst parameter.
' ========================================================================================
PUBLIC FUNCTION fbxMakeTime64 (BYREF _tm AS tm) AS LONGLONG
   DIM st AS SYSTEMTIME, stOut AS SYSTEMTIME
   st.wDay = _tm.tm_mday
   st.wDayOfWeek = _tm.tm_wday
   st.wHour = _tm.tm_hour
   st.wMinute = _tm.tm_min
   st.wMonth = _tm.tm_mon + 1
   st.wSecond = _tm.tm_sec
   st.wYear = _tm.tm_year + 1900
   st.wMilliseconds = 0
   stOut = st
   ' // Daylight savings
   DIM tzi AS TIME_ZONE_INFORMATION
   DIM r AS DWORD = GetTimeZoneInformation(@tzi)
   ' // Converts a local time to a time in Coordinated Universal Time (UTC).
   IF r <> TIME_ZONE_ID_INVALID THEN TzSpecificLocalTimeToSystemTime(@tzi, @st, @stOut)
   RETURN fbxSystemTimeToTime64(stOut)
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Returns the system time as a __time64_t (LONGLONG) value.
' Returns the time as seconds elapsed since midnight, January 1, 1970.
' Note: Replacement for _time64, not available in msvcrt.dll.
' ========================================================================================
PUBLIC FUNCTION fbxTime64 () AS LONGLONG
   DIM t64 AS LONGLONG
   DIM st AS SYSTEMTIME
   GetSystemTime(@st)
   RETURN fbxSystemTimeToTime64(st)
END FUNCTION
' ========================================================================================

' ========================================================================================
' Checks if a FILETIME is valid.
' ========================================================================================
PUBLIC FUNCTION fbxIsValidFILETIME (BYREF ft AS FILETIME) AS BOOLEAN
   DIM ftlocalTime AS FILETIME
   IF FileTimeToLocalFileTime(@ft, @ftlocalTime) = 0 THEN RETURN FALSE
	' // then convert that time to system time
   DIM sysTime AS SYSTEMTIME
   IF FileTimeToSystemTime(@ftlocalTime, @sysTime) = 0 THEN RETURN FALSE
   RETURN TRUE
END FUNCTION
' ========================================================================================

' ========================================================================================
' Comverts Unix time to FileTime.
' ========================================================================================
PUBLIC FUNCTION fbxUnixTimeToFileTime (BYVAL unixTime AS DWORD) AS FILETIME
   ' 11644473600 = seconds between entre 1601 y 1970
   DIM t AS ULONGLONG = (culngint(unixTime) + 11644473600ull) * 10000000ull
   DIM ft AS FILETIME
   ft.dwLowDateTime  =  cast(DWORD, t and &hFFFFFFFFull)
   ft.dwHighDateTime =  cast(DWORD, t shr 32)
   RETURN ft
END FUNCTION
' ========================================================================================

' ========================================================================================
' Comverts Unix time to SystemTime.
' ========================================================================================
PUBLIC FUNCTION fbxUnixTimeToSystemTime (BYVAL unixTime AS DWORD) AS SYSTEMTIME
   ' 11644473600 = seconds between entre 1601 y 1970
   DIM t AS ULONGLONG = (culngint(unixTime) + 11644473600ull) * 10000000ull
   DIM ft AS FILETIME
   ft.dwLowDateTime  =  cast(DWORD, t and &hFFFFFFFFull)
   ft.dwHighDateTime =  cast(DWORD, t shr 32)
   DIM st AS SYSTEMTIME
   FileTimeToSystemTime(@ft, @st)
   RETURN st
END FUNCTION
' ========================================================================================

' ========================================================================================
' Retuns an Unix date based on the specified mask, e.g. "dd-MM-yyyy".
' ========================================================================================
PUBLIC FUNCTION fbxUnixDateStr (BYVAL unixTime AS DWORD, BYREF wszMask AS WSTRING, BYVAL lcid AS LCID = LOCALE_USER_DEFAULT) AS USTRING
   ' 11644473600 = seconds between entre 1601 y 1970
   DIM t AS ULONGLONG = (culngint(unixTime) + 11644473600ull) * 10000000ull
   DIM ft AS FILETIME
   ft.dwLowDateTime  =  cast(DWORD, t and &hFFFFFFFFull)
   ft.dwHighDateTime =  cast(DWORD, t shr 32)
   DIM st AS SYSTEMTIME
   FileTimeToSystemTime(@ft, @st)
   DIM wszDate AS WSTRING * 260
   GetDateFormatW(lcid, NULL, @st, wszMask, wszDate, SIZEOF(wszDate) \ 2)
   RETURN wszDate
END FUNCTION
' ========================================================================================

' ========================================================================================
' Retuns an Unix time based on the specified mask, e.g. "hh':'mm':'ss"."
' ========================================================================================
PUBLIC FUNCTION fbxUnixTimeStr (BYVAL unixTime AS DWORD, BYREF wszMask AS WSTRING, BYVAL lcid AS LCID = LOCALE_USER_DEFAULT) AS USTRING
   ' 11644473600 = seconds between entre 1601 y 1970
   DIM t AS ULONGLONG = (culngint(unixTime) + 11644473600ull) * 10000000ull
   DIM ft AS FILETIME
   ft.dwLowDateTime  =  cast(DWORD, t and &hFFFFFFFFull)
   ft.dwHighDateTime =  cast(DWORD, t shr 32)
   DIM st AS SYSTEMTIME
   FileTimeToSystemTime(@ft, @st)
   DIM wszTime AS WSTRING * 260
   GetTimeFormatW(lcid, NULL, @st, wszMask, wszTime, SIZEOF(wszTime) \ 2)
   RETURN wszTime
END FUNCTION
' ========================================================================================
