' fbx/axhost (pkg/fbx): every header the module's files include, and the
' macros more than one of its files uses.
#pragma once

#include once "windows.bi"
#include once "win/ole2.bi"
#include once "win/unknwnbase.bi"
#include once "win/unknwn.bi"
#include once "win/olectl.bi"
#include once "win/docobj.bi"
#include once "win/shlguid.bi"
#include once "win/shobjidl.bi"
#include once "win/ocidl.bi"
#include once "win/exdisp.bi"
#include once "win/shtypes.bi"
#include once "win/mshtmhst.bi"
#include once "vbCompat.bi"

#ifndef _CAXH_DEBUG_
   #define _CAXH_DEBUG_ 0
#endif
#ifndef _CAXH_DP_
   #MACRO CAXH_DP(st)
      #if (_CAXH_DEBUG_ = 1)
         OutputDebugStringW(__FUNCTION__ + ": " + st)
      #endif
   #ENDMACRO
#endif
#ifndef _CWBX_DEBUG_
   #define _CWBX_DEBUG_ 0
#endif
#ifndef _CWBX_DP_
   #MACRO CWBX_DP(st)
      #if (_CWBX_DEBUG_ = 1)
         OutputDebugStringW(__FUNCTION__ + ": " + st)
      #endif
   #ENDMACRO
#endif
#ifndef _CMSHGRIDEVT_DEBUG_
   #define _CMSHGRIDEVT_DEBUG_ 0
#endif
#ifndef _CMSHGRIDEVT_DP_
   #MACRO CMSHGRIDEVT_DP(st)
      #IF (_CMSHGRIDEVT_DEBUG_ = 1)
         OutputDebugStringW(__FUNCTION__ + ": " + st)
      #ENDIF
   #ENDMACRO
#endif
