#module "sqlite"
#import "std/containers"
#import "std/outcome" as oc
#import "std/memory"
#import "std/strings"
#import "std/fs"
using containers, oc, memory, strings, fs
#include once "crt/string.bi"
#include once "sqlite3api.bi"
'' ===========================================================================
''  csv.tiko -- the CSV half of db/sqlite (it was fbsqlite_csv.bi)
''
''      #import "db/sqlite"
''      using sqlite
''
''      dim loaded as CountResult = ImportCsv( db, "company", "companies.csv" )
''      if loaded.IsOk( ) then print loaded.Value( ); " rows"
''
''  Real CSV, not split-on-comma: quoted fields, embedded delimiters, embedded
''  newlines, doubled quotes, CRLF or LF line endings, and a UTF-8 BOM.
''
''  Part of the module: '#import "db/sqlite"' brings it with the rest.
'' ===========================================================================




public type CountResult as oc.Result( of longint, DbError )
public type CsvRow      as UStringArray
public type CsvTable    as containers.Array( of UStringArray )

public type CsvOptions
    as ustring delimiter        '' "" means comma
    as boolean hasHeader        '' default false here; set it
    as boolean createTable      '' create the table from the header if missing
    as boolean emptyIsNull      '' an unquoted empty field becomes NULL
end type

'' The options most callers want: a header row, create the table, and treat an
'' empty field as NULL rather than as an empty string.
public function DefaultCsvOptions( ) as CsvOptions
    dim chosen as CsvOptions
    chosen.delimiter   = ","
    chosen.hasHeader   = true
    chosen.createTable = true
    chosen.emptyIsNull = true
    return chosen
end function

'' ---------------------------------------------------------------------------
''  Parsing
'' ---------------------------------------------------------------------------

'' Split the whole text into records.  Done in one pass rather than
'' line-by-line, because a quoted field may CONTAIN a newline and any
'' line-first design gets that wrong.
public function ParseCsv( byref text as ustring, byref delimiter as ustring = "," ) as CsvTable
    dim table_ as CsvTable
    dim record as UStringArray
    dim as ustring current
    dim as boolean inQuotes = false
    dim as boolean sawAnything = false

    dim as ulong sep = asc( "," )
    if len( delimiter ) > 0 then sep = delimiter[ 0 ]

    dim as long index = 0
    dim as long total = len( text )

    '' a UTF-8 BOM decodes to U+FEFF and is not part of the first field
    if total > 0 then
        if text[ 0 ] = &hFEFF then index = 1
    end if

    while index < total
        dim as ulong unit = text[ index ]
        sawAnything = true

        if inQuotes then
            if unit = asc( """" ) then
                dim as boolean doubled = false
                if ( index + 1 ) < total then
                    if text[ index + 1 ] = asc( """" ) then doubled = true
                end if
                if doubled then
                    current &= """"
                    index += 1
                else
                    inQuotes = false
                end if
            else
                current &= wchr( unit )
            end if

        elseif unit = asc( """" ) then
            inQuotes = true

        elseif unit = sep then
            record.Push( current )
            current = ""

        elseif unit = 10 then
            record.Push( current )
            current = ""
            table_.Push( record )
            record.Clear( )
            sawAnything = false

        elseif unit = 13 then
            '' CR is dropped; the LF that follows ends the record

        else
            current &= wchr( unit )
        end if

        index += 1
    wend

    '' a final record with no trailing newline
    dim as boolean tailPending = sawAnything
    if len( current ) > 0 then tailPending = true
    if record.Count( ) > 0 then tailPending = true

    if tailPending then
        record.Push( current )
        table_.Push( record )
    end if

    return table_
end function

public function ParseCsvFile( byref filePath as ustring, byref delimiter as ustring = "," ) as CsvTable
    dim table_ as CsvTable
    dim loaded as fs.FsResultUStr = fs.ReadAllText( filePath )
    if loaded.IsOk( ) = false then return table_
    return ParseCsv( loaded.Value( ), delimiter )
end function

'' ---------------------------------------------------------------------------
''  Import
'' ---------------------------------------------------------------------------

'' Turn a header cell into something safe to use as a column name.  Anything
'' that is not a letter, a digit or an underscore becomes an underscore, and a
'' name that would start with a digit gets one in front.
function hColumnName( byref heading as ustring, byval position as long ) as ustring
    dim as ustring cleaned

    for index as long = 0 to len( heading ) - 1
        dim as ulong unit = heading[ index ]
        dim as boolean isDigit = ( unit >= asc( "0" ) ) andalso ( unit <= asc( "9" ) )
        dim as boolean isUpper = ( unit >= asc( "A" ) ) andalso ( unit <= asc( "Z" ) )
        dim as boolean isLower = ( unit >= asc( "a" ) ) andalso ( unit <= asc( "z" ) )

        if isDigit then
            cleaned &= wchr( unit )
        elseif isUpper then
            cleaned &= wchr( unit + 32 )
        elseif isLower then
            cleaned &= wchr( unit )
        else
            cleaned &= "_"
        end if
    next

    if len( cleaned ) = 0 then return "column_" & ( position + 1 )

    dim as ulong lead = cleaned[ 0 ]
    if ( lead >= asc( "0" ) ) andalso ( lead <= asc( "9" ) ) then cleaned = "c_" & cleaned
    return cleaned
end function

'' Load a CSV file into a table, in ONE transaction, through ONE prepared
'' statement.  Every column is TEXT (or NULL); converting is SQL's job and
'' SQLite will do it on read.  Returns the number of rows inserted.
public function ImportCsvWith( byref conn as Database, byref tableName as ustring, _
                        byref filePath as ustring, byref chosen as CsvOptions ) as CountResult
    if conn.IsOpen( ) = false then
        return oc.Fail( of longint, DbError )( _
            DbError( SQLITE_MISUSE, SQLITE_MISUSE, "the database is not open", "ImportCsv", "" ) )
    end if

    dim loaded as fs.FsResultUStr = fs.ReadAllText( filePath )
    if loaded.IsOk( ) = false then
        return oc.Fail( of longint, DbError )( _
            DbError( SQLITE_CANTOPEN, SQLITE_CANTOPEN, _
                     "cannot read " & filePath & ": " & loaded.Failure( ).Message( ), "ImportCsv", "" ) )
    end if

    dim table_ as CsvTable = ParseCsv( loaded.Value( ), chosen.delimiter )
    if table_.Count( ) = 0 then return oc.Ok( of longint, DbError )( 0LL )

    '' -- column names
    dim columnNames as UStringArray
    dim as long firstDataRow = 0

    if chosen.hasHeader then
        for index as long = 0 to table_[ 0 ].Count( ) - 1
            columnNames.Push( hColumnName( table_[ 0 ][ index ], index ) )
        next
        firstDataRow = 1
    else
        for index as long = 0 to table_[ 0 ].Count( ) - 1
            columnNames.Push( "column_" & ( index + 1 ) )
        next
    end if

    if columnNames.Count( ) = 0 then return oc.Ok( of longint, DbError )( 0LL )

    '' -- create the table if asked
    if chosen.createTable then
        if conn.TableExists( tableName ) = false then
            dim as ustring ddl = "create table " & QuoteIdentifier( tableName ) & " ( "
            for index as long = 0 to columnNames.Count( ) - 1
                if index > 0 then ddl &= ", "
                ddl &= QuoteIdentifier( columnNames[ index ] ) & " text"
            next
            ddl &= " )"

            dim created as VoidResult = conn.Execute( ddl )
            if created.IsOk( ) = false then
                return oc.Fail( of longint, DbError )( created.Failure( ) )
            end if
        end if
    end if

    '' -- one prepared statement, one transaction
    dim as ustring insertSql = "insert into " & QuoteIdentifier( tableName ) & " ( "
    for index as long = 0 to columnNames.Count( ) - 1
        if index > 0 then insertSql &= ", "
        insertSql &= QuoteIdentifier( columnNames[ index ] )
    next
    insertSql &= " ) values ( "
    for index as long = 0 to columnNames.Count( ) - 1
        if index > 0 then insertSql &= ", "
        insertSql &= "?"
    next
    insertSql &= " )"

    dim inserter as Statement
    dim prepared as VoidResult = conn.Prepare( inserter, insertSql )
    if prepared.IsOk( ) = false then
        return oc.Fail( of longint, DbError )( prepared.Failure( ) )
    end if

    dim work as Transaction
    dim opened as VoidResult = work.Begin( conn )
    if opened.IsOk( ) = false then
        return oc.Fail( of longint, DbError )( opened.Failure( ) )
    end if

    dim as longint inserted = 0

    for rowIndex as long = firstDataRow to table_.Count( ) - 1
        inserter.Reset( )
        inserter.ClearBindings( )

        for columnIndex as long = 0 to columnNames.Count( ) - 1
            dim as ustring cell = ""
            if columnIndex < table_[ rowIndex ].Count( ) then cell = table_[ rowIndex ][ columnIndex ]

            dim bound as VoidResult
            if ( len( cell ) = 0 ) andalso ( chosen.emptyIsNull = true ) then
                bound = inserter.Bind( columnIndex + 1, NullValue( ) )
            else
                bound = inserter.Bind( columnIndex + 1, DbValue( cell ) )
            end if

            if bound.IsOk( ) = false then
                return oc.Fail( of longint, DbError )( bound.Failure( ) )
            end if
        next

        dim ran as VoidResult = inserter.RunToCompletion( )
        if ran.IsOk( ) = false then
            '' the Transaction destructor rolls back on the way out
            return oc.Fail( of longint, DbError )( ran.Failure( ) )
        end if

        inserted += 1
    next

    dim committed as VoidResult = work.Commit( )
    if committed.IsOk( ) = false then
        return oc.Fail( of longint, DbError )( committed.Failure( ) )
    end if

    return oc.Ok( of longint, DbError )( inserted )
end function

public function ImportCsv( byref conn as Database, byref tableName as ustring, _
                    byref filePath as ustring ) as CountResult
    dim chosen as CsvOptions = DefaultCsvOptions( )
    return ImportCsvWith( conn, tableName, filePath, chosen )
end function

'' ---------------------------------------------------------------------------
''  Export
'' ---------------------------------------------------------------------------

'' Quote a a field only when it needs it, which is what every spreadsheet does.
function hCsvField( byref cell as DbValue, byref delimiter as ustring ) as ustring
    if cell.IsNull( ) then return ""

    dim as ustring text = cell.ToString( )
    dim as boolean needsQuotes = false

    if len( delimiter ) > 0 then
        if strings.Contains( text, delimiter ) then needsQuotes = true
    end if
    if strings.Contains( text, """" ) then needsQuotes = true
    if strings.Contains( text, chr( 10 ) ) then needsQuotes = true
    if strings.Contains( text, chr( 13 ) ) then needsQuotes = true

    if needsQuotes = false then return text
    return """" & strings.Replace( text, """", """""" ) & """"
end function

'' Run a query and write the result as CSV, header included.  Returns the
'' number of DATA rows written.
public function ExportCsv( byref conn as Database, byref sqlText as ustring, _
                    byref filePath as ustring, byref delimiter as ustring = "," ) as CountResult
    dim outcome as RowsResult = conn.Query( sqlText )
    if outcome.IsOk( ) = false then
        return oc.Fail( of longint, DbError )( outcome.Failure( ) )
    end if

    dim as ustring text
    dim as long columns = outcome.Value( ).ColumnCount( )

    for index as long = 0 to columns - 1
        if index > 0 then text &= delimiter
        dim heading as DbValue = DbValue( outcome.Value( ).ColumnName( index ) )
        text &= hCsvField( heading, delimiter )
    next
    text &= chr( 13 ) & chr( 10 )

    dim as longint written = 0
    for each exported in outcome.Value( )
        for index as long = 0 to columns - 1
            if index > 0 then text &= delimiter
            text &= hCsvField( exported[ index ], delimiter )
        next
        text &= chr( 13 ) & chr( 10 )
        written += 1
    next

    dim stored as fs.FsResultBool = fs.WriteAllText( filePath, text )
    if stored.IsOk( ) = false then
        return oc.Fail( of longint, DbError )( _
            DbError( SQLITE_CANTOPEN, SQLITE_CANTOPEN, _
                     "cannot write " & filePath & ": " & stored.Failure( ).Message( ), "ExportCsv", sqlText ) )
    end if

    return oc.Ok( of longint, DbError )( written )
end function
