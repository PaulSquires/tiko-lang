#module "money"
#import "std/numeric"
#import "std/chrono"
#import "std/outcome"
#import "std/containers"
using numeric
using chrono
using outcome
using containers
'' std/money: fincash -- cash flows and investment appraisal
''
''     #import "std/money"
''     using money
''
''     dim as Array( of Decimal ) flows          ' flows[ 0 ] IS AT t = 0
''     flows.Push( ... )
''     var npv = NetPresentValue( flows, rate )
''     var irr = InternalRateOfReturn( flows )
''
'' EVERY SERIES PARAMETER IS containers.Array, NOT a plain 'flows( ) as Decimal'.
'' containers.Array is ZERO-BASED, so t = 0 is flows[ 0 ] with no lbound to think about
'' -- a caller that used to pass a 1-based array must re-base it.
''
'' Specified by C:\dev\docs\finance\RFC-0006-cash-flows.md.  Phase 5.
''
'' flows(0) IS AT t = 0, AND EXCEL'S IS NOT.  Excel's NPV( rate, values )
'' discounts its FIRST value by one period, so a flow at time zero has to be
'' added outside the call -- `initial + NPV( rate, rest )` -- and forgetting to
'' is the single most common spreadsheet error in capital budgeting.
''
'' HERE flows(0) IS UNDISCOUNTED, which is the textbook definition and the one
'' every other implementation agrees with.  This is a deliberate divergence from
'' the oracle the tests use, so it is stated loudly here, and the test that pins
'' it against Excel applies the shift EXPLICITLY with a comment naming RFC-0006
'' section 2.  An implementation that silently matched Excel would be wrong; one
'' that silently differed would be a trap.
''
'' THE THREE SERIES PRE-CHECKS LIVE HERE, NOT IN THE SOLVER.  RFC-0003 section
'' 4.0 lists four; finsolve.tiko can only make the fourth, because a caller's
'' series reaches it as an opaque `any ptr`.  So empty, no-sign-change and
'' unordered-dates are detected HERE, before the solver is ever called:
''
''     FIN_EMPTY_SERIES      nothing to appraise
''     FIN_NO_SIGN_CHANGE    every flow the same sign -- NO ROOT CAN EXIST, and
''                           this is not a convergence problem.  It is by far
''                           the most common real IRR failure, and reporting it
''                           as "did not converge" sends the caller hunting for
''                           a better seed that cannot help.
''     FIN_UNORDERED_DATES   a dated series must ascend.  Silently sorting the
''                           caller's array would be a surprise; discounting to
''                           a negative exponent would produce a plausible wrong
''                           number.
''
'' MULTIPLE ROOTS, RESTATED HERE RATHER THAN ONLY CROSS-REFERENCED.  A series
'' with more than one sign change can have more than one internal rate of
'' return.  finsolve.tiko returns ONE of them -- not necessarily the nearest to
'' any seed -- and that is not an error: the question is ILL-POSED rather than
'' hard.  ModifiedInternalRateOfReturn is the well-posed alternative and has
'' exactly one solution by construction.  Repeated at the call site because IRR
'' is where a caller actually meets this, and a cross-reference to another
'' document is not a warning anybody reads at 2 a.m.


#if __FB_LANG__ <> "fb"
    #error "std/money requires -lang fb (it uses namespaces)"
#endif

#include once "fblimits.bi"
#include once "fblimits.bi"

using FB

'' ===========================================================================
'' The dated flow
'' ===========================================================================

public type CashFlow
    as Decimal   Amount_
    as LocalDate Date_
end type

public function CashFlowMake overload ( byref amount as Decimal, byref d as LocalDate ) as CashFlow
    dim as CashFlow c
    c.Amount_ = amount
    c.Date_   = d
    return c
end function

'' Period-indexed rather than dated.  Date_ is Invalid, deliberately: a dated
'' function handed one of these refuses rather than inventing a calendar.
public function CashFlowAt overload ( byref amount as Decimal, byval period as long ) as CashFlow
    dim as CashFlow c
    c.Amount_ = amount
    c.Date_   = LocalDate.Invalid( )
    return c
end function

'' ===========================================================================
'' Pre-checks -- RFC-0003 section 4.0, the three the solver cannot make
'' ===========================================================================

function hCashCheckSeries overload ( byref flows as Array( of Decimal ) ) as FinanceErrorCode
    dim as long n = flows.Count( )
    if( n < 1 ) then return FIN_EMPTY_SERIES

    for each f in flows
        if( f.IsValid( ) = FALSE ) then return FIN_INVALID_TERM
    next
    return FIN_OK
end function

'' A root exists only if the series changes sign at least once.  Zeros are
'' skipped rather than counted as a sign.
function hCashHasSignChange overload ( byref flows as Array( of Decimal ) ) as boolean
    dim as boolean seenPos = FALSE, seenNeg = FALSE
    for each f in flows
        if( f > DecimalZero( ) ) then seenPos = TRUE
        if( f < DecimalZero( ) ) then seenNeg = TRUE
    next
    return ( seenPos andalso seenNeg )
end function

function hCashCheckDated overload ( byref flows as Array( of CashFlow ) ) as FinanceErrorCode
    dim as long n = flows.Count( )
    if( n < 1 ) then return FIN_EMPTY_SERIES

    for each f in flows
        if( f.Amount_.IsValid( ) = FALSE ) then return FIN_INVALID_TERM
        if( f.Date_.IsValid = FALSE ) then return FIN_UNORDERED_DATES
    next

    '' STRICTLY ascending -- a duplicate date is as ambiguous as a reversed one.
    for k as long = 1 to n - 1
        if( flows[ k ].Date_.DayNumber <= flows[ k - 1 ].Date_.DayNumber ) then
            return FIN_UNORDERED_DATES
        end if
    next
    return FIN_OK
end function

function hCashDatedHasSignChange overload ( byref flows as Array( of CashFlow ) ) as boolean
    dim as boolean seenPos = FALSE, seenNeg = FALSE
    for each f in flows
        if( f.Amount_ > DecimalZero( ) ) then seenPos = TRUE
        if( f.Amount_ < DecimalZero( ) ) then seenNeg = TRUE
    next
    return ( seenPos andalso seenNeg )
end function

'' ===========================================================================
'' Net present and future value
'' ===========================================================================

'' EXACT -- integer exponents throughout.
''
'' RFC-0006 section 4: ONE RUNNING DISCOUNT FACTOR, multiplied once per flow,
'' rather than a GrowthFactor call per term.  One multiply and one division per
'' flow, and because each step reduces to FIN_WORK_SCALE the accumulated error
'' stays inside RFC-0002 section 6.3's bound rather than growing with the series
'' length.
public function NetPresentValue overload ( byref flows as Array( of Decimal ), byref rate as Decimal ) as FinResultDec
    dim as FinanceErrorCode bad = hCashCheckSeries( flows )
    if( bad <> FIN_OK ) then return FinFailDec( bad )
    if( hFinRateOk( rate ) = FALSE ) then return FinFailDec( FIN_INVALID_RATE )

    dim as Decimal acc = DecimalZero( )
    dim as Decimal v = DecimalOne( )
    dim as Decimal onePlus = DecimalOne( ) + rate

    for each f in flows
        acc = acc + ( f * v )
        if( acc.IsValid( ) = FALSE ) then return FinFailDec( FIN_OVERFLOW )

        '' Reduced every step, which is what bounds the error.
        dim as Decimal nextV = ( v / onePlus )
        if( nextV.IsValid( ) = FALSE ) then return FinFailDec( FIN_OVERFLOW )
        v = nextV.Round( FIN_WORK_SCALE )
    next

    return FinOkDec( acc )
end function

'' EXACT.  The net present value carried forward to the end of the series.
public function NetFutureValue overload ( byref flows as Array( of Decimal ), byref rate as Decimal ) as FinResultDec
    dim as FinResultDec npv = NetPresentValue( flows, rate )
    if( npv.IsOk( ) = FALSE ) then return npv

    dim as long n = flows.Count( ) - 1
    dim as FinResultDec g = GrowthFactor( rate, n )
    if( g.IsOk( ) = FALSE ) then return g

    dim as Decimal fv = npv.Value( ) * g.Value( )
    if( fv.IsValid( ) = FALSE ) then return FinFailDec( FIN_OVERFLOW )
    return FinOkDec( fv )
end function

'' ===========================================================================
'' Internal rate of return
'' ===========================================================================

'' The objective's context: a copy of the flows, in double.
type hIrrCtx
    as double v( any )
    as long   n
end type

function hIrrObjective( byval rate as double, byval ctx as any ptr ) as double
    dim as hIrrCtx ptr c = cptr( hIrrCtx ptr, ctx )

    dim as double acc = 0.0
    dim as double disc = 1.0
    dim as double onePlus = 1.0 + rate
    if( onePlus <= 0.0 ) then return NaN( )

    for k as long = 0 to c->n - 1
        acc += c->v( k ) * disc
        disc /= onePlus
    next
    return acc
end function

'' DOUBLE KERNEL -- finsolve.tiko.
''
'' MULTIPLE ROOTS ARE NOT AN ERROR.  A series with more than one sign change can
'' have several internal rates of return; this returns ONE of them, and NOT
'' necessarily the one nearest any seed -- see the note at the top and RFC-0003
'' section 5.  ModifiedInternalRateOfReturn is the well-posed alternative.
public function InternalRateOfReturn overload ( byref flows as Array( of Decimal ), byref opt as FinSolverOptions ) as FinResultDec
    dim as FinanceErrorCode bad = hCashCheckSeries( flows )
    if( bad <> FIN_OK ) then return FinFailDec( bad )

    '' NO ROOT CAN EXIST without a sign change.  Named before the solver runs,
    '' because "did not converge" would send the caller after a better seed.
    if( hCashHasSignChange( flows ) = FALSE ) then return FinFailDec( FIN_NO_SIGN_CHANGE )

    dim as long n = flows.Count( )

    dim as hIrrCtx c
    c.n = n
    redim c.v( 0 to n - 1 )
    for k as long = 0 to n - 1
        c.v( k ) = flows[ k ].ToDouble( )
    next

    dim as FinSolverOptions use_ = opt
    if( IsNaN( use_.Guess_ ) ) then
        '' RFC-0003 section 4.1's domain seed: ( inflow / |outflow| )^(1/n) - 1,
        '' clamped.  A bad seed costs iterations, never correctness.
        dim as double inflow = 0.0, outflow = 0.0
        for k as long = 0 to n - 1
            if( c.v( k ) > 0.0 ) then inflow += c.v( k )
            if( c.v( k ) < 0.0 ) then outflow -= c.v( k )
        next
        dim as double seed = 0.1
        if( ( outflow > 0.0 ) andalso ( inflow > 0.0 ) andalso ( n > 1 ) ) then
            seed = Expm1( Log1p( inflow / outflow - 1.0 ) / cdbl( n - 1 ) )
        end if
        if( IsFinite( seed ) = FALSE ) then seed = 0.1
        use_.Guess_ = Clamp( seed, -0.9, 10.0 )
    end if

    dim as FinResultSolve r = FinSolveRoot( @hIrrObjective, @c, use_ )
    if( r.IsOk( ) = FALSE ) then
        return Fail( of Decimal, FinanceError )( r.Failure( ) )
    end if

    dim as Decimal d = hFinFromDouble( r.Value( ).Root_ )
    if( d.IsValid( ) = FALSE ) then return FinFailDec( FIN_OVERFLOW )
    return FinOkDec( d )
end function

public function InternalRateOfReturn overload ( byref flows as Array( of Decimal ) ) as FinResultDec
    dim as FinSolverOptions o = FinSolverOptionsDefault( )
    return InternalRateOfReturn( flows, o )
end function

'' The NPV and FV halves are EXACT; only the terminal n-th root is DOUBLE
'' KERNEL.  Exactly one solution by construction -- it discounts the negative
'' flows at one rate and compounds the positive ones at another rather than
'' solving a polynomial, so the multiple-roots problem does not arise.
public function ModifiedInternalRateOfReturn overload _
    ( _
        byref flows as Array( of Decimal ), byref financeRate as Decimal, byref reinvestRate as Decimal _
    ) as FinResultDec

    dim as FinanceErrorCode bad = hCashCheckSeries( flows )
    if( bad <> FIN_OK ) then return FinFailDec( bad )
    if( hFinRateOk( financeRate ) = FALSE ) then return FinFailDec( FIN_INVALID_RATE )
    if( hFinRateOk( reinvestRate ) = FALSE ) then return FinFailDec( FIN_INVALID_RATE )
    if( hCashHasSignChange( flows ) = FALSE ) then return FinFailDec( FIN_NO_SIGN_CHANGE )

    dim as long lo = 0, hi = flows.Count( ) - 1
    dim as long n = hi - lo
    if( n < 1 ) then return FinFailDec( FIN_INVALID_PERIODS )

    '' PV of the negative flows at the finance rate; FV of the positive flows
    '' at the reinvestment rate.  Both exact.
    dim as Decimal pvNeg = DecimalZero( )
    dim as Decimal fvPos = DecimalZero( )

    for k as long = lo to hi
        dim as long t = k - lo
        if( flows[ k ] < DecimalZero( ) ) then
            dim as FinResultDec v = DiscountFactor( financeRate, t )
            if( v.IsOk( ) = FALSE ) then return v
            pvNeg = pvNeg + ( flows[ k ] * v.Value( ) )
        elseif( flows[ k ] > DecimalZero( ) ) then
            dim as FinResultDec g = GrowthFactor( reinvestRate, n - t )
            if( g.IsOk( ) = FALSE ) then return g
            fvPos = fvPos + ( flows[ k ] * g.Value( ) )
        end if
    next

    dim as double a = fvPos.ToDouble( )
    dim as double b = -pvNeg.ToDouble( )
    if( b <= 0.0 ) then return FinFailDec( FIN_DOMAIN )
    if( a <= 0.0 ) then return FinFailDec( FIN_DOMAIN )

    '' ( FV / -PV )^(1/n) - 1, through Expm1/Log1p because the result is a rate
    '' near zero -- fincore.tiko's cancellation rule.
    dim as double m = Expm1( Log1p( a / b - 1.0 ) / cdbl( n ) )
    dim as Decimal d = hFinFromDouble( m )
    if( d.IsValid( ) = FALSE ) then return FinFailDec( FIN_OVERFLOW )
    return FinOkDec( d )
end function

'' ===========================================================================
'' Dated forms
''
'' DOUBLE KERNEL throughout: the discount exponent is a day-count fraction and
'' therefore not an integer.
'' ===========================================================================

public function NetPresentValueOnDates overload _
    ( byref flows as Array( of CashFlow ), byref annualRate as Decimal, byval basis as DayCount ) as FinResultDec

    dim as FinanceErrorCode bad = hCashCheckDated( flows )
    if( bad <> FIN_OK ) then return FinFailDec( bad )
    if( hFinRateOk( annualRate ) = FALSE ) then return FinFailDec( FIN_INVALID_RATE )

    dim as double rate = annualRate.ToDouble( )
    dim as double acc = 0.0

    '' The base date is fetched ONCE: it is the first flow's, not the loop's.
    dim as LocalDate base_ = flows[ 0 ].Date_
    for each f in flows
        dim as double yf = DayCountFractionDouble( base_, f.Date_, basis )
        '' exp( -yf * ln( 1 + r ) ) is ( 1 + r )^-yf without the intermediate.
        acc += f.Amount_.ToDouble( ) * exp( -yf * Log1p( rate ) )
    next

    dim as Decimal d = DecimalFromDouble( acc )
    if( d.IsValid( ) = FALSE ) then return FinFailDec( FIN_OVERFLOW )
    return FinOkDec( d )
end function

type hXirrCtx
    as double amount( any )
    as double yf( any )
    as long   n
end type

function hXirrObjective( byval rate as double, byval ctx as any ptr ) as double
    dim as hXirrCtx ptr c = cptr( hXirrCtx ptr, ctx )
    if( ( 1.0 + rate ) <= 0.0 ) then return NaN( )

    dim as double acc = 0.0
    dim as double lg = Log1p( rate )
    for k as long = 0 to c->n - 1
        acc += c->amount( k ) * exp( -c->yf( k ) * lg )
    next
    return acc
end function

public function InternalRateOfReturnOnDates overload _
    ( byref flows as Array( of CashFlow ), byval basis as DayCount, byref opt as FinSolverOptions ) as FinResultDec

    dim as FinanceErrorCode bad = hCashCheckDated( flows )
    if( bad <> FIN_OK ) then return FinFailDec( bad )
    if( hCashDatedHasSignChange( flows ) = FALSE ) then return FinFailDec( FIN_NO_SIGN_CHANGE )

    dim as long n = flows.Count( )

    dim as hXirrCtx c
    c.n = n
    redim c.amount( 0 to n - 1 )
    redim c.yf( 0 to n - 1 )
    for k as long = 0 to n - 1
        c.amount( k ) = flows[ k ].Amount_.ToDouble( )
        c.yf( k ) = DayCountFractionDouble( flows[ 0 ].Date_, flows[ k ].Date_, basis )
    next

    dim as FinSolverOptions use_ = opt
    if( IsNaN( use_.Guess_ ) ) then use_.Guess_ = 0.1

    dim as FinResultSolve r = FinSolveRoot( @hXirrObjective, @c, use_ )
    if( r.IsOk( ) = FALSE ) then
        return Fail( of Decimal, FinanceError )( r.Failure( ) )
    end if

    dim as Decimal d = hFinFromDouble( r.Value( ).Root_ )
    if( d.IsValid( ) = FALSE ) then return FinFailDec( FIN_OVERFLOW )
    return FinOkDec( d )
end function

public function InternalRateOfReturnOnDates overload _
    ( byref flows as Array( of CashFlow ), byval basis as DayCount ) as FinResultDec

    dim as FinSolverOptions o = FinSolverOptionsDefault( )
    return InternalRateOfReturnOnDates( flows, basis, o )
end function

'' ===========================================================================
'' Payback
''
'' OPTIONAL, NOT Result.  An investment that never returns its outlay has NO
'' payback period -- that is the finding, not a failure, and there is no
'' sub-reason worth printing.  RFC-0001 section 6's test for Optional.
''
'' An EMPTY array is a caller bug rather than a finding, and Optional has
'' nowhere to say so; it returns absence.  That asymmetry is accepted and
'' stated rather than hidden.
''
'' The value is the FRACTIONAL period, linearly interpolated inside the crossing
'' period, which is the convention every textbook uses.
'' ===========================================================================

function hCashPayback overload ( byref flows as Array( of Decimal ), byref rate as Decimal, byval discounted as boolean ) as Optional( of double )
    '' 'absent', not 'none': None( of T ) is a generic in std/outcome and
    '' FreeBASIC identifiers are case-insensitive.
    dim as Optional( of double ) absent
    dim as long n = flows.Count( )
    if( n < 1 ) then return absent

    dim as double running = 0.0
    dim as double disc = 1.0
    dim as double onePlus = 1.0 + rate.ToDouble( )
    if( discounted andalso ( onePlus <= 0.0 ) ) then return absent

    for k as long = 0 to n - 1
        dim as double amt = flows[ k ].ToDouble( )
        if( discounted ) then amt *= disc

        dim as double prev = running
        running += amt

        '' The crossing: from negative (or zero) to positive.
        if( ( prev < 0.0 ) andalso ( running >= 0.0 ) ) then
            '' BOTH type arguments written out: inference reads parameter
            '' positions only (std/outcome's optional.tiko).
            if( amt = 0.0 ) then return Some( of double )( cdbl( k ) )
            '' linear interpolation inside the period
            dim as double part = cdbl( k - 1 ) + ( -prev / amt )
            return Some( of double )( part )
        end if

        if( discounted ) then disc /= onePlus
    next

    return absent
end function

public function PaybackPeriod overload ( byref flows as Array( of Decimal ) ) as Optional( of double )
    return hCashPayback( flows, DecimalZero( ), FALSE )
end function

public function DiscountedPaybackPeriod overload ( byref flows as Array( of Decimal ), byref rate as Decimal ) as Optional( of double )
    return hCashPayback( flows, rate, TRUE )
end function

'' ===========================================================================
'' Profitability index
'' ===========================================================================

'' EXACT.  PV of everything after t = 0, over the absolute initial outlay.
''
'' A project with a ZERO initial outlay gives FIN_DOMAIN, not an infinity.
public function ProfitabilityIndex overload ( byref flows as Array( of Decimal ), byref rate as Decimal ) as FinResultDec
    dim as FinanceErrorCode bad = hCashCheckSeries( flows )
    if( bad <> FIN_OK ) then return FinFailDec( bad )
    if( hFinRateOk( rate ) = FALSE ) then return FinFailDec( FIN_INVALID_RATE )

    dim as Decimal outlay = flows[ 0 ].AbsValue( )
    if( outlay.IsZero( ) ) then return FinFailDec( FIN_DOMAIN )

    dim as FinResultDec npv = NetPresentValue( flows, rate )
    if( npv.IsOk( ) = FALSE ) then return npv

    '' NPV includes flows[ 0 ] undiscounted, so the PV of the rest is
    '' NPV - flows[ 0 ].
    dim as Decimal pvRest = npv.Value( ) - flows[ 0 ]
    dim as Decimal idx = ( pvRest / outlay )
    if( idx.IsValid( ) = FALSE ) then return FinFailDec( FIN_OVERFLOW )
    return FinOkDec( idx )
end function

