#module "money"
#import "std/outcome"
using outcome
'' std/money: moneyformat -- render an amount the way the user's locale writes money.
''
''     #import "std/money"
''     using money
''
''     dim as MoneyFormat m = DecimalParse( "-1234.5" ).Value( )
''     print m.ToString( )                  '' -$1,234.50   on en-CA
''
''     m.Negative = MONEY_NEG_PARENS
''     m.ThousandsSep = ""                  '' SUPPRESSED, not "use the locale"
''     print m.ToString( )                  '' ($1234.50)
''
''     m.UseLocale( MONEY_F_THOUSANDSSEP )  '' back to the locale's separator
''
'' currency.tiko and decimal.tiko HOLD money and the fin*.tiko files COMPUTE with
'' it. Nothing displayed it. This is that half: assign a value, set the
'' properties you care about, read back the string.
''
'' Every characteristic the user's locale specifies -- symbol, decimal point,
'' thousands separator, digit grouping, fraction digits, which side the symbol
'' goes on, where the sign goes -- is used by default, and every one of them can
'' be OVERRIDDEN or SUPPRESSED individually.
''
'' Design record, including the oracle behind the composition table:
'' C:\dev\docs\money\design.md
''
'' ---------------------------------------------------------------------------
'' WHERE THE SETTINGS COME FROM
''
'' Windows: GetLocaleInfoEx( LOCALE_NAME_USER_DEFAULT, ... ).  Linux:
'' localeconv( ).  Not one portable path, for two reasons that are both silent
'' failures rather than errors:
''
''   * The Windows CRT is NOT the Region control panel. setlocale(0,"") reads
''     the NLS defaults for the user's locale and does not reliably pick up the
''     per-user overrides they typed into Settings > Region.
''   * localeconv hands back BYTES IN THE PROCESS CODE PAGE. On a 1252 machine
''     the euro sign is one byte, 0x80. There is no code page in which every
''     currency symbol is representable, so a byte source cannot be made right.
''
'' On Linux localeconv stays: it is correct there, and strfmon() -- which would
'' do the whole job -- does not exist on Windows, so it cannot be the engine.
''
'' ---------------------------------------------------------------------------
'' THIS HEADER INCLUDES NOTHING FROM inc/win, DELIBERATELY
''
'' inc/win/_mingw.bi defaults _WIN32_WINNT to &h0502, and GetLocaleInfoEx,
'' LOCALE_NAME_USER_DEFAULT and LOCALE_SNAME all sit behind
'' `#if _WIN32_WINNT >= &h0600` in inc/win/winnls.bi. With the shipped headers
'' they ARE NOT VISIBLE -- the call fails to compile rather than failing to
'' link -- and raising _WIN32_WINNT from inside a public fb/ header (as this
'' file was) would move the whole calling program's Windows baseline as a side effect.
''
'' So the four things needed are declared below instead. The payoff is larger
'' than dodging the guard: a module that prints a price does not drag in
'' windows.bi, and there is no tagDEC collision with money.Decimal (the hazard
'' decimal.tiko already warns about, where a program including win/wtypes.bi
'' and saying `using money` has two things named Decimal in scope).
''
'' GetLocaleInfoEx is Vista+.
''
'' ---------------------------------------------------------------------------
'' THE LOCALE SNAPSHOT IS READ ONCE
''
'' setlocale is process-global and GetLocaleInfoEx is comparatively slow, so
'' the settings are read once, lazily, into a snapshot -- not per amount. A
'' MoneyFormat instance stores ONLY its own overrides and reads the snapshot at
'' render, so an instance is about 96 bytes and touches the heap only for the
'' string it produces.
''
'' TWO CONSEQUENCES, both stated rather than hidden:
''
''   * NOT THREAD-SAFE against a refresh. MoneyRefreshLocale / MoneySetLocale
''     rewrite the snapshot while another thread may be reading it. Call them
''     at start-up, or while nothing is formatting. A lock on every ToString
''     would cost more than the feature is worth.
''   * ONE SNAPSHOT PER PROGRAM. std/money is one module, so its
''     `dim shared` exists once and MoneySetLocale affects every caller.
''     (As a header, fb/moneyformat.bi, it was one snapshot per INCLUDING
''     module: a `dim shared` in a .bi included by two modules gave two
''     of them -- the same wall fb/scheduler.bi and fb/logger.bi
''     described.)


#include once "fblimits.bi"
#include once "fblimits.bi"

#ifndef __FB_WIN32__
    #include once "crt/locale.bi"
#endif

'' The Windows NLS entry points, self-declared -- see the note above.
'' The FB identifiers are prefixed so that a program which ALSO includes
'' win/winnls.bi with _WIN32_WINNT >= &h0600 does not get a duplicate
'' declaration; `alias` keeps the linker symbol correct either way.
#ifdef __FB_WIN32__
    extern "Windows"
        declare function mnyGetLocaleInfoEx_ alias "GetLocaleInfoEx" _
            ( byval lpLocaleName as const wstring ptr, byval LCType as ulong, _
              byval lpLCData as wstring ptr, byval cchData as long ) as long
    end extern
#endif

using FB

'' NLS LCTYPEs. Stable ABI numbers; named here so inc/win is not needed.
#ifdef __FB_WIN32__
const as ulong mnyLC_SCURRENCY       = &h00000014
const as ulong mnyLC_SMONDECIMALSEP  = &h00000016
const as ulong mnyLC_SMONTHOUSANDSEP = &h00000017
const as ulong mnyLC_SMONGROUPING    = &h00000018
const as ulong mnyLC_ICURRDIGITS     = &h00000019
const as ulong mnyLC_ICURRENCY       = &h0000001b
const as ulong mnyLC_INEGCURR        = &h0000001c
const as ulong mnyLC_SPOSITIVESIGN   = &h00000050
const as ulong mnyLC_SNEGATIVESIGN   = &h00000051
const as ulong mnyLC_SNAME           = &h0000005c
#endif

'' CHAR_MAX in an lconv byte field means "this locale does not specify it".
public const as long MONEY_UNSPECIFIED = 127

'' Most digit groups any locale describes; the real maximum in use is two.
public const as long MONEY_MAX_GROUPS = 8

'' Decimal's own ceiling. Past it Rescale has nowhere to put the digits.
public const as long MONEY_MAX_FRAC = DECIMAL_MAX_SCALE

'' Where the sign goes, the POSIX model that both platforms map onto.
''   0  ($1,234.56)      3  -$1,234.56  (sign immediately before the symbol)
''   1  -$1,234.56       4  $-1,234.56  (sign immediately after the symbol)
''   2  $1,234.56-
public enum MoneySignPosn
MONEY_POSN_PARENS    = 0
MONEY_POSN_BEFORE    = 1
MONEY_POSN_AFTER     = 2
MONEY_POSN_BEFORESYM = 3
MONEY_POSN_AFTERSYM  = 4
end enum

'' Negative-style presets. They change how the SIGN is shown and nothing else:
'' which side the symbol sits on, and whether a space separates it, still come
'' from the locale (or from your own SymbolPrecedes / SpaceBySymbol override).
public enum MoneyNegative
MONEY_NEG_LOCALE   = 0            '' whatever the locale says (the default)
MONEY_NEG_MINUS    = 1            '' -$1,234.56
MONEY_NEG_PARENS   = 2            '' ($1,234.56)
MONEY_NEG_TRAILING = 3            '' $1,234.56-
MONEY_NEG_NONE     = 4            '' $1,234.56   -- magnitude only
end enum

'' Which settings the caller has taken over. A setter always sets its bit, so
'' `m.Symbol = ""` is a SUPPRESSION and "never touched Symbol" is a different
'' state; only UseLocale( ) clears a bit. Without this the two would be the
'' same thing and suppression would not be expressible at all.
public enum MoneyField
MONEY_F_SYMBOL         = 1
MONEY_F_DECIMALPOINT   = 2
MONEY_F_THOUSANDSSEP   = 4
MONEY_F_GROUPING       = 8
MONEY_F_FRACDIGITS     = 16
MONEY_F_SYMBOLPRECEDES = 32
MONEY_F_SPACEBYSYMBOL  = 64
MONEY_F_NEGATIVE       = 128
MONEY_F_ALL            = &hFFFF
end enum

'' ===========================================================================
'' The snapshot
'' ===========================================================================

type MoneySnapshot_
Loaded       as boolean
IsValid      as boolean
LocaleName   as ustring

Symbol       as ustring
DecimalPoint as ustring
ThousandsSep as ustring
PositiveSign as ustring
NegativeSign as ustring

'' Innermost group first, i.e. right to left from the decimal point.
'' GroupsRepeat means the last one repeats forever, the ordinary case.
Groups(0 to MONEY_MAX_GROUPS-1) as long
GroupCount   as long
GroupsRepeat as boolean

FracDigits   as long

'' SepBySpace is 0/1/2 and NOT a boolean: 2 means the space separates the
'' SIGN from the symbol rather than the symbol from the digits, and two of
'' the sixteen Windows negative layouts need it. Flattened to a boolean
'' those two render "$- 1.1" and "1.1 -$", both wrong.
PosPrecedes  as boolean
PosSepSpace  as long
PosSignPosn  as long
NegPrecedes  as boolean
NegSepSpace  as long
NegSignPosn  as long
end type

dim shared as MoneySnapshot_ mnySnap_
dim shared as ustring mnyWanted_          '' "" = the user's own locale

'' ===========================================================================
'' NLS -> POSIX layout, the two Windows tables
''
'' PUBLIC so that the suite can assert every row: a transcription error here is
'' a wrong string on somebody's machine and on nobody else's.
'' ===========================================================================

'' LOCALE_ICURRENCY, 0..3 -- the positive layout.
''   0 $1.1    1 1.1$    2 $ 1.1    3 1.1 $
public sub MoneyLayoutFromICurrency _
( byval v as long, byref precedes as boolean, byref sepBySpace as long )

select case v
case 1 : precedes = false : sepBySpace = 0
case 2 : precedes = true  : sepBySpace = 1
case 3 : precedes = false : sepBySpace = 1
case else : precedes = true : sepBySpace = 0        '' 0, and anything odd
end select

end sub

'' LOCALE_INEGCURR, 0..15 -- the negative layout.
''    0 ($1.1)    4 (1.1$)     8 -1.1 $    12 $ -1.1
''    1 -$1.1     5 -1.1$      9 -$ 1.1    13 1.1- $
''    2 $-1.1     6 1.1-$     10 1.1 $-    14 ($ 1.1)
''    3 $1.1-     7 1.1$-     11 $ 1.1-    15 (1.1 $)
public sub MoneyLayoutFromINegCurr _
( byval v as long, byref precedes as boolean, byref sepBySpace as long, _
  byref signPosn as long )

select case v
case 0  : precedes = true  : sepBySpace = 0 : signPosn = MONEY_POSN_PARENS
case 1  : precedes = true  : sepBySpace = 0 : signPosn = MONEY_POSN_BEFORE
case 2  : precedes = true  : sepBySpace = 0 : signPosn = MONEY_POSN_AFTERSYM
case 3  : precedes = true  : sepBySpace = 0 : signPosn = MONEY_POSN_AFTER
case 4  : precedes = false : sepBySpace = 0 : signPosn = MONEY_POSN_PARENS
case 5  : precedes = false : sepBySpace = 0 : signPosn = MONEY_POSN_BEFORE
case 6  : precedes = false : sepBySpace = 0 : signPosn = MONEY_POSN_BEFORESYM
case 7  : precedes = false : sepBySpace = 0 : signPosn = MONEY_POSN_AFTER
case 8  : precedes = false : sepBySpace = 1 : signPosn = MONEY_POSN_BEFORE
case 9  : precedes = true  : sepBySpace = 1 : signPosn = MONEY_POSN_BEFORE
case 10 : precedes = false : sepBySpace = 1 : signPosn = MONEY_POSN_AFTER
case 11 : precedes = true  : sepBySpace = 1 : signPosn = MONEY_POSN_AFTER
case 12 : precedes = true  : sepBySpace = 2 : signPosn = MONEY_POSN_AFTERSYM
case 13 : precedes = false : sepBySpace = 2 : signPosn = MONEY_POSN_BEFORESYM
case 14 : precedes = true  : sepBySpace = 1 : signPosn = MONEY_POSN_PARENS
case 15 : precedes = false : sepBySpace = 1 : signPosn = MONEY_POSN_PARENS
case else : precedes = true : sepBySpace = 0 : signPosn = MONEY_POSN_BEFORE
end select

end sub

'' ===========================================================================
'' Composition
''
'' PUBLIC, and directly comparable to strfmon(3): the thirty
'' (precedes, sepBySpace, signPosn) cells were generated from glibc under WSL
'' rather than transcribed from a paraphrase, and the suite asserts all thirty
'' against this function. See design.md section 5.
''
''   sepBySpace = 1  a space sits immediately beside the NUMBER, on the
''                   symbol's side of it
''   sepBySpace = 2  a space sits between the SIGN and the SYMBOL, when those
''                   two are adjacent
''
'' The space for sepBySpace = 2 is emitted even when the sign string is empty,
'' producing a stray leading or trailing space. That is a glibc wart rather
'' than an intent, and it is reproduced here: "identical to strfmon" is a rule
'' that can be tested, "identical except where we thought it looked wrong" is
'' not. No preset and no override produces sepBySpace = 2 -- only a locale can.
'' ===========================================================================

public function MoneyCompose _
( byref num as ustring, byref sym as ustring, byref signStr as ustring, _
  byval precedes as boolean, byval sepBySpace as long, byval signPosn as long ) as ustring

dim as ustring sp1, sp2
if sepBySpace = 1 then sp1 = " "
if sepBySpace = 2 then sp2 = " "

'' 127 is what an lconv reports when the locale has no opinion. Normalise
'' here as well as in ToString so that both branches below agree on what
'' an unrecognised position means.
if signPosn < 0 orelse signPosn > 4 then signPosn = MONEY_POSN_BEFORE

if precedes then
    select case signPosn
    case MONEY_POSN_PARENS
        return "(" + sym + sp1 + num + ")"
    case MONEY_POSN_AFTER
        return sym + sp1 + num + signStr
    case MONEY_POSN_AFTERSYM
        return sym + sp2 + signStr + sp1 + num
    case else                              '' BEFORE and BEFORESYM
        return signStr + sp2 + sym + sp1 + num
    end select
else
    select case signPosn
    case MONEY_POSN_PARENS
        return "(" + num + sp1 + sym + ")"
    case MONEY_POSN_BEFORE
        return signStr + num + sp1 + sym
    case MONEY_POSN_BEFORESYM
        return num + sp1 + signStr + sp2 + sym
    case else                              '' AFTER and AFTERSYM
        return num + sp1 + sym + sp2 + signStr
    end select
end if

end function

'' ===========================================================================
'' Reading the locale
'' ===========================================================================

sub mnyClearSnap_( )
dim as MoneySnapshot_ blank
mnySnap_ = blank
end sub

'' "3;0" and the Indian "3;2;0" -- one group size per field, and a TRAILING 0
'' means "repeat the last one forever". Nearly, but not exactly, the lconv
'' convention: there a trailing 0 also means repeat, but 127 means stop, and
'' there is no 127 here. Both land in the same Groups()/GroupsRepeat shape so
'' that one composer serves both targets.
sub mnyParseGroupingText_( byref s as string )

mnySnap_.GroupCount = 0
mnySnap_.GroupsRepeat = false
if len( s ) = 0 then exit sub

dim as long i = 1
do while i <= len( s ) andalso mnySnap_.GroupCount < MONEY_MAX_GROUPS
    dim as long j = instr( i, s, ";" )
    if j = 0 then j = len( s ) + 1
    dim as long n = valint( mid( s, i, j - i ) )
    if n = 0 then
        '' trailing 0: repeat whatever the previous group was
        mnySnap_.GroupsRepeat = ( mnySnap_.GroupCount > 0 )
        exit do
    end if
    mnySnap_.Groups(mnySnap_.GroupCount) = n
    mnySnap_.GroupCount += 1
    i = j + 1
loop

end sub

#ifdef __FB_WIN32__

function mnyNlsText_( byval lctype as ulong ) as ustring
dim as wstring * 128 buf
dim as const wstring ptr pName = 0            '' NULL = LOCALE_NAME_USER_DEFAULT
if len( mnyWanted_ ) > 0 then
    static as wstring * 96 nameBuf
    nameBuf = mnyWanted_
    pName = @nameBuf
end if
if mnyGetLocaleInfoEx_( pName, lctype, @buf, 128 ) <= 0 then return ""
return buf
end function

function mnyNlsInt_( byval lctype as ulong, byval dflt as long ) as long
dim as string s = mnyNlsText_( lctype )
if len( s ) = 0 then return dflt
return valint( s )
end function

sub mnyLoadSnap_( )

mnyClearSnap_( )
mnySnap_.Loaded = true

'' A locale name that NLS does not know makes every query fail. One probe
'' decides it, rather than letting nine empty answers look like a locale
'' with no opinions.
dim as ustring probe = mnyNlsText_( mnyLC_SMONDECIMALSEP )
if len( probe ) = 0 then exit sub

mnySnap_.LocaleName   = mnyNlsText_( mnyLC_SNAME )
mnySnap_.Symbol       = mnyNlsText_( mnyLC_SCURRENCY )
mnySnap_.DecimalPoint = probe
mnySnap_.ThousandsSep = mnyNlsText_( mnyLC_SMONTHOUSANDSEP )
mnySnap_.PositiveSign = mnyNlsText_( mnyLC_SPOSITIVESIGN )
mnySnap_.NegativeSign = mnyNlsText_( mnyLC_SNEGATIVESIGN )
mnySnap_.FracDigits   = mnyNlsInt_( mnyLC_ICURRDIGITS, 2 )

mnyParseGroupingText_( mnyNlsText_( mnyLC_SMONGROUPING ) )

MoneyLayoutFromICurrency( mnyNlsInt_( mnyLC_ICURRENCY, 0 ), _
    mnySnap_.PosPrecedes, mnySnap_.PosSepSpace )
mnySnap_.PosSignPosn = MONEY_POSN_BEFORE      '' NLS has no positive sign posn

MoneyLayoutFromINegCurr( mnyNlsInt_( mnyLC_INEGCURR, 1 ), _
    mnySnap_.NegPrecedes, mnySnap_.NegSepSpace, mnySnap_.NegSignPosn )

mnySnap_.IsValid = true

end sub

#else

'' LC_MONETARY, NOT LC_ALL, AND THAT IS NOT A DETAIL.
''
'' setlocale is process-global, so widening the request to LC_ALL would also
'' move LC_NUMERIC -- and decimal.tiko's DecimalFromDouble builds its value by
'' snprintf( "%.14e" ) and then walking the digits. Under a German LC_NUMERIC
'' that prints "1,23456e+03", the comma is not a digit, and EVERY DOUBLE
'' ASSIGNED TO A MoneyFormat SILENTLY BECOMES AN INVALID Decimal, which renders
'' as the empty string. Measured, not predicted: it is what this suite did
'' under LANG=de_DE.UTF-8 before the request was narrowed. Formatting money
'' must not change how the rest of the program reads numbers.
''
'' DecimalFromDouble has since been taught to take whatever separator the
'' locale gave it, so it no longer breaks under a comma LC_NUMERIC and this is
'' no longer load-bearing. It stays anyway: the reason above holds on its own.
''
'' crt/locale.bi carries the GLIBC category numbers on every target, so
'' LC_MONETARY is right here. (On Windows the same constant is msvcrt's
'' LC_NUMERIC, and the header's LC_ALL of 6 is out of msvcrt's range entirely:
'' setlocale returns NULL and leaves you in the C locale with nothing to say
'' so. This branch never runs there -- Windows reads NLS directly.)
function mnyLconvText_( byval p as const zstring ptr ) as ustring
if p = 0 then return ""
return *p                        '' zstring -> ustring decodes as UTF-8
end function

function mnyLconvFlag_( byval v as ubyte ) as boolean
if v = MONEY_UNSPECIFIED then return false
return ( v <> 0 )
end function

function mnyLconvSep_( byval v as ubyte ) as long
if v = MONEY_UNSPECIFIED then return 0
if v > 2 then return 0
return v
end function

sub mnyLoadSnap_( )

mnyClearSnap_( )
mnySnap_.Loaded = true

'' "" asks for the user's locale: LC_ALL / LC_MONETARY / LANG. A named one
'' that has not been generated is REJECTED, and then every field below
'' keeps its C-locale value with nothing to say so -- hence the check.
'' AN EMPTY FB DYNAMIC STRING HAS A NULL strptr, and setlocale( cat, NULL )
'' QUERIES the current locale instead of setting one. Passing mnyWanted_
'' straight through therefore turned "use the user's locale" into "keep
'' whatever is already in force" -- with a plausible name coming back and
'' nothing to say it had not been applied. The literal "" is a static
'' zstring and is not NULL, so the two cases are split.
dim as zstring ptr pName
if len( mnyWanted_ ) = 0 then
    pName = setlocale( LC_MONETARY, "" )
else
    dim as string want = mnyWanted_
    pName = setlocale( LC_MONETARY, want )
end if
if pName = 0 then exit sub
mnySnap_.LocaleName = *pName

dim as lconv ptr lc = localeconv( )
if lc = 0 then exit sub

mnySnap_.Symbol       = mnyLconvText_( lc->currency_symbol )
mnySnap_.DecimalPoint = mnyLconvText_( lc->mon_decimal_point )
mnySnap_.ThousandsSep = mnyLconvText_( lc->mon_thousands_sep )
mnySnap_.PositiveSign = mnyLconvText_( lc->positive_sign )
mnySnap_.NegativeSign = mnyLconvText_( lc->negative_sign )
mnySnap_.FracDigits   = lc->frac_digits

mnySnap_.PosPrecedes = mnyLconvFlag_( lc->p_cs_precedes )
mnySnap_.PosSepSpace = mnyLconvSep_ ( lc->p_sep_by_space )
mnySnap_.PosSignPosn = lc->p_sign_posn
mnySnap_.NegPrecedes = mnyLconvFlag_( lc->n_cs_precedes )
mnySnap_.NegSepSpace = mnyLconvSep_ ( lc->n_sep_by_space )
mnySnap_.NegSignPosn = lc->n_sign_posn

'' mon_grouping is a BYTE STRING, not text: one byte per group, terminated
'' by 0 ("repeat the last group") or CHAR_MAX ("stop grouping"). It must be
'' read through a ubyte ptr -- indexing a zstring ptr hands back the raw
'' character, and a group size of 3 is not a printable one.
dim as ubyte ptr g = cast( ubyte ptr, lc->mon_grouping )
if g <> 0 then
    do while mnySnap_.GroupCount < MONEY_MAX_GROUPS
        dim as long n = g[mnySnap_.GroupCount]
        if n = 0 then
            mnySnap_.GroupsRepeat = ( mnySnap_.GroupCount > 0 )
            exit do
        end if
        if n = MONEY_UNSPECIFIED then exit do
        mnySnap_.Groups(mnySnap_.GroupCount) = n
        mnySnap_.GroupCount += 1
    loop
end if

mnySnap_.IsValid = true

end sub

#endif

sub mnyEnsureSnap_( )
if mnySnap_.Loaded = false then mnyLoadSnap_( )
end sub

'' Re-read the settings -- after the user has changed Settings > Region, say.
'' See the note at the top: not thread-safe against a concurrent format, and it
'' refreshes the program's one snapshot.
public sub MoneyRefreshLocale( )
mnyLoadSnap_( )
end sub

'' Force a named locale instead of the user's own: "de-DE" on Windows,
'' "de_DE.UTF-8" on Linux. Pass "" to go back to the user's. Returns false if
'' the system does not know it -- on Linux that usually means the locale has
'' not been generated -- and in that case nothing has an opinion and the
'' fallbacks in section "Resolving" apply.
public function MoneySetLocale( byref localeName as ustring ) as boolean
mnyWanted_ = localeName
mnyLoadSnap_( )
return mnySnap_.IsValid
end function

'' False when the system rejected the locale. Every field then holds a
'' C-locale value, which is not the user's anything -- treat the whole record
'' as unusable rather than trusting it.
public function MoneyLocaleIsValid( ) as boolean
mnyEnsureSnap_( )
return mnySnap_.IsValid
end function

public function MoneyLocaleName( ) as ustring
mnyEnsureSnap_( )
return mnySnap_.LocaleName
end function

'' ===========================================================================
'' MoneyFormat
'' ===========================================================================

public type MoneyFormat

private:
    value_     as Decimal
    mask_      as ulong

    oSymbol_   as ustring
    oDecPt_    as ustring
    oThouSep_  as ustring
    oGroup_    as ustring
    oFrac_     as long
    oPrecedes_ as boolean
    oSpace_    as boolean
    oNeg_      as long

    blankZero_ as boolean
    forcePlus_ as boolean
    zeroText_  as ustring
    round_     as long

public:
    declare constructor( )
    declare constructor( byval v as longint )
    declare constructor( byval v as double )
    declare constructor( byref v as Currency )
    declare constructor( byref v as Decimal )

    declare operator let( byval v as longint )
    declare operator let( byval v as double )
    declare operator let( byref v as Currency )
    declare operator let( byref v as Decimal )

    declare property Value( ) as Decimal

    '' Getters report the EFFECTIVE setting: the override if one is in
    '' force, otherwise what the locale says.
    declare property Symbol        ( ) as ustring
    declare property Symbol        ( byref s as ustring )
    declare property DecimalPoint  ( ) as ustring
    declare property DecimalPoint  ( byref s as ustring )
    declare property ThousandsSep  ( ) as ustring
    declare property ThousandsSep  ( byref s as ustring )
    declare property Grouping      ( ) as ustring
    declare property Grouping      ( byref s as ustring )
    declare property FracDigits    ( ) as long
    declare property FracDigits    ( byval n as long )
    declare property SymbolPrecedes( ) as boolean
    declare property SymbolPrecedes( byval b as boolean )
    declare property SpaceBySymbol ( ) as boolean
    declare property SpaceBySymbol ( byval b as boolean )
    declare property Negative      ( ) as MoneyNegative
    declare property Negative      ( byval n as MoneyNegative )

    '' No locale counterpart, so no mask bit and nothing to suppress.
    declare property BlankIfZero( ) as boolean
    declare property BlankIfZero( byval b as boolean )
    declare property ForcePlus  ( ) as boolean
    declare property ForcePlus  ( byval b as boolean )
    declare property ZeroText   ( ) as ustring
    declare property ZeroText   ( byref s as ustring )
    declare property Rounding   ( ) as long
    declare property Rounding   ( byval mode as long )

    declare function Overrides( ) as ulong
    declare sub UseLocale( byval fields as long = MONEY_F_ALL )

    declare function ToString( ) as ustring
    declare operator cast( ) as ustring

end type

'' ---------------------------------------------------------------------------
'' Construction and assignment
'' ---------------------------------------------------------------------------

constructor MoneyFormat( )
this.value_ = DecimalZero( )
this.oFrac_ = -1
this.oNeg_  = MONEY_NEG_LOCALE
this.round_ = DEC_HALF_EVEN
end constructor

constructor MoneyFormat( byval v as longint )
this.constructor( )
this.value_ = DecimalFromInt( v )
end constructor

constructor MoneyFormat( byval v as double )
this.constructor( )
this.value_ = DecimalFromDouble( v )
end constructor

constructor MoneyFormat( byref v as Currency )
this.constructor( )
this.value_ = DecimalFromCurrency( v )
end constructor

constructor MoneyFormat( byref v as Decimal )
this.constructor( )
this.value_ = v
end constructor

operator MoneyFormat.let( byval v as longint )
this.value_ = DecimalFromInt( v )
end operator

operator MoneyFormat.let( byval v as double )
this.value_ = DecimalFromDouble( v )
end operator

operator MoneyFormat.let( byref v as Currency )
this.value_ = DecimalFromCurrency( v )
end operator

operator MoneyFormat.let( byref v as Decimal )
this.value_ = v
end operator

property MoneyFormat.Value( ) as Decimal
return this.value_
end property

'' ---------------------------------------------------------------------------
'' Settings
'' ---------------------------------------------------------------------------

property MoneyFormat.Symbol( byref s as ustring )
this.oSymbol_ = s
this.mask_ or= MONEY_F_SYMBOL
end property

property MoneyFormat.Symbol( ) as ustring
if ( this.mask_ and MONEY_F_SYMBOL ) <> 0 then return this.oSymbol_
mnyEnsureSnap_( )
return mnySnap_.Symbol
end property

property MoneyFormat.DecimalPoint( byref s as ustring )
this.oDecPt_ = s
this.mask_ or= MONEY_F_DECIMALPOINT
end property

property MoneyFormat.DecimalPoint( ) as ustring
if ( this.mask_ and MONEY_F_DECIMALPOINT ) <> 0 then return this.oDecPt_
mnyEnsureSnap_( )
if mnySnap_.IsValid andalso len( mnySnap_.DecimalPoint ) > 0 then return mnySnap_.DecimalPoint
return "."
end property

property MoneyFormat.ThousandsSep( byref s as ustring )
this.oThouSep_ = s
this.mask_ or= MONEY_F_THOUSANDSSEP
end property

property MoneyFormat.ThousandsSep( ) as ustring
if ( this.mask_ and MONEY_F_THOUSANDSSEP ) <> 0 then return this.oThouSep_
mnyEnsureSnap_( )
if mnySnap_.IsValid then return mnySnap_.ThousandsSep
return ","
end property

property MoneyFormat.Grouping( byref s as ustring )
this.oGroup_ = s
this.mask_ or= MONEY_F_GROUPING
end property

property MoneyFormat.Grouping( ) as ustring
if ( this.mask_ and MONEY_F_GROUPING ) <> 0 then return this.oGroup_
mnyEnsureSnap_( )
if mnySnap_.IsValid = false then return "3;0"
dim as ustring r
for i as long = 0 to mnySnap_.GroupCount - 1
    if len( r ) > 0 then r += ";"
    r += str( mnySnap_.Groups(i) )
next
if mnySnap_.GroupsRepeat then
    if len( r ) > 0 then r += ";"
    r += "0"
end if
return r
end property

property MoneyFormat.FracDigits( byval n as long )
this.oFrac_ = n
this.mask_ or= MONEY_F_FRACDIGITS
end property

property MoneyFormat.FracDigits( ) as long
if ( this.mask_ and MONEY_F_FRACDIGITS ) <> 0 then
    if this.oFrac_ < 0 then return 0
    if this.oFrac_ > MONEY_MAX_FRAC then return MONEY_MAX_FRAC
    return this.oFrac_
end if
mnyEnsureSnap_( )
if mnySnap_.IsValid = false then return 2
dim as long d = mnySnap_.FracDigits
if d < 0 orelse d > MONEY_MAX_FRAC then return 2      '' covers 127
return d
end property

property MoneyFormat.SymbolPrecedes( byval b as boolean )
this.oPrecedes_ = b
this.mask_ or= MONEY_F_SYMBOLPRECEDES
end property

property MoneyFormat.SymbolPrecedes( ) as boolean
if ( this.mask_ and MONEY_F_SYMBOLPRECEDES ) <> 0 then return this.oPrecedes_
mnyEnsureSnap_( )
if mnySnap_.IsValid = false then return true
if this.value_.IsNegative( ) then return mnySnap_.NegPrecedes
return mnySnap_.PosPrecedes
end property

property MoneyFormat.SpaceBySymbol( byval b as boolean )
this.oSpace_ = b
this.mask_ or= MONEY_F_SPACEBYSYMBOL
end property

property MoneyFormat.SpaceBySymbol( ) as boolean
if ( this.mask_ and MONEY_F_SPACEBYSYMBOL ) <> 0 then return this.oSpace_
mnyEnsureSnap_( )
if mnySnap_.IsValid = false then return false
if this.value_.IsNegative( ) then return ( mnySnap_.NegSepSpace <> 0 )
return ( mnySnap_.PosSepSpace <> 0 )
end property

property MoneyFormat.Negative( byval n as MoneyNegative )
this.oNeg_ = n
this.mask_ or= MONEY_F_NEGATIVE
end property

property MoneyFormat.Negative( ) as MoneyNegative
return cast( MoneyNegative, this.oNeg_ )
end property

property MoneyFormat.BlankIfZero( byval b as boolean )
this.blankZero_ = b
end property
property MoneyFormat.BlankIfZero( ) as boolean
return this.blankZero_
end property

property MoneyFormat.ForcePlus( byval b as boolean )
this.forcePlus_ = b
end property
property MoneyFormat.ForcePlus( ) as boolean
return this.forcePlus_
end property

property MoneyFormat.ZeroText( byref s as ustring )
this.zeroText_ = s
end property
property MoneyFormat.ZeroText( ) as ustring
return this.zeroText_
end property

property MoneyFormat.Rounding( byval mode as long )
this.round_ = mode
end property
property MoneyFormat.Rounding( ) as long
return this.round_
end property

function MoneyFormat.Overrides( ) as ulong
return this.mask_
end function

sub MoneyFormat.UseLocale( byval fields as long )
this.mask_ and= not culng( fields )
end sub

'' ---------------------------------------------------------------------------
'' Rendering
'' ---------------------------------------------------------------------------

'' Insert the separator into a run of integer digits, innermost group first.
function mnyGroupDigits_ _
( byref intDigits as ustring, byref sep as ustring, byref spec as ustring ) as ustring

if len( sep ) = 0 then return intDigits

'' spec is "3;0" / "3;2;0"; parse it inline rather than keeping a second
'' parsed copy on every instance.
dim as long sizes(0 to MONEY_MAX_GROUPS-1)
dim as long cnt = 0
dim as boolean repeat_ = false
dim as string s = spec
dim as long i = 1
do while i <= len( s ) andalso cnt < MONEY_MAX_GROUPS
    dim as long j = instr( i, s, ";" )
    if j = 0 then j = len( s ) + 1
    dim as long n = valint( mid( s, i, j - i ) )
    if n = 0 then
        repeat_ = ( cnt > 0 )
        exit do
    end if
    sizes(cnt) = n
    cnt += 1
    i = j + 1
loop
if cnt = 0 then return intDigits

dim as ustring res
dim as long pos_ = len( intDigits )
dim as long gi = 0

do while pos_ > 0
    dim as long size_
    if gi < cnt then
        size_ = sizes(gi)
    elseif repeat_ then
        size_ = sizes(cnt-1)
    else
        exit do                              '' the locale says stop here
    end if
    if size_ <= 0 then exit do

    dim as long start_ = pos_ - size_
    if start_ <= 0 then exit do              '' the last group is the rest
    res = sep + mid( intDigits, start_ + 1, pos_ - start_ ) + res
    pos_ = start_
    gi += 1
loop

return left( intDigits, pos_ ) + res

end function

'' True when a fixed-point digit run is all zeros, so that a value which
'' ROUNDED AWAY to nothing is not rendered as -$0.00.
function mnyIsZeroText_( byref s as string ) as boolean
for i as long = 0 to len( s ) - 1
    dim as ubyte c = s[i]
    if c >= asc( "1" ) andalso c <= asc( "9" ) then return false
next
return true
end function

function MoneyFormat.ToString( ) as ustring

if this.value_.IsValid( ) = false then return ""

mnyEnsureSnap_( )

dim as long fd = this.FracDigits

'' Exact decimal rounding, then an exact rescale to the same place. No
'' snprintf and no binary round trip, so the printed figure agrees with
'' what std/money's finance functions computed.
dim as Decimal r = this.value_.RoundMode( fd, this.round_ )
if r.IsValid( ) = false then return ""
dim as string ds = r.ToStringFixed( fd )
if len( ds ) = 0 then return ""

dim as boolean neg = ( left( ds, 1 ) = "-" )
if neg then ds = mid( ds, 2 )
if mnyIsZeroText_( ds ) then
    neg = false
    if this.blankZero_ then return ""
    if len( this.zeroText_ ) > 0 then return this.zeroText_
end if

'' Split at the '.' ToStringFixed produced, group, rejoin with the
'' locale's decimal point.
dim as ustring ip, fp
dim as long dot = instr( ds, "." )
if dot = 0 then
    ip = ds
else
    ip = left( ds, dot - 1 )
    fp = mid( ds, dot + 1 )
end if

dim as ustring num = mnyGroupDigits_( ip, this.ThousandsSep, this.Grouping )
if len( fp ) > 0 then num += this.DecimalPoint + fp

'' Layout. SymbolPrecedes/SpaceBySymbol already resolve override-then-
'' locale, and already pick the positive or negative variant by sign --
'' which is why the sign is decided before they are read.
dim as boolean precedes = this.SymbolPrecedes
dim as long sepSpace
if ( this.mask_ and MONEY_F_SPACEBYSYMBOL ) <> 0 then
    sepSpace = iif( this.oSpace_, 1, 0 )
elseif mnySnap_.IsValid then
    sepSpace = iif( neg, mnySnap_.NegSepSpace, mnySnap_.PosSepSpace )
end if

dim as long posn = MONEY_POSN_BEFORE
dim as ustring signStr

if neg then
    dim as ustring locSign = "-"
    if mnySnap_.IsValid andalso len( mnySnap_.NegativeSign ) > 0 then locSign = mnySnap_.NegativeSign

    select case this.oNeg_
    case MONEY_NEG_MINUS
        posn = MONEY_POSN_BEFORE : signStr = locSign
    case MONEY_NEG_PARENS
        posn = MONEY_POSN_PARENS : signStr = ""
    case MONEY_NEG_TRAILING
        posn = MONEY_POSN_AFTER  : signStr = locSign
    case MONEY_NEG_NONE
        posn = MONEY_POSN_BEFORE : signStr = ""
    case else                                     '' MONEY_NEG_LOCALE
        signStr = locSign
        if mnySnap_.IsValid then posn = mnySnap_.NegSignPosn
        if posn < 0 orelse posn > 4 then posn = MONEY_POSN_BEFORE   '' 127
        if posn = MONEY_POSN_PARENS then signStr = ""
    end select
else
    if mnySnap_.IsValid then
        signStr = mnySnap_.PositiveSign
        posn = mnySnap_.PosSignPosn
        if posn < 0 orelse posn > 4 then posn = MONEY_POSN_BEFORE
        if posn = MONEY_POSN_PARENS then posn = MONEY_POSN_BEFORE   '' never wrap a positive
    end if
    if this.forcePlus_ andalso len( signStr ) = 0 then signStr = "+"
end if

'' NO SEPARATOR WITH NOTHING ON ONE SIDE OF IT. MoneyCompose is the
'' primitive and reproduces strfmon exactly, warts included; the class does
'' not, because both warts are reachable here from ordinary use. Suppressing
'' the symbol -- a first-class feature -- would otherwise leave "1.234,50 "
'' with a trailing space under any locale whose layout separates them, and
'' MONEY_NEG_NONE would leave one where the sign used to be.
dim as ustring symTxt = this.Symbol
if len( symTxt ) = 0 then sepSpace = 0
if sepSpace = 2 andalso len( signStr ) = 0 then sepSpace = 0

return MoneyCompose( num, symTxt, signStr, precedes, sepSpace, posn )

end function

operator MoneyFormat.cast( ) as ustring
return this.ToString( )
end operator

