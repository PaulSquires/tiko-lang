#module "money"
#import "std/numeric"
#import "std/chrono"
#import "std/outcome"
using numeric
using chrono
using outcome
'' std/money: finport -- portfolio returns and risk
''
''     #import "std/money"
''     using money
''
''     dim as Array( of double ) monthly
''     monthly.Push( ... )
''     var s = SummarizeReturns( monthly, 0.0035 / 12.0, RETURN_MONTHLY )
''     if( s.IsOk( ) ) then
''         print s.Value( ).Annualized_, s.Value( ).Volatility_, s.Value( ).Sharpe_
''     end if
''
'' EVERY SERIES PARAMETER IS FB.Array, NOT a plain 'periodReturns( ) as double'.
'' FB.Array is ZERO-BASED, so the indices MaxDrawdownPeak and MaxDrawdownTrough
'' return are offsets from element 0 with no lbound to subtract -- a caller that
'' used to pass a 1-based array must re-base it.
''
'' Specified by C:\dev\docs\finance\RFC-0008-portfolio.md.  Phase 7.
''
'' DOUBLE THROUGHOUT, and this is the one surface in the module where that is
'' the right answer rather than a compromise.  Three reasons, stated once here
'' instead of per function:
''
''   1. fb/decimal.bi has NO SQUARE ROOT.  Volatility, tracking error and both
''      ratio denominators are square roots.  Implementing one on a 96-bit
''      mantissa to serve a statistic whose input is uncertain in its third
''      significant digit is effort in the wrong place.
''   2. fb/stats.bi ALREADY DOES THIS WELL -- Neumaier-compensated summation,
''      and Welford for the moments.  Reimplementing in Decimal would duplicate
''      tested code to get a less accurate answer more slowly.
''   3. Nobody quotes a Sharpe ratio to 28 digits.
''
'' Money crossing in converts at the boundary through Decimal.ToDouble( ).
'' HoldingPeriodReturn is the ONE EXCEPTION and stays exact: it is a single
'' Decimal division of two money amounts, with no root and no summation, so
'' returning a double there would throw away precision for nothing.
''
'' SAMPLE OR POPULATION -- THE CHOICE, MADE AND STATED.  This is the classic
'' statistics bug and the RFC's own delegation table had it wrong until the
'' implementation checked:
''
''     Volatility, DownsideDeviation, TrackingError   SAMPLE  ( n - 1 )
''     Beta                                            sample covariance
''                                                     OVER SAMPLE VARIANCE
''
'' A return history is a SAMPLE of a process, so n-1 is right for the spread
'' measures, and that is what every commercial risk system reports.
''
'' For Beta what matters is NOT which convention but THAT BOTH LEGS USE THE
'' SAME ONE.  Beta is a regression slope, Cov(a,b)/Var(b); the n-1 factors
'' cancel, so sample-over-sample and population-over-population give the
'' IDENTICAL number.  Mixing them -- sample covariance over POPULATION variance,
'' which is what the RFC first specified -- scales the answer by (n-1)/n and is
'' wrong.  fb/stats.bi has no population covariance to pair with
'' VariancePopulation anyway, so the sample pair is both correct and the only
'' one available.  See C:\dev\docs\finance\amendments.md.
''
'' DOWNSIDE DEVIATION DOES NOT DELEGATE TO StdDev, and cannot.  StdDev measures
'' spread about the MEAN and divides by n-1; downside deviation measures
'' shortfall against a TARGET and divides by the FULL observation count, so that
'' a portfolio which is rarely below target is rewarded for it.  Different
'' centre, different denominator.  It is written out below with that stated.


#if __FB_LANG__ <> "fb"
    #error "fb/finport.bi requires -lang fb (it uses namespaces)"
#endif

#include once "fblimits.bi"
#include once "fblimits.bi"
#include once "fb/array.bi"
#include once "fb/array.bi"

using FB

'' ===========================================================================
'' Frequency
'' ===========================================================================

'' RETURN_DAILY_252 AND RETURN_DAILY_365 ARE BOTH OFFERED because the choice is
'' a convention, not a fact: 252 is trading days, 365 is calendar days, and a
'' Sharpe ratio computed one way is not comparable with one computed the other.
'' Forcing the caller to pick is the point.
public enum ReturnFrequency
    RETURN_ANNUAL    = 1
    RETURN_QUARTERLY = 4
    RETURN_WEEKLY    = 52
    RETURN_MONTHLY   = 12
    RETURN_DAILY_252 = 252
    RETURN_DAILY_365 = 365
end enum

public type ReturnSummary
    as double Total_, Annualized_, Volatility_, Sharpe_, Sortino_, MaxDrawdown_
    as long   Observations_
end type

public type FinResultSeries  as Result( of Array( of double ), FinanceError )
public type FinResultReturns as Result( of ReturnSummary, FinanceError )

'' ===========================================================================
'' Private helpers
'' ===========================================================================

function hPortCount overload ( byref r as Array( of double ) ) as long
    return r.Count( )
end function

function hPortCheck overload ( byref r as Array( of double ), byval minimum as long ) as FinanceErrorCode
    dim as long n = hPortCount( r )
    if( n < 1 ) then return FIN_EMPTY_SERIES
    if( n < minimum ) then return FIN_EMPTY_SERIES
    for each v in r
        if( IsFinite( v ) = FALSE ) then return FIN_DOMAIN
    next
    return FIN_OK
end function

function hPortCheckPair overload ( byref a as Array( of double ), byref b as Array( of double ), byval minimum as long ) as FinanceErrorCode
    dim as FinanceErrorCode bad = hPortCheck( a, minimum )
    if( bad <> FIN_OK ) then return bad
    bad = hPortCheck( b, minimum )
    if( bad <> FIN_OK ) then return bad
    if( hPortCount( a ) <> hPortCount( b ) ) then return FIN_LENGTH_MISMATCH
    return FIN_OK
end function

'' The active-return series, a - b, which several measures are built on.
sub hPortActive overload ( byref a as Array( of double ), byref b as Array( of double ), byref act as Array( of double ) )
    dim as long n = hPortCount( a )
    act.Clear( )
    act.Reserve( n )
    for k as long = 0 to n - 1
        act.Push( a[ k ] - b[ k ] )
    next
end sub

'' ===========================================================================
'' Returns
'' ===========================================================================

'' EXACT -- one Decimal division.  See the header note on why this alone stays
'' out of the double kernel.
public function HoldingPeriodReturn overload _
    ( byref beginValue as Decimal, byref endValue as Decimal, byref income as Decimal ) as FinResultDec

    if( beginValue.IsValid( ) = FALSE ) then return FinFailDec( FIN_INVALID_TERM )
    if( endValue.IsValid( ) = FALSE ) then return FinFailDec( FIN_INVALID_TERM )
    if( income.IsValid( ) = FALSE ) then return FinFailDec( FIN_INVALID_TERM )
    if( beginValue.IsZero( ) ) then return FinFailDec( FIN_DOMAIN )

    dim as Decimal gain = ( ( endValue - beginValue ) + income )
    dim as Decimal hpr = ( gain / beginValue )
    if( hpr.IsValid( ) = FALSE ) then return FinFailDec( FIN_OVERFLOW )
    return FinOkDec( hpr )
end function

'' DOUBLE.  A fractional root.
public function CompoundAnnualGrowthRate overload _
    ( byref beginValue as Decimal, byref endValue as Decimal, byval years as double ) as FinResultDbl

    if( beginValue.IsValid( ) = FALSE ) then return FinFailDbl( FIN_INVALID_TERM )
    if( endValue.IsValid( ) = FALSE ) then return FinFailDbl( FIN_INVALID_TERM )
    if( beginValue <= DecimalZero( ) ) then return FinFailDbl( FIN_DOMAIN )
    if( endValue <= DecimalZero( ) ) then return FinFailDbl( FIN_DOMAIN )
    if( years <= 0.0 ) then return FinFailDbl( FIN_INVALID_PERIODS )

    dim as double ratio = endValue.ToDouble( ) / beginValue.ToDouble( )
    '' Expm1/Log1p rather than Pow: the RESULT IS A RATE near zero, so the
    '' "- 1" would lose its leading digits -- fb/fincore.bi's rule.
    return FinOkDbl( Expm1( Log1p( ratio - 1.0 ) / years ) )
end function

'' GEOMETRIC, not r * f.  ( 1 + r )^f - 1.  Both are one-liners and the wrong
'' one appears in a great deal of published code, which is why this is a named
'' function rather than left inline at nine call sites.
public function AnnualizeReturn overload ( byval periodReturn as double, byval f as ReturnFrequency ) as double
    return Expm1( cdbl( clng( f ) ) * Log1p( periodReturn ) )
end function

'' A total return spread over 'periods' observations, annualized.
public function AnnualizeReturnOverPeriods overload _
    ( byval totalReturn as double, byval periods as long, byval f as ReturnFrequency ) as FinResultDbl

    if( periods < 1 ) then return FinFailDbl( FIN_INVALID_PERIODS )
    if( totalReturn <= -1.0 ) then return FinFailDbl( FIN_DOMAIN )

    dim as double perPeriod = Expm1( Log1p( totalReturn ) / cdbl( periods ) )
    return FinOkDbl( AnnualizeReturn( perPeriod, f ) )
end function

'' GEOMETRIC LINKING of sub-period returns.
''
'' THIS IS A TRUE TIME-WEIGHTED RETURN ONLY IF the caller cut a sub-period at
'' EVERY external cash flow.  Stated at the function because a caller who passes
'' monthly returns with mid-month contributions gets a plausible number that is
'' not a TWR -- and nothing in the signature could tell them.
public function TimeWeightedReturn overload ( byref subPeriodReturns as Array( of double ) ) as FinResultDbl
    dim as FinanceErrorCode bad = hPortCheck( subPeriodReturns, 1 )
    if( bad <> FIN_OK ) then return FinFailDbl( bad )

    dim as double acc = 0.0
    for each r in subPeriodReturns
        if( r <= -1.0 ) then return FinFailDbl( FIN_DOMAIN )
        acc += Log1p( r )
    next
    return FinOkDbl( Expm1( acc ) )
end function

'' MODIFIED DIETZ -- the standard approximation to a TWR that does not require a
'' valuation at every flow.  Each flow is weighted by the fraction of the period
'' it was invested for.
public function ModifiedDietzReturn overload _
    ( _
        byref beginValue as Decimal, byref endValue as Decimal, _
        byref flows as Array( of Decimal ), byref flowDayOffsets as Array( of long ), _
        byval periodDays as long _
    ) as FinResultDbl

    if( beginValue.IsValid( ) = FALSE ) then return FinFailDbl( FIN_INVALID_TERM )
    if( endValue.IsValid( ) = FALSE ) then return FinFailDbl( FIN_INVALID_TERM )
    if( periodDays < 1 ) then return FinFailDbl( FIN_INVALID_PERIODS )

    dim as long nf = flows.Count( )
    dim as long nd = flowDayOffsets.Count( )
    if( nf <> nd ) then return FinFailDbl( FIN_LENGTH_MISMATCH )

    dim as double bv = beginValue.ToDouble( )
    dim as double ev = endValue.ToDouble( )
    dim as double netFlow = 0.0
    dim as double weighted = 0.0

    for k as long = 0 to nf - 1
        dim as double amt = flows[ k ].ToDouble( )
        dim as long off = flowDayOffsets[ k ]
        if( off < 0 orelse off > periodDays ) then return FinFailDbl( FIN_INVALID_PERIODS )

        netFlow += amt
        '' The fraction of the period this money was invested for.
        dim as double w = cdbl( periodDays - off ) / cdbl( periodDays )
        weighted += amt * w
    next

    dim as double denom = bv + weighted
    if( denom = 0.0 ) then return FinFailDbl( FIN_DOMAIN )

    return FinOkDbl( ( ev - bv - netFlow ) / denom )
end function

'' MONEY-WEIGHTED -- the dated IRR of the flows with the terminal value
'' appended, so it DOES reflect the timing of contributions.  It measures the
'' INVESTOR; TimeWeightedReturn measures the MANAGER.
''
'' Inherits every limit of fb/finsolve.bi, including non-convergence.
public function MoneyWeightedReturn overload _
    ( _
        byref flows as Array( of CashFlow ), byref terminalValue as Decimal, _
        byref terminalDate as LocalDate, byval basis as DayCount _
    ) as FinResultDbl

    dim as long n = flows.Count( )
    if( n < 1 ) then return FinFailDbl( FIN_EMPTY_SERIES )
    if( terminalValue.IsValid( ) = FALSE ) then return FinFailDbl( FIN_INVALID_TERM )
    if( terminalDate.IsValid = FALSE ) then return FinFailDbl( FIN_UNORDERED_DATES )

    '' Append the terminal value as a final inflow.
    dim as Array( of CashFlow ) full_
    full_.Reserve( n + 1 )
    for each cf in flows
        full_.Push( cf )
    next
    full_.Push( CashFlowMake( terminalValue, terminalDate ) )

    dim as FinResultDec r = InternalRateOfReturnOnDates( full_, basis )
    if( r.IsOk( ) = FALSE ) then
        return Fail( of double, FinanceError )( r.Failure( ) )
    end if
    return FinOkDbl( r.Value( ).ToDouble( ) )
end function

'' ===========================================================================
'' Series
'' ===========================================================================

'' The cumulative return after each observation: ( 1 + r1 )...( 1 + rk ) - 1.
public function CumulativeReturnSeries overload ( byref periodReturns as Array( of double ) ) as FinResultSeries
    dim as FinanceErrorCode bad = hPortCheck( periodReturns, 1 )
    if( bad <> FIN_OK ) then
        return Fail( of Array( of double ), FinanceError )( FinanceErrorMake( bad ) )
    end if

    dim as Array( of double ) out_
    dim as double acc = 0.0
    for each r in periodReturns
        if( r <= -1.0 ) then
            return Fail( of Array( of double ), FinanceError )( FinanceErrorMake( FIN_DOMAIN ) )
        end if
        acc += Log1p( r )
        dim as double v = Expm1( acc )
        out_.Push( v )
    next
    return Ok( of Array( of double ), FinanceError )( out_ )
end function

'' The drawdown at each observation, measured FROM THE RUNNING PEAK of the
'' cumulative wealth series -- not from the series start.  Both definitions are
'' in use and this one is the standard; stated so it is a choice rather than an
'' assumption.
''
'' EVERY VALUE IS <= 0.  MaxDrawdown below returns the MAGNITUDE as a positive
'' number, which is the universal way it is quoted ("a 20% drawdown"), and the
'' asymmetry is deliberate and documented rather than accidental.
public function DrawdownSeries overload ( byref periodReturns as Array( of double ) ) as FinResultSeries
    dim as FinanceErrorCode bad = hPortCheck( periodReturns, 1 )
    if( bad <> FIN_OK ) then
        return Fail( of Array( of double ), FinanceError )( FinanceErrorMake( bad ) )
    end if

    dim as Array( of double ) out_
    dim as double wealth = 1.0
    dim as double peak = 1.0

    for each r in periodReturns
        if( r <= -1.0 ) then
            return Fail( of Array( of double ), FinanceError )( FinanceErrorMake( FIN_DOMAIN ) )
        end if
        wealth *= ( 1.0 + r )
        if( wealth > peak ) then peak = wealth
        out_.Push( ( wealth - peak ) / peak )
    next
    return Ok( of Array( of double ), FinanceError )( out_ )
end function

'' THE MAGNITUDE, as a POSITIVE number -- see DrawdownSeries.  A series that
'' never fell below its starting peak gives exactly zero.
public function MaxDrawdown overload ( byref periodReturns as Array( of double ) ) as FinResultDbl
    dim as FinResultSeries d = DrawdownSeries( periodReturns )
    if( d.IsOk( ) = FALSE ) then
        return Fail( of double, FinanceError )( d.Failure( ) )
    end if

    dim as double worst = 0.0
    for each dd in d.Value( )
        if( dd < worst ) then worst = dd
    next

    '' Guarded so a series that never drew down returns +0.0 and not -0.0.
    '' Negating a zero preserves the sign bit, and a drawdown that prints as
    '' "-0" is the sort of thing that gets reported as a defect.
    if( worst = 0.0 ) then return FinOkDbl( 0.0 )
    return FinOkDbl( -worst )
end function

'' The index of the peak the worst drawdown fell FROM, and of its trough.
''
'' OPTIONAL, not Result: a series that never drew down has NO peak and NO
'' trough, and that is the finding rather than a failure -- RFC-0001 section 6.
function hPortDrawdownIndex overload ( byref periodReturns as Array( of double ), byval wantPeak as boolean ) as Optional( of long )
    dim as Optional( of long ) absent
    if( hPortCheck( periodReturns, 1 ) <> FIN_OK ) then return absent

    dim as double wealth = 1.0
    dim as double peak = 1.0
    dim as double worst = 0.0
    dim as long peakIdx = -1, troughIdx = -1, curPeakIdx = -1

    for k as long = 0 to periodReturns.Count( ) - 1
        wealth *= ( 1.0 + periodReturns[ k ] )
        if( wealth > peak ) then
            peak = wealth
            curPeakIdx = k
        end if
        dim as double dd = ( wealth - peak ) / peak
        if( dd < worst ) then
            worst = dd
            peakIdx = curPeakIdx
            troughIdx = k
        end if
    next

    if( troughIdx < 0 ) then return absent
    if( wantPeak ) then return Some( of long )( peakIdx )
    return Some( of long )( troughIdx )
end function

public function MaxDrawdownPeak overload ( byref periodReturns as Array( of double ) ) as Optional( of long )
    return hPortDrawdownIndex( periodReturns, TRUE )
end function

public function MaxDrawdownTrough overload ( byref periodReturns as Array( of double ) ) as Optional( of long )
    return hPortDrawdownIndex( periodReturns, FALSE )
end function

'' ===========================================================================
'' Risk
''
'' Every moment here comes from fb/stats.bi.  Nothing statistical is
'' reimplemented, with ONE stated exception: DownsideDeviation, which measures
'' shortfall against a TARGET over the FULL count and therefore cannot be
'' StdDev.
'' ===========================================================================

'' SAMPLE standard deviation, scaled by the SQUARE ROOT of the frequency --
'' variance scales with time, standard deviation with its square root.
public function Volatility overload ( byref periodReturns as Array( of double ), byval f as ReturnFrequency ) as FinResultDbl
    dim as FinanceErrorCode bad = hPortCheck( periodReturns, 2 )
    if( bad <> FIN_OK ) then return FinFailDbl( bad )

    dim as double sd = StdDev( periodReturns )           '' fb/stats.bi, n-1
    if( IsFinite( sd ) = FALSE ) then return FinFailDbl( FIN_DOMAIN )
    return FinOkDbl( sd * sqr( cdbl( clng( f ) ) ) )
end function

'' NOT StdDev, and the header says why: this measures shortfall against a
'' TARGET, not spread about the mean, and divides by the FULL observation count
'' so that rarely being below target is rewarded.
public function DownsideDeviation overload _
    ( byref periodReturns as Array( of double ), byval targetPerPeriod as double, byval f as ReturnFrequency ) as FinResultDbl

    dim as FinanceErrorCode bad = hPortCheck( periodReturns, 1 )
    if( bad <> FIN_OK ) then return FinFailDbl( bad )

    dim as long n = hPortCount( periodReturns )
    dim as double acc = 0.0
    for each r in periodReturns
        dim as double short_ = r - targetPerPeriod
        if( short_ < 0.0 ) then acc += short_ * short_
    next

    dim as double dd = sqr( acc / cdbl( n ) )
    return FinOkDbl( dd * sqr( cdbl( clng( f ) ) ) )
end function

public function SharpeRatio overload _
    ( byref periodReturns as Array( of double ), byval riskFreePerPeriod as double, byval f as ReturnFrequency ) as FinResultDbl

    dim as FinanceErrorCode bad = hPortCheck( periodReturns, 2 )
    if( bad <> FIN_OK ) then return FinFailDbl( bad )

    dim as double avg = Mean( periodReturns )            '' fb/stats.bi
    dim as double sd = StdDev( periodReturns )           '' fb/stats.bi, n-1
    if( sd = 0.0 ) then return FinFailDbl( FIN_DOMAIN )
    if( IsFinite( sd ) = FALSE ) then return FinFailDbl( FIN_DOMAIN )

    '' Excess return per unit of risk, both annualized -- the sqrt( f ) in the
    '' denominator and the f in the numerator do NOT cancel.
    dim as double excess = ( avg - riskFreePerPeriod ) * cdbl( clng( f ) )
    return FinOkDbl( excess / ( sd * sqr( cdbl( clng( f ) ) ) ) )
end function

public function SortinoRatio overload _
    ( byref periodReturns as Array( of double ), byval targetPerPeriod as double, byval f as ReturnFrequency ) as FinResultDbl

    dim as FinanceErrorCode bad = hPortCheck( periodReturns, 1 )
    if( bad <> FIN_OK ) then return FinFailDbl( bad )

    dim as FinResultDbl dd = DownsideDeviation( periodReturns, targetPerPeriod, f )
    if( dd.IsOk( ) = FALSE ) then return dd
    if( dd.Value( ) = 0.0 ) then return FinFailDbl( FIN_DOMAIN )

    dim as double avg = Mean( periodReturns )
    dim as double excess = ( avg - targetPerPeriod ) * cdbl( clng( f ) )
    return FinOkDbl( excess / dd.Value( ) )
end function

'' SAMPLE COVARIANCE OVER SAMPLE VARIANCE.  The n-1 factors cancel, so this is
'' the regression slope and is identical to the population pair.  WHAT MATTERS
'' IS THAT BOTH LEGS AGREE -- mixing sample covariance with population variance
'' scales the answer by (n-1)/n, which is the classic error this docset's
'' RFC-0008 section 5 warns about and which its own first delegation table
'' committed.
public function Beta overload ( byref assetReturns as Array( of double ), byref benchmarkReturns as Array( of double ) ) as FinResultDbl
    dim as FinanceErrorCode bad = hPortCheckPair( assetReturns, benchmarkReturns, 2 )
    if( bad <> FIN_OK ) then return FinFailDbl( bad )

    dim as double cv = Covariance( assetReturns, benchmarkReturns )         '' n-1
    dim as double vb = Variance( benchmarkReturns )                         '' n-1
    if( vb = 0.0 ) then return FinFailDbl( FIN_DOMAIN )
    if( IsFinite( cv ) = FALSE ) then return FinFailDbl( FIN_DOMAIN )
    if( IsFinite( vb ) = FALSE ) then return FinFailDbl( FIN_DOMAIN )
    return FinOkDbl( cv / vb )
end function

'' Jensen's alpha, annualized: the excess the asset earned beyond what its beta
'' exposure to the benchmark would explain.
public function Alpha overload _
    ( _
        byref assetReturns as Array( of double ), byref benchmarkReturns as Array( of double ), _
        byval riskFreePerPeriod as double, byval f as ReturnFrequency _
    ) as FinResultDbl

    dim as FinResultDbl b = Beta( assetReturns, benchmarkReturns )
    if( b.IsOk( ) = FALSE ) then return b

    dim as double ra = Mean( assetReturns )
    dim as double rb = Mean( benchmarkReturns )
    dim as double a_ = ( ra - riskFreePerPeriod ) - b.Value( ) * ( rb - riskFreePerPeriod )
    return FinOkDbl( a_ * cdbl( clng( f ) ) )
end function

'' The SAMPLE standard deviation of the active return series, annualized.
public function TrackingError overload _
    ( byref assetReturns as Array( of double ), byref benchmarkReturns as Array( of double ), byval f as ReturnFrequency ) as FinResultDbl

    dim as FinanceErrorCode bad = hPortCheckPair( assetReturns, benchmarkReturns, 2 )
    if( bad <> FIN_OK ) then return FinFailDbl( bad )

    dim as Array( of double ) act
    hPortActive( assetReturns, benchmarkReturns, act )

    dim as double sd = StdDev( act )                     '' fb/stats.bi, n-1
    if( IsFinite( sd ) = FALSE ) then return FinFailDbl( FIN_DOMAIN )
    return FinOkDbl( sd * sqr( cdbl( clng( f ) ) ) )
end function

public function InformationRatio overload _
    ( byref assetReturns as Array( of double ), byref benchmarkReturns as Array( of double ), byval f as ReturnFrequency ) as FinResultDbl

    dim as FinResultDbl te = TrackingError( assetReturns, benchmarkReturns, f )
    if( te.IsOk( ) = FALSE ) then return te
    if( te.Value( ) = 0.0 ) then return FinFailDbl( FIN_DOMAIN )

    dim as Array( of double ) act
    hPortActive( assetReturns, benchmarkReturns, act )

    dim as double avg = Mean( act )
    return FinOkDbl( ( avg * cdbl( clng( f ) ) ) / te.Value( ) )
end function

public function CorrelationToBenchmark overload _
    ( byref assetReturns as Array( of double ), byref benchmarkReturns as Array( of double ) ) as FinResultDbl

    dim as FinanceErrorCode bad = hPortCheckPair( assetReturns, benchmarkReturns, 2 )
    if( bad <> FIN_OK ) then return FinFailDbl( bad )

    dim as double c = Correlation( assetReturns, benchmarkReturns )         '' fb/stats.bi
    if( IsFinite( c ) = FALSE ) then return FinFailDbl( FIN_DOMAIN )
    return FinOkDbl( c )
end function

'' ===========================================================================
'' Summary
'' ===========================================================================

public function SummarizeReturns overload _
    ( byref periodReturns as Array( of double ), byval riskFreePerPeriod as double, byval f as ReturnFrequency ) as FinResultReturns

    dim as FinanceErrorCode bad = hPortCheck( periodReturns, 2 )
    if( bad <> FIN_OK ) then
        return Fail( of ReturnSummary, FinanceError )( FinanceErrorMake( bad ) )
    end if

    dim as ReturnSummary s
    s.Observations_ = hPortCount( periodReturns )

    dim as FinResultDbl twr = TimeWeightedReturn( periodReturns )
    if( twr.IsOk( ) = FALSE ) then
        return Fail( of ReturnSummary, FinanceError )( twr.Failure( ) )
    end if
    s.Total_ = twr.Value( )

    dim as FinResultDbl ann = AnnualizeReturnOverPeriods( s.Total_, s.Observations_, f )
    if( ann.IsOk( ) ) then s.Annualized_ = ann.Value( )

    dim as FinResultDbl vol = Volatility( periodReturns, f )
    if( vol.IsOk( ) ) then s.Volatility_ = vol.Value( )

    dim as FinResultDbl sh = SharpeRatio( periodReturns, riskFreePerPeriod, f )
    if( sh.IsOk( ) ) then s.Sharpe_ = sh.Value( )

    dim as FinResultDbl so = SortinoRatio( periodReturns, riskFreePerPeriod, f )
    if( so.IsOk( ) ) then s.Sortino_ = so.Value( )

    dim as FinResultDbl md = MaxDrawdown( periodReturns )
    if( md.IsOk( ) ) then s.MaxDrawdown_ = md.Value( )

    return Ok( of ReturnSummary, FinanceError )( s )
end function

