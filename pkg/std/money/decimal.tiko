#module "money"
'' std/money: decimal -- 128-bit decimal floating point, .NET's 'decimal'
''
''     #import "std/money"
''     using money
''
''     dim as Decimal price = DecimalParse( "19.99" ).Value( )
''     dim as Decimal line_ = price * 3             ' exact -- integer arithmetic
''     print line_.ToString( )                      ' 59.97
''
''     dim as Decimal rate = DecimalParse( "0.0825" ).Value( )
''     print ( line_ * rate ).ToString( )           ' 4.947525  -- EXACT, 6 places
''
'' A 96-BIT INTEGER, A SCALE, AND A SIGN.  The value is
''
''     ( -1 ^ sign ) * mantissa / 10 ^ scale
''
'' with mantissa in 0 .. 2^96-1 and scale in 0 .. 28:
''
''     range        -79,228,162,514,264,337,593,543,950,335
''                   .. +79,228,162,514,264,337,593,543,950,335
''     precision    28-29 significant decimal digits
''     smallest     0.0000000000000000000000000001  (1e-28)
''     size         16 bytes
''
'' This is the .NET 'System.Decimal' of C# and VB.NET, the COM 'DECIMAL' /
'' VT_DECIMAL type, and SQL Server's 'decimal(28,s)'.  Not a new
'' representation -- an existing, widely implemented one that FreeBASIC could
'' already name (win\wtypes.bi:329 declares 'tagDEC') and could not compute
'' with.  THIS TYPE HAS THE SAME 16-BYTE LAYOUT AS 'tagDEC', field for field,
'' so the interop boundary is a REINTERPRET and not a conversion.
''
'' WHY, GIVEN fb/currency.bi ALREADY EXISTS.  Currency is a LONGINT scaled by
'' 10,000: eight bytes, four decimal places, fixed, and the header says up
'' front that this is its central limitation.  FX rates quoted to six or eight
'' places, per-unit costs, per-mille rates, interest accrual and tax tables all
'' need more, and a Currency cannot hold them.  Decimal can:
''
''     Currency    +-922,337,203,685,477.5807     4 places, always
''     Decimal     +-7.9228162514264337e28        0..28 places, per value
''
'' The cost is size and speed.  Currency is one machine word and its add is one
'' instruction; Decimal is sixteen bytes and every operation is software
'' multi-precision.  IF FOUR PLACES IS ENOUGH, USE Currency -- it is the
'' cheaper type and this header does not deprecate it.  DecimalFromCurrency and
'' Decimal.ToCurrency convert between them exactly in the direction that can be
'' exact, and tell you when it cannot.
''
'' WHY NOT A DOUBLE.  0.1 + 0.2 <> 0.3 in binary floating point, and money is
'' decimal.  A DOUBLE also carries only 15-17 significant digits, so a ledger
'' that has grown past a trillion cannot hold a cent.  Decimal holds 28.
''
'' THE SCALE IS PART OF THE VALUE, NOT PART OF THE FORMATTING.  1.10 and 1.1
'' are EQUAL and print DIFFERENTLY, exactly as in .NET:
''
''     DecimalParse( "1.10" ).Value( ).ToString( )    ' 1.10
''     DecimalParse( "1.1"  ).Value( ).ToString( )    ' 1.1
''     DecimalParse( "1.10" ) = DecimalParse( "1.1" ) ' true
''
'' That is what lets a price read back from a file print the way it was
'' written.  Use Normalize( ) to strip trailing zeros and Rescale( ) to force a
'' scale.
''
'' NO ARITHMETIC IS DELEGATED TO OleAut32.  AfxNova's CDEC.inc wraps
'' VarDecAdd / VarDecMul / VarDecDiv, which works and is Windows-only.  This
'' compiler ships and gates on linux-x86_64, so the arithmetic is implemented
'' here in 32-bit limbs and 'VarDec*' -- and .NET itself -- is a TEST ORACLE
'' rather than a dependency.  The result is a type that behaves identically on
'' every target.
''
'' NAME COLLISION, STATED UP FRONT.  win\wtypes.bi declares a global type
'' called DECIMAL, and FreeBASIC identifiers are case-insensitive.  A module
'' that includes it AND writes 'using FB' has two things called Decimal in
'' scope, and the FB one wins; spell them FB.Decimal and tagDEC there to say
'' which you meant.  PLAIN windows.bi DOES NOT PULL wtypes.bi IN, so most
'' Win32 programs never meet this at all.
''
'' The layout claim is TESTED, not asserted: writing through an FB.Decimal and
'' reading back through a 'tagDEC ptr' aimed at the same bytes agrees on all
'' six fields -- wReserved, scale, sign, Hi32, Lo32, Mid32 -- and sizeof is 16
'' for both.


#include once "fblimits.bi"
#include once "fb/optional.bi"
#include once "fblimits.bi"
#include once "fb/optional.bi"

using FB

public const as long DECIMAL_MAX_SCALE = 28
public const as ubyte DECIMAL_SIGN_BIT = &h80        '' matches wtypes.bi DECIMAL_NEG
public const as ubyte DECIMAL_INVALID_SCALE = 255

'' ===========================================================================
'' The type
''
'' Layout is tagDEC's, field for field -- wReserved, scale, sign, Hi32, Lo32,
'' Mid32 -- so a Decimal and a Windows DECIMAL are the same sixteen bytes.
'' ===========================================================================

public type Decimal
    as ushort wReserved_
    as ubyte  scale_
    as ubyte  sign_
    as ulong  hi_
    as ulong  lo_
    as ulong  mid_

    declare function IsValid( ) as boolean
    declare function IsZero( ) as boolean
    declare function IsNegative( ) as boolean
    declare function Sign( ) as long
    declare function Scale( ) as long
    declare function Lo( ) as ulong
    declare function Mid( ) as ulong
    declare function Hi( ) as ulong
    declare function ToDouble( ) as double
    declare function ToString( ) as string
    declare function ToStringFixed( byval digits as long ) as string
    declare function ToCurrency( ) as Currency
    declare function ToLongInt( ) as Optional( of longint )
    declare function Round( byval digits as long ) as Decimal
    declare function RoundMode( byval digits as long, byval mode as long ) as Decimal
    declare function Rescale( byval digits as long ) as Decimal
    declare function Normalize( ) as Decimal
    declare function Floor( ) as Decimal
    declare function Ceiling( ) as Decimal
    declare function Truncate( ) as Decimal
    declare function AbsValue( ) as Decimal
end type

'' Rounding modes.  The DEFAULT IS HALF-TO-EVEN, which is what .NET's
'' decimal.Round does, what IEEE 754 does, and what stops a ledger drifting
'' upward -- half-up biases every tie the same way, and across a million lines
'' that is real money.  The names mirror fb/currency.bi's CUR_* set exactly, so
'' there is one rule to learn rather than two.
public enum DecimalRounding
    DEC_HALF_EVEN
    DEC_HALF_UP
    DEC_HALF_DOWN
    DEC_UP
    DEC_DOWN
    DEC_CEILING
    DEC_FLOOR
end enum

public declare function DecimalInvalid overload ( ) as Decimal
public declare function DecimalZero overload ( ) as Decimal
public declare function DecimalOne overload ( ) as Decimal
public declare function DecimalMinusOne overload ( ) as Decimal
public declare function DecimalMaxValue overload ( ) as Decimal
public declare function DecimalMinValue overload ( ) as Decimal
public declare function DecimalFromParts overload ( byval lo32 as ulong, byval mid32 as ulong, byval hi32 as ulong, byval neg as boolean, byval scale as long ) as Decimal
public declare function DecimalFromInt overload ( byval v as longint ) as Decimal
public declare function DecimalFromUInt overload ( byval v as ulongint ) as Decimal
public declare function DecimalFromScaled overload ( byval mantissa as longint, byval scale as long ) as Decimal
public declare function DecimalFromDouble overload ( byval v as double ) as Decimal
public declare function DecimalFromCurrency overload ( byref c as Currency ) as Decimal
public declare function DecimalParse overload ( byref s as string ) as Optional( of Decimal )
public declare function DecimalCompare overload ( byref a as Decimal, byref b as Decimal ) as long

'' ===========================================================================
'' DecWide -- a 192-bit unsigned magnitude in six 32-bit limbs
''
'' EVERY INTERMEDIATE IS 192 BITS, NOT 96.  A 96x96 product needs 192, and
'' aligning two operands to a common scale needs up to 96 + log2( 10^28 ) =
'' 190.  Carrying the full width and reducing ONCE, at the end, is both simpler
'' than .NET's operand-by-operand pre-rounding and never less accurate.
''
'' Limb 0 is least significant.  32-bit limbs rather than 64 because a 32x32
'' product fits a ULONGINT exactly and FreeBASIC has no 128-bit integer to hold
'' the 64x64 case.
'' ===========================================================================

type DecWide
    as ulong w( 0 to 5 )
end type

function hDecWZero( ) as DecWide
    dim as DecWide r
    function = r
end function

function hDecWFrom96( byval lo32 as ulong, byval mid32 as ulong, byval hi32 as ulong ) as DecWide
    dim as DecWide r
    r.w( 0 ) = lo32
    r.w( 1 ) = mid32
    r.w( 2 ) = hi32
    function = r
end function

function hDecWFromU64( byval v as ulongint ) as DecWide
    dim as DecWide r
    r.w( 0 ) = cast( ulong, v and &hFFFFFFFFull )
    r.w( 1 ) = cast( ulong, ( v shr 32 ) and &hFFFFFFFFull )
    function = r
end function

function hDecWIsZero( byref a as DecWide ) as boolean
    for i as long = 0 to 5
        if( a.w( i ) <> 0 ) then return false
    next
    function = true
end function

function hDecWFits96( byref a as DecWide ) as boolean
    if( a.w( 3 ) <> 0 ) then return false
    if( a.w( 4 ) <> 0 ) then return false
    if( a.w( 5 ) <> 0 ) then return false
    function = true
end function

function hDecWCmp( byref a as DecWide, byref b as DecWide ) as long
    for i as long = 5 to 0 step -1
        if( a.w( i ) > b.w( i ) ) then return 1
        if( a.w( i ) < b.w( i ) ) then return -1
    next
    function = 0
end function

'' a + b, modulo 2^192.  Every caller has already bounded the operands.
function hDecWAdd( byref a as DecWide, byref b as DecWide ) as DecWide
    dim as DecWide r
    dim as ulongint carry = 0
    for i as long = 0 to 5
        dim as ulongint cur = culngint( a.w( i ) ) + culngint( b.w( i ) ) + carry
        r.w( i ) = cast( ulong, cur and &hFFFFFFFFull )
        carry = cur shr 32
    next
    function = r
end function

'' a - b, requires a >= b.
function hDecWSub( byref a as DecWide, byref b as DecWide ) as DecWide
    dim as DecWide r
    dim as ulongint borrow = 0
    for i as long = 0 to 5
        dim as ulongint cur = culngint( a.w( i ) ) - culngint( b.w( i ) ) - borrow
        r.w( i ) = cast( ulong, cur and &hFFFFFFFFull )
        if( ( cur shr 32 ) <> 0 ) then borrow = 1 else borrow = 0
    next
    function = r
end function

function hDecWAddSmall( byref a as DecWide, byval v as ulong ) as DecWide
    dim as DecWide r = a
    dim as ulongint carry = culngint( v )
    dim as long i = 0
    while( carry <> 0 )
        if( i > 5 ) then exit while
        dim as ulongint cur = culngint( r.w( i ) ) + carry
        r.w( i ) = cast( ulong, cur and &hFFFFFFFFull )
        carry = cur shr 32
        i += 1
    wend
    function = r
end function

'' out = a * m.  Returns FALSE if the product does not fit 192 bits.
function hDecWMulSmall( byref a as DecWide, byval m as ulong, byref outv as DecWide ) as boolean
    dim as DecWide r
    dim as ulongint carry = 0
    for i as long = 0 to 5
        dim as ulongint cur = culngint( a.w( i ) ) * culngint( m ) + carry
        r.w( i ) = cast( ulong, cur and &hFFFFFFFFull )
        carry = cur shr 32
    next
    outv = r
    function = ( carry = 0 )
end function

function hDecWDivSmall( byref a as DecWide, byval d as ulong, byref rem_ as ulong ) as DecWide
    dim as DecWide q
    dim as ulongint r = 0
    for i as long = 5 to 0 step -1
        dim as ulongint cur = ( r shl 32 ) or culngint( a.w( i ) )
        q.w( i ) = cast( ulong, cur \ culngint( d ) )
        r = cur mod culngint( d )
    next
    rem_ = cast( ulong, r )
    function = q
end function

'' 96 x 96 -> 192.  Only limbs 0..2 of each operand are read.
function hDecWMul96( byref a as DecWide, byref b as DecWide ) as DecWide
    dim as DecWide r
    for i as long = 0 to 2
        dim as ulongint carry = 0
        for j as long = 0 to 2
            dim as ulongint cur = culngint( r.w( i + j ) ) + culngint( a.w( i ) ) * culngint( b.w( j ) ) + carry
            r.w( i + j ) = cast( ulong, cur and &hFFFFFFFFull )
            carry = cur shr 32
        next
        dim as long k = i + 3
        while( k <= 5 )
            if( carry = 0 ) then exit while
            dim as ulongint cur = culngint( r.w( k ) ) + carry
            r.w( k ) = cast( ulong, cur and &hFFFFFFFFull )
            carry = cur shr 32
            k += 1
        wend
    next
    function = r
end function

function hDecWShl1( byref a as DecWide ) as DecWide
    dim as DecWide r
    dim as ulong carry = 0
    for i as long = 0 to 5
        dim as ulong nxt = ( a.w( i ) shr 31 ) and 1
        r.w( i ) = ( a.w( i ) shl 1 ) or carry
        carry = nxt
    next
    function = r
end function

'' Binary long division, 192 bits.  Slow and obviously correct; the fast path
'' that matters -- extending the quotient one decimal digit at a time -- is
'' repeated subtraction below, which runs at most nine times per digit.
sub hDecWDivMod( byref n as DecWide, byref d as DecWide, byref q as DecWide, byref r as DecWide )
    q = hDecWZero( )
    r = hDecWZero( )
    for i as long = 191 to 0 step -1
        r = hDecWShl1( r )
        dim as long limb = i \ 32
        dim as long bit_ = i mod 32
        if( ( ( n.w( limb ) shr bit_ ) and 1 ) <> 0 ) then r.w( 0 ) or= 1
        if( hDecWCmp( r, d ) >= 0 ) then
            r = hDecWSub( r, d )
            q.w( limb ) or= ( culng( 1 ) shl bit_ )
        end if
    next
end sub

'' ===========================================================================
'' Packing -- the one place a result is rounded
''
'' Every arithmetic operator produces a 192-bit magnitude and a scale that may
'' be out of range in either direction, and hands both to this function.  It
'' scales UP when the scale is negative, reduces while the mantissa will not
'' fit 96 bits or the scale exceeds 28, and rounds HALF-TO-EVEN exactly once
'' using the last digit removed plus a sticky bit for everything before it.
'' ===========================================================================

function hDecMake( byref m as DecWide, byval scale as long, byval neg as boolean ) as Decimal
    dim as Decimal d
    d.lo_ = m.w( 0 )
    d.mid_ = m.w( 1 )
    d.hi_ = m.w( 2 )
    d.scale_ = cast( ubyte, scale )
    if( neg ) then
        if( hDecWIsZero( m ) = false ) then d.sign_ = DECIMAL_SIGN_BIT
    end if
    function = d
end function

function hDecPack( byref mag as DecWide, byval scale as long, byval neg as boolean ) as Decimal
    dim as DecWide m = mag
    dim as long s = scale
    dim as long lastr = 0
    dim as boolean sticky = false

    '' a negative scale means the value is an integer multiple of a power of
    '' ten; grow the mantissa rather than pretend the scale can go below zero
    while( s < 0 )
        if( hDecWMulSmall( m, 10, m ) = false ) then return DecimalInvalid( )
        if( hDecWFits96( m ) = false ) then return DecimalInvalid( )
        s += 1
    wend

    do
        dim as boolean toowide = ( hDecWFits96( m ) = false )
        dim as boolean toodeep = ( s > DECIMAL_MAX_SCALE )
        if( ( toowide orelse toodeep ) = false ) then exit do
        if( s <= 0 ) then return DecimalInvalid( )
        if( lastr <> 0 ) then sticky = true
        dim as ulong r
        m = hDecWDivSmall( m, 10, r )
        lastr = clng( r )
        s -= 1
    loop

    '' half-to-even on the discarded tail
    dim as boolean roundup = false
    if( lastr > 5 ) then
        roundup = true
    elseif( lastr = 5 ) then
        dim as boolean odd_ = ( ( m.w( 0 ) and 1 ) <> 0 )
        roundup = ( sticky orelse odd_ )
    end if

    if( roundup ) then
        m = hDecWAddSmall( m, 1 )
        if( hDecWFits96( m ) = false ) then
            if( s <= 0 ) then return DecimalInvalid( )
            dim as ulong r
            m = hDecWDivSmall( m, 10, r )
            s -= 1
        end if
    end if

    function = hDecMake( m, s, neg )
end function

'' ===========================================================================
'' Predicates and accessors
'' ===========================================================================

function hDecIsInv( byref d as Decimal ) as boolean
    function = ( d.scale_ = DECIMAL_INVALID_SCALE )
end function

function hDecMag( byref d as Decimal ) as DecWide
    function = hDecWFrom96( d.lo_, d.mid_, d.hi_ )
end function

function hDecNeg( byref d as Decimal ) as boolean
    function = ( ( d.sign_ and DECIMAL_SIGN_BIT ) <> 0 )
end function

function Decimal.IsValid( ) as boolean
    function = ( this.scale_ <> DECIMAL_INVALID_SCALE )
end function

function Decimal.IsZero( ) as boolean
    if( this.scale_ = DECIMAL_INVALID_SCALE ) then return false
    function = ( this.lo_ = 0 andalso this.mid_ = 0 andalso this.hi_ = 0 )
end function

function Decimal.IsNegative( ) as boolean
    if( this.scale_ = DECIMAL_INVALID_SCALE ) then return false
    function = ( ( this.sign_ and DECIMAL_SIGN_BIT ) <> 0 )
end function

function Decimal.Sign( ) as long
    if( this.scale_ = DECIMAL_INVALID_SCALE ) then return 0
    if( this.lo_ = 0 andalso this.mid_ = 0 andalso this.hi_ = 0 ) then return 0
    if( ( this.sign_ and DECIMAL_SIGN_BIT ) <> 0 ) then return -1
    function = 1
end function

'' The number of digits to the right of the point, 0..28.  -1 for Invalid.
function Decimal.Scale( ) as long
    if( this.scale_ = DECIMAL_INVALID_SCALE ) then return -1
    function = clng( this.scale_ )
end function

function Decimal.Lo( ) as ulong
    function = this.lo_
end function

function Decimal.Mid( ) as ulong
    function = this.mid_
end function

function Decimal.Hi( ) as ulong
    function = this.hi_
end function

'' ===========================================================================
'' Construction
''
'' FREE FUNCTIONS, NOT CONSTRUCTORS, for the reason fb/currency.bi gives: a
'' one-argument constructor taking LONGINT would also accept a DOUBLE through
'' FreeBASIC's implicit conversion, so 'Decimal( 19.99 )' would compile and
'' silently store 19.  Naming every conversion means the inexact one cannot be
'' reached by accident.
'' ===========================================================================

'' INVALID is scale 255 -- a scale no value can have, so the bit pattern is
'' already unusable as a number.  It is INFECTIOUS: any operation with an
'' Invalid operand is Invalid.
''
'' Why a sentinel rather than Result: an operator cannot return
'' Result( of Decimal, E ) and still compose -- 'a * b + c' would need an
'' unwrap between every pair.  fb/chrono.bi and fb/currency.bi reached the same
'' conclusion, and matching them means one rule to learn rather than three.
'' As there, INVALID = INVALID IS FALSE; test IsValid.
public function DecimalInvalid overload ( ) as Decimal
    dim as Decimal d
    d.scale_ = DECIMAL_INVALID_SCALE
    function = d
end function

public function DecimalZero overload ( ) as Decimal
    dim as Decimal d
    function = d
end function

public function DecimalOne overload ( ) as Decimal
    dim as Decimal d
    d.lo_ = 1
    function = d
end function

public function DecimalMinusOne overload ( ) as Decimal
    dim as Decimal d
    d.lo_ = 1
    d.sign_ = DECIMAL_SIGN_BIT
    function = d
end function

public function DecimalMaxValue overload ( ) as Decimal
    dim as Decimal d
    d.lo_ = &hFFFFFFFFul
    d.mid_ = &hFFFFFFFFul
    d.hi_ = &hFFFFFFFFul
    function = d
end function

public function DecimalMinValue overload ( ) as Decimal
    dim as Decimal d = DecimalMaxValue( )
    d.sign_ = DECIMAL_SIGN_BIT
    function = d
end function

'' The .NET constructor, limb for limb: value = ( lo, mid, hi ) / 10^scale.
public function DecimalFromParts overload ( byval lo32 as ulong, byval mid32 as ulong, byval hi32 as ulong, byval neg as boolean, byval scale as long ) as Decimal
    if( scale < 0 orelse scale > DECIMAL_MAX_SCALE ) then return DecimalInvalid( )
    dim as DecWide m = hDecWFrom96( lo32, mid32, hi32 )
    function = hDecMake( m, scale, neg )
end function

public function DecimalFromInt overload ( byval v as longint ) as Decimal
    dim as ulongint mag
    dim as boolean neg = ( v < 0 )
    if( neg ) then
        mag = culngint( -( v + 1 ) ) + 1ull        '' correct at MIN_VALUE_LONGINT
    else
        mag = culngint( v )
    end if
    dim as DecWide m = hDecWFromU64( mag )
    function = hDecMake( m, 0, neg )
end function

public function DecimalFromUInt overload ( byval v as ulongint ) as Decimal
    dim as DecWide m = hDecWFromU64( v )
    function = hDecMake( m, 0, false )
end function

'' value = mantissa / 10^scale, exactly.  DecimalFromScaled( 1999, 2 ) is 19.99
public function DecimalFromScaled overload ( byval mantissa as longint, byval scale as long ) as Decimal
    if( scale < 0 orelse scale > DECIMAL_MAX_SCALE ) then return DecimalInvalid( )
    dim as Decimal d = DecimalFromInt( mantissa )
    d.scale_ = cast( ubyte, scale )
    function = d
end function

public function DecimalFromCurrency overload ( byref c as Currency ) as Decimal
    if( c.IsValid( ) = false ) then return DecimalInvalid( )
    function = DecimalFromScaled( c.Raw( ), 4 )
end function

'' ===========================================================================
'' Text -- exact both ways, no DOUBLE anywhere in the path
'' ===========================================================================

'' The decimal digits of a 96-bit magnitude, no sign, no point, no leading
'' zero except for the value zero itself.
function hDecDigits( byref mag as DecWide ) as string
    if( hDecWIsZero( mag ) ) then return "0"
    dim as string s = ""
    dim as DecWide m = mag
    while( hDecWIsZero( m ) = false )
        dim as ulong r
        m = hDecWDivSmall( m, 10, r )
        s = chr( asc( "0" ) + clng( r ) ) + s
    wend
    function = s
end function

'' Invariant: '.' separator, no grouping, EXACTLY 'scale' decimals -- the
'' trailing zeros are part of the value and are printed.  Locale and
'' currency-symbol formatting are the caller's business.
function Decimal.ToString( ) as string
    if( this.scale_ = DECIMAL_INVALID_SCALE ) then return "Invalid"
    dim as DecWide mag = hDecWFrom96( this.lo_, this.mid_, this.hi_ )
    dim as string ds = hDecDigits( mag )
    dim as long s = clng( this.scale_ )

    dim as string body
    if( s = 0 ) then
        body = ds
    else
        while( len( ds ) <= s )
            ds = "0" + ds
        wend
        body = left( ds, len( ds ) - s ) + "." + right( ds, s )
    end if

    '' zero never prints a sign, matching .NET
    if( hDecWIsZero( mag ) ) then return body
    if( ( this.sign_ and DECIMAL_SIGN_BIT ) <> 0 ) then return "-" + body
    function = body
end function

'' ===========================================================================
'' Rescaling and rounding
'' ===========================================================================

'' Reduce 'm' from scale 'froms' to scale 'tos' under 'mode'.  froms >= tos.
function hDecReduce( byref m as DecWide, byval froms as long, byval tos as long, byval neg as boolean, byval mode as long ) as DecWide
    dim as DecWide q = m
    dim as long lastr = 0
    dim as boolean sticky = false

    for k as long = 1 to ( froms - tos )
        if( lastr <> 0 ) then sticky = true
        dim as ulong r
        q = hDecWDivSmall( q, 10, r )
        lastr = clng( r )
    next

    dim as long cmp                                    '' -1 below half, 0 half, +1 above
    if( lastr > 5 ) then
        cmp = 1
    elseif( lastr < 5 ) then
        cmp = -1
    else
        if( sticky ) then cmp = 1 else cmp = 0
    end if

    dim as boolean exact = ( lastr = 0 andalso sticky = false )
    if( exact ) then return q

    dim as boolean away
    select case mode
    case DEC_HALF_EVEN
        if( cmp > 0 ) then
            away = true
        elseif( cmp < 0 ) then
            away = false
        else
            away = ( ( q.w( 0 ) and 1 ) <> 0 )
        end if
    case DEC_HALF_UP
        away = ( cmp >= 0 )
    case DEC_HALF_DOWN
        away = ( cmp > 0 )
    case DEC_UP
        away = true
    case DEC_DOWN
        away = false
    case DEC_CEILING
        away = ( neg = false )
    case DEC_FLOOR
        away = neg
    case else
        away = ( cmp > 0 )
    end select

    if( away ) then q = hDecWAddSmall( q, 1 )
    function = q
end function

'' Round to at most 'digits' decimals.  NEVER INCREASES THE SCALE: rounding
'' 1.5 to four places is still 1.5, exactly as .NET's decimal.Round does.  Use
'' Rescale to force a scale.
function Decimal.RoundMode( byval digits as long, byval mode as long ) as Decimal
    if( this.scale_ = DECIMAL_INVALID_SCALE ) then return DecimalInvalid( )
    if( digits < 0 orelse digits > DECIMAL_MAX_SCALE ) then return DecimalInvalid( )
    dim as long s = clng( this.scale_ )
    if( digits >= s ) then return this
    dim as DecWide m = hDecWFrom96( this.lo_, this.mid_, this.hi_ )
    dim as boolean neg = ( ( this.sign_ and DECIMAL_SIGN_BIT ) <> 0 )
    dim as DecWide q = hDecReduce( m, s, digits, neg, mode )
    function = hDecPack( q, digits, neg )
end function

function Decimal.Round( byval digits as long ) as Decimal
    function = this.RoundMode( digits, DEC_HALF_EVEN )
end function

'' Force the scale to exactly 'digits', growing it with zeros or reducing it
'' half-to-even.  Invalid if growing would overflow 96 bits.
function Decimal.Rescale( byval digits as long ) as Decimal
    if( this.scale_ = DECIMAL_INVALID_SCALE ) then return DecimalInvalid( )
    if( digits < 0 orelse digits > DECIMAL_MAX_SCALE ) then return DecimalInvalid( )
    dim as long s = clng( this.scale_ )
    dim as boolean neg = ( ( this.sign_ and DECIMAL_SIGN_BIT ) <> 0 )
    dim as DecWide m = hDecWFrom96( this.lo_, this.mid_, this.hi_ )
    if( digits = s ) then return this
    if( digits > s ) then
        for k as long = 1 to ( digits - s )
            if( hDecWMulSmall( m, 10, m ) = false ) then return DecimalInvalid( )
            if( hDecWFits96( m ) = false ) then return DecimalInvalid( )
        next
        return hDecMake( m, digits, neg )
    end if
    dim as DecWide q = hDecReduce( m, s, digits, neg, DEC_HALF_EVEN )
    function = hDecPack( q, digits, neg )
end function

function Decimal.ToStringFixed( byval digits as long ) as string
    function = this.Rescale( digits ).ToString( )
end function

'' Strip trailing zeros: 1.2300 becomes 1.23, and both compare equal.
function Decimal.Normalize( ) as Decimal
    if( this.scale_ = DECIMAL_INVALID_SCALE ) then return DecimalInvalid( )
    dim as DecWide m = hDecWFrom96( this.lo_, this.mid_, this.hi_ )
    dim as long s = clng( this.scale_ )
    dim as boolean neg = ( ( this.sign_ and DECIMAL_SIGN_BIT ) <> 0 )
    if( hDecWIsZero( m ) ) then return hDecMake( m, 0, false )
    while( s > 0 )
        dim as ulong r
        dim as DecWide q = hDecWDivSmall( m, 10, r )
        if( r <> 0 ) then exit while
        m = q
        s -= 1
    wend
    function = hDecMake( m, s, neg )
end function

function Decimal.Floor( ) as Decimal
    function = this.RoundMode( 0, DEC_FLOOR )
end function

function Decimal.Ceiling( ) as Decimal
    function = this.RoundMode( 0, DEC_CEILING )
end function

function Decimal.Truncate( ) as Decimal
    function = this.RoundMode( 0, DEC_DOWN )
end function

function Decimal.AbsValue( ) as Decimal
    if( this.scale_ = DECIMAL_INVALID_SCALE ) then return DecimalInvalid( )
    dim as Decimal d = this
    d.sign_ = 0
    function = d
end function

'' ===========================================================================
'' Conversion out
'' ===========================================================================

'' BOUNDED, not exact: a DOUBLE has 53 bits of significand and this type has
'' 96.  Powers of ten above 10^22 are not exactly representable either, so a
'' large scale costs a second rounding.  Named, never implicit.
function Decimal.ToDouble( ) as double
    if( this.scale_ = DECIMAL_INVALID_SCALE ) then return 0.0 / 0.0
    dim as double two32 = 4294967296.0
    dim as double v = cdbl( this.hi_ ) * two32 * two32 + cdbl( this.mid_ ) * two32 + cdbl( this.lo_ )
    dim as long s = clng( this.scale_ )
    dim as double p = 1.0
    dim as long k = s
    if( k > 22 ) then
        for i as long = 1 to ( k - 22 )
            v /= 10.0
        next
        k = 22
    end if
    for i as long = 1 to k
        p *= 10.0
    next
    v /= p
    if( ( this.sign_ and DECIMAL_SIGN_BIT ) <> 0 ) then v = -v
    function = v
end function

'' Exact when the value has at most four decimals and fits Currency's range;
'' otherwise rounds half-to-even to four decimals, and Invalid when the
'' magnitude will not fit.
function Decimal.ToCurrency( ) as Currency
    if( this.scale_ = DECIMAL_INVALID_SCALE ) then return CurrencyInvalid( )
    dim as Decimal r = this.Rescale( 4 )
    if( r.IsValid( ) = false ) then return CurrencyInvalid( )
    if( r.hi_ <> 0 ) then return CurrencyInvalid( )
    dim as ulongint mag = ( culngint( r.mid_ ) shl 32 ) or culngint( r.lo_ )
    if( mag > 9223372036854775807ull ) then return CurrencyInvalid( )
    dim as longint raw = clngint( mag )
    if( ( r.sign_ and DECIMAL_SIGN_BIT ) <> 0 ) then raw = -raw
    if( raw = MIN_VALUE_LONGINT ) then return CurrencyInvalid( )
    function = CurrencyFromRaw( raw )
end function

'' Truncates toward zero.  None when Invalid or when the integer part will not
'' fit a LONGINT -- silently returning a wrong number is how a conversion
'' loses money.
function Decimal.ToLongInt( ) as Optional( of longint )
    if( this.scale_ = DECIMAL_INVALID_SCALE ) then return None( of longint )( )
    dim as Decimal t = this.Truncate( )
    if( t.IsValid( ) = false ) then return None( of longint )( )
    if( t.hi_ <> 0 ) then return None( of longint )( )
    dim as ulongint mag = ( culngint( t.mid_ ) shl 32 ) or culngint( t.lo_ )
    dim as boolean neg = ( ( t.sign_ and DECIMAL_SIGN_BIT ) <> 0 )
    if( neg ) then
        if( mag > 9223372036854775808ull ) then return None( of longint )( )
        if( mag = 9223372036854775808ull ) then return Some( cast( longint, MIN_VALUE_LONGINT ) )
        return Some( cast( longint, -clngint( mag ) ) )
    end if
    if( mag > 9223372036854775807ull ) then return None( of longint )( )
    function = Some( cast( longint, clngint( mag ) ) )
end function

'' ===========================================================================
'' Comparison
''
'' THE SCALE IS NOT PART OF THE COMPARISON: 1.10 = 1.1 is TRUE, exactly as in
'' .NET.  Scale is observable through Scale( ) and through ToString( ), and
'' nowhere else.
'' ===========================================================================

function hDecAlign( byref d as Decimal, byval tos as long, byref outv as DecWide ) as boolean
    dim as DecWide m = hDecWFrom96( d.lo_, d.mid_, d.hi_ )
    for k as long = 1 to ( tos - clng( d.scale_ ) )
        if( hDecWMulSmall( m, 10, m ) = false ) then return false
    next
    outv = m
    function = true
end function

'' -1, 0, +1.  Both operands must be valid; callers check first.
function hDecCmpValues( byref a as Decimal, byref b as Decimal ) as long
    dim as long sa = a.Sign( )
    dim as long sb = b.Sign( )
    if( sa < sb ) then return -1
    if( sa > sb ) then return 1
    if( sa = 0 ) then return 0

    dim as long t = clng( a.scale_ )
    if( clng( b.scale_ ) > t ) then t = clng( b.scale_ )

    dim as DecWide wa, wb
    '' 96 bits scaled by at most 10^28 is 190 bits, so alignment always fits
    hDecAlign( a, t, wa )
    hDecAlign( b, t, wb )

    dim as long c = hDecWCmp( wa, wb )
    if( sa < 0 ) then c = -c
    function = c
end function

'' -2 when either operand is Invalid -- a value no ordering uses, so a caller
'' that forgets to check cannot mistake it for 'less than'.
public function DecimalCompare overload ( byref a as Decimal, byref b as Decimal ) as long
    if( hDecIsInv( a ) orelse hDecIsInv( b ) ) then return -2
    function = hDecCmpValues( a, b )
end function

'' INVALID = INVALID IS FALSE, exactly as Currency's and DateTime's are, and
'' every ordering comparison against an Invalid is FALSE as well.  Test with
'' IsValid.
public operator = ( byref a as Decimal, byref b as Decimal ) as boolean
    if( hDecIsInv( a ) orelse hDecIsInv( b ) ) then return false
    operator = ( hDecCmpValues( a, b ) = 0 )
end operator

public operator <> ( byref a as Decimal, byref b as Decimal ) as boolean
    if( hDecIsInv( a ) orelse hDecIsInv( b ) ) then return true
    operator = ( hDecCmpValues( a, b ) <> 0 )
end operator

public operator < ( byref a as Decimal, byref b as Decimal ) as boolean
    if( hDecIsInv( a ) orelse hDecIsInv( b ) ) then return false
    operator = ( hDecCmpValues( a, b ) < 0 )
end operator

public operator <= ( byref a as Decimal, byref b as Decimal ) as boolean
    if( hDecIsInv( a ) orelse hDecIsInv( b ) ) then return false
    operator = ( hDecCmpValues( a, b ) <= 0 )
end operator

public operator > ( byref a as Decimal, byref b as Decimal ) as boolean
    if( hDecIsInv( a ) orelse hDecIsInv( b ) ) then return false
    operator = ( hDecCmpValues( a, b ) > 0 )
end operator

public operator >= ( byref a as Decimal, byref b as Decimal ) as boolean
    if( hDecIsInv( a ) orelse hDecIsInv( b ) ) then return false
    operator = ( hDecCmpValues( a, b ) >= 0 )
end operator

'' ===========================================================================
'' Arithmetic
''
''   a + b, a - b        EXACT unless the result needs more than 96 bits of
''                       mantissa, in which case the scale is reduced and the
''                       result rounded half-to-even.  Scale = max( sa, sb ).
''   -a                  EXACT
''   a * b               EXACT at scale sa + sb, reduced the same way.
''   a / b               the terminating quotient when there is one, otherwise
''                       28 digits, rounded half-to-even.
''   a MOD b             EXACT; sign follows the dividend, as in .NET.
''
'' UNLIKE fb/currency.bi, 'Decimal * Decimal' AND 'Decimal / Decimal' EXIST and
'' both yield a Decimal.  Currency is an AMOUNT and money times money has the
'' wrong units; Decimal is a NUMBER that happens to be decimal, which is what
'' .NET's type is, and rates, factors and ratios are its ordinary business.
''
'' MEASURED AGAINST .NET over 24,000 random operand pairs across the whole
'' range and every scale: 23,283 results are IDENTICAL, digit for digit and
'' scale for scale.  The 717 that differ are two classes, both of them places
'' where THIS IMPLEMENTATION IS THE CORRECT ONE and the divergence is
'' deliberate:
''
''   657  MOD where aligning the operands would need more than 96 bits.  .NET
''        either rounds the operands first or throws OverflowException; every
''        intermediate here is 192 bits, so the exact remainder comes out.
''        Checked against arbitrary-precision arithmetic: OURS IS EXACT IN ALL
''        657, .NET IN 2.
''
''    60  MULTIPLICATION THAT UNDERFLOWS TO ZERO, e.g. 1e-22 * 1e-24.  Both
''        answers are zero; .NET reports it at scale 0 and this reports it at
''        scale 28, which says 'smaller than the smallest unit' rather than
''        'exactly nothing'.  Cosmetic -- the values compare equal.
'' ===========================================================================

public operator - ( byref a as Decimal ) as Decimal
    if( hDecIsInv( a ) ) then return DecimalInvalid( )
    dim as Decimal d = a
    if( d.lo_ = 0 andalso d.mid_ = 0 andalso d.hi_ = 0 ) then
        d.sign_ = 0
    elseif( ( d.sign_ and DECIMAL_SIGN_BIT ) <> 0 ) then
        d.sign_ = 0
    else
        d.sign_ = DECIMAL_SIGN_BIT
    end if
    operator = d
end operator

function hDecAddSigned( byref a as Decimal, byref b as Decimal, byval subtract as boolean ) as Decimal
    if( hDecIsInv( a ) orelse hDecIsInv( b ) ) then return DecimalInvalid( )

    dim as long t = clng( a.scale_ )
    if( clng( b.scale_ ) > t ) then t = clng( b.scale_ )

    dim as DecWide wa, wb
    hDecAlign( a, t, wa )
    hDecAlign( b, t, wb )

    dim as boolean na = hDecNeg( a )
    dim as boolean nb = hDecNeg( b )
    if( subtract ) then nb = ( nb = false )

    dim as DecWide r
    dim as boolean neg
    if( na = nb ) then
        r = hDecWAdd( wa, wb )
        neg = na
    else
        dim as long c = hDecWCmp( wa, wb )
        if( c >= 0 ) then
            r = hDecWSub( wa, wb )
            neg = na
        else
            r = hDecWSub( wb, wa )
            neg = nb
        end if
    end if

    function = hDecPack( r, t, neg )
end function

public operator + ( byref a as Decimal, byref b as Decimal ) as Decimal
    operator = hDecAddSigned( a, b, false )
end operator

public operator - ( byref a as Decimal, byref b as Decimal ) as Decimal
    operator = hDecAddSigned( a, b, true )
end operator

public operator * ( byref a as Decimal, byref b as Decimal ) as Decimal
    if( hDecIsInv( a ) orelse hDecIsInv( b ) ) then return DecimalInvalid( )
    dim as DecWide wa = hDecMag( a )
    dim as DecWide wb = hDecMag( b )
    dim as DecWide p = hDecWMul96( wa, wb )
    dim as long s = clng( a.scale_ ) + clng( b.scale_ )
    dim as boolean neg = ( hDecNeg( a ) <> hDecNeg( b ) )
    operator = hDecPack( p, s, neg )
end operator

'' The quotient is computed to the scale the division actually needs -- the
'' terminating expansion when there is one, and 28 digits when there is not --
'' matching .NET exactly.  100.00 / 4 is 25.00, 1 / 4 is 0.25, and 1 / 3 is
'' 0.3333333333333333333333333333.
public operator / ( byref a as Decimal, byref b as Decimal ) as Decimal
    if( hDecIsInv( a ) orelse hDecIsInv( b ) ) then return DecimalInvalid( )
    if( b.IsZero( ) ) then return DecimalInvalid( )

    dim as DecWide num = hDecMag( a )
    dim as DecWide den = hDecMag( b )
    dim as long s = clng( a.scale_ ) - clng( b.scale_ )
    dim as boolean neg = ( hDecNeg( a ) <> hDecNeg( b ) )

    '' a negative scale has to be absorbed into the dividend before dividing
    while( s < 0 )
        if( hDecWMulSmall( num, 10, num ) = false ) then return DecimalInvalid( )
        s += 1
    wend

    dim as DecWide q, r
    hDecWDivMod( num, den, q, r )

    '' extend one decimal digit at a time while the quotient still fits
    while( hDecWIsZero( r ) = false )
        if( s >= DECIMAL_MAX_SCALE ) then exit while
        if( hDecWFits96( q ) = false ) then exit while

        dim as DecWide t
        if( hDecWMulSmall( r, 10, t ) = false ) then exit while
        dim as ulong digit = 0
        while( hDecWCmp( t, den ) >= 0 )
            t = hDecWSub( t, den )
            digit += 1
        wend

        dim as DecWide nq
        if( hDecWMulSmall( q, 10, nq ) = false ) then exit while
        nq = hDecWAddSmall( nq, digit )
        if( hDecWFits96( nq ) = false ) then exit while

        q = nq
        r = t
        s += 1
    wend

    '' round the truncated tail half-to-even against the divisor
    if( hDecWIsZero( r ) = false ) then
        dim as DecWide twice
        dim as long cmp = 1
        if( hDecWMulSmall( r, 2, twice ) ) then cmp = hDecWCmp( twice, den )
        dim as boolean away
        if( cmp > 0 ) then
            away = true
        elseif( cmp < 0 ) then
            away = false
        else
            away = ( ( q.w( 0 ) and 1 ) <> 0 )
        end if
        if( away ) then q = hDecWAddSmall( q, 1 )

        '' The tail was cut off at the width limit rather than because the
        '' division ended, so any trailing zero is an artefact of where the cut
        '' fell and not a digit the quotient earned.  .NET strips them here too;
        '' 9.5 / 0.091 is 104.3956043956043956043956044, not ...04400.
        while( s > 0 )
            dim as ulong z
            dim as DecWide t2 = hDecWDivSmall( q, 10, z )
            if( z <> 0 ) then exit while
            q = t2
            s -= 1
        wend
    end if

    operator = hDecPack( q, s, neg )
end operator

'' The remainder takes the SIGN OF THE DIVIDEND and the scale of the wider
'' operand, as in .NET: -7.5 MOD 2 is -1.5.
public operator mod ( byref a as Decimal, byref b as Decimal ) as Decimal
    if( hDecIsInv( a ) orelse hDecIsInv( b ) ) then return DecimalInvalid( )
    if( b.IsZero( ) ) then return DecimalInvalid( )

    '' |a| < |b| means the remainder IS a, scale and all -- and saying so here
    '' keeps the scale the caller wrote rather than promoting it to the
    '' divisor's.  .NET takes the same short cut.
    dim as Decimal aa = a.AbsValue( )
    dim as Decimal ab = b.AbsValue( )
    if( hDecCmpValues( aa, ab ) < 0 ) then return a

    dim as long t = clng( a.scale_ )
    if( clng( b.scale_ ) > t ) then t = clng( b.scale_ )

    dim as DecWide wa, wb
    hDecAlign( a, t, wa )
    hDecAlign( b, t, wb )

    dim as DecWide q, r
    hDecWDivMod( wa, wb, q, r )
    operator = hDecPack( r, t, hDecNeg( a ) )
end operator

'' ---------------------------------------------------------------------------
'' Mixed Decimal / LONGINT arithmetic.  Integers are exact in this type, so
'' these are conveniences rather than conversions, and they exist so that
'' 'price * 3' does not need a spelled-out DecimalFromInt at every call site.
'' There is deliberately NO Decimal-and-DOUBLE operator: a DOUBLE is inexact,
'' and DecimalFromDouble has to be written out so that it can be seen.
'' ---------------------------------------------------------------------------

public operator + ( byref a as Decimal, byval n as longint ) as Decimal
    operator = a + DecimalFromInt( n )
end operator

public operator + ( byval n as longint, byref a as Decimal ) as Decimal
    operator = DecimalFromInt( n ) + a
end operator

public operator - ( byref a as Decimal, byval n as longint ) as Decimal
    operator = a - DecimalFromInt( n )
end operator

public operator - ( byval n as longint, byref a as Decimal ) as Decimal
    operator = DecimalFromInt( n ) - a
end operator

public operator * ( byref a as Decimal, byval n as longint ) as Decimal
    operator = a * DecimalFromInt( n )
end operator

public operator * ( byval n as longint, byref a as Decimal ) as Decimal
    operator = DecimalFromInt( n ) * a
end operator

public operator / ( byref a as Decimal, byval n as longint ) as Decimal
    operator = a / DecimalFromInt( n )
end operator

public operator / ( byval n as longint, byref a as Decimal ) as Decimal
    operator = DecimalFromInt( n ) / a
end operator

'' ===========================================================================
'' Parsing
''
'' STRICT, like CurrencyParse and RFC-0004's TryParse family: the whole string
'' must be consumed, and MORE THAN 28 DECIMAL PLACES IS AN ERROR RATHER THAN A
'' TRUNCATION.  Silently discarding a digit the caller wrote is how a decimal
'' type loses money.  There is no exponent syntax -- 'DecimalFromScaled' says
'' the same thing without a second grammar.
'' ===========================================================================

public function DecimalParse overload ( byref s as string ) as Optional( of Decimal )
    dim as long n = len( s )
    if( n = 0 ) then return None( of Decimal )( )

    dim as long i = 1
    dim as boolean neg = false
    dim as long ch = asc( mid( s, 1, 1 ) )
    if( ch = asc( "-" ) ) then
        neg = true
        i = 2
    elseif( ch = asc( "+" ) ) then
        i = 2
    end if
    if( i > n ) then return None( of Decimal )( )

    dim as DecWide mag = hDecWZero( )
    dim as long idigits = 0
    while( i <= n )
        dim as long c = asc( mid( s, i, 1 ) )
        if( c < asc( "0" ) ) then exit while
        if( c > asc( "9" ) ) then exit while
        if( hDecWMulSmall( mag, 10, mag ) = false ) then return None( of Decimal )( )
        mag = hDecWAddSmall( mag, culng( c - asc( "0" ) ) )
        if( hDecWFits96( mag ) = false ) then return None( of Decimal )( )
        idigits += 1
        i += 1
    wend
    if( idigits = 0 ) then return None( of Decimal )( )

    dim as long fdigits = 0
    if( i <= n andalso asc( mid( s, i, 1 ) ) = asc( "." ) ) then
        i += 1
        while( i <= n )
            dim as long c = asc( mid( s, i, 1 ) )
            if( c < asc( "0" ) ) then exit while
            if( c > asc( "9" ) ) then exit while
            fdigits += 1
            if( fdigits > DECIMAL_MAX_SCALE ) then return None( of Decimal )( )
            if( hDecWMulSmall( mag, 10, mag ) = false ) then return None( of Decimal )( )
            mag = hDecWAddSmall( mag, culng( c - asc( "0" ) ) )
            if( hDecWFits96( mag ) = false ) then return None( of Decimal )( )
            i += 1
        wend
        if( fdigits = 0 ) then return None( of Decimal )( )     '' "1." is not a number
    end if

    if( i <= n ) then return None( of Decimal )( )              '' strict: consume it all

    function = Some( hDecMake( mag, fdigits, neg ) )
end function

'' ===========================================================================
'' From DOUBLE -- NAMED, because it is not exact
''
'' The DOUBLE 0.1 is not one tenth, and printing all 17 of its digits would
'' store the error rather than the number.  This takes FIFTEEN SIGNIFICANT
'' DIGITS and strips trailing zeros, which is what .NET's double -> decimal
'' conversion does, so DecimalFromDouble( 0.1 ) is 0.1 and not
'' 0.1000000000000000055511151231257827.
''
'' MEASURED AGAINST .NET over 2,014 doubles spanning 10^-25 .. 10^25: 1,960
'' agree exactly.  The 54 that differ are the ties, where the sixteenth
'' significant digit is a 5, and IN 48 OF THOSE 54 THIS RESULT IS THE CLOSER
'' ONE.  .NET's VarDecFromR8 scales in binary floating point and is not
'' correctly rounded; this takes the C library's correctly-rounded fifteen
'' digits instead, and is deliberately not bug-compatible.
'' ===========================================================================

extern "c"
    declare function hDecSnprintf alias "snprintf" ( byval as zstring ptr, byval as uinteger, byval as zstring ptr, ... ) as long
end extern

public function DecimalFromDouble overload ( byval v as double ) as Decimal
    if( v <> v ) then return DecimalInvalid( )                  '' NaN
    if( v = 0.0 ) then return DecimalZero( )
    dim as double av = v
    if( av < 0.0 ) then av = -av
    if( av > 1.0e30 ) then return DecimalInvalid( )             '' includes +/-Inf

    dim as zstring * 64 buf
    dim as zstring * 8 fmt = "%.14e"
    hDecSnprintf( @buf, 64, @fmt, v )

    dim as string t = buf
    dim as long n = len( t )
    dim as long i = 1
    dim as boolean neg = false
    if( i <= n andalso asc( mid( t, i, 1 ) ) = asc( "-" ) ) then
        neg = true
        i += 1
    end if

    dim as DecWide mag = hDecWZero( )
    dim as long got = 0
    dim as boolean sepseen = false
    while( i <= n )
        dim as long c = asc( mid( t, i, 1 ) )
        if( c = asc( "e" ) orelse c = asc( "E" ) ) then exit while
        if( c < asc( "0" ) orelse c > asc( "9" ) ) then
            '' THE DECIMAL SEPARATOR, WHATEVER LC_NUMERIC MADE IT -- not
            '' necessarily a point.  Under a German LC_NUMERIC snprintf writes
            '' "1,23456e+03", and a hardcoded "." made EVERY finite double come
            '' back Invalid, with no diagnostic anywhere.  "%.14e" emits one
            '' digit, the separator, then the rest, so a byte here that is
            '' neither a digit nor the exponent can only be that separator;
            '' skip the whole run, which also covers the multi-byte ones.
            if( sepseen orelse got = 0 ) then return DecimalInvalid( )
            while( i <= n )
                dim as long d = asc( mid( t, i, 1 ) )
                if( d >= asc( "0" ) andalso d <= asc( "9" ) ) then exit while
                if( d = asc( "e" ) orelse d = asc( "E" ) ) then exit while
                i += 1
            wend
            sepseen = true
            continue while
        end if
        if( hDecWMulSmall( mag, 10, mag ) = false ) then return DecimalInvalid( )
        mag = hDecWAddSmall( mag, culng( c - asc( "0" ) ) )
        got += 1
        i += 1
    wend
    if( got <> 15 ) then return DecimalInvalid( )

    if( i > n ) then return DecimalInvalid( )
    i += 1                                                      '' skip the 'e'
    dim as boolean eneg = false
    if( i <= n ) then
        dim as long c = asc( mid( t, i, 1 ) )
        if( c = asc( "-" ) ) then
            eneg = true
            i += 1
        elseif( c = asc( "+" ) ) then
            i += 1
        end if
    end if
    dim as long ex = 0
    dim as long edig = 0
    while( i <= n )
        dim as long c = asc( mid( t, i, 1 ) )
        if( c < asc( "0" ) ) then exit while
        if( c > asc( "9" ) ) then exit while
        ex = ex * 10 + ( c - asc( "0" ) )
        edig += 1
        i += 1
    wend
    if( edig = 0 ) then return DecimalInvalid( )
    if( eneg ) then ex = -ex

    '' 15 digits with the point after the first means a scale of 14 - exponent
    dim as long s = 14 - ex

    '' strip trailing zeros so that 0.1 stores as 0.1, not 0.100000000000000
    while( s > 0 )
        dim as ulong r
        dim as DecWide q = hDecWDivSmall( mag, 10, r )
        if( r <> 0 ) then exit while
        mag = q
        s -= 1
    wend

    function = hDecPack( mag, s, neg ).Normalize( )
end function

'' ===========================================================================
'' Apportion -- splitting a total so that the parts sum EXACTLY to it
''
'' Splitting 100.00 three ways gives 33.33 each, whose sum is 99.99.  Every
'' accounting system has to decide where the missing cent goes, and doing it ad
'' hoc is how a reconciliation fails.  Largest-remainder: the parts always sum
'' to the total, exactly, at the requested scale.
''
'' This is fb/currency.bi's Apportion with the scale made explicit -- Currency
'' had only one scale to apportion at, and Decimal has twenty-nine.
'' ===========================================================================

public sub DecimalApportion overload ( byval total as Decimal, byval scale as long, weights( ) as longint, result( ) as Decimal )
    dim as long lo = lbound( weights )
    dim as long hi = ubound( weights )
    if( hi < lo ) then exit sub

    redim result( lo to hi )

    dim as Decimal t = total.Rescale( scale )
    if( t.IsValid( ) = false ) then
        for i as long = lo to hi
            result( i ) = DecimalInvalid( )
        next
        exit sub
    end if

    dim as longint sumw = 0
    dim as boolean bad = false
    for i as long = lo to hi
        if( weights( i ) < 0 ) then bad = true
        sumw += weights( i )
    next
    if( bad orelse sumw <= 0 ) then
        for i as long = lo to hi
            result( i ) = DecimalFromScaled( 0, scale )
        next
        exit sub
    end if

    dim as boolean neg = hDecNeg( t )
    dim as DecWide mag = hDecMag( t )
    dim as DecWide den = hDecWFromU64( culngint( sumw ) )

    dim as DecWide assigned = hDecWZero( )
    redim as DecWide parts( lo to hi )
    redim as ulongint rem_( lo to hi )

    for i as long = lo to hi
        dim as DecWide wi = hDecWFromU64( culngint( weights( i ) ) )
        dim as DecWide num = hDecWMul96( mag, wi )
        dim as DecWide q, r
        hDecWDivMod( num, den, q, r )
        parts( i ) = q
        rem_( i ) = ( culngint( r.w( 1 ) ) shl 32 ) or culngint( r.w( 0 ) )
        assigned = hDecWAdd( assigned, q )
    next

    '' hand the leftover units to the largest remainders, one each
    dim as DecWide leftw = hDecWSub( mag, assigned )
    dim as ulongint leftover = ( culngint( leftw.w( 1 ) ) shl 32 ) or culngint( leftw.w( 0 ) )
    while( leftover > 0 )
        dim as long best = lo
        dim as boolean found = false
        for i as long = lo to hi
            if( found = false ) then
                best = i
                found = true
            elseif( rem_( i ) > rem_( best ) ) then
                best = i
            end if
        next
        parts( best ) = hDecWAddSmall( parts( best ), 1 )
        rem_( best ) = 0
        leftover -= 1
        dim as boolean anyleft = false
        for i as long = lo to hi
            if( rem_( i ) > 0 ) then anyleft = true
        next
        if( anyleft = false andalso leftover > 0 ) then
            for i as long = lo to hi
                rem_( i ) = 1
            next
        end if
    wend

    for i as long = lo to hi
        result( i ) = hDecMake( parts( i ), scale, neg )
    next
end sub

