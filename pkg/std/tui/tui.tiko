#module "tui"
'' std/tui: tui -- the terminal UI module, its overview
''
''     #import "std/tui"
''     using tui
''
'' Mirrors std/logs: one #import pulls the whole module in, so a caller does
'' not have to know which type lives in which file.
''
'' The value layer, the backend and the renderer:
''
''     tuicore.tiko     TuiRect, TuiColor, TuiStyle, the SGR encoder
''     tuiterm.tiko     TuiTerminal -- raw mode, capabilities, restore
''     tuibuffer.tiko   TuiCell, TuiBuffer, TuiFrame, TuiScreen, the diff
''
'' Input and the column-width table:
''
''     tuiinput.tiko    TuiEvent, the VT grammar, TuiInput, PollEvent
''     tuiwidth.tiko    TuiCharWidth, TuiStringWidth, TuiTruncate, TuiWrap
''     tuiwidthtab.tiko GENERATED from the UCD -- do not edit by hand
''
'' Layout:
''
''     tuilayout.tiko   TuiConstraint, TuiSplitH/V, padding, centring
''
'' Widgets:
''
''     tuiwidget.tiko   TuiWidget, TuiFocusRing, TuiButton/TuiButtonOf, TuiStack
''     tuiwidgets.tiko  Block, Paragraph, List, Table, Tabs, Gauge, Spinner, Scrollbar
''
'' Charts:
''
''     tuidraw.tiko     TuiCanvas (braille), TuiGraph, TuiSparkline,
''                      TuiBarChart, TuiMeter
''
'' Input widgets and overlays:
''
''     tuiform.tiko     TextInput, TextArea, Checkbox, RadioGroup, Select
''     tuichrome.tiko   Popup, MessageBox, MenuBar, StatusBar, Tree
''
'' The application loop:
''
''     tuiapp.tiko      TuiApp, TuiCmd, TuiRun, TuiRenderOnce
''
'' ---------------------------------------------------------------------------
'' ONE RULE BEFORE ANY OTHER
''
'' Inside a TUI session, DO NOT USE PRINT, LOCATE, COLOR, CLS, INKEY, GETMOUSE
'' OR SCREEN. On linux-x86_64 a bare PRINT emits ESC[?1h ESC= ESC[6n and blocks
'' waiting for a cursor-position report; under a pty with no responder it hangs.
'' All output goes through TuiTerminal.


