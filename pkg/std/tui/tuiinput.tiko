#module "tui"
#import "std/outcome"
#import "std/containers"
#ifdef __FB_UNIX__
#include once "../../sys/posix/posix.ti"
using posix
#endif
using outcome
using containers
'' std/tui: tuiinput -- events, the VT input grammar, and PollEvent
''
''     dim as TuiInput keys
''     do
''         dim as TuiEventOpt e = PollEvent( term, keys, 100 )
''         if( e.HasValue( ) = false ) then continue do        '' timed out
''         if( e.Value( ).key.code = TUIKEY_ESCAPE ) then exit do
''     loop
''
'' RFC-0004 -- C:\dev\docs\tui\RFC-0004-input-and-events.md.
''
'' ---------------------------------------------------------------------------
'' NOTE `keys` AND NOT `inp` IN THAT EXAMPLE. `INP` is a FreeBASIC intrinsic --
'' the QB port-input function -- so `dim as TuiInput inp` is
'' `error 4: Duplicated definition`. It is not on the blocked-member-name list
'' because it is not a member; it bites at the CALL SITE, in user code.
''
'' ---------------------------------------------------------------------------
'' THE PARSER IS A SEPARATE TYPE, AND THAT IS AN AMENDMENT
''
'' RFC-0004 section 3 specified `PollEvent( t, timeoutMs )` with the parse state
'' living inside TuiTerminal. Phase 2 ships `PollEvent( t, inp, timeoutMs )` with
'' the state in a TuiInput the caller owns, for one reason: THE RFC'S OWN GATE IS
'' A TABLE OF BYTE SEQUENCES MAPPED TO EXPECTED EVENTS, and that gate is
'' untestable if the only way to reach the parser is through a real terminal.
'' TuiInput.Feed( ) takes bytes from anywhere, so the grammar is tested without a
'' tty, on both targets, against one shared table.
''
'' ---------------------------------------------------------------------------
'' THE BUFFER PERSISTS ACROSS CALLS
''
'' A single read( ) can deliver half an escape sequence, and a sequence can span
'' reads. This is the most common way a hand-rolled VT parser is wrong, so the
'' incomplete case is explicit everywhere: NextEvent( ) returns None and LEAVES
'' THE BYTES ALONE when it cannot yet decide.


#ifdef __FB_WIN32__
    #include once "windows.bi"
#endif
'' No crt.bi on POSIX: its O_/E*/CLOCKS_PER_SEC macros would redefine sys/posix's names.


'' ============================================================== events

public enum TuiEventKind
    TUIEVENT_NONE = 0
    TUIEVENT_KEY
    TUIEVENT_MOUSE
    TUIEVENT_RESIZE
    TUIEVENT_PASTE
    TUIEVENT_FOCUS
end enum

public enum TuiKeyCode
    TUIKEY_NONE = 0
    TUIKEY_CHAR                 '' the text is in TuiEvent.text
    TUIKEY_ENTER
    TUIKEY_TAB
    TUIKEY_BACKSPACE
    TUIKEY_ESCAPE
    TUIKEY_UP
    TUIKEY_DOWN
    TUIKEY_LEFT
    TUIKEY_RIGHT
    TUIKEY_HOME
    TUIKEY_END
    TUIKEY_PAGEUP
    TUIKEY_PAGEDOWN
    TUIKEY_INSERT
    TUIKEY_DELETE
    TUIKEY_F1  : TUIKEY_F2  : TUIKEY_F3  : TUIKEY_F4
    TUIKEY_F5  : TUIKEY_F6  : TUIKEY_F7  : TUIKEY_F8
    TUIKEY_F9  : TUIKEY_F10 : TUIKEY_F11 : TUIKEY_F12
end enum

public enum TuiMod
    TUIMOD_NONE  = 0
    TUIMOD_SHIFT = 1
    TUIMOD_ALT   = 2
    TUIMOD_CTRL  = 4
end enum

public type TuiKey
    as ushort code
    as ubyte mods
    as ulong ch                 '' the codepoint, when code = TUIKEY_CHAR

    declare function IsChar( ) as boolean
    declare function HasMod( byval m as TuiMod ) as boolean
end type

function TuiKey.IsChar( ) as boolean
    return ( code = TUIKEY_CHAR )
end function

function TuiKey.HasMod( byval m as TuiMod ) as boolean
    return ( ( mods and m ) <> 0 )
end function

public enum TuiMouseKind
    TUIMOUSE_PRESS = 0
    TUIMOUSE_RELEASE
    TUIMOUSE_MOVE
    TUIMOUSE_WHEELUP
    TUIMOUSE_WHEELDOWN
end enum

public enum TuiMouseButton
    TUIBTN_NONE = 0
    TUIBTN_LEFT
    TUIBTN_MIDDLE
    TUIBTN_RIGHT
end enum

public type TuiMouse
    as ubyte kind
    as ubyte button
    as ubyte mods
    as long x, y                '' ZERO-BASED; the 1-based wire form is
end type                        '' converted at the parser and nowhere else

'' A flat struct with every payload present, not a union: a ustring inside a
'' UNION is error 161, and an event is created a few hundred times a second at
'' most, so the size is irrelevant. Result made the same trade for the same
'' reason.
public type TuiEvent
    as ubyte kind
    as TuiKey key
    as TuiMouse mouse
    as TuiSize size
    as ustring text             '' PASTE, and KEY when it is printable
    as boolean focused
end type

public type TuiEventOpt as Optional( of TuiEvent )
public type TuiEventArray as Array( of TuiEvent )

public function TuiKeyEvent( byval code as TuiKeyCode, byval mods as ubyte = 0 ) as TuiEvent
    dim as TuiEvent ev
    ev.kind = TUIEVENT_KEY
    ev.key.code = code
    ev.key.mods = mods
    return ev
end function

'' Builds the ustring payload by DIRECT CODE-UNIT ASSIGNMENT rather than WCHR.
'' WCHR destroyed surrogate pairs where wchar_t is 32 bits until 0aa2601; direct
'' assignment is correct on every toolchain vintage and costs nothing.
public function TuiCharEvent( byval cp as ulong, byval mods as ubyte = 0 ) as TuiEvent
    dim as TuiEvent ev
    ev.kind = TUIEVENT_KEY
    ev.key.code = TUIKEY_CHAR
    ev.key.mods = mods
    ev.key.ch = cp

    if( cp < &h10000 ) then
        ev.text = " "
        ev.text[0] = cast( ushort, cp )
    else
        ev.text = "  "
        dim as ulong v = cp - &h10000
        ev.text[0] = cast( ushort, &hD800 + ( v shr 10 ) )
        ev.text[1] = cast( ushort, &hDC00 + ( v and &h3FF ) )
    end if
    return ev
end function

'' ============================================================== key names

public function TuiKeyBaseName( byval code as ushort ) as ustring
    select case code
    case TUIKEY_ENTER     : return "Enter"
    case TUIKEY_TAB       : return "Tab"
    case TUIKEY_BACKSPACE : return "Backspace"
    case TUIKEY_ESCAPE    : return "Esc"
    case TUIKEY_UP        : return "Up"
    case TUIKEY_DOWN      : return "Down"
    case TUIKEY_LEFT      : return "Left"
    case TUIKEY_RIGHT     : return "Right"
    case TUIKEY_HOME      : return "Home"
    case TUIKEY_END      : return "End"
    case TUIKEY_PAGEUP    : return "PageUp"
    case TUIKEY_PAGEDOWN  : return "PageDown"
    case TUIKEY_INSERT    : return "Insert"
    case TUIKEY_DELETE    : return "Delete"
    end select
    if( ( code >= TUIKEY_F1 ) andalso ( code <= TUIKEY_F12 ) ) then
        return "F" & str( code - TUIKEY_F1 + 1 )
    end if
    return "Unknown"
end function

public function TuiKeyName( byval k as TuiKey ) as ustring
    dim as ustring s
    if( ( k.mods and TUIMOD_CTRL ) <> 0 )  then s &= "Ctrl+"
    if( ( k.mods and TUIMOD_ALT ) <> 0 )   then s &= "Alt+"
    if( ( k.mods and TUIMOD_SHIFT ) <> 0 ) then s &= "Shift+"

    if( k.code = TUIKEY_CHAR ) then
        if( k.ch < &h10000 ) then
            dim as ustring c = " "
            c[0] = cast( ushort, k.ch )
            return s & c
        end if
        return s & "U+" & hex( k.ch )
    end if
    return s & TuiKeyBaseName( k.code )
end function

'' ============================================================== UTF-8

'' Decodes one UTF-8 sequence at 1-based index i. Returns the codepoint and how
'' many BYTES it used; outUsed = 0 means the sequence is incomplete and the
'' caller must wait for more bytes rather than consuming anything.
public function TuiUtf8At( byref s as string, byval i as long, byref outUsed as long ) as ulong
    outUsed = 0
    dim as long n = len( s )
    if( i > n ) then return 0

    dim as ulong b0_ = asc( mid( s, i, 1 ) )
    if( b0_ < &h80 ) then
        outUsed = 1
        return b0_
    end if

    dim as long need = 0
    dim as ulong cp = 0
    if(   ( b0_ and &hE0 ) = &hC0 ) then : need = 1 : cp = b0_ and &h1F
    elseif( ( b0_ and &hF0 ) = &hE0 ) then : need = 2 : cp = b0_ and &h0F
    elseif( ( b0_ and &hF8 ) = &hF0 ) then : need = 3 : cp = b0_ and &h07
    else
        '' a stray continuation byte or an invalid lead: consume it as U+FFFD
        '' rather than stalling the parser forever
        outUsed = 1
        return &hFFFD
    end if

    if( i + need > n ) then return 0        '' incomplete, wait

    for k as long = 1 to need
        dim as ulong bx = asc( mid( s, i + k, 1 ) )
        if( ( bx and &hC0 ) <> &h80 ) then
            outUsed = 1
            return &hFFFD
        end if
        cp = ( cp shl 6 ) or ( bx and &h3F )
    next

    outUsed = need + 1
    return cp
end function

'' ============================================================== the parser

public const TUI_PASTE_LIMIT = 4194304     '' 4 MB; a paste that never ends is hostile
public const TUI_ESC_TIMEOUT_MS = 50

public type TuiInput
    declare sub Feed( byref bytes as string )
    declare function NextEvent( byval escExpired as boolean = FALSE ) as TuiEventOpt
    declare sub PushEvent( byval e as TuiEvent )
    declare sub Reset( )
    declare function Buffered( ) as long
    declare function Queued( ) as long
    declare function WaitingOnLoneEsc( ) as boolean

    private:
        as string m_buf
        as TuiEventArray m_queue
        as long m_head              '' index of the first unconsumed queue entry

        declare function hTakeQueued( ) as TuiEventOpt
        declare function hParseCsi( ) as TuiEventOpt
        declare function hParseSs3( ) as TuiEventOpt
        declare function hC0( byval b as ulong ) as TuiEvent
end type

sub TuiInput.Feed( byref bytes as string )
    if( len( bytes ) > 0 ) then m_buf &= bytes
end sub

sub TuiInput.Reset( )
    m_buf = ""
    m_queue.Clear( )
    m_head = 0
end sub

function TuiInput.Buffered( ) as long
    return len( m_buf )
end function

function TuiInput.Queued( ) as long
    return m_queue.Count( ) - m_head
end function

'' TRUE when the buffer holds exactly a lone ESC and the parser cannot decide
'' without the timeout. PollEvent uses this to know it must wait rather than
'' block forever.
function TuiInput.WaitingOnLoneEsc( ) as boolean
    return ( len( m_buf ) = 1 ) andalso ( asc( m_buf, 1 ) = 27 )
end function

sub TuiInput.PushEvent( byval e as TuiEvent )
    m_queue.Push( e )
end sub

function TuiInput.hTakeQueued( ) as TuiEventOpt
    if( m_head >= m_queue.Count( ) ) then
        if( m_queue.Count( ) > 0 ) then
            m_queue.Clear( )
            m_head = 0
        end if
        return None( of TuiEvent )( )
    end if
    dim as TuiEvent e = m_queue[ m_head ]
    m_head += 1
    return Some( e )
end function

'' C0 controls. 0x09, 0x0D and 0x08/0x7F are NAMED KEYS in their own right and
'' must be reported as such -- a program cannot distinguish Ctrl+I from Tab on a
'' terminal without modifyOtherKeys, and that is a property of the encoding
'' rather than something to work around.
function TuiInput.hC0( byval b as ulong ) as TuiEvent
    select case b
    case 13, 10 : return TuiKeyEvent( TUIKEY_ENTER )
    case 9      : return TuiKeyEvent( TUIKEY_TAB )
    case 8, 127 : return TuiKeyEvent( TUIKEY_BACKSPACE )
    case 27     : return TuiKeyEvent( TUIKEY_ESCAPE )
    case 0      : return TuiKeyEvent( TUIKEY_CHAR, TUIMOD_CTRL )
    end select

    if( ( b >= 1 ) andalso ( b <= 26 ) ) then
        '' Ctrl+A .. Ctrl+Z
        return TuiCharEvent( asc( "a" ) + b - 1, TUIMOD_CTRL )
    end if
    '' 0x1C..0x1F -- Ctrl+\ ] ^ _
    return TuiCharEvent( b + 64, TUIMOD_CTRL )
end function

'' Maps the CSI/SS3 modifier parameter: m-1 is a bit set, 1 Shift, 2 Alt,
'' 4 Ctrl. So CSI 1;5A is Ctrl+Up and CSI 1;6A is Ctrl+Shift+Up.
public function TuiModsFromParam( byval m as long ) as ubyte
    if( m <= 1 ) then return TUIMOD_NONE
    dim as long bits = m - 1
    dim as ubyte r = 0
    if( ( bits and 1 ) <> 0 ) then r or= TUIMOD_SHIFT
    if( ( bits and 2 ) <> 0 ) then r or= TUIMOD_ALT
    if( ( bits and 4 ) <> 0 ) then r or= TUIMOD_CTRL
    return r
end function

'' The tilde-number family. The duplicates are NOT redundancy to be cleaned up:
'' different terminals emit different forms for Home and End, and a parser that
'' accepts only one is broken on half the field.
public function TuiTildeKey( byval n as long ) as TuiKeyCode
    select case n
    case 1, 7  : return TUIKEY_HOME
    case 2     : return TUIKEY_INSERT
    case 3     : return TUIKEY_DELETE
    case 4, 8  : return TUIKEY_END
    case 5     : return TUIKEY_PAGEUP
    case 6     : return TUIKEY_PAGEDOWN
    case 11    : return TUIKEY_F1
    case 12    : return TUIKEY_F2
    case 13    : return TUIKEY_F3
    case 14    : return TUIKEY_F4
    case 15    : return TUIKEY_F5
    case 17    : return TUIKEY_F6
    case 18    : return TUIKEY_F7
    case 19    : return TUIKEY_F8
    case 20    : return TUIKEY_F9
    case 21    : return TUIKEY_F10
    case 23    : return TUIKEY_F11
    case 24    : return TUIKEY_F12
    end select
    return TUIKEY_NONE
end function

public function TuiLetterKey( byval f as string ) as TuiKeyCode
    select case f
    case "A" : return TUIKEY_UP
    case "B" : return TUIKEY_DOWN
    case "C" : return TUIKEY_RIGHT
    case "D" : return TUIKEY_LEFT
    case "H" : return TUIKEY_HOME
    case "F" : return TUIKEY_END
    case "P" : return TUIKEY_F1
    case "Q" : return TUIKEY_F2
    case "R" : return TUIKEY_F3
    case "S" : return TUIKEY_F4
    end select
    return TUIKEY_NONE
end function

'' Splits "1;5" or "<0;12;7" into its numeric parameters.
public sub TuiSplitParams( byref p as string, byref outv as Array( of long ) )
    outv.Clear( )
    dim as string cur
    for i as long = 1 to len( p )
        dim as string c = mid( p, i, 1 )
        if( ( c = ";" ) orelse ( c = ":" ) ) then
            outv.Push( clng( iif( len( cur ) > 0, valint( cur ), 0LL ) ) )
            cur = ""
        elseif( ( c >= "0" ) andalso ( c <= "9" ) ) then
            cur &= c
        end if
    next
    outv.Push( clng( iif( len( cur ) > 0, valint( cur ), 0LL ) ) )
end sub

'' ESC [ params intermediates final
function TuiInput.hParseCsi( ) as TuiEventOpt
    dim as long n = len( m_buf )
    '' m_buf(1) = ESC, m_buf(2) = '['
    dim as long i = 3
    dim as string params_

    while( i <= n )
        dim as ulong b = asc( mid( m_buf, i, 1 ) )
        '' parameter and intermediate bytes
        if( ( b >= &h30 ) andalso ( b <= &h3F ) ) then
            params_ &= chr( b )
            i += 1
            continue while
        end if
        if( ( b >= &h20 ) andalso ( b <= &h2F ) ) then
            i += 1
            continue while
        end if
        exit while
    wend

    if( i > n ) then return None( of TuiEvent )( )   '' incomplete, keep bytes

    dim as string final_ = mid( m_buf, i, 1 )
    dim as long total = i        '' bytes consumed, 1-based inclusive

    '' ---- SGR 1006 mouse: ESC [ < b ; x ; y M|m
    if( ( len( params_ ) > 0 ) andalso ( left( params_, 1 ) = "<" ) ) then
        if( ( final_ <> "M" ) andalso ( final_ <> "m" ) ) then
            m_buf = mid( m_buf, total + 1 )
            return None( of TuiEvent )( )
        end if

        dim as Array( of long ) v
        TuiSplitParams( mid( params_, 2 ), v )
        if( v.Count( ) < 3 ) then
            m_buf = mid( m_buf, total + 1 )
            return None( of TuiEvent )( )
        end if

        dim as long b = v[0]
        dim as TuiEvent e
        e.kind = TUIEVENT_MOUSE
        '' coordinates are 1-based on the wire and 0-based everywhere else
        e.mouse.x = v[1] - 1
        e.mouse.y = v[2] - 1

        dim as ubyte mm = 0
        if( ( b and 4 ) <> 0 )  then mm or= TUIMOD_SHIFT
        if( ( b and 8 ) <> 0 )  then mm or= TUIMOD_ALT
        if( ( b and 16 ) <> 0 ) then mm or= TUIMOD_CTRL
        e.mouse.mods = mm

        if( ( b and 64 ) <> 0 ) then
            e.mouse.kind = iif( ( b and 1 ) <> 0, TUIMOUSE_WHEELDOWN, TUIMOUSE_WHEELUP )
            e.mouse.button = TUIBTN_NONE
        elseif( ( b and 32 ) <> 0 ) then
            e.mouse.kind = TUIMOUSE_MOVE
            e.mouse.button = cast( ubyte, ( b and 3 ) + 1 )
            if( ( b and 3 ) = 3 ) then e.mouse.button = TUIBTN_NONE
        else
            e.mouse.kind = iif( final_ = "m", TUIMOUSE_RELEASE, TUIMOUSE_PRESS )
            e.mouse.button = cast( ubyte, ( b and 3 ) + 1 )
            if( ( b and 3 ) = 3 ) then e.mouse.button = TUIBTN_NONE
        end if

        m_buf = mid( m_buf, total + 1 )
        return Some( e )
    end if

    '' ---- focus in / out
    if( ( len( params_ ) = 0 ) andalso ( ( final_ = "I" ) orelse ( final_ = "O" ) ) ) then
        dim as TuiEvent e
        e.kind = TUIEVENT_FOCUS
        e.focused = ( final_ = "I" )
        m_buf = mid( m_buf, total + 1 )
        return Some( e )
    end if

    '' ---- tilde family, including bracketed paste
    if( final_ = "~" ) then
        dim as Array( of long ) v
        TuiSplitParams( params_, v )
        dim as long n1 = v[0]

        '' bracketed paste: everything up to ESC [ 201 ~ is ONE event, not a
        '' burst of keys -- a pasted newline must not read as Enter and a
        '' pasted ESC must not read as Escape.
        if( n1 = 200 ) then
            dim as string term_ = chr( 27 ) & "[201~"
            dim as long at_ = instr( total + 1, m_buf, term_ )
            if( at_ = 0 ) then
                if( len( m_buf ) > TUI_PASTE_LIMIT ) then
                    dim as TuiEvent e
                    e.kind = TUIEVENT_PASTE
                    e.text = mid( m_buf, total + 1 )
                    m_buf = ""
                    return Some( e )
                end if
                return None( of TuiEvent )( )     '' incomplete, wait
            end if

            dim as string body = mid( m_buf, total + 1, at_ - total - 1 )
            dim as TuiEvent e
            e.kind = TUIEVENT_PASTE
            e.text = body                          '' UTF-8 -> ustring
            m_buf = mid( m_buf, at_ + len( term_ ) )
            return Some( e )
        end if

        '' modifyOtherKeys: CSI 27 ; mods ; codepoint ~
        if( ( n1 = 27 ) andalso ( v.Count( ) >= 3 ) ) then
            m_buf = mid( m_buf, total + 1 )
            return Some( TuiCharEvent( v[2], TuiModsFromParam( v[1] ) ) )
        end if

        dim as TuiKeyCode kc = TuiTildeKey( n1 )
        dim as ubyte mods = 0
        if( v.Count( ) >= 2 ) then mods = TuiModsFromParam( v[1] )
        m_buf = mid( m_buf, total + 1 )
        if( kc = TUIKEY_NONE ) then return None( of TuiEvent )( )
        return Some( TuiKeyEvent( kc, mods ) )
    end if

    '' ---- letter finals: CSI A, CSI 1;5A, ...
    dim as TuiKeyCode kc = TuiLetterKey( final_ )
    if( kc <> TUIKEY_NONE ) then
        dim as Array( of long ) v
        TuiSplitParams( params_, v )
        dim as ubyte mods = 0
        if( v.Count( ) >= 2 ) then mods = TuiModsFromParam( v[1] )
        m_buf = mid( m_buf, total + 1 )
        return Some( TuiKeyEvent( kc, mods ) )
    end if

    '' A well-formed sequence we do not implement: consume it so the parser
    '' cannot wedge, and report nothing.
    m_buf = mid( m_buf, total + 1 )
    return None( of TuiEvent )( )
end function

'' ESC O final -- F1..F4 on many terminals
function TuiInput.hParseSs3( ) as TuiEventOpt
    if( len( m_buf ) < 3 ) then return None( of TuiEvent )( )
    dim as string final_ = mid( m_buf, 3, 1 )
    dim as TuiKeyCode kc = TuiLetterKey( final_ )
    m_buf = mid( m_buf, 4 )
    if( kc = TUIKEY_NONE ) then return None( of TuiEvent )( )
    return Some( TuiKeyEvent( kc ) )
end function

'' Parses ONE event from the front of the buffer.
''
'' escExpired says whether the lone-ESC timeout has elapsed. Passing it in
'' rather than reading a clock is what keeps this function pure and therefore
'' testable against a fixed byte table.
function TuiInput.NextEvent( byval escExpired as boolean ) as TuiEventOpt
    dim as TuiEventOpt q = hTakeQueued( )
    if( q.HasValue( ) ) then return q

    dim as long n = len( m_buf )
    if( n = 0 ) then return None( of TuiEvent )( )

    dim as ulong b0_ = asc( m_buf, 1 )

    if( b0_ <> 27 ) then
        if( b0_ < 32 ) then
            m_buf = mid( m_buf, 2 )
            return Some( hC0( b0_ ) )
        end if
        if( b0_ = 127 ) then
            m_buf = mid( m_buf, 2 )
            return Some( TuiKeyEvent( TUIKEY_BACKSPACE ) )
        end if

        dim as long used = 0
        dim as ulong cp = TuiUtf8At( m_buf, 1, used )
        if( used = 0 ) then return None( of TuiEvent )( )    '' incomplete UTF-8
        m_buf = mid( m_buf, used + 1 )
        return Some( TuiCharEvent( cp ) )
    end if

    '' ---- ESC
    if( n = 1 ) then
        '' THE LONE-ESC AMBIGUITY. ESC is both a key and the start of every
        '' sequence and nothing in the protocol distinguishes them. Only the
        '' timeout can decide, so until it fires we keep the byte.
        if( escExpired = FALSE ) then return None( of TuiEvent )( )
        m_buf = ""
        return Some( TuiKeyEvent( TUIKEY_ESCAPE ) )
    end if

    dim as ulong b1 = asc( m_buf, 2 )

    if( b1 = asc( "[" ) ) then return hParseCsi( )
    if( b1 = asc( "O" ) ) then return hParseSs3( )

    if( b1 = 27 ) then
        '' ESC ESC -- the first is the Escape key
        m_buf = mid( m_buf, 2 )
        return Some( TuiKeyEvent( TUIKEY_ESCAPE ) )
    end if

    '' ESC <printable> -- Alt+that key
    if( b1 < 32 ) then
        m_buf = mid( m_buf, 3 )
        dim as TuiEvent e = hC0( b1 )
        e.key.mods or= TUIMOD_ALT
        return Some( e )
    end if

    dim as long used = 0
    dim as ulong cp = TuiUtf8At( m_buf, 2, used )
    if( used = 0 ) then return None( of TuiEvent )( )
    m_buf = mid( m_buf, used + 2 )
    return Some( TuiCharEvent( cp, TUIMOD_ALT ) )
end function

'' ============================================================== win32 records

#ifdef __FB_WIN32__

'' Translates one INPUT_RECORD. Returns FALSE when the record produces no event
'' -- key-up, focus and menu records, which Microsoft documents as internal.
''
'' `pendingHigh` carries a high surrogate between calls: an astral codepoint
'' arrives as TWO key records and must be combined rather than emitted as two
'' broken events.
public function TuiFromRecord( byref rec as INPUT_RECORD, byref outEv as TuiEvent, _
                                byref pendingHigh as ulong ) as boolean
    select case rec.EventType
    case TUI_REC_KEY
        dim as ulong ch = rec.Event.KeyEvent.uChar.UnicodeChar
        dim as DWORD cks = rec.Event.KeyEvent.dwControlKeyState
        dim as long vk = rec.Event.KeyEvent.wVirtualKeyCode

        '' A LONE SURROGATE IS NEVER AN EVENT. Emitting one builds an invalid
        '' ustring, and it is easy to reach: Windows sends a key-UP for each
        '' half of a pair, and the Alt+numpad case below would otherwise fire
        '' on both of them. Measured -- before this guard, one astral keypress
        '' produced THREE events: a lone high surrogate, the correct
        '' codepoint, then a lone low surrogate.
        dim as boolean isSurrogate = ( ch >= &hD800 ) andalso ( ch <= &hDFFF )

        if( rec.Event.KeyEvent.bKeyDown = 0 ) then
            '' The ONE key-up that carries information: an Alt+numpad
            '' composed character arrives with vk = 0 and a real char.
            '' Hoisted to explicit boolean locals. Mixing a bare boolean with
            '' comparison results in one andalso chain is warning 38,
            '' "Suspicious logic operation" -- the trap RFC-0001 section 3
            '' documents and this file was violating.
            dim as boolean noVk = ( vk = 0 )
            dim as boolean hasCh = ( ch <> 0 )
            if( noVk andalso hasCh andalso ( isSurrogate = FALSE ) ) then
                outEv = TuiCharEvent( ch )
                return TRUE
            end if
            return FALSE
        end if

        dim as ubyte mods = 0
        if( ( cks and ( LEFT_CTRL_PRESSED or RIGHT_CTRL_PRESSED ) ) <> 0 ) then mods or= TUIMOD_CTRL
        if( ( cks and ( LEFT_ALT_PRESSED or RIGHT_ALT_PRESSED ) ) <> 0 )   then mods or= TUIMOD_ALT
        if( ( cks and SHIFT_PRESSED ) <> 0 )                               then mods or= TUIMOD_SHIFT

        '' surrogate pairing
        if( ( ch >= &hD800 ) andalso ( ch <= &hDBFF ) ) then
            pendingHigh = ch
            return FALSE
        end if
        if( pendingHigh <> 0 ) then
            if( ( ch >= &hDC00 ) andalso ( ch <= &hDFFF ) ) then
                dim as ulong cp = &h10000 + ( ( pendingHigh - &hD800 ) shl 10 ) + ( ch - &hDC00 )
                pendingHigh = 0
                outEv = TuiCharEvent( cp, mods )
                return TRUE
            end if
            '' a high surrogate followed by anything else is dropped, and the
            '' current record is processed normally
            pendingHigh = 0
        end if

        '' a LOW surrogate with no high before it is orphaned -- drop it rather
        '' than emit half a character
        if( ( ch >= &hDC00 ) andalso ( ch <= &hDFFF ) ) then return FALSE

        dim as TuiKeyCode kc = TUIKEY_NONE
        select case vk
        case VK_UP     : kc = TUIKEY_UP
        case VK_DOWN   : kc = TUIKEY_DOWN
        case VK_LEFT   : kc = TUIKEY_LEFT
        case VK_RIGHT  : kc = TUIKEY_RIGHT
        case VK_HOME   : kc = TUIKEY_HOME
        case VK_END    : kc = TUIKEY_END
        case VK_PRIOR  : kc = TUIKEY_PAGEUP
        case VK_NEXT   : kc = TUIKEY_PAGEDOWN
        case VK_INSERT : kc = TUIKEY_INSERT
        case VK_DELETE : kc = TUIKEY_DELETE
        case VK_RETURN : kc = TUIKEY_ENTER
        case VK_TAB    : kc = TUIKEY_TAB
        case VK_BACK   : kc = TUIKEY_BACKSPACE
        case VK_ESCAPE : kc = TUIKEY_ESCAPE
        end select
        if( ( vk >= VK_F1 ) andalso ( vk <= VK_F12 ) ) then
            kc = cast( TuiKeyCode, TUIKEY_F1 + ( vk - VK_F1 ) )
        end if

        if( kc <> TUIKEY_NONE ) then
            outEv = TuiKeyEvent( kc, mods )
            return TRUE
        end if

        if( ch >= 32 ) then
            outEv = TuiCharEvent( ch, mods )
            return TRUE
        end if
        if( ( ch >= 1 ) andalso ( ch <= 26 ) andalso ( ( mods and TUIMOD_CTRL ) <> 0 ) ) then
            outEv = TuiCharEvent( asc( "a" ) + ch - 1, mods )
            return TRUE
        end if
        return FALSE

    case TUI_REC_MOUSE
        dim as DWORD flags = rec.Event.MouseEvent.dwEventFlags
        dim as DWORD btns = rec.Event.MouseEvent.dwButtonState
        dim as DWORD cks = rec.Event.MouseEvent.dwControlKeyState

        outEv.kind = TUIEVENT_MOUSE
        outEv.mouse.x = rec.Event.MouseEvent.dwMousePosition.X
        outEv.mouse.y = rec.Event.MouseEvent.dwMousePosition.Y

        dim as ubyte mods = 0
        if( ( cks and ( LEFT_CTRL_PRESSED or RIGHT_CTRL_PRESSED ) ) <> 0 ) then mods or= TUIMOD_CTRL
        if( ( cks and ( LEFT_ALT_PRESSED or RIGHT_ALT_PRESSED ) ) <> 0 )   then mods or= TUIMOD_ALT
        if( ( cks and SHIFT_PRESSED ) <> 0 )                               then mods or= TUIMOD_SHIFT
        outEv.mouse.mods = mods

        if( ( flags and MOUSE_WHEELED ) <> 0 ) then
            '' the wheel delta is the HIGH word, and it is SIGNED
            dim as long delta = cast( short, ( btns shr 16 ) and &hFFFF )
            outEv.mouse.kind = iif( delta > 0, TUIMOUSE_WHEELUP, TUIMOUSE_WHEELDOWN )
            outEv.mouse.button = TUIBTN_NONE
            return TRUE
        end if

        if( ( flags and MOUSE_MOVED ) <> 0 ) then
            outEv.mouse.kind = TUIMOUSE_MOVE
        elseif( btns = 0 ) then
            outEv.mouse.kind = TUIMOUSE_RELEASE
        else
            outEv.mouse.kind = TUIMOUSE_PRESS
        end if

        if( ( btns and FROM_LEFT_1ST_BUTTON_PRESSED ) <> 0 ) then
            outEv.mouse.button = TUIBTN_LEFT
        elseif( ( btns and RIGHTMOST_BUTTON_PRESSED ) <> 0 ) then
            outEv.mouse.button = TUIBTN_RIGHT
        elseif( ( btns and FROM_LEFT_2ND_BUTTON_PRESSED ) <> 0 ) then
            outEv.mouse.button = TUIBTN_MIDDLE
        else
            outEv.mouse.button = TUIBTN_NONE
        end if
        return TRUE

    case TUI_REC_RESIZE
        outEv.kind = TUIEVENT_RESIZE
        return TRUE
    end select

    return FALSE
end function

#endif

'' ============================================================== PollEvent

'' timeoutMs: 0 polls, -1 blocks, anything else waits that long.
''
'' Returning Optional rather than a boolean plus an out-parameter is exactly
'' what std/outcome's Optional exists for -- a timeout is "nothing is here, and it needs
'' no explanation".
public function PollEvent( byref t as TuiTerminal, byref src as TuiInput, _
                            byval timeoutMs as long = -1 ) as TuiEventOpt
    '' anything already parsed wins, with no syscall at all
    dim as TuiEventOpt pending = src.NextEvent( FALSE )
    if( pending.HasValue( ) ) then return pending

    '' A resize noticed by the signal handler is delivered before input, and
    '' carries the NEW size already queried so no caller has to ask.
    if( t.TakeResize( ) ) then
        dim as TuiEvent r
        r.kind = TUIEVENT_RESIZE
        dim as TuiSizeResult sz = t.Size( )
        if( sz.IsOk( ) ) then r.size = sz.Value( )
        return Some( r )
    end if

    #ifdef __FB_WIN32__
        dim as HANDLE hIn = GetStdHandle( STD_INPUT_HANDLE )
        dim as DWORD wait_ = iif( timeoutMs < 0, INFINITE, cast( DWORD, timeoutMs ) )
        if( WaitForSingleObject( hIn, wait_ ) <> WAIT_OBJECT_0 ) then
            return None( of TuiEvent )( )
        end if

        static as ulong pendingHigh
        dim as INPUT_RECORD recs( 0 to 63 )
        dim as DWORD got
        if( ReadConsoleInputW( hIn, @recs(0), 64, @got ) = 0 ) then
            return None( of TuiEvent )( )
        end if

        dim as boolean sawResize = FALSE
        for i as long = 0 to got - 1
            dim as TuiEvent ev
            if( TuiFromRecord( recs(i), ev, pendingHigh ) = FALSE ) then continue for

            if( ev.kind = TUIEVENT_RESIZE ) then
                '' COALESCE: a drag-resize floods, and an intermediate size is
                '' never the one the user meant.
                sawResize = TRUE
                continue for
            end if
            src.PushEvent( ev )
        next

        if( sawResize ) then
            dim as TuiEvent r
            r.kind = TUIEVENT_RESIZE
            '' the record carries the BUFFER size; the window size is what we
            '' draw into, so re-query it
            dim as TuiSizeResult sz = t.Size( )
            if( sz.IsOk( ) ) then r.size = sz.Value( )
            return Some( r )
        end if

        return src.NextEvent( FALSE )
    #elseif defined( __FB_UNIX__ )
        dim as struct_pollfd pf
        pf.fd = STDIN_FILENO
        pf.events = POLLIN

        dim as long rc = tui_poll( @pf, 1, timeoutMs )
        if( rc < 0 ) then return None( of TuiEvent )( )

        if( rc = 0 ) then
            '' Nothing arrived. If a lone ESC is sitting in the buffer and we
            '' actually waited, the timeout has decided it: it was the key.
            if( src.WaitingOnLoneEsc( ) andalso ( timeoutMs <> 0 ) ) then
                return src.NextEvent( TRUE )
            end if
            return None( of TuiEvent )( )
        end if

        dim as zstring * 1025 buf
        dim as integer n = tui_read( STDIN_FILENO, @buf[0], 1024 )
        if( n <= 0 ) then return None( of TuiEvent )( )

        dim as string chunk = space( n )
        for i as long = 0 to n - 1
            chunk[i] = buf[i]
        next
        src.Feed( chunk )

        dim as TuiEventOpt r = src.NextEvent( FALSE )
        if( r.HasValue( ) ) then return r

        '' A lone ESC arrived and nothing followed it in the same read. Give
        '' the continuation TUI_ESC_TIMEOUT_MS to show up: a real terminal
        '' emits a whole sequence in one write, so any continuation is here in
        '' microseconds, while a human cannot press Escape and another key
        '' inside 50 ms.
        if( src.WaitingOnLoneEsc( ) ) then
            dim as long rc2 = tui_poll( @pf, 1, TUI_ESC_TIMEOUT_MS )
            if( rc2 > 0 ) then
                dim as integer n2 = tui_read( STDIN_FILENO, @buf[0], 1024 )
                if( n2 > 0 ) then
                    dim as string c2 = space( n2 )
                    for i as long = 0 to n2 - 1
                        c2[i] = buf[i]
                    next
                    src.Feed( c2 )
                end if
                return src.NextEvent( TRUE )
            end if
            return src.NextEvent( TRUE )
        end if

        return None( of TuiEvent )( )
    #else
        #error "tui/tuiinput: no backend for this target"
    #endif
end function

