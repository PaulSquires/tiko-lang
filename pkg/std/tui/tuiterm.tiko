#module "tui"
#import "std/outcome"
using outcome
'' std/tui: tuiterm -- the terminal backend
''
''     #import "std/tui"
''     using tui
''
''     dim as TuiTerminal term
''     dim as TuiUnitResult r = term.Enter( TuiTermOptionsDefault( ) )
''     if( r.IsOk( ) = false ) then print r.Failure( ).Message( ) : end 1
''     defer term.Leave( )
''
'' RFC-0002 -- C:\dev\docs\tui\RFC-0002-backend-and-capabilities.md.
''
'' The only file in the module that touches the operating system. NO NEW RTLIB C
'' AND NO COMPILER CHANGE: every call below is a Win32 or libc declaration
'' written in FreeBASIC, and every one was compiled, linked and run during the
'' phase-0 probe pass.
''
'' ---------------------------------------------------------------------------
'' THE RULE THAT DECIDED THIS FILE'S EXISTENCE
''
'' A bare `print "hi"` on linux-x86_64 emits ESC[?1h ESC= ESC[6n at startup and
'' then BLOCKS waiting for a cursor-position report. Under a pty with no
'' responder it never printed and was killed at 15 seconds. The identical
'' program written with write( ) ran to completion under the same pty.
''
'' So: INSIDE A TUI SESSION, DO NOT USE PRINT, LOCATE, COLOR, CLS, INKEY,
'' GETMOUSE OR SCREEN. Not style advice -- on Linux a stray PRINT is a hang.
'' All output here goes through write( ) / WriteFile( ) / WriteConsoleW( ).
''
'' A second consequence: rtlib emits ESC[?1h ESC= at process start and a reset
'' at exit EVEN WHEN THE PROGRAM NEVER CALLS PRINT. Enter( ) therefore sets
'' every mode it depends on explicitly rather than assuming a clean slate, and
'' Leave( ) does not assume its own reset is the last write to the terminal.
''
'' ---------------------------------------------------------------------------
'' TWO NAMING TRAPS, BOTH SILENT
''
'' FreeBASIC identifiers are case-insensitive, so a parameter named `ok` shadows
'' outcome.Ok and a variable named `some` shadows outcome.Some. Both fail with
'' `error 72: Array not dimensioned`, which names neither the cause nor the
'' symbol. Nothing in this file uses either identifier.



#ifdef __FB_WIN32__
    #include once "windows.bi"
#else
    #include once "crt.bi"
#endif


'' ============================================================== errors

public enum TuiErrorCode
    TUIERR_NONE = 0
    TUIERR_NOTATTY          '' stdout or stdin is not a terminal
    TUIERR_RAWMODE          '' could not change terminal mode
    TUIERR_IO               '' a write or read failed
    TUIERR_UNSUPPORTED      '' the terminal cannot do what was asked
    TUIERR_SIZE             '' the size query gave nothing usable
end enum

public type TuiError
    as long code
    as long oscode          '' GetLastError( ) or errno
    as string detail

    declare constructor( )
    declare constructor( byval c as TuiErrorCode, byref d as string, byval os as long = 0 )
    declare function Message( ) as string
end type

constructor TuiError( )
    code = TUIERR_NONE
    oscode = 0
end constructor

constructor TuiError( byval c as TuiErrorCode, byref d as string, byval os as long )
    code = c
    oscode = os
    detail = d
end constructor

function TuiError.Message( ) as string
    dim as string s
    select case code
    case TUIERR_NONE        : return "no error"
    case TUIERR_NOTATTY     : s = "not a terminal"
    case TUIERR_RAWMODE     : s = "could not enter raw mode"
    case TUIERR_IO          : s = "terminal I/O failed"
    case TUIERR_UNSUPPORTED : s = "unsupported by this terminal"
    case TUIERR_SIZE        : s = "could not determine terminal size"
    case else               : s = "unknown terminal error"
    end select
    if( len( detail ) > 0 ) then s &= ": " & detail
    if( oscode <> 0 ) then s &= " (os " & str( oscode ) & ")"
    return s
end function

'' Result has NO constructor -- build with outcome.Ok / outcome.Fail. Neither does
'' Optional; build with outcome.Some / outcome.None. The typedefs exist because
'' Ok( of T, E ) cannot infer both parameters, so the type is spelled once here
'' rather than at every return.
public type TuiSizeResult as Result( of TuiSize, TuiError )
public type TuiUnitResult as Result( of long, TuiError )

public function TuiOkUnit( ) as TuiUnitResult
    return Ok( of long, TuiError )( 0 )
end function

public function TuiFailUnit( byval c as TuiErrorCode, byref d as string, byval os as long = 0 ) as TuiUnitResult
    return Fail( of long, TuiError )( TuiError( c, d, os ) )
end function

'' ============================================================== capabilities

public type TuiCaps
    as boolean isTerminal
    as long depth               '' TuiColorDepth
    as boolean mouse
    as boolean bracketedPaste
    as boolean focusEvents
    as boolean unicode
end type

public type TuiTermOptions
    as boolean altScreen
    as boolean rawMode
    as boolean hideCursor
    as boolean mouse
    as boolean bracketedPaste
    as boolean focusEvents
end type

public function TuiTermOptionsDefault( ) as TuiTermOptions
    dim as TuiTermOptions o
    o.altScreen      = TRUE
    o.rawMode        = TRUE
    o.hideCursor     = TRUE
    o.mouse          = FALSE
    o.bracketedPaste = TRUE
    o.focusEvents    = FALSE
    return o
end function

'' ============================================================== platform

#ifdef __FB_WIN32__

    '' Not all of these are in FreeBASIC's windows.bi.
    #ifndef ENABLE_VIRTUAL_TERMINAL_PROCESSING
        #define ENABLE_VIRTUAL_TERMINAL_PROCESSING &h0004
    #endif
    #ifndef DISABLE_NEWLINE_AUTO_RETURN
        #define DISABLE_NEWLINE_AUTO_RETURN &h0008
    #endif
    #ifndef ENABLE_VIRTUAL_TERMINAL_INPUT
        #define ENABLE_VIRTUAL_TERMINAL_INPUT &h0200
    #endif
    #ifndef ENABLE_QUICK_EDIT_MODE
        #define ENABLE_QUICK_EDIT_MODE &h0040
    #endif
    #ifndef ENABLE_EXTENDED_FLAGS
        #define ENABLE_EXTENDED_FLAGS &h0080
    #endif

    '' MOUSE_EVENT and WINDOW_BUFFER_SIZE_EVENT are TYPE NAMES in windows.bi,
    '' not constants -- using them is `error 1: Argument count mismatch`
    '' (probe #31). The record kinds are spelled as literals throughout.
    public const TUI_REC_KEY    as ushort = &h0001
    public const TUI_REC_MOUSE  as ushort = &h0002
    public const TUI_REC_RESIZE as ushort = &h0004

#else

    const TUI_NCCS = 32
    type tui_termios
        as ulong c_iflag, c_oflag, c_cflag, c_lflag
        as ubyte c_line
        as ubyte c_cc( 0 to TUI_NCCS-1 )
        as ulong c_ispeed, c_ospeed
    end type

    type tui_winsize
        as ushort ws_row, ws_col, ws_xpixel, ws_ypixel
    end type

    type tui_pollfd
        as long fd
        as short events, revents
    end type

    '' EVERY ONE OF THESE IS PREFIXED, AND THAT IS NOT COSMETIC.
    ''
    '' `read` and `write` are FreeBASIC STATEMENTS, and crt.bi declares its own
    '' `read`/`write`/`signal`/`poll`/`raise`. Declaring them unprefixed here
    '' compiles fine on its own and then fails in any program that also
    '' includes crt.bi -- `error 58: Type mismatch, at parameter 1 (s) of
    '' WRITE()`, naming a parameter that is not ours. The alias carries the
    '' real C symbol, so the prefix costs nothing at link.
    extern "c"
        declare function tui_tcgetattr alias "tcgetattr" ( byval fd as long, byval t as tui_termios ptr ) as long
        declare function tui_tcsetattr alias "tcsetattr" ( byval fd as long, byval act as long, byval t as tui_termios ptr ) as long
        declare function tui_ioctl     alias "ioctl"     ( byval fd as long, byval req as ulongint, byval p as any ptr ) as long
        declare function tui_isatty    alias "isatty"    ( byval fd as long ) as long
        declare function tui_read      alias "read"      ( byval fd as long, byval buf as any ptr, byval n as uinteger ) as integer
        declare function tui_write     alias "write"     ( byval fd as long, byval buf as any ptr, byval n as uinteger ) as integer
        declare function tui_signal    alias "signal"    ( byval sig as long, byval h as any ptr ) as any ptr
        declare function tui_poll      alias "poll"      ( byval fds as any ptr, byval n as ulongint, byval ms as long ) as long
        declare function tui_raise     alias "raise"     ( byval sig as long ) as long
    end extern

    '' glibc x86_64 values. sizeof( tui_termios ) = 60 and
    '' sizeof( tui_winsize ) = 8 were both measured, not assumed.
    const TUI_ICANON = &h0002, TUI_ECHO = &h0008, TUI_ISIG = &h0001, TUI_IEXTEN = &h8000
    const TUI_IXON = &h0400, TUI_ICRNL = &h0100, TUI_BRKINT = &h0002
    const TUI_INPCK = &h0010, TUI_ISTRIP = &h0020
    const TUI_OPOST = &h0001
    const TUI_TCSAFLUSH = 2
    const TUI_TIOCGWINSZ = &h5413
    const TUI_VMIN = 6, TUI_VTIME = 5
    const TUI_POLLIN = &h0001

    const TUI_SIGINT = 2, TUI_SIGQUIT = 3, TUI_SIGSEGV = 11
    const TUI_SIGTERM = 15, TUI_SIGHUP = 1, TUI_SIGWINCH = 28, TUI_SIGTSTP = 20

#endif

'' ============================================================== restore state
''
'' The crash-restore path needs state a signal handler can reach, and a signal
'' handler cannot be a closure or a method. As a header it also could not be
'' `dim shared`: two modules including the file would have collided at link.
''
'' A `static` local inside a function holds it: one slot per program, now that
'' std/tui is one module. (As a header the function was `private`, giving each
'' including module its own slot, which was correct because the handler
'' installed was also that module's own `private` procedure.) One terminal per
'' process is the only case this has to serve, and it serves it.

type TuiSavedMode
    as boolean active
    #ifdef __FB_WIN32__
        as HANDLE hOut, hIn
        as DWORD outMode, inMode
        as ulong outCP
    #else
        as tui_termios orig
        as boolean haveOrig
    #endif
    '' A FIXED buffer, not a string. Two reasons, and the second is the one
    '' that matters: a var-len string in this type makes its implicit
    '' destructor undefined when the type is a `static` local inside a
    '' `private` function (link error, no diagnostic at compile time) -- and a
    '' heap string descriptor is not async-signal-safe, which is exactly what
    '' TuiEmergencyRestore has to be. 128 bytes is comfortably above the
    '' longest sequence TuiLeaveSeq can produce.
    as zstring * 128 leaveSeq
    as long leaveLen
end type

'' THESE RETURN A POINTER, NOT A BYREF, AND THAT IS NOT A STYLE CHOICE.
''
'' `function TuiSaved( ) byref as TuiSavedMode` compiles, and reading through
'' it works -- but `@TuiSaved( )` does NOT yield the address of the referent.
'' It yields the address of the PROCEDURE, silently, with no diagnostic. The
'' result is a pointer into the code segment; reading it gives garbage and
'' writing through it faults. Measured: `@F( )` on three different
'' byref-returning functions produced three consecutive code addresses, while
'' the `return @s` form produced a real data address that round-tripped.
''
'' So every accessor here returns `ptr` explicitly.
function TuiSaved( ) as TuiSavedMode ptr
    static as TuiSavedMode s
    return @s
end function

'' The resize flag. Set by the SIGWINCH handler, which may touch nothing else.
function TuiResizeFlag( ) as long ptr
    static as long f
    return @f
end function

'' Async-signal-safe: a direct mode restore and one fixed write. No allocation,
'' no ustring, no Result. Idempotent -- it may run after Leave( ) already did.
sub TuiEmergencyRestore( )
    dim as TuiSavedMode ptr s = TuiSaved( )
    if( s->active = FALSE ) then exit sub
    s->active = FALSE

    #ifdef __FB_WIN32__
        if( s->leaveLen > 0 ) then
            dim as DWORD written
            WriteFile( s->hOut, @s->leaveSeq[0], s->leaveLen, @written, 0 )
        end if
        SetConsoleMode( s->hOut, s->outMode )
        SetConsoleMode( s->hIn, s->inMode )
        if( s->outCP <> 0 ) then SetConsoleOutputCP( s->outCP )
    #else
        if( s->leaveLen > 0 ) then
            tui_write( 1, @s->leaveSeq[0], s->leaveLen )
        end if
        if( s->haveOrig ) then tui_tcsetattr( 0, TUI_TCSAFLUSH, @s->orig )
    #endif
end sub

#ifdef __FB_WIN32__
    function TuiCtrlHandler stdcall ( byval dwType as DWORD ) as BOOL
        TuiEmergencyRestore( )
        return FALSE       '' let the default handler terminate us
    end function
#else
    sub TuiSignalHandler cdecl ( byval sig as long )
        TuiEmergencyRestore( )
        tui_signal( sig, cast( any ptr, 0 ) )   '' SIG_DFL
        tui_raise( sig )
    end sub

    sub TuiWinchHandler cdecl ( byval sig as long )
        *TuiResizeFlag( ) = 1
    end sub
#endif

'' ============================================================== the terminal

public type TuiTerminal
    declare constructor( )
    declare destructor( )

    declare function Enter( byval opts as TuiTermOptions ) as TuiUnitResult
    declare function Leave( ) as TuiUnitResult
    declare function IsActive( ) as boolean

    declare function Size( ) as TuiSizeResult
    declare function Caps( ) as TuiCaps
    declare function DetectCaps( ) as TuiCaps

    declare function Write( byref s as string ) as TuiUnitResult
    declare function WriteText( byref u as ustring ) as TuiUnitResult
    declare function Flush( ) as TuiUnitResult
    declare sub Discard( )
    declare function Pending( ) as long

    declare function TakeResize( ) as boolean

    private:
        as boolean m_active
        as TuiCaps m_caps
        as TuiTermOptions m_opts
        as string m_buf
        #ifdef __FB_WIN32__
            as HANDLE m_hOut, m_hIn
        #endif
end type

constructor TuiTerminal( )
    m_active = FALSE
    #ifdef __FB_WIN32__
        m_hOut = GetStdHandle( STD_OUTPUT_HANDLE )
        m_hIn  = GetStdHandle( STD_INPUT_HANDLE )
    #endif
    m_caps = DetectCaps( )
end constructor

'' Restore layer 2 of 3 -- covers unwinding. RFC-0002 section 5.
destructor TuiTerminal( )
    if( m_active ) then Leave( )
end destructor

function TuiTerminal.IsActive( ) as boolean
    return m_active
end function

function TuiTerminal.Caps( ) as TuiCaps
    return m_caps
end function

'' -------------------------------------------------------------- detection

function TuiTerminal.DetectCaps( ) as TuiCaps
    dim as TuiCaps c
    c.depth = TUIDEPTH_MONO

    #ifdef __FB_WIN32__
        '' ENVIRONMENT VARIABLES ARE USELESS HERE. A real conhost window
        '' reports TERM, COLORTERM and WT_SESSION all empty (probe #29), so
        '' anything keyed on them silently reports mono.
        if( GetFileType( m_hOut ) <> FILE_TYPE_CHAR ) then return c

        dim as DWORD mode
        if( GetConsoleMode( m_hOut, @mode ) = 0 ) then return c

        c.isTerminal = TRUE
        c.unicode = TRUE

        '' SUCCESS OF THE SetConsoleMode IS THE CAPABILITY TEST.
        dim as DWORD want = mode or ENABLE_VIRTUAL_TERMINAL_PROCESSING
        if( SetConsoleMode( m_hOut, want ) <> 0 ) then
            SetConsoleMode( m_hOut, mode )
            c.depth = TUIDEPTH_256
            if( len( environ( "WT_SESSION" ) ) > 0 ) then c.depth = TUIDEPTH_TRUECOLOR

            dim as OSVERSIONINFO vi
            vi.dwOSVersionInfoSize = sizeof( OSVERSIONINFO )
            #ifndef __FB_64BIT__
                '' GetVersionEx is deprecated and lies without a manifest;
                '' the WT_SESSION probe above is the reliable signal.
            #endif
            c.mouse = TRUE
            c.bracketedPaste = TRUE
            c.focusEvents = TRUE
        else
            '' Pre-VT console: 16 colours through the legacy attribute path.
            c.depth = TUIDEPTH_ANSI16
            c.mouse = TRUE
        end if
    #else
        if( tui_isatty( 1 ) = 0 ) then return c
        c.isTerminal = TRUE

        dim as string ct = lcase( environ( "COLORTERM" ) )
        dim as string tm = lcase( environ( "TERM" ) )

        if( ( instr( ct, "truecolor" ) > 0 ) orelse ( instr( ct, "24bit" ) > 0 ) ) then
            c.depth = TUIDEPTH_TRUECOLOR
        elseif( instr( tm, "256color" ) > 0 ) then
            c.depth = TUIDEPTH_256
        elseif( ( len( tm ) = 0 ) orelse ( tm = "dumb" ) ) then
            c.depth = TUIDEPTH_MONO
        else
            c.depth = TUIDEPTH_ANSI16
        end if

        if( c.depth <> TUIDEPTH_MONO ) then
            c.mouse = TRUE
            c.bracketedPaste = TRUE
            c.focusEvents = TRUE
        end if

        dim as string loc = lcase( environ( "LC_ALL" ) & environ( "LC_CTYPE" ) & environ( "LANG" ) )
        c.unicode = ( instr( loc, "utf-8" ) > 0 ) orelse ( instr( loc, "utf8" ) > 0 )
    #endif

    return c
end function

'' -------------------------------------------------------------- size

function TuiTerminal.Size( ) as TuiSizeResult
    #ifdef __FB_WIN32__
        dim as CONSOLE_SCREEN_BUFFER_INFO csbi
        if( GetConsoleScreenBufferInfo( m_hOut, @csbi ) = 0 ) then
            return Fail( of TuiSize, TuiError )( _
                TuiError( TUIERR_SIZE, "GetConsoleScreenBufferInfo failed", GetLastError( ) ) )
        end if
        '' The WINDOW rectangle, never dwSize -- dwSize is the scrollback
        '' buffer and is routinely taller than the visible window.
        dim as long cols = csbi.srWindow.Right - csbi.srWindow.Left + 1
        dim as long rows = csbi.srWindow.Bottom - csbi.srWindow.Top + 1
        if( ( cols <= 0 ) orelse ( rows <= 0 ) ) then
            return Ok( of TuiSize, TuiError )( TuiSizeOf( 80, 24 ) )
        end if
        return Ok( of TuiSize, TuiError )( TuiSizeOf( cols, rows ) )
    #else
        '' TIOCGWINSZ CAN SUCCEED AND REPORT 0x0 -- measured under a pty
        '' (probe #35). Success is not a size, so the fallback chain runs on
        '' the VALUE, not on the return code.
        dim as tui_winsize ws
        if( tui_ioctl( 1, TUI_TIOCGWINSZ, @ws ) = 0 ) then
            if( ( ws.ws_col > 0 ) andalso ( ws.ws_row > 0 ) ) then
                return Ok( of TuiSize, TuiError )( TuiSizeOf( ws.ws_col, ws.ws_row ) )
            end if
        end if

        dim as long ec = valint( environ( "COLUMNS" ) )
        dim as long er = valint( environ( "LINES" ) )
        if( ( ec > 0 ) andalso ( er > 0 ) ) then
            return Ok( of TuiSize, TuiError )( TuiSizeOf( ec, er ) )
        end if

        return Ok( of TuiSize, TuiError )( TuiSizeOf( 80, 24 ) )
    #endif
end function

'' -------------------------------------------------------------- sequences

public function TuiEnterSeq( byval o as TuiTermOptions ) as string
    dim as string s
    dim as string esc = chr( 27 )
    if( o.altScreen )      then s &= esc & "[?1049h"
    if( o.hideCursor )     then s &= esc & "[?25l"
    if( o.mouse )          then s &= esc & "[?1000h" & esc & "[?1002h" & esc & "[?1003h" & esc & "[?1006h"
    if( o.bracketedPaste ) then s &= esc & "[?2004h"
    if( o.focusEvents )    then s &= esc & "[?1004h"
    return s
end function

'' Exactly the reverse order of TuiEnterSeq, plus an SGR reset.
public function TuiLeaveSeq( byval o as TuiTermOptions ) as string
    dim as string s
    dim as string esc = chr( 27 )
    s &= esc & "[0m"
    if( o.focusEvents )    then s &= esc & "[?1004l"
    if( o.bracketedPaste ) then s &= esc & "[?2004l"
    if( o.mouse )          then s &= esc & "[?1006l" & esc & "[?1003l" & esc & "[?1002l" & esc & "[?1000l"
    if( o.hideCursor )     then s &= esc & "[?25h"
    if( o.altScreen )      then s &= esc & "[?1049l"
    return s
end function

'' -------------------------------------------------------------- enter / leave

#ifdef __FB_WIN32__
'' RFC-0002 section 3. The console input mode Enter( ) will install, as a PURE
'' function of the mode it found and the options asked for -- so it can be
'' asserted without a console.
''
'' The one non-obvious bit is QuickEdit. It is ON by default in most Windows
'' consoles and it CONSUMES EVERY MOUSE EVENT for text selection, so an app
'' asking for mouse:=TRUE sees nothing at all. Clearing ENABLE_QUICK_EDIT_MODE
'' is IGNORED unless ENABLE_EXTENDED_FLAGS is set in the same call.
''
'' The phase-2 mouse tests could not have caught this: they inject INPUT_RECORDs
'' with WriteConsoleInputW, which bypasses the console's own mouse handling.
public function TuiWin32InputMode _
    ( _
        byval current as DWORD, _
        byval opts as TuiTermOptions _
    ) as DWORD

    dim as DWORD strip = ENABLE_LINE_INPUT or ENABLE_ECHO_INPUT or ENABLE_PROCESSED_INPUT
    dim as DWORD wantIn = ( current and ( not strip ) ) or ENABLE_WINDOW_INPUT

    if( opts.mouse ) then
        wantIn or= ENABLE_MOUSE_INPUT or ENABLE_EXTENDED_FLAGS
        wantIn and= not ENABLE_QUICK_EDIT_MODE
    end if

    return wantIn
end function
#endif

function TuiTerminal.Enter( byval opts as TuiTermOptions ) as TuiUnitResult
    if( m_active ) then return TuiOkUnit( )

    m_caps = DetectCaps( )
    if( m_caps.isTerminal = FALSE ) then
        return TuiFailUnit( TUIERR_NOTATTY, "stdout is not a console or terminal" )
    end if

    m_opts = opts
    dim as TuiSavedMode ptr sv = TuiSaved( )

    #ifdef __FB_WIN32__
        sv->hOut = m_hOut
        sv->hIn  = m_hIn
        if( GetConsoleMode( m_hOut, @sv->outMode ) = 0 ) then
            return TuiFailUnit( TUIERR_RAWMODE, "GetConsoleMode(out)", GetLastError( ) )
        end if
        if( GetConsoleMode( m_hIn, @sv->inMode ) = 0 ) then
            return TuiFailUnit( TUIERR_RAWMODE, "GetConsoleMode(in)", GetLastError( ) )
        end if

        '' DISABLE_NEWLINE_AUTO_RETURN matters more than it looks: without it,
        '' writing the last column of the last row scrolls the screen, which
        '' corrupts a full-screen diff on every frame touching that cell.
        dim as DWORD wantOut = sv->outMode or ENABLE_VIRTUAL_TERMINAL_PROCESSING or DISABLE_NEWLINE_AUTO_RETURN
        if( SetConsoleMode( m_hOut, wantOut ) = 0 ) then
            return TuiFailUnit( TUIERR_UNSUPPORTED, "this console cannot do VT output", GetLastError( ) )
        end if

        if( opts.rawMode ) then
            dim as DWORD wantIn = TuiWin32InputMode( sv->inMode, opts )
            if( SetConsoleMode( m_hIn, wantIn ) = 0 ) then
                SetConsoleMode( m_hOut, sv->outMode )
                return TuiFailUnit( TUIERR_RAWMODE, "SetConsoleMode(in)", GetLastError( ) )
            end if
        end if

        '' THE OUTPUT CODE PAGE, and it is not optional.
        ''
        '' Render( ) produces UTF-8 bytes and Flush( ) sends them with
        '' WriteFile. A Windows console interprets WriteFile bytes in its
        '' OUTPUT CODE PAGE -- 437 or 1252 by default -- so without this every
        '' non-ASCII glyph arrives as mojibake, one cell per UTF-8 byte.
        ''
        '' Measured, and only findable live: drawing "AB" + two CJK ideographs
        '' + "CD" and reading the cells back with ReadConsoleOutputCharacterW
        '' gave A B 3A3 2555 A1 B5 FB E7 C D -- six garbage cells where four
        '' columns belonged. Every unit test passed, because they assert the
        '' byte string and not what the console does with it.
        sv->outCP = GetConsoleOutputCP( )
        SetConsoleOutputCP( 65001 )        '' CP_UTF8

        SetConsoleCtrlHandler( @TuiCtrlHandler, TRUE )
    #else
        if( opts.rawMode ) then
            if( tui_tcgetattr( 0, @sv->orig ) <> 0 ) then
                return TuiFailUnit( TUIERR_RAWMODE, "tcgetattr(0)" )
            end if
            sv->haveOrig = TRUE

            dim as tui_termios raw = sv->orig
            raw.c_iflag and= not ( TUI_BRKINT or TUI_ICRNL or TUI_INPCK or TUI_ISTRIP or TUI_IXON )
            raw.c_oflag and= not TUI_OPOST
            raw.c_lflag and= not ( TUI_ECHO or TUI_ICANON or TUI_ISIG or TUI_IEXTEN )
            '' VMIN = 0, VTIME = 0 makes read( ) non-blocking: the waiting is
            '' poll( )'s job, which is what gives PollEvent its timeout.
            raw.c_cc( TUI_VMIN )  = 0
            raw.c_cc( TUI_VTIME ) = 0

            if( tui_tcsetattr( 0, TUI_TCSAFLUSH, @raw ) <> 0 ) then
                return TuiFailUnit( TUIERR_RAWMODE, "tcsetattr(raw)" )
            end if
        end if

        tui_signal( TUI_SIGINT,  cast( any ptr, @TuiSignalHandler ) )
        tui_signal( TUI_SIGTERM, cast( any ptr, @TuiSignalHandler ) )
        tui_signal( TUI_SIGHUP,  cast( any ptr, @TuiSignalHandler ) )
        tui_signal( TUI_SIGQUIT, cast( any ptr, @TuiSignalHandler ) )
        tui_signal( TUI_SIGSEGV, cast( any ptr, @TuiSignalHandler ) )
        tui_signal( TUI_SIGWINCH, cast( any ptr, @TuiWinchHandler ) )
    #endif

    '' Arm the emergency path BEFORE writing anything, so a crash between here
    '' and the first Flush still restores.
    dim as string lv = TuiLeaveSeq( opts )
    if( len( lv ) > 127 ) then lv = left( lv, 127 )
    sv->leaveSeq = lv
    sv->leaveLen = len( lv )
    sv->active = TRUE
    m_active = TRUE

    dim as TuiUnitResult w = Write( TuiEnterSeq( opts ) )
    if( w.IsOk( ) = false ) then
        Leave( )
        return w
    end if
    return Flush( )
end function

function TuiTerminal.Leave( ) as TuiUnitResult
    if( m_active = FALSE ) then return TuiOkUnit( )

    Discard( )
    dim as TuiUnitResult w = Write( TuiLeaveSeq( m_opts ) )
    Flush( )

    dim as TuiSavedMode ptr sv = TuiSaved( )
    sv->active = FALSE
    m_active = FALSE

    #ifdef __FB_WIN32__
        SetConsoleMode( m_hOut, sv->outMode )
        SetConsoleMode( m_hIn,  sv->inMode )
        if( sv->outCP <> 0 ) then SetConsoleOutputCP( sv->outCP )
        SetConsoleCtrlHandler( @TuiCtrlHandler, FALSE )
    #else
        if( sv->haveOrig ) then tui_tcsetattr( 0, TUI_TCSAFLUSH, @sv->orig )
        tui_signal( TUI_SIGINT,   cast( any ptr, 0 ) )
        tui_signal( TUI_SIGTERM,  cast( any ptr, 0 ) )
        tui_signal( TUI_SIGHUP,   cast( any ptr, 0 ) )
        tui_signal( TUI_SIGQUIT,  cast( any ptr, 0 ) )
        tui_signal( TUI_SIGSEGV,  cast( any ptr, 0 ) )
        tui_signal( TUI_SIGWINCH, cast( any ptr, 0 ) )
    #endif

    return w
end function

'' -------------------------------------------------------------- output
''
'' Write appends; Flush issues ONE OS write. A full-screen frame is one syscall,
'' not one per cell -- which is most of what makes the diff worth having, since
'' a diff that still wrote per-cell would be slower than a blind repaint.

function TuiTerminal.Write( byref s as string ) as TuiUnitResult
    if( len( s ) > 0 ) then m_buf &= s
    return TuiOkUnit( )
end function

function TuiTerminal.WriteText( byref u as ustring ) as TuiUnitResult
    if( len( u ) = 0 ) then return TuiOkUnit( )

    #ifdef __FB_WIN32__
        if( m_caps.isTerminal ) then
            '' A real console is UTF-16 and so is ustring, so the code units
            '' go straight across with no re-encoding. But this path bypasses
            '' m_buf, so anything already buffered must go out first to keep
            '' the byte order right.
            dim as TuiUnitResult f = Flush( )
            if( f.IsOk( ) = false ) then return f
            dim as DWORD written
            if( WriteConsoleW( m_hOut, cast( any ptr, strptr( u ) ), len( u ), @written, 0 ) = 0 ) then
                return TuiFailUnit( TUIERR_IO, "WriteConsoleW", GetLastError( ) )
            end if
            return TuiOkUnit( )
        end if
    #endif

    '' The implicit ustring -> string conversion produces correct UTF-8 on both
    '' targets, verified for an astral codepoint (probe #41). NOTE that the
    '' reverse direction was NOT safe until 0aa2601: WCHR destroyed surrogate
    '' pairs where wchar_t is 32 bits. That is fixed, but nothing here builds a
    '' ustring with WCHR anyway -- direct code-unit assignment is correct on
    '' every toolchain vintage.
    dim as string u8 = u
    return Write( u8 )
end function

function TuiTerminal.Flush( ) as TuiUnitResult
    if( len( m_buf ) = 0 ) then return TuiOkUnit( )

    dim as long n = len( m_buf )
    #ifdef __FB_WIN32__
        dim as DWORD written
        if( WriteFile( m_hOut, strptr( m_buf ), n, @written, 0 ) = 0 ) then
            m_buf = ""
            return TuiFailUnit( TUIERR_IO, "WriteFile", GetLastError( ) )
        end if
    #else
        dim as long off = 0
        while( off < n )
            dim as integer w = tui_write( 1, strptr( m_buf ) + off, n - off )
            if( w <= 0 ) then
                m_buf = ""
                return TuiFailUnit( TUIERR_IO, "write" )
            end if
            off += w
        wend
    #endif

    '' Reset the length but keep the capacity, so steady-state rendering does
    '' not reallocate every frame.
    m_buf = ""
    return TuiOkUnit( )
end function

sub TuiTerminal.Discard( )
    m_buf = ""
end sub

function TuiTerminal.Pending( ) as long
    return len( m_buf )
end function

'' -------------------------------------------------------------- resize

'' Consumes the pending-resize flag. On Windows the resize arrives as an input
'' record instead, so this always reports FALSE there -- RFC-0004 section 6.
function TuiTerminal.TakeResize( ) as boolean
    #ifdef __FB_WIN32__
        return FALSE
    #else
        if( *TuiResizeFlag( ) = 0 ) then return FALSE
        *TuiResizeFlag( ) = 0
        return TRUE
    #endif
end function

'' -------------------------------------------------------------- cursor

public function TuiCursorTo( byval x as long, byval y as long ) as string
    '' VT coordinates are 1-based; everything in this module is 0-based, and
    '' the conversion happens here so nowhere else has to remember.
    return chr( 27 ) & "[" & str( y + 1 ) & ";" & str( x + 1 ) & "H"
end function

public function TuiShowCursorSeq( byval visible as boolean ) as string
    if( visible ) then return chr( 27 ) & "[?25h"
    return chr( 27 ) & "[?25l"
end function

public function TuiClearScreenSeq( ) as string
    return chr( 27 ) & "[2J"
end function

