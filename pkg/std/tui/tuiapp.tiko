#module "tui"
#import "std/chrono"
#import "std/outcome"
using chrono
using outcome
'' std/tui: tuiapp -- the application loop
''
''     type MyApp extends TuiApp
''         declare sub Init( ) override
''         declare function Update( byref e as TuiEvent ) as TuiCmd override
''         declare sub View( byref f as TuiFrame ) override
''     end type
''
''     dim as MyApp app
''     dim as Result( of long, TuiError ) r = TuiRun( app, TuiTermOptionsDefault( ) )
''
'' RFC-0009 -- C:\dev\docs\tui\RFC-0009-app-loop-and-async.md.
''
'' OPTIONAL. Everything in RFCs 0001-0008 works without it -- that is the
'' Ratatui style, and it stays available. This file is for programs that would
'' otherwise write the same loop again.
''
'' ---------------------------------------------------------------------------
'' UPDATE NEVER DRAWS. VIEW NEVER MUTATES.
''
'' The separation is the only rule, and it is what makes a frame reproducible
'' from state.


#include once "fb/array.bi"
#include once "fb/array.bi"
#include once "fb/array.bi"
#ifdef __FB_WIN32__
    #include once "windows.bi"
#else
    #include once "crt.bi"
#endif
#include once "fb/array.bi"
#include once "fb/array.bi"

using FB

'' ============================================================== commands

public enum TuiCmdKind
    TUICMD_NONE = 0
    TUICMD_REDRAW
    TUICMD_QUIT
    TUICMD_TICK             '' deliver a TUIEVENT_TICK in n ms
    TUICMD_SUSPEND
    TUICMD_INVALIDATE
end enum

public type TuiCmd
    as ubyte kind
    as long arg             '' ms for TICK, exit code for QUIT
end type

public function TuiNone( ) as TuiCmd
    dim as TuiCmd c
    c.kind = TUICMD_NONE
    return c
end function

public function TuiRedraw( ) as TuiCmd
    dim as TuiCmd c
    c.kind = TUICMD_REDRAW
    return c
end function

public function TuiQuit( byval code as long = 0 ) as TuiCmd
    dim as TuiCmd c
    c.kind = TUICMD_QUIT
    c.arg = code
    return c
end function

'' ONE-SHOT. A repeating timer is an Update that returns TuiTick again on each
'' tick -- one line at the call site, and it removes cancellation, drift
'' correction and timer identity from the API entirely.
public function TuiTick( byval ms as long ) as TuiCmd
    dim as TuiCmd c
    c.kind = TUICMD_TICK
    c.arg = iif( ms > 0, ms, 0 )
    return c
end function

public function TuiInvalidate( ) as TuiCmd
    dim as TuiCmd c
    c.kind = TUICMD_INVALIDATE
    return c
end function

public function TuiSuspend( ) as TuiCmd
    dim as TuiCmd c
    c.kind = TUICMD_SUSPEND
    return c
end function

'' There is deliberately NO TUICMD_BATCH. A batch needs a variable-length list
'' inside a value type returned by value from every Update, and FreeBASIC has no
'' varargs of any kind -- docs/logging hit exactly this and answered it with a
'' chained builder. Here the honest answer is that the three things a batch
'' would combine are already ordered by the loop: QUIT ends it, TICK schedules,
'' and a redraw happens anyway.

'' ============================================================== the tick event

'' TUIEVENT_TICK is delivered by the loop, not by the input parser, so it lives
'' here rather than in RFC-0004's enum.
public const TUIEVENT_TICK = 250

public function TuiTickEvent( ) as TuiEvent
    dim as TuiEvent ev
    ev.kind = TUIEVENT_TICK
    return ev
end function

'' ============================================================== the app

'' Init RETURNS A COMMAND, as Bubbletea's does.
''
'' RFC-0009 section 1 declared it `sub`, which made it impossible for an
'' application to schedule anything at startup: the only way to arm a tick was
'' to return TuiTick from Update in response to a TUIEVENT_TICK that could never
'' arrive. examples/dashboard.bas looked correct and its graphs never moved.
public type TuiApp extends Object
    declare abstract function Init( ) as TuiCmd
    declare abstract function Update( byref e as TuiEvent ) as TuiCmd
    declare abstract sub View( byref f as TuiFrame )
    declare virtual sub Shutdown( )
    declare virtual destructor( )
end type

sub TuiApp.Shutdown( ) : end sub
destructor TuiApp( ) : end destructor

public type TuiRunResult as Result( of long, TuiError )

'' ============================================================== the clock

'' A monotonic millisecond reading, from fb/chrono.bi's Stopwatch -- which is
'' backed by a real monotonic source, not by the wall clock. A frame budget
'' driven by wall time would stutter whenever the clock was adjusted.
public function TuiClockMs( ) as double
    static as Stopwatch sw = Stopwatch.StartNew( )
    return sw.Elapsed.TotalMilliseconds
end function

'' ============================================================== the loop

public type TuiRunOptions
    as long fps                 '' 0 = the default 60
    as boolean quitOnCtrlC      '' synthesise a quit on Ctrl+C (raw mode eats it)
end type

public function TuiRunOptionsDefault( ) as TuiRunOptions
    dim as TuiRunOptions o
    o.fps = 60
    o.quitOnCtrlC = TRUE
    return o
end function

'' Returns the application's exit code, or the TuiError that stopped it from
'' starting -- a program whose stdout is a pipe gets TUIERR_NOTATTY here and can
'' print an honest message instead of drawing a dashboard into a file.
public function TuiRun overload( byref app as TuiApp, _
                                 byval opts as TuiTermOptions, _
                                 byval runOpts as TuiRunOptions ) as TuiRunResult
    dim as TuiTerminal term

    dim as TuiUnitResult er = term.Enter( opts )
    if( er.IsOk( ) = false ) then
        return Fail( of long, TuiError )( er.Failure( ) )
    end if

    '' THE DEFER IS AT PROCEDURE SCOPE. Inside the `if` that checked Enter it
    '' would fire at END IF, restoring the terminal before the loop ran --
    '' measured in phase 1, not assumed.
    defer term.Leave( )

    dim as TuiScreen scr
    dim as TuiInput keys
    dim as long exitCode = 0

    dim as TuiSizeResult sz = term.Size( )
    if( sz.IsOk( ) ) then
        scr.Resize( sz.Value( ).cols, sz.Value( ).rows )
    else
        scr.Resize( 80, 24 )
    end if
    scr.Invalidate( )

    dim as long fps = iif( runOpts.fps > 0, runOpts.fps, 60 )
    dim as double frameMs = 1000.0 / fps
    dim as double nextFrame = TuiClockMs( )
    dim as double tickAt = -1.0
    dim as boolean dirty = TRUE
    dim as boolean running = TRUE
    dim as long exitFromInit = 0

    '' whatever Init asks for is honoured before the first poll
    dim as TuiCmd initCmd = app.Init( )
    select case initCmd.kind
    case TUICMD_TICK       : tickAt = TuiClockMs( ) + initCmd.arg
    case TUICMD_INVALIDATE : scr.Invalidate( )
    case TUICMD_QUIT       : exitFromInit = initCmd.arg : running = FALSE
    end select
    if( running = FALSE ) then
        app.Shutdown( )
        return Ok( of long, TuiError )( exitFromInit )
    end if

    while( running )
        '' the budget is whatever is left before the next frame, capped by the
        '' next pending tick
        dim as double now_ = TuiClockMs( )
        dim as double budget = nextFrame - now_
        if( budget < 0.0 ) then budget = 0.0
        if( tickAt >= 0.0 ) then
            dim as double untilTick = tickAt - now_
            if( untilTick < 0.0 ) then untilTick = 0.0
            if( untilTick < budget ) then budget = untilTick
        end if
        if( dirty = FALSE ) then
            '' NOTHING DIRTY, NOTHING DRAWN: block for the whole budget rather
            '' than spinning. An idle TUI uses no CPU.
            if( tickAt < 0.0 ) then budget = 250.0
        end if

        dim as TuiEventOpt ev = PollEvent( term, keys, clng( budget ) )

        '' EVENTS ARE DRAINED BEFORE RENDERING. A held arrow key or a mouse
        '' drag delivers faster than the frame rate; the loop applies every
        '' pending event and renders ONCE, so the frame reflects the latest
        '' state rather than lagging behind a queue it can never catch up with.
        while( ev.HasValue( ) )
            dim as TuiEvent tev = ev.Value( )

            if( tev.kind = TUIEVENT_RESIZE ) then
                if( ( tev.size.cols > 0 ) andalso ( tev.size.rows > 0 ) ) then
                    scr.Resize( tev.size.cols, tev.size.rows )
                end if
                scr.Invalidate( )
            end if

            if( runOpts.quitOnCtrlC ) then
                '' Hoisted to explicit boolean locals: IsChar( ) and HasMod( )
                '' return bare booleans, and mixing those with comparison
                '' results in one andalso chain is warning 38. RFC-0001 s3.
                dim as boolean isKey = ( tev.kind = TUIEVENT_KEY )
                dim as boolean isC = ( tev.key.ch = 99 )        '' asc( "c" )
                dim as boolean wasChar = tev.key.IsChar( )
                dim as boolean hasCtrl = tev.key.HasMod( TUIMOD_CTRL )
                if( isKey andalso wasChar andalso isC andalso hasCtrl ) then
                    running = FALSE
                    exit while
                end if
            end if

            dim as TuiCmd cmd = app.Update( tev )
            dirty = TRUE

            select case cmd.kind
            case TUICMD_QUIT
                exitCode = cmd.arg
                running = FALSE
                exit while
            case TUICMD_TICK
                tickAt = TuiClockMs( ) + cmd.arg
            case TUICMD_INVALIDATE
                scr.Invalidate( )
            case TUICMD_SUSPEND
                '' Ctrl+Z does not suspend in raw mode -- ISIG is cleared -- so
                '' the application must do it deliberately.
                term.Leave( )
                #ifndef __FB_WIN32__
                    tui_raise( 20 )         '' SIGTSTP
                #endif
                term.Enter( opts )
                scr.Invalidate( )
            end select

            ev = PollEvent( term, keys, 0 )     '' drain, without waiting
        wend

        if( running = FALSE ) then exit while

        '' a due tick becomes an event
        if( ( tickAt >= 0.0 ) andalso ( TuiClockMs( ) >= tickAt ) ) then
            tickAt = -1.0
            dim as TuiEvent te = TuiTickEvent( )
            dim as TuiCmd cmd = app.Update( te )
            dirty = TRUE
            select case cmd.kind
            case TUICMD_QUIT       : exitCode = cmd.arg : running = FALSE
            case TUICMD_TICK       : tickAt = TuiClockMs( ) + cmd.arg
            case TUICMD_INVALIDATE : scr.Invalidate( )
            end select
            if( running = FALSE ) then exit while
        end if

        if( dirty andalso ( TuiClockMs( ) >= nextFrame ) ) then
            dim as TuiFrame ptr f = scr.BeginFrame( )
            app.View( *f )
            term.Write( scr.Render( term.Caps( ).depth ) )
            dim as TuiUnitResult wr = term.Flush( )
            if( wr.IsOk( ) = false ) then
                app.Shutdown( )
                return Fail( of long, TuiError )( wr.Failure( ) )
            end if
            dirty = FALSE
            nextFrame = TuiClockMs( ) + frameMs
        end if
    wend

    app.Shutdown( )
    return Ok( of long, TuiError )( exitCode )
end function

public function TuiRun overload( byref app as TuiApp, byval opts as TuiTermOptions ) as TuiRunResult
    return TuiRun( app, opts, TuiRunOptionsDefault( ) )
end function

'' ============================================================== headless

'' Runs one Init/View cycle against a screen with no terminal at all, and
'' returns the bytes the renderer would have written.
''
'' This exists because the loop above cannot be unit-tested -- it needs a tty --
'' while the thing worth testing is that an app's View produces the right
'' frame. It is also what the phase-8 performance measurement drives.
public function TuiRenderOnce( byref app as TuiApp, byref scr as TuiScreen, _
                                byval depth as TuiColorDepth = TUIDEPTH_TRUECOLOR ) as string
    dim as TuiFrame ptr f = scr.BeginFrame( )
    app.View( *f )
    return scr.Render( depth )
end function

