#module "tui"
#import "std/outcome"
#import "std/containers"
using outcome
using containers
'' std/tui: tuiform -- the input widgets
''
'' RFC-0008 section 4 -- C:\dev\docs\tui\RFC-0008-widget-catalogue.md.
''
'' TextInput, TextArea, Checkbox, RadioGroup, Select.
''
'' ---------------------------------------------------------------------------
'' TWO DIFFERENT UNITS, AND THEY ARE NAMED TO SAY SO
''
''     cursor    a CODE UNIT index into the text
''     scrollX   a COLUMN offset for display
''
'' They are not interchangeable and conflating them is how a text field ends up
'' one column out on the first accented character. Every cursor move goes
'' through grapheme stepping, so the cursor can never land between a surrogate
'' pair or between a base character and its combining mark.


#ifdef __FB_WIN32__
    #include once "windows.bi"
#else
    #include once "crt.bi"
#endif


'' ============================================================== stepping

'' The index of the grapheme cluster BEFORE i. TuiNextGrapheme walks forward
'' only, so stepping back means walking from the start -- O(n) per keystroke,
'' which at terminal line lengths is nothing.
public function TuiPrevGraphemeIdx( byref s as ustring, byval i as long ) as long
    if( i <= 0 ) then return 0
    dim as long prev_ = 0, at_ = 0
    while( at_ < i )
        dim as long w = 0
        dim as long nxt = TuiNextGrapheme( s, at_, w )
        if( nxt <= at_ ) then exit while
        if( nxt >= i ) then return at_
        prev_ = at_
        at_ = nxt
    wend
    return prev_
end function

public function TuiNextGraphemeIdx( byref s as ustring, byval i as long ) as long
    dim as long w = 0
    dim as long nxt = TuiNextGrapheme( s, i, w )
    if( nxt <= i ) then return len( s )
    return nxt
end function

'' The column offset of a code-unit index -- the bridge between the two units.
public function TuiColumnOf( byref s as ustring, byval idx as long ) as long
    if( idx <= 0 ) then return 0
    dim as long col = 0, at_ = 0
    while( at_ < idx )
        dim as long w = 0
        dim as long nxt = TuiNextGrapheme( s, at_, w )
        if( nxt <= at_ ) then exit while
        col += w
        at_ = nxt
    wend
    return col
end function

'' Word stepping, for Ctrl+Left / Ctrl+Right.
public function TuiIsWordChar( byval cp as ulong ) as boolean
    if( ( cp >= asc( "0" ) ) andalso ( cp <= asc( "9" ) ) ) then return TRUE
    if( ( cp >= asc( "A" ) ) andalso ( cp <= asc( "Z" ) ) ) then return TRUE
    if( ( cp >= asc( "a" ) ) andalso ( cp <= asc( "z" ) ) ) then return TRUE
    if( cp = asc( "_" ) ) then return TRUE
    if( cp > 127 ) then return TRUE          '' any non-ASCII letter counts
    return FALSE
end function

'' ============================================================== text input

public type TuiTextInputState
    as ustring text
    as long cursor              '' CODE UNITS
    as long selAnchor           '' -1 = no selection
    as long scrollX             '' COLUMNS
end type

public sub TuiTextInputStateInit( byref s as TuiTextInputState )
    s.text = ""
    s.cursor = 0
    s.selAnchor = -1
    s.scrollX = 0
end sub

public type TuiTextInput extends TuiWidget
    as TuiTextInputState ptr state      '' CALLER-OWNED, never deleted here
    as ustring placeholder
    as TuiStyle normal, focused_, placeholderStyle, selectionStyle
    as boolean password
    as long maxLen                      '' 0 = unlimited, counted in CODE UNITS
    as boolean isFocused

    declare sub Render( byref f as TuiFrame, byval area as TuiRect ) override
    declare function Kind( ) as ustring override
    declare function HandleEvent( byref e as TuiEvent ) as boolean override
    declare function CanFocus( ) as boolean override
    declare sub SetFocused( byval on_ as boolean ) override
    declare function SizeHint( byval avail as TuiRect ) as TuiSize override

    declare function SelectionStart( ) as long
    declare function SelectionEnd( ) as long
    declare sub DeleteSelection( )
    declare sub Insert( byref t as ustring )

    private:
        as long lastW
        declare sub hScrollToCursor( )
end type

function TuiTextInput.Kind( ) as ustring : return "TextInput" : end function
function TuiTextInput.CanFocus( ) as boolean : return TRUE : end function
sub TuiTextInput.SetFocused( byval on_ as boolean ) : isFocused = on_ : end sub

function TuiTextInput.SizeHint( byval avail as TuiRect ) as TuiSize
    return TuiSizeOf( avail.w, 1 )
end function

function TuiTextInput.SelectionStart( ) as long
    if( state = 0 ) then return 0
    if( state->selAnchor < 0 ) then return state->cursor
    return iif( state->selAnchor < state->cursor, state->selAnchor, state->cursor )
end function

function TuiTextInput.SelectionEnd( ) as long
    if( state = 0 ) then return 0
    if( state->selAnchor < 0 ) then return state->cursor
    return iif( state->selAnchor > state->cursor, state->selAnchor, state->cursor )
end function

sub TuiTextInput.DeleteSelection( )
    if( state = 0 ) then exit sub
    if( state->selAnchor < 0 ) then exit sub
    dim as long a = SelectionStart( ), b = SelectionEnd( )
    if( b <= a ) then
        state->selAnchor = -1
        exit sub
    end if
    state->text = left( state->text, a ) & mid( state->text, b + 1 )
    state->cursor = a
    state->selAnchor = -1
end sub

'' A paste arrives here as ONE edit, which is the entire point of bracketed
'' paste: a pasted newline must not read as Enter.
sub TuiTextInput.Insert( byref t as ustring )
    if( state = 0 ) then exit sub
    DeleteSelection( )

    dim as ustring add_ = t
    if( maxLen > 0 ) then
        dim as long room = maxLen - len( state->text )
        if( room <= 0 ) then exit sub
        if( len( add_ ) > room ) then add_ = left( add_, room )
    end if

    state->text = left( state->text, state->cursor ) & add_ & mid( state->text, state->cursor + 1 )
    state->cursor += len( add_ )
end sub

'' The scroll follows the cursor, in COLUMNS.
sub TuiTextInput.hScrollToCursor( )
    if( state = 0 ) then exit sub
    dim as long w = iif( lastW > 0, lastW, 1 )
    dim as long col = TuiColumnOf( state->text, state->cursor )
    if( state->scrollX > col ) then state->scrollX = col
    if( col - state->scrollX >= w ) then state->scrollX = col - w + 1
    if( state->scrollX < 0 ) then state->scrollX = 0
end sub

sub TuiTextInput.Render( byref f as TuiFrame, byval area as TuiRect )
    if( area.IsEmpty( ) ) then exit sub
    if( state = 0 ) then exit sub
    lastW = area.w
    hScrollToCursor( )

    dim as TuiStyle base_ = iif( isFocused, focused_, normal )
    f.FillRect( TuiRectOf( area.x, area.y, area.w, 1 ), " ", base_ )

    '' A SECONDARY STYLE MUST COMPOSE WITH THE FIELD'S, NOT REPLACE IT.
    ''
    '' SetCell assigns the style outright, so drawing the placeholder with a
    '' style whose bg is "default" ERASES the field's background -- a focused
    '' input rendered its blue fill, then punched a black hole through it
    '' exactly the width of the placeholder. Patch( ) is what RFC-0001 section
    '' 4's mask exists for: the placeholder contributes a foreground and
    '' inherits everything it does not name.
    if( len( state->text ) = 0 ) then
        if( len( placeholder ) > 0 ) then
            f.DrawText( area.x, area.y, TuiTruncate( placeholder, area.w ), _
                        base_.Patch( placeholderStyle ) )
        end if
        if( isFocused ) then f.SetCursor( area.x, area.y )
        exit sub
    end if

    dim as long selA = SelectionStart( ), selB = SelectionEnd( )
    dim as long at_ = 0, col = 0
    while( at_ < len( state->text ) )
        dim as long w = 0
        dim as long nxt = TuiNextGrapheme( state->text, at_, w )
        if( nxt <= at_ ) then exit while

        dim as long screenCol = col - state->scrollX
        if( screenCol >= area.w ) then exit while
        if( screenCol >= 0 ) then
            dim as ustring g
            if( password ) then
                TuiAppendCp( g, &h2022 )        '' BULLET
            else
                g = mid( state->text, at_ + 1, nxt - at_ )
            end if
            dim as boolean hasSel = ( state->selAnchor >= 0 )
            dim as boolean inRange = ( at_ >= selA ) andalso ( at_ < selB )
            dim as TuiStyle cellStyle = base_
            if( hasSel andalso inRange ) then cellStyle = base_.Patch( selectionStyle )
            f.DrawText( area.x + screenCol, area.y, g, cellStyle )
        end if

        col += w
        at_ = nxt
    wend

    if( isFocused ) then
        dim as long cc = TuiColumnOf( state->text, state->cursor ) - state->scrollX
        if( cc < 0 ) then cc = 0
        if( cc > area.w - 1 ) then cc = area.w - 1
        f.SetCursor( area.x + cc, area.y )
    end if
end sub

function TuiTextInput.HandleEvent( byref e as TuiEvent ) as boolean
    if( isFocused = FALSE ) then return FALSE
    if( state = 0 ) then return FALSE

    '' A PASTE IS ONE EDIT. Not a burst of keys.
    if( e.kind = TUIEVENT_PASTE ) then
        Insert( e.text )
        return TRUE
    end if
    if( e.kind <> TUIEVENT_KEY ) then return FALSE

    dim as boolean shift = e.key.HasMod( TUIMOD_SHIFT )
    dim as boolean ctrl = e.key.HasMod( TUIMOD_CTRL )

    '' a movement key with Shift starts or extends a selection; without it,
    '' collapses one
    dim as boolean isMove = FALSE
    select case e.key.code
    case TUIKEY_LEFT, TUIKEY_RIGHT, TUIKEY_HOME, TUIKEY_END_ : isMove = TRUE
    end select
    if( isMove ) then
        if( shift ) then
            if( state->selAnchor < 0 ) then state->selAnchor = state->cursor
        else
            state->selAnchor = -1
        end if
    end if

    select case e.key.code
    case TUIKEY_LEFT
        if( ctrl ) then
            '' skip the run of non-word chars, then the word
            dim as long i = state->cursor
            while( i > 0 )
                dim as long p = TuiPrevGraphemeIdx( state->text, i )
                dim as long adv = 0
                if( TuiIsWordChar( TuiDecodeAt( state->text, p, adv ) ) ) then exit while
                i = p
            wend
            while( i > 0 )
                dim as long p = TuiPrevGraphemeIdx( state->text, i )
                dim as long adv = 0
                if( TuiIsWordChar( TuiDecodeAt( state->text, p, adv ) ) = FALSE ) then exit while
                i = p
            wend
            state->cursor = i
        else
            state->cursor = TuiPrevGraphemeIdx( state->text, state->cursor )
        end if
        hScrollToCursor( )
        return TRUE

    case TUIKEY_RIGHT
        if( ctrl ) then
            dim as long i = state->cursor, n = len( state->text )
            while( i < n )
                dim as long adv = 0
                if( TuiIsWordChar( TuiDecodeAt( state->text, i, adv ) ) = FALSE ) then exit while
                i = TuiNextGraphemeIdx( state->text, i )
            wend
            while( i < n )
                dim as long adv = 0
                if( TuiIsWordChar( TuiDecodeAt( state->text, i, adv ) ) ) then exit while
                i = TuiNextGraphemeIdx( state->text, i )
            wend
            state->cursor = i
        else
            state->cursor = TuiNextGraphemeIdx( state->text, state->cursor )
        end if
        hScrollToCursor( )
        return TRUE

    case TUIKEY_HOME
        state->cursor = 0
        hScrollToCursor( )
        return TRUE

    case TUIKEY_END_
        state->cursor = len( state->text )
        hScrollToCursor( )
        return TRUE

    case TUIKEY_BACKSPACE
        if( state->selAnchor >= 0 ) then
            DeleteSelection( )
        elseif( state->cursor > 0 ) then
            dim as long p = TuiPrevGraphemeIdx( state->text, state->cursor )
            state->text = left( state->text, p ) & mid( state->text, state->cursor + 1 )
            state->cursor = p
        end if
        hScrollToCursor( )
        return TRUE

    case TUIKEY_DELETE
        if( state->selAnchor >= 0 ) then
            DeleteSelection( )
        elseif( state->cursor < len( state->text ) ) then
            dim as long nxt = TuiNextGraphemeIdx( state->text, state->cursor )
            state->text = left( state->text, state->cursor ) & mid( state->text, nxt + 1 )
        end if
        hScrollToCursor( )
        return TRUE
    end select

    '' Ctrl+A selects all
    if( ctrl andalso e.key.IsChar( ) andalso ( e.key.ch = asc( "a" ) ) ) then
        state->selAnchor = 0
        state->cursor = len( state->text )
        hScrollToCursor( )
        return TRUE
    end if

    '' a printable character inserts. Control characters do not.
    if( e.key.IsChar( ) andalso ( ctrl = FALSE ) andalso ( e.key.ch >= 32 ) ) then
        Insert( e.text )
        hScrollToCursor( )
        return TRUE
    end if

    return FALSE
end function

'' ============================================================== text area

'' TextInput's model over a line array. Enter INSERTS rather than consuming.
public type TuiTextAreaState
    as TuiStringArray lines_
    as long cursorLine
    as long cursorCol           '' CODE UNITS within the line
    as long offsetY
end type

public sub TuiTextAreaStateInit( byref s as TuiTextAreaState )
    s.lines_.Clear( )
    s.lines_.Push( "" )
    s.cursorLine = 0
    s.cursorCol = 0
    s.offsetY = 0
end sub

public type TuiTextArea extends TuiWidget
    as TuiTextAreaState ptr state
    as TuiStyle normal, focused_
    as boolean showGutter
    as TuiStyle gutterStyle
    as boolean isFocused

    declare sub Render( byref f as TuiFrame, byval area as TuiRect ) override
    declare function Kind( ) as ustring override
    declare function HandleEvent( byref e as TuiEvent ) as boolean override
    declare function CanFocus( ) as boolean override
    declare sub SetFocused( byval on_ as boolean ) override

    private:
        as long lastH
        declare sub hClamp( )
end type

function TuiTextArea.Kind( ) as ustring : return "TextArea" : end function
function TuiTextArea.CanFocus( ) as boolean : return TRUE : end function
sub TuiTextArea.SetFocused( byval on_ as boolean ) : isFocused = on_ : end sub

sub TuiTextArea.hClamp( )
    if( state = 0 ) then exit sub
    if( state->lines_.Count( ) = 0 ) then state->lines_.Push( "" )
    if( state->cursorLine < 0 ) then state->cursorLine = 0
    if( state->cursorLine >= state->lines_.Count( ) ) then state->cursorLine = state->lines_.Count( ) - 1
    dim as long n = len( state->lines_[ state->cursorLine ] )
    if( state->cursorCol < 0 ) then state->cursorCol = 0
    if( state->cursorCol > n ) then state->cursorCol = n

    dim as long h = iif( lastH > 0, lastH, 1 )
    if( state->offsetY > state->cursorLine ) then state->offsetY = state->cursorLine
    if( state->cursorLine >= state->offsetY + h ) then state->offsetY = state->cursorLine - h + 1
    if( state->offsetY < 0 ) then state->offsetY = 0
end sub

sub TuiTextArea.Render( byref f as TuiFrame, byval area as TuiRect )
    if( area.IsEmpty( ) ) then exit sub
    if( state = 0 ) then exit sub
    lastH = area.h
    hClamp( )

    dim as TuiStyle base_ = iif( isFocused, focused_, normal )
    f.FillRect( area, " ", base_ )

    dim as long gw = 0
    if( showGutter ) then
        gw = len( str( state->lines_.Count( ) ) ) + 1
        if( gw > area.w ) then gw = area.w
    end if

    for row as long = 0 to area.h - 1
        dim as long i = state->offsetY + row
        if( i >= state->lines_.Count( ) ) then exit for
        if( gw > 0 ) then
            f.DrawText( area.x, area.y + row, TuiTruncate( str( i + 1 ), gw - 1 ), gutterStyle )
        end if
        f.DrawText( area.x + gw, area.y + row, _
                    TuiTruncate( state->lines_[i], area.w - gw ), base_ )
    next

    if( isFocused ) then
        dim as long cy = area.y + ( state->cursorLine - state->offsetY )
        dim as long cx = area.x + gw + TuiColumnOf( state->lines_[ state->cursorLine ], state->cursorCol )
        if( cx > area.Right( ) - 1 ) then cx = area.Right( ) - 1
        if( ( cy >= area.y ) andalso ( cy < area.Bottom( ) ) ) then f.SetCursor( cx, cy )
    end if
end sub

function TuiTextArea.HandleEvent( byref e as TuiEvent ) as boolean
    if( isFocused = FALSE ) then return FALSE
    if( state = 0 ) then return FALSE
    hClamp( )

    if( e.kind = TUIEVENT_PASTE ) then
        '' a multi-line paste splits into lines, as one edit
        dim as TuiStringArray parts = TuiWrap( e.text, 1000000 )
        if( parts.Count( ) > 0 ) then
            dim as ustring cur = state->lines_[ state->cursorLine ]
            dim as ustring tailPart = mid( cur, state->cursorCol + 1 )
            state->lines_[ state->cursorLine ] = left( cur, state->cursorCol ) & parts[0]
            for i as long = 1 to parts.Count( ) - 1
                state->lines_.Insert( state->cursorLine + i, parts[i] )
            next
            state->cursorLine += parts.Count( ) - 1
            state->cursorCol = len( state->lines_[ state->cursorLine ] )
            state->lines_[ state->cursorLine ] &= tailPart
        end if
        hClamp( )
        return TRUE
    end if
    if( e.kind <> TUIEVENT_KEY ) then return FALSE

    dim as long h = iif( lastH > 0, lastH, 1 )
    select case e.key.code
    case TUIKEY_UP       : state->cursorLine -= 1
    case TUIKEY_DOWN     : state->cursorLine += 1
    case TUIKEY_PAGEUP   : state->cursorLine -= h
    case TUIKEY_PAGEDOWN : state->cursorLine += h
    case TUIKEY_HOME     : state->cursorCol = 0
    case TUIKEY_END_     : state->cursorCol = len( state->lines_[ state->cursorLine ] )
    case TUIKEY_LEFT
        if( state->cursorCol > 0 ) then
            state->cursorCol = TuiPrevGraphemeIdx( state->lines_[ state->cursorLine ], state->cursorCol )
        elseif( state->cursorLine > 0 ) then
            state->cursorLine -= 1
            state->cursorCol = len( state->lines_[ state->cursorLine ] )
        end if
    case TUIKEY_RIGHT
        dim as long n = len( state->lines_[ state->cursorLine ] )
        if( state->cursorCol < n ) then
            state->cursorCol = TuiNextGraphemeIdx( state->lines_[ state->cursorLine ], state->cursorCol )
        elseif( state->cursorLine < state->lines_.Count( ) - 1 ) then
            state->cursorLine += 1
            state->cursorCol = 0
        end if
    case TUIKEY_ENTER
        '' ENTER INSERTS a newline here, unlike TextInput where it commits
        dim as ustring cur = state->lines_[ state->cursorLine ]
        state->lines_[ state->cursorLine ] = left( cur, state->cursorCol )
        state->lines_.Insert( state->cursorLine + 1, mid( cur, state->cursorCol + 1 ) )
        state->cursorLine += 1
        state->cursorCol = 0
    case TUIKEY_BACKSPACE
        if( state->cursorCol > 0 ) then
            dim as ustring cur = state->lines_[ state->cursorLine ]
            dim as long p = TuiPrevGraphemeIdx( cur, state->cursorCol )
            state->lines_[ state->cursorLine ] = left( cur, p ) & mid( cur, state->cursorCol + 1 )
            state->cursorCol = p
        elseif( state->cursorLine > 0 ) then
            dim as ustring cur = state->lines_[ state->cursorLine ]
            state->lines_.Remove( state->cursorLine )
            state->cursorLine -= 1
            state->cursorCol = len( state->lines_[ state->cursorLine ] )
            state->lines_[ state->cursorLine ] &= cur
        end if
    case else
        if( e.key.IsChar( ) andalso ( e.key.HasMod( TUIMOD_CTRL ) = FALSE ) andalso ( e.key.ch >= 32 ) ) then
            dim as ustring cur = state->lines_[ state->cursorLine ]
            state->lines_[ state->cursorLine ] = left( cur, state->cursorCol ) & e.text & mid( cur, state->cursorCol + 1 )
            state->cursorCol += len( e.text )
        else
            return FALSE
        end if
    end select

    hClamp( )
    return TRUE
end function

'' ============================================================== checkbox

public type TuiCheckbox extends TuiWidget
    as ustring label
    as boolean ptr checked      '' CALLER-OWNED
    as TuiStyle normal, focused_
    as boolean useUnicode
    as boolean isFocused

    declare sub Render( byref f as TuiFrame, byval area as TuiRect ) override
    declare function Kind( ) as ustring override
    declare function HandleEvent( byref e as TuiEvent ) as boolean override
    declare function CanFocus( ) as boolean override
    declare sub SetFocused( byval on_ as boolean ) override
end type

function TuiCheckbox.Kind( ) as ustring : return "Checkbox" : end function
function TuiCheckbox.CanFocus( ) as boolean : return TRUE : end function
sub TuiCheckbox.SetFocused( byval on_ as boolean ) : isFocused = on_ : end sub

sub TuiCheckbox.Render( byref f as TuiFrame, byval area as TuiRect )
    if( area.IsEmpty( ) ) then exit sub
    dim as TuiStyle st = iif( isFocused, focused_, normal )
    dim as boolean on_ = ( checked <> 0 ) andalso ( *checked )

    dim as ustring box
    if( useUnicode ) then
        TuiAppendCp( box, iif( on_, &h2611, &h2610 ) )
    else
        box = iif( on_, "[x]", "[ ]" )
    end if

    f.FillRect( TuiRectOf( area.x, area.y, area.w, 1 ), " ", st )
    dim as long used = f.DrawText( area.x, area.y, box, st )
    f.DrawText( area.x + used + 1, area.y, TuiTruncate( label, area.w - used - 1 ), st )
end sub

function TuiCheckbox.HandleEvent( byref e as TuiEvent ) as boolean
    if( isFocused = FALSE ) then return FALSE
    if( checked = 0 ) then return FALSE
    if( e.kind <> TUIEVENT_KEY ) then return FALSE
    if( ( e.key.code <> TUIKEY_ENTER ) andalso ( e.key.ch <> TUI_SPACE ) ) then return FALSE
    *checked = not *checked
    return TRUE
end function

'' ============================================================== radio group

public type TuiRadioGroup extends TuiWidget
    as TuiStringArray options
    as long ptr selected        '' CALLER-OWNED
    as TuiStyle normal, focused_, activeStyle
    as boolean horizontal
    as boolean useUnicode
    as boolean isFocused

    declare sub Render( byref f as TuiFrame, byval area as TuiRect ) override
    declare function Kind( ) as ustring override
    declare function HandleEvent( byref e as TuiEvent ) as boolean override
    declare function CanFocus( ) as boolean override
    declare sub SetFocused( byval on_ as boolean ) override
end type

function TuiRadioGroup.Kind( ) as ustring : return "RadioGroup" : end function
function TuiRadioGroup.CanFocus( ) as boolean : return TRUE : end function
sub TuiRadioGroup.SetFocused( byval on_ as boolean ) : isFocused = on_ : end sub

sub TuiRadioGroup.Render( byref f as TuiFrame, byval area as TuiRect )
    if( area.IsEmpty( ) ) then exit sub
    dim as long sel = iif( selected <> 0, *selected, -1 )
    dim as TuiStyle base_ = iif( isFocused, focused_, normal )

    dim as long x = area.x, y = area.y
    for i as long = 0 to options.Count( ) - 1
        dim as ustring dot_
        if( useUnicode ) then
            TuiAppendCp( dot_, iif( i = sel, &h25C9, &h25CB ) )
        else
            dot_ = iif( i = sel, "(*)", "( )" )
        end if
        '' The selected option composes the accent OVER the group's style, so a
        '' focused group highlights every option and the selected one also
        '' takes its accent colour. Replacing instead of patching inverted it:
        '' the unselected options looked focused and the selected one did not.
        dim as TuiStyle st = base_
        if( i = sel ) then st = base_.Patch( activeStyle )

        if( horizontal ) then
            if( x >= area.Right( ) ) then exit for
            x += f.DrawText( x, y, dot_, st )
            x += f.DrawText( x, y, " " & TuiTruncate( options[i], area.Right( ) - x - 1 ), st )
            x += 1
        else
            if( y >= area.Bottom( ) ) then exit for
            dim as long used = f.DrawText( area.x, y, dot_, st )
            f.DrawText( area.x + used + 1, y, TuiTruncate( options[i], area.w - used - 1 ), st )
            y += 1
        end if
    next
end sub

function TuiRadioGroup.HandleEvent( byref e as TuiEvent ) as boolean
    if( isFocused = FALSE ) then return FALSE
    if( selected = 0 ) then return FALSE
    if( e.kind <> TUIEVENT_KEY ) then return FALSE
    if( options.Count( ) = 0 ) then return FALSE

    dim as long d = 0
    if( horizontal ) then
        if( e.key.code = TUIKEY_LEFT ) then d = -1
        if( e.key.code = TUIKEY_RIGHT ) then d = 1
    else
        if( e.key.code = TUIKEY_UP ) then d = -1
        if( e.key.code = TUIKEY_DOWN ) then d = 1
    end if
    if( d = 0 ) then return FALSE

    dim as long n = options.Count( )
    *selected = ( ( *selected + d ) mod n + n ) mod n
    return TRUE
end function

'' ============================================================== select

public type TuiSelectState
    as long selected
    as boolean open_
    as long highlight
end type

'' When open, this draws into a LAYER -- it is a popup and follows RFC-0003
'' section 4's rules, so what is beneath it survives dismissal.
public type TuiSelect extends TuiWidget
    as TuiStringArray options
    as TuiSelectState ptr state
    as TuiStyle normal, focused_, listStyle, highlightStyle
    as long maxVisible
    as boolean isFocused

    declare sub Render( byref f as TuiFrame, byval area as TuiRect ) override
    declare function Kind( ) as ustring override
    declare function HandleEvent( byref e as TuiEvent ) as boolean override
    declare function CanFocus( ) as boolean override
    declare sub SetFocused( byval on_ as boolean ) override
    declare function IsOpen( ) as boolean
end type

function TuiSelect.Kind( ) as ustring : return "Select" : end function
function TuiSelect.CanFocus( ) as boolean : return TRUE : end function
sub TuiSelect.SetFocused( byval on_ as boolean ) : isFocused = on_ : end sub

function TuiSelect.IsOpen( ) as boolean
    if( state = 0 ) then return FALSE
    return state->open_
end function

sub TuiSelect.Render( byref f as TuiFrame, byval area as TuiRect )
    if( area.IsEmpty( ) ) then exit sub
    if( state = 0 ) then exit sub

    dim as TuiStyle st = iif( isFocused, focused_, normal )
    f.FillRect( TuiRectOf( area.x, area.y, area.w, 1 ), " ", st )

    dim as ustring cur = ""
    if( ( state->selected >= 0 ) andalso ( state->selected < options.Count( ) ) ) then
        cur = options[ state->selected ]
    end if
    dim as ustring arrow
    TuiAppendCp( arrow, iif( state->open_, &h25B2, &h25BC ) )

    f.DrawText( area.x, area.y, TuiTruncate( cur, area.w - 2 ), st )
    if( area.w >= 1 ) then f.DrawText( area.Right( ) - 1, area.y, arrow, st )

    if( state->open_ = FALSE ) then exit sub

    dim as long vis = iif( maxVisible > 0, maxVisible, 6 )
    if( vis > options.Count( ) ) then vis = options.Count( )
    if( vis <= 0 ) then exit sub

    dim as TuiRect drop = TuiRectOf( area.x, area.y + 1, area.w, vis )
    f.PushLayer( drop )
    f.FillRect( drop, " ", listStyle )
    for i as long = 0 to vis - 1
        if( i >= options.Count( ) ) then exit for
        dim as TuiStyle ls = iif( i = state->highlight, highlightStyle, listStyle )
        f.FillRect( TuiRectOf( drop.x, drop.y + i, drop.w, 1 ), " ", ls )
        f.DrawText( drop.x, drop.y + i, TuiTruncate( options[i], drop.w ), ls )
    next
    f.PopLayer( )
end sub

function TuiSelect.HandleEvent( byref e as TuiEvent ) as boolean
    if( isFocused = FALSE ) then return FALSE
    if( state = 0 ) then return FALSE
    if( e.kind <> TUIEVENT_KEY ) then return FALSE

    if( state->open_ = FALSE ) then
        if( ( e.key.code = TUIKEY_ENTER ) orelse ( e.key.ch = TUI_SPACE ) orelse ( e.key.code = TUIKEY_DOWN ) ) then
            state->open_ = TRUE
            state->highlight = state->selected
            if( state->highlight < 0 ) then state->highlight = 0
            return TRUE
        end if
        return FALSE
    end if

    '' OPEN: it is a popup, so it consumes what it uses and closes on Escape
    select case e.key.code
    case TUIKEY_UP     : state->highlight -= 1
    case TUIKEY_DOWN   : state->highlight += 1
    case TUIKEY_ESCAPE : state->open_ = FALSE : return TRUE
    case TUIKEY_ENTER
        state->selected = state->highlight
        state->open_ = FALSE
        return TRUE
    case else
        return FALSE
    end select

    dim as long n = options.Count( )
    if( n > 0 ) then state->highlight = ( ( state->highlight mod n ) + n ) mod n
    return TRUE
end function

