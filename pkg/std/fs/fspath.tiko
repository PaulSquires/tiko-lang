#module "fs"
#import "std/outcome"
#import "std/containers"
using outcome
using containers
'' std/fs: fspath -- fs.Path* , the pure path algebra
''
'' Specified in C:\dev\docs\filesystem\RFC-0002-path.md.
''
'' PURE. Nothing here touches the filesystem. A path is manipulated AS A STRING;
'' whether it names anything is fsinfo.tiko's question (RFC-0003). That is why
'' AbsolutePath and CanonicalPath are NOT here: the line this file draws is
'' syscalls, not subject matter.
''
'' FREE FUNCTIONS, NOT A Path TYPE. Go's choice, not Python's. A Path type would
'' have to pick one of STRING and USTRING and force a conversion at every
'' boundary with the other; every path is already a string when it arrives from
'' COMMAND or a config file and when it leaves to OPEN or SHELL; and the type is
'' additive later over these functions, while the reverse is not true. See
'' C:\dev\docs\filesystem\rationale.md.
''
'' THREE OVERLOADS PER FUNCTION, resolved on the FIRST argument alone, with
'' EVERY LATER PARAMETER A USTRING in all three -- the rule std/strings' string.tiko
'' establishes and the reason it gives: fbc ranks an overload on ALL of its
'' parameters, so per-family later parameters make the set ambiguous rather than
'' resolvable. Return type follows string.tiko too --
''
''     string, zstring  ->  string        (byte oriented, no encoding assumed)
''     wstring, ustring ->  ustring       (UTF-16 on every target)
''
'' THE USTRING FAMILY IS THE KERNEL. It aliases straight onto the C entry points
'' with no wrapper body, because a C function CAN return a FreeBASIC dynamic
'' string by handing back a temp descriptor -- which is how the whole std/strings
'' family already works. The STRING and WSTRING families are thin FB
'' bodies that widen, delegate, and narrow.
''
'' NARROWING IS LOSSY AND SAYS SO. A Windows path is a counted sequence of
'' UTF-16 code units and is not required to be well-formed -- NTFS permits
'' unpaired surrogates in file names. Through the STRING family such a path does
'' not survive the round trip, which means you cannot then open, delete or walk
'' it. Use the USTRING family for paths that came FROM the filesystem; the
'' STRING family is for literals and interop. RFC-0001 section 5.
''
'' THE `gram` PARAMETER selects the path grammar and defaults to the host's.
'' It is public so that fbc_tests.filesystem.path can evaluate Windows rules on
'' Linux and POSIX rules on Windows -- per the platform bug-class note, a
'' grammar reachable only on its own host is a grammar tested on one host.
'' Ordinary code never passes it.



#if __FB_LANG__ <> "fb"
    #error "std/fs requires -lang fb (it uses namespaces)"
#endif

#if defined( __FB_WIN32__ ) and ( not defined( __FB_64BIT__ ) )
    #define FBFSPATH_EXTERN extern "Windows"
#else
    #define FBFSPATH_EXTERN extern "C"
#endif

'' Must match FB_PATH_* in src/rtlib/fb_filesystem.h.
public const FB_PATH_POSIX = 0
public const FB_PATH_WIN32 = 1

#if defined( __FB_WIN32__ ) or defined( __FB_DOS__ ) or defined( __FB_CYGWIN__ )
    public const FB_PATH_NATIVE = FB_PATH_WIN32
#else
    public const FB_PATH_NATIVE = FB_PATH_POSIX
#endif


FBFSPATH_EXTERN
    '' ------------------------------------------------------- interrogate
    public declare function PathRootLen overload alias "fb_UStrPathRootLen" _
        ( byref p as const ustring, byval gram as long = FB_PATH_NATIVE ) as integer

    '' Drive-relative "C:foo" and rooted-no-drive "\foo" are both FALSE.
    '' They name a path relative to a per-drive or per-process current
    '' directory, and treating either as absolute is a real bug with real
    '' consequences (RFC-0002 section 1.2).
    public declare function PathIsAbsolute overload alias "fb_UStrPathIsAbsolute" _
        ( byref p as const ustring, byval gram as long = FB_PATH_NATIVE ) as boolean

    public declare function PathIsRoot overload alias "fb_UStrPathIsRoot" _
        ( byref p as const ustring, byval gram as long = FB_PATH_NATIVE ) as boolean

    '' Lexical, case-insensitive under the Windows grammar. Two different
    '' paths naming ONE file through a symlink compare UNEQUAL --
    '' CanonicalPath (RFC-0003) answers that question instead.
    public declare function PathEquals overload alias "fb_UStrPathEquals" _
        ( byref a as const ustring, byref b as const ustring, byval gram as long = FB_PATH_NATIVE ) as boolean

    '' Compares WHOLE COMPONENTS: "C:\abc" does not start with "C:\ab".
    public declare function PathStartsWith overload alias "fb_UStrPathStartsWith" _
        ( byref p as const ustring, byref prefix as const ustring, byval gram as long = FB_PATH_NATIVE ) as boolean

    '' --------------------------------------------------------- decompose
    public declare function PathRoot overload alias "fb_UStrPathRoot" _
        ( byref p as const ustring, byval gram as long = FB_PATH_NATIVE ) as ustring

    public declare function PathParent overload alias "fb_UStrPathParent" _
        ( byref p as const ustring, byval gram as long = FB_PATH_NATIVE ) as ustring

    public declare function PathFileName overload alias "fb_UStrPathFileName" _
        ( byref p as const ustring, byval gram as long = FB_PATH_NATIVE ) as ustring

    '' A dotfile has no extension, so PathStem( ".gitignore" ) is
    '' ".gitignore" and PathExtension( ".gitignore" ) is "". Matches Python,
    '' Rust and Go.
    public declare function PathStem overload alias "fb_UStrPathStem" _
        ( byref p as const ustring, byval gram as long = FB_PATH_NATIVE ) as ustring

    public declare function PathExtension overload alias "fb_UStrPathExtension" _
        ( byref p as const ustring, byval gram as long = FB_PATH_NATIVE ) as ustring

    '' --------------------------------------------------------- transform
    '' Collapses '.', resolves '..' LEXICALLY, removes duplicate separators,
    '' and removes a trailing separator except from a root. Does NOT touch
    '' the interior of a \\?\ path, where '..' is an ordinary name.
    ''
    '' Lexical is a documented limitation, not an oversight: resolving '..'
    '' properly means hitting the disk, which would make this fallible, slow
    '' and dependent on whether the path exists yet -- wrong for a function
    '' whose main use is BUILDING a path before creating it. Normalize to
    '' build, canonicalize to compare identity.
    public declare function PathNormalize overload alias "fb_UStrPathNormalize" _
        ( byref p as const ustring, byval gram as long = FB_PATH_NATIVE ) as ustring

    '' Separators to native and duplicates collapsed, but no '.' or '..'
    '' resolution. The module's fb_hConvertPath equivalent, differing in that
    '' it does not mutate its argument and does return a value.
    public declare function PathToNative overload alias "fb_UStrPathToNative" _
        ( byref p as const ustring, byval gram as long = FB_PATH_NATIVE ) as ustring

    '' ----------------------------------------------------------- compose
    '' Yields `b` when b is absolute or rooted -- b wins, a is DISCARDED.
    '' That discard is why PathJoin( base, userInput ) is a security
    '' consideration: check PathStartsWith afterwards if you need
    '' containment. Inserts exactly one separator and does NOT normalize.
    public declare function PathJoin overload alias "fb_UStrPathJoin2" _
        ( byref a as const ustring, byref b as const ustring, byval gram as long = FB_PATH_NATIVE ) as ustring

    '' Accepts the new extension with or without its dot. An empty ext
    '' removes the extension including the dot.
    public declare function PathChangeExtension overload alias "fb_UStrPathChangeExt" _
        ( byref p as const ustring, byref ext as const ustring, byval gram as long = FB_PATH_NATIVE ) as ustring

    '' Component cursor. Returns the offset of the component at or after
    '' `from`, writing its length, or -1 when exhausted. Never yields the
    '' root. PathSplit is built on this, so the C side never allocates.
    public declare function PathNextComponent overload alias "fb_UStrPathNextComp" _
        ( byref p as const ustring, byval gram as long, byval from as integer, byref outlen as integer ) as integer

    '' The one path entry point that can fail. Prefer PathRelativeTo below.
    declare function PathRelativeRaw overload alias "fb_UStrPathRelative" _
        ( byref p as const ustring, byref basePath as const ustring, byval gram as long, byref status as long ) as ustring
end extern

'' ------------------------------------------------------------- three-arg join
''
'' Fixed arity at two, three and four rather than variadic: FreeBASIC has no
'' clean variadic form for `byref as const ustring`, four covers essentially
'' every real call, and PathJoin( PathJoin( a, b ), c ) stays available. The
'' folds are left-associative and cost one temporary on a call that is not hot.
public declare function PathJoin overload ( byref a as const ustring, byref b as const ustring, byref c as const ustring, byval gram as long = FB_PATH_NATIVE ) as ustring
public declare function PathJoin overload ( byref a as const ustring, byref b as const ustring, byref c as const ustring, byref d as const ustring, byval gram as long = FB_PATH_NATIVE ) as ustring

public function PathJoin _
    ( _
        byref a as const ustring, byref b as const ustring, _
        byref c as const ustring, byval gram as long _
    ) as ustring

    return PathJoin( PathJoin( a, b, gram ), c, gram )
end function

public function PathJoin _
    ( _
        byref a as const ustring, byref b as const ustring, _
        byref c as const ustring, byref d as const ustring, byval gram as long _
    ) as ustring

    return PathJoin( PathJoin( PathJoin( a, b, gram ), c, gram ), d, gram )
end function

'' ------------------------------------------------------------------ PathSplit
''
'' Does NOT include the root as a component; PathRoot supplies the rest. The
'' round trip is normative (RFC-0002 section 3 rule 12): PathRoot joined with
'' these components reconstructs PathNormalize exactly.
public declare function PathSplit overload _
    ( _
        byref p as const ustring, byref comps as Array( of ustring ), _
        byval gram as long = FB_PATH_NATIVE _
    ) as long

public function PathSplit _
    ( _
        byref p as const ustring, byref comps as Array( of ustring ), _
        byval gram as long _
    ) as long

    dim as integer at = 0, clen = 0, start
    dim as long n = 0

    '' NORMALISED FIRST, and that is what makes rule 12's round trip hold:
    '' PathRoot joined with these components reconstructs PathNormalize
    '' exactly. Splitting the raw path would yield "." and ".." as
    '' components -- so the round trip would rebuild the INPUT rather than
    '' its normal form, and a caller iterating components would have to
    '' re-implement the collapsing itself.
    ''
    '' Rust's Path::components( ) normalises the same way and for the same
    '' reason; Python's PurePath.parts does not, and is the odd one out.
    '' Leading ".." in a relative path survive, because normalisation keeps
    '' them -- there is no root to clamp them against.
    dim as ustring np = PathNormalize( p, gram )

    comps.Clear( )

    do
        start = PathNextComponent( np, gram, at, clen )
        if( start < 0 ) then exit do

        comps.Push( mid( np, start + 1, clen ) )
        n += 1
        at = start + clen
    loop

    return n
end function

'' -------------------------------------------------------------- PathRelativeTo
''
'' Fails with FS_INVALID_PATH when the two paths have different roots --
'' different drives, one absolute and one relative, one UNC and one local. There
'' IS no relative path between C:\a and D:\b, and returning "..\..\D:\b" would
'' be a fabrication. Returns "." for two equal paths.
public declare function PathRelativeTo overload _
    ( _
        byref p as const ustring, byref basePath as const ustring, _
        byval gram as long = FB_PATH_NATIVE _
    ) as FsResultUStr

public function PathRelativeTo _
    ( _
        byref p as const ustring, byref basePath as const ustring, _
        byval gram as long _
    ) as FsResultUStr

    dim as long status = FS_OK
    dim as ustring r = PathRelativeRaw( p, basePath, gram, status )

    if( status <> FS_OK ) then
        return FsFail( of ustring )( cast( FsErrorCode, status ), "PathRelativeTo", p )
    end if

    return Ok( of ustring, FsError )( r )
end function

'' A dotfile has no extension, so this is FALSE for ".gitignore" -- the same
'' rule PathExtension applies, expressed as a predicate so callers do not have
'' to compare against "".
public declare function PathHasExtension overload ( byref p as const ustring, byval gram as long = FB_PATH_NATIVE ) as boolean

public function PathHasExtension( byref p as const ustring, byval gram as long ) as boolean
    return ( len( PathExtension( p, gram ) ) > 0 )
end function

'' ------------------------------------------------------------------ constants
public declare function PathSeparator overload ( byval gram as long = FB_PATH_NATIVE ) as ustring
public declare function PathIsCaseSensitive overload ( byval gram as long = FB_PATH_NATIVE ) as boolean

public function PathSeparator( byval gram as long ) as ustring
    if( gram = FB_PATH_WIN32 ) then return "\"
    return "/"
end function

'' A COMPILE-TIME, PER-PLATFORM answer, and deliberately not a per-volume one.
'' Lexical path comparison must be deterministic and must not do IO. The
'' per-volume question -- "will these two names collide on this disk" -- is
'' VolumeInfo.IsCaseSensitive in RFC-0008, and the two genuinely disagree: an
'' NTFS directory with per-directory case sensitivity enabled (WSL sets this),
'' or a case-insensitive filesystem mounted on Linux.
public function PathIsCaseSensitive( byval gram as long ) as boolean
    return ( gram <> FB_PATH_WIN32 )
end function

'' ------------------------------------------------- the STRING/WSTRING families
''
'' Thin bodies over the USTRING kernel. They widen, delegate and narrow, and the
'' narrowing is the lossy step documented at the top of this file.
''
'' ZSTRING is served by the STRING overload through fbc's own implicit
'' conversion, which for bytes-to-bytes is exact and involves no locale -- so
'' all four string types work and you never name which one you are using.

#macro FBFS_PATH1_OVERLOADS( fname )
    public declare function fname overload ( byref p as const string,  byval gram as long = FB_PATH_NATIVE ) as string
    public declare function fname overload ( byref p as const wstring, byval gram as long = FB_PATH_NATIVE ) as ustring

    public function fname( byref p as const string, byval gram as long ) as string
        dim as ustring u = p
        return fname( u, gram )
    end function

    public function fname( byref p as const wstring, byval gram as long ) as ustring
        dim as ustring u = p
        return fname( u, gram )
    end function
#endmacro

FBFS_PATH1_OVERLOADS( PathRoot )
FBFS_PATH1_OVERLOADS( PathParent )
FBFS_PATH1_OVERLOADS( PathFileName )
FBFS_PATH1_OVERLOADS( PathStem )
FBFS_PATH1_OVERLOADS( PathExtension )
FBFS_PATH1_OVERLOADS( PathNormalize )
FBFS_PATH1_OVERLOADS( PathToNative )

'' ------------------------------------- the composers' STRING/WSTRING family
''
'' PathJoin and PathChangeExtension RETURN TEXT, so they owe the same rule the
'' seven decomposition functions above follow: string in -> string out,
'' wstring/ustring in -> ustring out (std/strings' string.tiko).
''
'' THEY DID NOT HAVE IT. Until the phase-8 audit both returned `ustring` even
'' for a STRING argument, so `dim as string p = PathJoin( a, b )` compiled and
'' worked but round-tripped through UTF-16 on the way, while the neighbouring
'' PathParent( a ) returned a STRING directly. Same family, two rules, and
'' nothing in the type system to notice -- implicit conversion made the
'' inconsistency invisible at every call site.
''
'' Only the FIRST parameter varies, exactly as std/strings' string.tiko requires:
'' giving the later parameters per-family types is what makes the set ambiguous
'' rather than resolvable.

#macro FBFS_JOIN_OVERLOADS( firsttype, rettype )
    public declare function PathJoin overload ( byref a as const firsttype, byref b as const ustring, byval gram as long = FB_PATH_NATIVE ) as rettype
    public declare function PathJoin overload ( byref a as const firsttype, byref b as const ustring, byref c as const ustring, byval gram as long = FB_PATH_NATIVE ) as rettype
    public declare function PathJoin overload ( byref a as const firsttype, byref b as const ustring, byref c as const ustring, byref d as const ustring, byval gram as long = FB_PATH_NATIVE ) as rettype

    public function PathJoin( byref a as const firsttype, byref b as const ustring, byval gram as long ) as rettype
        dim as ustring ua = a
        return PathJoin( ua, b, gram )
    end function

    public function PathJoin( byref a as const firsttype, byref b as const ustring, byref c as const ustring, byval gram as long ) as rettype
        dim as ustring ua = a
        return PathJoin( ua, b, c, gram )
    end function

    public function PathJoin( byref a as const firsttype, byref b as const ustring, byref c as const ustring, byref d as const ustring, byval gram as long ) as rettype
        dim as ustring ua = a
        return PathJoin( ua, b, c, d, gram )
    end function
#endmacro

FBFS_JOIN_OVERLOADS( string, string )
FBFS_JOIN_OVERLOADS( wstring, ustring )

#macro FBFS_CHGEXT_OVERLOADS( firsttype, rettype )
    public declare function PathChangeExtension overload ( byref p as const firsttype, byref ext as const ustring, byval gram as long = FB_PATH_NATIVE ) as rettype

    public function PathChangeExtension( byref p as const firsttype, byref ext as const ustring, byval gram as long ) as rettype
        dim as ustring up = p
        return PathChangeExtension( up, ext, gram )
    end function
#endmacro

FBFS_CHGEXT_OVERLOADS( string, string )
FBFS_CHGEXT_OVERLOADS( wstring, ustring )



'' ======================================================== RFC-0001 section 12
''
'' Path additions, specified in C:\dev\docs\tiko-fs\RFC-0001-files-and-streams.md
'' section 12. Pure, like everything above: no syscalls, either grammar on either host.

'' ---------------------------------------------------------- PathComponents

public enum PathComponentKind
    PATH_PREFIX = 0         '' "C:", "\\server\share", "\\?\", "\\.\..." -- Windows grammar only
    PATH_ROOT   = 1         '' the root separator
    PATH_CURDIR = 2         '' "." -- kept only as the first component
    PATH_PARENT = 3         '' ".."
    PATH_NORMAL = 4         '' a name
end enum

'' PathComponent.PrefixKind( ) of a PATH_PREFIX
public const PATH_PREFIX_DISK         = 1     '' C:
public const PATH_PREFIX_UNC          = 2     '' \\server\share
public const PATH_PREFIX_VERBATIM     = 3     '' \\?\name
public const PATH_PREFIX_VERBATIM_UNC = 4     '' \\?\UNC\server\share
public const PATH_PREFIX_VERBATIM_DISK = 5    '' \\?\C:
public const PATH_PREFIX_DEVICE       = 6     '' \\.\name

public type PathComponent
    declare const function Kind( ) as PathComponentKind
    declare const function Text( ) as ustring
    declare const function PrefixKind( ) as long     '' 0 unless Kind( ) = PATH_PREFIX

    as PathComponentKind m_kind
    as ustring           m_text
    as long              m_prefix
end type

const function PathComponent.Kind( ) as PathComponentKind
    return this.m_kind
end function

const function PathComponent.Text( ) as ustring
    return this.m_text
end function

const function PathComponent.PrefixKind( ) as long
    return this.m_prefix
end function

private function hIsSep( byval c as ulong, byval gram as long ) as boolean
    if( c = 47 ) then return TRUE
    return ( gram = FB_PATH_WIN32 ) andalso ( c = 92 )
end function

'' The kind of a Windows prefix, from its text.
private function hPrefixKind( byref pre as const ustring ) as long
    dim as ustring u = ucase( pre )
    if( left( u, 8 ) = "\\?\UNC\" ) then return PATH_PREFIX_VERBATIM_UNC
    if( left( u, 4 ) = "\\?\" ) then
        if( ( len( u ) >= 6 ) andalso ( u[5] = 58 ) ) then return PATH_PREFIX_VERBATIM_DISK
        return PATH_PREFIX_VERBATIM
    end if
    if( left( u, 4 ) = "\\.\" ) then return PATH_PREFIX_DEVICE
    if( left( u, 2 ) = "\\" ) then return PATH_PREFIX_UNC
    return PATH_PREFIX_DISK
end function

'' The components of p, IN ORDER, as written -- not normalised, except that a "." after
'' the first component is dropped, as Rust's Path::components does. On the Windows
'' grammar a root splits into its PATH_PREFIX and the PATH_ROOT separator after it.
public declare function PathComponentList overload ( byref p as const ustring, comps as Array( of PathComponent ), byval gram as long = FB_PATH_NATIVE ) as long

public function PathComponentList( byref p as const ustring, comps as Array( of PathComponent ), byval gram as long ) as long
    comps.Clear( )
    dim as integer rl = PathRootLen( p, gram )
    if( rl > 0 ) then
        dim as ustring r = left( p, rl )
        dim as boolean sepEnd = hIsSep( r[rl - 1], gram )
        dim as ustring pre = r
        if( sepEnd ) then pre = left( r, rl - 1 )
        if( ( gram = FB_PATH_WIN32 ) andalso ( len( pre ) > 0 ) ) then
            dim as PathComponent c
            c.m_kind = PATH_PREFIX
            c.m_text = pre
            c.m_prefix = hPrefixKind( pre )
            comps.Push( c )
        end if
        if( sepEnd orelse ( gram <> FB_PATH_WIN32 ) ) then
            dim as PathComponent c
            c.m_kind = PATH_ROOT
            c.m_text = right( r, 1 )
            comps.Push( c )
        end if
    end if

    dim as integer at = rl, clen = 0, start
    do
        start = PathNextComponent( p, gram, at, clen )
        if( start < 0 ) then exit do
        at = start + clen
        dim as ustring t = mid( p, start + 1, clen )
        dim as PathComponent c
        c.m_text = t
        if( t = "." ) then
            if( comps.Count( ) > 0 ) then continue do
            c.m_kind = PATH_CURDIR
        elseif( t = ".." ) then
            c.m_kind = PATH_PARENT
        else
            c.m_kind = PATH_NORMAL
        end if
        comps.Push( c )
    loop
    return comps.Count( )
end function

'' 'for each c in PathComponents( p )' over PathComponentList.
public type PathComponentIterator
    declare function IsValid ( ) as boolean
    declare function Value   ( ) byref as PathComponent
    declare sub      MoveNext( )
    as Array( of PathComponent ) m_comps
    as long                      m_i
end type

function PathComponentIterator.IsValid( ) as boolean
    return this.m_i < this.m_comps.Count( )
end function

function PathComponentIterator.Value( ) byref as PathComponent
    return this.m_comps[this.m_i]
end function

sub PathComponentIterator.MoveNext( )
    this.m_i += 1
end sub

public type PathComponentRange
    declare const function GetIterator( ) as PathComponentIterator
    as ustring m_path
    as long    m_gram
end type

const function PathComponentRange.GetIterator( ) as PathComponentIterator
    dim as PathComponentIterator it
    PathComponentList( this.m_path, it.m_comps, this.m_gram )
    it.m_i = 0
    return it
end function

public declare function PathComponents overload ( byref p as const ustring, byval gram as long = FB_PATH_NATIVE ) as PathComponentRange

public function PathComponents( byref p as const ustring, byval gram as long ) as PathComponentRange
    dim as PathComponentRange r
    r.m_path = p
    r.m_gram = gram
    return r
end function

'' ------------------------------------------------------- names and extensions

'' The file name up to its FIRST dot, a leading dot not counting: "a.tar.gz" -> "a",
'' ".bashrc" -> ".bashrc", ".config.toml" -> ".config". Rust's file_prefix.
public declare function PathFilePrefix overload ( byref p as const ustring, byval gram as long = FB_PATH_NATIVE ) as ustring

public function PathFilePrefix( byref p as const ustring, byval gram as long ) as ustring
    dim as ustring nm = PathFileName( p, gram )
    dim as long n = len( nm )
    for i as long = 1 to n - 1
        if( nm[i] = 46 ) then return left( nm, i )
    next
    return nm
end function

'' Adds an extension AFTER any there already: "a.tar" + "gz" -> "a.tar.gz". A leading
'' dot in ext is not doubled. A trailing separator does not hide the name, as for
'' PathFileName: "dir/" + "gz" -> "dir.gz". An empty ext, or a path with no file name
'' (a root), returns p.
'' Rust's with_added_extension; PathChangeExtension is the one that replaces.
public declare function PathAddExtension overload ( byref p as const ustring, byref ext as const ustring, byval gram as long = FB_PATH_NATIVE ) as ustring

public function PathAddExtension( byref p as const ustring, byref ext as const ustring, byval gram as long ) as ustring
    dim as ustring e = ext
    while( ( len( e ) > 0 ) andalso ( e[0] = 46 ) )
        e = mid( e, 2 )
    wend
    if( len( e ) = 0 ) then return p
    if( len( PathFileName( p, gram ) ) = 0 ) then return p
    dim as ustring q = p
    while( ( len( q ) > 0 ) andalso hIsSep( q[len( q ) - 1], gram ) )
        q = left( q, len( q ) - 1 )
    wend
    return q & "." & e
end function

'' ---------------------------------------------------- local and reserved

'' TRUE when any component, under the Windows grammar, is a reserved device name --
'' CON PRN AUX NUL CONIN$ CONOUT$ COM1-9 LPT1-9 and their superscript-digit forms --
'' in any case, with or without an extension. Always FALSE under the POSIX grammar.
public declare function PathIsReserved overload ( byref p as const ustring, byval gram as long = FB_PATH_NATIVE ) as boolean

private function hReservedName( byref nm as const ustring ) as boolean
    dim as ustring s = nm
    dim as long d = instr( s, "." )
    if( d > 0 ) then s = left( s, d - 1 )
    s = rtrim( ucase( s ) )
    select case s
    case "CON", "PRN", "AUX", "NUL", "CONIN$", "CONOUT$"
        return TRUE
    end select
    if( len( s ) = 4 ) then
        dim as ustring stem = left( s, 3 )
        if( ( stem = "COM" ) orelse ( stem = "LPT" ) ) then
            dim as ulong c = s[3]
            '' 1-9, and the superscripts 1, 2, 3 (U+00B9, U+00B2, U+00B3)
            if( ( c >= 49 ) andalso ( c <= 57 ) ) then return TRUE
            if( ( c = &hB9 ) orelse ( c = &hB2 ) orelse ( c = &hB3 ) ) then return TRUE
        end if
    end if
    return FALSE
end function

public function PathIsReserved( byref p as const ustring, byval gram as long ) as boolean
    if( gram <> FB_PATH_WIN32 ) then return FALSE
    dim as Array( of PathComponent ) cs
    PathComponentList( p, cs, gram )
    for i as long = 0 to cs.Count( ) - 1
        if( cs[i].m_kind = PATH_NORMAL ) then
            if( hReservedName( cs[i].m_text ) ) then return TRUE
        end if
    next
    return FALSE
end function

'' Go's filepath.IsLocal, lexically: TRUE when p is not empty, has no root and no
'' drive, does not climb above where it starts once '.' and '..' are resolved, and --
'' under the Windows grammar -- names no reserved device and has no ':' (a drive or an
'' alternate data stream). The building block for "join an untrusted name under a
'' directory". NOT a containment guarantee: a symbolic link inside can still lead out.
public declare function PathIsLocal overload ( byref p as const ustring, byval gram as long = FB_PATH_NATIVE ) as boolean

public function PathIsLocal( byref p as const ustring, byval gram as long ) as boolean
    if( len( p ) = 0 ) then return FALSE
    if( PathRootLen( p, gram ) > 0 ) then return FALSE
    if( gram = FB_PATH_WIN32 ) then
        if( instr( p, ":" ) > 0 ) then return FALSE
        if( PathIsReserved( p, gram ) ) then return FALSE
    end if
    dim as long depth = 0
    dim as Array( of PathComponent ) cs
    PathComponentList( p, cs, gram )
    for i as long = 0 to cs.Count( ) - 1
        select case cs[i].m_kind
        case PATH_PARENT
            depth -= 1
            if( depth < 0 ) then return FALSE
        case PATH_NORMAL
            depth += 1
        end select
    next
    return TRUE
end function
