#module "fs"
#import "std/outcome"
#import "std/containers"
#import "std/codec"
using outcome
using containers
'' std/fs: fstextenc -- the whole-file calls, with a text encoding
''
''     fs.WriteAllText( p, s, fs.Utf16LE( ) )                        '' FF FE + UTF-16LE
''     dim as ustring t = fs.ReadAllText( p, fs.Ansi( ) ).Value( )    '' the ANSI code page
''     fs.AppendAllText( log_, line_, fs.Utf16LE( ) )                 '' the BOM once, when new
''
'' Each call here is an
'' OVERLOAD: ReadAllText( p ), WriteAllText( p, s ) and the rest keep their bytes, and
'' WriteAllText( p, s, Utf8( ) ) writes exactly what WriteAllText( p, s ) does.
''
'' BYTES FIRST, THEN std/codec. A read is ReadAllBytes then codec.DecodeText; a write is
'' codec.EncodeText then WriteAllBytes, AppendAllBytes or WriteAtomic's byte overload. No
'' runtime entry point is new.
''
'' READING BELIEVES THE CALLER. The encoding named is the one used; a BOM that
'' matches it is skipped, and any other leading bytes are text -- an ANSI read of a file
'' that starts EF BB BF gives the three characters, as FileSystemObject does. Bytes that
'' do not decode become U+FFFD, or under TEXT_STRICT fail with FS_INVALID_DATA.
''
'' WRITING IS STRICT BY DEFAULT. A character the encoding cannot hold fails with
'' FS_INVALID_DATA and the file is NOT touched: the text is encoded in full before the
'' file is opened. Under TEXT_REPLACE it becomes '?', the write succeeds, and the result's
'' VALUE IS FALSE -- "written, but not exactly". TRUE means every character was written as
'' it was. A BOM is written when the encoding's Bom says so: Utf16LE( ) and Utf16BE( ) by
'' default, Utf8( TRUE ) when asked, a code page and BINARY never.
''
'' DETECTING: ReadAllText( p, found, opts ) takes a BOM if there is one, else valid
'' UTF-8 (an empty file is UTF-8), else opts.Fallback -- Ansi( ) for the editor's rule,
'' BinaryMode( ) to lose nothing -- and says in `found` which it used. A UTF-32 BOM is
'' FS_UNSUPPORTED. The whole file is judged; TextReader( s, opts ) judges a prefix.
''
'' APPENDING CHECKS THE BOM. A file that starts with a BOM for a different UTF
'' fails with FS_INVALID_DATA and is left as it was. A new or empty file gets the BOM; a
'' file with text in it never gets another. Code pages and BINARY have no BOM, so there
'' is nothing to check.

#if __FB_LANG__ <> "fb"
    #error "std/fs requires -lang fb (it uses namespaces)"
#endif

public declare function ReadAllText overload ( byref p as const ustring, byval enc as TextEncoding, _
    byval mode as TextErrorMode = TEXT_REPLACE ) as FsResultUStr
public declare function ReadAllText overload ( byref p as const ustring, byref found as TextEncoding, _
    byref opts as const TextDetect, byval mode as TextErrorMode = TEXT_REPLACE ) as FsResultUStr
public declare function ReadAllLines overload ( byref p as const ustring, lines as Array( of ustring ), _
    byval enc as TextEncoding, byval mode as TextErrorMode = TEXT_REPLACE ) as FsResultLong
public declare function WriteAllText overload ( byref p as const ustring, byref s as const ustring, _
    byval enc as TextEncoding, byval mode as TextErrorMode = TEXT_STRICT ) as FsResultBool
public declare function AppendAllText overload ( byref p as const ustring, byref s as const ustring, _
    byval enc as TextEncoding, byval mode as TextErrorMode = TEXT_STRICT ) as FsResultBool
public declare function WriteAtomic overload ( byref p as const ustring, byref s as const ustring, _
    byval enc as TextEncoding, byval mode as TextErrorMode = TEXT_STRICT ) as FsResultBool

private function hEncRelabel( byref e as const FsError, byref op as const ustring, byref p as const ustring ) as FsError
    return FsError( e.Code( ), e.OsCode( ), op, p )
end function

'' The bytes of p, decoded in enc.
public function ReadAllText( byref p as const ustring, byval enc as TextEncoding, byval mode as TextErrorMode ) as FsResultUStr
    dim as Array( of ubyte ) b
    dim as FsResultI64 r = ReadAllBytes( p, b )
    if( r.IsOk( ) = FALSE ) then return Fail( of ustring, FsError )( hEncRelabel( r.Failure( ), "ReadAllText", p ) )
    dim as boolean strict = ( mode = TEXT_STRICT )
    dim as codec.EncResultText t = codec.DecodeText( b, enc, strict )
    if( t.IsOk( ) = FALSE ) then return Fail( of ustring, FsError )( FsEncodingFailure( t.Failure( ), "ReadAllText", p ) )
    return Ok( of ustring, FsError )( t.Value( ) )
end function

'' The bytes of p, decoded in the encoding opts' rules find for them; found is set to it.
public function ReadAllText( byref p as const ustring, byref found as TextEncoding, byref opts as const TextDetect, _
        byval mode as TextErrorMode ) as FsResultUStr
    dim as Array( of ubyte ) b
    dim as FsResultI64 r = ReadAllBytes( p, b )
    if( r.IsOk( ) = FALSE ) then return Fail( of ustring, FsError )( hEncRelabel( r.Failure( ), "ReadAllText", p ) )
    dim as codec.EncResultEncoding d = codec.DetectEncoding( b, opts )
    if( d.IsOk( ) = FALSE ) then return Fail( of ustring, FsError )( FsEncodingFailure( d.Failure( ), "ReadAllText", p ) )
    found = d.Value( )
    dim as boolean strict = ( mode = TEXT_STRICT )
    dim as codec.EncResultText t = codec.DecodeText( b, found, strict )
    if( t.IsOk( ) = FALSE ) then return Fail( of ustring, FsError )( FsEncodingFailure( t.Failure( ), "ReadAllText", p ) )
    return Ok( of ustring, FsError )( t.Value( ) )
end function

'' ReadAllText's text in enc, cut into ReadAllLines' lines.
public function ReadAllLines( byref p as const ustring, lines as Array( of ustring ), byval enc as TextEncoding, _
        byval mode as TextErrorMode ) as FsResultLong
    lines.Clear( )
    dim as FsResultUStr t = ReadAllText( p, enc, mode )
    if( t.IsOk( ) = FALSE ) then return Fail( of long, FsError )( hEncRelabel( t.Failure( ), "ReadAllLines", p ) )
    return Ok( of long, FsError )( FsSplitLines( t.Value( ), lines ) )
end function

'' s in enc, into b; FALSE with `failure` set when the text cannot be written.
private function hEncode( byref s as const ustring, byval enc as TextEncoding, byval mode as TextErrorMode, _
        byref b as Array( of ubyte ), byref exact as boolean, byref failure as FsError, _
        byref op as const ustring, byref p as const ustring ) as boolean
    dim as boolean strict = ( mode = TEXT_STRICT )
    dim as codec.EncResultBool e = codec.EncodeText( s, enc, b, strict )
    if( e.IsOk( ) = FALSE ) then
        failure = FsEncodingFailure( e.Failure( ), op, p )
        return FALSE
    end if
    exact = e.Value( )
    return TRUE
end function

'' ---------------------------------------------------------- Stream and MemoryStream

'' s in enc: exactly the bytes WriteAllText( p, s, enc ) would put in a file, BOM
'' included when enc.Bom says so. Text written in PIECES wants the BOM once, so pass the
'' BOM-less form after the first piece -- Utf16LE( FALSE ) -- or use a TextWriter, which
'' does that itself. Strict (the default) refuses a character enc cannot hold and writes
'' NOTHING; TEXT_REPLACE writes '?' and returns Value( ) FALSE. WriteUtf8( s ) is
'' WriteText( s, Utf8( ) ) without the lossy report.
function Stream.WriteText( byref s as const ustring, byval enc as TextEncoding, byval mode as TextErrorMode ) as FsResultBool
    dim as Array( of ubyte ) b
    dim as boolean exact
    dim as FsError f
    if( hEncode( s, enc, mode, b, exact, f, "WriteText", "" ) = FALSE ) then return Fail( of boolean, FsError )( f )
    dim as FsResultBool w = this.WriteBytes( b )
    if( w.IsOk( ) = FALSE ) then return w
    return Ok( of boolean, FsError )( exact )
end function

'' Every byte, whatever the position, decoded in enc -- the text ReadAllText( p, enc,
'' mode ) gives for a file holding the same bytes: a BOM matching enc is skipped, and
'' anything else is text.
const function MemoryStream.ToText( byval enc as TextEncoding, byval mode as TextErrorMode ) as FsResultUStr
    dim as boolean strict = ( mode = TEXT_STRICT )
    dim as codec.EncResultText t = codec.DecodeText( this.m_buf, this.m_len, enc, strict )
    if( t.IsOk( ) = FALSE ) then return Fail( of ustring, FsError )( FsEncodingFailure( t.Failure( ), "ToText", "" ) )
    return Ok( of ustring, FsError )( t.Value( ) )
end function

'' ------------------------------------------------------------- whole-file writes

public function WriteAllText( byref p as const ustring, byref s as const ustring, byval enc as TextEncoding, _
        byval mode as TextErrorMode ) as FsResultBool
    dim as Array( of ubyte ) b
    dim as boolean exact
    dim as FsError f
    if( hEncode( s, enc, mode, b, exact, f, "WriteAllText", p ) = FALSE ) then return Fail( of boolean, FsError )( f )
    dim as FsResultBool w = WriteAllBytes( p, b )
    if( w.IsOk( ) = FALSE ) then return Fail( of boolean, FsError )( hEncRelabel( w.Failure( ), "WriteAllText", p ) )
    return Ok( of boolean, FsError )( exact )
end function

public function WriteAtomic( byref p as const ustring, byref s as const ustring, byval enc as TextEncoding, _
        byval mode as TextErrorMode ) as FsResultBool
    dim as Array( of ubyte ) b
    dim as boolean exact
    dim as FsError f
    if( hEncode( s, enc, mode, b, exact, f, "WriteAtomic", p ) = FALSE ) then return Fail( of boolean, FsError )( f )
    dim as FsResultBool w = WriteAtomic( p, b )
    if( w.IsOk( ) = FALSE ) then return Fail( of boolean, FsError )( w.Failure( ) )
    return Ok( of boolean, FsError )( exact )
end function

'' The UTF a leading BOM names: 0 none, else a TextEncodingKind.
private function hBomKind( byval q as const ubyte ptr, byval n as long ) as long
    if( n >= 3 ) then
        if( ( q[0] = &hEF ) andalso ( q[1] = &hBB ) andalso ( q[2] = &hBF ) ) then return TEXT_UTF8
    end if
    if( n >= 2 ) then
        if( ( q[0] = &hFF ) andalso ( q[1] = &hFE ) ) then return TEXT_UTF16LE
        if( ( q[0] = &hFE ) andalso ( q[1] = &hFF ) ) then return TEXT_UTF16BE
    end if
    return 0
end function

public function AppendAllText( byref p as const ustring, byref s as const ustring, byval enc as TextEncoding, _
        byval mode as TextErrorMode ) as FsResultBool
    const op = "AppendAllText"
    '' encoded first, without the BOM, so a refusal touches nothing
    dim as TextEncoding body = enc
    body.Bom = FALSE
    dim as Array( of ubyte ) b
    dim as boolean exact
    dim as FsError f
    if( hEncode( s, body, mode, b, exact, f, op, p ) = FALSE ) then return Fail( of boolean, FsError )( f )

    '' what is there already: nothing, or its first bytes
    dim as boolean isNew = TRUE
    dim as ubyte head( 0 to 3 )
    dim as long nHead = 0
    scope
        dim as File g
        dim as FsResultBool o = g.OpenRead( p )
        if( o.IsOk( ) ) then
            dim as FsResultI64 r = g.Read( @head( 0 ), 4 )
            if( r.IsOk( ) = FALSE ) then return Fail( of boolean, FsError )( hEncRelabel( r.Failure( ), op, p ) )
            nHead = clng( r.Value( ) )
            isNew = ( nHead = 0 )
        elseif( o.Failure( ).Code( ) <> FS_NOT_FOUND ) then
            return Fail( of boolean, FsError )( hEncRelabel( o.Failure( ), op, p ) )
        end if
    end scope

    dim as boolean isUtf = ( enc.Kind = TEXT_UTF8 ) orelse ( enc.Kind = TEXT_UTF16LE ) orelse ( enc.Kind = TEXT_UTF16BE )
    if( isUtf andalso ( isNew = FALSE ) ) then
        dim as long have = hBomKind( @head( 0 ), nHead )
        if( ( have <> 0 ) andalso ( have <> enc.Kind ) ) then return FsFail( of boolean )( FS_INVALID_DATA, op, p )
    end if

    dim as Array( of ubyte ) w
    if( isNew andalso isUtf andalso enc.Bom ) then
        dim as Array( of ubyte ) bom
        codec.EncodeText( "", enc, bom )
        for i as long = 0 to bom.Count( ) - 1
            w.Push( bom[i] )
        next
    end if
    for i as long = 0 to b.Count( ) - 1
        w.Push( b[i] )
    next

    dim as FsResultBool a = AppendAllBytes( p, w )
    if( a.IsOk( ) = FALSE ) then return Fail( of boolean, FsError )( hEncRelabel( a.Failure( ), op, p ) )
    return Ok( of boolean, FsError )( exact )
end function
