#module "fs"
#import "std/outcome"
using outcome
'' std/fs: fsvolume -- FB.DiskSpace, FB.VolumeInfo, FB.GetVolumes
''
'' Specified in C:\dev\docs\filesystem\RFC-0008-volumes.md.
''
'' THE PATH IS ANY PATH ON THE VOLUME, not a volume name.
'' GetDiskSpace( "C:\dev\tiko" ) reports the volume holding it. That is what
'' GetVolumePathNameW and statvfs both accept, and what callers actually have.
''
'' AvailableBytes IS THE ONE TO USE. FreeBytes counts space the caller may not
'' be permitted to consume -- reserved blocks on ext4, a per-user quota on
'' either platform. A program deciding whether a write will fit must use
'' AvailableBytes; FreeBytes is for reporting. Where there is no quota the two
'' are equal, which is exactly why the distinction is invisible on a developer
'' machine and bites in production.
''
'' ALL THREE ARE SNAPSHOTS AND ARE STALE ON RETURN. A program that checks free
'' space and then writes is racing every other process on the machine; the check
'' is a courtesy, and the write's FS_NO_SPACE is the real answer.


#include once "fb/array.bi"
#include once "fb/array.bi"

#if __FB_LANG__ <> "fb"
    #error "fb/fsvolume.bi requires -lang fb (it uses namespaces)"
#endif

#if defined( __FB_WIN32__ ) and ( not defined( __FB_64BIT__ ) )
    #define FBFSVOL_EXTERN extern "Windows"
#else
    #define FBFSVOL_EXTERN extern "C"
#endif

'' Must match FB_FSVOL_* in src/rtlib/fb_filesystem.h.
public const FB_FSVOL_READONLY = 1
public const FB_FSVOL_CASESENS = 2
public const FB_FSVOL_LINKS = 4

public const FB_FS_MAXPATH = 512

using FB

public type DiskSpace
    as ulongint TotalBytes      '' capacity of the volume
    as ulongint FreeBytes       '' free, IGNORING quota -- for reporting
    as ulongint AvailableBytes  '' free TO THIS USER -- the one to branch on
end type

'' Mirror of FB_FSVOLUME. Layout is ABI; the suite asserts sizeof against the
'' C side, as it does for FileInfo.
public type VolumeInfoRaw        '' public for the ABI suites (tests/std/filesystem), not API
    as ushort  rootbuf( 0 to FB_FS_MAXPATH - 1 )
    as ushort  namebuf( 0 to FB_FS_MAXNAME - 1 )
    as ushort  fsbuf  ( 0 to FB_FS_MAXNAME - 1 )
    as long    rootlen, namelen, fstypelen
    as ulong   maxcomp
    as long    flags
end type

FBFSVOL_EXTERN
    declare function FsDiskSpaceRaw alias "fb_UStrFsDiskSpace" _
        ( byref p as const ustring, byval out as DiskSpace ptr ) as long

    declare function FsVolumeInfoRaw alias "fb_UStrFsVolumeInfo" _
        ( byref p as const ustring, byval out as VolumeInfoRaw ptr ) as long

    declare function FsVolumeEnumRaw alias "fb_FsVolumeEnum" _
        ( byval index as long, byval out as VolumeInfoRaw ptr ) as long

    declare function FsVolumeRootRaw alias "fb_UStrFsVolumeRoot" ( byval v as VolumeInfoRaw ptr ) as ustring
    declare function FsVolumeNameRaw alias "fb_UStrFsVolumeName" ( byval v as VolumeInfoRaw ptr ) as ustring
    declare function FsVolumeFsTypeRaw alias "fb_UStrFsVolumeFsType" ( byval v as VolumeInfoRaw ptr ) as ustring
    public declare function FsSizeofVolume alias "fb_FsSizeofVolume" ( ) as long
end extern

'' The cooked form. Built from VolumeInfoRaw by hMakeVolume below, so callers
'' never see the fixed buffers.
public type VolumeInfo
    as ustring RootPath        '' "C:\", "/", "\\srv\share\"
    as ustring Name            '' the label. MAY BE EMPTY -- always is on Linux,
                               '' where there is no portable way to read one
                               '' without linking blkid, and often is for a
                               '' network share on Windows.
    as ustring FileSystem      '' "NTFS", "ext4", "exFAT". May be empty.
    as ulong   MaxComponentLen '' longest single path component
    as boolean IsReadOnly

    '' PER-VOLUME, and deliberately NOT the same question as
    '' PathIsCaseSensitive( ), which is a compile-time per-platform constant.
    '' They disagree in two real cases: an NTFS directory with per-directory
    '' case sensitivity enabled (WSL sets this), and a case-insensitive
    '' filesystem mounted on Linux.
    ''
    '' Use PathIsCaseSensitive for LEXICAL path comparison, which must be
    '' deterministic and must not do IO. Use this one for "will these two
    '' names collide on this disk". Picking the wrong one gives a bug that
    '' only appears on someone else's machine.
    as boolean IsCaseSensitive

    '' BEST EFFORT, and ASYMMETRIC: a FALSE is reliable, a TRUE is not a
    '' guarantee. Windows reports FILE_SUPPORTS_REPARSE_POINTS honestly; Linux
    '' has no portable probe, so everything but the FAT family and ISO 9660 is
    '' assumed able. A caller that is wrong finds out from CreateSymlink.
    as boolean SupportsLinks
end type

public type FsResultSpace as Result( of DiskSpace, FsError )
public type FsResultVol as Result( of VolumeInfo, FsError )

function hMakeVolume( byval raw as VolumeInfoRaw ptr ) as VolumeInfo
    dim as VolumeInfo v

    v.RootPath        = FsVolumeRootRaw( raw )
    v.Name            = FsVolumeNameRaw( raw )
    v.FileSystem      = FsVolumeFsTypeRaw( raw )
    v.MaxComponentLen = raw->maxcomp
    v.IsReadOnly      = ( ( raw->flags and FB_FSVOL_READONLY ) <> 0 )
    v.IsCaseSensitive = ( ( raw->flags and FB_FSVOL_CASESENS ) <> 0 )
    v.SupportsLinks   = ( ( raw->flags and FB_FSVOL_LINKS ) <> 0 )

    return v
end function

public declare function GetDiskSpace overload ( byref p as const ustring ) as FsResultSpace
public declare function GetVolumeInfo overload ( byref p as const ustring ) as FsResultVol
public declare function GetVolumes overload ( vols as Array( of VolumeInfo ) ) as FsResultLong

public function GetDiskSpace( byref p as const ustring ) as FsResultSpace
    dim as DiskSpace d
    dim as long r = FsDiskSpaceRaw( p, @d )

    if( r <> FS_OK ) then
        return FsFail( of DiskSpace )( cast( FsErrorCode, r ), "GetDiskSpace", p )
    end if

    return Ok( of DiskSpace, FsError )( d )
end function

public function GetVolumeInfo( byref p as const ustring ) as FsResultVol
    dim as VolumeInfoRaw raw
    dim as long r = FsVolumeInfoRaw( p, @raw )

    if( r <> FS_OK ) then
        return FsFail( of VolumeInfo )( cast( FsErrorCode, r ), "GetVolumeInfo", p )
    end if

    dim as VolumeInfo v = hMakeVolume( @raw )
    return Ok( of VolumeInfo, FsError )( v )
end function

'' Mounted filesystems, ordered by root path and stable.
''
'' ON WINDOWS this is the logical drives, skipping any that report no media --
'' an empty optical drive or an unmapped network letter would otherwise each
'' cost a multi-second timeout, and probing them is what needs
'' SEM_FAILCRITICALERRORS to avoid a system modal dialog in a console program.
''
'' ON LINUX there are no drives, only mount points, so this reads
'' /proc/self/mountinfo and reports only filesystems backed by a real block
'' device. That FILTERS the pseudo-filesystems -- proc, sysfs, cgroup, tmpfs,
'' overlays -- which is what anyone asking "what disks are there" means, and it
'' will occasionally omit something a caller wanted (a network mount, a tmpfs
'' used as real storage). Read /proc/self/mountinfo directly if you need the
'' unfiltered list.
public function GetVolumes( vols as Array( of VolumeInfo ) ) as FsResultLong
    dim as VolumeInfoRaw raw
    dim as long n = 0, i = 0

    vols.Clear( )

    do
        dim as long r = FsVolumeEnumRaw( i, @raw )

        if( r = FB_FS_EXHAUSTED ) then exit do

        if( r <> FS_OK ) then
            return FsFail( of long )( cast( FsErrorCode, r ), "GetVolumes", "" )
        end if

        vols.Push( hMakeVolume( @raw ) )
        n += 1
        i += 1
    loop

    return Ok( of long, FsError )( n )
end function

