#module "containers"
'' std/containers: map -- containers.Map( of TK, TV ), an open-addressed hash map
''
'' Replaces CDicObj.inc, which obtains a
'' dictionary by instantiating Scripting.Dictionary over COM -- Windows-only,
'' CoInitialize per instance, every key and value a VARIANT, every lookup a
'' late-bound IDispatch call.
''
''     dim ages as containers.Map( of string, long )
''     ages.Put( "ada", 36 )
''     if ages.Contains( "ada" ) then print ages[ "ada" ]
''
''     for each kv in ages
''         print kv.key, kv.value
''     next
''
'' READING vs WRITING -- the most important thing on this page.
''
''     m[ k ]        INSERTS a default-constructed TV if k is absent.
''     m.TryGet      does not.
''     m.Contains    does not.
''
'' 'm[ k ] += 1' just working is why the indexer inserts, and 'if m[ k ] = 0'
'' silently growing the map is the price.  Every language has this argument and
'' none has won it; C# splits it the same way.  Use TryGet or Contains to READ.
''
'' THE HASH CONTRACT is in hash.tiko: 'HashOf( k )' must resolve and 'k = k'
'' must compare, and EQUAL KEYS MUST HASH EQUAL.
''
'' IMPLEMENTATION.  Open addressing with linear probing, power-of-two capacity,
'' Fibonacci hashing to pick the home slot (Mix), load factor 0.75, rehash
'' doubles.  Open addressing is chosen over chaining for one allocation instead
'' of one per entry, which matters more in a language with no garbage collector.
''
'' ONE CONTROL BYTE PER SLOT: MAP_EMPTY, or MAP_USED_BIT plus seven more bits of
'' the key's hash, its FINGERPRINT (CtrlOf).  A probe compares that byte before
'' it compares a key, so a slot holding some other key costs a key compare only
'' one time in 128 -- for string keys, a string compare.  SwissTable's idea,
'' without its 16-byte groups.
''
'' NO TOMBSTONES.  Remove shifts the rest of the probe run back into the hole
'' (backward-shift deletion) -- see Remove.
''
'' ITERATION ORDER IS UNSPECIFIED and changes across insertions.  It is not
'' randomised per process -- that is a hash-flooding defence FreeBASIC has no
'' threat model for, and stability within one unmodified map is more useful when
'' debugging.




public const MAP_MIN_CAPACITY as long = 8

'' The largest power of two a long holds.  A table this size still grows no
'' further: past ~8 x 10^8 live entries Put fills it, and when no slot is left
'' Put returns FALSE without storing (there is no error channel).
public const MAP_MAX_CAPACITY as long = &h40000000

'' control bytes: EMPTY, or the USED bit with a fingerprint under it -- see CtrlOf( )
const MAP_EMPTY    as ubyte = 0
const MAP_USED_BIT as ubyte = &h80

'' What Locate returns when no EMPTY slot ends the probe: the table is unallocated, or
'' full at MAP_MAX_CAPACITY.  Below every 'not slot' a miss returns.
const MAP_NOSLOT as long = -&h7FFFFFFF

'' What iteration yields.  A pair, read through kv.key and kv.value.
''
'' To destructure instead -- 'for each (k, v) in m.Pairs( )' -- see MapPairView
'' below.  This type stays the default because it is the one that names its
'' halves; the tuple form costs an extra copy of both.
public type KeyValuePair( of TK, TV )
    as TK key
    as TV value
end type

public type MapIterator( of TK, TV )
    as any ptr src
    as long slot
    declare function IsValid( ) as boolean
    declare function Value( ) as KeyValuePair( of TK, TV )
    declare sub MoveNext( )
end type

public type Map( of TK, TV )
    private:
    as TK keys_( any )                  '' an EMPTY slot holds a default key and value
    as TV vals_( any )
    as ubyte ctrl( any )                '' one control byte per slot -- see CtrlOf( )
    as long num                         '' live entries
    as long cap_                        '' slots allocated -- see Capacity( )
    as long shift_                      '' 64 - log2( cap_ ) -- see Mix( )
    declare function Mix( byref k as TK ) as ulongint
    declare function CtrlOf( byval h as ulongint ) as ubyte
    declare function Locate( byref k as TK, byval h as ulongint ) as long
    declare function NeedsRoom( ) as boolean
    declare function MakeRoom( byref k as TK, byval h as ulongint ) as long
    declare function InsertNew( byref k as TK, byref v as TV, byval h as ulongint, byval at as long ) as boolean
    declare function InsertBlank( byref k as TK, byval h as ulongint, byval at as long ) as long

    public:
    declare function Count( ) as long
    declare function IsEmpty( ) as boolean
    declare function Capacity( ) as long

    declare sub Reserve( byval n as long )
    declare sub Clear( )

    declare function FindSlot( byref k as TK ) as long
    declare function Put( byref k as TK, byref v as TV ) as boolean
    declare function Add( byref k as TK, byref v as TV ) as boolean
    declare function Contains( byref k as TK ) as boolean
    declare function TryGet( byref k as TK, byref outv as TV ) as boolean
    declare function Remove( byref k as TK ) as boolean
    declare operator [] ( byref k as TK ) byref as TV

    declare function Keys( ) as Array( of TK )
    declare function Values( ) as Array( of TV )
    declare function GetIterator( ) as MapIterator( of TK, TV )
    '' THE SLOT PROTOCOL MapIterator walks: slots 0 to Capacity( ) - 1, of which the used
    '' ones hold pairs. Public only because an iterator is another type; use 'for each'.
    declare function SlotUsed( byval slot as long ) as boolean
    declare function SlotKey( byval slot as long ) byref as TK
    declare function SlotValue( byval slot as long ) byref as TV
    declare function Pairs( ) as MapPairView( of TK, TV )
end type

'' A second view over the same slots, yielding a (TK, TV) TUPLE rather than a
'' KeyValuePair, so the destructuring form of FOR EACH accepts it:
''
''     for each (k, v) in m.Pairs( )
''
'' It exists as a view rather than as a change to MapIterator.Value( ) because
'' FreeBASIC cannot overload on the return type alone -- the parser picks the
'' overload bottom-up, before any expected type is known -- so one Value( ) has
'' to be chosen, and changing it would break every kv.key / kv.value site.
''
'' The view BORROWS the map; it does not own it and must not outlive it.  It is
'' invalidated by exactly what invalidates MapIterator: any rehash, any Remove.
public type MapPairIter( of TK, TV )
    as MapIterator( of TK, TV ) it
    declare function IsValid( ) as boolean
    declare function Value( ) as (TK, TV)
    declare sub MoveNext( )
end type

public type MapPairView( of TK, TV )
    as any ptr src
    declare function GetIterator( ) as MapPairIter( of TK, TV )
end type

function Map( of TK, TV ).Count( ) as long
    return this.num
end function

function Map( of TK, TV ).IsEmpty( ) as boolean
    return this.num = 0
end function

'' KEPT IN A FIELD, set where the arrays are sized. It was 'ubound( state ) - lbound(
'' state ) + 1', and both are RUNTIME CALLS over a dynamic array (fb_ArrayUBound,
'' fb_ArrayLBound) -- two calls on every lookup, four on an insert. Measured over the
'' Benchmarks Game k-nucleotide port (875M 'm[ k ] += 1' over ~140K keys): 9.3 s ->
'' 7.9 s, and TryGet + Put counting 28% faster.
function Map( of TK, TV ).Capacity( ) as long
    return this.cap_
end function

function Map( of TK, TV ).SlotUsed( byval slot as long ) as boolean
    return this.ctrl( slot ) <> MAP_EMPTY
end function

function Map( of TK, TV ).SlotKey( byval slot as long ) byref as TK
    return this.keys_( slot )
end function

function Map( of TK, TV ).SlotValue( byval slot as long ) byref as TV
    return this.vals_( slot )
end function

'' HashOf( k ) times 2^64 / phi (Fibonacci hashing).  Its TOP log2( cap ) bits are
'' the home slot, 'Mix( k ) shr shift_', and the seven bits under them the
'' fingerprint (CtrlOf) -- so one operation hashes once, and Locate takes the
'' result rather than hashing again.
''
'' The top bits, not the low ones.  The integer HashOf overloads are the identity
'' (hash.tiko), and this multiply is what spreads them: a dense run of small keys
'' lands in nearly distinct slots, where splitmix plus a low-bit mask scattered them
'' at random and the collisions cost a branch mispredict each.  Measured over the
'' Benchmarks Game k-nucleotide port (875M 'm[ k ] += 1'): 8.02 s -> 7.18 s, and
'' every k <= 6 pass flat.  It also rescues a user HashOf( ) that returns a bare id,
'' whose low bits a mask would take as they are.
function Map( of TK, TV ).Mix( byref k as TK ) as ulongint
    return HashOf( k ) * CONTAINERS_FIB_MULT
end function

'' The control byte of a slot holding a key whose Mix is h: the USED bit, and under it
'' the seven bits of h just below the home slot's.  Those are as well mixed as the
'' home bits -- the multiply carries upward -- and, the capacity being at most 2^30,
'' never overlap them.  They change with the capacity, so a rehash recomputes them.
function Map( of TK, TV ).CtrlOf( byval h as ulongint ) as ubyte
    return MAP_USED_BIT or cast( ubyte, ( h shr ( this.shift_ - 7 ) ) and &h7F )
end function

'' THE ONE PROBE every operation makes, for k, whose Mix is h.  Returns k's slot; or,
'' on a miss, 'not' the EMPTY slot that ended the probe (a negative number), which is
'' where k goes if it is inserted; or MAP_NOSLOT.
''
'' Linear probing stops at the first EMPTY slot.  Remove keeps that sound without
'' tombstones -- see there.
function Map( of TK, TV ).Locate( byref k as TK, byval h as ulongint ) as long
    dim as long cap = this.cap_
    if( cap = 0 ) then
        return MAP_NOSLOT
    end if

    dim as long mask = cap - 1
    dim as long i = cast( long, h shr this.shift_ )
    dim as ubyte c = this.CtrlOf( h )

    for probe as long = 0 to cap-1
        dim as ubyte s = this.ctrl( i )
        if( s = c ) then
            if( this.keys_( i ) = k ) then
                return i
            end if
        elseif( s = MAP_EMPTY ) then
            return not i
        end if

        i = (i + 1) and mask
    next

    return MAP_NOSLOT
end function

'' The slot holding k, or -1.
function Map( of TK, TV ).FindSlot( byref k as TK ) as long
    if( this.cap_ = 0 ) then
        return -1
    end if

    dim as long i = this.Locate( k, this.Mix( k ) )
    if( i < 0 ) then
        return -1
    end if
    return i
end function

'' Whether one more entry would take the table past the 0.75 load factor -- or
'' there is no table yet.  Reserve( num + 1 ) asks exactly this, so it grows whenever
'' this says so; otherwise an insert uses the EMPTY slot its miss returned.
function Map( of TK, TV ).NeedsRoom( ) as boolean
    return ( clngint( this.num ) + 1 ) * 4 > clngint( this.cap_ ) * 3
end function

'' Grow for one more entry, then return the EMPTY slot k goes in -- or -1 when the
'' table is full at MAP_MAX_CAPACITY.  k must not point into this map: the rehash
'' moves what it would point at.
function Map( of TK, TV ).MakeRoom( byref k as TK, byval h as ulongint ) as long
    this.Reserve( this.num + 1 )
    dim as long at = this.Locate( k, h )
    if( at = MAP_NOSLOT ) then
        return -1
    end if
    return not at
end function

'' Grow to at least n entries' worth of slots, keeping the load factor under
'' 0.75.  There are no tombstones to drop, so a table already big enough is left
'' alone.
''
'' NOTHING IS COPIED.  Every live key and value is SWAPPED out to a temporary
'' and swapped into its new slot -- the old rehash copied each one twice, into
'' the temporary and back through Put, which for string keys is two allocations
'' per entry per rehash.
''
'' Sizes are worked out in 64 bits and stop at MAP_MAX_CAPACITY: 'want * 3' in a
'' long overflowed past ~4 x 10^8 entries and the doubling never ended.
sub Map( of TK, TV ).Reserve( byval n as long )
    dim as longint want = MAP_MIN_CAPACITY

    while( ( (want * 3) \ 4 < n ) andalso ( want < MAP_MAX_CAPACITY ) )
        want *= 2
    wend

    if( want <= this.cap_ ) then
        exit sub
    end if

    '' move the live entries out, then size the new tables
    dim as long oldcap = this.cap_
    dim oldkeys( any ) as TK
    dim oldvals( any ) as TV
    dim oldctrl( any ) as ubyte

    if( oldcap > 0 ) then
        redim oldkeys( 0 to oldcap-1 )
        redim oldvals( 0 to oldcap-1 )
        redim oldctrl( 0 to oldcap-1 )
        for i as long = 0 to oldcap-1
            oldctrl( i ) = this.ctrl( i )
            if( this.ctrl( i ) <> MAP_EMPTY ) then
                swap oldkeys( i ), this.keys_( i )
                swap oldvals( i ), this.vals_( i )
            end if
        next
    end if

    redim this.keys_( 0 to want-1 )
    redim this.vals_( 0 to want-1 )
    redim this.ctrl( 0 to want-1 )
    this.cap_ = want
    this.shift_ = 64
    dim as longint w = want
    while( w > 1 )
        w shr= 1
        this.shift_ -= 1
    wend

    '' the new table has no duplicate keys: each entry goes in the first EMPTY slot
    '' of its probe chain, under a fingerprint for the new size
    dim as long mask = this.cap_ - 1
    for i as long = 0 to oldcap-1
        if( oldctrl( i ) <> MAP_EMPTY ) then
            dim as ulongint h = this.Mix( oldkeys( i ) )
            dim as long j = cast( long, h shr this.shift_ )
            while( this.ctrl( j ) <> MAP_EMPTY )
                j = (j + 1) and mask
            wend
            swap this.keys_( j ), oldkeys( i )
            swap this.vals_( j ), oldvals( i )
            this.ctrl( j ) = this.CtrlOf( h )
        end if
    next
end sub

sub Map( of TK, TV ).Clear( )
    dim as TK blankk
    dim as TV blankv

    for i as long = 0 to this.Capacity( )-1
        if( this.ctrl( i ) <> MAP_EMPTY ) then
            this.keys_( i ) = blankk
            this.vals_( i ) = blankv
        end if
        this.ctrl( i ) = MAP_EMPTY
    next

    this.num = 0
end sub

'' Store a key Locate missed, with its value, at the EMPTY slot 'at' the miss
'' returned -- or, when the load factor calls for it, at the slot it has after a
'' rehash.  FALSE only when the table is full at MAP_MAX_CAPACITY.
''
'' COPIED ONLY WHEN THE TABLE GROWS.  k or v may point INTO this map --
'' 'm.Put( k2, m[ k1 ] )' is legal -- and the rehash moves what they point at, so
'' then both are copied first and swapped into the new slot.  Otherwise they are
'' assigned straight in: the slot is EMPTY, so it is neither of them.  Put copied
'' both on every call, an allocation per string key or value even to overwrite.
function Map( of TK, TV ).InsertNew( byref k as TK, byref v as TV, byval h as ulongint, byval at as long ) as boolean
    if( this.NeedsRoom( ) ) then
        dim as TK kk = k
        dim as TV vv = v
        at = this.MakeRoom( kk, h )
        if( at < 0 ) then
            return false
        end if
        swap this.keys_( at ), kk
        swap this.vals_( at ), vv
    else
        at = not at
        this.keys_( at ) = k
        this.vals_( at ) = v
    end if

    this.ctrl( at ) = this.CtrlOf( h )
    this.num += 1
    return true
end function

'' Insert or overwrite.  Returns TRUE if the key was new.
function Map( of TK, TV ).Put( byref k as TK, byref v as TV ) as boolean
    dim as ulongint h = this.Mix( k )
    dim as long i = this.Locate( k, h )

    if( i >= 0 ) then
        '' 'm.Put( k, m[ k ] )' would assign the value to itself
        if( @this.vals_( i ) <> @v ) then
            this.vals_( i ) = v
        end if
        return false
    end if

    return this.InsertNew( k, v, h, i )
end function

'' Insert only if absent.  Returns FALSE if the key was already there, and does
'' NOT overwrite -- that is the difference from Put.
function Map( of TK, TV ).Add( byref k as TK, byref v as TV ) as boolean
    dim as ulongint h = this.Mix( k )
    dim as long i = this.Locate( k, h )

    if( i >= 0 ) then
        return false
    end if

    return this.InsertNew( k, v, h, i )
end function

function Map( of TK, TV ).Contains( byref k as TK ) as boolean
    return this.FindSlot( k ) >= 0
end function

'' Read without inserting.  Leaves outv alone on a miss.
function Map( of TK, TV ).TryGet( byref k as TK, byref outv as TV ) as boolean
    dim as long i = this.FindSlot( k )
    if( i < 0 ) then
        return false
    end if
    outv = this.vals_( i )
    return true
end function

'' Returns TRUE if something was removed.
''
'' BACKWARD-SHIFT DELETION, so no tombstone.  Emptying the slot alone would cut
'' the probe run and hide every key that collided past it.  Instead each later
'' entry of the run that may sit in the hole moves back into it, and the hole moves
'' to where that entry was, until the run ends at an EMPTY slot.  An entry may move
'' back when the hole lies cyclically between its home slot and where it sits; any
'' other would land in front of its home, where no probe for it starts.
''
'' The price is a Mix -- a HashOf -- per entry the run passes after the removed one,
'' to find its home: a few at the load factor, each a string hash for string keys.
'' What it buys: lookups never step over dead slots, and a put/remove loop never
'' has to rehash a table just to clear them out.
function Map( of TK, TV ).Remove( byref k as TK ) as boolean
    if( this.cap_ = 0 ) then
        return false
    end if

    dim as long i = this.Locate( k, this.Mix( k ) )
    if( i < 0 ) then
        return false
    end if

    '' the removed entry rides along in the hole and is blanked once, at the end
    dim as long mask = this.cap_ - 1
    dim as long j = i
    do
        j = (j + 1) and mask
        if( this.ctrl( j ) = MAP_EMPTY ) then
            exit do
        end if
        if( j = i ) then                '' no EMPTY slot: full at MAP_MAX_CAPACITY
            exit do
        end if

        dim as long home = cast( long, this.Mix( this.keys_( j ) ) shr this.shift_ )
        if( ( (j - home) and mask ) >= ( (j - i) and mask ) ) then
            swap this.keys_( i ), this.keys_( j )
            swap this.vals_( i ), this.vals_( j )
            this.ctrl( i ) = this.ctrl( j )
            i = j
        end if
    loop

    dim as TK blankk
    dim as TV blankv
    this.keys_( i ) = blankk
    this.vals_( i ) = blankv
    this.ctrl( i ) = MAP_EMPTY
    this.num -= 1

    return true
end function

'' INSERTS a default-constructed TV when k is absent.  See the header.
operator Map( of TK, TV ).[] ( byref k as TK ) byref as TV
    dim as ulongint h = this.Mix( k )
    dim as long i = this.Locate( k, h )

    if( i < 0 ) then
        i = this.InsertBlank( k, h, i )
    end if

    return this.vals_( i )
end operator

'' The indexer's miss path, kept OUT of the indexer: a 'dim as TK' inside its IF is
'' a dynamic stack allocation, which gave every m[ k ] -- hits included -- a frame
'' pointer, a __chkstk and a stack adjustment around each call.  Measured over
'' k-nucleotide: 7.18 s -> 6.34 s (C 4.31 s).
''
'' Stores k at the slot InsertNew would, and no value: an EMPTY slot's value is
'' already default-constructed.  Returns the slot -- -1 when the table is full at
'' MAP_MAX_CAPACITY, which the indexer has no way to report.
function Map( of TK, TV ).InsertBlank( byref k as TK, byval h as ulongint, byval at as long ) as long
    if( this.NeedsRoom( ) ) then
        dim as TK kk = k                '' k may point into this map: see InsertNew
        at = this.MakeRoom( kk, h )
        if( at < 0 ) then
            return -1
        end if
        swap this.keys_( at ), kk
    else
        at = not at
        this.keys_( at ) = k
    end if

    this.ctrl( at ) = this.CtrlOf( h )
    this.num += 1
    return at
end function

function Map( of TK, TV ).Keys( ) as Array( of TK )
    dim r as Array( of TK )
    r.Reserve( this.num )
    for i as long = 0 to this.Capacity( )-1
        if( this.ctrl( i ) <> MAP_EMPTY ) then
            r.Push( this.keys_( i ) )
        end if
    next
    return r
end function

function Map( of TK, TV ).Values( ) as Array( of TV )
    dim r as Array( of TV )
    r.Reserve( this.num )
    for i as long = 0 to this.Capacity( )-1
        if( this.ctrl( i ) <> MAP_EMPTY ) then
            r.Push( this.vals_( i ) )
        end if
    next
    return r
end function

function Map( of TK, TV ).GetIterator( ) as MapIterator( of TK, TV )
    dim it as MapIterator( of TK, TV )
    it.src = @this
    it.slot = 0

    '' land on the first live slot, or past the end for an empty map
    dim as long cap = this.Capacity( )
    while( (it.slot < cap) andalso (this.ctrl( it.slot ) = MAP_EMPTY) )
        it.slot += 1
    wend

    return it
end function

function MapIterator( of TK, TV ).IsValid( ) as boolean
    dim as Map( of TK, TV ) ptr m = cptr( Map( of TK, TV ) ptr, this.src )
    return this.slot < m->Capacity( )
end function

'' By value, not byref: the pair is assembled here and does not live in the map.
'' Assigning to it therefore changes nothing, which is why there is no byref
'' binding for a map -- use m[ k ] to write.
function MapIterator( of TK, TV ).Value( ) as KeyValuePair( of TK, TV )
    dim as Map( of TK, TV ) ptr m = cptr( Map( of TK, TV ) ptr, this.src )
    dim r as KeyValuePair( of TK, TV )
    r.key = m->SlotKey( this.slot )
    r.value = m->SlotValue( this.slot )
    return r
end function

sub MapIterator( of TK, TV ).MoveNext( )
    dim as Map( of TK, TV ) ptr m = cptr( Map( of TK, TV ) ptr, this.src )
    dim as long cap = m->Capacity( )

    this.slot += 1
    while( (this.slot < cap) andalso (m->SlotUsed( this.slot ) = false) )
        this.slot += 1
    wend
end sub

function Map( of TK, TV ).Pairs( ) as MapPairView( of TK, TV )
    dim v as MapPairView( of TK, TV )
    v.src = @this
    return v
end function

function MapPairView( of TK, TV ).GetIterator( ) as MapPairIter( of TK, TV )
    dim r as MapPairIter( of TK, TV )
    r.it = cptr( Map( of TK, TV ) ptr, this.src )->GetIterator( )
    return r
end function

function MapPairIter( of TK, TV ).IsValid( ) as boolean
    return this.it.IsValid( )
end function

'' The pair the wrapped iterator assembles, repackaged as a tuple.  Both halves
'' are copied a second time; that is the price of the spelling.
function MapPairIter( of TK, TV ).Value( ) as (TK, TV)
    var kv = this.it.Value( )
    return (kv.key, kv.value)
end function

sub MapPairIter( of TK, TV ).MoveNext( )
    this.it.MoveNext( )
end sub

