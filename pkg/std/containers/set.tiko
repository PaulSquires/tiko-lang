#module "containers"
'' std/containers: set -- containers.Set( of T ), a hash set
''
'' A Map with the value machinery removed rather than a wrapper
'' around one, so a Set costs one slot per element instead of two.
''
''     dim seen as containers.Set( of long )
''     if seen.Add( 42 ) then print "first time"
''
''     for each x in seen
''         print x
''     next
''
'' Add returns FALSE when the element was already present, which is what makes
'' 'if seen.Add( x ) then' the natural spelling of "process each thing once".
''
'' THE HASH CONTRACT is in hash.tiko: 'HashOf( v )' must resolve and 'v = v'
'' must compare, and EQUAL ELEMENTS MUST HASH EQUAL.
''
'' Same implementation as Map -- open addressing, linear probing, power-of-two
'' capacity, Fibonacci hashing for the home slot, a control byte per slot holding
'' a 7-bit fingerprint, backward-shift deletion instead of tombstones, load
'' factor 0.75 -- and the same unspecified, unstable iteration order.  Map's
'' comments are the full account; these say what differs.




public const SET_MIN_CAPACITY as long = 8

'' The largest power of two a long holds; past it Add fills the table and then
'' returns FALSE without storing, as Map.Put does.
public const SET_MAX_CAPACITY as long = &h40000000

'' control bytes, as Map's: EMPTY, or the USED bit with a fingerprint under it
const SET_EMPTY    as ubyte = 0
const SET_USED_BIT as ubyte = &h80

'' Locate's "no EMPTY slot ended the probe", as MAP_NOSLOT
const SET_NOSLOT as long = -&h7FFFFFFF

public type SetIterator( of T )
    as any ptr src
    as long slot
    declare function IsValid( ) as boolean
    declare function Value( ) byref as T
    declare sub MoveNext( )
end type

public type Set( of T )
    private:
    as T elems( any )                   '' an EMPTY slot holds a default element
    as ubyte ctrl( any )                '' one control byte per slot -- see CtrlOf( )
    as long num                         '' live elements
    as long cap_                        '' slots allocated -- see Capacity( )
    as long shift_                      '' 64 - log2( cap_ ) -- see Mix( )
    declare function Mix( byref v as T ) as ulongint
    declare function CtrlOf( byval h as ulongint ) as ubyte
    declare function Locate( byref v as T, byval h as ulongint ) as long

    public:
    declare function Count( ) as long
    declare function IsEmpty( ) as boolean
    declare function Capacity( ) as long

    declare sub Reserve( byval n as long )
    declare sub Clear( )

    declare function FindSlot( byref v as T ) as long
    declare function Add( byref v as T ) as boolean
    declare function Contains( byref v as T ) as boolean
    declare function Remove( byref v as T ) as boolean

    declare sub UnionWith( byref other as Set( of T ) )
    declare sub IntersectWith( byref other as Set( of T ) )
    declare sub ExceptWith( byref other as Set( of T ) )

    declare function Items( ) as Array( of T )
    declare function GetIterator( ) as SetIterator( of T )
    '' THE SLOT PROTOCOL SetIterator walks: slots 0 to Capacity( ) - 1, of which the used
    '' ones hold elements. 'for each' is the way to use it; it is public only because an
    '' iterator is another type and cannot see this one's private fields.
    declare function SlotUsed( byval slot as long ) as boolean
    declare function SlotValue( byval slot as long ) byref as T
end type

function Set( of T ).Count( ) as long
    return this.num
end function

function Set( of T ).IsEmpty( ) as boolean
    return this.num = 0
end function

'' KEPT IN A FIELD, set where the arrays are sized -- as in Map. It was 'ubound( state ) -
'' lbound( state ) + 1', and both are RUNTIME CALLS over a dynamic array (fb_ArrayUBound,
'' fb_ArrayLBound) -- two calls on every lookup, four on an Add.
function Set( of T ).Capacity( ) as long
    return this.cap_
end function

function Set( of T ).SlotUsed( byval slot as long ) as boolean
    return this.ctrl( slot ) <> SET_EMPTY
end function

function Set( of T ).SlotValue( byval slot as long ) byref as T
    return this.elems( slot )
end function

'' HashOf( v ) times 2^64 / phi: the top bits are the home slot, the seven under them
'' the fingerprint -- as Map.Mix.
function Set( of T ).Mix( byref v as T ) as ulongint
    return HashOf( v ) * CONTAINERS_FIB_MULT
end function

'' as Map.CtrlOf
function Set( of T ).CtrlOf( byval h as ulongint ) as ubyte
    return SET_USED_BIT or cast( ubyte, ( h shr ( this.shift_ - 7 ) ) and &h7F )
end function

'' v's slot; on a miss 'not' the EMPTY slot that ended the probe; or SET_NOSLOT --
'' as Map.Locate.
function Set( of T ).Locate( byref v as T, byval h as ulongint ) as long
    dim as long cap = this.cap_
    if( cap = 0 ) then
        return SET_NOSLOT
    end if

    dim as long mask = cap - 1
    dim as long i = cast( long, h shr this.shift_ )
    dim as ubyte c = this.CtrlOf( h )

    for probe as long = 0 to cap-1
        dim as ubyte s = this.ctrl( i )
        if( s = c ) then
            if( this.elems( i ) = v ) then
                return i
            end if
        elseif( s = SET_EMPTY ) then
            return not i
        end if

        i = (i + 1) and mask
    next

    return SET_NOSLOT
end function

'' The slot holding v, or -1.
function Set( of T ).FindSlot( byref v as T ) as long
    if( this.cap_ = 0 ) then
        return -1
    end if

    dim as long i = this.Locate( v, this.Mix( v ) )
    if( i < 0 ) then
        return -1
    end if
    return i
end function

'' Grow to hold at least n elements under a 0.75 load factor; a table already big
'' enough is left alone.  Elements move by SWAP, never copied; sizes in 64 bits,
'' stopping at SET_MAX_CAPACITY -- as Map.Reserve.
sub Set( of T ).Reserve( byval n as long )
    dim as longint want = SET_MIN_CAPACITY

    while( ( (want * 3) \ 4 < n ) andalso ( want < SET_MAX_CAPACITY ) )
        want *= 2
    wend

    if( want <= this.cap_ ) then
        exit sub
    end if

    dim as long oldcap = this.cap_
    dim oldelems( any ) as T
    dim oldctrl( any ) as ubyte

    if( oldcap > 0 ) then
        redim oldelems( 0 to oldcap-1 )
        redim oldctrl( 0 to oldcap-1 )
        for i as long = 0 to oldcap-1
            oldctrl( i ) = this.ctrl( i )
            if( this.ctrl( i ) <> SET_EMPTY ) then
                swap oldelems( i ), this.elems( i )
            end if
        next
    end if

    redim this.elems( 0 to want-1 )
    redim this.ctrl( 0 to want-1 )
    this.cap_ = want
    this.shift_ = 64
    dim as longint w = want
    while( w > 1 )
        w shr= 1
        this.shift_ -= 1
    wend

    dim as long mask = this.cap_ - 1
    for i as long = 0 to oldcap-1
        if( oldctrl( i ) <> SET_EMPTY ) then
            dim as ulongint h = this.Mix( oldelems( i ) )
            dim as long j = cast( long, h shr this.shift_ )
            while( this.ctrl( j ) <> SET_EMPTY )
                j = (j + 1) and mask
            wend
            swap this.elems( j ), oldelems( i )
            this.ctrl( j ) = this.CtrlOf( h )
        end if
    next
end sub

sub Set( of T ).Clear( )
    dim as T blank

    for i as long = 0 to this.Capacity( )-1
        if( this.ctrl( i ) <> SET_EMPTY ) then
            this.elems( i ) = blank
        end if
        this.ctrl( i ) = SET_EMPTY
    next

    this.num = 0
end sub

'' Insert.  Returns FALSE if the element was already present, which is the
'' "have I seen this before" idiom -- and also when the table is full at
'' SET_MAX_CAPACITY.
''
'' One probe, and v COPIED ONLY WHEN THE TABLE GROWS: v may point INTO this set
'' and the rehash moves it -- as Map.InsertNew.
function Set( of T ).Add( byref v as T ) as boolean
    dim as ulongint h = this.Mix( v )
    dim as long at = this.Locate( v, h )

    if( at >= 0 ) then
        return false
    end if

    if( ( clngint( this.num ) + 1 ) * 4 > clngint( this.cap_ ) * 3 ) then
        dim as T vv = v
        this.Reserve( this.num + 1 )
        at = this.Locate( vv, h )
        if( at = SET_NOSLOT ) then
            return false
        end if
        at = not at
        swap this.elems( at ), vv
    else
        at = not at
        this.elems( at ) = v
    end if

    this.ctrl( at ) = this.CtrlOf( h )
    this.num += 1
    return true
end function

function Set( of T ).Contains( byref v as T ) as boolean
    return this.FindSlot( v ) >= 0
end function

'' Returns TRUE if something was removed.  Backward-shift deletion, no tombstone:
'' see Map.Remove, including its price, a Mix per entry the run passes.
function Set( of T ).Remove( byref v as T ) as boolean
    if( this.cap_ = 0 ) then
        return false
    end if

    dim as long i = this.Locate( v, this.Mix( v ) )
    if( i < 0 ) then
        return false
    end if

    dim as long mask = this.cap_ - 1
    dim as long j = i
    do
        j = (j + 1) and mask
        if( this.ctrl( j ) = SET_EMPTY ) then
            exit do
        end if
        if( j = i ) then                '' no EMPTY slot: full at SET_MAX_CAPACITY
            exit do
        end if

        dim as long home = cast( long, this.Mix( this.elems( j ) ) shr this.shift_ )
        if( ( (j - home) and mask ) >= ( (j - i) and mask ) ) then
            swap this.elems( i ), this.elems( j )
            this.ctrl( i ) = this.ctrl( j )
            i = j
        end if
    loop

    dim as T blank
    this.elems( i ) = blank
    this.ctrl( i ) = SET_EMPTY
    this.num -= 1

    return true
end function

'' this = this OR other
sub Set( of T ).UnionWith( byref other as Set( of T ) )
    for i as long = 0 to other.Capacity( )-1
        if( other.ctrl( i ) <> SET_EMPTY ) then
            this.Add( other.elems( i ) )
        end if
    next
end sub

'' this = this AND other.
''
'' Collected first, then removed: a removal shifts later entries back into
'' slots a walk over this set's own slots has already passed.
sub Set( of T ).IntersectWith( byref other as Set( of T ) )
    dim doomed as Array( of T )

    for i as long = 0 to this.Capacity( )-1
        if( this.ctrl( i ) <> SET_EMPTY ) then
            if( other.Contains( this.elems( i ) ) = false ) then
                doomed.Push( this.elems( i ) )
            end if
        end if
    next

    for i as long = 0 to doomed.Count( )-1
        this.Remove( doomed[ i ] )
    next
end sub

'' this = this AND NOT other
sub Set( of T ).ExceptWith( byref other as Set( of T ) )
    '' 's.ExceptWith( s )' would walk the slots it removes from, and a removal
    '' shifts an unvisited entry back into a visited slot
    if( @other = @this ) then
        this.Clear( )
        exit sub
    end if

    '' Walk the SMALLER side where possible.  Removing 'other's elements one by
    '' one is O(|other|); scanning this set is O(capacity).
    for i as long = 0 to other.Capacity( )-1
        if( other.ctrl( i ) <> SET_EMPTY ) then
            this.Remove( other.elems( i ) )
        end if
    next
end sub

'' A snapshot, in the set's own unspecified order.
function Set( of T ).Items( ) as Array( of T )
    dim r as Array( of T )
    r.Reserve( this.num )
    for i as long = 0 to this.Capacity( )-1
        if( this.ctrl( i ) <> SET_EMPTY ) then
            r.Push( this.elems( i ) )
        end if
    next
    return r
end function

function Set( of T ).GetIterator( ) as SetIterator( of T )
    dim it as SetIterator( of T )
    it.src = @this
    it.slot = 0

    dim as long cap = this.Capacity( )
    while( (it.slot < cap) andalso (this.ctrl( it.slot ) = SET_EMPTY) )
        it.slot += 1
    wend

    return it
end function

function SetIterator( of T ).IsValid( ) as boolean
    dim as Set( of T ) ptr s = cptr( Set( of T ) ptr, this.src )
    return this.slot < s->Capacity( )
end function

'' BYREF, so 'for each byref' compiles -- but an element of a hash set must not
'' be modified in place: changing it changes its hash and it can never be found
'' again.  Remove and re-Add instead.
function SetIterator( of T ).Value( ) byref as T
    dim as Set( of T ) ptr s = cptr( Set( of T ) ptr, this.src )
    return s->SlotValue( this.slot )
end function

sub SetIterator( of T ).MoveNext( )
    dim as Set( of T ) ptr s = cptr( Set( of T ) ptr, this.src )
    dim as long cap = s->Capacity( )

    this.slot += 1
    while( (this.slot < cap) andalso (s->SlotUsed( this.slot ) = false) )
        this.slot += 1
    wend
end sub

