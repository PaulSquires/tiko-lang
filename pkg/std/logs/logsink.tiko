#module "logs"
#import "std/numeric"
using numeric
'' std/logs: logsink -- FB.Logging sinks
''
'' RFC-0004 -- C:\dev\docs\logging\RFC-0004-sinks.md.
''
'' A sink owns a destination. It holds the lock, it owns the encoding, and it is
'' the only thing in this module that touches the outside world.
''
'' Phase 1 ships ConsoleSink. FileSink and rotation (phase 3) are in
'' fb/logfile.bi.
''
'' ---------------------------------------------------------------------------
'' WHY THERE IS NO -mt REQUIREMENT
''
'' mutexcreate/mutexlock work in a SINGLE-THREADED build as well -- measured.
'' So the lock is unconditional and a program does not have to opt into -mt to
'' get a correct logger, unlike fb/sync.bi and fb/scheduler.bi which do.


#include once "fb/chrono.bi"
#include once "fb/array.bi"

using FB

'' ============================================================== Sink
''
'' Four obligations, and each is load-bearing:
''
''   Write  takes the RECORD, not rendered text, so a sink chooses its own
''          renderer and a later AsyncSink can defer rendering to its worker.
''          IT CANNOT FAIL -- no return value, no raise (RFC-0005 section 1).
''   Flush  makes what has been written as durable as this sink can. Safe on an
''          already-flushed or already-closed sink.
''   Close  flushes and releases. IDEMPOTENT: LogShutdown and a destructor will
''          both reach it.
''   DroppedCount  is the honesty channel. Never resets.
public type Sink extends object
    declare abstract sub Write( byref r as LogRecord )
    declare abstract sub Flush( )
    declare abstract sub Close( )
    declare abstract function DroppedCount( ) as ulongint
    declare virtual destructor( )
end type

virtual destructor Sink( )
end destructor

'' The alias is required: a generic does not instantiate directly in a TYPE
'' field, and Logger holds one of these.
public type SinkPtrArray as Array( of Sink ptr )

'' ============================================================== ConsoleSink
public enum ConsoleTarget
    CT_STDERR = 0        '' default
    CT_STDOUT
end enum

public type ConsoleSink extends Sink
    declare constructor( )
    declare constructor( byval target as ConsoleTarget )
    declare constructor( byval target as ConsoleTarget, byval r as Renderer ptr )
    declare destructor( ) override

    declare sub Write( byref r as LogRecord ) override
    declare sub Flush( ) override
    declare sub Close( ) override
    declare function DroppedCount( ) as ulongint override

    declare property Colour( ) as boolean
    declare property Colour( byval v as boolean )
    declare property IsConsole( ) as boolean

private:
    declare sub hInit( byval target as ConsoleTarget, byval r as Renderer ptr )
    declare function hEmit( byref s as ustring, byref os as long ) as ustring
    declare function hName( ) as ustring

    m_lock      as any ptr
    m_rend      as Renderer ptr      '' either @m_text or the caller's
    m_text      as TextRenderer      '' the one this sink owns
    m_ownrend   as boolean
    m_dropped   as ulongint
    m_closed    as boolean
    m_isconsole as boolean
    m_target    as ConsoleTarget
    m_thr       as hLogThrottle      '' RFC-0005 rule 3: one report a second
    m_buf       as ustring           '' reused across records; Render appends
    #ifdef __FB_WIN32__
        m_k32 as hLogK32
        m_h   as any ptr
    #else
        m_fd as long
    #endif
end type

constructor ConsoleSink( )
    this.hInit( CT_STDERR, 0 )
end constructor

constructor ConsoleSink( byval target as ConsoleTarget )
    this.hInit( target, 0 )
end constructor

constructor ConsoleSink( byval target as ConsoleTarget, byval r as Renderer ptr )
    this.hInit( target, r )
end constructor

'' RFC-0004 section 4. STDERR BY DEFAULT: logs are diagnostics, not output, and
'' a program whose stdout is piped into another program must not have its log
'' lines land in the pipe.
sub ConsoleSink.hInit( byval target as ConsoleTarget, byval r as Renderer ptr )
    this.m_lock    = mutexcreate( )
    this.m_dropped = 0
    this.m_closed  = FALSE
    this.m_target  = target

    if( r <> 0 ) then
        this.m_rend    = r
        this.m_ownrend = FALSE
    else
        this.m_rend    = @this.m_text
        this.m_ownrend = TRUE
    end if

    dim as boolean wantcolour = TRUE

    #ifdef __FB_WIN32__
        this.m_k32.Load( )
        this.m_h = 0
        this.m_isconsole = FALSE
        if( this.m_k32.pGetStdHandle <> 0 ) then
            if( target = CT_STDOUT ) then
                this.m_h = this.m_k32.pGetStdHandle( FB_LOG_STD_OUTPUT )
            else
                this.m_h = this.m_k32.pGetStdHandle( FB_LOG_STD_ERROR )
            end if
        end if
        if( this.m_k32.pGetFileType <> 0 ) then
            this.m_isconsole = ( this.m_k32.pGetFileType( this.m_h ) = FB_LOG_FILE_TYPE_CHAR )
        end if

        '' Test 3 of RFC-0004 section 4: on a Windows build too old to accept
        '' virtual-terminal processing the sequences would print as literal
        '' garbage, so colour is only on if enabling it actually worked.
        if( this.m_isconsole ) then
            dim as ulong mode
            if( this.m_k32.pGetConsoleMode = 0 orelse this.m_k32.pSetConsoleMode = 0 ) then
                wantcolour = FALSE
            elseif( this.m_k32.pGetConsoleMode( this.m_h, @mode ) = 0 ) then
                wantcolour = FALSE
            elseif( this.m_k32.pSetConsoleMode( this.m_h, mode or FB_LOG_ENABLE_VT ) = 0 ) then
                wantcolour = FALSE
            end if
        end if
    #else
        this.m_fd = iif( target = CT_STDOUT, 1, 2 )
        this.m_isconsole = ( hIsATty( this.m_fd ) <> 0 )
    #endif

    '' Test 2: redirected output is a file, and a file full of ESC[32m is the
    '' classic way this is got wrong.
    if( this.m_isconsole = FALSE ) then wantcolour = FALSE

    '' Test 1, and it wins over everything: the no-color.org convention.
    if( len( environ( "NO_COLOR" ) ) > 0 ) then wantcolour = FALSE

    if( this.m_ownrend ) then this.m_text.colour = wantcolour
end sub

destructor ConsoleSink( )
    this.Close( )
    if( this.m_lock <> 0 ) then
        mutexdestroy( this.m_lock )
        this.m_lock = 0
    end if
    #ifdef __FB_WIN32__
        this.m_k32.Unload( )
    #endif
end destructor

property ConsoleSink.Colour( ) as boolean
    return this.m_text.colour
end property

'' The override for a program that knows better than the three tests -- a CI
'' system that wants colour into a captured stream, say.
property ConsoleSink.Colour( byval v as boolean )
    if( this.m_ownrend ) then this.m_text.colour = v
end property

property ConsoleSink.IsConsole( ) as boolean
    return this.m_isconsole
end property

function ConsoleSink.DroppedCount( ) as ulongint
    return this.m_dropped
end function

'' RFC-0004 section 3. On Windows a console gets WIDE text, bypassing the
'' console code page: a console at CP437 would otherwise mangle every non-ASCII
'' character in a record. Everything else gets UTF-8.
function ConsoleSink.hName( ) as ustring
    if( this.m_target = CT_STDOUT ) then return "ConsoleSink(stdout)"
    return "ConsoleSink(stderr)"
end function

'' "" when the record was written; otherwise what went wrong, for the report.
'' On a GUI-subsystem program there is no console handle at all, and every
'' record lands here -- counted, and reported once a second.
function ConsoleSink.hEmit( byref s as ustring, byref os as long ) as ustring
    #ifdef __FB_WIN32__
        if( this.m_h = 0 orelse this.m_h = cast( any ptr, -1 ) ) then
            return "no console handle, record dropped"
        end if

        dim as ulong wrote
        if( this.m_isconsole ) then
            dim as long n = len( s )
            if( n = 0 ) then return ""
            dim as wstring ptr wp = callocate( (n + 1) * 2 )
            if( wp = 0 ) then return "out of memory, record dropped"
            *wp = s
            dim as long ok = 0
            if( this.m_k32.pWriteConsoleW <> 0 ) then ok = this.m_k32.pWriteConsoleW( this.m_h, wp, n, @wrote, 0 )
            if( ok = 0 andalso this.m_k32.pGetLastError <> 0 ) then os = this.m_k32.pGetLastError( )
            deallocate( wp )
            if( ok = 0 ) then return "write failed, record dropped"
        else
            dim as string u8 = s          '' ustring -> string is UTF-8
            if( len( u8 ) = 0 ) then return ""
            dim as long ok = 0
            if( this.m_k32.pWriteFile <> 0 ) then ok = this.m_k32.pWriteFile( this.m_h, strptr( u8 ), len( u8 ), @wrote, 0 )
            if( ok = 0 ) then
                if( this.m_k32.pGetLastError <> 0 ) then os = this.m_k32.pGetLastError( )
                return "write failed, record dropped"
            end if
        end if
    #else
        dim as string u8 = s
        if( len( u8 ) = 0 ) then return ""
        if( hWriteFd( this.m_fd, strptr( u8 ), len( u8 ) ) < 0 ) then
            return "write failed, record dropped"
        end if
    #endif
    return ""
end function

'' ONE MUTEX PER SINK, HELD ACROSS THE WHOLE WRITE. Not per-logger (which would
'' not protect a sink shared by a parent and its With( ) child) and not global
'' (which would make every log call in the process contend on one thing).
''
'' The rule this enforces: a record renders and writes as ONE UNIT, and no
'' record ever appears inside another. FreeBASIC's own PRINT # gives no such
'' guarantee -- two threads on one file handle interleave INSIDE a line, and
'' nothing reports it.
''
'' A record that is not written is DROPPED, counted, and REPORTED through
'' OnLogError -- after the lock is released (RFC-0005 rule 1), at most once a
'' second (rule 3).
sub ConsoleSink.Write( byref r as LogRecord )
    dim as ustring why
    dim as long os = 0
    dim as boolean report = FALSE

    mutexlock( this.m_lock )
    if( this.m_closed ) then
        why = "closed, record dropped"
    else
        this.m_buf = ""
        this.m_rend->Render( r, this.m_buf )
        why = this.hEmit( this.m_buf, os )
    end if
    if( len( why ) > 0 ) then
        this.m_dropped += 1
        report = this.m_thr.Admit( why )
    end if
    mutexunlock( this.m_lock )

    if( report ) then hLogReport( this.hName( ), why, os )
end sub

'' Nothing to flush: every Write reaches the OS handle directly, unbuffered by
'' this sink. Stated rather than left blank so that it reads as a decision.
sub ConsoleSink.Flush( )
end sub

'' Idempotent. The handle is a standard one and is NOT closed -- it does not
'' belong to this sink.
sub ConsoleSink.Close( )
    this.m_closed = TRUE
end sub

