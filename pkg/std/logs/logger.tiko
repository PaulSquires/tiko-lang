#module "logs"
#import "std/fs"
#import "std/numeric"
#import "std/chrono"
#import "std/containers"
using fs
using numeric
using chrono
using containers
'' std/logs: logger -- std/logs' front end
''
'' RFC-0002 -- C:\dev\docs\logging\RFC-0002-logger.md.
''
'' What a call site touches. Everything here is either a level test or a field
'' append; no I/O happens in this file. Logger.Emit hands a finished LogRecord
'' to the sinks.
''
''     dim con as ConsoleSink
''     dim lg as Logger
''     lg.MinLevel = LOG_DEBUG
''     lg.AddSink( @con )
''
''     lg.Info( "server started" )
''     lg.Warn( ).AddText( "user", u ).AddInt( "attempts", n ).Msg( "login failed" )
''
'' ---------------------------------------------------------------------------
'' THE EVENT LIVES ON THE CALLER'S STACK
''
'' Logger.Info( ) returns a LogEvent BY VALUE; every field method returns
'' `byref as LogEvent` to that same temporary; .Msg( ) is the only method that
'' commits. That is what makes this thread-safe with no thread-local storage --
'' and FreeBASIC has no user-reachable TLS to fall back on.
''
'' An earlier sketch returned byref to a `static as LogEvent`. It worked, and it
'' was thrown away: one static event shared by every thread is a data race that
'' only shows up under load.
''
'' AN EVENT THAT IS NEVER COMMITTED EMITS NOTHING. The destructor does NOT
'' auto-send. Auto-send-on-destruct (zerolog) makes a forgotten .Msg( )
'' invisible; here it means a missing line, which is noticed immediately.
''
'' ---------------------------------------------------------------------------
'' THE DEFAULT LOGGER IS NOT HERE
''
'' logs.DefaultLogger( ), LogInit and LogShutdown of RFC-0002 section 6 are in
'' logdefault.tiko (phase 4). As a header that file could not make the object --
'' a `dim shared` in a .bi included by two modules gave two of them, so the
'' program defined it with FB_LOG_IMPLEMENT( ); std/logs, one module, now does.




'' The forward alias exists so LogEvent can hold a `Logger ptr` before Logger
'' is defined. NOTE the consequence, measured: `Logger` is an INCOMPLETE type
'' here, so a member that returns a logger BY VALUE must be declared as
'' `LoggerType` -- spelling it `Logger` is `error 71: Incomplete type`. Callers are
'' unaffected: the alias is complete by the time they see it.
public type Logger as LoggerType

'' ============================================================== LogEvent
public type LogEvent
    declare constructor( )
    declare destructor( )

    declare function AddText  ( byref k as ustring, byref v as ustring  ) byref as LogEvent
    declare function AddInt   ( byref k as ustring, byval v as longint  ) byref as LogEvent
    declare function AddUInt  ( byref k as ustring, byval v as ulongint ) byref as LogEvent
    declare function AddFloat ( byref k as ustring, byval v as double   ) byref as LogEvent
    declare function AddBool  ( byref k as ustring, byval v as boolean  ) byref as LogEvent
    declare function AddPtr   ( byref k as ustring, byval v as any ptr  ) byref as LogEvent
    declare function AddTime  ( byref k as ustring, byref v as Instant  ) byref as LogEvent
    declare function AddSpan  ( byref k as ustring, byref v as TimeSpan ) byref as LogEvent
    declare function AddValue ( byref k as ustring, byref v as LogValue ) byref as LogEvent

    declare function AddError ( byref v as FsError ) byref as LogEvent
    declare function Site ( byref f as ustring, byval l as long, byref fn as ustring ) byref as LogEvent

    declare sub Msg( byref m as ustring )
    declare sub Send( )

    '' public because Logger constructs one; not part of the call-site surface
    m_owner   as Logger ptr
    m_enabled as boolean
    m_rec     as LogRecord
end type

'' ============================================================== Logger
public type LoggerType
    declare constructor( )
    declare destructor( )

    declare property MinLevel( ) as LogLevel
    declare property MinLevel( byval lv as LogLevel )
    declare property Name( ) as ustring
    declare property Name( byref n as ustring )

    declare function Enabled( byval lv as LogLevel ) as boolean

    declare sub AddSink   ( byval s as Sink ptr )
    declare sub RemoveSink( byval s as Sink ptr )
    declare sub ClearSinks( )
    declare function SinkCount( ) as long

    declare function WithField( byref k as ustring, byref v as LogValue ) as LoggerType
    declare function WithName( byref n as ustring ) as LoggerType

    declare function Log   ( byval lv as LogLevel ) as LogEvent
    declare function Trace ( ) as LogEvent
    declare function Debug ( ) as LogEvent
    declare function Info  ( ) as LogEvent
    declare function Warn  ( ) as LogEvent
    declare function Error( ) as LogEvent
    declare function Fatal ( ) as LogEvent

    declare sub Log   ( byval lv as LogLevel, byref m as ustring )
    declare sub Trace ( byref m as ustring )
    declare sub Debug ( byref m as ustring )
    declare sub Info  ( byref m as ustring )
    declare sub Warn  ( byref m as ustring )
    declare sub Error( byref m as ustring )
    declare sub Fatal ( byref m as ustring )

    declare sub Emit( byref r as LogRecord )
    declare sub Flush( )

    m_minlevel as LogLevel
    m_name     as ustring
    m_fields   as LogFieldArray      '' inherited, from With( )
    m_sinks    as SinkPtrArray
end type

constructor LoggerType( )
    this.m_minlevel = LOG_INFO
end constructor

destructor LoggerType( )
end destructor

property LoggerType.MinLevel( ) as LogLevel
    return this.m_minlevel
end property

property LoggerType.MinLevel( byval lv as LogLevel )
    this.m_minlevel = lv
end property

property LoggerType.Name( ) as ustring
    return this.m_name
end property

property LoggerType.Name( byref n as ustring )
    this.m_name = n
end property

'' ONE COMPARISON. No lock, no allocation. This is the whole performance story:
'' every LogEvent returned by a disabled level has m_enabled = FALSE, and every
'' one of its field methods is an immediate return, so nothing is formatted and
'' no LogField is ever constructed.
''
'' What it does NOT avoid is evaluating the ARGUMENTS at the call site. That is
'' irreducible at runtime in a language without lazy arguments, and it is what
'' logmacros.tiko (phase 5) exists to remove.
function LoggerType.Enabled( byval lv as LogLevel ) as boolean
    return ( lv >= this.m_minlevel )
end function

'' THE LOGGER DOES NOT OWN ITS SINKS. Lifetime is the program's: a sink must
'' outlive every logger holding it. That is what makes copying a Logger -- which
'' With( ) requires -- cheap and obviously not a duplicated file handle.
sub LoggerType.AddSink( byval s as Sink ptr )
    if( s <> nullptr ) then this.m_sinks.Push( s )
end sub

sub LoggerType.RemoveSink( byval s as Sink ptr )
    for i as long = this.m_sinks.Count( ) - 1 to 0 step -1
        if( this.m_sinks[i] = s ) then this.m_sinks.Remove( i )
    next
end sub

sub LoggerType.ClearSinks( )
    this.m_sinks.Clear( )
end sub

function LoggerType.SinkCount( ) as long
    return this.m_sinks.Count( )
end function

'' NOT `With`: WITH is a statement and the name is refused outright (TKO0600).
''
'' THE FIELD METHODS ARE NAMED Add<kind> -- AddText, AddInt, AddUInt, AddFloat,
'' AddBool, AddPtr, AddTime, AddSpan, AddValue, AddError -- so that none of them
'' collides with the language. Their first names did: INT and PTR are keywords
'' (TKO0600), which forced `Int_` and `Ptr_`; STR, VAL, TIME and ERR are
'' intrinsics, and a member named Str shadowed STR( ) inside the type's own
'' member bodies. A type name is no better: the fixed-width names are typedefs,
'' so a member called Int64 would shadow the type the same way. The level
'' methods -- Error, Log and the rest -- keep their names: being an intrinsic is
'' not enough to block a member name, only being a keyword or a statement is.
''
'' RFC-0002 section 5. Returns a NEW Logger by value carrying the parent's
'' level, sinks and inherited fields PLUS the new one. The parent is untouched
'' and the child does not alias it -- the generic member deep-copies.
''
'' A CHILD IS A SNAPSHOT: changing the parent's MinLevel afterwards does not
'' change the child's. That is the right default for what With( ) is for -- a
'' subsystem that captures its logger once at startup.
function LoggerType.WithField( byref k as ustring, byref v as LogValue ) as LoggerType
    dim child as LoggerType = this
    child.m_fields.Push( LogField( k, v ) )
    return child
end function

function LoggerType.WithName( byref n as ustring ) as LoggerType
    dim child as LoggerType = this
    child.m_name = n
    return child
end function

sub LoggerType.Emit( byref r as LogRecord )
    for i as long = 0 to this.m_sinks.Count( ) - 1
        this.m_sinks[i]->Write( r )
    next
end sub

sub LoggerType.Flush( )
    for i as long = 0 to this.m_sinks.Count( ) - 1
        this.m_sinks[i]->Flush( )
    next
end sub

function LoggerType.Log( byval lv as LogLevel ) as LogEvent
    dim e as LogEvent
    e.m_owner   = @this
    e.m_enabled = this.Enabled( lv )
    if( e.m_enabled = FALSE ) then return e

    e.m_rec.level   = lv
    e.m_rec.stamp   = WallClock.UtcNow( )
    '' Raw monotonic ticks rather than a process Stopwatch: a Stopwatch would
    '' be a process-wide singleton, which a header could not make. Absolute and
    '' comparable within the process, which is all ordering needs.
    e.m_rec.mono    = fb_DtTicksFromCounts( fb_DtMonoTimestamp( ), fb_DtMonoFrequency( ) )
    e.m_rec.logname = this.m_name

    '' Inherited fields first, call-site fields after -- so "most specific
    '' last" is available to any renderer that wants last-wins. Reserved in
    '' one go because every LogValue is 40 bytes (RFC-0001 section 1).
    dim as long n = this.m_fields.Count( )
    if( n > 0 ) then
        e.m_rec.fields.Reserve( n + 4 )
        for i as long = 0 to n - 1
            e.m_rec.fields.Push( this.m_fields[i] )
        next
    end if

    return e
end function

function LoggerType.Trace ( ) as LogEvent : return this.Log( LOG_TRACE ) : end function
function LoggerType.Debug ( ) as LogEvent : return this.Log( LOG_DEBUG ) : end function
function LoggerType.Info  ( ) as LogEvent : return this.Log( LOG_INFO  ) : end function
function LoggerType.Warn  ( ) as LogEvent : return this.Log( LOG_WARN  ) : end function
function LoggerType.Error( ) as LogEvent : return this.Log( LOG_ERROR ) : end function
function LoggerType.Fatal ( ) as LogEvent : return this.Log( LOG_FATAL ) : end function

'' The one-line form, expected to be the majority of call sites. It exists so
'' that structured logging does not tax the case with nothing to capture. The
'' overload pair resolves on ARITY, which is the one thing fbc overload
'' resolution is reliable at.
sub LoggerType.Log( byval lv as LogLevel, byref m as ustring )
    if( this.Enabled( lv ) = FALSE ) then exit sub
    dim e as LogEvent = this.Log( lv )
    e.Msg( m )
end sub

sub LoggerType.Trace ( byref m as ustring ) : this.Log( LOG_TRACE, m ) : end sub
sub LoggerType.Debug ( byref m as ustring ) : this.Log( LOG_DEBUG, m ) : end sub
sub LoggerType.Info  ( byref m as ustring ) : this.Log( LOG_INFO , m ) : end sub
sub LoggerType.Warn  ( byref m as ustring ) : this.Log( LOG_WARN , m ) : end sub
sub LoggerType.Error( byref m as ustring ) : this.Log( LOG_ERROR, m ) : end sub
sub LoggerType.Fatal ( byref m as ustring ) : this.Log( LOG_FATAL, m ) : end sub

'' ============================================================== LogEvent impl
constructor LogEvent( )
    this.m_owner   = nullptr
    this.m_enabled = FALSE
end constructor

destructor LogEvent( )
end destructor

function LogEvent.AddValue( byref k as ustring, byref v as LogValue ) byref as LogEvent
    if( this.m_enabled ) then this.m_rec.fields.Push( LogField( k, v ) )
    return this
end function

function LogEvent.AddText( byref k as ustring, byref v as ustring ) byref as LogEvent
    if( this.m_enabled ) then this.m_rec.fields.Push( LogField( k, LogValue( v ) ) )
    return this
end function

function LogEvent.AddInt( byref k as ustring, byval v as longint ) byref as LogEvent
    if( this.m_enabled ) then this.m_rec.fields.Push( LogField( k, LogValue( v ) ) )
    return this
end function

function LogEvent.AddUInt( byref k as ustring, byval v as ulongint ) byref as LogEvent
    if( this.m_enabled ) then this.m_rec.fields.Push( LogField( k, LogValue( v ) ) )
    return this
end function

function LogEvent.AddFloat( byref k as ustring, byval v as double ) byref as LogEvent
    if( this.m_enabled ) then this.m_rec.fields.Push( LogField( k, LogValue( v ) ) )
    return this
end function

function LogEvent.AddBool( byref k as ustring, byval v as boolean ) byref as LogEvent
    if( this.m_enabled ) then this.m_rec.fields.Push( LogField( k, LogValue( v ) ) )
    return this
end function

function LogEvent.AddPtr( byref k as ustring, byval v as any ptr ) byref as LogEvent
    if( this.m_enabled ) then this.m_rec.fields.Push( LogField( k, LogValue( v ) ) )
    return this
end function

function LogEvent.AddTime( byref k as ustring, byref v as Instant ) byref as LogEvent
    if( this.m_enabled ) then this.m_rec.fields.Push( LogField( k, LogValue( v ) ) )
    return this
end function

function LogEvent.AddSpan( byref k as ustring, byref v as TimeSpan ) byref as LogEvent
    if( this.m_enabled ) then this.m_rec.fields.Push( LogField( k, LogValue( v ) ) )
    return this
end function

'' Two fields from one call, so that a failed file operation logs consistently
'' everywhere instead of each call site inventing its own key names.
function LogEvent.AddError( byref v as FsError ) byref as LogEvent
    if( this.m_enabled ) then
        this.m_rec.fields.Push( LogField( "error", LogValue( v.Message( ) ) ) )
        this.m_rec.fields.Push( LogField( "error.code", LogValue( clngint( v.Code( ) ) ) ) )
        if( v.OsCode( ) <> 0 ) then
            this.m_rec.fields.Push( LogField( "error.os", LogValue( clngint( v.OsCode( ) ) ) ) )
        end if
    end if
    return this
end function

function LogEvent.Site( byref f as ustring, byval l as long, byref fn as ustring ) byref as LogEvent
    if( this.m_enabled ) then
        this.m_rec.srcfile = f
        this.m_rec.srcline = l
        this.m_rec.srcfunc = fn
    end if
    return this
end function

sub LogEvent.Msg( byref m as ustring )
    if( this.m_enabled = FALSE ) then exit sub
    this.m_rec.message = m
    this.Send( )
end sub

'' Send( ) commits with the message already set or empty. Two names because a
'' message-less structured record is legitimate and .Msg( "" ) reads like an
'' accident.
sub LogEvent.Send( )
    if( this.m_enabled = FALSE ) then exit sub
    if( this.m_owner <> nullptr ) then this.m_owner->Emit( this.m_rec )
    this.m_enabled = FALSE          '' committing twice would emit twice
end sub

