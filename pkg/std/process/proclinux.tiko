#module "process"
#ifdef __FB_UNIX__
#include once "../../sys/posix/posix.ti"
using posix
#endif
'' std/process: proclinux -- what only Linux has.  The rest of the POSIX side is
'' procposix.tiko, which calls the module-private helpers below.  A Darwin build
'' needs a procdarwin.tiko beside this one providing the same three:
''
''     hErrno( )                  this thread's errno (Darwin: *__error( ))
''     hEnviron( )                the environment block (Darwin: *_NSGetEnviron( ))
''     hPipeCloexec( fds )        a pipe with both ends O_CLOEXEC (Darwin has no pipe2:
''                                pipe( ) then fcntl( F_SETFD, FD_CLOEXEC ), and
''                                POSIX_SPAWN_CLOEXEC_DEFAULT to close the race)

#ifdef __FB_LINUX__

extern "C"
    declare function tkp_errno_location alias "__errno_location" ( ) as long ptr
    declare function tkp_pipe2 alias "pipe2" ( byval fds as long ptr, byval flags as long ) as long
    extern tkp_environ alias "environ" as zstring ptr ptr
end extern

private function hErrno( ) as long
    return *tkp_errno_location( )
end function

private function hEnviron( ) as zstring ptr ptr
    return tkp_environ
end function

'' Every pipe to a child is close-on-exec from the start (rule 4).
private function hPipeCloexec( byval fds as long ptr ) as long
    return tkp_pipe2( fds, O_CLOEXEC )
end function

#endif
