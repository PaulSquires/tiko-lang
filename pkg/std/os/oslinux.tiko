#module "os"
#import "std/containers"
#import "std/outcome"
#ifdef __FB_UNIX__
#include once "../../sys/posix/posix.ti"
using posix
#endif
using containers
using outcome
'' std/os: oslinux -- what only Linux has.  The rest of the POSIX side is
'' osposix.tiko, which calls the module-private helpers below.  A Darwin build needs
'' an osdarwin.tiko beside this one providing the same five:
''
''     Args( )                public; argv as given (Darwin: _NSGetArgc / _NSGetArgv)
''     hErrno( )              this thread's errno (Darwin: *__error( ))
''     hEnviron( )            the environment block (Darwin: *_NSGetEnviron( ))
''     hAffinityCount( )      the CPUs this process may run on, 0 when the OS cannot
''                            say (Darwin has no affinity API: 0)
''     hPipeNonBlockCloexec   a self-pipe, both ends O_NONBLOCK and O_CLOEXEC (Darwin
''                            has no pipe2: pipe( ), then fcntl on both ends)

#ifdef __FB_LINUX__

extern "C"
    declare function tkos_errno_location alias "__errno_location" ( ) as long ptr
    declare function tkos_open alias "open" ( byval p as const zstring ptr, byval flags as long, ... ) as long
    declare function tkosl_read alias "read" ( byval fd as long, byval buf as any ptr, byval n as uinteger ) as integer
    declare function tkos_close alias "close" ( byval fd as long ) as long
    declare function tkos_sched_getaffinity alias "sched_getaffinity" ( byval pid as pid_t, byval size as uinteger, _
        byval mask as cpu_set_t ptr ) as long
    declare function tkos_pipe2 alias "pipe2" ( byval fds as long ptr, byval flags as long ) as long
    extern tkos_environ alias "environ" as zstring ptr ptr
end extern

private function hErrno( ) as long
    return *tkos_errno_location( )
end function

private function hEnviron( ) as zstring ptr ptr
    return tkos_environ
end function

'' ---- arguments

'' /proc/self/cmdline is the arguments, each NUL-terminated, in the bytes the
'' program was given (UTF-8 in practice).
public function Args( ) as Array( of ustring )
    dim as Array( of ustring ) r
    dim as long fd = tkos_open( "/proc/self/cmdline", O_RDONLY )
    if( fd >= 0 ) then
        dim as string all_ = ""
        dim as zstring * 4097 buf
        do
            dim as integer got = tkosl_read( fd, @buf, 4096 )
            if( got <= 0 ) then exit do
            dim as string chunk = space( got )
            for i as long = 0 to got - 1
                chunk[i] = buf[i]
            next
            all_ &= chunk
        loop
        tkos_close( fd )
        dim as long st = 0
        for i as long = 0 to len( all_ ) - 1
            if( all_[i] = 0 ) then
                dim as ustring a = mid( all_, st + 1, i - st )
                r.Push( a )
                st = i + 1
            end if
        next
        if( r.num > 0 ) then return r
    end if
    '' no /proc: the runtime's COMMAND( ), which cannot show an empty argument
    dim as long i = 0
    do
        dim as ustring c = command( i )
        if( ( i > 0 ) andalso ( len( c ) = 0 ) ) then exit do
        r.Push( c )
        i += 1
    loop
    return r
end function

'' ---- host facts

'' sched_getaffinity's cpu_set_t: what this process may run on (containers and
'' taskset included), not what the machine has.  0 when it cannot say.
private function hAffinityCount( ) as long
    dim as cpu_set_t mask
    if( tkos_sched_getaffinity( 0, sizeof( cpu_set_t ), @mask ) <> 0 ) then return 0
    dim as ubyte ptr m = cptr( ubyte ptr, @mask )
    dim as long n = 0
    for i as long = 0 to sizeof( cpu_set_t ) - 1
        dim as ulong b = m[i]
        while( b <> 0 )
            if( ( b and 1 ) <> 0 ) then n += 1
            b shr= 1
        wend
    next
    return n
end function

'' ---- interrupts

'' CatchInterrupt's self-pipe, both ends non-blocking and close-on-exec, atomically.
private function hPipeNonBlockCloexec( byval fds as long ptr ) as long
    return tkos_pipe2( fds, O_NONBLOCK or O_CLOEXEC )
end function

#endif
