#module "numeric"
#import "std/outcome"
using outcome
'' std/numeric: complex -- double-precision complex numbers
''
''     #import "std/numeric"
''     using numeric
''
''     dim as Complex z = CSet( 3, 4 )
''     print CAbs( z )                 '' 5
''     print CToString( z * z )        '' -7+24i
''     dim as Complex w = CExp( z )
''
'' Specified by C:\dev\docs\math\RFC-0009-complex.md, which supersedes RFC-0007
'' s5.  Complex numbers used to live in fb/vector.bi; they were removed from it
'' when this file was written, as fb/complex.bi.  Both are std/numeric now, so
'' one #import gets both -- vector.tiko and complex.tiko are files of the same
'' module.
''
'' EVERY FUNCTION CARRIES A 'C' PREFIX.  Exp, Log, Sqr, Sin, Cos, Tan, Abs, Atn
'' and Str are FreeBASIC intrinsics, and a function of one of those names in
'' namespace FB SHADOWS the intrinsic for every later header -- measured during
'' phase 8, where it broke fb/random.bi -- after which the intrinsic cannot be
'' called back.  So the transcendentals must be prefixed, and given that, the
'' prefix is applied uniformly: a mixed scheme would require the reader to know
'' which of 'Sin' and 'Real' is an intrinsic in order to guess the spelling.
''
'' The TYPE is 'Complex', unprefixed.  There is no intrinsic of that name, and
'' the prefix exists to separate functions from intrinsics.
''
'' 'CStr' is a FreeBASIC keyword, so AfxNova's CStr( z ) is CToString( z ) here
'' -- which also names what it is: the round-tripping form from RFC-0004, not
'' STR.
''
'' DOUBLE ONLY.  No Complexf.  Both source libraries are double-only, and with
'' one element type there is no macro: the bodies are written once, plainly,
'' and are greppable by name and readable in a debugger.
''
'' TWO SOURCES, AND WHAT EACH CONTRIBUTED.  Both MIT.
''
''   C:\dev\AfxNova\src\AfxComplex.inc -- BREADTH.  The sec/csc/cot families,
''   all twelve inverses, the hyperbolics, CNthRoot, CLogAbs, the real-argument
''   variants and the polar string form.  (c) Jose Roca, MIT.
''
''   .NET's System.Numerics.Complex, CURRENT rather than the 4.7 version --
''   NUMERICS.  Smith division, the scaled Abs, the stable Sqrt, Asin_Internal,
''   the stabilised Tan, the special-value rules and the predicate set.
''   (c) .NET Foundation, MIT.
''
'' NEITHER IS FOLLOWED WHERE IT IS BEATEN.  Both ship .NET Framework 4.7's
'' polar CSqrt, which loses most of its significant digits near the negative
'' real axis; this file has the .NET Core 3.0 replacement.  AfxNova leaves
'' its double/Complex and Complex/double division overloads naive even though
'' its Complex/Complex is Smith; here all three are Smith.
''
'' NOTHING FROM AfxComplex'S FIRST 150 LINES IS PORTED.  Its private acosh,
'' asinh, atanh, hypot3, isinf and isinfinity, and its HUGE_VALF comparisons,
'' are all supplied by math.tiko as proper overload sets.
''
'' DEPENDENCIES, stated rather than left to be discovered: math.tiko for the
'' libm surface and the classification predicates, and mathtext.tiko for
'' CToString -- the second costs std/outcome transitively.


#include once "fblimits.bi"
#include once "fblimits.bi"

using FB

'' ===========================================================================
'' The type
'' ===========================================================================

public type Complex
    as double re, im
end type

'' ===========================================================================
'' Construction and special values
''
'' THE SPECIAL VALUES ARE FUNCTIONS, NOT CONSTANTS.  'const as Complex N' can
'' not be initialised from 0.0/0.0 -- that is a compile-time division by zero
'' and does not compile.  Same decision, same reason, as NaN( ) in math.tiko.
'' ===========================================================================

public function CSet( byval re as double, byval im as double ) as Complex
    dim as Complex r : r.re = re : r.im = im : function = r
end function

'' Magnitude and phase, the polar form.  AfxNova's CPolar and
'' CFromPolarCoordinates, which were the same function twice.
public function CPolar( byval r as double, byval theta as double ) as Complex
    function = CSet( r * cos( theta ), r * sin( theta ) )
end function

public function CZero( ) as Complex         : function = CSet( 0.0, 0.0 ) : end function
public function COne( ) as Complex          : function = CSet( 1.0, 0.0 ) : end function
public function CImaginaryOne( ) as Complex : function = CSet( 0.0, 1.0 ) : end function
public function CNaN( ) as Complex          : function = CSet( NaN( ), NaN( ) ) : end function
public function CInfinity( ) as Complex     : function = CSet( Infinity( ), Infinity( ) ) : end function

'' ===========================================================================
'' Accessors
'' ===========================================================================

public function CReal( byref z as Complex ) as double : function = z.re : end function
public function CImag( byref z as Complex ) as double : function = z.im : end function

public sub CSetReal( byref z as Complex, byval x as double ) : z.re = x : end sub
public sub CSetImag( byref z as Complex, byval y as double ) : z.im = y : end sub

public sub CSwap( byref a as Complex, byref b as Complex ) : swap a, b : end sub

'' ===========================================================================
'' Predicates -- .NET 7's set, with .NET's definitions
''
'' CIsNaN IS NOT 'either part is NaN'.  A complex number with one infinite and
'' one NaN part is INFINITE, not NaN: the infinity already determines the
'' answer to every question anyone asks of it.  That is why this is written as
'' 'neither infinite nor finite' rather than as a pair of IsNaN calls.
'' ===========================================================================

public function CIsFinite( byref z as Complex ) as boolean
    function = ( IsFinite( z.re ) andalso IsFinite( z.im ) )
end function

public function CIsInfinite( byref z as Complex ) as boolean
    function = ( IsInfinite( z.re ) orelse IsInfinite( z.im ) )
end function

public function CIsNaN( byref z as Complex ) as boolean
    dim as boolean inf_ = CIsInfinite( z )
    dim as boolean fin_ = CIsFinite( z )
    function = ( ( inf_ = false ) andalso ( fin_ = false ) )
end function

'' On the real axis.  Note that this is TRUE for a negative zero imaginary
'' part, which is the correct answer and is also the part that decides which
'' side of a branch cut the number is on -- see CLog.
public function CIsReal( byref z as Complex ) as boolean
    function = ( z.im = 0.0 )
end function

public function CIsZero( byref z as Complex ) as boolean
    dim as boolean re0 = ( z.re = 0.0 )
    dim as boolean im0 = ( z.im = 0.0 )
    function = ( re0 andalso im0 )
end function

'' ===========================================================================
'' Comparison
''
'' NO ORDERING OPERATORS.  '<' on complex numbers has no meaning -- the same
'' reasoning that declined lexicographic ordering on tuples.  AfxNova's CSgn,
'' which returned a LONG by comparing the real parts and then the imaginary
'' ones, was such an ordering under another name; see CSgn below for what this
'' file does with that name instead.
'' ===========================================================================

public operator = ( byref a as Complex, byref b as Complex ) as boolean
    dim as boolean er = ( a.re = b.re )
    dim as boolean ei = ( a.im = b.im )
    operator = ( er andalso ei )
end operator

public operator <> ( byref a as Complex, byref b as Complex ) as boolean
    dim as boolean er = ( a.re = b.re )
    dim as boolean ei = ( a.im = b.im )
    operator = ( ( er andalso ei ) = false )
end operator

'' Against a real, in both arrangements, so that 'z = 0.0' means what it looks
'' like: equal to the real number, imaginary part exactly zero.  Either sign of
'' zero counts, because -0.0 = 0.0 as numbers.
public operator = ( byref z as Complex, byval x as double ) as boolean
    dim as boolean er = ( z.re = x )
    dim as boolean ei = ( z.im = 0.0 )
    operator = ( er andalso ei )
end operator

public operator = ( byval x as double, byref z as Complex ) as boolean
    dim as boolean er = ( z.re = x )
    dim as boolean ei = ( z.im = 0.0 )
    operator = ( er andalso ei )
end operator

public operator <> ( byref z as Complex, byval x as double ) as boolean
    dim as boolean er = ( z.re = x )
    dim as boolean ei = ( z.im = 0.0 )
    operator = ( ( er andalso ei ) = false )
end operator

public operator <> ( byval x as double, byref z as Complex ) as boolean
    dim as boolean er = ( z.re = x )
    dim as boolean ei = ( z.im = 0.0 )
    operator = ( ( er andalso ei ) = false )
end operator

'' ===========================================================================
'' Addition, subtraction, multiplication
''
'' '*' IS THE PLAIN FOUR-MULTIPLY FORM, matching .NET.  C99's __muldc3
'' infinity-recovery path -- which rescues ( inf + 0i ) * ( 2 + 0i ) from NaN
'' -- is deliberately NOT implemented: it costs a branch on every multiply for
'' a case that does not arise outside deliberate infinity arithmetic.
'' ===========================================================================

public operator - ( byref z as Complex ) as Complex
    operator = CSet( -z.re, -z.im )
end operator

public operator + ( byref a as Complex, byref b as Complex ) as Complex
    operator = CSet( a.re + b.re, a.im + b.im )
end operator

public operator + ( byref z as Complex, byval x as double ) as Complex
    operator = CSet( z.re + x, z.im )
end operator

public operator + ( byval x as double, byref z as Complex ) as Complex
    operator = CSet( x + z.re, z.im )
end operator

public operator - ( byref a as Complex, byref b as Complex ) as Complex
    operator = CSet( a.re - b.re, a.im - b.im )
end operator

public operator - ( byref z as Complex, byval x as double ) as Complex
    operator = CSet( z.re - x, z.im )
end operator

public operator - ( byval x as double, byref z as Complex ) as Complex
    operator = CSet( x - z.re, -z.im )
end operator

public operator * ( byref a as Complex, byref b as Complex ) as Complex
    operator = CSet( a.re * b.re - a.im * b.im, a.re * b.im + a.im * b.re )
end operator

public operator * ( byref z as Complex, byval x as double ) as Complex
    operator = CSet( z.re * x, z.im * x )
end operator

public operator * ( byval x as double, byref z as Complex ) as Complex
    operator = CSet( x * z.re, x * z.im )
end operator

public function CNegate( byref z as Complex ) as Complex
    function = CSet( -z.re, -z.im )
end function

public function CConj( byref z as Complex ) as Complex
    function = CSet( z.re, -z.im )
end function

'' ===========================================================================
'' Division -- SMITH'S FORMULA, from .NET's Complex.Divide
''
'' The naive ( ac + bd ) / ( c^2 + d^2 ) that fb/vector.bi used to ship
'' overflows its denominator whenever |d| is above about 1.3e154, so
'' ( 1e200 + 1e200i ) / ( 1e200 + 1e200i ) came back NaN instead of 1.  Smith
'' divides through by the larger component first and has no range restriction.
''
'' ALL THREE OVERLOADS GET IT.  AfxNova applies Smith to Complex/Complex and
'' leaves double/Complex and Complex/double naive; those two overflow for
'' exactly the same operands, so they are done properly here.
'' ===========================================================================

public operator / ( byref a as Complex, byref b as Complex ) as Complex
    dim as double ar = a.re, ai = a.im, br = b.re, bi = b.im
    if( abs( bi ) < abs( br ) ) then
        dim as double doc = bi / br
        dim as double den = br + bi * doc
        operator = CSet( ( ar + ai * doc ) / den, ( ai - ar * doc ) / den )
    else
        dim as double cod = br / bi
        dim as double den = bi + br * cod
        operator = CSet( ( ai + ar * cod ) / den, ( -ar + ai * cod ) / den )
    end if
end operator

public operator / ( byref z as Complex, byval x as double ) as Complex
    operator = CSet( z.re / x, z.im / x )
end operator

public operator / ( byval x as double, byref z as Complex ) as Complex
    '' Smith again, for the same reason -- z.re^2 + z.im^2 overflows where the
    '' true quotient is an ordinary number.
    if( abs( z.im ) < abs( z.re ) ) then
        dim as double doc = z.im / z.re
        dim as double den = z.re + z.im * doc
        operator = CSet( x / den, ( -x * doc ) / den )
    else
        dim as double cod = z.re / z.im
        dim as double den = z.im + z.re * cod
        operator = CSet( ( x * cod ) / den, -x / den )
    end if
end operator

'' ===========================================================================
'' Magnitude and phase
'' ===========================================================================

'' CAbs FACTORS OUT THE LARGER COMPONENT, so it does not overflow for operands
'' near the type maximum where the naive sqr( x*x + y*y ) does.  Identical in
'' .NET and in AfxNova.  The 'small = 0' branch returns the larger component
'' unaltered, which is what lets a NaN through instead of turning it into one.
public function CAbs( byref z as Complex ) as double
    if( CIsInfinite( z ) ) then return Infinity( )
    dim as double c = abs( z.re ), d = abs( z.im )
    if( c > d ) then
        dim as double r = d / c
        function = c * sqr( 1.0 + r * r )
    elseif( d = 0.0 ) then
        function = c                        '' c is either 0.0 or NaN
    else
        dim as double r = c / d
        function = d * sqr( 1.0 + r * r )
    end if
end function

'' The modulus SQUARED.  This is the one to use for comparisons: 'CAbs(a) <
'' CAbs(b)' costs two square roots for a question that needs none.
public function CNorm( byref z as Complex ) as double
    function = z.re * z.re + z.im * z.im
end function

public function CArg( byref z as Complex ) as double
    function = atan2( z.im, z.re )
end function

'' log|z| WITHOUT FORMING |z| FIRST -- AfxNova's, which is GSL's.  Computing
'' log( CAbs( z ) ) is correct but throws away the range that CAbs works to
'' keep; this scales by the larger component and finishes with Log1p, so it
'' survives operands whose square would overflow and is accurate when |z| is
'' near 1, where log of the ratio would cancel.
public function CLogAbs( byref z as Complex ) as double
    dim as double xabs = abs( z.re ), yabs = abs( z.im )
    dim as double u, v
    if( xabs >= yabs ) then
        u = xabs : v = yabs
    else
        u = yabs : v = xabs
    end if
    if( u = 0.0 ) then return NegInfinity( )
    dim as double t = v / u
    function = log( u ) + 0.5 * Log1p( t * t )
end function

public function CReciprocal( byref z as Complex ) as Complex
    if( CIsZero( z ) ) then return CZero( )         '' .NET's answer
    function = 1.0 / z
end function

'' THE UNIT VECTOR IN z's DIRECTION -- z / |z|, and zero for zero.  This is
'' Mathematica's Sign[z] and the only meaning of "sign" that survives on C.
''
'' DELIBERATELY DIFFERENT FROM AfxNova, whose CSgn returned a LONG: +1 if the
'' real part was positive, else -1 if negative, else the same test on the
'' imaginary part.  That is a lexicographic tie-break, not a sign, and this
'' file has just declined to give C an ordering.  Code ported from AfxNova
'' gets a compile error at the assignment rather than a silently different
'' number, which is the intended outcome.
public function CSgn( byref z as Complex ) as Complex
    dim as double m = CAbs( z )
    if( m = 0.0 ) then return CZero( )
    function = z / m
end function

'' ===========================================================================
'' Exponential, logarithm, square root
'' ===========================================================================

public function CExp( byref z as Complex ) as Complex
    dim as double ev = exp( z.re )
    '' On the real axis the answer is exactly real; going through cos/sin would
    '' put a rounding error in the imaginary part where zero belongs.
    if( z.im = 0.0 ) then return CSet( ev, z.im )
    function = CSet( ev * cos( z.im ), ev * sin( z.im ) )
end function

'' PRINCIPAL BRANCH, cut along the negative real axis, with the cut BELOW it:
'' CLog( -1 + 0i ) is +PI*i and CLog( -1 - 0i ) is -PI*i.  That is atan2's
'' convention and C99's, and it is why the two zeros have to be distinguishable
'' -- see IsNegative in math.tiko.
public function CLog overload ( byref z as Complex ) as Complex
    function = CSet( CLogAbs( z ), atan2( z.im, z.re ) )
end function

public function CLog overload ( byref z as Complex, byval baseValue as double ) as Complex
    function = CLog( z ) / log( baseValue )
end function

public function CLog10( byref z as Complex ) as Complex
    function = CLog( z ) / LN10
end function

'' THE .NET CORE 3.0 ALGORITHM, not the polar form.  fb/vector.bi and AfxNova
'' both shipped FromPolar( sqr(|z|), Arg(z)/2 ), which is .NET Framework 4.7's
'' and loses most of its significant digits near the negative real axis, where
'' Arg is the difference of two nearly-equal quantities.
''
'' The rescale path exists because Hypot( re, im ) + re can overflow while the
'' root itself is perfectly representable; a quarter in and a double out is
'' exact in binary floating point, so it costs nothing but the branch.
public function CSqrt overload ( byref z as Complex ) as Complex
    '' THE REAL AXIS IS EXACT AND ITS ZERO IS SIGNED.  The cut runs along the
    '' negative reals, so which zero the imaginary part carries decides which
    '' side of it the operand is on: CSqrt( -4 + 0i ) is +2i and CSqrt( -4 - 0i )
    '' is -2i.  .NET tests 'imaginary == 0' and returns the positive root for
    '' both, which puts half of the axis on the wrong branch.
    '' 'abs' on the non-negative side is not decoration either -- sqr( -0.0 ) is
    '' -0.0 in IEEE, and csqrt( -0 + 0i ) is +0, not -0.
    if( z.im = 0.0 ) then
        if( z.re < 0.0 ) then
            dim as double t = sqr( -z.re )
            if( IsNegative( z.im ) ) then t = -t
            return CSet( 0.0, t )
        else
            return CSet( sqr( abs( z.re ) ), z.im )
        end if
    end if

    const as double RESCALE_THRESHOLD = MAX_DOUBLE / ( SQRT2 + 1.0 )

    dim as double rc = z.re, ic = z.im
    dim as boolean rescale = false
    dim as boolean bigRe = ( abs( rc ) >= RESCALE_THRESHOLD )
    dim as boolean bigIm = ( abs( ic ) >= RESCALE_THRESHOLD )
    if( bigRe orelse bigIm ) then
        dim as boolean infIm = IsInfinite( z.im )
        dim as boolean nanRe = IsNaN( z.re )
        if( infIm andalso ( nanRe = false ) ) then return CSet( Infinity( ), ic )
        rc *= 0.25 : ic *= 0.25 : rescale = true
    end if

    dim as double x, y
    if( rc >= 0.0 ) then
        x = sqr( ( Hypot( rc, ic ) + rc ) * 0.5 )
        y = ic / ( 2.0 * x )
    else
        y = sqr( ( Hypot( rc, ic ) - rc ) * 0.5 )
        if( ic < 0.0 ) then y = -y
        x = ic / ( 2.0 * y )
    end if

    if( rescale ) then
        x *= 2.0 : y *= 2.0
    end if
    function = CSet( x, y )
end function

'' The square root of a REAL that may be negative.  AfxNova spelled this
'' CSqrReal; it is the same concept with a different argument type, which is
'' what overloading is for.
public function CSqrt overload ( byval x as double ) as Complex
    if( x >= 0.0 ) then return CSet( sqr( x ), 0.0 )
    function = CSet( 0.0, sqr( -x ) )
end function

'' ===========================================================================
'' Powers and roots
'' ===========================================================================

'' .NET's Pow, INCLUDING ITS TWO WRONG ANSWERS, which are pinned by a test so
'' that changing them later is a deliberate act rather than a drift:
''
''     CPow( CZero( ), CZero( ) )   is 1     -- the w = 0 test comes first
''     CPow( CZero( ), w )          is 0     -- for EVERY other w, including
''                                              negative w, where the true
''                                              answer is infinite
public function CPow overload ( byref z as Complex, byref w as Complex ) as Complex
    dim as boolean wZero = CIsZero( w )
    if( wZero ) then return COne( )
    dim as boolean zZero = CIsZero( z )
    if( zZero ) then return CZero( )

    dim as double rho = CAbs( z )
    dim as double theta = atan2( z.im, z.re )
    dim as double newRho = w.re * theta + w.im * log( rho )
    dim as double t = Pow( rho, w.re ) * exp( -w.im * theta )
    function = CSet( t * cos( newRho ), t * sin( newRho ) )
end function

public function CPow overload ( byref z as Complex, byval p as double ) as Complex
    function = CPow( z, CSet( p, 0.0 ) )
end function

public function CPow overload ( byval x as double, byref w as Complex ) as Complex
    function = CPow( CSet( x, 0.0 ), w )
end function

public operator ^ ( byref z as Complex, byref w as Complex ) as Complex
    operator = CPow( z, w )
end operator

public operator ^ ( byref z as Complex, byval p as double ) as Complex
    operator = CPow( z, CSet( p, 0.0 ) )
end operator

public operator ^ ( byval x as double, byref w as Complex ) as Complex
    operator = CPow( CSet( x, 0.0 ), w )
end operator

'' THE k-TH OF THE n n-TH ROOTS.  AfxNova's, kept because nothing else in the
'' docset gives you all of them: k = 0 is the principal root and k = 1 .. n-1
'' are the others, spaced 2*PI/n apart around the same circle.
public function CNthRoot( byref z as Complex, byval n as long, byval k as long = 0 ) as Complex
    if( n = 0 ) then return CNaN( )
    dim as double rmod = exp( CLogAbs( z ) / n )
    dim as double t = ( atan2( z.im, z.re ) + 2.0 * PI * k ) / n
    function = CSet( rmod * cos( t ), rmod * sin( t ) )
end function

'' ===========================================================================
'' Trigonometric
'' ===========================================================================

public function CSin( byref z as Complex ) as Complex
    function = CSet( sin( z.re ) * Cosh( z.im ), cos( z.re ) * Sinh( z.im ) )
end function

public function CCos( byref z as Complex ) as Complex
    function = CSet( cos( z.re ) * Cosh( z.im ), -( sin( z.re ) * Sinh( z.im ) ) )
end function

'' THE STABILISED FORM, from .NET.  sin(z)/cos(z) is inf/inf -- that is, NaN --
'' for an imaginary part above about 710, because cosh overflows there while
'' the tangent itself is heading calmly for +-i.  This uses the double-angle
'' identity, and above |im| = 4 divides through by cosh so that neither operand
'' can overflow.
public function CTan( byref z as Complex ) as Complex
    '' BOTH AXES DIRECTLY.  The double-angle form below is correct there but
    '' arrives with a rounding error and a positive zero where an exact answer
    '' and a signed one belong: tan( 1 - 0i ) is tan(1) - 0i, and the general
    '' path gives the last digit of tan(1) wrong and the zero the wrong sign.
    if( z.im = 0.0 ) then return CSet( tan( z.re ), z.im )
    if( z.re = 0.0 ) then return CSet( z.re, Tanh( z.im ) )

    dim as double x2 = 2.0 * z.re
    dim as double y2 = 2.0 * z.im
    dim as double p = exp( y2 )
    dim as double q = 1.0 / p
    dim as double ch = ( p + q ) * 0.5
    if( abs( z.im ) <= 4.0 ) then
        dim as double sh = ( p - q ) * 0.5
        dim as double d = cos( x2 ) + ch
        function = CSet( sin( x2 ) / d, sh / d )
    else
        dim as double d = 1.0 + cos( x2 ) / ch
        function = CSet( sin( x2 ) / ch / d, Tanh( y2 ) / d )
    end if
end function

public function CSec( byref z as Complex ) as Complex : function = CReciprocal( CCos( z ) ) : end function
public function CCsc( byref z as Complex ) as Complex : function = CReciprocal( CSin( z ) ) : end function
public function CCot( byref z as Complex ) as Complex : function = CReciprocal( CTan( z ) ) : end function

'' ===========================================================================
'' Hyperbolic
''
'' CSinh and CCosh are written out directly on libm's Sinh/Cosh: the identity
'' route through CSin( iz ) is the same arithmetic but arrives with the signed
'' zeros negated on the real axis.  CTanh DOES go through CTan, so that it
'' inherits CTan's overflow guard rather than needing a second copy of it.
'' ===========================================================================

public function CSinh( byref z as Complex ) as Complex
    function = CSet( Sinh( z.re ) * cos( z.im ), Cosh( z.re ) * sin( z.im ) )
end function

public function CCosh( byref z as Complex ) as Complex
    function = CSet( Cosh( z.re ) * cos( z.im ), Sinh( z.re ) * sin( z.im ) )
end function

public function CTanh( byref z as Complex ) as Complex
    '' The two axes directly, for the same reason as CTan.
    if( z.im = 0.0 ) then return CSet( Tanh( z.re ), z.im )
    if( z.re = 0.0 ) then return CSet( z.re, tan( z.im ) )
    '' tanh z = -i * tan( iz )
    dim as Complex w = CTan( CSet( -z.im, z.re ) )
    function = CSet( w.im, -w.re )
end function

public function CSech( byref z as Complex ) as Complex : function = CReciprocal( CCosh( z ) ) : end function
public function CCsch( byref z as Complex ) as Complex : function = CReciprocal( CSinh( z ) ) : end function
public function CCoth( byref z as Complex ) as Complex : function = CReciprocal( CTanh( z ) ) : end function

'' ===========================================================================
'' Inverse trigonometric
''
'' THE HULL-FAIRGRIEVE-TANG METHOD, transcribed from .NET's Asin_Internal.
'' The textbook -i*Log( iz + CSqrt( 1 - z*z ) ) cancels catastrophically near
'' the branch points at +-1, which is exactly where an inverse sine is most
'' often evaluated.  This does not.
''
'' It reports three quantities for the FIRST-QUADRANT operand ( |re|, |im| ),
'' and CAsin and CAcos each reflect the result back into the right quadrant:
''
''   b       sin of the real part, valid when bPrime is negative
''   bPrime  tan of the real part, used instead when b is close to 1 and the
''           arcsine of it would lose precision
''   v       the imaginary part, always non-negative
'' ===========================================================================

sub hAsinInternal( byval x as double, byval y as double, _
                           byref b as double, byref bPrime as double, byref v as double )

    const as double OVERFLOW_THRESHOLD = 6.703903964971298e+153     '' sqr( MAX_DOUBLE ) / 2
    const as double B_THRESHOLD = 0.6417
    const as double C_THRESHOLD = 1.5

    dim as boolean bigX = ( x > OVERFLOW_THRESHOLD )
    dim as boolean bigY = ( y > OVERFLOW_THRESHOLD )
    if( bigX orelse bigY ) then
        '' Both r and s below would overflow.  Asymptotically the answer is
        '' log( 2|z| ), computed by scaling so that nothing squares.
        b = -1.0
        bPrime = x / y
        dim as double small_, big_
        if( x < y ) then
            small_ = x : big_ = y
        else
            small_ = y : big_ = x
        end if
        dim as double ratio = small_ / big_
        v = LN2 + log( big_ ) + 0.5 * Log1p( ratio * ratio )
        exit sub
    end if

    dim as double r = Hypot( x + 1.0, y )
    dim as double s = Hypot( x - 1.0, y )
    dim as double a = ( r + s ) * 0.5
    b = x / a

    if( b > B_THRESHOLD ) then
        if( x < 1.0 ) then
            dim as double amx = ( y * y / ( r + ( x + 1.0 ) ) + ( s + ( 1.0 - x ) ) ) * 0.5
            bPrime = x / sqr( ( a + x ) * amx )
        else
            dim as double t = ( 1.0 / ( r + ( x + 1.0 ) ) + 1.0 / ( s + ( x - 1.0 ) ) ) * 0.5
            bPrime = x / ( y * sqr( ( a + x ) * t ) )
        end if
    else
        bPrime = -1.0
    end if

    if( a < C_THRESHOLD ) then
        '' a is close to 1, so log( a + sqr( a^2 - 1 ) ) would cancel; form
        '' a - 1 directly and finish with Log1p.
        dim as double am1
        if( x < 1.0 ) then
            am1 = ( y * y / ( r + ( x + 1.0 ) ) + y * y / ( s + ( 1.0 - x ) ) ) * 0.5
        else
            am1 = ( y * y / ( r + ( x + 1.0 ) ) + ( s + ( x - 1.0 ) ) ) * 0.5
        end if
        v = Log1p( am1 + sqr( am1 * ( a + 1.0 ) ) )
    else
        v = log( a + sqr( ( a - 1.0 ) * ( a + 1.0 ) ) )
    end if
end sub

public function CAsin overload ( byref z as Complex ) as Complex
    '' hAsinInternal DIVIDES BY ZERO AT EXACTLY +-1 ON THE REAL AXIS -- its 't'
    '' term contains 1/( s + ( x - 1 ) ), and s is 0 there, so bPrime comes out
    '' NaN and .NET's Asin( 1 ) is NaN rather than PI/2.  The whole segment is
    '' in libm's domain anyway, so it is answered directly.
    dim as boolean onAxis = ( z.im = 0.0 )
    dim as boolean inDomain = ( abs( z.re ) <= 1.0 )
    if( onAxis andalso inDomain ) then return CSet( asin( z.re ), z.im )

    dim as double b, bPrime, v
    hAsinInternal( abs( z.re ), abs( z.im ), b, bPrime, v )
    dim as double u
    if( bPrime < 0.0 ) then u = asin( b ) else u = atn( bPrime )
    '' THE SIGN BIT, NOT THE COMPARISON.  .NET tests 'z.im < 0.0' here, and a
    '' negative zero is not less than zero, so it lands on the wrong side of
    '' the cut: .NET's Asin( 2 - 0i ) has a POSITIVE imaginary part where C99,
    '' Python and every other implementation give a negative one.  Verified
    '' against Python's cmath at all four sign combinations.
    if( IsNegative( z.re ) ) then u = -u
    if( IsNegative( z.im ) ) then v = -v
    function = CSet( u, v )
end function

public function CAcos overload ( byref z as Complex ) as Complex
    '' Same NaN at +-1 as CAsin, same fix.  The imaginary part is NEGATED here:
    '' acos( 1 + 0i ) is 0 - 0i.
    dim as boolean onAxis = ( z.im = 0.0 )
    dim as boolean inDomain = ( abs( z.re ) <= 1.0 )
    if( onAxis andalso inDomain ) then return CSet( acos( z.re ), -z.im )

    dim as double b, bPrime, v
    hAsinInternal( abs( z.re ), abs( z.im ), b, bPrime, v )
    dim as double u
    if( bPrime < 0.0 ) then u = acos( b ) else u = atn( 1.0 / bPrime )
    '' Same correction as CAsin: the sign bit rather than the comparison.
    if( IsNegative( z.re ) ) then u = PI - u
    if( IsNegative( z.im ) = false ) then v = -v
    function = CSet( u, v )
end function

'' The log form, which is well conditioned here -- the cancellation that ruins
'' the naive arcsine does not arise for the arctangent.
public function CAtan( byref z as Complex ) as Complex
    '' BOTH AXES ARE ANSWERED DIRECTLY, and the log form below handles only the
    '' rest of the plane.  Three separate reasons, all measured:
    ''
    ''   THE REAL AXIS, for the sign of a zero.  atan( x +- 0i ) is
    ''   atn( x ) +- 0i -- the function is odd in its imaginary part and owes
    ''   that zero's sign back, where the log form returns +0 for both.
    ''
    ''   THE IMAGINARY AXIS BEYOND +-i is the CUT, and the log form cannot see
    ''   which side of it an operand is on: forming '1 + iz' adds +0.0 to -0.0,
    ''   IEEE resolves that to +0.0, and the deciding bit is gone before CLog
    ''   is called.  Directly: atan( +-0 + yi ) = +-PI/2 + i*atanh( 1/y ).
    ''
    ''   THE IMAGINARY AXIS INSIDE +-i, for accuracy.  The log form CANCELS for
    ''   a small argument -- atan( 1e-8 i ) came out 9.9999999947e-9 where the
    ''   answer is 1e-8.
    if( z.im = 0.0 ) then return CSet( atn( z.re ), z.im )

    dim as boolean onAxis = ( z.re = 0.0 )
    if( onAxis ) then
        if( abs( z.im ) > 1.0 ) then
            dim as double h = PI * 0.5
            if( IsNegative( z.re ) ) then h = -h
            return CSet( h, Atanh( 1.0 / z.im ) )
        end if
        return CSet( z.re, Atanh( z.im ) )
    end if

    dim as Complex iz = CSet( -z.im, z.re )
    dim as Complex t = CLog( COne( ) - iz ) - CLog( COne( ) + iz )
    '' multiply by i/2
    function = CSet( -t.im * 0.5, t.re * 0.5 )
end function

public function CAsec overload ( byref z as Complex ) as Complex : function = CAcos( CReciprocal( z ) ) : end function
public function CAcsc overload ( byref z as Complex ) as Complex : function = CAsin( CReciprocal( z ) ) : end function
public function CAcot( byref z as Complex ) as Complex : function = CAtan( CReciprocal( z ) ) : end function

'' The real-argument forms.  Each exists because the REAL function is undefined
'' outside its domain while the complex one is not -- CAsin( 2.0 ) is a perfectly
'' ordinary complex number.  AfxNova spelled these CArcSinReal, CArcCosReal,
'' CArcSecReal and CArcCscReal; same concept, different argument type.
public function CAsin overload ( byval x as double ) as Complex
    if( abs( x ) <= 1.0 ) then return CSet( asin( x ), 0.0 )
    function = CAsin( CSet( x, 0.0 ) )
end function

public function CAcos overload ( byval x as double ) as Complex
    if( abs( x ) <= 1.0 ) then return CSet( acos( x ), 0.0 )
    function = CAcos( CSet( x, 0.0 ) )
end function

public function CAsec overload ( byval x as double ) as Complex : function = CAcos( 1.0 / x ) : end function
public function CAcsc overload ( byval x as double ) as Complex : function = CAsin( 1.0 / x ) : end function

'' ===========================================================================
'' Inverse hyperbolic
''
'' The three primary ones are the inverse TRIGONOMETRIC ones rotated, so they
'' inherit the Hull-Fairgrieve-Tang conditioning above rather than needing
'' their own; the reciprocal three compose those with CReciprocal.
''
'' EACH ROTATION IS PRECEDED BY THE AXIS IT GETS WRONG.  A rotation is exact
'' arithmetic on the value and destructive of the sign of a zero, and the sign
'' of a zero is what decides the side of a branch cut -- so every segment where
'' that matters is answered before the rotation is reached.  All of them were
'' put here by a measured failure against C99, not by taste.
'' ===========================================================================

public function CAsinh( byref z as Complex ) as Complex
    if( z.im = 0.0 ) then
        '' MEASURED: mingw-w64's asinh( +0.0 ) returns -0.0, which is wrong --
        '' asinh is odd, so it owes the sign of its argument back.  One line
        '' rather than a whole test that fails on one platform and not another.
        if( z.re = 0.0 ) then return CSet( z.re, z.im )
        return CSet( Asinh( z.re ), z.im )
    end if
    '' asinh z = -i * asin( iz )
    dim as Complex w = CAsin( CSet( -z.im, z.re ) )
    function = CSet( w.im, -w.re )
end function

'' PRINCIPAL BRANCH, real part non-negative, cut along ( -inf, 1 ).  acosh z is
'' +-i*acos z; the sign is the one that keeps the real part on the right side.
public function CAcosh overload ( byref z as Complex ) as Complex
    dim as boolean onAxis = ( z.im = 0.0 )
    dim as boolean inDomain = ( z.re >= 1.0 )
    if( onAxis andalso inDomain ) then return CSet( Acosh( z.re ), z.im )
    '' Between -1 and 1 on the real axis the answer is PURELY IMAGINARY, and
    '' the rotation below would give it a negative-zero real part.  Zero is the
    '' right answer and its sign is visible to IsNegative, so it is worth the
    '' three lines.
    dim as boolean inCut = ( abs( z.re ) <= 1.0 )
    if( onAxis andalso inCut ) then
        dim as double t = acos( z.re )
        if( IsNegative( z.im ) ) then t = -t
        return CSet( 0.0, t )
    end if
    dim as Complex w = CAcos( z )
    if( w.im <= 0.0 ) then
        function = CSet( -w.im, w.re )      '' i * w
    else
        function = CSet( w.im, -w.re )      '' -i * w
    end if
end function

public function CAtanh overload ( byref z as Complex ) as Complex
    '' Both zeros, which the platform's atanh gets the sign of wrong -- the
    '' same defect as mingw-w64's asinh( +0.0 ) noted in CAsinh.
    dim as boolean reZero = ( z.re = 0.0 )
    dim as boolean imZero = ( z.im = 0.0 )
    if( reZero andalso imZero ) then return CSet( z.re, z.im )

    dim as boolean onAxis = ( z.im = 0.0 )
    dim as boolean inDomain = ( abs( z.re ) < 1.0 )
    if( onAxis andalso inDomain ) then return CSet( Atanh( z.re ), z.im )
    '' BEYOND +-1 ON THE REAL AXIS, which is the cut itself, the rotation below
    '' cannot get the answer right: forming '1 + iz' adds +0.0 to -0.0, and
    '' IEEE gives +0.0 for that, so the sign that decides the side of the cut is
    '' destroyed before CLog ever sees it.  Done directly instead --
    '' atanh( x +- 0i ) = atanh( 1/x ) +- i*PI/2.
    dim as boolean outside = ( abs( z.re ) > 1.0 )
    if( onAxis andalso outside ) then
        dim as double t = PI * 0.5
        if( IsNegative( z.im ) ) then t = -t
        return CSet( Atanh( 1.0 / z.re ), t )
    end if
    '' The imaginary axis, exactly: atanh( +-0 + yi ) = +-0 + i*atan( y ).  The
    '' rotation below loses the sign of that zero on the way through CAtan.
    if( z.re = 0.0 ) then return CSet( z.re, atn( z.im ) )
    '' atanh z = -i * atan( iz )
    dim as Complex w = CAtan( CSet( -z.im, z.re ) )
    function = CSet( w.im, -w.re )
end function

public function CAsech( byref z as Complex ) as Complex : function = CAcosh( CReciprocal( z ) ) : end function
public function CAcsch( byref z as Complex ) as Complex : function = CAsinh( CReciprocal( z ) ) : end function
public function CAcoth( byref z as Complex ) as Complex : function = CAtanh( CReciprocal( z ) ) : end function

'' The real-argument forms -- AfxNova's CArcCosHReal and CArcTanHReal.
public function CAcosh overload ( byval x as double ) as Complex
    if( x >= 1.0 ) then return CSet( Acosh( x ), 0.0 )
    function = CAcosh( CSet( x, 0.0 ) )
end function

public function CAtanh overload ( byval x as double ) as Complex
    if( abs( x ) < 1.0 ) then return CSet( Atanh( x ), 0.0 )
    function = CAtanh( CSet( x, 0.0 ) )
end function

'' ===========================================================================
'' Text
''
'' BUILT ON mathtext.tiko's ToString, so the components round-trip: the value
'' that comes back out of TryParseDouble is the value that went in, which STR
'' does not promise and does not deliver.
''
'' The sign is emitted SEPARATELY from the magnitude so that a negative zero
'' imaginary part survives: "3-0i" parses back to -0.0, where "3+0i" would not.
'' Which side of a branch cut a number is on depends on exactly that bit.
''
'' The non-finite components come out as "nan", "inf" and "-inf", which
'' TryParseDouble does accept again under PARSE_STRICT.  A NaN is not equal to
'' itself, though, so what survives that trip is the representation and not the
'' value -- everything finite, both signed zeros included, survives as a value.
'' ===========================================================================

public function CToString( byref z as Complex ) as string
    dim as string s = ToString( z.re )
    if( IsNaN( z.im ) ) then return s + "+nani"
    if( IsNegative( z.im ) ) then
        function = s + "-" + ToString( -z.im ) + "i"
    else
        function = s + "+" + ToString( z.im ) + "i"
    end if
end function

'' The polar form, AfxNova's spelling of it: modulus, then the phase in an
'' exponential.  Unambiguous and ASCII, which "r < theta" would not be.
public function CToStringPolar( byref z as Complex ) as string
    function = ToString( CAbs( z ) ) + " * exp(" + ToString( CArg( z ) ) + "i)"
end function

