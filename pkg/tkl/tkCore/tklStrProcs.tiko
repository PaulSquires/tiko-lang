' ========================================================================================
' * Extracts characters from a string up to a character or group of characters.
' Complement function to AfxStrRemain.
' Returns a substring of wszMainStr starting with its first character (or the character
' specified by nStart) and up to (but not including) the first occurrence of wszMatchStr
' If wszMatchStr is not present in wszMainStr (or is null) then all of wszMainStr is
' returned from the nStart position.
' This function is case-sensitive.
' The following line returns "aba" (match on "cad")
' DIM dws AS DWSTRING = tkStrExtract(1, "abacadabra","cad")
' ========================================================================================
'PUBLIC FUNCTION tkStrExtract OVERLOAD (BYVAL nStart AS LONG = 1, BYREF wszMainStr AS CONST WSTRING, BYREF wszMatchStr AS CONST WSTRING) AS USTRING
'   DIM nLen AS LONG = LEN(wszMainStr)
'   IF (nStart = 0) OR (nStart > nLen) THEN RETURN ""
'   IF nStart < 0 THEN nStart = nLen + nStart + 1
'   DIM nPos AS LONG = INSTR(nStart, wszMainStr, wszMatchStr)
'   IF nPos THEN RETURN MID(wszMainStr, nStart, nPos - nStart)
'   RETURN MID(wszMainStr, nStart)
'END FUNCTION
' ========================================================================================
' ========================================================================================
' * Case insensitive version of tkStrExtract.
' DIM dws AS DWSTRING = tkStrExtractI(1, "abacadabra","CaD")
' ========================================================================================
'PUBLIC FUNCTION tkStrExtractI (BYVAL nStart AS LONG = 1, BYREF wszMainStr AS CONST WSTRING, BYREF wszMatchStr AS CONST WSTRING) AS USTRING
'   DIM ustr AS USTRING = wszMainStr
'   DIM nLen AS LONG = LEN(wszMainStr)
'   IF (nStart = 0) OR (nStart > nLen) THEN RETURN ""
'   IF nStart < 0 THEN nStart = nLen + nStart + 1
'   DIM nPos AS LONG = INSTR(nStart, UCASE(wszMainStr), UCASE(wszMatchStr))
'   IF nPos THEN RETURN MID(wszMainStr, nStart, nPos - nStart )
'   RETURN MID(wszMainStr, nStart)
'END FUNCTION
' ========================================================================================

' ========================================================================================
' * Returns the portion of a string following the occurrence of a specified delimiter up to
' the second delimiter. If one of the delimiters isn't found, it returns an empty string.
' Parameters:
' nStart: [Optional]. The one-based starting position where to start the search
' wszMainStr: The main string
' wszDelim1: The first delimiter
' wszDelim2: The second delimiter
' This function is case-sensitive.
' Example:
' DIM ustrText AS USTRING = "blah blah (text beween parentheses) blah blah"
' print tkStrExtract(ustrText, "(", ")")
' ========================================================================================
'PUBLIC FUNCTION tkStrExtract OVERLOAD (BYREF wszMainStr AS CONST WSTRING, BYREF wszDelim1 AS CONST WSTRING, BYREF wszDelim2 AS CONST WSTRING) AS USTRING
'   DIM nPos1 AS LONG = INSTR(wszMainStr, wszDelim1)
'   IF nPos1 = 0 THEN RETURN ""
'   nPos1 += LEN(wszDelim1)
'   DIM nPos2 AS LONG = INSTR(nPos1, wszMainStr, wszDelim2)
'   IF nPos2 = 0 THEN RETURN ""
'   DIM nLen AS LONG = nPos2 - nPos1
'   RETURN MID(wszMainStr, nPos1, nLen)
'END FUNCTION
' ========================================================================================
' ========================================================================================
'PUBLIC FUNCTION tkStrExtract OVERLOAD (BYVAL nStart AS LONG = 1, BYREF wszMainStr AS CONST WSTRING, BYREF wszDelim1 AS CONST WSTRING, BYREF wszDelim2 AS CONST WSTRING) AS USTRING
'   DIM nLen AS LONG = LEN(wszMainStr)
'   IF (nStart = 0) OR (nStart > nLen) THEN RETURN ""
'   IF nStart < 0 THEN nStart = nLen + nStart + 1
'   DIM nPos1 AS LONG = INSTR(nStart, wszMainStr, wszDelim1)
'   IF nPos1 = 0 THEN RETURN ""
'   nPos1 += LEN(wszDelim1)
'   DIM nPos2 AS LONG = INSTR(nPos1, wszMainStr, wszDelim2)
'   IF nPos2 = 0 THEN RETURN ""
'   nLen = nPos2 - nPos1
'   RETURN MID(wszMainStr, nPos1, nLen)
'END FUNCTION
' ========================================================================================

' ========================================================================================
' * Within a specified string, replace all occurrences of one string with another string.
' Replaces all occurrences of wszMatchStr in wszMainStr with wszReplaceWith
' The replacement can cause wszMainStr to grow or condense in size.
' When a match is found, the scan for the next match begins at the position immediately
' following the prior match.
' This function is case sensitive.
' Example: tkStrReplace("Hello World", "World", "Earth")   ' -> "Hello Earth"
' ========================================================================================
PUBLIC FUNCTION tkStrReplace OVERLOAD (BYREF wszMainStr AS CONST WSTRING, BYREF wszMatchStr AS CONST WSTRING, BYREF wszReplaceWith AS CONST WSTRING) AS USTRING
   DIM ustrMainStr AS USTRING = wszMainStr
   DIM nLenReplaceWith AS LONG = LEN(wszReplaceWith)
   DIM nLenMatchStr AS LONG = LEN(wszMatchStr)
   DIM nPos AS LONG = 1
   DO
      nPos = INSTR(nPos, ustrMainStr, wszMatchStr)
      IF nPos = 0 THEN EXIT DO
      ustrMainStr = MID(ustrMainStr, 1, nPos - 1) + wszReplaceWith + MID(ustrMainStr, nPos + nLenMatchStr)
      nPos += nLenReplaceWith
   LOOP
   RETURN ustrMainStr
END FUNCTION
' ========================================================================================
' ========================================================================================
' * Case insensitive version of tkStrReplace.
' Example: AfxStrReplaceI("Hello world", "World", "Earth")   ' -> "Hello Earth"
' ========================================================================================
'PUBLIC FUNCTION tkStrReplaceI (BYREF wszMainStr AS CONST WSTRING, BYREF wszMatchStr AS CONST WSTRING, BYREF wszReplaceWith AS CONST WSTRING) AS USTRING
'   DIM ustrMainStr AS USTRING = wszMainStr
'   DIM ustrMatchStr AS USTRING = UCASE(wszMatchStr)
'   DIM nLenReplaceWith AS LONG = LEN(wszReplaceWith)
'   DIM nLenMatchStr AS LONG = LEN(wszMatchStr)
'   DIM nPos AS LONG = 1
'   DO
'      nPos = INSTR(nPos, UCASE(ustrMainStr), ustrMatchStr)
'      IF nPos = 0 THEN EXIT DO
'      ustrMainStr = MID(ustrMainStr, 1, nPos - 1) + wszReplaceWith + MID(ustrMainStr, nPos + nLenMatchStr)
'      nPos += nLenReplaceWith
'   LOOP
'   RETURN ustrMainStr
'END FUNCTION
' ========================================================================================

' ========================================================================================
' * Returns a copy of a string with substrings removed.
' If wszMatchStr is not present in wszMainStr, all of wszMainStr is returned intact.
' This function is case sensitive.
' Example: tkStrRemove("Hello World. Welcome to the Freebasic World", "World")
' ========================================================================================
PUBLIC FUNCTION tkStrRemove (BYREF wszMainStr AS CONST WSTRING, BYREF wszMatchStr AS CONST WSTRING) AS USTRING
   DIM ustrMainStr AS USTRING = wszMainStr
   DIM nLen AS LONG = LEN(wszMatchStr)
   DO
      DIM nPos AS LONG = INSTR(ustrMainStr, wszMatchStr)
      IF nPos = 0 THEN EXIT DO
      ustrMainStr = LEFT(ustrMainStr, nPos - 1) + MID(ustrMainStr, nPos + nLen)
   LOOP
   RETURN ustrMainStr
END FUNCTION
' ========================================================================================

' ========================================================================================
' Returns the count of delimited fields from a string expression.
' If wszMainStr is empty (a null string) or contains no delimiter character(s), the string
' is considered to contain exactly one sub-field. In this case, tkParseCount returns the value 1.
' Delimiter contains a string (one or more characters) that must be fully matched.
' Delimiters are case-sensitive.
' Example: DIM nCount AS LONG = tkParseCount("one,two,three", ",")   ' Output: 3
' Example: DIM nCount AS LONG = tkParseCount("1;2,3", ",;")          ' Output: 3
' ========================================================================================
PUBLIC FUNCTION tkParseCount (BYREF wszSourceString AS CONST WSTRING, BYREF wszDelimiter AS CONST WSTRING = ",") AS LONG
   DIM nCount AS LONG = 1
   DIM nPos AS LONG = 1
   DO
      nPos = INSTR(nPos, wszSourceString, ANY wszDelimiter)
      IF nPos = 0 THEN EXIT DO
      nCount += 1
      nPos += 1
   LOOP
   RETURN nCount
END FUNCTION
' ========================================================================================

' ========================================================================================
' Returns delimited fields from a string expression.
' Delimiter contains a set of characters (one or more), any of which may act as a delimiter character.
' If nPosition evaluates to zero or is outside of the actual field count, an empty string is returned.
' If nPosition is negative then fields are searched from the right to left of the MainString.
' Delimiters are case-sensitive.
' Example: DIM ustr AS USTRING = tkParseStr("one,two,three")           ' Output: one
' Example: DIM ustr AS USTRING = tkParseStr("one;two,three", 1, ";")   ' Output: one
' Example: DIM ustr AS USTRING = tkParseStr("1;2,3", 2, ",;")          ' Output: 2
' ========================================================================================
PUBLIC FUNCTION tkParseStr (BYREF wszSourceString AS CONST WSTRING, BYVAL index AS LONG = 1, BYREF wszDelimiter AS CONST WSTRING = ",") AS USTRING

   DIM ustr AS USTRING
   IF LEN(wszSourceString) = 0 THEN RETURN ustr
   DIM nCount AS LONG, nStart AS LONG
   DIM nPos AS LONG = 1
   DIM fReverse AS BOOLEAN = IIF(index < 0, TRUE, FALSE)
   index = ABS(index)

   IF fReverse THEN
      ' *** Reverse search ***
      ' // Get the start of the token by searching in reverse
      nPos = InstrRev(wszSourceString, ANY wszDelimiter)
      DO WHILE nPos > 0   ' if not found loop will be skipped
         nStart = nPos + 1
         nCount += 1
         nPos = nPos - 1
         IF nCount = index THEN EXIT DO
         nPos = InStrRev(wszSourceString, ANY wszDelimiter, nPos)
      LOOP
      IF nPos = 0 THEN nStart = 1
      ' // Now continue forward to get the end of the token
      nPos = INSTR(nStart, wszSourceString, ANY wszDelimiter)
      IF nPos > 0 OR nCount = index THEN
         IF nPos = 0 THEN
            ustr = MID(wszSourceString, nStart)
         ELSE
            ustr = MID(wszSourceString, nStart, nPos - nStart)
         END IF
      END IF
   ELSE
      ' *** Forward search ***
      DO
         nStart = nPos
         nPos = INSTR(nPos, wszSourceString, ANY wszDelimiter)
         IF nPos THEN
            nCount += 1
            nPos += 1
         END IF
      LOOP UNTIL nPos = 0 OR nCount = index
      IF nPos > 0 OR nCount = index - 1 THEN
         IF nPos = 0 THEN
            ustr = MID(wszSourceString, nStart)
         ELSE
            ustr = MID(wszSourceString, nStart, nPos - 1 - nStart)
         END IF
      END IF
   END IF

   ' // Return the result
   RETURN ustr

END FUNCTION
' ========================================================================================

' ========================================================================================
'  Parses a path/file name to extract component parts.
'  This function evaluates a text path/file text name, and returns a requested part of the
'  name. The functionality is strictly one of string parsing alone.
'  wszOption is one of the following words which is used to specify the requested part:
'  PATH
'        Returns the path portion of the path/file Name. That is the text up to and
'        including the last backslash (\) or colon (:).
'  NAME
'        Returns the name portion of the path/file Name. That is the text to the right
'        of the last backslash (\) or colon (:), ending just before the last period (.).
'  EXTN
'        Returns the extension portion of the path/file name. That is the last
'        period (.) in the string plus the text to the right of it.
'  NAMEX
'        Returns the name and the EXTN parts combined.
' ========================================================================================
PUBLIC FUNCTION tkParsePathName (BYREF wszOption AS CONST WSTRING, BYREF wszFileSpec AS WSTRING) AS USTRING
   DIM ustr AS USTRING
   IF LEN(wszFileSpec) = 0 THEN RETURN ustr
   SELECT CASE UCASE(wszOption)
      CASE "PATH"
         ' // Returns the path portion of file spec
         DIM nPos AS LONG = InstrRev(wszFileSpec, ANY ":/\")
         IF nPos THEN ustr = MID(wszFileSpec, 1, nPos)
      CASE "NAME"
         ' // Retrieve the full filename
         ustr = wszFileSpec
         DIM nPos AS LONG = InstrRev(wszFileSpec, ANY ":/\")
         IF nPos THEN ustr = MID(wszFileSpec, nPos + 1)
         ' // Retrieve the filename
         nPos = InstrRev(ustr, ".")
         IF nPos THEN ustr = MID(ustr, 1, nPos - 1)
      CASE "NAMEX"
         ' // Retrieve the name and extension combined
         DIM nPos AS LONG = InStrRev(wszFileSpec, ANY ":/\")
         IF nPos THEN ustr = MID(wszFileSpec, nPos + 1) ELSE ustr = wszFileSpec
      CASE "EXTN"
         ' // Retrieve the name and extension combined
         DIM nPos AS LONG = InstrRev(wszFileSpec, ANY ":/\")
         IF nPos THEN ustr = MID(wszFileSpec, nPos + 1) ELSE ustr = wszFileSpec
         ' // Retrieve the extension
         nPos = InStrRev(ustr, ".")
         IF nPos THEN ustr = MID(ustr, nPos) ELSE ustr = ""
   END SELECT
   RETURN ustr
END FUNCTION
' ========================================================================================

' ========================================================================================
' Usage example:
' DIM ustr AS USTRING = "Good morning!"
' ustr = tkBase64EncodeW(ustr)
' print ustr
' DIM ustr2 AS USTRING = tkBase64EncodeW(ustr)
' print ustr2
' ========================================================================================
PUBLIC FUNCTION tkBase64EncodeA (BYREF strData AS STRING) AS STRING
   DIM cchStr AS DWORD, strOut AS STRING
   DIM bRes AS LONG = CryptBinaryToStringA(STRPTR(strData), LEN(strData), CRYPT_STRING_BASE64, nullptr, @cchStr)
   IF bRes = 0 OR cchStr = 0 THEN EXIT FUNCTION
   strOut = SPACE(cchStr)
   bRes = CryptBinaryToStringA(STRPTR(strData), LEN(strData), CRYPT_STRING_BASE64, STRPTR(strOut), @cchStr)
   FUNCTION = strOut
END FUNCTION
' ========================================================================================
' ========================================================================================
PUBLIC FUNCTION tkBase64EncodeW (BYREF ustrData AS WSTRING) AS USTRING
   DIM cchStr AS DWORD, ustrOut AS USTRING
   DIM bRes AS LONG = CryptBinaryToStringW(CAST(UBYTE PTR, STRPTR(ustrData)), LEN(ustrData) * 2, CRYPT_STRING_BASE64, nullptr, @cchStr)
   IF bRes = 0 OR cchStr = 0 THEN EXIT FUNCTION
   ustrOut = WSPACE(cchStr)
   bRes = CryptBinaryToStringW(CAST(UBYTE PTR, STRPTR(ustrData)), LEN(ustrData) * 2, CRYPT_STRING_BASE64, STRPTR(ustrOut), @cchStr)
   FUNCTION = ustrOut
END FUNCTION
' ========================================================================================
#ifndef UNICODE
' [pkg/tk] #define tkBase64Encode moved to core.ti
#else
' [pkg/tk] #define tkBase64Encode moved to core.ti
#endif

' ========================================================================================
PUBLIC FUNCTION tkBase64DecodeA (BYREF strData AS STRING) AS STRING
   DIM cbBinary AS DWORD, strOut AS STRING
   DIM bRes AS LONG = CryptStringToBinaryA(STRPTR(strData), LEN(strData), CRYPT_STRING_BASE64, nullptr, @cbBinary, nullptr, nullptr)
   IF bRes = 0 OR cbBinary = 0 THEN EXIT FUNCTION
   strOut = SPACE(cbBinary)
   bRes = CryptStringToBinaryA(STRPTR(strData), LEN(strData), CRYPT_STRING_BASE64, STRPTR(strOut), @cbBinary, nullptr, nullptr)
   FUNCTION = strOut
END FUNCTION
' ========================================================================================
' ========================================================================================
PUBLIC FUNCTION tkBase64DecodeW (BYREF ustrData AS USTRING) AS USTRING
   DIM cbBinary AS DWORD, ustrOut AS USTRING
   DIM bRes AS LONG = CryptStringToBinaryW(STRPTR(ustrData), LEN(ustrData) * 2, CRYPT_STRING_BASE64, nullptr, @cbBinary, nullptr, nullptr)
   IF bRes = 0 OR cbBinary = 0 THEN EXIT FUNCTION
   ustrOut = WSPACE(cbBinary \ 2)
   bRes = CryptStringToBinaryW(STRPTR(ustrData), LEN(ustrData) * 2, CRYPT_STRING_BASE64, CAST(BYTE PTR, STRPTR(ustrOut)), @cbBinary, nullptr, nullptr)
   FUNCTION = ustrOut
END FUNCTION
