#module "tkCore"

#include once "windows.bi"
#include once "win/shlwapi.bi"

' ========================================================================================
' * Returns an uppercased version of a string.
' ========================================================================================
PUBLIC FUNCTION tkUcase (BYVAL pwszStr AS WSTRING PTR, _
   BYVAL pwszLocaleName AS WSTRING PTR = LOCALE_NAME_USER_DEFAULT, _
   BYVAL dwMapFlags AS DWORD = 0) AS USTRING

   ' // Check the validity of the passed parameters
   IF pwszStr = nullptr THEN RETURN ""
   IF LEN(*pwszStr) = 0 THEN RETURN ""
   DIM ustrOut AS USTRING = *pwszStr
   ' // Make sure that LCMAP_LOWERCASE is not being used
   dwMapFlags = dwMapFlags AND (NOT LCMAP_LOWERCASE)
   ' // Make sure that LCMAP_LINGUISTIC_CASING OR LCMAP_UPPERCASE is being used
   dwMapFlags OR= LCMAP_LINGUISTIC_CASING OR LCMAP_UPPERCASE
   ' // Usually, the length of the converted string will be the same that the one of
   ' // the input string, so let's try it
   DIM cbLen AS LONG = LCMapStringEx(pwszLocaleName, dwMapFlags, pwszStr, LEN(*pwszStr), _
       STRPTR(ustrOut), LEN(ustrOut), nullptr, nullptr, 0)
   ' // If the output length is bigger than the input one, request the needed length,
   ' // make the buffer bigger and try it again
   IF cbLen = 0 AND GetLastError = ERROR_INSUFFICIENT_BUFFER THEN
      cbLen = LCMapStringEx(pwszLocaleName, dwMapFlags, pwszStr, LEN(*pwszStr), nullptr, 0, nullptr, nullptr, 0)
      IF cbLen THEN
         ustrOut += WSPACE(cbLen)
         cbLen = LCMapStringEx(pwszLocaleName, dwMapFlags, pwszStr, LEN(*pwszStr), _
                 STRPTR(ustrOut), LEN(ustrOut), nullptr, nullptr, 0)
      END IF
   END IF
   RETURN ustrOut

END FUNCTION
' ========================================================================================

' ========================================================================================
' * Returns a lowercased version of a string.
' ========================================================================================
PUBLIC FUNCTION tkLcase (BYVAL pwszStr AS WSTRING PTR, _
   BYVAL pwszLocaleName AS WSTRING PTR = LOCALE_NAME_USER_DEFAULT, _
   BYVAL dwMapFlags AS DWORD = 0) AS USTRING

   ' // Check the vailidy of the passed parameters
   IF pwszStr = nullptr THEN RETURN ""
   IF LEN(*pwszStr) = 0 THEN RETURN ""
   DIM ustrOut AS USTRING = *pwszStr
   ' // Make sure that LCMAP_UPPERCASE is not being used
   dwMapFlags = dwMapFlags AND (NOT LCMAP_UPPERCASE)
   ' // Make sure that LCMAP_LINGUISTIC_CASING OR LCMAP_LOWERCASE is being used
   dwMapFlags OR= LCMAP_LINGUISTIC_CASING OR LCMAP_LOWERCASE
   ' // Usually, the length of the converted string will be the same that the one of
   ' // the input string, so let's try it
   DIM cbLen AS LONG = LCMapStringEx(pwszLocaleName, dwMapFlags, pwszStr, LEN(*pwszStr), _
       STRPTR(ustrOut), LEN(ustrOut), nullptr, nullptr, 0)
   ' // If the output length is bigger than the input one, request the needed length,
   ' // make the buffer bigger and try it again
   IF cbLen = 0 AND GetLastError = ERROR_INSUFFICIENT_BUFFER THEN
      cbLen = LCMapStringEx(pwszLocaleName, dwMapFlags, pwszStr, LEN(*pwszStr), nullptr, 0, nullptr, nullptr, 0)
      IF cbLen THEN
         ustrOut += WSPACE(cbLen)
         cbLen = LCMapStringEx(pwszLocaleName, dwMapFlags, pwszStr, LEN(*pwszStr), _
                 STRPTR(ustrOut), LEN(ustrOut), nullptr, nullptr, 0)
      END IF
   END IF
   RETURN ustrOut

END FUNCTION
' ========================================================================================

' ========================================================================================
' * Translates ansi bytes to Unicode chars.
' ========================================================================================
PUBLIC FUNCTION tkUcode (BYREF ansiStr AS CONST STRING, BYVAL nCodePage AS LONG = 0) AS USTRING

   IF nCodePage = CP_UTF8 THEN
      DIM dwLen AS DWORD = MultiByteToWideChar(CP_UTF8, 0, STRPTR(ansiStr), LEN(ansiStr), nullptr, 0)
      IF dwLen THEN
         DIM ustr AS USTRING = WSPACE(dwLen)
         dwLen = MultiByteToWideChar(CP_UTF8, 0, STRPTR(ansiStr), LEN(ansiStr), STRPTR(ustr), dwLen * 2)
         IF dwLen THEN RETURN ustr
      END IF
   ELSE
      DIM ustr AS USTRING = WSPACE(LEN(ansiStr))
      DIM dwLen AS DWORD = MultiByteToWideChar(nCodePage, MB_PRECOMPOSED, STRPTR(ansiStr), LEN(ansiStr), STRPTR(ustr), LEN(ansiStr) * 2)
      IF dwLen THEN RETURN ustr
   END IF
   RETURN ""

END FUNCTION
' ========================================================================================

' ========================================================================================
' * Translates Unicode chars to ansi bytes.
' ========================================================================================
PUBLIC FUNCTION tkAcode (BYVAL pwszStr AS WSTRING PTR, BYVAL nCodePage AS LONG = 0) AS STRING

   IF pwszStr = nullptr THEN EXIT FUNCTION
   IF nCodePage = CP_UTF8 THEN
      DIM dwLen AS DWORD = WideCharToMultiByte(CP_UTF8, 0, pwszStr, LEN(*pwszStr), nullptr, 0, nullptr, nullptr)
      IF dwLen THEN
         DIM ansiStr AS STRING = SPACE(dwLen)
         dwLen = WideCharToMultiByte(CP_UTF8, 0, pwszStr, LEN(*pwszStr), STRPTR(ansiStr), LEN(ansiStr), nullptr, nullptr)
         IF dwLen THEN RETURN ansiStr
      END IF
   ELSE
      DIM ansiStr AS STRING = SPACE(LEN(*pwszStr))
      DIM dwLen AS DWORD = WideCharToMultiByte(nCodePage, 0, pwszStr, LEN(*pwszStr), STRPTR(ansiStr), LEN(ansiStr), nullptr, nullptr)
      IF dwLen THEN RETURN ansiStr
   ENDIF
   RETURN ""

END FUNCTION
' ========================================================================================

' ========================================================================================
' Converts Unicode to utf8.
' ========================================================================================
PUBLIC FUNCTION tkWideToUtf8 (BYVAL pwszStr AS WSTRING PTR) AS STRING
   RETURN tkAcode(pwszStr, CP_UTF8)
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Converts utf8 to Unicode.
' ========================================================================================
PUBLIC FUNCTION tkUtf8ToWide (BYREF utf8Str AS CONST STRING) AS USTRING
   RETURN tkUcode(utf8Str, CP_UTF8)
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Transltes Unicode to OEM byte characters.
' ========================================================================================
PUBLIC FUNCTION tkWideToOem (BYVAL pwszStr AS WSTRING PTR) AS STRING
   RETURN tkAcode(pwszStr, CP_OEMCP)
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Traslates a byte string of OEM characters to Unicode.
' ========================================================================================
PUBLIC FUNCTION tkOemToWide (BYREF oemStr AS CONST STRING) AS USTRING
   RETURN tkUcode(oemStr, CP_OEMCP)
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Converts a numeric value into a string that represents the number expressed as a size
' value in bytes, kilobytes, megabytes, or gigabytes, depending on the size.
' ========================================================================================
PUBLIC FUNCTION tkFormatByteSize (BYVAL ull AS LONGLONG) AS USTRING
   DIM wsz AS WSTRING *  260 = WSPACE(260)
   StrFormatByteSizeW(ull, @wsz, 260)
   RETURN wsz
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Converts a numeric value into a string that represents the number expressed as a size
' value in kilobytes.
' ========================================================================================
PUBLIC FUNCTION tkFormatKBSize (BYVAL ull AS LONGLONG) AS USTRING
   DIM wsz AS WSTRING * 260 = WSPACE(260)
   StrFormatKBSizeW(ull, @wsz, 260)
   RETURN wsz
END FUNCTION
' ========================================================================================

' ========================================================================================
' * Converts a time interval, specified in milliseconds, to a string.
' Parameters:
' - dwTimeMS: The time interval, in milliseconds.
' - digits  : The maximum number of significant digits to be represented in the output
'             string. Some examples are:
'             dwTimeMS digits   cwsOut
'             -------- ------ -----------
'                34000    3         34 sec.
'                34000    2         34 sec.
'                34000    1         30 sec.
'                74000    3  1 min. 14 sec.
'                74000    2  1 min. 10 sec.
'                74000    1  1 min.
' ========================================================================================
PUBLIC FUNCTION tkStrFromTimeInterval (BYVAL dwTimeMS AS DWORD, BYVAL digits AS LONG) AS USTRING
   DIM ustr AS USTRING = WSPACE(260)
   StrFromTimeIntervalW(STRPTR(ustr), 260, dwTimeMS, digits)
   RETURN ustr
END FUNCTION
