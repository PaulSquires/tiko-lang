PUBLIC FUNCTION tkMenu_GetSystemMenuHandle (BYVAL hwnd AS HWND, BYVAL bRevert AS BOOLEAN = FALSE) AS HMENU
   RETURN ..GetSystemMenu(hwnd, bRevert)
