   DECLARE CONSTRUCTOR (BYVAL brush AS GpBrush PTR, BYVAL nWidth AS SINGLE, BYVAL unit AS GpUnit = UnitPixel)
   DECLARE DESTRUCTOR
   DECLARE OPERATOR @ () AS GpPen PTR PTR
   DECLARE OPERATOR CAST () AS GpPen PTR
END TYPE
