/'*********************************************************************************************
*
*   raymath v2.0 - Math functions to work with Vector2, Vector3, Vector4, Matrix and Quaternions
*
*   CONVENTIONS:
*     - Matrix structure is defined as row-major (memory layout) but parameters naming AND all
*       math operations performed by the library consider the structure as it was column-major
*       It is like transposed versions of the matrices are used for all the maths
*       It benefits some functions making them cache-friendly and also avoids matrix
*       transpositions sometimes required by OpenGL
*       Example: In memory order, row0 is [m0 m4 m8 m12] but in semantic math row0 is [m0 m1 m2 m3]
*     - Functions are always self-contained, no function use another raymath function inside,
*       required code is directly re-implemented inside
*     - Functions input parameters are always received by value (2 unavoidable exceptions)
*     - Functions use always a "result" variable for return (except C++ operators)
*     - Functions are always defined inline
*     - Angles are always in radians (DEG2RAD/RAD2DEG macros provided for convenience)
*     - No compound literals used to make sure the library is compatible with C++
*
*   CONFIGURATION:
*       #define RAYMATH_IMPLEMENTATION
*           Generates the implementation of the library into the included file
*           If not defined, the library is in header only mode and can be included in other headers
*           or source files without problems. But only ONE file should hold the implementation
*
*       #define RAYMATH_STATIC_INLINE
*           Define static inline functions code, so #include header suffices for use
*           This may use up lots of memory
*
*       #define RAYMATH_DISABLE_CPP_OPERATORS
*           Disables C++ operator overloads for raymath types.
*
*       #define RAYMATH_USE_SIMD_INTRINSICS   1
*           Try to enable SIMD intrinsics for MatrixMultiply()
*           Note that users enabling it must be aware of the target platform where application will
*           run to support the selected SIMD intrinsic, for now, only SSE is supported
*
*   LICENSE: zlib/libpng
*
*   Copyright (c) 2015-2026 Ramon Santamaria (@raysan5)
*
*   This software is provided "as-is", without any express or implied warranty. In no event
*   will the authors be held liable for any damages arising from the use of this software.
*
*   Permission is granted to anyone to use this software for any purpose, including commercial
*   applications, and to alter it and redistribute it freely, subject to the following restrictions:
*
*     1. The origin of this software must not be misrepresented; you must not claim that you
*     wrote the original software. If you use this software in a product, an acknowledgment
*     in the product documentation would be appreciated but is not required.
*
*     2. Altered source versions must be plainly marked as such, and must not be misrepresented
*     as being the original software.
*
*     3. This notice may not be removed or altered from any source distribution.
*
*********************************************************************************************'/

#pragma once

extern "C"

#if (defined(RAYMATH_IMPLEMENTATION) andalso defined(RAYMATH_STATIC_INLINE))
    #error "Specifying both RAYMATH_IMPLEMENTATION and RAYMATH_STATIC_INLINE is contradictory"
#endif

'' Function specifiers definition
'' c2t: export macro RMAPI (decoration, stripped where used)

''----------------------------------------------------------------------------------
'' Defines and Macros
''----------------------------------------------------------------------------------
#ifndef PI
    #define PI 3.14159265358979323846f
#endif

#ifndef EPSILON
    #define EPSILON 0.000001f
#endif

#ifndef DEG2RAD
    '' C2T-NOTE(value) raymath.h:99 -- clang's value; '(PI / 180.0f)' is 0.01745329300562541 in tiko
    #define DEG2RAD 0.01745329238474369
#endif

#ifndef RAD2DEG
    '' C2T-NOTE(value) raymath.h:103 -- clang's value; '(180.0f / PI)' is 57.29577791868205 in tiko
    #define RAD2DEG 57.2957763671875
#endif

'' Get float vector for Matrix
#ifndef MatrixToFloat
    '' C2T-TODO(function-like-macro) raymath.h:108 -- member access, subscripts and increments
''     #define MatrixToFloat(mat) (MatrixToFloatV(mat).v)
#endif

'' Get float vector for Vector3
#ifndef Vector3ToFloat
    '' C2T-TODO(function-like-macro) raymath.h:113 -- member access, subscripts and increments
''     #define Vector3ToFloat(vec) (Vector3ToFloatV(vec).v)
#endif

''----------------------------------------------------------------------------------
'' Types and Structures Definition
''----------------------------------------------------------------------------------
#if ((defined(RL_VECTOR2_TYPE)) = 0)
'' Vector2 type
type Vector2
    x as float32
    y as float32
end type
#define RL_VECTOR2_TYPE
#endif

#if ((defined(RL_VECTOR3_TYPE)) = 0)
'' Vector3 type
type Vector3
    x as float32
    y as float32
    z as float32
end type
#define RL_VECTOR3_TYPE
#endif

#if ((defined(RL_VECTOR4_TYPE)) = 0)
'' Vector4 type
type Vector4
    x as float32
    y as float32
    z as float32
    w as float32
end type
#define RL_VECTOR4_TYPE
#endif

#if ((defined(RL_QUATERNION_TYPE)) = 0)
'' Quaternion type
type Quaternion as Vector4
#define RL_QUATERNION_TYPE
#endif

#if ((defined(RL_MATRIX_TYPE)) = 0)
'' Matrix type (OpenGL style 4x4 - right handed, column major)
type Matrix
    m0 as float32
    m4 as float32
    m8 as float32
    m12 as float32              '' Matrix first row (4 components)
    m1 as float32
    m5 as float32
    m9 as float32
    m13 as float32              '' Matrix second row (4 components)
    m2 as float32
    m6 as float32
    m10 as float32
    m14 as float32              '' Matrix third row (4 components)
    m3 as float32
    m7 as float32
    m11 as float32
    m15 as float32              '' Matrix fourth row (4 components)
end type
#define RL_MATRIX_TYPE
#endif

'' NOTE: Helper types to be used instead of array return types for *ToFloat functions
#if ((defined(RL_FLOAT3_TYPE)) = 0)
type float3
    v(0 to 2) as float32
end type
#define RL_FLOAT3_TYPE
#endif

#if ((defined(RL_FLOAT16_TYPE)) = 0)
type float16
    v(0 to 15) as float32
end type
#define RL_FLOAT16_TYPE
#endif

#include once "crt/math.bi"       '' Required for: sinf(), cosf(), tan(), atan2f(), sqrtf(), floor(), fminf(), fmaxf(), fabsf()

#if RAYMATH_USE_SIMD_INTRINSICS
    '' SIMD is used on the most costly raymath function MatrixMultiply()
    '' NOTE: Only SSE intrinsics support implemented
    '' TODO: Consider support for other SIMD intrinsics:
    ''  - SSEx, AVX, AVX2, FMA, NEON, RVV
    /'
    #if defined(__SSE4_2__)
        #include <nmmintrin.h>
        #define RAYMATH_SSE42_ENABLED
    #elif defined(__SSE4_1__)
        #include <smmintrin.h>
        #define RAYMATH_SSE41_ENABLED
    #elif defined(__SSSE3__)
        #include <tmmintrin.h>
        #define RAYMATH_SSSE3_ENABLED
    #elif defined(__SSE3__)
        #include <pmmintrin.h>
        #define RAYMATH_SSE3_ENABLED
    #elif defined(__SSE2__) || (defined(_M_AMD64) || defined(_M_X64)) // SSE2 x64
        #include <emmintrin.h>
        #define RAYMATH_SSE2_ENABLED
    #endif
    '/
    #if ((defined(__SSE__) orelse defined(TIKO_ARCH_X86_64)) orelse (defined(_M_IX86_FP) andalso (_M_IX86_FP >= 1)))
        '' C2T-TODO(system-header) raymath.h:207 -- <xmmintrin.h> has no tiko counterpart in c2t's table
''         #include <xmmintrin.h>
        #define RAYMATH_SSE_ENABLED
    #endif
#endif

''----------------------------------------------------------------------------------
'' Module Functions Definition - Utils math
''----------------------------------------------------------------------------------

'' Clamp float value
'' C2T-NOTE(inline) raymath.h:217 -- inline: links only if the library exports 'Clamp'
declare function Clamp( byval value as float32, byval min as float32, byval max as float32 ) as float32

'' Calculate linear interpolation between two floats
'' C2T-NOTE(inline) raymath.h:227 -- inline: links only if the library exports 'Lerp'
declare function Lerp( byval start as float32, byval end_ as float32, byval amount as float32 ) as float32

'' Normalize input value within input range
'' C2T-NOTE(inline) raymath.h:235 -- inline: links only if the library exports 'Normalize'
declare function Normalize( byval value as float32, byval start as float32, byval end_ as float32 ) as float32

'' Remap input value within input range to output range
'' C2T-NOTE(inline) raymath.h:243 -- inline: links only if the library exports 'Remap'
declare function Remap( byval value as float32, byval inputStart as float32, byval inputEnd as float32, byval outputStart as float32, byval outputEnd as float32 ) as float32

'' Wrap input value from min to max
'' C2T-NOTE(inline) raymath.h:251 -- inline: links only if the library exports 'Wrap'
declare function Wrap( byval value as float32, byval min as float32, byval max as float32 ) as float32

'' Check whether two given floats are almost equal
'' C2T-NOTE(inline) raymath.h:259 -- inline: links only if the library exports 'FloatEquals'
declare function FloatEquals( byval x as float32, byval y as float32 ) as int32

''----------------------------------------------------------------------------------
'' Module Functions Definition - Vector2 math
''----------------------------------------------------------------------------------

'' Vector with components value 0.0f
'' C2T-NOTE(inline) raymath.h:275 -- inline: links only if the library exports 'Vector2Zero'
declare function Vector2Zero( ) as Vector2

'' Vector with components value 1.0f
'' C2T-NOTE(inline) raymath.h:283 -- inline: links only if the library exports 'Vector2One'
declare function Vector2One( ) as Vector2

'' Add two vectors (v1 + v2)
'' C2T-NOTE(inline) raymath.h:291 -- inline: links only if the library exports 'Vector2Add'
declare function Vector2Add( byval v1 as Vector2, byval v2 as Vector2 ) as Vector2

'' Add vector and float value
'' C2T-NOTE(inline) raymath.h:299 -- inline: links only if the library exports 'Vector2AddValue'
declare function Vector2AddValue( byval v as Vector2, byval add as float32 ) as Vector2

'' Subtract two vectors (v1 - v2)
'' C2T-NOTE(inline) raymath.h:307 -- inline: links only if the library exports 'Vector2Subtract'
declare function Vector2Subtract( byval v1 as Vector2, byval v2 as Vector2 ) as Vector2

'' Subtract vector by float value
'' C2T-NOTE(inline) raymath.h:315 -- inline: links only if the library exports 'Vector2SubtractValue'
declare function Vector2SubtractValue( byval v as Vector2, byval sub_ as float32 ) as Vector2

'' Calculate vector length
'' C2T-NOTE(inline) raymath.h:323 -- inline: links only if the library exports 'Vector2Length'
declare function Vector2Length( byval v as Vector2 ) as float32

'' Calculate vector square length
'' C2T-NOTE(inline) raymath.h:331 -- inline: links only if the library exports 'Vector2LengthSqr'
declare function Vector2LengthSqr( byval v as Vector2 ) as float32

'' Calculate two vectors dot product
'' C2T-NOTE(inline) raymath.h:339 -- inline: links only if the library exports 'Vector2DotProduct'
declare function Vector2DotProduct( byval v1 as Vector2, byval v2 as Vector2 ) as float32

'' Calculate two vectors cross product
'' C2T-NOTE(inline) raymath.h:347 -- inline: links only if the library exports 'Vector2CrossProduct'
declare function Vector2CrossProduct( byval v1 as Vector2, byval v2 as Vector2 ) as float32

'' Calculate distance between two vectors
'' C2T-NOTE(inline) raymath.h:355 -- inline: links only if the library exports 'Vector2Distance'
declare function Vector2Distance( byval v1 as Vector2, byval v2 as Vector2 ) as float32

'' Calculate square distance between two vectors
'' C2T-NOTE(inline) raymath.h:363 -- inline: links only if the library exports 'Vector2DistanceSqr'
declare function Vector2DistanceSqr( byval v1 as Vector2, byval v2 as Vector2 ) as float32

'' Calculate the signed angle from v1 to v2, relative to the origin (0, 0)
'' NOTE: Coordinate system convention: positive X right, positive Y down
'' positive angles appear clockwise, and negative angles appear counterclockwise
'' C2T-NOTE(inline) raymath.h:373 -- inline: links only if the library exports 'Vector2Angle'
declare function Vector2Angle( byval v1 as Vector2, byval v2 as Vector2 ) as float32

'' Calculate angle defined by a two vectors line
'' NOTE: Parameters need to be normalized
'' Current implementation should be aligned with glm::angle
'' C2T-NOTE(inline) raymath.h:388 -- inline: links only if the library exports 'Vector2LineAngle'
declare function Vector2LineAngle( byval start as Vector2, byval end_ as Vector2 ) as float32

'' Scale vector (multiply by value)
'' C2T-NOTE(inline) raymath.h:398 -- inline: links only if the library exports 'Vector2Scale'
declare function Vector2Scale( byval v as Vector2, byval scale as float32 ) as Vector2

'' Multiply vector by vector
'' C2T-NOTE(inline) raymath.h:406 -- inline: links only if the library exports 'Vector2Multiply'
declare function Vector2Multiply( byval v1 as Vector2, byval v2 as Vector2 ) as Vector2

'' Negate vector
'' C2T-NOTE(inline) raymath.h:414 -- inline: links only if the library exports 'Vector2Negate'
declare function Vector2Negate( byval v as Vector2 ) as Vector2

'' Divide vector by vector
'' C2T-NOTE(inline) raymath.h:422 -- inline: links only if the library exports 'Vector2Divide'
declare function Vector2Divide( byval v1 as Vector2, byval v2 as Vector2 ) as Vector2

'' Normalize provided vector
'' C2T-NOTE(inline) raymath.h:430 -- inline: links only if the library exports 'Vector2Normalize'
declare function Vector2Normalize( byval v as Vector2 ) as Vector2

'' Transforms a Vector2 by a given Matrix
'' C2T-NOTE(inline) raymath.h:446 -- inline: links only if the library exports 'Vector2Transform'
declare function Vector2Transform( byval v as Vector2, byval mat as Matrix ) as Vector2

'' Calculate linear interpolation between two vectors
'' C2T-NOTE(inline) raymath.h:461 -- inline: links only if the library exports 'Vector2Lerp'
declare function Vector2Lerp( byval v1 as Vector2, byval v2 as Vector2, byval amount as float32 ) as Vector2

'' Calculate reflected vector to normal
'' C2T-NOTE(inline) raymath.h:472 -- inline: links only if the library exports 'Vector2Reflect'
declare function Vector2Reflect( byval v as Vector2, byval normal as Vector2 ) as Vector2

'' Get min value for each pair of components
'' C2T-NOTE(inline) raymath.h:485 -- inline: links only if the library exports 'Vector2Min'
declare function Vector2Min( byval v1 as Vector2, byval v2 as Vector2 ) as Vector2

'' Get max value for each pair of components
'' C2T-NOTE(inline) raymath.h:496 -- inline: links only if the library exports 'Vector2Max'
declare function Vector2Max( byval v1 as Vector2, byval v2 as Vector2 ) as Vector2

'' Rotate vector by angle
'' C2T-NOTE(inline) raymath.h:507 -- inline: links only if the library exports 'Vector2Rotate'
declare function Vector2Rotate( byval v as Vector2, byval angle as float32 ) as Vector2

'' Move Vector towards target
'' C2T-NOTE(inline) raymath.h:521 -- inline: links only if the library exports 'Vector2MoveTowards'
declare function Vector2MoveTowards( byval v as Vector2, byval target as Vector2, byval maxDistance as float32 ) as Vector2

'' Invert the given vector
'' C2T-NOTE(inline) raymath.h:540 -- inline: links only if the library exports 'Vector2Invert'
declare function Vector2Invert( byval v as Vector2 ) as Vector2

'' Clamp the components of the vector between
'' min and max values specified by the given vectors
'' C2T-NOTE(inline) raymath.h:549 -- inline: links only if the library exports 'Vector2Clamp'
declare function Vector2Clamp( byval v as Vector2, byval min as Vector2, byval max as Vector2 ) as Vector2

'' Clamp the magnitude of the vector between two min and max values
'' C2T-NOTE(inline) raymath.h:560 -- inline: links only if the library exports 'Vector2ClampValue'
declare function Vector2ClampValue( byval v as Vector2, byval min as float32, byval max as float32 ) as Vector2

'' Check whether two given vectors are almost equal
'' C2T-NOTE(inline) raymath.h:581 -- inline: links only if the library exports 'Vector2Equals'
declare function Vector2Equals( byval p as Vector2, byval q as Vector2 ) as int32

'' Compute the direction of a refracted ray
'' v: normalized direction of the incoming ray
'' n: normalized normal vector of the interface of two optical media
'' r: ratio of the refractive index of the medium from where the ray comes
'' to the refractive index of the medium on the other side of the surface
'' C2T-NOTE(inline) raymath.h:598 -- inline: links only if the library exports 'Vector2Refract'
declare function Vector2Refract( byval v as Vector2, byval n as Vector2, byval r as float32 ) as Vector2


''----------------------------------------------------------------------------------
'' Module Functions Definition - Vector3 math
''----------------------------------------------------------------------------------

'' Vector with components value 0.0f
'' C2T-NOTE(inline) raymath.h:623 -- inline: links only if the library exports 'Vector3Zero'
declare function Vector3Zero( ) as Vector3

'' Vector with components value 1.0f
'' C2T-NOTE(inline) raymath.h:631 -- inline: links only if the library exports 'Vector3One'
declare function Vector3One( ) as Vector3

'' Add two vectors
'' C2T-NOTE(inline) raymath.h:639 -- inline: links only if the library exports 'Vector3Add'
declare function Vector3Add( byval v1 as Vector3, byval v2 as Vector3 ) as Vector3

'' Add vector and float value
'' C2T-NOTE(inline) raymath.h:647 -- inline: links only if the library exports 'Vector3AddValue'
declare function Vector3AddValue( byval v as Vector3, byval add as float32 ) as Vector3

'' Subtract two vectors
'' C2T-NOTE(inline) raymath.h:655 -- inline: links only if the library exports 'Vector3Subtract'
declare function Vector3Subtract( byval v1 as Vector3, byval v2 as Vector3 ) as Vector3

'' Subtract vector by float value
'' C2T-NOTE(inline) raymath.h:663 -- inline: links only if the library exports 'Vector3SubtractValue'
declare function Vector3SubtractValue( byval v as Vector3, byval sub_ as float32 ) as Vector3

'' Multiply vector by scalar
'' C2T-NOTE(inline) raymath.h:671 -- inline: links only if the library exports 'Vector3Scale'
declare function Vector3Scale( byval v as Vector3, byval scalar as float32 ) as Vector3

'' Multiply vector by vector
'' C2T-NOTE(inline) raymath.h:679 -- inline: links only if the library exports 'Vector3Multiply'
declare function Vector3Multiply( byval v1 as Vector3, byval v2 as Vector3 ) as Vector3

'' Calculate two vectors cross product
'' C2T-NOTE(inline) raymath.h:687 -- inline: links only if the library exports 'Vector3CrossProduct'
declare function Vector3CrossProduct( byval v1 as Vector3, byval v2 as Vector3 ) as Vector3

'' Calculate one vector perpendicular vector
'' C2T-NOTE(inline) raymath.h:695 -- inline: links only if the library exports 'Vector3Perpendicular'
declare function Vector3Perpendicular( byval v as Vector3 ) as Vector3

'' Calculate vector length
'' C2T-NOTE(inline) raymath.h:724 -- inline: links only if the library exports 'Vector3Length'
declare function Vector3Length( byval v as Vector3 ) as float32

'' Calculate vector square length
'' C2T-NOTE(inline) raymath.h:732 -- inline: links only if the library exports 'Vector3LengthSqr'
declare function Vector3LengthSqr( byval v as Vector3 ) as float32

'' Calculate two vectors dot product
'' C2T-NOTE(inline) raymath.h:740 -- inline: links only if the library exports 'Vector3DotProduct'
declare function Vector3DotProduct( byval v1 as Vector3, byval v2 as Vector3 ) as float32

'' Calculate distance between two vectors
'' C2T-NOTE(inline) raymath.h:748 -- inline: links only if the library exports 'Vector3Distance'
declare function Vector3Distance( byval v1 as Vector3, byval v2 as Vector3 ) as float32

'' Calculate square distance between two vectors
'' C2T-NOTE(inline) raymath.h:761 -- inline: links only if the library exports 'Vector3DistanceSqr'
declare function Vector3DistanceSqr( byval v1 as Vector3, byval v2 as Vector3 ) as float32

'' Calculate angle between two vectors
'' C2T-NOTE(inline) raymath.h:774 -- inline: links only if the library exports 'Vector3Angle'
declare function Vector3Angle( byval v1 as Vector3, byval v2 as Vector3 ) as float32

'' Negate provided vector (invert direction)
'' C2T-NOTE(inline) raymath.h:787 -- inline: links only if the library exports 'Vector3Negate'
declare function Vector3Negate( byval v as Vector3 ) as Vector3

'' Divide vector by vector
'' C2T-NOTE(inline) raymath.h:795 -- inline: links only if the library exports 'Vector3Divide'
declare function Vector3Divide( byval v1 as Vector3, byval v2 as Vector3 ) as Vector3

'' Normalize provided vector
'' C2T-NOTE(inline) raymath.h:803 -- inline: links only if the library exports 'Vector3Normalize'
declare function Vector3Normalize( byval v as Vector3 ) as Vector3

''Calculate the projection of the vector v1 on to v2
'' C2T-NOTE(inline) raymath.h:821 -- inline: links only if the library exports 'Vector3Project'
declare function Vector3Project( byval v1 as Vector3, byval v2 as Vector3 ) as Vector3

''Calculate the rejection of the vector v1 on to v2
'' C2T-NOTE(inline) raymath.h:838 -- inline: links only if the library exports 'Vector3Reject'
declare function Vector3Reject( byval v1 as Vector3, byval v2 as Vector3 ) as Vector3

'' Orthonormalize provided vectors
'' Makes vectors normalized and orthogonal to each other
'' Gram-Schmidt function implementation
'' C2T-NOTE(inline) raymath.h:857 -- inline: links only if the library exports 'Vector3OrthoNormalize'
declare sub Vector3OrthoNormalize( byval v1 as Vector3 ptr, byval v2 as Vector3 ptr )

'' Transforms a Vector3 by a given Matrix
'' C2T-NOTE(inline) raymath.h:890 -- inline: links only if the library exports 'Vector3Transform'
declare function Vector3Transform( byval v as Vector3, byval mat as Matrix ) as Vector3

'' Transform a vector by quaternion rotation
'' C2T-NOTE(inline) raymath.h:906 -- inline: links only if the library exports 'Vector3RotateByQuaternion'
declare function Vector3RotateByQuaternion( byval v as Vector3, byval q as Quaternion ) as Vector3

'' Rotates a vector around an axis
'' C2T-NOTE(inline) raymath.h:918 -- inline: links only if the library exports 'Vector3RotateByAxisAngle'
declare function Vector3RotateByAxisAngle( byval v as Vector3, byval axis as Vector3, byval angle as float32 ) as Vector3

'' Move Vector towards target
'' C2T-NOTE(inline) raymath.h:970 -- inline: links only if the library exports 'Vector3MoveTowards'
declare function Vector3MoveTowards( byval v as Vector3, byval target as Vector3, byval maxDistance as float32 ) as Vector3

'' Calculate linear interpolation between two vectors
'' C2T-NOTE(inline) raymath.h:991 -- inline: links only if the library exports 'Vector3Lerp'
declare function Vector3Lerp( byval v1 as Vector3, byval v2 as Vector3, byval amount as float32 ) as Vector3

'' Calculate cubic hermite interpolation between two vectors and their tangents
'' as described in the GLTF 2.0 specification: https://registry.khronos.org/glTF/specs/2.0/glTF-2.0.html#interpolation-cubic
'' C2T-NOTE(inline) raymath.h:1004 -- inline: links only if the library exports 'Vector3CubicHermite'
declare function Vector3CubicHermite( byval v1 as Vector3, byval tangent1 as Vector3, byval v2 as Vector3, byval tangent2 as Vector3, byval amount as float32 ) as Vector3

'' Calculate reflected vector to normal
'' C2T-NOTE(inline) raymath.h:1019 -- inline: links only if the library exports 'Vector3Reflect'
declare function Vector3Reflect( byval v as Vector3, byval normal as Vector3 ) as Vector3

'' Get min value for each pair of components
'' C2T-NOTE(inline) raymath.h:1037 -- inline: links only if the library exports 'Vector3Min'
declare function Vector3Min( byval v1 as Vector3, byval v2 as Vector3 ) as Vector3

'' Get max value for each pair of components
'' C2T-NOTE(inline) raymath.h:1049 -- inline: links only if the library exports 'Vector3Max'
declare function Vector3Max( byval v1 as Vector3, byval v2 as Vector3 ) as Vector3

'' Compute barycenter coordinates (u, v, w) for point p with respect to triangle (a, b, c)
'' NOTE: Assumes P is on the plane of the triangle
'' C2T-NOTE(inline) raymath.h:1062 -- inline: links only if the library exports 'Vector3Barycenter'
declare function Vector3Barycenter( byval p as Vector3, byval a as Vector3, byval b as Vector3, byval c as Vector3 ) as Vector3

'' Projects a Vector3 from screen space into object space
'' NOTE: Self-contained function, no other raymath functions are called
'' C2T-NOTE(inline) raymath.h:1086 -- inline: links only if the library exports 'Vector3Unproject'
declare function Vector3Unproject( byval source as Vector3, byval projection as Matrix, byval view_ as Matrix ) as Vector3

'' Get Vector3 as float array
'' C2T-NOTE(inline) raymath.h:1169 -- inline: links only if the library exports 'Vector3ToFloatV'
declare function Vector3ToFloatV( byval v as Vector3 ) as float3

'' Invert the given vector
'' C2T-NOTE(inline) raymath.h:1181 -- inline: links only if the library exports 'Vector3Invert'
declare function Vector3Invert( byval v as Vector3 ) as Vector3

'' Clamp the components of the vector between
'' min and max values specified by the given vectors
'' C2T-NOTE(inline) raymath.h:1190 -- inline: links only if the library exports 'Vector3Clamp'
declare function Vector3Clamp( byval v as Vector3, byval min as Vector3, byval max as Vector3 ) as Vector3

'' Clamp the magnitude of the vector between two values
'' C2T-NOTE(inline) raymath.h:1202 -- inline: links only if the library exports 'Vector3ClampValue'
declare function Vector3ClampValue( byval v as Vector3, byval min as float32, byval max as float32 ) as Vector3

'' Check whether two given vectors are almost equal
'' C2T-NOTE(inline) raymath.h:1224 -- inline: links only if the library exports 'Vector3Equals'
declare function Vector3Equals( byval p as Vector3, byval q as Vector3 ) as int32

'' Compute the direction of a refracted ray
'' v: normalized direction of the incoming ray
'' n: normalized normal vector of the interface of two optical media
'' r: ratio of the refractive index of the medium from where the ray comes
'' to the refractive index of the medium on the other side of the surface
'' C2T-NOTE(inline) raymath.h:1242 -- inline: links only if the library exports 'Vector3Refract'
declare function Vector3Refract( byval v as Vector3, byval n as Vector3, byval r as float32 ) as Vector3


