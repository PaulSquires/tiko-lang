'' Calculate linear interpolation between two vectors
'' C2T-NOTE(inline) raymath.h:1441 -- inline: links only if the library exports 'Vector4Lerp'
declare function Vector4Lerp( byval v1 as Vector4, byval v2 as Vector4, byval amount as float32 ) as Vector4

'' Move Vector towards target
'' C2T-NOTE(inline) raymath.h:1454 -- inline: links only if the library exports 'Vector4MoveTowards'
declare function Vector4MoveTowards( byval v as Vector4, byval target as Vector4, byval maxDistance as float32 ) as Vector4

'' Invert the given vector
'' C2T-NOTE(inline) raymath.h:1477 -- inline: links only if the library exports 'Vector4Invert'
