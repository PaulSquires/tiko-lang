'' Multiply vector by vector
'' C2T-NOTE(inline) raymath.h:1376 -- inline: links only if the library exports 'Vector4Multiply'
declare function Vector4Multiply( byval v1 as Vector4, byval v2 as Vector4 ) as Vector4

'' Negate vector
'' C2T-NOTE(inline) raymath.h:1383 -- inline: links only if the library exports 'Vector4Negate'
declare function Vector4Negate( byval v as Vector4 ) as Vector4

'' Divide vector by vector
'' C2T-NOTE(inline) raymath.h:1390 -- inline: links only if the library exports 'Vector4Divide'
declare function Vector4Divide( byval v1 as Vector4, byval v2 as Vector4 ) as Vector4

'' Normalize provided vector
'' C2T-NOTE(inline) raymath.h:1397 -- inline: links only if the library exports 'Vector4Normalize'
declare function Vector4Normalize( byval v as Vector4 ) as Vector4

'' Get min value for each pair of components
'' C2T-NOTE(inline) raymath.h:1415 -- inline: links only if the library exports 'Vector4Min'
declare function Vector4Min( byval v1 as Vector4, byval v2 as Vector4 ) as Vector4

'' Get max value for each pair of components
'' C2T-NOTE(inline) raymath.h:1428 -- inline: links only if the library exports 'Vector4Max'
