'' Check whether two given vectors are almost equal
'' C2T-NOTE(inline) raymath.h:1484 -- inline: links only if the library exports 'Vector4Equals'
declare function Vector4Equals( byval p as Vector4, byval q as Vector4 ) as int32


''----------------------------------------------------------------------------------
'' Module Functions Definition - Matrix math
''----------------------------------------------------------------------------------

'' Compute matrix determinant
'' C2T-NOTE(inline) raymath.h:1503 -- inline: links only if the library exports 'MatrixDeterminant'
declare function MatrixDeterminant( byval mat as Matrix ) as float32

'' Get the trace of the matrix (sum of the values along the diagonal)
'' C2T-NOTE(inline) raymath.h:1540 -- inline: links only if the library exports 'MatrixTrace'
declare function MatrixTrace( byval mat as Matrix ) as float32

'' Transposes provided matrix
'' C2T-NOTE(inline) raymath.h:1548 -- inline: links only if the library exports 'MatrixTranspose'
declare function MatrixTranspose( byval mat as Matrix ) as Matrix

'' Invert provided matrix
'' C2T-NOTE(inline) raymath.h:1573 -- inline: links only if the library exports 'MatrixInvert'
declare function MatrixInvert( byval mat as Matrix ) as Matrix

'' Get identity matrix
'' C2T-NOTE(inline) raymath.h:1620 -- inline: links only if the library exports 'MatrixIdentity'
declare function MatrixIdentity( ) as Matrix

'' Add two matrices
'' C2T-NOTE(inline) raymath.h:1631 -- inline: links only if the library exports 'MatrixAdd'
declare function MatrixAdd( byval left_ as Matrix, byval right_ as Matrix ) as Matrix

'' Subtract two matrices (left - right)
'' C2T-NOTE(inline) raymath.h:1656 -- inline: links only if the library exports 'MatrixSubtract'
declare function MatrixSubtract( byval left_ as Matrix, byval right_ as Matrix ) as Matrix

'' Get two matrix multiplication
'' NOTE: When multiplying matrices... the order matters!
'' C2T-NOTE(inline) raymath.h:1682 -- inline: links only if the library exports 'MatrixMultiply'
declare function MatrixMultiply( byval left_ as Matrix, byval right_ as Matrix ) as Matrix

'' Multiply matrix components by value
'' C2T-NOTE(inline) raymath.h:1765 -- inline: links only if the library exports 'MatrixMultiplyValue'
declare function MatrixMultiplyValue( byval left_ as Matrix, byval value as float32 ) as Matrix

'' Get translation matrix
'' C2T-NOTE(inline) raymath.h:1778 -- inline: links only if the library exports 'MatrixTranslate'
declare function MatrixTranslate( byval x as float32, byval y as float32, byval z as float32 ) as Matrix

'' Create rotation matrix from axis and angle
'' NOTE: Angle should be provided in radians
'' C2T-NOTE(inline) raymath.h:1790 -- inline: links only if the library exports 'MatrixRotate'
declare function MatrixRotate( byval axis as Vector3, byval angle as float32 ) as Matrix

'' Get x-rotation matrix
'' NOTE: Angle must be provided in radians
'' C2T-NOTE(inline) raymath.h:1835 -- inline: links only if the library exports 'MatrixRotateX'
declare function MatrixRotateX( byval angle as float32 ) as Matrix

'' Get y-rotation matrix
'' NOTE: Angle must be provided in radians
'' C2T-NOTE(inline) raymath.h:1855 -- inline: links only if the library exports 'MatrixRotateY'
declare function MatrixRotateY( byval angle as float32 ) as Matrix

'' Get z-rotation matrix
'' NOTE: Angle must be provided in radians
'' C2T-NOTE(inline) raymath.h:1875 -- inline: links only if the library exports 'MatrixRotateZ'
declare function MatrixRotateZ( byval angle as float32 ) as Matrix


'' Get xyz-rotation matrix
'' NOTE: Angle must be provided in radians
'' C2T-NOTE(inline) raymath.h:1896 -- inline: links only if the library exports 'MatrixRotateXYZ'
declare function MatrixRotateXYZ( byval angle as Vector3 ) as Matrix

'' Get zyx-rotation matrix
'' NOTE: Angle must be provided in radians
'' C2T-NOTE(inline) raymath.h:1927 -- inline: links only if the library exports 'MatrixRotateZYX'
declare function MatrixRotateZYX( byval angle as Vector3 ) as Matrix

'' Get scaling matrix
'' C2T-NOTE(inline) raymath.h:1962 -- inline: links only if the library exports 'MatrixScale'
declare function MatrixScale( byval x as float32, byval y as float32, byval z as float32 ) as Matrix

'' Get perspective projection matrix
'' C2T-NOTE(inline) raymath.h:1973 -- inline: links only if the library exports 'MatrixFrustum'
declare function MatrixFrustum( byval left_ as float64, byval right_ as float64, byval bottom as float64, byval top as float64, byval nearPlane as float64, byval farPlane as float64 ) as Matrix

'' Get perspective projection matrix
'' NOTE: Fovy angle must be provided in radians
'' C2T-NOTE(inline) raymath.h:2006 -- inline: links only if the library exports 'MatrixPerspective'
declare function MatrixPerspective( byval fovY as float64, byval aspect as float64, byval nearPlane as float64, byval farPlane as float64 ) as Matrix

'' Get orthographic projection matrix
'' C2T-NOTE(inline) raymath.h:2032 -- inline: links only if the library exports 'MatrixOrtho'
declare function MatrixOrtho( byval left_ as float64, byval right_ as float64, byval bottom as float64, byval top as float64, byval nearPlane as float64, byval farPlane as float64 ) as Matrix

'' Get camera look-at matrix (view matrix)
'' C2T-NOTE(inline) raymath.h:2061 -- inline: links only if the library exports 'MatrixLookAt'
declare function MatrixLookAt( byval eye as Vector3, byval target as Vector3, byval up as Vector3 ) as Matrix

'' Get float array of matrix data
'' C2T-NOTE(inline) raymath.h:2116 -- inline: links only if the library exports 'MatrixToFloatV'
declare function MatrixToFloatV( byval mat as Matrix ) as float16

''----------------------------------------------------------------------------------
'' Module Functions Definition - Quaternion math
''----------------------------------------------------------------------------------

'' Add two quaternions
'' C2T-NOTE(inline) raymath.h:2145 -- inline: links only if the library exports 'QuaternionAdd'
declare function QuaternionAdd( byval q1 as Quaternion, byval q2 as Quaternion ) as Quaternion

'' Add quaternion and float value
'' C2T-NOTE(inline) raymath.h:2153 -- inline: links only if the library exports 'QuaternionAddValue'
declare function QuaternionAddValue( byval q as Quaternion, byval add as float32 ) as Quaternion

'' Subtract two quaternions
'' C2T-NOTE(inline) raymath.h:2161 -- inline: links only if the library exports 'QuaternionSubtract'
declare function QuaternionSubtract( byval q1 as Quaternion, byval q2 as Quaternion ) as Quaternion

'' Subtract quaternion and float value
'' C2T-NOTE(inline) raymath.h:2169 -- inline: links only if the library exports 'QuaternionSubtractValue'
declare function QuaternionSubtractValue( byval q as Quaternion, byval sub_ as float32 ) as Quaternion

'' Get identity quaternion
'' C2T-NOTE(inline) raymath.h:2177 -- inline: links only if the library exports 'QuaternionIdentity'
declare function QuaternionIdentity( ) as Quaternion

'' Computes the length of a quaternion
'' C2T-NOTE(inline) raymath.h:2185 -- inline: links only if the library exports 'QuaternionLength'
declare function QuaternionLength( byval q as Quaternion ) as float32

'' Normalize provided quaternion
'' C2T-NOTE(inline) raymath.h:2193 -- inline: links only if the library exports 'QuaternionNormalize'
declare function QuaternionNormalize( byval q as Quaternion ) as Quaternion

'' Invert provided quaternion
'' C2T-NOTE(inline) raymath.h:2210 -- inline: links only if the library exports 'QuaternionInvert'
declare function QuaternionInvert( byval q as Quaternion ) as Quaternion

'' Calculate two quaternion multiplication
'' C2T-NOTE(inline) raymath.h:2230 -- inline: links only if the library exports 'QuaternionMultiply'
declare function QuaternionMultiply( byval q1 as Quaternion, byval q2 as Quaternion ) as Quaternion

'' Scale quaternion by float value
'' C2T-NOTE(inline) raymath.h:2246 -- inline: links only if the library exports 'QuaternionScale'
declare function QuaternionScale( byval q as Quaternion, byval mul as float32 ) as Quaternion

'' Divide two quaternions
'' C2T-NOTE(inline) raymath.h:2259 -- inline: links only if the library exports 'QuaternionDivide'
declare function QuaternionDivide( byval q1 as Quaternion, byval q2 as Quaternion ) as Quaternion

'' Calculate linear interpolation between two quaternions
'' C2T-NOTE(inline) raymath.h:2267 -- inline: links only if the library exports 'QuaternionLerp'
declare function QuaternionLerp( byval q1 as Quaternion, byval q2 as Quaternion, byval amount as float32 ) as Quaternion

'' Calculate slerp-optimized interpolation between two quaternions
'' C2T-NOTE(inline) raymath.h:2280 -- inline: links only if the library exports 'QuaternionNlerp'
declare function QuaternionNlerp( byval q1 as Quaternion, byval q2 as Quaternion, byval amount as float32 ) as Quaternion

'' Calculates spherical linear interpolation between two quaternions
'' C2T-NOTE(inline) raymath.h:2305 -- inline: links only if the library exports 'QuaternionSlerp'
declare function QuaternionSlerp( byval q1 as Quaternion, byval q2 as Quaternion, byval amount as float32 ) as Quaternion

'' Calculate quaternion cubic spline interpolation using Cubic Hermite Spline algorithm
'' as described in the GLTF 2.0 specification: https://registry.khronos.org/glTF/specs/2.0/glTF-2.0.html#interpolation-cubic
'' C2T-NOTE(inline) raymath.h:2352 -- inline: links only if the library exports 'QuaternionCubicHermiteSpline'
declare function QuaternionCubicHermiteSpline( byval q1 as Quaternion, byval outTangent1 as Quaternion, byval q2 as Quaternion, byval inTangent2 as Quaternion, byval t as float32 ) as Quaternion

'' Calculate quaternion based on the rotation from one vector to another
'' C2T-NOTE(inline) raymath.h:2377 -- inline: links only if the library exports 'QuaternionFromVector3ToVector3'
declare function QuaternionFromVector3ToVector3( byval from as Vector3, byval to_ as Vector3 ) as Quaternion

'' Get a quaternion for a given rotation matrix
'' C2T-NOTE(inline) raymath.h:2426 -- inline: links only if the library exports 'QuaternionFromMatrix'
declare function QuaternionFromMatrix( byval mat as Matrix ) as Quaternion

'' Get a matrix for a given quaternion
'' C2T-NOTE(inline) raymath.h:2490 -- inline: links only if the library exports 'QuaternionToMatrix'
declare function QuaternionToMatrix( byval q as Quaternion ) as Matrix

'' Get rotation quaternion for an angle and axis
'' NOTE: Angle must be provided in radians
'' C2T-NOTE(inline) raymath.h:2524 -- inline: links only if the library exports 'QuaternionFromAxisAngle'
declare function QuaternionFromAxisAngle( byval axis as Vector3, byval angle as float32 ) as Quaternion

'' Get the rotation angle and axis for a given quaternion
'' C2T-NOTE(inline) raymath.h:2563 -- inline: links only if the library exports 'QuaternionToAxisAngle'
declare sub QuaternionToAxisAngle( byval q as Quaternion, byval outAxis as Vector3 ptr, byval outAngle as float32 ptr )

'' Get the quaternion equivalent to Euler angles
'' NOTE: Rotation order is ZYX
'' C2T-NOTE(inline) raymath.h:2601 -- inline: links only if the library exports 'QuaternionFromEuler'
declare function QuaternionFromEuler( byval pitch as float32, byval yaw as float32, byval roll as float32 ) as Quaternion

'' Get the Euler angles equivalent to quaternion (roll, pitch, yaw)
'' NOTE: Angles are returned in a Vector3 struct in radians
'' C2T-NOTE(inline) raymath.h:2622 -- inline: links only if the library exports 'QuaternionToEuler'
declare function QuaternionToEuler( byval q as Quaternion ) as Vector3

'' Transform a quaternion given a transformation matrix
'' C2T-NOTE(inline) raymath.h:2646 -- inline: links only if the library exports 'QuaternionTransform'
declare function QuaternionTransform( byval q as Quaternion, byval mat as Matrix ) as Quaternion

'' Check whether two given quaternions are almost equal
'' C2T-NOTE(inline) raymath.h:2659 -- inline: links only if the library exports 'QuaternionEquals'
declare function QuaternionEquals( byval p as Quaternion, byval q as Quaternion ) as int32

'' Compose a transformation matrix from rotational, translational and scaling components
'' C2T-NOTE(inline) raymath.h:2678 -- inline: links only if the library exports 'MatrixCompose'
declare function MatrixCompose( byval translation as Vector3, byval rotation as Quaternion, byval scale as Vector3 ) as Matrix

'' Decompose a transformation matrix into its rotational, translational and scaling components and remove shear
'' TODO: WARNING: Following raymath convention and make the function self-contained
'' C2T-NOTE(inline) raymath.h:2731 -- inline: links only if the library exports 'MatrixDecompose'
declare sub MatrixDecompose( byval mat as Matrix, byval translation as Vector3 ptr, byval rotation as Quaternion ptr, byval scale as Vector3 ptr )

