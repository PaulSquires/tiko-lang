'' Vectors dot product
'' C2T-NOTE(inline) raymath.h:1343 -- inline: links only if the library exports 'Vector4DotProduct'
declare function Vector4DotProduct( byval v1 as Vector4, byval v2 as Vector4 ) as float32

'' Calculate distance between two vectors
'' C2T-NOTE(inline) raymath.h:1350 -- inline: links only if the library exports 'Vector4Distance'
declare function Vector4Distance( byval v1 as Vector4, byval v2 as Vector4 ) as float32

'' Calculate square distance between two vectors
'' C2T-NOTE(inline) raymath.h:1359 -- inline: links only if the library exports 'Vector4DistanceSqr'
declare function Vector4DistanceSqr( byval v1 as Vector4, byval v2 as Vector4 ) as float32

'' Scale vector components by value (multiply)
'' C2T-NOTE(inline) raymath.h:1369 -- inline: links only if the library exports 'Vector4Scale'
