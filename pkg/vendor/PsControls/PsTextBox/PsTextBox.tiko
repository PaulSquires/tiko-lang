#module "PsTextBox"

#import "sys/win"
#import "sys/win/gui"
#import "sys/win/gdiplus"
#import "sys/win/richedit"
#import "vendor/PsControls/PsBufferPaint"
#import "vendor/PsControls/PsPopupMenu"
#import "vendor/PsControls/PsRegistry"
#import "vendor/PsControls/PsTheme"

using gui
using gdiplus
using richedit
using PsBufferPaint
using PsPopupMenu
using PsRegistry
using PsTheme

#include once "vbcompat.bi"                 ' format() -- numeric mode formatting
' The built-in context menu is a PsPopupMenu (the vendor/PsControls/PsPopupMenu module,
' imported above). This is the control family's owner-drawn floating menu -- using it instead of
' TrackPopupMenu is what makes the textbox's right-click menu themeable and consistent
' with the rest of an app's menus. It brings a MESSAGE-PUMP OBLIGATION with it: see
' PsTextBox_FilterMessage below.
' The RichEdit helpers the implementation uses (richedit.RichEdit.GetText, GetSelText,
' CanPaste, ...) and win/richedit.bi's CHARFORMATW, EM_CANPASTE, ... come from sys/win/richedit,
' which this module imports itself (above). Prefer them over re-rolled SendMessage.

public type PSTEXTBOX_MESSAGEINFO
    hTextBox        as HWND       ' the CONTROL (container) handle, not the RichEdit child
    uMsg            as UINT
    wParam          as WPARAM
    lParam          as LPARAM
end type

' Fired after the text changed from USER interaction (typing, cut/paste, undo). Never
' fired for programmatic changes (SetText/ReplaceSel/Clear or a forwarded WM_SETTEXT):
' programmatic setters are silent, only user interaction notifies -- the same split the
' sibling controls apply, and it lets a host call a setter from inside its own handler
' without re-entrancy.
public type TXT_ChangeCallbackSub as sub( byval hTextBox as HWND )

' Fired when the RichEdit child gains (bGotFocus = true) or loses (false) the keyboard
' focus. The control has already invalidated itself for the border color switch.
public type TXT_FocusCallbackSub as sub( byval hTextBox as HWND, byval bGotFocus as boolean )

' Fired when the user presses ENTER in the textbox. The keypress itself is always
' swallowed (no newline, no beep). SINGLE-LINE ONLY: in a multiline control ENTER
' inserts a newline and this callback never fires.
public type TXT_EnterPressedCallbackSub as sub( byval hTextBox as HWND )

' Fired whenever the vertical scroll state MAY have changed (relayed from the RichEdit's
' EN_UPDATE, which fires on any display update: typing, programmatic SetText, scrolling
' by wheel/keys/caret). Multiline only; deliberately NOT gated like the ChangeCallback --
' a programmatic SetText changes the line count and a scrollbar must hear about it.
' Shaped for PsVScrollBar: on each fire call PsTextBox_GetVScrollInfo and push the three
' numbers into PsVScrollBar_SetRange( total, page, pos ); wire PsVScrollBar's
' ScrollCallback( newPos ) to PsTextBox_ScrollToLine.
public type TXT_ScrollChangedCallbackSub as sub( byval hTextBox as HWND )

' Observe key, mouse, focus and context-menu messages before the control acts on them.
' Return TRUE if you handled the message and want the control's default handling (and
' the RichEdit's own) suppressed, FALSE to let it proceed. The result is honored
' uniformly: the control takes no mouse capture, so there is no invariant a callback
' can strand by suppressing a message. CAUTION: suppressing WM_SETFOCUS/WM_KILLFOCUS
' also suppresses the RichEdit's own caret handling -- only do that on purpose.
' Vetoing WM_KEYDOWN for VK_TAB repurposes Tab (the control otherwise consumes it to
' move focus to the next/previous tab stop -- e.g. veto it to drive a picker list).
public type TXT_MessageCallbackFunc as function( byval m as PSTEXTBOX_MESSAGEINFO ptr ) as boolean


' Horizontal text alignment. LEFT is the default and is what every host had before this
' existed, so adding it changed nothing for any of them.
'
' These are the control's own constants rather than richedit.bi's PFA_* values, because the
' mapping is an implementation detail: a host should not have to know that alignment is
' delivered by EM_SETPARAFORMAT, any more than it has to know that the forecolor is
' delivered by EM_SETCHARFORMAT.
public enum
    TXT_ALIGN_LEFT = 0
    TXT_ALIGN_CENTER
    TXT_ALIGN_RIGHT
end enum


public type PSTEXTBOX_STATE
    hWin            as HWND
    ' TRUE once the host set the colours itself (the PsTextBox_Set*Color setters): the theme then
    ' leaves this textbox alone until PsTextBox_UnpinColors.
    bColorsPinned   as boolean
    hRichEdit       as HWND               ' the RichEdit50W child that does the editing
    idc_TextBox     as integer = 1000
    ' Multiline mode. Fixed at creation (ES_MULTILINE cannot be toggled on a live
    ' window): word-wrapped, ENTER inserts a newline, TAB inserts a tab character,
    ' no vertical text centering, numeric mode unavailable. The control adds no
    ' scrollbar styles -- pair it with an external scrollbar via the scroll API below.
    bMultiline      as boolean = false
    ' --- Colors. One forecolor/backcolor for ALL text (the control never colors
    '     individual characters; the child runs in TM_PLAINTEXT mode to guarantee it). ---
    ForeColor       as COLORREF = BGR(0,0,0)
    BackColor       as COLORREF = BGR(255,255,255)
    CueColor        as COLORREF = BGR(128,128,128)
    BorderColor     as COLORREF = BGR(122,122,122)
    FocusBorderColor as COLORREF = BGR(0,120,215)
    OuterBackColor  as COLORREF = BGR(255,255,255)  ' fills the pixels outside rounded corners
    nBorderWidth    as integer = 1        ' 0 = no border drawn
    nCornerRadius   as integer = 0        ' 0 = square corners
    nMarginLeft     as integer = 0        ' EM_SETMARGINS values, stored so they can be
    nMarginRight    as integer = 0        '   re-applied after font/geometry changes
    ' Horizontal alignment (TXT_ALIGN_*). LEFT is the RichEdit's own starting state, so a
    ' control whose host never calls PsTextBox_SetTextAlign never touches any of the
    ' machinery behind this field. Applying a non-default value is surprisingly expensive --
    ' see PsTextBox_ApplyParaFormat, which had to be built around TM_PLAINTEXT refusing
    ' EM_SETPARAFORMAT outright.
    nTextAlign      as long = TXT_ALIGN_LEFT
    ' Caller-supplied fonts (caller owns them; the control never deletes an HFONT).
    ' NOT named hFont: a member called hFont would shadow the HFONT type inside member
    ' procedures (FreeBASIC is case-insensitive).
    hTextFont       as HFONT              ' 0 = stock DEFAULT_GUI_FONT
    hCueFont        as HFONT              ' 0 = use hTextFont
    CueText         as ustring           ' drawn whenever the buffer is empty ("" = none)
    ' Built-in context menu labels; defaulted to Cut/Copy/Paste/Select All at Create,
    ' replace via PsTextBox_SetMenuText to localize.
    wszMenuCut       as ustring
    wszMenuCopy      as ustring
    wszMenuPaste     as ustring
    wszMenuSelectAll as ustring
    ' The context menu itself: one PsPopupMenu window per textbox, created at Create so a
    ' host can theme it immediately (PsTextBox_GetContextMenu), rebuilt from the current
    ' selection/clipboard/read-only state each time it opens, and destroyed with the
    ' control. Unlike the HMENU it replaces it is NOT modal -- the commands run from its
    ' select callback after it closes, not inline in WM_CONTEXTMENU.
    hContextMenu     as HWND
    ' Select the whole text when the control gains keyboard focus (Tab or programmatic
    ' SetFocus). A mouse click still places the caret at the click point: the click's
    ' own caret placement runs after the focus change and wins, by design.
    bSelectOnFocus  as boolean = false
    ' --- Numeric input mode: only digits, one leading minus and one decimal separator
    '     are accepted (typed OR pasted), with at most nDecimalPlaces fractional digits
    '     (0 = integers only). On focus loss a non-empty value is reformatted to exactly
    '     nDecimalPlaces (silently -- no ChangeCallback); empty stays empty so the cue
    '     banner can show -- unless bZeroWhenEmpty, which stamps the formatted zero
    '     ("0.00") instead, so the box always displays a value (and the cue banner
    '     effectively never shows once the box has been visited). ---
    bNumericOnly    as boolean = false
    nDecimalPlaces  as integer = 2
    bZeroWhenEmpty  as boolean = false
    ' TRUE while the control itself writes to the RichEdit; EN_CHANGE is dropped so
    ' programmatic changes never reach the ChangeCallback.
    bInternalChange as boolean = false
    ' Multiline wheel scrolling is implemented by the control (the RichEdit's own
    ' handling proved unreliable). High-precision wheels send deltas below one notch
    ' (120); the remainder accumulates here between events.
    nWheelAccum           as long = 0
    ChangeCallback        as TXT_ChangeCallbackSub
    FocusCallback         as TXT_FocusCallbackSub
    EnterPressedCallback  as TXT_EnterPressedCallbackSub
    MessageCallback       as TXT_MessageCallbackFunc
    ScrollChangedCallback as TXT_ScrollChangedCallbackSub
end type


' ----------------------------------------------------------------------------------------
' Creation.
' The returned handle is the control's real HWND: position it with SetWindowPos (include
' SWP_SHOWWINDOW -- the control is created hidden), find it with GetDlgItem(CtrlID). The
' RichEdit child is an implementation detail; reach it with PsTextBox_GetRichEditHandle
' only for RichEdit-specific messages the flat API (or the forwarded EM_ range, see
' below) does not cover.
'
' Every pixel value passed to this API (margins, border width, corner radius) is a RAW
' device pixel: DPI-scale at the call site (pWindow->ScaleX). The control never scales
' a caller's value -- margins go verbatim into EM_SETMARGINS, so a control-side scale
' would both lie to EM_GETMARGINS readers and double-scale hosts that already follow
' the sibling convention of scaling before the call.
'
' Message door: the container forwards the classic edit-control message range
' (EM_GETSEL .. EM_GETIMESTATUS) plus WM_SETTEXT / WM_GETTEXT / WM_GETTEXTLENGTH /
' WM_CUT / WM_COPY / WM_PASTE / WM_CLEAR / WM_UNDO to the RichEdit child, so
' SendMessage(hTextBox, EM_SETSEL, ...) works from a separate control or window. Same
' operation, two doors: message for a separate control, function for an in-process host.
' ----------------------------------------------------------------------------------------
' bMultiline is fixed for the control's lifetime (see the TYPE field comment). Multiline
' controls word-wrap (no ES_AUTOHSCROLL) and scroll vertically without showing a native
' scrollbar; drive an external one through the scroll API below.
public declare function PsTextBox_Create( byval hWndParent as HWND, byval CtrlID as integer, byval bMultiline as boolean = false ) as HWND
public declare function PsTextBox_GetRichEditHandle( byval hTextBoxControl as HWND ) as HWND
public declare function PsTextBox_GetMultiline( byval hTextBoxControl as HWND ) as boolean
' Does this textbox own the keyboard focus? Focus sits on the RichEdit child, so a
' plain GetFocus() = hTextBox comparison is ALWAYS false -- use this instead.
public declare function PsTextBox_HasFocus( byval hTextBoxControl as HWND ) as boolean

' ----------------------------------------------------------------------------------------
' Text.
' ----------------------------------------------------------------------------------------
public declare function PsTextBox_GetText( byval hTextBoxControl as HWND ) as ustring
public declare function PsTextBox_SetText( byval hTextBoxControl as HWND, byval Text as ustring ) as boolean
public declare function PsTextBox_GetTextLength( byval hTextBoxControl as HWND ) as integer
public declare function PsTextBox_GetSelText( byval hTextBoxControl as HWND ) as ustring
public declare function PsTextBox_ReplaceSel( byval hTextBoxControl as HWND, byval Text as ustring ) as boolean
public declare function PsTextBox_Clear( byval hTextBoxControl as HWND ) as boolean

' ----------------------------------------------------------------------------------------
' Selection. Positions are 0-based character indices; nEnd = -1 selects to the end.
' ----------------------------------------------------------------------------------------
public declare sub      PsTextBox_GetSel( byval hTextBoxControl as HWND, byref nStart as integer, byref nEnd as integer )
public declare sub      PsTextBox_SetSel( byval hTextBoxControl as HWND, byval nStart as integer, byval nEnd as integer )
public declare sub      PsTextBox_SelectAll( byval hTextBoxControl as HWND )

' ----------------------------------------------------------------------------------------
' Edit behavior.
' ----------------------------------------------------------------------------------------
public declare function PsTextBox_GetLimitText( byval hTextBoxControl as HWND ) as integer
public declare sub      PsTextBox_SetLimitText( byval hTextBoxControl as HWND, byval nLimit as integer )
public declare function PsTextBox_GetReadOnly( byval hTextBoxControl as HWND ) as boolean
public declare function PsTextBox_SetReadOnly( byval hTextBoxControl as HWND, byval bReadOnly as boolean ) as boolean
public declare function PsTextBox_GetModify( byval hTextBoxControl as HWND ) as boolean
public declare sub      PsTextBox_SetModify( byval hTextBoxControl as HWND, byval bModified as boolean )
public declare sub      PsTextBox_SetPasswordChar( byval hTextBoxControl as HWND, byval wchChar as integer )   ' 0 = off
' Select all text when the control gains keyboard focus (see the TYPE field comment:
' a mouse click still places the caret). Default false.
public declare function PsTextBox_GetSelectOnFocus( byval hTextBoxControl as HWND ) as boolean
public declare sub      PsTextBox_SetSelectOnFocus( byval hTextBoxControl as HWND, byval bSelect as boolean )
' Numeric input mode (see the TYPE field comment for the accepted grammar). DecimalPlaces
' 0 means integers only. GetValue/SetValue trade the text as a double; SetValue formats
' to DecimalPlaces and, like every programmatic setter, is silent. SINGLE-LINE ONLY:
' SetNumericMode is a no-op on a multiline control.
public declare function PsTextBox_GetNumericMode( byval hTextBoxControl as HWND ) as boolean
public declare sub      PsTextBox_SetNumericMode( byval hTextBoxControl as HWND, byval bEnable as boolean )
public declare function PsTextBox_GetDecimalPlaces( byval hTextBoxControl as HWND ) as integer
public declare sub      PsTextBox_SetDecimalPlaces( byval hTextBoxControl as HWND, byval nPlaces as integer )
public declare function PsTextBox_GetValue( byval hTextBoxControl as HWND ) as double
public declare function PsTextBox_SetValue( byval hTextBoxControl as HWND, byval nValue as double ) as boolean
' Numeric mode only: display the formatted zero ("0.00") instead of an empty box. The
' setter stamps it immediately when the box is currently empty and unfocused; after
' that, every focus loss with an empty buffer restores it. Trumps the cue banner.
public declare function PsTextBox_GetZeroWhenEmpty( byval hTextBoxControl as HWND ) as boolean
public declare sub      PsTextBox_SetZeroWhenEmpty( byval hTextBoxControl as HWND, byval bEnable as boolean )
public declare sub      PsTextBox_Cut( byval hTextBoxControl as HWND )
public declare sub      PsTextBox_Copy( byval hTextBoxControl as HWND )
public declare sub      PsTextBox_Paste( byval hTextBoxControl as HWND )
public declare function PsTextBox_CanPaste( byval hTextBoxControl as HWND ) as boolean
public declare function PsTextBox_Undo( byval hTextBoxControl as HWND ) as boolean
public declare function PsTextBox_CanUndo( byval hTextBoxControl as HWND ) as boolean
' Left/right margins between the border and the text, in pixels (EM_SETMARGINS).
public declare sub      PsTextBox_GetMargins( byval hTextBoxControl as HWND, byref nLeft as integer, byref nRight as integer )
public declare sub      PsTextBox_SetMargins( byval hTextBoxControl as HWND, byval nLeft as integer, byval nRight as integer )

' ----------------------------------------------------------------------------------------
' Vertical scroll state (multiline). Units are LINES, shaped 1:1 for PsVScrollBar:
' ScrollChangedCallback fires -> GetVScrollInfo -> PsVScrollBar_SetRange( total, page, pos );
' PsVScrollBar's ScrollCallback( newPos ) -> ScrollToLine( newPos ). LinesPerPage derives
' from the formatting-rect height and the text font's line height -- a partial line at the
' bottom is not counted. Single-line controls report total=1, page=0/1, first=0.
' ----------------------------------------------------------------------------------------
public declare sub      PsTextBox_GetVScrollInfo( byval hTextBoxControl as HWND, byref nTotalLines as integer, byref nLinesPerPage as integer, byref nFirstVisibleLine as integer )
' Scroll so nLine (0-based) becomes the first visible line. The RichEdit clamps overscroll.
public declare sub      PsTextBox_ScrollToLine( byval hTextBoxControl as HWND, byval nLine as integer )

' ----------------------------------------------------------------------------------------
' Appearance. All fonts are caller-owned HFONTs; the control converts the text font to a
' CHARFORMATW internally (face/size/charset/bold/italic + ForeColor) and re-applies it
' whenever the font or forecolor changes.
' ----------------------------------------------------------------------------------------
public declare function PsTextBox_GetFont( byval hTextBoxControl as HWND ) as HFONT
public declare function PsTextBox_SetFont( byval hTextBoxControl as HWND, byval hFont as HFONT ) as boolean
public declare function PsTextBox_GetForeColor( byval hTextBoxControl as HWND ) as COLORREF
public declare function PsTextBox_SetForeColor( byval hTextBoxControl as HWND, byval clr as COLORREF ) as COLORREF
public declare function PsTextBox_GetBackColor( byval hTextBoxControl as HWND ) as COLORREF
public declare function PsTextBox_SetBackColor( byval hTextBoxControl as HWND, byval clr as COLORREF ) as COLORREF
' Cue banner: drawn whenever the buffer is empty, focused or not (the caret blinks over
' it). Its color is independent of the text ForeColor; its font defaults to the text font.
public declare function PsTextBox_GetCueBannerText( byval hTextBoxControl as HWND ) as ustring
public declare sub      PsTextBox_SetCueBannerText( byval hTextBoxControl as HWND, byval Text as ustring )
public declare function PsTextBox_GetCueBannerColor( byval hTextBoxControl as HWND ) as COLORREF
public declare sub      PsTextBox_SetCueBannerColor( byval hTextBoxControl as HWND, byval clr as COLORREF )
public declare function PsTextBox_GetCueBannerFont( byval hTextBoxControl as HWND ) as HFONT
public declare sub      PsTextBox_SetCueBannerFont( byval hTextBoxControl as HWND, byval hFont as HFONT )
' Horizontal alignment of the text (TXT_ALIGN_LEFT / CENTER / RIGHT; LEFT is the default,
' so this changed nothing for hosts written before it existed). It applies to the whole
' buffer, in both line modes, and it survives every subsequent SetText.
'
' SET IT AT SETUP TIME, BEFORE THE CONTROL HAS CONTENT. This is not a style preference:
' TM_PLAINTEXT -- which this control relies on for uniform formatting and for making pasted
' text shed its rich formatting -- REFUSES EM_SETPARAFORMAT outright, silently, returning
' failure and leaving the alignment at LEFT. The only sequence the RichEdit accepts is to
' empty the buffer, flip to rich-text mode, apply, and flip back, so the setter does exactly
' that. On an empty control that costs nothing. On a control the user has been typing into
' IT DISCARDS THE UNDO HISTORY, which is the whole reason to set it early.
'
' The margins set by PsTextBox_SetMargins still apply -- centring happens between them, not
' between the border edges, so a centred value in a control with lopsided margins sits
' off-centre by design. Give it equal margins if you want it optically centred.
public declare function PsTextBox_GetTextAlign( byval hTextBoxControl as HWND ) as long
public declare sub      PsTextBox_SetTextAlign( byval hTextBoxControl as HWND, byval nAlign as long )
' Border chrome. Width 0 = borderless; the border color switches to FocusBorderColor
' while the RichEdit has focus. CornerRadius rounds the frame -- the arcs are
' antialiased now, so a larger radius no longer looks stepped the way it did under
' GDI's RoundRect. OuterBackColor fills the pixels outside the corner arcs -- pass the
' host's background color so rounded corners blend into it.
public declare function PsTextBox_GetBorderColor( byval hTextBoxControl as HWND ) as COLORREF
public declare sub      PsTextBox_SetBorderColor( byval hTextBoxControl as HWND, byval clr as COLORREF )
public declare function PsTextBox_GetFocusBorderColor( byval hTextBoxControl as HWND ) as COLORREF
public declare sub      PsTextBox_SetFocusBorderColor( byval hTextBoxControl as HWND, byval clr as COLORREF )
public declare function PsTextBox_GetBorderWidth( byval hTextBoxControl as HWND ) as integer
public declare sub      PsTextBox_SetBorderWidth( byval hTextBoxControl as HWND, byval nWidth as integer )
public declare function PsTextBox_GetCornerRadius( byval hTextBoxControl as HWND ) as integer
public declare sub      PsTextBox_SetCornerRadius( byval hTextBoxControl as HWND, byval nRadius as integer )
public declare function PsTextBox_GetOuterBackColor( byval hTextBoxControl as HWND ) as COLORREF
public declare sub      PsTextBox_SetOuterBackColor( byval hTextBoxControl as HWND, byval clr as COLORREF )
public declare sub      PsTextBox_ApplyTheme( byval hTextBoxControl as HWND, byref t as PSTHEME_COLORS )
public declare sub      PsTextBox_UnpinColors( byval hTextBoxControl as HWND )
public declare sub      PsTextBox_ApplyFonts( byval hTextBoxControl as HWND, byval hTextFont as HFONT, byval hGlyphFont as HFONT )
public declare sub      PsTextBox_Rescale( byval hTextBoxControl as HWND, byval oldDpi as long, byval newDpi as long )
' Localize the built-in right-click menu (Cut/Copy/Paste/Select All). An empty
' SelectAllText keeps the current Select All label, so 3-argument callers are unaffected.
public declare sub      PsTextBox_SetMenuText( byval hTextBoxControl as HWND, byval CutText as ustring, byval CopyText as ustring, byval PasteText as ustring, byval SelectAllText as ustring = "" )

' ----------------------------------------------------------------------------------------
' THE BUILT-IN CONTEXT MENU (Cut / Copy / Paste / Select All)
'
' It is a PsPopupMenu window owned by the control, created at Create and destroyed with it.
' Two consequences a host has to know about:
'
' 1. THE MESSAGE-PUMP OBLIGATION (not optional). A PsPopupMenu is not modal: keyboard
'    navigation and click-outside dismissal live in its message filter. A host that never
'    calls PsTextBox_FilterMessage gets a right-click menu that opens and paints but cannot
'    be driven from the keyboard and never closes on an outside click:
'        do while GetMessage(@uMsg, null, 0, 0)
'            if PsTextBox_FilterMessage( @uMsg ) then continue do
'            ...TranslateMessage/DispatchMessage...
'    One call serves every PsTextBox in the application -- only one menu chain can be open
'    at a time, and the filter finds it. (An app that also hosts PsMenuBar calls that
'    filter too; the two are independent and each stands down when the other's menu is up.)
'
' 2. STYLING IS YOURS. GetContextMenu hands back the popup so the usual PsPopupMenu setters
'    (SetColors / SetFonts / SetGlyphs / SetItemHeight) apply -- point them at the same
'    values the rest of your menus use and the textbox menu matches them. Left alone it
'    renders with PsPopupMenu's own defaults. The handle is stable for the control's
'    lifetime, so theming it once at startup is enough; the labels are rebuilt per open
'    but colors and fonts are not.
' ----------------------------------------------------------------------------------------
' CloseContextMenu dismisses an open menu from any PsTextBox. SILENT (no select callback),
' matching the family's programmatic-setter rule. For hosts with a global "close every
' menu" moment -- app deactivation, or a modal dialog about to open.
public declare function PsTextBox_GetContextMenu( byval hTextBoxControl as HWND ) as HWND
public declare function PsTextBox_FilterMessage( byval pMsg as MSG ptr ) as boolean
public declare sub      PsTextBox_CloseContextMenu()

' ----------------------------------------------------------------------------------------
' Callbacks. See the type declarations above for each signature and contract.
'   ChangeCallback        - text changed by USER interaction (programmatic changes silent).
'   FocusCallback         - RichEdit gained/lost keyboard focus.
'   EnterPressedCallback  - ENTER pressed (single-line only; keypress always swallowed).
'   MessageCallback       - observe key/mouse/focus/context-menu messages; TRUE suppresses.
'   ScrollChangedCallback - vertical scroll state may have changed (multiline only).
' ----------------------------------------------------------------------------------------
public declare sub      PsTextBox_SetChangeCallback( byval hTextBoxControl as HWND, byval usersub as TXT_ChangeCallbackSub )
public declare sub      PsTextBox_SetFocusCallback( byval hTextBoxControl as HWND, byval usersub as TXT_FocusCallbackSub )
public declare sub      PsTextBox_SetEnterPressedCallback( byval hTextBoxControl as HWND, byval usersub as TXT_EnterPressedCallbackSub )
public declare sub      PsTextBox_SetMessageCallback( byval hTextBoxControl as HWND, byval userfunc as TXT_MessageCallbackFunc )
public declare sub      PsTextBox_SetScrollChangedCallback( byval hTextBoxControl as HWND, byval usersub as TXT_ScrollChangedCallbackSub )

function GetTextBoxPointer( byval hTextBoxControl as HWND ) as PSTEXTBOX_STATE ptr
    dim pWindow as CWindow ptr = CWindowPtr(hTextBoxControl)
    dim as PSTEXTBOX_STATE ptr pTextBox = null
    if pWindow then pTextBox = cast( PSTEXTBOX_STATE ptr, pWindow->UserData(0) )
    return pTextBox
end function


' ========================================================================================
' THE BUILT-IN CONTEXT MENU
'
' Replaces the CreatePopupMenu/TrackPopupMenu block that used to sit inline in the
' RichEdit subclass. The visible win is a themeable menu that matches the rest of the
' family; the structural cost is that PsPopupMenu is NOT modal. TrackPopupMenu returned
' the chosen id, so cut/copy/paste ran in the same stack frame as WM_CONTEXTMENU; now
' Show returns immediately and the command runs later, from the select callback.
'
' The callback signature carries no user data, so the target RichEdit is parked here at
' show time. Safe because PsPopupMenu enforces ONE open chain per application: a second
' textbox's menu closes the first, and a closed menu never fires a select.
' ========================================================================================
dim shared as HWND gTB_ContextMenuTarget   ' RichEdit whose menu is currently open

' Item ids. Local to this menu (they never leave the control), 1-based because 0 is
' PsPopupMenu's separator marker.
#define PSTEXTBOX_IDM_CUT         1
#define PSTEXTBOX_IDM_COPY        2
#define PSTEXTBOX_IDM_PASTE       3
#define PSTEXTBOX_IDM_SELECTALL   4

private sub PsTextBox_ContextMenuSelect( byval hPopup as HWND, byval id as long )
    dim as HWND hWin = gTB_ContextMenuTarget
    if hWin = 0 then exit sub
    if IsWindow( hWin ) = 0 then exit sub
    select case id
        case PSTEXTBOX_IDM_CUT:       SendMessage( hWin, WM_CUT, 0, 0 )
        case PSTEXTBOX_IDM_COPY:      SendMessage( hWin, WM_COPY, 0, 0 )
        case PSTEXTBOX_IDM_PASTE:     SendMessage( hWin, WM_PASTE, 0, 0 )
        case PSTEXTBOX_IDM_SELECTALL: SendMessage( hWin, EM_SETSEL, 0, -1 )
    end select
end sub

' Rebuild from the current selection / clipboard / read-only state and show at the
' cursor (which also covers the keyboard menu key well enough). An empty menu -- nothing
' selected, nothing to paste, no text -- shows nothing at all, as before.
private sub PsTextBox_ShowContextMenu( byval pTextBox as PSTEXTBOX_STATE ptr )
    if pTextBox = null then exit sub
    if pTextBox->hContextMenu = 0 then exit sub

    dim as HWND hWin = pTextBox->hRichEdit
    dim as HWND hPopup = pTextBox->hContextMenu
    dim as boolean bReadOnly = ( (GetWindowLongPtr(hWin, GWL_STYLE) and ES_READONLY) <> 0 )
    dim as ustring wszSelText = richedit.RichEdit.GetSelText( hWin )
    dim as boolean bHasSel = (len(wszSelText) > 0)

    PsPopupMenu_Clear( hPopup )

    if bHasSel andalso (bReadOnly = false) then
        PsPopupMenu_AddItem( hPopup, PSTEXTBOX_IDM_CUT, pTextBox->wszMenuCut )
    end if
    if bHasSel then
        PsPopupMenu_AddItem( hPopup, PSTEXTBOX_IDM_COPY, pTextBox->wszMenuCopy )
    end if
    if (richedit.RichEdit.CanPaste(hWin, 0) <> 0) andalso (bReadOnly = false) then
        if PsPopupMenu_GetItemCount(hPopup) > 0 then PsPopupMenu_AddSeparator( hPopup )
        PsPopupMenu_AddItem( hPopup, PSTEXTBOX_IDM_PASTE, pTextBox->wszMenuPaste )
    end if
    ' Select All: offered whenever the control holds any text (read-only included --
    ' selecting is always allowed).
    if GetWindowTextLength(hWin) > 0 then
        if PsPopupMenu_GetItemCount(hPopup) > 0 then PsPopupMenu_AddSeparator( hPopup )
        PsPopupMenu_AddItem( hPopup, PSTEXTBOX_IDM_SELECTALL, pTextBox->wszMenuSelectAll )
    end if

    if PsPopupMenu_GetItemCount(hPopup) = 0 then exit sub

    dim as POINT pt
    GetCursorPos( @pt )
    gTB_ContextMenuTarget = hWin
    PsPopupMenu_Show( hPopup, pt.x, pt.y )
end sub


' ========================================================================================
' The context menu's public surface. See the contract block at the top of this file -- the filter
' is an OBLIGATION on the host's message pump, not an optional extra.
' ========================================================================================
function PsTextBox_GetContextMenu( byval hTextBoxControl as HWND ) as HWND
    dim as PSTEXTBOX_STATE ptr pTextBox = GetTextBoxPointer(hTextBoxControl)
    if pTextBox = null then return 0
    return pTextBox->hContextMenu
end function

' Resolve the popup of whichever textbox last opened its menu (0 if none). Both the
' filter and the close path need it.
private function PsTextBox_OpenContextMenu() as HWND
    if gTB_ContextMenuTarget = 0 then return 0
    if IsWindow( gTB_ContextMenuTarget ) = 0 then
        gTB_ContextMenuTarget = 0
        return 0
    end if
    dim as PSTEXTBOX_STATE ptr pTextBox = GetTextBoxPointer( GetParent(gTB_ContextMenuTarget) )
    if pTextBox = null then return 0
    return pTextBox->hContextMenu
end function

public function PsTextBox_FilterMessage( byval pMsg as MSG ptr ) as boolean
    ' One call serves every PsTextBox: only one chain can be open, and the last-shown
    ' target identifies it. PsPopupMenu_FilterMessage is self-guarding -- it stands down
    ' unless the handle really is in the currently open chain -- so a stale handle here
    ' costs one comparison and nothing else.
    dim as HWND hPopup = PsTextBox_OpenContextMenu()
    if hPopup = 0 then return false
    return PsPopupMenu_FilterMessage( hPopup, pMsg )
end function

sub PsTextBox_CloseContextMenu()
    dim as HWND hPopup = PsTextBox_OpenContextMenu()
    if hPopup then PsPopupMenu_CloseChain( hPopup )
    gTB_ContextMenuTarget = 0
end sub


' ========================================================================================
' Convert the caller's HFONT (or the stock DEFAULT_GUI_FONT) plus ForeColor into a
' CHARFORMATW and apply it to the WHOLE buffer. This is the only place character
' formatting is produced; SCF_ALL plus TM_PLAINTEXT mode keeps the entire buffer in
' this one format -- the control never colors individual characters.
' ========================================================================================
private sub PsTextBox_ApplyCharFormat( byval pTextBox as PSTEXTBOX_STATE ptr )
    if pTextBox = null then exit sub
    if pTextBox->hRichEdit = 0 then exit sub

    dim as HFONT hFontUse = pTextBox->hTextFont
    if hFontUse = 0 then hFontUse = cast( HFONT, GetStockObject(DEFAULT_GUI_FONT) )
    dim as LOGFONTW lf
    if GetObjectW( hFontUse, sizeof(LOGFONTW), @lf ) = 0 then exit sub

    ' lfHeight is negative for character height (the usual CreateFont case); a positive
    ' value is cell height, for which the point size below is a close approximation.
    dim as HDC hdc = GetDC( pTextBox->hRichEdit )
    dim as integer dpiY = GetDeviceCaps( hdc, LOGPIXELSY )
    ReleaseDC( pTextBox->hRichEdit, hdc )
    dim as integer pointSize = MulDiv( abs(lf.lfHeight), 72, dpiY )

    dim cf as CHARFORMATW
    cf.cbSize = sizeof(cf)
    cf.dwMask = CFM_FACE or CFM_SIZE or CFM_CHARSET or CFM_COLOR or _
                CFM_BOLD or CFM_ITALIC or CFM_UNDERLINE or CFM_STRIKEOUT
    cf.crTextColor = pTextBox->ForeColor
    cf.yHeight = pointSize * 20               ' twips (1/20 pt)
    cf.bCharSet = lf.lfCharSet
    cf.bPitchAndFamily = lf.lfPitchAndFamily
    cf.szFaceName = lf.lfFaceName
    if lf.lfWeight >= FW_BOLD then cf.dwEffects or= CFE_BOLD
    if lf.lfItalic then cf.dwEffects or= CFE_ITALIC
    if lf.lfUnderline then cf.dwEffects or= CFE_UNDERLINE
    if lf.lfStrikeOut then cf.dwEffects or= CFE_STRIKEOUT
    SendMessage( pTextBox->hRichEdit, EM_SETCHARFORMAT, SCF_ALL, cast(LPARAM, @cf) )
end sub


' ========================================================================================
' Apply the stored horizontal alignment to the buffer.
'
' The paragraph-format counterpart to PsTextBox_ApplyCharFormat above, and the only place
' alignment is produced. It is NOT called at Create: the RichEdit already starts left-aligned,
' so a control whose host never asks for anything else never runs a line of this.
'
' ---------------------------------------------------------------------------------------
' WHY IT LOOKS LIKE THIS. The obvious implementation -- send EM_SETPARAFORMAT and be done --
' DOES NOT WORK IN THIS CONTROL, and it fails silently, which is the dangerous part.
'
' MEASURED, not reasoned about (the harness probe that found it is in this repo's history):
'
'   EM_SETPARAFORMAT under TM_PLAINTEXT returns 0 -- failure -- EVERY time. In both line
'   modes. With a selection and without one. With the buffer empty and with content. The
'   paragraph format simply stays PFA_LEFT and nothing anywhere reports a problem.
'
'   The same message sent while the control is in TM_RICHTEXT returns 1 and takes effect --
'   AND the resulting format SURVIVES the switch back to TM_PLAINTEXT, and survives every
'   subsequent WM_SETTEXT.
'
' TM_PLAINTEXT is not negotiable here: it is what keeps one character format across the whole
' buffer and what makes pasted text shed its rich formatting. So the alignment is applied in
' the only window where the control will accept it -- the buffer has to be empty to change
' text mode at all, so: save, clear, flip to rich, apply, flip back, restore.
'
' THE COST, stated plainly: the undo history does not survive. Called at setup time -- which
' is when a host sets alignment, and when the buffer is empty anyway -- it costs nothing at
' all. Called on a control the user has been typing into, it costs them their undo stack.
' That is why PsTextBox_SetTextAlign says so in its own comment.
'
' Multiline with several paragraphs relies on inheritance: the restored text is typed into
' the one formatted paragraph, and each new paragraph inherits the preceding one's format.
' The harness asserts this on a real multiline control rather than trusting it.
' ========================================================================================
private sub PsTextBox_ApplyParaFormat( byval pTextBox as PSTEXTBOX_STATE ptr )
    if pTextBox = null then exit sub
    if pTextBox->hRichEdit = 0 then exit sub

    dim pf as PARAFORMAT
    pf.cbSize = sizeof(PARAFORMAT)
    pf.dwMask = PFM_ALIGNMENT
    select case pTextBox->nTextAlign
    case TXT_ALIGN_CENTER : pf.wAlignment = PFA_CENTER
    case TXT_ALIGN_RIGHT  : pf.wAlignment = PFA_RIGHT
    case else             : pf.wAlignment = PFA_LEFT
    end select

    dim as ustring wszSaved = richedit.RichEdit.GetText( pTextBox->hRichEdit )
    dim as DWORD dwStart, dwEnd
    SendMessage( pTextBox->hRichEdit, EM_GETSEL, cast(WPARAM, @dwStart), cast(LPARAM, @dwEnd) )

    ' Every write below is ours, so the ChangeCallback must not hear about any of it.
    pTextBox->bInternalChange = true

    if len(wszSaved) > 0 then
        SendMessage( pTextBox->hRichEdit, WM_SETTEXT, 0, cast(LPARAM, @wstr("")) )
    end if

    ' EM_SETTEXTMODE returns 0 on SUCCESS. If it refuses (it will not -- the buffer is empty
    ' -- but a refusal here would strand the control in rich-text mode), skip the whole
    ' thing rather than leaving the text mode changed.
    if SendMessage( pTextBox->hRichEdit, EM_SETTEXTMODE, TM_RICHTEXT, 0 ) = 0 then
        richedit.RichEdit.SetParaFormat( pTextBox->hRichEdit, @pf )
        SendMessage( pTextBox->hRichEdit, EM_SETTEXTMODE, _
                     TM_PLAINTEXT or TM_MULTILEVELUNDO or TM_MULTICODEPAGE, 0 )
    end if

    if len(wszSaved) > 0 then
        SendMessage( pTextBox->hRichEdit, WM_SETTEXT, 0, cast(LPARAM, strptr(wszSaved)) )
        SendMessage( pTextBox->hRichEdit, EM_SETSEL, cast(WPARAM, dwStart), cast(LPARAM, dwEnd) )
    end if

    pTextBox->bInternalChange = false

    ' The undo stack spans the text we just replaced under the user's feet; leaving it in
    ' place would let Ctrl+Z "undo" our own bookkeeping into a half-state.
    SendMessage( pTextBox->hRichEdit, EM_EMPTYUNDOBUFFER, 0, 0 )
end sub


' ========================================================================================
' Center the (single) text line vertically by raising the formatting rect's top
' (EM_SETRECT). Works on a single-line RichEdit even though the classic EDIT would
' ignore it -- proven in tiko's search box, which this code is ported from.
' Single-line only: a multiline control never calls EM_SETRECT, so its formatting rect
' keeps tracking the client area automatically and text starts at the top.
' ========================================================================================
private sub PsTextBox_CenterSingleLineText( byval pTextBox as PSTEXTBOX_STATE ptr )
    if pTextBox = null then exit sub
    if pTextBox->bMultiline then exit sub
    dim as HWND hRichEdit = pTextBox->hRichEdit
    if hRichEdit = 0 then exit sub

    dim as RECT rc
    GetClientRect( hRichEdit, @rc )
    if (rc.bottom - rc.top) <= 0 then exit sub

    dim as HFONT hFontUse = pTextBox->hTextFont
    if hFontUse = 0 then hFontUse = cast( HFONT, GetStockObject(DEFAULT_GUI_FONT) )
    dim as HDC hdc = GetDC( hRichEdit )
    if hdc = 0 then exit sub
    dim as HFONT hOldFont = SelectObject( hdc, hFontUse )
    dim as TEXTMETRIC tm
    GetTextMetrics( hdc, @tm )
    SelectObject( hdc, hOldFont )
    ReleaseDC( hRichEdit, hdc )

    dim as long topMargin = ((rc.bottom - rc.top) - tm.tmHeight) / 2
    if topMargin < 0 then topMargin = 0
    rc.top = topMargin
    SendMessage( hRichEdit, EM_SETRECT, 0, cast(LPARAM, @rc) )
end sub


' ========================================================================================
' Push the stored left/right margins to the RichEdit. Kept in the TYPE (not only in the
' control) so they can be re-applied after every EM_SETRECT: the formatting rect and
' the margins are set through different messages and geometry changes redo both.
' ========================================================================================
private sub PsTextBox_ApplyMargins( byval pTextBox as PSTEXTBOX_STATE ptr )
    if pTextBox = null then exit sub
    if pTextBox->hRichEdit = 0 then exit sub
    SendMessage( pTextBox->hRichEdit, EM_SETMARGINS, _
                 EC_LEFTMARGIN or EC_RIGHTMARGIN, _
                 MAKELPARAM( pTextBox->nMarginLeft, pTextBox->nMarginRight ) )
end sub


' ========================================================================================
' Derive the RichEdit child's rect from the container's client rect (inset by the
' border width on all sides), then redo vertical centering and margins. This is the
' only place the child geometry is produced -- rects are derived, never set.
' ========================================================================================
private sub PsTextBox_PositionRichEdit( byval pTextBox as PSTEXTBOX_STATE ptr )
    if pTextBox = null then exit sub
    if pTextBox->hRichEdit = 0 then exit sub

    dim as RECT rc
    GetClientRect( pTextBox->hWin, @rc )
    dim as integer bw = pTextBox->nBorderWidth
    dim as integer w = (rc.right - rc.left) - (bw * 2)
    dim as integer h = (rc.bottom - rc.top) - (bw * 2)
    if w < 0 then w = 0
    if h < 0 then h = 0
    SetWindowPos( pTextBox->hRichEdit, 0, rc.left + bw, rc.top + bw, w, h, _
                  SWP_NOZORDER or SWP_SHOWWINDOW )
    PsTextBox_CenterSingleLineText( pTextBox )
    PsTextBox_ApplyMargins( pTextBox )
end sub


' ========================================================================================
' Format a numeric value with the specified decimal places. Ported from tracks'
' AfxMoney and renamed (it never was an AfxNova function). bUseComma inserts thousands
' separators; the control itself always formats WITHOUT them, since "," is not an
' accepted input character.
' ========================================================================================
private function PsTextBox_FormatNumeric( byval nValue as double, byval nDecimalPlaces as integer, byval bUseComma as boolean ) as ustring
    dim as string fmt = "0"
    if bUseComma then fmt = "#,##" & fmt
    if nDecimalPlaces > 0 then fmt = fmt & "." & string(nDecimalPlaces, "0")
    return format( nValue, fmt )
end function


' ========================================================================================
' Is wszText acceptable as (possibly partial) numeric input? Grammar: optional leading
' minus, digits, at most one period followed by at most nDecimalPlaces digits (no
' period at all when nDecimalPlaces = 0). Empty and "-" are valid intermediate states.
' Used to vet a paste before it lands.
' ========================================================================================
private function PsTextBox_IsValidNumericText( byval pTextBox as PSTEXTBOX_STATE ptr, byref wszText as ustring ) as boolean
    dim as integer periodAt = 0
    for i as integer = 1 to len(wszText)
        select case asc(mid(wszText, i, 1))
            case asc("0") to asc("9")
            case asc("-")
                if i <> 1 then return false
            case asc(".")
                if pTextBox->nDecimalPlaces = 0 then return false
                if periodAt > 0 then return false
                periodAt = i
            case else
                return false
        end select
    next
    if periodAt > 0 then
        if (len(wszText) - periodAt) > pTextBox->nDecimalPlaces then return false
    end if
    return true
end function


' ========================================================================================
' Retrieve the RichEdit child's handle. Escape hatch for RichEdit-specific messages the
' flat API and the forwarded EM_ range do not cover.
' ========================================================================================
public function PsTextBox_GetRichEditHandle( byval hTextBoxControl as HWND ) as HWND
    dim as PSTEXTBOX_STATE ptr pTextBox = GetTextBoxPointer(hTextBoxControl)
    if pTextBox = null then return 0
    return pTextBox->hRichEdit
end function


' ========================================================================================
' Is this a multiline control? (Fixed at creation.)
' ========================================================================================
public function PsTextBox_GetMultiline( byval hTextBoxControl as HWND ) as boolean
    dim as PSTEXTBOX_STATE ptr pTextBox = GetTextBoxPointer(hTextBoxControl)
    if pTextBox = null then return false
    return pTextBox->bMultiline
end function


' ========================================================================================
' Does this textbox own the keyboard focus? (It does when its RichEdit child does.)
' ========================================================================================
public function PsTextBox_HasFocus( byval hTextBoxControl as HWND ) as boolean
    dim as PSTEXTBOX_STATE ptr pTextBox = GetTextBoxPointer(hTextBoxControl)
    if pTextBox = null then return false
    return ( GetFocus() = pTextBox->hRichEdit )
end function


' ========================================================================================
' Retrieve the control's text.
' ========================================================================================
public function PsTextBox_GetText( byval hTextBoxControl as HWND ) as ustring
    dim as PSTEXTBOX_STATE ptr pTextBox = GetTextBoxPointer(hTextBoxControl)
    if pTextBox = null then return ""
    return richedit.RichEdit.GetText( pTextBox->hRichEdit )
end function


' ========================================================================================
' Set the control's text. Programmatic: does NOT fire the ChangeCallback.
' ========================================================================================
public function PsTextBox_SetText( byval hTextBoxControl as HWND, byval Text as ustring ) as boolean
    dim as PSTEXTBOX_STATE ptr pTextBox = GetTextBoxPointer(hTextBoxControl)
    if pTextBox = null then return false
    pTextBox->bInternalChange = true
    SendMessage( pTextBox->hRichEdit, WM_SETTEXT, 0, cast(LPARAM, strptr(Text)) )
    pTextBox->bInternalChange = false
    return true
end function


' ========================================================================================
' Retrieve the length of the control's text, in characters.
' ========================================================================================
function PsTextBox_GetTextLength( byval hTextBoxControl as HWND ) as integer
    dim as PSTEXTBOX_STATE ptr pTextBox = GetTextBoxPointer(hTextBoxControl)
    if pTextBox = null then return 0
    return GetWindowTextLength( pTextBox->hRichEdit )
end function


' ========================================================================================
' Retrieve the currently selected text ("" if no selection).
' ========================================================================================
function PsTextBox_GetSelText( byval hTextBoxControl as HWND ) as ustring
    dim as PSTEXTBOX_STATE ptr pTextBox = GetTextBoxPointer(hTextBoxControl)
    if pTextBox = null then return ""
    return richedit.RichEdit.GetSelText( pTextBox->hRichEdit )
end function


' ========================================================================================
' Replace the current selection (or insert at the caret when there is none).
' Programmatic: does NOT fire the ChangeCallback. The replace is undoable.
' ========================================================================================
function PsTextBox_ReplaceSel( byval hTextBoxControl as HWND, byval Text as ustring ) as boolean
    dim as PSTEXTBOX_STATE ptr pTextBox = GetTextBoxPointer(hTextBoxControl)
    if pTextBox = null then return false
    pTextBox->bInternalChange = true
    SendMessage( pTextBox->hRichEdit, EM_REPLACESEL, true, cast(LPARAM, strptr(Text)) )
    pTextBox->bInternalChange = false
    return true
end function


' ========================================================================================
' Clear all text. Programmatic: does NOT fire the ChangeCallback.
' ========================================================================================
public function PsTextBox_Clear( byval hTextBoxControl as HWND ) as boolean
    return PsTextBox_SetText( hTextBoxControl, "" )
end function


' ========================================================================================
' Retrieve the selection as 0-based character indices (nStart = nEnd means a caret).
' ========================================================================================
sub PsTextBox_GetSel( byval hTextBoxControl as HWND, byref nStart as integer, byref nEnd as integer )
    nStart = 0: nEnd = 0
    dim as PSTEXTBOX_STATE ptr pTextBox = GetTextBoxPointer(hTextBoxControl)
    if pTextBox = null then exit sub
    dim as DWORD dwStart, dwEnd
    SendMessage( pTextBox->hRichEdit, EM_GETSEL, cast(WPARAM, @dwStart), cast(LPARAM, @dwEnd) )
    nStart = dwStart: nEnd = dwEnd
end sub


' ========================================================================================
' Set the selection. nEnd = -1 selects through the end of the text.
' ========================================================================================
public sub PsTextBox_SetSel( byval hTextBoxControl as HWND, byval nStart as integer, byval nEnd as integer )
    dim as PSTEXTBOX_STATE ptr pTextBox = GetTextBoxPointer(hTextBoxControl)
    if pTextBox = null then exit sub
    SendMessage( pTextBox->hRichEdit, EM_SETSEL, nStart, nEnd )
end sub


' ========================================================================================
' Select all text.
' ========================================================================================
public sub PsTextBox_SelectAll( byval hTextBoxControl as HWND )
    PsTextBox_SetSel( hTextBoxControl, 0, -1 )
end sub


' ========================================================================================
' Text length limit (characters). 0 restores the RichEdit default limit.
' ========================================================================================
function PsTextBox_GetLimitText( byval hTextBoxControl as HWND ) as integer
    dim as PSTEXTBOX_STATE ptr pTextBox = GetTextBoxPointer(hTextBoxControl)
    if pTextBox = null then return 0
    return SendMessage( pTextBox->hRichEdit, EM_GETLIMITTEXT, 0, 0 )
end function

sub PsTextBox_SetLimitText( byval hTextBoxControl as HWND, byval nLimit as integer )
    dim as PSTEXTBOX_STATE ptr pTextBox = GetTextBoxPointer(hTextBoxControl)
    if pTextBox = null then exit sub
    SendMessage( pTextBox->hRichEdit, EM_EXLIMITTEXT, 0, nLimit )
end sub


' ========================================================================================
' Read-only state.
' ========================================================================================
public function PsTextBox_GetReadOnly( byval hTextBoxControl as HWND ) as boolean
    dim as PSTEXTBOX_STATE ptr pTextBox = GetTextBoxPointer(hTextBoxControl)
    if pTextBox = null then return false
    return ( (GetWindowLongPtr( pTextBox->hRichEdit, GWL_STYLE ) and ES_READONLY) <> 0 )
end function

public function PsTextBox_SetReadOnly( byval hTextBoxControl as HWND, byval bReadOnly as boolean ) as boolean
    dim as PSTEXTBOX_STATE ptr pTextBox = GetTextBoxPointer(hTextBoxControl)
    if pTextBox = null then return false
    return ( SendMessage( pTextBox->hRichEdit, EM_SETREADONLY, bReadOnly, 0 ) <> 0 )
end function


' ========================================================================================
' Modified flag (set by user edits, cleared by WM_SETTEXT or SetModify(false)).
' ========================================================================================
function PsTextBox_GetModify( byval hTextBoxControl as HWND ) as boolean
    dim as PSTEXTBOX_STATE ptr pTextBox = GetTextBoxPointer(hTextBoxControl)
    if pTextBox = null then return false
    return ( SendMessage( pTextBox->hRichEdit, EM_GETMODIFY, 0, 0 ) <> 0 )
end function

sub PsTextBox_SetModify( byval hTextBoxControl as HWND, byval bModified as boolean )
    dim as PSTEXTBOX_STATE ptr pTextBox = GetTextBoxPointer(hTextBoxControl)
    if pTextBox = null then exit sub
    SendMessage( pTextBox->hRichEdit, EM_SETMODIFY, bModified, 0 )
end sub


' ========================================================================================
' Password character (0 turns password mode off).
' ========================================================================================
sub PsTextBox_SetPasswordChar( byval hTextBoxControl as HWND, byval wchChar as integer )
    dim as PSTEXTBOX_STATE ptr pTextBox = GetTextBoxPointer(hTextBoxControl)
    if pTextBox = null then exit sub
    SendMessage( pTextBox->hRichEdit, EM_SETPASSWORDCHAR, wchChar, 0 )
    InvalidateRect( pTextBox->hRichEdit, null, true )
end sub


' ========================================================================================
' Select-all-on-focus behavior.
' ========================================================================================
function PsTextBox_GetSelectOnFocus( byval hTextBoxControl as HWND ) as boolean
    dim as PSTEXTBOX_STATE ptr pTextBox = GetTextBoxPointer(hTextBoxControl)
    if pTextBox = null then return false
    return pTextBox->bSelectOnFocus
end function

public sub PsTextBox_SetSelectOnFocus( byval hTextBoxControl as HWND, byval bSelect as boolean )
    dim as PSTEXTBOX_STATE ptr pTextBox = GetTextBoxPointer(hTextBoxControl)
    if pTextBox = null then exit sub
    pTextBox->bSelectOnFocus = bSelect
end sub


' ========================================================================================
' Numeric input mode.
' ========================================================================================
public function PsTextBox_GetNumericMode( byval hTextBoxControl as HWND ) as boolean
    dim as PSTEXTBOX_STATE ptr pTextBox = GetTextBoxPointer(hTextBoxControl)
    if pTextBox = null then return false
    return pTextBox->bNumericOnly
end function

public sub PsTextBox_SetNumericMode( byval hTextBoxControl as HWND, byval bEnable as boolean )
    dim as PSTEXTBOX_STATE ptr pTextBox = GetTextBoxPointer(hTextBoxControl)
    if pTextBox = null then exit sub
    if pTextBox->bMultiline then exit sub    ' numeric mode is single-line only
    pTextBox->bNumericOnly = bEnable
end sub

public function PsTextBox_GetDecimalPlaces( byval hTextBoxControl as HWND ) as integer
    dim as PSTEXTBOX_STATE ptr pTextBox = GetTextBoxPointer(hTextBoxControl)
    if pTextBox = null then return 0
    return pTextBox->nDecimalPlaces
end function

public sub PsTextBox_SetDecimalPlaces( byval hTextBoxControl as HWND, byval nPlaces as integer )
    dim as PSTEXTBOX_STATE ptr pTextBox = GetTextBoxPointer(hTextBoxControl)
    if pTextBox = null then exit sub
    if nPlaces < 0 then nPlaces = 0
    pTextBox->nDecimalPlaces = nPlaces
end sub

' The current text as a double (val of the text; empty/"-"/"." read as 0).
public function PsTextBox_GetValue( byval hTextBoxControl as HWND ) as double
    dim as PSTEXTBOX_STATE ptr pTextBox = GetTextBoxPointer(hTextBoxControl)
    if pTextBox = null then return 0
    return val( richedit.RichEdit.GetText( pTextBox->hRichEdit ) )
end function

' Set the text from a double, formatted to DecimalPlaces. Programmatic: silent.
public function PsTextBox_SetValue( byval hTextBoxControl as HWND, byval nValue as double ) as boolean
    dim as PSTEXTBOX_STATE ptr pTextBox = GetTextBoxPointer(hTextBoxControl)
    if pTextBox = null then return false
    return PsTextBox_SetText( hTextBoxControl, _
                PsTextBox_FormatNumeric( nValue, pTextBox->nDecimalPlaces, false ) )
end function

' Display the formatted zero instead of an empty box (numeric mode only).
function PsTextBox_GetZeroWhenEmpty( byval hTextBoxControl as HWND ) as boolean
    dim as PSTEXTBOX_STATE ptr pTextBox = GetTextBoxPointer(hTextBoxControl)
    if pTextBox = null then return false
    return pTextBox->bZeroWhenEmpty
end function

public sub PsTextBox_SetZeroWhenEmpty( byval hTextBoxControl as HWND, byval bEnable as boolean )
    dim as PSTEXTBOX_STATE ptr pTextBox = GetTextBoxPointer(hTextBoxControl)
    if pTextBox = null then exit sub
    pTextBox->bZeroWhenEmpty = bEnable
    ' Apply immediately when the box is already empty and not being edited; a focused
    ' box is left alone (the user may be mid-entry) -- its focus loss will stamp it.
    if bEnable andalso pTextBox->bNumericOnly then
        if (GetWindowTextLength(pTextBox->hRichEdit) = 0) andalso (GetFocus() <> pTextBox->hRichEdit) then
            PsTextBox_SetValue( hTextBoxControl, 0 )
        end if
    end if
end sub


' ========================================================================================
' Clipboard and undo.
' ========================================================================================
sub PsTextBox_Cut( byval hTextBoxControl as HWND )
    dim as PSTEXTBOX_STATE ptr pTextBox = GetTextBoxPointer(hTextBoxControl)
    if pTextBox = null then exit sub
    SendMessage( pTextBox->hRichEdit, WM_CUT, 0, 0 )
end sub

sub PsTextBox_Copy( byval hTextBoxControl as HWND )
    dim as PSTEXTBOX_STATE ptr pTextBox = GetTextBoxPointer(hTextBoxControl)
    if pTextBox = null then exit sub
    SendMessage( pTextBox->hRichEdit, WM_COPY, 0, 0 )
end sub

sub PsTextBox_Paste( byval hTextBoxControl as HWND )
    dim as PSTEXTBOX_STATE ptr pTextBox = GetTextBoxPointer(hTextBoxControl)
    if pTextBox = null then exit sub
    SendMessage( pTextBox->hRichEdit, WM_PASTE, 0, 0 )
end sub

function PsTextBox_CanPaste( byval hTextBoxControl as HWND ) as boolean
    dim as PSTEXTBOX_STATE ptr pTextBox = GetTextBoxPointer(hTextBoxControl)
    if pTextBox = null then return false
    return ( richedit.RichEdit.CanPaste( pTextBox->hRichEdit, 0 ) <> 0 )
end function

function PsTextBox_Undo( byval hTextBoxControl as HWND ) as boolean
    dim as PSTEXTBOX_STATE ptr pTextBox = GetTextBoxPointer(hTextBoxControl)
    if pTextBox = null then return false
    return ( SendMessage( pTextBox->hRichEdit, EM_UNDO, 0, 0 ) <> 0 )
end function

function PsTextBox_CanUndo( byval hTextBoxControl as HWND ) as boolean
    dim as PSTEXTBOX_STATE ptr pTextBox = GetTextBoxPointer(hTextBoxControl)
    if pTextBox = null then return false
    return ( SendMessage( pTextBox->hRichEdit, EM_CANUNDO, 0, 0 ) <> 0 )
end function


' ========================================================================================
' Left/right text margins, in pixels.
' ========================================================================================
sub PsTextBox_GetMargins( byval hTextBoxControl as HWND, byref nLeft as integer, byref nRight as integer )
    nLeft = 0: nRight = 0
    dim as PSTEXTBOX_STATE ptr pTextBox = GetTextBoxPointer(hTextBoxControl)
    if pTextBox = null then exit sub
    nLeft = pTextBox->nMarginLeft
    nRight = pTextBox->nMarginRight
end sub

public sub PsTextBox_SetMargins( byval hTextBoxControl as HWND, byval nLeft as integer, byval nRight as integer )
    dim as PSTEXTBOX_STATE ptr pTextBox = GetTextBoxPointer(hTextBoxControl)
    if pTextBox = null then exit sub
    pTextBox->nMarginLeft = nLeft
    pTextBox->nMarginRight = nRight
    PsTextBox_ApplyMargins( pTextBox )
    InvalidateRect( pTextBox->hRichEdit, null, true )
end sub


' ========================================================================================
' Vertical scroll state, in LINES -- shaped 1:1 for PsVScrollBar_SetRange(total, page, pos).
' LinesPerPage derives from the formatting-rect height and the text font's line height
' (TEXTMETRIC height + external leading, which is how the RichEdit spaces single-format
' plain-text lines); a partial line at the bottom is not counted. No fudge factors --
' the harness asserts these numbers against hand counts.
' ========================================================================================
public sub PsTextBox_GetVScrollInfo( byval hTextBoxControl as HWND, byref nTotalLines as integer, byref nLinesPerPage as integer, byref nFirstVisibleLine as integer )
    nTotalLines = 0: nLinesPerPage = 0: nFirstVisibleLine = 0
    dim as PSTEXTBOX_STATE ptr pTextBox = GetTextBoxPointer(hTextBoxControl)
    if pTextBox = null then exit sub
    dim as HWND hRichEdit = pTextBox->hRichEdit
    if hRichEdit = 0 then exit sub

    nTotalLines = SendMessage( hRichEdit, EM_GETLINECOUNT, 0, 0 )
    nFirstVisibleLine = SendMessage( hRichEdit, EM_GETFIRSTVISIBLELINE, 0, 0 )

    dim as RECT rcFormat
    SendMessage( hRichEdit, EM_GETRECT, 0, cast(LPARAM, @rcFormat) )
    dim as integer rectHeight = rcFormat.bottom - rcFormat.top
    if rectHeight <= 0 then exit sub

    dim as HFONT hFontUse = pTextBox->hTextFont
    if hFontUse = 0 then hFontUse = cast( HFONT, GetStockObject(DEFAULT_GUI_FONT) )
    dim as HDC hdc = GetDC( hRichEdit )
    if hdc = 0 then exit sub
    dim as HFONT hOldFont = SelectObject( hdc, hFontUse )
    dim as TEXTMETRIC tm
    GetTextMetrics( hdc, @tm )
    SelectObject( hdc, hOldFont )
    ReleaseDC( hRichEdit, hdc )

    dim as integer lineHeight = tm.tmHeight + tm.tmExternalLeading
    if lineHeight <= 0 then exit sub         ' guard BEFORE dividing
    nLinesPerPage = rectHeight \ lineHeight
end sub


' ========================================================================================
' Scroll so nLine (0-based) becomes the first visible line -- the receiving end of a
' scrollbar's position callback (PsVScrollBar's ScrollCallback newPos goes straight here).
' EM_LINESCROLL takes a DELTA, so the current first line is subtracted; the RichEdit
' clamps overscroll itself.
' ========================================================================================
public sub PsTextBox_ScrollToLine( byval hTextBoxControl as HWND, byval nLine as integer )
    dim as PSTEXTBOX_STATE ptr pTextBox = GetTextBoxPointer(hTextBoxControl)
    if pTextBox = null then exit sub
    if pTextBox->hRichEdit = 0 then exit sub
    if nLine < 0 then nLine = 0
    dim as integer nFirst = SendMessage( pTextBox->hRichEdit, EM_GETFIRSTVISIBLELINE, 0, 0 )
    if nLine <> nFirst then
        SendMessage( pTextBox->hRichEdit, EM_LINESCROLL, 0, cast(LPARAM, nLine - nFirst) )
    end if
end sub


' ========================================================================================
' Text font (caller-owned HFONT; 0 = stock DEFAULT_GUI_FONT).
' ========================================================================================
function PsTextBox_GetFont( byval hTextBoxControl as HWND ) as HFONT
    dim as PSTEXTBOX_STATE ptr pTextBox = GetTextBoxPointer(hTextBoxControl)
    if pTextBox = null then return 0
    return pTextBox->hTextFont
end function

public function PsTextBox_SetFont( byval hTextBoxControl as HWND, byval hFont as HFONT ) as boolean
    dim as PSTEXTBOX_STATE ptr pTextBox = GetTextBoxPointer(hTextBoxControl)
    if pTextBox = null then return false
    pTextBox->hTextFont = hFont
    PsTextBox_ApplyCharFormat( pTextBox )
    PsTextBox_CenterSingleLineText( pTextBox )
    PsTextBox_ApplyMargins( pTextBox )
    InvalidateRect( pTextBox->hRichEdit, null, true )
    return true
end function


' ========================================================================================
' Text forecolor (one color for ALL text).
' ========================================================================================
public function PsTextBox_GetForeColor( byval hTextBoxControl as HWND ) as COLORREF
    dim as PSTEXTBOX_STATE ptr pTextBox = GetTextBoxPointer(hTextBoxControl)
    if pTextBox = null then return 0
    return pTextBox->ForeColor
end function

public function PsTextBox_SetForeColor( byval hTextBoxControl as HWND, byval clr as COLORREF ) as COLORREF
    dim as PSTEXTBOX_STATE ptr pTextBox = GetTextBoxPointer(hTextBoxControl)
    if pTextBox = null then return 0
    dim as COLORREF oldclr = pTextBox->ForeColor
    pTextBox->ForeColor = clr
    pTextBox->bColorsPinned = true
    PsTextBox_ApplyCharFormat( pTextBox )
    return oldclr
end function


' ========================================================================================
' Background color (the text area; the border/outer chrome has its own colors).
' ========================================================================================
public function PsTextBox_GetBackColor( byval hTextBoxControl as HWND ) as COLORREF
    dim as PSTEXTBOX_STATE ptr pTextBox = GetTextBoxPointer(hTextBoxControl)
    if pTextBox = null then return 0
    return pTextBox->BackColor
end function

public function PsTextBox_SetBackColor( byval hTextBoxControl as HWND, byval clr as COLORREF ) as COLORREF
    dim as PSTEXTBOX_STATE ptr pTextBox = GetTextBoxPointer(hTextBoxControl)
    if pTextBox = null then return 0
    dim as COLORREF oldclr = pTextBox->BackColor
    pTextBox->BackColor = clr
    pTextBox->bColorsPinned = true
    SendMessage( pTextBox->hRichEdit, EM_SETBKGNDCOLOR, 0, cast(LPARAM, clr) )
    InvalidateRect( pTextBox->hWin, null, true )
    return oldclr
end function


' ========================================================================================
' Cue banner: text, color, font.
