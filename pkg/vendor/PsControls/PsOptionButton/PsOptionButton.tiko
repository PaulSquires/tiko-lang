public declare sub      PsOptionButton_GetPadding( byval hOptionButton as HWND, byref nLeft as long, byref nTop as long, byref nRight as long, byref nBottom as long )
public declare sub      PsOptionButton_SetPadding( byval hOptionButton as HWND, byval nLeft as long, byval nTop as long, byval nRight as long, byval nBottom as long )
public declare function PsOptionButton_GetBoxGap( byval hOptionButton as HWND ) as long
