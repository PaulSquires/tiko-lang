    return pOpt->nBoxAlign
end function

' No ApplyAutoSize: the mirror is exact, so flipping the side cannot change the ideal size.
public sub PsOptionButton_SetBoxAlign( byval hOptionButton as HWND, byval nBoxAlign as long )
