public sub PsChart_SetPieSliceGap( byval hChart as HWND, byval nGap as long )
    dim as PSCHART_STATE ptr pChart = GetChartPointer( hChart )
    if pChart = 0 then exit sub
    if nGap < 0 then nGap = 0
    pChart->nPieSliceGap = nGap
    InvalidateRect( hChart, NULL, TRUE )
end sub

' --- colours ---------------------------------------------------------------------------------------
public sub PsChart_GetColors( byval hChart as HWND, byval pColors as PSCHART_COLORS ptr )
    dim as PSCHART_STATE ptr pChart = GetChartPointer( hChart )
    if (pChart = 0) orelse (pColors = 0) then exit sub
    *pColors = pChart->colors
end sub

public sub PsChart_SetColors( byval hChart as HWND, byval pColors as PSCHART_COLORS ptr )
    dim as PSCHART_STATE ptr pChart = GetChartPointer( hChart )
    if (pChart = 0) orelse (pColors = 0) then exit sub
    pChart->colors = *pColors
    pChart->bColorsPinned = true
    InvalidateRect( hChart, NULL, TRUE )
end sub

' ========================================================================================
' The theme (vendor/PsControls/PsTheme). ThemeColors is the adapter: the chart's colours
' derived from the theme's roles. ApplyTheme applies them unless the host pinned its own.
' The palette, series and point colours are data and are never themed.
' ========================================================================================
public function PsChart_ThemeColors( byref t as PSTHEME_COLORS ) as PSCHART_COLORS
    dim as PSCHART_COLORS c
    c.BackColor          = t.Window
    c.PlotBackColor      = t.Window
    c.GridColor          = t.Divider
    c.AxisColor          = t.Border
    c.LabelColor         = t.TextDim
    c.TitleColor         = t.Text
    c.SubtitleColor      = t.TextDim
    c.LegendTextColor    = t.Text
    c.SliceLabelColor    = t.SelectedText
    c.SliceLabelOutColor = t.Text
    c.LeaderColor        = t.TextDim
    c.SliceGapColor      = t.Window
    c.UpColor            = t.Success
    c.DownColor          = t.Error
    c.ForeColorDisabled  = t.TextDisabled
    return c
end function

public sub PsChart_ApplyTheme( byval hChart as HWND, byref t as PSTHEME_COLORS )
    dim as PSCHART_STATE ptr pChart = GetChartPointer( hChart )
    if (pChart = 0) orelse pChart->bColorsPinned then exit sub
    dim as PSCHART_COLORS c = PsChart_ThemeColors( t )
    PsChart_SetColors( hChart, @c )
    pChart->bColorsPinned = false
end sub

' Hands the chart back to the theme, which is applied at once.
public sub PsChart_UnpinColors( byval hChart as HWND )
    dim as PSCHART_STATE ptr pChart = GetChartPointer( hChart )
    if pChart = 0 then exit sub
    pChart->bColorsPinned = false
    dim as PSTHEME_COLORS t
    if PsRegistry_GetTheme( t ) then PsChart_ApplyTheme( hChart, t )
end sub

' The form's fonts (PsApp), handed over when the chart is created on a form. No glyph font;
' the title and subtitle fall back to the label font.
public sub PsChart_ApplyFonts( byval hChart as HWND, byval hTextFont as HFONT, byval hGlyphFont as HFONT )
    if hTextFont then PsChart_SetFont( hChart, hTextFont )
end sub

sub PsChart_SetPaletteColor( byval hChart as HWND, byval idx as long, byval clr as COLORREF )
    dim as PSCHART_STATE ptr pChart = GetChartPointer( hChart )
    if pChart = 0 then exit sub
    if (idx < 0) orelse (idx >= PSCHART_PALETTE_COUNT) then exit sub
    pChart->palette(idx) = clr
    InvalidateRect( hChart, NULL, TRUE )
end sub

function PsChart_GetPaletteColor( byval hChart as HWND, byval idx as long ) as COLORREF
    dim as PSCHART_STATE ptr pChart = GetChartPointer( hChart )
    if pChart = 0 then return 0
    if (idx < 0) orelse (idx >= PSCHART_PALETTE_COUNT) then return 0
    return pChart->palette(idx)
end function

' --- query -----------------------------------------------------------------------------------------
function PsChart_HitTest( byval hChart as HWND, byval x as long, byval y as long, _
                          byref iSeries as long, byref iPoint as long ) as boolean
    iSeries = -1 : iPoint = -1
    dim as PSCHART_STATE ptr pChart = GetChartPointer( hChart )
    if pChart = 0 then return false
    CHT_EnsureLayout( pChart )
    return CHT_HitTest( pChart, x, y, iSeries, iPoint )
end function

function PsChart_GetPlotRect( byval hChart as HWND, byref rc as RECT ) as boolean
    SetRectEmpty( @rc )
    dim as PSCHART_STATE ptr pChart = GetChartPointer( hChart )
    if pChart = 0 then return false
    CHT_EnsureLayout( pChart )
    rc = pChart->rcPlot
    return true
end function

function PsChart_GetPointRect( byval hChart as HWND, byval iSeries as long, byval iPoint as long, byref rc as RECT ) as boolean
    SetRectEmpty( @rc )
    dim as PSCHART_STATE ptr pChart = GetChartPointer( hChart )
    if pChart = 0 then return false
    CHT_EnsureLayout( pChart )
    dim as PSCHART_POINT ptr p = pChart->GetPoint( iSeries, iPoint )
    if p = 0 then return false
    rc = p->rc
    return true
end function

function PsChart_ValueToY( byval hChart as HWND, byval fValue as double ) as long
    dim as PSCHART_STATE ptr pChart = GetChartPointer( hChart )
    if pChart = 0 then return 0
    CHT_EnsureLayout( pChart )
    return pChart->ValueToY( fValue )
end function

function PsChart_YToValue( byval hChart as HWND, byval y as long ) as double
    dim as PSCHART_STATE ptr pChart = GetChartPointer( hChart )
    if pChart = 0 then return 0.0
    CHT_EnsureLayout( pChart )
    return pChart->YToValue( y )
end function

function PsChart_GetHotPoint( byval hChart as HWND, byref iSeries as long, byref iPoint as long ) as boolean
    iSeries = -1 : iPoint = -1
    dim as PSCHART_STATE ptr pChart = GetChartPointer( hChart )
    if pChart = 0 then return false
    iSeries = pChart->nHotSeries
    iPoint = pChart->nHotPoint
    return (iPoint >= 0)
end function

' --- tooltips ----------------------------------------------------------------------------------------
sub PsChart_SetTooltipText( byval hChart as HWND, byval wszText as ustring )
    dim as PSCHART_STATE ptr pChart = GetChartPointer( hChart )
    if pChart = 0 then exit sub
    pChart->wszTipText = wszText
end sub

function PsChart_GetTooltipText( byval hChart as HWND ) as ustring
    dim as PSCHART_STATE ptr pChart = GetChartPointer( hChart )
    if pChart = 0 then return ""
    return pChart->wszTipText
end function

sub PsChart_SetTooltipMode( byval hChart as HWND, byval nMode as long )
    dim as PSCHART_STATE ptr pChart = GetChartPointer( hChart )
    if pChart = 0 then exit sub
    PsTipHost_SetMode( @pChart->tip, nMode )
end sub

function PsChart_GetTooltipMode( byval hChart as HWND ) as long
    dim as PSCHART_STATE ptr pChart = GetChartPointer( hChart )
    if pChart = 0 then return PSTIP_MODE_SYSTEM
    return PsTipHost_GetMode( @pChart->tip )
end function

' --- callbacks -----------------------------------------------------------------------------------------
sub PsChart_SetPaintCallback( byval hChart as HWND, byval userfunc as CHT_PaintCallbackSub )
    dim as PSCHART_STATE ptr pChart = GetChartPointer( hChart )
    if pChart = 0 then exit sub
    pChart->PaintCallback = userfunc
    InvalidateRect( hChart, NULL, TRUE )
end sub

sub PsChart_SetMessageCallback( byval hChart as HWND, byval userfunc as CHT_MessageCallbackFunc )
    dim as PSCHART_STATE ptr pChart = GetChartPointer( hChart )
    if pChart = 0 then exit sub
    pChart->MessageCallback = userfunc
end sub

sub PsChart_SetTooltipCallback( byval hChart as HWND, byval userfunc as CHT_TooltipCallbackFunc )
    dim as PSCHART_STATE ptr pChart = GetChartPointer( hChart )
    if pChart = 0 then exit sub
    pChart->TooltipCallback = userfunc
end sub

sub PsChart_SetValueLabelCallback( byval hChart as HWND, byval userfunc as CHT_ValueLabelCallbackFunc )
    dim as PSCHART_STATE ptr pChart = GetChartPointer( hChart )
    if pChart = 0 then exit sub
    pChart->ValueLabelCallback = userfunc
    pChart->Refresh()
end sub

sub PsChart_SetHotChangeCallback( byval hChart as HWND, byval userfunc as CHT_HotChangeCallbackSub )
    dim as PSCHART_STATE ptr pChart = GetChartPointer( hChart )
    if pChart = 0 then exit sub
    pChart->HotChangeCallback = userfunc
end sub


' ########################################################################################
'  RENDER PROBES
'
'  Both drive CHT_Render -- the SAME function WM_PAINT calls -- into an offscreen buffer and
'  read the result back. Anything that measured a parallel implementation would be measuring
'  the wrong thing, and that failure has shipped in this family before.
' ########################################################################################

' Render offscreen and hand the caller the memory DC to read. Returns false if anything in
' the chain failed, in which case nothing was drawn and nothing should be measured.
private function CHT_RenderOffscreen( byval pChart as PSCHART_STATE ptr, byval b as PsPaintBuffer ptr, _
                                      byref rcOut as RECT ) as boolean
    if (pChart = 0) orelse (b = 0) then return false
    GetClientRect( pChart->hWin, @rcOut )
    if (rcOut.right <= rcOut.left) orelse (rcOut.bottom <= rcOut.top) then return false

    dim as HDC hScreen = GetDC( pChart->hWin )
    if hScreen = 0 then return false
    b->BeginDoubleBuffer( pChart->hWin, hScreen, rcOut )
    CHT_Render( pChart, b )
    ' Deliberately NOT EndDoubleBuffer: that would blit the buffer to the screen and free it.
    ' The caller reads the surface first through getMemDC and lets the destructor clean up.
    ReleaseDC( pChart->hWin, hScreen )
    return true
end function

function PsChart_CountRenderedTones( byval hChart as HWND ) as long
    dim as PSCHART_STATE ptr pChart = GetChartPointer( hChart )
    if pChart = 0 then return 0

    dim as PsPaintBuffer b
    dim as RECT rc
    if CHT_RenderOffscreen( pChart, @b, rc ) = false then return 0
    dim as HDC hdc = b.getMemDC()
    if hdc = 0 then return 0

    ' A small fixed sample grid rather than every pixel: the question this answers is "did
    ' anything actually get drawn", and a full scan of a 700x400 surface is 280,000 GetPixel
    ' calls for the same answer.
    dim as COLORREF seen( 0 to 63 )
    dim as long nSeen = 0
    for gy as long = 0 to 31
        for gx as long = 0 to 31
            dim as long x = rc.left + (rc.right - rc.left) * gx \ 32
            dim as long y = rc.top + (rc.bottom - rc.top) * gy \ 32
            dim as COLORREF c = GetPixel( hdc, x, y )
            dim as boolean bFound = false
            for k as long = 0 to nSeen - 1
                if seen(k) = c then bFound = true : exit for
            next
            if (bFound = false) andalso (nSeen < 64) then
                seen(nSeen) = c
                nSeen += 1
            end if
        next
    next
    return nSeen
end function

function PsChart_GetRenderedPixel( byval hChart as HWND, byval x as long, byval y as long ) as COLORREF
    dim as PSCHART_STATE ptr pChart = GetChartPointer( hChart )
    if pChart = 0 then return CLR_INVALID

    dim as PsPaintBuffer b
    dim as RECT rc
    if CHT_RenderOffscreen( pChart, @b, rc ) = false then return CLR_INVALID
    dim as HDC hdc = b.getMemDC()
    if hdc = 0 then return CLR_INVALID

    dim as POINT pt
    pt.x = x : pt.y = y
    if PtInRect( @rc, pt ) = 0 then return CLR_INVALID
    return GetPixel( hdc, x, y )
end function

function PsChart_CountPlotInkPixels( byval hChart as HWND, byval clrBack as COLORREF ) as long
    dim as PSCHART_STATE ptr pChart = GetChartPointer( hChart )
    if pChart = 0 then return 0

    dim as PsPaintBuffer b
    dim as RECT rc
    if CHT_RenderOffscreen( pChart, @b, rc ) = false then return 0
    dim as HDC hdc = b.getMemDC()
    if hdc = 0 then return 0

    ' rcPlot is only trustworthy after the render above ran the layout.
    dim as RECT rcp = pChart->rcPlot
    if IntersectRect( @rcp, @rcp, @rc ) = 0 then return 0

    dim as long n = 0
    for y as long = rcp.top to rcp.bottom - 1
        for x as long = rcp.left to rcp.right - 1
            if GetPixel( hdc, x, y ) <> clrBack then n += 1
        next
    next
    return n
end function

function PsChart_HashRenderedPart( byval hChart as HWND ) as ulong
    dim as PSCHART_STATE ptr pChart = GetChartPointer( hChart )
    if pChart = 0 then return 0

    dim as PsPaintBuffer b
    dim as RECT rc
    if CHT_RenderOffscreen( pChart, @b, rc ) = false then return 0
    dim as HDC hdc = b.getMemDC()
    if hdc = 0 then return 0

    ' FNV-1a over the same sample grid. Two renders that differ anywhere in the grid produce
    ' different hashes; identical ones produce the same. That is all a regression check needs.
    dim as ulong h = &h811C9DC5
    for gy as long = 0 to 31
        for gx as long = 0 to 31
            dim as long x = rc.left + (rc.right - rc.left) * gx \ 32
            dim as long y = rc.top + (rc.bottom - rc.top) * gy \ 32
            dim as ulong c = GetPixel( hdc, x, y )
            for shift as long = 0 to 24 step 8
                h = h xor ((c shr shift) and &hFF)
                h *= 16777619
            next
        next
    next
    return h
end function


' ---- PsChart_SelfTest.tiko (inlined: a module is its directory's files) ----
dim shared as long gCHT_TestCount
dim shared as long gCHT_FailCount

private sub CHTTest_Check( byval sName as string, byval bOK as boolean, byval sDetail as string )
    gCHT_TestCount += 1
    dim as string s
    if bOK then
        s = "PASS  "
    else
        s = "FAIL  "
        gCHT_FailCount += 1
    end if
    s &= sName & "   [" & sDetail & "]"
    print s
end sub

private function CHTTest_Near( byval a as double, byval b as double, byval tol as double ) as boolean
    return (abs(a - b) <= tol)
end function

private function CHTTest_RectStr( byref rc as RECT ) as string
    return "(" & str(rc.left) & "," & str(rc.top) & ")-(" & str(rc.right) & "," & str(rc.bottom) & ")"
end function

' A chart sized to a KNOWN client rect. SetWindowPos on this WS_CHILD sets the window rect,
' and with no border on this control that is also the client rect.
private function CHTTest_MakeChart( byval hParent as HWND, byval nType as long, _
                                    byval w as long, byval h as long ) as HWND
    dim as HWND hCtrl = PsChart_Create( hParent, 9000, nType )
    if hCtrl = 0 then return 0
    ' Hidden BEFORE it is sized: the self-test must not flash six charts across the host form.
    ShowWindow( hCtrl, SW_HIDE )
    SetWindowPos( hCtrl, 0, 0, 0, w, h, SWP_NOZORDER or SWP_NOACTIVATE )
    return hCtrl
end function


public function PsChart_RunSelfTest( byval hWndParent as HWND ) as long
    gCHT_TestCount = 0
    gCHT_FailCount = 0
    print "===== PsChart self-test ====="

    ' --- CHT_NiceRange --------------------------------------------------------------------
    scope
        dim as double lo, hi, st

        CHT_NiceRange( 0.0, 8.0, 5, lo, hi, st )
        CHTTest_Check( "NiceRange: 0..8 with 5 ticks steps by 2", _
            CHTTest_Near(st,2.0,0.0001) andalso CHTTest_Near(lo,0.0,0.0001) andalso CHTTest_Near(hi,8.0,0.0001), _
            "min=" & str(lo) & " max=" & str(hi) & " step=" & str(st) )

        CHT_NiceRange( 0.0, 8.0, 8, lo, hi, st )
        CHTTest_Check( "NiceRange: 0..8 with 8 ticks steps by 1", _
            CHTTest_Near(st,1.0,0.0001) andalso CHTTest_Near(lo,0.0,0.0001) andalso CHTTest_Near(hi,8.0,0.0001), _
            "min=" & str(lo) & " max=" & str(hi) & " step=" & str(st) )

        ' The HLOC reference range. The bounds widen to the step, which is the point: the top
        ' gridline must sit ABOVE the highest datum, not on it.
        CHT_NiceRange( 1000.0, 1220.0, 5, lo, hi, st )
        CHTTest_Check( "NiceRange: 1000..1220 snaps to a 50 step", _
            CHTTest_Near(st,50.0,0.0001) andalso CHTTest_Near(lo,1000.0,0.0001) andalso CHTTest_Near(hi,1250.0,0.0001), _
            "min=" & str(lo) & " max=" & str(hi) & " step=" & str(st) )

        ' A FLAT SERIES -- the one input that would divide by zero without a synthetic window.
        CHT_NiceRange( 5.0, 5.0, 5, lo, hi, st )
        CHTTest_Check( "NiceRange: a flat series opens a window around the value", _
            (st > 0.0) andalso (lo <= 5.0) andalso (hi >= 5.0), _
            "min=" & str(lo) & " max=" & str(hi) & " step=" & str(st) )

        CHT_NiceRange( 0.0, 0.0, 5, lo, hi, st )
        CHTTest_Check( "NiceRange: an all-zero series does not divide by zero", _
            (st > 0.0) andalso (hi > lo), _
            "min=" & str(lo) & " max=" & str(hi) & " step=" & str(st) )

        ' ALL-NEGATIVE. int() is floor, so the ceiling of -1/2 has to come out 0, not -1.
        CHT_NiceRange( -8.0, -1.0, 5, lo, hi, st )
        CHTTest_Check( "NiceRange: an all-negative range ceils toward zero", _
            CHTTest_Near(lo,-8.0,0.0001) andalso CHTTest_Near(hi,0.0,0.0001), _
            "min=" & str(lo) & " max=" & str(hi) & " step=" & str(st) )

        ' A SUB-UNIT STEP, where a truncating int() would land on the wrong power of ten.
        CHT_NiceRange( 0.0, 0.4, 5, lo, hi, st )
        CHTTest_Check( "NiceRange: a sub-unit range keeps a sub-unit step", _
            (st > 0.0) andalso (st < 1.0) andalso (hi >= 0.4), _
            "min=" & str(lo) & " max=" & str(hi) & " step=" & str(st) )
    end scope

    ' --- decimals and formatting ------------------------------------------------------------
    scope
        CHTTest_Check( "AutoDecimals: a step of 1 needs none", (CHT_AutoDecimals(1.0) = 0), _
                       "d=" & str(CHT_AutoDecimals(1.0)) )
        CHTTest_Check( "AutoDecimals: a step of 0.2 needs one", (CHT_AutoDecimals(0.2) = 1), _
                       "d=" & str(CHT_AutoDecimals(0.2)) )
        CHTTest_Check( "AutoDecimals: a step of 0.25 needs two", (CHT_AutoDecimals(0.25) = 2), _
                       "d=" & str(CHT_AutoDecimals(0.25)) )

        dim as string s
        s = CHT_FormatNumber( 1200.0, 0, true )
        CHTTest_Check( "FormatNumber: groups thousands", (s = "1,200"), s )
        s = CHT_FormatNumber( 1200.0, 0, false )
        CHTTest_Check( "FormatNumber: grouping is optional", (s = "1200"), s )
        s = CHT_FormatNumber( -1234.5, 1, true )
        CHTTest_Check( "FormatNumber: negative, grouped, one decimal", (s = "-1,234.5"), s )
        s = CHT_FormatNumber( 0.25, 2, false )
        CHTTest_Check( "FormatNumber: a sub-unit value keeps its leading zero", (s = "0.25"), s )
        ' THE CARRY CASE. Rounding after splitting the number gives 0.100 here.
        s = CHT_FormatNumber( 0.999, 2, false )
        CHTTest_Check( "FormatNumber: rounds before splitting, so the carry lands", (s = "1.00"), s )
        s = CHT_FormatNumber( 1000000.0, 0, true )
        CHTTest_Check( "FormatNumber: groups every three digits, not just once", (s = "1,000,000"), s )
    end scope

    if hWndParent = 0 then
        print "----- no parent HWND: geometry assertions skipped -----"
        dim as string sNo = "===== " & str(gCHT_TestCount) & " checks, " & str(gCHT_FailCount) & " failed ====="
        print sNo
        return gCHT_FailCount
    end if

    ' --- column geometry ----------------------------------------------------------------------
    scope
        dim as HWND h = CHTTest_MakeChart( hWndParent, PSCHART_TYPE_COLUMN, 700, 400 )
        if h = 0 then
            CHTTest_Check( "Column: the control was created", false, "PsChart_Create returned 0" )
        else
            PsChart_BeginUpdate( h )
            for i as long = 0 to 2
                dim as long si = PsChart_AddSeries( h, "S" & str(i) )
                PsChart_AddPoint( h, si, "Oranges",    1.0 + i )
                PsChart_AddPoint( h, si, "Apples",     4.0 + i )
                PsChart_AddPoint( h, si, "Pears",      5.0 )
                PsChart_AddPoint( h, si, "Bananas",    4.0 )
                PsChart_AddPoint( h, si, "Pineapples", 4.0 )
            next
            PsChart_EndUpdate( h )

            dim as RECT rcPlot
            PsChart_GetPlotRect( h, rcPlot )
            CHTTest_Check( "Column: the plot rect is non-empty", _
                (rcPlot.right > rcPlot.left) andalso (rcPlot.bottom > rcPlot.top), _
                CHTTest_RectStr(rcPlot) )

            dim as double vmin, vmax
            PsChart_GetValueRange( h, vmin, vmax )
            CHTTest_Check( "Column: the range is forced to include zero", (vmin <= 0.0), _
                           "min=" & str(vmin) & " max=" & str(vmax) )

            ' THE TWO ENDS OF THE MAPPING, to the pixel. An off-by-one here is invisible on a
            ' curve and unmistakable on a bar chart's baseline.
            dim as long yMin = PsChart_ValueToY( h, vmin )
            dim as long yMax = PsChart_ValueToY( h, vmax )
            CHTTest_Check( "ValueToY: the minimum lands on the plot bottom edge", _
                (yMin = rcPlot.bottom), "y=" & str(yMin) & " want " & str(rcPlot.bottom) )
            CHTTest_Check( "ValueToY: the maximum lands on the plot top edge", _
                (yMax = rcPlot.top), "y=" & str(yMax) & " want " & str(rcPlot.top) )

            dim as long nBars = 0, nInside = 0, nOnBase = 0, nOverlap = 0
            for i as long = 0 to PsChart_GetSeriesCount(h) - 1
                for j as long = 0 to PsChart_GetPointCount(h, i) - 1
                    dim as RECT rc
                    PsChart_GetPointRect( h, i, j, rc )
                    nBars += 1
                    if (rc.left >= rcPlot.left) andalso (rc.right <= rcPlot.right) andalso _
                       (rc.top >= rcPlot.top) andalso (rc.bottom <= rcPlot.bottom) then nInside += 1
                    if rc.bottom = rcPlot.bottom then nOnBase += 1
                next
            next
            CHTTest_Check( "Column: 3 series x 5 categories is 15 bars", (nBars = 15), _
                           "n=" & str(nBars) )
            CHTTest_Check( "Column: every bar lies inside the plot rect", (nInside = nBars), _
                           str(nInside) & " of " & str(nBars) )
            CHTTest_Check( "Column: every bar of an all-positive chart shares the baseline", _
                           (nOnBase = nBars), str(nOnBase) & " of " & str(nBars) )

            ' Bars within one category must not overlap each other.
            for j as long = 0 to PsChart_GetPointCount(h, 0) - 1
                for i as long = 0 to PsChart_GetSeriesCount(h) - 2
                    dim as RECT rcA, rcB
                    PsChart_GetPointRect( h, i, j, rcA )
                    PsChart_GetPointRect( h, i + 1, j, rcB )
                    if rcA.right > rcB.left then nOverlap += 1
                next
            next
            CHTTest_Check( "Column: bars within one group do not overlap", (nOverlap = 0), _
                           "overlaps=" & str(nOverlap) )

            CHTTest_Check( "Column: five short labels in 700px need no skipping", _
                           (PsChart_GetAxisLabelSkip(h) = 1), _
                           "stride=" & str(PsChart_GetAxisLabelSkip(h)) )

            DestroyWindow( h )
        end if
    end scope

    ' --- negative values -------------------------------------------------------------------------
    scope
        dim as HWND h = CHTTest_MakeChart( hWndParent, PSCHART_TYPE_COLUMN, 700, 400 )
        if h <> 0 then
            dim as long s = PsChart_AddSeries( h, "mixed" )
            PsChart_AddPoint( h, s, "a",  4.0 )
            PsChart_AddPoint( h, s, "b", -3.0 )
            PsChart_AddPoint( h, s, "c",  2.0 )

            dim as long yZero = PsChart_ValueToY( h, 0.0 )
            dim as RECT rcPos, rcNeg
            PsChart_GetPointRect( h, s, 0, rcPos )
            PsChart_GetPointRect( h, s, 1, rcNeg )

            CHTTest_Check( "Negatives: the positive bar sits wholly above the origin", _
                (rcPos.bottom <= yZero) andalso (rcPos.top < yZero), _
                CHTTest_RectStr(rcPos) & " origin=" & str(yZero) )
            CHTTest_Check( "Negatives: the negative bar sits wholly below the origin", _
                (rcNeg.top >= yZero) andalso (rcNeg.bottom > yZero), _
                CHTTest_RectStr(rcNeg) & " origin=" & str(yZero) )
            DestroyWindow( h )
        end if
    end scope

    ' --- line geometry and the auto-skip ------------------------------------------------------------
    scope
        dim as HWND h = CHTTest_MakeChart( hWndParent, PSCHART_TYPE_LINE, 700, 400 )
        if h <> 0 then
            dim as long s = PsChart_AddSeries( h, "line" )
            PsChart_BeginUpdate( h )
            ' Sixty dated categories in a 700px plot -- the HLOC reference's shape, and the
            ' case the auto-skip exists for.
            for i as long = 0 to 59
                PsChart_AddPoint( h, s, "Jan-" & str(i + 1), 1000.0 + (i mod 17) * 13.0 )
            next
            PsChart_EndUpdate( h )

            dim as RECT rcPlot
            PsChart_GetPlotRect( h, rcPlot )

            dim as long nOutside = 0
            for j as long = 0 to PsChart_GetPointCount(h, s) - 1
                dim as long y = PsChart_ValueToY( h, PsChart_GetPointValue(h, s, j) )
                if (y < rcPlot.top) orelse (y > rcPlot.bottom) then nOutside += 1
            next
            CHTTest_Check( "Line: every vertex of in-range data lands inside the plot", _
                           (nOutside = 0), "outside=" & str(nOutside) )

            dim as long stride = PsChart_GetAxisLabelSkip( h )
            CHTTest_Check( "Line: 60 dated labels in 700px force a stride above 1", _
                           (stride > 1), "stride=" & str(stride) )

            ' The stride has to be ENOUGH, not merely greater than one: two drawn labels are
            ' stride slots apart, so that width must clear the widest label.
            dim as long slotsW = clng( (rcPlot.right - rcPlot.left) / 60.0 ) * stride
            dim as long lw, lh
            CHT_MeasureText( h, 0, "Jan-60", lw, lh )
            CHTTest_Check( "Line: the stride leaves the widest label room to fit", _
                           (slotsW >= lw), "slots=" & str(slotsW) & " label=" & str(lw) )

            dim as double vmin, vmax
            PsChart_GetValueRange( h, vmin, vmax )
            dim as double perPx = (vmax - vmin) / csng(rcPlot.bottom - rcPlot.top)
            dim as double back = PsChart_YToValue( h, PsChart_ValueToY( h, 1100.0 ) )
            CHTTest_Check( "YToValue: round-trips to within a pixel", _
                           CHTTest_Near( back, 1100.0, perPx * 1.5 ), _
                           "got " & str(back) & " tol " & str(perPx * 1.5) )

            ' A LINE CHART MUST NOT FORCE ZERO into its range, or a series sitting at 1,100
            ' becomes a flat line across the top of the plot.
            CHTTest_Check( "Line: the range is not dragged down to zero", (vmin > 500.0), _
                           "min=" & str(vmin) )

            DestroyWindow( h )
        end if
    end scope

    ' --- HLOC ---------------------------------------------------------------------------------------
    scope
        dim as HWND h = CHTTest_MakeChart( hWndParent, PSCHART_TYPE_HLOC, 700, 400 )
        if h <> 0 then
            dim as long s = PsChart_AddSeries( h, "ohlc" )
            PsChart_AddHlocPoint( h, s, "d1", 1020.0, 1080.0, 1000.0, 1060.0 )
            PsChart_AddHlocPoint( h, s, "d2", 1060.0, 1100.0, 1040.0, 1050.0 )
            PsChart_AddHlocPoint( h, s, "d3", 1050.0, 1070.0,  990.0, 1010.0 )

            dim as double vmin, vmax
            PsChart_GetValueRange( h, vmin, vmax )
            ' The range must come from LOW and HIGH. Taking it from the close would clip the
            ' wick, which is the one thing this chart exists to show.
            CHTTest_Check( "HLOC: the range covers the lowest low", (vmin <= 990.0), _
                           "min=" & str(vmin) )
            CHTTest_Check( "HLOC: the range covers the highest high", (vmax >= 1100.0), _
                           "max=" & str(vmax) )

            dim as RECT rcPlot, rcBand
            PsChart_GetPlotRect( h, rcPlot )
            PsChart_GetPointRect( h, s, 0, rcBand )
            dim as long yHi = PsChart_ValueToY( h, 1080.0 )
            dim as long yLo = PsChart_ValueToY( h, 1000.0 )
            CHTTest_Check( "HLOC: the hit band spans high to low", _
                (rcBand.top = yHi) andalso (rcBand.bottom = yLo), _
                CHTTest_RectStr(rcBand) & " want top=" & str(yHi) & " bottom=" & str(yLo) )
            ' The band is the whole slot, not the wick: a two-pixel target is not clickable.
            CHTTest_Check( "HLOC: the hit band is a full slot wide", _
                           ((rcBand.right - rcBand.left) > 10), _
                           "w=" & str(rcBand.right - rcBand.left) )
            DestroyWindow( h )
        end if
    end scope

    ' --- pie -------------------------------------------------------------------------------------------
    scope
        dim as HWND h = CHTTest_MakeChart( hWndParent, PSCHART_TYPE_PIE, 400, 400 )
        if h <> 0 then
            dim as long s = PsChart_AddSeries( h, "pie" )
            dim as double vals(0 to 4) = { 4.0, 4.0, 1.0, 4.0, 2.0 }
            for i as long = 0 to 4
                PsChart_AddPoint( h, s, "P" & str(i), vals(i) )
            next

            dim as RECT rcDummy
            PsChart_GetPlotRect( h, rcDummy )        ' forces the layout

            dim as PSCHART_STATE ptr pChart = GetChartPointer( h )
            dim as double total = 0.0
            for i as long = 0 to 4
                total += pChart->series(0).points(i).fSweep
            next
            CHTTest_Check( "Pie: the sweeps sum to a full circle", _
                           CHTTest_Near( total, 360.0, 0.01 ), "sum=" & str(total) )

            CHTTest_Check( "Pie: the first slice starts at 12 o clock", _
                           CHTTest_Near( pChart->series(0).points(0).fStart, -90.0, 0.01 ), _
                           "start=" & str(pChart->series(0).points(0).fStart) )

            ' Proportionality: a value of 1 out of 15 is 24 degrees.
            CHTTest_Check( "Pie: a slice sweep is its share of the total", _
                           CHTTest_Near( pChart->series(0).points(2).fSweep, 24.0, 0.01 ), _
                           "sweep=" & str(pChart->series(0).points(2).fSweep) )

            ' HIT TEST AT EACH SLICE CENTROID. This is the assertion that ties the angle
            ' arithmetic to the thing a user actually points at.
            const PI_ = 3.14159265358979323846
            dim as long cx = (pChart->rcPie.left + pChart->rcPie.right) \ 2
            dim as long cy = (pChart->rcPie.top + pChart->rcPie.bottom) \ 2
            dim as single radius = csng( pChart->rcPie.right - pChart->rcPie.left ) / 2.0
            dim as long nHit = 0
            for k as long = 0 to 4
                dim as double midDeg = pChart->series(0).points(k).fStart + _
                                    pChart->series(0).points(k).fSweep / 2.0
                dim as double r = midDeg * PI_ / 180.0
                dim as long px = cx + clng( cos(r) * radius * 0.5 )
                dim as long py = cy + clng( sin(r) * radius * 0.5 )
                dim as long iSer, iPt
                if PsChart_HitTest( h, px, py, iSer, iPt ) then
                    if iPt = k then nHit += 1
                end if
            next
            CHTTest_Check( "Pie: hit-testing each slice centroid names that slice", _
                           (nHit = 5), str(nHit) & " of 5" )

            dim as long iS2, iP2
            dim as boolean bOut = PsChart_HitTest( h, pChart->rcPie.right + 20, cy, iS2, iP2 )
            CHTTest_Check( "Pie: a point beyond the rim hits nothing", _
                           (bOut = false) andalso (iP2 = -1), _
                           "hit=" & str(bOut) & " idx=" & str(iP2) )

            ' The doughnut hole is a hole for the hit test too, not only for the eye.
            PsChart_SetDoughnutRatio( h, 0.5 )
            PsChart_GetPlotRect( h, rcDummy )
            dim as long iS3, iP3
            dim as boolean bHole = PsChart_HitTest( h, cx, cy, iS3, iP3 )
            CHTTest_Check( "Doughnut: the hole hits nothing", (bHole = false), _
                           "hit=" & str(bHole) )

            DestroyWindow( h )
        end if
    end scope

    ' --- layout robustness --------------------------------------------------------------------------------
    scope
        ' A 0x0 client is the state EVERY control is created in, before the host sizes it.
        ' Laying out against it must re-arm rather than produce rects of nonsense.
        dim as HWND h = PsChart_Create( hWndParent, 9001, PSCHART_TYPE_COLUMN )
        if h <> 0 then
            ShowWindow( h, SW_HIDE )
            dim as PSCHART_STATE ptr pChart = GetChartPointer( h )
            pChart->bLayoutDirty = false
            pChart->LayoutChart()
            CHTTest_Check( "Layout: a 0x0 client re-arms the dirty flag instead of laying out", _
                           (pChart->bLayoutDirty = true), "dirty=" & str(pChart->bLayoutDirty) )

            SetWindowPos( h, 0, 0, 0, 300, 200, SWP_NOZORDER or SWP_NOACTIVATE )
            dim as RECT rc
            dim as boolean bGot = PsChart_GetPlotRect( h, rc )
            CHTTest_Check( "Layout: an empty chart still produces a plot rect", _
                           bGot andalso (rc.right > rc.left), CHTTest_RectStr(rc) )
            dim as long iSer, iPt
            CHTTest_Check( "HitTest: an empty chart answers nothing and does not fault", _
                           (PsChart_HitTest( h, 50, 50, iSer, iPt ) = false), "idx=" & str(iPt) )
            DestroyWindow( h )
        end if
    end scope

    ' --- the renderer actually renders -----------------------------------------------------------------------
    scope
        dim as HWND h = CHTTest_MakeChart( hWndParent, PSCHART_TYPE_COLUMN, 700, 400 )
        if h <> 0 then
            dim as long nEmpty = PsChart_CountRenderedTones( h )
            dim as ulong hashNoData = PsChart_HashRenderedPart( h )

            dim as long s = PsChart_AddSeries( h, "s" )
            PsChart_AddPoint( h, s, "a", 3.0 )
            PsChart_AddPoint( h, s, "b", 7.0 )
            PsChart_AddPoint( h, s, "c", 5.0 )

            dim as long nData = PsChart_CountRenderedTones( h )
            dim as ulong hashWithData = PsChart_HashRenderedPart( h )

            ' THE POINT OF THESE. A probe that passed while the painter drew a flat rectangle
            ' has shipped in this family before; a tone count that does not rise when data
            ' arrives is exactly that failure, caught.
            CHTTest_Check( "Render: an empty chart still draws its chrome", (nEmpty >= 2), _
                           "tones=" & str(nEmpty) )
            CHTTest_Check( "Render: adding data adds tones to the surface", (nData > nEmpty), _
                           "empty=" & str(nEmpty) & " data=" & str(nData) )
            CHTTest_Check( "Render: the surface hash changes when the data does", _
                           (hashWithData <> hashNoData), _
                           "empty=" & hex(hashNoData) & " data=" & hex(hashWithData) )

            ' And it must be REPEATABLE, or every comparison above is noise.
            dim as ulong hashAgain = PsChart_HashRenderedPart( h )
            CHTTest_Check( "Render: the same state hashes the same twice", _
                           (hashAgain = hashWithData), _
                           "a=" & hex(hashWithData) & " b=" & hex(hashAgain) )
            DestroyWindow( h )
        end if
    end scope

    ' --- per-series line style -------------------------------------------------------------------------------
    ' The whole claim being tested is "a dashed series is distinguishable from a solid one at
    ' the width a chart actually uses", and the only honest measurement of that is the ink:
    ' identical geometry, fewer set pixels. A hash comparison would only prove the picture
    ' changed, which a colour change would prove equally well.
    scope
        dim as HWND h = CHTTest_MakeChart( hWndParent, PSCHART_TYPE_LINE, 700, 400 )
        if h <> 0 then
            dim as PSCHART_COLORS clrs
            PsChart_GetColors( h, @clrs )

            dim as long s = PsChart_AddSeries( h, "s" )
            ' A zig-zag rather than a ramp: a dash pattern that only ever met one slope would
            ' not exercise the join, and the joins are where a dashed polyline goes wrong.
            for j as long = 0 to 11
                PsChart_AddPoint( h, s, str(j), iif( (j mod 2) = 0, 10.0, 40.0 ) )
            next
            PsChart_SetSeriesLineWidth( h, s, 2 )

            dim as boolean bDefSolid = (PsChart_GetSeriesLineStyle( h, s ) = CHT_LINE_SOLID)

            ' Geometry must not move. Captured before the style changes and compared after,
            ' because "fewer pixels" only means "dashed" if the line is in the same place.
            dim as RECT rcBefore
            PsChart_GetPointRect( h, s, 5, rcBefore )

            dim as long inkSolid = PsChart_CountPlotInkPixels( h, clrs.PlotBackColor )

            PsChart_SetSeriesLineStyle( h, s, CHT_LINE_DASH )
            dim as long inkDash = PsChart_CountPlotInkPixels( h, clrs.PlotBackColor )

            PsChart_SetSeriesLineStyle( h, s, CHT_LINE_DOT )
            dim as long inkDot = PsChart_CountPlotInkPixels( h, clrs.PlotBackColor )

            PsChart_SetSeriesLineStyle( h, s, CHT_LINE_DASHDOT )
            dim as long inkDashDot = PsChart_CountPlotInkPixels( h, clrs.PlotBackColor )

            dim as RECT rcAfter
            PsChart_GetPointRect( h, s, 5, rcAfter )

            CHTTest_Check( "LineStyle: a new series defaults to solid", bDefSolid, _
                           "default=" & str(CHT_LINE_SOLID) )
            CHTTest_Check( "LineStyle: a dashed series draws less ink than the solid one", _
                           (inkDash < inkSolid) andalso (inkDash > 0), _
                           "solid=" & str(inkSolid) & " dash=" & str(inkDash) )
            CHTTest_Check( "LineStyle: a dotted series draws less ink again", _
                           (inkDot < inkDash) andalso (inkDot > 0), _
                           "dash=" & str(inkDash) & " dot=" & str(inkDot) )
            CHTTest_Check( "LineStyle: dash-dot lands between dot and dash", _
                           (inkDashDot > inkDot) andalso (inkDashDot < inkSolid), _
                           "dot=" & str(inkDot) & " dashdot=" & str(inkDashDot) & " solid=" & str(inkSolid) )
            CHTTest_Check( "LineStyle: the style does not move the geometry", _
                           EqualRect( @rcBefore, @rcAfter ) <> 0, _
                           CHTTest_RectStr(rcBefore) & " vs " & CHTTest_RectStr(rcAfter) )

            PsChart_SetSeriesLineStyle( h, s, 999 )
            CHTTest_Check( "LineStyle: an unrecognised style is stored as solid", _
                           (PsChart_GetSeriesLineStyle( h, s ) = CHT_LINE_SOLID), _
                           "style=" & str(PsChart_GetSeriesLineStyle( h, s )) )
            CHTTest_Check( "LineStyle: an out-of-range series answers solid and does not fault", _
                           (PsChart_SetSeriesLineStyle( h, 99, CHT_LINE_DASH ) = false) andalso _
                           (PsChart_GetSeriesLineStyle( h, 99 ) = CHT_LINE_SOLID), _
                           "rejected" )

            DestroyWindow( h )
        end if
    end scope

    ' --- area fill under a series ----------------------------------------------------------------------------
    ' Asserted by SAMPLING NAMED PIXELS, not by eye. A flat series at a known value has a known
    ' baseline and a known top edge, so "inside the fill" and "above the fill" are arithmetic.
    scope
        dim as HWND h = CHTTest_MakeChart( hWndParent, PSCHART_TYPE_LINE, 700, 400 )
        if h <> 0 then
            dim as PSCHART_COLORS clrs
            PsChart_GetColors( h, @clrs )

            ' A FLAT series, on purpose: every x has the same y, so one sample stands for the
            ' whole run and no assertion below depends on where along it we looked.
            dim as long s = PsChart_AddSeries( h, "s" )
            for j as long = 0 to 9
                PsChart_AddPoint( h, s, str(j), 50.0 )
            next
            ' Fixed range, so the baseline is the plot bottom and the line is exactly halfway
            ' up it -- autoscaling a flat series would pick a range this test cannot predict.
            PsChart_SetValueRange( h, 0.0, 100.0 )

            dim as RECT rcPlot
            PsChart_GetPlotRect( h, rcPlot )
            dim as long yLine = PsChart_ValueToY( h, 50.0 )
            dim as long xMid  = (rcPlot.left + rcPlot.right) \ 2
            ' Well clear of the line's own 2px stroke in both directions.
            dim as long yIn   = (yLine + rcPlot.bottom) \ 2      ' under the line, in the fill
            dim as long yOut  = (rcPlot.top + yLine) \ 2         ' above the line, outside it

            dim as long tonesBefore = PsChart_CountRenderedTones( h )
            dim as COLORREF cInBefore = PsChart_GetRenderedPixel( h, xMid, yIn )

            PsChart_SetSeriesFill( h, s, BGR(0,160,255), 128 )

            dim as long tonesAfter = PsChart_CountRenderedTones( h )
            dim as COLORREF cIn  = PsChart_GetRenderedPixel( h, xMid, yIn )
            dim as COLORREF cOut = PsChart_GetRenderedPixel( h, xMid, yOut )

            CHTTest_Check( "Fill: a fill adds tones to the surface", (tonesAfter > tonesBefore), _
                           "before=" & str(tonesBefore) & " after=" & str(tonesAfter) )
            CHTTest_Check( "Fill: a pixel between the line and the baseline changed colour", _
                           (cIn <> cInBefore), "was=" & hex(cInBefore) & " now=" & hex(cIn) )
            CHTTest_Check( "Fill: a pixel ABOVE the line did not -- the fill stops at the line", _
                           (cOut = clrs.PlotBackColor), _
                           "y=" & str(yOut) & " got=" & hex(cOut) & " want=" & hex(clrs.PlotBackColor) )
            ' 128 alpha over the dark default background must land BETWEEN the two, which is
            ' what proves the alpha was honoured rather than the colour painted flat.
            CHTTest_Check( "Fill: the fill is translucent, not the flat colour asked for", _
                           (cIn <> BGR(0,160,255)) andalso (cIn <> clrs.PlotBackColor), _
                           "got=" & hex(cIn) & " opaque would be " & hex(BGR(0,160,255)) )

            PsChart_ClearSeriesFill( h, s )
            dim as COLORREF cCleared = PsChart_GetRenderedPixel( h, xMid, yIn )
            CHTTest_Check( "Fill: ClearSeriesFill puts the background back", _
                           (cCleared = cInBefore), _
                           "was=" & hex(cInBefore) & " now=" & hex(cCleared) )

            CHTTest_Check( "Fill: an out-of-range series is rejected and does not fault", _
                           (PsChart_SetSeriesFill( h, 99, BGR(255,0,0), 128 ) = false) andalso _
                           (PsChart_ClearSeriesFill( h, 99 ) = false), "rejected" )

            DestroyWindow( h )
        end if
    end scope

    ' --- a filled band between two series --------------------------------------------------------------------
    ' Two FLAT series at known values over a fixed range, so "between them" and "outside them"
    ' are pixel rows this test computes rather than recognises. That is the whole assertion: a
    ' band that leaked past its own edges, or one that covered the lines it brackets, would
    ' pass any check that only asked whether the picture changed.
    scope
        dim as HWND h = CHTTest_MakeChart( hWndParent, PSCHART_TYPE_LINE, 700, 400 )
        if h <> 0 then
            dim as PSCHART_COLORS clrs
            PsChart_GetColors( h, @clrs )

            dim as long sLo = PsChart_AddSeries( h, "lo" )
            dim as long sHi = PsChart_AddSeries( h, "hi" )
            for j as long = 0 to 9
                PsChart_AddPoint( h, sLo, str(j), 30.0 )
                PsChart_AddPoint( h, sHi, str(j), 70.0 )
            next
            PsChart_SetValueRange( h, 0.0, 100.0 )

            dim as RECT rcPlot
            PsChart_GetPlotRect( h, rcPlot )
            dim as long yLo = PsChart_ValueToY( h, 30.0 )       ' lower on screen = larger y
            dim as long yHi = PsChart_ValueToY( h, 70.0 )
            dim as long xMid = (rcPlot.left + rcPlot.right) \ 2
            dim as long yMid = (yHi + yLo) \ 2                   ' squarely between the two
            dim as long yAbove = (rcPlot.top + yHi) \ 2          ' above the high series
            dim as long yBelow = (yLo + rcPlot.bottom) \ 2       ' below the low series

            dim as COLORREF cMidBefore   = PsChart_GetRenderedPixel( h, xMid, yMid )
            dim as long     inkBefore    = PsChart_CountPlotInkPixels( h, clrs.PlotBackColor )

            dim as boolean bSet = PsChart_SetSeriesBand( h, sLo, sHi, BGR(255,170,0), 110 )

            dim as COLORREF cMid   = PsChart_GetRenderedPixel( h, xMid, yMid )
            dim as COLORREF cAbove = PsChart_GetRenderedPixel( h, xMid, yAbove )
            dim as COLORREF cBelow = PsChart_GetRenderedPixel( h, xMid, yBelow )
            dim as long     inkAfter = PsChart_CountPlotInkPixels( h, clrs.PlotBackColor )

            CHTTest_Check( "Band: setting one over two valid series succeeds", bSet, "set=" & str(bSet) )
            CHTTest_Check( "Band: a pixel BETWEEN the two series is filled", _
                           (cMid <> cMidBefore) andalso (cMid <> clrs.PlotBackColor), _
                           "y=" & str(yMid) & " was=" & hex(cMidBefore) & " now=" & hex(cMid) )
            CHTTest_Check( "Band: a pixel ABOVE the high series is untouched", _
                           (cAbove = clrs.PlotBackColor), _
                           "y=" & str(yAbove) & " got=" & hex(cAbove) )
            CHTTest_Check( "Band: a pixel BELOW the low series is untouched", _
                           (cBelow = clrs.PlotBackColor), _
                           "y=" & str(yBelow) & " got=" & hex(cBelow) )
            CHTTest_Check( "Band: the fill is translucent, not the flat colour asked for", _
                           (cMid <> BGR(255,170,0)), _
                           "got=" & hex(cMid) & " opaque would be " & hex(BGR(255,170,0)) )
            ' HOW FAR ALONG X the ribbon runs. A polyline starts at the first category's slot
            ' CENTRE and ends at the last one's, not at the plot's edges, so the band's extent
            ' is derived from the vertices rather than from rcPlot.
            dim as RECT rcP0, rcP9
            PsChart_GetPointRect( h, sHi, 0, rcP0 )
            PsChart_GetPointRect( h, sHi, 9, rcP9 )
            dim as long xFirst = (rcP0.left + rcP0.right) \ 2
            dim as long xLast  = (rcP9.left + rcP9.right) \ 2

            CHTTest_Check( "Band: it reaches the first vertex", _
                           (PsChart_GetRenderedPixel( h, xFirst + 3, yMid ) = cMid), _
                           "x=" & str(xFirst + 3) )
            CHTTest_Check( "Band: it reaches the last vertex", _
                           (PsChart_GetRenderedPixel( h, xLast - 3, yMid ) = cMid), _
                           "x=" & str(xLast - 3) )
            CHTTest_Check( "Band: it stops there -- the plot left of the first vertex is clear", _
                           (PsChart_GetRenderedPixel( h, xFirst - 8, yMid ) = clrs.PlotBackColor), _
                           "x=" & str(xFirst - 8) & " got=" & hex(PsChart_GetRenderedPixel( h, xFirst - 8, yMid )) )

            ' And it is a solid ribbon, not an outline or a sliver. The bound is 80% of the
            ' rectangle the band must contain, deliberately loose in ONE direction only:
            ' gridlines and the two series had already inked part of that area before the band
            ' arrived, so those pixels cannot be "gained" twice, and the edges antialias.
            dim as long areaMin = clng( (xLast - xFirst) * (yLo - yHi) * 0.8 )
            CHTTest_Check( "Band: it fills the whole ribbon, not a sliver of it", _
                           (inkAfter - inkBefore) >= areaMin, _
                           "gained=" & str(inkAfter - inkBefore) & " need>=" & str(areaMin) )

            ' THE Z-ORDER CLAIM. The two lines must still be on top of the band they bracket.
            ' Sampled ON the high series' own row, which must be neither the band's tint nor
            ' the background -- it must be the series' pen.
            dim as COLORREF cOnLine = PsChart_GetRenderedPixel( h, xMid, yHi )
            CHTTest_Check( "Band: the bracketed lines are drawn OVER the band, not under it", _
                           (cOnLine <> cMid) andalso (cOnLine <> clrs.PlotBackColor), _
                           "online=" & hex(cOnLine) & " band=" & hex(cMid) )

            ' Identity is the PAIR, in either order.
            PsChart_SetSeriesBand( h, sLo, sHi, BGR(0,255,0), 110 )
            CHTTest_Check( "Band: re-setting the same pair replaces it rather than stacking", _
                           (PsChart_GetRenderedPixel( h, xMid, yMid ) <> cMid), "replaced" )
            CHTTest_Check( "Band: clearing takes the pair in the opposite order", _
                           PsChart_ClearSeriesBand( h, sHi, sLo ), "cleared" )
            CHTTest_Check( "Band: clearing puts the background back exactly", _
                           (PsChart_GetRenderedPixel( h, xMid, yMid ) = cMidBefore), _
                           "now=" & hex(PsChart_GetRenderedPixel( h, xMid, yMid )) )
            CHTTest_Check( "Band: clearing one that is not there reports false", _
                           (PsChart_ClearSeriesBand( h, sHi, sLo ) = false), "no-op" )
            CHTTest_Check( "Band: a series banded against itself is rejected", _
                           (PsChart_SetSeriesBand( h, sLo, sLo, BGR(255,0,0), 128 ) = false), _
                           "rejected" )
            CHTTest_Check( "Band: an out-of-range series is rejected and does not fault", _
                           (PsChart_SetSeriesBand( h, sLo, 99, BGR(255,0,0), 128 ) = false), _
                           "rejected" )

            ' A hidden edge suppresses the band but must not destroy it -- unhiding brings the
            ' same picture back, or a legend click would silently eat the host's setup.
            PsChart_SetSeriesBand( h, sLo, sHi, BGR(255,170,0), 110 )
            PsChart_SetSeriesVisible( h, sHi, false )
            dim as COLORREF cHidden = PsChart_GetRenderedPixel( h, xMid, yMid )
            PsChart_SetSeriesVisible( h, sHi, true )
            dim as COLORREF cRestored = PsChart_GetRenderedPixel( h, xMid, yMid )
            CHTTest_Check( "Band: hiding an edge suppresses the band", _
                           (cHidden <> cMid), "hidden=" & hex(cHidden) )
            CHTTest_Check( "Band: unhiding it brings the same band back", _
                           (cRestored = cMid), "restored=" & hex(cRestored) & " want=" & hex(cMid) )

            DestroyWindow( h )
        end if
    end scope

    ' --- stacked columns --------------------------------------------------------------------------------------
    scope
        dim as HWND h = CHTTest_MakeChart( hWndParent, PSCHART_TYPE_COLUMN, 700, 400 )
        if h <> 0 then
            ' Three series over four categories. The totals differ per category on purpose,
            ' so a range taken from the tallest SINGLE value could not accidentally be right.
            dim as double v(0 to 2, 0 to 3) = { _
                    { 2, 5, 1, 3 }, _
                    { 4, 2, 6, 1 }, _
                    { 3, 1, 2, 8 } }
            dim as double totals(0 to 3) = { 9, 8, 9, 12 }
            for i as long = 0 to 2
                dim as long s = PsChart_AddSeries( h, "s" & str(i) )
                for j as long = 0 to 3
                    PsChart_AddPoint( h, s, "c" & str(j), v(i, j) )
                next
            next

            CHTTest_Check( "Stacked: a column chart defaults to grouped", _
                           (PsChart_GetColumnMode( h ) = CHT_COL_GROUPED), _
                           "mode=" & str(PsChart_GetColumnMode( h )) )

            ' Grouped first, so the stacked numbers below are compared against a real before.
            dim as RECT rcG0, rcG1
            PsChart_GetPointRect( h, 0, 3, rcG0 )
            PsChart_GetPointRect( h, 1, 3, rcG1 )
            dim as boolean bSideBySide = (rcG0.right <= rcG1.left)

            PsChart_SetColumnMode( h, CHT_COL_STACKED )
            CHTTest_Check( "Stacked: the mode reads back", _
                           (PsChart_GetColumnMode( h ) = CHT_COL_STACKED), "mode=stacked" )

            dim as double fLo, fHi
            PsChart_GetValueRange( h, fLo, fHi )
            ' The tallest single value is 8 and the tallest STACK is 12. A range that stopped
            ' short of 12 would draw a stack running off the top of its own plot.
            CHTTest_Check( "Stacked: the axis scales to the stack total, not the tallest bar", _
                           (fHi >= 12.0), "max=" & str(fHi) & " tallest stack=12 tallest bar=8" )
            CHTTest_Check( "Stacked: the axis still includes zero", (fLo <= 0.0), "min=" & str(fLo) )

            ' Category 3: segments of 3, 1 and 8 piled up from the baseline.
            dim as RECT rc0, rc1, rc2
            PsChart_GetPointRect( h, 0, 3, rc0 )
            PsChart_GetPointRect( h, 1, 3, rc1 )
            PsChart_GetPointRect( h, 2, 3, rc2 )

            CHTTest_Check( "Stacked: grouped really was side by side, so this is a change", _
                           bSideBySide, "grouped " & CHTTest_RectStr(rcG0) & " " & CHTTest_RectStr(rcG1) )
            CHTTest_Check( "Stacked: every segment of a category shares one bar's width", _
                           (rc0.left = rc1.left) andalso (rc1.left = rc2.left) andalso _
                           (rc0.right = rc1.right) andalso (rc1.right = rc2.right), _
                           CHTTest_RectStr(rc0) & " " & CHTTest_RectStr(rc1) & " " & CHTTest_RectStr(rc2) )
            CHTTest_Check( "Stacked: the first segment stands on the baseline", _
                           (rc0.bottom = PsChart_ValueToY( h, 0.0 )), _
                           "bottom=" & str(rc0.bottom) & " origin=" & str(PsChart_ValueToY( h, 0.0 )) )
            ' CONTIGUOUS, to the pixel. A gap or an overlap here is the classic stacked-bar
            ' defect and it is invisible at a glance.
            CHTTest_Check( "Stacked: segment 2 starts exactly where segment 1 ended", _
                           (rc1.bottom = rc0.top), _
                           "s1.top=" & str(rc0.top) & " s2.bottom=" & str(rc1.bottom) )
            CHTTest_Check( "Stacked: segment 3 starts exactly where segment 2 ended", _
                           (rc2.bottom = rc1.top), _
                           "s2.top=" & str(rc1.top) & " s3.bottom=" & str(rc2.bottom) )
            CHTTest_Check( "Stacked: the top of the stack is the total's own pixel row", _
                           (rc2.top = PsChart_ValueToY( h, totals(3) )), _
                           "top=" & str(rc2.top) & " want=" & str(PsChart_ValueToY( h, totals(3) )) )

            ' HIT TESTING NAMES THE SEGMENT, not the stack. Sampled at each segment's own
            ' vertical middle, which is arithmetic on the rects above and not a guess.
            dim as long xMid = (rc1.left + rc1.right) \ 2
            dim as long iSer, iPt
            dim as boolean bHit1 = PsChart_HitTest( h, xMid, (rc1.top + rc1.bottom) \ 2, iSer, iPt )
            CHTTest_Check( "Stacked: a click in the middle segment names the middle series", _
                           bHit1 andalso (iSer = 1) andalso (iPt = 3), _
                           "series=" & str(iSer) & " point=" & str(iPt) )
            dim as boolean bHit2 = PsChart_HitTest( h, xMid, (rc2.top + rc2.bottom) \ 2, iSer, iPt )
            CHTTest_Check( "Stacked: a click in the top segment names the top series", _
                           bHit2 andalso (iSer = 2) andalso (iPt = 3), _
                           "series=" & str(iSer) & " point=" & str(iPt) )
            dim as boolean bHit0 = PsChart_HitTest( h, xMid, rc0.bottom - 2, iSer, iPt )
            CHTTest_Check( "Stacked: a click just above the baseline names the bottom series", _
                           bHit0 andalso (iSer = 0) andalso (iPt = 3), _
                           "series=" & str(iSer) & " point=" & str(iPt) )

            ' A hidden series must leave the stack AND the range, not just stop drawing --
            ' the same rule the grouped path already keeps.
            PsChart_SetSeriesVisible( h, 2, false )
            dim as double fLo2, fHi2
            PsChart_GetValueRange( h, fLo2, fHi2 )
            dim as RECT rcH1
            PsChart_GetPointRect( h, 1, 3, rcH1 )
            CHTTest_Check( "Stacked: hiding a series shrinks the axis to the new totals", _
                           (fHi2 < fHi), "was=" & str(fHi) & " now=" & str(fHi2) )
            CHTTest_Check( "Stacked: the survivors close up rather than leaving a hole", _
                           (rcH1.bottom = PsChart_ValueToY( h, v(0, 3) )), _
                           "bottom=" & str(rcH1.bottom) & " want=" & str(PsChart_ValueToY( h, v(0, 3) )) )
            PsChart_SetSeriesVisible( h, 2, true )

            CHTTest_Check( "Stacked: an unrecognised mode falls back to grouped", _
                           PsChart_SetColumnMode( h, 77 ) andalso _
                           (PsChart_GetColumnMode( h ) = CHT_COL_GROUPED), "grouped" )

            DestroyWindow( h )
        end if
    end scope

    ' Negatives stack DOWN from the baseline while positives stack up, so a category holding
    ' both reads as two piles meeting at zero instead of one pile that cancels itself out.
    scope
        dim as HWND h = CHTTest_MakeChart( hWndParent, PSCHART_TYPE_COLUMN, 700, 400 )
        if h <> 0 then
            dim as long s0 = PsChart_AddSeries( h, "up" )
            dim as long s1 = PsChart_AddSeries( h, "down" )
            dim as long s2 = PsChart_AddSeries( h, "up2" )
            PsChart_AddPoint( h, s0, "c0",  4.0 )
            PsChart_AddPoint( h, s1, "c0", -6.0 )
            PsChart_AddPoint( h, s2, "c0",  3.0 )
            PsChart_SetColumnMode( h, CHT_COL_STACKED )

            dim as long yZero = PsChart_ValueToY( h, 0.0 )
            dim as RECT rcUp, rcDown, rcUp2
            PsChart_GetPointRect( h, s0, 0, rcUp )
            PsChart_GetPointRect( h, s1, 0, rcDown )
            PsChart_GetPointRect( h, s2, 0, rcUp2 )

            CHTTest_Check( "Stacked negatives: the positive segment sits above the baseline", _
                           (rcUp.bottom = yZero) andalso (rcUp.top < yZero), _
                           CHTTest_RectStr(rcUp) & " zero=" & str(yZero) )
            CHTTest_Check( "Stacked negatives: the negative segment hangs below it", _
                           (rcDown.top = yZero) andalso (rcDown.bottom > yZero), _
                           CHTTest_RectStr(rcDown) & " zero=" & str(yZero) )
            CHTTest_Check( "Stacked negatives: the second positive stacks on the first, not on zero", _
                           (rcUp2.bottom = rcUp.top), _
                           "up.top=" & str(rcUp.top) & " up2.bottom=" & str(rcUp2.bottom) )

            dim as double fLo, fHi
            PsChart_GetValueRange( h, fLo, fHi )
            CHTTest_Check( "Stacked negatives: the range covers both piles, not their net", _
                           (fHi >= 7.0) andalso (fLo <= -6.0), _
                           "min=" & str(fLo) & " max=" & str(fHi) & " net would be -1" )

            DestroyWindow( h )
        end if
    end scope

    dim as string sSum = "===== " & str(gCHT_TestCount) & " checks, " & str(gCHT_FailCount) & " failed ====="
    print sSum
    return gCHT_FailCount
end function
