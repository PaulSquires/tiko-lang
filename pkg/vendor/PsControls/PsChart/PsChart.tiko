    if pChart = 0 then exit sub
    pChart->nDecimals = nDecimals
    pChart->bThousands = bThousands
    ' A full Refresh, not just an invalidate: the label widths change and the Y gutter is
    ' measured from them.
    pChart->Refresh()
end sub

