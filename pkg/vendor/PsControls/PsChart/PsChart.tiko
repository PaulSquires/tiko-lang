public declare sub      PsChart_GetValueRange( byval hChart as HWND, byref fLo as double, byref fHi as double )
public declare sub      PsChart_SetTickCountHint( byval hChart as HWND, byval nTicks as long )
public declare sub      PsChart_SetGridLines( byval hChart as HWND, byval bHorz as boolean, byval bVert as boolean )
