''
''  vendor/PsControls/PsTheme  --  the shared theme: semantic colour roles and presets
''

#module "PsTheme"

#import "sys/win"
#import "sys/win/gui"
 
' A theme is a set of semantic ROLES, not a colour per control field. Every control has an
' adapter, Ps<X>_ThemeColors( t ), that derives its own colour set from the roles, and
' Ps<X>_ApplyTheme( h, t ) that applies it -- unless the program set that control's colours
' itself, which PINS them (Ps<X>_UnpinColors hands it back).
'
' PsTheme_Dark() is the family's built-in look: every control's default colours are dark, and
' the Dark preset is those defaults expressed as roles (a control whose defaults use a shade the
' roles do not have moves to the nearest role; RFC-0001 appendix A lists the differences).
' PsTheme_Light() is new. PsTheme_System() follows the Windows app mode (Settings > Colours).
'
' The registry (vendor/PsControls/PsRegistry) holds the current theme and applies it to every
' registered control; vendor/PsControls/PsApp switches it.

public type PSTHEME_COLORS
    IsDark          as boolean
    Window          as COLORREF     ' form background; controls that sit flat on it
    Surface         as COLORREF     ' control face: buttons, fields, bars
    SurfaceHot      as COLORREF     ' face under the mouse
    SurfaceDisabled as COLORREF
    Text            as COLORREF
    TextHot         as COLORREF     ' text under the mouse
    TextStrong      as COLORREF     ' titles, pressed and emphasised text
    TextDim         as COLORREF     ' secondary text: captions, labels, placeholders
    TextDisabled    as COLORREF
    Accent          as COLORREF     ' checked / on / progress / today
    AccentHot       as COLORREF
    FocusRing       as COLORREF     ' focus rings and focused borders
    Border          as COLORREF
    BorderDisabled  as COLORREF
    Divider         as COLORREF     ' separators, grid lines, hairlines
    Selected        as COLORREF     ' selection and pressed fill
    SelectedText    as COLORREF
    Popup           as COLORREF     ' menus, dropdowns, tooltips
    PopupText       as COLORREF
    Track           as COLORREF     ' the unfilled part of a track: toggle off, progress
    Success         as COLORREF
    Warning         as COLORREF
    Error           as COLORREF
end type

public function PsTheme_Dark( ) as PSTHEME_COLORS
    dim as PSTHEME_COLORS t
    t.IsDark          = true
    t.Window          = BGR( 33, 37, 43)
    t.Surface         = BGR( 44, 49, 58)
    t.SurfaceHot      = BGR( 55, 61, 72)
    t.SurfaceDisabled = BGR( 40, 44, 51)
    t.Text            = BGR(200,205,214)
    t.TextHot         = BGR(226,230,238)
    t.TextStrong      = BGR(255,255,255)
    t.TextDim         = BGR(150,156,166)
    t.TextDisabled    = BGR( 96,102,112)
    t.Accent          = BGR( 86,156,214)
    t.AccentHot       = BGR(122,180,230)
    t.FocusRing       = BGR( 97,175,239)
    t.Border          = BGR( 68,74, 86)
    t.BorderDisabled  = BGR( 48, 52, 60)
    t.Divider         = BGR( 55, 60, 69)
    t.Selected        = BGR( 38, 79,120)
    t.SelectedText    = BGR(255,255,255)
    t.Popup           = BGR( 44, 49, 58)
    t.PopupText       = BGR(212,217,226)
    t.Track           = BGR( 51, 55, 63)
    t.Success         = BGR( 72,151, 13)
    t.Warning         = BGR(229,192,123)
    t.Error           = BGR(224,108,117)
    return t
end function

public function PsTheme_Light( ) as PSTHEME_COLORS
    dim as PSTHEME_COLORS t
    t.IsDark          = false
    t.Window          = BGR(243,243,243)
    t.Surface         = BGR(255,255,255)
    t.SurfaceHot      = BGR(229,241,251)
    t.SurfaceDisabled = BGR(240,240,240)
    t.Text            = BGR( 32, 32, 32)
    t.TextHot         = BGR(  0,  0,  0)
    t.TextStrong      = BGR(  0,  0,  0)
    t.TextDim         = BGR( 96, 96, 96)
    t.TextDisabled    = BGR(160,160,160)
    t.Accent          = BGR(  0,120,215)
    t.AccentHot       = BGR( 25,140,230)
    t.FocusRing       = BGR(  0,120,215)
    t.Border          = BGR(200,200,200)
    t.BorderDisabled  = BGR(222,222,222)
    t.Divider         = BGR(225,225,225)
    t.Selected        = BGR(  0,120,215)
    t.SelectedText    = BGR(255,255,255)
    t.Popup           = BGR(249,249,249)
    t.PopupText       = BGR( 32, 32, 32)
    t.Track           = BGR(225,225,225)
    t.Success         = BGR( 16,124, 16)
    t.Warning         = BGR(157, 93,  0)
    t.Error           = BGR(196, 43, 28)
    return t
end function

' TRUE when Windows is set to dark app mode (HKCU ...\Themes\Personalize, AppsUseLightTheme = 0).
' Absent value (older Windows): light.
public function PsTheme_SystemIsDark( ) as boolean
    dim as DWORD v = 1, cb = sizeof( DWORD )
    dim as wstring * 128 wszKey = "Software\Microsoft\Windows\CurrentVersion\Themes\Personalize"
    dim as wstring * 32 wszVal = "AppsUseLightTheme"
    if RegGetValueW( HKEY_CURRENT_USER, @wszKey, @wszVal, RRF_RT_REG_DWORD, null, @v, @cb ) <> ERROR_SUCCESS then
        return false
    end if
    return v = 0
end function

' The preset the Windows app mode asks for.
public function PsTheme_System( ) as PSTHEME_COLORS
    if PsTheme_SystemIsDark() then return PsTheme_Dark()
    return PsTheme_Light()
end function

' Dark or light window chrome (caption and frame) through DWM. Windows 10 1809+; a no-op
' where DWM does not know the attribute, and when the caption already matches. A visible
' window's frame is repainted at once: Windows 11 redraws the caption by itself, but Windows 10
' leaves the old one up until the frame is next painted.
public sub PsTheme_ApplyTitleBar( byval hwnd as HWND, byval bDark as boolean )
    if IsWindow( hwnd ) = 0 then exit sub
    dim as BOOL v = iif( bDark, TRUE, FALSE )
    dim as BOOL cur = FALSE
    ' DWMWA_USE_IMMERSIVE_DARK_MODE is 20 from Windows 10 20H1; builds before it used 19.
    dim as long attr = DWMWA_USE_IMMERSIVE_DARK_MODE
    if FAILED( DwmGetWindowAttribute( hwnd, attr, @cur, sizeof( cur ) ) ) then attr = 19
    if (cur <> 0) = bDark then
        if attr = DWMWA_USE_IMMERSIVE_DARK_MODE then exit sub
    end if
    if FAILED( DwmSetWindowAttribute( hwnd, attr, @v, sizeof( v ) ) ) then exit sub
    if IsWindowVisible( hwnd ) then
        SetWindowPos( hwnd, null, 0, 0, 0, 0, SWP_NOMOVE or SWP_NOSIZE or SWP_NOZORDER or _
                      SWP_NOACTIVATE or SWP_FRAMECHANGED )
    end if
end sub

' The caption of the top-level window h sits in -- if that window has a caption at all (a
' popup, a menu or a tooltip does not, and is left alone).
public sub PsTheme_ApplyCaptionOf( byval h as HWND, byval bDark as boolean )
    dim as HWND hRoot = GetAncestor( h, GA_ROOT )
    if hRoot = 0 then exit sub
    if (GetWindowLongPtrW( hRoot, GWL_STYLE ) and WS_CAPTION) <> WS_CAPTION then exit sub
    PsTheme_ApplyTitleBar( hRoot, bDark )
end sub

' Componentwise equality, for tests and change detection.
' The colours are compared as one block from Window to Error: IsDark is compared on its own,
' so the padding after it never takes part.
public function PsTheme_Equal( byref a as PSTHEME_COLORS, byref b as PSTHEME_COLORS ) as boolean
    if a.IsDark <> b.IsDark then return false
    dim as COLORREF ptr pa = @a.Window
    dim as COLORREF ptr pb = @b.Window
    dim as long n = ((cast( ubyte ptr, @a.Error ) - cast( ubyte ptr, pa )) \ sizeof( COLORREF )) + 1
    for i as long = 0 to n - 1
        if pa[i] <> pb[i] then return false
    next
    return true
end function
