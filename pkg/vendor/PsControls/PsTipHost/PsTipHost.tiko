' ########################################################################################
'  PsTipHost -- the tooltip backend switch shared by the owner-drawn control family.
'
'  NOT A CONTROL. Like PsBufferPaint and PsImage it is a support type a control HOLDS: no
'  HWND of its own, no window, no message pump obligation. One PSTIPHOST_STATE field replaces the
'  `hToolTip as HWND` + `HoverTime as long` pair every control in the family carries today.
'
'  ------------------------------------------------------------------------------------
'  WHY THIS EXISTS
'  ------------------------------------------------------------------------------------
'  Thirteen files in this family create a comctl32 tooltip, in three shapes (whole-control,
'  per-item with TTM_POP, and TTF_TRACK). Converting each by hand means writing the same
'  sixty lines thirteen times and having them drift thirteen ways. This holds the one copy.
'
'  ------------------------------------------------------------------------------------
'  WHAT IT DOES *NOT* DO -- read this before extending it
'  ------------------------------------------------------------------------------------
'  It does not own the tooltip TEXT and must never learn to. Every control in this family
'  already has a private Ps<X>_ResolveTooltipText with its own policy (authored text wins,
'  callback second, and whether there is a caption/item-text fallback differs per control).
'  This type carries a CALLBACK to that policy and nothing else -- so switching backends
'  cannot change what a tip says, only how it is drawn and driven.
'
'  ------------------------------------------------------------------------------------
'  THE DEFAULT IS PSTIP_MODE_SYSTEM, DELIBERATELY
'  ------------------------------------------------------------------------------------
'  Every existing host keeps the comctl32 tooltip it has today unless it asks for otherwise.
'  That is not timidity: PsTooltip's colour defaults are DARK and the system tip is light, so
'  a control that silently switched would put a dark tip on a light form. A host opts in per
'  control with Ps<X>_SetTooltipMode, and themes them all at once with
'  PsTooltip_SetDefaultColors and friends.
'
'  ------------------------------------------------------------------------------------
'  SINGLE-THREADED. UI thread only, like everything else here.
' ########################################################################################

#module "PsTipHost"

#ifndef TIKO_OS_WINDOWS
    #error "vendor/PsControls is Windows-only (Win32 controls): build for -target windows-x86_64, or use vendor/tkControls"
#endif

#import "sys/win"
#import "sys/win/gui"
#import "sys/win/gdiplus"
#import "vendor/PsControls/PsTooltip"
#import "vendor/PsControls/PsBufferPaint"

using gui
using gdiplus
using PsTooltip
using PsBufferPaint

public enum
    PSTIP_MODE_SYSTEM = 0        ' comctl32 tooltips_class32 (the default; unchanged behaviour)
    PSTIP_MODE_PS     = 1        ' PsTooltip
end enum


' The per-control state. A control declares ONE of these and passes its address in.
'
' Both handles are kept rather than one: a mode switch destroys the outgoing backend's window
' and builds the incoming one, and keeping them in separate fields is what makes "which one am
' I on" answerable without consulting nMode and hoping the two agree.
public type PSTIPHOST_STATE
    nMode        as long = PSTIP_MODE_SYSTEM
    hSysTip      as HWND         ' comctl32 window, 0 unless nMode = PSTIP_MODE_SYSTEM
    hPsTip       as HWND         ' PsTooltip window,  0 unless nMode = PSTIP_MODE_PS
    hCtrl        as HWND         ' the control being served; set by the first Ensure

    ' The text policy, supplied by the control. Installed on the PsTooltip backend and
    ' remembered so a later mode switch can re-install it. In system mode it is unused --
    ' comctl32 asks the control's own WndProc through TTN_GETDISPINFOW instead, which is why
    ' that arm stays in every control rather than being absorbed here.
    TipCallback  as TIP_TooltipCallbackFunc

    ' -1 = never set by the host, so the backend keeps its own derivation. A stored 0 is a
    ' real request for "no delay" and must survive a mode switch; conflating the two with 0
    ' would hand comctl32's system-derived hover time to a host that asked for none.
    nInitialMs   as long = -1
    nAutoPopMs   as long = -1
    nReshowMs    as long = -1

    ' A TRACKED tip is positioned and shown by the control rather than by a dwell -- see
    ' PsTipHost_SetTracked. It changes how the comctl32 tool is BUILT, so it must be declared
    ' before the first Ensure.
    bTracked     as boolean = false
end type


' --- lifecycle ----------------------------------------------------------------------------
' Build the backing tip for the CURRENT mode if it does not exist yet. Idempotent, so a
' control may call it from Create and again from any setter that needs a live tip. Returns
' true if a tip exists on return.
public declare function PsTipHost_Ensure( byval pHost as PSTIPHOST_STATE ptr, byval hCtrl as HWND, _
                                   byval TipCallback as TIP_TooltipCallbackFunc = 0 ) as boolean

' Destroy whichever backend is live. Call from the control's WM_NCDESTROY, exactly where
' DestroyWindow(pBtn->hToolTip) is called today.
public declare sub      PsTipHost_Destroy( byval pHost as PSTIPHOST_STATE ptr )

' --- mode ---------------------------------------------------------------------------------
' Switching destroys the outgoing tip and builds the incoming one, re-applying the stored
' delays. Cheap enough to call at any time; a no-op when the mode is already the one asked
' for. Returns true if the requested mode is live on return.
public declare function PsTipHost_SetMode( byval pHost as PSTIPHOST_STATE ptr, byval nMode as long ) as boolean
public declare function PsTipHost_GetMode( byval pHost as PSTIPHOST_STATE ptr ) as long

' The live handle for each backend, 0 when that backend is not the current one. The PsTooltip
' handle is the host's door to PsTooltip's own SetColors/SetFonts/SetStyle/SetMaxWidth/
' SetTitle/SetGlyph -- those are deliberately NOT mirrored per control, since thirteen
' controls x twenty setters is 260 wrappers to keep in step.
public declare function PsTipHost_SysHandle( byval pHost as PSTIPHOST_STATE ptr ) as HWND
public declare function PsTipHost_PsHandle( byval pHost as PSTIPHOST_STATE ptr ) as HWND

' --- per-item -----------------------------------------------------------------------------
' The hot item changed. This is the single call site that sends TTM_POP today: on the system
' backend it still does, and on PsTooltip it moves the tool index (which hides a visible tip
' and re-resolves on the next dwell). idx -1 is a whole-control tip.
public declare sub      PsTipHost_SetToolIndex( byval pHost as PSTIPHOST_STATE ptr, byval idx as long )

' Take a visible tip down without changing the item -- the control is being hidden, disabled,
' pressed, or destroyed.
public declare sub      PsTipHost_Pop( byval pHost as PSTIPHOST_STATE ptr )

' --- tracked tips (PsCalendar, PsDatePicker) ----------------------------------------------
' THE THIRD SHAPE. Most controls in this family let the tooltip decide when to appear: they
' name the item and the dwell does the rest. The two calendars do not -- they resolve a tip
' for the day cell under the cursor, position it themselves and show it immediately, which on
' comctl32 means a TTF_TRACK tool driven with TTM_TRACKPOSITION / TTM_TRACKACTIVATE.
'
' Declare it BEFORE the first Ensure. A tracked tool differs at CREATION (TTF_TRACK plus
' TTF_ABSOLUTE, and text pushed rather than pulled through LPSTR_TEXTCALLBACK), so switching
' this afterwards would leave a tool of the wrong kind.
public declare sub      PsTipHost_SetTracked( byval pHost as PSTIPHOST_STATE ptr, byval bTracked as boolean )
public declare function PsTipHost_IsTracked( byval pHost as PSTIPHOST_STATE ptr ) as boolean

' Show the tip NOW, with this text, at this place. Both arguments are in SCREEN coordinates
' and both are needed because the two backends place differently and neither can derive the
' other's input: comctl32 is told a POINT and puts its top-left corner there, PsTooltip is
' given the ANCHOR RECT and does its own flip/clamp against the work area. Handing PsTooltip a
' degenerate rect at the point would throw away exactly the placement it exists to do.
public declare sub      PsTipHost_TrackShow( byval pHost as PSTIPHOST_STATE ptr, byval ptScreen as POINT, _
                                      byval rcAnchorScreen as RECT, byval wszText as ustring )
' Take a tracked tip down. Safe to call when nothing is showing.
public declare sub      PsTipHost_TrackHide( byval pHost as PSTIPHOST_STATE ptr )

' --- timing -------------------------------------------------------------------------------
' nWhich is comctl32's own TTDT_INITIAL / TTDT_AUTOPOP / TTDT_RESHOW, reused rather than
' re-invented so a control's existing TTM_SETDELAYTIME call site converts without a new
' vocabulary. Honoured by BOTH backends, which is the whole point: a host's hover time must
' not depend on which tooltip it happens to be looking at.
public declare sub      PsTipHost_SetDelay( byval pHost as PSTIPHOST_STATE ptr, byval nWhich as long, _
                                     byval nMs as long )
public declare function PsTipHost_GetDelay( byval pHost as PSTIPHOST_STATE ptr, byval nWhich as long ) as long

' ========================================================================================
' Build the comctl32 tool. Lifted unchanged from the twelve identical copies in the family
' (PsButton_AddTooltip and its siblings) so that PSTIP_MODE_SYSTEM is byte-for-byte the
' behaviour those controls have today -- including LPSTR_TEXTCALLBACK, which is why every
' control keeps its own TTN_GETDISPINFOW arm.
'
' TTF_SUBCLASS is retained here on purpose even though it is one of the reasons PsTooltip
' exists (it never sees the mouse when the real input window is a descendant, and it
' aggravates the unreliable WM_MOUSELEAVE this family carries poll timers for). This arm is
' the COMPATIBILITY path; changing it would make the default mode something other than what
' the controls ship today, which is the one property that makes this whole change safe to
' land on thirteen controls at once.
' ========================================================================================
private function PsTipHost_AddSystemTool( byval hCtrl as HWND, byval bTracked as boolean = false ) as HWND
    if IsWindow(hCtrl) = 0 then return 0

    ' The TRACKED flavour is what PsCalendar and PsDatePicker built by hand: owned by the
    ' control, TTS_NOPREFIX (a date can contain an ampersand), and the tool carries TTF_TRACK
    ' or TTF_ABSOLUTE with text PUSHED through TTM_UPDATETIPTEXTW rather than pulled through
    ' LPSTR_TEXTCALLBACK. Reproduced exactly, because PSTIP_MODE_SYSTEM has to be what those
    ' controls already ship.
    dim as HWND hTooltip
    if bTracked then
        hTooltip = CreateWindowExW( WS_EX_TOPMOST, "tooltips_class32", "", _
                                    WS_POPUP or TTS_NOPREFIX or TTS_ALWAYSTIP, _
                                    0, 0, 0, 0, hCtrl, NULL, GetModuleHandleW(NULL), NULL )
    else
        hTooltip = CreateWindowExW( 0, "tooltips_class32", "", _
                                    WS_POPUP or TTS_ALWAYSTIP, _
                                    0, 0, 0, 0, NULL, NULL, NULL, NULL )
    end if
    if hTooltip = 0 then return 0
    SetWindowPos( hTooltip, HWND_TOPMOST, 0, 0, 0, 0, SWP_NOMOVE or SWP_NOSIZE or SWP_NOACTIVATE )

    if bTracked then
        dim tiT as TOOLINFOW
        tiT.cbSize   = sizeof(TOOLINFOW)
        tiT.uFlags   = TTF_TRACK or TTF_ABSOLUTE or TTF_IDISHWND
        tiT.hwnd     = hCtrl
        tiT.uId      = cast(UINT_PTR, hCtrl)
        tiT.lpszText = @wstr("")
        SendMessageW( hTooltip, TTM_ADDTOOLW, 0, cast(LPARAM, @tiT) )
        return hTooltip
    end if

    dim tti as TOOLINFOW
    ' cbSize must match the running comctl32 version (see sys/win gui.AddTooltip).
    #ifdef __FB_64BIT__
        if win.GetFileVersion("COMCTL32.DLL") < 600 then tti.cbSize = 64 else tti.cbSize = 72
    #else
        if win.GetFileVersion("COMCTL32.DLL") < 600 then tti.cbSize = 44 else tti.cbSize = 48
    #endif
    tti.uFlags   = TTF_IDISHWND or TTF_SUBCLASS
    tti.hwnd     = hCtrl
    tti.uId      = cast(UINT_PTR, hCtrl)
    tti.hinst    = GetModuleHandleW(NULL)
    tti.lpszText = LPSTR_TEXTCALLBACK
    SendMessageW( hTooltip, TTM_ADDTOOLW, 0, cast(LPARAM, @tti) )
    return hTooltip
end function


' Push whatever delays the host has asked for at the live backend. Called after every create
' and after every mode switch, so the two backends cannot disagree about the hover time.
'
' A stored -1 is left alone rather than pushed: the backend's own derivation (comctl32's
' internal default, or PsTooltip_Create's GetDoubleClickTime arithmetic) is the right answer
' when the host has expressed no opinion, and both derive the SAME numbers from the same
' system setting.
private sub PsTipHost_ApplyDelays( byval pHost as PSTIPHOST_STATE ptr )
    if pHost = 0 then exit sub

    if pHost->nMode = PSTIP_MODE_PS then
        if pHost->hPsTip = 0 then exit sub
        if pHost->nInitialMs >= 0 then PsTooltip_SetInitialDelay( pHost->hPsTip, pHost->nInitialMs )
        if pHost->nAutoPopMs >= 0 then PsTooltip_SetAutoPopDelay( pHost->hPsTip, pHost->nAutoPopMs )
        if pHost->nReshowMs  >= 0 then PsTooltip_SetReshowDelay( pHost->hPsTip, pHost->nReshowMs )
    else
        if pHost->hSysTip = 0 then exit sub
        if pHost->nInitialMs >= 0 then
            SendMessageW( pHost->hSysTip, TTM_SETDELAYTIME, TTDT_INITIAL, cast(LPARAM, pHost->nInitialMs) )
        end if
        if pHost->nAutoPopMs >= 0 then
            SendMessageW( pHost->hSysTip, TTM_SETDELAYTIME, TTDT_AUTOPOP, cast(LPARAM, pHost->nAutoPopMs) )
        end if
        if pHost->nReshowMs >= 0 then
            SendMessageW( pHost->hSysTip, TTM_SETDELAYTIME, TTDT_RESHOW, cast(LPARAM, pHost->nReshowMs) )
        end if
    end if
end sub


' ========================================================================================
' PUBLIC API -- lifecycle
' ========================================================================================
public function PsTipHost_Ensure( byval pHost as PSTIPHOST_STATE ptr, byval hCtrl as HWND, _
                           byval TipCallback as TIP_TooltipCallbackFunc = 0 ) as boolean
    if pHost = 0 then return false
    if IsWindow(hCtrl) = 0 then return false

    pHost->hCtrl = hCtrl
    ' A caller passing 0 is saying "keep what you were given", not "clear it" -- Ensure is
    ' called from setters as well as from Create, and only Create knows the callback.
    if TipCallback <> 0 then pHost->TipCallback = TipCallback

    if pHost->nMode = PSTIP_MODE_PS then
        if IsWindow(pHost->hPsTip) = 0 then
            ' Create ALSO attaches, and applies whatever the host armed process-wide. That
            ' is what lets a control's lazily-built tip carry the host's theme without the
            ' host ever seeing this HWND.
            pHost->hPsTip = PsTooltip_Create( hCtrl )
            if pHost->hPsTip = 0 then return false
            if pHost->TipCallback <> 0 then
                PsTooltip_SetTooltipCallback( pHost->hPsTip, pHost->TipCallback )
            end if
            PsTipHost_ApplyDelays( pHost )
        end if
        return true
    end if

    if IsWindow(pHost->hSysTip) = 0 then
        pHost->hSysTip = PsTipHost_AddSystemTool( hCtrl, pHost->bTracked )
        if pHost->hSysTip = 0 then return false
        PsTipHost_ApplyDelays( pHost )
    end if
    return true
end function


public sub PsTipHost_Destroy( byval pHost as PSTIPHOST_STATE ptr )
    if pHost = 0 then exit sub
    ' Both, unconditionally of nMode. A switch that failed half way -- PsTooltip_Create
    ' returning 0 on a control whose top-level window is already going down -- can leave the
    ' outgoing handle behind, and the control's WM_NCDESTROY is the last chance either has.
    if IsWindow(pHost->hSysTip) then DestroyWindow( pHost->hSysTip )
    if IsWindow(pHost->hPsTip)  then DestroyWindow( pHost->hPsTip )
    pHost->hSysTip = 0
    pHost->hPsTip  = 0
end sub


' ========================================================================================
' PUBLIC API -- mode
' ========================================================================================
public function PsTipHost_SetMode( byval pHost as PSTIPHOST_STATE ptr, byval nMode as long ) as boolean
    if pHost = 0 then return false
    if (nMode <> PSTIP_MODE_SYSTEM) andalso (nMode <> PSTIP_MODE_PS) then return false
    if pHost->nMode = nMode then return true

    ' Take down the outgoing backend before the mode changes, or Destroy below would be
    ' asked to tear down the one we are about to build.
    if IsWindow(pHost->hSysTip) then DestroyWindow( pHost->hSysTip )
    if IsWindow(pHost->hPsTip)  then DestroyWindow( pHost->hPsTip )
    pHost->hSysTip = 0
    pHost->hPsTip  = 0

    pHost->nMode = nMode

    ' Rebuild ONLY if the control already had a tip -- i.e. if hCtrl was ever set. A control
    ' whose host switches mode before the first Ensure must still get its tip lazily, on the
    ' same schedule it would have had.
    if IsWindow(pHost->hCtrl) then return PsTipHost_Ensure( pHost, pHost->hCtrl )
    return true
end function


public function PsTipHost_GetMode( byval pHost as PSTIPHOST_STATE ptr ) as long
    if pHost = 0 then return PSTIP_MODE_SYSTEM
    return pHost->nMode
end function


public function PsTipHost_SysHandle( byval pHost as PSTIPHOST_STATE ptr ) as HWND
    if pHost = 0 then return 0
    return pHost->hSysTip
end function


public function PsTipHost_PsHandle( byval pHost as PSTIPHOST_STATE ptr ) as HWND
    if pHost = 0 then return 0
    return pHost->hPsTip
end function


' ========================================================================================
' PUBLIC API -- per-item and manual take-down
' ========================================================================================
public sub PsTipHost_SetToolIndex( byval pHost as PSTIPHOST_STATE ptr, byval idx as long )
    if pHost = 0 then exit sub
    if pHost->nMode = PSTIP_MODE_PS then
        if pHost->hPsTip then PsTooltip_SetToolIndex( pHost->hPsTip, idx )
    else
        ' comctl32 has no notion of the item; TTM_POP is how the family tells it the text it
        ' cached is stale, and the next dwell re-asks through TTN_GETDISPINFOW.
        if pHost->hSysTip then SendMessageW( pHost->hSysTip, TTM_POP, 0, 0 )
    end if
end sub


public sub PsTipHost_Pop( byval pHost as PSTIPHOST_STATE ptr )
    if pHost = 0 then exit sub
    if pHost->nMode = PSTIP_MODE_PS then
        if pHost->hPsTip then PsTooltip_Hide( pHost->hPsTip )
    else
        if pHost->hSysTip then SendMessageW( pHost->hSysTip, TTM_POP, 0, 0 )
    end if
end sub


' ========================================================================================
' PUBLIC API -- tracked tips
'
' The control decides when, what and where; the dwell plays no part. See the declarations at
' the top of this file for why the two backends are handed different things.
' ========================================================================================
public sub PsTipHost_SetTracked( byval pHost as PSTIPHOST_STATE ptr, byval bTracked as boolean )
    if pHost = 0 then exit sub
    pHost->bTracked = bTracked
end sub


public function PsTipHost_IsTracked( byval pHost as PSTIPHOST_STATE ptr ) as boolean
    if pHost = 0 then return false
    return pHost->bTracked
end function


public sub PsTipHost_TrackShow( byval pHost as PSTIPHOST_STATE ptr, byval ptScreen as POINT, _
                         byval rcAnchorScreen as RECT, byval wszText as ustring )
    if pHost = 0 then exit sub
    if len(wszText) = 0 then
        PsTipHost_TrackHide( pHost )
        exit sub
    end if

    if pHost->nMode = PSTIP_MODE_PS then
        if pHost->hPsTip = 0 then exit sub
        ' Authored text, not the callback: a tracked control has ALREADY resolved what this
        ' tip says (it had to, in order to decide whether to show one at all), so asking again
        ' through the callback would resolve it twice per cell.
        PsTooltip_SetText( pHost->hPsTip, wszText )
        PsTooltip_ShowForRect( pHost->hPsTip, rcAnchorScreen, TIP_ALIGN_BELOW )
        exit sub
    end if

    if pHost->hSysTip = 0 then exit sub
    dim ti as TOOLINFOW
    ti.cbSize   = sizeof(TOOLINFOW)
    ti.hwnd     = pHost->hCtrl
    ti.uId      = cast(UINT_PTR, pHost->hCtrl)
    ti.lpszText = cast(WSTRING ptr, strptr(wszText))
    SendMessageW( pHost->hSysTip, TTM_UPDATETIPTEXTW, 0, cast(LPARAM, @ti) )
    SendMessageW( pHost->hSysTip, TTM_TRACKPOSITION, 0, _
                  cast(LPARAM, MAKELONG(ptScreen.x, ptScreen.y)) )
    SendMessageW( pHost->hSysTip, TTM_TRACKACTIVATE, TRUE, cast(LPARAM, @ti) )
end sub


public sub PsTipHost_TrackHide( byval pHost as PSTIPHOST_STATE ptr )
    if pHost = 0 then exit sub
    if pHost->nMode = PSTIP_MODE_PS then
        if pHost->hPsTip then PsTooltip_Hide( pHost->hPsTip )
        exit sub
    end if
    if pHost->hSysTip = 0 then exit sub
    dim ti as TOOLINFOW
    ti.cbSize = sizeof(TOOLINFOW)
    ti.hwnd   = pHost->hCtrl
    ti.uId    = cast(UINT_PTR, pHost->hCtrl)
    SendMessageW( pHost->hSysTip, TTM_TRACKACTIVATE, FALSE, cast(LPARAM, @ti) )
end sub


' ========================================================================================
' PUBLIC API -- timing
' ========================================================================================
public sub PsTipHost_SetDelay( byval pHost as PSTIPHOST_STATE ptr, byval nWhich as long, byval nMs as long )
    if pHost = 0 then exit sub
    if nMs < 0 then nMs = 0

    ' Stored FIRST, then pushed, so the value survives a mode switch that happens later. A
    ' setter that only pushed at the live backend would silently lose the host's hover time
    ' the moment the mode changed -- and the tip would still appear, just on the wrong beat.
    select case nWhich
        case TTDT_INITIAL  : pHost->nInitialMs = nMs
        case TTDT_AUTOPOP  : pHost->nAutoPopMs = nMs
        case TTDT_RESHOW   : pHost->nReshowMs  = nMs
        case else          : exit sub
    end select

    PsTipHost_ApplyDelays( pHost )
end sub


function PsTipHost_GetDelay( byval pHost as PSTIPHOST_STATE ptr, byval nWhich as long ) as long
    if pHost = 0 then return -1
    select case nWhich
        case TTDT_INITIAL  : return pHost->nInitialMs
        case TTDT_AUTOPOP  : return pHost->nAutoPopMs
        case TTDT_RESHOW   : return pHost->nReshowMs
    end select
    return -1
end function
