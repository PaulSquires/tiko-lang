''
''  vendor/PsControls/PsToggle  --  owner-drawn toggle switch (pill + knob)
''

#module "PsToggle"

#import "sys/win"
#import "sys/win/gui"
#import "sys/win/gdiplus"
#import "vendor/PsControls/PsBufferPaint"

using gui
using gdiplus
using PsBufferPaint

' Polling timer that guarantees hot-tracking is cleared when the mouse leaves the control.
' WM_MOUSELEAVE (TME_LEAVE) is not reliably delivered on fast exits, so a periodic cursor
' check acts as a safety net. Timer IDs are per-window, so every instance can share this id.
#define IDT_CTOGGLE_HOTTRACK   &hCB70
#define PSTOGGLE_HOTTRACK_MS    100

' (PSTOGGLE_SUPERSAMPLE is gone. The pill and knob used to be rendered at 4x into an
'  offscreen tile and scaled back down with a HALFTONE StretchBlt to fake antialiasing,
'  because plain GDI RoundRect/Ellipse edges are visibly jagged at this size.
'  PsBufferPaint renders through GDI+ now and antialiases the curves directly, so the
'  tile, the constant and the traps that came with them have all been deleted.)

' Defaults. The four SIZE values are DPI-scaled at Create; every setter afterwards takes
' raw pixels and the caller scales (the family rule). The two THICKNESS values are NOT
' DPI-scaled, ever -- a hairline should stay a hairline (PsMenuBar's nSeparatorThickness).
public const PSTOGGLE_DEFAULT_TRACKW = 40
public const PSTOGGLE_DEFAULT_TRACKH = 20
public const PSTOGGLE_DEFAULT_KNOBINSET = 2
public const PSTOGGLE_DEFAULT_BORDERTHICK = 1   ' not DPI-scaled
#define PSTOGGLE_DEFAULT_FOCUSGAP     3
public const PSTOGGLE_DEFAULT_FOCUSTHICK = 1   ' not DPI-scaled

' Where the pill sits horizontally when the control is wider than the pill needs. It is
' ALWAYS vertically centred -- there is no vertical justification, because a toggle in a
' settings row is always centred on its row and nothing wanted otherwise.
public enum
    TOG_JUSTIFY_LEFT = 0
    TOG_JUSTIFY_CENTER
    TOG_JUSTIFY_RIGHT
end enum


' Colors for the built-in painter. Copied on Set.
'
' Three drawn parts (track fill, track border, knob) x two states (checked / unchecked) x
' three moods (idle / hot / disabled), plus the control's own background and the focus ring.
' Flat COLORREF fields with defaults, exactly like PSSELECTBAR_COLORS -- read-modify-write is
' PsToggle_GetColors, assign, PsToggle_SetColors.
'
' THE ON PILL LOOKS BORDERLESS BY DEFAULT because TrackBorderColorOn* is defaulted EQUAL to
' the matching TrackColorOn*. The OFF pill is distinguished by an outline instead: its fill
' sits close to the background and TrackBorderColorOff is markedly lighter. That asymmetry
' is the look this control was drawn for; a host that wants a visible ON border just sets
' the field. (Same trick PsSelectBar uses defaulting BackColorHot to BackColor.)
'
' THERE ARE NO PRESSED COLORS. A live press renders as hot, which is PsSelectBar's rule and
' reads correctly for a control whose whole job is to flip on release. isPressed is still
' handed to the paint callback, so a host that wants a distinct pressed look can draw one.
public type PSTOGGLE_COLORS
    BackColor                   as COLORREF = BGR( 33, 37, 43)   ' the control's own background
    FocusRingColor              as COLORREF = BGR( 86,156,214)
    ' --- checked (ON) ---
    TrackColorOn                as COLORREF = BGR( 74,108,140)
    TrackColorOnHot             as COLORREF = BGR( 92,132,170)
    TrackColorOnDisabled        as COLORREF = BGR( 56, 70, 84)
    TrackBorderColorOn          as COLORREF = BGR( 74,108,140)   ' = TrackColorOn (see above)
    TrackBorderColorOnHot       as COLORREF = BGR( 92,132,170)   ' = TrackColorOnHot
    TrackBorderColorOnDisabled  as COLORREF = BGR( 56, 70, 84)   ' = TrackColorOnDisabled
    KnobColorOn                 as COLORREF = BGR(216,220,226)
    KnobColorOnHot              as COLORREF = BGR(255,255,255)
    KnobColorOnDisabled         as COLORREF = BGR(120,126,134)
    ' --- unchecked (OFF) ---
    TrackColorOff               as COLORREF = BGR( 51, 55, 63)
    TrackColorOffHot            as COLORREF = BGR( 62, 67, 77)
    TrackColorOffDisabled       as COLORREF = BGR( 44, 48, 55)
    TrackBorderColorOff         as COLORREF = BGR(107,114,128)
    TrackBorderColorOffHot      as COLORREF = BGR(138,146,161)
    TrackBorderColorOffDisabled as COLORREF = BGR( 72, 77, 86)
    KnobColorOff                as COLORREF = BGR(138,144,153)
    KnobColorOffHot             as COLORREF = BGR(176,182,191)
    KnobColorOffDisabled        as COLORREF = BGR( 84, 89, 97)
end type


' Everything the painter needs. All three rects are precomputed by LayoutToggle -- never
' re-derive one from another, and in particular never derive the knob from the track by
' repeating the inset arithmetic, because SetKnobInset can change it underneath you.
public type PSTOGGLE_PAINTINFO
    hToggle    as HWND                 ' the control, so the callback can query it
    b          as PsPaintBuffer ptr  ' the control's buffer for this repaint (no copy)
    ' --- Geometry, all precomputed by LayoutToggle ---
    rcClient   as RECT                 ' the whole client area
    rcTrack    as RECT                 ' the pill
    rcKnob     as RECT                 ' the circle, already at the end its state calls for
    rcVisual   as RECT                 ' rcTrack inflated by the focus-ring padding
    ' --- State: the control decides these, you only render. ---
    isChecked  as boolean              ' ON: the knob is at the RIGHT end
    isHot      as boolean              ' the mouse is over the control
    isPressed  as boolean              ' a live left press AND the cursor is still inside
                                       '   (slide off and this goes false without ending
                                       '   the gesture)
    isEnabled  as boolean
    isFocused  as boolean              ' draw a focus ring when true
end type

public type PSTOGGLE_MESSAGEINFO
    hToggle    as HWND
    uMsg       as UINT
    wParam     as WPARAM
    lParam     as LPARAM
end type


' Draw the whole control, INSTEAD OF the built-in painter. Paint through p->b (the control's
' double buffer for this repaint) -- do not touch the screen DC.
'
' NOTE what you give up by setting this: the built-in painter is the ONLY thing that runs
' the supersampling pass, so a callback drawing with plain GDI RoundRect/Ellipse gets
' aliased edges. That is a legitimate choice (a host drawing a square switch, or an image,
' may not care), but it is a choice -- it is not free antialiasing you inherit.
'
' The control has already filled the client with BackColor before calling you, so a callback
' that only wants to add something on top does not have to repaint the background.
public type TOG_PaintCallbackSub as sub( byval p as PSTOGGLE_PAINTINFO ptr )

' Observe messages. Return TRUE if you handled it and want the control's default handling
' suppressed, FALSE to let it proceed.
'
' Unlike its siblings this control hands over the FOCUS and KEYBOARD messages as well as the
' mouse ones (WM_SETFOCUS, WM_KILLFOCUS, WM_KEYDOWN), because PsToggle is the first focusable
' control in the family and those now carry real state.
'
' CAUTION: the result is IGNORED for three messages.
'   WM_LBUTTONUP        - the control holds mouse capture across a press and the up-message
'                         is what releases it: a callback that suppressed it would strand
'                         capture and route every subsequent click to this control (the
'                         PsListBox bug recorded in Learnings.md). Suppressing
'                         WM_LBUTTONDOWN suppresses the press, never the capture bookkeeping.
'   WM_SETFOCUS         - focus is a FACT the system reports, not an action to veto. The
'   WM_KILLFOCUS          state is already updated by the time you are called; there is
'                         nothing left to suppress. A host that does not want the control
'                         focusable must not make it a tabstop.
' For every other message TRUE suppresses the control's default handling.
public type TOG_MessageCallbackFunc as function( byval m as PSTOGGLE_MESSAGEINFO ptr ) as boolean

' The checked state changed through USER interaction -- a completed click, or Space/Enter.
' Fired AFTER the control's state is updated, so PsToggle_GetChecked() = isChecked. The
' programmatic PsToggle_SetChecked does NOT fire this (Win32's BM_SETCHECK / BN_CLICKED
' precedent), which also makes it safe to call SetChecked from inside the handler.
public type TOG_CheckChangedCallbackSub as sub( byval hToggle as HWND, byval isChecked as boolean )


public type PSTOGGLE_STATE
    hWin           as HWND
    idc_Toggle     as long = 0
    ' --- State. All single-valued: there is exactly one of this control, so unlike the
    '     collection siblings there are no indices here to be left dangling, and none of
    '     their index fix-up code exists. ---
    isChecked      as boolean = false
    isEnabled      as boolean = true
    isHot          as boolean = false   ' the mouse is over the client
    isFocused      as boolean = false
    ' Set when a WM_KEYDOWN we consume will be followed by a WM_CHAR, so that character can be
    ' swallowed too. Without it the character reaches DefWindowProc and the system BEEPS on
    ' every Enter/Space -- the keystroke still works, so the beep is the only symptom.
    bAteKeyDown   as boolean = false
    isPressed      as boolean = false   ' a live left press (see the capture note below)
    hotTimerOn     as boolean = false   ' is the hot-tracking safety-net timer running?
    ' --- Press state (mouse capture). The control TAKES capture on a press: the
    '     press/cancel gesture (press, slide off the control, release, the state does NOT
    '     flip) consumes the guaranteed down->up pairing, which is the family's test for
    '     taking capture. It pays the full price: snapshot the press BEFORE releasing
    '     (ReleaseCapture sends WM_CAPTURECHANGED synchronously -- Learnings.md), release on
    '     the up-message before any callback runs, WM_CAPTURECHANGED cancels the press,
    '     WM_DESTROY releases, and no callback may suppress an up-message.
    '     There is no bPressedInside flag: "the cursor is still inside" is exactly isHot,
    '     and hover tracking already maintains that through the capture. ---
    colors         as PSTOGGLE_COLORS
    ' --- Layout. Rects are DERIVED, never set from outside; LayoutToggle() owns them.
    '     Layout is lazy: mutators mark it dirty, the next paint (or any rect query) runs
    '     it. There is NO font and NO measuring pass -- alone in the family, LayoutToggle
    '     never takes a DC, because nothing about this control's geometry is measured. ---
    nTrackWidth    as long = PSTOGGLE_DEFAULT_TRACKW       ' DPI-scaled at Create
    nTrackHeight   as long = PSTOGGLE_DEFAULT_TRACKH       ' DPI-scaled at Create
    nKnobInset     as long = PSTOGGLE_DEFAULT_KNOBINSET    ' DPI-scaled at Create
    nBorderThick   as long = PSTOGGLE_DEFAULT_BORDERTHICK  ' NOT DPI-scaled
    nFocusGap      as long = PSTOGGLE_DEFAULT_FOCUSGAP     ' DPI-scaled at Create
    nFocusThick    as long = PSTOGGLE_DEFAULT_FOCUSTHICK   ' NOT DPI-scaled
    nJustify       as long = TOG_JUSTIFY_CENTER
    rcTrack        as RECT               ' derived
    rcKnob         as RECT               ' derived; depends on isChecked
    rcVisual       as RECT               ' derived: rcTrack inflated by the ring padding
    bLayoutDirty   as boolean = true
    PaintCallback        as TOG_PaintCallbackSub          ' optional; replaces the built-in painter
    MessageCallback      as TOG_MessageCallbackFunc       ' optional
    CheckChangedCallback as TOG_CheckChangedCallbackSub   ' optional; user-driven changes only

    declare sub      LayoutToggle()
    declare function RingPad() as long
    declare function KnobDiameter() as long
    declare sub      CancelPress()
    declare sub      Refresh()
end type


' The distance the visual bounds extend beyond the track on every side. The focus ring is
' drawn INSIDE this band, so reserving it unconditionally -- whether or not the control
' currently has focus -- is what stops the pill jumping when focus arrives.
function PSTOGGLE_STATE.RingPad() as long
    return this.nFocusGap + this.nFocusThick
end function

' The knob is a circle inset from the track on all four sides, so its diameter follows the
' track HEIGHT and the inset, never the width. Clamped at 1: a host that sets an inset
' larger than half the track height gets a degenerate-but-drawable knob rather than an
' Ellipse with a negative extent.
function PSTOGGLE_STATE.KnobDiameter() as long
    dim as long dia = this.nTrackHeight - (2 * this.nKnobInset)
    if dia < 1 then dia = 1
    return dia
end function


' Assign the three rects. This is the only place toggle geometry is produced; painting,
' invalidation and every public rect query consume it.
'
'   ringPad      = nFocusGap + nFocusThick
'   knobDia      = nTrackHeight - 2*nKnobInset
'   visualW      = nTrackWidth  + 2*ringPad          ( = GetIdealSize's width )
'   visualH      = nTrackHeight + 2*ringPad          ( = GetIdealSize's height )
'
'   rcTrack.top  = clientTop + (clientH - nTrackHeight) \ 2        ALWAYS v-centred
'   rcTrack.left = LEFT   -> clientLeft  + ringPad
'                  CENTER -> clientLeft  + (clientW - nTrackWidth) \ 2
'                  RIGHT  -> clientRight - ringPad - nTrackWidth
'
'   rcKnob.top   = rcTrack.top + nKnobInset                        (w = h = knobDia)
'   rcKnob.left  = OFF -> rcTrack.left  + nKnobInset
'                  ON  -> rcTrack.right - nKnobInset - knobDia
'
'   rcVisual     = rcTrack inflated by ringPad on all four sides
'
' WHY CENTER USES THE TRACK AND NOT THE VISUAL: the ring band is symmetric about the track,
' so centring the track centres the visual too -- and doing it this way keeps the CENTER
' formula independent of the ring settings, which means changing the ring thickness cannot
' nudge a centred pill sideways.
'
' OVERFLOW: when the visual does not fit the client the justification degrades to LEFT and
' the tail clips at the client edge. Rects are computed HONESTLY rather than squeezed
' (PsIconPanel's and PsTabBar's rule), so the pill keeps its proper shape and only the part
' past the edge is lost. The same applies vertically: a client shorter than the track gives
' a negative top, and the pill is clipped top and bottom rather than being deformed.
'
' NO DC IS TAKEN. There is no text and no font, so nothing here is measured -- every number
' above is authored or derived. This is the only LayoutXxx in the family that can say that.
sub PSTOGGLE_STATE.LayoutToggle()
    this.bLayoutDirty = false
    if this.hWin = 0 then exit sub

    dim as RECT rcClient
    GetClientRect( this.hWin, @rcClient )
    dim as long clientW = rcClient.right - rcClient.left
    dim as long clientH = rcClient.bottom - rcClient.top

    ' No geometry yet (created 0x0, sized only once the host shows us). Placement is
    ' impossible, so leave the rects alone and ask to be run again. Note that
    ' PsToggle_GetIdealSize deliberately does NOT come through here -- it is computed
    ' straight from the scalars, because a host calls it to decide how big to make the
    ' control in the first place and returning 0 until it had already been sized would be a
    ' chicken-and-egg trap.
    if (clientW <= 0) orelse (clientH <= 0) then
        this.bLayoutDirty = true
        exit sub
    end if

    ' NOT named ringPad: FreeBASIC is case-insensitive, so a local with the same name as the
    ' RingPad() member is a duplicate definition inside a member procedure -- and the error
    ' points at the DIM, never at the method it collides with. Same family of trap as the
    ' hFont/HFONT shadowing recorded in C:\dev\Learnings.md.
    dim as long nRingPad = this.RingPad()
    dim as long knobDia  = this.KnobDiameter()
    dim as long visualW  = this.nTrackWidth + (2 * nRingPad)

    ' LEFT, which is also the overflow fallback.
    dim as long x = rcClient.left + nRingPad
    if visualW < clientW then
        select case this.nJustify
        case TOG_JUSTIFY_CENTER
            x = rcClient.left + ((clientW - this.nTrackWidth) \ 2)
        case TOG_JUSTIFY_RIGHT
            x = rcClient.right - nRingPad - this.nTrackWidth
        end select
    end if

    dim as long y = rcClient.top + ((clientH - this.nTrackHeight) \ 2)

    SetRect( @this.rcTrack, x, y, x + this.nTrackWidth, y + this.nTrackHeight )

    dim as long knobX = this.rcTrack.left + this.nKnobInset
    if this.isChecked then knobX = this.rcTrack.right - this.nKnobInset - knobDia
    dim as long knobY = this.rcTrack.top + this.nKnobInset
    SetRect( @this.rcKnob, knobX, knobY, knobX + knobDia, knobY + knobDia )

    this.rcVisual = this.rcTrack
    InflateRect( @this.rcVisual, nRingPad, nRingPad )
end sub


' Forget any live press WITHOUT touching the capture. Releasing capture is the WndProc's job,
' and only on the up-message or WM_DESTROY -- doing it here would let a callback strand or
' double-release it.
sub PSTOGGLE_STATE.CancelPress()
    this.isPressed = false
end sub

' Mark the layout stale and request a repaint. Every mutator routes through here, which is
' what makes layout lazy.
sub PSTOGGLE_STATE.Refresh()
    this.bLayoutDirty = true
    ' Repaint WITH background erase so a region vacated by a shrinking pill is cleared.
    if this.hWin then InvalidateRect( this.hWin, NULL, TRUE )
end sub


' ========================================================================================
' PUBLIC API
' ========================================================================================
'
' A TOGGLE SWITCH: a rounded pill whose fill changes with state, and a circular knob that
' sits at the left end when OFF and the right end when ON. No text, no animation, no
' tri-state.
'
' NO TEXT, THEREFORE NO FONT
'   The control draws only the track and the knob. There is no caption, no SetFont/GetFont,
'   and no measuring pass -- a host that wants a label puts one beside the control. This is
'   why LayoutToggle takes no DC.
'
' NO TOOLTIPS
'   No tooltip window is created and there is no TOG_TooltipCallback. A host that wants a
'   tip can add its own tool over the control's HWND.
'
' IT IS FOCUSABLE -- THE ONLY ONE IN THE FAMILY
'   WS_TABSTOP, real focus tracking, a painted focus ring, and Space/Enter activation.
'   Every other control in the family is mouse-only, so this is a deliberate departure and
'   not drift. A host that does not run IsDialogMessage in its pump still gets working mouse
'   and (once the control has focus) keyboard behaviour; only Tab NAVIGATION needs the
'   dialog manager.
'
' ANTIALIASING
'   The built-in painter draws through PsBufferPaint, which renders geometry with GDI+,
'   so the pill's shoulders and the knob's rim are antialiased. A paint callback replaces
'   the built-in painter entirely -- but it gets the same buffer, so it inherits the same
'   antialiased primitives rather than having to hand-roll smoothing the way the old
'   supersampled painter did.
'
' THE CONTROL HANDLE
'   Every PsToggle_* function takes the handle returned by PsToggle_Create().
'
'   The handle is a real HWND on purpose (not an opaque type): callers legitimately need to
'   treat the control as a window, e.g. SetWindowPos() to place and size it.
'
' LIFETIME
'   The control frees itself when its window is destroyed. It owns no host resources.
'
' THERE IS NO PsToggle_HitTest
'   The whole client rect is the hit area, so a hit test could only ever be
'   PtInRect(client) -- a function that returns TRUE for exactly the points the caller
'   already knows are inside. Its absence is a decision, not an omission.
'
' ----------------------------------------------------------------------------------------
' Creation
'   CtrlID becomes the control window's id (GWLP_ID), so hosts can find it with GetDlgItem.
'   There are no child controls. The control is created zero-sized: size it with
'   PsToggle_GetIdealSize and position it with SetWindowPos().
' ----------------------------------------------------------------------------------------
public declare function PsToggle_Create( byval hWndParent as HWND, byval CtrlID as long ) as HWND

' ----------------------------------------------------------------------------------------
' State.
'
'   SetChecked is SILENT -- the change callback fires only for user interaction (a completed
'   click, or Space/Enter), following Win32's BM_SETCHECK / BN_CLICKED precedent. That is
'   also what stops a host calling SetChecked from inside its own handler from recursing.
'
'   SetEnabled(false) greys the control, blocks hover, and swallows clicks and keys. It
'   clears any live press and hot state at once rather than waiting for the next mouse move.
'   It does NOT change the checked state: a disabled ON toggle still reads as ON, which is
'   why the color struct carries separate disabled colors for each state.
' ----------------------------------------------------------------------------------------
public declare function PsToggle_GetChecked( byval hToggle as HWND ) as boolean
public declare sub      PsToggle_SetChecked( byval hToggle as HWND, byval isChecked as boolean )
public declare function PsToggle_GetEnabled( byval hToggle as HWND ) as boolean
public declare sub      PsToggle_SetEnabled( byval hToggle as HWND, byval isEnabled as boolean )
public declare function PsToggle_GetFocused( byval hToggle as HWND ) as boolean
public declare sub      PsToggle_Refresh( byval hToggle as HWND )

' ----------------------------------------------------------------------------------------
' Layout.  ALL setters take RAW PIXELS -- the caller DPI-scales (the family rule; only the
' Create-time defaults are scaled for you). The two THICKNESS values should not be scaled at
' all: a hairline stays a hairline.
'
'   SetTrackSize changes the pill; the knob diameter follows the height and the inset.
'   SetKnobInset is the gap between the track edge and the knob on all four sides.
'   SetFocusRing sets the gap from the track to the ring, and the ring's own thickness. Both
'     are reserved unconditionally, focused or not, so the pill never jumps when focus
'     arrives -- which means changing either changes the IDEAL SIZE.
'   SetJustify places the pill horizontally when the control is wider than it needs; the
'     pill is always vertically centred.
'
'   GetIdealSize is the visual bounds: (trackW + 2*ringPad) x (trackH + 2*ringPad). Size the
'   control with it and the focus ring is never clipped. It is valid BEFORE the control has
'   ever been sized.
'
'   The rect queries force a pending layout, so results are always current. They return
'   FALSE if the control has no geometry yet (created but never sized).
' ----------------------------------------------------------------------------------------
public declare sub      PsToggle_GetTrackSize( byval hToggle as HWND, byref nTrackWidth as long, byref nTrackHeight as long )
public declare sub      PsToggle_SetTrackSize( byval hToggle as HWND, byval nTrackWidth as long, byval nTrackHeight as long )
public declare function PsToggle_GetKnobInset( byval hToggle as HWND ) as long
public declare sub      PsToggle_SetKnobInset( byval hToggle as HWND, byval nKnobInset as long )
public declare function PsToggle_GetBorderThickness( byval hToggle as HWND ) as long
public declare sub      PsToggle_SetBorderThickness( byval hToggle as HWND, byval nThickness as long )
public declare sub      PsToggle_GetFocusRing( byval hToggle as HWND, byref nGap as long, byref nThickness as long )
public declare sub      PsToggle_SetFocusRing( byval hToggle as HWND, byval nGap as long, byval nThickness as long )
public declare function PsToggle_GetJustify( byval hToggle as HWND ) as long
public declare sub      PsToggle_SetJustify( byval hToggle as HWND, byval nJustify as long )
public declare sub      PsToggle_GetIdealSize( byval hToggle as HWND, byref nWidth as long, byref nHeight as long )
public declare function PsToggle_GetTrackRect( byval hToggle as HWND, byref rc as RECT ) as boolean
public declare function PsToggle_GetKnobRect( byval hToggle as HWND, byref rc as RECT ) as boolean
public declare function PsToggle_GetVisualRect( byval hToggle as HWND, byref rc as RECT ) as boolean

' ----------------------------------------------------------------------------------------
' Appearance.  SetColors copies the whole struct. GetColors fills one out, so the
' read-modify-write "change one color" idiom is Get, assign, Set.
' ----------------------------------------------------------------------------------------
public declare sub      PsToggle_GetColors( byval hToggle as HWND, byval pColors as PSTOGGLE_COLORS ptr )
public declare sub      PsToggle_SetColors( byval hToggle as HWND, byval pColors as PSTOGGLE_COLORS ptr )

' ----------------------------------------------------------------------------------------
' Callbacks.  See the type declarations above for each signature and contract.
'   PaintCallback        - draw the whole control INSTEAD OF the built-in painter (which
'                          also means instead of its supersampling pass).
'   MessageCallback      - observe mouse, focus and key messages; return TRUE to suppress
'                          default handling (IGNORED for WM_LBUTTONUP -- capture-critical).
'   CheckChangedCallback - the USER flipped the toggle. Programmatic SetChecked is silent.
' ----------------------------------------------------------------------------------------
public declare sub      PsToggle_SetPaintCallback( byval hToggle as HWND, byval usersub as TOG_PaintCallbackSub )
public declare sub      PsToggle_SetMessageCallback( byval hToggle as HWND, byval userfunc as TOG_MessageCallbackFunc )
public declare sub      PsToggle_SetCheckChangedCallback( byval hToggle as HWND, byval usersub as TOG_CheckChangedCallbackSub )

public function GetTogglePointer( byval hToggle as HWND ) as PSTOGGLE_STATE ptr
    dim pWindow as CWindow ptr = CWindowPtr(hToggle)
    if pWindow = 0 then return 0
    return cast( PSTOGGLE_STATE ptr, pWindow->UserData(0) )
end function


' ========================================================================================
' Hand a message to the host's message callback. Returns TRUE if the host claims it.
' Callers decide whether to honor that answer -- WM_LBUTTONUP and the focus messages
' deliberately do not.
' ========================================================================================
private function PsToggle_CallMessage( _
            byval pTog   as PSTOGGLE_STATE ptr, _
            byval hwnd   as HWND, _
            byval uMsg   as UINT, _
            byval wParam as WPARAM, _
            byval lParam as LPARAM _
            ) as boolean

    if pTog = 0 then return false
    if pTog->MessageCallback = 0 then return false

    dim as PSTOGGLE_MESSAGEINFO m
    m.hToggle = hwnd
    m.uMsg    = uMsg
    m.wParam  = wParam
    m.lParam  = lParam
    return pTog->MessageCallback( @m )
end function


' ========================================================================================
' Draw the pill and the knob.
'
' This used to supersample: the whole visual was rendered into a 4x offscreen 32bpp DIB and
' averaged back down with a HALFTONE StretchBlt, because plain GDI has no antialiasing and
' RoundRect's shoulders and Ellipse's rim came out visibly stair-stepped on a ~40x20 switch.
' PsBufferPaint draws through GDI+ now, so the curves are antialiased directly and the
' whole tile -- roughly 145 lines, an offscreen DC, a DIB section, and the two traps below
' -- is gone.
'
' The two traps went with it, and they are recorded here because they are what the old code
' was spending its complexity on:
'
'   1. THE TILE HAD TO BE PRE-FILLED WITH BackColor. A fresh DIB section is zeroed, i.e.
'      black, and the downscale averaged edge blocks against whatever was underneath -- so
'      an unfilled tile blended every curve toward black and the pill wore a dark fringe
'      that read as a drop shadow. There is no tile now, so there is no blend partner to
'      get wrong.
'
'   2. GDI PENS ARE CENTRED ON THE PATH, so a border of width W straddled the track edge
'      with half of it outside, and the RoundRect had to be deflated by W. GDI+ pens are
'      centred too -- but PsBufferPaint now owns that correction for every control, so it
'      is applied once there instead of hand-rolled here.
'
' What is left is three primitive calls. Nothing in this routine touches a GDI object or a
' device context, which is what puts PsToggle back on the family contract: the control owns
' geometry and state, PsBufferPaint owns rendering.
' ========================================================================================
public sub PsToggle_RenderDefault( _
            byval pTog as PSTOGGLE_STATE ptr, _
            byval b    as PsPaintBuffer ptr, _
            byval p    as PSTOGGLE_PAINTINFO ptr _
            )

    if (pTog = 0) orelse (b = 0) orelse (p = 0) then exit sub

    dim as long vw = p->rcVisual.right - p->rcVisual.left
    dim as long vh = p->rcVisual.bottom - p->rcVisual.top
    if (vw <= 0) orelse (vh <= 0) then exit sub

    ' ---- which three colors ------------------------------------------------------------
    ' Precedence: disabled > hot/pressed > idle. A live press renders as hot; there are no
    ' pressed colors (see PSTOGGLE_COLORS).
    dim as COLORREF clrTrack, clrBorder, clrKnob
    with pTog->colors
        if p->isEnabled = false then
            if p->isChecked then
                clrTrack = .TrackColorOnDisabled
                clrBorder = .TrackBorderColorOnDisabled
                clrKnob  = .KnobColorOnDisabled
            else
                clrTrack = .TrackColorOffDisabled
                clrBorder = .TrackBorderColorOffDisabled
                clrKnob  = .KnobColorOffDisabled
            end if
        elseif p->isHot orelse p->isPressed then
            if p->isChecked then
                clrTrack = .TrackColorOnHot
                clrBorder = .TrackBorderColorOnHot
                clrKnob  = .KnobColorOnHot
            else
                clrTrack = .TrackColorOffHot
                clrBorder = .TrackBorderColorOffHot
                clrKnob  = .KnobColorOffHot
            end if
        else
            if p->isChecked then
                clrTrack = .TrackColorOn
                clrBorder = .TrackBorderColorOn
                clrKnob  = .KnobColorOn
            else
                clrTrack = .TrackColorOff
                clrBorder = .TrackBorderColorOff
                clrKnob  = .KnobColorOff
            end if
        end if
    end with

    ' ---- the track ---------------------------------------------------------------------
    ' A corner ellipse as wide and tall as the rect's HEIGHT makes both ends exact
    ' semicircles -- that, and only that, is what turns a rounded rectangle into a pill.
    ' Curvature is a DIAMETER here (PsBufferPaint halves it to a radius internally), so
    ' the track height goes in unmodified.
    dim as long ell = p->rcTrack.bottom - p->rcTrack.top
    dim as RECT rcTrack = p->rcTrack
    b->SetBackColor( clrTrack )
    if pTog->nBorderThick > 0 then
        b->SetPenColor( clrBorder )
        b->PaintRoundBorderRect( @rcTrack, ell, pTog->nBorderThick )
    else
        b->PaintRoundRect( @rcTrack, ell )
    end if

    ' ---- the knob ----------------------------------------------------------------------
    dim as RECT rcKnob = p->rcKnob
    b->SetBackColor( clrKnob )
    b->PaintEllipse( @rcKnob, 0 )

    ' ---- the focus ring ----------------------------------------------------------------
    ' Outline, never filled: it is drawn OVER the pill, and a filled round rect here would
    ' erase everything above. Its band is reserved in the layout whether or not we are
    ' focused, which is what stops the pill jumping when focus arrives.
    if p->isFocused andalso (pTog->nFocusThick > 0) then
        dim as RECT rcRing = p->rcVisual
        dim as long fell = rcRing.bottom - rcRing.top
        b->SetPenColor( pTog->colors.FocusRingColor )
        b->PaintRoundOutline( @rcRing, fell, pTog->nFocusThick )
    end if
end sub


' ========================================================================================
' Process WM_PAINT.
' ========================================================================================
private function PsToggle_OnPaint( byval hwnd as HWND ) as LRESULT
    dim as PSTOGGLE_STATE ptr pTog = GetTogglePointer(hwnd)
    if pTog = null then return 0

    ' Consume any pending layout before painting -- this is what makes layout lazy.
    if pTog->bLayoutDirty then pTog->LayoutToggle()

    dim as PsPaintBuffer b
    b.BeginDoubleBuffer(hwnd)
    b.SetBackColor( pTog->colors.BackColor )
    b.PaintClientRect()

    dim p as PSTOGGLE_PAINTINFO
    p.hToggle  = hwnd
    p.b        = @b
    GetClientRect( hwnd, @p.rcClient )
    p.rcTrack  = pTog->rcTrack
    p.rcKnob   = pTog->rcKnob
    p.rcVisual = pTog->rcVisual
    p.isChecked = pTog->isChecked
    p.isHot     = pTog->isHot
    ' "The press is still armed" is exactly "pressed AND the cursor is still inside" --
    ' hover tracking maintains isHot through the capture, so there is no second flag.
    p.isPressed = pTog->isPressed andalso pTog->isHot
    p.isEnabled = pTog->isEnabled
    p.isFocused = pTog->isFocused

    if pTog->PaintCallback then
        pTog->PaintCallback( @p )
    else
        PsToggle_RenderDefault( pTog, @b, @p )
    end if

    b.EndDoubleBuffer()
    function = 0
end function


' ========================================================================================
' Clear the hover state and stop the hover poll timer. Repaints only if the state actually
' changes, so this is cheap to call repeatedly.
'
' Note this also changes how a live press LOOKS (the painter derives isPressed from isHot),
' which is exactly right: the cursor left, so the press must stop looking armed. The gesture
' itself survives -- only a release or a capture loss ends it.
' ========================================================================================
private sub PsToggle_ClearHot( byval pTog as PSTOGGLE_STATE ptr, byval hwnd as HWND )
    if pTog = 0 then exit sub
    if pTog->hotTimerOn then
        KillTimer( hwnd, IDT_CTOGGLE_HOTTRACK )
        pTog->hotTimerOn = false
    end if
    if pTog->isHot then
        pTog->isHot = false
        InvalidateRect( hwnd, NULL, FALSE )
    end if
end sub


' ========================================================================================
' Flip the state because the USER asked for it -- a completed click, or Space/Enter. The one
' place that fires the change callback, so click and keyboard cannot drift apart.
'
' The layout is marked dirty because the KNOB MOVED: rcKnob depends on isChecked, and it is
' LayoutToggle that positions it. Setting isChecked without this would leave the knob drawn
' at the old end.
'
' The callback goes out LAST, after the state is consistent, so a host that queries
' PsToggle_GetChecked() from inside it sees the new value.
' ========================================================================================
private sub PsToggle_ApplyUserToggle( byval pTog as PSTOGGLE_STATE ptr, byval hwnd as HWND )
    if pTog = 0 then exit sub
    pTog->isChecked = not pTog->isChecked
    pTog->bLayoutDirty = true
    InvalidateRect( hwnd, NULL, FALSE )
    if pTog->CheckChangedCallback then pTog->CheckChangedCallback( hwnd, pTog->isChecked )
end sub


' ========================================================================================
' PsToggle Window procedure
'
' This control has no child windows, so there is nothing to subclass: every message is
' handled here and anything unhandled goes to DefWindowProc.
'
' THE CONTROL TAKES MOUSE CAPTURE on a press. Something consumes the guaranteed
' WM_LBUTTONDOWN -> WM_LBUTTONUP pairing: the press/cancel gesture. Press the toggle, slide
' off it, release -- the state does NOT flip. The full price is paid, in the order the
' family learned to pay it:
'   - WM_LBUTTONUP SNAPSHOTS isPressed, THEN releases capture. ReleaseCapture sends
'     WM_CAPTURECHANGED synchronously and that handler cancels the press, so reading the
'     flag afterwards would always find FALSE and no click would ever flip anything
'     (Learnings.md);
'   - the release happens before any callback runs;
'   - the message callback's result is IGNORED for WM_LBUTTONUP, so it cannot strand it;
'   - WM_CAPTURECHANGED cancels the press (anything can steal capture at any time);
'   - WM_DESTROY releases it if we still hold it.
'
' CS_DBLCLKS IS DELIBERATELY *NOT* SET -- the opposite call from PsSelectBar and PsSplitter,
' and the reason matters. With CS_DBLCLKS the second of two rapid clicks arrives as
' WM_LBUTTONDBLCLK INSTEAD OF a second WM_LBUTTONDOWN. For a control whose entire job is to
' flip on every click, that would silently swallow every second rapid click and the toggle
' would appear to ignore half the user's input. PsIconPanel omits it for exactly this reason
' on its toggle items; here the control IS a toggle, so the reasoning is stronger still.
' Without the class style, rapid clicking produces a plain down/up pair every time.
'
' FOCUS: this is the first focusable control in the family (WS_TABSTOP, Space/Enter). See
' the WM_GETDLGCODE handler for the one subtlety that needed care.
' ========================================================================================
function PsToggle_WndProc( _
            byval hwnd   as HWND, _
            byval uMsg   as UINT, _
            byval wParam as WPARAM, _
            byval lParam as LPARAM _
            ) as LRESULT

    dim as PSTOGGLE_STATE ptr pTog = GetTogglePointer( hwnd )

    select case uMsg

    case WM_PAINT
        return PsToggle_OnPaint( hwnd )

    case WM_ERASEBKGND
        ' Never erase: WM_PAINT fills the whole client through the double buffer, so a
        ' background erase here would only add flicker.
        return true

    case WM_SIZE
        if pTog then pTog->Refresh()
        return 0

    case WM_TIMER
        if (pTog <> 0) andalso (wParam = IDT_CTOGGLE_HOTTRACK) then
            ' The cursor may have left without us getting a WM_MOUSELEAVE. If it is no
            ' longer over our client area, clear the hot state ourselves. Skipped while a
            ' press is live: under capture the cursor legitimately roams outside, and
            ' WM_MOUSEMOVE is already maintaining isHot correctly for that case.
            if pTog->isPressed = false then
                dim as RECT rcClient
                GetClientRect( hwnd, @rcClient )
                if isMouseOverRECT( hwnd, rcClient ) = false then
                    PsToggle_ClearHot( pTog, hwnd )
                end if
            end if
            return 0
        end if

    case WM_MOUSEMOVE
        if pTog = 0 then exit select
        if pTog->isEnabled = false then exit select

        ' Under capture we receive moves from anywhere on the desktop, so "is the mouse over
        ' us" must be asked of the cursor position and never assumed from the message.
        dim as RECT rcClient
        GetClientRect( hwnd, @rcClient )
        dim as boolean bOver = isMouseOverRECT( hwnd, rcClient )

        if bOver then
            ' Track so we get the eventual WM_MOUSELEAVE.
            dim tme as TrackMouseEvent
            tme.cbSize    = sizeof(TrackMouseEvent)
            tme.dwFlags   = TME_LEAVE
            tme.hwndTrack = hwnd
            TrackMouseEvent(@tme)

            ' Safety net: WM_MOUSELEAVE is not guaranteed to arrive when the mouse exits
            ' quickly (or onto another control), which would strand the control painted hot.
            if pTog->hotTimerOn = false then
                SetTimer( hwnd, IDT_CTOGGLE_HOTTRACK, PSTOGGLE_HOTTRACK_MS, NULL )
                pTog->hotTimerOn = true
            end if
        end if

        if bOver <> pTog->isHot then
            pTog->isHot = bOver
            InvalidateRect( hwnd, NULL, FALSE )
        end if

        if PsToggle_CallMessage( pTog, hwnd, uMsg, wParam, lParam ) then return 0

    case WM_MOUSELEAVE
        if pTog then
            ' Fast path for clearing the hot state (the WM_TIMER poll is the fallback for
            ' when this message never arrives).
            if pTog->isPressed = false then PsToggle_ClearHot( pTog, hwnd )
            if PsToggle_CallMessage( pTog, hwnd, uMsg, wParam, lParam ) then return 0
        end if

    case WM_LBUTTONDOWN
        if pTog = 0 then return 0
        ' A disabled window does not receive mouse input at all (PsToggle_SetEnabled calls
        ' EnableWindow), so this is belt-and-braces against a host that disabled us by some
        ' other route.
        if pTog->isEnabled = false then return 0

        ' Focus first, and unconditionally: clicking a control focuses it, and that is true
        ' even if the host goes on to suppress the press. Note this runs WM_SETFOCUS
        ' synchronously, so isFocused is already correct by the time we paint below.
        SetFocus( hwnd )

        ' Suppressing the press is allowed: no capture has been taken yet, so there is no
        ' bookkeeping to strand.
        if PsToggle_CallMessage( pTog, hwnd, uMsg, wParam, lParam ) then return 0

        SetCapture( hwnd )
        pTog->isPressed = true
        pTog->isHot     = true
        InvalidateRect( hwnd, NULL, FALSE )
        return 0

    case WM_LBUTTONUP
        if pTog = 0 then return 0

        ' SNAPSHOT BEFORE RELEASING. ReleaseCapture sends WM_CAPTURECHANGED to the window
        ' losing capture SYNCHRONOUSLY, and our handler for it cancels the press -- so
        ' reading isPressed after the release would always find FALSE and nothing would ever
        ' flip.
        dim as boolean bWasPressed = pTog->isPressed
        ' Release capture unconditionally, before any callback runs. Nothing below -- not a
        ' callback, not a host handler -- gets the chance to leave it held.
        if GetCapture() = hwnd then ReleaseCapture()

        dim as RECT rcClient
        GetClientRect( hwnd, @rcClient )
        dim as boolean bInside = isMouseOverRECT( hwnd, rcClient )

        pTog->CancelPress()
        InvalidateRect( hwnd, NULL, FALSE )

        ' The result is deliberately IGNORED here (see TOG_MessageCallbackFunc).
        PsToggle_CallMessage( pTog, hwnd, uMsg, wParam, lParam )

        ' Only a matched press+release with the cursor still inside flips the state. Press,
        ' slide off, release = nothing happened, which is the whole reason for capture.
        ' isEnabled is re-read because a callback may have disabled us mid-gesture.
        dim as boolean bFlip = bWasPressed andalso bInside andalso pTog->isEnabled
        if bFlip then PsToggle_ApplyUserToggle( pTog, hwnd )
        return 0

    case WM_CAPTURECHANGED
        ' Capture can be stolen at any time (a modal dialog, another control, the shell).
        ' The gesture is over; forget it and repaint.
        if pTog then
            pTog->CancelPress()
            InvalidateRect( hwnd, NULL, FALSE )
            return 0
        end if

    case WM_RBUTTONDOWN, WM_RBUTTONUP
        ' Reported, never acted on: a context menu is the host's business (PsPopupMenu). No
        ' capture is taken for the right button, so an up can arrive without a down.
        if pTog then
            if PsToggle_CallMessage( pTog, hwnd, uMsg, wParam, lParam ) then return 0
        end if

    case WM_SETFOCUS, WM_KILLFOCUS
        ' A pending swallow must not survive a focus change: the WM_CHAR it was armed for is
        ' not coming, and a stale flag would eat the next character instead.
        if pTog then pTog->bAteKeyDown = false
        ' Focus is a FACT reported by the system, not an action a host can veto, so the
        ' state is updated first and the callback's result is IGNORED. A host that wants to
        ' refuse focus must not make the control a tabstop in the first place.
        if pTog then
            dim as boolean bFocused = (uMsg = WM_SETFOCUS)
            if bFocused <> pTog->isFocused then
                pTog->isFocused = bFocused
                InvalidateRect( hwnd, NULL, FALSE )
            end if
            PsToggle_CallMessage( pTog, hwnd, uMsg, wParam, lParam )
            return 0
        end if

    case WM_GETDLGCODE
        ' Claim ONLY the two keys we actually consume, and only when we are being asked
        ' about a specific message (lParam points at the MSG when it does).
        '
        ' Claiming unconditionally would return DLGC_WANTALLKEYS for Tab as well, and the
        ' control would swallow the very navigation it just opted into by being a tabstop.
        ' Claiming nothing would let a host's IsDialogMessage pump route Enter to the
        ' dialog's default button before the control ever saw it. Per-message is the only
        ' answer that gets both right.
        if lParam then
            dim as MSG ptr pMsg = cast( MSG ptr, lParam )
            ' Claim the CHARACTER produced by a key we already consumed. Claiming a key with
            ' DLGC_WANTALLKEYS makes IsDialogMessage TranslateMessage it, which manufactures a
            ' matching WM_CHAR; if nothing claims that, it reaches DefWindowProc and beeps.
            if pMsg->message = WM_CHAR then
                if pTog then
                    if pTog->bAteKeyDown then return DLGC_WANTALLKEYS
                end if
            end if
            if pMsg->message = WM_KEYDOWN then
                select case pMsg->wParam
                case VK_SPACE, VK_RETURN
                    return DLGC_WANTALLKEYS
                end select
            end if
        end if
        return 0

    case WM_CHAR
        ' Swallow the character generated by a key WM_KEYDOWN already acted on, so it never
        ' reaches DefWindowProc -- which beeps at a character no control wants. The keystroke
        ' works either way, so the beep is the ONLY symptom and no assertion can hear it.
        '
        ' Anything we did not consume falls through untouched. WM_SYSCHAR is deliberately not
        ' touched either: swallowing it would break Alt+F4 and the host's menu mnemonics.
        if pTog = 0 then exit select
        if pTog->bAteKeyDown then
            pTog->bAteKeyDown = false
            return 0
        end if

    case WM_KEYDOWN
        if pTog = 0 then exit select
        ' Arm the character swallow (see WM_CHAR). Every path below that handles one of these
        ' keys consumes it, so the key alone decides -- and only keys that actually produce a
        ' WM_CHAR are armed.
        pTog->bAteKeyDown = (wParam = VK_SPACE) orelse (wParam = VK_RETURN)
        if pTog->isEnabled = false then return 0
        if PsToggle_CallMessage( pTog, hwnd, uMsg, wParam, lParam ) then return 0
        select case wParam
        case VK_SPACE, VK_RETURN
            ' Same path a completed click takes, so keyboard and mouse cannot drift apart:
            ' both are user action, both notify.
            PsToggle_ApplyUserToggle( pTog, hwnd )
            return 0
        end select
        ' Arrow keys are deliberately NOT handled. Left=off / Right=on is a common toggle
        ' idiom but was not asked for, and adding it would mean claiming the arrows in
        ' WM_GETDLGCODE too and taking them away from the dialog manager's navigation.

    case WM_ENABLE
        ' Keeps our own flag true to the window's real state, so a host that reaches for
        ' EnableWindow directly instead of PsToggle_SetEnabled still gets the greyed
        ' rendering rather than a control that looks live but eats input.
        if pTog then
            pTog->isEnabled = (wParam <> 0)
            if pTog->isEnabled = false then
                pTog->isHot = false
                pTog->CancelPress()
            end if
            InvalidateRect( hwnd, NULL, FALSE )
        end if

    case WM_DESTROY
        if pTog then
            ' Don't let the hot-tracking timer outlive the window...
            if pTog->hotTimerOn then
                KillTimer( hwnd, IDT_CTOGGLE_HOTTRACK )
                pTog->hotTimerOn = false
            end if
            ' ...nor the capture, if we are being destroyed mid-press.
            if GetCapture() = hwnd then ReleaseCapture()
            pTog->CancelPress()
        end if

    case WM_NCDESTROY
        ' Delete the stored toggle data pointer. There is no tooltip window and no font to
        ' release: the control owns no host resources.
        if pTog then delete(pTog)

        ' delete the allocated memory for window
        dim as CWindow ptr pWindow = CWindowPtr(hwnd)
        if pWindow then delete(pWindow)
        return 0

    end select

    ' for messages that we don't deal with
    function = DefWindowProc( hwnd, uMsg, wParam, lParam )

end function


' ========================================================================================
' PsToggle_Create
' ========================================================================================
public function PsToggle_Create( byval hWndParent as HWND, byval CtrlID as long ) as HWND

    dim pWindow as CWindow ptr = New CWindow

    ' WS_TABSTOP: this control takes focus, unlike most of its siblings. There is no
    ' WS_EX_CONTROLPARENT because there is no child to see through to -- the tabstop is on
    ' this window itself.
    '
    ' THE TRAILING 0 IS THAT SENTENCE'S IMPLEMENTATION, AND IT WAS MISSING UNTIL 2026-07-23.
    ' CWindow.Create defaults its dwExStyle parameter to WS_EX_CONTROLPARENT OR
    ' WS_EX_WINDOWEDGE, so passing only dwStyle -- as this call did -- silently declared the
    ' control a CONTAINER. The dialog manager then descended into it looking for tabstops,
    ' found no children, and SKIPPED it: Tab never landed on a PsToggle, in this repo's demo
    ' or in any host. The comment above was written as an intention and read for months as a
    ' statement of fact; nothing at the call site showed an extended style being chosen at all.
    '
    ' DO NOT COPY THIS INTO A WRAP-A-REAL-CHILD CONTROL. PsListBox, PsTextBox, PsNumericUpDown
    ' and PsScrollPanel all NEED WS_EX_CONTROLPARENT, because their tabstop lives on an inner
    ' child; passing 0 there would make them unreachable instead. The test is "does this
    ' window have children the dialog manager should find?", not "is this a control?".
    ' Full write-up in C:\dev\Learnings.md.
    dim as HWND hCtrl = _
            pWindow->Create( hWndParent, "", @PsToggle_WndProc, _
            0, 0, 0, 0, WS_CHILD or WS_TABSTOP or WS_CLIPSIBLINGS or WS_CLIPCHILDREN, _
            0 _
            )

    ' NOTE: CS_DBLCLKS is deliberately NOT enabled here -- see the WndProc header. It would
    ' turn every second rapid click into a WM_LBUTTONDBLCLK and the toggle would drop it.

    dim as PSTOGGLE_STATE ptr pTog = new PSTOGGLE_STATE
    pTog->hWin       = hCtrl
    pTog->idc_Toggle = CtrlID

    ' Only the Create-time defaults are DPI-scaled for us; every setter afterwards takes raw
    ' pixels and the caller scales (the family rule). The inset and the focus gap take
    ' ScaleY because they are subtracted from the track HEIGHT (they apply on both axes, and
    ' ScaleX and ScaleY agree in practice, but the height arithmetic is the one that has to
    ' stay consistent). nBorderThick and nFocusThick are NOT scaled at all -- a hairline
    ' should stay a hairline, which is PsMenuBar's nSeparatorThickness rule.
    pTog->nTrackWidth  = pWindow->ScaleX( PSTOGGLE_DEFAULT_TRACKW )
    pTog->nTrackHeight = pWindow->ScaleY( PSTOGGLE_DEFAULT_TRACKH )
    pTog->nKnobInset   = pWindow->ScaleY( PSTOGGLE_DEFAULT_KNOBINSET )
    pTog->nFocusGap    = pWindow->ScaleY( PSTOGGLE_DEFAULT_FOCUSGAP )

    SetWindowLongPtr( hCtrl, GWLP_ID, CtrlID )

    ' Store the new pointer into the user data area of the toggle window
    pWindow->UserData(0) = cast(LONG_PTR, pTog)

    function = hCtrl

end function


' ========================================================================================
' State
' ========================================================================================
public function PsToggle_GetChecked( byval hToggle as HWND ) as boolean
    dim as PSTOGGLE_STATE ptr pTog = GetTogglePointer(hToggle)
    if pTog = 0 then return false
    return pTog->isChecked
end function

' ========================================================================================
' SILENT: the change callback fires only for user interaction. See the header.
' ========================================================================================
public sub PsToggle_SetChecked( byval hToggle as HWND, byval isChecked as boolean )
    dim as PSTOGGLE_STATE ptr pTog = GetTogglePointer(hToggle)
    if pTog = 0 then exit sub
    if pTog->isChecked = isChecked then exit sub
    pTog->isChecked = isChecked
    pTog->Refresh()          ' the knob moved, so the layout is stale
end sub

public function PsToggle_GetEnabled( byval hToggle as HWND ) as boolean
    dim as PSTOGGLE_STATE ptr pTog = GetTogglePointer(hToggle)
    if pTog = 0 then return false
    return pTog->isEnabled
end function

' ========================================================================================
' Greys the control AND disables the window. Going through EnableWindow rather than just
' painting differently is what actually stops the input: a disabled window receives no mouse
' messages and the dialog manager's Tab skips it, so there is no way for a click or a
' keystroke to sneak past the cosmetic check. WM_ENABLE does the state clearing (and covers
' a host that calls EnableWindow itself); the work is repeated here because Windows sends no
' WM_ENABLE when the state was already what we asked for.
' ========================================================================================
public sub PsToggle_SetEnabled( byval hToggle as HWND, byval isEnabled as boolean )
    dim as PSTOGGLE_STATE ptr pTog = GetTogglePointer(hToggle)
    if pTog = 0 then exit sub
    pTog->isEnabled = isEnabled
    if isEnabled then
        EnableWindow( hToggle, TRUE )
    else
        EnableWindow( hToggle, FALSE )
        pTog->isHot = false
        pTog->CancelPress()
    end if
    InvalidateRect( hToggle, NULL, FALSE )
end sub

function PsToggle_GetFocused( byval hToggle as HWND ) as boolean
    dim as PSTOGGLE_STATE ptr pTog = GetTogglePointer(hToggle)
    if pTog = 0 then return false
    return pTog->isFocused
end function

sub PsToggle_Refresh( byval hToggle as HWND )
    dim as PSTOGGLE_STATE ptr pTog = GetTogglePointer(hToggle)
    if pTog = 0 then exit sub
    pTog->Refresh()
end sub


' ========================================================================================
' Layout.  All setters take RAW PIXELS -- the caller DPI-scales.
' ========================================================================================
public sub PsToggle_GetTrackSize( byval hToggle as HWND, byref nTrackWidth as long, byref nTrackHeight as long )
    nTrackWidth  = 0
    nTrackHeight = 0
    dim as PSTOGGLE_STATE ptr pTog = GetTogglePointer(hToggle)
    if pTog = 0 then exit sub
    nTrackWidth  = pTog->nTrackWidth
    nTrackHeight = pTog->nTrackHeight
end sub

public sub PsToggle_SetTrackSize( byval hToggle as HWND, byval nTrackWidth as long, byval nTrackHeight as long )
    dim as PSTOGGLE_STATE ptr pTog = GetTogglePointer(hToggle)
    if pTog = 0 then exit sub
    if nTrackWidth  < 1 then nTrackWidth  = 1
    if nTrackHeight < 1 then nTrackHeight = 1
    pTog->nTrackWidth  = nTrackWidth
    pTog->nTrackHeight = nTrackHeight
    pTog->Refresh()
end sub

public function PsToggle_GetKnobInset( byval hToggle as HWND ) as long
    dim as PSTOGGLE_STATE ptr pTog = GetTogglePointer(hToggle)
    if pTog = 0 then return 0
    return pTog->nKnobInset
end function

public sub PsToggle_SetKnobInset( byval hToggle as HWND, byval nKnobInset as long )
    dim as PSTOGGLE_STATE ptr pTog = GetTogglePointer(hToggle)
    if pTog = 0 then exit sub
    if nKnobInset < 0 then nKnobInset = 0
    pTog->nKnobInset = nKnobInset
    pTog->Refresh()
end sub

public function PsToggle_GetBorderThickness( byval hToggle as HWND ) as long
    dim as PSTOGGLE_STATE ptr pTog = GetTogglePointer(hToggle)
    if pTog = 0 then return 0
    return pTog->nBorderThick
end function

' Thickness only, no layout consequence: the border is drawn INSIDE the track, so changing
' it repaints but never moves anything. Zero means no border at all.
sub PsToggle_SetBorderThickness( byval hToggle as HWND, byval nThickness as long )
    dim as PSTOGGLE_STATE ptr pTog = GetTogglePointer(hToggle)
    if pTog = 0 then exit sub
    if nThickness < 0 then nThickness = 0
    pTog->nBorderThick = nThickness
    if pTog->hWin then InvalidateRect( pTog->hWin, NULL, FALSE )
end sub

public sub PsToggle_GetFocusRing( byval hToggle as HWND, byref nGap as long, byref nThickness as long )
    nGap       = 0
    nThickness = 0
    dim as PSTOGGLE_STATE ptr pTog = GetTogglePointer(hToggle)
    if pTog = 0 then exit sub
    nGap       = pTog->nFocusGap
    nThickness = pTog->nFocusThick
end sub

' BOTH are layout inputs, focused or not: the ring's band is reserved unconditionally so the
' pill does not jump when focus arrives, which means either value changes the ideal size.
public sub PsToggle_SetFocusRing( byval hToggle as HWND, byval nGap as long, byval nThickness as long )
    dim as PSTOGGLE_STATE ptr pTog = GetTogglePointer(hToggle)
    if pTog = 0 then exit sub
    if nGap < 0 then nGap = 0
    if nThickness < 0 then nThickness = 0
    pTog->nFocusGap   = nGap
    pTog->nFocusThick = nThickness
    pTog->Refresh()
end sub

public function PsToggle_GetJustify( byval hToggle as HWND ) as long
    dim as PSTOGGLE_STATE ptr pTog = GetTogglePointer(hToggle)
    if pTog = 0 then return TOG_JUSTIFY_CENTER
    return pTog->nJustify
end function

public sub PsToggle_SetJustify( byval hToggle as HWND, byval nJustify as long )
    dim as PSTOGGLE_STATE ptr pTog = GetTogglePointer(hToggle)
    if pTog = 0 then exit sub
    select case nJustify
    case TOG_JUSTIFY_LEFT, TOG_JUSTIFY_CENTER, TOG_JUSTIFY_RIGHT
    case else
        exit sub                 ' ignore garbage rather than laying out somewhere strange
    end select
    pTog->nJustify = nJustify
    pTog->Refresh()
end sub

' ========================================================================================
' The visual bounds: the pill plus the focus-ring band on every side. Computed straight from
' the scalars and NOT from the layout, so it is valid before the control has ever been
' sized -- which is the whole point, since a host calls this to decide how big to make it.
' ========================================================================================
public sub PsToggle_GetIdealSize( byval hToggle as HWND, byref nWidth as long, byref nHeight as long )
    nWidth  = 0
    nHeight = 0
    dim as PSTOGGLE_STATE ptr pTog = GetTogglePointer(hToggle)
    if pTog = 0 then exit sub
    dim as long ringPad = pTog->RingPad()
    nWidth  = pTog->nTrackWidth  + (2 * ringPad)
    nHeight = pTog->nTrackHeight + (2 * ringPad)
end sub

' ========================================================================================
' Rect queries. Each forces a pending layout, so results are always current. FALSE means the
' control has no geometry yet (created but never sized).
' ========================================================================================
public function PsToggle_GetTrackRect( byval hToggle as HWND, byref rc as RECT ) as boolean
    SetRectEmpty( @rc )
    dim as PSTOGGLE_STATE ptr pTog = GetTogglePointer(hToggle)
    if pTog = 0 then return false
    if pTog->bLayoutDirty then pTog->LayoutToggle()
    if pTog->bLayoutDirty then return false        ' still no client area
    rc = pTog->rcTrack
    return true
end function

public function PsToggle_GetKnobRect( byval hToggle as HWND, byref rc as RECT ) as boolean
    SetRectEmpty( @rc )
    dim as PSTOGGLE_STATE ptr pTog = GetTogglePointer(hToggle)
    if pTog = 0 then return false
    if pTog->bLayoutDirty then pTog->LayoutToggle()
    if pTog->bLayoutDirty then return false
    rc = pTog->rcKnob
    return true
end function

public function PsToggle_GetVisualRect( byval hToggle as HWND, byref rc as RECT ) as boolean
    SetRectEmpty( @rc )
    dim as PSTOGGLE_STATE ptr pTog = GetTogglePointer(hToggle)
    if pTog = 0 then return false
    if pTog->bLayoutDirty then pTog->LayoutToggle()
    if pTog->bLayoutDirty then return false
    rc = pTog->rcVisual
    return true
end function


' ========================================================================================
' Appearance
' ========================================================================================
public sub PsToggle_GetColors( byval hToggle as HWND, byval pColors as PSTOGGLE_COLORS ptr )
    if pColors = 0 then exit sub
    dim as PSTOGGLE_STATE ptr pTog = GetTogglePointer(hToggle)
    if pTog = 0 then exit sub
    *pColors = pTog->colors
end sub

public sub PsToggle_SetColors( byval hToggle as HWND, byval pColors as PSTOGGLE_COLORS ptr )
    if pColors = 0 then exit sub
    dim as PSTOGGLE_STATE ptr pTog = GetTogglePointer(hToggle)
    if pTog = 0 then exit sub
    pTog->colors = *pColors
    if pTog->hWin then InvalidateRect( pTog->hWin, NULL, TRUE )
end sub


' ========================================================================================
' Callbacks
' ========================================================================================
public sub PsToggle_SetPaintCallback( byval hToggle as HWND, byval usersub as TOG_PaintCallbackSub )
    dim as PSTOGGLE_STATE ptr pTog = GetTogglePointer(hToggle)
    if pTog = 0 then exit sub
    pTog->PaintCallback = usersub
    if pTog->hWin then InvalidateRect( pTog->hWin, NULL, TRUE )
end sub

public sub PsToggle_SetMessageCallback( byval hToggle as HWND, byval userfunc as TOG_MessageCallbackFunc )
    dim as PSTOGGLE_STATE ptr pTog = GetTogglePointer(hToggle)
    if pTog = 0 then exit sub
    pTog->MessageCallback = userfunc
end sub

public sub PsToggle_SetCheckChangedCallback( byval hToggle as HWND, byval usersub as TOG_CheckChangedCallbackSub )
    dim as PSTOGGLE_STATE ptr pTog = GetTogglePointer(hToggle)
    if pTog = 0 then exit sub
    pTog->CheckChangedCallback = usersub
end sub
