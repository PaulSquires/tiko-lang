''
''  vendor/PsControls/PsRegistry  --  the controls' process-wide registry
''

#module "PsRegistry"

#import "sys/win"

' Every PsControl that places an obligation on the host's message pump registers here, and
' vendor/PsControls/PsApp's pump walks the registry instead of naming each control. A host with
' a hand-written pump that calls each control's FilterMessage itself is unaffected: the rows
' exist, nothing walks them, and no control behaves differently either way.
'
' Two kinds of entry:
'
'   ROWS, one per control HWND. A row carries an optional per-instance filter (h, pMsg) and an
'   optional dismiss proc that closes whatever the control has open (a dropdown, a menu chain)
'   when its top-level window loses the activation. A row's priority orders the walk:
'   PSREG_PRIO_OWNER rows (controls that own popups) are filtered before PSREG_PRIO_POPUP rows
'   (standalone PsPopupMenu chains the host shows itself).
'
'   GLOBAL FILTERS, one per filter procedure, reference-counted. PsTextBox, PsNumericUpDown,
'   PsDatePicker and PsListTree each export a FilterMessage( pMsg ) that serves every instance at
'   once; each instance adds a reference in Create and releases it in WM_DESTROY.
'
' Every filter the family exports stands down at its first comparison unless ITS OWN chain is
' open, and only one popup chain can be open in a process, so calling all of them per message is
' cheap and cannot double-handle anything.
'
' THE POPUP-ROW RULE. A popup another control owns is filtered by that owner and never by its own
' row: PsMenuBar's filter, for one, deliberately returns FALSE for a click on the bar so the bar's
' toggle handler gets it, and a popup row walked after it would treat that click as an outside
' click and close the chain. Every API that hands a popup to an owner therefore removes its row.
'
' RE-ENTRANCY. A filter can destroy windows, and a destroyed control removes its row from its
' WM_DESTROY. During a walk a removal only marks the row dead; the walk compacts the table when
' it ends. Rows added during a walk are first visited on the next message.

public type PSREG_FilterProc       as function( byval h as HWND, byval pMsg as MSG ptr ) as boolean
public type PSREG_GlobalFilterProc as function( byval pMsg as MSG ptr ) as boolean
public type PSREG_DismissProc      as sub( byval h as HWND )

public enum PSREG_PRIO
    PSREG_PRIO_OWNER = 0
    PSREG_PRIO_POPUP = 1
end enum

type PSREG_ROW
    hwnd     as HWND
    prio     as long
    pFilter  as PSREG_FilterProc
    pDismiss as PSREG_DismissProc
    bDead    as boolean
end type

type PSREG_GLOBAL
    pFilter as PSREG_GlobalFilterProc
    nRefs   as long
end type

dim shared gREG_Rows( any ) as PSREG_ROW
dim shared gREG_RowCount as long
dim shared gREG_Globals( any ) as PSREG_GLOBAL
dim shared gREG_GlobalCount as long
dim shared gREG_WalkDepth as long        ' > 0 while a walk is in progress (walks can nest)
dim shared gREG_HasDead as boolean


private function REG_FindRow( byval h as HWND ) as long
    for i as long = 0 to gREG_RowCount - 1
        if (gREG_Rows(i).hwnd = h) andalso (gREG_Rows(i).bDead = false) then return i
    next
    return -1
end function

private sub REG_Compact( )
    if gREG_WalkDepth > 0 then exit sub
    if gREG_HasDead = false then exit sub
    dim as long n = 0
    for i as long = 0 to gREG_RowCount - 1
        if gREG_Rows(i).bDead = false then
            if n <> i then gREG_Rows(n) = gREG_Rows(i)
            n += 1
        end if
    next
    gREG_RowCount = n
    gREG_HasDead = false
end sub


' ========================================================================================
' Adds a row for h, or replaces the procs of h's existing row (a control that registers twice
' keeps one row). Either proc may be null.
' ========================================================================================
public sub PsRegistry_Add( byval h as HWND, byval prio as long, _
                           byval pFilter as PSREG_FilterProc, _
                           byval pDismiss as PSREG_DismissProc = 0 )
    if h = 0 then exit sub
    dim as long idx = REG_FindRow( h )
    if idx = -1 then
        if gREG_RowCount > ubound(gREG_Rows) then
            dim as long cap = (ubound(gREG_Rows) + 1) * 2
            if cap < 16 then cap = 16
            redim preserve gREG_Rows( 0 to cap - 1 )
        end if
        idx = gREG_RowCount
        gREG_RowCount += 1
    end if
    gREG_Rows(idx).hwnd     = h
    gREG_Rows(idx).prio     = prio
    gREG_Rows(idx).pFilter  = pFilter
    gREG_Rows(idx).pDismiss = pDismiss
    gREG_Rows(idx).bDead    = false
end sub

' ========================================================================================
' Removes h's row. A no-op when h has none -- which is the normal case for a popup that was
' handed to an owner and so had its row removed already.
' ========================================================================================
public sub PsRegistry_Remove( byval h as HWND )
    dim as long idx = REG_FindRow( h )
    if idx = -1 then exit sub
    gREG_Rows(idx).bDead = true
    gREG_HasDead = true
    REG_Compact()
end sub

' ========================================================================================
' Global filters: one entry per procedure, one reference per instance that relies on it.
' ========================================================================================
public sub PsRegistry_AddGlobalFilter( byval p as PSREG_GlobalFilterProc )
    if p = 0 then exit sub
    for i as long = 0 to gREG_GlobalCount - 1
        if gREG_Globals(i).pFilter = p then
            gREG_Globals(i).nRefs += 1
            exit sub
        end if
    next
    ' A zero-reference entry is kept in place (never compacted while a walk might be reading
    ' the array), so reuse one before growing.
    for i as long = 0 to gREG_GlobalCount - 1
        if gREG_Globals(i).nRefs = 0 then
            gREG_Globals(i).pFilter = p
            gREG_Globals(i).nRefs = 1
            exit sub
        end if
    next
    if gREG_GlobalCount > ubound(gREG_Globals) then
        redim preserve gREG_Globals( 0 to gREG_GlobalCount + 7 )
    end if
    gREG_Globals(gREG_GlobalCount).pFilter = p
    gREG_Globals(gREG_GlobalCount).nRefs = 1
    gREG_GlobalCount += 1
end sub

public sub PsRegistry_ReleaseGlobalFilter( byval p as PSREG_GlobalFilterProc )
    if p = 0 then exit sub
    for i as long = 0 to gREG_GlobalCount - 1
        if (gREG_Globals(i).pFilter = p) andalso (gREG_Globals(i).nRefs > 0) then
            gREG_Globals(i).nRefs -= 1
            if gREG_Globals(i).nRefs = 0 then gREG_Globals(i).pFilter = 0
            exit sub
        end if
    next
end sub


' ========================================================================================
' The pump's one call: TRUE when a filter consumed the message. Order: global filters, then
' PSREG_PRIO_OWNER rows, then PSREG_PRIO_POPUP rows, each in registration order.
' ========================================================================================
public function PsRegistry_FilterMessage( byval pMsg as MSG ptr ) as boolean
    if pMsg = 0 then return false
    dim as boolean bEaten = false
    gREG_WalkDepth += 1

    ' Counts are read once: entries added by a filter wait for the next message.
    dim as long nGlobals = gREG_GlobalCount
    for i as long = 0 to nGlobals - 1
        dim as PSREG_GlobalFilterProc p = gREG_Globals(i).pFilter
        if (p <> 0) andalso (gREG_Globals(i).nRefs > 0) then
            if p( pMsg ) then
                bEaten = true
                exit for
            end if
        end if
    next

    dim as long nRows = gREG_RowCount
    for prio as long = PSREG_PRIO_OWNER to PSREG_PRIO_POPUP
        if bEaten then exit for
        for i as long = 0 to nRows - 1
            if gREG_Rows(i).bDead then continue for
            if gREG_Rows(i).prio <> prio then continue for
            dim as PSREG_FilterProc p = gREG_Rows(i).pFilter
            if p = 0 then continue for
            dim as HWND h = gREG_Rows(i).hwnd
            if IsWindow( h ) = 0 then continue for
            if p( h, pMsg ) then
                bEaten = true
                exit for
            end if
        next
    next

    gREG_WalkDepth -= 1
    REG_Compact()
    return bEaten
end function

' ========================================================================================
' Closes whatever is open under hRoot (every row whose top-level window is hRoot), or under
' every window when hRoot is null. Called on WM_ACTIVATEAPP( FALSE ), so a dropdown or menu
' does not outlive the activation by the up-to-100ms its own foreground poll would take.
' ========================================================================================
public sub PsRegistry_Dismiss( byval hRoot as HWND )
    gREG_WalkDepth += 1
    dim as long nRows = gREG_RowCount
    for i as long = 0 to nRows - 1
        if gREG_Rows(i).bDead then continue for
        dim as PSREG_DismissProc p = gREG_Rows(i).pDismiss
        if p = 0 then continue for
        dim as HWND h = gREG_Rows(i).hwnd
        if IsWindow( h ) = 0 then continue for
        if hRoot <> 0 then
            ' A popup is a top-level window owned by the form; a control is a child of it.
            dim as HWND hTop = GetAncestor( h, GA_ROOTOWNER )
            if (hTop <> hRoot) andalso (GetAncestor( h, GA_ROOT ) <> hRoot) then continue for
        end if
        p( h )
    next
    gREG_WalkDepth -= 1
    REG_Compact()
end sub

' ========================================================================================
' Counts, for tests: live rows, and global filters holding at least one reference.
' ========================================================================================
public function PsRegistry_Count( ) as long
    dim as long n = 0
    for i as long = 0 to gREG_RowCount - 1
        if gREG_Rows(i).bDead = false then n += 1
    next
    return n
end function

public function PsRegistry_GlobalCount( ) as long
    dim as long n = 0
    for i as long = 0 to gREG_GlobalCount - 1
        if gREG_Globals(i).nRefs > 0 then n += 1
    next
    return n
end function

public function PsRegistry_HasRow( byval h as HWND ) as boolean
    return REG_FindRow( h ) <> -1
end function
