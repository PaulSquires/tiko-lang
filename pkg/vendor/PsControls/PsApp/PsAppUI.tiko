''
''  vendor/PsControls/PsApp  --  the UI thread: RunOnUI and window-less timers
''

#module "PsApp"

#ifndef TIKO_OS_WINDOWS
    #error "vendor/PsControls is Windows-only (Win32 controls): build for -target windows-x86_64, or use vendor/tkControls"
#endif

#import "sys/win"

' A window belongs to the thread that created it, so a worker -- a raw thread or a std/tasks
' goroutine -- must never touch one. It hands the work back instead:
'
'     app.RunOnUI( @ShowResult, pResult )      ' from any thread; ShowResult runs on the UI thread
'
' RunOnUI appends to a queue guarded by a critical section and, when the queue was empty, posts
' one message to a hidden message-only window; that window's procedure drains the whole queue
' in order. A WINDOW, not PostThreadMessage: a thread message is lost in any nested loop that
' does not dispatch it (MessageBox, a modal form, a control's own modal loop), while a window's
' message is dispatched by every loop on the thread. Posting only on empty -> non-empty keeps a
' burst of calls from filling the thread's 10,000-message post quota.
'
' The payload is the caller's: RunOnUI copies the pointer, never what it points at.
'
' SetTimer/KillTimer are timers that need no form, backed by the same window -- the documented
' way to poll a std/tasks Channel with TryReceive.

const WM_PSAPP_RUNONUI = WM_APP + &h3A0

type PSAPP_UIITEM
    p       as PSAPP_UIProc
    payload as any ptr
end type

type PSAPP_TIMER
    id      as long
    p       as PSAPP_TimerProc
    payload as any ptr
end type

dim shared gUI_Lock as CRITICAL_SECTION
dim shared gUI_bLockReady as boolean
dim shared gUI_hWnd as HWND                    ' the message-only window; 0 once torn down
dim shared gUI_Queue( any ) as PSAPP_UIITEM
dim shared gUI_Count as long
dim shared gUI_bPosted as boolean              ' a wake-up message is in flight
dim shared gUI_Timers( any ) as PSAPP_TIMER
dim shared gUI_TimerCount as long
dim shared gUI_NextTimerId as long
dim shared gUI_ThreadId as DWORD

' A variable, not a const: assigning a wstr() const to WNDCLASSEXW.lpszClassName is an ICE
' (TKO0994) in tiko at 82da2873e.
dim shared gUI_ClassName as wstring * 16 = "PsApp.UI"


private sub UI_Drain( )
    ' Take the whole queue under the lock, run it outside: a proc may call RunOnUI again, and
    ' what it queues waits for the next wake-up rather than extending this one.
    EnterCriticalSection( @gUI_Lock )
    dim as long n = gUI_Count
    dim as PSAPP_UIITEM items( any )
    if n > 0 then
        redim items( 0 to n - 1 )
        for i as long = 0 to n - 1
            items(i) = gUI_Queue(i)
        next
    end if
    gUI_Count = 0
    gUI_bPosted = false
    LeaveCriticalSection( @gUI_Lock )

    for i as long = 0 to n - 1
        items(i).p( items(i).payload )
    next
end sub

private function UI_WndProc( byval hwnd as HWND, byval uMsg as UINT, byval wParam as WPARAM, _
                             byval lParam as LPARAM ) as LRESULT
    select case uMsg
    case WM_PSAPP_RUNONUI
        UI_Drain()
        return 0
    case WM_TIMER
        dim as long id = cast( long, wParam )
        for i as long = 0 to gUI_TimerCount - 1
            if gUI_Timers(i).id = id then
                ' Copied first: the proc may kill its own timer, which reshuffles the table.
                dim as PSAPP_TIMER t = gUI_Timers(i)
                t.p( t.id, t.payload )
                exit for
            end if
        next
        return 0
    end select
    return DefWindowProcW( hwnd, uMsg, wParam, lParam )
end function

' Init's part: the lock and the window. FALSE when the window cannot be created.
function App_UIInit( ) as boolean
    if gUI_bLockReady = false then
        InitializeCriticalSection( @gUI_Lock )
        gUI_bLockReady = true
    end if
    gUI_ThreadId = GetCurrentThreadId()
    dim as WNDCLASSEXW wc
    wc.cbSize = sizeof( wc )
    wc.lpfnWndProc = @UI_WndProc
    wc.hInstance = GetModuleHandleW( null )
    wc.lpszClassName = @gUI_ClassName
    RegisterClassExW( @wc )               ' fails harmlessly if a previous Init registered it
    dim as HWND h = CreateWindowExW( 0, @gUI_ClassName, "", 0, 0, 0, 0, 0, HWND_MESSAGE, null, _
                                     wc.hInstance, null )
    EnterCriticalSection( @gUI_Lock )
    gUI_hWnd = h
    gUI_Count = 0
    gUI_bPosted = false
    LeaveCriticalSection( @gUI_Lock )
    return h <> 0
end function

' Run's part of the tear-down. Work still queued is dropped: its procs would run against a
' torn-down application.
sub App_UITeardown( )
    if gUI_bLockReady = false then exit sub
    EnterCriticalSection( @gUI_Lock )
    dim as HWND h = gUI_hWnd
    gUI_hWnd = 0
    gUI_Count = 0
    gUI_bPosted = false
    LeaveCriticalSection( @gUI_Lock )
    if h then
        for i as long = 0 to gUI_TimerCount - 1
            ..KillTimer( h, gUI_Timers(i).id )
        next
        DestroyWindow( h )
    end if
    gUI_TimerCount = 0
    UnregisterClassW( @gUI_ClassName, GetModuleHandleW( null ) )
end sub


' ========================================================================================
' RunOnUI -- any thread. FALSE when there is no running application to run it.
' ========================================================================================
function PsApplication.RunOnUI( byval p as PSAPP_UIProc, byval payload as any ptr = 0 ) as boolean
    if (p = 0) orelse (gUI_bLockReady = false) then return false
    EnterCriticalSection( @gUI_Lock )
    dim as HWND h = gUI_hWnd
    if h = 0 then
        LeaveCriticalSection( @gUI_Lock )
        return false
    end if
    if gUI_Count > ubound( gUI_Queue ) then
        dim as long cap = (ubound( gUI_Queue ) + 1) * 2
        if cap < 64 then cap = 64
        redim preserve gUI_Queue( 0 to cap - 1 )
    end if
    gUI_Queue(gUI_Count).p = p
    gUI_Queue(gUI_Count).payload = payload
    gUI_Count += 1
    dim as boolean bPost = (gUI_bPosted = false)
    if bPost then gUI_bPosted = true
    LeaveCriticalSection( @gUI_Lock )

    if bPost then
        if PostMessageW( h, WM_PSAPP_RUNONUI, 0, 0 ) = 0 then
            ' The post failed (quota): let the next call try again rather than strand the queue.
            EnterCriticalSection( @gUI_Lock )
            gUI_bPosted = false
            LeaveCriticalSection( @gUI_Lock )
        end if
    end if
    return true
end function

' TRUE on the thread that called Init.
function PsApplication.IsUIThread( ) as boolean
    return GetCurrentThreadId() = gUI_ThreadId
end function


' ========================================================================================
' Timers -- UI thread only. SetTimer returns an id that is never 0, or 0 on failure.
' ========================================================================================
function PsApplication.SetTimer( byval ms as ulong, byval p as PSAPP_TimerProc, _
                                 byval payload as any ptr = 0 ) as long
    if (p = 0) orelse (gUI_hWnd = 0) then return 0
    gUI_NextTimerId += 1
    dim as long id = gUI_NextTimerId
    if ..SetTimer( gUI_hWnd, id, ms, null ) = 0 then return 0
    if gUI_TimerCount > ubound( gUI_Timers ) then
        redim preserve gUI_Timers( 0 to gUI_TimerCount + 7 )
    end if
    gUI_Timers(gUI_TimerCount).id = id
    gUI_Timers(gUI_TimerCount).p = p
    gUI_Timers(gUI_TimerCount).payload = payload
    gUI_TimerCount += 1
    return id
end function

sub PsApplication.KillTimer( byval id as long )
    for i as long = 0 to gUI_TimerCount - 1
        if gUI_Timers(i).id = id then
            if gUI_hWnd then ..KillTimer( gUI_hWnd, id )
            for j as long = i to gUI_TimerCount - 2
                gUI_Timers(j) = gUI_Timers(j + 1)
            next
            gUI_TimerCount -= 1
            exit sub
        end if
    next
end sub
