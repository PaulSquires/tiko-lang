''
''  vendor/PsControls/PsApp  --  the application: start-up, the message pump, tear-down
''

#module "PsApp"

#import "sys/win" public
#import "sys/win/gui" public
#import "sys/win/gdiplus"
#import "vendor/PsControls/PsBufferPaint" public
#import "vendor/PsControls/PsRegistry" public

using gui
using gdiplus
using PsBufferPaint
using PsRegistry

' A PsControls program in a dozen lines:
'
'     dim app as PsApplication
'     app.Init( )
'     dim f as PsForm ptr = app.NewForm( "Hello", 640, 400 )
'     ... create controls on f->hWindow, set callbacks, f->OnSize( @MyLayout ) ...
'     end app.Run( f )
'
' Init brings up COM, the DPI awareness, GDI+ and the glyph font; NewForm makes a hidden,
' centred PsForm; Run shows it, focuses its first tab stop, pumps until the main form is
' destroyed (or Quit), and tears down everything Init set up BEFORE it returns -- `end
' app.Run( f )` ends the program without running module-level destructors, so the tear-down
' cannot live in one.
'
' THE PUMP. Every control that places an obligation on the host's pump has registered it with
' vendor/PsControls/PsRegistry, so this pump names no control and an app links only the controls
' it imports. Per message: the registry's filters, the app's own filters, the active form's
' accelerators, IsDialogMessage on the form that owns the message, then Translate/Dispatch.
' Modal forms (PsForm.ShowModal) run the same pump.
'
' Specified in C:\dev\docs\tiko-psapp\RFC-0001-psapp.md.

public enum PSAPP_DPIMODE
    PSAPP_DPI_SYSTEM = 0          ' system-aware: what the demos' manifests declare
    PSAPP_DPI_PERMONITORV2        ' per-monitor v2 (WM_DPICHANGED is handled from RFC phase P4)
    PSAPP_DPI_MANIFEST            ' leave whatever the manifest set
end enum

public enum PSFONT_ROLE
    PSFONT_UI = 0                 ' FontUI at FontUISize
    PSFONT_UI_SMALL               ' FontUI, one point smaller
    PSFONT_UI_BOLD                ' FontUI at FontUISize, bold
    PSFONT_UI_LARGE               ' FontUI, two points larger
    PSFONT_GLYPH                  ' the glyph face (Segoe Fluent Icons or its fallback) at FontUISize
    PSFONT_GLYPH_LARGE            ' the glyph face, two points larger
    PSFONT_MONO                   ' FontMono (falls back to Consolas) at FontUISize
    PSFONT_ROLE_COUNT
end enum

public type PSAPP_OPTIONS
    ComMode       as long = COINIT_APARTMENTTHREADED    ' -1: no COM
    GlyphFontFile as ustring                            ' loaded FR_PRIVATE when the face is not installed
    DpiMode       as long = PSAPP_DPI_SYSTEM
    FontUI        as ustring = "Segoe UI"
    FontUISize    as long = 10
    FontMono      as ustring = "Cascadia Mono"
end type

' RunOnUI's work item and a window-less timer's proc (PsAppUI.tiko).
public type PSAPP_UIProc    as sub( byval payload as any ptr )
public type PSAPP_TimerProc as sub( byval id as long, byval payload as any ptr )

public type PsApplication
    declare function Init( ) as boolean
    declare function Init( byref opts as PSAPP_OPTIONS ) as boolean
    declare function NewForm( byval title as ustring, byval cx as long, byval cy as long, _
                              byval dwStyle as DWORD = WS_OVERLAPPEDWINDOW or WS_CLIPCHILDREN or WS_CLIPSIBLINGS, _
                              byval dwExStyle as DWORD = WS_EX_CONTROLPARENT, _
                              byval hParent as HWND = null ) as PsForm ptr
    declare function Run( byval mainForm as PsForm ptr ) as long
    declare sub      Quit( byval exitCode as long = 0 )
    declare function GlyphFace( ) as ustring
    declare function Options( ) as PSAPP_OPTIONS
    declare function AddMessageFilter( byval p as PSREG_GlobalFilterProc ) as boolean
    declare sub      RemoveMessageFilter( byval p as PSREG_GlobalFilterProc )
    declare function RunOnUI( byval p as PSAPP_UIProc, byval payload as any ptr = 0 ) as boolean
    declare function IsUIThread( ) as boolean
    declare function SetTimer( byval ms as ulong, byval p as PSAPP_TimerProc, byval payload as any ptr = 0 ) as long
    declare sub      KillTimer( byval id as long )
private:
    m_unused as long        ' the state is the module's (one application per process); a TYPE needs a field
end type

' The application Init'ed in this process, or null.
public declare function PsApp_Instance( ) as PsApplication ptr


' ---- module state ----------------------------------------------------------------------
dim shared gApp_Instance as PsApplication ptr
dim shared gApp_Opts as PSAPP_OPTIONS
dim shared gApp_bCom as boolean
dim shared gApp_GdipToken as ULONG_PTR
dim shared gApp_GlyphFace as ustring
dim shared gApp_MonoFace as ustring
dim shared gApp_PrivateFont as ustring              ' the file Init loaded FR_PRIVATE, "" for none
dim shared gApp_hMain as HWND                       ' Run's form: destroying it ends the program
dim shared gApp_Filters( any ) as PSREG_GlobalFilterProc
dim shared gApp_FilterCount as long
dim shared gApp_Forms( any ) as HWND                ' every live form, for tear-down
dim shared gApp_FormCount as long


public function PsApp_Instance( ) as PsApplication ptr
    return gApp_Instance
end function

' ---- the form list (PsForm.tiko adds and removes) --------------------------------------
sub App_AddForm( byval h as HWND )
    if gApp_FormCount > ubound(gApp_Forms) then
        redim preserve gApp_Forms( 0 to gApp_FormCount + 7 )
    end if
    gApp_Forms(gApp_FormCount) = h
    gApp_FormCount += 1
end sub

sub App_RemoveForm( byval h as HWND )
    for i as long = 0 to gApp_FormCount - 1
        if gApp_Forms(i) = h then
            for j as long = i to gApp_FormCount - 2
                gApp_Forms(j) = gApp_Forms(j + 1)
            next
            gApp_FormCount -= 1
            exit sub
        end if
    next
end sub

function App_MainForm( ) as HWND
    return gApp_hMain
end function

function App_FontFace( byval role as long ) as ustring
    select case role
    case PSFONT_GLYPH, PSFONT_GLYPH_LARGE
        return gApp_GlyphFace
    case PSFONT_MONO
        return gApp_MonoFace
    end select
    return gApp_Opts.FontUI
end function

function App_FontUISize( ) as long
    return gApp_Opts.FontUISize
end function


' ========================================================================================
' TRUE when face is installed: the font mapper substitutes a missing face, so the face a DC
' actually selected is the answer.
' ========================================================================================
private function App_FaceExists( byval face as ustring ) as boolean
    if len( face ) = 0 then return false
    dim as LOGFONTW lf
    lf.lfHeight = -12
    lf.lfCharSet = DEFAULT_CHARSET
    dim as wstring * LF_FACESIZE wszFace = left( face, LF_FACESIZE - 1 )
    lf.lfFaceName = wszFace
    dim as HFONT hf = CreateFontIndirectW( @lf )
    if hf = 0 then return false
    dim as HDC hdc = GetDC( null )
    dim as HGDIOBJ hOld = SelectObject( hdc, hf )
    dim as wstring * LF_FACESIZE wszGot
    GetTextFaceW( hdc, LF_FACESIZE, @wszGot )
    SelectObject( hdc, hOld )
    ReleaseDC( null, hdc )
    DeleteObject( hf )
    return lcase( wszGot ) = lcase( wszFace )
end function


' ========================================================================================
' Init
' ========================================================================================
function PsApplication.Init( ) as boolean
    dim as PSAPP_OPTIONS opts
    return this.Init( opts )
end function

function PsApplication.Init( byref opts as PSAPP_OPTIONS ) as boolean
    if gApp_Instance then return false              ' one application per process
    gApp_Opts = opts

    if opts.ComMode <> -1 then
        dim as HRESULT hr = CoInitializeEx( null, opts.ComMode )
        if FAILED( hr ) then return false
        gApp_bCom = true
    end if

    ' Before any window exists: CWindow reads the process awareness in its constructor. A
    ' manifest that already set one makes this call fail, harmlessly.
    select case opts.DpiMode
    case PSAPP_DPI_SYSTEM
        if SetProcessDpiAwarenessContext( DPI_AWARENESS_CONTEXT_SYSTEM_AWARE ) = 0 then SetProcessDPIAware()
    case PSAPP_DPI_PERMONITORV2
        if SetProcessDpiAwarenessContext( DPI_AWARENESS_CONTEXT_PER_MONITOR_AWARE_V2 ) = 0 then SetProcessDPIAware()
    end select

    gApp_GdipToken = gdiplus.Init()

    ' The glyph face: installed (Windows 11), else the app's own file, else Segoe MDL2 Assets
    ' (Windows 10), whose code points the family's glyphs share for the common icons.
    gApp_GlyphFace = "Segoe Fluent Icons"
    if App_FaceExists( gApp_GlyphFace ) = false then
        dim as boolean bLoaded = false
        if len( opts.GlyphFontFile ) then
            dim as wstring * MAX_PATH wszFile = opts.GlyphFontFile
            if AddFontResourceExW( @wszFile, FR_PRIVATE, 0 ) > 0 then
                gApp_PrivateFont = opts.GlyphFontFile
                bLoaded = App_FaceExists( gApp_GlyphFace )
            end if
        end if
        if bLoaded = false then gApp_GlyphFace = "Segoe MDL2 Assets"
    end if

    gApp_MonoFace = opts.FontMono
    if App_FaceExists( gApp_MonoFace ) = false then gApp_MonoFace = "Consolas"

    ' RunOnUI's queue and window, and the window-less timers (PsAppUI.tiko).
    App_UIInit()

    gApp_Instance = @this
    return true
end function

function PsApplication.GlyphFace( ) as ustring
    return gApp_GlyphFace
end function

function PsApplication.Options( ) as PSAPP_OPTIONS
    return gApp_Opts
end function


' ========================================================================================
' App filters: run after the registry's, before accelerators and IsDialogMessage.
' ========================================================================================
function PsApplication.AddMessageFilter( byval p as PSREG_GlobalFilterProc ) as boolean
    if p = 0 then return false
    for i as long = 0 to gApp_FilterCount - 1
        if gApp_Filters(i) = p then return false
    next
    if gApp_FilterCount > ubound(gApp_Filters) then
        redim preserve gApp_Filters( 0 to gApp_FilterCount + 7 )
    end if
    gApp_Filters(gApp_FilterCount) = p
    gApp_FilterCount += 1
    return true
end function

sub PsApplication.RemoveMessageFilter( byval p as PSREG_GlobalFilterProc )
    for i as long = 0 to gApp_FilterCount - 1
        if gApp_Filters(i) = p then
            for j as long = i to gApp_FilterCount - 2
                gApp_Filters(j) = gApp_Filters(j + 1)
            next
            gApp_FilterCount -= 1
            exit sub
        end if
    next
end sub


' ========================================================================================
' The pump. pModal is null for Run's loop; for a modal form it is the state its ShowModal
' owns on the stack, which outlives the form -- so the loop never touches a form that a
' message destroyed.
' ========================================================================================
private function App_PreTranslate( byval pMsg as MSG ptr ) as boolean
    if PsRegistry_FilterMessage( pMsg ) then return true

    for i as long = 0 to gApp_FilterCount - 1
        if gApp_Filters(i)( pMsg ) then return true
    next

    ' The form that owns the message. A PsPopupMenu is a top-level window of its own and not a
    ' form, so neither accelerators nor the dialog manager ever run against one.
    dim as HWND hRoot = GetAncestor( pMsg->hwnd, GA_ROOT )
    if hRoot = 0 then return false
    dim as PsForm ptr fr = PsForm_FromRoot( hRoot )
    if fr = 0 then return false

    dim as HACCEL hAccel = fr->AccelHandle
    if hAccel then
        if TranslateAcceleratorW( hRoot, hAccel, pMsg ) then return true
    end if
    if IsDialogMessageW( hRoot, pMsg ) then return true
    return false
end function

function App_RunLoop( byval pModal as PSF_MODALSTATE ptr ) as long
    dim as MSG m
    do
        if pModal then
            if pModal->bEnded orelse pModal->bDestroyed then return 0
        end if
        dim as long r = GetMessageW( @m, null, 0, 0 )
        if r = -1 then return 0
        if r = 0 then
            ' WM_QUIT. A modal loop hands it on to the loop under it.
            if pModal then
                pModal->bQuit = true
                PostQuitMessage( cast( long, m.wParam ) )
            end if
            return cast( long, m.wParam )
        end if
        if App_PreTranslate( @m ) = false then
            TranslateMessage( @m )
            DispatchMessageW( @m )
        end if
    loop
end function


' ========================================================================================
' Run: show, focus, pump, tear down. Returns WM_QUIT's exit code.
' ========================================================================================
function PsApplication.Run( byval mainForm as PsForm ptr ) as long
    dim as long exitCode = 0
    if mainForm then
        gApp_hMain = mainForm->hWindow
        if IsWindowVisible( gApp_hMain ) = 0 then mainForm->Show( SW_SHOWNORMAL )
        exitCode = App_RunLoop( 0 )
    end if
    gApp_hMain = 0

    ' Tear-down, reverse order of Init. Forms first: a form's controls and buffers must be gone
    ' before GDI+ is, and GDI+ before COM.
    do while gApp_FormCount > 0
        dim as HWND h = gApp_Forms(gApp_FormCount - 1)
        dim as long nBefore = gApp_FormCount
        if IsWindow( h ) then DestroyWindow( h )
        ' A form's WM_NCDESTROY removes it; one that could not be destroyed is dropped here,
        ' so the loop always ends.
        if gApp_FormCount = nBefore then App_RemoveForm( h )
    loop
    ' After the forms (a form's OnDestroy may still queue work, which is then dropped).
    App_UITeardown()
    if len( gApp_PrivateFont ) then
        dim as wstring * MAX_PATH wszFile = gApp_PrivateFont
        RemoveFontResourceExW( @wszFile, FR_PRIVATE, 0 )
        gApp_PrivateFont = ""
    end if
    if gApp_GdipToken then
        gdiplus.Uninit( gApp_GdipToken )
        gApp_GdipToken = 0
    end if
    if gApp_bCom then
        CoUninitialize()
        gApp_bCom = false
    end if
    gApp_Instance = 0
    return exitCode
end function

sub PsApplication.Quit( byval exitCode as long = 0 )
    PostQuitMessage( exitCode )
end sub
