''  vendor/PsControls/PsApp  --  PsForm: a CWindow whose messages arrive as callbacks
''

#module "PsApp"

#import "sys/win"
#import "sys/win/gui"
#import "vendor/PsControls/PsBufferPaint"
#import "vendor/PsControls/PsRegistry"

using gui
using PsBufferPaint
using PsRegistry

' A PsForm IS a CWindow (ScaleX/ScaleY, CreateFont, AnchorControl, AddAccelerator, UserData all
' work on it), so PsPaintBuffer and every control that reads CWindowPtr( hParent ) see what they
' always saw. What it adds is the window procedure: a message goes
'
'   1. to the built-ins that always run (WM_ACTIVATEAPP(FALSE) closes registered dropdowns;
'      WM_DESTROY calls OnDestroy and, for the main form, ends the program),
'   2. to its typed callback, if one is set -- a SUB callback has handled it; a FUNCTION
'      callback that returns FALSE falls through,
'   3. to the OnMessage table,
'   4. to the defaults (no background erase; paint the background when there is no OnPaint;
'      WM_CLOSE asks OnClose, then destroys -- or ends the modal loop),
'   5. to DefWindowProcW.
'
' Every callback gets the form first. A control callback, which gets only the control's HWND,
' reaches its form with PsForm.FromHwnd( hCtrl ).
'
' There is no OnCreate: NewForm creates the window before it returns, so the app creates its
' controls straight after the call. The few messages a window gets inside CreateWindowEx
' (WM_NCCREATE, WM_GETMINMAXINFO, WM_NCCALCSIZE, WM_CREATE) go to DefWindowProc.

public type PsForm as PSFORM_T

public type PSF_SizeProc        as sub(      byval f as PsForm ptr, byval cx as long, byval cy as long )
public type PSF_PaintProc       as sub(      byval f as PsForm ptr, byref b as PsPaintBuffer )
public type PSF_CommandProc     as function( byval f as PsForm ptr, byval id as long, byval code as long, byval hCtl as HWND ) as boolean
public type PSF_NotifyProc      as function( byval f as PsForm ptr, byval id as long, byval pnm as NMHDR ptr, byref result as LRESULT ) as boolean
public type PSF_TimerProc       as sub(      byval f as PsForm ptr, byval id as UINT_PTR )
public type PSF_KeyProc         as function( byval f as PsForm ptr, byval vk as long, byval lParam as LPARAM ) as boolean
public type PSF_CloseProc       as function( byval f as PsForm ptr ) as boolean
public type PSF_FormProc        as sub(      byval f as PsForm ptr )
public type PSF_ActivateAppProc as sub(      byval f as PsForm ptr, byval bActive as boolean )
public type PSF_DpiProc         as sub(      byval f as PsForm ptr, byval oldDpi as long, byval newDpi as long )
public type PSF_MessageProc     as function( byval f as PsForm ptr, byval uMsg as UINT, byval wParam as WPARAM, _
                                             byval lParam as LPARAM, byref result as LRESULT ) as boolean

' A modal form's loop state, owned by ShowModal's stack frame: it outlives the form, so the
' pump can learn that the form was destroyed without reading it.
type PSF_MODALSTATE
    bEnded     as boolean
    bDestroyed as boolean
    bQuit      as boolean
    code       as long
end type

type PSF_MSGENTRY
    uMsg as UINT
    p    as PSF_MessageProc
end type

public type PSFORM_T extends CWindow
    declare constructor( byref wszClassName as const wstring = "" )
    declare destructor( )

    declare sub OnSize( byval p as PSF_SizeProc )
    declare sub OnPaint( byval p as PSF_PaintProc )
    declare sub OnCommand( byval p as PSF_CommandProc )
    declare sub OnNotify( byval p as PSF_NotifyProc )
    declare sub OnTimer( byval p as PSF_TimerProc )
    declare sub OnKeyDown( byval p as PSF_KeyProc )
    declare sub OnKeyUp( byval p as PSF_KeyProc )
    declare sub OnClose( byval p as PSF_CloseProc )
    declare sub OnDestroy( byval p as PSF_FormProc )
    declare sub OnActivateApp( byval p as PSF_ActivateAppProc )
    declare sub OnDpiChanged( byval p as PSF_DpiProc )
    declare sub OnThemeChanged( byval p as PSF_FormProc )
    declare sub OnMessage( byval uMsg as UINT, byval p as PSF_MessageProc )

    declare function Item( byval id as long ) as HWND
    declare function Font( byval role as long ) as HFONT
    declare function SetRoleFont( byval role as long, byval face as ustring, byval pt as long, _
                                  byval weight as long = FW_NORMAL ) as HFONT
    declare function Show( byval nCmdShow as long = SW_SHOWNORMAL ) as boolean
    declare function ShowModal( byval hOwner as HWND = null ) as long
    declare sub      EndModal( byval code as long )
    declare function IsModal( ) as boolean
    declare sub      Close( )
    declare sub      FocusFirst( )
    declare static function FromHwnd( byval h as HWND ) as PsForm ptr

    ' The window procedure's entry point, the theme switch's call and the DPI step. Not for app code.
    declare sub      FireThemeChanged( )
    declare sub      ChangeDpi( byval oldDpi as long, byval newDpi as long )
    declare function Dispatch( byval hwnd as HWND, byval uMsg as UINT, byval wParam as WPARAM, _
                               byval lParam as LPARAM ) as LRESULT

    Tag as any ptr          ' the app's own

private:
    m_onSize        as PSF_SizeProc
    m_onPaint       as PSF_PaintProc
    m_onCommand     as PSF_CommandProc
    m_onNotify      as PSF_NotifyProc
    m_onTimer       as PSF_TimerProc
    m_onKeyDown     as PSF_KeyProc
    m_onKeyUp       as PSF_KeyProc
    m_onClose       as PSF_CloseProc
    m_onDestroy     as PSF_FormProc
    m_onActivateApp as PSF_ActivateAppProc
    m_onDpiChanged  as PSF_DpiProc
    m_onTheme       as PSF_FormProc
    m_msgs( any )   as PSF_MSGENTRY
    m_msgCount      as long
    m_fonts( 0 to 6 ) as HFONT      ' one per PSFONT_ROLE
    m_pModal        as PSF_MODALSTATE ptr
    m_retired( 0 to 63 ) as HFONT   ' old role fonts DeleteObject refused (still selected); retried at destruction
    m_retiredCount  as long
    m_bShown        as boolean
end type

' WM_DPICHANGED (winuser.h 0x02E0): inc/win/winuser.bi does not declare it.
const PSF_WM_DPICHANGED = &h02E0

' The property every form sets on its own HWND; FromHwnd and the pump read it.
const PSF_PROP = wstr( "PsApp.Form" )


' ========================================================================================
' Construction
' ========================================================================================
constructor PSFORM_T( byref wszClassName as const wstring = "" )
    base( wszClassName )
end constructor

destructor PSFORM_T( )
    for i as long = 0 to ubound( m_fonts )
        if m_fonts(i) then DeleteObject( m_fonts(i) )
        m_fonts(i) = 0
    next
    for i as long = 0 to m_retiredCount - 1
        DeleteObject( m_retired(i) )
    next
end destructor


' ========================================================================================
' Callback setters. Null clears.
' ========================================================================================
sub PSFORM_T.OnSize( byval p as PSF_SizeProc )
    m_onSize = p
end sub
sub PSFORM_T.OnPaint( byval p as PSF_PaintProc )
    m_onPaint = p
end sub
sub PSFORM_T.OnCommand( byval p as PSF_CommandProc )
    m_onCommand = p
end sub
sub PSFORM_T.OnNotify( byval p as PSF_NotifyProc )
    m_onNotify = p
end sub
sub PSFORM_T.OnTimer( byval p as PSF_TimerProc )
    m_onTimer = p
end sub
sub PSFORM_T.OnKeyDown( byval p as PSF_KeyProc )
    m_onKeyDown = p
end sub
sub PSFORM_T.OnKeyUp( byval p as PSF_KeyProc )
    m_onKeyUp = p
end sub
sub PSFORM_T.OnClose( byval p as PSF_CloseProc )
    m_onClose = p
end sub
sub PSFORM_T.OnDestroy( byval p as PSF_FormProc )
    m_onDestroy = p
end sub
sub PSFORM_T.OnActivateApp( byval p as PSF_ActivateAppProc )
    m_onActivateApp = p
end sub
sub PSFORM_T.OnDpiChanged( byval p as PSF_DpiProc )
    m_onDpiChanged = p
end sub
sub PSFORM_T.OnThemeChanged( byval p as PSF_FormProc )
    m_onTheme = p
end sub

' One entry per message: setting a message again replaces its entry, and a null proc removes it.
sub PSFORM_T.OnMessage( byval uMsg as UINT, byval p as PSF_MessageProc )
    for i as long = 0 to m_msgCount - 1
        if m_msgs(i).uMsg = uMsg then
            if p then
                m_msgs(i).p = p
            else
                for j as long = i to m_msgCount - 2
                    m_msgs(j) = m_msgs(j + 1)
                next
                m_msgCount -= 1
            end if
            exit sub
        end if
    next
    if p = 0 then exit sub
    if m_msgCount > ubound( m_msgs ) then redim preserve m_msgs( 0 to m_msgCount + 7 )
    m_msgs(m_msgCount).uMsg = uMsg
    m_msgs(m_msgCount).p = p
    m_msgCount += 1
end sub


' ========================================================================================
' Helpers
' ========================================================================================
function PSFORM_T.Item( byval id as long ) as HWND
    return GetDlgItem( this.hWindow, id )
end function

' A role's font, created at the form's DPI on first use and owned by the form.
function PSFORM_T.Font( byval role as long ) as HFONT
    if (role < 0) orelse (role > ubound( m_fonts )) then return 0
    if m_fonts(role) = 0 then
        dim as long pt = App_FontUISize()
        dim as long weight = FW_NORMAL
        select case role
        case PSFONT_UI_SMALL
            pt -= 1
        case PSFONT_UI_BOLD
            weight = FW_BOLD
        case PSFONT_UI_LARGE, PSFONT_GLYPH_LARGE
            pt += 2
        end select
        dim as wstring * LF_FACESIZE wszFace = App_FontFace( role )
        m_fonts(role) = this.CreateFont( wszFace, pt, weight )
    end if
    return m_fonts(role)
end function

' Replaces a role's font. The old handle is deleted, so call this before handing the role's
' font to any control.
function PSFORM_T.SetRoleFont( byval role as long, byval face as ustring, byval pt as long, _
                               byval weight as long = FW_NORMAL ) as HFONT
    if (role < 0) orelse (role > ubound( m_fonts )) then return 0
    dim as wstring * LF_FACESIZE wszFace = face
    dim as HFONT hNew = this.CreateFont( wszFace, pt, weight )
    if hNew = 0 then return 0
    if m_fonts(role) then DeleteObject( m_fonts(role) )
    m_fonts(role) = hNew
    return hNew
end function

' Focus the first WS_TABSTOP control. Without it IsDialogMessage ignores the first Tab: it acts
' only when the focus is on a DESCENDANT of the form, and after ShowWindow it is on the form.
sub PSFORM_T.FocusFirst( )
    dim as HWND h = GetNextDlgTabItem( this.hWindow, null, false )
    if h then SetFocus( h )
end sub

function PSFORM_T.Show( byval nCmdShow as long = SW_SHOWNORMAL ) as boolean
    dim as HWND h = this.hWindow
    if h = 0 then return false
    ' The first layout runs BEFORE the window is visible: the WM_SIZE sent inside CreateWindowEx
    ' came before any OnSize could be set, so without this the first frame would show every
    ' control at its creation size (zero, for the family) until the user resized the form.
    dim as boolean bFirst = (m_bShown = false)
    if bFirst andalso (m_onSize <> 0) then
        dim as RECT rc
        ..GetClientRect( h, @rc )          ' .. : CWindow has a GetClientRect of its own
        m_onSize( @this, rc.right - rc.left, rc.bottom - rc.top )
    end if
    ShowWindow( h, nCmdShow )
    UpdateWindow( h )
    if bFirst then
        m_bShown = true
        this.FocusFirst()
    end if
    return true
end function

sub PSFORM_T.Close( )
    if this.hWindow then SendMessageW( this.hWindow, WM_CLOSE, 0, 0 )
end sub

' The DPI step: the form's own scale, its role fonts, every control's metrics and fonts. The old
' fonts are deleted only after every control holds the new ones.
sub PSFORM_T.ChangeDpi( byval oldDpi as long, byval newDpi as long )
    this.DPI = newDpi
    dim as HFONT hOld( 0 to 6 )
    for i as long = 0 to ubound( m_fonts )
        hOld(i) = m_fonts(i)
        m_fonts(i) = 0
    next
    for i as long = 0 to ubound( m_fonts )
        if hOld(i) then this.Font( i )         ' re-created at the new DPI
    next
    PsRegistry_Rescale( this.hWindow, oldDpi, newDpi )
    PsRegistry_ApplyFonts( this.hWindow, this.Font( PSFONT_UI ), this.Font( PSFONT_GLYPH ) )
    ' Repaint everything with the new fonts BEFORE deleting the old ones: a control can still
    ' have an old font selected into a DC it keeps, and DeleteObject refuses a selected font.
    RedrawWindow( this.hWindow, null, null, RDW_INVALIDATE or RDW_ERASE or RDW_ALLCHILDREN or RDW_UPDATENOW )
    for i as long = 0 to 6
        if hOld(i) then
            ' A font still selected into a DC is freed by GDI once it is deselected; a refusal
            ' (some GDI versions) is kept and retried when the form goes.
            if (DeleteObject( hOld(i) ) = 0) andalso (m_retiredCount <= ubound( m_retired )) then
                m_retired( m_retiredCount ) = hOld(i)
                m_retiredCount += 1
            end if
        end if
    next
end sub

sub PSFORM_T.FireThemeChanged( )
    if m_onTheme then m_onTheme( @this )
end sub

function PSFORM_T.IsModal( ) as boolean
    return m_pModal <> 0
end function

' The form that owns h: h itself, or the nearest parent -- or, for a top-level popup such as a
' PsPopupMenu, the nearest owner -- that is a form.
function PSFORM_T.FromHwnd( byval h as HWND ) as PsForm ptr
    dim as long nGuard = 0
    do while (h <> 0) andalso (nGuard < 64)
        dim as HANDLE p = GetPropW( h, PSF_PROP )
        if p then return cast( PsForm ptr, p )
        if (GetWindowLongPtrW( h, GWL_STYLE ) and WS_CHILD) then
            h = GetParent( h )
        else
            h = GetWindow( h, GW_OWNER )
        end if
        nGuard += 1
    loop
    return 0
end function

' The pump's lookup: only hRoot itself, no walk.
function PsForm_FromRoot( byval hRoot as HWND ) as PsForm ptr
    return cast( PsForm ptr, GetPropW( hRoot, PSF_PROP ) )
end function


' ========================================================================================
' Modal
' ========================================================================================
function PSFORM_T.ShowModal( byval hOwner as HWND = null ) as long
    dim as HWND hForm = this.hWindow
    if hForm = 0 then return IDCANCEL
    if hOwner = 0 then hOwner = GetWindow( hForm, GW_OWNER )
    if hOwner = 0 then
        hOwner = GetActiveWindow()
        if hOwner = hForm then hOwner = 0
    end if
    if (hOwner <> 0) andalso (GetWindow( hForm, GW_OWNER ) = 0) then
        SetWindowLongPtrW( hForm, GWLP_HWNDPARENT, cast( LONG_PTR, hOwner ) )
    end if

    dim as PSF_MODALSTATE st
    st.code = IDCANCEL
    m_pModal = @st

    dim as boolean bOwnerEnabled = false
    if hOwner then
        bOwnerEnabled = (IsWindowEnabled( hOwner ) <> 0)
        if bOwnerEnabled then EnableWindow( hOwner, FALSE )
        this.Center( hForm, hOwner )
    end if
    this.Show( SW_SHOWNORMAL )

    App_RunLoop( @st )

    ' From here on `this` may already be gone (st.bDestroyed): only st and locals are read.
    ' The owner is enabled BEFORE the form is destroyed, so the activation returns to it rather
    ' than to some other application's window.
    if bOwnerEnabled then EnableWindow( hOwner, TRUE )
    if st.bDestroyed = false then
        m_pModal = 0
        DestroyWindow( hForm )
    end if
    if (hOwner <> 0) andalso (IsWindow( hOwner ) <> 0) then SetActiveWindow( hOwner )
    return st.code
end function

sub PSFORM_T.EndModal( byval code as long )
    if m_pModal = 0 then exit sub
    m_pModal->code = code
    m_pModal->bEnded = true
    ' Wake the loop if EndModal ran outside a dispatched message (from a timer proc, say).
    PostMessageW( this.hWindow, WM_NULL, 0, 0 )
end sub


' ========================================================================================
' The window procedure
' ========================================================================================
function PsForm_WndProc( byval hwnd as HWND, byval uMsg as UINT, byval wParam as WPARAM, _
                         byval lParam as LPARAM ) as LRESULT
    ' CWindow stores the object in the window's extra bytes once CreateWindowEx has returned;
    ' until then (WM_NCCREATE .. WM_CREATE) there is no form to call.
    dim as PsForm ptr f = cast( PsForm ptr, CWindowPtr( hwnd ) )
    if f = 0 then return DefWindowProcW( hwnd, uMsg, wParam, lParam )
    return f->Dispatch( hwnd, uMsg, wParam, lParam )
end function

function PSFORM_T.Dispatch( byval hwnd as HWND, byval uMsg as UINT, byval wParam as WPARAM, _
                            byval lParam as LPARAM ) as LRESULT
    dim as LRESULT res = 0

    ' ---- 1. built-ins that always run ----------------------------------------------------
    select case uMsg
    case WM_ACTIVATEAPP
        if wParam = 0 then PsRegistry_Dismiss( hwnd )
    case PSF_WM_DPICHANGED
        ' Per-monitor DPI: the form, its fonts and every control on it move to the new DPI, then
        ' the window takes the rect Windows suggests (its WM_SIZE runs OnSize), then OnDpiChanged.
        dim as long newDpi = LOWORD( wParam )
        dim as long oldDpi = clng( this.DPI )
        if (newDpi > 0) andalso (newDpi <> oldDpi) then this.ChangeDpi( oldDpi, newDpi )
        dim as RECT ptr prc = cast( RECT ptr, lParam )
        if prc then
            SetWindowPos( hwnd, null, prc->left, prc->top, prc->right - prc->left, prc->bottom - prc->top, _
                          SWP_NOZORDER or SWP_NOACTIVATE )
        end if
        if m_onDpiChanged then m_onDpiChanged( @this, oldDpi, newDpi )
        return 0
    case WM_SETTINGCHANGE
        if lParam then
            if *cast( wstring ptr, lParam ) = "ImmersiveColorSet" then App_ThemeSystemChanged()
        end if
    case WM_DESTROY
        if m_onDestroy then m_onDestroy( @this )
        if hwnd = App_MainForm() then PostQuitMessage( 0 )
    case WM_NCDESTROY
        for i as long = 0 to m_msgCount - 1
            if m_msgs(i).uMsg = WM_NCDESTROY then m_msgs(i).p( @this, uMsg, wParam, lParam, res )
        next
        if m_pModal then m_pModal->bDestroyed = true
        RemovePropW( hwnd, PSF_PROP )
        App_RemoveForm( hwnd )
        delete @this
        return 0
    end select

    ' ---- 2. typed callbacks -------------------------------------------------------------
    select case uMsg
    case WM_SIZE
        if m_onSize then
            if wParam <> SIZE_MINIMIZED then m_onSize( @this, LOWORD( lParam ), HIWORD( lParam ) )
            return 0
        end if
    case WM_PAINT
        if m_onPaint then
            dim as PsPaintBuffer b
            b.BeginDoubleBuffer( hwnd )
            m_onPaint( @this, b )
            b.EndDoubleBuffer()
            return 0
        end if
    case WM_COMMAND
        if m_onCommand then
            if m_onCommand( @this, LOWORD( wParam ), HIWORD( wParam ), cast( HWND, lParam ) ) then return 0
        end if
    case WM_NOTIFY
        if (m_onNotify <> 0) andalso (lParam <> 0) then
            dim as NMHDR ptr pnm = cast( NMHDR ptr, lParam )
            if m_onNotify( @this, cast( long, pnm->idFrom ), pnm, res ) then return res
        end if
    case WM_TIMER
        if m_onTimer then
            m_onTimer( @this, wParam )
            return 0
        end if
    case WM_KEYDOWN
        if m_onKeyDown then
            if m_onKeyDown( @this, cast( long, wParam ), lParam ) then return 0
        end if
    case WM_KEYUP
        if m_onKeyUp then
            if m_onKeyUp( @this, cast( long, wParam ), lParam ) then return 0
        end if
    case WM_ACTIVATEAPP
        if m_onActivateApp then
            m_onActivateApp( @this, wParam <> 0 )
            return 0
        end if
    end select

    ' ---- 3. the OnMessage table ---------------------------------------------------------
    for i as long = 0 to m_msgCount - 1
        if m_msgs(i).uMsg = uMsg then
            res = 0
            if m_msgs(i).p( @this, uMsg, wParam, lParam, res ) then return res
            exit for
        end if
    next

    ' ---- 4. defaults --------------------------------------------------------------------
    select case uMsg
    case WM_ERASEBKGND
        return 1                    ' WM_PAINT fills the background, double-buffered
    case WM_PAINT
        dim as PsPaintBuffer b
        b.BeginDoubleBuffer( hwnd )
        b.SetBackColor( App_FormBackColor() )
        b.PaintClientRect()
        b.EndDoubleBuffer()
        return 0
    case WM_COMMAND
        ' Esc in a modal form: IsDialogMessage turns it into IDCANCEL, which ends the loop.
        if (m_pModal <> 0) andalso (LOWORD( wParam ) = IDCANCEL) then
            this.EndModal( IDCANCEL )
            return 0
        end if
    case WM_CLOSE
        if m_onClose then
            if m_onClose( @this ) = false then return 0
        end if
        if m_pModal then
            this.EndModal( IDCANCEL )
        else
            DestroyWindow( hwnd )
        end if
        return 0
    end select

    return DefWindowProcW( hwnd, uMsg, wParam, lParam )
end function


' ========================================================================================
' NewForm (a PsApplication method; here because it needs the window procedure)
' ========================================================================================
function PsApplication.NewForm( byval title as ustring, byval cx as long, byval cy as long, _
                                byval dwStyle as DWORD = WS_OVERLAPPEDWINDOW or WS_CLIPCHILDREN or WS_CLIPSIBLINGS, _
                                byval dwExStyle as DWORD = WS_EX_CONTROLPARENT, _
                                byval hParent as HWND = null ) as PsForm ptr
    ' One window class per form: CWindow registers its class in Create and FAILS when the name
    ' is already registered, and unregisters it in its destructor.
    static as long nSerial = 0
    nSerial += 1
    dim as wstring * 64 wszClass = "PsApp.Form:" & wstr( nSerial )
    dim as PsForm ptr f = new PsForm( wszClass )
    dim as wstring * 512 wszTitle = left( title, 511 )
    ' cx and cy are DIPs: CWindow.Create scales position and size by the form's DPI.
    dim as HWND h = f->Create( hParent, wszTitle, @PsForm_WndProc, 0, 0, cx, cy, dwStyle, dwExStyle )
    if h = 0 then
        delete f
        return 0
    end if
    SetPropW( h, PSF_PROP, cast( HANDLE, f ) )
    App_AddForm( h )
    App_ThemeForm( h )
    ' Per-monitor DPI: CWindow created the form at the SYSTEM DPI; if its monitor has another,
    ' the form takes that one, and its size follows (nothing is on it yet, so nothing else moves).
    if App_DpiMode() = PSAPP_DPI_PERMONITORV2 then
        dim as long dpi = GetDpiForWindow( h )
        dim as long sysDpi = clng( f->DPI )
        if (dpi > 0) andalso (sysDpi > 0) andalso (dpi <> sysDpi) then
            f->DPI = dpi
            dim as RECT rc
            ..GetWindowRect( h, @rc )
            SetWindowPos( h, null, 0, 0, MulDiv( rc.right - rc.left, dpi, sysDpi ), _
                          MulDiv( rc.bottom - rc.top, dpi, sysDpi ), SWP_NOZORDER or SWP_NOMOVE or SWP_NOACTIVATE )
        end if
    end if
    f->Center( h, hParent )
    return f
end function
