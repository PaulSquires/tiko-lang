''
''  vendor/PsControls/PsApp  --  the theme and the automatic fonts
''

#module "PsApp"

#ifndef TIKO_OS_WINDOWS
    #error "vendor/PsControls is Windows-only (Win32 controls): build for -target windows-x86_64, or use vendor/tkControls"
#endif

#import "sys/win"
#import "sys/win/gui"
#import "vendor/PsControls/PsRegistry"
#import "vendor/PsControls/PsTheme"

using gui
using PsRegistry
using PsTheme

' The registry holds the current theme and themes every control as it registers; this file
' decides WHICH theme (Init's ThemeMode, SetTheme, the Windows app mode) and does the form side
' of a switch: every form's title bar and background, a repaint, and OnThemeChanged.
'
' Fonts: a control that registers a font proc while it sits on a form gets that form's
' PSFONT_UI and PSFONT_GLYPH at once, through the hook installed here. A Ps<X>_SetFont call
' afterwards replaces them as it always did.

dim shared gTheme_Mode as long          ' PSAPP_THEMEMODE


' The registry's hook for a newly registered control: the control's form, if it is on one, hands
' it its DPI (a control's CWindow starts at the SYSTEM DPI, which under per-monitor DPI need not
' be the form's) and then its fonts, which are already at the form's DPI.
private sub Theme_FontHook( byval h as HWND, byval pFonts as PSREG_FontProc, byval pRescale as PSREG_RescaleProc )
    dim as PsForm ptr f = PsForm.FromHwnd( h )
    if f = 0 then exit sub
    if pRescale then
        dim as CWindow ptr pCtl = CWindowPtr( h )
        if pCtl then
            dim as long ctlDpi = clng( pCtl->DPI )
            dim as long formDpi = clng( f->DPI )
            if (ctlDpi > 0) andalso (formDpi > 0) andalso (ctlDpi <> formDpi) then pRescale( h, ctlDpi, formDpi )
        end if
    end if
    if pFonts then pFonts( h, f->Font( PSFONT_UI ), f->Font( PSFONT_GLYPH ) )
end sub

' Init's part.
sub App_ThemeInit( byval mode as long )
    gTheme_Mode = mode
    PsRegistry_SetFontHook( @Theme_FontHook )
    select case mode
    case PSAPP_THEME_SYSTEM
        PsRegistry_SetTheme( PsTheme_System() )
    case PSAPP_THEME_LIGHT
        PsRegistry_SetTheme( PsTheme_Light() )
    case PSAPP_THEME_DARK
        PsRegistry_SetTheme( PsTheme_Dark() )
    case else
        PsRegistry_ClearTheme()
    end select
end sub

sub App_ThemeTeardown( )
    PsRegistry_SetFontHook( 0 )
    PsRegistry_ClearTheme()
end sub

' The form background: the theme's Window, or the system face colour with no theme.
function App_FormBackColor( ) as COLORREF
    dim as PSTHEME_COLORS t
    if PsRegistry_GetTheme( t ) then return t.Window
    return GetSysColor( COLOR_BTNFACE )
end function

' A new form takes the theme's chrome.
sub App_ThemeForm( byval hForm as HWND )
    dim as PSTHEME_COLORS t
    if PsRegistry_GetTheme( t ) then PsTheme_ApplyTitleBar( hForm, t.IsDark )
end sub

' WM_SETTINGCHANGE "ImmersiveColorSet": the Windows app mode may have changed. Every top-level
' window gets the message, so the switch happens once and the rest find nothing to do.
sub App_ThemeSystemChanged( )
    if gTheme_Mode <> PSAPP_THEME_SYSTEM then exit sub
    dim as PSTHEME_COLORS tNew = PsTheme_System()
    dim as PSTHEME_COLORS tCur
    if PsRegistry_GetTheme( tCur ) then
        if PsTheme_Equal( tCur, tNew ) then exit sub
    end if
    dim as PsApplication ptr app = PsApp_Instance()
    if app then app->SetTheme( tNew )
end sub


' ========================================================================================
' SetTheme: every registered control (unless its colours are pinned), then every form.
' ========================================================================================
sub PsApplication.SetTheme( byref t as PSTHEME_COLORS )
    PsRegistry_SetTheme( t )
    for i as long = 0 to gApp_FormCount - 1
        dim as HWND h = gApp_Forms(i)
        if IsWindow( h ) = 0 then continue for
        PsTheme_ApplyTitleBar( h, t.IsDark )
        RedrawWindow( h, null, null, RDW_INVALIDATE or RDW_ERASE or RDW_FRAME or RDW_ALLCHILDREN )
        dim as PsForm ptr f = PsForm_FromRoot( h )
        if f then f->FireThemeChanged()
    next
end sub

function PsApplication.Theme( ) as PSTHEME_COLORS
    dim as PSTHEME_COLORS t
    if PsRegistry_GetTheme( t ) = false then t = PsTheme_Dark()
    return t
end function

' Fixes the theme mode: after SetThemeMode( PSAPP_THEME_LIGHT ), a Windows switch to dark mode is
' ignored; PSAPP_THEME_SYSTEM follows it again.
sub PsApplication.SetThemeMode( byval mode as long )
    gTheme_Mode = mode
    select case mode
    case PSAPP_THEME_SYSTEM
        this.SetTheme( PsTheme_System() )
    case PSAPP_THEME_LIGHT
        this.SetTheme( PsTheme_Light() )
    case PSAPP_THEME_DARK
        this.SetTheme( PsTheme_Dark() )
    end select
end sub

function PsApplication.ThemeMode( ) as long
    return gTheme_Mode
end function
