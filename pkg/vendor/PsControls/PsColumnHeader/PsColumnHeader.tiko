'    Owner-drawn column header control
'
'    A self-contained, per-instance header band in the same vein as PsStatusBar and
'    PsVScrollBar: it owns its own window class and keeps all state per instance in the
'    CWindow UserData area, so any number of instances can coexist. It is generic -- it
'    knows nothing about listboxes. PsListBox embeds one above its rows (the way it embeds
'    a PsVScrollBar on its right edge), but the control works standalone.
'
'    The control owns the column model (text, widths) and the derived geometry; all
'    rendering is the host's, via a per-column paint callback. Column widths are stored
'    in PIXELS (drag-resize deltas and autosize answers are pixels; round-tripping
'    through unscaled units would accumulate rounding drift). The control-owned defaults
'    below (padding, divider gutter, minimum width) are DPI-scaled at use.

#module "PsColumnHeader"

#import "sys/win"
#import "sys/win/gui"
#import "sys/win/gdiplus"
#import "vendor/PsControls/PsBufferPaint"
#import "vendor/PsControls/PsTipHost"

using gui
using gdiplus
using PsBufferPaint
using PsTipHost

' The tooltip backend switch. The control ships on the SYSTEM (comctl32) backend exactly
' as it always has; a host opts an instance into PsTooltip with PsColumnHeader_SetTooltipMode.

' Polling timer that guarantees hot-tracking is cleared when the mouse leaves the
' control. WM_MOUSELEAVE (TME_LEAVE) is not reliably delivered on fast exits, so a
' periodic cursor check acts as a safety net. Timer ids are per-window, so every
' instance can share this id.
public const IDT_CCOLHDR_HOTTRACK = &hCB30
public const CCOLHDR_HOTTRACK_MS = 100

' Default horizontal inset for a column's caption. The control DPI-scales this at
' Create; PsColumnHeader_SetPadding takes raw pixels thereafter. Padding is paint-side
' only here (unlike PsStatusBar, widths are stored, not measured from text).
public const CCOLHDR_DEFAULT_PADDING = 8

' Half-width of the divider hit zone: a boundary is grabbable within +/- this many
' pixels (DPI-scaled at use) of a column's right edge.
public const CCOLHDR_DIVIDER_GUTTER = 3

' Floor applied to any column whose own nMinWidth is 0 (DPI-scaled at use). A column
' can never be dragged or laid out narrower than its effective minimum.
public const CCOLHDR_DEFAULT_MINWIDTH = 16

' Fill-column designations for PsColumnHeader_SetFillColumn (besides an explicit index).
' The fill column absorbs whatever client width the fixed columns leave over -- it
' shrinks and grows with the window (never below its minimum width). Default is
' FILL_LAST: with a single column the cell spans the full width, and there is no dead
' strip right of the last column.
public const CCOLHDR_FILL_LAST = -2
public const CCOLHDR_FILL_NONE = -1

' NOTE: "width" is a FreeBASIC reserved word (see C:\dev\Learnings.md) and produces
' errors that never name the real problem -- hence nMinWidth / nWidth throughout.
' NOTE: no isHot here. Hover is transient and single-valued, so the control's
' nLastHotIdx / nHotDividerIdx are the one source of truth.
public type PSCOLUMNHEADER_COLINFO
    Text      as ustring
    itemData  as integer
    nWidth    as integer = 100   ' stored width in PIXELS; the fill column's is derived
    nMinWidth as integer = 0     ' floor in pixels; 0 = scaled CCOLHDR_DEFAULT_MINWIDTH
    rc        as RECT            ' computed client coordinates (see LayoutColumns)
end type

public type PSCOLUMNHEADER_PAINTINFO
    hHeader     as HWND                   ' the control, so the callback can query it
    itemID      as integer                ' column index
    b           as PsPaintBuffer ptr    ' the control's buffer for this repaint (no copy)
    rc          as RECT                   ' this column's rect, in client coordinates
    isHot       as boolean                ' mouse is over this column's body
    isPressed   as boolean                ' live left press on this column's body
    isResizeHot as boolean                ' cursor is in this column's right-divider gutter
    isResizing  as boolean                ' this column's divider is being dragged
    isFill      as boolean                ' this is the (effective) fill column
    wszCaption  as ustring               ' the column's Text
end type

public type PSCOLUMNHEADER_MESSAGEINFO
    hHeader as HWND
    uMsg    as UINT
    wParam  as WPARAM
    lParam  as LPARAM
    idx     as integer    ' column index under the mouse (-1 if none / on a divider)
end type

' Draw one column's header cell. Called for each column touched by the repaint; keep it
' cheap. Paint through p->b using p->rc as the cell rect -- do not touch the screen DC.
' Style from the state flags; the control decides them, you only render. Inset your
' caption by PsColumnHeader_GetPadding( p->hHeader ). Nothing but the control's flat
' BackColor is drawn if no paint callback is set.
public type HDR_PaintCallbackSub as sub( byval p as PSCOLUMNHEADER_PAINTINFO ptr )

' Observe mouse messages. Return TRUE if you handled it and want the control's default
' handling suppressed, FALSE to let it proceed. The result is IGNORED for WM_LBUTTONUP:
' the control holds mouse capture across a press, and the up-message is the capture's
' exit -- a callback that suppressed it would strand the capture (see Learnings.md).
public type HDR_MessageCallbackFunc as function( byval m as PSCOLUMNHEADER_MESSAGEINFO ptr ) as boolean

' Supply the tooltip text for a column, on demand (only when a tip is about to show).
' Return "" for no tooltip. If unset, the column's own Text is used.
public type HDR_TooltipCallbackFunc as function( byval hHeader as HWND, byval idx as integer ) as ustring

' A completed click on a column's BODY (matched press+release on the same column, not on
' a divider). This is the host's sorting hook: the control never sorts -- repaint a sort
' glyph from your paint callback and reorder your own data.
public type HDR_ClickCallbackSub as sub( byval hHeader as HWND, byval idx as integer )

' A column's width changed through USER interaction. Fired per WM_MOUSEMOVE during a
' live divider drag with bLive = true, and once more with bLive = false when the drag
' commits (release), cancels (ESC / capture loss -- carrying the restored width), or an
' autosize applies. Programmatic PsColumnHeader_SetColumnWidth does NOT fire this (the
' family rule: programmatic setters are silent; only user interaction notifies).
public type HDR_WidthChangedCallbackSub as sub( byval hHeader as HWND, byval idx as integer, byval nWidth as integer, byval bLive as boolean )

' Divider double-click: return the best-fit width in pixels for the column (the host
' owns the cell data and fonts, so only it can measure). Return <= 0 for "no change".
public type HDR_AutoSizeCallbackFunc as function( byval hHeader as HWND, byval idx as integer ) as integer

public type PSCOLUMNHEADER_STATE
    hWin              as HWND
    ' The tooltip, whichever backend it is on. Replaces the old hToolTip + HoverTime
    ' pair; PsColumnHeader_GetTooltipHandle still answers the comctl32 handle, and 0 while
    ' this instance is on PsTooltip.
    tip         as PSTIPHOST_STATE
    wszTooltip        as ustring     ' instance-lifetime buffer TTN_GETDISPINFOW points at
    cols(any)         as PSCOLUMNHEADER_COLINFO
    colCount          as integer = 0
    HoverTime         as integer = 250
    nLastHotIdx       as integer = -1     ' column body the mouse was last over
    nHotDividerIdx    as integer = -1     ' column whose right-divider gutter is hovered
    hotTimerOn        as boolean = false  ' is the hot-tracking safety-net timer running?
    BackColor         as COLORREF
    ' Caller-supplied font (caller owns it). NOT named hFont: a member called hFont would
    ' shadow the TYPE name HFONT inside every member procedure (see Learnings.md).
    hHeaderFont       as HFONT
    ' Fill designation: CCOLHDR_FILL_LAST (default) / CCOLHDR_FILL_NONE / explicit index.
    ' A stored index gets the same insert/delete fixups as PsStatusBar's spring panel.
    fillCol           as integer = CCOLHDR_FILL_LAST
    ' Future horizontal scroll: every rect is computed at (runningX - xOffset). Always 0
    ' in v1; a PsHScrollBar can drive it later without any contract change.
    xOffset           as integer = 0
    nPadding          as integer = CCOLHDR_DEFAULT_PADDING   ' DPI-scaled at Create
    bLayoutDirty      as boolean = true
    ' --- Press / divider-drag state (mouse capture; PsTabBar discipline). The control
    '     takes capture on WM_LBUTTONDOWN because both gestures here consume the
    '     guaranteed down->up pairing: the drag obviously, and the body click's
    '     "press, slide off, release -> nothing" cancel semantics. ---
    nPressedIdx       as integer = -1     ' column body under a live left press
    nDragDividerIdx   as integer = -1     ' column whose divider is being dragged
    nDragOrigWidth    as integer = 0      ' stored width at drag start; ESC restores this
    nDragAnchorX      as integer = 0      ' press x; drag delta = cursor x - anchor
    bDragCancelled    as boolean = false  ' ESC consumed the drag; ignore the trailing up
    PaintCallback        as HDR_PaintCallbackSub
    MessageCallback      as HDR_MessageCallbackFunc
    TooltipCallback      as HDR_TooltipCallbackFunc      ' optional; defaults to Text
    ClickCallback        as HDR_ClickCallbackSub
    WidthChangedCallback as HDR_WidthChangedCallbackSub
    AutoSizeCallback     as HDR_AutoSizeCallbackFunc

    declare sub      LayoutColumns()
    declare function EffectiveFillCol() as integer
    declare function EffectiveMinWidth( byval idx as integer ) as integer
    declare function GetCount() as integer
    declare function InsertColumnAt( byval idx as integer ) as PSCOLUMNHEADER_COLINFO ptr
    declare function AddColumn() as PSCOLUMNHEADER_COLINFO ptr
    declare function GetColumn( byval idx as integer ) as PSCOLUMNHEADER_COLINFO ptr
    declare function DeleteColumnAt( byval idx as integer ) as boolean
    declare function IsValidColumn( byval idx as integer ) as boolean
    declare function HitTestColumn( byval x as integer, byval y as integer ) as integer
    declare function HitTestDivider( byval x as integer, byval y as integer ) as integer
    declare sub      CancelPress()
    declare sub      Clear()
    declare sub      Refresh()
end type

' Which column is the (effective) fill column right now? Resolves the FILL_LAST
' designation against the current count. -1 = none.
function PSCOLUMNHEADER_STATE.EffectiveFillCol() as integer
    if this.fillCol = CCOLHDR_FILL_NONE then return -1
    if this.fillCol = CCOLHDR_FILL_LAST then
        if this.colCount > 0 then return this.colCount - 1
        return -1
    end if
    if this.IsValidColumn( this.fillCol ) then return this.fillCol
    return -1
end function

' The floor a column can never be laid out or dragged below: its own nMinWidth, or the
' DPI-scaled control default when that is 0.
function PSCOLUMNHEADER_STATE.EffectiveMinWidth( byval idx as integer ) as integer
    dim as integer minW = 0
    if this.IsValidColumn( idx ) then minW = this.cols(idx).nMinWidth
    if minW <= 0 then
        minW = CCOLHDR_DEFAULT_MINWIDTH
        dim pWindow as CWindow ptr = CWindowPtr( this.hWin )
        if pWindow then minW = pWindow->ScaleX( CCOLHDR_DEFAULT_MINWIDTH )
    end if
    return minW
end function

' Assign every column's rect. This is the only place column geometry is produced;
' everything else (hit-testing, painting, invalidation, an embedding host's row cells)
' consumes it. Widths are stored, not measured: each fixed column gets
' max( nWidth, EffectiveMinWidth ), and the fill column absorbs the leftover client
' width -- shrinking as well as growing (unlike PsStatusBar's grow-only spring), because
' a fill column must track the window both ways -- but never below its own minimum.
' On overflow the rects run honestly past the right edge; clipping is the paint pass's
' job, and the cursor cannot reach past the edge, so hit-testing stays correct for free.
sub PSCOLUMNHEADER_STATE.LayoutColumns()
    this.bLayoutDirty = false
    if this.hWin = 0 then exit sub
    if this.colCount = 0 then exit sub

    dim as RECT rcClient
    GetClientRect( this.hWin, @rcClient )
    dim as integer clientW = rcClient.right - rcClient.left
    dim as integer clientH = rcClient.bottom - rcClient.top
    ' No geometry yet (created 0x0, sized only once the host positions us). Nothing to
    ' lay out; stay dirty so the next query after a real WM_SIZE recomputes.
    if (clientW <= 0) orelse (clientH <= 0) then
        this.bLayoutDirty = true
        exit sub
    end if

    dim as integer effFill = this.EffectiveFillCol()

    dim colW( 0 to this.colCount - 1 ) as integer
    dim as integer sumOthers = 0
    for i as integer = 0 to this.colCount - 1
        if i = effFill then continue for
        dim as integer nWidth = this.cols(i).nWidth
        dim as integer minW = this.EffectiveMinWidth(i)
        if nWidth < minW then nWidth = minW
        colW(i) = nWidth
        sumOthers += nWidth
    next
    if effFill <> -1 then
        dim as integer nWidth = clientW - sumOthers
        dim as integer minW = this.EffectiveMinWidth(effFill)
        if nWidth < minW then nWidth = minW
        colW(effFill) = nWidth
    end if

    ' Position left-to-right; every column spans the full client height. xOffset shifts
    ' the whole run left once horizontal scrolling exists (always 0 in v1).
    dim as integer x = rcClient.left - this.xOffset
    for i as integer = 0 to this.colCount - 1
        SetRect( @this.cols(i).rc, x, rcClient.top, x + colW(i), rcClient.bottom )
        x += colW(i)
    next
end sub

function PSCOLUMNHEADER_STATE.GetCount() as integer
    return this.colCount
end function

function PSCOLUMNHEADER_STATE.IsValidColumn( byval idx as integer ) as boolean
    return (idx >= 0) andalso (idx < this.colCount)
end function

function PSCOLUMNHEADER_STATE.GetColumn( byval idx as integer ) as PSCOLUMNHEADER_COLINFO ptr
    if this.IsValidColumn(idx) = false then return 0
    return @this.cols(idx)
end function

' Insert a fresh (reset) column at idx, shifting later columns up. Grows the backing
' store by doubling so bulk inserts are amortized O(1), not O(n^2).
function PSCOLUMNHEADER_STATE.InsertColumnAt( byval idx as integer ) as PSCOLUMNHEADER_COLINFO ptr
    if idx < 0 then idx = 0
    if idx > this.colCount then idx = this.colCount

    dim as integer cap = ubound(this.cols) + 1
    if this.colCount >= cap then
        dim as integer newcap = iif( cap = 0, 8, cap * 2 )
        redim preserve this.cols( 0 to newcap - 1 )
    end if

    ' shift [idx .. colCount-1] up by one (no-op when appending)
    for i as integer = this.colCount to idx + 1 step -1
        this.cols(i) = this.cols(i - 1)
    next

    ' reset the new slot (frees any ustring left in a recycled capacity slot)
    with this.cols(idx)
        .Text      = ""
        .itemData  = 0
        .nWidth    = 100
        .nMinWidth = 0
        SetRectEmpty( @.rc )
    end with

    this.colCount += 1
    ' A stored fill index shifts up when inserting at or before it.
    if (this.fillCol >= 0) andalso (idx <= this.fillCol) then
        this.fillCol += 1
    end if
    ' Hover/press indices now point at shifted columns; a live gesture's target is
    ' ambiguous, so cancel rather than guess.
    this.CancelPress()
    this.nLastHotIdx = -1
    this.nHotDividerIdx = -1
    this.Refresh()
    return @this.cols(idx)
end function

function PSCOLUMNHEADER_STATE.AddColumn() as PSCOLUMNHEADER_COLINFO ptr
    return this.InsertColumnAt( this.colCount )
end function

function PSCOLUMNHEADER_STATE.DeleteColumnAt( byval idx as integer ) as boolean
    if this.IsValidColumn(idx) = false then return false
    ' shift [idx+1 .. colCount-1] down by one
    for i as integer = idx to this.colCount - 2
        this.cols(i) = this.cols(i + 1)
    next
    this.cols(this.colCount - 1).Text = ""   ' free the vacated last slot's string
    this.colCount -= 1
    ' Keep a stored fill index meaningful: deleting the fill column itself falls back to
    ' the default (last column); deleting anything before it shifts it down.
    if this.fillCol >= 0 then
        if idx = this.fillCol then
            this.fillCol = CCOLHDR_FILL_LAST
        elseif idx < this.fillCol then
            this.fillCol -= 1
        end if
    end if
    this.CancelPress()
    this.nLastHotIdx = -1
    this.nHotDividerIdx = -1
    this.Refresh()
    return true
end function

sub PSCOLUMNHEADER_STATE.Clear()
    for i as integer = 0 to this.colCount - 1
        this.cols(i).Text = ""
    next
    this.colCount = 0
    this.fillCol  = CCOLHDR_FILL_LAST
    this.nLastHotIdx = -1
    this.nHotDividerIdx = -1
    this.CancelPress()
    this.Refresh()
end sub

' Which column's right-divider gutter is (x, y) in? Returns the column being resized by
' that divider, or -1. Iterates right-to-left so that when a column sits at its minimum
' width and two boundaries nearly coincide, the later divider wins (matches listview
' feel). The effective fill column's own divider is NOT grabbable: its width is derived,
' and with no horizontal scroll there is nothing meaningful to drag it to.
function PSCOLUMNHEADER_STATE.HitTestDivider( byval x as integer, byval y as integer ) as integer
    if this.colCount = 0 then return -1
    if this.bLayoutDirty then this.LayoutColumns()
    dim as integer gutter = CCOLHDR_DIVIDER_GUTTER
    dim pWindow as CWindow ptr = CWindowPtr( this.hWin )
    if pWindow then gutter = pWindow->ScaleX( CCOLHDR_DIVIDER_GUTTER )
    dim as integer effFill = this.EffectiveFillCol()
    for i as integer = this.colCount - 1 to 0 step -1
        if i = effFill then continue for
        dim as integer bx = this.cols(i).rc.right
        if abs(x - bx) <= gutter then return i
    next
    return -1
end function

' Which column's BODY is (x, y) over? Divider gutters take priority: on a gutter this
' returns -1 (the gesture there is a resize, not a column press).
function PSCOLUMNHEADER_STATE.HitTestColumn( byval x as integer, byval y as integer ) as integer
    if this.colCount = 0 then return -1
    if this.bLayoutDirty then this.LayoutColumns()
    if this.HitTestDivider( x, y ) <> -1 then return -1
    dim as POINT pt
    pt.x = x : pt.y = y
    for i as integer = 0 to this.colCount - 1
        if PtInRect( @this.cols(i).rc, pt ) then return i
    next
    return -1
end function

' Abandon any live press or divider drag WITHOUT firing callbacks or restoring widths --
' this is the "state is gone" path (column mutated under a gesture, window destroyed).
' Interactive cancel/commit paths (up, ESC, WM_CAPTURECHANGED) have their own handlers.
sub PSCOLUMNHEADER_STATE.CancelPress()
    this.nPressedIdx = -1
    this.nDragDividerIdx = -1
    this.bDragCancelled = false
    if (this.hWin <> 0) andalso (GetCapture() = this.hWin) then ReleaseCapture()
end sub

' Mark the layout stale and request a repaint. Every mutator routes through here, which
' is what makes layout lazy: a burst of width changes costs one layout pass, not N.
sub PSCOLUMNHEADER_STATE.Refresh()
    this.bLayoutDirty = true
    ' Repaint WITH background erase so a region vacated by a shrinking column is cleared.
    if this.hWin then InvalidateRect( this.hWin, NULL, TRUE )
end sub


' ========================================================================================
' PUBLIC API
'
' THE CONTROL HANDLE
'   Every PsColumnHeader_* function takes the handle returned by PsColumnHeader_Create().
'   The handle is a real HWND on purpose (not an opaque type): callers legitimately need
'   to treat the control as a window, e.g. SetWindowPos() to place and size it.
'
' LIFETIME
'   The control frees itself when its window is destroyed. Fonts you pass in stay yours.
'
' ----------------------------------------------------------------------------------------
' Creation
'   CtrlID becomes the control window's id (GWLP_ID). There are no child controls.
'   The control is created zero-sized: position it with SetWindowPos().
' ----------------------------------------------------------------------------------------
public declare function PsColumnHeader_Create( byval hWndParent as HWND, byval CtrlID as integer ) as HWND

' ----------------------------------------------------------------------------------------
' Adding / removing columns. Add returns the new column's index, Insert the actual index
' used (clamped to [0, count]); both -1 on failure. Widths are pixels. nMinWidth 0 means
' the scaled CCOLHDR_DEFAULT_MINWIDTH floor applies.
' ----------------------------------------------------------------------------------------
public declare function PsColumnHeader_AddColumn( byval hHeader as HWND, byval Text as ustring, byval nWidth as integer = 100, byval nMinWidth as integer = 0, byval itemData as integer = 0 ) as integer
public declare function PsColumnHeader_InsertColumn( byval hHeader as HWND, byval idx as integer, byval Text as ustring, byval nWidth as integer = 100, byval nMinWidth as integer = 0, byval itemData as integer = 0 ) as integer
public declare function PsColumnHeader_DeleteColumn( byval hHeader as HWND, byval idx as integer ) as boolean
public declare sub      PsColumnHeader_Clear( byval hHeader as HWND )
public declare function PsColumnHeader_GetCount( byval hHeader as HWND ) as integer
public declare sub      PsColumnHeader_Refresh( byval hHeader as HWND )

' ----------------------------------------------------------------------------------------
' Column contents. Set* return FALSE for an invalid column index.
' ----------------------------------------------------------------------------------------
public declare function PsColumnHeader_GetColumnText( byval hHeader as HWND, byval idx as integer ) as ustring
public declare function PsColumnHeader_SetColumnText( byval hHeader as HWND, byval idx as integer, byval Text as ustring ) as boolean
public declare function PsColumnHeader_GetColumnItemData( byval hHeader as HWND, byval idx as integer ) as integer
public declare function PsColumnHeader_SetColumnItemData( byval hHeader as HWND, byval idx as integer, byval itemData as integer ) as boolean

' ----------------------------------------------------------------------------------------
' Layout.
'
'   Fixed columns render at max( nWidth, effective minimum ); the single fill column
'   absorbs the leftover client width, shrinking and growing with the window but never
'   below its minimum. SetFillColumn takes an index, CCOLHDR_FILL_LAST (default), or
'   CCOLHDR_FILL_NONE; GetFillColumn returns the resolved index (-1 = none).
'
'   SetColumnWidth is the programmatic door: it stores the width silently (no
'   WidthChanged callback -- that is reserved for user drags). Setting the fill
'   column's width stores it but has no visual effect until it stops being the fill.
'
'   Rects are computed lazily. GetColumnRect forces a pending layout, so it is always
'   current -- an embedding host reads row-cell x-coordinates from it.
'
'   HitTestDivider (client coords) is public mainly for self-tests: it returns the
'   column whose right-edge divider gutter contains the point, -1 otherwise.
' ----------------------------------------------------------------------------------------
public declare function PsColumnHeader_GetColumnWidth( byval hHeader as HWND, byval idx as integer ) as integer
public declare function PsColumnHeader_SetColumnWidth( byval hHeader as HWND, byval idx as integer, byval nWidth as integer ) as boolean
public declare function PsColumnHeader_GetColumnMinWidth( byval hHeader as HWND, byval idx as integer ) as integer
public declare function PsColumnHeader_SetColumnMinWidth( byval hHeader as HWND, byval idx as integer, byval nMinWidth as integer ) as boolean
public declare function PsColumnHeader_GetFillColumn( byval hHeader as HWND ) as integer
public declare function PsColumnHeader_SetFillColumn( byval hHeader as HWND, byval idx as integer ) as boolean
public declare function PsColumnHeader_GetColumnRect( byval hHeader as HWND, byval idx as integer, byref rc as RECT ) as boolean
public declare function PsColumnHeader_HitTestDivider( byval hHeader as HWND, byval x as integer, byval y as integer ) as integer
public declare function PsColumnHeader_GetPadding( byval hHeader as HWND ) as integer
public declare sub      PsColumnHeader_SetPadding( byval hHeader as HWND, byval nPadding as integer )
public declare sub      PsColumnHeader_SetXOffset( byval hHeader as HWND, byval xOffset as integer )

' ----------------------------------------------------------------------------------------
' Appearance. The font is borrowed, never owned: keep it alive and destroy it yourself.
' ----------------------------------------------------------------------------------------
public declare function PsColumnHeader_GetBackColor( byval hHeader as HWND ) as COLORREF
public declare function PsColumnHeader_SetBackColor( byval hHeader as HWND, byval clr as COLORREF ) as COLORREF
public declare function PsColumnHeader_GetFont( byval hHeader as HWND ) as HFONT
public declare function PsColumnHeader_SetFont( byval hHeader as HWND, byval hFont as HFONT ) as boolean
public declare function PsColumnHeader_GetTooltipHandle( byval hHeader as HWND ) as HWND
public declare sub      PsColumnHeader_SetHoverTime( byval hHeader as HWND, byval milliseconds as integer )
public declare function PsColumnHeader_SetTooltipMode( byval hHeader as HWND, byval nMode as long ) as boolean
public declare function PsColumnHeader_GetTooltipMode( byval hHeader as HWND ) as long
' The PsTooltip window, or 0 on the system backend. The door to PsTooltip's own
' SetColors/SetFonts/SetStyle/SetMaxWidth/SetTitle/SetGlyph -- deliberately not mirrored
' here, since thirteen controls x twenty setters is 260 wrappers to keep in step.
public declare function PsColumnHeader_GetPsTooltipHandle( byval hHeader as HWND ) as HWND
' Honoured by BOTH backends. A delay never set keeps the backend's own derivation from
' the system double-click time.
public declare sub      PsColumnHeader_SetAutoPopTime( byval hHeader as HWND, byval milliseconds as long )
public declare sub      PsColumnHeader_SetReshowTime( byval hHeader as HWND, byval milliseconds as long )

' ----------------------------------------------------------------------------------------
' Callbacks. See the type declarations above for each signature and contract.
'   PaintCallback        - draw one column's header cell. Required to see anything.
'   MessageCallback      - observe mouse messages; TRUE suppresses default handling
'                          (result ignored for WM_LBUTTONUP -- capture discipline).
'   TooltipCallback      - per-column tooltip text on demand; "" for none.
'   ClickCallback        - completed click on a column body (the sorting hook).
'   WidthChangedCallback - user resize: live per move, final on commit/cancel/autosize.
'   AutoSizeCallback     - divider double-click: return best-fit pixels, <= 0 = ignore.
' ----------------------------------------------------------------------------------------
public declare sub      PsColumnHeader_SetPaintCallback( byval hHeader as HWND, byval usersub as HDR_PaintCallbackSub )
public declare sub      PsColumnHeader_SetMessageCallback( byval hHeader as HWND, byval userfunc as HDR_MessageCallbackFunc )
public declare sub      PsColumnHeader_SetTooltipCallback( byval hHeader as HWND, byval userfunc as HDR_TooltipCallbackFunc )
public declare sub      PsColumnHeader_SetClickCallback( byval hHeader as HWND, byval usersub as HDR_ClickCallbackSub )
public declare sub      PsColumnHeader_SetWidthChangedCallback( byval hHeader as HWND, byval usersub as HDR_WidthChangedCallbackSub )
public declare sub      PsColumnHeader_SetAutoSizeCallback( byval hHeader as HWND, byval userfunc as HDR_AutoSizeCallbackFunc )

' The tooltip backend switch (PsTipHost) is imported at the top of this module, so a host
' needs no import of its own.


function GetColumnHeaderPointer( byval hHeader as HWND ) as PSCOLUMNHEADER_STATE ptr
    dim pWindow as CWindow ptr = CWindowPtr(hHeader)
    if pWindow = 0 then return 0
    return cast( PSCOLUMNHEADER_STATE ptr, pWindow->UserData(0) )
end function


' Repaint one column's header cell. Silently does nothing for an invalid index, which is
' what makes the hover paths safe when the cursor is over empty band area (idx = -1).
' FALSE = no background erase; the cell rect is fully painted by the paint callback.
private sub PsColumnHeader_InvalidateColumn( byval pHdr as PSCOLUMNHEADER_STATE ptr, byval idx as integer )
    if pHdr = 0 then exit sub
    if pHdr->IsValidColumn(idx) = false then exit sub
    InvalidateRect( pHdr->hWin, @pHdr->cols(idx).rc, FALSE )
end sub


' ========================================================================================
' Add a column to the end of the header. Returns the new column's index, or -1.
' ========================================================================================
public function PsColumnHeader_AddColumn( byval hHeader as HWND, byval Text as ustring, byval nWidth as integer = 100, byval nMinWidth as integer = 0, byval itemData as integer = 0 ) as integer
    return PsColumnHeader_InsertColumn( hHeader, &h7FFFFFFF, Text, nWidth, nMinWidth, itemData )
end function


' ========================================================================================
' Insert a column at the given index (existing columns shift up). Returns the actual
' index used (clamped to [0, count]), or -1 on failure.
' ========================================================================================
public function PsColumnHeader_InsertColumn( byval hHeader as HWND, byval idx as integer, byval Text as ustring, byval nWidth as integer = 100, byval nMinWidth as integer = 0, byval itemData as integer = 0 ) as integer
    dim as PSCOLUMNHEADER_STATE ptr pHdr = GetColumnHeaderPointer(hHeader)
    if pHdr = 0 then return -1
    dim as integer at = idx
    if at < 0 then at = 0
    if at > pHdr->GetCount() then at = pHdr->GetCount()
    dim as PSCOLUMNHEADER_COLINFO ptr pCol = pHdr->InsertColumnAt( at )
    if pCol = 0 then return -1
    pCol->Text      = Text
    pCol->itemData  = itemData
    if nWidth > 0 then pCol->nWidth = nWidth
    if nMinWidth > 0 then pCol->nMinWidth = nMinWidth
    return at
end function


' ========================================================================================
' Delete the column at the given index. Returns TRUE on success.
' ========================================================================================
public function PsColumnHeader_DeleteColumn( byval hHeader as HWND, byval idx as integer ) as boolean
    dim as PSCOLUMNHEADER_STATE ptr pHdr = GetColumnHeaderPointer(hHeader)
    if pHdr = 0 then return false
    return pHdr->DeleteColumnAt( idx )
end function


' ========================================================================================
' Remove all columns from the header.
' ========================================================================================
public sub PsColumnHeader_Clear( byval hHeader as HWND )
    dim as PSCOLUMNHEADER_STATE ptr pHdr = GetColumnHeaderPointer(hHeader)
    if pHdr = 0 then return
    pHdr->Clear()
end sub


' ========================================================================================
' Retrieve the current column count.
' ========================================================================================
public function PsColumnHeader_GetCount( byval hHeader as HWND ) as integer
    dim as PSCOLUMNHEADER_STATE ptr pHdr = GetColumnHeaderPointer(hHeader)
    if pHdr = 0 then return 0
    return pHdr->GetCount()
end function


' ========================================================================================
' Refresh (re-layout + repaint) the header.
' ========================================================================================
public sub PsColumnHeader_Refresh( byval hHeader as HWND )
    dim as PSCOLUMNHEADER_STATE ptr pHdr = GetColumnHeaderPointer(hHeader)
    if pHdr then pHdr->Refresh()
end sub


' ========================================================================================
' Column text.
' ========================================================================================
public function PsColumnHeader_GetColumnText( byval hHeader as HWND, byval idx as integer ) as ustring
    dim as PSCOLUMNHEADER_STATE ptr pHdr = GetColumnHeaderPointer(hHeader)
    if pHdr = 0 then return ""
    if pHdr->IsValidColumn(idx) = false then return ""
    dim as ustring wszText = pHdr->GetColumn(idx)->Text
    return wszText
end function

public function PsColumnHeader_SetColumnText( byval hHeader as HWND, byval idx as integer, byval Text as ustring ) as boolean
    dim as PSCOLUMNHEADER_STATE ptr pHdr = GetColumnHeaderPointer(hHeader)
    if pHdr = 0 then return false
    if pHdr->IsValidColumn(idx) = false then return false
    pHdr->GetColumn(idx)->Text = Text
    ' Text does not drive layout (widths are stored), so a repaint of the cell suffices.
    PsColumnHeader_InvalidateColumn( pHdr, idx )
    return true
end function


' ========================================================================================
' Column itemData.
' ========================================================================================
function PsColumnHeader_GetColumnItemData( byval hHeader as HWND, byval idx as integer ) as integer
    dim as PSCOLUMNHEADER_STATE ptr pHdr = GetColumnHeaderPointer(hHeader)
    if pHdr = 0 then return 0
    if pHdr->IsValidColumn(idx) = false then return 0
    return pHdr->GetColumn(idx)->itemData
end function

function PsColumnHeader_SetColumnItemData( byval hHeader as HWND, byval idx as integer, byval itemData as integer ) as boolean
    dim as PSCOLUMNHEADER_STATE ptr pHdr = GetColumnHeaderPointer(hHeader)
    if pHdr = 0 then return false
    if pHdr->IsValidColumn(idx) = false then return false
    pHdr->GetColumn(idx)->itemData = itemData
    return true
end function


' ========================================================================================
' Column width (pixels). SetColumnWidth is the programmatic door: silent by the family
' rule (no WidthChanged callback -- that is reserved for user drags). The width is
' clamped to the column's effective minimum.
' ========================================================================================
public function PsColumnHeader_GetColumnWidth( byval hHeader as HWND, byval idx as integer ) as integer
    dim as PSCOLUMNHEADER_STATE ptr pHdr = GetColumnHeaderPointer(hHeader)
    if pHdr = 0 then return 0
    if pHdr->IsValidColumn(idx) = false then return 0
    ' The fill column's rendered width is derived; report the laid-out truth.
    if idx = pHdr->EffectiveFillCol() then
        if pHdr->bLayoutDirty then pHdr->LayoutColumns()
        return pHdr->cols(idx).rc.right - pHdr->cols(idx).rc.left
    end if
    dim as integer nWidth = pHdr->cols(idx).nWidth
    dim as integer minW = pHdr->EffectiveMinWidth(idx)
    if nWidth < minW then nWidth = minW
    return nWidth
end function

public function PsColumnHeader_SetColumnWidth( byval hHeader as HWND, byval idx as integer, byval nWidth as integer ) as boolean
    dim as PSCOLUMNHEADER_STATE ptr pHdr = GetColumnHeaderPointer(hHeader)
    if pHdr = 0 then return false
    if pHdr->IsValidColumn(idx) = false then return false
    dim as integer minW = pHdr->EffectiveMinWidth(idx)
    if nWidth < minW then nWidth = minW
    pHdr->cols(idx).nWidth = nWidth
    ' Programmatic width change during a live drag on the SAME column: the new value
    ' becomes the drag's base, so a later ESC restores to it and the next mousemove
    ' resumes from it (re-anchored to the current cursor x).
    if idx = pHdr->nDragDividerIdx then
        pHdr->nDragOrigWidth = nWidth
        dim as POINT pt
        GetCursorPos( @pt )
        ScreenToClient( hHeader, @pt )
        pHdr->nDragAnchorX = pt.x
    end if
    pHdr->Refresh()
    return true
end function


' ========================================================================================
' Column minimum width (pixels). 0 = the scaled CCOLHDR_DEFAULT_MINWIDTH floor.
' ========================================================================================
public function PsColumnHeader_GetColumnMinWidth( byval hHeader as HWND, byval idx as integer ) as integer
    dim as PSCOLUMNHEADER_STATE ptr pHdr = GetColumnHeaderPointer(hHeader)
    if pHdr = 0 then return 0
    if pHdr->IsValidColumn(idx) = false then return 0
    return pHdr->GetColumn(idx)->nMinWidth
end function

public function PsColumnHeader_SetColumnMinWidth( byval hHeader as HWND, byval idx as integer, byval nMinWidth as integer ) as boolean
    dim as PSCOLUMNHEADER_STATE ptr pHdr = GetColumnHeaderPointer(hHeader)
    if pHdr = 0 then return false
    if pHdr->IsValidColumn(idx) = false then return false
    if nMinWidth < 0 then nMinWidth = 0
    pHdr->GetColumn(idx)->nMinWidth = nMinWidth
    pHdr->Refresh()
    return true
end function


' ========================================================================================
' Fill column. Set takes an index, CCOLHDR_FILL_LAST, or CCOLHDR_FILL_NONE; Get returns
' the resolved effective index (-1 = none).
' ========================================================================================
public function PsColumnHeader_GetFillColumn( byval hHeader as HWND ) as integer
    dim as PSCOLUMNHEADER_STATE ptr pHdr = GetColumnHeaderPointer(hHeader)
    if pHdr = 0 then return -1
    return pHdr->EffectiveFillCol()
end function

public function PsColumnHeader_SetFillColumn( byval hHeader as HWND, byval idx as integer ) as boolean
    dim as PSCOLUMNHEADER_STATE ptr pHdr = GetColumnHeaderPointer(hHeader)
    if pHdr = 0 then return false
    dim as boolean isDesignation = (idx = CCOLHDR_FILL_LAST) orelse (idx = CCOLHDR_FILL_NONE)
    if isDesignation = false then
        if pHdr->IsValidColumn(idx) = false then return false
    end if
    pHdr->fillCol = idx
    pHdr->Refresh()
    return true
end function


' ========================================================================================
' Retrieve the computed client-coordinate rect of the specified column. Forces a pending
' layout so the result is always current -- an embedding host derives row-cell
' x-coordinates from this. Returns FALSE for a bad index.
' ========================================================================================
public function PsColumnHeader_GetColumnRect( byval hHeader as HWND, byval idx as integer, byref rc as RECT ) as boolean
    dim as PSCOLUMNHEADER_STATE ptr pHdr = GetColumnHeaderPointer(hHeader)
    SetRectEmpty( @rc )
    if pHdr = 0 then return false
    if pHdr->IsValidColumn(idx) = false then return false
    if pHdr->bLayoutDirty then pHdr->LayoutColumns()
    rc = pHdr->GetColumn(idx)->rc
    return true
end function


' ========================================================================================
' Public divider hit-test (client coords), mainly for self-tests. Returns the column
' whose right-edge divider gutter contains the point, -1 otherwise.
' ========================================================================================
public function PsColumnHeader_HitTestDivider( byval hHeader as HWND, byval x as integer, byval y as integer ) as integer
    dim as PSCOLUMNHEADER_STATE ptr pHdr = GetColumnHeaderPointer(hHeader)
    if pHdr = 0 then return -1
    return pHdr->HitTestDivider( x, y )
end function


' ========================================================================================
' Caption padding (pixels). Paint-side only: inset your caption by this much.
' ========================================================================================
public function PsColumnHeader_GetPadding( byval hHeader as HWND ) as integer
    dim as PSCOLUMNHEADER_STATE ptr pHdr = GetColumnHeaderPointer(hHeader)
    if pHdr = 0 then return 0
    return pHdr->nPadding
end function

sub PsColumnHeader_SetPadding( byval hHeader as HWND, byval nPadding as integer )
    dim as PSCOLUMNHEADER_STATE ptr pHdr = GetColumnHeaderPointer(hHeader)
    if pHdr = 0 then exit sub
    if nPadding < 0 then nPadding = 0
    pHdr->nPadding = nPadding
    InvalidateRect( hHeader, NULL, FALSE )
end sub


' ========================================================================================
' Horizontal scroll offset (future PsHScrollBar integration; always 0 in v1). Shifts the
' whole column run left by xOffset pixels.
' ========================================================================================
sub PsColumnHeader_SetXOffset( byval hHeader as HWND, byval xOffset as integer )
    dim as PSCOLUMNHEADER_STATE ptr pHdr = GetColumnHeaderPointer(hHeader)
    if pHdr = 0 then exit sub
    if xOffset < 0 then xOffset = 0
    if xOffset = pHdr->xOffset then exit sub
    pHdr->xOffset = xOffset
    pHdr->Refresh()
end sub


' ========================================================================================
' Appearance.
' ========================================================================================
function PsColumnHeader_GetBackColor( byval hHeader as HWND ) as COLORREF
    dim as PSCOLUMNHEADER_STATE ptr pHdr = GetColumnHeaderPointer(hHeader)
    if pHdr = 0 then return 0
    return pHdr->BackColor
end function

public function PsColumnHeader_SetBackColor( byval hHeader as HWND, byval clr as COLORREF ) as COLORREF
    dim as PSCOLUMNHEADER_STATE ptr pHdr = GetColumnHeaderPointer(hHeader)
    if pHdr = 0 then return 0
    dim as COLORREF oldClr = pHdr->BackColor
    pHdr->BackColor = clr
    InvalidateRect( hHeader, NULL, FALSE )
    return oldClr
end function

function PsColumnHeader_GetFont( byval hHeader as HWND ) as HFONT
    dim as PSCOLUMNHEADER_STATE ptr pHdr = GetColumnHeaderPointer(hHeader)
    if pHdr = 0 then return 0
    return pHdr->hHeaderFont
end function

public function PsColumnHeader_SetFont( byval hHeader as HWND, byval hFont as HFONT ) as boolean
    dim as PSCOLUMNHEADER_STATE ptr pHdr = GetColumnHeaderPointer(hHeader)
    if pHdr = 0 then return false
    pHdr->hHeaderFont = hFont
    ' The font does not drive layout (widths are stored); a repaint suffices.
    InvalidateRect( hHeader, NULL, FALSE )
    return true
end function

' The comctl32 handle, and 0 while on PsTooltip -- the honest answer, since a TTM_* sent
' to a PsTooltip window is silently ignored.
public function PsColumnHeader_GetTooltipHandle( byval hHeader as HWND ) as HWND
    dim as PSCOLUMNHEADER_STATE ptr pHdr = GetColumnHeaderPointer(hHeader)
    if pHdr = 0 then return 0
    return PsTipHost_SysHandle( @pHdr->tip )
end function

' The PsTooltip window, and 0 while on the system backend. This is the door to PsTooltip's
' own SetColors/SetFonts/SetStyle/SetMaxWidth/SetTitle/SetGlyph, none of which is mirrored
' on this control.
public function PsColumnHeader_GetPsTooltipHandle( byval hHeader as HWND ) as HWND
    dim as PSCOLUMNHEADER_STATE ptr pHdr = GetColumnHeaderPointer(hHeader)
    if pHdr = 0 then return 0
    return PsTipHost_PsHandle( @pHdr->tip )
end function

public function PsColumnHeader_SetTooltipMode( byval hHeader as HWND, byval nMode as long ) as boolean
    dim as PSCOLUMNHEADER_STATE ptr pHdr = GetColumnHeaderPointer(hHeader)
    if pHdr = 0 then return false
    return PsTipHost_SetMode( @pHdr->tip, nMode )
end function

public function PsColumnHeader_GetTooltipMode( byval hHeader as HWND ) as long
    dim as PSCOLUMNHEADER_STATE ptr pHdr = GetColumnHeaderPointer(hHeader)
    if pHdr = 0 then return PSTIP_MODE_SYSTEM
    return PsTipHost_GetMode( @pHdr->tip )
end function

' The three delays go through PsTipHost, which STORES them as well as pushing them, so a
' hover time set before a mode switch is still in force after it. Pushing straight at the
' live tooltip loses it at the switch -- and the tip still appears, just on a different
' beat, with nothing reporting the change.
public sub PsColumnHeader_SetHoverTime( byval hHeader as HWND, byval milliseconds as integer )
    dim as PSCOLUMNHEADER_STATE ptr pHdr = GetColumnHeaderPointer(hHeader)
    if pHdr = 0 then exit sub
    ' The field is STILL READ by TrackMouseEvent as dwHoverTime, so this setter
    ' drives the hot-tracking dwell as well as the tooltip. Dropping it here would
    ' silently change when the control considers itself hot.
    pHdr->HoverTime = milliseconds
    PsTipHost_SetDelay( @pHdr->tip, TTDT_INITIAL, milliseconds )
end sub

sub PsColumnHeader_SetAutoPopTime( byval hHeader as HWND, byval milliseconds as long )
    dim as PSCOLUMNHEADER_STATE ptr pHdr = GetColumnHeaderPointer(hHeader)
    if pHdr = 0 then exit sub
    PsTipHost_SetDelay( @pHdr->tip, TTDT_AUTOPOP, milliseconds )
end sub

sub PsColumnHeader_SetReshowTime( byval hHeader as HWND, byval milliseconds as long )
    dim as PSCOLUMNHEADER_STATE ptr pHdr = GetColumnHeaderPointer(hHeader)
    if pHdr = 0 then exit sub
    PsTipHost_SetDelay( @pHdr->tip, TTDT_RESHOW, milliseconds )
end sub


' ========================================================================================
' Callback setters.
' ========================================================================================
public sub PsColumnHeader_SetPaintCallback( byval hHeader as HWND, byval usersub as HDR_PaintCallbackSub )
    dim as PSCOLUMNHEADER_STATE ptr pHdr = GetColumnHeaderPointer(hHeader)
    if pHdr = 0 then return
    pHdr->PaintCallback = usersub
    InvalidateRect( hHeader, NULL, FALSE )
end sub

sub PsColumnHeader_SetMessageCallback( byval hHeader as HWND, byval userfunc as HDR_MessageCallbackFunc )
    dim as PSCOLUMNHEADER_STATE ptr pHdr = GetColumnHeaderPointer(hHeader)
    if pHdr = 0 then return
    pHdr->MessageCallback = userfunc
end sub

public sub PsColumnHeader_SetTooltipCallback( byval hHeader as HWND, byval userfunc as HDR_TooltipCallbackFunc )
    dim as PSCOLUMNHEADER_STATE ptr pHdr = GetColumnHeaderPointer(hHeader)
    if pHdr = 0 then return
    pHdr->TooltipCallback = userfunc
end sub

public sub PsColumnHeader_SetClickCallback( byval hHeader as HWND, byval usersub as HDR_ClickCallbackSub )
    dim as PSCOLUMNHEADER_STATE ptr pHdr = GetColumnHeaderPointer(hHeader)
    if pHdr = 0 then return
    pHdr->ClickCallback = usersub
end sub

public sub PsColumnHeader_SetWidthChangedCallback( byval hHeader as HWND, byval usersub as HDR_WidthChangedCallbackSub )
    dim as PSCOLUMNHEADER_STATE ptr pHdr = GetColumnHeaderPointer(hHeader)
    if pHdr = 0 then return
    pHdr->WidthChangedCallback = usersub
end sub

public sub PsColumnHeader_SetAutoSizeCallback( byval hHeader as HWND, byval userfunc as HDR_AutoSizeCallbackFunc )
    dim as PSCOLUMNHEADER_STATE ptr pHdr = GetColumnHeaderPointer(hHeader)
    if pHdr = 0 then return
    pHdr->AutoSizeCallback = userfunc
end sub


' Resolve the tooltip text for a column: host callback if set, else the column's Text.
function PsColumnHeader_ResolveTooltipText( byval pHdr as PSCOLUMNHEADER_STATE ptr, byval idx as integer ) as ustring
    if pHdr = 0 then return ""
    if pHdr->IsValidColumn(idx) = false then return ""
    if pHdr->TooltipCallback then return pHdr->TooltipCallback( pHdr->hWin, idx )
    dim as ustring wszText = pHdr->cols(idx).Text
    return wszText
end function


' ========================================================================================
' Process WM_SIZE. No child windows to position; the client width decides how much the
' fill column absorbs, so a resize invalidates the layout.
' ========================================================================================
function PsColumnHeader_OnSize( _
            byval hwnd as HWND, _
            byval state as UINT, _
            byval cx as long, _
            byval cy as long _
            ) as LRESULT
    if state <> SIZE_MINIMIZED then
        dim as PSCOLUMNHEADER_STATE ptr pHdr = GetColumnHeaderPointer(hwnd)
        if pHdr then pHdr->Refresh()
    end if
    function = 0
end function


' ========================================================================================
' Process WM_PAINT. Consumes any pending layout first, fills the control's flat
' background, then hands each column touched by the update rect to the host callback.
' (GetUpdateRect is a conservative bounding-box skip -- see PsStatusBar_OnPaint for why
' that is sufficient here.)
' ========================================================================================
function PsColumnHeader_OnPaint( byval hwnd as HWND ) as LRESULT
    dim as PSCOLUMNHEADER_STATE ptr pHdr = GetColumnHeaderPointer(hwnd)
    if pHdr = 0 then return 0

    if pHdr->bLayoutDirty then pHdr->LayoutColumns()

    ' Capture the update rect BEFORE BeginDoubleBuffer -- BeginPaint clears it.
    dim as RECT rcUpdate
    if GetUpdateRect( hwnd, @rcUpdate, FALSE ) = 0 then GetClientRect( hwnd, @rcUpdate )

    dim as PsPaintBuffer b
    b.BeginDoubleBuffer(hwnd)
    b.SetBackColor( pHdr->BackColor )

    ' Fill the whole band, which also covers any strip no column owns (the control's own
    ' background is the only thing it paints; cells belong to the paint callback).
    b.PaintClientRect()

    if pHdr->PaintCallback then
        dim p as PSCOLUMNHEADER_PAINTINFO
        p.hHeader = hwnd
        p.b       = @b
        dim as integer effFill = pHdr->EffectiveFillCol()
        for i as integer = 0 to pHdr->colCount - 1
            dim as RECT rcHit
            if IntersectRect( @rcHit, @pHdr->cols(i).rc, @rcUpdate ) = 0 then continue for
            p.itemID      = i
            p.rc          = pHdr->cols(i).rc
            p.isHot       = (i = pHdr->nLastHotIdx)
            p.isPressed   = (i = pHdr->nPressedIdx)
            p.isResizeHot = (i = pHdr->nHotDividerIdx)
            p.isResizing  = (i = pHdr->nDragDividerIdx)
            p.isFill      = (i = effFill)
            p.wszCaption  = pHdr->cols(i).Text
            pHdr->PaintCallback( @p )
        next
    end if

    b.EndDoubleBuffer()
    function = 0
end function


' ========================================================================================
' Clear any hot-tracked column/divider and stop the safety-net timer. Repaints only what
' actually changes, so this is cheap to call repeatedly.
' ========================================================================================
private sub PsColumnHeader_ClearHotTracking( byval pHdr as PSCOLUMNHEADER_STATE ptr, byval hHeader as HWND )
    if pHdr = 0 then exit sub
    if pHdr->hotTimerOn then
        KillTimer( hHeader, IDT_CCOLHDR_HOTTRACK )
        pHdr->hotTimerOn = false
    end if
    dim as boolean changed = false
    if pHdr->nLastHotIdx <> -1 then
        PsColumnHeader_InvalidateColumn( pHdr, pHdr->nLastHotIdx )
        pHdr->nLastHotIdx = -1
        changed = true
    end if
    if pHdr->nHotDividerIdx <> -1 then
        PsColumnHeader_InvalidateColumn( pHdr, pHdr->nHotDividerIdx )
        PsColumnHeader_InvalidateColumn( pHdr, pHdr->nHotDividerIdx + 1 )
        pHdr->nHotDividerIdx = -1
        changed = true
    end if
    if changed then UpdateWindow( hHeader )
end sub


' ========================================================================================
' Update hover state (column body + divider gutter) from a client-coordinate point.
' Invalidates only the cells whose paint flags changed. The divider highlight may be
' drawn by the host at the boundary between column i and i+1, so both get repainted.
' ========================================================================================
private sub PsColumnHeader_UpdateHotTracking( byval pHdr as PSCOLUMNHEADER_STATE ptr, byval x as integer, byval y as integer )
    if pHdr = 0 then exit sub

    dim as integer newDiv = pHdr->HitTestDivider( x, y )
    dim as integer newHot = pHdr->HitTestColumn( x, y )

    if newHot <> pHdr->nLastHotIdx then
        PsColumnHeader_InvalidateColumn( pHdr, pHdr->nLastHotIdx )
        PsColumnHeader_InvalidateColumn( pHdr, newHot )
        pHdr->nLastHotIdx = newHot
        ' Item changed. On the system backend this pops the tip so it re-queries
        ' TTN_GETDISPINFOW for the new item; on PsTooltip it moves the tool index, which
        ' hides a visible tip and re-resolves on the next dwell. One call site either way --
        ' and the index is what lets the PsTooltip backend report WHICH item a tip is for,
        ' which comctl32 never knew.
        PsTipHost_SetToolIndex( @pHdr->tip, newHot )
    end if

    if newDiv <> pHdr->nHotDividerIdx then
        PsColumnHeader_InvalidateColumn( pHdr, pHdr->nHotDividerIdx )
        PsColumnHeader_InvalidateColumn( pHdr, pHdr->nHotDividerIdx + 1 )
        PsColumnHeader_InvalidateColumn( pHdr, newDiv )
        PsColumnHeader_InvalidateColumn( pHdr, newDiv + 1 )
        pHdr->nHotDividerIdx = newDiv
    end if
end sub


private sub PsColumnHeader_FireWidthChanged( byval pHdr as PSCOLUMNHEADER_STATE ptr, byval idx as integer, byval nWidth as integer, byval bLive as boolean )
    if pHdr = 0 then exit sub
    if pHdr->WidthChangedCallback then pHdr->WidthChangedCallback( pHdr->hWin, idx, nWidth, bLive )
end sub


' ========================================================================================
' Cancel a live divider drag, RESTORING the pre-drag width, and fire one final
' WidthChanged notification carrying it (so a host that consumed the live updates
' converges back). Used by the ESC poll and by WM_CAPTURECHANGED -- unlike PsTabBar's
' live reorder, a half-applied width is not a legitimate final state unless the
' up-handler blessed it. Save-then-clears the drag state BEFORE ReleaseCapture, so the
' WM_CAPTURECHANGED that fires during the release finds nothing left to cancel.
' bReleaseCapture = false when the capture is already gone (WM_CAPTURECHANGED path).
' ========================================================================================
private sub PsColumnHeader_CancelDragRestore( byval pHdr as PSCOLUMNHEADER_STATE ptr, byval bReleaseCapture as boolean )
    if pHdr = 0 then exit sub
    dim as integer dragIdx = pHdr->nDragDividerIdx
    if dragIdx = -1 then exit sub
    pHdr->nDragDividerIdx = -1
    pHdr->bDragCancelled  = true
    pHdr->cols(dragIdx).nWidth = pHdr->nDragOrigWidth
    pHdr->Refresh()
    PsColumnHeader_FireWidthChanged( pHdr, dragIdx, pHdr->nDragOrigWidth, false )
    if bReleaseCapture then
        if GetCapture() = pHdr->hWin then ReleaseCapture()
    end if
end sub


' ========================================================================================
' PsColumnHeader Window procedure
'
' This control has no child windows, so there is nothing to subclass: every message is
' handled here and anything unhandled goes to DefWindowProc.
'
' The press machinery TAKES capture on a press (the PsTabBar decision): both gestures
' here consume the guaranteed down->up pairing -- the divider drag obviously, and the
' body click's "press, slide off, release -> nothing" cancel semantics. It pays the
' family's full price:
'   - capture taken BEFORE the host callback can suppress anything;
'   - released in the up-handler unconditionally, callback result IGNORED there;
'   - WM_CAPTURECHANGED cancels the press (and restores an uncommitted drag width);
'   - WM_DESTROY releases if we still hold it.
' No SetFocus anywhere: a header must not steal focus from the host's editor.
' ========================================================================================
function PsColumnHeader_WndProc( _
            byval hwnd   as HWND, _
            byval uMsg   as UINT, _
            byval wParam as WPARAM, _
            byval lParam as LPARAM _
            ) as LRESULT

    dim as PSCOLUMNHEADER_STATE ptr pHdr = GetColumnHeaderPointer( hwnd )

    ' Per-message scratch info passed to the user MessageCallback. A plain local (NOT
    ' static) so that multiple control instances never share it.
    dim m as PSCOLUMNHEADER_MESSAGEINFO

    select case uMsg
        ' Prepare the callback MessageInfo for only the messages we hand to the host.
        case WM_MOUSEMOVE, WM_MOUSEHOVER, WM_MOUSELEAVE, _
             WM_LBUTTONDOWN, WM_RBUTTONDOWN, WM_LBUTTONUP, WM_LBUTTONDBLCLK
            with m
                .hHeader = hwnd
                .uMsg    = uMsg
                .wParam  = wParam
                .lParam  = lParam
                .idx     = -1
            end with
    end select

    select case uMsg
        HANDLE_MSG (hwnd, WM_SIZE,  PsColumnHeader_OnSize)
        HANDLE_MSG (hwnd, WM_PAINT, PsColumnHeader_OnPaint)

    case WM_ERASEBKGND
        ' Never erase: WM_PAINT fills the whole client through the double buffer.
        return true

    case WM_TIMER
        if (pHdr <> 0) andalso (wParam = IDT_CCOLHDR_HOTTRACK) then
            if pHdr->nDragDividerIdx <> -1 then
                ' While a drag holds capture the cursor legitimately roams outside the
                ' client: never clear the resize visuals mid-gesture. The timer doubles
                ' as the ESC poll so a motionless cancel still works.
                if (GetAsyncKeyState(VK_ESCAPE) and &h8000) then
                    PsColumnHeader_CancelDragRestore( pHdr, true )
                end if
                return 0
            end if
            ' The cursor may have left without a WM_MOUSELEAVE. If it is no longer over
            ' our client area, clear the hot column ourselves.
            dim as RECT rcClient : GetClientRect( hwnd, @rcClient )
            if isMouseOverRECT( hwnd, rcClient ) = false then
                PsColumnHeader_ClearHotTracking( pHdr, hwnd )
            end if
            return 0
        end if

    case WM_MOUSEMOVE
        if pHdr = 0 then return 0

        ' Signed coords: under capture (dragging) they legitimately go negative.
        dim as integer ptX = cast( short, loword(lParam) )
        dim as integer ptY = cast( short, hiword(lParam) )

        ' ----------------------------------------------------------------------------
        ' Divider drag in progress: ESC cancels (restoring the pre-drag width),
        ' otherwise live-resize -- store the clamped width, re-layout, and notify the
        ' host per move (bLive = true). Hover tracking is SUSPENDED for the whole
        ' gesture: the resize visuals are driven by nDragDividerIdx, and with capture
        ' held the cursor legitimately roams outside the client.
        ' ----------------------------------------------------------------------------
        if pHdr->nDragDividerIdx <> -1 then
            if (GetAsyncKeyState(VK_ESCAPE) and &h8000) then
                PsColumnHeader_CancelDragRestore( pHdr, true )
            else
                dim as integer dragIdx = pHdr->nDragDividerIdx
                dim as integer newW = pHdr->nDragOrigWidth + (ptX - pHdr->nDragAnchorX)
                dim as integer minW = pHdr->EffectiveMinWidth( dragIdx )
                if newW < minW then newW = minW
                if newW <> pHdr->cols(dragIdx).nWidth then
                    pHdr->cols(dragIdx).nWidth = newW
                    pHdr->Refresh()
                    PsColumnHeader_FireWidthChanged( pHdr, dragIdx, newW, true )
                end if
            end if
            ' Observer only mid-drag: the gesture is not suppressible in flight.
            m.idx = -1
            if pHdr->MessageCallback then pHdr->MessageCallback( @m )
            return 0
        end if

        ' Track that we are over the control to catch WM_MOUSEHOVER / WM_MOUSELEAVE.
        dim tme as TrackMouseEvent
        tme.cbSize      = sizeof(TrackMouseEvent)
        tme.dwFlags     = TME_HOVER or TME_LEAVE
        tme.hwndTrack   = hwnd
        tme.dwHoverTime = pHdr->HoverTime
        TrackMouseEvent(@tme)

        ' Safety net: WM_MOUSELEAVE is not guaranteed to arrive on fast exits.
        if pHdr->hotTimerOn = false then
            SetTimer( hwnd, IDT_CCOLHDR_HOTTRACK, CCOLHDR_HOTTRACK_MS, NULL )
            pHdr->hotTimerOn = true
        end if

        PsColumnHeader_UpdateHotTracking( pHdr, ptX, ptY )

        m.idx = pHdr->nLastHotIdx
        if pHdr->MessageCallback then
            if pHdr->MessageCallback( @m ) then return 0
        end if

    case WM_MOUSEHOVER
        if pHdr then
            m.idx = pHdr->nLastHotIdx
            if pHdr->MessageCallback then
                if pHdr->MessageCallback( @m ) then return 0
            end if
        end if

    case WM_MOUSELEAVE
        if pHdr then
            ' Fast path for clearing the hot column (the WM_TIMER poll is the fallback).
            ' m.idx stays -1: the mouse is gone. Never while dragging -- with capture
            ' held the cursor roams outside the client mid-gesture, and a clear would
            ' strip the resize visuals.
            if pHdr->nDragDividerIdx = -1 then
                PsColumnHeader_ClearHotTracking( pHdr, hwnd )
            end if
            if pHdr->MessageCallback then
                if pHdr->MessageCallback( @m ) then return 0
            end if
        end if

    case WM_SETCURSOR
        ' Show the resize cursor over a divider gutter (and for the whole drag, even
        ' when the cursor is momentarily off any gutter). Must return TRUE after
        ' SetCursor, or DefWindowProc restores the class arrow cursor on every move.
        if (pHdr <> 0) andalso (loword(lParam) = HTCLIENT) then
            dim as POINT pt
            GetCursorPos( @pt )
            ScreenToClient( hwnd, @pt )
            dim as boolean wantSizeCursor = (pHdr->nDragDividerIdx <> -1)
            if wantSizeCursor = false then
                wantSizeCursor = (pHdr->HitTestDivider( pt.x, pt.y ) <> -1)
            end if
            if wantSizeCursor then
                SetCursor( LoadCursor( NULL, IDC_SIZEWE ) )
                return TRUE
            end if
        end if

    case WM_LBUTTONDOWN, WM_LBUTTONDBLCLK
        ' WM_LBUTTONDBLCLK REPLACES the second WM_LBUTTONDOWN (CS_DBLCLKS) but is still
        ' followed by its own WM_LBUTTONUP, so it must run the same press bookkeeping or
        ' that up would release a capture never taken.
        SetCapture( hwnd )
        if pHdr then
            dim as integer ptX = cast( short, loword(lParam) )
            dim as integer ptY = cast( short, hiword(lParam) )
            dim as integer divIdx = pHdr->HitTestDivider( ptX, ptY )
            pHdr->bDragCancelled = false
            m.idx = pHdr->HitTestColumn( ptX, ptY )
            ' Host observer first: TRUE suppresses the press semantics -- but never the
            ' capture bookkeeping, whose release is already guaranteed above.
            if pHdr->MessageCallback then
                if pHdr->MessageCallback( @m ) then return 0
            end if
            if (uMsg = WM_LBUTTONDBLCLK) andalso (divIdx <> -1) then
                ' Divider double-click: ask the host for a best-fit width (it owns the
                ' cell data and fonts; the control cannot measure). <= 0 = no change.
                ' Replaces any press/drag semantics for this down; the trailing up
                ' finds no press state and does nothing.
                if pHdr->AutoSizeCallback then
                    dim as integer bestW = pHdr->AutoSizeCallback( hwnd, divIdx )
                    if bestW > 0 then
                        dim as integer minW = pHdr->EffectiveMinWidth( divIdx )
                        if bestW < minW then bestW = minW
                        pHdr->cols(divIdx).nWidth = bestW
                        pHdr->Refresh()
                        PsColumnHeader_FireWidthChanged( pHdr, divIdx, bestW, false )
                    end if
                end if
            elseif divIdx <> -1 then
                ' Arm a divider drag. The base is the EFFECTIVE (min-clamped) width, so
                ' the first pixel of movement never jumps from a sub-minimum stored
                ' value. (A body dblclk falls through to the press below -- it simply
                ' clicks twice, once per matched press/release pair.)
                dim as integer baseW = pHdr->cols(divIdx).nWidth
                dim as integer minW = pHdr->EffectiveMinWidth( divIdx )
                if baseW < minW then baseW = minW
                pHdr->nDragDividerIdx = divIdx
                pHdr->nDragOrigWidth  = baseW
                pHdr->nDragAnchorX    = ptX
                PsColumnHeader_InvalidateColumn( pHdr, divIdx )    ' isResizing visual on
            elseif m.idx <> -1 then
                pHdr->nPressedIdx = m.idx
                PsColumnHeader_InvalidateColumn( pHdr, m.idx )     ' isPressed visual on
            end if
        end if

    case WM_LBUTTONUP
        ' Save-then-clear the press/drag BEFORE releasing: WM_CAPTURECHANGED arrives
        ' during ReleaseCapture and must find nothing to cancel.
        dim as integer pressedIdx = -1
        dim as integer dragIdx = -1
        if pHdr then
            pressedIdx = pHdr->nPressedIdx
            dragIdx    = pHdr->nDragDividerIdx
            pHdr->nPressedIdx     = -1
            pHdr->nDragDividerIdx = -1
        end if
        if GetCapture() = hwnd then ReleaseCapture()
        if pHdr then
            dim as integer ptX = cast( short, loword(lParam) )
            dim as integer ptY = cast( short, hiword(lParam) )
            m.idx = pHdr->HitTestColumn( ptX, ptY )
            ' Result IGNORED: this message just released the capture, and a callback
            ' must never be able to strand that (Learnings.md, the PsListBox bug).
            if pHdr->MessageCallback then pHdr->MessageCallback( @m )
            PsColumnHeader_InvalidateColumn( pHdr, pressedIdx )    ' isPressed off (no-op -1)
            PsColumnHeader_InvalidateColumn( pHdr, dragIdx )       ' isResizing off (no-op -1)
            if dragIdx <> -1 then
                ' Drag commit: the width was live-applied per move; one final
                ' notification blesses it.
                PsColumnHeader_FireWidthChanged( pHdr, dragIdx, pHdr->cols(dragIdx).nWidth, false )
            elseif (pressedIdx <> -1) andalso (pressedIdx = m.idx) then
                ' Click fires only on a MATCHED gesture: pressed this column's body and
                ' released still on it. Capture is what routed an outside-release here
                ' as idx = -1, making slide-off a reliable cancel.
                if pHdr->ClickCallback then pHdr->ClickCallback( hwnd, pressedIdx )
            end if
        end if

    case WM_RBUTTONDOWN
        ' Observer only: no press semantics, no capture.
        if pHdr then
            dim as integer ptX = cast( short, loword(lParam) )
            dim as integer ptY = cast( short, hiword(lParam) )
            m.idx = pHdr->HitTestColumn( ptX, ptY )
            if pHdr->MessageCallback then
                if pHdr->MessageCallback( @m ) then return 0
            end if
        end if

    case WM_CAPTURECHANGED
        ' Someone stole the capture mid-gesture (Alt-Tab, a menu, another SetCapture).
        ' The gesture is dead: cancel the press so no click can fire from its corpse,
        ' and restore an uncommitted drag's width (no ReleaseCapture -- it is already
        ' not ours). The interactive paths cleared their state before releasing, so
        ' this finds nothing to do after a normal up/ESC.
        if pHdr then
            dim as integer wasPressed = pHdr->nPressedIdx
            pHdr->nPressedIdx = -1
            PsColumnHeader_InvalidateColumn( pHdr, wasPressed )    ' no-op for -1
            PsColumnHeader_CancelDragRestore( pHdr, false )
        end if

    case WM_NOTIFY
        ' The tooltip asks for its text on demand; supply the current hot column's.
        dim as NMHDR ptr pnmh = cast(NMHDR ptr, lParam)
        if (pnmh <> 0) andalso (pnmh->code = TTN_GETDISPINFOW) then
            if pHdr then
                dim as NMTTDISPINFOW ptr pdi = cast(NMTTDISPINFOW ptr, lParam)
                ' store in an instance-lifetime buffer and point lpszText at it
                pHdr->wszTooltip = PsColumnHeader_ResolveTooltipText( pHdr, pHdr->nLastHotIdx )
                pdi->lpszText = cast( LPWSTR, PsWPtr(pHdr->wszTooltip) )
                pdi->hinst    = NULL
            end if
            return 0
        end if

    case WM_DESTROY
        if pHdr then
            if pHdr->hotTimerOn then
                KillTimer( hwnd, IDT_CCOLHDR_HOTTRACK )
                pHdr->hotTimerOn = false
            end if
            ' Never leave a capture stranded (phase 2 press/drag holds it).
            pHdr->CancelPress()
        end if

    case WM_NCDESTROY
        if pHdr then
            PsTipHost_Destroy( @pHdr->tip )
            delete(pHdr)
        end if
        dim as CWindow ptr pWindow = CWindowPtr(hwnd)
        if pWindow then delete(pWindow)
        return 0

    end select

    ' for messages that we don't deal with
    function = DefWindowProc( hwnd, uMsg, wParam, lParam )

end function


' ========================================================================================
' Supply the tooltip text to the PsTooltip backend.
'
' This thunk is why PsTipHost never learns the text policy: PsColumnHeader_ResolveTooltipText
' stays the ONE place that decides what a tip says, and the system backend reaches the
' same function by the other road (comctl32 asking through TTN_GETDISPINFOW), which is
' why that arm stays in the WndProc.
' ========================================================================================
private function PsColumnHeader_TipTextCallback( byval hTooltip as HWND, byval hAttached as HWND, _
                                        byval idx as long ) as ustring
    dim as ustring wszOut = PsColumnHeader_ResolveTooltipText( GetColumnHeaderPointer(hAttached), cast(integer, idx) )
    return wszOut
end function


' ========================================================================================
' PsColumnHeader_Create. The control is created zero-sized; the host positions it.
' ========================================================================================
public function PsColumnHeader_Create( byval hWndParent as HWND, byval CtrlID as integer ) as HWND

    dim pWindow as CWindow ptr = New CWindow

    dim as HWND hCtrl = _
            pWindow->Create( hWndParent, "", @PsColumnHeader_WndProc, _
            0, 0, 0, 0, WS_CHILD or WS_CLIPSIBLINGS or WS_CLIPCHILDREN _
            )
    ' Enable double-click messages (WM_LBUTTONDBLCLK) on the control's window class for
    ' divider double-click autosize, preserving the class's existing styles rather than
    ' replacing them. (CWindow's ClassStyle setter REPLACES, so this must be
    ' read-modify-write, and it needs m_hwnd -- i.e. it only works after Create.)
    pWindow->ClassStyle = pWindow->ClassStyle or CS_DBLCLKS

    dim as PSCOLUMNHEADER_STATE ptr pHdr = new PSCOLUMNHEADER_STATE
    pHdr->hWin = hCtrl
    pHdr->nPadding = pWindow->ScaleX( CCOLHDR_DEFAULT_PADDING )
    SetWindowLongPtr( hCtrl, GWLP_ID, CtrlID )

    ' Store the new pointer into the user data area of the header window
    pWindow->UserData(0) = cast(LONG_PTR, pHdr)

    ' AFTER UserData, not before: PsColumnHeader_TipTextCallback resolves the control through
    ' GetColumnHeaderPointer(hAttached), which reads exactly that slot.
    PsTipHost_Ensure( @pHdr->tip, hCtrl, @PsColumnHeader_TipTextCallback )


    function = hCtrl

end function
