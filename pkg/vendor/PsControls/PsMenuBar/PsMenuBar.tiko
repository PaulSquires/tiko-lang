#module "PsMenuBar"

#ifndef TIKO_OS_WINDOWS
    #error "vendor/PsControls is Windows-only (Win32 controls): build for -target windows-x86_64, or use vendor/tkControls"
#endif

#import "sys/win"
#import "sys/win/gui"
#import "sys/win/gdiplus"
#import "vendor/PsControls/PsPopupMenu"
#import "vendor/PsControls/PsBufferPaint"
#import "vendor/PsControls/PsRegistry"
#import "vendor/PsControls/PsTheme"

using gui
using gdiplus
using PsPopupMenu
using PsBufferPaint
using PsRegistry
using PsTheme

' The bar's dropdowns ARE PsPopupMenu windows; the dependency is one-way (PsPopupMenu
' never knows about the bar -- it reports through CPM_NOTIFY_* messages to whatever
' notify window registered, which the bar sets to itself).

' Polling timer that guarantees hover highlight is cleared when the mouse leaves the
' bar. WM_MOUSELEAVE (TME_LEAVE) is not reliably delivered on fast exits, so a
' periodic cursor check acts as a safety net. Timer ids are per-window, so every
' instance can share this id.
public const IDT_CMENUBAR_HOTTRACK = &hCB40
public const PSMENUBAR_HOTTRACK_MS = 100

' Default horizontal inset applied to each side of an item's caption when measuring
' (tiko uses 6+6). DPI-scaled at Create; PsMenuBar_SetPadding takes raw pixels.
public const PSMENUBAR_DEFAULT_PADDING = 6


public type PSMENUBAR_ITEM
    id        as long            ' host id for this bar entry (not a command id --
                                 ' commands live on the popup items)
    wszText   as ustring
    hDropDown as HWND            ' attached PsPopupMenu window. OWNED once attached: the
                                 ' bar destroys it when it is itself destroyed. 0 = a
                                 ' bar item with no menu (clicks on it do nothing).
    ' --- DERIVED by LayoutItems, never set from outside. ---
    nWidth    as long = 0        ' measured width: text + 2*padding
    rc        as RECT            ' full item rect, client coordinates (full bar height)
end type

' Colors for the built-in painter. Copied on Set. A hovered item and the ACTIVE item
' (its dropdown open, or holding the keyboard highlight) render identically -- hot
' fill + hot text -- because a click opens the dropdown at once, so the two are
' frames of one gesture. Set a paint callback if you want them distinguished.
public type PSMENUBAR_COLORS
    BackColor    as COLORREF     ' bar background + idle item fill
    ForeColor    as COLORREF
    BackColorHot as COLORREF     ' hovered / active item fill
    ForeColorHot as COLORREF     ' hovered / active item text
end type

' Handed to the per-item paint callback (which replaces the built-in painter for every
' item when set). Paint through p->b; fill p->rc and center the caption in it. The
' control paints the bar background itself, before the items.
public type PSMENUBAR_PAINTINFO
    hMenuBar   as HWND
    itemID     as long                    ' bar item index
    b          as PsPaintBuffer ptr
    rc         as RECT                    ' the full item rect: fill THIS
    isHot      as boolean                 ' mouse is over this item
    isActive   as boolean                 ' this item's dropdown is open, or it holds
                                          ' the keyboard highlight
    wszCaption as ustring
end type

' A command item on one of this bar's dropdowns was executed (mouse or Enter). The
' popup chain is ALREADY closed and the bar's highlight already cleared when this
' fires. id is the POPUP item's command id -- tiko's shim posts it straight on:
' PostMessage( HWND_FRMMAIN, WM_COMMAND, MAKEWPARAM(id, 0), 0 ).
public type MB_CommandCallbackSub as sub( byval hMenuBar as HWND, byval id as long )

' The dropdown for bar item idx is about to open (click, hover-switch, keyboard, or
' PsMenuBar_OpenMenu). The hook for just-in-time state: flip enabled/checked on the
' popup tree (the by-id setters recurse), rebuild dynamic sections. Fired BEFORE the
' popup's own PM_InitPopupCallback. hPopup is the dropdown being opened.
public type MB_InitPopupCallbackSub as sub( byval hMenuBar as HWND, byval idx as long, byval hPopup as HWND )

' Draw one bar item, INSTEAD OF the built-in painter. See PSMENUBAR_PAINTINFO.
public type MB_PaintItemCallbackSub as sub( byval p as PSMENUBAR_PAINTINFO ptr )


public type PSMENUBAR_STATE
    hWin              as HWND
    ' TRUE once the host set the colours itself (PsMenuBar_SetColors): the theme then leaves this
    ' menu bar alone until PsMenuBar_UnpinColors.
    bColorsPinned     as boolean
    items(any)        as PSMENUBAR_ITEM
    itemCount         as long = 0
    idc_MenuBar       as long = 0
    ' Two single-valued facts, deliberately separate:
    '   nHotIdx    - transient mouse hover (text-only highlight). Cleared on leave.
    '   nActiveIdx - the item whose dropdown is open, OR the keyboard highlight when
    '                no dropdown is open (bMenuOpen tells the two modes apart).
    nHotIdx           as long = -1
    nActiveIdx        as long = -1
    bMenuOpen         as boolean = false
    colors            as PSMENUBAR_COLORS
    ' Caller-supplied font (caller owns it). NOT named hFont -- the HFONT shadowing
    ' trap (see C:\dev\Learnings.md).
    hBarFont          as HFONT
    nPadding          as long = PSMENUBAR_DEFAULT_PADDING   ' DPI-scaled at Create
    bLayoutDirty      as boolean = true
    hotTimerOn        as boolean = false
    CommandCallback   as MB_CommandCallbackSub
    InitPopupCallback as MB_InitPopupCallbackSub
    PaintItemCallback as MB_PaintItemCallbackSub

    declare sub      LayoutItems()
    declare function HitTest( byval x as long, byval y as long ) as long
    declare function IsValidItem( byval idx as long ) as boolean
    declare sub      Refresh()
end type


' ========================================================================================
' PUBLIC API
' ========================================================================================
'
' A MENU BAR: a horizontal strip of text items, each optionally owning a PsPopupMenu
' dropdown. Click opens the dropdown; while one is open, hovering another bar item
' auto-switches to its dropdown; clicking the bar again closes. The bar never takes
' focus -- keyboard navigation arrives through PsMenuBar_FilterMessage, which the host
' MUST call in its message pump (see the contract in PsPopupMenu's module header; the bar's filter
' wraps the popup one, so one call serves the whole menu system).
'
' ALT-KEY ACTIVATION IS THE HOST'S. The filter never consumes WM_SYSKEY* -- the host
' decides what Alt (or an accelerator like Alt+F) does and calls PsMenuBar_OpenMenu /
' PsMenuBar_SetActiveIndex to drive the bar (tiko routes Alt+F etc. through its
' accelerator table precisely because a global Alt hook conflicts with Scintilla).
'
' THE CONTROL HANDLE is a real HWND (family convention): the host positions and sizes
' the bar with SetWindowPos like any child window -- bar height, compact mode, and the
' strip to the right of the items (tiko's "Update Available" label) are all the
' host's. PsMenuBar_GetIdealWidth reports the items' total width for exactly that.
'
' LIFETIME: the control frees itself on destroy, and destroys its attached dropdowns
' (which destroy their submenus) -- one DestroyWindow unwinds the whole menu system.
' Fonts you pass in stay yours.
' ----------------------------------------------------------------------------------------
public declare function PsMenuBar_Create( byval hWndParent as HWND, byval CtrlID as long ) as HWND

' ----------------------------------------------------------------------------------------
' Items. AddItem appends and returns the new index (or -1). SetDropDown attaches a
' PsPopupMenu as the item's dropdown -- OWNERSHIP TRANSFERS; attaching over an existing
' dropdown destroys the old one; 0 detaches without destroying. Programmatic mutators
' are SILENT.
' ----------------------------------------------------------------------------------------
public declare function PsMenuBar_AddItem( byval hMenuBar as HWND, byval Text as ustring, byval id as long ) as long
public declare function PsMenuBar_GetItemCount( byval hMenuBar as HWND ) as long
public declare function PsMenuBar_GetItemText( byval hMenuBar as HWND, byval idx as long ) as ustring
public declare function PsMenuBar_SetItemText( byval hMenuBar as HWND, byval idx as long, byval Text as ustring ) as boolean
public declare function PsMenuBar_SetDropDown( byval hMenuBar as HWND, byval idx as long, byval hPopup as HWND ) as boolean
public declare function PsMenuBar_GetDropDown( byval hMenuBar as HWND, byval idx as long ) as HWND

' ----------------------------------------------------------------------------------------
' Geometry (derived; queries force a pending layout). Items are laid out contiguously
' from x = 0, each item = text width + 2*padding, spanning the full bar height.
' GetIdealWidth = the right edge of the last item: size the bar with it, or draw your
' own content (an update label) in the leftover strip of a full-width bar.
' ----------------------------------------------------------------------------------------
public declare function PsMenuBar_GetItemRect( byval hMenuBar as HWND, byval idx as long, byref rc as RECT ) as boolean
public declare function PsMenuBar_GetIdealWidth( byval hMenuBar as HWND ) as long
public declare function PsMenuBar_GetPadding( byval hMenuBar as HWND ) as long
public declare sub      PsMenuBar_SetPadding( byval hMenuBar as HWND, byval nPadding as long )

' ----------------------------------------------------------------------------------------
' Menu control. OpenMenu is the host's keyboard entry point (tiko's Alt+F accelerator):
' opens item idx's dropdown, optionally putting the selection on its first selectable
' row. CloseMenu closes any open dropdown chain AND clears the highlight -- call it
' from your WM_ACTIVATEAPP(FALSE) handler for instant dismissal on app switch (the
' control's own foreground watch is a 100ms poll). Both are SILENT (programmatic).
' SetActiveIndex sets the keyboard highlight WITHOUT opening a menu (-1 clears).
' ----------------------------------------------------------------------------------------
public declare function PsMenuBar_OpenMenu( byval hMenuBar as HWND, byval idx as long, byval bSelectFirst as boolean = false ) as boolean
public declare sub      PsMenuBar_CloseMenu( byval hMenuBar as HWND )
public declare function PsMenuBar_IsMenuOpen( byval hMenuBar as HWND ) as boolean
public declare function PsMenuBar_GetActiveIndex( byval hMenuBar as HWND ) as long
public declare function PsMenuBar_SetActiveIndex( byval hMenuBar as HWND, byval idx as long ) as boolean

' ----------------------------------------------------------------------------------------
' Appearance. The font is borrowed (caller owns it) and is also the measuring font.
' ----------------------------------------------------------------------------------------
public declare sub      PsMenuBar_SetColors( byval hMenuBar as HWND, byval pColors as PSMENUBAR_COLORS ptr )
public declare function PsMenuBar_ThemeColors( byref t as PSTHEME_COLORS ) as PSMENUBAR_COLORS
public declare sub      PsMenuBar_ApplyTheme( byval hMenuBar as HWND, byref t as PSTHEME_COLORS )
public declare sub      PsMenuBar_UnpinColors( byval hMenuBar as HWND )
public declare sub      PsMenuBar_ApplyFonts( byval hMenuBar as HWND, byval hTextFont as HFONT, byval hGlyphFont as HFONT )
public declare sub      PsMenuBar_Rescale( byval hMenuBar as HWND, byval oldDpi as long, byval newDpi as long )
public declare sub      PsMenuBar_SetFont( byval hMenuBar as HWND, byval hBarFont as HFONT )

' ----------------------------------------------------------------------------------------
' Plumbing.
'   FilterMessage - THE message-pump hook for the whole menu system (bar + dropdowns
'                   + submenus): call it once per pumped message, skip Translate/
'                   Dispatch when it returns TRUE. Handles arrows/Enter/Escape/Home/
'                   End while a dropdown is open (wrapping the PsPopupMenu filter and
'                   adding the bar-boundary moves: Left at the root / Right on a row
'                   without a submenu step between bar items), the highlight-only
'                   keyboard mode, and outside-click dismissal.
'   Callbacks     - see the type declarations above for each contract.
' ----------------------------------------------------------------------------------------
public declare function PsMenuBar_FilterMessage( byval hMenuBar as HWND, byval pMsg as MSG ptr ) as boolean
public declare sub      PsMenuBar_SetCommandCallback( byval hMenuBar as HWND, byval usersub as MB_CommandCallbackSub )
public declare sub      PsMenuBar_SetInitPopupCallback( byval hMenuBar as HWND, byval usersub as MB_InitPopupCallbackSub )
public declare sub      PsMenuBar_SetPaintItemCallback( byval hMenuBar as HWND, byval usersub as MB_PaintItemCallbackSub )

' The bar drives its dropdowns through the popup's implementation (including a few of
' its helpers, which PsPopupMenu makes public for this), imported at the top of this
' module: importing PsMenuBar alone gives a host the complete menu system.


private function GetMenuBarPointer( byval hMenuBar as HWND ) as PSMENUBAR_STATE ptr
    dim pWindow as CWindow ptr = CWindowPtr(hMenuBar)
    dim as PSMENUBAR_STATE ptr pBar = null
    if pWindow then pBar = cast( PSMENUBAR_STATE ptr, pWindow->UserData(0) )
    return pBar
end function

declare function MB_OpenMenuAt( byval hMenuBar as HWND, byval idx as long, byval bSelectFirst as boolean ) as boolean


' ========================================================================================
' PSMENUBAR_STATE member procedures
' ========================================================================================

' Measure every item and assign its rect. The only place bar geometry is produced.
' Items run contiguously from x = 0 and span the full client height; when they do not
' fit, the rightmost simply clips at the client edge.
sub PSMENUBAR_STATE.LayoutItems()
    this.bLayoutDirty = false
    if this.hWin = 0 then exit sub
    if this.itemCount = 0 then exit sub

    dim as RECT rcClient
    GetClientRect( this.hWin, @rcClient )
    ' No geometry yet (created 0x0, sized only once the host positions us). Nothing to
    ' lay out; WM_SIZE will mark the layout dirty again.
    if (rcClient.bottom - rcClient.top) <= 0 then
        this.bLayoutDirty = true
        exit sub
    end if

    dim as HDC hDC = GetDC( this.hWin )
    if hDC = 0 then
        this.bLayoutDirty = true
        exit sub
    end if
    dim as HFONT hFontUse = this.hBarFont
    if hFontUse = 0 then hFontUse = cast( HFONT, GetStockObject( DEFAULT_GUI_FONT ) )
    dim as HFONT hOldFont = SelectObject( hDC, hFontUse )

    dim as long x = rcClient.left
    for i as long = 0 to this.itemCount - 1
        dim as long textW = 0
        dim as long nChars = len( this.items(i).wszText )
        if nChars > 0 then
            dim as SIZE sz
            if GetTextExtentPoint32W( hDC, this.items(i).wszText, nChars, @sz ) then
                textW = sz.cx
            end if
        end if
        this.items(i).nWidth = textW + (this.nPadding * 2)
        SetRect( @this.items(i).rc, x, rcClient.top, x + this.items(i).nWidth, rcClient.bottom )
        x += this.items(i).nWidth
    next

    SelectObject( hDC, hOldFont )
    ReleaseDC( this.hWin, hDC )
end sub

function PSMENUBAR_STATE.HitTest( byval x as long, byval y as long ) as long
    dim as POINT pt = ( x, y )
    for i as long = 0 to this.itemCount - 1
        if PtInRect( @this.items(i).rc, pt ) then return i
    next
    return -1
end function

function PSMENUBAR_STATE.IsValidItem( byval idx as long ) as boolean
    return (idx >= 0) andalso (idx < this.itemCount)
end function

sub PSMENUBAR_STATE.Refresh()
    this.bLayoutDirty = true
    if this.hWin then InvalidateRect( this.hWin, NULL, TRUE )
end sub


' ========================================================================================
' Private helpers
' ========================================================================================

private sub MB_InvalidateItem( byval pBar as PSMENUBAR_STATE ptr, byval idx as long )
    if pBar = null then exit sub
    if pBar->IsValidItem(idx) = false then exit sub
    InvalidateRect( pBar->hWin, @pBar->items(idx).rc, FALSE )
end sub

' Clear any hovered item and stop the safety-net timer. Cheap to call repeatedly.
private sub MB_ClearHotTracking( byval pBar as PSMENUBAR_STATE ptr, byval hMenuBar as HWND )
    if pBar = null then exit sub
    if pBar->hotTimerOn then
        KillTimer( hMenuBar, IDT_CMENUBAR_HOTTRACK )
        pBar->hotTimerOn = false
    end if
    if pBar->nHotIdx <> -1 then
        MB_InvalidateItem( pBar, pBar->nHotIdx )
        pBar->nHotIdx = -1
    end if
end sub

' Set the active (open/highlight) item and repaint the two affected items.
private sub MB_SetActive( byval pBar as PSMENUBAR_STATE ptr, byval idx as long )
    if pBar = null then exit sub
    if idx <> pBar->nActiveIdx then
        MB_InvalidateItem( pBar, pBar->nActiveIdx )
        MB_InvalidateItem( pBar, idx )
        pBar->nActiveIdx = idx
    end if
end sub

' Open item idx's dropdown: fire the bar's InitPopup hook, aim the popup's
' notifications back at the bar, and show it under the item. Showing a new root
' silently closes any other open chain (PM_ShowCore), so a hover-switch is just
' "open the other one".
private function MB_OpenMenuAt( byval hMenuBar as HWND, byval idx as long, byval bSelectFirst as boolean ) as boolean
    dim as PSMENUBAR_STATE ptr pBar = GetMenuBarPointer(hMenuBar)
    if pBar = null then return false
    if pBar->IsValidItem(idx) = false then return false
    dim as HWND hDrop = pBar->items(idx).hDropDown
    if hDrop = 0 then return false
    if pBar->bLayoutDirty then pBar->LayoutItems()
    if pBar->bLayoutDirty then return false       ' no geometry to anchor against yet

    if pBar->InitPopupCallback then pBar->InitPopupCallback( hMenuBar, idx, hDrop )
    PsPopupMenu_SetNotifyWindow( hDrop, hMenuBar )

    dim as RECT rcAnchor = pBar->items(idx).rc
    MapWindowPoints( hMenuBar, HWND_DESKTOP, cast(POINT ptr, @rcAnchor), 2 )
    if PsPopupMenu_ShowForRect( hDrop, rcAnchor, PM_ALIGN_BELOW ) = false then return false
    if bSelectFirst then PsPopupMenu_SelectFirst( hDrop )

    MB_SetActive( pBar, idx )
    pBar->bMenuOpen = true
    return true
end function

' Step the active highlight/menu to the previous/next bar item that HAS a dropdown,
' wrapping (the keyboard Left/Right-at-the-boundary move).
private sub MB_OpenAdjacent( byval hMenuBar as HWND, byval nDir as long )
    dim as PSMENUBAR_STATE ptr pBar = GetMenuBarPointer(hMenuBar)
    if pBar = null then exit sub
    if pBar->itemCount = 0 then exit sub
    dim as long idx = pBar->nActiveIdx
    for k as long = 1 to pBar->itemCount
        idx += nDir
        if idx < 0 then idx = pBar->itemCount - 1
        if idx > pBar->itemCount - 1 then idx = 0
        if pBar->items(idx).hDropDown then
            MB_OpenMenuAt( hMenuBar, idx, true )
            exit sub
        end if
    next
end sub

' Move the highlight-only selection (no menu open) to the previous/next item, wrapping.
private sub MB_MoveHighlight( byval pBar as PSMENUBAR_STATE ptr, byval nDir as long )
    if pBar = null then exit sub
    if pBar->itemCount = 0 then exit sub
    dim as long idx = pBar->nActiveIdx
    idx += nDir
    if idx < 0 then idx = pBar->itemCount - 1
    if idx > pBar->itemCount - 1 then idx = 0
    MB_SetActive( pBar, idx )
end sub


' ========================================================================================
' Process WM_PAINT message for window: PsMenuBar
' ========================================================================================
private function PsMenuBar_OnPaint( byval hwnd as HWND ) as LRESULT
    dim as PSMENUBAR_STATE ptr pBar = GetMenuBarPointer(hwnd)
    if pBar = null then return 0

    if pBar->bLayoutDirty then pBar->LayoutItems()

    dim as PsPaintBuffer b
    b.BeginDoubleBuffer(hwnd)
    b.SetBackColor( pBar->colors.BackColor )
    b.PaintClientRect()

    dim p as PSMENUBAR_PAINTINFO
    p.hMenuBar = hwnd
    p.b = @b
    for i as long = 0 to pBar->itemCount - 1
        p.itemID     = i
        p.rc         = pBar->items(i).rc
        p.isHot      = (i = pBar->nHotIdx)
        p.isActive   = (i = pBar->nActiveIdx)
        p.wszCaption = pBar->items(i).wszText
        if pBar->PaintItemCallback then
            pBar->PaintItemCallback( @p )
        else
            ' Hover and active render the SAME: hot fill + hot text. The active item
            ' is the one whose dropdown is open (or holds the keyboard highlight), and
            ' since a click opens that dropdown immediately, hover and active are two
            ' frames of one gesture -- styling them differently made the fill flicker
            ' in under the cursor on press. Use the paint callback for a design that
            ' wants them distinct.
            dim as COLORREF backclr, foreclr
            if p.isActive orelse p.isHot then
                backclr = pBar->colors.BackColorHot
                foreclr = pBar->colors.ForeColorHot
            else
                backclr = pBar->colors.BackColor
                foreclr = pBar->colors.ForeColor
            end if
            b.SetColors( foreclr, backclr )
            b.PaintRect( @p.rc )
            b.SetFont( pBar->hBarFont )
            b.PaintText( p.wszCaption, @p.rc, DT_CENTER )
        end if
    next

    b.EndDoubleBuffer()
    return 0
end function


' ========================================================================================
' PsMenuBar Window procedure
' ========================================================================================
function PsMenuBar_WndProc( _
            byval hwnd   as HWND, _
            byval uMsg   as UINT, _
            byval wParam as WPARAM, _
            byval lParam as LPARAM _
            ) as LRESULT

    dim as PSMENUBAR_STATE ptr pBar = GetMenuBarPointer( hwnd )

    select case uMsg
    case WM_PAINT
        return PsMenuBar_OnPaint( hwnd )

    case WM_SIZE
        ' Item rects span the full client height, so a resize invalidates the layout.
        if wParam <> SIZE_MINIMIZED then
            if pBar then pBar->Refresh()
        end if
        return 0

    case WM_MOUSEMOVE
        if pBar then
            dim tme as TrackMouseEvent
            tme.cbSize = sizeof(TrackMouseEvent)
            tme.dwFlags = TME_LEAVE
            tme.hwndTrack = hwnd
            TrackMouseEvent(@tme)
            ' Safety net for the unreliable WM_MOUSELEAVE.
            if pBar->hotTimerOn = false then
                SetTimer( hwnd, IDT_CMENUBAR_HOTTRACK, PSMENUBAR_HOTTRACK_MS, NULL )
                pBar->hotTimerOn = true
            end if

            dim as long idx = pBar->HitTest( cast(short, loword(lParam)), cast(short, hiword(lParam)) )
            if idx <> pBar->nHotIdx then
                MB_InvalidateItem( pBar, pBar->nHotIdx )
                MB_InvalidateItem( pBar, idx )
                pBar->nHotIdx = idx
            end if

            ' Hover-switch: while a dropdown is open, moving onto another bar item
            ' that has one switches the open dropdown to it (no click needed).
            if pBar->bMenuOpen then
                dim as boolean bSwitch = pBar->IsValidItem(idx) andalso (idx <> pBar->nActiveIdx)
                if bSwitch then
                    if pBar->items(idx).hDropDown then MB_OpenMenuAt( hwnd, idx, false )
                end if
            end if
        end if
        return 0

    case WM_MOUSELEAVE
        ' Clears the hover highlight only -- the active (open/keyboard) item persists.
        MB_ClearHotTracking( pBar, hwnd )
        return 0

    case WM_TIMER
        if (pBar <> 0) andalso (wParam = IDT_CMENUBAR_HOTTRACK) then
            dim as RECT rcClient
            GetClientRect( hwnd, @rcClient )
            if isMouseOverRECT( hwnd, rcClient ) = false then
                MB_ClearHotTracking( pBar, hwnd )
            end if
            return 0
        end if

    ' No mouse capture is taken -- the per-control test, re-run for this control: the
    ' bar acts on the DOWN alone (menus open on press), tracks no press state and has
    ' no drag, so nothing consumes the down->up pairing.
    case WM_LBUTTONDOWN, WM_LBUTTONDBLCLK
        ' WM_LBUTTONDBLCLK substitutes for the second down of a fast double-click
        ' (CS_DBLCLKS), so it runs the same toggle logic.
        if pBar then
            dim as long idx = pBar->HitTest( cast(short, loword(lParam)), cast(short, hiword(lParam)) )
            if pBar->bMenuOpen then
                ' Any bar click while a dropdown is open closes it (hover-switch has
                ' already moved the dropdown to whatever item the cursor is on).
                PsMenuBar_CloseMenu( hwnd )
            else
                if pBar->IsValidItem(idx) then
                    if pBar->items(idx).hDropDown then MB_OpenMenuAt( hwnd, idx, false )
                end if
            end if
        end if
        return 0

    ' The dropdowns report back through these (the bar registered itself as their
    ' notify window). The chain is already closed when either arrives.
    case CPM_NOTIFY_COMMAND
        if pBar then
            MB_SetActive( pBar, -1 )
            pBar->bMenuOpen = false
            dim as long id = cast(long, cast(LONG_PTR, wParam))
            if pBar->CommandCallback then pBar->CommandCallback( hwnd, id )
        end if
        return 0

    case CPM_NOTIFY_CLOSED
        if pBar then
            pBar->bMenuOpen = false
            ' Escape at the root (wParam = 1) drops back to the keyboard highlight;
            ' any other dismissal (outside click, foreground loss) clears it.
            if wParam <> 1 then MB_SetActive( pBar, -1 )
            MB_InvalidateItem( pBar, pBar->nActiveIdx )
        end if
        return 0

    case WM_ERASEBKGND
        return true

    case WM_DESTROY
        PsRegistry_Remove( hwnd )
        if (pBar <> 0) andalso pBar->hotTimerOn then
            KillTimer( hwnd, IDT_CMENUBAR_HOTTRACK )
            pBar->hotTimerOn = false
        end if
        ' No capture to release: none is ever taken (see the press handler).

    case WM_NCDESTROY
        if pBar then
            ' Attached dropdowns are OWNED: destroying the bar unwinds the whole menu
            ' tree (each popup's own WM_NCDESTROY destroys its submenus).
            for i as long = 0 to pBar->itemCount - 1
                if pBar->items(i).hDropDown then
                    DestroyWindow( pBar->items(i).hDropDown )
                    pBar->items(i).hDropDown = 0
                end if
            next
            delete(pBar)
        end if
        dim as CWindow ptr pWindow = CWindowPtr(hwnd)
        if pWindow then delete(pWindow)
        return 0

    end select

    return DefWindowProc( hwnd, uMsg, wParam, lParam )
end function


' ========================================================================================
' PUBLIC API implementation
' ========================================================================================

public function PsMenuBar_Create( byval hWndParent as HWND, byval CtrlID as long ) as HWND
    dim pWindow as CWindow ptr = new CWindow

    dim as HWND hCtrl = pWindow->Create( hWndParent, "", @PsMenuBar_WndProc, _
            0, 0, 0, 0, WS_CHILD or WS_CLIPSIBLINGS or WS_CLIPCHILDREN )
    ' Replace the class style (dropping CS_HREDRAW/CS_VREDRAW, which only add
    ' flicker); CS_DBLCLKS so a fast double-click still toggles per press.
    pWindow->ClassStyle = CS_DBLCLKS

    dim as PSMENUBAR_STATE ptr pBar = new PSMENUBAR_STATE
    pBar->hWin = hCtrl
    pBar->idc_MenuBar = CtrlID
    pBar->nPadding = pWindow->ScaleX( PSMENUBAR_DEFAULT_PADDING )
    SetWindowLongPtr( hCtrl, GWLP_ID, CtrlID )

    pWindow->UserData(0) = cast(LONG_PTR, pBar)

    ' The pump obligation, registered: a PsApp pump calls our filter (which covers every
    ' dropdown and submenu), and closes the open menu when the form loses the activation.
    PsRegistry_Add( hCtrl, PSREG_PRIO_OWNER, @PsMenuBar_FilterMessage, @PsMenuBar_CloseMenu )

    ' The theme and the form's fonts, applied now if a PsApp program has them (PsRegistry).
    PsRegistry_SetThemeProcs( hCtrl, @PsMenuBar_ApplyTheme, @PsMenuBar_ApplyFonts, @PsMenuBar_Rescale )

    return hCtrl
end function


public function PsMenuBar_AddItem( byval hMenuBar as HWND, byval Text as ustring, byval id as long ) as long
    dim as PSMENUBAR_STATE ptr pBar = GetMenuBarPointer(hMenuBar)
    if pBar = null then return -1
    dim as long cap = ubound(pBar->items) + 1
    if pBar->itemCount >= cap then
        dim as long newcap = iif( cap = 0, 8, cap * 2 )
        redim preserve pBar->items( 0 to newcap - 1 )
    end if
    dim as long idx = pBar->itemCount
    with pBar->items(idx)
        .id        = id
        .wszText   = Text
        .hDropDown = 0
        .nWidth    = 0
        SetRectEmpty( @.rc )
    end with
    pBar->itemCount += 1
    pBar->Refresh()
    return idx
end function


public function PsMenuBar_GetItemCount( byval hMenuBar as HWND ) as long
    dim as PSMENUBAR_STATE ptr pBar = GetMenuBarPointer(hMenuBar)
    if pBar = null then return 0
    return pBar->itemCount
end function


public function PsMenuBar_GetItemText( byval hMenuBar as HWND, byval idx as long ) as ustring
    dim as PSMENUBAR_STATE ptr pBar = GetMenuBarPointer(hMenuBar)
    if pBar = null then return ""
    if pBar->IsValidItem(idx) = false then return ""
    dim as ustring wszText = pBar->items(idx).wszText
    return wszText
end function


function PsMenuBar_SetItemText( byval hMenuBar as HWND, byval idx as long, byval Text as ustring ) as boolean
    dim as PSMENUBAR_STATE ptr pBar = GetMenuBarPointer(hMenuBar)
    if pBar = null then return false
    if pBar->IsValidItem(idx) = false then return false
    pBar->items(idx).wszText = Text
    ' Text drives the item's width, so this needs a re-layout, not just a repaint.
    pBar->Refresh()
    return true
end function


' Attach a PsPopupMenu as item idx's dropdown. OWNERSHIP TRANSFERS: the bar destroys
' attached dropdowns when it is destroyed. Attaching over an existing dropdown
' destroys the old one; hPopup = 0 detaches without destroying.
public function PsMenuBar_SetDropDown( byval hMenuBar as HWND, byval idx as long, byval hPopup as HWND ) as boolean
    dim as PSMENUBAR_STATE ptr pBar = GetMenuBarPointer(hMenuBar)
    if pBar = null then return false
    if pBar->IsValidItem(idx) = false then return false
    dim as HWND hOld = pBar->items(idx).hDropDown
    if (hOld <> 0) andalso (hOld <> hPopup) then DestroyWindow( hOld )
    ' Our filter drives the dropdown from here on; its own filter would see the bar's clicks as
    ' outside clicks (the popup-row rule in PsRegistry). The row stays for the theme.
    if hPopup then PsRegistry_ClearFilter( hPopup )
    pBar->items(idx).hDropDown = hPopup
    return true
end function


public function PsMenuBar_GetDropDown( byval hMenuBar as HWND, byval idx as long ) as HWND
    dim as PSMENUBAR_STATE ptr pBar = GetMenuBarPointer(hMenuBar)
    if pBar = null then return 0
    if pBar->IsValidItem(idx) = false then return 0
    return pBar->items(idx).hDropDown
end function


public function PsMenuBar_GetItemRect( byval hMenuBar as HWND, byval idx as long, byref rc as RECT ) as boolean
    dim as PSMENUBAR_STATE ptr pBar = GetMenuBarPointer(hMenuBar)
    SetRectEmpty( @rc )
    if pBar = null then return false
    if pBar->IsValidItem(idx) = false then return false
    if pBar->bLayoutDirty then pBar->LayoutItems()
    rc = pBar->items(idx).rc
    return true
end function


' The right edge of the last item -- the width the items actually need. The host sizes
' the bar with this, or draws its own content in the leftover strip of a wider bar.
public function PsMenuBar_GetIdealWidth( byval hMenuBar as HWND ) as long
    dim as PSMENUBAR_STATE ptr pBar = GetMenuBarPointer(hMenuBar)
    if pBar = null then return 0
    if pBar->itemCount = 0 then return 0
    if pBar->bLayoutDirty then pBar->LayoutItems()
    if pBar->bLayoutDirty then return 0           ' no geometry yet
    return pBar->items(pBar->itemCount - 1).rc.right
end function


public function PsMenuBar_GetPadding( byval hMenuBar as HWND ) as long
    dim as PSMENUBAR_STATE ptr pBar = GetMenuBarPointer(hMenuBar)
    if pBar = null then return 0
    return pBar->nPadding
end function


sub PsMenuBar_SetPadding( byval hMenuBar as HWND, byval nPadding as long )
    dim as PSMENUBAR_STATE ptr pBar = GetMenuBarPointer(hMenuBar)
    if pBar = null then exit sub
    if nPadding < 0 then nPadding = 0
    pBar->nPadding = nPadding
    pBar->Refresh()
end sub


' The host's keyboard entry point (tiko's Alt+F accelerator): open item idx's dropdown,
' optionally selecting its first selectable row. SILENT beyond the InitPopup hooks.
public function PsMenuBar_OpenMenu( byval hMenuBar as HWND, byval idx as long, byval bSelectFirst as boolean = false ) as boolean
    return MB_OpenMenuAt( hMenuBar, idx, bSelectFirst )
end function


' Close any open dropdown chain AND clear the highlight. SILENT (programmatic) --
' also the host's instant-dismissal hook for WM_ACTIVATEAPP(FALSE).
public sub PsMenuBar_CloseMenu( byval hMenuBar as HWND )
    dim as PSMENUBAR_STATE ptr pBar = GetMenuBarPointer(hMenuBar)
    if pBar = null then exit sub
    if pBar->bMenuOpen then
        if pBar->IsValidItem(pBar->nActiveIdx) then
            dim as HWND hDrop = pBar->items(pBar->nActiveIdx).hDropDown
            if hDrop then PsPopupMenu_CloseChain( hDrop )
        end if
    end if
    pBar->bMenuOpen = false
    MB_SetActive( pBar, -1 )
end sub


public function PsMenuBar_IsMenuOpen( byval hMenuBar as HWND ) as boolean
    dim as PSMENUBAR_STATE ptr pBar = GetMenuBarPointer(hMenuBar)
    if pBar = null then return false
    return pBar->bMenuOpen
end function


public function PsMenuBar_GetActiveIndex( byval hMenuBar as HWND ) as long
    dim as PSMENUBAR_STATE ptr pBar = GetMenuBarPointer(hMenuBar)
    if pBar = null then return -1
    return pBar->nActiveIdx
end function


' Set the keyboard highlight WITHOUT opening a menu (-1 clears). What a host's bare
' Alt-press handler would call. SILENT.
public function PsMenuBar_SetActiveIndex( byval hMenuBar as HWND, byval idx as long ) as boolean
    dim as PSMENUBAR_STATE ptr pBar = GetMenuBarPointer(hMenuBar)
    if pBar = null then return false
    if (idx <> -1) andalso (pBar->IsValidItem(idx) = false) then return false
    MB_SetActive( pBar, idx )
    return true
end function


public sub PsMenuBar_SetColors( byval hMenuBar as HWND, byval pColors as PSMENUBAR_COLORS ptr )
    dim as PSMENUBAR_STATE ptr pBar = GetMenuBarPointer(hMenuBar)
    if pBar = null then exit sub
    if pColors = null then exit sub
    pBar->colors = *pColors               ' copied; the caller's struct stays theirs
    pBar->bColorsPinned = true
    if pBar->hWin then InvalidateRect( pBar->hWin, NULL, TRUE )
end sub

' ========================================================================================
' The theme (vendor/PsControls/PsTheme). ThemeColors is the adapter: the menu bar's colours
' derived from the theme's roles. ApplyTheme applies them unless the host pinned its own.
' ========================================================================================
public function PsMenuBar_ThemeColors( byref t as PSTHEME_COLORS ) as PSMENUBAR_COLORS
    dim as PSMENUBAR_COLORS c
    c.BackColor    = t.Window
    c.ForeColor    = t.Text
    c.BackColorHot = t.SurfaceHot
    c.ForeColorHot = t.TextHot
    return c
end function

public sub PsMenuBar_ApplyTheme( byval hMenuBar as HWND, byref t as PSTHEME_COLORS )
    dim as PSMENUBAR_STATE ptr pBar = GetMenuBarPointer(hMenuBar)
    if (pBar = 0) orelse pBar->bColorsPinned then exit sub
    dim as PSMENUBAR_COLORS c = PsMenuBar_ThemeColors( t )
    PsMenuBar_SetColors( hMenuBar, @c )
    pBar->bColorsPinned = false
end sub

' Hands the menu bar back to the theme, which is applied at once.
public sub PsMenuBar_UnpinColors( byval hMenuBar as HWND )
    dim as PSMENUBAR_STATE ptr pBar = GetMenuBarPointer(hMenuBar)
    if pBar = 0 then exit sub
    pBar->bColorsPinned = false
    dim as PSTHEME_COLORS t
    if PsRegistry_GetTheme( t ) then PsMenuBar_ApplyTheme( hMenuBar, t )
end sub

' The form's fonts (PsApp), handed over when the menu bar is created on a form.
public sub PsMenuBar_ApplyFonts( byval hMenuBar as HWND, byval hTextFont as HFONT, byval hGlyphFont as HFONT )
    if hTextFont then PsMenuBar_SetFont( hMenuBar, hTextFont )
end sub

' ========================================================================================
' Per-monitor DPI (RFC-0001 P4). The one stored pixel metric, nPadding -- the scaled Create
' default or whatever the host set since -- times newDpi/oldDpi; the item widths are a
' LayoutItems cache and are re-measured. The bar's own CWindow takes the new DPI so later
' ScaleX calls agree. The dropdowns are PsPopupMenus with their own registry rows and are
' rescaled by their own proc, not from here. The font is not ours: PsApp hands a new one
' over after this.
' ========================================================================================
public sub PsMenuBar_Rescale( byval hMenuBar as HWND, byval oldDpi as long, byval newDpi as long )
    dim as PSMENUBAR_STATE ptr pBar = GetMenuBarPointer(hMenuBar)
    if (pBar = 0) orelse (oldDpi <= 0) orelse (newDpi <= 0) orelse (oldDpi = newDpi) then exit sub
    pBar->nPadding = MulDiv( pBar->nPadding, newDpi, oldDpi )
    dim as CWindow ptr pWindow = CWindowPtr( hMenuBar )
    if pWindow then pWindow->DPI = newDpi
    pBar->Refresh()
end sub


public sub PsMenuBar_SetFont( byval hMenuBar as HWND, byval hBarFont as HFONT )
    dim as PSMENUBAR_STATE ptr pBar = GetMenuBarPointer(hMenuBar)
    if pBar = null then exit sub
    pBar->hBarFont = hBarFont
    ' The font is what item widths are measured with, so changing it re-lays out.
    pBar->Refresh()
end sub


public sub PsMenuBar_SetCommandCallback( byval hMenuBar as HWND, byval usersub as MB_CommandCallbackSub )
    dim as PSMENUBAR_STATE ptr pBar = GetMenuBarPointer(hMenuBar)
    if pBar = null then exit sub
    pBar->CommandCallback = usersub
end sub


public sub PsMenuBar_SetInitPopupCallback( byval hMenuBar as HWND, byval usersub as MB_InitPopupCallbackSub )
    dim as PSMENUBAR_STATE ptr pBar = GetMenuBarPointer(hMenuBar)
    if pBar = null then exit sub
    pBar->InitPopupCallback = usersub
end sub


sub PsMenuBar_SetPaintItemCallback( byval hMenuBar as HWND, byval usersub as MB_PaintItemCallbackSub )
    dim as PSMENUBAR_STATE ptr pBar = GetMenuBarPointer(hMenuBar)
    if pBar = null then exit sub
    pBar->PaintItemCallback = usersub
end sub


' ========================================================================================
' The message-pump filter for the whole menu system (see its declaration at the top of
' this file). Wraps the
' PsPopupMenu filter, adding the bar-boundary keyboard moves and the highlight-only
' keyboard mode.
' ========================================================================================
public function PsMenuBar_FilterMessage( byval hMenuBar as HWND, byval pMsg as MSG ptr ) as boolean
    dim as PSMENUBAR_STATE ptr pBar = GetMenuBarPointer(hMenuBar)
    if pBar = null then return false
    if pMsg = 0 then return false

    if pBar->bMenuOpen then
        dim as HWND hRoot = 0
        if pBar->IsValidItem(pBar->nActiveIdx) then hRoot = pBar->items(pBar->nActiveIdx).hDropDown
        if hRoot = 0 orelse (PsPopupMenu_IsOpen(hRoot) = false) then
            ' The chain closed behind our back (it always notifies, so this is a
            ' belt-and-braces resync, not an expected path).
            pBar->bMenuOpen = false
            return false
        end if

        ' Bar-boundary keys, pre-handled before delegating to the popup filter:
        ' Left at the root level / Right on a row without a submenu step between
        ' bar items (wrapping), with the first row selected -- classic menubar keys.
        if pMsg->message = WM_KEYDOWN then
            select case pMsg->wParam
            case VK_LEFT
                dim as HWND hInner = PM_InnermostHwnd( hRoot )
                if hInner = hRoot then
                    MB_OpenAdjacent( hMenuBar, -1 )
                    return true
                end if
            case VK_RIGHT
                dim as HWND hInner = PM_InnermostHwnd( hRoot )
                dim as PSPOPUPMENU_STATE ptr pInner = GetPopupMenuPointer( hInner )
                if pInner then
                    dim as long idx = pInner->nCurSel
                    dim as boolean bHasSub = false
                    if pInner->IsValidItem(idx) then
                        bHasSub = (pInner->items(idx).hSubMenu <> 0) andalso _
                                  (pInner->items(idx).isDisabled = false)
                    end if
                    if bHasSub = false then
                        MB_OpenAdjacent( hMenuBar, 1 )
                        return true
                    end if
                end if
            end select
        end if

        ' A click on the bar itself must reach the bar's own toggle handler, not be
        ' treated as an outside click.
        if (pMsg->message = WM_LBUTTONDOWN) andalso (pMsg->hwnd = pBar->hWin) then return false

        return PsPopupMenu_FilterMessage( hRoot, pMsg )
    end if

    ' Highlight-only mode: a bar item is highlighted (keyboard) with no dropdown open.
    if pBar->nActiveIdx <> -1 then
        select case pMsg->message
        case WM_KEYDOWN
            select case pMsg->wParam
            case VK_LEFT
                MB_MoveHighlight( pBar, -1 )
                return true
            case VK_RIGHT
                MB_MoveHighlight( pBar, 1 )
                return true
            case VK_DOWN, VK_RETURN
                MB_OpenMenuAt( hMenuBar, pBar->nActiveIdx, true )
                return true
            case VK_ESCAPE
                MB_SetActive( pBar, -1 )
                return true
            end select
        case WM_LBUTTONDOWN, WM_NCLBUTTONDOWN
            ' A click anywhere but the bar abandons the highlight; the click proceeds.
            if pMsg->hwnd <> pBar->hWin then MB_SetActive( pBar, -1 )
            return false
        end select
    end if

    return false
end function
