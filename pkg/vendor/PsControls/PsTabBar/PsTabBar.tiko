#module "PsTabBar"

#import "sys/win"
#import "sys/win/gui"
#import "sys/win/gdiplus"
#import "vendor/PsControls/PsBufferPaint"
#import "vendor/PsControls/PsTipHost"
#import "vendor/PsControls/PsRegistry"
#import "vendor/PsControls/PsTheme"

using gui
using gdiplus
using PsBufferPaint
using PsTipHost
using PsRegistry
using PsTheme

' The tooltip backend switch. The control ships on the SYSTEM (comctl32) backend exactly
' as it always has; a host opts an instance into PsTooltip with PsTabBar_SetTooltipMode.

' Polling timer that guarantees hot-tracking is cleared when the mouse leaves the
' control. WM_MOUSELEAVE (TME_LEAVE) is not reliably delivered on fast exits, so a
' periodic cursor check acts as a safety net. Timer IDs are per-window, so every
' instance can share this id.
public const IDT_CTABBAR_HOTTRACK = &hCB01
public const PSTABBAR_HOTTRACK_MS = 100


' Default horizontal inset applied to each side of a tab's text when measuring. The
' control DPI-scales this at Create; PsTabBar_SetPadding takes raw pixels thereafter.
public const PSTABBAR_DEFAULT_PADDING = 8

' Default side of the two square icon rects (left icon, right close icon) reserved in
' EVERY tab, used or not -- always reserving them is what keeps the caption at the same
' offset in every tab, and stops the close "X" shifting the text when it appears on
' hover. DPI-scaled at Create; PsTabBar_SetIconWidth takes raw pixels thereafter.
public const PSTABBAR_DEFAULT_ICONWIDTH = 20

' Cross-control navigation messages, for driving the bar from a SEPARATE control (the
' host's nav buttons) via SendMessage. Each is the message-shaped door to the plain
' function of the same name -- one implementation, two doors.
'   TCM_NAVIGATE:    wParam = -1 (left) / +1 (right). Returns the new first-visible index.
'   TCM_CANNAVIGATE: wParam = -1 / +1. Returns 1 if navigation that way would move, else 0
'                    (so a nav control can grey its buttons out).
public const TCM_NAVIGATE = (WM_USER + 100)
public const TCM_CANNAVIGATE = (WM_USER + 101)

' type and array to hold values related to the tab bar's tabs
' NOTE: "width" is a FreeBASIC reserved word (see C:\dev\Learnings.md) and produces errors
' that never name the real problem -- hence nMinWidth / nWidth throughout.
' NOTE: no isHot here. Hover is transient and single-valued, so the control's nLastHotIdx
' is the one source of truth; a per-tab copy would be a second one to keep in sync.
public type PSTABBAR_TABINFO
    Text      as ustring
    itemData  as integer         ' id to invoke if clicked on
    nMinWidth as integer = 0     ' floor for this tab's width; 0 = auto-size to text
    ' --- Everything below is DERIVED by LayoutTabs, never set from outside. A tab
    '     scrolled off the left holds EMPTY rects, not stale ones: hit-testing loops
    '     every tab, so a leftover rect would still answer hover and clicks. ---
    nWidth    as integer = 0     ' measured natural width (the no-shrink formula)
    rc        as RECT            ' full tab rect, client coordinates
    rcPaint   as RECT            ' rc deflated by the border -- the host paints in THIS
    rcText    as RECT            ' caption area between the icon rects (symmetric height)
    rcIcon    as RECT            ' left icon rect (file-type glyph etc.)
    rcClose   as RECT            ' right icon rect (the close "X"; hit-test target)
end type

public type PSTABBAR_PAINTINFO
    hTabBar         as HWND                   ' the control, so the callback can query it
    itemID          as integer                ' tab index (model index)
    b               as PsPaintBuffer ptr    ' the control's buffer for this repaint (no copy)
    ' --- Geometry, all precomputed by LayoutTabs. Never re-derive insets from rc. ---
    rc              as RECT                   ' the border-DEFLATED paint area: fill THIS.
                                              '   On the active tab it runs to the client
                                              '   bottom (your fill covers the gap where
                                              '   the control's bottom line breaks).
    rcText          as RECT                   ' caption area, rcIcon.right -> rcClose.left.
                                              '   Symmetric vertical extents, so DT_VCENTER
                                              '   text never moves when selection changes.
    rcIcon          as RECT                   ' left icon square (file-type glyph etc.)
    rcClose         as RECT                   ' right icon square (the close "X")
    ' --- State: the control decides these, you only render. ---
    isSelected      as boolean                ' this tab is the active tab
    isHot           as boolean                ' the mouse is over this tab
    isHotClose      as boolean                ' mouse is over the close icon. A tab can be
                                              '   both isHot and isHotClose: the "X" is
                                              '   inside the tab.
    isPressed       as boolean                ' a live left press is on this tab
    isDragging      as boolean                ' this tab is being drag-reordered (it is
                                              '   also isPressed; the tabs visibly moving
                                              '   ARE the drag feedback -- style this one
                                              '   so the eye can follow it)
    wszCaption      as ustring               ' the tab's Text
end type

public type PSTABBAR_MESSAGEINFO
    hTabBar        as HWND
    uMsg            as UINT
    wParam          as WPARAM
    lParam          as LPARAM
    idx             as integer    ' tab index under the mouse (-1 if none)
end type


' Draw one tab. Called for each tab touched by the repaint; keep it cheap. Paint through
' p->b (the control's double buffer for this repaint) -- do not touch the screen DC.
' Fill p->rc, caption in p->rcText, glyphs in p->rcIcon / p->rcClose. Style from the
' state flags; the control decides them, you only render. No callback = no tabs drawn
' (the control still paints its background and chrome).
'
' Two contracts worth honoring, or the layout will not match what you draw:
'   - Draw with the SAME font you handed to PsTabBar_SetFont. The control measured the
'     tab widths with it; a different font means the widths lie.
'   - Use the rects as handed to you instead of re-deriving insets from p->rc -- they
'     are exactly the space the measured width accounts for, and their vertical extents
'     encode the never-moves-on-selection rule.
'
' The control draws its own chrome AFTER the callbacks (the bottom line, broken under
' the active tab, and the active tab's 3-sided border), so chrome is authoritative no
' matter what a callback paints.
public type TB_PaintCallbackSub as sub( byval p as PSTABBAR_PAINTINFO ptr )

' Observe mouse messages. Return TRUE if you handled it and want the control's default
' handling suppressed, FALSE to let it proceed.
'
' CAUTION: the result is honored for every message EXCEPT WM_LBUTTONUP and WM_MBUTTONUP,
' where it is IGNORED. The control holds mouse capture across a press (unlike PsStatusBar,
' and deliberately -- the close-X cancel semantics and Phase 5's drag both consume the
' guaranteed down->up pairing), and the up-message is what releases it: a callback that
' suppressed it would strand capture and route every subsequent click to this control
' (the PsListBox bug recorded in Learnings.md). Suppressing WM_LBUTTONDOWN suppresses
' selection and the press, never the capture bookkeeping.
public type TB_MessageCallbackFunc as function( byval m as PSTABBAR_MESSAGEINFO ptr ) as boolean

' Supply the tooltip text for a tab, on demand (only when a tip is about to show).
' Return "" for no tooltip. If unset, the tab's own Text is used.
public type TB_TooltipCallbackFunc as function( byval hTabBar as HWND, byval idx as integer ) as ustring

' The active tab changed through USER interaction (click, middle of a gesture the
' control owns). Fired AFTER the control's state is updated, so GetCurSel() = idxNew.
' Programmatic SetCurSel does NOT fire this -- only the user does (Win32's
' TCM_SETCURSEL / TCN_SELCHANGE precedent), which also makes it safe to call SetCurSel
' from inside the handler without recursing.
public type TB_SelChangeCallbackSub as sub( byval hTabBar as HWND, byval idxOld as integer, byval idxNew as integer )

' The user asked to close a tab: a matched press+release on its close "X", or a matched
' middle-click anywhere on it. NOTIFY-ONLY -- the control deletes nothing. The host
' decides: prompt to save, veto by doing nothing, or call PsTabBar_DeleteTab itself.
public type TB_CloseCallbackSub as sub( byval hTabBar as HWND, byval idx as integer )

' A drag reordered a tab: fired once PER MOVE, after the control's array and stored
' indices are already updated. Reordering is LIVE (each midpoint crossing moves the tab
' immediately), so one drag can fire several of these -- mirror each (idxFrom, idxTo)
' move into your model as it arrives and the two stay in sync. Unlike close there is
' nothing to veto: a move destroys nothing, so the control reorders itself and tells
' you after. Programmatic PsTabBar_MoveTab does NOT fire this (the SetCurSel rule:
' programmatic is silent, only the user speaks).
public type TB_ReorderCallbackSub as sub( byval hTabBar as HWND, byval idxFrom as integer, byval idxTo as integer )

public type PSTABBAR_STATE
    hWin            as HWND
    ' TRUE once the host set the colours itself (PsTabBar_SetBackColor/SetBorderColor): the theme
    ' then leaves this tab bar alone until PsTabBar_UnpinColors.
    bColorsPinned   as boolean
    ' The tooltip, whichever backend it is on. Replaces the old hToolTip + HoverTime
    ' pair; PsTabBar_GetTooltipHandle still answers the comctl32 handle, and 0 while
    ' this instance is on PsTooltip.
    tip       as PSTIPHOST_STATE
    wszTooltip      as ustring
    tabs(any)       as PSTABBAR_TABINFO
    tabCount        as integer = 0
    idc_TabBar     as integer = 2000
    HoverTime       as integer = 250
    nLastHotIdx     as integer = -1       ' tab the mouse was last over (hover tracking)
    ' Second single-valued hover fact, kept beside nLastHotIdx for the same reason isHot
    ' is not a TABINFO field: one source of truth. A tab is both isHot and isHotClose
    ' when the cursor is over its "X" -- the X is inside the tab.
    bLastHotClose   as boolean = false    ' hover is over the hot tab's close rect
    hotTimerOn      as boolean = false    ' is the hot-tracking safety-net timer running?
    ' --- Press state (mouse capture). The control TAKES capture on a press -- unlike
    '     PsStatusBar, and deliberately: the close-X cancel semantics (press the X, slide
    '     off, release, nothing happens) and Phase 5's drag both consume the guaranteed
    '     down->up pairing. It pays PsVScrollBar's full price: release on the up-message
    '     unconditionally, WM_CAPTURECHANGED cancels the press, WM_DESTROY releases,
    '     and no callback may suppress an up-message. Any tab mutation cancels a live
    '     press -- the gesture's target is gone. ---
    nPressedIdx     as integer = -1       ' tab under a live left press, or -1
    bPressedClose   as boolean = false    ' that press started on the close "X"
    nPressedMidIdx  as integer = -1       ' tab under a live middle press, or -1
    ' --- Drag-to-reorder. A left press (not on the "X") that travels past the system
    '     drag threshold becomes a drag; thereafter the tabs EXCHANGE the moment the
    '     pointer crosses into an adjacent tab, gated on the direction of travel
    '     (live reordering -- the moving tabs are the drag visual).
    '     While dragging, HOVER IS PINNED to the dragged tab (tracking suspends, the
    '     clear paths stand down): the dragged tab keeps isHot -- and so its "X" --
    '     for the whole gesture, and a tab being dragged over can never light up or
    '     grow an X of its own. Normal tracking resumes on the first move after drop.
    '     No ESC cancel: the control never takes focus, so it never sees keyboard
    '     messages, and with live reordering every intermediate order is already a
    '     legitimate, notified state. Capture loss simply ends the drag the same way. ---
    bDragging       as boolean = false    ' the live press became a drag
    ptPress         as POINT              ' client coords of the press (threshold test)
    nLastDragX      as integer = 0        ' previous drag x: the direction-of-travel gate
    ' The cursor shown for the whole gesture (IDC_SIZEALL, loaded at Create -- a shared
    ' system cursor, so it is never destroyed). PsSplitter's hBarCursor shape: a field
    ' rather than a LoadCursor per message. Zero means "leave the cursor alone".
    hDragCursor     as HCURSOR
    BackColor       as COLORREF
    ' Caller-supplied font (caller owns it). NOT named hFont: FreeBASIC is case-insensitive,
    ' so a member called hFont would shadow the TYPE name HFONT inside every member
    ' procedure of this type, and "dim as HFONT x" there fails with a misleading
    ' "error 14: Expected identifier, found 'HFONT'". See C:\dev\Learnings.md.
    hTabFont      as HFONT
    PaintCallback     as TB_PaintCallbackSub
    MessageCallback   as TB_MessageCallbackFunc
    TooltipCallback   as TB_TooltipCallbackFunc    ' optional; defaults to the tab's Text
    SelChangeCallback as TB_SelChangeCallbackSub   ' optional; user-driven changes only
    CloseCallback     as TB_CloseCallbackSub       ' optional; notify-only, host deletes
    ReorderCallback   as TB_ReorderCallbackSub     ' optional; one per live move
    ' --- Layout. tab rects are derived, never set from outside; LayoutTabs() owns them.
    '     Layout is lazy: mutators mark it dirty, the next paint (or any rect query) runs it,
    '     which coalesces a burst of SetText calls into one measuring pass. ---
    nPadding        as integer = PSTABBAR_DEFAULT_PADDING     ' DPI-scaled at Create
    nIconWidth      as integer = PSTABBAR_DEFAULT_ICONWIDTH   ' DPI-scaled at Create
    nBorderWidth    as integer = 1                           ' DPI-scaled at Create
    BorderColor     as COLORREF                              ' bottom line + active tab border
    bLayoutDirty    as boolean = true
    ' --- Selection and scroll position. Stored indices: every insert/delete must fix
    '     them up, and layout clamps nFirstVisible (you cannot scroll into empty space). ---
    nCurSel         as integer = -1       ' the active tab, or -1 for none
    nFirstVisible   as integer = 0        ' leftmost drawn tab (listbox-style top index)
    bEnsureVisible  as boolean = false    ' scroll nCurSel into view on the next layout

    declare sub      LayoutTabs()
    declare sub      MoveTab( byval idxFrom as integer, byval idxTo as integer )
    declare function GetCount() as integer                                  ' tab count
    declare function InsertTabAt( byval idx as integer ) as PSTABBAR_TABINFO ptr
    declare function AddTab() as PSTABBAR_TABINFO ptr                       ' append
    declare function GetTab( byval idx as integer ) as PSTABBAR_TABINFO ptr
    declare function DeleteTabAt( byval idx as integer ) as boolean
    declare function IsValidTab( byval idx as integer ) as boolean
    declare sub      Clear()
    declare sub      Refresh()
end type

' Measure every tab and assign its rects. This is the only place tab geometry is
' produced; everything else (hit-testing, painting, invalidation) consumes it.
'
'   width = max( text width + 2*icon width + 2*padding + 2*border, nMinWidth )
'
' Tabs NEVER shrink: a tab is always at least as wide as its own text plus its two
' always-reserved icon rects. When the tabs no longer fit, the rightmost simply clips at
' the client edge -- navigation (nFirstVisible, driven by a separate host control) is the
' escape valve, not squeezing. Rects that run past the edge are computed honestly rather
' than squeezed: clipping is the paint pass's job, and the cursor can't reach past the
' edge anyway, so hit-testing stays correct for free.
'
' Tabs scrolled off the left (i < nFirstVisible) get EMPTY rects, not stale ones:
' hit-testing loops every tab, so a leftover rect would still answer hover and clicks.
'
' rcPaint is rc deflated by the border the control draws (Phase 3), and the deflation is
' deliberately ASYMMETRIC:
'   - left/top/right on EVERY tab: reserving space a border MAY occupy is what stops the
'     caption jumping sideways the moment a tab is selected (same argument as the
'     always-reserved icon rects).
'   - bottom on INACTIVE tabs only: the active tab's rcPaint runs to the client bottom,
'     because its own fill is what covers the gap where the full-width bottom line
'     breaks. Deflate it and a 1px background strip destroys the merge-with-content look.
' The icon rects are v-centred on the SYMMETRICALLY deflated height, so they (and any
' text aligned to them) sit at identical offsets whether or not the tab is selected.
sub PSTABBAR_STATE.LayoutTabs()
    this.bLayoutDirty = false
    if this.hWin = 0 then exit sub
    if this.tabCount = 0 then exit sub

    dim as RECT rcClient
    GetClientRect( this.hWin, @rcClient )
    dim as integer clientW = rcClient.right - rcClient.left
    dim as integer clientH = rcClient.bottom - rcClient.top
    ' No geometry yet (created 0x0, sized only once the host shows us). Nothing to lay out,
    ' and bLayoutDirty stays consumed only because WM_SIZE will mark it again.
    if (clientW <= 0) orelse (clientH <= 0) then
        this.bLayoutDirty = true
        exit sub
    end if

    dim as HDC hDC = GetDC( this.hWin )
    if hDC = 0 then
        this.bLayoutDirty = true          ' couldn't measure; try again next paint
        exit sub
    end if

    ' Measure with a deterministic font: the caller's if set, else the stock GUI font --
    ' never "whatever the DC happens to hold". Stock objects must not be deleted.
    dim as HFONT hFontUse = this.hTabFont
    if hFontUse = 0 then hFontUse = cast( HFONT, GetStockObject( DEFAULT_GUI_FONT ) )
    dim as HFONT hOldFont = SelectObject( hDC, hFontUse )

    for i as integer = 0 to this.tabCount - 1
        dim as integer textW = 0
        dim as integer nChars = len( this.tabs(i).Text )
        if nChars > 0 then
            dim as SIZE sz
            if GetTextExtentPoint32W( hDC, this.tabs(i).Text, nChars, @sz ) then
                textW = sz.cx
            end if
        end if
        ' The border is part of the spend: rcPaint is deflated by it on both sides, so a
        ' width that omits it clips the last 2*bw pixels of every caption (found by
        ' screenshot in Phase 3 -- the geometry trace matched the formula, but the
        ' formula was short).
        dim as integer nW = textW + (this.nIconWidth * 2) + (this.nPadding * 2) + (this.nBorderWidth * 2)
        if nW < this.tabs(i).nMinWidth then nW = this.tabs(i).nMinWidth
        this.tabs(i).nWidth = nW
    next

    SelectObject( hDC, hOldFont )
    ReleaseDC( this.hWin, hDC )

    ' Clamp the scroll position: stored index, so deletes can leave it past the end,
    ' and you cannot scroll into empty space.
    if this.nFirstVisible < 0 then this.nFirstVisible = 0
    if this.nFirstVisible > this.tabCount - 1 then this.nFirstVisible = this.tabCount - 1

    ' Scroll-into-view, requested by SetCurSel and consumed HERE, because this is where
    ' measured widths exist (SetCurSel may run before the control is even sized).
    if this.bEnsureVisible then
        this.bEnsureVisible = false
        if this.IsValidTab( this.nCurSel ) then
            if this.nCurSel < this.nFirstVisible then
                this.nFirstVisible = this.nCurSel
            else
                ' Find the smallest first-visible >= current such that the selected
                ' tab's right edge fits. If the tab alone is wider than the client,
                ' show it from its own left edge -- its right will clip, honestly.
                dim as integer totalW = 0
                for i as integer = this.nCurSel to this.nFirstVisible step -1
                    totalW += this.tabs(i).nWidth
                    if totalW > clientW then
                        this.nFirstVisible = i + 1
                        if this.nFirstVisible > this.nCurSel then this.nFirstVisible = this.nCurSel
                        exit for
                    end if
                next
            end if
        end if
    end if

    ' Back-fill: when the whole tail [nFirstVisible..end] fits the client with enough
    ' slack to also hold the previous tab, pull earlier tabs into view. Without this a
    ' delete (or a widening resize) leaves dead space on the right while tabs sit
    ' hidden to the left -- a listbox clamps its top index the same way. Runs after
    ' ensure-visible: it only ever reduces nFirstVisible while keeping the full tail
    ' (nCurSel included) visible, so the two never fight.
    dim as integer tailW = 0
    for i as integer = this.nFirstVisible to this.tabCount - 1
        tailW += this.tabs(i).nWidth
    next
    while (this.nFirstVisible > 0) andalso _
          (tailW + this.tabs(this.nFirstVisible - 1).nWidth <= clientW)
        this.nFirstVisible -= 1
        tailW += this.tabs(this.nFirstVisible).nWidth
    wend

    ' Position left-to-right from nFirstVisible; every tab spans the full client height.
    dim as integer x = rcClient.left
    for i as integer = 0 to this.tabCount - 1
        if i < this.nFirstVisible then
            SetRectEmpty( @this.tabs(i).rc )
            SetRectEmpty( @this.tabs(i).rcPaint )
            SetRectEmpty( @this.tabs(i).rcText )
            SetRectEmpty( @this.tabs(i).rcIcon )
            SetRectEmpty( @this.tabs(i).rcClose )
            continue for
        end if

        SetRect( @this.tabs(i).rc, x, rcClient.top, x + this.tabs(i).nWidth, rcClient.bottom )

        ' rcPaint: the asymmetric deflation (see the declarations at the top of this file).
        dim as RECT rp = this.tabs(i).rc
        rp.left   += this.nBorderWidth
        rp.top    += this.nBorderWidth
        rp.right  -= this.nBorderWidth
        if i <> this.nCurSel then rp.bottom -= this.nBorderWidth
        this.tabs(i).rcPaint = rp

        ' Icon rects: v-centred on the symmetric height so they never move with selection.
        dim as integer cyMid   = ( (this.tabs(i).rc.top + this.nBorderWidth) + _
                                   (this.tabs(i).rc.bottom - this.nBorderWidth) ) \ 2
        dim as integer iconTop = cyMid - (this.nIconWidth \ 2)
        SetRect( @this.tabs(i).rcIcon, _
                 rp.left + this.nPadding, iconTop, _
                 rp.left + this.nPadding + this.nIconWidth, iconTop + this.nIconWidth )
        SetRect( @this.tabs(i).rcClose, _
                 rp.right - this.nPadding - this.nIconWidth, iconTop, _
                 rp.right - this.nPadding, iconTop + this.nIconWidth )

        ' Caption area: between the icon rects, on the same symmetric vertical extents,
        ' so DT_VCENTER text obeys the same never-moves-on-selection rule as the icons.
        SetRect( @this.tabs(i).rcText, _
                 this.tabs(i).rcIcon.right, this.tabs(i).rc.top + this.nBorderWidth, _
                 this.tabs(i).rcClose.left, this.tabs(i).rc.bottom - this.nBorderWidth )

        x += this.tabs(i).nWidth
    next
end sub

function PSTABBAR_STATE.GetCount() as integer
    return this.tabCount
end function

function PSTABBAR_STATE.IsValidTab( byval idx as integer ) as boolean
    return (idx >= 0) andalso (idx < this.tabCount)
end function

function PSTABBAR_STATE.GetTab( byval idx as integer ) as PSTABBAR_TABINFO ptr
    if this.IsValidTab(idx) = false then return null
    return @this.tabs(idx)
end function

' Insert a fresh (reset) tab at idx, shifting later tabs right. Grows the
' backing store by doubling so bulk inserts are amortized O(1), not O(n^2).
function PSTABBAR_STATE.InsertTabAt( byval idx as integer ) as PSTABBAR_TABINFO ptr
    if idx < 0 then idx = 0
    if idx > this.tabCount then idx = this.tabCount

    dim as integer cap = ubound(this.tabs) + 1
    if this.tabCount >= cap then
        dim as integer newcap = iif( cap = 0, 16, cap * 2 )
        redim preserve this.tabs( 0 to newcap - 1 )
    end if

    ' shift [idx .. tabCount-1] right by one (no-op when appending)
    for i as integer = this.tabCount to idx + 1 step -1
        this.tabs(i) = this.tabs(i - 1)
    next

    ' reset the new slot (frees any ustring left in a recycled capacity slot)
    with this.tabs(idx)
        .Text       = ""
        .itemData   = 0
        .nMinWidth  = 0
        .nWidth     = 0
        SetRectEmpty( @.rc )
        SetRectEmpty( @.rcPaint )
        SetRectEmpty( @.rcText )
        SetRectEmpty( @.rcIcon )
        SetRectEmpty( @.rcClose )
    end with

    this.tabCount += 1

    ' Stored indices follow the shift. The tabCount > 1 guard keeps the very first tab
    ' from bumping nFirstVisible off it (0 <= 0 would fire). nCurSel = -1 can never
    ' fire its guard, since idx >= 0. Note: adding a tab does NOT select it -- the host
    ' decides what is current, always.
    if (this.tabCount > 1) andalso (idx <= this.nFirstVisible) then this.nFirstVisible += 1
    if idx <= this.nCurSel then this.nCurSel += 1

    ' A mutation mid-press invalidates the gesture: the pressed slot no longer means
    ' what the finger meant.
    this.nPressedIdx = -1
    this.bPressedClose = false
    this.nPressedMidIdx = -1
    this.bDragging = false

    this.Refresh()
    return @this.tabs(idx)
end function

function PSTABBAR_STATE.AddTab() as PSTABBAR_TABINFO ptr
    return this.InsertTabAt( this.tabCount )
end function

function PSTABBAR_STATE.DeleteTabAt( byval idx as integer ) as boolean
    if this.IsValidTab(idx) = false then return false
    ' shift [idx+1 .. tabCount-1] down by one
    for i as integer = idx to this.tabCount - 2
        this.tabs(i) = this.tabs(i + 1)
    next
    this.tabs(this.tabCount - 1).Text = ""   ' free the vacated last slot's string
    this.tabCount -= 1
    ' A hot index can likewise be left dangling past the end.
    if this.nLastHotIdx >= this.tabCount then this.nLastHotIdx = -1
    ' Stored indices follow the shift; layout re-clamps nFirstVisible.
    if idx < this.nFirstVisible then this.nFirstVisible -= 1
    ' Deleting the selected tab leaves NOTHING selected: the control never guesses
    ' which document the host wants next (the notify-only philosophy, applied here).
    if idx = this.nCurSel then
        this.nCurSel = -1
    elseif idx < this.nCurSel then
        this.nCurSel -= 1
    end if
    ' A mutation mid-press invalidates the gesture (see InsertTabAt).
    this.nPressedIdx = -1
    this.bPressedClose = false
    this.nPressedMidIdx = -1
    this.bDragging = false
    this.Refresh()
    return true
end function

' Move one tab to another slot, remapping every stored index the way the slots moved.
' This is the THIRD index-fixup site (after insert and delete) -- the same bug class,
' worth the same care:
'   i = idxFrom          -> idxTo
'   idxFrom < i <= idxTo -> i - 1   (move right)
'   idxTo <= i < idxFrom -> i + 1   (move left)
' nCurSel and nLastHotIdx follow the DOCUMENT (the selection/hover is on a tab, and the
' tab moved). nFirstVisible deliberately does NOT: scroll position is a viewport concept,
' and a drag only ever touches visible tabs (hidden ones hold empty rects the cursor
' cannot hit), so every index the move remaps is >= nFirstVisible already -- following
' the dragged tab would instead scroll the bar as a side effect of dragging its first
' visible tab, hiding the tabs that just slid into its place.
sub PSTABBAR_STATE.MoveTab( byval idxFrom as integer, byval idxTo as integer )
    if this.IsValidTab(idxFrom) = false then exit sub
    if this.IsValidTab(idxTo) = false then exit sub
    if idxFrom = idxTo then exit sub

    dim as PSTABBAR_TABINFO tmp = this.tabs(idxFrom)
    if idxTo > idxFrom then
        for i as integer = idxFrom to idxTo - 1
            this.tabs(i) = this.tabs(i + 1)
        next
    else
        for i as integer = idxFrom to idxTo + 1 step -1
            this.tabs(i) = this.tabs(i - 1)
        next
    end if
    this.tabs(idxTo) = tmp

    dim as integer lo = iif( idxFrom < idxTo, idxFrom, idxTo )
    dim as integer hi = iif( idxFrom < idxTo, idxTo, idxFrom )
    dim as integer nShift = iif( idxTo > idxFrom, -1, 1 )

    if this.nCurSel = idxFrom then
        this.nCurSel = idxTo
    elseif (this.nCurSel >= lo) andalso (this.nCurSel <= hi) then
        this.nCurSel += nShift
    end if

    if this.nLastHotIdx = idxFrom then
        this.nLastHotIdx = idxTo
    elseif (this.nLastHotIdx >= lo) andalso (this.nLastHotIdx <= hi) then
        this.nLastHotIdx += nShift
    end if

    this.Refresh()
end sub

sub PSTABBAR_STATE.Clear()
    for i as integer = 0 to this.tabCount - 1
        this.tabs(i).Text = ""
    next
    this.tabCount  = 0
    this.nLastHotIdx = -1
    this.bLastHotClose = false
    this.nCurSel = -1
    this.nFirstVisible = 0
    this.bEnsureVisible = false
    this.nPressedIdx = -1
    this.bPressedClose = false
    this.nPressedMidIdx = -1
    this.bDragging = false
    this.Refresh()
end sub

' Mark the layout stale and request a repaint. Every mutator routes through here, which is
' what makes layout lazy: a burst of SetText calls costs one measuring pass, not N.
sub PSTABBAR_STATE.Refresh()
    this.bLayoutDirty = true
    ' Repaint WITH background erase so a region vacated by a shrinking tab is cleared.
    if this.hWin then InvalidateRect( this.hWin, NULL, TRUE )
end sub


' ========================================================================================
' PUBLIC API
' ========================================================================================
'
' A TAB BAR, NOT A TAB CONTAINER
'   The control never shows, hides, creates or owns tab pages. It reports what was
'   selected (SelChangeCallback), what the user wants closed (CloseCallback -- notify
'   only, nothing is deleted), and how tabs were dragged (ReorderCallback). The host
'   owns everything below the bar.
'
' THE CONTROL HANDLE
'   Every PsTabBar_* function takes the handle returned by PsTabBar_Create().
'
'   The handle is a real HWND on purpose (not an opaque type): callers legitimately need
'   to treat the control as a window, e.g. SetWindowPos() to place and size it. An opaque
'   wrapper would buy a little type-safety and break that, so it was rejected.
'
' LIFETIME
'   The control frees itself when its window is destroyed. Fonts you pass in stay yours.
'
' ----------------------------------------------------------------------------------------
' Creation
'   CtrlID becomes the control window's id (GWLP_ID). There are no child controls.
'   The control is created zero-sized: position it with SetWindowPos().
' ----------------------------------------------------------------------------------------
public declare function PsTabBar_Create( byval hWndParent as HWND, byval CtrlID as integer ) as HWND

' ----------------------------------------------------------------------------------------
' Adding / removing / moving tabs.  Add* and Insert* return the new tab's index, or -1.
'   MoveTab reorders programmatically with the same index remapping a drag performs
'   (selection and hover follow the moved tab; the scroll position stays put). Like
'   SetCurSel it is SILENT -- the reorder callback fires only for user drags.
' ----------------------------------------------------------------------------------------
public declare function PsTabBar_AddTab( byval hTabBar as HWND, byval Text as ustring, byval itemData as integer = 0 ) as integer
public declare function PsTabBar_IsValidTab( byval hTabBar as HWND, byval idx as integer ) as boolean
public declare function PsTabBar_InsertTab( byval hTabBar as HWND, byval idx as integer, byval Text as ustring, byval itemData as integer = 0 ) as integer
public declare function PsTabBar_DeleteTab( byval hTabBar as HWND, byval idx as integer ) as boolean
public declare function PsTabBar_MoveTab( byval hTabBar as HWND, byval idxFrom as integer, byval idxTo as integer ) as boolean
public declare sub      PsTabBar_Clear( byval hTabBar as HWND )
public declare sub      PsTabBar_Refresh( byval hTabBar as HWND )

' ----------------------------------------------------------------------------------------
' Counts.  GetCount = every tab in the control.
' ----------------------------------------------------------------------------------------
public declare function PsTabBar_GetCount( byval hTabBar as HWND ) as integer

' ----------------------------------------------------------------------------------------
' tab contents.  Set* return FALSE for an invalid tab index.
' ----------------------------------------------------------------------------------------
public declare function PsTabBar_GetText( byval hTabBar as HWND, byval idx as integer ) as ustring
public declare function PsTabBar_SetText( byval hTabBar as HWND, byval idx as integer, byval Text as ustring ) as boolean
public declare function PsTabBar_GetItemData( byval hTabBar as HWND, byval idx as integer ) as integer
public declare function PsTabBar_SetItemData( byval hTabBar as HWND, byval idx as integer, byval itemData as integer ) as boolean

' ----------------------------------------------------------------------------------------
' Layout.
'
'   A tab is always at least as wide as its text plus its two icon rects and its border,
'   and NEVER shrinks:
'       width = max( text width + 2*icon width + 2*padding + 2*border, nMinWidth )
'
'   nMinWidth defaults to 0, so tabs auto-size. Set a floor on a tab that would otherwise
'   be uncomfortably narrow for its own text (a one-character filename), or on one that
'   must not resize as its text changes and shove its neighbours along.
'
'   When the tabs stop fitting, the rightmost clips at the client edge -- nothing shrinks.
'   Rects that run past the edge are computed honestly; clipping is the paint pass's job.
'   (A consequence worth knowing: a partially visible rightmost tab is clickable, but its
'   close rect can sit past the client edge and be unreachable. Documented, not fixed.)
'
'   Both icon rects (left icon, right close "X") are ALWAYS reserved, used or not, so the
'   caption sits at the same offset in every tab and never shifts when the "X" appears on
'   hover. Padding and icon width are LAYOUT inputs: draw your text between rcIcon.right
'   and rcClose.left (see GetTabParts) rather than re-deriving insets.
'
'   Rects are computed lazily. GetTabRect / GetTabParts force a layout if one is pending,
'   so they are always current. GetTabRect returns the FULL tab rect; GetTabParts returns
'   the derived interior rects (rcPaint pre-deflated by the border, rcText between the
'   icon rects, rcIcon, rcClose) -- the same rects the paint callback receives.
' ----------------------------------------------------------------------------------------
public declare function PsTabBar_GetTabMinWidth( byval hTabBar as HWND, byval idx as integer ) as integer
public declare function PsTabBar_SetTabMinWidth( byval hTabBar as HWND, byval idx as integer, byval nMinWidth as integer ) as boolean
public declare function PsTabBar_GetPadding( byval hTabBar as HWND ) as integer
public declare sub      PsTabBar_SetPadding( byval hTabBar as HWND, byval nPadding as integer )
public declare function PsTabBar_GetIconWidth( byval hTabBar as HWND ) as integer
public declare sub      PsTabBar_SetIconWidth( byval hTabBar as HWND, byval nIconWidth as integer )
public declare function PsTabBar_GetTabRect( byval hTabBar as HWND, byval idx as integer, byref rc as RECT ) as boolean
public declare function PsTabBar_GetTabParts( byval hTabBar as HWND, byval idx as integer, byref rcPaint as RECT, byref rcText as RECT, byref rcIcon as RECT, byref rcClose as RECT ) as boolean

' ----------------------------------------------------------------------------------------
' Selection.  The control owns the current tab (a tab bar has one; a statusbar had none).
'
'   SetCurSel accepts -1 to clear. A valid index is scrolled into view on the next layout
'   (so tiko opening a file never selects a tab the user cannot see). Programmatic
'   SetCurSel does NOT fire the selection-change notification (Phase 4) -- only user
'   interaction does, following Win32's TCM_SETCURSEL / TCN_SELCHANGE precedent; this also
'   stops a host calling SetCurSel from inside its own handler from recursing.
'
'   Deleting the selected tab clears the selection: the control never guesses which
'   document the host wants next. Adding a tab does not select it, for the same reason.
' ----------------------------------------------------------------------------------------
public declare function PsTabBar_GetCurSel( byval hTabBar as HWND ) as integer
public declare function PsTabBar_SetCurSel( byval hTabBar as HWND, byval idx as integer ) as boolean

' ----------------------------------------------------------------------------------------
' Navigation.  nFirstVisible is a listbox-style top index: whole tabs, never half-drawn
' at the left edge. Navigate steps it by one tab; CanNavigate says whether a step that
' way would move (left: not already at 0; right: the last tab still clips), so a nav
' control can grey its buttons out. A no-op Navigate is harmless and returns the current
' index. TCM_NAVIGATE / TCM_CANNAVIGATE (top of file) are the SendMessage doors to these
' same functions, for driving the bar from a separate control.
' ----------------------------------------------------------------------------------------
public declare function PsTabBar_GetFirstVisible( byval hTabBar as HWND ) as integer
public declare function PsTabBar_SetFirstVisible( byval hTabBar as HWND, byval idx as integer ) as boolean
public declare function PsTabBar_Navigate( byval hTabBar as HWND, byval nDirection as integer ) as integer
public declare function PsTabBar_CanNavigate( byval hTabBar as HWND, byval nDirection as integer ) as boolean

' ----------------------------------------------------------------------------------------
' Appearance.  The font is borrowed, never owned: keep it alive and destroy it yourself.
'
'   BorderColor/BorderWidth style the chrome the CONTROL draws (Phase 3): the full-width
'   bottom line, broken under the active tab, and the active tab's 3-sided border. The
'   border width is also a LAYOUT input -- it is what rcPaint is deflated by.
' ----------------------------------------------------------------------------------------
public declare function PsTabBar_GetBackColor( byval hTabBar as HWND ) as COLORREF
public declare function PsTabBar_SetBackColor( byval hTabBar as HWND, byval clr as COLORREF ) as COLORREF
public declare function PsTabBar_GetBorderColor( byval hTabBar as HWND ) as COLORREF
public declare function PsTabBar_SetBorderColor( byval hTabBar as HWND, byval clr as COLORREF ) as COLORREF
public declare sub      PsTabBar_ApplyTheme( byval hTabBar as HWND, byref t as PSTHEME_COLORS )
public declare sub      PsTabBar_UnpinColors( byval hTabBar as HWND )
public declare sub      PsTabBar_ApplyFonts( byval hTabBar as HWND, byval hTextFont as HFONT, byval hGlyphFont as HFONT )
public declare sub      PsTabBar_Rescale( byval hTabBar as HWND, byval oldDpi as long, byval newDpi as long )
public declare function PsTabBar_GetBorderWidth( byval hTabBar as HWND ) as integer
public declare sub      PsTabBar_SetBorderWidth( byval hTabBar as HWND, byval nBorderWidth as integer )
public declare function PsTabBar_GetFont( byval hTabBar as HWND ) as HFONT
public declare function PsTabBar_SetFont( byval hTabBar as HWND, byval hFont as HFONT ) as boolean
public declare sub      PsTabBar_SetHoverTime( byval hTabBar as HWND, byval milliseconds as integer )
public declare function PsTabBar_GetTooltipHandle( byval hTabBar as HWND ) as HWND
public declare function PsTabBar_SetTooltipMode( byval hTabBar as HWND, byval nMode as long ) as boolean
public declare function PsTabBar_GetTooltipMode( byval hTabBar as HWND ) as long
' The PsTooltip window, or 0 on the system backend. The door to PsTooltip's own
' SetColors/SetFonts/SetStyle/SetMaxWidth/SetTitle/SetGlyph -- deliberately not mirrored
' here, since thirteen controls x twenty setters is 260 wrappers to keep in step.
public declare function PsTabBar_GetPsTooltipHandle( byval hTabBar as HWND ) as HWND
' Honoured by BOTH backends. A delay never set keeps the backend's own derivation from
' the system double-click time.
public declare sub      PsTabBar_SetAutoPopTime( byval hTabBar as HWND, byval milliseconds as long )
public declare sub      PsTabBar_SetReshowTime( byval hTabBar as HWND, byval milliseconds as long )

' ----------------------------------------------------------------------------------------
' Callbacks.  See the type declarations above for each signature and contract.
'   PaintCallback     - draw one tab. Required if you want to see any tabs (the control
'                       still paints its own background and chrome without one).
'   MessageCallback   - observe mouse messages; return TRUE to suppress default handling
'                       (IGNORED for WM_LBUTTONUP / WM_MBUTTONUP -- capture-critical).
'   TooltipCallback   - supply per-tab tooltip text on demand; "" for none.
'   SelChangeCallback - the USER changed the active tab. Programmatic SetCurSel is silent.
'   CloseCallback     - the user asked to close a tab (its "X", or a middle-click on it).
'                       Notify-only: the control never deletes. Prompt, veto, or call
'                       PsTabBar_DeleteTab yourself.
'   ReorderCallback   - a drag moved a tab; one callback per live move, state already
'                       updated. Programmatic MoveTab is silent.
' ----------------------------------------------------------------------------------------
public declare sub      PsTabBar_SetPaintCallback( byval hTabBar as HWND, byval usersub as TB_PaintCallbackSub )
public declare sub      PsTabBar_SetMessageCallback( byval hTabBar as HWND, byval userfunc as TB_MessageCallbackFunc )
public declare sub      PsTabBar_SetTooltipCallback( byval hTabBar as HWND, byval userfunc as TB_TooltipCallbackFunc )
public declare sub      PsTabBar_SetSelChangeCallback( byval hTabBar as HWND, byval usersub as TB_SelChangeCallbackSub )
public declare sub      PsTabBar_SetCloseCallback( byval hTabBar as HWND, byval usersub as TB_CloseCallbackSub )
public declare sub      PsTabBar_SetReorderCallback( byval hTabBar as HWND, byval usersub as TB_ReorderCallbackSub )

' The tooltip backend switch is PsTipHost, which the module imports itself (top of this file).


private function GetTabBarPointer( byval hTabBar as HWND ) as PSTABBAR_STATE ptr
    dim pWindow as CWindow ptr = CWindowPtr(hTabBar)
    dim as PSTABBAR_STATE ptr pTabBar = null
    if pWindow then pTabBar = cast( PSTABBAR_STATE ptr, pWindow->UserData(0) )
    return pTabBar
end function

' Which tab is the cursor over? Returns a index, or -1 for none (the cursor is
' over empty bar area, or outside the control entirely).
private function GetHotTabBarTab( byval hTabBar as HWND ) as integer
    dim as PSTABBAR_STATE ptr pTabBar = GetTabBarPointer(hTabBar)
    if pTabBar = null then return -1
    dim as integer idx = -1
    for i as integer = 0 to pTabBar->tabCount - 1
        if isMouseOverRECT( hTabBar, pTabBar->tabs(i).rc ) then
            idx = i: exit for
        end if
    next
    return idx
end function


' Repaint one tab. Silently does nothing for an invalid index, which is what makes the
' hover path safe when the cursor is over empty bar area (idx = -1). FALSE = no background
' erase; the tab's rect is fully painted by the paint callback.
private sub PsTabBar_InvalidateTab( byval pTabBar as PSTABBAR_STATE ptr, byval idx as integer )
    if pTabBar = null then exit sub
    if pTabBar->IsValidTab(idx) = false then exit sub
    InvalidateRect( pTabBar->hWin, @pTabBar->tabs(idx).rc, FALSE )
end sub



' ========================================================================================
' Add a string (and optional itemData) to the end of the custom tab bar.
' ========================================================================================
public function PsTabBar_AddTab( byval hTabBar as HWND, byval Text as ustring, byval itemData as integer = 0 ) as integer
    dim as PSTABBAR_STATE ptr pTabBar = GetTabBarPointer(hTabBar)
    if pTabBar = null then return -1
    dim as PSTABBAR_TABINFO ptr pTab = pTabBar->AddTab()
    if pTab = null then return -1
    pTab->Text = Text
    pTab->itemData = itemData
    return pTabBar->GetCount() - 1  ' index of the appended tab
end function


' ========================================================================================
' Returns whether the specified tab index is valid.
' ========================================================================================
function PsTabBar_IsValidTab( byval hTabBar as HWND, byval idx as integer ) as boolean
    dim as PSTABBAR_STATE ptr pTabBar = GetTabBarPointer(hTabBar)
    if pTabBar = null then return false
    return pTabBar->IsValidTab(idx)
end function


' ========================================================================================
' Insert a tab at the given index (existing tabs shift right). Returns the
' actual index used (clamped to [0, count]), or -1 on failure.
' ========================================================================================
function PsTabBar_InsertTab( byval hTabBar as HWND, byval idx as integer, byval Text as ustring, byval itemData as integer = 0 ) as integer
    dim as PSTABBAR_STATE ptr pTabBar = GetTabBarPointer(hTabBar)
    if pTabBar = null then return -1
    dim as integer at = idx
    if at < 0 then at = 0
    if at > pTabBar->GetCount() then at = pTabBar->GetCount()
    dim as PSTABBAR_TABINFO ptr pTab = pTabBar->InsertTabAt( at )
    if pTab = null then return -1
    pTab->Text = Text
    pTab->itemData = itemData
    return at
end function


' ========================================================================================
' Delete the tab at the given index. Returns TRUE on success.
' ========================================================================================
public function PsTabBar_DeleteTab( byval hTabBar as HWND, byval idx as integer ) as boolean
    dim as PSTABBAR_STATE ptr pTabBar = GetTabBarPointer(hTabBar)
    if pTabBar = null then return false
    return pTabBar->DeleteTabAt( idx )
end function


' ========================================================================================
' Move a tab to another slot programmatically -- the same index remapping a drag does
' (selection and hover follow the moved tab; scroll position stays put). SILENT, like
' SetCurSel: the reorder callback fires only for user drags. FALSE for a bad index.
' ========================================================================================
function PsTabBar_MoveTab( byval hTabBar as HWND, byval idxFrom as integer, byval idxTo as integer ) as boolean
    dim as PSTABBAR_STATE ptr pTabBar = GetTabBarPointer(hTabBar)
    if pTabBar = null then return false
    if pTabBar->IsValidTab(idxFrom) = false then return false
    if pTabBar->IsValidTab(idxTo) = false then return false
    pTabBar->MoveTab( idxFrom, idxTo )
    return true
end function


' ========================================================================================
' Remove all tabs from the control.
' ========================================================================================
sub PsTabBar_Clear( byval hTabBar as HWND )
    dim as PSTABBAR_STATE ptr pTabBar = GetTabBarPointer(hTabBar)
    if pTabBar = null then return
    pTabBar->Clear()
end sub


' ========================================================================================
' Set specified tab text in the custom tab bar. Returns TRUE on success,
' FALSE if the idx index is invalid.
' ========================================================================================
function PsTabBar_SetText( byval hTabBar as HWND, byval idx as integer, byval Text as ustring ) as boolean
    dim as PSTABBAR_STATE ptr pTabBar = GetTabBarPointer(hTabBar)
    if pTabBar = null then return false
    if pTabBar->IsValidTab(idx) then
        pTabBar->GetTab(idx)->Text = Text
        ' Text drives the tab's width, so this needs a re-layout, not just a repaint.
        pTabBar->Refresh()
        return true     ' success
    end if
    return false  ' invalid tab
end function


' ========================================================================================
' Retrieve specified tab text from the custom tab bar.
' ========================================================================================
public function PsTabBar_GetText( byval hTabBar as HWND, byval idx as integer ) as ustring
    dim as PSTABBAR_STATE ptr pTabBar = GetTabBarPointer(hTabBar)
    if pTabBar = null then return ""
    if pTabBar->IsValidTab(idx) = false then return ""
    dim as PSTABBAR_TABINFO ptr pTab = pTabBar->GetTab(idx)
    dim as ustring wszText = pTab->Text
    return wszText
end function


' ========================================================================================
' Set the user defined tab's painting callback for the custom tab bar.
' ========================================================================================
public sub PsTabBar_SetPaintCallback( byval hTabBar as HWND, byval usersub as TB_PaintCallbackSub )
    dim as PSTABBAR_STATE ptr pTabBar = GetTabBarPointer(hTabBar)
    if pTabBar = null then return 
    pTabBar->PaintCallback = usersub
end sub


' ========================================================================================
' Set the user defined message callback for the custom tab bar.
' ========================================================================================
public sub PsTabBar_SetMessageCallback( byval hTabBar as HWND, byval userfunc as TB_MessageCallbackFunc )
    dim as PSTABBAR_STATE ptr pTabBar = GetTabBarPointer(hTabBar)
    if pTabBar = null then return
    pTabBar->MessageCallback = userfunc
end sub


' ========================================================================================
' Set the on-demand tooltip text callback. If none is set, the tooltip shows the
' hovered tab's Text. Return "" from the callback to suppress the tooltip.
' ========================================================================================
public sub PsTabBar_SetTooltipCallback( byval hTabBar as HWND, byval userfunc as TB_TooltipCallbackFunc )
    dim as PSTABBAR_STATE ptr pTabBar = GetTabBarPointer(hTabBar)
    if pTabBar = null then return
    pTabBar->TooltipCallback = userfunc
end sub


' ========================================================================================
' Set the selection-change callback. Fired only for USER-driven changes, after the
' control's state is updated (GetCurSel already answers the new index). Programmatic
' SetCurSel never fires it.
' ========================================================================================
public sub PsTabBar_SetSelChangeCallback( byval hTabBar as HWND, byval usersub as TB_SelChangeCallbackSub )
    dim as PSTABBAR_STATE ptr pTabBar = GetTabBarPointer(hTabBar)
    if pTabBar = null then return
    pTabBar->SelChangeCallback = usersub
end sub


' ========================================================================================
' Set the close-request callback. Notify-only: the control never deletes a tab. The
' host prompts/vetoes/deletes as it sees fit.
' ========================================================================================
public sub PsTabBar_SetCloseCallback( byval hTabBar as HWND, byval usersub as TB_CloseCallbackSub )
    dim as PSTABBAR_STATE ptr pTabBar = GetTabBarPointer(hTabBar)
    if pTabBar = null then return
    pTabBar->CloseCallback = usersub
end sub


' ========================================================================================
' Set the reorder callback: one call per live drag move, fired after the control's
' array and indices are updated. Programmatic MoveTab never fires it.
' ========================================================================================
public sub PsTabBar_SetReorderCallback( byval hTabBar as HWND, byval usersub as TB_ReorderCallbackSub )
    dim as PSTABBAR_STATE ptr pTabBar = GetTabBarPointer(hTabBar)
    if pTabBar = null then return
    pTabBar->ReorderCallback = usersub
end sub


' Resolve the tooltip text for a tab: host callback if set, else the tab's Text.
function PsTabBar_ResolveTooltipText( byval pTabBar as PSTABBAR_STATE ptr, byval idx as integer ) as ustring
    if (pTabBar = null) orelse (pTabBar->IsValidTab(idx) = false) then return ""
    if pTabBar->TooltipCallback then return pTabBar->TooltipCallback( pTabBar->hWin, idx )
    return pTabBar->tabs(idx).Text
end function


' ========================================================================================
' Set the tooltip hovertime for the custom tab bar.
' ========================================================================================
' NEW: this control's tooltip handle used to be private, so a host could not
' reach the tip at all -- no TTM_*, and no way to see whether one existed.
' The comctl32 handle, and 0 while on PsTooltip -- the honest answer, since a TTM_* sent
' to a PsTooltip window is silently ignored.
function PsTabBar_GetTooltipHandle( byval hTabBar as HWND ) as HWND
    dim as PSTABBAR_STATE ptr pTabBar = GetTabBarPointer(hTabBar)
    if pTabBar = 0 then return 0
    return PsTipHost_SysHandle( @pTabBar->tip )
end function

' The PsTooltip window, and 0 while on the system backend. This is the door to PsTooltip's
' own SetColors/SetFonts/SetStyle/SetMaxWidth/SetTitle/SetGlyph, none of which is mirrored
' on this control.
function PsTabBar_GetPsTooltipHandle( byval hTabBar as HWND ) as HWND
    dim as PSTABBAR_STATE ptr pTabBar = GetTabBarPointer(hTabBar)
    if pTabBar = 0 then return 0
    return PsTipHost_PsHandle( @pTabBar->tip )
end function

function PsTabBar_SetTooltipMode( byval hTabBar as HWND, byval nMode as long ) as boolean
    dim as PSTABBAR_STATE ptr pTabBar = GetTabBarPointer(hTabBar)
    if pTabBar = 0 then return false
    return PsTipHost_SetMode( @pTabBar->tip, nMode )
end function

function PsTabBar_GetTooltipMode( byval hTabBar as HWND ) as long
    dim as PSTABBAR_STATE ptr pTabBar = GetTabBarPointer(hTabBar)
    if pTabBar = 0 then return PSTIP_MODE_SYSTEM
    return PsTipHost_GetMode( @pTabBar->tip )
end function

' The three delays go through PsTipHost, which STORES them as well as pushing them, so a
' hover time set before a mode switch is still in force after it. Pushing straight at the
' live tooltip loses it at the switch -- and the tip still appears, just on a different
' beat, with nothing reporting the change.
' NOTE the `as integer` -- this control declared its hover time that way from the start.
' Left as it is rather than harmonised with the family's `as long`: widening a shipped public
' signature is an API change, not a tidy-up.
'
' AND NOTE WHAT THIS NOW DOES THAT IT DID NOT. Before, this setter ONLY stored the field for
' TrackMouseEvent -- it never touched the tooltip, so this control's tip delay was not
' settable at all. It now drives both.
sub PsTabBar_SetHoverTime( byval hTabBar as HWND, byval milliseconds as integer )
    dim as PSTABBAR_STATE ptr pTabBar = GetTabBarPointer(hTabBar)
    if pTabBar = 0 then exit sub
    ' The field is STILL READ by TrackMouseEvent as dwHoverTime, so this setter
    ' drives the hot-tracking dwell as well as the tooltip. Dropping it here would
    ' silently change when the control considers itself hot.
    pTabBar->HoverTime = milliseconds
    PsTipHost_SetDelay( @pTabBar->tip, TTDT_INITIAL, milliseconds )
end sub

sub PsTabBar_SetAutoPopTime( byval hTabBar as HWND, byval milliseconds as long )
    dim as PSTABBAR_STATE ptr pTabBar = GetTabBarPointer(hTabBar)
    if pTabBar = 0 then exit sub
    PsTipHost_SetDelay( @pTabBar->tip, TTDT_AUTOPOP, milliseconds )
end sub

sub PsTabBar_SetReshowTime( byval hTabBar as HWND, byval milliseconds as long )
    dim as PSTABBAR_STATE ptr pTabBar = GetTabBarPointer(hTabBar)
    if pTabBar = 0 then exit sub
    PsTipHost_SetDelay( @pTabBar->tip, TTDT_RESHOW, milliseconds )
end sub


' ========================================================================================
' Set specified idx itemData for the custom tab bar.
' ========================================================================================
' Returns TRUE on success, FALSE if the idx index is invalid.
function PsTabBar_SetItemData( byval hTabBar as HWND, byval idx as integer, byval itemData as integer ) as boolean
    dim as PSTABBAR_STATE ptr pTabBar = GetTabBarPointer(hTabBar)
    if pTabBar = null then return false
    if pTabBar->IsValidTab(idx) then
        pTabBar->GetTab(idx)->itemData = itemData
        return true     ' success
    end if
    return false  ' invalid tab
end function


' ========================================================================================
' Retrieve specified tab itemData from the custom tab bar.
' ========================================================================================
public function PsTabBar_GetItemData( byval hTabBar as HWND, byval idx as integer ) as integer
    dim as PSTABBAR_STATE ptr pTabBar = GetTabBarPointer(hTabBar)
    if pTabBar = null then return 0
    if pTabBar->IsValidTab(idx) = false then return 0
    return pTabBar->GetTab(idx)->itemData
end function


' ========================================================================================
' Retrieve the font used to measure tab text.
' ========================================================================================
function PsTabBar_GetFont( byval hTabBar as HWND ) as HFONT
    dim as PSTABBAR_STATE ptr pTabBar = GetTabBarPointer(hTabBar)
    if pTabBar = null then return 0
    return pTabBar->hTabFont
end function


' ========================================================================================
' Set the font used to paint tab text. The caller owns the HFONT and is responsible for
' destroying it; the control only stores the handle.
' ========================================================================================
public function PsTabBar_SetFont( byval hTabBar as HWND, byval hFont as HFONT ) as boolean
    dim as PSTABBAR_STATE ptr pTabBar = GetTabBarPointer(hTabBar)
    if pTabBar = null then return false
    pTabBar->hTabFont = hFont
    ' The font is what tab widths are measured with, so changing it re-lays out.
    pTabBar->Refresh()
    return true
end function


' ========================================================================================
' Retrieve the minimum width (pixels) of the specified tab. 0 = auto-size to text.
' ========================================================================================
function PsTabBar_GetTabMinWidth( byval hTabBar as HWND, byval idx as integer ) as integer
    dim as PSTABBAR_STATE ptr pTabBar = GetTabBarPointer(hTabBar)
    if pTabBar = null then return 0
    if pTabBar->IsValidTab(idx) = false then return 0
    return pTabBar->GetTab(idx)->nMinWidth
end function


' ========================================================================================
' Set the minimum width (pixels) of the specified tab. The tab never renders narrower
' than its text, so this is a floor, not a fixed width. Returns FALSE for a bad index.
' ========================================================================================
public function PsTabBar_SetTabMinWidth( byval hTabBar as HWND, byval idx as integer, byval nMinWidth as integer ) as boolean
    dim as PSTABBAR_STATE ptr pTabBar = GetTabBarPointer(hTabBar)
    if pTabBar = null then return false
    if pTabBar->IsValidTab(idx) = false then return false
    if nMinWidth < 0 then nMinWidth = 0
    pTabBar->GetTab(idx)->nMinWidth = nMinWidth
    pTabBar->Refresh()
    return true
end function


' ========================================================================================
' Retrieve the horizontal padding (pixels) added to each side of a tab's text.
' ========================================================================================
function PsTabBar_GetPadding( byval hTabBar as HWND ) as integer
    dim as PSTABBAR_STATE ptr pTabBar = GetTabBarPointer(hTabBar)
    if pTabBar = null then return 0
    return pTabBar->nPadding
end function


' ========================================================================================
' Set the horizontal padding (raw pixels -- the caller DPI-scales) added to each side of a
' tab's text when measuring. Inset your paint callback's text by the same amount.
' ========================================================================================
public sub PsTabBar_SetPadding( byval hTabBar as HWND, byval nPadding as integer )
    dim as PSTABBAR_STATE ptr pTabBar = GetTabBarPointer(hTabBar)
    if pTabBar = null then exit sub
    if nPadding < 0 then nPadding = 0
    pTabBar->nPadding = nPadding
    pTabBar->Refresh()
end sub


' ========================================================================================
' Retrieve the side (pixels) of the two square icon rects reserved in every tab.
' ========================================================================================
function PsTabBar_GetIconWidth( byval hTabBar as HWND ) as integer
    dim as PSTABBAR_STATE ptr pTabBar = GetTabBarPointer(hTabBar)
    if pTabBar = null then return 0
    return pTabBar->nIconWidth
end function


' ========================================================================================
' Set the icon rect side (raw pixels -- the caller DPI-scales). A layout input: every
' tab reserves 2*nIconWidth, so changing it re-measures everything.
' ========================================================================================
sub PsTabBar_SetIconWidth( byval hTabBar as HWND, byval nIconWidth as integer )
    dim as PSTABBAR_STATE ptr pTabBar = GetTabBarPointer(hTabBar)
    if pTabBar = null then exit sub
    if nIconWidth < 0 then nIconWidth = 0
    pTabBar->nIconWidth = nIconWidth
    pTabBar->Refresh()
end sub


' ========================================================================================
' Retrieve the width (pixels) of the control-drawn border chrome.
' ========================================================================================
function PsTabBar_GetBorderWidth( byval hTabBar as HWND ) as integer
    dim as PSTABBAR_STATE ptr pTabBar = GetTabBarPointer(hTabBar)
    if pTabBar = null then return 0
    return pTabBar->nBorderWidth
end function


' ========================================================================================
' Set the border width (raw pixels -- the caller DPI-scales). A layout input: rcPaint
' is deflated by it. 0 is legal and means no chrome.
' ========================================================================================
sub PsTabBar_SetBorderWidth( byval hTabBar as HWND, byval nBorderWidth as integer )
    dim as PSTABBAR_STATE ptr pTabBar = GetTabBarPointer(hTabBar)
    if pTabBar = null then exit sub
    if nBorderWidth < 0 then nBorderWidth = 0
    pTabBar->nBorderWidth = nBorderWidth
    pTabBar->Refresh()
end sub


' ========================================================================================
' Retrieve the border (chrome) color.
' ========================================================================================
function PsTabBar_GetBorderColor( byval hTabBar as HWND ) as COLORREF
    dim as PSTABBAR_STATE ptr pTabBar = GetTabBarPointer(hTabBar)
    if pTabBar = null then return 0
    return pTabBar->BorderColor
end function


' ========================================================================================
' Set the border (chrome) color. Returns the previous color.
' ========================================================================================
public function PsTabBar_SetBorderColor( byval hTabBar as HWND, byval clr as COLORREF ) as COLORREF
    dim as PSTABBAR_STATE ptr pTabBar = GetTabBarPointer(hTabBar)
    if pTabBar = null then return 0
    dim as COLORREF oldClr = pTabBar->BorderColor
    pTabBar->BorderColor = clr
    pTabBar->bColorsPinned = true
    if pTabBar->hWin then InvalidateRect( pTabBar->hWin, NULL, TRUE )
    return oldClr
end function


' ========================================================================================
' Retrieve the computed client-coordinate rect of the specified tab. Forces a pending
' layout so the result is always current. Returns FALSE for a bad index.
' ========================================================================================
function PsTabBar_GetTabRect( byval hTabBar as HWND, byval idx as integer, byref rc as RECT ) as boolean
    dim as PSTABBAR_STATE ptr pTabBar = GetTabBarPointer(hTabBar)
    SetRectEmpty( @rc )
    if pTabBar = null then return false
    if pTabBar->IsValidTab(idx) = false then return false
    if pTabBar->bLayoutDirty then pTabBar->LayoutTabs()
    rc = pTabBar->GetTab(idx)->rc
    return true
end function


' ========================================================================================
' Retrieve the derived interior rects of the specified tab: rcPaint (the full rect
' pre-deflated by the border -- the space the paint callback owns), rcText (caption
' area between the icon rects), rcIcon (left icon) and rcClose (the close "X"). The
' same rects the paint callback receives. Forces a pending layout. Returns FALSE for a
' bad index. A tab scrolled off the left returns empty rects -- its honest geometry.
' ========================================================================================
function PsTabBar_GetTabParts( byval hTabBar as HWND, byval idx as integer, byref rcPaint as RECT, byref rcText as RECT, byref rcIcon as RECT, byref rcClose as RECT ) as boolean
    dim as PSTABBAR_STATE ptr pTabBar = GetTabBarPointer(hTabBar)
    SetRectEmpty( @rcPaint )
    SetRectEmpty( @rcText )
    SetRectEmpty( @rcIcon )
    SetRectEmpty( @rcClose )
    if pTabBar = null then return false
    if pTabBar->IsValidTab(idx) = false then return false
    if pTabBar->bLayoutDirty then pTabBar->LayoutTabs()
    rcPaint = pTabBar->GetTab(idx)->rcPaint
    rcText  = pTabBar->GetTab(idx)->rcText
    rcIcon  = pTabBar->GetTab(idx)->rcIcon
    rcClose = pTabBar->GetTab(idx)->rcClose
    return true
end function


' ========================================================================================
' Retrieve the index of the active tab, or -1 for none.
' ========================================================================================
function PsTabBar_GetCurSel( byval hTabBar as HWND ) as integer
    dim as PSTABBAR_STATE ptr pTabBar = GetTabBarPointer(hTabBar)
    if pTabBar = null then return -1
    return pTabBar->nCurSel
end function


' ========================================================================================
' Set the active tab (-1 clears the selection). A valid index is scrolled into view on
' the next layout, which is where measured widths exist -- so calling this before the
' control is sized is safe, and the scroll happens once it is. Returns FALSE for a bad
' index. Does NOT fire the selection-change notification: only user interaction does.
' ========================================================================================
public function PsTabBar_SetCurSel( byval hTabBar as HWND, byval idx as integer ) as boolean
    dim as PSTABBAR_STATE ptr pTabBar = GetTabBarPointer(hTabBar)
    if pTabBar = null then return false
    if (idx <> -1) andalso (pTabBar->IsValidTab(idx) = false) then return false
    pTabBar->nCurSel = idx
    if idx <> -1 then pTabBar->bEnsureVisible = true
    ' Selection is a layout input (the active tab's rcPaint differs), not just a repaint.
    pTabBar->Refresh()
    return true
end function


' ========================================================================================
' Retrieve the first-visible (leftmost drawn) tab index.
' ========================================================================================
function PsTabBar_GetFirstVisible( byval hTabBar as HWND ) as integer
    dim as PSTABBAR_STATE ptr pTabBar = GetTabBarPointer(hTabBar)
    if pTabBar = null then return 0
    return pTabBar->nFirstVisible
end function


' ========================================================================================
' Set the first-visible tab index directly (Navigate is the stepwise form). Returns
' FALSE for a bad index.
' ========================================================================================
function PsTabBar_SetFirstVisible( byval hTabBar as HWND, byval idx as integer ) as boolean
    dim as PSTABBAR_STATE ptr pTabBar = GetTabBarPointer(hTabBar)
    if pTabBar = null then return false
    if pTabBar->IsValidTab(idx) = false then return false
    pTabBar->nFirstVisible = idx
    ' Layout is lazy, so a scroll-into-view queued by an earlier SetCurSel would be
    ' consumed in the same later pass and OVERRIDE this explicit scroll position.
    ' Last mutation wins: an explicit SetFirstVisible cancels the pending request.
    pTabBar->bEnsureVisible = false
    pTabBar->Refresh()
    return true
end function


' ========================================================================================
' Would a one-tab step in the given direction (-1 left / +1 right) actually move?
' Left: not already at the first tab. Right: the last tab still clips at the client
' edge (scrolling further right than "last tab visible" would serve nothing).
' Forces a pending layout; FALSE while the control has no geometry yet.
' ========================================================================================
function PsTabBar_CanNavigate( byval hTabBar as HWND, byval nDirection as integer ) as boolean
    dim as PSTABBAR_STATE ptr pTabBar = GetTabBarPointer(hTabBar)
    if pTabBar = null then return false
    if pTabBar->tabCount = 0 then return false
    if (nDirection <> -1) andalso (nDirection <> 1) then return false
    if pTabBar->bLayoutDirty then pTabBar->LayoutTabs()
    ' Still dirty means no geometry (0x0 client): the rects are stale, answer nothing.
    if pTabBar->bLayoutDirty then return false
    if nDirection = -1 then return (pTabBar->nFirstVisible > 0)
    if pTabBar->nFirstVisible >= pTabBar->tabCount - 1 then return false
    dim as RECT rcClient
    GetClientRect( pTabBar->hWin, @rcClient )
    return (pTabBar->tabs(pTabBar->tabCount - 1).rc.right > rcClient.right)
end function


' ========================================================================================
' Step the first-visible tab one to the left (-1) or right (+1), gated on CanNavigate,
' so a no-op step is harmless. Returns the (possibly unchanged) first-visible index.
' ========================================================================================
function PsTabBar_Navigate( byval hTabBar as HWND, byval nDirection as integer ) as integer
    dim as PSTABBAR_STATE ptr pTabBar = GetTabBarPointer(hTabBar)
    if pTabBar = null then return -1
    if PsTabBar_CanNavigate( hTabBar, nDirection ) then
        pTabBar->nFirstVisible += iif( nDirection < 0, -1, 1 )
        pTabBar->Refresh()
    end if
    return pTabBar->nFirstVisible
end function


' ========================================================================================
' Retrieve the background color from the custom tab bar.
' ========================================================================================
function PsTabBar_GetBackColor( byval hTabBar as HWND ) as COLORREF
    dim as PSTABBAR_STATE ptr pTabBar = GetTabBarPointer(hTabBar)
    if pTabBar = null then return 0
    return pTabBar->BackColor
end function


' ========================================================================================
' Set the background color for the custom tab bar.
' ========================================================================================
public function PsTabBar_SetBackColor( byval hTabBar as HWND, byval clr as COLORREF ) as COLORREF 
    dim as PSTABBAR_STATE ptr pTabBar = GetTabBarPointer(hTabBar)
    if pTabBar = null then return 0
    dim as COLORREF oldClr = pTabBar->BackColor
    pTabBar->BackColor = clr
    pTabBar->bColorsPinned = true
    return oldClr
end function

' ========================================================================================
' The theme (vendor/PsControls/PsTheme). ApplyTheme sets the tab bar's colours from the
' theme's roles unless the host pinned its own.
' ========================================================================================
public sub PsTabBar_ApplyTheme( byval hTabBar as HWND, byref t as PSTHEME_COLORS )
    dim as PSTABBAR_STATE ptr pTabBar = GetTabBarPointer(hTabBar)
    if (pTabBar = 0) orelse pTabBar->bColorsPinned then exit sub
    PsTabBar_SetBackColor( hTabBar, t.Window )
    PsTabBar_SetBorderColor( hTabBar, t.Border )
    pTabBar->bColorsPinned = false
end sub

' Hands the tab bar back to the theme, which is applied at once.
public sub PsTabBar_UnpinColors( byval hTabBar as HWND )
    dim as PSTABBAR_STATE ptr pTabBar = GetTabBarPointer(hTabBar)
    if pTabBar = 0 then exit sub
    pTabBar->bColorsPinned = false
    dim as PSTHEME_COLORS t
    if PsRegistry_GetTheme( t ) then PsTabBar_ApplyTheme( hTabBar, t )
end sub

' The form's fonts (PsApp), handed over when the tab bar is created on a form.
public sub PsTabBar_ApplyFonts( byval hTabBar as HWND, byval hTextFont as HFONT, byval hGlyphFont as HFONT )
    if hTextFont then PsTabBar_SetFont( hTabBar, hTextFont )
end sub

' ========================================================================================
' Per-monitor DPI (RFC-0001 P4). Padding, icon width and border width (all scaled at Create,
' or the host's since) and every tab's minimum width are pixels, so they are scaled; a border
' that was there stays at least one pixel. The tab rects are layout's and are re-derived. The
' font is not ours: PsApp hands the new one over after this.
' ========================================================================================
public sub PsTabBar_Rescale( byval hTabBar as HWND, byval oldDpi as long, byval newDpi as long )
    dim as PSTABBAR_STATE ptr pTabBar = GetTabBarPointer(hTabBar)
    if (pTabBar = 0) orelse (oldDpi <= 0) orelse (newDpi <= 0) orelse (oldDpi = newDpi) then exit sub
    pTabBar->nPadding   = MulDiv( pTabBar->nPadding,   newDpi, oldDpi )
    pTabBar->nIconWidth = MulDiv( pTabBar->nIconWidth, newDpi, oldDpi )
    if pTabBar->nBorderWidth > 0 then
        pTabBar->nBorderWidth = MulDiv( pTabBar->nBorderWidth, newDpi, oldDpi )
        if pTabBar->nBorderWidth < 1 then pTabBar->nBorderWidth = 1
    end if
    for i as integer = 0 to pTabBar->tabCount - 1
        pTabBar->tabs(i).nMinWidth = MulDiv( pTabBar->tabs(i).nMinWidth, newDpi, oldDpi )
    next
    dim as CWindow ptr pWindow = CWindowPtr( hTabBar )
    if pWindow then pWindow->DPI = newDpi
    pTabBar->Refresh()
end sub


' ========================================================================================
' Retrieve the current tab count in the custom tab bar.
' ========================================================================================
function PsTabBar_GetCount( byval hTabBar as HWND ) as integer
    dim as PSTABBAR_STATE ptr pTabBar = GetTabBarPointer(hTabBar)
    if pTabBar = null then return 0
    return pTabBar->GetCount()
end function


' ========================================================================================
' Refresh the custom tab bar.
' ========================================================================================
sub PsTabBar_Refresh( byval hTabBar as HWND ) 
    dim as PSTABBAR_STATE ptr pTabBar = GetTabBarPointer(hTabBar)
    if pTabBar then pTabBar->Refresh()
end sub


' ========================================================================================
' Process WM_SIZE message for window/dialog: PsTabBar
' ========================================================================================
function PsTabBar_OnSize( _
            byval hwnd as HWND, _
            byval state as UINT, _
            byval cx as long, _
            byval cy as long _
            ) as LRESULT
    if state <> SIZE_MINIMIZED then
        ' There are no child windows to position, but tab rects span the full client
        ' height and the client width decides where the rightmost tab clips, so a
        ' resize invalidates the layout.
        dim as PSTABBAR_STATE ptr pTabBar = GetTabBarPointer(hwnd)
        if pTabBar then pTabBar->Refresh()
    end if
    function = 0
end function
 
        
' ========================================================================================
' Process WM_PAINT message for window/dialog: PsTabBar
' ========================================================================================
function PsTabBar_OnPaint( byval hwnd as HWND ) as LRESULT
    dim as PSTABBAR_STATE ptr pTabBar = GetTabBarPointer(hwnd)
    if pTabBar = null then return 0

    ' Consume any pending layout before painting. This is what makes a burst of SetText
    ' calls cost one measuring pass instead of N.
    if pTabBar->bLayoutDirty then pTabBar->LayoutTabs()

    ' Capture the update rect BEFORE BeginDoubleBuffer -- BeginPaint clears it.
    '
    ' This is a CONSERVATIVE approximation and correctness never depends on it: it only
    ' skips handing the host tabs that could not show a pixel anyway. GetUpdateRect
    ' returns the BOUNDING BOX of the update region, not the region, so when hover moves
    ' between two far-apart tabs their union bounds the whole bar and nothing is skipped.
    ' Measured: hovering one tab repaints one; moving from tab 0 to tab 4 repaints all
    ' five. That is fine -- the buffer allocates and fills the whole client every paint
    ' regardless, so the skip is noise next to that. Reach for GetUpdateRgn/RectInRegion
    ' only if a real tab count ever makes this matter.
    dim as RECT rcUpdate
    if GetUpdateRect( hwnd, @rcUpdate, FALSE ) = 0 then GetClientRect( hwnd, @rcUpdate )

    dim as PsPaintBuffer b

    b.BeginDoubleBuffer(hwnd)
    b.SetBackColor( pTabBar->BackColor )

    ' Fill the whole bar, which also covers any gap no tab owns (the control's own
    ' background is the only thing it paints; tabs belong to the paint callback).
    b.PaintClientRect()

    ' Hand each affected tab to the host. Skipping the rest is safe even though
    ' EndDoubleBuffer blits the WHOLE client: BeginPaint's DC is clipped to the update
    ' region, so the skipped (background-filled) areas never reach the screen.
    if pTabBar->PaintCallback then
        dim p as PSTABBAR_PAINTINFO
        p.hTabBar   = hwnd
        p.b          = @b
        for i as integer = 0 to pTabBar->tabCount - 1
            dim as RECT rcHit
            if IntersectRect( @rcHit, @pTabBar->tabs(i).rc, @rcUpdate ) = 0 then continue for
            p.itemID     = i
            ' The DEFLATED paint area, plus every derived rect precomputed -- the
            ' callback never re-derives geometry (author's call).
            p.rc         = pTabBar->tabs(i).rcPaint
            p.rcText     = pTabBar->tabs(i).rcText
            p.rcIcon     = pTabBar->tabs(i).rcIcon
            p.rcClose    = pTabBar->tabs(i).rcClose
            p.isSelected = (i = pTabBar->nCurSel)
            p.isHot      = (i = pTabBar->nLastHotIdx)
            p.isHotClose = (i = pTabBar->nLastHotIdx) andalso pTabBar->bLastHotClose
            p.isPressed  = (i = pTabBar->nPressedIdx)
            p.isDragging = (i = pTabBar->nPressedIdx) andalso pTabBar->bDragging
            p.wszCaption = pTabBar->tabs(i).Text
            pTabBar->PaintCallback( @p )
        next
    end if

    ' ------------------------------------------------------------------------------------
    ' Control-drawn chrome, AFTER the callbacks so it is authoritative no matter what a
    ' callback painted: the full-width bottom line, broken under the active tab, and the
    ' active tab's 3-sided (left/top/right) border. The line is drawn as TWO SEGMENTS
    ' skipping the active tab's x-range -- never "draw it fully and let the active tab
    ' paint over it": the control's chrome must not depend on a host callback to
    ' complete it. The active tab's own fill (its rcPaint runs to the client bottom) is
    ' what shows through the break.
    ' ------------------------------------------------------------------------------------
    if pTabBar->nBorderWidth > 0 then
        dim as integer bw = pTabBar->nBorderWidth
        dim as RECT rcC : GetClientRect( hwnd, @rcC )
        b.SetBackColor( pTabBar->BorderColor )

        ' The active tab's x-range, if there is an active tab and it is not scrolled off
        ' (an empty rect must not break the line at 0..0).
        dim as RECT rcSel : SetRectEmpty( @rcSel )
        if pTabBar->IsValidTab( pTabBar->nCurSel ) then rcSel = pTabBar->tabs(pTabBar->nCurSel).rc

        dim as RECT rcStrip
        if IsRectEmpty( @rcSel ) then
            SetRect( @rcStrip, rcC.left, rcC.bottom - bw, rcC.right, rcC.bottom )
            b.PaintRect( @rcStrip )
        else
            if rcSel.left > rcC.left then
                SetRect( @rcStrip, rcC.left, rcC.bottom - bw, rcSel.left, rcC.bottom )
                b.PaintRect( @rcStrip )
            end if
            if rcSel.right < rcC.right then
                SetRect( @rcStrip, rcSel.right, rcC.bottom - bw, rcC.right, rcC.bottom )
                b.PaintRect( @rcStrip )
            end if
            ' 3-sided border; the sides run the full height to meet the broken line's ends.
            SetRect( @rcStrip, rcSel.left, rcSel.top, rcSel.left + bw, rcSel.bottom )
            b.PaintRect( @rcStrip )
            SetRect( @rcStrip, rcSel.left, rcSel.top, rcSel.right, rcSel.top + bw )
            b.PaintRect( @rcStrip )
            SetRect( @rcStrip, rcSel.right - bw, rcSel.top, rcSel.right, rcSel.bottom )
            b.PaintRect( @rcStrip )
        end if
    end if

    b.EndDoubleBuffer()

    function = 0
end function


' ========================================================================================
' Clear any hot-tracked tab and stop the safety-net timer. Repaints only if a tab was
' actually hot, so this is cheap to call repeatedly.
' ========================================================================================
private sub PsTabBar_ClearHotTracking( byval pTabBar as PSTABBAR_STATE ptr, byval hTabBar as HWND )
    if pTabBar = null then exit sub
    if pTabBar->hotTimerOn then
        KillTimer( hTabBar, IDT_CTABBAR_HOTTRACK )
        pTabBar->hotTimerOn = false
    end if
    if pTabBar->nLastHotIdx <> -1 then
        pTabBar->nLastHotIdx = -1
        pTabBar->bLastHotClose = false
        win.RedrawWindow( hTabBar )
    end if
end sub


' ========================================================================================
' Hand the cursor back to the window class after a drag ends. Needed because the drop can
' happen without any further mouse movement: WM_SETCURSOR only arrives with motion, so
' without this the four-headed arrow would stay on screen until the user moved the mouse.
' ========================================================================================
private sub PsTabBar_RestoreCursor( byval hTabBar as HWND )
    dim as HCURSOR hCur = cast( HCURSOR, GetClassLongPtr( hTabBar, GCLP_HCURSOR ) )
    if hCur = 0 then hCur = LoadCursor( null, IDC_ARROW )
    SetCursor( hCur )
end sub


' ========================================================================================
' PsTabBar Window procedure
'
' This control has no child windows, so there is nothing to subclass: every message is
' handled here and anything unhandled goes to DefWindowProc. 
' ========================================================================================
function PsTabBar_WndProc( _
            byval hwnd   as HWND, _
            byval uMsg   as UINT, _
            byval wParam as WPARAM, _
            byval lParam as LPARAM _
            ) as LRESULT

    dim as PSTABBAR_STATE ptr pTabBar = GetTabBarPointer( hwnd )

    ' Per-message scratch info passed to the user MessageCallback. A plain local (NOT
    ' static) so that multiple control instances never share it. The hover tracking index
    ' likewise lives per-instance in pTabBar->nLastHotIdx.
    dim m as PSTABBAR_MESSAGEINFO

    select case uMsg
        ' Prepare the callback MessageInfo for only the messages that we hand to the host.
        case WM_MOUSEMOVE, WM_MOUSEHOVER, WM_MOUSELEAVE, _
             WM_LBUTTONDOWN, WM_RBUTTONDOWN, WM_LBUTTONUP, WM_LBUTTONDBLCLK, _
             WM_MBUTTONDOWN, WM_MBUTTONUP, WM_MOUSEWHEEL
            with m
                .hTabBar   = hwnd
                .uMsg       = uMsg
                .wParam     = wParam
                .lParam     = lParam
                .idx        = -1
            end with
    end select

    select case uMsg
        HANDLE_MSG (hwnd, WM_SIZE,        PsTabBar_OnSize)
        HANDLE_MSG (hwnd, WM_PAINT,       PsTabBar_OnPaint)

    ' The SendMessage doors for a separate nav control. wParam is -1/+1; anything else
    ' is answered without moving. (wParam arrives zero-extended, so cast via LONG_PTR
    ' to get the sign back before treating it as a direction.)
    case TCM_NAVIGATE
        return PsTabBar_Navigate( hwnd, cast(integer, cast(LONG_PTR, wParam)) )

    case TCM_CANNAVIGATE
        return iif( PsTabBar_CanNavigate( hwnd, cast(integer, cast(LONG_PTR, wParam)) ), 1, 0 )

    case WM_TIMER
        if (pTabBar <> 0) andalso (wParam = IDT_CTABBAR_HOTTRACK) then
            ' The cursor may have left without us getting a WM_MOUSELEAVE. If it is no
            ' longer over our client area, clear the hot tab ourselves. Never while
            ' dragging: hover is pinned to the dragged tab, and with capture held the
            ' cursor legitimately roams outside the client mid-gesture.
            dim as RECT rcClient : GetClientRect( hwnd, @rcClient )
            if (pTabBar->bDragging = false) andalso (isMouseOverRECT( hwnd, rcClient ) = false) then
                PsTabBar_ClearHotTracking( pTabBar, hwnd )
            end if
            return 0
        end if

    case WM_SETCURSOR
        ' A drag-reorder is in progress: show the four-headed move cursor for the whole
        ' gesture. Under capture the hit-test code in loword(lParam) can be anything (the
        ' cursor legitimately roams off the control mid-drag), so it is deliberately not
        ' tested here -- while bDragging we own the cursor unconditionally, and while we
        ' are not dragging we claim nothing and DefWindowProc sets the class cursor.
        ' Not offered to MessageCallback: the host's message list is unchanged by this.
        if pTabBar then
            if pTabBar->bDragging andalso (pTabBar->hDragCursor <> 0) then
                SetCursor( pTabBar->hDragCursor )
                return true
            end if
        end if

    case WM_MOUSEMOVE
        ' Track that we are over the control in order to catch the eventual
        ' WM_MOUSEHOVER and WM_MOUSELEAVE events.
        dim tme as TrackMouseEvent
        tme.cbSize = sizeof(TrackMouseEvent)
        tme.dwFlags = TME_HOVER or TME_LEAVE
        tme.hwndTrack = hwnd
        tme.dwHoverTime = 250    ' HOVER_DEFAULT is 500
        if pTabBar then tme.dwHoverTime = pTabBar->HoverTime
        TrackMouseEvent(@tme)

        ' Safety net: WM_MOUSELEAVE is not guaranteed to arrive when the mouse exits
        ' quickly (or onto another control), which would strand the hot tab painted.
        ' Poll the cursor while we are over the control.
        if (pTabBar <> 0) andalso (pTabBar->hotTimerOn = false) then
            SetTimer( hwnd, IDT_CTABBAR_HOTTRACK, PSTABBAR_HOTTRACK_MS, NULL )
            pTabBar->hotTimerOn = true
        end if

        ' Repaint only the tabs whose state changed, not the whole bar.
        if pTabBar then
            dim as integer idx = GetHotTabBarTab(hwnd)
            ' Hover tracking is SUSPENDED while dragging: hover stays pinned to the
            ' dragged tab (MoveTab keeps nLastHotIdx following it), so the dragged tab
            ' keeps its hot state -- and its close "X" -- for the whole gesture, and a
            ' tab being dragged over can never light up or grow an X of its own.
            ' Normal tracking resumes on the first move after the drop.
            if pTabBar->bDragging = false then
                ' Is the cursor over the hot tab's close "X"? A tab is both isHot and
                ' isHotClose then -- the X is inside the tab.
                dim as boolean hotClose = false
                if idx <> -1 then hotClose = isMouseOverRECT( hwnd, pTabBar->tabs(idx).rcClose )
                if idx <> pTabBar->nLastHotIdx then
                    PsTabBar_InvalidateTab( pTabBar, idx )                   ' newly hot
                    PsTabBar_InvalidateTab( pTabBar, pTabBar->nLastHotIdx )  ' previously hot
                    pTabBar->nLastHotIdx = idx
                    pTabBar->bLastHotClose = hotClose
                    ' Item changed. On the system backend this pops the tip so it re-queries
                    ' TTN_GETDISPINFOW for the new item; on PsTooltip it moves the tool index, which
                    ' hides a visible tip and re-resolves on the next dwell. One call site either way --
                    ' and the index is what lets the PsTooltip backend report WHICH item a tip is for,
                    ' which comctl32 never knew.
                    PsTipHost_SetToolIndex( @pTabBar->tip, idx )
                elseif hotClose <> pTabBar->bLastHotClose then
                    ' Same tab, but the cursor crossed the close rect's edge: the X's
                    ' rendering changes, so repaint just this tab.
                    pTabBar->bLastHotClose = hotClose
                    PsTabBar_InvalidateTab( pTabBar, idx )
                end if
            end if

            ' --------------------------------------------------------------------------
            ' Drag-to-reorder. A live left press (not on the "X" -- the X is a click
            ' target, not a handle) that travels past the system drag threshold becomes
            ' a drag. Reordering is LIVE: the moment the pointer crosses INTO an
            ' adjacent tab, the tabs exchange immediately -- the tabs visibly changing
            ' places ARE the drag feedback. The exchange is gated on the DIRECTION OF
            ' TRAVEL, which is what prevents oscillation when a narrow tab is dragged
            ' over a wide one: after that exchange the pointer still sits over the wide
            ' tab (now on the other side of the dragged one), and without the gate the
            ' next pixel of movement would exchange them straight back.
            ' --------------------------------------------------------------------------
            if (pTabBar->nPressedIdx <> -1) andalso (pTabBar->bPressedClose = false) then
                dim as integer ptX = cast( short, loword(lParam) )
                dim as integer ptY = cast( short, hiword(lParam) )
                if pTabBar->bDragging = false then
                    if (abs(ptX - pTabBar->ptPress.x) >= GetSystemMetrics(SM_CXDRAG)) orelse _
                       (abs(ptY - pTabBar->ptPress.y) >= GetSystemMetrics(SM_CYDRAG)) then
                        pTabBar->bDragging = true
                        ' Pin hover to the dragged tab for the whole gesture (tracking
                        ' above is suspended while bDragging): its X stays displayed,
                        ' and no dragged-over tab can become hot.
                        pTabBar->nLastHotIdx = pTabBar->nPressedIdx
                        pTabBar->bLastHotClose = false
                        pTabBar->nLastDragX = ptX   ' seed the direction-of-travel gate
                        PsTabBar_InvalidateTab( pTabBar, pTabBar->nPressedIdx )   ' isDragging visual on
                        ' Set the move cursor here rather than waiting for WM_SETCURSOR:
                        ' that message is sent BEFORE the WM_MOUSEMOVE that starts the
                        ' drag, so leaving it to the handler above would cost one move of
                        ' visible lag on every gesture.
                        if pTabBar->hDragCursor then SetCursor( pTabBar->hDragCursor )
                    end if
                end if
                if pTabBar->bDragging andalso (idx <> -1) andalso (idx <> pTabBar->nPressedIdx) then
                    ' Exchange on entering the adjacent tab, gated on travelling toward it.
                    dim as boolean doMove
                    if idx > pTabBar->nPressedIdx then
                        doMove = (ptX > pTabBar->nLastDragX)    ' over a tab to the right, still moving right
                    else
                        doMove = (ptX < pTabBar->nLastDragX)    ' over a tab to the left, still moving left
                    end if
                    if doMove then
                        dim as integer idxFrom = pTabBar->nPressedIdx
                        pTabBar->MoveTab( idxFrom, idx )   ' remaps nCurSel / nLastHotIdx itself
                        pTabBar->nPressedIdx = idx
                        ' USER-driven move: the one path that fires the reorder callback
                        ' (programmatic PsTabBar_MoveTab stays silent). State already updated.
                        if pTabBar->ReorderCallback then pTabBar->ReorderCallback( hwnd, idxFrom, idx )
                    end if
                end if
                if pTabBar->bDragging then pTabBar->nLastDragX = ptX
            end if

            m.idx = idx
            if pTabBar->MessageCallback then
                if pTabBar->MessageCallback( @m ) then return 0
            end if
        end if

    case WM_MOUSEHOVER
        if pTabBar then
            m.idx = GetHotTabBarTab(hwnd)
            if pTabBar->MessageCallback then
                if pTabBar->MessageCallback( @m ) then return 0
            end if
        end if

    case WM_MOUSELEAVE
        if pTabBar then
            ' Fast path for clearing the hot tab (the WM_TIMER poll is the fallback for
            ' when this message never arrives). The tooltip hides itself when the mouse
            ' leaves the tool, so nothing to push. m.idx stays -1: the mouse is gone.
            ' Never while dragging -- hover is pinned to the dragged tab until the drop.
            if pTabBar->bDragging = false then
                PsTabBar_ClearHotTracking( pTabBar, hwnd )
            end if
            if pTabBar->MessageCallback then
                if pTabBar->MessageCallback( @m ) then return 0
            end if
        end if

    ' ------------------------------------------------------------------------------------
    ' The press machinery. The control TAKES capture on a press (the PsStatusBar decision
    ' reversed, deliberately -- see the declarations at the top of this file): capture is what makes "press the X,
    ' slide off, release" a reliable cancel. It pays PsVScrollBar's full price:
    '   - capture taken BEFORE the host callback can suppress anything;
    '   - released in the up-handler unconditionally, callback result IGNORED there;
    '   - WM_CAPTURECHANGED cancels the press;
    '   - WM_DESTROY releases if we still hold it.
    ' No SetFocus anywhere: a tab must not steal focus from the host's editor.
    ' ------------------------------------------------------------------------------------
    case WM_LBUTTONDOWN, WM_LBUTTONDBLCLK
        ' WM_LBUTTONDBLCLK REPLACES the second WM_LBUTTONDOWN (CS_DBLCLKS) but is still
        ' followed by its own WM_LBUTTONUP, so it must run the same press bookkeeping or
        ' that up would release a capture never taken.
        SetCapture( hwnd )
        if pTabBar then
            m.idx = GetHotTabBarTab(hwnd)
            ' Host observer first: TRUE suppresses selection and the press -- but never
            ' the capture bookkeeping, whose release is already guaranteed above.
            if pTabBar->MessageCallback then
                if pTabBar->MessageCallback( @m ) then return 0
            end if
            if m.idx <> -1 then
                pTabBar->nPressedIdx   = m.idx
                pTabBar->bPressedClose = isMouseOverRECT( hwnd, pTabBar->tabs(m.idx).rcClose )
                ' Remember where the press landed: the drag threshold measures from here.
                pTabBar->ptPress.x = cast( short, loword(lParam) )
                pTabBar->ptPress.y = cast( short, hiword(lParam) )
                ' Select on DOWN (what real tab controls do) -- unless the press landed
                ' on the close "X": closing must not first activate the closing tab.
                if (pTabBar->bPressedClose = false) andalso (m.idx <> pTabBar->nCurSel) then
                    dim as integer idxOld = pTabBar->nCurSel
                    pTabBar->nCurSel = m.idx
                    ' A partially clipped rightmost tab scrolls into view on selection.
                    pTabBar->bEnsureVisible = true
                    pTabBar->Refresh()
                    ' USER-driven change: this is the one path that fires the callback
                    ' (programmatic SetCurSel stays silent). State is already updated.
                    if pTabBar->SelChangeCallback then pTabBar->SelChangeCallback( hwnd, idxOld, m.idx )
                end if
            end if
        end if

    case WM_LBUTTONUP
        ' Save-then-clear the press BEFORE releasing: WM_CAPTURECHANGED arrives during
        ' ReleaseCapture and must find nothing to cancel.
        dim as integer pressedIdx = -1
        dim as boolean pressedClose = false
        if pTabBar then
            pressedIdx   = pTabBar->nPressedIdx
            pressedClose = pTabBar->bPressedClose
            pTabBar->nPressedIdx   = -1
            pTabBar->bPressedClose = false
            if pTabBar->bDragging then
                ' The drop itself: the array is already in its final order (live
                ' reordering), so ending the drag is just turning the visual off.
                pTabBar->bDragging = false
                PsTabBar_InvalidateTab( pTabBar, pressedIdx )
                PsTabBar_RestoreCursor( hwnd )
            end if
        end if
        if GetCapture() = hwnd then ReleaseCapture()
        if pTabBar then
            m.idx = GetHotTabBarTab(hwnd)
            ' Result IGNORED: this message just released the capture, and a callback
            ' must never be able to strand that (Learnings.md, the PsListBox bug).
            if pTabBar->MessageCallback then pTabBar->MessageCallback( @m )
            ' Close fires only on a MATCHED gesture: pressed this tab's X, and released
            ' still on this tab's X. Capture is what routed the outside-release here as
            ' idx = -1, making slide-off a reliable cancel.
            if pressedClose andalso (pressedIdx <> -1) andalso (pressedIdx = m.idx) then
                if isMouseOverRECT( hwnd, pTabBar->tabs(m.idx).rcClose ) then
                    if pTabBar->CloseCallback then pTabBar->CloseCallback( hwnd, m.idx )
                end if
            end if
        end if

    case WM_MBUTTONDOWN
        ' Middle-click closes a tab (editor convention): same capture shape as the left
        ' press, same matched down+up rule -- just anywhere on the tab, not only the X.
        SetCapture( hwnd )
        if pTabBar then
            m.idx = GetHotTabBarTab(hwnd)
            if pTabBar->MessageCallback then
                if pTabBar->MessageCallback( @m ) then return 0
            end if
            pTabBar->nPressedMidIdx = m.idx
        end if

    case WM_MBUTTONUP
        dim as integer pressedMid = -1
        if pTabBar then
            pressedMid = pTabBar->nPressedMidIdx
            pTabBar->nPressedMidIdx = -1
        end if
        if GetCapture() = hwnd then ReleaseCapture()
        if pTabBar then
            m.idx = GetHotTabBarTab(hwnd)
            if pTabBar->MessageCallback then pTabBar->MessageCallback( @m )   ' result IGNORED
            if (pressedMid <> -1) andalso (pressedMid = m.idx) then
                if pTabBar->CloseCallback then pTabBar->CloseCallback( hwnd, m.idx )
            end if
        end if

    case WM_RBUTTONDOWN
        ' Observer only: no press semantics, no capture.
        if pTabBar then
            m.idx = GetHotTabBarTab(hwnd)
            if pTabBar->MessageCallback then
                if pTabBar->MessageCallback( @m ) then return 0
            end if
        end if

    case WM_MOUSEWHEEL
        ' Wheel steps the scroll position through the same gate as the nav buttons.
        ' Reaches us on Win10+ via the scroll-under-cursor setting (on by default);
        ' a host can also forward wheel messages here explicitly.
        if pTabBar then
            m.idx = GetHotTabBarTab(hwnd)
            if pTabBar->MessageCallback then
                if pTabBar->MessageCallback( @m ) then return 0   ' host suppressed the scroll
            end if
            dim as integer delta = cast( short, HIWORD(wParam) )
            PsTabBar_Navigate( hwnd, iif( delta > 0, -1, 1 ) )    ' wheel up = left
            return 0
        end if

    case WM_CAPTURECHANGED
        ' Someone stole the capture mid-press (Alt-Tab, a menu, another SetCapture).
        ' The gesture is dead: cancel the press so no click can fire from its corpse.
        ' A drag ends here too, WITHOUT restoring the original order: reordering is
        ' live, so every intermediate order is already a legitimate, notified state.
        if pTabBar then
            dim as integer wasDragIdx = iif( pTabBar->bDragging, pTabBar->nPressedIdx, -1 )
            pTabBar->nPressedIdx    = -1
            pTabBar->bPressedClose  = false
            pTabBar->nPressedMidIdx = -1
            pTabBar->bDragging      = false
            PsTabBar_InvalidateTab( pTabBar, wasDragIdx )   ' no-op for -1
            if wasDragIdx <> -1 then PsTabBar_RestoreCursor( hwnd )
        end if

    case WM_NOTIFY
        ' The tooltip asks for its text on demand; supply the current hot tab's.
        dim as NMHDR ptr pnmh = cast(NMHDR ptr, lParam)
        if (pnmh <> 0) andalso (pnmh->code = TTN_GETDISPINFOW) then
            if pTabBar then
                dim as NMTTDISPINFOW ptr pdi = cast(NMTTDISPINFOW ptr, lParam)
                ' store in an instance-lifetime buffer and point lpszText at it
                pTabBar->wszTooltip = PsTabBar_ResolveTooltipText( pTabBar, pTabBar->nLastHotIdx )
                pdi->lpszText = cast( LPWSTR, strptr(pTabBar->wszTooltip) )
                pdi->hinst    = NULL
            end if
            return 0
        end if

    case WM_DESTROY
        PsRegistry_Remove( hwnd )
        ' Don't let the hot-tracking timer -- or a live mouse capture -- outlive the window.
        if (pTabBar <> 0) andalso pTabBar->hotTimerOn then
            KillTimer( hwnd, IDT_CTABBAR_HOTTRACK )
            pTabBar->hotTimerOn = false
        end if
        if GetCapture() = hwnd then ReleaseCapture()

    case WM_NCDESTROY
        ' Delete the stored tab data pointer
        if pTabBar then
            PsTipHost_Destroy( @pTabBar->tip )
            delete(pTabBar)
        end if

        ' delete the allocated memory for window
        dim as CWindow ptr pWindow = CWindowPtr(hwnd)
        if pWindow then delete(pWindow)
        return 0

    case WM_ERASEBKGND
        ' Never erase: WM_PAINT fills the whole client through the double buffer, so a
        ' background erase here would only add flicker.
        return true

    end select

    ' for messages that we don't deal with
    function = DefWindowProc( hwnd, uMsg, wParam, lParam )

end function


' ========================================================================================
' Supply the tooltip text to the PsTooltip backend.
'
' This thunk is why PsTipHost never learns the text policy: PsTabBar_ResolveTooltipText
' stays the ONE place that decides what a tip says, and the system backend reaches the
' same function by the other road (comctl32 asking through TTN_GETDISPINFOW), which is
' why that arm stays in the WndProc.
' ========================================================================================
private function PsTabBar_TipTextCallback( byval hTooltip as HWND, byval hAttached as HWND, _
                                        byval idx as long ) as ustring
    dim as ustring wszOut = PsTabBar_ResolveTooltipText( GetTabBarPointer(hAttached), cast(integer, idx) )
    return wszOut
end function


' ========================================================================================
' PsTabBar_Create
' ========================================================================================
public function PsTabBar_Create( byval hWndParent as HWND, byval CtrlID as integer ) as HWND

    dim pWindow as CWindow ptr = New CWindow

    dim as HWND hCtrl = _
            pWindow->Create( hWndParent, "", @PsTabBar_WndProc, _
            0, 0, 0, 0, WS_CHILD or WS_CLIPSIBLINGS or WS_CLIPCHILDREN _
            )
    ' Enable double-click messages (WM_LBUTTONDBLCLK) on the control's window class,
    ' preserving the class's existing styles rather than replacing them. (CWindow's
    ' ClassStyle setter REPLACES, so this must be read-modify-write, and it needs
    ' m_hwnd -- i.e. it only works after Create.)
    pWindow->ClassStyle = pWindow->ClassStyle or CS_DBLCLKS

    ' Define the TYPE that holds all the information about this custom tab bar.
    dim as PSTABBAR_STATE ptr pTabBar = new PSTABBAR_STATE
    pTabBar->hWin = hCtrl
    pTabBar->idc_TabBar = CtrlID
    pTabBar->nPadding    = pWindow->ScaleX( PSTABBAR_DEFAULT_PADDING )
    pTabBar->nIconWidth  = pWindow->ScaleX( PSTABBAR_DEFAULT_ICONWIDTH )
    pTabBar->nBorderWidth = pWindow->ScaleX( 1 )
    if pTabBar->nBorderWidth < 1 then pTabBar->nBorderWidth = 1
    ' Shared system cursor: loaded once, never destroyed (DestroyCursor is only for
    ' cursors the caller created).
    pTabBar->hDragCursor = LoadCursor( null, IDC_SIZEALL )
    SetWindowLongPtr( hCtrl, GWLP_ID, CtrlID )

    ' Store the new pointer into the user data area of the tab window
    pWindow->UserData(0) = cast(LONG_PTR, pTabBar)

    ' AFTER UserData, not before: PsTabBar_TipTextCallback resolves the control through
    ' GetTabBarPointer(hAttached), which reads exactly that slot.
    PsTipHost_Ensure( @pTabBar->tip, hCtrl, @PsTabBar_TipTextCallback )
    
    ' The theme and the form's fonts, applied now if a PsApp program has them (PsRegistry).
    PsRegistry_SetThemeProcs( hCtrl, @PsTabBar_ApplyTheme, @PsTabBar_ApplyFonts, @PsTabBar_Rescale )

    function = hCtrl
    
end function
