function PsProgressBar_GetTextMode( byval hProgressBar as HWND ) as long
    dim as PSPROGRESSBAR_STATE ptr pBar = GetProgressBarPointer(hProgressBar)
    if pBar = 0 then return PRG_TEXT_NONE
    return pBar->nTextMode
end function

public sub PsProgressBar_SetTextMode( byval hProgressBar as HWND, byval nTextMode as long )
    dim as PSPROGRESSBAR_STATE ptr pBar = GetProgressBarPointer(hProgressBar)
    if pBar = 0 then exit sub
    dim as long m = nTextMode
    if (m < PRG_TEXT_NONE) orelse (m > PRG_TEXT_CALLBACK) then m = PRG_TEXT_NONE
    if m = pBar->nTextMode then exit sub
    pBar->nTextMode = m
    if pBar->hWin then InvalidateRect( pBar->hWin, NULL, FALSE )
end sub

function PsProgressBar_GetFont( byval hProgressBar as HWND ) as HFONT
    dim as PSPROGRESSBAR_STATE ptr pBar = GetProgressBarPointer(hProgressBar)
    if pBar = 0 then return 0
    return pBar->hFont
end function

' BORROWED, not owned. The caller keeps the handle and must outlive the control -- the family
' rule, and the reason no control here ever calls CreateFont.
public sub PsProgressBar_SetFont( byval hProgressBar as HWND, byval hFont as HFONT )
    dim as PSPROGRESSBAR_STATE ptr pBar = GetProgressBarPointer(hProgressBar)
    if pBar = 0 then exit sub
    pBar->hFont = hFont
    if pBar->hWin then InvalidateRect( pBar->hWin, NULL, FALSE )
end sub

function PsProgressBar_GetDisplayText( byval hProgressBar as HWND ) as ustring
    return PRG_ResolveText( GetProgressBarPointer(hProgressBar) )
end function


' ========================================================================================
' Colors
' ========================================================================================
sub PsProgressBar_GetColors( byval hProgressBar as HWND, byval pColors as PSPROGRESSBAR_COLORS ptr )
    dim as PSPROGRESSBAR_STATE ptr pBar = GetProgressBarPointer(hProgressBar)
    if (pBar = 0) orelse (pColors = 0) then exit sub
    *pColors = pBar->colors
end sub

sub PsProgressBar_SetColors( byval hProgressBar as HWND, byval pColors as PSPROGRESSBAR_COLORS ptr )
    dim as PSPROGRESSBAR_STATE ptr pBar = GetProgressBarPointer(hProgressBar)
    if (pBar = 0) orelse (pColors = 0) then exit sub
    pBar->colors = *pColors
    pBar->bColorsPinned = true
    if pBar->hWin then InvalidateRect( pBar->hWin, NULL, FALSE )
end sub

' ========================================================================================
' The theme (vendor/PsControls/PsTheme). ThemeColors is the adapter: the bar's colours
' derived from the theme's roles. ApplyTheme applies them unless the host pinned its own.
' Each state's End stop takes the same role as its start, so a themed gradient is flat.
' ========================================================================================
public function PsProgressBar_ThemeColors( byref t as PSTHEME_COLORS ) as PSPROGRESSBAR_COLORS
    dim as PSPROGRESSBAR_COLORS c
    c.BackColor           = t.Window
    c.TrackColor          = t.Track
    c.TrackBorderColor    = t.Border
    c.BarColor            = t.Accent
    c.BarColorEnd         = t.Accent
    c.BarColorPaused      = t.Warning
    c.BarColorPausedEnd   = t.Warning
    c.BarColorError       = t.Error
    c.BarColorErrorEnd    = t.Error
    c.BarColorDisabled    = t.TextDisabled
    c.BarColorDisabledEnd = t.TextDisabled
    c.TextColor           = t.Text
    c.TextColorOnBar      = t.SelectedText
    c.TextColorDisabled   = t.TextDisabled
    return c
end function

public sub PsProgressBar_ApplyTheme( byval hProgressBar as HWND, byref t as PSTHEME_COLORS )
    dim as PSPROGRESSBAR_STATE ptr pBar = GetProgressBarPointer(hProgressBar)
    if (pBar = 0) orelse pBar->bColorsPinned then exit sub
    dim as PSPROGRESSBAR_COLORS c = PsProgressBar_ThemeColors( t )
    PsProgressBar_SetColors( hProgressBar, @c )
    pBar->bColorsPinned = false
end sub

' Hands the bar back to the theme, which is applied at once.
public sub PsProgressBar_UnpinColors( byval hProgressBar as HWND )
    dim as PSPROGRESSBAR_STATE ptr pBar = GetProgressBarPointer(hProgressBar)
    if pBar = 0 then exit sub
    pBar->bColorsPinned = false
    dim as PSTHEME_COLORS t
    if PsRegistry_GetTheme( t ) then PsProgressBar_ApplyTheme( hProgressBar, t )
end sub

' The form's fonts (PsApp), handed over when the bar is created on a form. No glyph font.
public sub PsProgressBar_ApplyFonts( byval hProgressBar as HWND, byval hTextFont as HFONT, byval hGlyphFont as HFONT )
    if hTextFont then PsProgressBar_SetFont( hProgressBar, hTextFont )
end sub

' ========================================================================================
' Per-monitor DPI. Every stored pixel metric -- the scaled Create defaults and
' whatever the host set since -- times newDpi/oldDpi, the marquee step included (it is a
' pixel distance per tick). nBorderThick and nCurvature stay as they are: both are documented
' as never DPI-scaled (the curvature is a sentinel or a host-chosen corner size). The bar's
' own CWindow takes the new DPI. The fonts are not ours: PsApp hands new ones over after this.
' ========================================================================================
public sub PsProgressBar_Rescale( byval hProgressBar as HWND, byval oldDpi as long, byval newDpi as long )
    dim as PSPROGRESSBAR_STATE ptr pBar = GetProgressBarPointer(hProgressBar)
    if (pBar = 0) orelse (oldDpi <= 0) orelse (newDpi <= 0) orelse (oldDpi = newDpi) then exit sub
    pBar->nThickness   = MulDiv( pBar->nThickness,   newDpi, oldDpi )
    pBar->nBarInset    = MulDiv( pBar->nBarInset,    newDpi, oldDpi )
    pBar->nBlockLength = MulDiv( pBar->nBlockLength, newDpi, oldDpi )
    pBar->nBlockGap    = MulDiv( pBar->nBlockGap,    newDpi, oldDpi )
    pBar->nMarqueeStep = MulDiv( pBar->nMarqueeStep, newDpi, oldDpi )
    if pBar->nBlockLength < 1 then pBar->nBlockLength = 1
    if pBar->nMarqueeStep < 1 then pBar->nMarqueeStep = 1
    dim as CWindow ptr pWindow = CWindowPtr( hProgressBar )
    if pWindow then pWindow->DPI = newDpi
    pBar->Refresh()
end sub

sub PsProgressBar_ResolveBarColors( byval hProgressBar as HWND, byref clr1 as COLORREF, byref clr2 as COLORREF )
    PRG_ResolveColors( GetProgressBarPointer(hProgressBar), clr1, clr2 )
end sub


