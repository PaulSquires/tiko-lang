' at nMax where PBM_STEPIT wraps around to nMin -- a wrap makes a finished job look restarted.
public declare function PsProgressBar_StepIt( byval hProgressBar as HWND ) as long
public declare function PsProgressBar_DeltaPos( byval hProgressBar as HWND, byval nDelta as long ) as long
public declare function PsProgressBar_GetPercent( byval hProgressBar as HWND ) as long

