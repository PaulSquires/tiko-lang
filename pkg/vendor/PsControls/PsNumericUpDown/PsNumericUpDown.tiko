''  vendor/PsControls/PsNumericUpDown  --  owner-drawn numeric up/down (spinner) with an editable value
''

#module "PsNumericUpDown"

#ifndef TIKO_OS_WINDOWS
    #error "vendor/PsControls is Windows-only (Win32 controls): build for -target windows-x86_64, or use vendor/tkControls"
#endif

#import "sys/win"
#import "sys/win/gui"
#import "sys/win/gdiplus"
#import "vendor/PsControls/PsBufferPaint"
#import "vendor/PsControls/PsTextBox"
#import "vendor/PsControls/PsRegistry"
#import "vendor/PsControls/PsTheme"

using gui
using gdiplus
using PsBufferPaint
using PsTextBox
using PsRegistry
using PsTheme

#include once "vbcompat.bi"                 ' format()

' Polling timer that guarantees hot-tracking is cleared when the mouse leaves a button.
' WM_MOUSELEAVE (TME_LEAVE) is not reliably delivered on fast exits, AND the PsTextBox child
' covers the middle of our client, so a periodic cursor check is the safety net. Timer ids
' are per-window, so every instance can share these two.
public const IDT_CNUMERICUPDOWN_HOTTRACK = &hCB80
public const IDT_CNUMERICUPDOWN_REPEAT = &hCB81
public const PSNUMERICUPDOWN_HOTTRACK_MS = 100

' Defaults. The SIZE values are DPI-scaled at Create; every setter afterwards takes raw
' pixels and the caller scales (the family rule).
'
' TWO of the three THICKNESS values are NOT DPI-scaled, ever -- a hairline should stay a
' hairline (PsMenuBar's nSeparatorThickness rule): the border and the divider are RULES, and a
' rule that thickens with the display stops reading as a rule.
'
' THE GLYPH THICKNESS IS THE EXCEPTION, and the asymmetry is deliberate -- do not "harmonise"
' it. The bars of the "-" and "+" are not rules, they are the strokes of an ICON, and an icon
' whose length scales while its weight does not gets thinner and thinner relative to itself as
' the display scales. At 1.75x an unscaled bar is 18 pixels long and 1 thick, which reads as a
' thread rather than a minus sign. Asked of a real screenshot, not reasoned about.
public const CNUD_DEFAULT_BUTTONW = 28
public const CNUD_DEFAULT_VALUEPAD = 6   ' left and right, inside the value cell
public const CNUD_DEFAULT_VERTPAD = 5   ' above and below the text, for GetIdealSize
public const CNUD_DEFAULT_CORNERRADIUS = 6
public const CNUD_DEFAULT_BORDERTHICK = 1   ' not DPI-scaled
public const CNUD_DEFAULT_DIVIDERTHICK = 1   ' not DPI-scaled
public const CNUD_DEFAULT_GLYPHLENGTH = 10   ' the bar of the "-", and each bar of the "+"
public const CNUD_DEFAULT_GLYPHTHICK = 1   ' DPI-scaled -- it is an icon stroke, not a rule

' Auto-repeat: hold a button and it keeps stepping. Delay before the first repeat, then one
' step per interval. Either at 0 disables repeating entirely (one click = one step).
public const CNUD_DEFAULT_REPEATDELAY = 400
public const CNUD_DEFAULT_REPEATINTERVAL = 60

' Value defaults. The range is deliberately wide: a host that never calls SetRange gets a
' control that does not silently clamp, but the range machinery is always present so the
' buttons can grey out at a limit.
public const CNUD_DEFAULT_MIN = -1000000.0
public const CNUD_DEFAULT_MAX = 1000000.0
public const CNUD_DEFAULT_INCREMENT = 1.0
public const CNUD_DEFAULT_DECIMALPLACES = 0

' The three hit-testable parts, plus "nothing". The value cell is reported by HitTest for
' completeness, but the control never acts on it -- that area belongs to the PsTextBox child,
' which receives its own mouse messages and never routes them here.
public enum
    NUD_PART_NONE = 0
    NUD_PART_MINUS
    NUD_PART_VALUE
    NUD_PART_PLUS
end enum


' Colors for the built-in painter. Copied on Set.
'
' Flat COLORREF fields with defaults, exactly like PSTOGGLE_COLORS and PSSELECTBAR_COLORS --
' read-modify-write is PsNumericUpDown_GetColors, assign, PsNumericUpDown_SetColors.
'
' THE CONTROL READS AS ONE FLAT CELL until you hover a button, because ButtonBackColor is
' defaulted EQUAL to ValueBackColor. That is PsSelectBar's trick (BackColorHot = BackColor)
' applied the other way round, and it is what makes the dividers the only thing separating
' the three parts at rest. A host that wants visibly raised buttons just sets the field.
'
' The value cell's two colors are pushed into the embedded PsTextBox rather than painted by
' us -- the RichEdit draws the number. They live here so a host sets every color of the
' control in one place, which is the point of the struct.
public type PSNUMERICUPDOWN_COLORS
    BackColor                as COLORREF = BGR( 33, 37, 43)   ' behind the rounded corners
    BorderColor              as COLORREF = BGR( 60, 66, 77)
    FocusBorderColor         as COLORREF = BGR( 86,156,214)   ' while the value field has focus
    BorderColorDisabled      as COLORREF = BGR( 48, 52, 60)
    DividerColor             as COLORREF = BGR( 60, 66, 77)
    DividerColorDisabled     as COLORREF = BGR( 48, 52, 60)
    ' --- the value cell (handed to the PsTextBox, not painted here) ---
    ValueBackColor           as COLORREF = BGR( 44, 49, 58)
    ValueForeColor           as COLORREF = BGR(215,218,224)
    ValueBackColorDisabled   as COLORREF = BGR( 38, 42, 49)
    ValueForeColorDisabled   as COLORREF = BGR( 90, 96,106)
    ' --- the two button cells ---
    ButtonBackColor          as COLORREF = BGR( 44, 49, 58)   ' = ValueBackColor (see above)
    ButtonBackColorHot       as COLORREF = BGR( 56, 62, 73)
    ButtonBackColorPressed   as COLORREF = BGR( 38, 79,120)
    ButtonBackColorDisabled  as COLORREF = BGR( 38, 42, 49)
    GlyphColor               as COLORREF = BGR(190,196,206)
    GlyphColorHot            as COLORREF = BGR(255,255,255)
    GlyphColorPressed        as COLORREF = BGR(255,255,255)
    GlyphColorDisabled       as COLORREF = BGR( 90, 96,106)
end type


' Everything the painter needs. Every rect is precomputed by LayoutControl -- never
' re-derive one from another, and in particular never derive a glyph bar from its cell by
' repeating the centring arithmetic, because SetGlyphSize can change it underneath you.
'
' NOTE WHAT IS NOT HERE: the value text. It is drawn by the RichEdit inside the embedded
' PsTextBox, not by this control and not by a paint callback. A callback replaces the frame,
' the cells, the dividers and the glyphs -- never the number.
public type PSNUMERICUPDOWN_PAINTINFO
    hCtrl        as HWND                ' the control, so the callback can query it
    b            as PsPaintBuffer ptr    ' the control's buffer for this repaint (no copy)
    ' --- Geometry, all precomputed by LayoutControl ---
    rcClient     as RECT                ' the whole client area
    rcFrame      as RECT                ' where the rounded border is stroked
    rcMinus      as RECT                ' the left button cell
    rcDiv1       as RECT                ' the hairline between the "-" cell and the value
    rcValue      as RECT                ' the value cell -- the PsTextBox child sits exactly here
    rcDiv2       as RECT                ' the hairline between the value and the "+" cell
    rcPlus       as RECT                ' the right button cell
    rcMinusBar   as RECT                ' the "-" glyph
    rcPlusBarH   as RECT                ' the "+" glyph, horizontal bar
    rcPlusBarV   as RECT                ' the "+" glyph, vertical bar
    ' --- State: the control decides these, you only render. ---
    hotPart      as long                ' NUD_PART_* under the cursor (NONE if not hot)
    pressedPart  as long                ' NUD_PART_* held down AND the cursor still inside
    isEnabled    as boolean
    isFocused    as boolean             ' the value field owns the keyboard focus
    bAtMin       as boolean             ' the "-" button can do nothing: draw it disabled
    bAtMax       as boolean             ' likewise the "+" button
    nValue       as double              ' the current value, already clamped and rounded
end type

public type PSNUMERICUPDOWN_MESSAGEINFO
    hCtrl        as HWND
    uMsg         as UINT
    wParam       as WPARAM
    lParam       as LPARAM
end type


' Draw the whole control, INSTEAD OF the built-in painter. Paint through p->b (the control's
' double buffer for this repaint) -- do not touch the screen DC.
'
' The control has already filled the client with BackColor before calling you, so a callback
' that only wants to add something on top does not have to repaint the background.
'
' It does NOT draw the number: that is the RichEdit child's job, and it paints itself over
' whatever this callback puts in rcValue.
public type NUD_PaintCallbackSub as sub( byval p as PSNUMERICUPDOWN_PAINTINFO ptr )

' Observe messages. Return TRUE if you handled it and want the control's default handling
' suppressed, FALSE to let it proceed.
'
' TWO SOURCES FEED THIS ONE CALLBACK. The container's own messages (the mouse over the two
' buttons, the timers, enable/disable) arrive directly; the value field's key, wheel and
' focus messages arrive relayed from the embedded PsTextBox's own message callback, with
' m->hCtrl rewritten to THIS control. So a host sees one message stream for the whole
' control and never has to know a RichEdit is in there.
'
' CAUTION: the result is IGNORED for two messages.
'   WM_LBUTTONUP  - the control holds mouse capture across a button press and the up-message
'                   is what releases it: a callback that suppressed it would strand capture
'                   and route every subsequent click here (the PsListBox bug recorded in
'                   Learnings.md). Suppressing WM_LBUTTONDOWN suppresses the press, never
'                   the capture bookkeeping.
'   WM_KILLFOCUS  - focus loss is what COMMITS a typed value. Suppressing it would leave the
'                   control displaying text it has not accepted. (WM_SETFOCUS may be
'                   suppressed; nothing depends on it but the border color.)
public type NUD_MessageCallbackFunc as function( byval m as PSNUMERICUPDOWN_MESSAGEINFO ptr ) as boolean

' The value changed through USER interaction. Fired AFTER the value is clamped, rounded and
' displayed, so PsNumericUpDown_GetValue() = nValue inside the handler.
'
' WHEN IT FIRES: immediately for a button click, an auto-repeat tick, an arrow key, PgUp/PgDn
' and the wheel -- every one of those produces a complete value. For TYPING it fires on
' COMMIT ONLY (ENTER, or focus leaving the field), which is also when the typed text is
' clamped and reformatted. Typing "16" therefore never reports the transient 1.
'
' The programmatic setters (SetValue, SetRange, SetDecimalPlaces, StepUp, StepDown) are all
' SILENT -- Win32's BM_SETCHECK / BN_CLICKED precedent, and what makes it safe to call one
' from inside this handler.
public type NUD_ValueChangedCallbackSub as sub( byval hCtrl as HWND, byval nValue as double )


public type PSNUMERICUPDOWN_STATE
    hWin            as HWND
    ' TRUE once the host set the colours itself (PsNumericUpDown_SetColors): the theme then
    ' leaves this control alone until PsNumericUpDown_UnpinColors.
    bColorsPinned   as boolean
    hTextBox        as HWND               ' the embedded PsTextBox (numeric mode, borderless)
    idc_Ctrl        as long = 0
    ' --- State. Single-valued: there is exactly one of this control, so unlike the
    '     collection siblings there are no indices here to be left dangling. ---
    isEnabled       as boolean = true
    isFocused       as boolean = false    ' the value field has the keyboard focus
    bReadOnly       as boolean = false
    hotPart         as long = NUD_PART_NONE
    pressedPart     as long = NUD_PART_NONE   ' which button is held (see the capture note)
    hotTimerOn      as boolean = false
    repeatTimerOn   as boolean = false
    ' --- Press state (mouse capture). The control TAKES capture on a button press: the
    '     press/cancel gesture (press, slide off the button, release, the value does NOT
    '     step) consumes the guaranteed down->up pairing, which is the family's test for
    '     taking capture. It pays the full price: snapshot the press BEFORE releasing
    '     (ReleaseCapture sends WM_CAPTURECHANGED synchronously -- Learnings.md), release on
    '     the up-message before any callback runs, WM_CAPTURECHANGED cancels the press and
    '     kills the repeat timer, WM_DESTROY releases, and no callback may suppress an
    '     up-message. ---
    ' --- Value. THE PSTEXTBOX_STATE'S TEXT IS THE SOURCE OF TRUTH; nValue is the last value the
    '     control committed, kept only so a change can be detected and reported once. ---
    nValue          as double = 0.0
    nMin            as double = CNUD_DEFAULT_MIN
    nMax            as double = CNUD_DEFAULT_MAX
    nIncrement      as double = CNUD_DEFAULT_INCREMENT
    nLargeIncrement as double = CNUD_DEFAULT_INCREMENT * 10.0
    nDecimalPlaces  as long   = CNUD_DEFAULT_DECIMALPLACES
    nRepeatDelayMs    as long = CNUD_DEFAULT_REPEATDELAY
    nRepeatIntervalMs as long = CNUD_DEFAULT_REPEATINTERVAL
    ' Sub-notch wheel accumulation, the scrollbar siblings' rule: a precision touchpad sends
    ' deltas well under one 120 notch, and truncating each one would ignore a slow swipe
    ' entirely.
    nWheelAccum     as long = 0
    colors          as PSNUMERICUPDOWN_COLORS
    hFont           as HFONT = 0          ' CALLER-OWNED; never deleted here
    ' --- Layout. Rects are DERIVED, never set from outside; LayoutControl() owns them.
    '     Layout is lazy: mutators mark it dirty, the next paint (or any rect query) runs
    '     it. LayoutControl takes NO DC -- every cell is derived from the client rect and
    '     authored scalars, and nothing in it is measured. Only GetIdealSize measures, and
    '     it takes its own DC to do it. ---
    nButtonWidth    as long = CNUD_DEFAULT_BUTTONW        ' DPI-scaled at Create
    nValuePadLeft   as long = CNUD_DEFAULT_VALUEPAD       ' DPI-scaled at Create
    nValuePadRight  as long = CNUD_DEFAULT_VALUEPAD       ' DPI-scaled at Create
    nVertPadding    as long = CNUD_DEFAULT_VERTPAD        ' DPI-scaled at Create
    nCornerRadius   as long = CNUD_DEFAULT_CORNERRADIUS   ' DPI-scaled at Create
    nBorderThick    as long = CNUD_DEFAULT_BORDERTHICK    ' NOT DPI-scaled
    nDividerThick   as long = CNUD_DEFAULT_DIVIDERTHICK   ' NOT DPI-scaled
    nGlyphLength    as long = CNUD_DEFAULT_GLYPHLENGTH    ' DPI-scaled at Create
    nGlyphThick     as long = CNUD_DEFAULT_GLYPHTHICK     ' DPI-scaled at Create (see above)
    rcFrame         as RECT               ' derived
    rcMinus         as RECT               ' derived
    rcDiv1          as RECT               ' derived
    rcValue         as RECT               ' derived
    rcDiv2          as RECT               ' derived
    rcPlus          as RECT               ' derived
    rcMinusBar      as RECT               ' derived
    rcPlusBarH      as RECT               ' derived
    rcPlusBarV      as RECT               ' derived
    bLayoutDirty    as boolean = true
    PaintCallback        as NUD_PaintCallbackSub          ' optional; replaces the built-in painter
    MessageCallback      as NUD_MessageCallbackFunc       ' optional
    ValueChangedCallback as NUD_ValueChangedCallbackSub   ' optional; user-driven changes only

    declare sub      LayoutControl()
    declare function ClampToRange( byval nValue as double ) as double
    declare function SnapToPlaces( byval nValue as double ) as double
    declare sub      CancelPress()
    declare sub      Refresh()
end type


' Round to the decimal grid the control displays on. Applied after EVERY step, not merely on
' display: adding 0.1 ten times to a binary double lands on 0.9999999999999999, and a value
' that is a hair below the grid formats correctly but compares wrong -- so the drift would be
' invisible until the range check at a limit disagreed with the text on screen.
function PSNUMERICUPDOWN_STATE.SnapToPlaces( byval nValue as double ) as double
    dim as double scaleBy = 10.0 ^ this.nDecimalPlaces
    ' Int(x + 0.5) rounds half away from zero for positives; mirror it for negatives so
    ' -0.5 rounds to -1 rather than to 0 (FreeBASIC's Int floors).
    if nValue < 0 then return -int( (-nValue * scaleBy) + 0.5 ) / scaleBy
    return int( (nValue * scaleBy) + 0.5 ) / scaleBy
end function

' Clamp into [nMin, nMax]. A host that sets an inverted range (min > max) gets nMin, which is
' at least deterministic; the setter also swaps them, so this is only reachable if the fields
' are written directly.
function PSNUMERICUPDOWN_STATE.ClampToRange( byval nValue as double ) as double
    if nValue > this.nMax then nValue = this.nMax
    if nValue < this.nMin then nValue = this.nMin
    return nValue
end function


' Assign every rect. This is the only place the control's geometry is produced; painting,
' the child's placement, invalidation and every public rect query consume it.
'
'   rcFrame  = the whole client (the rounded border is stroked INSIDE it, over the cells)
'
'   rcMinus  = client.left ..              client.left + nButtonWidth
'   rcDiv1   = rcMinus.right ..            + nDividerThick
'   rcPlus   = client.right - nButtonWidth .. client.right
'   rcDiv2   = rcPlus.left - nDividerThick .. rcPlus.left
'   rcValue  = rcDiv1.right ..             rcDiv2.left       (the PsTextBox goes exactly here)
'
' THE CELLS ARE NOT DEFLATED BY THE BORDER, and that is deliberate. The button cells have to
' reach the frame's rounded corners: a cell inset by the border width would round its own
' corners a pixel inside the frame's, leaving a sliver of the base fill showing through
' whenever a hovered button's color differs from it. So the cells span the full client and
' the border is stroked over their outer edges, last.
'
' rcValue IS inset vertically, and only rcValue. The PsTextBox child covers every pixel of
' that rect and paints its own background there -- so a full-height value cell would put the
' child on top of the frame's top and bottom rows and the border would be interrupted across
' the middle of the control. Nothing else needs the inset, because nothing else is covered by
' a child window.
'
' The inset is nBorderThick PLUS nVertPadding. nBorderThick alone keeps the child off the
' frame's rows; the nVertPadding term (DPI-scaled) is what gives the borderless RichEdit's
' full-height line and selection highlight clearance from the frame. Without it the child sat
' one UNSCALED pixel inside the border and the text clipped top and bottom at scaled DPI. This
' also makes the cell match what GetIdealSize already reserves (2*nVertPadding + 2*nBorderThick):
' at ideal height the value cell is exactly tmHeight tall, centred in the frame.
'
'   the glyph bars are centred in their own cell:
'     rcMinusBar = nGlyphLength x nGlyphThick,  centred in rcMinus
'     rcPlusBarH = nGlyphLength x nGlyphThick,  centred in rcPlus
'     rcPlusBarV = nGlyphThick  x nGlyphLength, centred in rcPlus
'
' Both "+" bars are centred on the SAME cell centre rather than one being derived from the
' other, so the cross is exactly symmetric whatever the parity of the cell and the bar.
'
' OVERFLOW: when the inner width cannot hold both buttons and both dividers, the value cell
' collapses to zero width (left = right) and the buttons keep their size, clipping at the
' client edge. Rects are computed HONESTLY rather than squeezed (PsIconPanel's and PsTabBar's
' rule), so the buttons stay square and only what is past the edge is lost. rcValue is never
' allowed to invert -- a negative-width rect handed to SetWindowPos is a different kind of
' bug from a clipped one.
'
' NO DC IS TAKEN. Every number above is authored or derived from the client rect; the value
' text is measured by the RichEdit, not by us. PsNumericUpDown_GetIdealSize is the one place
' this control measures anything, and it opens its own DC.
sub PSNUMERICUPDOWN_STATE.LayoutControl()
    this.bLayoutDirty = false
    if this.hWin = 0 then exit sub

    dim as RECT rcClient
    GetClientRect( this.hWin, @rcClient )
    dim as long clientW = rcClient.right - rcClient.left
    dim as long clientH = rcClient.bottom - rcClient.top

    ' No geometry yet (created 0x0, sized only once the host shows us). Placement is
    ' impossible, so leave the rects alone and ask to be run again. Note that
    ' PsNumericUpDown_GetIdealSize deliberately does NOT come through here -- it is computed
    ' from the scalars and a measured string, because a host calls it to decide how big to
    ' make the control in the first place.
    if (clientW <= 0) orelse (clientH <= 0) then
        this.bLayoutDirty = true
        exit sub
    end if

    this.rcFrame = rcClient

    dim as long L = rcClient.left
    dim as long T = rcClient.top
    dim as long R = rcClient.right
    dim as long B = rcClient.bottom

    SetRect( @this.rcMinus, L, T, L + this.nButtonWidth, B )
    SetRect( @this.rcDiv1, this.rcMinus.right, T, this.rcMinus.right + this.nDividerThick, B )
    SetRect( @this.rcPlus, R - this.nButtonWidth, T, R, B )
    SetRect( @this.rcDiv2, this.rcPlus.left - this.nDividerThick, T, this.rcPlus.left, B )

    ' The value cell alone is inset vertically -- see the note above: it is the only rect a
    ' child window covers. The inset is nBorderThick (keeps the child off the frame's rows)
    ' plus nVertPadding (DPI-scaled clearance so the borderless RichEdit's full-height line
    ' does not clip against the frame). vpad collapses gracefully on a control shorter than
    ' ideal via the valueB < valueT guard below.
    dim as long bt = this.nBorderThick
    dim as long vpad = this.nVertPadding
    dim as long valueL = this.rcDiv1.right
    dim as long valueR = this.rcDiv2.left
    if valueR < valueL then valueR = valueL
    dim as long valueT = T + bt + vpad
    dim as long valueB = B - bt - vpad
    if valueB < valueT then
        ' Not enough height for the full padding: fall back to a centred cell of whatever
        ' height remains inside the border, so a too-short control still shows its value.
        valueT = T + bt
        valueB = B - bt
        if valueB < valueT then valueB = valueT
    end if
    SetRect( @this.rcValue, valueL, valueT, valueR, valueB )

    ' --- the glyphs ---------------------------------------------------------------------
    dim as long gl = this.nGlyphLength
    dim as long gt = this.nGlyphThick
    if gl < 1 then gl = 1
    if gt < 1 then gt = 1

    dim as long cxMinus = this.rcMinus.left + ((this.rcMinus.right - this.rcMinus.left) \ 2)
    dim as long cyMinus = this.rcMinus.top + ((this.rcMinus.bottom - this.rcMinus.top) \ 2)
    SetRect( @this.rcMinusBar, cxMinus - (gl \ 2), cyMinus - (gt \ 2), _
                               cxMinus - (gl \ 2) + gl, cyMinus - (gt \ 2) + gt )

    dim as long cxPlus = this.rcPlus.left + ((this.rcPlus.right - this.rcPlus.left) \ 2)
    dim as long cyPlus = this.rcPlus.top + ((this.rcPlus.bottom - this.rcPlus.top) \ 2)
    SetRect( @this.rcPlusBarH, cxPlus - (gl \ 2), cyPlus - (gt \ 2), _
                               cxPlus - (gl \ 2) + gl, cyPlus - (gt \ 2) + gt )
    SetRect( @this.rcPlusBarV, cxPlus - (gt \ 2), cyPlus - (gl \ 2), _
                               cxPlus - (gt \ 2) + gt, cyPlus - (gl \ 2) + gl )
end sub


' Forget any live press WITHOUT touching the capture. Releasing capture is the WndProc's job,
' and only on the up-message or WM_DESTROY -- doing it here would let a callback strand or
' double-release it. The repeat timer IS killed here, because it is ours alone and a tick
' arriving after the gesture ended would step the value with nothing holding the button.
sub PSNUMERICUPDOWN_STATE.CancelPress()
    this.pressedPart = NUD_PART_NONE
    if this.repeatTimerOn then
        if this.hWin then KillTimer( this.hWin, IDT_CNUMERICUPDOWN_REPEAT )
        this.repeatTimerOn = false
    end if
end sub

' Mark the layout stale and request a repaint. Every mutator routes through here, which is
' what makes layout lazy.
sub PSNUMERICUPDOWN_STATE.Refresh()
    this.bLayoutDirty = true
    ' Repaint WITH background erase so a region vacated by a shrinking cell is cleared.
    if this.hWin then InvalidateRect( this.hWin, NULL, TRUE )
end sub


' ========================================================================================
' PUBLIC API
' ========================================================================================
'
' A NUMERIC UP/DOWN: a rounded frame holding a "-" button, an editable numeric field and a
' "+" button, separated by hairline dividers. The value has a range, a settable number of
' decimal places, and a settable increment.
'
' IT WRAPS A REAL CHILD
'   The value field is a PsTextBox in numeric mode, whose own child is a RichEdit50W. That is
'   where typing, selection, the clipboard, undo and the right-click menu come from -- none
'   of it is reimplemented here. The window tree is:
'
'       PsNumericUpDown container      WS_EX_CONTROLPARENT
'         +-- PsTextBox                borderless: THIS control owns all the chrome
'               +-- RichEdit50W       WS_TABSTOP -- the real focus target
'
'   PsNumericUpDown_GetTextBoxHandle is the escape hatch: every PsTextBox_* setter applies to
'   it (cue banner, limit text, context-menu theming). Two of them are OWNED by this control
'   and must not be set behind its back -- PsTextBox_SetValue/SetDecimalPlaces (use ours, or
'   the cached value and the buttons' limit state go stale) and PsTextBox_SetBorderWidth
'   (nonzero would draw a second frame inside ours).
'
' FOCUS
'   Keyboard focus sits on the RichEdit two levels down, so GetFocus() = hCtrl is ALWAYS
'   false -- use PsNumericUpDown_HasFocus(). The frame is drawn in FocusBorderColor while the
'   field has focus; there is no separate focus ring and therefore no reserved ring band, so
'   the control's ideal size does not change when focus arrives.
'
'   TAB NAVIGATION works without IsDialogMessage in the host's pump, because PsTextBox
'   handles VK_TAB itself. It needs WS_EX_CONTROLPARENT on every window between the RichEdit
'   and the top-level window -- this container sets it, which is the only reason tabbing
'   works through the extra nesting level this control adds.
'
' THE HOST MESSAGE-PUMP OBLIGATION -- NOT OPTIONAL
'   The value field carries PsTextBox's built-in right-click Cut/Copy/Paste/Select All menu,
'   which is a PsPopupMenu and therefore not modal: keyboard navigation and click-outside
'   dismissal live in a message filter. A host that never calls PsNumericUpDown_FilterMessage
'   gets a menu that opens and paints but cannot be driven from the keyboard and never
'   closes on an outside click.
'
'       do while GetMessage(@uMsg, null, 0, 0)
'           if PsNumericUpDown_FilterMessage( @uMsg ) then continue do
'           TranslateMessage @uMsg
'           DispatchMessage @uMsg
'       loop
'
'   It forwards to PsTextBox_FilterMessage, so an app already calling that is covered either
'   way and calling both is harmless.
'
' NO TOOLTIPS
'   No tooltip window is created and there is no NUD_TooltipCallback. A host that wants a tip
'   can add its own tool over the control's HWND.
'
' THE CONTROL HANDLE
'   Every PsNumericUpDown_* function takes the handle returned by PsNumericUpDown_Create().
'   It is a real HWND on purpose (not an opaque type): callers legitimately need to treat the
'   control as a window, e.g. SetWindowPos() to place and size it.
'
' LIFETIME
'   The control frees itself when its window is destroyed, taking the PsTextBox with it. It
'   owns no host resources -- in particular the font is caller-owned and is never deleted.
'
' ----------------------------------------------------------------------------------------
' Creation.
'   CtrlID becomes the control window's id (GWLP_ID), so hosts can find it with GetDlgItem.
'   The control is created zero-sized: size it with PsNumericUpDown_GetIdealSize and position
'   it with SetWindowPos().
' ----------------------------------------------------------------------------------------
public declare function PsNumericUpDown_Create( byval hWndParent as HWND, byval CtrlID as long ) as HWND
public declare function PsNumericUpDown_GetTextBoxHandle( byval hCtrl as HWND ) as HWND
public declare function PsNumericUpDown_HasFocus( byval hCtrl as HWND ) as boolean

' ----------------------------------------------------------------------------------------
' Value.  EVERY SETTER HERE IS SILENT -- only user interaction fires the change callback.
'
'   SetValue clamps to the range and snaps to the decimal grid, so what you set is what
'     GetValue returns, and it is what is displayed.
'   SetRange re-clamps the current value (silently, again) and swaps an inverted pair.
'   SetDecimalPlaces re-formats the displayed value; 0 means integers only, and the field
'     then refuses a typed decimal separator outright.
'   StepUp/StepDown are the programmatic door to exactly what the buttons do -- and, being
'     programmatic, they do NOT notify. The buttons call the same arithmetic internally and
'     then notify.
'   SetReadOnly stops TYPING only. The buttons, the arrow keys and the wheel still work: it
'     is "you may not type an arbitrary number here", not "this control is inert" -- that is
'     SetEnabled.
' ----------------------------------------------------------------------------------------
public declare function PsNumericUpDown_GetValue( byval hCtrl as HWND ) as double
public declare sub      PsNumericUpDown_SetValue( byval hCtrl as HWND, byval nValue as double )
public declare sub      PsNumericUpDown_GetRange( byval hCtrl as HWND, byref nMin as double, byref nMax as double )
public declare sub      PsNumericUpDown_SetRange( byval hCtrl as HWND, byval nMin as double, byval nMax as double )
public declare function PsNumericUpDown_GetIncrement( byval hCtrl as HWND ) as double
public declare sub      PsNumericUpDown_SetIncrement( byval hCtrl as HWND, byval nIncrement as double )
public declare function PsNumericUpDown_GetLargeIncrement( byval hCtrl as HWND ) as double
public declare sub      PsNumericUpDown_SetLargeIncrement( byval hCtrl as HWND, byval nIncrement as double )
public declare function PsNumericUpDown_GetDecimalPlaces( byval hCtrl as HWND ) as long
public declare sub      PsNumericUpDown_SetDecimalPlaces( byval hCtrl as HWND, byval nPlaces as long )
public declare sub      PsNumericUpDown_StepUp( byval hCtrl as HWND )
public declare sub      PsNumericUpDown_StepDown( byval hCtrl as HWND )
public declare function PsNumericUpDown_GetReadOnly( byval hCtrl as HWND ) as boolean
public declare sub      PsNumericUpDown_SetReadOnly( byval hCtrl as HWND, byval bReadOnly as boolean )

' ----------------------------------------------------------------------------------------
' State and behavior.
'
'   SetEnabled(false) greys the whole control, blocks hover, and swallows clicks and keys. It
'     goes through EnableWindow -- on this container AND on the PsTextBox child -- rather than
'     setting a cosmetic flag, so the disable is enforced by the system and no SetFocus can
'     sneak into a control that looks dead. WM_ENABLE syncs the flag back, so a host that
'     reaches for EnableWindow directly still gets the greyed rendering.
'   SetAutoRepeat: milliseconds. Either value <= 0 disables repeating (one click = one step).
'     Repeating stops on its own the moment the value reaches a limit.
' ----------------------------------------------------------------------------------------
public declare function PsNumericUpDown_GetEnabled( byval hCtrl as HWND ) as boolean
public declare sub      PsNumericUpDown_SetEnabled( byval hCtrl as HWND, byval isEnabled as boolean )
public declare sub      PsNumericUpDown_GetAutoRepeat( byval hCtrl as HWND, byref nDelayMs as long, byref nIntervalMs as long )
public declare sub      PsNumericUpDown_SetAutoRepeat( byval hCtrl as HWND, byval nDelayMs as long, byval nIntervalMs as long )
public declare sub      PsNumericUpDown_Refresh( byval hCtrl as HWND )

' ----------------------------------------------------------------------------------------
' Layout.  ALL setters take RAW PIXELS -- the caller DPI-scales (the family rule; only the
' Create-time defaults are scaled for you). The BORDER and DIVIDER thicknesses should not be
' scaled at all -- a hairline stays a hairline -- but the GLYPH thickness should be, because
' it is an icon stroke rather than a rule. See the defines at the top of this file.
'
'   SetFont is CALLER-OWNED -- the control never deletes the HFONT. It is handed to the
'     PsTextBox, which converts it to a CHARFORMATW internally.
'   SetValuePadding: nLeft/nRight are the text margins inside the value cell; nVert is used
'     only by GetIdealSize, to decide the height around one line of text.
'   SetGlyphSize: the length of the "-" bar (and of each "+" bar) and its thickness.
'
'   GetIdealSize measures the WIDEST value the range can produce at the current decimal
'   places, in the current font, and adds the padding, both buttons, both dividers and the
'   border. This is the only place the control measures anything, and it opens its own DC to
'   do it -- so it is valid BEFORE the control has ever been sized.
'
'   The rect queries force a pending layout, so results are always current. They return
'   FALSE if the control has no geometry yet (created but never sized).
' ----------------------------------------------------------------------------------------
public declare function PsNumericUpDown_GetFont( byval hCtrl as HWND ) as HFONT
public declare sub      PsNumericUpDown_SetFont( byval hCtrl as HWND, byval hFont as HFONT )
public declare function PsNumericUpDown_GetButtonWidth( byval hCtrl as HWND ) as long
public declare sub      PsNumericUpDown_SetButtonWidth( byval hCtrl as HWND, byval nWidth as long )
public declare sub      PsNumericUpDown_GetValuePadding( byval hCtrl as HWND, byref nLeft as long, byref nRight as long, byref nVert as long )
public declare sub      PsNumericUpDown_SetValuePadding( byval hCtrl as HWND, byval nLeft as long, byval nRight as long, byval nVert as long )
public declare function PsNumericUpDown_GetCornerRadius( byval hCtrl as HWND ) as long
public declare sub      PsNumericUpDown_SetCornerRadius( byval hCtrl as HWND, byval nRadius as long )
public declare function PsNumericUpDown_GetBorderThickness( byval hCtrl as HWND ) as long
public declare sub      PsNumericUpDown_SetBorderThickness( byval hCtrl as HWND, byval nThickness as long )
public declare function PsNumericUpDown_GetDividerThickness( byval hCtrl as HWND ) as long
public declare sub      PsNumericUpDown_SetDividerThickness( byval hCtrl as HWND, byval nThickness as long )
public declare sub      PsNumericUpDown_GetGlyphSize( byval hCtrl as HWND, byref nLength as long, byref nThickness as long )
public declare sub      PsNumericUpDown_SetGlyphSize( byval hCtrl as HWND, byval nLength as long, byval nThickness as long )
public declare sub      PsNumericUpDown_GetIdealSize( byval hCtrl as HWND, byref nWidth as long, byref nHeight as long )
public declare function PsNumericUpDown_GetFrameRect( byval hCtrl as HWND, byref rc as RECT ) as boolean
public declare function PsNumericUpDown_GetMinusRect( byval hCtrl as HWND, byref rc as RECT ) as boolean
public declare function PsNumericUpDown_GetValueRect( byval hCtrl as HWND, byref rc as RECT ) as boolean
public declare function PsNumericUpDown_GetPlusRect( byval hCtrl as HWND, byref rc as RECT ) as boolean
' Which part is at pt (CLIENT coordinates)? Public so a host can special-case a region, and
' so the self-test can assert that hit-testing and the layout agree.
public declare function PsNumericUpDown_HitTest( byval hCtrl as HWND, byval pt as POINT ) as long

' ----------------------------------------------------------------------------------------
' Appearance.  SetColors copies the whole struct and pushes the value cell's two colors into
' the embedded PsTextBox. GetColors fills one out, so the read-modify-write "change one color"
' idiom is Get, assign, Set.
' ----------------------------------------------------------------------------------------
public declare sub      PsNumericUpDown_GetColors( byval hCtrl as HWND, byval pColors as PSNUMERICUPDOWN_COLORS ptr )
public declare sub      PsNumericUpDown_SetColors( byval hCtrl as HWND, byval pColors as PSNUMERICUPDOWN_COLORS ptr )
public declare function PsNumericUpDown_ThemeColors( byref t as PSTHEME_COLORS ) as PSNUMERICUPDOWN_COLORS
public declare sub      PsNumericUpDown_ApplyTheme( byval hCtrl as HWND, byref t as PSTHEME_COLORS )
public declare sub      PsNumericUpDown_UnpinColors( byval hCtrl as HWND )
public declare sub      PsNumericUpDown_ApplyFonts( byval hCtrl as HWND, byval hTextFont as HFONT, byval hGlyphFont as HFONT )
public declare sub      PsNumericUpDown_Rescale( byval hCtrl as HWND, byval oldDpi as long, byval newDpi as long )

' ----------------------------------------------------------------------------------------
' Callbacks.  See the type declarations above for each signature and contract.
'   PaintCallback        - draw the frame, cells, dividers and glyphs INSTEAD OF the
'                          built-in painter. It never draws the number.
'   MessageCallback      - observe the container's mouse/timer messages AND the value
'                          field's relayed key/wheel/focus messages; return TRUE to suppress
'                          default handling (IGNORED for WM_LBUTTONUP and WM_KILLFOCUS).
'   ValueChangedCallback - the USER changed the value. Programmatic setters are silent.
' ----------------------------------------------------------------------------------------
public declare sub      PsNumericUpDown_SetPaintCallback( byval hCtrl as HWND, byval usersub as NUD_PaintCallbackSub )
public declare sub      PsNumericUpDown_SetMessageCallback( byval hCtrl as HWND, byval userfunc as NUD_MessageCallbackFunc )
public declare sub      PsNumericUpDown_SetValueChangedCallback( byval hCtrl as HWND, byval usersub as NUD_ValueChangedCallbackSub )

' ----------------------------------------------------------------------------------------
' Host message pump.  See THE HOST MESSAGE-PUMP OBLIGATION above -- this is not optional.
' ----------------------------------------------------------------------------------------
public declare function PsNumericUpDown_FilterMessage( byval pMsg as MSG ptr ) as boolean

public function GetNumericUpDownPointer( byval hCtrl as HWND ) as PSNUMERICUPDOWN_STATE ptr
    dim pWindow as CWindow ptr = CWindowPtr(hCtrl)
    if pWindow = 0 then return 0
    return cast( PSNUMERICUPDOWN_STATE ptr, pWindow->UserData(0) )
end function


' Forward declarations: the Create routine installs these on the embedded PsTextBox, and the
' WndProc and they call each other.
declare function PsNumericUpDown_WndProc( byval hwnd as HWND, byval uMsg as UINT, byval wParam as WPARAM, byval lParam as LPARAM ) as LRESULT
declare sub      NUD_SyncChild( byval pNud as PSNUMERICUPDOWN_STATE ptr )
declare function NUD_StepBy( byval pNud as PSNUMERICUPDOWN_STATE ptr, byval hCtrl as HWND, byval delta as double ) as boolean
declare function NUD_HandleWheel( byval pNud as PSNUMERICUPDOWN_STATE ptr, byval hCtrl as HWND, byval nDelta as long ) as boolean


' ========================================================================================
' Format a value the way the control displays it. Deliberately NOT calling PsTextBox's own
' PsTextBox_FormatNumeric: it is private to the PsTextBox module this one imports, and reaching
' for it would couple this control to an implementation detail of another module.
' ========================================================================================
private function NUD_FormatValue( byval nValue as double, byval nDecimalPlaces as long ) as ustring
    dim as string fmt = "0"
    if nDecimalPlaces > 0 then fmt = fmt & "." & string(nDecimalPlaces, "0")
    return format( nValue, fmt )
end function


' ========================================================================================
' Do these two values differ ENOUGH to count as a change?
'
' Both operands have been through SnapToPlaces, so a real difference is at least one grid
' unit; anything smaller is binary-floating-point residue. A quarter of a grid unit is
' therefore comfortably clear of both -- and using the grid rather than a fixed epsilon is
' what keeps this correct at 0 decimal places (where 0.9 and 1.0 are the SAME displayed
' value would be wrong, and they differ by more than 0.25 so they are not).
' ========================================================================================
private function NUD_ValuesDiffer( _
            byval pNud as PSNUMERICUPDOWN_STATE ptr, _
            byval a as double, _
            byval b as double _
            ) as boolean

    if pNud = 0 then return (a <> b)
    dim as double tolerance = 0.25 / (10.0 ^ pNud->nDecimalPlaces)
    return ( abs(a - b) > tolerance )
end function


' ========================================================================================
' Hand a message to the host's message callback. Returns TRUE if the host claims it.
' Callers decide whether to honor that answer -- WM_LBUTTONUP and WM_KILLFOCUS deliberately
' do not (see NUD_MessageCallbackFunc).
' ========================================================================================
private function NUD_CallMessage( _
            byval pNud   as PSNUMERICUPDOWN_STATE ptr, _
            byval hCtrl  as HWND, _
            byval uMsg   as UINT, _
            byval wParam as WPARAM, _
            byval lParam as LPARAM _
            ) as boolean

    if pNud = 0 then return false
    if pNud->MessageCallback = 0 then return false

    dim as PSNUMERICUPDOWN_MESSAGEINFO m
    m.hCtrl  = hCtrl
    m.uMsg   = uMsg
    m.wParam = wParam
    m.lParam = lParam
    return pNud->MessageCallback( @m )
end function


' ========================================================================================
' Push the value cell's colors into the PsTextBox for the control's current enabled state.
'
' The RichEdit draws the number, so these two colors have to live on the child -- but they
' are authored in OUR color struct, because a host should set every color of the control in
' one place. This is the one routine that bridges the two.
' ========================================================================================
private sub NUD_ApplyStateColors( byval pNud as PSNUMERICUPDOWN_STATE ptr )
    if pNud = 0 then exit sub
    if pNud->hTextBox = 0 then exit sub

    if pNud->isEnabled then
        PsTextBox_SetBackColor( pNud->hTextBox, pNud->colors.ValueBackColor )
        PsTextBox_SetForeColor( pNud->hTextBox, pNud->colors.ValueForeColor )
    else
        PsTextBox_SetBackColor( pNud->hTextBox, pNud->colors.ValueBackColorDisabled )
        PsTextBox_SetForeColor( pNud->hTextBox, pNud->colors.ValueForeColorDisabled )
    end if
end sub


' ========================================================================================
' Display a value and record it as the control's committed value.
'
' THE ORDER MATTERS. nValue is updated first so that anything the writes below trigger --
' a repaint deciding whether a button is at its limit, a host querying us from a callback --
' already sees the new value. PsTextBox_SetValue is silent (a programmatic setter), so this
' never notifies; the caller decides whether a change is worth reporting.
' ========================================================================================
private sub NUD_DisplayValue( byval pNud as PSNUMERICUPDOWN_STATE ptr, byval nValue as double )
    if pNud = 0 then exit sub

    pNud->nValue = nValue
    if pNud->hTextBox then
        ' No alignment work here. The centring is set ONCE at Create and survives every
        ' subsequent write -- PsTextBox's own harness asserts exactly that. An earlier version
        ' of this routine re-stamped it after each value change, which was both unnecessary
        ' and (as it turned out) ineffective: it was sending EM_SETPARAFORMAT itself, which
        ' TM_PLAINTEXT silently refuses.
        PsTextBox_SetValue( pNud->hTextBox, nValue )
    end if
    ' The buttons' at-a-limit appearance is derived from the value, so a repaint is not
    ' optional here even though the number itself is drawn by the child.
    if pNud->hWin then InvalidateRect( pNud->hWin, NULL, FALSE )
end sub


' ========================================================================================
' What is in the field RIGHT NOW, normalised.
'
' Read from the PsTextBox rather than from nValue, because the user may have typed something
' that has not been committed yet -- and stepping from what is on screen is what a user
' expects when they type 50 and then click "+". Out-of-range typing is clamped here, so a
' step always starts from a legal value.
' ========================================================================================
private function NUD_CurrentValue( byval pNud as PSNUMERICUPDOWN_STATE ptr ) as double
    if pNud = 0 then return 0
    if pNud->hTextBox = 0 then return pNud->nValue
    return pNud->ClampToRange( pNud->SnapToPlaces( PsTextBox_GetValue( pNud->hTextBox ) ) )
end function


' ========================================================================================
' Is the value hard against a limit? Used only to paint a button disabled.
'
' Answered from nValue -- the committed value -- and not from the live text, so painting
' never sends a WM_GETTEXT to a child window. The consequence is honest and small: while the
' user is mid-typing, the buttons reflect the last committed value rather than the digits on
' screen. They still step correctly from what was typed (see NUD_CurrentValue).
' ========================================================================================
private function NUD_AtMin( byval pNud as PSNUMERICUPDOWN_STATE ptr ) as boolean
    if pNud = 0 then return false
    return ( NUD_ValuesDiffer( pNud, pNud->nValue, pNud->nMin ) = false ) orelse (pNud->nValue < pNud->nMin)
end function

private function NUD_AtMax( byval pNud as PSNUMERICUPDOWN_STATE ptr ) as boolean
    if pNud = 0 then return false
    return ( NUD_ValuesDiffer( pNud, pNud->nValue, pNud->nMax ) = false ) orelse (pNud->nValue > pNud->nMax)
end function


' ========================================================================================
' Add delta to whatever is in the field, clamp, snap, display, and report the change.
'
' Returns TRUE if the value actually MOVED, which is what stops auto-repeat dead at a limit.
' Note the two different comparisons, and that they are asking different questions:
'   - "did it move"      compares against what was in the FIELD (so a step off uncommitted
'                        typed text is a move);
'   - "should we notify" compares against nValue, the last value the host was told about
'                        (so typing 50 and clicking "+" reports 51 once, not twice).
' The display is refreshed either way, which is also what normalises "5." to "5.00".
' ========================================================================================
private function NUD_StepBy( _
            byval pNud  as PSNUMERICUPDOWN_STATE ptr, _
            byval hCtrl as HWND, _
            byval delta as double _
            ) as boolean

    if pNud = 0 then return false

    dim as double nCurrent = NUD_CurrentValue( pNud )
    dim as double nNew = pNud->ClampToRange( pNud->SnapToPlaces( nCurrent + delta ) )
    dim as double nOld = pNud->nValue

    dim as boolean bMoved = NUD_ValuesDiffer( pNud, nNew, nCurrent )
    dim as boolean bNotify = NUD_ValuesDiffer( pNud, nNew, nOld )

    NUD_DisplayValue( pNud, nNew )

    if bNotify andalso (pNud->ValueChangedCallback <> 0) then
        pNud->ValueChangedCallback( hCtrl, nNew )
    end if

    return bMoved
end function


' ========================================================================================
' Commit whatever the user typed: clamp it, snap it, reformat it, and report it once.
'
' Reached from ENTER and from focus loss. By the time PsTextBox's FocusCallback runs, its
' numeric mode has already rewritten "5." as "5.00" -- but it knows nothing about our range,
' so the clamp is ours and has to happen here.
' ========================================================================================
private sub NUD_CommitTypedValue( byval pNud as PSNUMERICUPDOWN_STATE ptr, byval hCtrl as HWND )
    if pNud = 0 then exit sub

    dim as double nOld = pNud->nValue
    ' An empty field reads as 0 and is then clamped into the range, so the control can never
    ' be left blank -- there is no "no value" state to represent.
    dim as double nNew = NUD_CurrentValue( pNud )

    NUD_DisplayValue( pNud, nNew )

    if NUD_ValuesDiffer( pNud, nNew, nOld ) andalso (pNud->ValueChangedCallback <> 0) then
        pNud->ValueChangedCallback( hCtrl, nNew )
    end if
end sub


' ========================================================================================
' Wheel: one increment per notch, accumulating sub-notch deltas.
'
' The accumulation is the scrollbar siblings' rule -- a precision touchpad sends deltas well
' under one 120 notch and truncating each one would ignore a slow swipe entirely.
'
' SPI_GETWHEELSCROLLLINES is deliberately NOT consulted, which is where this parts company
' with PsVScrollBar/PsHScrollBar: "how many LINES does one notch scroll" is a question about
' scrolling a view, and this is a value, not a view. One notch = one increment, and the host
' controls the feel through SetIncrement.
' ========================================================================================
private function NUD_HandleWheel( _
            byval pNud   as PSNUMERICUPDOWN_STATE ptr, _
            byval hCtrl  as HWND, _
            byval nDelta as long _
            ) as boolean

    if pNud = 0 then return false
    if pNud->isEnabled = false then return false

    pNud->nWheelAccum += nDelta
    dim as long nNotches = pNud->nWheelAccum \ WHEEL_DELTA
    if nNotches = 0 then return true          ' consumed, but not yet a whole notch
    pNud->nWheelAccum -= nNotches * WHEEL_DELTA

    ' Positive delta = wheel away from the user = increase.
    NUD_StepBy( pNud, hCtrl, nNotches * pNud->nIncrement )
    return true
end function


' ========================================================================================
' Which part is under a CLIENT-coordinate point?
'
' The value cell is reported for completeness, but the control never acts on it: that area
' is covered by the PsTextBox child, which gets its own mouse messages and never routes them
' here. So in practice only MINUS and PLUS are ever reachable through a real mouse message.
' ========================================================================================
private function NUD_HitTestPart( byval pNud as PSNUMERICUPDOWN_STATE ptr, byval pt as POINT ) as long
    if pNud = 0 then return NUD_PART_NONE
    if pNud->bLayoutDirty then pNud->LayoutControl()

    if PtInRect( @pNud->rcMinus, pt ) then return NUD_PART_MINUS
    if PtInRect( @pNud->rcPlus, pt ) then return NUD_PART_PLUS
    if PtInRect( @pNud->rcValue, pt ) then return NUD_PART_VALUE
    return NUD_PART_NONE
end function


' ========================================================================================
' Auto-repeat control. The delay/interval transition needs no extra state: every tick
' re-arms the timer at the INTERVAL, and SetTimer with an existing id replaces the timer
' rather than adding a second one. So the first tick arrives after the delay and all the
' rest after the interval.
' ========================================================================================
private sub NUD_StartRepeat( byval pNud as PSNUMERICUPDOWN_STATE ptr, byval hCtrl as HWND )
    if pNud = 0 then exit sub
    if (pNud->nRepeatDelayMs <= 0) orelse (pNud->nRepeatIntervalMs <= 0) then exit sub
    SetTimer( hCtrl, IDT_CNUMERICUPDOWN_REPEAT, pNud->nRepeatDelayMs, NULL )
    pNud->repeatTimerOn = true
end sub

private sub NUD_StopRepeat( byval pNud as PSNUMERICUPDOWN_STATE ptr, byval hCtrl as HWND )
    if pNud = 0 then exit sub
    if pNud->repeatTimerOn then
        KillTimer( hCtrl, IDT_CNUMERICUPDOWN_REPEAT )
        pNud->repeatTimerOn = false
    end if
end sub


' ========================================================================================
' Clear the hover state and stop the hover poll timer. Repaints only if the state actually
' changes, so this is cheap to call repeatedly.
' ========================================================================================
private sub NUD_ClearHot( byval pNud as PSNUMERICUPDOWN_STATE ptr, byval hCtrl as HWND )
    if pNud = 0 then exit sub
    if pNud->hotTimerOn then
        KillTimer( hCtrl, IDT_CNUMERICUPDOWN_HOTTRACK )
        pNud->hotTimerOn = false
    end if
    if pNud->hotPart <> NUD_PART_NONE then
        pNud->hotPart = NUD_PART_NONE
        InvalidateRect( hCtrl, NULL, FALSE )
    end if
end sub


' ========================================================================================
' Keep the PsTextBox child sitting exactly on rcValue.
'
' Guarded by a comparison so it is a no-op in steady state: this runs from WM_PAINT as well
' as WM_SIZE, and an unconditional SetWindowPos from inside a paint would invite a repaint
' loop. In practice WM_SIZE has already done the work and the comparison short-circuits.
'
' A client too narrow to hold both buttons collapses rcValue to zero width; the child is
' hidden rather than handed a degenerate rect, because a zero-width RichEdit is a different
' kind of problem from an absent one.
' ========================================================================================
private sub NUD_SyncChild( byval pNud as PSNUMERICUPDOWN_STATE ptr )
    if pNud = 0 then exit sub
    if pNud->hTextBox = 0 then exit sub
    if pNud->bLayoutDirty then pNud->LayoutControl()

    dim as RECT rc = pNud->rcValue
    dim as long cx = rc.right - rc.left
    dim as long cy = rc.bottom - rc.top

    if (cx <= 0) orelse (cy <= 0) then
        ShowWindow( pNud->hTextBox, SW_HIDE )
        exit sub
    end if

    dim as RECT rcNow
    GetWindowRect( pNud->hTextBox, @rcNow )
    MapWindowPoints( HWND_DESKTOP, pNud->hWin, cast(POINT ptr, @rcNow), 2 )
    if EqualRect( @rcNow, @rc ) = 0 then
        SetWindowPos( pNud->hTextBox, 0, rc.left, rc.top, cx, cy, SWP_NOZORDER or SWP_NOACTIVATE )
    end if
    ShowWindow( pNud->hTextBox, SW_SHOW )
end sub


' ========================================================================================
' Draw the frame, the two button cells, the dividers and the two glyphs.
'
' IT NEVER DRAWS THE NUMBER. The RichEdit inside the PsTextBox paints that, over rcValue,
' after we are done -- and because the container is WS_CLIPCHILDREN, the child's rect is
' excluded from our DC anyway, so anything drawn there would be discarded rather than
' fighting for the pixels.
'
' THE PAINT ORDER IS LOad-BEARING, and it is what keeps the corners round:
'
'   1. the client, in BackColor                 -- shows through OUTSIDE the rounded corners
'   2. the whole frame, as a filled ROUND rect  -- this is what makes the corners round; it
'                                                  is also the value cell's background, for
'                                                  the strip above and below the child
'   3. each button cell, as a filled ROUND rect EXTENDED INWARD past the divider. A plain
'      rectangular fill would square off the two corners it covers. Extending it inward puts
'      its own inner rounding somewhere harmless -- past the divider, inside the child's
'      clipped-away rect -- so only the outer, wanted rounding survives.
'   4. the dividers, then the glyphs, as filled RECTANGLES. Learnings.md: an antialiased 1px
'      axis-aligned rule comes out grey and blurry, and a stated extent sidesteps both the
'      smoothing and the endpoint-inclusion question. Reserve AA for curves.
'   5. the frame OUTLINE last, over everything -- PaintRoundOutline, not
'      PaintRoundBorderRect, because a filled round rect here would erase steps 2-4.
'
' Curvature is a DIAMETER in this API (PsBufferPaint halves it to a GDI+ radius internally),
' so nCornerRadius is doubled at every call site here.
' ========================================================================================
private sub PsNumericUpDown_RenderDefault( _
            byval pNud as PSNUMERICUPDOWN_STATE ptr, _
            byval b    as PsPaintBuffer ptr, _
            byval p    as PSNUMERICUPDOWN_PAINTINFO ptr _
            )

    if (pNud = 0) orelse (b = 0) orelse (p = 0) then exit sub

    dim as long cw = p->rcFrame.right - p->rcFrame.left
    dim as long ch = p->rcFrame.bottom - p->rcFrame.top
    if (cw <= 0) orelse (ch <= 0) then exit sub

    dim as long ell = pNud->nCornerRadius * 2

    ' ---- 2. the frame's fill ------------------------------------------------------------
    dim as COLORREF clrBase = pNud->colors.ValueBackColor
    if p->isEnabled = false then clrBase = pNud->colors.ValueBackColorDisabled
    dim as RECT rcFrame = p->rcFrame
    b->SetBackColor( clrBase )
    b->PaintRoundRect( @rcFrame, ell )

    ' ---- 3. the two button cells --------------------------------------------------------
    ' Precedence: disabled (control-wide, or this button at its limit) > pressed > hot > idle.
    ' A button at a limit is drawn disabled while the rest of the control stays live, which is
    ' the only per-part state in here.
    dim as long ext = pNud->nCornerRadius + pNud->nDividerThick + 1

    for iPart as long = NUD_PART_MINUS to NUD_PART_PLUS step (NUD_PART_PLUS - NUD_PART_MINUS)
        dim as RECT rcCell, rcFill
        dim as boolean bAtLimit
        if iPart = NUD_PART_MINUS then
            rcCell = p->rcMinus
            bAtLimit = p->bAtMin
            SetRect( @rcFill, rcCell.left, rcCell.top, rcCell.right + ext, rcCell.bottom )
        else
            rcCell = p->rcPlus
            bAtLimit = p->bAtMax
            SetRect( @rcFill, rcCell.left - ext, rcCell.top, rcCell.right, rcCell.bottom )
        end if

        dim as COLORREF clrBack, clrGlyph
        if (p->isEnabled = false) orelse bAtLimit then
            clrBack  = pNud->colors.ButtonBackColorDisabled
            clrGlyph = pNud->colors.GlyphColorDisabled
        elseif p->pressedPart = iPart then
            clrBack  = pNud->colors.ButtonBackColorPressed
            clrGlyph = pNud->colors.GlyphColorPressed
        elseif p->hotPart = iPart then
            clrBack  = pNud->colors.ButtonBackColorHot
            clrGlyph = pNud->colors.GlyphColorHot
        else
            clrBack  = pNud->colors.ButtonBackColor
            clrGlyph = pNud->colors.GlyphColor
        end if

        b->SetBackColor( clrBack )
        b->PaintRoundRect( @rcFill, ell )

        ' ---- 4b. the glyph ---------------------------------------------------------------
        b->SetBackColor( clrGlyph )
        if iPart = NUD_PART_MINUS then
            dim as RECT rcBar = p->rcMinusBar
            b->PaintRect( @rcBar )
        else
            dim as RECT rcBarH = p->rcPlusBarH
            dim as RECT rcBarV = p->rcPlusBarV
            b->PaintRect( @rcBarH )
            b->PaintRect( @rcBarV )
        end if
    next

    ' ---- 4a. the dividers ---------------------------------------------------------------
    if pNud->nDividerThick > 0 then
        dim as COLORREF clrDiv = pNud->colors.DividerColor
        if p->isEnabled = false then clrDiv = pNud->colors.DividerColorDisabled
        dim as RECT rcD1 = p->rcDiv1
        dim as RECT rcD2 = p->rcDiv2
        b->SetBackColor( clrDiv )
        b->PaintRect( @rcD1 )
        b->PaintRect( @rcD2 )
    end if

    ' ---- 5. the frame outline -----------------------------------------------------------
    ' There is no separate focus ring and therefore no reserved band: focus simply recolors
    ' this stroke, which is why the control's ideal size does not change when focus arrives.
    if pNud->nBorderThick > 0 then
        dim as COLORREF clrBorder = pNud->colors.BorderColor
        if p->isEnabled = false then
            clrBorder = pNud->colors.BorderColorDisabled
        elseif p->isFocused then
            clrBorder = pNud->colors.FocusBorderColor
        end if
        dim as RECT rcOutline = p->rcFrame
        b->SetPenColor( clrBorder )
        b->PaintRoundOutline( @rcOutline, ell, pNud->nBorderThick )
    end if
end sub


' ========================================================================================
' Process WM_PAINT.
' ========================================================================================
private function PsNumericUpDown_OnPaint( byval hwnd as HWND ) as LRESULT
    dim as PSNUMERICUPDOWN_STATE ptr pNud = GetNumericUpDownPointer(hwnd)
    if pNud = null then return 0

    ' Consume any pending layout before painting -- this is what makes layout lazy -- and
    ' make sure the child is standing where the layout says it should.
    if pNud->bLayoutDirty then pNud->LayoutControl()
    NUD_SyncChild( pNud )

    dim as PsPaintBuffer b
    b.BeginDoubleBuffer(hwnd)
    b.SetBackColor( pNud->colors.BackColor )
    b.PaintClientRect()

    dim p as PSNUMERICUPDOWN_PAINTINFO
    p.hCtrl       = hwnd
    p.b           = @b
    GetClientRect( hwnd, @p.rcClient )
    p.rcFrame     = pNud->rcFrame
    p.rcMinus     = pNud->rcMinus
    p.rcDiv1      = pNud->rcDiv1
    p.rcValue     = pNud->rcValue
    p.rcDiv2      = pNud->rcDiv2
    p.rcPlus      = pNud->rcPlus
    p.rcMinusBar  = pNud->rcMinusBar
    p.rcPlusBarH  = pNud->rcPlusBarH
    p.rcPlusBarV  = pNud->rcPlusBarV
    p.hotPart     = pNud->hotPart
    ' "The press is still armed" is exactly "pressed AND the cursor is still on that button"
    ' -- hover tracking maintains hotPart through the capture, so there is no second flag.
    p.pressedPart = NUD_PART_NONE
    if (pNud->pressedPart <> NUD_PART_NONE) andalso (pNud->pressedPart = pNud->hotPart) then
        p.pressedPart = pNud->pressedPart
    end if
    p.isEnabled   = pNud->isEnabled
    p.isFocused   = pNud->isFocused
    p.bAtMin      = NUD_AtMin( pNud )
    p.bAtMax      = NUD_AtMax( pNud )
    p.nValue      = pNud->nValue

    if pNud->PaintCallback then
        pNud->PaintCallback( @p )
    else
        PsNumericUpDown_RenderDefault( pNud, @b, @p )
    end if

    b.EndDoubleBuffer()
    function = 0
end function


' ========================================================================================
' THE THREE HOOKS INTO THE EMBEDDED PsTextBox.
'
' PsTextBox reports events against ITS OWN handle, so each of these starts by walking up one
' level: GetParent(hTextBox) is this control. That is the whole mapping -- there is no
' registry and no back-pointer to keep in sync.
' ========================================================================================

' The value field gained or lost keyboard focus.
'
' FOCUS LOSS IS WHAT COMMITS A TYPED VALUE, and by the time this runs PsTextBox's numeric mode
' has already reformatted the buffer ("5." -> "5.00"). It knows nothing about our range,
' though, so the clamp happens here.
private sub NUD_OnTextBoxFocus( byval hTextBox as HWND, byval bGotFocus as boolean )
    dim as HWND hCtrl = GetParent( hTextBox )
    dim as PSNUMERICUPDOWN_STATE ptr pNud = GetNumericUpDownPointer( hCtrl )
    if pNud = 0 then exit sub

    pNud->isFocused = bGotFocus
    InvalidateRect( hCtrl, NULL, FALSE )

    if bGotFocus = false then NUD_CommitTypedValue( pNud, hCtrl )
end sub


' ENTER in the value field. PsTextBox swallows the keystroke itself (no newline, no beep) and
' reports it here; committing is the natural meaning of ENTER in a spinner.
private sub NUD_OnTextBoxEnter( byval hTextBox as HWND )
    dim as HWND hCtrl = GetParent( hTextBox )
    dim as PSNUMERICUPDOWN_STATE ptr pNud = GetNumericUpDownPointer( hCtrl )
    if pNud = 0 then exit sub

    NUD_CommitTypedValue( pNud, hCtrl )
end sub


' Every key, wheel, mouse and focus message the RichEdit sees passes through here BEFORE
' PsTextBox acts on it. Two jobs:
'
'   1. RELAY it to our own host as if it had arrived at this control, so a host sees one
'      message stream and never has to know a RichEdit is in there.
'   2. CLAIM the four navigation keys and the wheel. They are free to take: a single-line
'      RichEdit does nothing useful with Up/Down/PgUp/PgDn, and PsTextBox only handles
'      WM_MOUSEWHEEL in multiline mode.
'
' Returning TRUE makes PsTextBox's subclass return 0 without calling the RichEdit, which is
' exactly "consumed". Home and End are deliberately NOT claimed -- they move the caret to the
' start and end of the text, and stealing them for min/max would break ordinary editing in a
' field the user can type into.
private function NUD_OnTextBoxMessage( byval m as PSTEXTBOX_MESSAGEINFO ptr ) as boolean
    if m = 0 then return false

    dim as HWND hCtrl = GetParent( m->hTextBox )
    dim as PSNUMERICUPDOWN_STATE ptr pNud = GetNumericUpDownPointer( hCtrl )
    if pNud = 0 then return false

    ' The host sees it first. WM_KILLFOCUS is relayed but NOT vetoable: it is what commits a
    ' typed value, and a suppressed commit would leave the control displaying a number it has
    ' not accepted.
    dim as boolean bClaimed = NUD_CallMessage( pNud, hCtrl, m->uMsg, m->wParam, m->lParam )
    if bClaimed andalso (m->uMsg <> WM_KILLFOCUS) then return true

    if pNud->isEnabled = false then return false

    select case m->uMsg

    case WM_KEYDOWN
        select case m->wParam
        case VK_UP
            NUD_StepBy( pNud, hCtrl, pNud->nIncrement )
            return true
        case VK_DOWN
            NUD_StepBy( pNud, hCtrl, -pNud->nIncrement )
            return true
        case VK_PRIOR
            NUD_StepBy( pNud, hCtrl, pNud->nLargeIncrement )
            return true
        case VK_NEXT
            NUD_StepBy( pNud, hCtrl, -pNud->nLargeIncrement )
            return true
        end select

    case WM_MOUSEWHEEL
        ' The delta is a SIGNED word in the high word (Learnings.md).
        return NUD_HandleWheel( pNud, hCtrl, cast(short, hiword(m->wParam)) )

    end select

    return false
end function


' ========================================================================================
' PsNumericUpDown container window procedure.
'
' It owns the chrome, the two buttons and the child's geometry. The value field's own
' messages never reach here -- they go to the RichEdit and come back through
' NUD_OnTextBoxMessage.
'
' THE CONTROL TAKES MOUSE CAPTURE on a button press, and pays the family's full price for it:
' snapshot before releasing (ReleaseCapture sends WM_CAPTURECHANGED synchronously, so reading
' the flag afterwards always finds it cleared -- Learnings.md), release on the up-message
' before any callback runs, WM_CAPTURECHANGED cancels the press, WM_DESTROY releases, and the
' message callback's result is IGNORED for WM_LBUTTONUP so nothing can strand it.
'
' BUT NOTE WHAT THE CAPTURE IS FOR HERE, because it is NOT the press/cancel gesture its
' siblings take it for. A SPINNER STEPS ON THE BUTTON-DOWN, not on the release -- it has to,
' because auto-repeat has to start from somewhere and a first step deferred to the release
' would arrive after the repeats it precedes. So sliding off a button does not undo the step
' that already happened; what capture buys is (a) the repeat stops the moment the cursor
' leaves the button and resumes if it comes back, and (b) the up-message is guaranteed to
' arrive here, wherever the cursor has wandered to, so the repeat timer can never outlive the
' gesture. Every real spinner behaves this way.
'
' CS_DBLCLKS IS DELIBERATELY NOT SET, which is PsToggle's and PsIconPanel's call rather than
' PsSelectBar's: with it, the second of two rapid clicks arrives as WM_LBUTTONDBLCLK INSTEAD
' OF a second WM_LBUTTONDOWN, and a user double-clicking "+" to add two would get one.
' ========================================================================================
function PsNumericUpDown_WndProc( _
            byval hwnd   as HWND, _
            byval uMsg   as UINT, _
            byval wParam as WPARAM, _
            byval lParam as LPARAM _
            ) as LRESULT

    dim as PSNUMERICUPDOWN_STATE ptr pNud = GetNumericUpDownPointer( hwnd )

    select case uMsg

    case WM_PAINT
        return PsNumericUpDown_OnPaint( hwnd )

    case WM_ERASEBKGND
        ' Never erase: WM_PAINT fills the whole client through the double buffer, so a
        ' background erase here would only add flicker.
        return true

    case WM_SIZE
        if pNud then
            pNud->Refresh()
            NUD_SyncChild( pNud )
        end if
        return 0

    case WM_SETFOCUS
        ' A host that reaches for SetFocus(hCtrl) means "put the caret in the field". The
        ' container itself is not a tabstop and has nothing to do with focus, so hand it
        ' straight down rather than swallowing it.
        if pNud andalso pNud->hTextBox then
            dim as HWND hEdit = PsTextBox_GetRichEditHandle( pNud->hTextBox )
            if hEdit then
                SetFocus( hEdit )
                return 0
            end if
        end if

    case WM_TIMER
        if pNud = 0 then exit select

        if wParam = IDT_CNUMERICUPDOWN_HOTTRACK then
            ' The cursor may have left without us getting a WM_MOUSELEAVE. If it is no longer
            ' over our client area, clear the hot state ourselves. Note this poll runs even
            ' during a press: under capture the cursor legitimately roams outside, and the
            ' pressed button's appearance follows hotPart.
            dim as RECT rcClient
            GetClientRect( hwnd, @rcClient )
            if isMouseOverRECT( hwnd, rcClient ) = false then
                if pNud->pressedPart = NUD_PART_NONE then
                    NUD_ClearHot( pNud, hwnd )
                elseif pNud->hotPart <> NUD_PART_NONE then
                    pNud->hotPart = NUD_PART_NONE
                    NUD_StopRepeat( pNud, hwnd )
                    InvalidateRect( hwnd, NULL, FALSE )
                end if
            end if
            return 0
        end if

        if wParam = IDT_CNUMERICUPDOWN_REPEAT then
            ' Re-arm at the INTERVAL. The first tick came after the delay; SetTimer with an
            ' existing id replaces the timer, so this is the whole delay->interval
            ' transition and it needs no extra state.
            SetTimer( hwnd, IDT_CNUMERICUPDOWN_REPEAT, pNud->nRepeatIntervalMs, NULL )

            ' Repeat only while the button is still held AND the cursor is still on it.
            if (pNud->pressedPart = NUD_PART_NONE) orelse (pNud->pressedPart <> pNud->hotPart) then
                NUD_StopRepeat( pNud, hwnd )
                return 0
            end if

            dim as double delta = pNud->nIncrement
            if pNud->pressedPart = NUD_PART_MINUS then delta = -delta
            ' Reaching a limit stops the repeat dead rather than spinning against the clamp.
            if NUD_StepBy( pNud, hwnd, delta ) = false then NUD_StopRepeat( pNud, hwnd )
            return 0
        end if

    case WM_MOUSEMOVE
        if pNud = 0 then exit select
        if pNud->isEnabled = false then exit select

        ' Under capture we receive moves from anywhere on the desktop, so "where is the
        ' mouse" must be asked of the cursor position and never assumed from the message.
        dim as POINT pt
        GetCursorPos( @pt )
        ScreenToClient( hwnd, @pt )
        dim as long newHot = NUD_HitTestPart( pNud, pt )
        ' Only the buttons light up; the value cell belongs to the child.
        if newHot = NUD_PART_VALUE then newHot = NUD_PART_NONE

        if newHot <> NUD_PART_NONE then
            ' Track so we get the eventual WM_MOUSELEAVE.
            dim tme as TrackMouseEvent
            tme.cbSize    = sizeof(TrackMouseEvent)
            tme.dwFlags   = TME_LEAVE
            tme.hwndTrack = hwnd
            TrackMouseEvent(@tme)

            ' Safety net: WM_MOUSELEAVE is not guaranteed to arrive when the mouse exits
            ' quickly (or onto the child in the middle), which would strand a button hot.
            if pNud->hotTimerOn = false then
                SetTimer( hwnd, IDT_CNUMERICUPDOWN_HOTTRACK, PSNUMERICUPDOWN_HOTTRACK_MS, NULL )
                pNud->hotTimerOn = true
            end if
        end if

        if newHot <> pNud->hotPart then
            pNud->hotPart = newHot
            ' Sliding off the held button suspends the repeat; sliding back on resumes it,
            ' after the full delay again so a wobbling cursor cannot machine-gun the value.
            if pNud->pressedPart <> NUD_PART_NONE then
                if pNud->pressedPart = newHot then
                    NUD_StartRepeat( pNud, hwnd )
                else
                    NUD_StopRepeat( pNud, hwnd )
                end if
            end if
            InvalidateRect( hwnd, NULL, FALSE )
        end if

        if NUD_CallMessage( pNud, hwnd, uMsg, wParam, lParam ) then return 0

    case WM_MOUSELEAVE
        if pNud then
            ' Fast path for clearing the hot state (the WM_TIMER poll is the fallback for
            ' when this message never arrives).
            if pNud->pressedPart = NUD_PART_NONE then
                NUD_ClearHot( pNud, hwnd )
            else
                if pNud->hotPart <> NUD_PART_NONE then
                    pNud->hotPart = NUD_PART_NONE
                    NUD_StopRepeat( pNud, hwnd )
                    InvalidateRect( hwnd, NULL, FALSE )
                end if
            end if
            if NUD_CallMessage( pNud, hwnd, uMsg, wParam, lParam ) then return 0
        end if

    case WM_LBUTTONDOWN
        if pNud = 0 then return 0
        ' A disabled window receives no mouse input at all (SetEnabled calls EnableWindow),
        ' so this is belt-and-braces against a host that disabled us by some other route.
        if pNud->isEnabled = false then return 0

        ' Asked of the cursor rather than unpacked from lParam, so this reads identically to
        ' the WM_MOUSEMOVE handler and needs no windowsx.bi macro.
        dim as POINT pt
        GetCursorPos( @pt )
        ScreenToClient( hwnd, @pt )
        dim as long part = NUD_HitTestPart( pNud, pt )
        if (part <> NUD_PART_MINUS) andalso (part <> NUD_PART_PLUS) then
            if NUD_CallMessage( pNud, hwnd, uMsg, wParam, lParam ) then return 0
            exit select
        end if

        ' Put the caret in the value field so the arrows and the wheel work straight away and
        ' the frame lights up -- but WITHOUT selecting the text, which would leave the number
        ' highlighted after every click of "+". A Tab arrival still selects.
        '
        ' Toggling the PsTextBox flag around the SetFocus is safe (rather than a timing
        ' gamble) because PsTextBox applies select-on-focus synchronously inside its
        ' WM_SETFOCUS handler -- the whole effect is over before SetFocus returns.
        if pNud->hTextBox then
            dim as HWND hEdit = PsTextBox_GetRichEditHandle( pNud->hTextBox )
            if hEdit then
                PsTextBox_SetSelectOnFocus( pNud->hTextBox, false )
                SetFocus( hEdit )
                PsTextBox_SetSelectOnFocus( pNud->hTextBox, true )
            end if
        end if

        ' Suppressing the press is allowed: no capture has been taken yet, so there is no
        ' bookkeeping to strand.
        if NUD_CallMessage( pNud, hwnd, uMsg, wParam, lParam ) then return 0

        SetCapture( hwnd )
        pNud->pressedPart = part
        pNud->hotPart     = part
        InvalidateRect( hwnd, NULL, FALSE )

        ' Step immediately, then let the repeat timer take over after the delay.
        dim as double delta = pNud->nIncrement
        if part = NUD_PART_MINUS then delta = -delta
        if NUD_StepBy( pNud, hwnd, delta ) then NUD_StartRepeat( pNud, hwnd )
        return 0

    case WM_LBUTTONUP
        if pNud = 0 then return 0

        ' Release capture unconditionally, before any callback runs. Nothing below -- not a
        ' callback, not a host handler -- gets the chance to leave it held. (There is no
        ' "was it pressed" snapshot to take here, unlike the press/cancel siblings: the step
        ' already happened on the down-message, so the up has no value decision to make.)
        if GetCapture() = hwnd then ReleaseCapture()

        NUD_StopRepeat( pNud, hwnd )
        pNud->CancelPress()
        InvalidateRect( hwnd, NULL, FALSE )

        ' The result is deliberately IGNORED here (see NUD_MessageCallbackFunc).
        NUD_CallMessage( pNud, hwnd, uMsg, wParam, lParam )
        return 0

    case WM_CAPTURECHANGED
        ' Capture can be stolen at any time (a modal dialog, another control, the shell).
        ' The gesture is over; forget it, stop repeating and repaint.
        if pNud then
            pNud->CancelPress()
            InvalidateRect( hwnd, NULL, FALSE )
            return 0
        end if

    case WM_MOUSEWHEEL
        ' Wheel messages go to the FOCUSED window, so most of them arrive at the RichEdit and
        ' come back through NUD_OnTextBoxMessage. This path catches the other case: Windows'
        ' "scroll inactive windows" setting (on by default) delivers the wheel to whatever is
        ' under the cursor, which is this container when the pointer is over a button.
        if pNud then
            if NUD_CallMessage( pNud, hwnd, uMsg, wParam, lParam ) then return 0
            if NUD_HandleWheel( pNud, hwnd, cast(short, hiword(wParam)) ) then return 0
        end if

    case WM_RBUTTONDOWN, WM_RBUTTONUP
        ' Reported, never acted on. The value field has its own context menu (PsTextBox's);
        ' the buttons have none, and inventing one here is the host's business.
        if pNud then
            if NUD_CallMessage( pNud, hwnd, uMsg, wParam, lParam ) then return 0
        end if

    case WM_ENABLE
        ' Keeps our own flag true to the window's real state, so a host that reaches for
        ' EnableWindow directly instead of PsNumericUpDown_SetEnabled still gets the greyed
        ' rendering rather than a control that looks live but eats input.
        if pNud then
            pNud->isEnabled = (wParam <> 0)
            if pNud->isEnabled = false then
                pNud->hotPart = NUD_PART_NONE
                NUD_StopRepeat( pNud, hwnd )
                pNud->CancelPress()
            end if
            NUD_ApplyStateColors( pNud )
            InvalidateRect( hwnd, NULL, TRUE )
            NUD_CallMessage( pNud, hwnd, uMsg, wParam, lParam )
        end if

    case WM_DESTROY
        PsRegistry_Remove( hwnd )
        PsRegistry_ReleaseGlobalFilter( @PsNumericUpDown_FilterMessage )
        if pNud then
            ' Don't let either timer outlive the window...
            if pNud->hotTimerOn then
                KillTimer( hwnd, IDT_CNUMERICUPDOWN_HOTTRACK )
                pNud->hotTimerOn = false
            end if
            NUD_StopRepeat( pNud, hwnd )
            ' ...nor the capture, if we are being destroyed mid-press.
            if GetCapture() = hwnd then ReleaseCapture()
            pNud->CancelPress()
        end if

    case WM_NCDESTROY
        ' Delete the stored control data. The PsTextBox child destroys itself with its own
        ' window (it is our child, so it goes first); the font is caller-owned and is never
        ' deleted here.
        if pNud then delete(pNud)

        ' delete the allocated memory for window
        dim as CWindow ptr pWindow = CWindowPtr(hwnd)
        if pWindow then delete(pWindow)
        return 0

    end select

    ' for messages that we don't deal with
    function = DefWindowProc( hwnd, uMsg, wParam, lParam )

end function


' ========================================================================================
' PsNumericUpDown_Create
' ========================================================================================
public function PsNumericUpDown_Create( byval hWndParent as HWND, byval CtrlID as long ) as HWND

    dim pWindow as CWindow ptr = New CWindow

    ' WS_EX_CONTROLPARENT is LOAD-BEARING, not decoration. PsTextBox handles VK_TAB itself by
    ' walking GetAncestor(GA_ROOT) + GetNextDlgTabItem, and that walk only sees through a
    ' container that declares itself one. Without it, tabbing into or out of the value field
    ' stops working the moment the textbox is nested inside this control.
    dim as HWND hCtrl = _
            pWindow->Create( hWndParent, "", @PsNumericUpDown_WndProc, _
            0, 0, 0, 0, WS_CHILD or WS_CLIPSIBLINGS or WS_CLIPCHILDREN, _
            WS_EX_CONTROLPARENT _
            )

    ' NOTE: CS_DBLCLKS is deliberately NOT enabled here -- see the WndProc header.

    dim as PSNUMERICUPDOWN_STATE ptr pNud = new PSNUMERICUPDOWN_STATE
    pNud->hWin     = hCtrl
    pNud->idc_Ctrl = CtrlID

    ' Only the Create-time defaults are DPI-scaled for us; every setter afterwards takes raw
    ' pixels and the caller scales (the family rule).
    '
    ' nBorderThick and nDividerThick are NOT scaled -- a hairline should stay a hairline,
    ' PsMenuBar's nSeparatorThickness rule. nGlyphThick IS scaled, and that asymmetry is
    ' deliberate: the border and divider are rules, while the glyph bars are the strokes of an
    ' icon, and scaling an icon's length but not its weight makes it thinner relative to
    ' itself on every step up in DPI. At 1.75x the unscaled version was 18 pixels long and 1
    ' thick, which read as a thread rather than a minus sign.
    '
    ' ScaleY for the thickness because the "-" bar's thickness is a vertical extent; ScaleX
    ' and ScaleY agree in practice, and picking the axis the primary glyph is measured on
    ' keeps the choice explicable. Floored at 1 so a fractional scale can never round a
    ' visible bar away to nothing.
    pNud->nButtonWidth   = pWindow->ScaleX( CNUD_DEFAULT_BUTTONW )
    pNud->nValuePadLeft  = pWindow->ScaleX( CNUD_DEFAULT_VALUEPAD )
    pNud->nValuePadRight = pWindow->ScaleX( CNUD_DEFAULT_VALUEPAD )
    pNud->nVertPadding   = pWindow->ScaleY( CNUD_DEFAULT_VERTPAD )
    pNud->nCornerRadius  = pWindow->ScaleX( CNUD_DEFAULT_CORNERRADIUS )
    pNud->nGlyphLength   = pWindow->ScaleX( CNUD_DEFAULT_GLYPHLENGTH )
    pNud->nGlyphThick    = pWindow->ScaleY( CNUD_DEFAULT_GLYPHTHICK )
    if pNud->nGlyphThick < 1 then pNud->nGlyphThick = 1

    SetWindowLongPtr( hCtrl, GWLP_ID, CtrlID )

    ' Store the pointer BEFORE creating the child: the child's creation sends messages to
    ' this window, and a handler that found a null pointer would silently do nothing.
    pWindow->UserData(0) = cast(LONG_PTR, pNud)

    ' The pump obligation, registered: a PsApp pump calls our filter (one for every instance).
    PsRegistry_AddGlobalFilter( @PsNumericUpDown_FilterMessage )

    ' ---- the value field ----------------------------------------------------------------
    ' Borderless, because THIS control owns every pixel of chrome; numeric, because that is
    ' the whole reason for embedding a PsTextBox rather than drawing the number ourselves.
    pNud->hTextBox = PsTextBox_Create( hCtrl, CtrlID )
    if pNud->hTextBox then
        PsTextBox_SetBorderWidth( pNud->hTextBox, 0 )
        PsTextBox_SetNumericMode( pNud->hTextBox, true )
        PsTextBox_SetDecimalPlaces( pNud->hTextBox, pNud->nDecimalPlaces )
        ' Never show an empty box: with a range there is no "no value" state to represent,
        ' so an empty buffer displays the formatted zero instead of the (unset) cue banner.
        PsTextBox_SetZeroWhenEmpty( pNud->hTextBox, true )
        ' Tab in and the whole number is selected, so the first keystroke replaces it. A
        ' button click deliberately bypasses this -- see WM_LBUTTONDOWN.
        PsTextBox_SetSelectOnFocus( pNud->hTextBox, true )
        PsTextBox_SetMargins( pNud->hTextBox, pNud->nValuePadLeft, pNud->nValuePadRight )
        ' Centred, which is the whole reason PsTextBox grew an alignment setter. It is set
        ' HERE, while the buffer is still empty, and that timing is not incidental: applying
        ' alignment rewrites the buffer and discards the undo history, so a control that has
        ' been typed into pays for it. At Create there is nothing to pay.
        PsTextBox_SetTextAlign( pNud->hTextBox, TXT_ALIGN_CENTER )
        NUD_ApplyStateColors( pNud )

        PsTextBox_SetFocusCallback( pNud->hTextBox, @NUD_OnTextBoxFocus )
        PsTextBox_SetEnterPressedCallback( pNud->hTextBox, @NUD_OnTextBoxEnter )
        PsTextBox_SetMessageCallback( pNud->hTextBox, @NUD_OnTextBoxMessage )

        PsTextBox_SetValue( pNud->hTextBox, pNud->nValue )
        ShowWindow( pNud->hTextBox, SW_SHOW )
    end if

    ' The theme and the form's fonts, applied now if a PsApp program has them (PsRegistry).
    PsRegistry_SetThemeProcs( hCtrl, @PsNumericUpDown_ApplyTheme, @PsNumericUpDown_ApplyFonts, @PsNumericUpDown_Rescale )

    function = hCtrl

end function


public function PsNumericUpDown_GetTextBoxHandle( byval hCtrl as HWND ) as HWND
    dim as PSNUMERICUPDOWN_STATE ptr pNud = GetNumericUpDownPointer(hCtrl)
    if pNud = 0 then return 0
    return pNud->hTextBox
end function

' Focus sits on the RichEdit two levels down, so a plain GetFocus() = hCtrl is always false.
function PsNumericUpDown_HasFocus( byval hCtrl as HWND ) as boolean
    dim as PSNUMERICUPDOWN_STATE ptr pNud = GetNumericUpDownPointer(hCtrl)
    if pNud = 0 then return false
    if pNud->hTextBox = 0 then return false
    return PsTextBox_HasFocus( pNud->hTextBox )
end function


' ========================================================================================
' Value.  Every setter here is SILENT -- see NUD_ValueChangedCallbackSub.
' ========================================================================================
public function PsNumericUpDown_GetValue( byval hCtrl as HWND ) as double
    dim as PSNUMERICUPDOWN_STATE ptr pNud = GetNumericUpDownPointer(hCtrl)
    if pNud = 0 then return 0
    return pNud->nValue
end function

public sub PsNumericUpDown_SetValue( byval hCtrl as HWND, byval nValue as double )
    dim as PSNUMERICUPDOWN_STATE ptr pNud = GetNumericUpDownPointer(hCtrl)
    if pNud = 0 then exit sub
    NUD_DisplayValue( pNud, pNud->ClampToRange( pNud->SnapToPlaces( nValue ) ) )
end sub

public sub PsNumericUpDown_GetRange( byval hCtrl as HWND, byref nMin as double, byref nMax as double )
    dim as PSNUMERICUPDOWN_STATE ptr pNud = GetNumericUpDownPointer(hCtrl)
    if pNud = 0 then
        nMin = 0 : nMax = 0
        exit sub
    end if
    nMin = pNud->nMin
    nMax = pNud->nMax
end sub

' An inverted pair is swapped rather than rejected: the alternative is a control whose
' ClampToRange can never be satisfied, and every subsequent step would pin to nMin.
public sub PsNumericUpDown_SetRange( byval hCtrl as HWND, byval nMin as double, byval nMax as double )
    dim as PSNUMERICUPDOWN_STATE ptr pNud = GetNumericUpDownPointer(hCtrl)
    if pNud = 0 then exit sub

    if nMin > nMax then swap nMin, nMax
    pNud->nMin = nMin
    pNud->nMax = nMax
    ' Re-clamp what is already displayed -- silently, like every setter here.
    NUD_DisplayValue( pNud, pNud->ClampToRange( pNud->nValue ) )
end sub

public function PsNumericUpDown_GetIncrement( byval hCtrl as HWND ) as double
    dim as PSNUMERICUPDOWN_STATE ptr pNud = GetNumericUpDownPointer(hCtrl)
    if pNud = 0 then return 0
    return pNud->nIncrement
end function

public sub PsNumericUpDown_SetIncrement( byval hCtrl as HWND, byval nIncrement as double )
    dim as PSNUMERICUPDOWN_STATE ptr pNud = GetNumericUpDownPointer(hCtrl)
    if pNud = 0 then exit sub
    pNud->nIncrement = abs(nIncrement)
end sub

function PsNumericUpDown_GetLargeIncrement( byval hCtrl as HWND ) as double
    dim as PSNUMERICUPDOWN_STATE ptr pNud = GetNumericUpDownPointer(hCtrl)
    if pNud = 0 then return 0
    return pNud->nLargeIncrement
end function

public sub PsNumericUpDown_SetLargeIncrement( byval hCtrl as HWND, byval nIncrement as double )
    dim as PSNUMERICUPDOWN_STATE ptr pNud = GetNumericUpDownPointer(hCtrl)
    if pNud = 0 then exit sub
    pNud->nLargeIncrement = abs(nIncrement)
end sub

public function PsNumericUpDown_GetDecimalPlaces( byval hCtrl as HWND ) as long
    dim as PSNUMERICUPDOWN_STATE ptr pNud = GetNumericUpDownPointer(hCtrl)
    if pNud = 0 then return 0
    return pNud->nDecimalPlaces
end function

' Changing the grid re-snaps the current value onto it, so 16.25 at 2 places becomes 16 at 0.
' The PsTextBox is told too: it is what refuses a typed decimal separator at 0 places.
public sub PsNumericUpDown_SetDecimalPlaces( byval hCtrl as HWND, byval nPlaces as long )
    dim as PSNUMERICUPDOWN_STATE ptr pNud = GetNumericUpDownPointer(hCtrl)
    if pNud = 0 then exit sub
    if nPlaces < 0 then nPlaces = 0

    pNud->nDecimalPlaces = nPlaces
    if pNud->hTextBox then PsTextBox_SetDecimalPlaces( pNud->hTextBox, nPlaces )
    NUD_DisplayValue( pNud, pNud->ClampToRange( pNud->SnapToPlaces( pNud->nValue ) ) )
end sub

' The programmatic door to exactly what the buttons do -- minus the notification, because
' this is a programmatic setter (the family rule).
public sub PsNumericUpDown_StepUp( byval hCtrl as HWND )
    dim as PSNUMERICUPDOWN_STATE ptr pNud = GetNumericUpDownPointer(hCtrl)
    if pNud = 0 then exit sub
    NUD_DisplayValue( pNud, pNud->ClampToRange( pNud->SnapToPlaces( NUD_CurrentValue(pNud) + pNud->nIncrement ) ) )
end sub

public sub PsNumericUpDown_StepDown( byval hCtrl as HWND )
    dim as PSNUMERICUPDOWN_STATE ptr pNud = GetNumericUpDownPointer(hCtrl)
    if pNud = 0 then exit sub
    NUD_DisplayValue( pNud, pNud->ClampToRange( pNud->SnapToPlaces( NUD_CurrentValue(pNud) - pNud->nIncrement ) ) )
end sub

public function PsNumericUpDown_GetReadOnly( byval hCtrl as HWND ) as boolean
    dim as PSNUMERICUPDOWN_STATE ptr pNud = GetNumericUpDownPointer(hCtrl)
    if pNud = 0 then return false
    return pNud->bReadOnly
end function

' Stops TYPING only. The buttons, the arrows and the wheel keep working -- "you may not type
' an arbitrary number here" is a different statement from "this control is inert".
public sub PsNumericUpDown_SetReadOnly( byval hCtrl as HWND, byval bReadOnly as boolean )
    dim as PSNUMERICUPDOWN_STATE ptr pNud = GetNumericUpDownPointer(hCtrl)
    if pNud = 0 then exit sub
    pNud->bReadOnly = bReadOnly
    if pNud->hTextBox then PsTextBox_SetReadOnly( pNud->hTextBox, bReadOnly )
end sub


' ========================================================================================
' State and behavior
' ========================================================================================
public function PsNumericUpDown_GetEnabled( byval hCtrl as HWND ) as boolean
    dim as PSNUMERICUPDOWN_STATE ptr pNud = GetNumericUpDownPointer(hCtrl)
    if pNud = 0 then return false
    return pNud->isEnabled
end function

' EnableWindow on BOTH windows, not a cosmetic flag. Disabling only the container would leave
' the PsTextBox itself enabled, and a programmatic SetFocus could still drop a caret into a
' control that looks dead. WM_ENABLE (above) does the state and color work for both calls.
public sub PsNumericUpDown_SetEnabled( byval hCtrl as HWND, byval isEnabled as boolean )
    dim as PSNUMERICUPDOWN_STATE ptr pNud = GetNumericUpDownPointer(hCtrl)
    if pNud = 0 then exit sub

    if pNud->hTextBox then EnableWindow( pNud->hTextBox, isEnabled )
    EnableWindow( hCtrl, isEnabled )
end sub

sub PsNumericUpDown_GetAutoRepeat( byval hCtrl as HWND, byref nDelayMs as long, byref nIntervalMs as long )
    dim as PSNUMERICUPDOWN_STATE ptr pNud = GetNumericUpDownPointer(hCtrl)
    if pNud = 0 then
        nDelayMs = 0 : nIntervalMs = 0
        exit sub
    end if
    nDelayMs    = pNud->nRepeatDelayMs
    nIntervalMs = pNud->nRepeatIntervalMs
end sub

' Either value <= 0 disables repeating: one click = one step.
sub PsNumericUpDown_SetAutoRepeat( byval hCtrl as HWND, byval nDelayMs as long, byval nIntervalMs as long )
    dim as PSNUMERICUPDOWN_STATE ptr pNud = GetNumericUpDownPointer(hCtrl)
    if pNud = 0 then exit sub
    pNud->nRepeatDelayMs    = nDelayMs
    pNud->nRepeatIntervalMs = nIntervalMs
    if (nDelayMs <= 0) orelse (nIntervalMs <= 0) then NUD_StopRepeat( pNud, hCtrl )
end sub

sub PsNumericUpDown_Refresh( byval hCtrl as HWND )
    dim as PSNUMERICUPDOWN_STATE ptr pNud = GetNumericUpDownPointer(hCtrl)
    if pNud = 0 then exit sub
    pNud->Refresh()
    NUD_SyncChild( pNud )
end sub


' ========================================================================================
' Layout
' ========================================================================================
function PsNumericUpDown_GetFont( byval hCtrl as HWND ) as HFONT
    dim as PSNUMERICUPDOWN_STATE ptr pNud = GetNumericUpDownPointer(hCtrl)
    if pNud = 0 then return 0
    return pNud->hFont
end function

' CALLER-OWNED: the control converts nothing and deletes nothing; the PsTextBox turns it into
' a CHARFORMATW internally and also never takes ownership.
public sub PsNumericUpDown_SetFont( byval hCtrl as HWND, byval hFont as HFONT )
    dim as PSNUMERICUPDOWN_STATE ptr pNud = GetNumericUpDownPointer(hCtrl)
    if pNud = 0 then exit sub
    pNud->hFont = hFont
    ' A font change re-applies the CHARFORMAT but leaves the paragraph format alone, so the
    ' centring set at Create is untouched -- and re-applying it here would be actively
    ' harmful, since doing so rewrites the buffer and drops the undo history.
    if pNud->hTextBox then PsTextBox_SetFont( pNud->hTextBox, hFont )
    pNud->Refresh()
end sub

public function PsNumericUpDown_GetButtonWidth( byval hCtrl as HWND ) as long
    dim as PSNUMERICUPDOWN_STATE ptr pNud = GetNumericUpDownPointer(hCtrl)
    if pNud = 0 then return 0
    return pNud->nButtonWidth
end function

sub PsNumericUpDown_SetButtonWidth( byval hCtrl as HWND, byval nWidth as long )
    dim as PSNUMERICUPDOWN_STATE ptr pNud = GetNumericUpDownPointer(hCtrl)
    if pNud = 0 then exit sub
    if nWidth < 0 then nWidth = 0
    pNud->nButtonWidth = nWidth
    pNud->Refresh()
    NUD_SyncChild( pNud )
end sub

public sub PsNumericUpDown_GetValuePadding( byval hCtrl as HWND, byref nLeft as long, byref nRight as long, byref nVert as long )
    dim as PSNUMERICUPDOWN_STATE ptr pNud = GetNumericUpDownPointer(hCtrl)
    if pNud = 0 then
        nLeft = 0 : nRight = 0 : nVert = 0
        exit sub
    end if
    nLeft  = pNud->nValuePadLeft
    nRight = pNud->nValuePadRight
    nVert  = pNud->nVertPadding
end sub

' nLeft/nRight are real text margins inside the value cell (EM_SETMARGINS on the RichEdit);
' nVert is the vertical clearance inside the value cell: it insets rcValue top and bottom (so
' the borderless RichEdit's line clears the frame) AND is reserved by GetIdealSize when sizing
' the height around one line of text -- the two agree, so an ideal-height control has a value
' cell exactly one text-line tall.
sub PsNumericUpDown_SetValuePadding( byval hCtrl as HWND, byval nLeft as long, byval nRight as long, byval nVert as long )
    dim as PSNUMERICUPDOWN_STATE ptr pNud = GetNumericUpDownPointer(hCtrl)
    if pNud = 0 then exit sub
    if nLeft < 0 then nLeft = 0
    if nRight < 0 then nRight = 0
    if nVert < 0 then nVert = 0
    pNud->nValuePadLeft  = nLeft
    pNud->nValuePadRight = nRight
    pNud->nVertPadding   = nVert
    if pNud->hTextBox then PsTextBox_SetMargins( pNud->hTextBox, nLeft, nRight )
    pNud->Refresh()
end sub

function PsNumericUpDown_GetCornerRadius( byval hCtrl as HWND ) as long
    dim as PSNUMERICUPDOWN_STATE ptr pNud = GetNumericUpDownPointer(hCtrl)
    if pNud = 0 then return 0
    return pNud->nCornerRadius
end function

sub PsNumericUpDown_SetCornerRadius( byval hCtrl as HWND, byval nRadius as long )
    dim as PSNUMERICUPDOWN_STATE ptr pNud = GetNumericUpDownPointer(hCtrl)
    if pNud = 0 then exit sub
    if nRadius < 0 then nRadius = 0
    pNud->nCornerRadius = nRadius
    pNud->Refresh()
end sub

public function PsNumericUpDown_GetBorderThickness( byval hCtrl as HWND ) as long
    dim as PSNUMERICUPDOWN_STATE ptr pNud = GetNumericUpDownPointer(hCtrl)
    if pNud = 0 then return 0
    return pNud->nBorderThick
end function

sub PsNumericUpDown_SetBorderThickness( byval hCtrl as HWND, byval nThickness as long )
    dim as PSNUMERICUPDOWN_STATE ptr pNud = GetNumericUpDownPointer(hCtrl)
    if pNud = 0 then exit sub
    if nThickness < 0 then nThickness = 0
    pNud->nBorderThick = nThickness
    pNud->Refresh()
    NUD_SyncChild( pNud )
end sub

public function PsNumericUpDown_GetDividerThickness( byval hCtrl as HWND ) as long
    dim as PSNUMERICUPDOWN_STATE ptr pNud = GetNumericUpDownPointer(hCtrl)
    if pNud = 0 then return 0
    return pNud->nDividerThick
end function

sub PsNumericUpDown_SetDividerThickness( byval hCtrl as HWND, byval nThickness as long )
    dim as PSNUMERICUPDOWN_STATE ptr pNud = GetNumericUpDownPointer(hCtrl)
    if pNud = 0 then exit sub
    if nThickness < 0 then nThickness = 0
    pNud->nDividerThick = nThickness
    pNud->Refresh()
    NUD_SyncChild( pNud )
end sub

public sub PsNumericUpDown_GetGlyphSize( byval hCtrl as HWND, byref nLength as long, byref nThickness as long )
    dim as PSNUMERICUPDOWN_STATE ptr pNud = GetNumericUpDownPointer(hCtrl)
    if pNud = 0 then
        nLength = 0 : nThickness = 0
        exit sub
    end if
    nLength    = pNud->nGlyphLength
    nThickness = pNud->nGlyphThick
end sub

public sub PsNumericUpDown_SetGlyphSize( byval hCtrl as HWND, byval nLength as long, byval nThickness as long )
    dim as PSNUMERICUPDOWN_STATE ptr pNud = GetNumericUpDownPointer(hCtrl)
    if pNud = 0 then exit sub
    if nLength < 1 then nLength = 1
    if nThickness < 1 then nThickness = 1
    pNud->nGlyphLength = nLength
    pNud->nGlyphThick  = nThickness
    pNud->Refresh()
end sub

' ========================================================================================
' The ideal size: what the control needs to show the WIDEST value its range can produce.
'
' Both ends of the range are measured, not just the max: -1000 is wider than 999, and a range
' that never goes negative should not pay for a minus sign it will never draw.
'
' THIS IS THE ONLY PLACE THIS CONTROL MEASURES ANYTHING, and it opens its own DC to do it --
' which is what makes it valid BEFORE the control has ever been sized, when a host is calling
' it precisely to decide how big to make the thing. (LayoutControl, by contrast, takes no DC
' at all: every cell is derived from the client rect and authored scalars.)
' ========================================================================================
public sub PsNumericUpDown_GetIdealSize( byval hCtrl as HWND, byref nWidth as long, byref nHeight as long )
    nWidth = 0 : nHeight = 0
    dim as PSNUMERICUPDOWN_STATE ptr pNud = GetNumericUpDownPointer(hCtrl)
    if pNud = 0 then exit sub

    dim as HDC hdc = GetDC( hCtrl )
    if hdc = 0 then exit sub

    dim as HFONT hFontUse = pNud->hFont
    if hFontUse = 0 then hFontUse = cast( HFONT, GetStockObject(DEFAULT_GUI_FONT) )
    dim as HFONT hFontOld = cast( HFONT, SelectObject( hdc, hFontUse ) )

    dim as ustring wszMin = NUD_FormatValue( pNud->nMin, pNud->nDecimalPlaces )
    dim as ustring wszMax = NUD_FormatValue( pNud->nMax, pNud->nDecimalPlaces )

    dim as SIZE szMin, szMax
    GetTextExtentPoint32W( hdc, wszMin, len(wszMin), @szMin )
    GetTextExtentPoint32W( hdc, wszMax, len(wszMax), @szMax )
    dim as long textW = szMin.cx
    if szMax.cx > textW then textW = szMax.cx

    dim as TEXTMETRICW tm
    GetTextMetricsW( hdc, @tm )

    SelectObject( hdc, hFontOld )
    ReleaseDC( hCtrl, hdc )

    nWidth = (pNud->nButtonWidth * 2) + (pNud->nDividerThick * 2) + _
             pNud->nValuePadLeft + pNud->nValuePadRight + textW
    nHeight = tm.tmHeight + (pNud->nVertPadding * 2) + (pNud->nBorderThick * 2)
end sub


' The rect queries force a pending layout, so results are always current. FALSE means the
' control has no geometry yet (created but never sized).
private function NUD_GetRect( byval hCtrl as HWND, byref rc as RECT, byval iPart as long ) as boolean
    dim as PSNUMERICUPDOWN_STATE ptr pNud = GetNumericUpDownPointer(hCtrl)
    SetRectEmpty( @rc )
    if pNud = 0 then return false
    if pNud->bLayoutDirty then pNud->LayoutControl()
    if pNud->bLayoutDirty then return false      ' still no geometry: never been sized

    select case iPart
    case NUD_PART_MINUS : rc = pNud->rcMinus
    case NUD_PART_VALUE : rc = pNud->rcValue
    case NUD_PART_PLUS  : rc = pNud->rcPlus
    case else           : rc = pNud->rcFrame
    end select
    return true
end function

public function PsNumericUpDown_GetFrameRect( byval hCtrl as HWND, byref rc as RECT ) as boolean
    return NUD_GetRect( hCtrl, rc, NUD_PART_NONE )
end function

public function PsNumericUpDown_GetMinusRect( byval hCtrl as HWND, byref rc as RECT ) as boolean
    return NUD_GetRect( hCtrl, rc, NUD_PART_MINUS )
end function

public function PsNumericUpDown_GetValueRect( byval hCtrl as HWND, byref rc as RECT ) as boolean
    return NUD_GetRect( hCtrl, rc, NUD_PART_VALUE )
end function

public function PsNumericUpDown_GetPlusRect( byval hCtrl as HWND, byref rc as RECT ) as boolean
    return NUD_GetRect( hCtrl, rc, NUD_PART_PLUS )
end function

public function PsNumericUpDown_HitTest( byval hCtrl as HWND, byval pt as POINT ) as long
    dim as PSNUMERICUPDOWN_STATE ptr pNud = GetNumericUpDownPointer(hCtrl)
    if pNud = 0 then return NUD_PART_NONE
    return NUD_HitTestPart( pNud, pt )
end function


' ========================================================================================
' Appearance
' ========================================================================================
public sub PsNumericUpDown_GetColors( byval hCtrl as HWND, byval pColors as PSNUMERICUPDOWN_COLORS ptr )
    dim as PSNUMERICUPDOWN_STATE ptr pNud = GetNumericUpDownPointer(hCtrl)
    if (pNud = 0) orelse (pColors = 0) then exit sub
    *pColors = pNud->colors
end sub

' Copies the whole struct, then pushes the value cell's two colors into the PsTextBox -- the
' RichEdit draws the number, so those two have to live on the child even though they are
' authored here.
public sub PsNumericUpDown_SetColors( byval hCtrl as HWND, byval pColors as PSNUMERICUPDOWN_COLORS ptr )
    dim as PSNUMERICUPDOWN_STATE ptr pNud = GetNumericUpDownPointer(hCtrl)
    if (pNud = 0) orelse (pColors = 0) then exit sub
    pNud->colors = *pColors
    pNud->bColorsPinned = true
    NUD_ApplyStateColors( pNud )
    pNud->Refresh()
end sub

' ========================================================================================
' The theme (vendor/PsControls/PsTheme). ThemeColors is the adapter: the control's colours
' derived from the theme's roles. ApplyTheme applies them unless the host pinned its own.
' ========================================================================================
public function PsNumericUpDown_ThemeColors( byref t as PSTHEME_COLORS ) as PSNUMERICUPDOWN_COLORS
    dim as PSNUMERICUPDOWN_COLORS c
    c.BackColor               = t.Window
    c.BorderColor             = t.Border
    c.FocusBorderColor        = t.FocusRing
    c.BorderColorDisabled     = t.BorderDisabled
    c.DividerColor            = t.Divider
    c.DividerColorDisabled    = t.BorderDisabled
    c.ValueBackColor          = t.Surface
    c.ValueForeColor          = t.Text
    c.ValueBackColorDisabled  = t.SurfaceDisabled
    c.ValueForeColorDisabled  = t.TextDisabled
    c.ButtonBackColor         = t.Surface
    c.ButtonBackColorHot      = t.SurfaceHot
    c.ButtonBackColorPressed  = t.Selected
    c.ButtonBackColorDisabled = t.SurfaceDisabled
    c.GlyphColor              = t.Text
    c.GlyphColorHot           = t.TextHot
    c.GlyphColorPressed       = t.SelectedText
    c.GlyphColorDisabled      = t.TextDisabled
    return c
end function

public sub PsNumericUpDown_ApplyTheme( byval hCtrl as HWND, byref t as PSTHEME_COLORS )
    dim as PSNUMERICUPDOWN_STATE ptr pNud = GetNumericUpDownPointer(hCtrl)
    if (pNud = 0) orelse pNud->bColorsPinned then exit sub
    dim as PSNUMERICUPDOWN_COLORS c = PsNumericUpDown_ThemeColors( t )
    PsNumericUpDown_SetColors( hCtrl, @c )
    pNud->bColorsPinned = false
end sub

' Hands the control back to the theme, which is applied at once.
public sub PsNumericUpDown_UnpinColors( byval hCtrl as HWND )
    dim as PSNUMERICUPDOWN_STATE ptr pNud = GetNumericUpDownPointer(hCtrl)
    if pNud = 0 then exit sub
    pNud->bColorsPinned = false
    dim as PSTHEME_COLORS t
    if PsRegistry_GetTheme( t ) then PsNumericUpDown_ApplyTheme( hCtrl, t )
end sub

' The form's fonts (PsApp), handed over when the control is created on a form. No glyph font:
' the +/- glyphs are drawn bars.
public sub PsNumericUpDown_ApplyFonts( byval hCtrl as HWND, byval hTextFont as HFONT, byval hGlyphFont as HFONT )
    if hTextFont then PsNumericUpDown_SetFont( hCtrl, hTextFont )
end sub

' ========================================================================================
' Per-monitor DPI (RFC-0001 P4). Every stored pixel metric -- the scaled Create defaults and
' whatever the host set since -- times newDpi/oldDpi; nBorderThick and nDividerThick stay as
' they are (hairlines, never scaled). The embedded PsTextBox has its own registry row and
' rescales itself, its margins included, so they are NOT pushed to it from here (that would
' scale them twice); the re-layout only moves it onto the new rcValue. The control's own
' CWindow takes the new DPI. The fonts are not ours: PsApp hands new ones over after this.
' ========================================================================================
public sub PsNumericUpDown_Rescale( byval hCtrl as HWND, byval oldDpi as long, byval newDpi as long )
    dim as PSNUMERICUPDOWN_STATE ptr pNud = GetNumericUpDownPointer(hCtrl)
    if (pNud = 0) orelse (oldDpi <= 0) orelse (newDpi <= 0) orelse (oldDpi = newDpi) then exit sub
    pNud->nButtonWidth   = MulDiv( pNud->nButtonWidth,   newDpi, oldDpi )
    pNud->nValuePadLeft  = MulDiv( pNud->nValuePadLeft,  newDpi, oldDpi )
    pNud->nValuePadRight = MulDiv( pNud->nValuePadRight, newDpi, oldDpi )
    pNud->nVertPadding   = MulDiv( pNud->nVertPadding,   newDpi, oldDpi )
    pNud->nCornerRadius  = MulDiv( pNud->nCornerRadius,  newDpi, oldDpi )
    pNud->nGlyphLength   = MulDiv( pNud->nGlyphLength,   newDpi, oldDpi )
    pNud->nGlyphThick    = MulDiv( pNud->nGlyphThick,    newDpi, oldDpi )
    if pNud->nGlyphLength < 1 then pNud->nGlyphLength = 1
    if pNud->nGlyphThick < 1 then pNud->nGlyphThick = 1
    dim as CWindow ptr pWindow = CWindowPtr( hCtrl )
    if pWindow then pWindow->DPI = newDpi
    pNud->Refresh()
    NUD_SyncChild( pNud )
end sub


' ========================================================================================
' Callbacks
' ========================================================================================
public sub PsNumericUpDown_SetPaintCallback( byval hCtrl as HWND, byval usersub as NUD_PaintCallbackSub )
    dim as PSNUMERICUPDOWN_STATE ptr pNud = GetNumericUpDownPointer(hCtrl)
    if pNud = 0 then exit sub
    pNud->PaintCallback = usersub
    if pNud->hWin then InvalidateRect( pNud->hWin, NULL, TRUE )
end sub

public sub PsNumericUpDown_SetMessageCallback( byval hCtrl as HWND, byval userfunc as NUD_MessageCallbackFunc )
    dim as PSNUMERICUPDOWN_STATE ptr pNud = GetNumericUpDownPointer(hCtrl)
    if pNud = 0 then exit sub
    pNud->MessageCallback = userfunc
end sub

public sub PsNumericUpDown_SetValueChangedCallback( byval hCtrl as HWND, byval usersub as NUD_ValueChangedCallbackSub )
    dim as PSNUMERICUPDOWN_STATE ptr pNud = GetNumericUpDownPointer(hCtrl)
    if pNud = 0 then exit sub
    pNud->ValueChangedCallback = usersub
end sub


' ========================================================================================
' Host message pump.
'
' One line of forwarding, and it exists so a host adopting this control has ONE call to add
' rather than having to know that there is a PsTextBox inside it with a PsPopupMenu inside
' that. An app already calling PsTextBox_FilterMessage is covered either way, and calling both
' is harmless -- the filter finds the single open menu chain, or finds none.
' ========================================================================================
public function PsNumericUpDown_FilterMessage( byval pMsg as MSG ptr ) as boolean
    return PsTextBox_FilterMessage( pMsg )
end function
