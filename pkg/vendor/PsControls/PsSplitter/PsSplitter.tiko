'    Owner-drawn splitter bar control
'
'    A self-contained, per-instance control in the same vein as PsVScrollBar/PsStatusBar: it
'    owns its own window class and keeps all state per instance in the CWindow UserData
'    area, so any number of instances can coexist.
'
'    WHAT IT IS NOT: the control does not own, create, size, or even know about the pane
'    windows on either side of it. It maintains exactly one number -- the splitter's
'    position -- and tells the host when the user changes it. The host owns its own layout.
'
'    THE POSITION
'      nPos is the bar's LEADING EDGE expressed in the PARENT's client coordinates:
'          PSSPLITTER_VERTICAL   -> the bar's x (a vertical bar splitting left/right panes)
'          PSSPLITTER_HORIZONTAL -> the bar's y (a horizontal bar splitting top/bottom panes)
'      The orientation is named for the BAR's own axis, not for the panes it separates.
'      Min/max limits are in that same coordinate space.
'
'    THE DRAG
'      Live: on every mouse move the control clamps the new position, moves ITSELF with
'      SetWindowPos, then fires the notification. The host only has to lay out the two
'      panes; re-placing the bar from the host's own layout pass is a harmless no-op.

#module "PsSplitter"

#ifndef TIKO_OS_WINDOWS
    #error "vendor/PsControls is Windows-only (Win32 controls): build for -target windows-x86_64, or use vendor/tkControls"
#endif

#import "sys/win"
#import "sys/win/gui"
#import "sys/win/gdiplus"
#import "vendor/PsControls/PsBufferPaint"
#import "vendor/PsControls/PsRegistry"
#import "vendor/PsControls/PsTheme"

using gui
using gdiplus
using PsBufferPaint
using PsRegistry
using PsTheme

' Polling timer that guarantees hot-tracking is cleared when the mouse leaves the control.
' WM_MOUSELEAVE (TME_LEAVE) is not reliably delivered on fast exits, so a periodic cursor
' check acts as a safety net. Timer IDs are per-window, so every instance can share this id.
public const IDT_CSPLITTER_HOTTRACK = &hCB20
public const PSSPLITTER_HOTTRACK_MS = 100

' Named for the BAR's own axis: a VERTICAL bar is a vertical line separating a left and a
' right pane, and drags horizontally (IDC_SIZEWE).
public enum PSSPLITTER_ORIENTATION
    PSSPLITTER_VERTICAL   = 0     ' vertical bar,   left/right panes -> IDC_SIZEWE, nPos = x
    PSSPLITTER_HORIZONTAL = 1     ' horizontal bar, top/bottom panes -> IDC_SIZENS, nPos = y
end enum

' Phase of the position notification. BEGIN and END bracket a user drag; a host uses them
' for the work that is too expensive to do per-pixel (hiding scrollbars, deferring a
' reflow, committing the new layout to config).
public enum PSSPLITTER_PHASE
    PSSPLITTER_PHASE_BEGIN = 0    ' the user just grabbed the bar; newPos = current position
    PSSPLITTER_PHASE_MOVE  = 1    ' the position actually changed
    PSSPLITTER_PHASE_END   = 2    ' the drag ended (button up, or capture lost); final position
end enum

public type PSSPLITTER_PAINTINFO
    hSplitter    as HWND                  ' the control, so the callback can query it
    b            as PsPaintBuffer ptr   ' the control's buffer for this repaint (no copy)
    rcClient     as RECT                  ' the whole bar, in client coordinates
    nOrientation as integer               ' PSSPLITTER_VERTICAL / PSSPLITTER_HORIZONTAL
    isHot        as boolean               ' the mouse is over the bar
    isDragging   as boolean               ' a drag is in progress (hot stays pinned true)
end type

public type PSSPLITTER_MESSAGEINFO
    hSplitter as HWND
    uMsg      as UINT
    wParam    as WPARAM
    lParam    as LPARAM
end type


' Paint the bar. Paint through p->b (the control's double buffer for this repaint) using
' p->rcClient -- do not touch the screen DC. If unset, a built-in default paint using the
' colors below is used; setting a callback replaces that default ENTIRELY.
public type SPL_PaintCallbackSub as sub( byval p as PSSPLITTER_PAINTINFO ptr )

' Observe mouse messages (including WM_LBUTTONDBLCLK -- the class carries CS_DBLCLKS -- and
' WM_SETCURSOR). Return TRUE if you handled it and want the control's default handling
' suppressed, FALSE to let it proceed.
'
' ONE ASYMMETRY, AND IT IS DELIBERATE: the result is IGNORED for WM_LBUTTONUP. The control
' holds the mouse capture for the duration of a drag and that up-message is the capture's
' exit; a callback allowed to suppress it would strand the capture and every subsequent
' click in the app would be routed here. See C:\dev\Learnings.md.
'
' Claiming WM_LBUTTONDBLCLK is the supported way to implement collapse/restore on a
' double-click: no drag starts, and the trailing WM_LBUTTONUP is harmless.
public type SPL_MessageCallbackFunc as function( byval m as PSSPLITTER_MESSAGEINFO ptr ) as boolean

' The user moved the splitter. newPos is the bar's new leading edge in PARENT client
' coordinates; nPhase is one of the PSSPLITTER_PHASE_* values. The control has already moved
' itself -- lay out the two panes and nothing else.
'
' NOT fired for PsSplitter_SetPos / PsSplitter_SetRange: programmatic setters are silent, so a
' host can call them from inside this very callback without re-entering itself.
public type SPL_PosChangedCallbackSub as sub( byval hSplitter as HWND, byval newPos as integer, _
                                       byval nPhase as integer )


public type PSSPLITTER_STATE
    hWin           as HWND
    ' TRUE once the host set the colours itself (PsSplitter_SetColors): the theme then leaves
    ' this splitter alone until PsSplitter_UnpinColors.
    bColorsPinned  as boolean
    hParent        as HWND                ' the coordinate space nPos lives in
    nOrientation   as integer = PSSPLITTER_VERTICAL
    ' --- Position model. nPos is the bar's leading edge in hParent's client coords. ---
    nPos           as integer = 0
    nMin           as integer = 0
    nMax           as integer = &h7FFFFFFF   ' effectively unbounded until SetRange is called
    ' --- Interaction ---
    isHot          as boolean = false
    isDragging     as boolean = false
    dragOffset     as integer = 0         ' cursor offset from the bar's leading edge at grab
    hotTimerOn     as boolean = false
    ' Shared system cursor (IDC_SIZEWE / IDC_SIZENS), loaded once at Create. NOT named
    ' hCursor: FreeBASIC is case-insensitive, so a member called hCursor would shadow the
    ' TYPE name HCURSOR inside every member procedure of this type, and "dim as HCURSOR x"
    ' there fails with a misleading "error 14: Expected identifier". Same trap as
    ' PsStatusBar's hPanelFont/HFONT. See C:\dev\Learnings.md.
    hBarCursor     as HCURSOR
    ' --- Appearance (used by the default paint; a PaintCallback overrides entirely) ---
    BackColor      as COLORREF = BGR(53,59,69)
    HotColor       as COLORREF = BGR(90,98,112)
    PaintCallback      as SPL_PaintCallbackSub
    MessageCallback    as SPL_MessageCallbackFunc
    PosChangedCallback as SPL_PosChangedCallbackSub

    declare function ClampPos( byval n as integer ) as integer
    declare function WindowRectInParent() as RECT
    declare function BarEdgeFromWindow() as integer
    declare function CursorAxisInParent() as integer
    declare sub      MoveBar()
    declare sub      Notify( byval nPhase as integer )
end type


' Clamp into [nMin, nMax]. An inverted range (max < min) collapses to min rather than
' rejecting the call -- a host recomputing limits on WM_SIZE legitimately produces one for
' a window too small to hold both panes, and pinning the bar is the sane result.
function PSSPLITTER_STATE.ClampPos( byval n as integer ) as integer
    dim as integer lo = this.nMin
    dim as integer hi = this.nMax
    if hi < lo then hi = lo
    if n < lo then n = lo
    if n > hi then n = hi
    return n
end function

' The control's own window rect, converted to the parent's client coordinates -- the space
' nPos is measured in.
function PSSPLITTER_STATE.WindowRectInParent() as RECT
    dim as RECT rc
    if this.hWin = 0 then return rc
    GetWindowRect( this.hWin, @rc )
    if this.hParent then
        MapWindowPoints( HWND_DESKTOP, this.hParent, cast( POINT ptr, @rc ), 2 )
    end if
    return rc
end function

' Where the bar ACTUALLY is, as opposed to where nPos says it is. Used to re-sync after the
' host moves us itself.
function PSSPLITTER_STATE.BarEdgeFromWindow() as integer
    dim as RECT rc = this.WindowRectInParent()
    if this.nOrientation = PSSPLITTER_VERTICAL then return rc.left
    return rc.top
end function

' The cursor's position along the drag axis, in parent client coordinates. Read from
' GetCursorPos rather than from a message's lParam on purpose: lParam is relative to a
' window we are moving mid-gesture, and applying it as an incremental delta makes clamping
' "sticky" (the bar starts moving again before the cursor has travelled back to the grab
' point). An absolute parent-relative read has neither problem.
function PSSPLITTER_STATE.CursorAxisInParent() as integer
    dim as POINT pt
    GetCursorPos( @pt )
    if this.hParent then ScreenToClient( this.hParent, @pt )
    if this.nOrientation = PSSPLITTER_VERTICAL then return pt.x
    return pt.y
end function

' Move the window to nPos along the drag axis ONLY. The cross-axis position and the size
' are read back from the window itself and preserved -- the control never invents geometry
' the host owns.
sub PSSPLITTER_STATE.MoveBar()
    if this.hWin = 0 then exit sub
    dim as RECT rc = this.WindowRectInParent()
    dim as integer x = rc.left
    dim as integer y = rc.top
    if this.nOrientation = PSSPLITTER_VERTICAL then
        x = this.nPos
    else
        y = this.nPos
    end if
    if (x = rc.left) andalso (y = rc.top) then exit sub
    SetWindowPos( this.hWin, NULL, x, y, 0, 0, _
                  SWP_NOSIZE or SWP_NOZORDER or SWP_NOACTIVATE )
end sub

sub PSSPLITTER_STATE.Notify( byval nPhase as integer )
    if this.PosChangedCallback then
        this.PosChangedCallback( this.hWin, this.nPos, nPhase )
    end if
end sub


' ========================================================================================
' PUBLIC API
' ========================================================================================
'
' THE CONTROL HANDLE
'   Every PsSplitter_* function takes the handle returned by PsSplitter_Create().
'
'   The handle is a real HWND on purpose (not an opaque type): callers legitimately need to
'   treat the control as a window, e.g. SetWindowPos() to place and size it.
'
' LIFETIME
'   The control frees itself when its window is destroyed. It loads no resource that needs
'   freeing (the resize cursors are shared system cursors -- never DestroyCursor them).
'
' ----------------------------------------------------------------------------------------
' Creation
'   CtrlID becomes the control window's id (GWLP_ID). There are no child controls.
'   The control is created zero-sized and hidden: position, size and show it with
'   SetWindowPos(). The width (or height) you give it IS the grab area -- there is no
'   separate hit margin; paint a thinner line inside it if you want a thin look.
'
'   The orientation is fixed for the control's lifetime. A host that switches split modes
'   destroys the control and creates the other one; that is cheaper than reasoning about an
'   nPos whose meaning changed axis underneath a stale range.
' ----------------------------------------------------------------------------------------
public declare function PsSplitter_Create( byval hWndParent as HWND, byval CtrlID as integer, _
                                   byval nOrientation as integer = PSSPLITTER_VERTICAL ) as HWND
public declare function PsSplitter_GetOrientation( byval hSplit as HWND ) as integer

' ----------------------------------------------------------------------------------------
' Position and limits. All values are the bar's LEADING EDGE in the PARENT's client
' coordinates (x for a vertical bar, y for a horizontal one).
'
'   PsSplitter_SetPos    clamps, moves the bar, repaints -- and fires NOTHING. This is the
'                       host telling the control where it put the splitter, not the user
'                       moving it.
'   PsSplitter_SetRange  the limits the drag clamps to. The control does NOT derive them
'                       from the parent's client rect, because it cannot know what else
'                       lives there (tiko's help viewer parks a scrollbar between the pane
'                       and the bar). Recompute and re-set them from your own WM_SIZE.
'                       Also clamps the current position into the new range, silently.
'   PsSplitter_GetPos    always agrees with where the bar actually is: the control re-syncs
'                       from its own window rect whenever the HOST moves it.
' ----------------------------------------------------------------------------------------
public declare function PsSplitter_GetPos( byval hSplit as HWND ) as integer
public declare sub      PsSplitter_SetPos( byval hSplit as HWND, byval nPosition as integer )
public declare sub      PsSplitter_SetRange( byval hSplit as HWND, byval nMin as integer, byval nMax as integer )
public declare function PsSplitter_GetMin( byval hSplit as HWND ) as integer
public declare function PsSplitter_GetMax( byval hSplit as HWND ) as integer

' ----------------------------------------------------------------------------------------
' State queries.
' ----------------------------------------------------------------------------------------
public declare function PsSplitter_IsHot( byval hSplit as HWND ) as boolean
public declare function PsSplitter_IsDragging( byval hSplit as HWND ) as boolean

' ----------------------------------------------------------------------------------------
' Appearance. Used by the built-in painter only; a PaintCallback ignores them.
' ----------------------------------------------------------------------------------------
public declare function PsSplitter_GetBackColor( byval hSplit as HWND ) as COLORREF
public declare sub      PsSplitter_SetColors( byval hSplit as HWND, byval backclr as COLORREF, byval hotclr as COLORREF )
public declare sub      PsSplitter_ApplyTheme( byval hSplit as HWND, byref t as PSTHEME_COLORS )
public declare sub      PsSplitter_Rescale( byval hSplit as HWND, byval oldDpi as long, byval newDpi as long )
public declare sub      PsSplitter_UnpinColors( byval hSplit as HWND )

' ----------------------------------------------------------------------------------------
' Callbacks. See the type declarations above for each signature and contract.
'   PaintCallback       - draw the bar. Optional; replaces the built-in painter.
'   MessageCallback     - observe mouse messages; return TRUE to suppress default handling
'                         (ignored for WM_LBUTTONUP).
'   PosChangedCallback  - the user moved the splitter (BEGIN / MOVE / END).
' ----------------------------------------------------------------------------------------
public declare sub      PsSplitter_SetPaintCallback( byval hSplit as HWND, byval usersub as SPL_PaintCallbackSub )
public declare sub      PsSplitter_SetMessageCallback( byval hSplit as HWND, byval userfunc as SPL_MessageCallbackFunc )
public declare sub      PsSplitter_SetPosChangedCallback( byval hSplit as HWND, byval usersub as SPL_PosChangedCallbackSub )

function GetSplitterPointer( byval hSplit as HWND ) as PSSPLITTER_STATE ptr
    dim pWindow as CWindow ptr = CWindowPtr(hSplit)
    if pWindow = 0 then return 0
    return cast( PSSPLITTER_STATE ptr, pWindow->UserData(0) )
end function


' ========================================================================================
' Hand a message to the host's message callback. Returns TRUE if the host claims it.
' Callers decide whether to honor that answer -- WM_LBUTTONUP deliberately does not.
' ========================================================================================
function PsSplitter_CallMessage( _
            byval pSpl   as PSSPLITTER_STATE ptr, _
            byval hwnd   as HWND, _
            byval uMsg   as UINT, _
            byval wParam as WPARAM, _
            byval lParam as LPARAM _
            ) as boolean

    if pSpl = 0 then return false
    if pSpl->MessageCallback = 0 then return false

    dim as PSSPLITTER_MESSAGEINFO m
    m.hSplitter = hwnd
    m.uMsg      = uMsg
    m.wParam    = wParam
    m.lParam    = lParam
    return pSpl->MessageCallback( @m )
end function


' ========================================================================================
' Clear the hover state and stop the hover poll timer. Repaints only if the state actually
' changes, so this is cheap to call repeatedly.
' ========================================================================================
sub PsSplitter_ClearHot( byval pSpl as PSSPLITTER_STATE ptr )
    if pSpl = 0 then return
    if pSpl->hotTimerOn then
        KillTimer( pSpl->hWin, IDT_CSPLITTER_HOTTRACK )
        pSpl->hotTimerOn = false
    end if
    if pSpl->isHot then
        pSpl->isHot = false
        InvalidateRect( pSpl->hWin, NULL, FALSE )
    end if
end sub


' ========================================================================================
' Arm the hover poll timer if it is not already running. WM_MOUSELEAVE is not reliably
' delivered on fast exits, so this periodic cursor check is the safety net.
' ========================================================================================
sub PsSplitter_ArmHotTimer( byval pSpl as PSSPLITTER_STATE ptr )
    if pSpl = 0 then return
    if pSpl->hotTimerOn then return
    SetTimer( pSpl->hWin, IDT_CSPLITTER_HOTTRACK, PSSPLITTER_HOTTRACK_MS, NULL )
    pSpl->hotTimerOn = true
end sub


' ========================================================================================
' End a drag, keeping the position the user dragged to. Shared by WM_LBUTTONUP and
' WM_CAPTURECHANGED -- a stolen capture is treated as an implicit button-up, because the
' host has already applied every intermediate position and has nothing to undo.
'
' No-op when no drag is in progress, so the WM_CAPTURECHANGED that ReleaseCapture() itself
' generates cannot fire a second END notification.
'
' The END notification goes out LAST, after the state is consistent: a host that queries
' PsSplitter_IsDragging() from inside the callback must see FALSE.
' ========================================================================================
sub PsSplitter_EndDrag( byval pSpl as PSSPLITTER_STATE ptr )
    if pSpl = 0 then return
    if pSpl->isDragging = false then return
    pSpl->isDragging = false

    ' The hover pin is released with the drag: hover was held true for the whole gesture
    ' (the cursor legitimately roams outside the client under capture), so re-derive it
    ' from where the cursor actually ended up.
    dim as RECT rcClient
    GetClientRect( pSpl->hWin, @rcClient )
    pSpl->isHot = isMouseOverRECT( pSpl->hWin, rcClient )
    if pSpl->isHot then
        PsSplitter_ArmHotTimer( pSpl )
    else
        if pSpl->hotTimerOn then
            KillTimer( pSpl->hWin, IDT_CSPLITTER_HOTTRACK )
            pSpl->hotTimerOn = false
        end if
    end if

    InvalidateRect( pSpl->hWin, NULL, FALSE )
    pSpl->Notify( PSSPLITTER_PHASE_END )
end sub


' ========================================================================================
' Process WM_PAINT.
' ========================================================================================
function PsSplitter_OnPaint( byval hwnd as HWND ) as LRESULT
    dim as PSSPLITTER_STATE ptr pSpl = GetSplitterPointer(hwnd)
    if pSpl = 0 then return 0

    dim as PsPaintBuffer b
    b.BeginDoubleBuffer(hwnd)

    dim as PSSPLITTER_PAINTINFO p
    p.hSplitter    = hwnd
    p.b            = @b
    GetClientRect( hwnd, @p.rcClient )
    p.nOrientation = pSpl->nOrientation
    p.isHot        = pSpl->isHot
    p.isDragging   = pSpl->isDragging

    if pSpl->PaintCallback then
        pSpl->PaintCallback( @p )
    else
        ' Default paint: a flat bar, brighter while hot or dragging.
        dim as COLORREF clr = pSpl->BackColor
        if pSpl->isHot orelse pSpl->isDragging then clr = pSpl->HotColor
        b.SetBackColor( clr )
        b.PaintClientRect()
    end if

    b.EndDoubleBuffer()
    function = 0
end function


' ========================================================================================
' PsSplitter Window procedure
' ========================================================================================
function PsSplitter_WndProc( _
            byval hwnd   as HWND, _
            byval uMsg   as UINT, _
            byval wParam as WPARAM, _
            byval lParam as LPARAM _
            ) as LRESULT

    dim as PSSPLITTER_STATE ptr pSpl = GetSplitterPointer(hwnd)

    select case uMsg
        HANDLE_MSG (hwnd, WM_PAINT, PsSplitter_OnPaint)

    case WM_ERASEBKGND
        return true      ' the double buffer paints every pixel

    case WM_SIZE
        InvalidateRect( hwnd, NULL, FALSE )
        return 0

    case WM_WINDOWPOSCHANGED
        ' The HOST moved us as part of its own layout pass (parent resize, pane collapse,
        ' a manual SetWindowPos). Record it: without this, GetPos and the bar's actual
        ' location drift apart. This is an observation, not a change -- nothing is
        ' clamped and nothing is notified. Skipped mid-drag, where WE are the mover.
        if pSpl then
            if pSpl->isDragging = false then
                pSpl->nPos = pSpl->BarEdgeFromWindow()
            end if
        end if
        ' fall through to DefWindowProc so WM_MOVE/WM_SIZE are still generated

    case WM_SETCURSOR
        if pSpl = 0 then exit select
        ' Under capture the hit-test code can be anything (the cursor is over the panes,
        ' or off the window entirely), so mid-drag we own the cursor unconditionally.
        dim as boolean bClient = (loword(lParam) = HTCLIENT)
        if (pSpl->isDragging = false) andalso (bClient = false) then exit select
        if PsSplitter_CallMessage( pSpl, hwnd, uMsg, wParam, lParam ) then return true
        if pSpl->hBarCursor then
            SetCursor( pSpl->hBarCursor )
            return true
        end if
        exit select

    case WM_LBUTTONDOWN, WM_LBUTTONDBLCLK
        ' WM_LBUTTONDBLCLK REPLACES the second WM_LBUTTONDOWN (the class carries
        ' CS_DBLCLKS): the sequence is down, up, dblclk, up. So the dblclk must run the
        ' SAME capture bookkeeping as the down, or the trailing up would release a capture
        ' that was never taken. See C:\dev\Learnings.md.
        if pSpl = 0 then return 0
        ' Capture goes first, before any host callback runs, so the down->up pairing is
        ' guaranteed no matter what the host does with the message.
        SetCapture( hwnd )
        if PsSplitter_CallMessage( pSpl, hwnd, uMsg, wParam, lParam ) then return 0

        pSpl->isDragging = true
        pSpl->isHot      = true      ' pinned for the whole gesture
        ' Absolute grab offset: the distance from the bar's leading edge to the cursor, in
        ' the parent's coordinate space. Every subsequent move recomputes the position from
        ' the cursor and this offset -- never by accumulating deltas, which would make the
        ' clamps sticky.
        pSpl->dragOffset = pSpl->CursorAxisInParent() - pSpl->nPos
        InvalidateRect( hwnd, NULL, FALSE )
        pSpl->Notify( PSSPLITTER_PHASE_BEGIN )
        return 0

    case WM_MOUSEMOVE
        if pSpl = 0 then return 0
        if PsSplitter_CallMessage( pSpl, hwnd, uMsg, wParam, lParam ) then return 0

        if pSpl->isDragging then
            dim as integer newPos = _
                pSpl->ClampPos( pSpl->CursorAxisInParent() - pSpl->dragOffset )
            if newPos <> pSpl->nPos then
                pSpl->nPos = newPos
                pSpl->MoveBar()          ' no repaint needed: the content did not change
                pSpl->Notify( PSSPLITTER_PHASE_MOVE )
            end if
        else
            ' Hover. The whole client IS the bar, so any move that reaches us (outside a
            ' drag) means the cursor is on it.
            dim tme as TRACKMOUSEEVENT
            tme.cbSize    = sizeof(TRACKMOUSEEVENT)
            tme.dwFlags   = TME_LEAVE
            tme.hwndTrack = hwnd
            TrackMouseEvent(@tme)
            PsSplitter_ArmHotTimer( pSpl )
            if pSpl->isHot = false then
                pSpl->isHot = true
                InvalidateRect( hwnd, NULL, FALSE )
            end if
        end if
        return 0

    case WM_LBUTTONUP
        if pSpl = 0 then return 0
        ' The callback's answer is deliberately IGNORED here: this up-message is the
        ' capture's exit, and a host allowed to suppress it would strand the capture and
        ' swallow the next click anywhere in the app.
        PsSplitter_CallMessage( pSpl, hwnd, uMsg, wParam, lParam )
        ' End the drag BEFORE releasing, so the WM_CAPTURECHANGED that ReleaseCapture
        ' generates finds nothing to do and cannot fire a second END.
        PsSplitter_EndDrag( pSpl )
        if GetCapture() = hwnd then ReleaseCapture()
        return 0

    case WM_CAPTURECHANGED
        ' Capture lost to someone else mid-drag. Keep the position the user dragged to and
        ' close the gesture cleanly.
        PsSplitter_EndDrag( pSpl )
        return 0

    case WM_MOUSELEAVE
        ' Stand down while dragging: under capture the cursor legitimately leaves the
        ' client, and clearing hover there would strip the bar's active visuals mid-drag.
        if pSpl = 0 then return 0
        if pSpl->isDragging = false then PsSplitter_ClearHot( pSpl )
        return 0

    case WM_SHOWWINDOW
        ' Hidden (e.g. a collapsed pane) while the mouse was over us: drop the hover state
        ' or it would reappear stale the next time we are shown.
        if pSpl = 0 then exit select
        if wParam = 0 then
            PsSplitter_EndDrag( pSpl )
            PsSplitter_ClearHot( pSpl )
        end if
        exit select

    case WM_TIMER
        if pSpl = 0 then exit select
        if wParam = IDT_CSPLITTER_HOTTRACK then
            if pSpl->isDragging = false then
                dim as RECT rcClient : GetClientRect( hwnd, @rcClient )
                if isMouseOverRECT( hwnd, rcClient ) = false then PsSplitter_ClearHot( pSpl )
            end if
            return 0
        end if

    case WM_NCDESTROY
        PsRegistry_Remove( hwnd )
        if pSpl then
            if pSpl->hotTimerOn then KillTimer( hwnd, IDT_CSPLITTER_HOTTRACK )
            if GetCapture() = hwnd then ReleaseCapture()
            delete(pSpl)
        end if
        dim as CWindow ptr pWindow = CWindowPtr(hwnd)
        if pWindow then delete(pWindow)
        return 0

    end select

    ' for messages that we don't deal with
    function = DefWindowProc( hwnd, uMsg, wParam, lParam )

end function


' ========================================================================================
' PsSplitter_Create. The control starts hidden and zero-sized; the host positions, sizes
' and shows it with SetWindowPos. The size it gives us along the drag axis IS the grab
' area -- there is no separate hit margin.
' ========================================================================================
public function PsSplitter_Create( _
            byval hWndParent   as HWND, _
            byval CtrlID       as integer, _
            byval nOrientation as integer = PSSPLITTER_VERTICAL _
            ) as HWND

    dim pWindow as CWindow ptr = New CWindow

    dim as HWND hSplit = _
        pWindow->Create( hWndParent, "", @PsSplitter_WndProc, _
                         0, 0, 0, 0, WS_CHILD or WS_CLIPSIBLINGS or WS_CLIPCHILDREN )

    ' Enable double-click messages (WM_LBUTTONDBLCLK) on the control's window class,
    ' preserving the class's existing styles rather than replacing them. (CWindow's
    ' ClassStyle setter REPLACES, so this must be read-modify-write, and it needs
    ' m_hwnd -- i.e. it only works after Create.)
    pWindow->ClassStyle = pWindow->ClassStyle or CS_DBLCLKS

    dim as PSSPLITTER_STATE ptr pSpl = new PSSPLITTER_STATE
    pSpl->hWin    = hSplit
    pSpl->hParent = hWndParent

    if nOrientation <> PSSPLITTER_HORIZONTAL then nOrientation = PSSPLITTER_VERTICAL
    pSpl->nOrientation = nOrientation

    ' Shared system cursors -- never DestroyCursor these.
    if nOrientation = PSSPLITTER_VERTICAL then
        pSpl->hBarCursor = LoadCursor( null, IDC_SIZEWE )
    else
        pSpl->hBarCursor = LoadCursor( null, IDC_SIZENS )
    end if

    pWindow->UserData(0) = cast(LONG_PTR, pSpl)
    SetWindowLongPtr( hSplit, GWLP_ID, CtrlID )

    ' The theme and the form's fonts, applied now if a PsApp program has them (PsRegistry).
    PsRegistry_SetThemeProcs( hSplit, @PsSplitter_ApplyTheme, 0, @PsSplitter_Rescale )

    function = hSplit
end function


public function PsSplitter_GetOrientation( byval hSplit as HWND ) as integer
    dim as PSSPLITTER_STATE ptr pSpl = GetSplitterPointer(hSplit)
    if pSpl = 0 then return PSSPLITTER_VERTICAL
    return pSpl->nOrientation
end function


public function PsSplitter_GetPos( byval hSplit as HWND ) as integer
    dim as PSSPLITTER_STATE ptr pSpl = GetSplitterPointer(hSplit)
    if pSpl = 0 then return 0
    return pSpl->nPos
end function


' Set the position without invoking the position callback (this is the host telling us
' where it put the splitter, not the user moving it).
public sub PsSplitter_SetPos( byval hSplit as HWND, byval nPosition as integer )
    dim as PSSPLITTER_STATE ptr pSpl = GetSplitterPointer(hSplit)
    if pSpl = 0 then return
    nPosition = pSpl->ClampPos( nPosition )
    if nPosition = pSpl->nPos then return
    pSpl->nPos = nPosition
    pSpl->MoveBar()
    InvalidateRect( hSplit, NULL, FALSE )
end sub


' Set the drag limits, in the same parent-client space as the position. Clamps the current
' position into the new range -- silently, because the host set the range and already knows.
public sub PsSplitter_SetRange( byval hSplit as HWND, byval nMin as integer, byval nMax as integer )
    dim as PSSPLITTER_STATE ptr pSpl = GetSplitterPointer(hSplit)
    if pSpl = 0 then return
    pSpl->nMin = nMin
    pSpl->nMax = nMax
    dim as integer nClamped = pSpl->ClampPos( pSpl->nPos )
    if nClamped <> pSpl->nPos then
        pSpl->nPos = nClamped
        pSpl->MoveBar()
        InvalidateRect( hSplit, NULL, FALSE )
    end if
end sub


public function PsSplitter_GetMin( byval hSplit as HWND ) as integer
    dim as PSSPLITTER_STATE ptr pSpl = GetSplitterPointer(hSplit)
    if pSpl = 0 then return 0
    return pSpl->nMin
end function


public function PsSplitter_GetMax( byval hSplit as HWND ) as integer
    dim as PSSPLITTER_STATE ptr pSpl = GetSplitterPointer(hSplit)
    if pSpl = 0 then return 0
    return pSpl->nMax
end function


function PsSplitter_IsHot( byval hSplit as HWND ) as boolean
    dim as PSSPLITTER_STATE ptr pSpl = GetSplitterPointer(hSplit)
    if pSpl = 0 then return false
    return pSpl->isHot
end function


public function PsSplitter_IsDragging( byval hSplit as HWND ) as boolean
    dim as PSSPLITTER_STATE ptr pSpl = GetSplitterPointer(hSplit)
    if pSpl = 0 then return false
    return pSpl->isDragging
end function


function PsSplitter_GetBackColor( byval hSplit as HWND ) as COLORREF
    dim as PSSPLITTER_STATE ptr pSpl = GetSplitterPointer(hSplit)
    if pSpl = 0 then return 0
    return pSpl->BackColor
end function


public sub PsSplitter_SetColors( byval hSplit as HWND, byval backclr as COLORREF, byval hotclr as COLORREF )
    dim as PSSPLITTER_STATE ptr pSpl = GetSplitterPointer(hSplit)
    if pSpl = 0 then return
    pSpl->BackColor = backclr
    pSpl->HotColor  = hotclr
    pSpl->bColorsPinned = true
    InvalidateRect( hSplit, NULL, FALSE )
end sub

' ========================================================================================
' The theme (vendor/PsControls/PsTheme). ApplyTheme sets the splitter's colours from the
' theme's roles unless the host pinned its own.
' ========================================================================================
public sub PsSplitter_ApplyTheme( byval hSplit as HWND, byref t as PSTHEME_COLORS )
    dim as PSSPLITTER_STATE ptr pSpl = GetSplitterPointer(hSplit)
    if (pSpl = 0) orelse pSpl->bColorsPinned then exit sub
    PsSplitter_SetColors( hSplit, t.Divider, t.TextDisabled )
    pSpl->bColorsPinned = false
end sub

' ========================================================================================
' Per-monitor DPI (RFC-0001 P4). The position and the drag limits are pixels in the parent's
' client space, so all three are scaled -- except the "unbounded" &h7FFFFFFF maximum a host
' that never called SetRange still has, which stays the sentinel (MulDiv would overflow it).
' The bar is then moved to the scaled position silently, as SetPos does; the host's own layout
' pass re-places it anyway (WM_WINDOWPOSCHANGED re-syncs nPos). Thickness is the host's.
' ========================================================================================
public sub PsSplitter_Rescale( byval hSplit as HWND, byval oldDpi as long, byval newDpi as long )
    dim as PSSPLITTER_STATE ptr pSpl = GetSplitterPointer(hSplit)
    if (pSpl = 0) orelse (oldDpi <= 0) orelse (newDpi <= 0) orelse (oldDpi = newDpi) then exit sub
    pSpl->nPos = MulDiv( pSpl->nPos, newDpi, oldDpi )
    pSpl->nMin = MulDiv( pSpl->nMin, newDpi, oldDpi )
    if pSpl->nMax <> &h7FFFFFFF then pSpl->nMax = MulDiv( pSpl->nMax, newDpi, oldDpi )
    dim as CWindow ptr pWindow = CWindowPtr( hSplit )
    if pWindow then pWindow->DPI = newDpi
    pSpl->nPos = pSpl->ClampPos( pSpl->nPos )
    pSpl->MoveBar()
    InvalidateRect( hSplit, NULL, FALSE )
end sub

' Hands the splitter back to the theme, which is applied at once.
public sub PsSplitter_UnpinColors( byval hSplit as HWND )
    dim as PSSPLITTER_STATE ptr pSpl = GetSplitterPointer(hSplit)
    if pSpl = 0 then exit sub
    pSpl->bColorsPinned = false
    dim as PSTHEME_COLORS t
    if PsRegistry_GetTheme( t ) then PsSplitter_ApplyTheme( hSplit, t )
end sub


public sub PsSplitter_SetPaintCallback( byval hSplit as HWND, byval usersub as SPL_PaintCallbackSub )
    dim as PSSPLITTER_STATE ptr pSpl = GetSplitterPointer(hSplit)
    if pSpl = 0 then return
    pSpl->PaintCallback = usersub
    InvalidateRect( hSplit, NULL, FALSE )
end sub


public sub PsSplitter_SetMessageCallback( byval hSplit as HWND, byval userfunc as SPL_MessageCallbackFunc )
    dim as PSSPLITTER_STATE ptr pSpl = GetSplitterPointer(hSplit)
    if pSpl = 0 then return
    pSpl->MessageCallback = userfunc
end sub


public sub PsSplitter_SetPosChangedCallback( byval hSplit as HWND, byval usersub as SPL_PosChangedCallbackSub )
    dim as PSSPLITTER_STATE ptr pSpl = GetSplitterPointer(hSplit)
    if pSpl = 0 then return
    pSpl->PosChangedCallback = usersub
end sub
