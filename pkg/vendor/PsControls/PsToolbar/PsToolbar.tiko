public declare function PsToolbar_GetItemID( byval hToolbar as HWND, byval idx as long ) as long
public declare function PsToolbar_SetItemID( byval hToolbar as HWND, byval idx as long, byval id as long ) as boolean
public declare function PsToolbar_GetItemData( byval hToolbar as HWND, byval idx as long ) as integer
public declare function PsToolbar_SetItemData( byval hToolbar as HWND, byval idx as long, byval itemData as integer ) as boolean
public declare function PsToolbar_GetSelected( byval hToolbar as HWND, byval idx as long ) as boolean
