'    Owner-drawn vertical scrollbar control
'
'    A self-contained, per-instance control in the same vein as PsListBox: it owns its
'    own window class and keeps all state per instance in the CWindow UserData area, so
'    any number of instances can coexist. It knows nothing about listboxes -- the owner
'    drives it purely through PsVScrollBar_SetRange( total, page, pos ) and is told about
'    user scrolling through a scroll callback.

#module "PsVScrollBar"

#import "sys/win"
#import "sys/win/gui"
#import "sys/win/gdiplus"
#import "vendor/PsControls/PsBufferPaint"

using gui
using gdiplus
using PsBufferPaint

' Timer ids are per-window, so every instance can share these values.
public const IDT_CVSCROLL_HOTTRACK = &hCB10
public const IDT_CVSCROLL_REPEAT = &hCB11
public const CVSCROLL_HOTTRACK_MS = 100   ' hover safety-net poll (TME_LEAVE is unreliable)
public const CVSCROLL_REPEAT_DELAY = 400   ' initial delay before track auto-repeat kicks in
public const CVSCROLL_REPEAT_MS = 80   ' auto-repeat interval while the button is held
public const CVSCROLL_MIN_THUMB = 20   ' minimum thumb height (DPI scaled at use)
public const CVSCROLL_DEFAULT_WIDTH = 12   ' default track width (DPI scaled at use)

public type PSVSCROLLBAR_PAINTINFO
    b            as PsPaintBuffer ptr  ' points to the caller's buffer (no copy)
    rcClient     as RECT                 ' the whole track
    rcThumb      as RECT                 ' empty when no thumb is needed
    isHot        as boolean              ' mouse is over the thumb
    isDragging   as boolean
end type

' Paint the scrollbar. If unset, a default paint using the colors below is used.
public type VScrollPaintCallbackSub as sub( byval p as PSVSCROLLBAR_PAINTINFO ptr )
' Called when the user scrolls (drag or track paging). newPos is the new top position.
public type VScrollCallbackSub as sub( byval hScrollBar as HWND, byval newPos as integer )

public type PSVSCROLLBAR_STATE
    hWin          as HWND
    ' --- Range model. Deliberately generic: "total" units, "page" units visible,
    '     "pos" = index of the first visible unit. ---
    nTotal        as integer = 0
    nPage         as integer = 0
    nPos          as integer = 0
    ' --- Geometry (derived from the range; never stored independently) ---
    rcThumb       as RECT
    thumbHeight   as integer = 0
    ' --- Interaction ---
    isDragging    as boolean = false
    dragOffset    as integer = 0      ' cursor offset within the thumb when grabbed
    isHot         as boolean = false
    hotTimerOn    as boolean = false
    repeatTimerOn as boolean = false
    repeatDir     as integer = 0      ' -1 = page up, +1 = page down
    ' --- Mouse wheel / trackpad ---
    '     nWheelAccum is what makes a precision touchpad usable: its deltas are routinely
    '     well under one 120 notch, so the unconsumed remainder is carried between messages
    '     and a slow two-finger swipe scrolls continuously instead of in jumps.
    nWheelAccum   as integer = 0
    nWheelStep    as integer = 0      ' units per notch; 0 = follow the system setting
    ' --- Appearance (used by the default paint; a PaintCallback overrides entirely) ---
    BackColor     as COLORREF = BGR(33,37,43)
    ForeColor     as COLORREF = BGR(53,59,69)
    ForeColorHot  as COLORREF = BGR(90,98,112)
    ' A one-pixel rule down the track's LEFT edge, separating the bar from whatever it
    ' scrolls. 0 = none, which is the default, so an existing host sees no change.
    '
    ' NOT DPI-SCALED HERE: PsBufferPaint.PaintLine scales the pen width it is handed, so
    ' pre-scaling would apply the factor twice and a hairline would be two pixels at 175%.
    ' The family rule, and the one no assertion running at 100% can catch.
    bHasDivider   as boolean  = false
    DividerColor  as COLORREF = 0
    PaintCallback   as VScrollPaintCallbackSub
    ScrollCallback  as VScrollCallbackSub

    declare function TrackHeight() as integer
    declare function MaxPos() as integer
    declare function NeedsThumb() as boolean
    declare sub      Recalc()
    declare function PosFromThumbTop( byval thumbTop as integer ) as integer
end type

function PSVSCROLLBAR_STATE.TrackHeight() as integer
    dim as RECT rc : GetClientRect( this.hWin, @rc )
    return rc.bottom - rc.top
end function

function PSVSCROLLBAR_STATE.MaxPos() as integer
    dim as integer m = this.nTotal - this.nPage
    if m < 0 then m = 0
    return m
end function

' Is there anything to scroll? This is a RANGE question only -- deliberately independent
' of our own geometry, because the owner asks it to decide whether to show us at all, and
' at that point we may still be 0x0 (we only get a size once we are shown). Folding a
' track-height test in here would deadlock: never sized -> never needed -> never shown.
' The geometry guard lives in Recalc instead.
function PSVSCROLLBAR_STATE.NeedsThumb() as boolean
    if (this.nTotal <= 0) orelse (this.nPage <= 0) then return false
    return (this.nTotal > this.nPage)                       ' false = everything fits
end function

' Derive the thumb rect from the range. Size and position both scale off the TRACK
' height (not any external control's height), and the thumb is clamped to a minimum
' so it stays grabbable on very large lists.
sub PSVSCROLLBAR_STATE.Recalc()
    SetRectEmpty( @this.rcThumb )
    this.thumbHeight = 0
    if this.NeedsThumb() = false then exit sub

    dim as RECT rc : GetClientRect( this.hWin, @rc )
    dim as integer track = rc.bottom - rc.top
    if track <= 0 then exit sub          ' no geometry yet: nothing to draw, no divide

    dim as integer minThumb = CVSCROLL_MIN_THUMB
    dim pWindow as CWindow ptr = CWindowPtr( this.hWin )
    if pWindow then minThumb = pWindow->ScaleY( CVSCROLL_MIN_THUMB )

    dim as integer th = (this.nPage / this.nTotal) * track
    if th < minThumb then th = minThumb
    if th > track then th = track
    this.thumbHeight = th

    dim as integer span = track - th
    dim as integer y = 0
    if this.MaxPos() > 0 then y = (this.nPos / this.MaxPos()) * span
    if y < 0 then y = 0
    if y > span then y = span

    SetRect( @this.rcThumb, rc.left, y, rc.right, y + th )
end sub

' Inverse of Recalc's position mapping: which pos does a given thumb top represent?
function PSVSCROLLBAR_STATE.PosFromThumbTop( byval thumbTop as integer ) as integer
    dim as integer span = this.TrackHeight() - this.thumbHeight
    if span <= 0 then return 0
    if thumbTop < 0 then thumbTop = 0
    if thumbTop > span then thumbTop = span
    dim as integer p = (thumbTop / span) * this.MaxPos()
    if p < 0 then p = 0
    if p > this.MaxPos() then p = this.MaxPos()
    return p
end function


' ----------------------------------------------------------------------------------------
' PUBLIC API
' All PsVScrollBar_* functions take the handle returned by PsVScrollBar_Create().
' ----------------------------------------------------------------------------------------
public declare function PsVScrollBar_Create( byval hWndParent as HWND, byval CtrlID as integer ) as HWND
public declare sub      PsVScrollBar_SetRange( byval hSB as HWND, byval nTotal as integer, byval nPage as integer, byval nPosition as integer )
public declare function PsVScrollBar_GetPos( byval hSB as HWND ) as integer
public declare sub      PsVScrollBar_SetPos( byval hSB as HWND, byval nPosition as integer )
public declare function PsVScrollBar_NeedsThumb( byval hSB as HWND ) as boolean
public declare sub      PsVScrollBar_SetColors( byval hSB as HWND, byval backclr as COLORREF, byval foreclr as COLORREF, byval foreclrhot as COLORREF )
' The left-edge rule. Call with bShow = false (the default) to remove it again.
public declare sub      PsVScrollBar_SetDividerColor( byval hSB as HWND, byval clr as COLORREF, byval bShow as boolean = true )
public declare function PsVScrollBar_GetDividerColor( byval hSB as HWND ) as COLORREF
public declare sub      PsVScrollBar_SetPaintCallback( byval hSB as HWND, byval usersub as VScrollPaintCallbackSub )
public declare sub      PsVScrollBar_SetScrollCallback( byval hSB as HWND, byval usersub as VScrollCallbackSub )

' ----------------------------------------------------------------------------------------
' MOUSE WHEEL / TRACKPAD
'
' The control handles WM_MOUSEWHEEL itself, so a wheel or a two-finger trackpad swipe with
' the cursor over the bar scrolls it. Precision-touchpad deltas smaller than one 120 notch
' are accumulated, so a slow swipe scrolls smoothly rather than in jumps.
'
' HandleWheelDelta is that same implementation, exposed. Call it to route a wheel gesture
' the HOST received -- typically one made over the content the bar scrolls, which is a far
' bigger target than the bar itself -- passing the ALREADY-EXTRACTED signed delta:
'
'     case WM_MOUSEWHEEL
'         PsVScrollBar_HandleWheelDelta( hSB, cast(short, hiword(wParam)) )
'
' The cast matters: loword/hiword yield UNSIGNED words, so a delta read without it turns
' ~-120 into ~65416 and the direction silently inverts (see C:\dev\Learnings.md).
' Returns TRUE if the position actually moved.
'
' ROUTING, worth knowing: Windows sends wheel messages to the FOCUSED window, and this
' control never takes focus. What makes hovering work is Windows 10+'s "scroll inactive
' windows when I hover over them" (Settings -> Mouse), which is on by default and routes
' them to the window under the cursor instead. With it OFF the message goes to whatever has
' focus and DefWindowProc bubbles it to that window's PARENT -- never sideways to this bar.
' Hosting HandleWheelDelta yourself is the reliable path; the built-in handler is the
' convenience.
'
' SetWheelStep sets how many range units one 120-unit notch scrolls. 0 (the default) means
' follow the system setting -- SPI_GETWHEELSCROLLLINES, typically 3, re-read per message so
' a Control Panel change takes effect immediately, and honouring WHEEL_PAGESCROLL ("a page
' per notch"). Set it when your range units are neither lines nor characters and the system
' number would be meaningless.
' ----------------------------------------------------------------------------------------
public declare function PsVScrollBar_HandleWheelDelta( byval hSB as HWND, byval nDelta as integer ) as boolean
public declare sub      PsVScrollBar_SetWheelStep( byval hSB as HWND, byval nUnitsPerNotch as integer )
public declare function PsVScrollBar_GetWheelStep( byval hSB as HWND ) as integer

public function GetVScrollBarPointer( byval hSB as HWND ) as PSVSCROLLBAR_STATE ptr
    dim pWindow as CWindow ptr = CWindowPtr(hSB)
    if pWindow = 0 then return 0
    return cast( PSVSCROLLBAR_STATE ptr, pWindow->UserData(0) )
end function


' ========================================================================================
' Move by nUnits (signed, in range units), clamped to [0, MaxPos()], notifying the owner.
' Returns TRUE if the position actually changed.
'
' THE one place that clamps, recalculates, invalidates and notifies. Paging and the wheel
' both route through it, so the two can never drift apart.
' ========================================================================================
function PsVScrollBar_StepBy( byval pSB as PSVSCROLLBAR_STATE ptr, byval nUnits as integer ) as boolean
    if pSB = 0 then return false
    dim as integer newPos = pSB->nPos + nUnits
    if newPos < 0 then newPos = 0
    if newPos > pSB->MaxPos() then newPos = pSB->MaxPos()
    if newPos = pSB->nPos then return false
    pSB->nPos = newPos
    pSB->Recalc()
    InvalidateRect( pSB->hWin, NULL, FALSE )
    if pSB->ScrollCallback then pSB->ScrollCallback( pSB->hWin, newPos )
    return true
end function


' ========================================================================================
' Move by one page in the given direction (-1 up / +1 down), notifying the owner.
' Returns TRUE if the position actually changed.
' ========================================================================================
function PsVScrollBar_PageStep( byval pSB as PSVSCROLLBAR_STATE ptr, byval nDir as integer ) as boolean
    if pSB = 0 then return false
    return PsVScrollBar_StepBy( pSB, nDir * pSB->nPage )
end function


' ========================================================================================
' Feed the scrollbar a mouse-wheel delta. THE single implementation of wheel scrolling:
' the control's own WM_MOUSEWHEEL handler is a thin wrapper around this, and a host can
' call it directly to route a wheel gesture made over the CONTENT into this bar.
'
' nDelta is the ALREADY-EXTRACTED signed delta, not the raw wParam:
'
'     PsVScrollBar_HandleWheelDelta( hSB, cast(short, hiword(wParam)) )
'
' The cast matters -- loword/hiword yield UNSIGNED words, so a scroll-up delta read without
' it becomes ~65416 and the direction silently inverts (see C:\dev\Learnings.md).
'
' SIGN: for WM_MOUSEWHEEL a POSITIVE delta means the wheel moved away from the user, which
' scrolls UP, which DECREASES nPos. That is the opposite of PsHScrollBar, whose horizontal
' WM_MOUSEHWHEEL uses a positive delta for "scroll right" = nPos increases. The two look
' equally plausible in code, so the sign is applied here, once, with this comment on it.
'
' High-resolution wheels and precision touchpads send deltas well under one 120 notch, so
' the remainder is accumulated: a slow two-finger swipe moves the bar continuously instead
' of sitting dead until a whole notch arrives.
'
' Returns TRUE if the position actually moved.
' ========================================================================================
public function PsVScrollBar_HandleWheelDelta( byval hSB as HWND, byval nDelta as integer ) as boolean
    dim as PSVSCROLLBAR_STATE ptr pSB = GetVScrollBarPointer(hSB)
    if pSB = 0 then return false
    if nDelta = 0 then return false

    pSB->nWheelAccum += nDelta

    ' Units moved per 120-unit notch: the caller's override, else the system setting. The
    ' system value is re-read per message rather than cached at Create, so changing it in
    ' Control Panel takes effect without restarting the app.
    dim as integer nStep = pSB->nWheelStep
    if nStep <= 0 then
        dim as ulong sysval = 3
        SystemParametersInfo( SPI_GETWHEELSCROLLLINES, 0, @sysval, 0 )
        ' WHEEL_PAGESCROLL (= UINT_MAX) means "one page per notch". FreeBASIC's winuser.bi
        ' declares the SPI_* constants but NOT this one, so it is spelled out -- the same
        ' workaround PsTextBox.tiko uses for the identical check.
        if sysval = cast(ulong, &hFFFFFFFF) then
            nStep = pSB->nPage
        else
            nStep = cast(integer, sysval)
        end if
    end if
    if nStep <= 0 then nStep = 1        ' never divide by, or step, zero

    dim as integer nUnits = (pSB->nWheelAccum * nStep) \ 120
    if nUnits = 0 then return false     ' not enough delta yet; the remainder is kept

    ' Consume exactly the delta those units represent, keeping the rest. FB's \ truncates
    ' toward zero, which is what makes this symmetric for negative deltas and stops the
    ' accumulator overshooting past the units actually applied.
    pSB->nWheelAccum -= (nUnits * 120) \ nStep

    return PsVScrollBar_StepBy( pSB, -nUnits )    ' SIGN: positive delta scrolls up
end function


' ========================================================================================
' Stop the track auto-repeat.
' ========================================================================================
sub PsVScrollBar_StopRepeat( byval pSB as PSVSCROLLBAR_STATE ptr )
    if pSB = 0 then return
    if pSB->repeatTimerOn then
        KillTimer( pSB->hWin, IDT_CVSCROLL_REPEAT )
        pSB->repeatTimerOn = false
    end if
    pSB->repeatDir = 0
end sub


' ========================================================================================
' Clear the thumb hover state and stop the hover poll timer. Repaints only if the
' state actually changes, so this is cheap to call repeatedly.
' ========================================================================================
sub PsVScrollBar_ClearHot( byval pSB as PSVSCROLLBAR_STATE ptr )
    if pSB = 0 then return
    if pSB->hotTimerOn then
        KillTimer( pSB->hWin, IDT_CVSCROLL_HOTTRACK )
        pSB->hotTimerOn = false
    end if
    if pSB->isHot then
        pSB->isHot = false
        InvalidateRect( pSB->hWin, NULL, FALSE )
    end if
end sub


' ========================================================================================
' Process WM_PAINT. The thumb is always recalculated from the current range here, so it
' can never go stale no matter who changed the position.
' ========================================================================================
function PsVScrollBar_OnPaint( byval hwnd as HWND ) as LRESULT
    dim as PSVSCROLLBAR_STATE ptr pSB = GetVScrollBarPointer(hwnd)
    if pSB = 0 then return 0
    pSB->Recalc()

    dim as PsPaintBuffer b
    b.BeginDoubleBuffer(hwnd)

    dim as PSVSCROLLBAR_PAINTINFO p
    GetClientRect( hwnd, @p.rcClient )
    p.b          = @b
    p.rcThumb    = pSB->rcThumb
    p.isHot      = pSB->isHot
    p.isDragging = pSB->isDragging

    if pSB->PaintCallback then
        pSB->PaintCallback( @p )
    else
        ' Default paint: flat track + flat thumb, brighter while hot/dragging.
        b.SetBackColor( pSB->BackColor )
        b.PaintClientRect()
        if IsRectEmpty( @pSB->rcThumb ) = 0 then
            dim as COLORREF clr = pSB->ForeColor
            if pSB->isHot orelse pSB->isDragging then clr = pSB->ForeColorHot
            b.SetBackColor( clr )
            b.PaintRect( @pSB->rcThumb )
        end if
        ' LAST, over the thumb rather than under it. The thumb spans the full width of the
        ' track, so a divider drawn first is interrupted wherever the thumb happens to be --
        ' which reads as a rendering fault rather than as a divider.
        if pSB->bHasDivider then
            b.SetPenColor( pSB->DividerColor )
            b.PaintLine( 1, p.rcClient.left, p.rcClient.top, p.rcClient.left, p.rcClient.bottom )
        end if
    end if

    b.EndDoubleBuffer()
    function = 0
end function


' ========================================================================================
' PsVScrollBar Window procedure
' ========================================================================================
function PsVScrollBar_WndProc( _
            byval hwnd   as HWND, _
            byval uMsg   as UINT, _
            byval wParam as WPARAM, _
            byval lParam as LPARAM _
            ) as LRESULT

    dim as PSVSCROLLBAR_STATE ptr pSB = GetVScrollBarPointer(hwnd)

    select case uMsg
        HANDLE_MSG (hwnd, WM_PAINT, PsVScrollBar_OnPaint)

    case WM_ERASEBKGND
        return true      ' the double buffer paints every pixel

    case WM_SIZE
        if pSB then
            pSB->Recalc()
            InvalidateRect( hwnd, NULL, FALSE )
        end if
        return 0

    case WM_SHOWWINDOW
        ' Hidden (e.g. auto-hide) while the mouse was over the thumb: drop the hover
        ' state, or it would reappear stale the next time we are shown.
        if (pSB <> 0) andalso (wParam = 0) then
            PsVScrollBar_ClearHot( pSB )
            PsVScrollBar_StopRepeat( pSB )
            pSB->isDragging = false
        end if

    case WM_LBUTTONDOWN
        if pSB = 0 then return 0
        if pSB->NeedsThumb() = false then return 0     ' nothing to scroll
        pSB->Recalc()
        dim as POINT pt
        pt.x = GET_X_LPARAM(lParam) : pt.y = GET_Y_LPARAM(lParam)
        if PtInRect( @pSB->rcThumb, pt ) then
            ' Grab the thumb. Remember where inside the thumb we grabbed it so the
            ' thumb tracks the cursor without jumping.
            pSB->isDragging = true
            pSB->dragOffset = pt.y - pSB->rcThumb.top
            SetCapture( hwnd )
            InvalidateRect( hwnd, NULL, FALSE )
        else
            ' Track click: page once now, then auto-repeat while held.
            pSB->repeatDir = iif( pt.y < pSB->rcThumb.top, -1, 1 )
            PsVScrollBar_PageStep( pSB, pSB->repeatDir )
            SetCapture( hwnd )
            SetTimer( hwnd, IDT_CVSCROLL_REPEAT, CVSCROLL_REPEAT_DELAY, NULL )
            pSB->repeatTimerOn = true
        end if
        return 0

    case WM_MOUSEMOVE
        if pSB = 0 then return 0
        dim as POINT pt
        pt.x = GET_X_LPARAM(lParam) : pt.y = GET_Y_LPARAM(lParam)

        if pSB->isDragging then
            ' Derive the position from the cursor, then rebuild the thumb FROM that
            ' position -- the thumb and the owner can never drift apart.
            dim as integer newPos = pSB->PosFromThumbTop( pt.y - pSB->dragOffset )
            if newPos <> pSB->nPos then
                pSB->nPos = newPos
                pSB->Recalc()
                ' UPDATEWINDOW, NOT JUST INVALIDATERECT. WM_PAINT is generated only when the
                ' queue has nothing else in it, and a drag fills the queue with WM_MOUSEMOVE
                ' -- so the repaint is starved and the thumb visibly trails the cursor,
                ' several rows behind on a long list. Invalidating more often does not help;
                ' the paint has to be forced. This is the only path in the control where the
                ' input rate can outrun the paint rate.
                InvalidateRect( hwnd, NULL, FALSE )
                UpdateWindow( hwnd )
                if pSB->ScrollCallback then pSB->ScrollCallback( hwnd, newPos )
            end if
        else
            ' Hover tracking. WM_MOUSELEAVE is not reliably delivered on fast exits,
            ' so arm a poll timer as a safety net (same approach as PsListBox).
            dim tme as TRACKMOUSEEVENT
            tme.cbSize    = sizeof(TRACKMOUSEEVENT)
            tme.dwFlags   = TME_LEAVE
            tme.hwndTrack = hwnd
            TrackMouseEvent(@tme)
            if pSB->hotTimerOn = false then
                SetTimer( hwnd, IDT_CVSCROLL_HOTTRACK, CVSCROLL_HOTTRACK_MS, NULL )
                pSB->hotTimerOn = true
            end if

            dim as boolean hot = false
            if pSB->NeedsThumb() then
                pSB->Recalc()
                if PtInRect( @pSB->rcThumb, pt ) then hot = true
            end if
            if hot <> pSB->isHot then
                pSB->isHot = hot
                InvalidateRect( hwnd, NULL, FALSE )
            end if
        end if
        return 0

    case WM_LBUTTONUP
        if pSB then
            if pSB->isDragging orelse pSB->repeatTimerOn then ReleaseCapture()
            pSB->isDragging = false
            PsVScrollBar_StopRepeat( pSB )
            InvalidateRect( hwnd, NULL, FALSE )
        end if
        return 0

    case WM_CAPTURECHANGED
        ' Capture lost (someone else took it): never leave a drag/repeat stranded.
        if pSB then
            pSB->isDragging = false
            PsVScrollBar_StopRepeat( pSB )
            InvalidateRect( hwnd, NULL, FALSE )
        end if
        return 0

    case WM_MOUSELEAVE
        PsVScrollBar_ClearHot( pSB )
        return 0

    case WM_MOUSEWHEEL
        ' A wheel, or a two-finger trackpad swipe, with the cursor over the bar. All the
        ' work (and the sign) lives in HandleWheelDelta, which a host can also call to
        ' route a gesture made over the content. The signed-word cast is not optional --
        ' hiword is unsigned (Learnings.md).
        '
        ' Reaching us at all depends on "scroll inactive windows when I hover over them"
        ' (on by default), since this control never takes focus -- see the ROUTING note above
        ' PsVScrollBar_HandleWheelDelta's declaration at the top of this file.
        if pSB then
            PsVScrollBar_HandleWheelDelta( hwnd, cast(short, hiword(wParam)) )
            return 0                    ' we own this gesture, moved or not
        end if
        ' No instance: fall through to DefWindowProc so the message still bubbles up.

    case WM_TIMER
        if pSB = 0 then exit select

        if wParam = IDT_CVSCROLL_HOTTRACK then
            dim as RECT rcClient : GetClientRect( hwnd, @rcClient )
            if isMouseOverRECT( hwnd, rcClient ) = false then PsVScrollBar_ClearHot( pSB )
            return 0
        end if

        if wParam = IDT_CVSCROLL_REPEAT then
            ' Switch from the initial delay to the fast repeat cadence.
            SetTimer( hwnd, IDT_CVSCROLL_REPEAT, CVSCROLL_REPEAT_MS, NULL )
            dim as POINT pt : GetCursorPos( @pt ) : ScreenToClient( hwnd, @pt )
            pSB->Recalc()
            ' Stop once the thumb has travelled far enough to reach the cursor
            ' (standard scrollbar behavior), or when there is nowhere left to go.
            if PtInRect( @pSB->rcThumb, pt ) then
                PsVScrollBar_StopRepeat( pSB )
            elseif PsVScrollBar_PageStep( pSB, pSB->repeatDir ) = false then
                PsVScrollBar_StopRepeat( pSB )
            end if
            return 0
        end if

    case WM_NCDESTROY
        if pSB then
            PsVScrollBar_StopRepeat( pSB )
            if pSB->hotTimerOn then KillTimer( hwnd, IDT_CVSCROLL_HOTTRACK )
            delete(pSB)
        end if
        dim as CWindow ptr pWindow = CWindowPtr(hwnd)
        if pWindow then delete(pWindow)
        return 0

    end select

    ' for messages that we don't deal with
    function = DefWindowProc( hwnd, uMsg, wParam, lParam )

end function


' ========================================================================================
' PsVScrollBar_Create. The control starts hidden; the owner shows it once it knows
' whether there is anything to scroll.
' ========================================================================================
public function PsVScrollBar_Create( byval hWndParent as HWND, byval CtrlID as integer ) as HWND
    dim pWindow as CWindow ptr = New CWindow

    dim as HWND hSB = _
        pWindow->Create( hWndParent, "", @PsVScrollBar_WndProc, _
                         0, 0, 0, 0, WS_CHILD or WS_CLIPSIBLINGS or WS_CLIPCHILDREN )

    dim as PSVSCROLLBAR_STATE ptr pSB = new PSVSCROLLBAR_STATE
    pSB->hWin = hSB
    pWindow->UserData(0) = cast(LONG_PTR, pSB)
    SetWindowLongPtr( hSB, GWLP_ID, CtrlID )

    function = hSB
end function


' ========================================================================================
' Set the scroll range. total = number of units, page = units visible at once,
' pos = index of the first visible unit. Clamped and repainted.
' ========================================================================================
public sub PsVScrollBar_SetRange( byval hSB as HWND, byval nTotal as integer, byval nPage as integer, byval nPosition as integer )
    dim as PSVSCROLLBAR_STATE ptr pSB = GetVScrollBarPointer(hSB)
    if pSB = 0 then return
    if nTotal < 0 then nTotal = 0
    if nPage  < 0 then nPage  = 0
    pSB->nTotal = nTotal
    pSB->nPage  = nPage
    if nPosition < 0 then nPosition = 0
    if nPosition > pSB->MaxPos() then nPosition = pSB->MaxPos()
    pSB->nPos = nPosition
    pSB->Recalc()
    InvalidateRect( hSB, NULL, FALSE )
end sub


public function PsVScrollBar_GetPos( byval hSB as HWND ) as integer
    dim as PSVSCROLLBAR_STATE ptr pSB = GetVScrollBarPointer(hSB)
    if pSB = 0 then return 0
    return pSB->nPos
end function


' Set the position without invoking the scroll callback (this is the owner telling us
' where it scrolled to, not the user scrolling).
public sub PsVScrollBar_SetPos( byval hSB as HWND, byval nPosition as integer )
    dim as PSVSCROLLBAR_STATE ptr pSB = GetVScrollBarPointer(hSB)
    if pSB = 0 then return
    if nPosition < 0 then nPosition = 0
    if nPosition > pSB->MaxPos() then nPosition = pSB->MaxPos()
    if nPosition = pSB->nPos then return
    pSB->nPos = nPosition
    pSB->Recalc()
    InvalidateRect( hSB, NULL, FALSE )
end sub


public function PsVScrollBar_NeedsThumb( byval hSB as HWND ) as boolean
    dim as PSVSCROLLBAR_STATE ptr pSB = GetVScrollBarPointer(hSB)
    if pSB = 0 then return false
    return pSB->NeedsThumb()
end function


public sub PsVScrollBar_SetColors( byval hSB as HWND, byval backclr as COLORREF, byval foreclr as COLORREF, byval foreclrhot as COLORREF )
    dim as PSVSCROLLBAR_STATE ptr pSB = GetVScrollBarPointer(hSB)
    if pSB = 0 then return
    pSB->BackColor    = backclr
    pSB->ForeColor    = foreclr
    pSB->ForeColorHot = foreclrhot
    InvalidateRect( hSB, NULL, FALSE )
end sub


public sub PsVScrollBar_SetDividerColor( byval hSB as HWND, byval clr as COLORREF, byval bShow as boolean = true )
    dim as PSVSCROLLBAR_STATE ptr pSB = GetVScrollBarPointer(hSB)
    if pSB = 0 then exit sub
    pSB->DividerColor = clr
    pSB->bHasDivider  = bShow
    InvalidateRect( hSB, NULL, FALSE )
end sub

public function PsVScrollBar_GetDividerColor( byval hSB as HWND ) as COLORREF
    dim as PSVSCROLLBAR_STATE ptr pSB = GetVScrollBarPointer(hSB)
    if pSB = 0 then return 0
    return pSB->DividerColor
end function

public sub PsVScrollBar_SetPaintCallback( byval hSB as HWND, byval usersub as VScrollPaintCallbackSub )
    dim as PSVSCROLLBAR_STATE ptr pSB = GetVScrollBarPointer(hSB)
    if pSB = 0 then return
    pSB->PaintCallback = usersub
    InvalidateRect( hSB, NULL, FALSE )
end sub


public sub PsVScrollBar_SetScrollCallback( byval hSB as HWND, byval usersub as VScrollCallbackSub )
    dim as PSVSCROLLBAR_STATE ptr pSB = GetVScrollBarPointer(hSB)
    if pSB = 0 then return
    pSB->ScrollCallback = usersub
end sub


' ========================================================================================
' How many range units one 120-unit wheel notch scrolls. 0 = follow the system setting.
'
' CHANGING it resets any part-accumulated delta: the remainder was measured against the old
' step and would translate to the wrong distance under the new one.
'
' Setting it to the value it ALREADY HAS is a no-op that keeps the remainder -- and that
' matters more than it looks. A host whose units are neither lines nor characters has to
' convert, and the natural home for that is its per-layout range-push, which re-runs
' constantly -- including while a slow trackpad swipe is still accumulating. Resetting on
' every such call would discard every sub-notch remainder and put the dead-then-jump
' behaviour straight back.
' ========================================================================================
public sub PsVScrollBar_SetWheelStep( byval hSB as HWND, byval nUnitsPerNotch as integer )
    dim as PSVSCROLLBAR_STATE ptr pSB = GetVScrollBarPointer(hSB)
    if pSB = 0 then return
    if nUnitsPerNotch < 0 then nUnitsPerNotch = 0
    if pSB->nWheelStep = nUnitsPerNotch then return   ' no-op: keep the remainder
    pSB->nWheelStep  = nUnitsPerNotch
    pSB->nWheelAccum = 0
end sub


public function PsVScrollBar_GetWheelStep( byval hSB as HWND ) as integer
    dim as PSVSCROLLBAR_STATE ptr pSB = GetVScrollBarPointer(hSB)
    if pSB = 0 then return 0
    return pSB->nWheelStep
end function
