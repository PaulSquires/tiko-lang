#module "PsIconPanel"

#import "sys/win"
#import "sys/win/gui"
#import "sys/win/gdiplus"
#import "vendor/PsControls/PsBufferPaint"
#import "vendor/PsControls/PsImage"
#import "vendor/PsControls/PsTipHost"
#import "vendor/PsControls/PsRegistry"
#import "vendor/PsControls/PsTheme"

using gui
using gdiplus
using PsBufferPaint
using PsImage
using PsTipHost
using PsRegistry
using PsTheme

' An item can show a real image file (.ico/.png/.bmp/.jpg) instead of a Fluent glyph.
' PsImage owns the decode; PsPaintBuffer.PaintImage draws it. See PsIconPanel_SetImage.
' The tooltip backend switch. The control ships on the SYSTEM (comctl32) backend exactly
' as it always has; a host opts an instance into PsTooltip with PsIconPanel_SetTooltipMode.

' Polling timer that guarantees hot-tracking is cleared when the mouse leaves the
' control. WM_MOUSELEAVE (TME_LEAVE) is not reliably delivered on fast exits, so a
' periodic cursor check acts as a safety net. Timer IDs are per-window, so every
' instance can share this id.
public const IDT_CICONPANEL_HOTTRACK = &hCB50
public const PSICONPANEL_HOTTRACK_MS = 100

' Default icon cell size. Every icon gets a cell of exactly this size unless the item
' overrides it. DPI-scaled at Create; PsIconPanel_SetIconSize takes raw pixels thereafter.
public const PSICONPANEL_DEFAULT_ICONWIDTH = 20
public const PSICONPANEL_DEFAULT_ICONHEIGHT = 20

' Default space reserved BEFORE and AFTER each icon. This is the author's spacing control
' and the whole reason this control exists: it is never adjusted, redistributed or
' squeezed by the layout. DPI-scaled at Create; the setters take raw pixels thereafter.
public const PSICONPANEL_DEFAULT_PADBEFORE = 4
public const PSICONPANEL_DEFAULT_PADAFTER = 4

' Default thickness of a separator's rule (it takes the place of the icon width in a
' separator's cell). DPI-scaled at Create.
public const PSICONPANEL_DEFAULT_SEPWIDTH = 1


' Where the whole run of items sits in the client area. This is the ONLY thing the layout
' recomputes when the host resizes the panel: the run is shifted as one block, and the
' spacing inside it never changes.
public enum PSICONPANEL_JUSTIFY
    IP_JUSTIFY_LEFT = 0
    IP_JUSTIFY_CENTER
    IP_JUSTIFY_RIGHT
end enum

' What an item DOES when clicked. Kind is authored at Add time and never changes.
'   TOGGLE    - latches. Flips isSelected on a matched click and fires SelChangeCallback.
'               Toggles are INDEPENDENT of each other: this control has no "current item",
'               it has a set of switches (contrast PsTabBar's single nCurSel).
'   COMMAND   - momentary. Draws pressed while held, fires ClickCallback on a matched
'               release, and never latches.
'   SEPARATOR - a vertical rule the control draws itself. Not hit-testable: it never goes
'               hot, never presses, and HitTest returns -1 for it.
public enum PSICONPANEL_ITEMKIND
    IP_KIND_TOGGLE = 0
    IP_KIND_COMMAND
    IP_KIND_SEPARATOR
end enum


' Colors for the built-in painter. Copied on Set. Defaults are tiko's dark theme, which is
' what this control was shaped for; a host on a light theme sets all eight.
public type PSICONPANEL_COLORS
    BackColor         as COLORREF = BGR(33,37,43)     ' panel background + idle cell fill
    ForeColor         as COLORREF = BGR(215,218,224)  ' idle glyph
    BackColorHot      as COLORREF = BGR(44,49,58)
    ForeColorHot      as COLORREF = BGR(255,255,255)
    BackColorSelect   as COLORREF = BGR(38,79,120)    ' latched toggle, and the press flash
    ForeColorSelect   as COLORREF = BGR(255,255,255)
    ForeColorDisabled as COLORREF = BGR(110,115,125)
    SeparatorColor    as COLORREF = BGR(70,76,88)
end type


' One item. Everything above the DERIVED line is authored; everything below belongs to
' LayoutItems and is never set from outside.
'
' NOTE: "width" is a FreeBASIC reserved word (see C:\dev\Learnings.md) and produces errors
' that never name the real problem -- hence nIconWidth / nCellWidth throughout.
' NOTE: no isHot here. Hover is transient and single-valued, so the control's nLastHotIdx
' is the one source of truth; a per-item copy would be a second one to keep in sync. The
' same argument does NOT apply to isSelected: selection is multi-valued and persistent, so
' it genuinely lives on the item.
public type PSICONPANEL_ITEM
    itemKind      as long = IP_KIND_TOGGLE
    wszGlyph      as ustring          ' the Segoe Fluent Icons codepoint(s) to draw
    ' An image drawn in the icon cell INSTEAD OF the glyph. The control OWNS this PsImage and
    ' frees it in WM_NCDESTROY. The item slot is glyph OR image: PsIconPanel_SetImage clears
    ' wszGlyph, PsIconPanel_SetGlyph frees pImage. NULL = no image. It fits the SAME declared
    ' icon cell a glyph would, so an image needs no layout change.
    pImage        as PsImageFile ptr
    wszTooltip    as ustring          ' "" = ask TooltipCallback, then show nothing
    id            as long = 0          ' host command id, reported by ClickCallback
    itemData      as integer = 0       ' free-form host payload
    isSelected    as boolean = false   ' latched (TOGGLE items only)
    isEnabled     as boolean = true    ' false = greyed, never hot, swallows clicks
    ' Per-item overrides. The inherit sentinels differ because 0 is a legal padding but
    ' not a legal icon size.
    nPadBefore    as long = -1         ' -1 = inherit the panel's nPadBefore
    nPadAfter     as long = -1         ' -1 = inherit the panel's nPadAfter
    nIconWidth    as long = 0          '  0 = inherit the panel's nIconWidth
    nIconHeight   as long = 0          '  0 = inherit the panel's nIconHeight
    ForeColorItem as COLORREF = 0      ' idle glyph color, when bHasForeColor
    ' A boolean rather than a CLR_NONE sentinel: every COLORREF value is a legal color,
    ' and the flag reads honestly at each use site.
    bHasForeColor as boolean = false
    ' --- DERIVED by LayoutItems ---------------------------------------------------------
    nCellWidth    as long = 0          ' padBefore + icon (or rule) width + padAfter
    rc            as RECT              ' the full cell, client coords: the FILL and HIT rect
    rcIcon        as RECT              ' the icon draw rect, centred in rc both ways
end type


public type PSICONPANEL_PAINTINFO
    hIconPanel  as HWND                   ' the control, so the callback can query it
    itemID      as long                   ' item index (model index)
    b           as PsPaintBuffer ptr    ' the control's buffer for this repaint (no copy)
    itemKind    as long                   ' IP_KIND_*
    rc          as RECT                   ' the full cell: fill THIS
    rcIcon      as RECT                   ' the icon rect: draw the glyph in THIS
    ' --- State: the control decides these, you only render. ---
    isHot       as boolean                ' the mouse is over this item
    isSelected  as boolean                ' a latched TOGGLE
    isPressed   as boolean                ' a live left press is on this item AND the
                                          '   cursor is still over it (slide off and this
                                          '   goes false without ending the gesture)
    isEnabled   as boolean
    wszGlyph    as ustring
    ' Resolved image handle for this item's cell, or NULL. When set, draw this image via
    ' p->b->PaintImage INSTEAD OF the glyph -- a custom painter should honour it, image first.
    pImage      as CGpImage ptr
end type

public type PSICONPANEL_MESSAGEINFO
    hIconPanel  as HWND
    uMsg        as UINT
    wParam      as WPARAM
    lParam      as LPARAM
    idx         as long       ' item index under the mouse (-1 if none)
end type


' Draw one item, INSTEAD OF the built-in painter -- setting this replaces the built-in
' rendering for EVERY item, separators included. Paint through p->b (the control's double
' buffer for this repaint), using p->rc as the cell and p->rcIcon as the glyph box -- do
' not touch the screen DC. Style from the state flags; the control decides them, you only
' render.
'
' Two contracts worth honoring:
'   - Draw the glyph with the SAME font you handed to PsIconPanel_SetFont, sized to fit
'     rcIcon. rcIcon is a LAYOUT cell, not a measurement of your glyph: the control never
'     measures text, so a font too large for the cell simply clips.
'   - Fill p->rc, not p->rcIcon. rc includes the item's padding and is what the control
'     background-filled; leaving part of it unpainted shows the panel background through.
public type IP_PaintItemCallbackSub as sub( byval p as PSICONPANEL_PAINTINFO ptr )

' Observe mouse messages. Return TRUE if you handled it and want the control's default
' handling suppressed, FALSE to let it proceed.
'
' CAUTION: the result is honored for every message EXCEPT WM_LBUTTONUP, where it is
' IGNORED. The control holds mouse capture across a press (the press/cancel gesture
' consumes the guaranteed down->up pairing), and the up-message is what releases it: a
' callback that suppressed it would strand capture and route every subsequent click to
' this control (the PsListBox bug recorded in Learnings.md). Suppressing WM_LBUTTONDOWN
' suppresses the press, never the capture bookkeeping.
public type IP_MessageCallbackFunc as function( byval m as PSICONPANEL_MESSAGEINFO ptr ) as boolean

' Supply the tooltip text for an item, on demand (only when a tip is about to show).
' Consulted only when the item has no tooltip text of its own. Return "" for no tooltip.
' Unlike PsStatusBar/PsTabBar there is no caption to fall back on -- an icon has none -- so
' an item with neither its own text nor a callback answer simply shows no tip.
public type IP_TooltipCallbackFunc as function( byval hIconPanel as HWND, byval idx as long ) as ustring

' A COMMAND item was clicked: a matched press+release on the same item. Fires nothing for
' toggles (they report through SelChangeCallback) and nothing for a cancelled gesture
' (press an icon, slide off, release).
public type IP_ClickCallbackSub as sub( byval hIconPanel as HWND, byval idx as long, byval id as long )

' A TOGGLE item latched or unlatched through USER interaction. Fired AFTER the control's
' state is updated, so PsIconPanel_GetSelected( h, idx ) = isSelected. Programmatic
' PsIconPanel_SetSelected does NOT fire this -- only the user does (the family rule, and
' Win32's TCM_SETCURSEL / TCN_SELCHANGE precedent), which also makes it safe to call the
' setter from inside the handler without recursing.
public type IP_SelChangeCallbackSub as sub( byval hIconPanel as HWND, byval idx as long, byval isSelected as boolean )


public type PSICONPANEL_STATE
    hWin              as HWND
    ' TRUE once the host set the colours itself (PsIconPanel_SetColors): the theme then leaves this
    ' panel alone until PsIconPanel_UnpinColors.
    bColorsPinned     as boolean
    ' The tooltip, whichever backend it is on. Replaces the old hToolTip + HoverTime
    ' pair; PsIconPanel_GetTooltipHandle still answers the comctl32 handle, and 0 while
    ' this instance is on PsTooltip.
    tip         as PSTIPHOST_STATE
    wszTooltip        as ustring
    items(any)        as PSICONPANEL_ITEM
    itemCount         as long = 0
    idc_IconPanel     as long = 0
    HoverTime         as long = 250
    ' Two single-valued indices. Because the item set is STATIC -- items are added once and
    ' never inserted, deleted or moved -- neither can ever be left dangling by a mutation,
    ' so this control carries none of the index fix-up code the dynamic siblings need
    ' (three separate sites in PsTabBar alone, and the family's most repeated bug class).
    nLastHotIdx       as long = -1       ' item the mouse was last over (hover tracking)
    hotTimerOn        as boolean = false ' is the hot-tracking safety-net timer running?
    ' --- Press state (mouse capture). The control TAKES capture on a press -- unlike
    '     PsStatusBar, and deliberately: the press/cancel gesture (press an icon, slide
    '     off, release, nothing happens) consumes the guaranteed down->up pairing, which
    '     is the family's test for taking capture. It pays PsVScrollBar's full price:
    '     snapshot the pressed index BEFORE releasing (ReleaseCapture sends
    '     WM_CAPTURECHANGED synchronously -- Learnings.md), release on the up-message
    '     before any callback runs, WM_CAPTURECHANGED cancels the press, WM_DESTROY
    '     releases, and no callback may suppress an up-message.
    '     There is no bPressedInside flag: "the cursor is still on the pressed item" is
    '     exactly (nLastHotIdx = nPressedIdx), and hover tracking already maintains that
    '     through the capture (moves outside the client report -1). ---
    nPressedIdx       as long = -1       ' item under a live left press, or -1
    colors            as PSICONPANEL_COLORS
    ' Caller-supplied font (caller owns it). NOT named hFont: FreeBASIC is case-insensitive,
    ' so a member called hFont would shadow the TYPE name HFONT inside every member
    ' procedure of this type, and "dim as HFONT x" there fails with a misleading
    ' "error 14: Expected identifier, found 'HFONT'". See C:\dev\Learnings.md.
    hIconFont         as HFONT
    ' --- Layout. Item rects are derived, never set from outside; LayoutItems() owns them.
    '     Layout is lazy: mutators mark it dirty, the next paint (or any rect query) runs
    '     it, which coalesces a burst of mutations into one pass. ---
    nJustify          as long = IP_JUSTIFY_LEFT
    nIconWidth        as long = PSICONPANEL_DEFAULT_ICONWIDTH    ' DPI-scaled at Create
    nIconHeight       as long = PSICONPANEL_DEFAULT_ICONHEIGHT   ' DPI-scaled at Create
    nPadBefore        as long = PSICONPANEL_DEFAULT_PADBEFORE    ' DPI-scaled at Create
    nPadAfter         as long = PSICONPANEL_DEFAULT_PADAFTER     ' DPI-scaled at Create
    nSepWidth         as long = PSICONPANEL_DEFAULT_SEPWIDTH     ' DPI-scaled at Create
    nTotalWidth       as long = 0        ' summed cell widths = the run's ideal width
    bLayoutDirty      as boolean = true
    PaintItemCallback as IP_PaintItemCallbackSub    ' optional; replaces the built-in painter
    MessageCallback   as IP_MessageCallbackFunc     ' optional
    TooltipCallback   as IP_TooltipCallbackFunc     ' optional
    ClickCallback     as IP_ClickCallbackSub        ' optional; COMMAND items
    SelChangeCallback as IP_SelChangeCallbackSub    ' optional; TOGGLE items, user only

    declare sub      LayoutItems()
    declare function GetCount() as long                                     ' item count
    declare function AddItem() as PSICONPANEL_ITEM ptr                       ' append
    declare function GetItem( byval idx as long ) as PSICONPANEL_ITEM ptr
    declare function IsValidItem( byval idx as long ) as boolean
    declare function HitTest( byval x as long, byval y as long ) as long
    declare sub      CancelPress()
    declare sub      Refresh()
end type


' Assign every item its cell. This is the only place item geometry is produced; everything
' else (hit-testing, painting, invalidation) consumes it.
'
'   cellWidth(i) = padBefore(i) + iconWidth(i) + padAfter(i)      TOGGLE / COMMAND
'                = padBefore(i) + sepWidth     + padAfter(i)      SEPARATOR
'   totalW       = sum of every cellWidth
'   x0           = 0                        LEFT, or totalW >= clientW (the overflow rule)
'                = (clientW - totalW) \ 2   CENTER
'                = clientW - totalW         RIGHT
'   rc(i)        = ( x, clientTop, x + cellWidth(i), clientBottom )   full client height
'   rcIcon(i)    = iconW x iconH, centred in rc both ways
'
' TWO THINGS THAT MAKE THIS CONTROL DIFFERENT FROM ITS SIBLINGS:
'
'   1. Nothing is measured. Cell widths are DECLARED by the author, so -- alone in the
'      family -- this layout never takes a DC and never calls GetTextExtentPoint32W. The
'      font matters at paint time only. Layout stays lazy purely to coalesce mutations.
'
'   2. A resize moves x0 and nothing else. Relative spacing is authored and is never
'      adjusted, redistributed, or squeezed. That is the whole difference from PsStatusBar,
'      whose panels auto-size to their text and whose spring absorbs the slack.
'
' On overflow the justification degrades to LEFT and the tail clips at the client edge:
' the leading icons stay reachable, and rects are computed honestly rather than squeezed
' (PsTabBar's rule) -- clipping is the paint pass's job, and the cursor cannot reach past
' the edge anyway, so hit-testing stays correct for free.
'
' rc spans the FULL client height, so the hot/selected fill reads like a menu bar and the
' hit target includes the item's padding. Only rcIcon obeys the "centred vertically in the
' client area" rule. A host wanting a compact pill highlight fills an inflated rcIcon from
' the paint callback instead.
sub PSICONPANEL_STATE.LayoutItems()
    this.bLayoutDirty = false
    this.nTotalWidth  = 0
    if this.hWin = 0 then exit sub
    if this.itemCount = 0 then exit sub

    dim as RECT rcClient
    GetClientRect( this.hWin, @rcClient )
    dim as long clientW = rcClient.right - rcClient.left
    dim as long clientH = rcClient.bottom - rcClient.top

    ' Resolve every per-item override ONCE, here, so the two passes below cannot disagree
    ' about what an item's padding or icon size is.
    dim padB( 0 to this.itemCount - 1 ) as long
    dim coreW( 0 to this.itemCount - 1 ) as long
    dim coreH( 0 to this.itemCount - 1 ) as long

    dim as long totalW = 0
    for i as long = 0 to this.itemCount - 1
        with this.items(i)
            padB(i) = iif( .nPadBefore < 0, this.nPadBefore, .nPadBefore )
            dim as long padA = iif( .nPadAfter < 0, this.nPadAfter, .nPadAfter )
            ' A separator's rule takes the place of the icon width, but keeps the icon
            ' HEIGHT: the rule then stands exactly as tall as the icons it divides.
            coreH(i) = iif( .nIconHeight = 0, this.nIconHeight, .nIconHeight )
            if .itemKind = IP_KIND_SEPARATOR then
                coreW(i) = this.nSepWidth
            else
                coreW(i) = iif( .nIconWidth = 0, this.nIconWidth, .nIconWidth )
            end if
            ' Never taller than the client -- but only once there IS a client to measure
            ' against (see the zero-geometry bail below).
            if (clientH > 0) andalso (coreH(i) > clientH) then coreH(i) = clientH
            .nCellWidth = padB(i) + coreW(i) + padA
            totalW += .nCellWidth
        end with
    next
    this.nTotalWidth = totalW

    ' No geometry yet (created 0x0, sized only once the host shows us). Placement is
    ' impossible, so leave the rects alone and ask to be run again -- but note this bail
    ' comes AFTER nTotalWidth is computed. The run's width does not depend on the client
    ' at all (only x0 does), and GetIdealWidth is exactly what a host calls to decide how
    ' big to make the panel in the first place: returning 0 until it had already been
    ' sized would be a chicken-and-egg trap.
    if (clientW <= 0) orelse (clientH <= 0) then
        this.bLayoutDirty = true
        exit sub
    end if

    ' The block offset: the ENTIRE response to a resize.
    dim as long x0 = rcClient.left
    if totalW < clientW then
        select case this.nJustify
        case IP_JUSTIFY_CENTER
            x0 = rcClient.left + ((clientW - totalW) \ 2)
        case IP_JUSTIFY_RIGHT
            x0 = rcClient.right - totalW
        end select
    end if

    dim as long x = x0
    for i as long = 0 to this.itemCount - 1
        with this.items(i)
            SetRect( @.rc, x, rcClient.top, x + .nCellWidth, rcClient.bottom )
            dim as long yTop = rcClient.top + ((clientH - coreH(i)) \ 2)
            SetRect( @.rcIcon, x + padB(i), yTop, _
                               x + padB(i) + coreW(i), yTop + coreH(i) )
            x += .nCellWidth
        end with
    next
end sub

function PSICONPANEL_STATE.GetCount() as long
    return this.itemCount
end function

function PSICONPANEL_STATE.IsValidItem( byval idx as long ) as boolean
    return (idx >= 0) andalso (idx < this.itemCount)
end function

function PSICONPANEL_STATE.GetItem( byval idx as long ) as PSICONPANEL_ITEM ptr
    if this.IsValidItem(idx) = false then return null
    return @this.items(idx)
end function

' Which item contains this client-coordinate point? Separators are excluded -- they are
' decoration, not targets. DISABLED items are NOT excluded: they still occupy their cell,
' and a host asking "what is here" deserves the truth. The hover and click paths add the
' enabled test themselves.
function PSICONPANEL_STATE.HitTest( byval x as long, byval y as long ) as long
    dim as POINT pt
    pt.x = x
    pt.y = y
    for i as long = 0 to this.itemCount - 1
        if this.items(i).itemKind = IP_KIND_SEPARATOR then continue for
        if PtInRect( @this.items(i).rc, pt ) then return i
    next
    return -1
end function

' Append a fresh (reset) item. Grows the backing store by doubling so building a panel is
' amortized O(1), not O(n^2).
'
' There is NO InsertItemAt and NO DeleteItemAt, deliberately -- the item set is static. See
' the type's index comment for what that buys.
function PSICONPANEL_STATE.AddItem() as PSICONPANEL_ITEM ptr
    dim as long cap = ubound(this.items) + 1
    if this.itemCount >= cap then
        dim as long newcap = iif( cap = 0, 16, cap * 2 )
        redim preserve this.items( 0 to newcap - 1 )
    end if

    dim as long idx = this.itemCount

    ' reset the new slot (frees any ustring left in a recycled capacity slot)
    with this.items(idx)
        .itemKind      = IP_KIND_TOGGLE
        .wszGlyph      = ""
        .wszTooltip    = ""
        .id            = 0
        .itemData      = 0
        .isSelected    = false
        .isEnabled     = true
        .nPadBefore    = -1
        .nPadAfter     = -1
        .nIconWidth    = 0
        .nIconHeight   = 0
        .ForeColorItem = 0
        .bHasForeColor = false
        .nCellWidth    = 0
        SetRectEmpty( @.rc )
        SetRectEmpty( @.rcIcon )
    end with

    this.itemCount += 1
    this.Refresh()
    return @this.items(idx)
end function

' Forget any live press WITHOUT touching the capture. Called from the capture-loss path and
' from SetEnabled when the pressed item is disabled out from under the gesture. Releasing
' capture is the WndProc's job, and only on the up-message or WM_DESTROY -- doing it here
' would let a callback strand or double-release it.
sub PSICONPANEL_STATE.CancelPress()
    this.nPressedIdx = -1
end sub

' Mark the layout stale and request a repaint. Every mutator routes through here, which is
' what makes layout lazy: a burst of Add calls costs one layout pass, not N.
sub PSICONPANEL_STATE.Refresh()
    this.bLayoutDirty = true
    ' Repaint WITH background erase so a region vacated by a shrinking run is cleared --
    ' with three justifications the run can move wholesale, so this matters more here than
    ' anywhere else in the family.
    if this.hWin then InvalidateRect( this.hWin, NULL, TRUE )
end sub


' ========================================================================================
' PUBLIC API
' ========================================================================================
'
' AN ICON STRIP WHERE THE AUTHOR OWNS THE SPACING
'   Every item declares its own cell: an icon size plus the space before and after it. The
'   control lays the cells out in the order supplied and NEVER adjusts them -- no
'   auto-sizing, no spring panel, no squeezing to fit. The one thing it recomputes when the
'   host resizes is where the whole run sits: left, centred, or right, as one block.
'
'   That is the difference from PsStatusBar, whose panels measure themselves against their
'   text and whose nominated spring panel absorbs all slack.
'
' STATIC BY CONTRACT
'   Items are added once, at construction, and are never inserted, deleted or moved
'   afterwards -- which is why there is no InsertItem, no DeleteItem and no Clear. Their
'   widths are declared rather than measured, so they do not move at runtime either; only
'   the justification moves them, and only as one block.
'
'   What that buys: none of the stored-index fix-up code the dynamic siblings carry, because
'   nLastHotIdx and nPressedIdx cannot go stale. Everything a host does at runtime --
'   toggling, enabling, recolouring, swapping a glyph -- addresses an item that is still
'   exactly where it was.
'
' THE CONTROL HANDLE
'   Every PsIconPanel_* function takes the handle returned by PsIconPanel_Create().
'
'   The handle is a real HWND on purpose (not an opaque type): callers legitimately need
'   to treat the control as a window, e.g. SetWindowPos() to place and size it. An opaque
'   wrapper would buy a little type-safety and break that, so it was rejected.
'
' SELECTION IS A SET, NOT A CURRENT ITEM
'   Every TOGGLE item latches independently -- there is no nCurSel here. Programmatic
'   SetSelected is SILENT; only the user fires SelChangeCallback.
'
' LIFETIME
'   The control frees itself when its window is destroyed. Fonts you pass in stay yours.
'
' ----------------------------------------------------------------------------------------
' Creation
'   CtrlID becomes the control window's id (GWLP_ID). There are no child controls.
'   The control is created zero-sized: position it with SetWindowPos().
' ----------------------------------------------------------------------------------------
public declare function PsIconPanel_Create( byval hWndParent as HWND, byval CtrlID as long ) as HWND

' ----------------------------------------------------------------------------------------
' Building the panel.  Add* return the new item's index, or -1.
'   AddItem's kind is IP_KIND_TOGGLE or IP_KIND_COMMAND; AddSeparator adds the third kind
'   (which has no glyph, no id and no click behaviour of its own).
'
'   These are the ONLY way items come into existence, and there is no way to take one out
'   again -- the static contract above. Build the panel once, then drive it with the state
'   setters (SetSelected, SetEnabled, SetGlyph, SetItemForeColor).
' ----------------------------------------------------------------------------------------
public declare function PsIconPanel_AddItem( byval hIconPanel as HWND, byval itemKind as long, byval Glyph as ustring, byval id as long = 0, byval itemData as integer = 0 ) as long
public declare function PsIconPanel_AddSeparator( byval hIconPanel as HWND ) as long
public declare sub      PsIconPanel_Refresh( byval hIconPanel as HWND )

' ----------------------------------------------------------------------------------------
' Counts and lookup.
'   FindItemByID returns the FIRST item with that id, or -1. HitTest takes CLIENT
'   coordinates, forces a pending layout, and returns the item there (separators excluded,
'   disabled items included) or -1.
' ----------------------------------------------------------------------------------------
public declare function PsIconPanel_GetCount( byval hIconPanel as HWND ) as long
public declare function PsIconPanel_IsValidItem( byval hIconPanel as HWND, byval idx as long ) as boolean
public declare function PsIconPanel_FindItemByID( byval hIconPanel as HWND, byval id as long ) as long
public declare function PsIconPanel_HitTest( byval hIconPanel as HWND, byval x as long, byval y as long ) as long

' ----------------------------------------------------------------------------------------
' Item contents and state.  Set* return FALSE for an invalid item index.
'
'   SetSelected is SILENT (no SelChangeCallback) and applies to TOGGLE items only -- it is
'   how a host restores latched state at startup, and it is safe to call from inside the
'   change handler. SetEnabled(false) greys the item, stops it going hot, and makes it
'   swallow clicks; disabling the item under a live press cancels the press.
' ----------------------------------------------------------------------------------------
public declare function PsIconPanel_GetItemKind( byval hIconPanel as HWND, byval idx as long ) as long
public declare function PsIconPanel_GetGlyph( byval hIconPanel as HWND, byval idx as long ) as ustring
public declare function PsIconPanel_SetGlyph( byval hIconPanel as HWND, byval idx as long, byval Glyph as ustring ) as boolean
' Load an image file (.ico/.png/.bmp/.jpg) into an item's cell, replacing its glyph. "" removes
' whatever image is there. Returns TRUE when the item ends up as you asked -- a successful load,
' OR a successful removal -- and FALSE only for a bad index or a file that would not decode.
' The image fits the item's existing icon cell.
public declare function PsIconPanel_SetImage( byval hIconPanel as HWND, byval idx as long, byval Path as ustring ) as boolean
public declare function PsIconPanel_GetItemID( byval hIconPanel as HWND, byval idx as long ) as long
public declare function PsIconPanel_SetItemID( byval hIconPanel as HWND, byval idx as long, byval id as long ) as boolean
public declare function PsIconPanel_GetItemData( byval hIconPanel as HWND, byval idx as long ) as integer
public declare function PsIconPanel_SetItemData( byval hIconPanel as HWND, byval idx as long, byval itemData as integer ) as boolean
public declare function PsIconPanel_GetSelected( byval hIconPanel as HWND, byval idx as long ) as boolean
public declare function PsIconPanel_SetSelected( byval hIconPanel as HWND, byval idx as long, byval isSelected as boolean ) as boolean
public declare function PsIconPanel_GetEnabled( byval hIconPanel as HWND, byval idx as long ) as boolean
public declare function PsIconPanel_SetEnabled( byval hIconPanel as HWND, byval idx as long, byval isEnabled as boolean ) as boolean

' ----------------------------------------------------------------------------------------
' Layout.
'
'   SetJustify moves the whole run as one block and is re-applied on every resize. When the
'   run is wider than the client area the justification degrades to LEFT and the tail clips
'   at the right edge.
'
'   Panel-level SetIconSize / SetPadding / SetSeparatorWidth take RAW PIXELS -- the caller
'   DPI-scales (the family rule; only the Create-time defaults are scaled for you). The
'   per-item setters override them: pass -1 for a padding or 0 for an icon dimension to go
'   back to inheriting.
'
'   GetIdealWidth is the summed width of every cell -- size the panel with it (or centre a
'   fixed-width panel yourself). Rects are computed lazily; every query here forces a
'   pending layout, so results are always current.
' ----------------------------------------------------------------------------------------
public declare function PsIconPanel_GetJustify( byval hIconPanel as HWND ) as long
public declare sub      PsIconPanel_SetJustify( byval hIconPanel as HWND, byval nJustify as long )
public declare sub      PsIconPanel_GetIconSize( byval hIconPanel as HWND, byref nIconWidth as long, byref nIconHeight as long )
public declare sub      PsIconPanel_SetIconSize( byval hIconPanel as HWND, byval nIconWidth as long, byval nIconHeight as long )
public declare sub      PsIconPanel_GetPadding( byval hIconPanel as HWND, byref nPadBefore as long, byref nPadAfter as long )
public declare sub      PsIconPanel_SetPadding( byval hIconPanel as HWND, byval nPadBefore as long, byval nPadAfter as long )
public declare function PsIconPanel_GetSeparatorWidth( byval hIconPanel as HWND ) as long
public declare sub      PsIconPanel_SetSeparatorWidth( byval hIconPanel as HWND, byval nSepWidth as long )
public declare function PsIconPanel_SetItemPadding( byval hIconPanel as HWND, byval idx as long, byval nPadBefore as long, byval nPadAfter as long ) as boolean
public declare function PsIconPanel_SetItemIconSize( byval hIconPanel as HWND, byval idx as long, byval nIconWidth as long, byval nIconHeight as long ) as boolean
public declare function PsIconPanel_GetItemRect( byval hIconPanel as HWND, byval idx as long, byref rc as RECT ) as boolean
public declare function PsIconPanel_GetItemIconRect( byval hIconPanel as HWND, byval idx as long, byref rc as RECT ) as boolean
public declare function PsIconPanel_GetIdealWidth( byval hIconPanel as HWND ) as long

' ----------------------------------------------------------------------------------------
' Appearance.  The font is borrowed, never owned: keep it alive and destroy it yourself.
' It is a PAINT-time input only -- nothing here is measured, so changing it never changes
' the layout.
'
'   SetColors copies the whole struct. GetColors fills one out, so the read-modify-write
'   "change one color" idiom is Get, assign, Set.
'
'   SetItemForeColor overrides the IDLE glyph color of one item (a red record dot, a green
'   run arrow); hot, selected and disabled keep the panel's colors, so a hover always
'   speaks the panel's language. ClearItemForeColor goes back to the panel's ForeColor.
' ----------------------------------------------------------------------------------------
public declare sub      PsIconPanel_GetColors( byval hIconPanel as HWND, byval pColors as PSICONPANEL_COLORS ptr )
public declare sub      PsIconPanel_SetColors( byval hIconPanel as HWND, byval pColors as PSICONPANEL_COLORS ptr )
public declare function PsIconPanel_ThemeColors( byref t as PSTHEME_COLORS ) as PSICONPANEL_COLORS
public declare sub      PsIconPanel_ApplyTheme( byval hIconPanel as HWND, byref t as PSTHEME_COLORS )
public declare sub      PsIconPanel_UnpinColors( byval hIconPanel as HWND )
public declare sub      PsIconPanel_ApplyFonts( byval hIconPanel as HWND, byval hTextFont as HFONT, byval hGlyphFont as HFONT )
public declare sub      PsIconPanel_Rescale( byval hIconPanel as HWND, byval oldDpi as long, byval newDpi as long )
public declare function PsIconPanel_SetItemForeColor( byval hIconPanel as HWND, byval idx as long, byval clr as COLORREF ) as boolean
public declare function PsIconPanel_ClearItemForeColor( byval hIconPanel as HWND, byval idx as long ) as boolean
public declare function PsIconPanel_GetFont( byval hIconPanel as HWND ) as HFONT
public declare function PsIconPanel_SetFont( byval hIconPanel as HWND, byval hIconFont as HFONT ) as boolean
public declare function PsIconPanel_GetTooltipHandle( byval hIconPanel as HWND ) as HWND
public declare sub      PsIconPanel_SetHoverTime( byval hIconPanel as HWND, byval milliseconds as long )
public declare function PsIconPanel_SetTooltipMode( byval hIconPanel as HWND, byval nMode as long ) as boolean
public declare function PsIconPanel_GetTooltipMode( byval hIconPanel as HWND ) as long
' The PsTooltip window, or 0 on the system backend. The door to PsTooltip's own
' SetColors/SetFonts/SetStyle/SetMaxWidth/SetTitle/SetGlyph -- deliberately not mirrored
' here, since thirteen controls x twenty setters is 260 wrappers to keep in step.
public declare function PsIconPanel_GetPsTooltipHandle( byval hIconPanel as HWND ) as HWND
' Honoured by BOTH backends. A delay never set keeps the backend's own derivation from
' the system double-click time.
public declare sub      PsIconPanel_SetAutoPopTime( byval hIconPanel as HWND, byval milliseconds as long )
public declare sub      PsIconPanel_SetReshowTime( byval hIconPanel as HWND, byval milliseconds as long )

' ----------------------------------------------------------------------------------------
' Tooltips.  Per-item text wins; the callback is consulted only for items with none; an
' item with neither shows no tip.
' ----------------------------------------------------------------------------------------
public declare function PsIconPanel_GetTooltipText( byval hIconPanel as HWND, byval idx as long ) as ustring
public declare function PsIconPanel_SetTooltipText( byval hIconPanel as HWND, byval idx as long, byval Text as ustring ) as boolean

' ----------------------------------------------------------------------------------------
' Callbacks.  See the type declarations above for each signature and contract.
'   PaintItemCallback - draw one item INSTEAD OF the built-in painter (which handles every
'                       item, including separators, when this is unset).
'   MessageCallback   - observe mouse messages; return TRUE to suppress default handling
'                       (IGNORED for WM_LBUTTONUP -- capture-critical).
'   TooltipCallback   - supply tooltip text on demand for items without their own.
'   ClickCallback     - a COMMAND item was clicked (matched press+release).
'   SelChangeCallback - a TOGGLE item latched/unlatched. Programmatic SetSelected is silent.
' ----------------------------------------------------------------------------------------
public declare sub      PsIconPanel_SetPaintItemCallback( byval hIconPanel as HWND, byval usersub as IP_PaintItemCallbackSub )
public declare sub      PsIconPanel_SetMessageCallback( byval hIconPanel as HWND, byval userfunc as IP_MessageCallbackFunc )
public declare sub      PsIconPanel_SetTooltipCallback( byval hIconPanel as HWND, byval userfunc as IP_TooltipCallbackFunc )
public declare sub      PsIconPanel_SetClickCallback( byval hIconPanel as HWND, byval usersub as IP_ClickCallbackSub )
public declare sub      PsIconPanel_SetSelChangeCallback( byval hIconPanel as HWND, byval usersub as IP_SelChangeCallbackSub )

' The tooltip backend switch (PsTipHost) and the image loader (PsImage) are imported at the
' top of this module, so a host needs no import of its own for either.


function GetIconPanelPointer( byval hIconPanel as HWND ) as PSICONPANEL_STATE ptr
    dim pWindow as CWindow ptr = CWindowPtr(hIconPanel)
    dim as PSICONPANEL_STATE ptr pIcon = null
    if pWindow then pIcon = cast( PSICONPANEL_STATE ptr, pWindow->UserData(0) )
    return pIcon
end function


' Which item is the cursor over, for HOVER and CLICK purposes? Returns a model index, or
' -1 for none. This is the public HitTest plus two extra rules that belong to interaction
' and not to geometry:
'   - the cursor must be inside the client area. Cells can legitimately run PAST the right
'     edge when the run overflows, and without this test a cursor over the sibling window
'     next door would light one of them up.
'   - a DISABLED item is never hot and never pressable.
private function GetHotIconPanelItem( byval hIconPanel as HWND ) as long
    dim as PSICONPANEL_STATE ptr pIcon = GetIconPanelPointer(hIconPanel)
    if pIcon = null then return -1

    dim as POINT pt
    GetCursorPos( @pt )
    ScreenToClient( hIconPanel, @pt )

    dim as RECT rcClient
    GetClientRect( hIconPanel, @rcClient )
    if PtInRect( @rcClient, pt ) = 0 then return -1

    dim as long idx = pIcon->HitTest( pt.x, pt.y )
    if idx = -1 then return -1
    if pIcon->items(idx).isEnabled = false then return -1
    return idx
end function


' Repaint one item. Silently does nothing for an invalid index, which is what makes the
' hover path safe when the cursor is over empty panel area (idx = -1). FALSE = no
' background erase; the item's whole cell is painted every time.
private sub PsIconPanel_InvalidateItem( byval pIcon as PSICONPANEL_STATE ptr, byval idx as long )
    if pIcon = null then exit sub
    if pIcon->IsValidItem(idx) = false then exit sub
    InvalidateRect( pIcon->hWin, @pIcon->items(idx).rc, FALSE )
end sub


' ========================================================================================
' Append an item. itemKind is IP_KIND_TOGGLE or IP_KIND_COMMAND (a separator has no glyph
' or id of its own -- use PsIconPanel_AddSeparator). Returns the new item's index, or -1.
' ========================================================================================
public function PsIconPanel_AddItem( byval hIconPanel as HWND, byval itemKind as long, byval Glyph as ustring, byval id as long = 0, byval itemData as integer = 0 ) as long
    dim as PSICONPANEL_STATE ptr pIcon = GetIconPanelPointer(hIconPanel)
    if pIcon = null then return -1
    dim as PSICONPANEL_ITEM ptr pItem = pIcon->AddItem()
    if pItem = null then return -1
    pItem->itemKind = itemKind
    pItem->wszGlyph = Glyph
    pItem->id       = id
    pItem->itemData = itemData
    return pIcon->GetCount() - 1  ' model index of the appended item
end function


' ========================================================================================
' Append a separator: a vertical rule as tall as an icon, drawn by the control itself.
' Give it its own padding (PsIconPanel_SetItemPadding) to control the size of the visual
' gap it makes.
' ========================================================================================
public function PsIconPanel_AddSeparator( byval hIconPanel as HWND ) as long
    return PsIconPanel_AddItem( hIconPanel, IP_KIND_SEPARATOR, "", 0, 0 )
end function


' ========================================================================================
' Refresh the custom icon panel control.
' ========================================================================================
sub PsIconPanel_Refresh( byval hIconPanel as HWND )
    dim as PSICONPANEL_STATE ptr pIcon = GetIconPanelPointer(hIconPanel)
    if pIcon then pIcon->Refresh()
end sub


' ========================================================================================
' Retrieve the current item count in the custom icon panel control.
' ========================================================================================
function PsIconPanel_GetCount( byval hIconPanel as HWND ) as long
    dim as PSICONPANEL_STATE ptr pIcon = GetIconPanelPointer(hIconPanel)
    if pIcon = null then return 0
    return pIcon->GetCount()
end function


' ========================================================================================
' Is idx a valid item index?
' ========================================================================================
function PsIconPanel_IsValidItem( byval hIconPanel as HWND, byval idx as long ) as boolean
    dim as PSICONPANEL_STATE ptr pIcon = GetIconPanelPointer(hIconPanel)
    if pIcon = null then return false
    return pIcon->IsValidItem( idx )
end function


' ========================================================================================
' Index of the FIRST item carrying this id, or -1. Separators are skipped: they all carry
' id 0, so a search for 0 would otherwise find decoration.
' ========================================================================================
function PsIconPanel_FindItemByID( byval hIconPanel as HWND, byval id as long ) as long
    dim as PSICONPANEL_STATE ptr pIcon = GetIconPanelPointer(hIconPanel)
    if pIcon = null then return -1
    for i as long = 0 to pIcon->itemCount - 1
        if pIcon->items(i).itemKind = IP_KIND_SEPARATOR then continue for
        if pIcon->items(i).id = id then return i
    next
    return -1
end function


' ========================================================================================
' Which item is at this CLIENT-coordinate point? Forces a pending layout so the answer is
' always current. Separators are excluded; disabled items are included (they occupy their
' cell, and a caller asking "what is here" deserves the truth).
' ========================================================================================
function PsIconPanel_HitTest( byval hIconPanel as HWND, byval x as long, byval y as long ) as long
    dim as PSICONPANEL_STATE ptr pIcon = GetIconPanelPointer(hIconPanel)
    if pIcon = null then return -1
    if pIcon->bLayoutDirty then pIcon->LayoutItems()
    return pIcon->HitTest( x, y )
end function


' ========================================================================================
' Retrieve an item's kind (IP_KIND_*), or -1 for an invalid index.
' ========================================================================================
function PsIconPanel_GetItemKind( byval hIconPanel as HWND, byval idx as long ) as long
    dim as PSICONPANEL_STATE ptr pIcon = GetIconPanelPointer(hIconPanel)
    if pIcon = null then return -1
    if pIcon->IsValidItem(idx) = false then return -1
    return pIcon->GetItem(idx)->itemKind
end function


' ========================================================================================
' Retrieve an item's glyph.
' ========================================================================================
function PsIconPanel_GetGlyph( byval hIconPanel as HWND, byval idx as long ) as ustring
    dim as PSICONPANEL_STATE ptr pIcon = GetIconPanelPointer(hIconPanel)
    if pIcon = null then return ""
    if pIcon->IsValidItem(idx) = false then return ""
    dim as ustring wszGlyph = pIcon->GetItem(idx)->wszGlyph
    return wszGlyph
end function


' ========================================================================================
' Set an item's glyph. Repaints that item only -- NOT a re-layout: the cell width is
' declared, never measured, so a glyph swap cannot move anything.
' ========================================================================================
function PsIconPanel_SetGlyph( byval hIconPanel as HWND, byval idx as long, byval Glyph as ustring ) as boolean
    dim as PSICONPANEL_STATE ptr pIcon = GetIconPanelPointer(hIconPanel)
    if pIcon = null then return false
    if pIcon->IsValidItem(idx) = false then return false
    dim as PSICONPANEL_ITEM ptr pit = pIcon->GetItem(idx)
    pit->wszGlyph = Glyph
    ' Glyph OR image: setting an actual glyph frees any image on this item.
    if (len( Glyph ) > 0) andalso (pit->pImage <> 0) then
        delete pit->pImage : pit->pImage = 0
    end if
    PsIconPanel_InvalidateItem( pIcon, idx )
    return true
end function

' ========================================================================================
' Load an image into an item's cell, replacing its glyph. "" removes it. TRUE on a
' successful load; on failure the empty image is dropped so nothing draws.
' ========================================================================================
public function PsIconPanel_SetImage( byval hIconPanel as HWND, byval idx as long, byval Path as ustring ) as boolean
    dim as PSICONPANEL_STATE ptr pIcon = GetIconPanelPointer(hIconPanel)
    if pIcon = null then return false
    if pIcon->IsValidItem(idx) = false then return false
    dim as PSICONPANEL_ITEM ptr pit = pIcon->GetItem(idx)

    if len( Path ) = 0 then
        ' Removal SUCCEEDS. It used to return FALSE, which a caller could not tell apart from
        ' a load that failed -- so "did that do what I asked" had no answer on this path.
        if pit->pImage then delete pit->pImage : pit->pImage = 0
        PsIconPanel_InvalidateItem( pIcon, idx )
        return true
    end if

    if pit->pImage = 0 then pit->pImage = new PsImageFile
    dim as long bOK = pit->pImage->Load( Path )
    if bOK = 0 then
        delete pit->pImage : pit->pImage = 0
    else
        pit->wszGlyph = ""                 ' glyph OR image
    end if
    PsIconPanel_InvalidateItem( pIcon, idx )
    return (bOK <> 0)
end function


' ========================================================================================
' Get / set an item's host command id (reported by the click callback).
' ========================================================================================
function PsIconPanel_GetItemID( byval hIconPanel as HWND, byval idx as long ) as long
    dim as PSICONPANEL_STATE ptr pIcon = GetIconPanelPointer(hIconPanel)
    if pIcon = null then return 0
    if pIcon->IsValidItem(idx) = false then return 0
    return pIcon->GetItem(idx)->id
end function

function PsIconPanel_SetItemID( byval hIconPanel as HWND, byval idx as long, byval id as long ) as boolean
    dim as PSICONPANEL_STATE ptr pIcon = GetIconPanelPointer(hIconPanel)
    if pIcon = null then return false
    if pIcon->IsValidItem(idx) = false then return false
    pIcon->GetItem(idx)->id = id
    return true
end function


' ========================================================================================
' Get / set an item's free-form host payload.
' ========================================================================================
function PsIconPanel_GetItemData( byval hIconPanel as HWND, byval idx as long ) as integer
    dim as PSICONPANEL_STATE ptr pIcon = GetIconPanelPointer(hIconPanel)
    if pIcon = null then return 0
    if pIcon->IsValidItem(idx) = false then return 0
    return pIcon->GetItem(idx)->itemData
end function

function PsIconPanel_SetItemData( byval hIconPanel as HWND, byval idx as long, byval itemData as integer ) as boolean
    dim as PSICONPANEL_STATE ptr pIcon = GetIconPanelPointer(hIconPanel)
    if pIcon = null then return false
    if pIcon->IsValidItem(idx) = false then return false
    pIcon->GetItem(idx)->itemData = itemData
    return true
end function


' ========================================================================================
' Is this TOGGLE item latched?
' ========================================================================================
function PsIconPanel_GetSelected( byval hIconPanel as HWND, byval idx as long ) as boolean
    dim as PSICONPANEL_STATE ptr pIcon = GetIconPanelPointer(hIconPanel)
    if pIcon = null then return false
    if pIcon->IsValidItem(idx) = false then return false
    return pIcon->GetItem(idx)->isSelected
end function


' ========================================================================================
' Latch / unlatch a TOGGLE item. SILENT -- no SelChangeCallback, because only the user
' fires that (the family rule); this also makes it safe to call from inside the change
' handler. Returns FALSE for an invalid index or an item that is not a toggle.
' ========================================================================================
public function PsIconPanel_SetSelected( byval hIconPanel as HWND, byval idx as long, byval isSelected as boolean ) as boolean
    dim as PSICONPANEL_STATE ptr pIcon = GetIconPanelPointer(hIconPanel)
    if pIcon = null then return false
    if pIcon->IsValidItem(idx) = false then return false
    dim as PSICONPANEL_ITEM ptr pItem = pIcon->GetItem(idx)
    if pItem->itemKind <> IP_KIND_TOGGLE then return false
    if pItem->isSelected = isSelected then return true      ' no repaint for a no-op
    pItem->isSelected = isSelected
    PsIconPanel_InvalidateItem( pIcon, idx )
    return true
end function


' ========================================================================================
' Is this item enabled?
' ========================================================================================
function PsIconPanel_GetEnabled( byval hIconPanel as HWND, byval idx as long ) as boolean
    dim as PSICONPANEL_STATE ptr pIcon = GetIconPanelPointer(hIconPanel)
    if pIcon = null then return false
    if pIcon->IsValidItem(idx) = false then return false
    return pIcon->GetItem(idx)->isEnabled
end function


' ========================================================================================
' Enable / disable an item. A disabled item greys out, stops answering hover, and swallows
' clicks -- so disabling the item the cursor is on, or the one under a live press, must
' clear that state here rather than wait for the next mouse move.
' ========================================================================================
public function PsIconPanel_SetEnabled( byval hIconPanel as HWND, byval idx as long, byval isEnabled as boolean ) as boolean
    dim as PSICONPANEL_STATE ptr pIcon = GetIconPanelPointer(hIconPanel)
    if pIcon = null then return false
    if pIcon->IsValidItem(idx) = false then return false
    dim as PSICONPANEL_ITEM ptr pItem = pIcon->GetItem(idx)
    if pItem->isEnabled = isEnabled then return true         ' no repaint for a no-op
    pItem->isEnabled = isEnabled
    if isEnabled = false then
        if pIcon->nLastHotIdx = idx then pIcon->nLastHotIdx = -1
        if pIcon->nPressedIdx = idx then pIcon->CancelPress()
    end if
    PsIconPanel_InvalidateItem( pIcon, idx )
    return true
end function


' ========================================================================================
' Get / set where the whole run sits in the client area. Re-applied on every resize.
' ========================================================================================
function PsIconPanel_GetJustify( byval hIconPanel as HWND ) as long
    dim as PSICONPANEL_STATE ptr pIcon = GetIconPanelPointer(hIconPanel)
    if pIcon = null then return IP_JUSTIFY_LEFT
    return pIcon->nJustify
end function

public sub PsIconPanel_SetJustify( byval hIconPanel as HWND, byval nJustify as long )
    dim as PSICONPANEL_STATE ptr pIcon = GetIconPanelPointer(hIconPanel)
    if pIcon = null then exit sub
    if (nJustify < IP_JUSTIFY_LEFT) orelse (nJustify > IP_JUSTIFY_RIGHT) then exit sub
    pIcon->nJustify = nJustify
    pIcon->Refresh()
end sub


' ========================================================================================
' Get / set the panel-wide icon cell size (raw pixels -- the caller DPI-scales). A LAYOUT
' input: it is the width every item contributes to the run unless it overrides it.
' ========================================================================================
sub PsIconPanel_GetIconSize( byval hIconPanel as HWND, byref nIconWidth as long, byref nIconHeight as long )
    nIconWidth  = 0
    nIconHeight = 0
    dim as PSICONPANEL_STATE ptr pIcon = GetIconPanelPointer(hIconPanel)
    if pIcon = null then exit sub
    nIconWidth  = pIcon->nIconWidth
    nIconHeight = pIcon->nIconHeight
end sub

sub PsIconPanel_SetIconSize( byval hIconPanel as HWND, byval nIconWidth as long, byval nIconHeight as long )
    dim as PSICONPANEL_STATE ptr pIcon = GetIconPanelPointer(hIconPanel)
    if pIcon = null then exit sub
    if nIconWidth  < 0 then nIconWidth  = 0
    if nIconHeight < 0 then nIconHeight = 0
    pIcon->nIconWidth  = nIconWidth
    pIcon->nIconHeight = nIconHeight
    pIcon->Refresh()
end sub


' ========================================================================================
' Get / set the panel-wide padding before and after each icon (raw pixels -- the caller
' DPI-scales). This is the author's spacing control: the layout never adjusts it.
' ========================================================================================
sub PsIconPanel_GetPadding( byval hIconPanel as HWND, byref nPadBefore as long, byref nPadAfter as long )
    nPadBefore = 0
    nPadAfter  = 0
    dim as PSICONPANEL_STATE ptr pIcon = GetIconPanelPointer(hIconPanel)
    if pIcon = null then exit sub
    nPadBefore = pIcon->nPadBefore
    nPadAfter  = pIcon->nPadAfter
end sub

public sub PsIconPanel_SetPadding( byval hIconPanel as HWND, byval nPadBefore as long, byval nPadAfter as long )
    dim as PSICONPANEL_STATE ptr pIcon = GetIconPanelPointer(hIconPanel)
    if pIcon = null then exit sub
    if nPadBefore < 0 then nPadBefore = 0
    if nPadAfter  < 0 then nPadAfter  = 0
    pIcon->nPadBefore = nPadBefore
    pIcon->nPadAfter  = nPadAfter
    pIcon->Refresh()
end sub


' ========================================================================================
' Get / set the thickness of a separator's rule (raw pixels -- the caller DPI-scales).
' ========================================================================================
function PsIconPanel_GetSeparatorWidth( byval hIconPanel as HWND ) as long
    dim as PSICONPANEL_STATE ptr pIcon = GetIconPanelPointer(hIconPanel)
    if pIcon = null then return 0
    return pIcon->nSepWidth
end function

sub PsIconPanel_SetSeparatorWidth( byval hIconPanel as HWND, byval nSepWidth as long )
    dim as PSICONPANEL_STATE ptr pIcon = GetIconPanelPointer(hIconPanel)
    if pIcon = null then exit sub
    if nSepWidth < 0 then nSepWidth = 0
    pIcon->nSepWidth = nSepWidth
    pIcon->Refresh()
end sub


' ========================================================================================
' Override one item's padding (raw pixels). Pass -1 for either side to go back to
' inheriting the panel's value.
' ========================================================================================
public function PsIconPanel_SetItemPadding( byval hIconPanel as HWND, byval idx as long, byval nPadBefore as long, byval nPadAfter as long ) as boolean
    dim as PSICONPANEL_STATE ptr pIcon = GetIconPanelPointer(hIconPanel)
    if pIcon = null then return false
    if pIcon->IsValidItem(idx) = false then return false
    if nPadBefore < -1 then nPadBefore = -1
    if nPadAfter  < -1 then nPadAfter  = -1
    pIcon->GetItem(idx)->nPadBefore = nPadBefore
    pIcon->GetItem(idx)->nPadAfter  = nPadAfter
    pIcon->Refresh()
    return true
end function


' ========================================================================================
' Override one item's icon size (raw pixels). Pass 0 for either dimension to go back to
' inheriting the panel's value. On a SEPARATOR the width is ignored (its rule is
' nSepWidth wide) but the height still sets how tall the rule stands.
' ========================================================================================
public function PsIconPanel_SetItemIconSize( byval hIconPanel as HWND, byval idx as long, byval nIconWidth as long, byval nIconHeight as long ) as boolean
    dim as PSICONPANEL_STATE ptr pIcon = GetIconPanelPointer(hIconPanel)
    if pIcon = null then return false
    if pIcon->IsValidItem(idx) = false then return false
    if nIconWidth  < 0 then nIconWidth  = 0
    if nIconHeight < 0 then nIconHeight = 0
    pIcon->GetItem(idx)->nIconWidth  = nIconWidth
    pIcon->GetItem(idx)->nIconHeight = nIconHeight
    pIcon->Refresh()
    return true
end function


' ========================================================================================
' Retrieve the computed client-coordinate cell rect of the specified item. Forces a
' pending layout so the result is always current. Returns FALSE for a bad index.
' ========================================================================================
function PsIconPanel_GetItemRect( byval hIconPanel as HWND, byval idx as long, byref rc as RECT ) as boolean
    dim as PSICONPANEL_STATE ptr pIcon = GetIconPanelPointer(hIconPanel)
    SetRectEmpty( @rc )
    if pIcon = null then return false
    if pIcon->IsValidItem(idx) = false then return false
    if pIcon->bLayoutDirty then pIcon->LayoutItems()
    rc = pIcon->GetItem(idx)->rc
    return true
end function


' ========================================================================================
' Retrieve the computed icon rect (the vertically centred glyph box) of the specified
' item. Forces a pending layout. Returns FALSE for a bad index.
' ========================================================================================
function PsIconPanel_GetItemIconRect( byval hIconPanel as HWND, byval idx as long, byref rc as RECT ) as boolean
    dim as PSICONPANEL_STATE ptr pIcon = GetIconPanelPointer(hIconPanel)
    SetRectEmpty( @rc )
    if pIcon = null then return false
    if pIcon->IsValidItem(idx) = false then return false
    if pIcon->bLayoutDirty then pIcon->LayoutItems()
    rc = pIcon->GetItem(idx)->rcIcon
    return true
end function


' ========================================================================================
' The summed width of every cell: what the panel would have to be for the run to exactly
' fill it. Forces a pending layout.
' ========================================================================================
public function PsIconPanel_GetIdealWidth( byval hIconPanel as HWND ) as long
    dim as PSICONPANEL_STATE ptr pIcon = GetIconPanelPointer(hIconPanel)
    if pIcon = null then return 0
    if pIcon->bLayoutDirty then pIcon->LayoutItems()
    return pIcon->nTotalWidth
end function


' ========================================================================================
' Get / set the built-in painter's colors. Both copy the whole struct, so the
' change-one-color idiom is Get, assign, Set.
' ========================================================================================
public sub PsIconPanel_GetColors( byval hIconPanel as HWND, byval pColors as PSICONPANEL_COLORS ptr )
    if pColors = null then exit sub
    dim as PSICONPANEL_STATE ptr pIcon = GetIconPanelPointer(hIconPanel)
    if pIcon = null then exit sub
    *pColors = pIcon->colors
end sub

public sub PsIconPanel_SetColors( byval hIconPanel as HWND, byval pColors as PSICONPANEL_COLORS ptr )
    if pColors = null then exit sub
    dim as PSICONPANEL_STATE ptr pIcon = GetIconPanelPointer(hIconPanel)
    if pIcon = null then exit sub
    pIcon->colors = *pColors
    pIcon->bColorsPinned = true
    if pIcon->hWin then InvalidateRect( pIcon->hWin, NULL, TRUE )
end sub

' ========================================================================================
' The theme (vendor/PsControls/PsTheme). ThemeColors is the adapter: the panel's colours
' derived from the theme's roles. ApplyTheme applies them unless the host pinned its own.
' ========================================================================================
public function PsIconPanel_ThemeColors( byref t as PSTHEME_COLORS ) as PSICONPANEL_COLORS
    dim as PSICONPANEL_COLORS c
    c.BackColor         = t.Window
    c.ForeColor         = t.Text
    c.BackColorHot      = t.SurfaceHot
    c.ForeColorHot      = t.TextHot
    c.BackColorSelect   = t.Selected
    c.ForeColorSelect   = t.SelectedText
    c.ForeColorDisabled = t.TextDisabled
    c.SeparatorColor    = t.Divider
    return c
end function

public sub PsIconPanel_ApplyTheme( byval hIconPanel as HWND, byref t as PSTHEME_COLORS )
    dim as PSICONPANEL_STATE ptr pIcon = GetIconPanelPointer(hIconPanel)
    if (pIcon = 0) orelse pIcon->bColorsPinned then exit sub
    dim as PSICONPANEL_COLORS c = PsIconPanel_ThemeColors( t )
    PsIconPanel_SetColors( hIconPanel, @c )
    pIcon->bColorsPinned = false
end sub

' Hands the panel back to the theme, which is applied at once.
public sub PsIconPanel_UnpinColors( byval hIconPanel as HWND )
    dim as PSICONPANEL_STATE ptr pIcon = GetIconPanelPointer(hIconPanel)
    if pIcon = 0 then exit sub
    pIcon->bColorsPinned = false
    dim as PSTHEME_COLORS t
    if PsRegistry_GetTheme( t ) then PsIconPanel_ApplyTheme( hIconPanel, t )
end sub

' The form's fonts (PsApp), handed over when the panel is created on a form.
public sub PsIconPanel_ApplyFonts( byval hIconPanel as HWND, byval hTextFont as HFONT, byval hGlyphFont as HFONT )
    if hGlyphFont then PsIconPanel_SetFont( hIconPanel, hGlyphFont )
end sub

' ========================================================================================
' Per-monitor DPI (RFC-0001 P4). Every stored pixel metric -- the scaled Create defaults and
' whatever the host set since -- times newDpi/oldDpi, and so is every per-item override
' that is set (the -1 / 0 inherit sentinels are left alone). The cell widths and the run
' width are LayoutItems caches and are re-derived. An item's PsImage is not re-decoded: it is
' fitted into the (rescaled) icon cell at paint time. The panel's own CWindow takes the new
' DPI so later ScaleX calls agree. The font is not ours: PsApp hands a new one over after
' this.
' ========================================================================================
public sub PsIconPanel_Rescale( byval hIconPanel as HWND, byval oldDpi as long, byval newDpi as long )
    dim as PSICONPANEL_STATE ptr pIcon = GetIconPanelPointer(hIconPanel)
    if (pIcon = 0) orelse (oldDpi <= 0) orelse (newDpi <= 0) orelse (oldDpi = newDpi) then exit sub
    pIcon->nIconWidth  = MulDiv( pIcon->nIconWidth,  newDpi, oldDpi )
    pIcon->nIconHeight = MulDiv( pIcon->nIconHeight, newDpi, oldDpi )
    pIcon->nPadBefore  = MulDiv( pIcon->nPadBefore,  newDpi, oldDpi )
    pIcon->nPadAfter   = MulDiv( pIcon->nPadAfter,   newDpi, oldDpi )
    pIcon->nSepWidth   = MulDiv( pIcon->nSepWidth,   newDpi, oldDpi )
    for i as long = 0 to pIcon->itemCount - 1
        with pIcon->items(i)
            if .nPadBefore  > 0 then .nPadBefore  = MulDiv( .nPadBefore,  newDpi, oldDpi )
            if .nPadAfter   > 0 then .nPadAfter   = MulDiv( .nPadAfter,   newDpi, oldDpi )
            if .nIconWidth  > 0 then .nIconWidth  = MulDiv( .nIconWidth,  newDpi, oldDpi )
            if .nIconHeight > 0 then .nIconHeight = MulDiv( .nIconHeight, newDpi, oldDpi )
        end with
    next
    dim as CWindow ptr pWindow = CWindowPtr( hIconPanel )
    if pWindow then pWindow->DPI = newDpi
    pIcon->Refresh()
end sub


' ========================================================================================
' Override one item's IDLE glyph color. Hot, selected and disabled keep the panel's
' colors, so a hover always speaks the panel's language.
' ========================================================================================
public function PsIconPanel_SetItemForeColor( byval hIconPanel as HWND, byval idx as long, byval clr as COLORREF ) as boolean
    dim as PSICONPANEL_STATE ptr pIcon = GetIconPanelPointer(hIconPanel)
    if pIcon = null then return false
    if pIcon->IsValidItem(idx) = false then return false
    pIcon->GetItem(idx)->ForeColorItem = clr
    pIcon->GetItem(idx)->bHasForeColor = true
    PsIconPanel_InvalidateItem( pIcon, idx )
    return true
end function

function PsIconPanel_ClearItemForeColor( byval hIconPanel as HWND, byval idx as long ) as boolean
    dim as PSICONPANEL_STATE ptr pIcon = GetIconPanelPointer(hIconPanel)
    if pIcon = null then return false
    if pIcon->IsValidItem(idx) = false then return false
    pIcon->GetItem(idx)->ForeColorItem = 0
    pIcon->GetItem(idx)->bHasForeColor = false
    PsIconPanel_InvalidateItem( pIcon, idx )
    return true
end function


' ========================================================================================
' Retrieve the font used to draw the glyphs.
' ========================================================================================
function PsIconPanel_GetFont( byval hIconPanel as HWND ) as HFONT
    dim as PSICONPANEL_STATE ptr pIcon = GetIconPanelPointer(hIconPanel)
    if pIcon = null then return 0
    return pIcon->hIconFont
end function


' ========================================================================================
' Set the font used to draw the glyphs (normally Segoe Fluent Icons). The caller owns the
' HFONT and is responsible for destroying it; the control only stores the handle.
'
' Unlike every text-driven sibling this does NOT re-lay-out: cell widths are declared, not
' measured, so the font is a paint-time input only. Pick a size that fits the icon cell --
' nothing here measures the glyph, so an oversized font simply clips.
' ========================================================================================
public function PsIconPanel_SetFont( byval hIconPanel as HWND, byval hIconFont as HFONT ) as boolean
    dim as PSICONPANEL_STATE ptr pIcon = GetIconPanelPointer(hIconPanel)
    if pIcon = null then return false
    pIcon->hIconFont = hIconFont
    if pIcon->hWin then InvalidateRect( pIcon->hWin, NULL, TRUE )
    return true
end function


' ========================================================================================
' Retrieve the handle of the panel's tooltip control.
' ========================================================================================
' The comctl32 handle, and 0 while on PsTooltip -- the honest answer, since a TTM_* sent
' to a PsTooltip window is silently ignored.
function PsIconPanel_GetTooltipHandle( byval hIconPanel as HWND ) as HWND
    dim as PSICONPANEL_STATE ptr pIcon = GetIconPanelPointer(hIconPanel)
    if pIcon = null then return 0
    return PsTipHost_SysHandle( @pIcon->tip )
end function


' The PsTooltip window, and 0 while on the system backend. This is the door to PsTooltip's
' own SetColors/SetFonts/SetStyle/SetMaxWidth/SetTitle/SetGlyph, none of which is mirrored
' on this control.
function PsIconPanel_GetPsTooltipHandle( byval hIconPanel as HWND ) as HWND
    dim as PSICONPANEL_STATE ptr pIcon = GetIconPanelPointer(hIconPanel)
    if pIcon = 0 then return 0
    return PsTipHost_PsHandle( @pIcon->tip )
end function

function PsIconPanel_SetTooltipMode( byval hIconPanel as HWND, byval nMode as long ) as boolean
    dim as PSICONPANEL_STATE ptr pIcon = GetIconPanelPointer(hIconPanel)
    if pIcon = 0 then return false
    return PsTipHost_SetMode( @pIcon->tip, nMode )
end function

function PsIconPanel_GetTooltipMode( byval hIconPanel as HWND ) as long
    dim as PSICONPANEL_STATE ptr pIcon = GetIconPanelPointer(hIconPanel)
    if pIcon = 0 then return PSTIP_MODE_SYSTEM
    return PsTipHost_GetMode( @pIcon->tip )
end function

' The three delays go through PsTipHost, which STORES them as well as pushing them, so a
' hover time set before a mode switch is still in force after it. Pushing straight at the
' live tooltip loses it at the switch -- and the tip still appears, just on a different
' beat, with nothing reporting the change.
sub PsIconPanel_SetHoverTime( byval hIconPanel as HWND, byval milliseconds as long )
    dim as PSICONPANEL_STATE ptr pIcon = GetIconPanelPointer(hIconPanel)
    if pIcon = 0 then exit sub
    ' The field is STILL READ by TrackMouseEvent as dwHoverTime, so this setter
    ' drives the hot-tracking dwell as well as the tooltip. Dropping it here would
    ' silently change when the control considers itself hot.
    pIcon->HoverTime = milliseconds
    PsTipHost_SetDelay( @pIcon->tip, TTDT_INITIAL, milliseconds )
end sub

sub PsIconPanel_SetAutoPopTime( byval hIconPanel as HWND, byval milliseconds as long )
    dim as PSICONPANEL_STATE ptr pIcon = GetIconPanelPointer(hIconPanel)
    if pIcon = 0 then exit sub
    PsTipHost_SetDelay( @pIcon->tip, TTDT_AUTOPOP, milliseconds )
end sub

sub PsIconPanel_SetReshowTime( byval hIconPanel as HWND, byval milliseconds as long )
    dim as PSICONPANEL_STATE ptr pIcon = GetIconPanelPointer(hIconPanel)
    if pIcon = 0 then exit sub
    PsTipHost_SetDelay( @pIcon->tip, TTDT_RESHOW, milliseconds )
end sub


' ========================================================================================
' Get / set an item's own tooltip text. "" means "ask the tooltip callback".
' ========================================================================================
function PsIconPanel_GetTooltipText( byval hIconPanel as HWND, byval idx as long ) as ustring
    dim as PSICONPANEL_STATE ptr pIcon = GetIconPanelPointer(hIconPanel)
    if pIcon = null then return ""
    if pIcon->IsValidItem(idx) = false then return ""
    dim as ustring wszText = pIcon->GetItem(idx)->wszTooltip
    return wszText
end function

public function PsIconPanel_SetTooltipText( byval hIconPanel as HWND, byval idx as long, byval Text as ustring ) as boolean
    dim as PSICONPANEL_STATE ptr pIcon = GetIconPanelPointer(hIconPanel)
    if pIcon = null then return false
    if pIcon->IsValidItem(idx) = false then return false
    pIcon->GetItem(idx)->wszTooltip = Text
    return true
end function


' Resolve the tooltip text for an item: the item's own text if it has any, else the host
' callback. No caption fallback -- an icon has no caption.
private function PsIconPanel_ResolveTooltipText( byval pIcon as PSICONPANEL_STATE ptr, byval idx as long ) as ustring
    if pIcon = null then return ""
    if pIcon->IsValidItem(idx) = false then return ""
    dim as ustring wszText = pIcon->items(idx).wszTooltip
    if len(wszText) then return wszText
    if pIcon->TooltipCallback then return pIcon->TooltipCallback( pIcon->hWin, idx )
    return ""
end function


' ========================================================================================
' Callback setters. See the type declarations at the top of this file for each contract.
' ========================================================================================
public sub PsIconPanel_SetPaintItemCallback( byval hIconPanel as HWND, byval usersub as IP_PaintItemCallbackSub )
    dim as PSICONPANEL_STATE ptr pIcon = GetIconPanelPointer(hIconPanel)
    if pIcon = null then return
    pIcon->PaintItemCallback = usersub
end sub

public sub PsIconPanel_SetMessageCallback( byval hIconPanel as HWND, byval userfunc as IP_MessageCallbackFunc )
    dim as PSICONPANEL_STATE ptr pIcon = GetIconPanelPointer(hIconPanel)
    if pIcon = null then return
    pIcon->MessageCallback = userfunc
end sub

public sub PsIconPanel_SetTooltipCallback( byval hIconPanel as HWND, byval userfunc as IP_TooltipCallbackFunc )
    dim as PSICONPANEL_STATE ptr pIcon = GetIconPanelPointer(hIconPanel)
    if pIcon = null then return
    pIcon->TooltipCallback = userfunc
end sub

public sub PsIconPanel_SetClickCallback( byval hIconPanel as HWND, byval usersub as IP_ClickCallbackSub )
    dim as PSICONPANEL_STATE ptr pIcon = GetIconPanelPointer(hIconPanel)
    if pIcon = null then return
    pIcon->ClickCallback = usersub
end sub

public sub PsIconPanel_SetSelChangeCallback( byval hIconPanel as HWND, byval usersub as IP_SelChangeCallbackSub )
    dim as PSICONPANEL_STATE ptr pIcon = GetIconPanelPointer(hIconPanel)
    if pIcon = null then return
    pIcon->SelChangeCallback = usersub
end sub


' ========================================================================================
' Process WM_SIZE message for window/dialog: PsIconPanel
' ========================================================================================
function PsIconPanel_OnSize( _
            byval hwnd as HWND, _
            byval state as UINT, _
            byval cx as long, _
            byval cy as long _
            ) as LRESULT
    if state <> SIZE_MINIMIZED then
        ' There are no child windows to position. The client width decides where the
        ' justified run sits, so a resize invalidates the layout -- and unlike the
        ' siblings, that IS the whole of the resize response.
        dim as PSICONPANEL_STATE ptr pIcon = GetIconPanelPointer(hwnd)
        if pIcon then pIcon->Refresh()
    end if
    function = 0
end function


' ========================================================================================
' The built-in painter: draws one item when no PaintItemCallback is set.
'
' State precedence, decided once here so every renderer agrees:
'   disabled > pressed > hot > selected > idle
' A disabled item is never hot or pressed (GetHotIconPanelItem refuses it), so the first
' rung is unreachable from the others rather than merely winning over them.
'
' Pressed reuses the SELECT color pair rather than adding a ninth color: on a COMMAND item
' it is the momentary flash that makes the icon feel like a button, and on a TOGGLE it
' previews the latched look the release is about to produce.
' ========================================================================================
private sub PsIconPanel_PaintItemDefault( _
            byval pIcon as PSICONPANEL_STATE ptr, _
            byval b as PsPaintBuffer ptr, _
            byval idx as long, _
            byval isHot as boolean, _
            byval isPressed as boolean _
            )
    if (pIcon = null) orelse (b = null) then exit sub

    with pIcon->items(idx)
        if .itemKind = IP_KIND_SEPARATOR then
            b->SetBackColor( pIcon->colors.BackColor )
            b->PaintRect( @.rc )
            b->SetBackColor( pIcon->colors.SeparatorColor )
            b->PaintRect( @.rcIcon )     ' the rule: sepWidth wide, icon-height tall
            exit sub
        end if

        dim as COLORREF backclr = pIcon->colors.BackColor
        dim as COLORREF foreclr = pIcon->colors.ForeColor
        if .isEnabled = false then
            foreclr = pIcon->colors.ForeColorDisabled
        elseif isPressed then
            backclr = pIcon->colors.BackColorSelect
            foreclr = pIcon->colors.ForeColorSelect
        elseif isHot then
            backclr = pIcon->colors.BackColorHot
            foreclr = pIcon->colors.ForeColorHot
        elseif .isSelected then
            backclr = pIcon->colors.BackColorSelect
            foreclr = pIcon->colors.ForeColorSelect
        elseif .bHasForeColor then
            foreclr = .ForeColorItem
        end if

        b->SetColors( foreclr, backclr )
        b->PaintRect( @.rc )             ' fill the WHOLE cell, padding included

        ' Image first, else glyph. Both draw into the same declared icon cell (rcIcon).
        if (.pImage <> 0) andalso (.pImage->IsValid() <> 0) then
            b->PaintImage( .pImage->Image(), @.rcIcon, PS_IMGFIT_ASPECT )
        elseif len(.wszGlyph) then
            b->SetFont( pIcon->hIconFont )
            ' PaintText already adds DT_VCENTER / DT_SINGLELINE / DT_NOPREFIX.
            b->PaintText( .wszGlyph, @.rcIcon, DT_CENTER )
        end if
    end with
end sub


' ========================================================================================
' Process WM_PAINT message for window/dialog: PsIconPanel
' ========================================================================================
function PsIconPanel_OnPaint( byval hwnd as HWND ) as LRESULT
    dim as PSICONPANEL_STATE ptr pIcon = GetIconPanelPointer(hwnd)
    if pIcon = null then return 0

    ' Consume any pending layout before painting. This is what makes a burst of Add calls
    ' cost one layout pass instead of N.
    if pIcon->bLayoutDirty then pIcon->LayoutItems()

    ' Capture the update rect BEFORE BeginDoubleBuffer -- BeginPaint clears it. This is a
    ' CONSERVATIVE approximation and correctness never depends on it: GetUpdateRect returns
    ' the BOUNDING BOX of the update region, so it only ever skips items that could not
    ' show a pixel anyway.
    dim as RECT rcUpdate
    if GetUpdateRect( hwnd, @rcUpdate, FALSE ) = 0 then GetClientRect( hwnd, @rcUpdate )

    dim as PsPaintBuffer b

    b.BeginDoubleBuffer(hwnd)
    b.SetBackColor( pIcon->colors.BackColor )

    ' Fill the whole panel, which also covers everything outside the run -- with three
    ' justifications that is usually most of the client area.
    b.PaintClientRect()

    ' Skipping items outside the update rect is safe even though EndDoubleBuffer blits the
    ' WHOLE client: BeginPaint's DC is clipped to the update region, so the skipped
    ' (background-filled) areas never reach the screen.
    dim p as PSICONPANEL_PAINTINFO
    p.hIconPanel = hwnd
    p.b          = @b

    for i as long = 0 to pIcon->itemCount - 1
        dim as RECT rcHit
        if IntersectRect( @rcHit, @pIcon->items(i).rc, @rcUpdate ) = 0 then continue for

        dim as boolean isHot     = (i = pIcon->nLastHotIdx)
        ' "The press is still on this item" is exactly "the pressed item is also the hot
        ' one" -- hover tracking maintains that through the capture, so no second flag.
        dim as boolean isPressed = (i = pIcon->nPressedIdx) andalso (pIcon->nLastHotIdx = pIcon->nPressedIdx)

        if pIcon->PaintItemCallback then
            p.itemID     = i
            p.itemKind   = pIcon->items(i).itemKind
            p.rc         = pIcon->items(i).rc
            p.rcIcon     = pIcon->items(i).rcIcon
            p.isHot      = isHot
            p.isSelected = pIcon->items(i).isSelected
            p.isPressed  = isPressed
            p.isEnabled  = pIcon->items(i).isEnabled
            p.wszGlyph   = pIcon->items(i).wszGlyph
            dim as PSICONPANEL_ITEM ptr pit = @pIcon->items(i)
            p.pImage     = iif( (pit->pImage <> 0) andalso (pit->pImage->IsValid() <> 0), pit->pImage->Image(), cast( CGpImage ptr, 0 ) )
            pIcon->PaintItemCallback( @p )
        else
            PsIconPanel_PaintItemDefault( pIcon, @b, i, isHot, isPressed )
        end if
    next

    b.EndDoubleBuffer()

    function = 0
end function


' ========================================================================================
' Clear any hot-tracked item and stop the safety-net timer. Repaints only if an item was
' actually hot, so this is cheap to call repeatedly.
'
' Note this also changes how a live press LOOKS (isPressed is derived from the hot index),
' which is exactly right: the cursor left the item, so the press must stop looking armed.
' The gesture itself survives -- only a release or a capture loss ends it.
' ========================================================================================
private sub PsIconPanel_ClearHotTracking( byval pIcon as PSICONPANEL_STATE ptr, byval hIconPanel as HWND )
    if pIcon = null then exit sub
    if pIcon->hotTimerOn then
        KillTimer( hIconPanel, IDT_CICONPANEL_HOTTRACK )
        pIcon->hotTimerOn = false
    end if
    if pIcon->nLastHotIdx <> -1 then
        pIcon->nLastHotIdx = -1
        win.RedrawWindow( hIconPanel )
    end if
end sub


' ========================================================================================
' PsIconPanel Window procedure
'
' This control has no child windows, so there is nothing to subclass: every message is
' handled here and anything unhandled goes to DefWindowProc.
'
' The control TAKES mouse capture on a press. Unlike PsStatusBar (whose "no capture" note
' must not be inherited here), something does consume the guaranteed WM_LBUTTONDOWN ->
' WM_LBUTTONUP pairing: the press/cancel gesture. Press an icon, slide off it, release --
' nothing fires. That requires knowing the press is still live while the cursor is
' elsewhere, which is what capture buys. The full price is paid, in the order the family
' learned to pay it:
'   - WM_LBUTTONUP releases capture FIRST and unconditionally, before any callback runs;
'   - the message callback's result is IGNORED for WM_LBUTTONUP, so it cannot strand it;
'   - WM_CAPTURECHANGED cancels the press (anything can steal capture at any time);
'   - WM_DESTROY releases it if we still hold it.
'
' There is deliberately NO CS_DBLCLKS on this window class. PsStatusBar sets it, and copying
' that here would be a bug: with double-click messages enabled the second of two rapid
' clicks arrives as WM_LBUTTONDBLCLK instead of WM_LBUTTONDOWN, so every other click on a
' toggle would be swallowed. A toolbar has no double-click semantic to gain in exchange.
' ========================================================================================
function PsIconPanel_WndProc( _
            byval hwnd   as HWND, _
            byval uMsg   as UINT, _
            byval wParam as WPARAM, _
            byval lParam as LPARAM _
            ) as LRESULT

    dim as PSICONPANEL_STATE ptr pIcon = GetIconPanelPointer( hwnd )

    ' Per-message scratch info passed to the user MessageCallback. A plain local (NOT
    ' static) so that multiple control instances never share it. The hover tracking index
    ' likewise lives per-instance in pIcon->nLastHotIdx.
    dim m as PSICONPANEL_MESSAGEINFO

    select case uMsg
        ' Prepare the callback MessageInfo for only the messages that we hand to the host.
        case WM_MOUSEMOVE, WM_MOUSEHOVER, WM_MOUSELEAVE, _
             WM_LBUTTONDOWN, WM_LBUTTONUP, WM_RBUTTONDOWN, WM_RBUTTONUP
            with m
                .hIconPanel = hwnd
                .uMsg       = uMsg
                .wParam     = wParam
                .lParam     = lParam
                .idx        = -1
            end with
    end select

    select case uMsg
        HANDLE_MSG (hwnd, WM_SIZE,        PsIconPanel_OnSize)
        HANDLE_MSG (hwnd, WM_PAINT,       PsIconPanel_OnPaint)

    case WM_TIMER
        if (pIcon <> 0) andalso (wParam = IDT_CICONPANEL_HOTTRACK) then
            ' The cursor may have left without us getting a WM_MOUSELEAVE. If it is no
            ' longer over our client area, clear the hot item ourselves.
            dim as RECT rcClient : GetClientRect( hwnd, @rcClient )
            if isMouseOverRECT( hwnd, rcClient ) = false then
                PsIconPanel_ClearHotTracking( pIcon, hwnd )
            end if
            return 0
        end if

    case WM_MOUSEMOVE
        ' Track that we are over the control in order to catch the eventual
        ' WM_MOUSEHOVER and WM_MOUSELEAVE events.
        dim tme as TrackMouseEvent
        tme.cbSize = sizeof(TrackMouseEvent)
        tme.dwFlags = TME_HOVER or TME_LEAVE
        tme.hwndTrack = hwnd
        tme.dwHoverTime = 250    ' HOVER_DEFAULT is 500
        if pIcon then tme.dwHoverTime = pIcon->HoverTime
        TrackMouseEvent(@tme)

        ' Safety net: WM_MOUSELEAVE is not guaranteed to arrive when the mouse exits
        ' quickly (or onto another control), which would strand the hot item painted.
        ' Poll the cursor while we are over the control.
        if (pIcon <> 0) andalso (pIcon->hotTimerOn = false) then
            SetTimer( hwnd, IDT_CICONPANEL_HOTTRACK, PSICONPANEL_HOTTRACK_MS, NULL )
            pIcon->hotTimerOn = true
        end if

        ' Repaint only the items whose state changed, not the whole panel. This is also
        ' what keeps a live press's appearance current: isPressed is derived from the hot
        ' index, so arming and disarming it costs nothing extra here.
        if pIcon then
            dim as long idx = GetHotIconPanelItem(hwnd)
            if idx <> pIcon->nLastHotIdx then
                PsIconPanel_InvalidateItem( pIcon, idx )                 ' newly hot
                PsIconPanel_InvalidateItem( pIcon, pIcon->nLastHotIdx )  ' previously hot
                pIcon->nLastHotIdx = idx
                ' Item changed. On the system backend this pops the tip so it re-queries
                ' TTN_GETDISPINFOW for the new item; on PsTooltip it moves the tool index,
                ' which hides a visible tip and re-resolves on the next dwell. One call site
                ' either way -- and the index is what makes the PsTooltip backend able to
                ' report WHICH item a tip is for, which comctl32 never knew.
                PsTipHost_SetToolIndex( @pIcon->tip, idx )
            end if
            m.idx = idx
            if pIcon->MessageCallback then
                if pIcon->MessageCallback( @m ) then return 0
            end if
        end if

    case WM_MOUSEHOVER
        if pIcon then
            m.idx = GetHotIconPanelItem(hwnd)
            if pIcon->MessageCallback then
                if pIcon->MessageCallback( @m ) then return 0
            end if
        end if

    case WM_MOUSELEAVE
        if pIcon then
            ' Fast path for clearing the hot item (the WM_TIMER poll is the fallback for
            ' when this message never arrives). The tooltip hides itself when the mouse
            ' leaves the tool, so nothing to push. m.idx stays -1: the mouse is gone.
            PsIconPanel_ClearHotTracking( pIcon, hwnd )
            if pIcon->MessageCallback then
                if pIcon->MessageCallback( @m ) then return 0
            end if
        end if

    case WM_LBUTTONDOWN
        if pIcon then
            ' GetHotIconPanelItem already rejects separators and disabled items, so this
            ' index is always something that can legitimately be pressed.
            dim as long idx = GetHotIconPanelItem(hwnd)
            m.idx = idx
            if pIcon->MessageCallback then
                ' Suppressing the press is allowed: no capture has been taken yet, so
                ' there is no bookkeeping to strand.
                if pIcon->MessageCallback( @m ) then return 0
            end if
            ' No SetFocus: a toolbar must not steal focus from the host's editor.
            if idx <> -1 then
                SetCapture( hwnd )
                pIcon->nPressedIdx = idx
                PsIconPanel_InvalidateItem( pIcon, idx )
            end if
            return 0
        end if

    case WM_LBUTTONUP
        if pIcon then
            ' SNAPSHOT BEFORE RELEASING. ReleaseCapture sends WM_CAPTURECHANGED to the
            ' window losing capture SYNCHRONOUSLY, and our handler for it cancels the
            ' press -- so reading nPressedIdx after the release would always find -1 and
            ' no click would ever fire.
            dim as long idxPressed = pIcon->nPressedIdx
            ' Release capture unconditionally, before any callback runs. Nothing below --
            ' not a callback, not a host handler -- gets the chance to leave it held.
            if GetCapture() = hwnd then ReleaseCapture()

            dim as long idx = GetHotIconPanelItem(hwnd)
            pIcon->CancelPress()
            PsIconPanel_InvalidateItem( pIcon, idxPressed )

            m.idx = idx
            ' The result is deliberately IGNORED here (see IP_MessageCallbackFunc).
            if pIcon->MessageCallback then pIcon->MessageCallback( @m )

            ' Only a matched press+release on the SAME item acts. Press, slide off,
            ' release = nothing happened, which is the whole reason for the capture.
            if (idxPressed <> -1) andalso (idx = idxPressed) then
                dim as PSICONPANEL_ITEM ptr pItem = pIcon->GetItem( idxPressed )
                ' The item set is static, so this pointer cannot have been invalidated by
                ' an insert or delete inside a callback -- but a callback CAN still have
                ' disabled the item mid-gesture, so that is re-checked below.
                if pItem <> null then
                    if pItem->isEnabled then
                        select case pItem->itemKind
                        case IP_KIND_TOGGLE
                            dim as boolean bNewState = not pItem->isSelected
                            pItem->isSelected = bNewState
                            PsIconPanel_InvalidateItem( pIcon, idxPressed )
                            ' Snapshot before the callback: it may delete items, which
                            ' would leave pItem dangling.
                            if pIcon->SelChangeCallback then
                                pIcon->SelChangeCallback( hwnd, idxPressed, bNewState )
                            end if
                        case IP_KIND_COMMAND
                            dim as long nId = pItem->id
                            if pIcon->ClickCallback then
                                pIcon->ClickCallback( hwnd, idxPressed, nId )
                            end if
                        end select
                    end if
                end if
            end if
            return 0
        end if

    case WM_CAPTURECHANGED
        ' Capture can be stolen at any time (a modal dialog, another control, the shell).
        ' The gesture is over; forget it and repaint the item that was armed.
        if pIcon then
            dim as long idxPressed = pIcon->nPressedIdx
            pIcon->CancelPress()
            PsIconPanel_InvalidateItem( pIcon, idxPressed )
            return 0
        end if

    case WM_RBUTTONDOWN, WM_RBUTTONUP
        ' Reported, never acted on: a context menu is the host's business (PsPopupMenu).
        ' No capture is taken for the right button, so an up can arrive without a down.
        if pIcon then
            m.idx = GetHotIconPanelItem(hwnd)
            if pIcon->MessageCallback then
                if pIcon->MessageCallback( @m ) then return 0
            end if
        end if

    case WM_NOTIFY
        ' The tooltip asks for its text on demand; supply the current hot item's.
        dim as NMHDR ptr pnmh = cast(NMHDR ptr, lParam)
        if (pnmh <> 0) andalso (pnmh->code = TTN_GETDISPINFOW) then
            if pIcon then
                dim as NMTTDISPINFOW ptr pdi = cast(NMTTDISPINFOW ptr, lParam)
                ' store in an instance-lifetime buffer and point lpszText at it
                pIcon->wszTooltip = PsIconPanel_ResolveTooltipText( pIcon, pIcon->nLastHotIdx )
                pdi->lpszText = cast( LPWSTR, strptr(pIcon->wszTooltip) )
                pdi->hinst    = NULL
            end if
            return 0
        end if

    case WM_DESTROY
        PsRegistry_Remove( hwnd )
        if pIcon then
            ' Don't let the hot-tracking timer outlive the window...
            if pIcon->hotTimerOn then
                KillTimer( hwnd, IDT_CICONPANEL_HOTTRACK )
                pIcon->hotTimerOn = false
            end if
            ' ...nor the capture, if we are being destroyed mid-press.
            if GetCapture() = hwnd then ReleaseCapture()
            pIcon->CancelPress()
        end if

    case WM_NCDESTROY
        ' Delete the stored icon panel data pointer
        if pIcon then
            PsTipHost_Destroy( @pIcon->tip )
            ' Free any per-item images we own (raw pointers, not auto-freed by delete pIcon).
            for i as long = 0 to pIcon->itemCount - 1
                if pIcon->items(i).pImage then delete pIcon->items(i).pImage : pIcon->items(i).pImage = 0
            next
            delete(pIcon)
        end if

        ' delete the allocated memory for window
        dim as CWindow ptr pWindow = CWindowPtr(hwnd)
        if pWindow then delete(pWindow)
        return 0

    case WM_ERASEBKGND
        ' Never erase: WM_PAINT fills the whole client through the double buffer, so a
        ' background erase here would only add flicker.
        return true

    end select

    ' for messages that we don't deal with
    function = DefWindowProc( hwnd, uMsg, wParam, lParam )

end function


' ========================================================================================
' Supply the tooltip text to the PsTooltip backend.
'
' This thunk is why PsTipHost never learns the text policy: PsIconPanel_ResolveTooltipText
' stays the ONE place that decides what a tip says, and the system backend reaches the
' same function by the other road (comctl32 asking through TTN_GETDISPINFOW), which is
' why that arm stays in the WndProc.
' ========================================================================================
private function PsIconPanel_TipTextCallback( byval hTooltip as HWND, byval hAttached as HWND, _
                                        byval idx as long ) as ustring
    dim as ustring wszOut = PsIconPanel_ResolveTooltipText( GetIconPanelPointer(hAttached), idx )
    return wszOut
end function


' ========================================================================================
' PsIconPanel_Create
' ========================================================================================
public function PsIconPanel_Create( byval hWndParent as HWND, byval CtrlID as long ) as HWND

    dim pWindow as CWindow ptr = New CWindow

    dim as HWND hCtrl = _
            pWindow->Create( hWndParent, "", @PsIconPanel_WndProc, _
            0, 0, 0, 0, WS_CHILD or WS_CLIPSIBLINGS or WS_CLIPCHILDREN _
            )
    ' NO CS_DBLCLKS here -- see the WndProc header. It would swallow every second rapid
    ' click on a toggle, and this control has nothing to do with a double-click.

    ' Define the TYPE that holds all the information about this custom icon panel.
    dim as PSICONPANEL_STATE ptr pIcon = new PSICONPANEL_STATE
    pIcon->hWin          = hCtrl
    pIcon->idc_IconPanel = CtrlID
    ' Only the Create-time defaults are DPI-scaled for us; every setter afterwards takes
    ' raw pixels and the caller scales (the family rule).
    pIcon->nIconWidth  = pWindow->ScaleX( PSICONPANEL_DEFAULT_ICONWIDTH )
    pIcon->nIconHeight = pWindow->ScaleY( PSICONPANEL_DEFAULT_ICONHEIGHT )
    pIcon->nPadBefore  = pWindow->ScaleX( PSICONPANEL_DEFAULT_PADBEFORE )
    pIcon->nPadAfter   = pWindow->ScaleX( PSICONPANEL_DEFAULT_PADAFTER )
    pIcon->nSepWidth   = pWindow->ScaleX( PSICONPANEL_DEFAULT_SEPWIDTH )
    SetWindowLongPtr( hCtrl, GWLP_ID, CtrlID )

    ' Store the new pointer into the user data area of the icon panel window
    pWindow->UserData(0) = cast(LONG_PTR, pIcon)

    ' AFTER UserData, not before: PsIconPanel_TipTextCallback resolves the control through
    ' GetIconPanelPointer(hAttached), which reads exactly that slot.
    PsTipHost_Ensure( @pIcon->tip, hCtrl, @PsIconPanel_TipTextCallback )

    ' The theme and the form's fonts, applied now if a PsApp program has them (PsRegistry).
    PsRegistry_SetThemeProcs( hCtrl, @PsIconPanel_ApplyTheme, @PsIconPanel_ApplyFonts, @PsIconPanel_Rescale )


    function = hCtrl

end function
