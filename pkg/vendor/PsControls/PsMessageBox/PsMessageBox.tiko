''
''  vendor/PsControls/PsMessageBox  --  owner-drawn modal message box (caption + icon + wrapped text + buttons)
''

#module "PsMessageBox"

#ifndef TIKO_OS_WINDOWS
    #error "vendor/PsControls is Windows-only (Win32 controls): build for -target windows-x86_64, or use vendor/tkControls"
#endif

#import "sys/win"
#import "sys/win/gui"
#import "sys/win/gdiplus"
#import "vendor/PsControls/PsBufferPaint"
#import "vendor/PsControls/PsButton"
#import "vendor/PsControls/PsRegistry"
#import "vendor/PsControls/PsTheme"

using gui
using gdiplus
using PsBufferPaint
using PsButton
using PsRegistry
using PsTheme

' The family names its booleans bOK, never "ok" -- a convention from AfxNova, where GDI+'s
' Ok = 0 made an "ok" a duplicate definition. Under sys/win an "ok" of your own compiles.
' The footer buttons ARE PsButtons. This control is the first in the family to be a genuine
' container of siblings, so this module imports another control (PsButton, above).

' Polling timer that guarantees the close button's hot-tracking is cleared when the mouse
' leaves. WM_MOUSELEAVE (TME_LEAVE) is not reliably delivered on fast exits. Timer IDs are
' per-window, so every instance can share this id.
public const IDT_CMESSAGEBOX_HOTTRACK = &hCB91
public const PSMESSAGEBOX_HOTTRACK_MS = 100

' The most buttons the footer will hold. Not an arbitrary cap: a message box that needs a
' fourth choice wants a real dialog, and the layout arithmetic below is written against a
' fixed-size array precisely so there is no index fix-up code to get wrong.
public const PSMESSAGEBOX_MAXBUTTONS = 3

' Control ids handed to the footer buttons. The HOST's return ids are set separately with
' PsButton_SetID, so these never enter anyone's command stream -- they exist only so
' GetDlgItem / GetNextDlgTabItem have something to report.
public const IDC_CMESSAGEBOX_BUTTON_BASE = 8100

' Default geometry, in unscaled pixels. Everything except the THICKNESS values is DPI-scaled
' once at Create; every setter afterwards takes raw pixels and the caller scales (family rule).
public const PSMESSAGEBOX_DEFAULT_CAPTIONHEIGHT = 34
public const PSMESSAGEBOX_DEFAULT_CAPTIONPADX = 14
public const PSMESSAGEBOX_DEFAULT_CLOSEWIDTH = 44
public const PSMESSAGEBOX_DEFAULT_BODYPADX = 20
public const PSMESSAGEBOX_DEFAULT_BODYPADY = 20
public const PSMESSAGEBOX_DEFAULT_FOOTERPADX = 20
public const PSMESSAGEBOX_DEFAULT_FOOTERPADY = 14
public const PSMESSAGEBOX_DEFAULT_ICONWIDTH = 32
public const PSMESSAGEBOX_DEFAULT_ICONHEIGHT = 32
public const PSMESSAGEBOX_DEFAULT_ICONGAP = 16
public const PSMESSAGEBOX_DEFAULT_BUTTONGAP = 8
public const PSMESSAGEBOX_DEFAULT_BUTTONMINWIDTH = 88
public const PSMESSAGEBOX_DEFAULT_MAXWIDTH = 420
public const PSMESSAGEBOX_DEFAULT_MINWIDTH = 300
public const PSMESSAGEBOX_DEFAULT_BORDERTHICK = 1   ' not DPI-scaled -- a hairline stays a hairline
public const PSMESSAGEBOX_DEFAULT_DIVIDERTHICK = 1   ' likewise

' The glyphs the icon kinds resolve to (Segoe Fluent Icons / Segoe MDL2 Assets codepoints), and
' the close button's. They are #defines rather than literals buried in the resolver so a host
' that ships a different icon font can see exactly what to remap.
public const PSMESSAGEBOX_GLYPH_INFO = &hE946   ' Info
public const PSMESSAGEBOX_GLYPH_WARNING = &hE7BA   ' Warning  (the triangle in the reference shot)
public const PSMESSAGEBOX_GLYPH_ERROR = &hEA39   ' ErrorBadge
public const PSMESSAGEBOX_GLYPH_QUESTION = &hE9CE   ' StatusCircleQuestionMark
public const PSMESSAGEBOX_GLYPH_CLOSE = &hE8BB   ' ChromeClose


' The icon on the left. Each kind resolves to a glyph AND to its own colour -- see
' PsMessageBox_ResolveGlyph / PsMessageBox_ResolveIconColor, which are PURE FUNCTIONS so the whole
' mapping can be asserted rather than only observed inside a paint.
'
' MBX_ICON_NONE is not "no artwork available", it is a real layout state: the icon cell and its
' gap are not charged at all, so the text starts at the body padding and the box is narrower.
public enum
    MBX_ICON_NONE = 0
    MBX_ICON_INFO
    MBX_ICON_WARNING
    MBX_ICON_ERROR
    MBX_ICON_QUESTION
end enum

' Ready-made button sets for PsMessageBox_AddPreset and PsMessageBox_Show. Every one of them is
' just a sequence of PsMessageBox_AddButton calls plus a SetDefaultButton and a SetCancelID --
' there is nothing a preset can express that a host cannot write out by hand, which is the point
' of having free-form AddButton underneath.
'
' The captions are ENGLISH LITERALS. A localised host uses AddButton directly; presets are a
' convenience, not a localisation layer.
public enum
    MBX_BTN_OK = 0                  ' [OK]                                default OK,   cancel OK
    MBX_BTN_OKCANCEL                ' [OK] [Cancel]                       default OK,   cancel Cancel
    MBX_BTN_YESNO                   ' [Yes] [No]                          default Yes,  cancel No
    MBX_BTN_YESNOCANCEL             ' [Yes] [No] [Cancel]                 default Yes,  cancel Cancel
    MBX_BTN_RETRYCANCEL             ' [Retry] [Cancel]                    default Retry,cancel Cancel
    MBX_BTN_SAVE_DONTSAVE_CANCEL    ' [Save] [Don't Save] [Cancel]        default Save, cancel Cancel
end enum

' Which rect PsMessageBox_CountRenderedTones looks at. See that function for why it exists.
public enum
    MBX_PART_CAPTION = 0
    MBX_PART_BODY
    MBX_PART_FOOTER
    MBX_PART_TEXT
    MBX_PART_ICON
    MBX_PART_CLOSE
end enum


' Colors for the built-in painter. Copied on Set.
'
' THE DEFAULTS ARE DARK, inherited from PSBUTTON_COLORS' palette rather than matched to the light
' reference screenshot. A box built with no colour calls therefore looks like the rest of this
' family, which is what a host of these controls actually wants; the demo shows a light set.
'
' THE CLOSE BUTTON IS NOT A PsButton (it would be a fourth tabstop), so it carries its own three
' colour pairs here. Its hot pair is the Windows close-red rather than the theme accent, because
' that colour is the one universally understood "this discards" signal.
'
' THERE IS NO DISABLED MOOD ANYWHERE IN THIS STRUCT. A message box is modal and everything on it
' is live by definition -- a disabled button on a box the user cannot leave would be a trap.
public type MBX_COLORS
    ' --- the window as a whole ---
    BorderColor           as COLORREF = BGR( 70, 76, 86)   ' 1px outline around the whole box
    ' --- caption band ---
    CaptionBackColor      as COLORREF = BGR( 44, 49, 58)
    CaptionForeColor      as COLORREF = BGR(200,205,214)
    CloseBackColor        as COLORREF = BGR( 44, 49, 58)   ' = CaptionBackColor: invisible until hot
    CloseForeColor        as COLORREF = BGR(200,205,214)
    CloseBackColorHot     as COLORREF = BGR(196, 43, 28)
    CloseForeColorHot     as COLORREF = BGR(255,255,255)
    CloseBackColorPressed as COLORREF = BGR(200, 70, 60)
    CloseForeColorPressed as COLORREF = BGR(255,255,255)
    ' --- body ---
    BackColor             as COLORREF = BGR( 33, 37, 43)
    ForeColor             as COLORREF = BGR(200,205,214)   ' the message text
    ' --- footer ---
    FooterBackColor       as COLORREF = BGR( 40, 44, 51)
    DividerColor          as COLORREF = BGR( 55, 60, 69)   ' hairline above the footer
    ' --- the four icon kinds. MBX_ICON_NONE has no colour because it has no glyph. ---
    IconColorInfo         as COLORREF = BGR( 97,175,239)
    IconColorWarning      as COLORREF = BGR(229,192,123)
    IconColorError        as COLORREF = BGR(224,108,117)
    IconColorQuestion     as COLORREF = BGR( 97,175,239)
end type


' Everything the painter needs. Every rect is precomputed by LayoutBox -- never re-derive one
' from another, and in particular never re-apply the body padding to rcBody to get rcText,
' because the icon cell and the icon gap can change underneath you.
'
' THE BUTTONS ARE NOT IN HERE. They are real child windows that paint themselves; a paint
' callback draws the box AROUND them and must not try to draw them.
public type MBX_PAINTINFO
    hMsgBox        as HWND              ' the box, so the callback can query it
    b              as PsPaintBuffer ptr  ' the box's buffer for this repaint (no copy)
    ' --- Geometry, all precomputed by LayoutBox ---
    rcClient       as RECT              ' the whole client area
    rcCaption      as RECT              ' the caption band, full width
    rcCaptionText  as RECT              ' the title's box: rcCaption minus padding and rcClose
    rcClose        as RECT              ' the X. EMPTY only if the caption band has no height
    rcBody         as RECT              ' between the caption and the footer, full width
    rcIcon         as RECT              ' the icon cell. EMPTY for MBX_ICON_NONE with no override
    ' THE WRAP BOX, NOT THE INK. rcText is what DrawTextW was measured against and what it will
    ' be drawn into, so its width is the wrap width. Its HEIGHT is the measured height of the
    ' wrapped text, which is not the same as the body's height.
    rcText         as RECT
    rcFooter       as RECT              ' the button band, full width
    ' --- State: the control decides these, you only render. ---
    isCloseHot     as boolean           ' the mouse is over the X
    isClosePressed as boolean           ' a live left press on the X AND the cursor is still on it
    isActive       as boolean           ' the box is the active window
    ' --- What to draw ---
    wszCaption     as ustring
    wszText        as ustring
    wszGlyph       as ustring          ' already resolved from the kind (or the host override)
    clrIcon        as COLORREF          ' likewise
end type

public type MBX_MESSAGEINFO
    hMsgBox    as HWND
    uMsg       as UINT
    wParam     as WPARAM
    lParam     as LPARAM
end type


' Draw the whole box, INSTEAD OF the built-in painter. Paint through p->b (the box's double
' buffer for this repaint) -- do not touch the screen DC.
'
' The control has already filled the client with BackColor before calling you, so a callback
' that only wants to add something on top does not have to repaint the background.
'
' TWO CONTRACTS WORTH HONOURING:
'   - Draw the message with the SAME font you handed to PsMessageBox_SetFont, and with
'     DT_WORDBREAK. The box's HEIGHT was measured with that font and that flag; a different
'     either means the height lies and the text clips.
'   - DO NOT reach for PaintBorderRect to draw the window outline or the footer divider. It
'     FILLS unconditionally, so used as an outline it erases everything beneath it -- a mistake
'     this family has now made three separate times (PsToggle, PsComboBox, PsNumericUpDown), every
'     time by copying a sibling's callback. PaintRoundOutline and PaintLine stroke without
'     filling. PsMessageBox_CountRenderedTones exists to let you assert you have not done it.
public type MBX_PaintCallbackSub as sub( byval p as MBX_PAINTINFO ptr )

' Observe messages. Return TRUE if you handled it and want the control's default handling
' suppressed, FALSE to let it proceed.
'
' CAUTION: the result is IGNORED for three messages.
'   WM_LBUTTONUP        - the box holds mouse capture across a press on the X, and the
'                         up-message is what releases it: a callback that suppressed it would
'                         strand capture (the PsListBox bug recorded in Learnings.md).
'   WM_CLOSE            - a modal box MUST be able to end. Suppressing the close would leave the
'                         nested message loop spinning with the parent disabled, which is an
'                         unrecoverable hang rather than a refused action. Veto the dismissal by
'                         not offering a cancel path, not by eating this.
'   WM_DESTROY          - likewise: by then the loop has already ended.
' For every other message TRUE suppresses the control's default handling.
public type MBX_MessageCallbackFunc as function( byval m as MBX_MESSAGEINFO ptr ) as boolean


public type PSMESSAGEBOX_STATE
    hWin            as HWND
    ' TRUE once the host set the colours itself (PsMessageBox_SetColors/SetButtonColors): the
    ' theme then leaves this box alone until PsMessageBox_UnpinColors.
    bColorsPinned   as boolean
    hParent         as HWND = 0        ' disabled for the duration of DoModal. 0 is legal.
    ' --- Content ---
    wszCaption      as ustring        ' the title. "" draws an empty band, it does not remove it
    wszText         as ustring        ' the message. Wrapped, left-justified
    wszGlyph        as ustring        ' set only by PsMessageBox_SetGlyph (host override)
    bGlyphOverride  as boolean = false
    clrIconOverride as COLORREF = 0
    bIconOverride   as boolean = false
    nIconKind       as long = MBX_ICON_NONE
    bBeep           as boolean = true  ' MessageBeep for the kind, before the box is shown
    ' --- Buttons. A FIXED array, not a dynamic one: the cap is 3 by contract, so there is no
    '     insert/delete/reorder and none of the stored-index fix-up code the collection siblings
    '     carry exists here (PsSelectBar's and PsIconPanel's static-by-contract rule). ---
    hButtons(0 to PSMESSAGEBOX_MAXBUTTONS - 1) as HWND
    nButtonCount    as long = 0
    nDefaultIndex   as long = -1       ' -1 = none. Paints the accent border AND claims Enter
    nFocusIndex     as long = -1       ' -1 = "the default, else the first"
    bFocusExplicit  as boolean = false ' has SetFocusButton been called? (see SetDefaultButton)
    nCancelID       as long = 0
    bCancelIDSet    as boolean = false ' unset => the LAST button's id
    ' --- Modal state ---
    nResult         as long = 0
    bRunning        as boolean = false ' the nested loop's condition. Cleared by any dismissal
    ' --- Close-button state. Single-valued: there is exactly one X. ---
    isCloseHot      as boolean = false
    isClosePressed  as boolean = false
    hotTimerOn      as boolean = false
    colors          as MBX_COLORS
    btnColors       as PSBUTTON_COLORS  ' pushed into every button as it is added
    ' Caller-supplied fonts (caller owns all three). NOT named hFont: FreeBASIC is
    ' case-insensitive, so a member called hFont would shadow the TYPE name HFONT inside every
    ' member procedure of this type. See C:\dev\Learnings.md.
    '
    ' hTextFont is the MEASURING font -- it drives the wrap and therefore the box's height.
    hTextFont       as HFONT
    hCaptionFont    as HFONT           ' unset falls back to hTextFont
    hGlyphFont      as HFONT           ' the MESSAGE ICON's font. Unset falls back to hTextFont
    ' The close X's font, SEPARATE from the icon's and not an oversight. The icon cell is ~32px
    ' and the X is a ~10px caption glyph; one font cannot serve both, and since this family
    ' never creates fonts (the caller owns them), the control cannot derive a smaller one
    ' itself. Unset falls back to hGlyphFont, which is the right answer only if the host has
    ' sized that font for the X rather than for the icon.
    hCloseFont      as HFONT
    ' --- Layout inputs. All pixels; DPI-scaled once at Create, raw thereafter. ---
    nCaptionHeight  as long = PSMESSAGEBOX_DEFAULT_CAPTIONHEIGHT
    nCaptionPadX    as long = PSMESSAGEBOX_DEFAULT_CAPTIONPADX
    nCloseWidth     as long = PSMESSAGEBOX_DEFAULT_CLOSEWIDTH
    nBodyPadX       as long = PSMESSAGEBOX_DEFAULT_BODYPADX
    nBodyPadY       as long = PSMESSAGEBOX_DEFAULT_BODYPADY
    nFooterPadX     as long = PSMESSAGEBOX_DEFAULT_FOOTERPADX
    nFooterPadY     as long = PSMESSAGEBOX_DEFAULT_FOOTERPADY
    ' NOTE: "width" is a FreeBASIC reserved word (see C:\dev\Learnings.md) and produces errors
    ' that never name the real problem -- hence nIconWidth, nBoxWidth and friends throughout.
    nIconWidth      as long = PSMESSAGEBOX_DEFAULT_ICONWIDTH
    nIconHeight     as long = PSMESSAGEBOX_DEFAULT_ICONHEIGHT
    nIconGap        as long = PSMESSAGEBOX_DEFAULT_ICONGAP
    nButtonGap      as long = PSMESSAGEBOX_DEFAULT_BUTTONGAP
    nButtonMinWidth as long = PSMESSAGEBOX_DEFAULT_BUTTONMINWIDTH
    nMaxWidth       as long = PSMESSAGEBOX_DEFAULT_MAXWIDTH
    nMinWidth       as long = PSMESSAGEBOX_DEFAULT_MINWIDTH
    nBorderThick    as long = PSMESSAGEBOX_DEFAULT_BORDERTHICK    ' NOT DPI-scaled
    nDividerThick   as long = PSMESSAGEBOX_DEFAULT_DIVIDERTHICK   ' NOT DPI-scaled
    ' --- Layout outputs. Rects are DERIVED, never set from outside; LayoutBox() owns them.
    '     Layout is lazy: mutators mark it dirty, the next paint (or any size query) runs it,
    '     which coalesces a burst of mutations into ONE measuring pass. ---
    nTextBlockW     as long = 0     ' derived: the width the wrapped text actually used
    nTextBlockH     as long = 0     ' derived: the height it needs at that width
    nButtonH        as long = 0     ' derived: the tallest button's ideal height
    nFooterH        as long = 0     ' derived
    nBodyH          as long = 0     ' derived
    nIdealW         as long = 0     ' derived: the whole box
    nIdealH         as long = 0     ' derived
    rcCaption       as RECT         ' derived
    rcCaptionText   as RECT         ' derived
    rcClose         as RECT         ' derived
    rcBody          as RECT         ' derived
    rcIcon          as RECT         ' derived
    rcText          as RECT         ' derived -- the WRAP BOX, see MBX_PAINTINFO
    rcFooter        as RECT         ' derived
    rcButtons(0 to PSMESSAGEBOX_MAXBUTTONS - 1) as RECT   ' derived; applied by PositionButtons
    bLayoutDirty    as boolean = true
    PaintCallback   as MBX_PaintCallbackSub      ' optional; replaces the built-in painter
    MessageCallback as MBX_MessageCallbackFunc   ' optional

    declare sub      LayoutBox()
    declare function HasIcon() as boolean
    declare function ResolveCancelID() as long
    declare function ResolveFocusIndex() as long
    declare sub      CancelClosePress()
    declare sub      Refresh()
end type


' Is there an icon cell at all? Tested as a named member rather than inline, because the
' measuring pass, the placement pass and the painter must all agree about it and three copies of
' the same test is three places to disagree.
'
' A HOST GLYPH OVERRIDE BEATS MBX_ICON_NONE. Setting a glyph is an unambiguous request for an
' icon, so it turns the cell on rather than being silently ignored because the kind is NONE.
function PSMESSAGEBOX_STATE.HasIcon() as boolean
    if this.bGlyphOverride andalso (len( this.wszGlyph ) > 0) then return true
    return (this.nIconKind <> MBX_ICON_NONE)
end function


' What Esc / the X / Alt+F4 return.
'
' UNSET DEFAULTS TO THE LAST BUTTON, which is Cancel in every preset and in the reference
' screenshot. That is a convention, not a law -- a host whose last button is destructive MUST
' call PsMessageBox_SetCancelID. With no buttons at all there is nothing to name, so 0.
function PSMESSAGEBOX_STATE.ResolveCancelID() as long
    if this.bCancelIDSet then return this.nCancelID
    if this.nButtonCount <= 0 then return 0
    return PsButton_GetID( this.hButtons( this.nButtonCount - 1 ) )
end function


' Which button gets the focus when the box opens.
'
' THE ORDER MATTERS AND IS THE DOCUMENTED CONTRACT: an explicit SetFocusButton wins, else the
' default button, else the first. That is what makes SetDefaultButton alone do the right thing
' for the common case (the reference screenshot, where Save is both) while still allowing
' "Cancel focused, Delete default".
function PSMESSAGEBOX_STATE.ResolveFocusIndex() as long
    if this.nButtonCount <= 0 then return -1
    if this.bFocusExplicit andalso (this.nFocusIndex >= 0) andalso _
       (this.nFocusIndex < this.nButtonCount) then return this.nFocusIndex
    if (this.nDefaultIndex >= 0) andalso (this.nDefaultIndex < this.nButtonCount) then
        return this.nDefaultIndex
    end if
    return 0
end function


' Forget any live press on the X WITHOUT touching the capture. Releasing capture is the
' WndProc's job, and only on the up-message or WM_DESTROY.
sub PSMESSAGEBOX_STATE.CancelClosePress()
    this.isClosePressed = false
end sub


' Mark the layout stale and request a repaint. Every mutator routes through here, which is what
' makes layout lazy: a burst of setters costs one measuring pass, not N.
sub PSMESSAGEBOX_STATE.Refresh()
    this.bLayoutDirty = true
    if this.hWin then InvalidateRect( this.hWin, NULL, TRUE )
end sub


' ========================================================================================
' Measure the message, then assign every rect. This is the only place box geometry is produced;
' painting, child placement, sizing and every public rect query consume it.
'
'   iconBlock    = hasIcon ? nIconWidth + nIconGap : 0
'   availW       = nMaxWidth - 2*nBodyPadX - iconBlock          the WRAP width
'   textW/textH  = DrawTextW( DT_CALCRECT or DT_WORDBREAK ) at availW
'   btnW(i)      = max( PsButton ideal width , nButtonMinWidth )
'   nButtonH     = the TALLEST button's ideal height
'   nFooterH     = nButtonCount ? 2*nFooterPadY + nButtonH : 0
'   nBodyH       = 2*nBodyPadY + max( textH , hasIcon ? nIconHeight : 0 )
'
'   nIdealW      = max( 2*nBodyPadX + iconBlock + textW ,
'                       2*nFooterPadX + sum(btnW) + (n-1)*nButtonGap ,
'                       nCaptionPadX + captionTextW + nCloseWidth ,
'                       nMinWidth )
'   nIdealH      = nCaptionHeight + nBodyH + nFooterH
'
' THE BOX SHRINKS TO FIT. nMaxWidth constrains the WRAP, and DT_CALCRECT reports the width the
' text actually used -- so "Delete this file?" gives a small box rather than one padded out to
' the maximum. That is what a real MessageBox does, and it costs nothing extra to do.
'
' nMaxWidth IS NOT A CAP ON THE WINDOW. Three long-captioned buttons legitimately make the box
' wider than the wrap width; the max() above is what lets that happen instead of clipping them.
'
' THE BUTTONS SHARE ONE HEIGHT (the tallest) BUT NOT ONE WIDTH. A row of buttons must sit on one
' baseline or it reads as broken, whereas Windows sizes each button to its own caption above a
' minimum -- which is exactly what the reference screenshot shows (Save / Don't Save / Cancel are
' three different widths).
'
' WHY THE MEASURING PASS RUNS BEFORE THE ZERO-CLIENT BAIL: nIdealW/nIdealH do not depend on the
' client area at all, and DoModal calls PsMessageBox_GetIdealSize to decide how big to MAKE the
' window in the first place. Returning 0 until it had already been sized would be a
' chicken-and-egg trap (PsButton and PsComboBox dodge it by this same ordering).
'
' OVERFLOW: when the client is smaller than ideal the rects are computed HONESTLY rather than
' squeezed (the family rule) -- rcText and rcCaptionText collapse, clamped to EMPTY rather than
' going negative, and the buttons keep their sizes and run off the left edge. Nothing here can
' make that happen (DoModal always sizes to ideal); it matters only for a host that resized the
' box itself.
' ========================================================================================
sub PSMESSAGEBOX_STATE.LayoutBox()
    this.bLayoutDirty = false
    if this.hWin = 0 then exit sub

    ' ---- the measuring pass ---------------------------------------------------------------
    dim as HDC hDC = GetDC( this.hWin )
    if hDC = 0 then
        this.bLayoutDirty = true          ' couldn't measure; try again next paint
        exit sub
    end if

    ' Measure with a deterministic font: the caller's if set, else the stock GUI font -- never
    ' "whatever the DC happens to hold". Stock objects must not be deleted.
    dim as HFONT hTextUse = this.hTextFont
    if hTextUse = 0 then hTextUse = cast( HFONT, GetStockObject( DEFAULT_GUI_FONT ) )
    dim as HFONT hOldFont = SelectObject( hDC, hTextUse )

    ' Resolved ONCE for the whole pass rather than re-tested at each of the sites below, so the
    ' box cannot be measured one way and placed another.
    dim as boolean bIcon = this.HasIcon()
    dim as long iconBlock = 0
    if bIcon then iconBlock = this.nIconWidth + this.nIconGap

    dim as long availW = this.nMaxWidth - (2 * this.nBodyPadX) - iconBlock
    ' A floor, not a correction: a host that sets an absurd nMaxWidth gets a narrow column of
    ' text rather than a DT_CALCRECT called with a negative width, whose behaviour is undefined.
    if availW < 40 then availW = 40

    this.nTextBlockW = 0
    this.nTextBlockH = 0
    if len( this.wszText ) then
        dim as RECT rcCalc
        SetRect( @rcCalc, 0, 0, availW, 0 )
        ' DT_CALCRECT with DT_WORDBREAK is the whole auto-height mechanism: it returns the
        ' height the wrapped text needs AND the width it actually used. DT_NOPREFIX matches
        ' PsBufferPaint.PaintText, which forces it -- without it here, a message containing "&"
        ' would measure one width and draw another.
        DrawTextW( hDC, this.wszText, len( this.wszText ), @rcCalc, _
                   DT_CALCRECT or DT_WORDBREAK or DT_LEFT or DT_NOPREFIX or DT_EXPANDTABS )
        this.nTextBlockW = rcCalc.right - rcCalc.left
        this.nTextBlockH = rcCalc.bottom - rcCalc.top
    end if

    ' The title only contributes a WIDTH FLOOR -- the caption band's height is declared, not
    ' measured, so a title too tall for it clips rather than growing the box.
    dim as long capTextW = 0
    if len( this.wszCaption ) then
        dim as HFONT hCapUse = this.hCaptionFont
        if hCapUse = 0 then hCapUse = hTextUse
        SelectObject( hDC, hCapUse )
        dim as SIZE sz
        if GetTextExtentPoint32W( hDC, this.wszCaption, _
                                  len( this.wszCaption ), @sz ) then capTextW = sz.cx
        SelectObject( hDC, hTextUse )
    end if

    SelectObject( hDC, hOldFont )
    ReleaseDC( this.hWin, hDC )

    ' ---- the buttons, measured through their own public API --------------------------------
    ' PsButton_GetIdealSize forces the button's own pending layout, so this is valid even for a
    ' button added moments ago and never sized -- which is always the case here.
    dim btnW(0 to PSMESSAGEBOX_MAXBUTTONS - 1) as long
    this.nButtonH = 0
    dim as long sumBtnW = 0
    for i as long = 0 to this.nButtonCount - 1
        dim as long bw, bh
        PsButton_GetIdealSize( this.hButtons(i), bw, bh )
        if bw < this.nButtonMinWidth then bw = this.nButtonMinWidth
        btnW(i) = bw
        sumBtnW += bw
        if bh > this.nButtonH then this.nButtonH = bh
    next

    this.nFooterH = 0
    dim as long footerW = 0
    if this.nButtonCount > 0 then
        this.nFooterH = (2 * this.nFooterPadY) + this.nButtonH
        footerW = (2 * this.nFooterPadX) + sumBtnW + _
                  ((this.nButtonCount - 1) * this.nButtonGap)
    end if

    ' ---- the ideal size, which does not depend on the client area --------------------------
    dim as long bodyContentH = this.nTextBlockH
    if bIcon then
        if this.nIconHeight > bodyContentH then bodyContentH = this.nIconHeight
    end if
    this.nBodyH = (2 * this.nBodyPadY) + bodyContentH

    dim as long contentW = (2 * this.nBodyPadX) + iconBlock + this.nTextBlockW
    dim as long captionW = this.nCaptionPadX + capTextW + this.nCloseWidth

    this.nIdealW = contentW
    if footerW  > this.nIdealW then this.nIdealW = footerW
    if captionW > this.nIdealW then this.nIdealW = captionW
    if this.nMinWidth > this.nIdealW then this.nIdealW = this.nMinWidth
    this.nIdealH = this.nCaptionHeight + this.nBodyH + this.nFooterH

    ' ---- placement, which does -------------------------------------------------------------
    dim as RECT rcClient
    GetClientRect( this.hWin, @rcClient )
    dim as long clientW = rcClient.right - rcClient.left
    dim as long clientH = rcClient.bottom - rcClient.top

    ' No geometry yet (created 0x0; DoModal sizes us from the ideal computed above). Placement
    ' is impossible, so leave the rects alone and ask to be run again -- but note this bail
    ' comes AFTER the ideal size. See the header.
    if (clientW <= 0) orelse (clientH <= 0) then
        this.bLayoutDirty = true
        exit sub
    end if

    ' --- caption band ---
    SetRect( @this.rcCaption, 0, 0, clientW, this.nCaptionHeight )
    dim as long closeLeft = clientW - this.nCloseWidth
    if closeLeft < 0 then closeLeft = 0
    SetRect( @this.rcClose, closeLeft, 0, clientW, this.nCaptionHeight )
    dim as long capRight = this.rcClose.left
    if capRight < this.nCaptionPadX then capRight = this.nCaptionPadX
    SetRect( @this.rcCaptionText, this.nCaptionPadX, 0, capRight, this.nCaptionHeight )

    ' --- footer band ---
    if this.nFooterH > 0 then
        SetRect( @this.rcFooter, 0, clientH - this.nFooterH, clientW, clientH )
    else
        SetRectEmpty( @this.rcFooter )
    end if

    ' --- body ---
    dim as long bodyBottom = clientH - this.nFooterH
    if bodyBottom < this.nCaptionHeight then bodyBottom = this.nCaptionHeight
    SetRect( @this.rcBody, 0, this.nCaptionHeight, clientW, bodyBottom )

    ' The icon and the text are each v-centred on the TALLER of the two, so a one-line message
    ' sits level with a 32px icon instead of clinging to its top edge, and a long message keeps
    ' the icon beside its first lines rather than floating at the top of a tall block.
    dim as long contentTop = this.rcBody.top + this.nBodyPadY

    if bIcon then
        dim as long iy = contentTop + ((bodyContentH - this.nIconHeight) \ 2)
        SetRect( @this.rcIcon, this.nBodyPadX, iy, _
                 this.nBodyPadX + this.nIconWidth, iy + this.nIconHeight )
    else
        SetRectEmpty( @this.rcIcon )
    end if

    if this.nTextBlockH > 0 then
        dim as long tLeft  = this.nBodyPadX + iconBlock
        dim as long tRight = clientW - this.nBodyPadX
        ' Degenerate rather than negative when the client is too narrow (see OVERFLOW above).
        if tRight < tLeft then tRight = tLeft
        dim as long ty = contentTop + ((bodyContentH - this.nTextBlockH) \ 2)
        SetRect( @this.rcText, tLeft, ty, tRight, ty + this.nTextBlockH )
    else
        SetRectEmpty( @this.rcText )
    end if

    ' --- the buttons, right-aligned, laid out from the right edge inwards ---
    for i as long = 0 to PSMESSAGEBOX_MAXBUTTONS - 1
        SetRectEmpty( @this.rcButtons(i) )
    next
    if this.nButtonCount > 0 then
        dim as long bx = clientW - this.nFooterPadX
        dim as long by = this.rcFooter.top + this.nFooterPadY
        for i as long = this.nButtonCount - 1 to 0 step -1
            SetRect( @this.rcButtons(i), bx - btnW(i), by, bx, by + this.nButtonH )
            bx = bx - btnW(i) - this.nButtonGap
        next
    end if
end sub


' ========================================================================================
' Which glyph does an icon kind draw?  A PURE FUNCTION on purpose: it takes no control pointer
' and touches no global, so the whole mapping can be asserted directly (PsButton_ResolveMood's
' precedent) rather than only being observable from inside a WM_PAINT.
'
' The HOST OVERRIDE is deliberately NOT folded in here -- that lives in the painter, so this
' function answers exactly one question and answers it the same way every time.
' ========================================================================================
function PsMessageBox_ResolveGlyph( byval nKind as long ) as ustring
    select case nKind
    case MBX_ICON_INFO     : return wchr( PSMESSAGEBOX_GLYPH_INFO )
    case MBX_ICON_WARNING  : return wchr( PSMESSAGEBOX_GLYPH_WARNING )
    case MBX_ICON_ERROR    : return wchr( PSMESSAGEBOX_GLYPH_ERROR )
    case MBX_ICON_QUESTION : return wchr( PSMESSAGEBOX_GLYPH_QUESTION )
    end select
    return ""
end function


' ========================================================================================
' And which colour?  Pure for the same reason. MBX_ICON_NONE answers with the body's own
' foreground rather than with an arbitrary sentinel: nothing will be drawn with it, and a
' sentinel would be a colour a careless painter could actually use.
' ========================================================================================
function PsMessageBox_ResolveIconColor( _
            byval nKind   as long, _
            byval pColors as MBX_COLORS ptr _
            ) as COLORREF

    if pColors = 0 then return 0
    select case nKind
    case MBX_ICON_INFO     : return pColors->IconColorInfo
    case MBX_ICON_WARNING  : return pColors->IconColorWarning
    case MBX_ICON_ERROR    : return pColors->IconColorError
    case MBX_ICON_QUESTION : return pColors->IconColorQuestion
    end select
    return pColors->ForeColor
end function


' ========================================================================================
' PUBLIC API
' ========================================================================================
'
' A MODAL MESSAGE BOX: an owner-drawn caption band with a title and a close X, a body holding an
' optional icon and a wrapped left-justified message, and a footer holding one to three PsButtons.
'
' IT BLOCKS
'   PsMessageBox_DoModal runs its own nested GetMessage loop and does not return until the box is
'   dismissed. That is the one big departure from every other control in this family, which are
'   passive and pumped by their host.
'
' THERE IS NO PUMP OBLIGATION
'   Precisely BECAUSE it owns its own loop, the box calls IsDialogMessage itself -- so Tab, the
'   focus ring and Space/Enter all work with nothing added to the host's pump. Unlike PsComboBox,
'   PsNumericUpDown and PsTextBox there is no PsMessageBox_FilterMessage.
'
' IT IS A CONTAINER, AND THAT IS WHY IT CARRIES WS_EX_CONTROLPARENT
'   The exact opposite of the PsButton fix. The tabstops here are the child buttons, so the dialog
'   manager MUST descend into this window. Do not "correct" this to 0; see the per-sibling table
'   in C:\dev\Learnings.md, and the self-test, which asserts the flag both ways.
'
' THE PARENT IS DISABLED FOR THE DURATION
'   EnableWindow(hParent, FALSE) at the top of DoModal, restored BEFORE the box is destroyed --
'   destroying an owned window while its owner is still disabled hands activation to another
'   application. hParent = 0 is legal: nothing is disabled and the box centres on the screen.
'
' NO TOOLTIPS
'   By request. There is no tooltip window, no MBX_TooltipCallback and no hover text anywhere.
'
' NO Ctrl+C
'   The real Win32 MessageBox copies its text to the clipboard on Ctrl+C. This one does not: the
'   message is drawn with DrawTextW and there is no text object to select from.
'
' LIFETIME
'   PsMessageBox_DoModal DESTROYS the box before returning, so the handle is dead afterwards. A
'   box created and then abandoned without DoModal must be destroyed by the host with
'   DestroyWindow. The three fonts you pass in stay yours.
'
' ----------------------------------------------------------------------------------------
' Creation and the modal loop.
'
'   Create makes a hidden, zero-sized WS_POPUP window. Configure it, then DoModal, which
'     measures, sizes, centres, shows, pumps, and returns the id of whatever dismissed it.
'   DoModal returns the clicked button's id, or -- for Esc / the X / Alt+F4 / a WM_CLOSE from
'     anywhere -- whatever PSMESSAGEBOX_STATE.ResolveCancelID() answers.
'   Show is Create + configure + DoModal in one call, for the common case.
' ----------------------------------------------------------------------------------------
public declare function PsMessageBox_Create( byval hWndParent as HWND ) as HWND
public declare function PsMessageBox_DoModal( byval hMsgBox as HWND ) as long
public declare function PsMessageBox_Show( byval hWndParent as HWND, _
                                   byval Text as ustring, _
                                   byval Caption as ustring, _
                                   byval nIconKind as long = MBX_ICON_NONE, _
                                   byval nPreset as long = MBX_BTN_OK ) as long

' ----------------------------------------------------------------------------------------
' Content.  All SILENT.
'
'   SetCaption is the title in the band. It is NOT the window text -- unlike PsButton, this
'     control does not alias WM_SETTEXT, because a message box is not something generic dialog
'     code walks looking for captions.
'   SetText is the message. Embedded CRLF is honoured as well as the automatic wrap.
'   SetIconKind picks one of the five kinds; SetGlyph and SetIconColor override the glyph and
'     the colour that kind resolved to. A glyph override TURNS THE ICON ON even when the kind is
'     MBX_ICON_NONE -- setting a glyph is an unambiguous request for one.
'   SetBeep(false) suppresses the MessageBeep that otherwise fires for the kind just before the
'     box is shown.
' ----------------------------------------------------------------------------------------
public declare function PsMessageBox_GetCaption( byval hMsgBox as HWND ) as ustring
public declare sub      PsMessageBox_SetCaption( byval hMsgBox as HWND, byval Text as ustring )
public declare function PsMessageBox_GetText( byval hMsgBox as HWND ) as ustring
public declare sub      PsMessageBox_SetText( byval hMsgBox as HWND, byval Text as ustring )
public declare function PsMessageBox_GetIconKind( byval hMsgBox as HWND ) as long
public declare sub      PsMessageBox_SetIconKind( byval hMsgBox as HWND, byval nKind as long )
public declare sub      PsMessageBox_SetGlyph( byval hMsgBox as HWND, byval Glyph as ustring )
public declare sub      PsMessageBox_SetIconColor( byval hMsgBox as HWND, byval clr as COLORREF )
public declare sub      PsMessageBox_SetBeep( byval hMsgBox as HWND, byval bBeep as boolean )

' ----------------------------------------------------------------------------------------
' Buttons.  One to three, laid out left to right in the order added and right-aligned in the
' footer. Tab order follows the order added.
'
'   AddButton returns the PsButton's HWND so a host can reach past this API for anything the
'     box does not expose (a glyph on one button, a different colour set for a destructive
'     choice). It returns 0 if the box already holds PSMESSAGEBOX_MAXBUTTONS.
'   The id is YOUR value and is what DoModal returns. It is never used as a command id.
'   AddPreset adds a whole set AND sets the default button and the cancel id to match. It is
'     additive, so calling it on a box that already has buttons is a host error.
'   SetDefaultButton paints the accent border, claims Enter box-wide, AND takes the initial
'     focus -- unless SetFocusButton is called AFTER it.
'   SetCancelID overrides what Esc / the X / Alt+F4 return. Unset, that is the LAST button's id.
' ----------------------------------------------------------------------------------------
public declare function PsMessageBox_AddButton( byval hMsgBox as HWND, byval Text as ustring, byval id as long ) as HWND
public declare sub      PsMessageBox_AddPreset( byval hMsgBox as HWND, byval nPreset as long )
public declare function PsMessageBox_GetButtonCount( byval hMsgBox as HWND ) as long
public declare function PsMessageBox_GetButtonHandle( byval hMsgBox as HWND, byval idx as long ) as HWND
public declare function PsMessageBox_GetDefaultButton( byval hMsgBox as HWND ) as long
public declare sub      PsMessageBox_SetDefaultButton( byval hMsgBox as HWND, byval idx as long )
public declare function PsMessageBox_GetFocusButton( byval hMsgBox as HWND ) as long
public declare sub      PsMessageBox_SetFocusButton( byval hMsgBox as HWND, byval idx as long )
public declare function PsMessageBox_GetCancelID( byval hMsgBox as HWND ) as long
public declare sub      PsMessageBox_SetCancelID( byval hMsgBox as HWND, byval id as long )

' ----------------------------------------------------------------------------------------
' Layout.  ALL setters take RAW PIXELS -- the caller DPI-scales (the family rule; only the
' Create-time defaults are scaled for you). The two THICKNESS values should not be scaled at
' all: a hairline stays a hairline.
'
'   SetMaxWidth is the WRAP width, not a hard cap on the window: if the footer's buttons need
'     more room than that, the box is wider. Text is what the maximum constrains.
'   SetMinWidth is a floor on the whole box.
'   GetIdealSize forces a pending layout and returns the measured size of the whole box. Like
'     PsButton's, it is valid BEFORE the window has ever been sized -- which here is load-bearing,
'     because DoModal sizes the window FROM it.
'   The rect queries force a pending layout, so results are always current. They return FALSE if
'     the box has no geometry yet. An absent part's rect is EMPTY and the query still returns
'     TRUE -- empty is the honest answer.
' ----------------------------------------------------------------------------------------
public declare sub      PsMessageBox_SetMaxWidth( byval hMsgBox as HWND, byval nMaxWidth as long )
public declare sub      PsMessageBox_SetMinWidth( byval hMsgBox as HWND, byval nMinWidth as long )
public declare sub      PsMessageBox_SetCaptionHeight( byval hMsgBox as HWND, byval nHeight as long )
public declare sub      PsMessageBox_SetBodyPadding( byval hMsgBox as HWND, byval nX as long, byval nY as long )
public declare sub      PsMessageBox_SetFooterPadding( byval hMsgBox as HWND, byval nX as long, byval nY as long )
public declare sub      PsMessageBox_SetIconSize( byval hMsgBox as HWND, byval nIconWidth as long, byval nIconHeight as long )
public declare sub      PsMessageBox_SetIconGap( byval hMsgBox as HWND, byval nGap as long )
public declare sub      PsMessageBox_SetButtonGap( byval hMsgBox as HWND, byval nGap as long )
public declare sub      PsMessageBox_SetButtonMinWidth( byval hMsgBox as HWND, byval nMinWidth as long )
public declare sub      PsMessageBox_SetBorderThickness( byval hMsgBox as HWND, byval nThickness as long )
public declare sub      PsMessageBox_GetIdealSize( byval hMsgBox as HWND, byref nBoxWidth as long, byref nBoxHeight as long )
public declare function PsMessageBox_GetCaptionRect( byval hMsgBox as HWND, byref rc as RECT ) as boolean
public declare function PsMessageBox_GetCloseRect( byval hMsgBox as HWND, byref rc as RECT ) as boolean
public declare function PsMessageBox_GetBodyRect( byval hMsgBox as HWND, byref rc as RECT ) as boolean
public declare function PsMessageBox_GetIconRect( byval hMsgBox as HWND, byref rc as RECT ) as boolean
public declare function PsMessageBox_GetTextRect( byval hMsgBox as HWND, byref rc as RECT ) as boolean
public declare function PsMessageBox_GetFooterRect( byval hMsgBox as HWND, byref rc as RECT ) as boolean
public declare function PsMessageBox_GetButtonRect( byval hMsgBox as HWND, byval idx as long, byref rc as RECT ) as boolean

' ----------------------------------------------------------------------------------------
' Appearance.  SetColors copies the whole struct. GetColors fills one out, so the
' read-modify-write "change one color" idiom is Get, assign, Set.
'
'   SetButtonColors is pushed into every button that exists NOW and into every button added
'     LATER, so the order of the two calls does not matter.
'
' ALL THREE fonts are BORROWED, never owned: keep them alive and destroy them yourself.
'   SetFont        - the MESSAGE font, and the MEASURING font. Changing it re-wraps, which
'                    changes the box's height. Also pushed into the buttons.
'   SetCaptionFont - the title's font. Unset falls back to the message font.
'   SetGlyphFont   - the MESSAGE ICON's font (normally Segoe Fluent Icons). Unset falls back to
'                    the message font, which draws the codepoints as missing-glyph boxes -- so
'                    in practice a host that wants an icon must set this.
'   SetCloseGlyphFont - the close X's font, SEPARATE because the icon cell is ~32px and the X is
'                    a ~10px caption glyph. Unset falls back to the icon font, which will draw a
'                    comically large X if that font was sized for the icon. Two handles, because
'                    this family never creates fonts and so cannot derive a smaller one itself.
' ----------------------------------------------------------------------------------------
public declare sub      PsMessageBox_GetColors( byval hMsgBox as HWND, byval pColors as MBX_COLORS ptr )
public declare sub      PsMessageBox_SetColors( byval hMsgBox as HWND, byval pColors as MBX_COLORS ptr )
public declare sub      PsMessageBox_SetButtonColors( byval hMsgBox as HWND, byval pColors as PSBUTTON_COLORS ptr )
public declare function PsMessageBox_ThemeColors( byref t as PSTHEME_COLORS ) as MBX_COLORS
public declare sub      PsMessageBox_ApplyTheme( byval hMsgBox as HWND, byref t as PSTHEME_COLORS )
public declare sub      PsMessageBox_UnpinColors( byval hMsgBox as HWND )
public declare sub      PsMessageBox_ApplyFonts( byval hMsgBox as HWND, byval hTextFont as HFONT, byval hGlyphFont as HFONT )
public declare sub      PsMessageBox_Rescale( byval hMsgBox as HWND, byval oldDpi as long, byval newDpi as long )
public declare function PsMessageBox_GetFont( byval hMsgBox as HWND ) as HFONT
public declare sub      PsMessageBox_SetFont( byval hMsgBox as HWND, byval hTextFont as HFONT )
public declare function PsMessageBox_GetCaptionFont( byval hMsgBox as HWND ) as HFONT
public declare sub      PsMessageBox_SetCaptionFont( byval hMsgBox as HWND, byval hCaptionFont as HFONT )
public declare function PsMessageBox_GetGlyphFont( byval hMsgBox as HWND ) as HFONT
public declare sub      PsMessageBox_SetGlyphFont( byval hMsgBox as HWND, byval hGlyphFont as HFONT )
public declare function PsMessageBox_GetCloseGlyphFont( byval hMsgBox as HWND ) as HFONT
public declare sub      PsMessageBox_SetCloseGlyphFont( byval hMsgBox as HWND, byval hCloseFont as HFONT )

' ----------------------------------------------------------------------------------------
' Callbacks.  See the type declarations above for each signature and contract.
'   PaintCallback   - draw the whole box INSTEAD OF the built-in painter. The child buttons
'                     still paint themselves.
'   MessageCallback - observe messages; TRUE suppresses the box's default handling (IGNORED for
'                     WM_LBUTTONUP, WM_CLOSE and WM_DESTROY).
' ----------------------------------------------------------------------------------------
public declare sub      PsMessageBox_SetPaintCallback( byval hMsgBox as HWND, byval usersub as MBX_PaintCallbackSub )
public declare sub      PsMessageBox_SetMessageCallback( byval hMsgBox as HWND, byval userfunc as MBX_MessageCallbackFunc )

' ----------------------------------------------------------------------------------------
' Plumbing.
'
'   CountRenderedTones - render the box OFFSCREEN with its current painter and return how many
'                 distinct colours land inside one of its rects (capped at 64). Nothing in the
'                 control calls it; it exists to make one specific defect measurable.
'
'                 THE DEFECT: PsBufferPaint.PaintBorderRect FILLS before it strokes, so a paint
'                 callback that reaches for it to draw the window outline or the footer divider
'                 floods everything beneath and the box renders as one solid block. That has
'                 shipped three times in this family (PsToggle, PsComboBox, PsNumericUpDown), every
'                 time from a copied callback, and it survives a glance because the flood colour
'                 is a real colour from the control. A wiped part is literally ONE tone, so
'                 "count > 1" is an unambiguous assertion where a screenshot is a judgement.
'
'                 A HOST THAT WRITES ITS OWN PaintCallback SHOULD ASSERT THIS. That is why it is
'                 public rather than private to the self-test (PsButton's precedent).
'
'                 The PAINTINFO is built by the same routine WM_PAINT uses, because a probe that
'                 hand-builds that struct and leaves one field zeroed silently skips the thing it
'                 is measuring -- that produced a near-miss false PASS the first time this was
'                 written for PsButton (Learnings.md). Returns 0 if the box has no geometry yet,
'                 so call it AFTER PsMessageBox_LayoutForTest.
'
'   LayoutForTest - size the box to its ideal size WITHOUT showing it or entering the modal
'                 loop, so geometry can be asserted and the tone probe can run. There is no
'                 other way in: every rect this control owns depends on the client area, and
'                 the client area is only established by DoModal.
'
'   RunSelfTest - geometry, icon-resolution, cancel/focus-resolution and tab-navigability
'                 assertions, gated on the PSMESSAGEBOX_SELFTEST env var. Call it from the host
'                 before the message loop. It never enters a modal loop.
' ----------------------------------------------------------------------------------------
public declare sub      PsMessageBox_LayoutForTest( byval hMsgBox as HWND )
public declare function PsMessageBox_CountRenderedTones( byval hMsgBox as HWND, byval nPart as long ) as long
public declare sub      PsMessageBox_RunSelfTest( byval hWndParent as HWND )

' Forward declarations. The button plumbing is referenced by AddButton, which is defined well
' above the modal machinery that owns it.
declare sub      PsMessageBox_OnButtonClick( byval hButton as HWND, byval id as long )
declare sub      PsMessageBox_PositionButtons( byval pBox as PSMESSAGEBOX_STATE ptr )
declare sub      PsMessageBox_Dismiss( byval pBox as PSMESSAGEBOX_STATE ptr, byval nResult as long )


function GetMessageBoxPointer( byval hMsgBox as HWND ) as PSMESSAGEBOX_STATE ptr
    dim pWindow as CWindow ptr = CWindowPtr(hMsgBox)
    if pWindow = 0 then return 0
    return cast( PSMESSAGEBOX_STATE ptr, pWindow->UserData(0) )
end function


' ========================================================================================
' Hand a message to the host's message callback. Returns TRUE if the host claims it.
'
' Callers decide whether to honor that answer -- three messages deliberately do not.
' WM_LBUTTONUP is one (the box holds capture across a press on the X and the up-message is what
' releases it); WM_CLOSE and WM_DESTROY are the other two, because a modal box that cannot be
' dismissed is a hang, not a refused action.
' ========================================================================================
private function PsMessageBox_CallMessage( _
            byval pBox   as PSMESSAGEBOX_STATE ptr, _
            byval hwnd   as HWND, _
            byval uMsg   as UINT, _
            byval wParam as WPARAM, _
            byval lParam as LPARAM _
            ) as boolean

    if pBox = 0 then return false
    if pBox->MessageCallback = 0 then return false

    dim as MBX_MESSAGEINFO m
    m.hMsgBox = hwnd
    m.uMsg    = uMsg
    m.wParam  = wParam
    m.lParam  = lParam
    return pBox->MessageCallback( @m )
end function


' ========================================================================================
' Resolve the icon actually drawn: the host's override if it set one, else whatever the kind
' maps to. Kept out of PsMessageBox_ResolveGlyph / PsMessageBox_ResolveIconColor so those stay
' pure and their mapping stays assertable on its own.
' ========================================================================================
private function PsMessageBox_EffectiveGlyph( byval pBox as PSMESSAGEBOX_STATE ptr ) as ustring
    if pBox = 0 then return ""
    if pBox->bGlyphOverride then
        dim as ustring wszOut = pBox->wszGlyph
        return wszOut
    end if
    return PsMessageBox_ResolveGlyph( pBox->nIconKind )
end function

private function PsMessageBox_EffectiveIconColor( byval pBox as PSMESSAGEBOX_STATE ptr ) as COLORREF
    if pBox = 0 then return 0
    if pBox->bIconOverride then return pBox->clrIconOverride
    return PsMessageBox_ResolveIconColor( pBox->nIconKind, @pBox->colors )
end function


' ========================================================================================
' Draw the box: caption band, close X, footer band and its divider, icon, message, border.
'
' Nothing in here touches a GDI object or a device context -- PsBufferPaint owns rendering and
' this control owns geometry and state, which is the family contract.
'
' THE BUTTONS ARE NOT DRAWN HERE. They are real child windows with their own WM_PAINT.
'
' PRESENCE IS TESTED ON THE RECTS, not on the strings. LayoutBox leaves an absent part's rect
' EMPTY, so IsRectEmpty is the single source of truth about what exists -- and a degenerate
' caption span (the box too narrow to leave any room beside the X) drops out of the same test
' rather than needing its own.
'
' THE BORDER IS DRAWN LAST, over everything, so a body or footer fill can never overpaint it.
' ========================================================================================
private sub PsMessageBox_RenderDefault( _
            byval pBox as PSMESSAGEBOX_STATE ptr, _
            byval b    as PsPaintBuffer ptr, _
            byval p    as MBX_PAINTINFO ptr _
            )

    if (pBox = 0) orelse (b = 0) orelse (p = 0) then exit sub

    ' The fonts. Paint with the SAME font the measuring pass used -- the caller's if set, else
    ' the stock GUI font. PsBufferPaint.SetFont IGNORES a null handle, so leaving it unset would
    ' silently paint in the DC's font while the wrap was measured in another, and the message
    ' would clip for no visible reason.
    dim as HFONT hTextUse = pBox->hTextFont
    if hTextUse = 0 then hTextUse = cast( HFONT, GetStockObject( DEFAULT_GUI_FONT ) )
    ' Both of these fall back to the MESSAGE font rather than to the stock font: a host that set
    ' one font and not the others almost certainly meant that one.
    dim as HFONT hCapUse = pBox->hCaptionFont
    if hCapUse = 0 then hCapUse = hTextUse
    dim as HFONT hGlyphUse = pBox->hGlyphFont
    if hGlyphUse = 0 then hGlyphUse = hTextUse
    ' The X gets its OWN font, falling back to the icon's. See PSMESSAGEBOX_STATE.hCloseFont for why
    ' one glyph font cannot serve a 32px icon and a 10px caption button.
    dim as HFONT hCloseUse = pBox->hCloseFont
    if hCloseUse = 0 then hCloseUse = hGlyphUse

    ' ---- the caption band ------------------------------------------------------------------
    if IsRectEmpty( @p->rcCaption ) = 0 then
        dim as RECT rcCap = p->rcCaption
        b->SetBackColor( pBox->colors.CaptionBackColor )
        b->PaintRect( @rcCap )
    end if

    ' ---- the close button ------------------------------------------------------------------
    ' Three moods and no disabled one: the X on a modal box is always live. Its idle background
    ' defaults EQUAL to the caption's, so it is invisible until the cursor reaches it -- the
    ' same borderless-by-default trick PsButton and PsComboBox use.
    dim as COLORREF clrCloseBk = pBox->colors.CloseBackColor
    dim as COLORREF clrCloseFg = pBox->colors.CloseForeColor
    if p->isClosePressed then
        clrCloseBk = pBox->colors.CloseBackColorPressed
        clrCloseFg = pBox->colors.CloseForeColorPressed
    elseif p->isCloseHot then
        clrCloseBk = pBox->colors.CloseBackColorHot
        clrCloseFg = pBox->colors.CloseForeColorHot
    end if

    if IsRectEmpty( @p->rcClose ) = 0 then
        dim as RECT rcX = p->rcClose
        b->SetBackColor( clrCloseBk )
        b->PaintRect( @rcX )
        b->SetFont( hCloseUse )
        b->SetColors( clrCloseFg, clrCloseBk )
        b->PaintText( wchr( PSMESSAGEBOX_GLYPH_CLOSE ), @rcX, DT_CENTER )
    end if

    ' ---- the title -------------------------------------------------------------------------
    ' DT_END_ELLIPSIS rather than a clip: rcCaptionText already stops short of the X, so a long
    ' title ellipsizes into its own span instead of sliding under the close button.
    if (IsRectEmpty( @p->rcCaptionText ) = 0) andalso (len( p->wszCaption ) > 0) then
        dim as RECT rcCT = p->rcCaptionText
        b->SetFont( hCapUse )
        b->SetColors( pBox->colors.CaptionForeColor, pBox->colors.CaptionBackColor )
        b->PaintText( p->wszCaption, @rcCT, DT_LEFT or DT_END_ELLIPSIS )
    end if

    ' ---- the footer band and its divider ---------------------------------------------------
    if IsRectEmpty( @p->rcFooter ) = 0 then
        dim as RECT rcF = p->rcFooter
        b->SetBackColor( pBox->colors.FooterBackColor )
        b->PaintRect( @rcF )

        ' A HAIRLINE, drawn with PaintLine. NOT PaintBorderRect -- that fills before it strokes
        ' and would erase the footer it was meant to sit on top of. Thickness is deliberately
        ' not DPI-scaled: a hairline stays a hairline.
        if pBox->nDividerThick > 0 then
            b->SetPenColor( pBox->colors.DividerColor )
            b->PaintLine( pBox->nDividerThick, rcF.left, rcF.top, rcF.right, rcF.top )
        end if
    end if

    ' ---- the icon --------------------------------------------------------------------------
    ' The cell is a LAYOUT rect, not a measurement of the glyph: the control never measures the
    ' icon font, so a glyph too large for the cell clips rather than resizing the box
    ' (PsIconPanel's declared-cell rule).
    if (IsRectEmpty( @p->rcIcon ) = 0) andalso (len( p->wszGlyph ) > 0) then
        dim as RECT rcI = p->rcIcon
        b->SetFont( hGlyphUse )
        b->SetColors( p->clrIcon, pBox->colors.BackColor )
        b->PaintText( p->wszGlyph, @rcI, DT_CENTER )
    end if

    ' ---- the message -----------------------------------------------------------------------
    ' PaintTextEx, NOT PaintText: PaintText forces DT_VCENTER or DT_SINGLELINE, which cannot
    ' coexist with DT_WORDBREAK -- it would draw one clipped line inside a tall box. The flags
    ' here MUST match the ones LayoutBox measured with, or the height lies.
    '
    ' DT_TOP, and no vertical centring: rcText's height IS the measured height of the wrapped
    ' text, and the rect itself was already v-centred against the icon by LayoutBox.
    if (IsRectEmpty( @p->rcText ) = 0) andalso (len( p->wszText ) > 0) then
        dim as RECT rcT = p->rcText
        b->SetFont( hTextUse )
        b->SetColors( pBox->colors.ForeColor, pBox->colors.BackColor )
        b->PaintTextEx( p->wszText, @rcT, DT_LEFT or DT_TOP or DT_WORDBREAK or DT_EXPANDTABS )
    end if

    ' ---- the border ------------------------------------------------------------------------
    ' Outline, never filled, and LAST so nothing can paint over it. PaintRoundOutline with a
    ' curvature of 0 is a plain rectangle; PsBufferPaint owns the deflate-by-half-pen correction,
    ' so the stroke lands inside the client rather than half off the edge.
    if pBox->nBorderThick > 0 then
        dim as RECT rcB = p->rcClient
        b->SetPenColor( pBox->colors.BorderColor )
        b->PaintRoundOutline( @rcB, 0, pBox->nBorderThick )
    end if
end sub


' ========================================================================================
' Fill a PAINTINFO from the box's current state and geometry. One place, so the WM_PAINT path
' and the offscreen tone probe cannot describe the box differently -- a probe that hand-built
' this struct and left one field zeroed silently skipped the thing it was measuring the first
' time this pattern was written for PsButton (Learnings.md).
' ========================================================================================
private sub PsMessageBox_FillPaintInfo( _
            byval pBox as PSMESSAGEBOX_STATE ptr, _
            byval hwnd as HWND, _
            byval b    as PsPaintBuffer ptr, _
            byval p    as MBX_PAINTINFO ptr _
            )

    if (pBox = 0) orelse (p = 0) then exit sub

    p->hMsgBox = hwnd
    p->b       = b
    GetClientRect( hwnd, @p->rcClient )
    p->rcCaption      = pBox->rcCaption
    p->rcCaptionText  = pBox->rcCaptionText
    p->rcClose        = pBox->rcClose
    p->rcBody         = pBox->rcBody
    p->rcIcon         = pBox->rcIcon
    p->rcText         = pBox->rcText
    p->rcFooter       = pBox->rcFooter
    p->isCloseHot     = pBox->isCloseHot
    p->isClosePressed = pBox->isClosePressed
    p->isActive       = (GetActiveWindow() = hwnd)
    p->wszCaption     = pBox->wszCaption
    p->wszText        = pBox->wszText
    p->wszGlyph       = PsMessageBox_EffectiveGlyph( pBox )
    p->clrIcon        = PsMessageBox_EffectiveIconColor( pBox )
end sub


' ========================================================================================
' Process WM_PAINT.
' ========================================================================================
private function PsMessageBox_OnPaint( byval hwnd as HWND ) as LRESULT
    dim as PSMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer(hwnd)
    if pBox = null then return 0

    ' Consume any pending layout before painting -- this is what makes layout lazy.
    if pBox->bLayoutDirty then pBox->LayoutBox()

    dim as PsPaintBuffer b
    b.BeginDoubleBuffer(hwnd)

    ' The body colour, not a fixed one, so a paint callback that draws only a foreground still
    ' sits on the right background. The caption and footer bands paint over it.
    b.SetBackColor( pBox->colors.BackColor )
    b.PaintClientRect()

    dim p as MBX_PAINTINFO
    PsMessageBox_FillPaintInfo( pBox, hwnd, @b, @p )

    if pBox->PaintCallback then
        pBox->PaintCallback( @p )
    else
        PsMessageBox_RenderDefault( pBox, @b, @p )
    end if

    b.EndDoubleBuffer()
    function = 0
end function


' ========================================================================================
' Clear the close button's hover state and stop the hover poll timer. Repaints only if the
' state actually changes, so this is cheap to call repeatedly.
' ========================================================================================
private sub PsMessageBox_ClearCloseHot( byval pBox as PSMESSAGEBOX_STATE ptr, byval hwnd as HWND )
    if pBox = 0 then exit sub
    if pBox->hotTimerOn then
        KillTimer( hwnd, IDT_CMESSAGEBOX_HOTTRACK )
        pBox->hotTimerOn = false
    end if
    if pBox->isCloseHot then
        pBox->isCloseHot = false
        InvalidateRect( hwnd, @pBox->rcClose, FALSE )
    end if
end sub


' ========================================================================================
' End the modal loop with a result.
'
' THE ONE DISMISSAL PATH. A button click, Esc, the X, Alt+F4 and a host's WM_CLOSE all come
' through here, so no route can end the loop without also setting a result -- which is exactly
' the bug that would show up as DoModal returning 0 for a real click.
'
' It does NOT destroy the window: DoModal owns that, and destroying here would free the state
' out from under the loop that is about to read nResult.
' ========================================================================================
sub PsMessageBox_Dismiss( byval pBox as PSMESSAGEBOX_STATE ptr, byval nResult as long )
    if pBox = 0 then exit sub
    pBox->nResult  = nResult
    pBox->bRunning = false
end sub


' ========================================================================================
' A footer button was clicked. The button reports its HOST id (set by AddButton), which is
' exactly what DoModal returns -- so the box never has to map one id space onto another.
'
' The owning box is found through GetParent rather than a stored back-pointer: the button IS a
' child window of the box, so the relationship is already recorded by the window manager and a
' second copy of it could only ever go stale.
' ========================================================================================
sub PsMessageBox_OnButtonClick( byval hButton as HWND, byval id as long )
    dim as HWND hBox = GetParent( hButton )
    if hBox = 0 then exit sub
    dim as PSMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer( hBox )
    if pBox = 0 then exit sub
    PsMessageBox_Dismiss( pBox, id )
end sub


' ========================================================================================
' Apply the computed button rects to the real child windows, and show them.
'
' SEPARATE FROM LayoutBox ON PURPOSE. LayoutBox runs from WM_PAINT, and moving child windows
' from inside a paint invites a recursive invalidation storm; this runs from WM_SIZE and from
' DoModal, where a SetWindowPos is exactly what is expected.
' ========================================================================================
sub PsMessageBox_PositionButtons( byval pBox as PSMESSAGEBOX_STATE ptr )
    if pBox = 0 then exit sub
    if pBox->bLayoutDirty then pBox->LayoutBox()
    if pBox->bLayoutDirty then exit sub          ' still no client area; nothing to place onto

    for i as long = 0 to pBox->nButtonCount - 1
        dim as RECT rc = pBox->rcButtons(i)
        if IsRectEmpty( @rc ) then continue for
        SetWindowPos( pBox->hButtons(i), 0, rc.left, rc.top, _
                      rc.right - rc.left, rc.bottom - rc.top, _
                      SWP_NOZORDER or SWP_NOACTIVATE )
        ShowWindow( pBox->hButtons(i), SW_SHOW )
    next
end sub


' ========================================================================================
' PsMessageBox Window procedure
'
' MOUSE CAPTURE IS TAKEN, but only for the close button. The family's test is "take capture only
' if something consumes the guaranteed WM_LBUTTONDOWN -> WM_LBUTTONUP pairing", and the X has
' exactly PsButton's press/cancel gesture: press it, slide off, release, nothing happens. So the
' full price is paid -- snapshot the press before releasing, a WM_CAPTURECHANGED handler that
' cancels it, a release in WM_DESTROY, and a callback result that is ignored for the up-message.
'
' The FOOTER buttons take their own capture; nothing here knows or cares.
'
' CS_DBLCLKS IS DELIBERATELY *NOT* SET. The only double-clickable thing on the box is the X, and
' a rapid second click there is a legitimate second click on a window that may already be gone.
'
' THE BOX ITSELF IS NOT FOCUSABLE. It has no WS_TABSTOP and never calls SetFocus on itself: the
' tabstops are the child buttons, which is why this window carries WS_EX_CONTROLPARENT.
' ========================================================================================
function PsMessageBox_WndProc( _
            byval hwnd   as HWND, _
            byval uMsg   as UINT, _
            byval wParam as WPARAM, _
            byval lParam as LPARAM _
            ) as LRESULT

    dim as PSMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer( hwnd )

    select case uMsg

    case WM_PAINT
        return PsMessageBox_OnPaint( hwnd )

    case WM_ERASEBKGND
        ' Never erase: WM_PAINT fills the whole client through the double buffer, so a
        ' background erase here would only add flicker.
        return true

    case WM_SIZE
        if pBox then
            ' Re-layout EAGERLY rather than waiting for the next paint, because the child
            ' buttons have to be moved and that cannot happen from inside WM_PAINT.
            pBox->bLayoutDirty = true
            pBox->LayoutBox()
            PsMessageBox_PositionButtons( pBox )
            InvalidateRect( hwnd, NULL, TRUE )
        end if
        return 0

    case WM_ACTIVATE
        ' Tracked only so a host painter can render an inactive caption; the built-in painter
        ' does not, deliberately -- a modal box is the only thing the user can interact with, so
        ' greying its title says nothing useful.
        if pBox then InvalidateRect( hwnd, @pBox->rcCaption, FALSE )

    case WM_NCHITTEST
        ' HTCAPTION over the caption band is the WHOLE drag implementation: DefWindowProc does
        ' the move for us. The close button must be excluded or the X becomes both undraggable
        ' and unclickable, which is the natural mistake here.
        if pBox = 0 then exit select
        dim as LRESULT ht = DefWindowProc( hwnd, uMsg, wParam, lParam )
        if ht <> HTCLIENT then return ht
        if pBox->bLayoutDirty then pBox->LayoutBox()

        dim as POINT pt
        pt.x = cast( short, loword(lParam) )        ' SCREEN coords for this message
        pt.y = cast( short, hiword(lParam) )
        ScreenToClient( hwnd, @pt )

        if PtInRect( @pBox->rcClose, pt ) then return HTCLIENT
        if PtInRect( @pBox->rcCaption, pt ) then return HTCAPTION
        return HTCLIENT

    case WM_TIMER
        if (pBox <> 0) andalso (wParam = IDT_CMESSAGEBOX_HOTTRACK) then
            ' The cursor may have left the X without us getting a WM_MOUSELEAVE. NOT while a
            ' press is live: during capture the cursor is legitimately allowed to wander off and
            ' come back, and WM_MOUSEMOVE is already maintaining isCloseHot for exactly that.
            if pBox->isClosePressed = false then
                if isMouseOverRECT( hwnd, pBox->rcClose ) = false then
                    PsMessageBox_ClearCloseHot( pBox, hwnd )
                end if
            end if
            return 0
        end if

    case WM_MOUSEMOVE
        if pBox = 0 then exit select
        if pBox->bLayoutDirty then pBox->LayoutBox()

        dim as boolean bOver = isMouseOverRECT( hwnd, pBox->rcClose )

        if bOver then
            dim tme as TrackMouseEvent
            tme.cbSize    = sizeof(TrackMouseEvent)
            tme.dwFlags   = TME_LEAVE
            tme.hwndTrack = hwnd
            TrackMouseEvent(@tme)

            ' Safety net: WM_MOUSELEAVE is not guaranteed to arrive when the mouse exits
            ' quickly, which would strand the X painted red.
            if pBox->hotTimerOn = false then
                SetTimer( hwnd, IDT_CMESSAGEBOX_HOTTRACK, PSMESSAGEBOX_HOTTRACK_MS, NULL )
                pBox->hotTimerOn = true
            end if
        end if

        ' This also drives the press-cancel FEEDBACK: with capture held, moves outside the X
        ' still reach us, so sliding off a pressed X un-flashes it before the release decides
        ' that nothing happened.
        if bOver <> pBox->isCloseHot then
            pBox->isCloseHot = bOver
            InvalidateRect( hwnd, @pBox->rcClose, FALSE )
        end if

        if PsMessageBox_CallMessage( pBox, hwnd, uMsg, wParam, lParam ) then return 0

    case WM_MOUSELEAVE
        if pBox then
            if pBox->isClosePressed = false then PsMessageBox_ClearCloseHot( pBox, hwnd )
            if PsMessageBox_CallMessage( pBox, hwnd, uMsg, wParam, lParam ) then return 0
        end if

    case WM_LBUTTONDOWN
        if pBox = 0 then return 0
        if pBox->bLayoutDirty then pBox->LayoutBox()

        ' Suppressing the press is allowed: no capture has been taken yet, so there is no
        ' bookkeeping to strand.
        if PsMessageBox_CallMessage( pBox, hwnd, uMsg, wParam, lParam ) then return 0

        if isMouseOverRECT( hwnd, pBox->rcClose ) then
            SetCapture( hwnd )
            pBox->isClosePressed = true
            pBox->isCloseHot     = true
            InvalidateRect( hwnd, @pBox->rcClose, FALSE )
        end if
        return 0

    case WM_LBUTTONUP
        if pBox = 0 then return 0

        ' SNAPSHOT BEFORE RELEASING. ReleaseCapture sends WM_CAPTURECHANGED to the window losing
        ' capture SYNCHRONOUSLY, and our handler for it cancels the press -- so reading
        ' isClosePressed after the release would always find FALSE and the X would never close.
        dim as boolean bWasPressed = pBox->isClosePressed
        ' Release capture unconditionally, before any callback runs. Nothing below gets the
        ' chance to leave it held.
        if GetCapture() = hwnd then ReleaseCapture()

        dim as boolean bInside = isMouseOverRECT( hwnd, pBox->rcClose )

        pBox->CancelClosePress()
        InvalidateRect( hwnd, @pBox->rcClose, FALSE )

        ' The result is deliberately IGNORED here (see MBX_MessageCallbackFunc).
        PsMessageBox_CallMessage( pBox, hwnd, uMsg, wParam, lParam )

        ' Only a matched press+release still on the X closes the box. Press, slide off, release
        ' = nothing happened, which is the whole reason for capture.
        if bWasPressed andalso bInside then
            PostMessage( hwnd, WM_CLOSE, 0, 0 )
        end if
        return 0

    case WM_CAPTURECHANGED
        ' Capture can be stolen at any time. The gesture is over; forget it and repaint.
        if pBox then
            pBox->CancelClosePress()
            InvalidateRect( hwnd, @pBox->rcClose, FALSE )
            return 0
        end if

    case WM_CLOSE
        ' Esc, the X, Alt+F4 and any host WM_CLOSE all land here, and all resolve to the same
        ' answer. The callback's result is IGNORED (see MBX_MessageCallbackFunc): a modal box
        ' that cannot be dismissed leaves the nested loop spinning with the parent disabled,
        ' which is an unrecoverable hang rather than a refused action. A host that does not want
        ' the box dismissable this way should not offer a cancel path.
        if pBox then
            PsMessageBox_CallMessage( pBox, hwnd, uMsg, wParam, lParam )
            PsMessageBox_Dismiss( pBox, pBox->ResolveCancelID() )
        end if
        return 0

    case WM_DESTROY
        PsRegistry_Remove( hwnd )
        if pBox then
            PsMessageBox_CallMessage( pBox, hwnd, uMsg, wParam, lParam )
            ' Don't let the hot-tracking timer outlive the window...
            if pBox->hotTimerOn then
                KillTimer( hwnd, IDT_CMESSAGEBOX_HOTTRACK )
                pBox->hotTimerOn = false
            end if
            ' ...nor the capture, if we are being destroyed mid-press.
            if GetCapture() = hwnd then ReleaseCapture()
            pBox->CancelClosePress()
            ' Stop the loop no matter how the window died -- a parent being destroyed takes its
            ' owned windows with it, and the nested pump must not outlive its own window.
            pBox->bRunning = false
        end if

    case WM_NCDESTROY
        ' Delete the stored box data. The child buttons are ordinary child windows and are
        ' destroyed by the system; each one frees its own state in its own WM_NCDESTROY. The
        ' three fonts are the host's and are left alone.
        if pBox then delete(pBox)

        ' delete the allocated memory for window
        dim as CWindow ptr pWindow = CWindowPtr(hwnd)
        if pWindow then delete(pWindow)
        return 0

    end select

    ' for messages that we don't deal with
    function = DefWindowProc( hwnd, uMsg, wParam, lParam )

end function


' ========================================================================================
' PsMessageBox_Create
' ========================================================================================
public function PsMessageBox_Create( byval hWndParent as HWND ) as HWND

    dim pWindow as CWindow ptr = New CWindow

    ' WS_POPUP with NO system caption: the caption band, its title and its X are all drawn by
    ' this control, which is the only way the host's colours and font reach them.
    '
    ' THE EXTENDED STYLE IS PASSED EXPLICITLY, AND WS_EX_CONTROLPARENT IS CORRECT HERE -- the
    ' exact OPPOSITE of the PsButton fix. CWindow.Create defaults dwExStyle to
    ' WS_EX_CONTROLPARENT OR WS_EX_WINDOWEDGE; a LEAF control that inherits that silently
    ' declares itself a container and becomes unreachable by Tab. This window genuinely IS a
    ' container -- its tabstops are the child buttons -- so the dialog manager MUST descend into
    ' it. WS_EX_WINDOWEDGE is dropped: it is a raised-border hint that means nothing to a window
    ' drawing its own chrome.
    '
    ' The test is "does this window have children the dialog manager should find?", not "is this
    ' a control?". See the per-sibling table in C:\dev\Learnings.md, and the self-test, which
    ' asserts this window HAS the flag and its buttons do NOT.
    dim as HWND hCtrl = _
            pWindow->Create( hWndParent, "", @PsMessageBox_WndProc, _
            0, 0, 0, 0, _
            WS_POPUP or WS_CLIPSIBLINGS or WS_CLIPCHILDREN, _
            WS_EX_CONTROLPARENT _
            )

    ' Replace the class style like every sibling does (dropping CS_HREDRAW/CS_VREDRAW, which
    ' only add flicker) and add the system drop shadow -- a WS_POPUP with no system caption gets
    ' no DWM shadow of its own, and without one the box reads as painted onto the parent rather
    ' than floating above it. CWindow registers a UNIQUE class per instance, so this cannot leak
    ' to other windows; the setter REPLACES and needs m_hwnd, so it must run after Create and
    ' before the first show. The shadow honors the system setting and degrades silently.
    '
    ' NOTE: CS_DBLCLKS is deliberately NOT included -- see the WndProc header.
    pWindow->ClassStyle = CS_DROPSHADOW

    dim as PSMESSAGEBOX_STATE ptr pBox = new PSMESSAGEBOX_STATE
    pBox->hWin    = hCtrl
    pBox->hParent = hWndParent

    ' Only the Create-time defaults are DPI-scaled for us; every setter afterwards takes raw
    ' pixels and the caller scales (the family rule). The two THICKNESS values are not scaled at
    ' all, here or anywhere -- a hairline stays a hairline.
    pBox->nCaptionHeight  = pWindow->ScaleY( PSMESSAGEBOX_DEFAULT_CAPTIONHEIGHT )
    pBox->nCaptionPadX    = pWindow->ScaleX( PSMESSAGEBOX_DEFAULT_CAPTIONPADX )
    pBox->nCloseWidth     = pWindow->ScaleX( PSMESSAGEBOX_DEFAULT_CLOSEWIDTH )
    pBox->nBodyPadX       = pWindow->ScaleX( PSMESSAGEBOX_DEFAULT_BODYPADX )
    pBox->nBodyPadY       = pWindow->ScaleY( PSMESSAGEBOX_DEFAULT_BODYPADY )
    pBox->nFooterPadX     = pWindow->ScaleX( PSMESSAGEBOX_DEFAULT_FOOTERPADX )
    pBox->nFooterPadY     = pWindow->ScaleY( PSMESSAGEBOX_DEFAULT_FOOTERPADY )
    pBox->nIconWidth      = pWindow->ScaleX( PSMESSAGEBOX_DEFAULT_ICONWIDTH )
    pBox->nIconHeight     = pWindow->ScaleY( PSMESSAGEBOX_DEFAULT_ICONHEIGHT )
    pBox->nIconGap        = pWindow->ScaleX( PSMESSAGEBOX_DEFAULT_ICONGAP )
    pBox->nButtonGap      = pWindow->ScaleX( PSMESSAGEBOX_DEFAULT_BUTTONGAP )
    pBox->nButtonMinWidth = pWindow->ScaleX( PSMESSAGEBOX_DEFAULT_BUTTONMINWIDTH )
    pBox->nMaxWidth       = pWindow->ScaleX( PSMESSAGEBOX_DEFAULT_MAXWIDTH )
    pBox->nMinWidth       = pWindow->ScaleX( PSMESSAGEBOX_DEFAULT_MINWIDTH )

    ' Store the new pointer into the user data area of the control window
    pWindow->UserData(0) = cast(LONG_PTR, pBox)

    ' The theme and the form's fonts, applied now if a PsApp program has them (PsRegistry).
    PsRegistry_SetThemeProcs( hCtrl, @PsMessageBox_ApplyTheme, @PsMessageBox_ApplyFonts, @PsMessageBox_Rescale )

    function = hCtrl

end function


' ========================================================================================
' Content.  All SILENT -- they change what is drawn, never what was answered.
' ========================================================================================
function PsMessageBox_GetCaption( byval hMsgBox as HWND ) as ustring
    dim as PSMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer(hMsgBox)
    if pBox = 0 then return ""
    dim as ustring wszOut = pBox->wszCaption
    return wszOut
end function

public sub PsMessageBox_SetCaption( byval hMsgBox as HWND, byval Text as ustring )
    dim as PSMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer(hMsgBox)
    if pBox = 0 then exit sub
    pBox->wszCaption = Text
    pBox->Refresh()
end sub

function PsMessageBox_GetText( byval hMsgBox as HWND ) as ustring
    dim as PSMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer(hMsgBox)
    if pBox = 0 then return ""
    dim as ustring wszOut = pBox->wszText
    return wszOut
end function

public sub PsMessageBox_SetText( byval hMsgBox as HWND, byval Text as ustring )
    dim as PSMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer(hMsgBox)
    if pBox = 0 then exit sub
    pBox->wszText = Text
    pBox->Refresh()
end sub

function PsMessageBox_GetIconKind( byval hMsgBox as HWND ) as long
    dim as PSMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer(hMsgBox)
    if pBox = 0 then return MBX_ICON_NONE
    return pBox->nIconKind
end function

public sub PsMessageBox_SetIconKind( byval hMsgBox as HWND, byval nKind as long )
    dim as PSMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer(hMsgBox)
    if pBox = 0 then exit sub
    if (nKind < MBX_ICON_NONE) orelse (nKind > MBX_ICON_QUESTION) then exit sub
    pBox->nIconKind = nKind
    pBox->Refresh()
end sub

' A glyph override TURNS THE ICON ON even when the kind is MBX_ICON_NONE (see
' PSMESSAGEBOX_STATE.HasIcon): setting a glyph is an unambiguous request for one. Passing "" clears the
' override and hands the decision back to the kind.
sub PsMessageBox_SetGlyph( byval hMsgBox as HWND, byval Glyph as ustring )
    dim as PSMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer(hMsgBox)
    if pBox = 0 then exit sub
    pBox->wszGlyph       = Glyph
    pBox->bGlyphOverride = (len( Glyph ) > 0)
    pBox->Refresh()
end sub

sub PsMessageBox_SetIconColor( byval hMsgBox as HWND, byval clr as COLORREF )
    dim as PSMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer(hMsgBox)
    if pBox = 0 then exit sub
    pBox->clrIconOverride = clr
    pBox->bIconOverride   = true
    ' Colour only: nothing here changes a measurement, so this repaints without re-laying-out.
    if pBox->hWin then InvalidateRect( pBox->hWin, NULL, FALSE )
end sub

public sub PsMessageBox_SetBeep( byval hMsgBox as HWND, byval bBeep as boolean )
    dim as PSMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer(hMsgBox)
    if pBox = 0 then exit sub
    pBox->bBeep = bBeep
end sub


' ========================================================================================
' Buttons.
' ========================================================================================
public function PsMessageBox_AddButton( byval hMsgBox as HWND, byval Text as ustring, byval id as long ) as HWND
    dim as PSMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer(hMsgBox)
    if pBox = 0 then return 0
    if pBox->nButtonCount >= PSMESSAGEBOX_MAXBUTTONS then return 0

    dim as long idx = pBox->nButtonCount

    ' The control id is positional and internal; the HOST's id goes on separately and is what
    ' DoModal returns. Keeping them apart is what stops a host id of 0 or 1 colliding with
    ' anything the dialog manager cares about.
    dim as HWND hBtn = PsButton_Create( hMsgBox, IDC_CMESSAGEBOX_BUTTON_BASE + idx )
    if hBtn = 0 then return 0

    PsButton_SetText( hBtn, Text )
    PsButton_SetID( hBtn, id )
    PsButton_SetClickCallback( hBtn, @PsMessageBox_OnButtonClick )
    ' Push the box's current appearance into the new button, so Add-then-SetFont and
    ' SetFont-then-Add produce the same result (SetFont/SetButtonColors re-apply to all).
    PsButton_SetColors( hBtn, @pBox->btnColors )
    if pBox->hTextFont  then PsButton_SetFont( hBtn, pBox->hTextFont )
    if pBox->hGlyphFont then PsButton_SetGlyphFont( hBtn, pBox->hGlyphFont )

    pBox->hButtons(idx) = hBtn
    pBox->nButtonCount += 1
    pBox->Refresh()
    return hBtn
end function


' Add a whole set AND set the default button and the cancel id to match. Additive: calling it on
' a box that already has buttons is a host error, not something this polices.
public sub PsMessageBox_AddPreset( byval hMsgBox as HWND, byval nPreset as long )
    dim as PSMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer(hMsgBox)
    if pBox = 0 then exit sub

    select case nPreset
    case MBX_BTN_OKCANCEL
        PsMessageBox_AddButton( hMsgBox, "OK", IDOK )
        PsMessageBox_AddButton( hMsgBox, "Cancel", IDCANCEL )
        PsMessageBox_SetDefaultButton( hMsgBox, 0 )
        PsMessageBox_SetCancelID( hMsgBox, IDCANCEL )

    case MBX_BTN_YESNO
        PsMessageBox_AddButton( hMsgBox, "Yes", IDYES )
        PsMessageBox_AddButton( hMsgBox, "No", IDNO )
        PsMessageBox_SetDefaultButton( hMsgBox, 0 )
        ' No Cancel button, so Esc / the X answer NO -- the safe half of a yes/no question.
        PsMessageBox_SetCancelID( hMsgBox, IDNO )

    case MBX_BTN_YESNOCANCEL
        PsMessageBox_AddButton( hMsgBox, "Yes", IDYES )
        PsMessageBox_AddButton( hMsgBox, "No", IDNO )
        PsMessageBox_AddButton( hMsgBox, "Cancel", IDCANCEL )
        PsMessageBox_SetDefaultButton( hMsgBox, 0 )
        PsMessageBox_SetCancelID( hMsgBox, IDCANCEL )

    case MBX_BTN_RETRYCANCEL
        PsMessageBox_AddButton( hMsgBox, "Retry", IDRETRY )
        PsMessageBox_AddButton( hMsgBox, "Cancel", IDCANCEL )
        PsMessageBox_SetDefaultButton( hMsgBox, 0 )
        PsMessageBox_SetCancelID( hMsgBox, IDCANCEL )

    case MBX_BTN_SAVE_DONTSAVE_CANCEL
        ' The reference screenshot. Note the ids: there is no IDSAVE in Win32, so a save
        ' question is a yes/no/cancel question wearing better captions.
        PsMessageBox_AddButton( hMsgBox, "Save", IDYES )
        PsMessageBox_AddButton( hMsgBox, "Don't Save", IDNO )
        PsMessageBox_AddButton( hMsgBox, "Cancel", IDCANCEL )
        PsMessageBox_SetDefaultButton( hMsgBox, 0 )
        PsMessageBox_SetCancelID( hMsgBox, IDCANCEL )

    case else       ' MBX_BTN_OK
        PsMessageBox_AddButton( hMsgBox, "OK", IDOK )
        PsMessageBox_SetDefaultButton( hMsgBox, 0 )
        ' The only button IS the cancel path: with nothing else to answer, Esc must not be a
        ' silent no-op.
        PsMessageBox_SetCancelID( hMsgBox, IDOK )
    end select
end sub

function PsMessageBox_GetButtonCount( byval hMsgBox as HWND ) as long
    dim as PSMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer(hMsgBox)
    if pBox = 0 then return 0
    return pBox->nButtonCount
end function

function PsMessageBox_GetButtonHandle( byval hMsgBox as HWND, byval idx as long ) as HWND
    dim as PSMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer(hMsgBox)
    if pBox = 0 then return 0
    if (idx < 0) orelse (idx >= pBox->nButtonCount) then return 0
    return pBox->hButtons(idx)
end function

function PsMessageBox_GetDefaultButton( byval hMsgBox as HWND ) as long
    dim as PSMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer(hMsgBox)
    if pBox = 0 then return -1
    return pBox->nDefaultIndex
end function

' Paints the accent border, claims Enter box-wide, AND takes the initial focus -- unless
' SetFocusButton is called AFTER this. See PSMESSAGEBOX_STATE.ResolveFocusIndex for the precedence.
'
' Clearing the old default matters: PsButton_SetDefault is appearance only and does not police
' uniqueness, so without this a host that changed its mind would end up with two accent borders.
public sub PsMessageBox_SetDefaultButton( byval hMsgBox as HWND, byval idx as long )
    dim as PSMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer(hMsgBox)
    if pBox = 0 then exit sub
    if (idx < -1) orelse (idx >= pBox->nButtonCount) then exit sub

    for i as long = 0 to pBox->nButtonCount - 1
        PsButton_SetDefault( pBox->hButtons(i), (i = idx) )
    next
    pBox->nDefaultIndex = idx
end sub

function PsMessageBox_GetFocusButton( byval hMsgBox as HWND ) as long
    dim as PSMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer(hMsgBox)
    if pBox = 0 then return -1
    return pBox->ResolveFocusIndex()
end function

public sub PsMessageBox_SetFocusButton( byval hMsgBox as HWND, byval idx as long )
    dim as PSMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer(hMsgBox)
    if pBox = 0 then exit sub
    if (idx < 0) orelse (idx >= pBox->nButtonCount) then exit sub
    pBox->nFocusIndex    = idx
    pBox->bFocusExplicit = true
end sub

function PsMessageBox_GetCancelID( byval hMsgBox as HWND ) as long
    dim as PSMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer(hMsgBox)
    if pBox = 0 then return 0
    return pBox->ResolveCancelID()
end function

sub PsMessageBox_SetCancelID( byval hMsgBox as HWND, byval id as long )
    dim as PSMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer(hMsgBox)
    if pBox = 0 then exit sub
    pBox->nCancelID    = id
    pBox->bCancelIDSet = true
end sub


' ========================================================================================
' Layout.  ALL setters take RAW PIXELS -- the caller DPI-scales.
' ========================================================================================
sub PsMessageBox_SetMaxWidth( byval hMsgBox as HWND, byval nMaxWidth as long )
    dim as PSMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer(hMsgBox)
    if pBox = 0 then exit sub
    if nMaxWidth < 1 then exit sub
    pBox->nMaxWidth = nMaxWidth
    pBox->Refresh()
end sub

sub PsMessageBox_SetMinWidth( byval hMsgBox as HWND, byval nMinWidth as long )
    dim as PSMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer(hMsgBox)
    if pBox = 0 then exit sub
    if nMinWidth < 0 then exit sub
    pBox->nMinWidth = nMinWidth
    pBox->Refresh()
end sub

sub PsMessageBox_SetCaptionHeight( byval hMsgBox as HWND, byval nHeight as long )
    dim as PSMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer(hMsgBox)
    if pBox = 0 then exit sub
    if nHeight < 0 then exit sub
    pBox->nCaptionHeight = nHeight
    pBox->Refresh()
end sub

sub PsMessageBox_SetBodyPadding( byval hMsgBox as HWND, byval nX as long, byval nY as long )
    dim as PSMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer(hMsgBox)
    if pBox = 0 then exit sub
    if (nX < 0) orelse (nY < 0) then exit sub
    pBox->nBodyPadX = nX
    pBox->nBodyPadY = nY
    pBox->Refresh()
end sub

sub PsMessageBox_SetFooterPadding( byval hMsgBox as HWND, byval nX as long, byval nY as long )
    dim as PSMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer(hMsgBox)
    if pBox = 0 then exit sub
    if (nX < 0) orelse (nY < 0) then exit sub
    pBox->nFooterPadX = nX
    pBox->nFooterPadY = nY
    pBox->Refresh()
end sub

sub PsMessageBox_SetIconSize( byval hMsgBox as HWND, byval nIconWidth as long, byval nIconHeight as long )
    dim as PSMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer(hMsgBox)
    if pBox = 0 then exit sub
    if (nIconWidth < 0) orelse (nIconHeight < 0) then exit sub
    pBox->nIconWidth  = nIconWidth
    pBox->nIconHeight = nIconHeight
    pBox->Refresh()
end sub

sub PsMessageBox_SetIconGap( byval hMsgBox as HWND, byval nGap as long )
    dim as PSMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer(hMsgBox)
    if pBox = 0 then exit sub
    if nGap < 0 then exit sub
    pBox->nIconGap = nGap
    pBox->Refresh()
end sub

sub PsMessageBox_SetButtonGap( byval hMsgBox as HWND, byval nGap as long )
    dim as PSMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer(hMsgBox)
    if pBox = 0 then exit sub
    if nGap < 0 then exit sub
    pBox->nButtonGap = nGap
    pBox->Refresh()
end sub

sub PsMessageBox_SetButtonMinWidth( byval hMsgBox as HWND, byval nMinWidth as long )
    dim as PSMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer(hMsgBox)
    if pBox = 0 then exit sub
    if nMinWidth < 0 then exit sub
    pBox->nButtonMinWidth = nMinWidth
    pBox->Refresh()
end sub

sub PsMessageBox_SetBorderThickness( byval hMsgBox as HWND, byval nThickness as long )
    dim as PSMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer(hMsgBox)
    if pBox = 0 then exit sub
    if nThickness < 0 then exit sub
    pBox->nBorderThick = nThickness
    ' The border is drawn INSIDE the client and takes no space from the layout, so this is a
    ' repaint rather than a re-measure.
    if pBox->hWin then InvalidateRect( pBox->hWin, NULL, FALSE )
end sub

sub PsMessageBox_GetIdealSize( byval hMsgBox as HWND, byref nBoxWidth as long, byref nBoxHeight as long )
    nBoxWidth  = 0
    nBoxHeight = 0
    dim as PSMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer(hMsgBox)
    if pBox = 0 then exit sub
    if pBox->bLayoutDirty then pBox->LayoutBox()
    nBoxWidth  = pBox->nIdealW
    nBoxHeight = pBox->nIdealH
end sub


' The rect queries. Each forces a pending layout, so results are always current. FALSE means the
' box has no geometry yet (created but never sized); an absent part answers TRUE with an EMPTY
' rect, because empty is the honest answer.
private function PsMessageBox_QueryRect( _
            byval hMsgBox as HWND, _
            byval nPart   as long, _
            byref rc      as RECT _
            ) as boolean

    SetRectEmpty( @rc )
    dim as PSMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer(hMsgBox)
    if pBox = 0 then return false
    if pBox->bLayoutDirty then pBox->LayoutBox()
    if pBox->bLayoutDirty then return false      ' no client area yet

    select case nPart
    case MBX_PART_CAPTION : rc = pBox->rcCaption
    case MBX_PART_CLOSE   : rc = pBox->rcClose
    case MBX_PART_BODY    : rc = pBox->rcBody
    case MBX_PART_ICON    : rc = pBox->rcIcon
    case MBX_PART_TEXT    : rc = pBox->rcText
    case MBX_PART_FOOTER  : rc = pBox->rcFooter
    end select
    return true
end function

public function PsMessageBox_GetCaptionRect( byval hMsgBox as HWND, byref rc as RECT ) as boolean
    return PsMessageBox_QueryRect( hMsgBox, MBX_PART_CAPTION, rc )
end function

function PsMessageBox_GetCloseRect( byval hMsgBox as HWND, byref rc as RECT ) as boolean
    return PsMessageBox_QueryRect( hMsgBox, MBX_PART_CLOSE, rc )
end function

function PsMessageBox_GetBodyRect( byval hMsgBox as HWND, byref rc as RECT ) as boolean
    return PsMessageBox_QueryRect( hMsgBox, MBX_PART_BODY, rc )
end function

function PsMessageBox_GetIconRect( byval hMsgBox as HWND, byref rc as RECT ) as boolean
    return PsMessageBox_QueryRect( hMsgBox, MBX_PART_ICON, rc )
end function

function PsMessageBox_GetTextRect( byval hMsgBox as HWND, byref rc as RECT ) as boolean
    return PsMessageBox_QueryRect( hMsgBox, MBX_PART_TEXT, rc )
end function

function PsMessageBox_GetFooterRect( byval hMsgBox as HWND, byref rc as RECT ) as boolean
    return PsMessageBox_QueryRect( hMsgBox, MBX_PART_FOOTER, rc )
end function

function PsMessageBox_GetButtonRect( byval hMsgBox as HWND, byval idx as long, byref rc as RECT ) as boolean
    SetRectEmpty( @rc )
    dim as PSMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer(hMsgBox)
    if pBox = 0 then return false
    if (idx < 0) orelse (idx >= pBox->nButtonCount) then return false
    if pBox->bLayoutDirty then pBox->LayoutBox()
    if pBox->bLayoutDirty then return false
    rc = pBox->rcButtons(idx)
    return true
end function


' ========================================================================================
' Appearance.
' ========================================================================================
public sub PsMessageBox_GetColors( byval hMsgBox as HWND, byval pColors as MBX_COLORS ptr )
    dim as PSMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer(hMsgBox)
    if (pBox = 0) orelse (pColors = 0) then exit sub
    *pColors = pBox->colors
end sub

public sub PsMessageBox_SetColors( byval hMsgBox as HWND, byval pColors as MBX_COLORS ptr )
    dim as PSMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer(hMsgBox)
    if (pBox = 0) orelse (pColors = 0) then exit sub
    pBox->colors = *pColors
    pBox->bColorsPinned = true
    if pBox->hWin then InvalidateRect( pBox->hWin, NULL, FALSE )
end sub

' Pushed into every button that exists NOW and stored for every button added LATER, so the order
' of AddButton and SetButtonColors does not matter.
public sub PsMessageBox_SetButtonColors( byval hMsgBox as HWND, byval pColors as PSBUTTON_COLORS ptr )
    dim as PSMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer(hMsgBox)
    if (pBox = 0) orelse (pColors = 0) then exit sub
    pBox->btnColors = *pColors
    pBox->bColorsPinned = true
    for i as long = 0 to pBox->nButtonCount - 1
        PsButton_SetColors( pBox->hButtons(i), pColors )
    next
end sub

' ========================================================================================
' The theme (vendor/PsControls/PsTheme). ThemeColors is the adapter: the box's colours
' derived from the theme's roles. ApplyTheme applies them, and PsButton's adapter to the
' buttons, unless the host pinned its own.
' ========================================================================================
public function PsMessageBox_ThemeColors( byref t as PSTHEME_COLORS ) as MBX_COLORS
    dim as MBX_COLORS c
    c.BorderColor           = t.Border
    c.CaptionBackColor      = t.Surface
    c.CaptionForeColor      = t.Text
    c.CloseBackColor        = t.Surface
    c.CloseForeColor        = t.Text
    c.CloseBackColorHot     = t.Error
    c.CloseForeColorHot     = t.SelectedText
    c.CloseBackColorPressed = t.Error
    c.CloseForeColorPressed = t.SelectedText
    c.BackColor             = t.Window
    c.ForeColor             = t.Text
    c.FooterBackColor       = t.SurfaceDisabled
    c.DividerColor          = t.Divider
    c.IconColorInfo         = t.FocusRing
    c.IconColorWarning      = t.Warning
    c.IconColorError        = t.Error
    c.IconColorQuestion     = t.FocusRing
    return c
end function

public sub PsMessageBox_ApplyTheme( byval hMsgBox as HWND, byref t as PSTHEME_COLORS )
    dim as PSMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer(hMsgBox)
    if (pBox = 0) orelse pBox->bColorsPinned then exit sub
    dim as MBX_COLORS c = PsMessageBox_ThemeColors( t )
    PsMessageBox_SetColors( hMsgBox, @c )
    dim as PSBUTTON_COLORS cb = PsButton_ThemeColors( t )
    PsMessageBox_SetButtonColors( hMsgBox, @cb )
    pBox->bColorsPinned = false
end sub

' Hands the box back to the theme, which is applied at once.
public sub PsMessageBox_UnpinColors( byval hMsgBox as HWND )
    dim as PSMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer(hMsgBox)
    if pBox = 0 then exit sub
    pBox->bColorsPinned = false
    dim as PSTHEME_COLORS t
    if PsRegistry_GetTheme( t ) then PsMessageBox_ApplyTheme( hMsgBox, t )
end sub

' The form's fonts (PsApp), handed over when the box is created: the message font and the
' icon font (both also pushed into the buttons).
public sub PsMessageBox_ApplyFonts( byval hMsgBox as HWND, byval hTextFont as HFONT, byval hGlyphFont as HFONT )
    if hTextFont then PsMessageBox_SetFont( hMsgBox, hTextFont )
    if hGlyphFont then PsMessageBox_SetGlyphFont( hMsgBox, hGlyphFont )
end sub

' ========================================================================================
' Per-monitor DPI (RFC-0001 P4). Every layout input -- the scaled Create defaults and whatever
' the host set since -- times newDpi/oldDpi; the border and divider THICKNESS values stay as
' they are (they were never scaled). The footer buttons are PsButtons with their own Rescale.
' The layout stays lazy (Refresh), so the measuring pass runs after the buttons and the new
' fonts are in; DoModal sizes the window from it. The fonts are not ours: PsApp hands new ones
' over after this.
' ========================================================================================
public sub PsMessageBox_Rescale( byval hMsgBox as HWND, byval oldDpi as long, byval newDpi as long )
    dim as PSMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer(hMsgBox)
    if (pBox = 0) orelse (oldDpi <= 0) orelse (newDpi <= 0) orelse (oldDpi = newDpi) then exit sub
    pBox->nCaptionHeight  = MulDiv( pBox->nCaptionHeight,  newDpi, oldDpi )
    pBox->nCaptionPadX    = MulDiv( pBox->nCaptionPadX,    newDpi, oldDpi )
    pBox->nCloseWidth     = MulDiv( pBox->nCloseWidth,     newDpi, oldDpi )
    pBox->nBodyPadX       = MulDiv( pBox->nBodyPadX,       newDpi, oldDpi )
    pBox->nBodyPadY       = MulDiv( pBox->nBodyPadY,       newDpi, oldDpi )
    pBox->nFooterPadX     = MulDiv( pBox->nFooterPadX,     newDpi, oldDpi )
    pBox->nFooterPadY     = MulDiv( pBox->nFooterPadY,     newDpi, oldDpi )
    pBox->nIconWidth      = MulDiv( pBox->nIconWidth,      newDpi, oldDpi )
    pBox->nIconHeight     = MulDiv( pBox->nIconHeight,     newDpi, oldDpi )
    pBox->nIconGap        = MulDiv( pBox->nIconGap,        newDpi, oldDpi )
    pBox->nButtonGap      = MulDiv( pBox->nButtonGap,      newDpi, oldDpi )
    pBox->nButtonMinWidth = MulDiv( pBox->nButtonMinWidth, newDpi, oldDpi )
    pBox->nMaxWidth       = MulDiv( pBox->nMaxWidth,       newDpi, oldDpi )
    pBox->nMinWidth       = MulDiv( pBox->nMinWidth,       newDpi, oldDpi )
    dim as CWindow ptr pWindow = CWindowPtr( hMsgBox )
    if pWindow then pWindow->DPI = newDpi
    pBox->Refresh()
end sub

function PsMessageBox_GetFont( byval hMsgBox as HWND ) as HFONT
    dim as PSMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer(hMsgBox)
    if pBox = 0 then return 0
    return pBox->hTextFont
end function

' The MESSAGE font and the MEASURING font. Changing it re-wraps, which changes the box's height.
' Also pushed into the buttons, whose own ideal widths then change too.
public sub PsMessageBox_SetFont( byval hMsgBox as HWND, byval hTextFont as HFONT )
    dim as PSMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer(hMsgBox)
    if pBox = 0 then exit sub
    pBox->hTextFont = hTextFont
    for i as long = 0 to pBox->nButtonCount - 1
        PsButton_SetFont( pBox->hButtons(i), hTextFont )
    next
    pBox->Refresh()
end sub

function PsMessageBox_GetCaptionFont( byval hMsgBox as HWND ) as HFONT
    dim as PSMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer(hMsgBox)
    if pBox = 0 then return 0
    return pBox->hCaptionFont
end function

public sub PsMessageBox_SetCaptionFont( byval hMsgBox as HWND, byval hCaptionFont as HFONT )
    dim as PSMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer(hMsgBox)
    if pBox = 0 then exit sub
    pBox->hCaptionFont = hCaptionFont
    ' The title contributes a WIDTH FLOOR, so this really can change the box's size.
    pBox->Refresh()
end sub

function PsMessageBox_GetGlyphFont( byval hMsgBox as HWND ) as HFONT
    dim as PSMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer(hMsgBox)
    if pBox = 0 then return 0
    return pBox->hGlyphFont
end function

' The ICON font, used for both the message icon and the close X. A paint-time input only
' (PsIconPanel's rule): the icon cell is DECLARED by SetIconSize and never measured, so changing
' this repaints without re-laying-out. It is still pushed into the buttons, where it is their
' glyph font and likewise does not re-measure them.
public sub PsMessageBox_SetGlyphFont( byval hMsgBox as HWND, byval hGlyphFont as HFONT )
    dim as PSMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer(hMsgBox)
    if pBox = 0 then exit sub
    pBox->hGlyphFont = hGlyphFont
    for i as long = 0 to pBox->nButtonCount - 1
        PsButton_SetGlyphFont( pBox->hButtons(i), hGlyphFont )
    next
    if pBox->hWin then InvalidateRect( pBox->hWin, NULL, FALSE )
end sub


function PsMessageBox_GetCloseGlyphFont( byval hMsgBox as HWND ) as HFONT
    dim as PSMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer(hMsgBox)
    if pBox = 0 then return 0
    return pBox->hCloseFont
end function

' The close X's font. Not pushed into the buttons -- it is caption chrome, not content -- and a
' paint-time input only, so this repaints without re-laying-out.
public sub PsMessageBox_SetCloseGlyphFont( byval hMsgBox as HWND, byval hCloseFont as HFONT )
    dim as PSMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer(hMsgBox)
    if pBox = 0 then exit sub
    pBox->hCloseFont = hCloseFont
    if pBox->hWin then InvalidateRect( pBox->hWin, @pBox->rcClose, FALSE )
end sub


' ========================================================================================
' Callbacks.
' ========================================================================================
public sub PsMessageBox_SetPaintCallback( byval hMsgBox as HWND, byval usersub as MBX_PaintCallbackSub )
    dim as PSMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer(hMsgBox)
    if pBox = 0 then exit sub
    pBox->PaintCallback = usersub
    if pBox->hWin then InvalidateRect( pBox->hWin, NULL, TRUE )
end sub

public sub PsMessageBox_SetMessageCallback( byval hMsgBox as HWND, byval userfunc as MBX_MessageCallbackFunc )
    dim as PSMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer(hMsgBox)
    if pBox = 0 then exit sub
    pBox->MessageCallback = userfunc
end sub


' ========================================================================================
' Where does the box go?  Centred on the parent's WINDOW rect, or -- with no parent -- on the
' monitor holding the cursor, then clamped into that monitor's work area.
'
' THE CLAMP ORDER MATTERS. right/bottom first, then left/top, so a box taller than the work area
' ends up flush with the TOP rather than pushed off it. Work-area coordinates are freely
' negative on a multi-monitor desktop, which is exactly why the clamp is done against
' MonitorFromPoint's answer instead of against screen metrics (PsPopupMenu's arithmetic).
' ========================================================================================
private sub PsMessageBox_ComputeOrigin( _
            byval pBox as PSMESSAGEBOX_STATE ptr, _
            byval nBoxWidth  as long, _
            byval nBoxHeight as long, _
            byref x as long, _
            byref y as long _
            )

    x = 0 : y = 0
    if pBox = 0 then exit sub

    dim as RECT rcAnchor
    if (pBox->hParent <> 0) andalso IsWindow( pBox->hParent ) then
        GetWindowRect( pBox->hParent, @rcAnchor )
    else
        dim as POINT ptCur
        GetCursorPos( @ptCur )
        dim mi as MONITORINFO
        mi.cbSize = sizeof(MONITORINFO)
        if GetMonitorInfo( MonitorFromPoint( ptCur, MONITOR_DEFAULTTONEAREST ), @mi ) then
            rcAnchor = mi.rcWork
        end if
    end if

    x = rcAnchor.left + (((rcAnchor.right - rcAnchor.left) - nBoxWidth) \ 2)
    y = rcAnchor.top  + (((rcAnchor.bottom - rcAnchor.top) - nBoxHeight) \ 2)

    dim as POINT ptCentre
    ptCentre.x = x + (nBoxWidth \ 2)
    ptCentre.y = y + (nBoxHeight \ 2)
    dim mi2 as MONITORINFO
    mi2.cbSize = sizeof(MONITORINFO)
    if GetMonitorInfo( MonitorFromPoint( ptCentre, MONITOR_DEFAULTTONEAREST ), @mi2 ) then
        if (x + nBoxWidth)  > mi2.rcWork.right  then x = mi2.rcWork.right - nBoxWidth
        if (y + nBoxHeight) > mi2.rcWork.bottom then y = mi2.rcWork.bottom - nBoxHeight
        if x < mi2.rcWork.left then x = mi2.rcWork.left
        if y < mi2.rcWork.top  then y = mi2.rcWork.top
    end if
end sub


' ========================================================================================
' The one MessageBeep, mapped from the icon kind. Win32's MessageBox does this too, and the
' sounds are user-configurable, so a host that suppresses it is overriding a system preference
' rather than removing noise.
' ========================================================================================
private sub PsMessageBox_Beep( byval nKind as long )
    select case nKind
    case MBX_ICON_ERROR    : MessageBeep( MB_ICONHAND )
    case MBX_ICON_WARNING  : MessageBeep( MB_ICONEXCLAMATION )
    case MBX_ICON_QUESTION : MessageBeep( MB_ICONQUESTION )
    case MBX_ICON_INFO     : MessageBeep( MB_ICONASTERISK )
    case else              : MessageBeep( MB_OK )
    end select
end sub


' ========================================================================================
' Keys the box claims before IsDialogMessage ever sees them.
'
' ESCAPE always. IsDialogMessage does synthesise a WM_COMMAND/IDCANCEL for it, but only in terms
' of a control id we deliberately do not use as a host id -- handling it here keeps the cancel
' answer in ONE place (ResolveCancelID) instead of two.
'
' ENTER only when a button does NOT have the focus. A focused PsButton claims Enter itself
' through WM_GETDLGCODE, and clicking THAT button is the right answer -- not the default one.
' Stealing Enter unconditionally here would make the default button fire no matter which button
' the user had tabbed to, which is the natural bug in this area.
' ========================================================================================
private function PsMessageBox_PreTranslate( _
            byval pBox    as PSMESSAGEBOX_STATE ptr, _
            byval hMsgBox as HWND, _
            byval pMsg    as MSG ptr _
            ) as boolean

    if (pBox = 0) orelse (pMsg = 0) then return false
    if pMsg->message <> WM_KEYDOWN then return false
    ' Only keys aimed at the box or one of its descendants. Without this a key sent to some
    ' other window of the host's while the box happened to be up would be swallowed.
    if (pMsg->hwnd <> hMsgBox) andalso (IsChild( hMsgBox, pMsg->hwnd ) = 0) then return false

    select case pMsg->wParam
    case VK_ESCAPE
        PostMessage( hMsgBox, WM_CLOSE, 0, 0 )
        return true

    case VK_RETURN
        dim as HWND hFocus = GetFocus()
        for i as long = 0 to pBox->nButtonCount - 1
            if hFocus = pBox->hButtons(i) then return false
        next
        if (pBox->nDefaultIndex >= 0) andalso (pBox->nDefaultIndex < pBox->nButtonCount) then
            ' PsButton_Click FIRES the click callback -- the documented exception to the family's
            ' silent-setter rule, and the reason this works at all.
            PsButton_Click( pBox->hButtons( pBox->nDefaultIndex ) )
            return true
        end if
    end select

    return false
end function


' ========================================================================================
' PsMessageBox_DoModal -- measure, size, centre, show, PUMP, and return the answer.
'
' THE NESTED LOOP IS THIS CONTROL'S ONE BIG DEPARTURE from the rest of the family, which is
' passive and pumped by its host. Four things in here are the whole risk surface:
'
'   1. THE LOOP CONDITION IS RE-FETCHED EVERY ITERATION, never cached. A host that destroys the
'      parent takes this owned window with it and frees pBox -- so a cached pointer would be a
'      use-after-free on the very next test. IsWindow first, then the pointer.
'
'   2. WM_QUIT IS RE-POSTED, not consumed. GetMessage returning 0 removes the quit from the
'      queue; leaving it consumed would swallow the host's shutdown and the outer pump would
'      spin forever. (AfxInputBox ends its nested loop by letting the quit through, which works
'      only because nothing runs after it.)
'
'   3. THE PARENT IS RE-ENABLED BEFORE THE BOX IS DESTROYED. Destroying an owned window while
'      its owner is still disabled hands activation to another application -- the classic
'      "my app went behind Explorer when the dialog closed" bug.
'
'   4. IsDialogMessage IS OURS. It is what makes Tab walk the buttons, and it is why the host has
'      no pump obligation at all. It only acts once a DESCENDANT has focus, hence the explicit
'      SetFocus before the loop -- the second half of the PsButton Tab bug in Learnings.md.
' ========================================================================================
public function PsMessageBox_DoModal( byval hMsgBox as HWND ) as long
    dim as PSMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer(hMsgBox)
    if pBox = 0 then return 0

    ' Captured now, because pBox may not survive the loop (see 1 above) and the parent still has
    ' to be re-enabled afterwards no matter what happened.
    dim as HWND hParent = pBox->hParent

    ' ---- measure and place ------------------------------------------------------------------
    pBox->bLayoutDirty = true
    pBox->LayoutBox()
    dim as long nBoxWidth  = pBox->nIdealW
    dim as long nBoxHeight = pBox->nIdealH
    if nBoxWidth  < 1 then nBoxWidth  = 1
    if nBoxHeight < 1 then nBoxHeight = 1

    dim as long x, y
    PsMessageBox_ComputeOrigin( pBox, nBoxWidth, nBoxHeight, x, y )
    ' This fires WM_SIZE, which re-lays out and positions the child buttons.
    SetWindowPos( hMsgBox, HWND_TOP, x, y, nBoxWidth, nBoxHeight, SWP_NOACTIVATE )

    ' Before the show, not after: a beep that lands after the paint reads as a delayed error.
    if pBox->bBeep then PsMessageBox_Beep( pBox->nIconKind )

    ' ---- go modal ---------------------------------------------------------------------------
    ' Disable the parent BEFORE showing, so there is no frame in which both windows are live.
    if hParent then EnableWindow( hParent, FALSE )

    ShowWindow( hMsgBox, SW_SHOW )
    UpdateWindow( hMsgBox )
    SetActiveWindow( hMsgBox )

    ' IsDialogMessage ignores Tab until a DESCENDANT of hMsgBox has focus, so this is not
    ' optional -- without it the first Tab does nothing and it reads as broken tabstops.
    dim as long nFocusIdx = pBox->ResolveFocusIndex()
    if nFocusIdx >= 0 then SetFocus( pBox->hButtons(nFocusIdx) )

    pBox->bRunning = true

    dim uMsg as MSG
    do
        if IsWindow( hMsgBox ) = 0 then exit do
        dim as PSMESSAGEBOX_STATE ptr pLoop = GetMessageBoxPointer( hMsgBox )
        if pLoop = 0 then exit do
        if pLoop->bRunning = false then exit do

        if GetMessageW( @uMsg, NULL, 0, 0 ) = 0 then
            ' The host is shutting down. Put the quit back so the OUTER pump still sees it.
            PostQuitMessage( cast( long, uMsg.wParam ) )
            exit do
        end if

        if PsMessageBox_PreTranslate( pLoop, hMsgBox, @uMsg ) = false then
            if IsDialogMessageW( hMsgBox, @uMsg ) = 0 then
                TranslateMessage( @uMsg )
                DispatchMessageW( @uMsg )
            end if
        end if
    loop

    ' ---- unwind, in this order ---------------------------------------------------------------
    ' Read the answer while the window is still alive...
    dim as long nResult = 0
    if IsWindow( hMsgBox ) then
        dim as PSMESSAGEBOX_STATE ptr pEnd = GetMessageBoxPointer( hMsgBox )
        if pEnd then nResult = pEnd->nResult
    end if

    ' ...re-enable and re-activate the parent BEFORE destroying us (see 3 above)...
    if hParent andalso IsWindow( hParent ) then
        EnableWindow( hParent, TRUE )
        SetActiveWindow( hParent )
    end if

    ' ...and only then destroy. The handle is dead after this call.
    if IsWindow( hMsgBox ) then DestroyWindow( hMsgBox )

    return nResult
end function


' ========================================================================================
' PsMessageBox_Show -- Create + configure + DoModal, for the common case.
'
' Everything it does is reachable through the long form; nothing here is privileged. A host that
' wants custom captions, a third button with its own id, a glyph override or its own colours
' builds the box itself.
' ========================================================================================
public function PsMessageBox_Show( byval hWndParent as HWND, _
                           byval Text as ustring, _
                           byval Caption as ustring, _
                           byval nIconKind as long = MBX_ICON_NONE, _
                           byval nPreset as long = MBX_BTN_OK ) as long

    dim as HWND hBox = PsMessageBox_Create( hWndParent )
    if hBox = 0 then return 0

    PsMessageBox_SetCaption( hBox, Caption )
    PsMessageBox_SetText( hBox, Text )
    PsMessageBox_SetIconKind( hBox, nIconKind )
    PsMessageBox_AddPreset( hBox, nPreset )

    ' NOTE: no fonts are set here, so the box measures and draws with the stock GUI font and the
    ' icon codepoints come out as missing-glyph boxes. A host that has loaded Segoe Fluent Icons
    ' wants the long form, or its own wrapper around it. Documented in the README rather than
    ' papered over with a font this control would then have to own.
    return PsMessageBox_DoModal( hBox )
end function


' ========================================================================================
' Plumbing.
' ========================================================================================

' Size the box to its ideal size WITHOUT showing it or entering the modal loop, so geometry can
' be asserted and the tone probe can run. There is no other way in: every rect this control owns
' depends on the client area, and the client area is otherwise only established by DoModal.
public sub PsMessageBox_LayoutForTest( byval hMsgBox as HWND )
    dim as PSMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer(hMsgBox)
    if pBox = 0 then exit sub

    pBox->bLayoutDirty = true
    pBox->LayoutBox()
    dim as long nBoxWidth  = pBox->nIdealW
    dim as long nBoxHeight = pBox->nIdealH
    if nBoxWidth  < 1 then nBoxWidth  = 1
    if nBoxHeight < 1 then nBoxHeight = 1

    ' SWP_NOACTIVATE and no SW_SHOW: the window stays hidden, which is what makes this safe to
    ' call from a self-test that must not steal focus from the host being tested.
    SetWindowPos( hMsgBox, 0, 0, 0, nBoxWidth, nBoxHeight, _
                  SWP_NOZORDER or SWP_NOMOVE or SWP_NOACTIVATE )
end sub


private function PsMessageBox_PartRect( byval pBox as PSMESSAGEBOX_STATE ptr, byval nPart as long ) as RECT
    dim as RECT rc
    if pBox = 0 then return rc
    select case nPart
    case MBX_PART_CAPTION : rc = pBox->rcCaption
    case MBX_PART_BODY    : rc = pBox->rcBody
    case MBX_PART_FOOTER  : rc = pBox->rcFooter
    case MBX_PART_TEXT    : rc = pBox->rcText
    case MBX_PART_ICON    : rc = pBox->rcIcon
    case MBX_PART_CLOSE   : rc = pBox->rcClose
    end select
    return rc
end function


' Render the box OFFSCREEN with its current painter and count the distinct colours inside one of
' its rects. See the declaration at the top of this file for what this is for and why it is public.
public function PsMessageBox_CountRenderedTones( byval hMsgBox as HWND, byval nPart as long ) as long
    dim as PSMESSAGEBOX_STATE ptr pBox = GetMessageBoxPointer(hMsgBox)
    if pBox = 0 then return 0
    if pBox->bLayoutDirty then pBox->LayoutBox()
    if pBox->bLayoutDirty then return 0          ' no client area yet

    dim as RECT rcClient
    GetClientRect( hMsgBox, @rcClient )
    dim as long cw = rcClient.right - rcClient.left
    dim as long ch = rcClient.bottom - rcClient.top
    if (cw <= 0) orelse (ch <= 0) then return 0

    dim as RECT rcPart = PsMessageBox_PartRect( pBox, nPart )
    if IsRectEmpty( @rcPart ) then return 0

    if rcPart.left   < 0  then rcPart.left   = 0
    if rcPart.top    < 0  then rcPart.top    = 0
    if rcPart.right  > cw then rcPart.right  = cw
    if rcPart.bottom > ch then rcPart.bottom = ch
    if (rcPart.right <= rcPart.left) orelse (rcPart.bottom <= rcPart.top) then return 0

    dim as HDC hRef = GetDC( hMsgBox )
    if hRef = 0 then return 0
    dim as HDC hMem = CreateCompatibleDC( hRef )
    if hMem = 0 then
        ReleaseDC( hMsgBox, hRef )
        return 0
    end if

    ' 32bpp top-down, matching what PsBufferPaint.SetupBitmap builds, so the pixels we read are
    ' laid out the way the renderer wrote them.
    dim as BITMAPINFO bmi
    with bmi.bmiHeader
        .biSize        = sizeof(BITMAPINFOHEADER)
        .biWidth       = cw
        .biHeight      = -ch
        .biPlanes      = 1
        .biBitCount    = 32
        .biCompression = BI_RGB
    end with
    dim as any ptr pBits
    dim as HBITMAP hbm = CreateDIBSection( hRef, @bmi, DIB_RGB_COLORS, @pBits, null, 0 )
    ReleaseDC( hMsgBox, hRef )
    if (hbm = 0) orelse (pBits = 0) then
        if hbm then DeleteObject( hbm )
        DeleteDC( hMem )
        return 0
    end if
    dim as HGDIOBJ hOldBmp = SelectObject( hMem, hbm )

    ' Force the close button HOT so its own fill is actually exercised -- idle, its background
    ' equals the caption's and the probe would be measuring the caption twice.
    dim as boolean bSavedHot = pBox->isCloseHot
    pBox->isCloseHot = true

    scope
        dim as PsPaintBuffer b
        ' Four-arg form: hMem is BOTH the blit target and the cached back buffer, so the final
        ' BitBlt is a self-copy and the bitmap survives EndDoubleBuffer for us to read.
        b.BeginDoubleBuffer( hMsgBox, hMem, rcClient, hMem )

        b.SetBackColor( pBox->colors.BackColor )
        b.PaintClientRect()

        dim p as MBX_PAINTINFO
        PsMessageBox_FillPaintInfo( pBox, hMsgBox, @b, @p )

        if pBox->PaintCallback then
            pBox->PaintCallback( @p )
        else
            PsMessageBox_RenderDefault( pBox, @b, @p )
        end if

        b.EndDoubleBuffer()
    end scope

    pBox->isCloseHot = bSavedHot

    ' Count distinct tones. The alpha byte is masked off: GDI text leaves it at 0 and GDI+
    ' shapes leave it at 255, so an unmasked compare would report two tones for one colour.
    dim tones(0 to 63) as ulong
    dim as long nTones = 0
    dim as ulong ptr px = cast( ulong ptr, pBits )

    for yy as long = rcPart.top to rcPart.bottom - 1
        for xx as long = rcPart.left to rcPart.right - 1
            dim as ulong c = px[(yy * cw) + xx] and &h00FFFFFF
            dim as boolean bFound = false
            for t as long = 0 to nTones - 1
                if tones(t) = c then bFound = true : exit for
            next
            if bFound = false then
                if nTones < 64 then
                    tones(nTones) = c
                    nTones += 1
                end if
            end if
        next
    next

    SelectObject( hMem, hOldBmp )
    DeleteObject( hbm )
    DeleteDC( hMem )
    return nTones
end function


' ========================================================================================
' Self-test.  Gated on PSMESSAGEBOX_SELFTEST=1.
'
' NOTHING HERE ENTERS THE MODAL LOOP. Every assertion runs against a box that has been sized by
' PsMessageBox_LayoutForTest and never shown -- a self-test that went modal would block the host
' it was called from and could not report anything.
' ========================================================================================
dim shared as long gMBX_TestCount
dim shared as long gMBX_FailCount

private sub MBXTest_Check( byval sName as string, byval bOK as boolean, byval sDetail as string )
    gMBX_TestCount += 1
    dim as string s
    if bOK then
        s = "PASS  "
    else
        s = "FAIL  "
        gMBX_FailCount += 1
    end if
    ' Built as a plain STRING first: print on a string & wstring concat
    ' interleaves nulls (C:\dev\Learnings.md).
    s &= sName & "   [" & sDetail & "]"
    print s
end sub

private function MBXTest_RectStr( byref rc as RECT ) as string
    return "(" & str(rc.left) & "," & str(rc.top) & ")-(" & str(rc.right) & "," & str(rc.bottom) & ")"
end function


public sub PsMessageBox_RunSelfTest( byval hWndParent as HWND )
    if environ("PSMESSAGEBOX_SELFTEST") <> "1" then exit sub

    gMBX_TestCount = 0
    gMBX_FailCount = 0
    print "=== PsMessageBox self-test ==="

    dim as string sD

    ' ---- 1. the pure resolvers, asserted on their own --------------------------------------
    ' These take no control pointer and touch no global, which is the whole reason they exist as
    ' separate functions: the mapping is a truth table, not something to eyeball in a paint.
    MBXTest_Check( "glyph: NONE resolves to nothing", _
                   len( PsMessageBox_ResolveGlyph( MBX_ICON_NONE ) ) = 0, "" )
    MBXTest_Check( "glyph: INFO", _
                   PsMessageBox_ResolveGlyph( MBX_ICON_INFO ) = wchr(PSMESSAGEBOX_GLYPH_INFO), "" )
    MBXTest_Check( "glyph: WARNING", _
                   PsMessageBox_ResolveGlyph( MBX_ICON_WARNING ) = wchr(PSMESSAGEBOX_GLYPH_WARNING), "" )
    MBXTest_Check( "glyph: ERROR", _
                   PsMessageBox_ResolveGlyph( MBX_ICON_ERROR ) = wchr(PSMESSAGEBOX_GLYPH_ERROR), "" )
    MBXTest_Check( "glyph: QUESTION", _
                   PsMessageBox_ResolveGlyph( MBX_ICON_QUESTION ) = wchr(PSMESSAGEBOX_GLYPH_QUESTION), "" )

    scope
        dim c as MBX_COLORS
        MBXTest_Check( "icon colour: INFO", _
                       PsMessageBox_ResolveIconColor( MBX_ICON_INFO, @c ) = c.IconColorInfo, "" )
        MBXTest_Check( "icon colour: WARNING", _
                       PsMessageBox_ResolveIconColor( MBX_ICON_WARNING, @c ) = c.IconColorWarning, "" )
        MBXTest_Check( "icon colour: ERROR", _
                       PsMessageBox_ResolveIconColor( MBX_ICON_ERROR, @c ) = c.IconColorError, "" )
        MBXTest_Check( "icon colour: QUESTION", _
                       PsMessageBox_ResolveIconColor( MBX_ICON_QUESTION, @c ) = c.IconColorQuestion, "" )
        MBXTest_Check( "icon colour: NONE falls back to the body fore", _
                       PsMessageBox_ResolveIconColor( MBX_ICON_NONE, @c ) = c.ForeColor, "" )
    end scope

    ' ---- the box under test ----------------------------------------------------------------
    dim as HWND h = PsMessageBox_Create( hWndParent )
    if h = 0 then
        print "FAIL  create   [PsMessageBox_Create returned 0]"
        exit sub
    end if
    dim as PSMESSAGEBOX_STATE ptr pB = GetMessageBoxPointer(h)
    if pB = 0 then
        print "FAIL  create   [no state pointer]"
        DestroyWindow(h)
        exit sub
    end if

    PsMessageBox_SetCaption( h, "Warning" )
    PsMessageBox_SetText( h, "This buffer contains unsaved edits. Do you want to save it?" )
    PsMessageBox_SetIconKind( h, MBX_ICON_WARNING )
    PsMessageBox_AddPreset( h, MBX_BTN_SAVE_DONTSAVE_CANCEL )
    PsMessageBox_LayoutForTest( h )

    dim as RECT rcClient
    GetClientRect( h, @rcClient )
    dim as long cw = rcClient.right - rcClient.left
    dim as long ch = rcClient.bottom - rcClient.top
    sD = "client " & str(cw) & "x" & str(ch)
    MBXTest_Check( "sized before ever being shown", (cw > 0) andalso (ch > 0), sD )

    dim as RECT rcCap, rcClose, rcBody, rcText, rcIcon, rcFoot
    PsMessageBox_GetCaptionRect( h, rcCap )
    PsMessageBox_GetCloseRect( h, rcClose )
    PsMessageBox_GetBodyRect( h, rcBody )
    PsMessageBox_GetTextRect( h, rcText )
    PsMessageBox_GetIconRect( h, rcIcon )
    PsMessageBox_GetFooterRect( h, rcFoot )

    ' ---- 2. the three bands tile the client exactly, with no gap and no overlap -------------
    ' Asserted against each OTHER rather than against the fields they were computed from, so a
    ' band that is placed correctly but sized from the wrong input still fails.
    sD = "cap " & MBXTest_RectStr(rcCap)
    MBXTest_Check( "caption starts at the top-left", _
                   (rcCap.left = 0) andalso (rcCap.top = 0), sD )
    MBXTest_Check( "caption spans the full width", (rcCap.right = cw), sD )
    MBXTest_Check( "caption height is the declared one", _
                   (rcCap.bottom - rcCap.top) = pB->nCaptionHeight, sD )

    sD = "body " & MBXTest_RectStr(rcBody) & " foot " & MBXTest_RectStr(rcFoot)
    MBXTest_Check( "body begins where the caption ends", (rcBody.top = rcCap.bottom), sD )
    MBXTest_Check( "footer begins where the body ends", (rcFoot.top = rcBody.bottom), sD )
    MBXTest_Check( "footer ends at the client bottom", (rcFoot.bottom = ch), sD )
    MBXTest_Check( "body spans the full width", _
                   (rcBody.left = 0) andalso (rcBody.right = cw), sD )
    MBXTest_Check( "footer spans the full width", _
                   (rcFoot.left = 0) andalso (rcFoot.right = cw), sD )

    dim as long bandSum = (rcCap.bottom - rcCap.top) + (rcBody.bottom - rcBody.top) + _
                          (rcFoot.bottom - rcFoot.top)
    sD = "caption+body+footer=" & str(bandSum) & " client=" & str(ch)
    MBXTest_Check( "the three bands tile the client exactly", (bandSum = ch), sD )

    ' ---- 3. the close button ----------------------------------------------------------------
    sD = "close " & MBXTest_RectStr(rcClose)
    MBXTest_Check( "close is pinned to the right edge", (rcClose.right = cw), sD )
    MBXTest_Check( "close is the declared width", _
                   (rcClose.right - rcClose.left) = pB->nCloseWidth, sD )
    MBXTest_Check( "close fills the caption band's height", _
                   (rcClose.top = rcCap.top) andalso (rcClose.bottom = rcCap.bottom), sD )

    dim as RECT rcCapText = pB->rcCaptionText
    sD = "captext " & MBXTest_RectStr(rcCapText)
    MBXTest_Check( "title starts at the caption padding", _
                   (rcCapText.left = pB->nCaptionPadX), sD )
    MBXTest_Check( "title never runs under the close button", _
                   (rcCapText.right <= rcClose.left), sD )

    ' ---- 4. the icon and the text ------------------------------------------------------------
    sD = "icon " & MBXTest_RectStr(rcIcon)
    MBXTest_Check( "icon present for a real kind", IsRectEmpty( @rcIcon ) = 0, sD )
    MBXTest_Check( "icon is the declared cell", _
                   ((rcIcon.right - rcIcon.left) = pB->nIconWidth) andalso _
                   ((rcIcon.bottom - rcIcon.top) = pB->nIconHeight), sD )
    MBXTest_Check( "icon pinned at the body padding", (rcIcon.left = pB->nBodyPadX), sD )

    sD = "text " & MBXTest_RectStr(rcText)
    MBXTest_Check( "text starts after icon + gap", _
                   (rcText.left = pB->nBodyPadX + pB->nIconWidth + pB->nIconGap), sD )
    MBXTest_Check( "text ends at the body padding", (rcText.right = cw - pB->nBodyPadX), sD )
    MBXTest_Check( "text height is the MEASURED wrapped height", _
                   (rcText.bottom - rcText.top) = pB->nTextBlockH, sD )
    MBXTest_Check( "text sits inside the body", _
                   (rcText.top >= rcBody.top) andalso (rcText.bottom <= rcBody.bottom), sD )
    MBXTest_Check( "icon sits inside the body", _
                   (rcIcon.top >= rcBody.top) andalso (rcIcon.bottom <= rcBody.bottom), sD )

    ' The icon and the text are each v-centred on the TALLER of the two, so their centres agree.
    dim as long iconMid = (rcIcon.top + rcIcon.bottom) \ 2
    dim as long textMid = (rcText.top + rcText.bottom) \ 2
    sD = "iconMid=" & str(iconMid) & " textMid=" & str(textMid)
    MBXTest_Check( "icon and text share a vertical centre", abs(iconMid - textMid) <= 1, sD )

    ' ---- 5. the buttons -----------------------------------------------------------------------
    MBXTest_Check( "preset added three buttons", PsMessageBox_GetButtonCount(h) = 3, _
                   "count=" & str(PsMessageBox_GetButtonCount(h)) )
    MBXTest_Check( "a fourth button is refused", _
                   PsMessageBox_AddButton( h, "Extra", 99 ) = 0, "" )

    dim as RECT rb0, rb1, rb2
    PsMessageBox_GetButtonRect( h, 0, rb0 )
    PsMessageBox_GetButtonRect( h, 1, rb1 )
    PsMessageBox_GetButtonRect( h, 2, rb2 )
    sD = MBXTest_RectStr(rb0) & " " & MBXTest_RectStr(rb1) & " " & MBXTest_RectStr(rb2)

    MBXTest_Check( "last button is right-aligned to the footer padding", _
                   (rb2.right = cw - pB->nFooterPadX), sD )
    MBXTest_Check( "gap between buttons 0 and 1 is exact", _
                   (rb1.left - rb0.right) = pB->nButtonGap, sD )
    MBXTest_Check( "gap between buttons 1 and 2 is exact", _
                   (rb2.left - rb1.right) = pB->nButtonGap, sD )
    MBXTest_Check( "buttons are laid out left to right in the order added", _
                   (rb0.left < rb1.left) andalso (rb1.left < rb2.left), sD )
    MBXTest_Check( "all buttons share one height", _
                   ((rb0.bottom - rb0.top) = (rb1.bottom - rb1.top)) andalso _
                   ((rb1.bottom - rb1.top) = (rb2.bottom - rb2.top)), sD )
    MBXTest_Check( "all buttons share one baseline", _
                   (rb0.top = rb1.top) andalso (rb1.top = rb2.top), sD )
    MBXTest_Check( "buttons honour the min-width floor", _
                   ((rb0.right - rb0.left) >= pB->nButtonMinWidth) andalso _
                   ((rb1.right - rb1.left) >= pB->nButtonMinWidth) andalso _
                   ((rb2.right - rb2.left) >= pB->nButtonMinWidth), sD )
    MBXTest_Check( "buttons sit inside the footer band", _
                   (rb0.top >= rcFoot.top) andalso (rb2.bottom <= rcFoot.bottom), sD )
    MBXTest_Check( "first button clears the left footer padding", _
                   (rb0.left >= pB->nFooterPadX), sD )

    ' ---- 6. cancel-id resolution ---------------------------------------------------------------
    MBXTest_Check( "cancel unset resolves to the LAST button's id", _
                   PsMessageBox_GetCancelID(h) = IDCANCEL, _
                   "id=" & str(PsMessageBox_GetCancelID(h)) )
    PsMessageBox_SetCancelID( h, 4242 )
    MBXTest_Check( "an explicit cancel id wins", PsMessageBox_GetCancelID(h) = 4242, "" )

    ' ---- 7. default and focus, and the precedence between them ----------------------------------
    ' The preset made button 0 default and nothing has called SetFocusButton, so focus follows.
    MBXTest_Check( "preset made button 0 the default", PsMessageBox_GetDefaultButton(h) = 0, _
                   "idx=" & str(PsMessageBox_GetDefaultButton(h)) )
    MBXTest_Check( "focus follows the default when not set explicitly", _
                   PsMessageBox_GetFocusButton(h) = 0, _
                   "idx=" & str(PsMessageBox_GetFocusButton(h)) )
    PsMessageBox_SetDefaultButton( h, 1 )
    MBXTest_Check( "focus follows a CHANGED default", PsMessageBox_GetFocusButton(h) = 1, _
                   "idx=" & str(PsMessageBox_GetFocusButton(h)) )
    MBXTest_Check( "only one button carries the default border", _
                   (PsButton_GetDefault( PsMessageBox_GetButtonHandle(h,0) ) = false) andalso _
                   (PsButton_GetDefault( PsMessageBox_GetButtonHandle(h,1) ) = true) andalso _
                   (PsButton_GetDefault( PsMessageBox_GetButtonHandle(h,2) ) = false), "" )
    PsMessageBox_SetFocusButton( h, 2 )
    MBXTest_Check( "an explicit focus button overrides the default", _
                   PsMessageBox_GetFocusButton(h) = 2, _
                   "idx=" & str(PsMessageBox_GetFocusButton(h)) )
    MBXTest_Check( "...and does NOT move the default border", _
                   PsMessageBox_GetDefaultButton(h) = 1, "" )

    ' ---- 8. tab navigability, end to end --------------------------------------------------------
    ' CWindow.Create defaults dwExStyle to WS_EX_CONTROLPARENT OR WS_EX_WINDOWEDGE. For a LEAF
    ' control that flag is fatal (PsButton shipped broken with it); for THIS window it is
    ' REQUIRED, because the tabstops are its children. Both halves are asserted, because the flag
    ' is invisible at the call site that causes it.
    dim as ulong exStyle = cast( ulong, GetWindowLongPtr( h, GWL_EXSTYLE ) )
    dim as ulong wsStyle = cast( ulong, GetWindowLongPtr( h, GWL_STYLE ) )
    sD = "exstyle=&h" & hex(exStyle) & " style=&h" & hex(wsStyle)
    MBXTest_Check( "the BOX is a control parent (its children are the tabstops)", _
                   (exStyle and WS_EX_CONTROLPARENT) <> 0, sD )
    MBXTest_Check( "the box itself is NOT a tabstop", (wsStyle and WS_TABSTOP) = 0, sD )

    for i as long = 0 to 2
        dim as HWND hb = PsMessageBox_GetButtonHandle( h, i )
        dim as ulong bEx = cast( ulong, GetWindowLongPtr( hb, GWL_EXSTYLE ) )
        dim as ulong bSt = cast( ulong, GetWindowLongPtr( hb, GWL_STYLE ) )
        sD = "button " & str(i) & " exstyle=&h" & hex(bEx) & " style=&h" & hex(bSt)
        MBXTest_Check( "button " & str(i) & " is a tab ITEM, not a container", _
                       ((bSt and WS_TABSTOP) <> 0) andalso ((bEx and WS_EX_CONTROLPARENT) = 0), sD )
    next

    ' End to end: walk the dialog manager's own answer. This is the assertion that would have
    ' caught PsButton's bug, and it is the only one here that tests what the USER experiences
    ' rather than what a style bit says.
    scope
        dim as HWND hFirst = GetNextDlgTabItem( h, NULL, FALSE )
        dim as HWND hNext1 = GetNextDlgTabItem( h, hFirst, FALSE )
        dim as HWND hNext2 = GetNextDlgTabItem( h, hNext1, FALSE )
        dim as HWND hWrap  = GetNextDlgTabItem( h, hNext2, FALSE )
        sD = "ids " & str(GetDlgCtrlID(hFirst)) & " " & str(GetDlgCtrlID(hNext1)) & " " & _
             str(GetDlgCtrlID(hNext2)) & " -> " & str(GetDlgCtrlID(hWrap))
        MBXTest_Check( "Tab reaches every button and cycles", _
                       (hFirst = PsMessageBox_GetButtonHandle(h,0)) andalso _
                       (hNext1 = PsMessageBox_GetButtonHandle(h,1)) andalso _
                       (hNext2 = PsMessageBox_GetButtonHandle(h,2)) andalso _
                       (hWrap  = hFirst), sD )
        MBXTest_Check( "Shift+Tab walks the other way", _
                       GetNextDlgTabItem( h, hFirst, TRUE ) = PsMessageBox_GetButtonHandle(h,2), sD )
    end scope

    ' ---- 9. the offscreen tone probe -------------------------------------------------------------
    ' THE THRESHOLDS ARE NOT "> 1", AND THAT IS THE POINT. PsButton can use "> 1" because a wiped
    ' button really is one flat colour. This control cannot: its bands span the full width, so
    ' the window border strokes through EVERY one of them and a fully flooded box still measures
    ' 2 tones per band. A "> 1" assertion here passes on a completely destroyed render.
    '
    ' Measured, by deliberately swapping the border's PaintRoundOutline for PaintBorderRect
    ' (which fills before it strokes) and rebuilding:
    '
    '            caption   body   footer   close
    '   healthy      50      64        3       3
    '   flooded       2       2        2       2
    '
    ' So the floors below are calibrated to sit between those two rows. The footer's and the
    ' close button's are deliberately EXACT -- 3 is a fill plus its one distinct mark (the
    ' hairline / the glyph), and losing either should fail rather than be rounded away.
    '
    ' One limit worth stating, because it was found the hard way: flooding the FOOTER alone is
    ' invisible to this probe, since the flood colour would be the FooterBackColor the band was
    ' just filled with. The probe catches a flood that crosses bands, not one that repaints a
    ' band in its own colour.
    scope
        dim as long tCap   = PsMessageBox_CountRenderedTones( h, MBX_PART_CAPTION )
        dim as long tBody  = PsMessageBox_CountRenderedTones( h, MBX_PART_BODY )
        dim as long tFoot  = PsMessageBox_CountRenderedTones( h, MBX_PART_FOOTER )
        dim as long tClose = PsMessageBox_CountRenderedTones( h, MBX_PART_CLOSE )
        sD = "caption=" & str(tCap) & " body=" & str(tBody) & " footer=" & str(tFoot) & _
             " close=" & str(tClose) & "   (flooded reads 2/2/2/2)"
        MBXTest_Check( "caption band renders its title, not a flood", (tCap >= 10), sD )
        MBXTest_Check( "body renders its message and icon, not a flood", (tBody >= 10), sD )
        MBXTest_Check( "footer renders its fill AND its divider hairline", (tFoot >= 3), sD )
        MBXTest_Check( "the close button renders its own fill and glyph", (tClose >= 3), sD )
    end scope

    DestroyWindow( h )

    ' ---- 10. auto-height, shrink-to-fit, and the no-icon layout ------------------------------------
    ' A SECOND box, because these need different content and the assertions above are all about
    ' the first one's fixed geometry.
    scope
        dim as HWND h2 = PsMessageBox_Create( hWndParent )
        if h2 = 0 then
            print "FAIL  create #2   [PsMessageBox_Create returned 0]"
        else
            dim as PSMESSAGEBOX_STATE ptr p2 = GetMessageBoxPointer(h2)
            PsMessageBox_SetCaption( h2, "Question" )
            PsMessageBox_AddPreset( h2, MBX_BTN_OK )
            PsMessageBox_SetMinWidth( h2, 0 )       ' out of the way, so shrink-to-fit is visible

            dim as long w1, hh1, w2, hh2
            PsMessageBox_SetText( h2, "Short." )
            PsMessageBox_GetIdealSize( h2, w1, hh1 )

            PsMessageBox_SetText( h2, "This is a considerably longer message that is certain " & _
                                     "to wrap onto several separate lines once the maximum " & _
                                     "width has been applied to it by the layout pass." )
            PsMessageBox_GetIdealSize( h2, w2, hh2 )

            sD = "short " & str(w1) & "x" & str(hh1) & "  long " & str(w2) & "x" & str(hh2)
            MBXTest_Check( "a wrapped message is TALLER than a one-liner", (hh2 > hh1), sD )
            MBXTest_Check( "a short message shrinks the box to fit", (w1 < p2->nMaxWidth), sD )
            MBXTest_Check( "a long message clamps to the wrap width", (w2 <= p2->nMaxWidth), sD )

            ' No icon: the cell AND its gap are both given back, so the text starts at the body
            ' padding and the box is narrower by exactly iconW + iconGap.
            '
            ' THE MESSAGE HERE IS DELIBERATELY LONG ENOUGH TO DOMINATE THE FOOTER. The first
            ' version of this assertion used "Short.", and both widths came back 128 -- because
            ' at that size the box's width is the FOOTER's (2*footerPadX + one button's
            ' min-width), so the icon's 48px never reached the total and the test was measuring
            ' the max() rather than the icon. It failed honestly, which is the only reason the
            ' scaffolding error was visible at all.
            PsMessageBox_SetText( h2, "Long enough that the text block, not the footer, decides." )
            PsMessageBox_SetIconKind( h2, MBX_ICON_INFO )
            dim as long wIcon, hIcon
            PsMessageBox_GetIdealSize( h2, wIcon, hIcon )
            dim as long textHIcon = p2->nTextBlockH
            PsMessageBox_SetIconKind( h2, MBX_ICON_NONE )
            dim as long wNone, hNone
            PsMessageBox_GetIdealSize( h2, wNone, hNone )
            dim as long textHNone = p2->nTextBlockH
            sD = "with icon " & str(wIcon) & "  without " & str(wNone) & _
                 "  iconW+gap=" & str(p2->nIconWidth + p2->nIconGap)
            ' The precondition, asserted rather than assumed: removing the icon widens the wrap
            ' box, so if the message were near the wrap limit it would re-flow and the delta
            ' would not be the icon block at all.
            MBXTest_Check( "the icon test message does not re-wrap between the two cases", _
                           (textHIcon = textHNone), sD & " textH " & str(textHIcon) & _
                           "/" & str(textHNone) )
            MBXTest_Check( "removing the icon gives back the cell AND the gap", _
                           (wIcon - wNone) = (p2->nIconWidth + p2->nIconGap), sD )

            PsMessageBox_SetText( h2, "Short." )
            PsMessageBox_SetIconKind( h2, MBX_ICON_NONE )
            PsMessageBox_LayoutForTest( h2 )
            dim as RECT rcI2, rcT2
            PsMessageBox_GetIconRect( h2, rcI2 )
            PsMessageBox_GetTextRect( h2, rcT2 )
            sD = "icon " & MBXTest_RectStr(rcI2) & " text " & MBXTest_RectStr(rcT2)
            MBXTest_Check( "no icon = EMPTY rect, not a zero-width one", _
                           IsRectEmpty( @rcI2 ) <> 0, sD )
            MBXTest_Check( "no icon = text starts at the body padding", _
                           (rcT2.left = p2->nBodyPadX), sD )

            ' A glyph override is an unambiguous request for an icon and must beat ICON_NONE.
            PsMessageBox_SetGlyph( h2, wchr(PSMESSAGEBOX_GLYPH_INFO) )
            PsMessageBox_LayoutForTest( h2 )
            PsMessageBox_GetIconRect( h2, rcI2 )
            MBXTest_Check( "a glyph override turns the icon on even with kind NONE", _
                           IsRectEmpty( @rcI2 ) = 0, MBXTest_RectStr(rcI2) )

            ' One button, cancel unset -> that button. The single-button case is the one where
            ' "the last button" and "the only button" have to agree.
            MBXTest_Check( "one button, cancel unset, resolves to it", _
                           PsMessageBox_GetCancelID(h2) = IDOK, _
                           "id=" & str(PsMessageBox_GetCancelID(h2)) )

            DestroyWindow( h2 )
        end if
    end scope

    ' ---- 11. the footer can force the box WIDER than the wrap width ---------------------------------
    ' nMaxWidth constrains the TEXT, not the window. Three long captions must push the box out
    ' rather than being clipped -- that is the max() in LayoutBox, and it is an easy thing to
    ' write as a clamp by mistake.
    scope
        dim as HWND h3 = PsMessageBox_Create( hWndParent )
        if h3 then
            PsMessageBox_SetText( h3, "Hi." )
            PsMessageBox_SetMaxWidth( h3, 200 )
            PsMessageBox_SetMinWidth( h3, 0 )
            PsMessageBox_AddButton( h3, "A considerably long caption", 1 )
            PsMessageBox_AddButton( h3, "Another very long caption", 2 )
            PsMessageBox_AddButton( h3, "And a third long one", 3 )
            PsMessageBox_LayoutForTest( h3 )

            dim as long w3, h3h
            PsMessageBox_GetIdealSize( h3, w3, h3h )
            dim as RECT rl
            PsMessageBox_GetButtonRect( h3, 0, rl )
            sD = "ideal " & str(w3) & " maxWidth=200 firstBtn " & MBXTest_RectStr(rl)
            MBXTest_Check( "long buttons widen the box past the wrap width", (w3 > 200), sD )
            MBXTest_Check( "...and no button is pushed off the left edge", (rl.left >= 0), sD )
            DestroyWindow( h3 )
        end if
    end scope

    dim as string sSummary = "=== PsMessageBox self-test: " & str(gMBX_TestCount) & " checks, " & _
                             str(gMBX_FailCount) & " failed ==="
    print sSummary
end sub
