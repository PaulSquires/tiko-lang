/' parameter for the CURLOPT_USE_SSL option '/
#define CURLUSESSL_NONE 0     /' do not attempt to use SSL '/
#define CURLUSESSL_TRY 1      /' try using SSL, proceed anyway otherwise '/
#define CURLUSESSL_CONTROL 2  /' SSL for the control connection or fail '/
#define CURLUSESSL_ALL 3      /' SSL for all communication or fail '/

