/' The return code from the sockopt_callback can signal information back
   to libcurl: '/
#define CURL_SOCKOPT_OK 0
#define CURL_SOCKOPT_ERROR 1
#define CURL_SOCKOPT_ALREADY_CONNECTED 2

#if defined(TIKO_OS_WINDOWS)
'' C2T-TODO(refused-type) curl.h:425 -- typedef 'curl_sockopt_callback': 'SOCKET' is a system header's type
'' typedef int (*curl_sockopt_callback)(void *clientp,
''                                      curl_socket_t curlfd,
''                                      curlsocktype purpose);
#elseif not (defined(TIKO_OS_WINDOWS))
type curl_sockopt_callback as function cdecl( byval as any ptr, byval as curl_socket_t, byval as curlsocktype ) as int32
#endif

'' C2T-TODO(refused-type) curl.h:429 -- record 'curl_sockaddr': field 'addr': 'struct sockaddr' is a system header's type
'' struct curl_sockaddr {
''   int family;
''   int socktype;
''   int protocol;
''   unsigned int addrlen; /* addrlen was a socklen_t type before 7.18.0 but it
''                            turned really ugly and painful on the systems that
''                            lack this type */
''   struct sockaddr addr;
'' };

#if defined(TIKO_OS_WINDOWS)
'' C2T-TODO(refused-type) curl.h:439 -- typedef 'curl_opensocket_callback': 'SOCKET' is a system header's type
'' typedef curl_socket_t
'' (*curl_opensocket_callback)(void *clientp,
''                             curlsocktype purpose,
''                             struct curl_sockaddr *address);
#elseif not (defined(TIKO_OS_WINDOWS))
type curl_sockaddr__fwd as curl_sockaddr
type curl_opensocket_callback as function cdecl( byval as any ptr, byval as curlsocktype, byval as curl_sockaddr ptr ) as curl_socket_t
#endif

#if defined(TIKO_OS_WINDOWS)
'' C2T-TODO(refused-type) curl.h:444 -- typedef 'curl_closesocket_callback': 'SOCKET' is a system header's type
'' typedef int
'' (*curl_closesocket_callback)(void *clientp, curl_socket_t item);
#elseif not (defined(TIKO_OS_WINDOWS))
type curl_closesocket_callback as function cdecl( byval as any ptr, byval as curl_socket_t ) as int32
#endif

#if defined(TIKO_OS_WINDOWS)
type curlioerr as int32
enum
  CURLIOE_OK             /' I/O operation successful '/
  CURLIOE_UNKNOWNCMD     /' command was unknown to callback '/
  CURLIOE_FAILRESTART    /' failed to restart the read '/
  CURLIOE_LAST           /' never use '/
end enum
#elseif not (defined(TIKO_OS_WINDOWS))
type curlioerr as uint32
enum
  CURLIOE_OK             /' I/O operation successful '/
  CURLIOE_UNKNOWNCMD     /' command was unknown to callback '/
  CURLIOE_FAILRESTART    /' failed to restart the read '/
  CURLIOE_LAST           /' never use '/
end enum
#endif

#if defined(TIKO_OS_WINDOWS)
type curliocmd as int32
enum
  CURLIOCMD_NOP          /' no operation '/
  CURLIOCMD_RESTARTREAD  /' restart the read stream from start '/
  CURLIOCMD_LAST         /' never use '/
end enum
#elseif not (defined(TIKO_OS_WINDOWS))
type curliocmd as uint32
enum
  CURLIOCMD_NOP          /' no operation '/
  CURLIOCMD_RESTARTREAD  /' restart the read stream from start '/
  CURLIOCMD_LAST         /' never use '/
end enum
#endif

type curl_ioctl_callback as function cdecl( byval as CURL ptr, byval as int32, byval as any ptr ) as curlioerr

#ifndef CURL_DID_MEMORY_FUNC_TYPEDEFS
/'
 * The following typedef's are signatures of malloc, free, realloc, strdup and
 * calloc respectively. Function pointers of these types can be passed to the
 * curl_global_init_mem() function to set user defined memory management
 * callback routines.
 '/
type curl_malloc_callback as function cdecl( byval as uinteger ) as any ptr
type curl_free_callback as sub cdecl( byval as any ptr )
type curl_realloc_callback as function cdecl( byval as any ptr, byval as uinteger ) as any ptr
type curl_strdup_callback as function cdecl( byval as const zstring ptr ) as zstring ptr
type curl_calloc_callback as function cdecl( byval as uinteger, byval as uinteger ) as any ptr

#define CURL_DID_MEMORY_FUNC_TYPEDEFS
#endif

/' the kind of data that is passed to information_callback '/
#if defined(TIKO_OS_WINDOWS)
type curl_infotype as int32
enum
  CURLINFO_TEXT = 0
  CURLINFO_HEADER_IN     /' 1 '/
  CURLINFO_HEADER_OUT    /' 2 '/
  CURLINFO_DATA_IN       /' 3 '/
  CURLINFO_DATA_OUT      /' 4 '/
  CURLINFO_SSL_DATA_IN   /' 5 '/
  CURLINFO_SSL_DATA_OUT  /' 6 '/
  CURLINFO_END
end enum
#elseif not (defined(TIKO_OS_WINDOWS))
type curl_infotype as uint32
enum
  CURLINFO_TEXT = 0
  CURLINFO_HEADER_IN     /' 1 '/
  CURLINFO_HEADER_OUT    /' 2 '/
  CURLINFO_DATA_IN       /' 3 '/
  CURLINFO_DATA_OUT      /' 4 '/
  CURLINFO_SSL_DATA_IN   /' 5 '/
  CURLINFO_SSL_DATA_OUT  /' 6 '/
  CURLINFO_END
end enum
#endif

type curl_debug_callback as function cdecl( byval as CURL ptr, byval as curl_infotype, byval as zstring ptr, byval as uinteger, byval as any ptr ) as int32    /' whatever the user please '/

/' This is the CURLOPT_PREREQFUNCTION callback prototype. '/
type curl_prereq_callback as function cdecl( byval as any ptr, byval as zstring ptr, byval as zstring ptr, byval as int32, byval as int32 ) as int32

/' Return code for when the pre-request callback has terminated without
   any errors '/
#define CURL_PREREQFUNC_OK 0
/' Return code for when the pre-request callback wants to abort the
   request '/
#define CURL_PREREQFUNC_ABORT 1

/' All possible error codes from all sorts of curl functions. Future versions
   may return other values, stay prepared.

   Always add new return codes last. Never *EVER* remove any. The return
   codes must remain the same!
 '/

#if defined(TIKO_OS_WINDOWS)
type CURLcode as int32
enum
  CURLE_OK = 0
  CURLE_UNSUPPORTED_PROTOCOL     /' 1 '/
