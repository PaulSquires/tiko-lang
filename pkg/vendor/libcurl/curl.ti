#define CURL_GLOBAL_SSL (1 shl 0) /' no purpose since 7.57.0 '/
#define CURL_GLOBAL_WINSOCK (1 shl 1)
#define CURL_GLOBAL_WIN32 CURL_GLOBAL_WINSOCK /' for compatibility '/
#define CURL_GLOBAL_ALL (CURL_GLOBAL_SSL or CURL_GLOBAL_WINSOCK)
#define CURL_GLOBAL_NOTHING 0
#define CURL_GLOBAL_DEFAULT CURL_GLOBAL_ALL
#define CURL_GLOBAL_ACK_EINTR (1 shl 2)

/'****************************************************************************
 * Setup defines, protos etc for the sharing stuff.
 '/

/' Different data locks for a single share '/
#if defined(TIKO_OS_WINDOWS)
type curl_lock_data as int32
enum
  CURL_LOCK_DATA_NONE = 0
  /'  CURL_LOCK_DATA_SHARE is used internally to say that the locking is made
   *  to change the internal state of the share itself.
   '/
  CURL_LOCK_DATA_SHARE
  CURL_LOCK_DATA_COOKIE
  CURL_LOCK_DATA_DNS
  CURL_LOCK_DATA_SSL_SESSION
  CURL_LOCK_DATA_CONNECT
  CURL_LOCK_DATA_PSL
  CURL_LOCK_DATA_HSTS
  CURL_LOCK_DATA_LAST
end enum
#elseif not (defined(TIKO_OS_WINDOWS))
type curl_lock_data as uint32
enum
  CURL_LOCK_DATA_NONE = 0
  /'  CURL_LOCK_DATA_SHARE is used internally to say that the locking is made
   *  to change the internal state of the share itself.
   '/
  CURL_LOCK_DATA_SHARE
  CURL_LOCK_DATA_COOKIE
  CURL_LOCK_DATA_DNS
  CURL_LOCK_DATA_SSL_SESSION
  CURL_LOCK_DATA_CONNECT
  CURL_LOCK_DATA_PSL
  CURL_LOCK_DATA_HSTS
  CURL_LOCK_DATA_LAST
end enum
#endif

/' Different lock access types '/
#if defined(TIKO_OS_WINDOWS)
type curl_lock_access as int32
enum
  CURL_LOCK_ACCESS_NONE = 0    /' unspecified action '/
  CURL_LOCK_ACCESS_SHARED = 1  /' for read perhaps '/
  CURL_LOCK_ACCESS_SINGLE = 2  /' for write perhaps '/
  CURL_LOCK_ACCESS_LAST        /' never use '/
end enum
#elseif not (defined(TIKO_OS_WINDOWS))
type curl_lock_access as uint32
enum
  CURL_LOCK_ACCESS_NONE = 0    /' unspecified action '/
  CURL_LOCK_ACCESS_SHARED = 1  /' for read perhaps '/
  CURL_LOCK_ACCESS_SINGLE = 2  /' for write perhaps '/
  CURL_LOCK_ACCESS_LAST        /' never use '/
end enum
#endif

type curl_lock_function as sub cdecl( byval as CURL ptr, byval as curl_lock_data, byval as curl_lock_access, byval as any ptr )
type curl_unlock_function as sub cdecl( byval as CURL ptr, byval as curl_lock_data, byval as any ptr )

#if defined(TIKO_OS_WINDOWS)
type CURLSHcode as int32
enum
  CURLSHE_OK   /' all is fine '/
  CURLSHE_BAD_OPTION  /' 1 '/
  CURLSHE_IN_USE      /' 2 '/
  CURLSHE_INVALID     /' 3 '/
  CURLSHE_NOMEM       /' 4 out of memory '/
  CURLSHE_NOT_BUILT_IN  /' 5 feature not present in lib '/
  CURLSHE_LAST        /' never use '/
end enum
#elseif not (defined(TIKO_OS_WINDOWS))
type CURLSHcode as uint32
enum
  CURLSHE_OK   /' all is fine '/
  CURLSHE_BAD_OPTION  /' 1 '/
  CURLSHE_IN_USE      /' 2 '/
  CURLSHE_INVALID     /' 3 '/
  CURLSHE_NOMEM       /' 4 out of memory '/
  CURLSHE_NOT_BUILT_IN  /' 5 feature not present in lib '/
  CURLSHE_LAST        /' never use '/
end enum
#endif

#if defined(TIKO_OS_WINDOWS)
type CURLSHoption as int32
enum
  CURLSHOPT_NONE   /' do not use '/
  CURLSHOPT_SHARE    /' specify a data type to share '/
  CURLSHOPT_UNSHARE  /' specify which data type to stop sharing '/
  CURLSHOPT_LOCKFUNC    /' pass in a 'curl_lock_function' pointer '/
  CURLSHOPT_UNLOCKFUNC  /' pass in a 'curl_unlock_function' pointer '/
  CURLSHOPT_USERDATA    /' pass in a user data pointer used in the lock/unlock
                           callback functions '/
  CURLSHOPT_LAST  /' never use '/
end enum
#elseif not (defined(TIKO_OS_WINDOWS))
type CURLSHoption as uint32
enum
  CURLSHOPT_NONE   /' do not use '/
  CURLSHOPT_SHARE    /' specify a data type to share '/
  CURLSHOPT_UNSHARE  /' specify which data type to stop sharing '/
  CURLSHOPT_LOCKFUNC    /' pass in a 'curl_lock_function' pointer '/
  CURLSHOPT_UNLOCKFUNC  /' pass in a 'curl_unlock_function' pointer '/
  CURLSHOPT_USERDATA    /' pass in a user data pointer used in the lock/unlock
                           callback functions '/
  CURLSHOPT_LAST  /' never use '/
end enum
#endif

declare function curl_share_init( ) as CURLSH ptr
declare function curl_share_setopt( byval sh as CURLSH ptr, byval option_ as CURLSHoption, ... ) as CURLSHcode
declare function curl_share_cleanup( byval sh as CURLSH ptr ) as CURLSHcode

/'***************************************************************************
 * Structures for querying information about the curl library at runtime.
 '/

#if defined(TIKO_OS_WINDOWS)
type CURLversion as int32
enum
  CURLVERSION_FIRST     /' 7.10 '/
  CURLVERSION_SECOND    /' 7.11.1 '/
  CURLVERSION_THIRD     /' 7.12.0 '/
  CURLVERSION_FOURTH    /' 7.16.1 '/
  CURLVERSION_FIFTH     /' 7.57.0 '/
  CURLVERSION_SIXTH     /' 7.66.0 '/
  CURLVERSION_SEVENTH   /' 7.70.0 '/
  CURLVERSION_EIGHTH    /' 7.72.0 '/
  CURLVERSION_NINTH     /' 7.75.0 '/
  CURLVERSION_TENTH     /' 7.77.0 '/
  CURLVERSION_ELEVENTH  /' 7.87.0 '/
  CURLVERSION_TWELFTH   /' 8.8.0 '/
  CURLVERSION_LAST /' never actually use this '/
end enum
#elseif not (defined(TIKO_OS_WINDOWS))
type CURLversion as uint32
enum
  CURLVERSION_FIRST     /' 7.10 '/
  CURLVERSION_SECOND    /' 7.11.1 '/
  CURLVERSION_THIRD     /' 7.12.0 '/
  CURLVERSION_FOURTH    /' 7.16.1 '/
  CURLVERSION_FIFTH     /' 7.57.0 '/
  CURLVERSION_SIXTH     /' 7.66.0 '/
  CURLVERSION_SEVENTH   /' 7.70.0 '/
  CURLVERSION_EIGHTH    /' 7.72.0 '/
  CURLVERSION_NINTH     /' 7.75.0 '/
  CURLVERSION_TENTH     /' 7.77.0 '/
  CURLVERSION_ELEVENTH  /' 7.87.0 '/
  CURLVERSION_TWELFTH   /' 8.8.0 '/
  CURLVERSION_LAST /' never actually use this '/
end enum
#endif

/' The 'CURLVERSION_NOW' is the symbolic name meant to be used by programs
   that want to get version information. It is meant to be a built-in
   version number for what kind of struct the caller expects. If the struct
   ever changes, we redefine the NOW to another enum from above. '/
#define CURLVERSION_NOW CURLVERSION_TWELFTH

type curl_version_info_data
  age as CURLversion        /' age of the returned struct '/
  version as const zstring ptr      /' LIBCURL_VERSION '/
  version_num as uint32     /' LIBCURL_VERSION_NUM '/
  host as const zstring ptr /' OS/host/cpu/machine when configured '/
  features as int32         /' bitmask, see defines below '/
  ssl_version as const zstring ptr  /' human readable string '/
  ssl_version_num as clong  /' not used anymore, always 0 '/
  libz_version as const zstring ptr /' human readable string '/
  /' protocols is terminated by an entry with a NULL protoname '/
  protocols as const zstring const ptr ptr

  /' The fields below this were added in CURLVERSION_SECOND '/
  ares as const zstring ptr
  ares_num as int32

  /' This field was added in CURLVERSION_THIRD '/
  libidn as const zstring ptr

  /' These field were added in CURLVERSION_FOURTH '/

  /' Same as '_libiconv_version' if built with HAVE_ICONV '/
  iconv_ver_num as int32

  libssh_version as const zstring ptr /' human readable string '/

  /' These fields were added in CURLVERSION_FIFTH '/
  brotli_ver_num as uint32     /' Numeric Brotli version
                                  (MAJOR << 24) | (MINOR << 12) | PATCH '/
  brotli_version as const zstring ptr /' human readable string. '/

  /' These fields were added in CURLVERSION_SIXTH '/
  nghttp2_ver_num as uint32     /' Numeric nghttp2 version
                                   (MAJOR << 16) | (MINOR << 8) | PATCH '/
  nghttp2_version as const zstring ptr /' human readable string. '/
  quic_version as const zstring ptr    /' human readable quic (+ HTTP/3) library +
                                  version or NULL '/

  /' These fields were added in CURLVERSION_SEVENTH '/
  cainfo as const zstring ptr  /' the built-in default CURLOPT_CAINFO, might
                                  be NULL '/
  capath as const zstring ptr  /' the built-in default CURLOPT_CAPATH, might
                                  be NULL '/

  /' These fields were added in CURLVERSION_EIGHTH '/
  zstd_ver_num as uint32     /' Numeric Zstd version
                                  (MAJOR << 24) | (MINOR << 12) | PATCH '/
  zstd_version as const zstring ptr /' human readable string. '/

  /' These fields were added in CURLVERSION_NINTH '/
  hyper_version as const zstring ptr /' human readable string. '/

  /' These fields were added in CURLVERSION_TENTH '/
  gsasl_version as const zstring ptr /' human readable string. '/

  /' These fields were added in CURLVERSION_ELEVENTH '/
  /' feature_names is terminated by an entry with a NULL feature name '/
  feature_names as const zstring const ptr ptr

  /' These fields were added in CURLVERSION_TWELFTH '/
  rtmp_version as const zstring ptr /' human readable string. '/
end type
type curl_version_info_data__fwd as curl_version_info_data

#define CURL_VERSION_IPV6 (1 shl 0)       /' IPv6-enabled '/
#define CURL_VERSION_KERBEROS4 (1 shl 1)
#define CURL_VERSION_SSL (1 shl 2)        /' SSL options are present '/
#define CURL_VERSION_LIBZ (1 shl 3)       /' libz features are present '/
#define CURL_VERSION_NTLM (1 shl 4)       /' NTLM auth is supported '/
#define CURL_VERSION_GSSNEGOTIATE (1 shl 5)
#define CURL_VERSION_DEBUG (1 shl 6)      /' Built with debug capabilities '/
#define CURL_VERSION_ASYNCHDNS (1 shl 7)  /' Asynchronous DNS resolves '/
#define CURL_VERSION_SPNEGO (1 shl 8)     /' SPNEGO auth is supported '/
#define CURL_VERSION_LARGEFILE (1 shl 9)  /' Supports files larger than 2GB '/
#define CURL_VERSION_IDN (1 shl 10)
#define CURL_VERSION_SSPI (1 shl 11)      /' Built against Windows SSPI '/
#define CURL_VERSION_CONV (1 shl 12)      /' Character conversions supported '/
#define CURL_VERSION_CURLDEBUG (1 shl 13)
#define CURL_VERSION_TLSAUTH_SRP (1 shl 14) /' TLS-SRP auth is supported '/
#define CURL_VERSION_NTLM_WB (1 shl 15)
#define CURL_VERSION_HTTP2 (1 shl 16)     /' HTTP2 support built-in '/
#define CURL_VERSION_GSSAPI (1 shl 17)    /' Built against a GSS-API library '/
#define CURL_VERSION_KERBEROS5 (1 shl 18) /' Kerberos V5 auth is supported '/
#define CURL_VERSION_UNIX_SOCKETS (1 shl 19) /' Unix domain sockets support '/
#define CURL_VERSION_PSL (1 shl 20)
#define CURL_VERSION_HTTPS_PROXY (1 shl 21) /' HTTPS-proxy support built-in '/
#define CURL_VERSION_MULTI_SSL (1 shl 22) /' Multiple SSL backends available '/
#define CURL_VERSION_BROTLI (1 shl 23)    /' Brotli features are present. '/
#define CURL_VERSION_ALTSVC (1 shl 24)    /' Alt-Svc handling built-in '/
#define CURL_VERSION_HTTP3 (1 shl 25)     /' HTTP3 support built-in '/
#define CURL_VERSION_ZSTD (1 shl 26)      /' zstd features are present '/
#define CURL_VERSION_UNICODE (1 shl 27)   /' Unicode support on Windows '/
#define CURL_VERSION_HSTS (1 shl 28)      /' HSTS is supported '/
#define CURL_VERSION_GSASL (1 shl 29)     /' libgsasl is supported '/
#define CURL_VERSION_THREADSAFE (1 shl 30) /' libcurl API is thread-safe '/

/'
 * NAME curl_version_info()
 *
 * DESCRIPTION
 *
 * This function returns a pointer to a static copy of the version info
 * struct. See above.
 '/
declare function curl_version_info( byval stamp as CURLversion ) as curl_version_info_data ptr

/'
 * NAME curl_easy_strerror()
 *
 * DESCRIPTION
 *
 * The curl_easy_strerror function may be used to turn a CURLcode value
 * into the equivalent human readable error string. This is useful
 * for printing meaningful error messages.
 '/
declare function curl_easy_strerror( byval error_ as CURLcode ) as const zstring ptr

/'
 * NAME curl_share_strerror()
 *
 * DESCRIPTION
 *
 * The curl_share_strerror function may be used to turn a CURLSHcode value
 * into the equivalent human readable error string. This is useful
 * for printing meaningful error messages.
 '/
declare function curl_share_strerror( byval error_ as CURLSHcode ) as const zstring ptr

/'
 * NAME curl_easy_pause()
 *
 * DESCRIPTION
 *
 * The curl_easy_pause function pauses or unpauses transfers. Select the new
 * state by setting the action bitmask, use the convenience defines below.
 *
 '/
declare function curl_easy_pause( byval curl as CURL ptr, byval action as int32 ) as CURLcode

#define CURLPAUSE_RECV (1 shl 0)
#define CURLPAUSE_RECV_CONT 0

#define CURLPAUSE_SEND (1 shl 2)
#define CURLPAUSE_SEND_CONT 0

#define CURLPAUSE_ALL (CURLPAUSE_RECV or CURLPAUSE_SEND)
#define CURLPAUSE_CONT (CURLPAUSE_RECV_CONT or CURLPAUSE_SEND_CONT)

/'
 * NAME curl_easy_ssls_import()
 *
 * DESCRIPTION
 *
 * The curl_easy_ssls_import function adds a previously exported SSL session
 * to the SSL session cache of the easy handle (or the underlying share).
 '/
declare function curl_easy_ssls_import( byval curl as CURL ptr, _
                                        byval session_key as const zstring ptr, _
                                        byval shmac as const uint8 ptr, _
                                        byval shmac_len as uinteger, _
                                        byval sdata as const uint8 ptr, _
                                        byval sdata_len as uinteger ) as CURLcode

/' This is the curl_ssls_export_cb callback prototype. It
 * is passed to curl_easy_ssls_export() to extract SSL sessions/tickets. '/
'' C2T-TODO(unsupported) curl.h:3310 -- typedef 'curl_ssls_export_cb' names a function type, not a pointer to one
'' typedef CURLcode curl_ssls_export_cb(CURL *curl,
''                                      void *userptr,
''                                      const char *session_key,
''                                      const unsigned char *shmac,
''                                      size_t shmac_len,
''                                      const unsigned char *sdata,
''                                      size_t sdata_len,
''                                      curl_off_t valid_until,
''                                      int ietf_tls_id,
''                                      const char *alpn,
''                                      size_t earlydata_max);

/'
 * NAME curl_easy_ssls_export()
 *
 * DESCRIPTION
 *
 * The curl_easy_ssls_export function iterates over all SSL sessions stored
 * in the easy handle (or underlying share) and invokes the passed
 * callback.
 *
 '/
declare function curl_easy_ssls_export( byval curl as CURL ptr, _
                                        byval export_fn as function cdecl( byval as CURL ptr, byval as any ptr, byval as const zstring ptr, byval as const uint8 ptr, byval as uinteger, byval as const uint8 ptr, byval as uinteger, byval as curl_off_t, byval as int32, byval as const zstring ptr, byval as uinteger ) as CURLcode ptr, _
                                        byval userptr as any ptr ) as CURLcode

end extern

/' unfortunately, the easy.h and multi.h include files need options and info
   stuff before they can be included! '/
/' ---- easy.h (flattened) ---- '/
#ifndef CURLINC_EASY_H
#define CURLINC_EASY_H
/'**************************************************************************
 *                                  _   _ ____  _
 *  Project                     ___| | | |  _ \| |
