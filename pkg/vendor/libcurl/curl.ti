extern "C"

type curl_header
  name as zstring ptr    /' this might not use the same case '/
  value as zstring ptr
  amount as uinteger /' number of headers using this name '/
  index as uinteger  /' ... of this instance, 0 or higher '/
  origin as uint32     /' see bits below '/
  anchor as any ptr /' handle privately used by libcurl '/
end type

/' 'origin' bits '/
#define CURLH_HEADER (1 shl 0)   /' plain server header '/
#define CURLH_TRAILER (1 shl 1)  /' trailers '/
#define CURLH_CONNECT (1 shl 2)  /' CONNECT headers '/
#define CURLH_1XX (1 shl 3)      /' 1xx headers '/
#define CURLH_PSEUDO (1 shl 4)   /' pseudo headers '/

#if defined(TIKO_OS_WINDOWS)
type CURLHcode as int32
enum
  CURLHE_OK
  CURLHE_BADINDEX       /' header exists but not with this index '/
  CURLHE_MISSING        /' no such header exists '/
  CURLHE_NOHEADERS      /' no headers at all exist (yet) '/
  CURLHE_NOREQUEST      /' no request with this number was used '/
  CURLHE_OUT_OF_MEMORY  /' out of memory while processing '/
  CURLHE_BAD_ARGUMENT   /' a function argument was not okay '/
  CURLHE_NOT_BUILT_IN   /' if API was disabled in the build '/
end enum
#elseif not (defined(TIKO_OS_WINDOWS))
type CURLHcode as uint32
enum
  CURLHE_OK
  CURLHE_BADINDEX       /' header exists but not with this index '/
  CURLHE_MISSING        /' no such header exists '/
  CURLHE_NOHEADERS      /' no headers at all exist (yet) '/
  CURLHE_NOREQUEST      /' no request with this number was used '/
  CURLHE_OUT_OF_MEMORY  /' out of memory while processing '/
  CURLHE_BAD_ARGUMENT   /' a function argument was not okay '/
  CURLHE_NOT_BUILT_IN   /' if API was disabled in the build '/
end enum
#endif

declare function curl_easy_header( byval curl as CURL ptr, _
                                   byval name_ as const zstring ptr, _
                                   byval nameindex as uinteger, _
                                   byval origin as uint32, _
                                   byval request as int32, _
                                   byval hout as curl_header ptr ptr ) as CURLHcode

declare function curl_easy_nextheader( byval curl as CURL ptr, _
                                       byval origin as uint32, _
                                       byval request as int32, _
                                       byval prev as curl_header ptr ) as curl_header ptr

end extern

#endif /' CURLINC_HEADER_H '/
/' ---- end header.h ---- '/
