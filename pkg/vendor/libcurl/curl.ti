extern "C"

type curl_ws_frame
  age as int32          /' zero '/
  flags as int32        /' See the CURLWS_* defines '/
  offset as curl_off_t  /' the offset of this data into the frame '/
  bytesleft as curl_off_t /' number of pending bytes left of the payload '/
  len as uinteger       /' size of the current data chunk '/
end type

/' flag bits '/
#define CURLWS_TEXT (1 shl 0)
#define CURLWS_BINARY (1 shl 1)
#define CURLWS_CONT (1 shl 2)
#define CURLWS_CLOSE (1 shl 3)
#define CURLWS_PING (1 shl 4)
#define CURLWS_OFFSET (1 shl 5)

/'
 * NAME curl_ws_recv()
 *
 * DESCRIPTION
 *
 * Receives data from the websocket connection. Use after successful
 * curl_easy_perform() with CURLOPT_CONNECT_ONLY option.
 '/
declare function curl_ws_recv( byval curl as CURL ptr, byval buffer as any ptr, byval buflen as uinteger, _
                               byval recv as uinteger ptr, _
                               byval metap as const curl_ws_frame ptr ptr ) as CURLcode

/' flags for curl_ws_send() '/
#define CURLWS_PONG (1 shl 6)

/'
 * NAME curl_ws_send()
 *
 * DESCRIPTION
 *
 * Sends data over the websocket connection. Use after successful
 * curl_easy_perform() with CURLOPT_CONNECT_ONLY option.
 '/
declare function curl_ws_send( byval curl as CURL ptr, byval buffer_arg as const any ptr, _
                               byval buflen as uinteger, byval sent as uinteger ptr, _
                               byval fragsize as curl_off_t, _
                               byval flags as uint32 ) as CURLcode

/'
 * NAME curl_ws_start_frame()
 *
 * DESCRIPTION
 *
 * Buffers a websocket frame header with the given flags and length.
 * Errors when a previous frame is not complete, e.g. not all its
 * payload has been added.
 '/
declare function curl_ws_start_frame( byval curl as CURL ptr, _
                                      byval flags as uint32, _
                                      byval frame_len as curl_off_t ) as CURLcode

/' bits for the CURLOPT_WS_OPTIONS bitmask: '/
#define CURLWS_RAW_MODE (1 shl 0)
#define CURLWS_NOAUTOPONG (1 shl 1)

declare function curl_ws_meta( byval curl as CURL ptr ) as const curl_ws_frame ptr

end extern

#endif /' CURLINC_WEBSOCKETS_H '/
/' ---- end websockets.h ---- '/
