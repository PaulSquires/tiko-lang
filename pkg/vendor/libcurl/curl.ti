extern "C"

#if defined(TIKO_OS_WINDOWS)
type curl_easytype as int32
enum
  CURLOT_LONG     /' long (a range of values) '/
  CURLOT_VALUES   /'      (a defined set or bitmask) '/
  CURLOT_OFF_T    /' curl_off_t (a range of values) '/
  CURLOT_OBJECT   /' pointer (void *) '/
  CURLOT_STRING   /'         (char * to null-terminated buffer) '/
  CURLOT_SLIST    /'         (struct curl_slist *) '/
  CURLOT_CBPTR    /'         (void * passed as-is to a callback) '/
  CURLOT_BLOB     /' blob (struct curl_blob *) '/
  CURLOT_FUNCTION /' function pointer '/
end enum
#elseif not (defined(TIKO_OS_WINDOWS))
type curl_easytype as uint32
enum
  CURLOT_LONG     /' long (a range of values) '/
  CURLOT_VALUES   /'      (a defined set or bitmask) '/
  CURLOT_OFF_T    /' curl_off_t (a range of values) '/
  CURLOT_OBJECT   /' pointer (void *) '/
  CURLOT_STRING   /'         (char * to null-terminated buffer) '/
  CURLOT_SLIST    /'         (struct curl_slist *) '/
  CURLOT_CBPTR    /'         (void * passed as-is to a callback) '/
  CURLOT_BLOB     /' blob (struct curl_blob *) '/
  CURLOT_FUNCTION /' function pointer '/
end enum
#endif

/' Flag bits '/

/' "alias" means it is provided for old programs to remain functional,
   we prefer another name '/
#define CURLOT_FLAG_ALIAS (1 shl 0)

/' The CURLOPTTYPE_* id ranges can still be used to figure out what type/size
   to use for curl_easy_setopt() for the given id '/
type curl_easyoption
  name as const zstring ptr
  id as CURLoption
  type as curl_easytype
  flags as uint32
end type

declare function curl_easy_option_by_name( byval name_ as const zstring ptr ) as const curl_easyoption ptr

declare function curl_easy_option_by_id( byval id as CURLoption ) as const curl_easyoption ptr

declare function curl_easy_option_next( byval prev as const curl_easyoption ptr ) as const curl_easyoption ptr

end extern
#endif /' CURLINC_OPTIONS_H '/
/' ---- end options.h ---- '/
