/'
 * Bitmasks for CURLOPT_HTTPAUTH and CURLOPT_PROXYAUTH options:
 *
 * CURLAUTH_NONE         - No HTTP authentication
 * CURLAUTH_BASIC        - HTTP Basic authentication (default)
 * CURLAUTH_DIGEST       - HTTP Digest authentication
 * CURLAUTH_NEGOTIATE    - HTTP Negotiate (SPNEGO) authentication
 * CURLAUTH_GSSNEGOTIATE - Alias for CURLAUTH_NEGOTIATE (deprecated)
 * CURLAUTH_NTLM         - HTTP NTLM authentication
 * CURLAUTH_DIGEST_IE    - HTTP Digest authentication with IE flavor
 * CURLAUTH_NTLM_WB      - HTTP NTLM authentication delegated to winbind helper
 * CURLAUTH_BEARER       - HTTP Bearer token authentication
 * CURLAUTH_ONLY         - Use together with a single other type to force no
 *                         authentication or that single type
 * CURLAUTH_ANY          - All fine types set
 * CURLAUTH_ANYSAFE      - All fine types except Basic
 '/

'' C2T-NOTE(value) curl.h:832 -- clang's value; a cast, which tiko's preprocessor does not evaluate
#define CURLAUTH_NONE 0
'' C2T-NOTE(value) curl.h:833 -- clang's value; a cast, which tiko's preprocessor does not evaluate
#define CURLAUTH_BASIC 1
'' C2T-NOTE(value) curl.h:834 -- clang's value; a cast, which tiko's preprocessor does not evaluate
#define CURLAUTH_DIGEST 2
'' C2T-NOTE(value) curl.h:835 -- clang's value; a cast, which tiko's preprocessor does not evaluate
#define CURLAUTH_NEGOTIATE 4
/' Deprecated since the advent of CURLAUTH_NEGOTIATE '/
#define CURLAUTH_GSSNEGOTIATE CURLAUTH_NEGOTIATE
/' Used for CURLOPT_SOCKS5_AUTH to stay terminologically correct '/
#define CURLAUTH_GSSAPI CURLAUTH_NEGOTIATE
'' C2T-NOTE(value) curl.h:840 -- clang's value; a cast, which tiko's preprocessor does not evaluate
#define CURLAUTH_NTLM 8
'' C2T-NOTE(value) curl.h:841 -- clang's value; a cast, which tiko's preprocessor does not evaluate
#define CURLAUTH_DIGEST_IE 16
#ifndef CURL_NO_OLDIES
  /' functionality removed since 8.8.0 '/
'' C2T-NOTE(value) curl.h:844 -- clang's value; a cast, which tiko's preprocessor does not evaluate
#define CURLAUTH_NTLM_WB 32
#endif
'' C2T-NOTE(value) curl.h:846 -- clang's value; a cast, which tiko's preprocessor does not evaluate
#define CURLAUTH_BEARER 64
'' C2T-NOTE(value) curl.h:847 -- clang's value; a cast, which tiko's preprocessor does not evaluate
#define CURLAUTH_AWS_SIGV4 128
'' C2T-NOTE(value) curl.h:848 -- clang's value; a cast, which tiko's preprocessor does not evaluate
#define CURLAUTH_HTTPSIG 256
'' C2T-NOTE(value) curl.h:849 -- clang's value; a cast, which tiko's preprocessor does not evaluate
#define CURLAUTH_ONLY 2147483648ull
'' C2T-NOTE(value) curl.h:850 -- clang's value; a cast, which tiko's preprocessor does not evaluate
#define CURLAUTH_ANY 4294967023ull
'' C2T-NOTE(value) curl.h:853 -- clang's value; a cast, which tiko's preprocessor does not evaluate
#define CURLAUTH_ANYSAFE 4294967022ull

/' constants for CURLOPT_HTTPSIG_ALGORITHM '/
#define CURLHTTPSIG_NONE 0
#define CURLHTTPSIG_ED25519 1
#define CURLHTTPSIG_HMAC_SHA256 2

/' all types supported by server '/
'' C2T-NOTE(value) curl.h:863 -- clang's value; a cast, which tiko's preprocessor does not evaluate
#define CURLSSH_AUTH_ANY 4294967295ull
#define CURLSSH_AUTH_NONE 0              /' none allowed, silly but complete '/
#define CURLSSH_AUTH_PUBLICKEY (1 shl 0) /' public/private key files '/
#define CURLSSH_AUTH_PASSWORD (1 shl 1)  /' password '/
#define CURLSSH_AUTH_HOST (1 shl 2)      /' host key files '/
#define CURLSSH_AUTH_KEYBOARD (1 shl 3)  /' keyboard interactive '/
#define CURLSSH_AUTH_AGENT (1 shl 4)     /' agent (ssh-agent, pageant...) '/
#define CURLSSH_AUTH_GSSAPI (1 shl 5)    /' gssapi (kerberos, ...) '/
#define CURLSSH_AUTH_DEFAULT CURLSSH_AUTH_ANY

#define CURLGSSAPI_DELEGATION_NONE 0              /' no delegation (default) '/
#define CURLGSSAPI_DELEGATION_POLICY_FLAG (1 shl 0) /' if permitted by policy '/
#define CURLGSSAPI_DELEGATION_FLAG (1 shl 1)      /' delegate always '/

#define CURL_ERROR_SIZE 256

