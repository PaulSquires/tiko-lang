#define CURLSSLBACKEND_DARWINSSL CURLSSLBACKEND_SECURETRANSPORT

/' bits for the CURLOPT_FOLLOWLOCATION option '/
#define CURLFOLLOW_ALL 1        /' generic follow redirects '/

/' Do not use the custom method in the follow-up request if the HTTP code
   instructs so (301, 302, 303). '/
#define CURLFOLLOW_OBEYCODE 2

/' Only use the custom method in the first request, always reset in the next '/
#define CURLFOLLOW_FIRSTONLY 3

type curl_slist__fwd as curl_slist
type curl_httppost
  next as curl_httppost ptr         /' next entry in the list '/
  name as zstring ptr               /' pointer to allocated name '/
  namelength as clong               /' length of name length '/
  contents as zstring ptr           /' pointer to allocated data contents '/
  contentslength as clong           /' length of contents field, see also
                                       CURL_HTTPPOST_LARGE '/
  buffer as zstring ptr             /' pointer to allocated buffer contents '/
  bufferlength as clong             /' length of buffer field '/
  contenttype as zstring ptr        /' Content-Type '/
  contentheader as curl_slist__fwd ptr /' list of extra headers for this form '/
  more as curl_httppost ptr         /' if one field name has more than one
                                       file, this link should link to following
                                       files '/
  flags as clong                    /' as defined below '/

/' specified content is a filename '/
/' specified content is a filename '/
/' name is only stored pointer do not free in formfree '/
/' contents is only stored pointer do not free in formfree '/
/' upload file from buffer '/
/' upload file from pointer contents '/
/' upload file contents by using the regular read callback to get the data and
   pass the given pointer as custom pointer '/
/' use size in 'contentlen', added in 7.46.0 '/

  showfilename as zstring ptr       /' The filename to show. If not set, the
                                       actual filename is used (if this is
                                       a file part) '/
  userp as any ptr                  /' custom pointer used for
                                       HTTPPOST_CALLBACK posts '/
  contentlen as curl_off_t          /' alternative length of contents
                                       field. Used if CURL_HTTPPOST_LARGE is
                                       set. Added in 7.46.0 '/
end type

/' This is a return code for the progress callback that, when returned,
   signals libcurl to continue executing the default progress function '/
#define CURL_PROGRESSFUNC_CONTINUE &h10000001

/' This is the CURLOPT_PROGRESSFUNCTION callback prototype. It is now
   considered deprecated but was the only choice up until 7.31.0 '/
type curl_progress_callback as function cdecl( byval as any ptr, byval as float64, byval as float64, byval as float64, byval as float64 ) as int32

/' This is the CURLOPT_XFERINFOFUNCTION callback prototype. It was introduced
   in 7.32.0, avoids the use of floating point numbers and provides more
   detailed information. '/
type curl_xferinfo_callback as function cdecl( byval as any ptr, byval as curl_off_t, byval as curl_off_t, byval as curl_off_t, byval as curl_off_t ) as int32

#ifndef CURL_MAX_READ_SIZE
  /' The maximum receive buffer size configurable via CURLOPT_BUFFERSIZE. '/
#define CURL_MAX_READ_SIZE ((10 * 1024) * 1024)
#endif

#ifndef CURL_MAX_WRITE_SIZE
  /' Tests have proven that 20K is a bad buffer size for uploads on Windows,
     while 16K for some odd reason performed a lot better. We do the ifndef
     check to allow this value to easier be changed at build time for those
     who feel adventurous. The practical minimum is about 400 bytes since
     libcurl uses a buffer of this size as a scratch area (unrelated to
     network send operations). '/
#define CURL_MAX_WRITE_SIZE 16384
#endif

#ifndef CURL_MAX_HTTP_HEADER
/' The only reason to have a max limit for this is to avoid the risk of a bad
   server feeding libcurl with a never-ending header that causes reallocs
   infinitely '/
#define CURL_MAX_HTTP_HEADER (100 * 1024)
#endif

/' This is a magic return code for the write callback that, when returned,
   signals libcurl to pause receiving on the current transfer. '/
#define CURL_WRITEFUNC_PAUSE &h10000001

/' This is a magic return code for the write callback that, when returned,
   signals an error from the callback. '/
#define CURL_WRITEFUNC_ERROR &hFFFFFFFF

type curl_write_callback as function cdecl( byval as zstring ptr, byval as uinteger, byval as uinteger, byval as any ptr ) as uinteger

/' This callback is called when a new resolver request is made '/
type curl_resolver_start_callback as function cdecl( byval as any ptr, byval as any ptr, byval as any ptr ) as int32

/' enumeration of file types '/
#if defined(TIKO_OS_WINDOWS)
type curlfiletype as int32
enum
  CURLFILETYPE_FILE = 0
  CURLFILETYPE_DIRECTORY
  CURLFILETYPE_SYMLINK
  CURLFILETYPE_DEVICE_BLOCK
  CURLFILETYPE_DEVICE_CHAR
  CURLFILETYPE_NAMEDPIPE
  CURLFILETYPE_SOCKET
  CURLFILETYPE_DOOR  /' is possible only on Sun Solaris now '/

  CURLFILETYPE_UNKNOWN /' should never occur '/
end enum
#elseif not (defined(TIKO_OS_WINDOWS))
type curlfiletype as uint32
enum
  CURLFILETYPE_FILE = 0
  CURLFILETYPE_DIRECTORY
  CURLFILETYPE_SYMLINK
  CURLFILETYPE_DEVICE_BLOCK
  CURLFILETYPE_DEVICE_CHAR
  CURLFILETYPE_NAMEDPIPE
  CURLFILETYPE_SOCKET
  CURLFILETYPE_DOOR  /' is possible only on Sun Solaris now '/

  CURLFILETYPE_UNKNOWN /' should never occur '/
end enum
#endif

#define CURLFINFOFLAG_KNOWN_FILENAME (1 shl 0)
#define CURLFINFOFLAG_KNOWN_FILETYPE (1 shl 1)
#define CURLFINFOFLAG_KNOWN_TIME (1 shl 2)
#define CURLFINFOFLAG_KNOWN_PERM (1 shl 3)
#define CURLFINFOFLAG_KNOWN_UID (1 shl 4)
#define CURLFINFOFLAG_KNOWN_GID (1 shl 5)
#define CURLFINFOFLAG_KNOWN_SIZE (1 shl 6)
#define CURLFINFOFLAG_KNOWN_HLINKCOUNT (1 shl 7)

/' Information about a single file, used when doing FTP wildcard matching '/
type curl_fileinfo_strings_t
    time as zstring ptr
    perm as zstring ptr
    user as zstring ptr
    group as zstring ptr
    target as zstring ptr
end type
type curl_fileinfo
  filename as zstring ptr
  filetype as curlfiletype
  time as time_t /' always zero! '/
  perm as uint32
  uid as int32
  gid as int32
  size as curl_off_t
  hardlinks as clong

  strings as curl_fileinfo_strings_t
    /' If some of these fields is not NULL, it is a pointer to b_data. '/ /' pointer to the target filename of a symlink '/

  flags as uint32

  /' These are libcurl private struct fields. Previously used by libcurl, so
     they must never be interfered with. '/
  b_data as zstring ptr
  b_size as uinteger
  b_used as uinteger
end type

/' return codes for CURLOPT_CHUNK_BGN_FUNCTION '/
#define CURL_CHUNK_BGN_FUNC_OK 0
#define CURL_CHUNK_BGN_FUNC_FAIL 1    /' tell the lib to end the task '/
#define CURL_CHUNK_BGN_FUNC_SKIP 2    /' skip this chunk over '/

/' if splitting of data transfer is enabled, this callback is called before
   download of an individual chunk started. Note that parameter "remains" works
   only for FTP wildcard downloading (for now), otherwise is not used '/
type curl_chunk_bgn_callback as function cdecl( byval as const any ptr, byval as any ptr, byval as int32 ) as clong

/' return codes for CURLOPT_CHUNK_END_FUNCTION '/
#define CURL_CHUNK_END_FUNC_OK 0
#define CURL_CHUNK_END_FUNC_FAIL 1    /' tell the lib to end the task '/

/' If splitting of data transfer is enabled this callback is called after
   download of an individual chunk finished.
   Note! After this callback was set then it have to be called FOR ALL chunks.
   Even if downloading of this chunk was skipped in CHUNK_BGN_FUNC.
   This is the reason why we do not need "transfer_info" parameter in this
   callback and we are not interested in "remains" parameter too. '/
type curl_chunk_end_callback as function cdecl( byval as any ptr ) as clong

/' return codes for FNMATCHFUNCTION '/
#define CURL_FNMATCHFUNC_MATCH 0    /' string corresponds to the pattern '/
#define CURL_FNMATCHFUNC_NOMATCH 1  /' pattern does not match the string '/
#define CURL_FNMATCHFUNC_FAIL 2     /' an error occurred '/

/' callback type for wildcard downloading pattern matching. If the
   string matches the pattern, return CURL_FNMATCHFUNC_MATCH value, etc. '/
type curl_fnmatch_callback as function cdecl( byval as any ptr, byval as const zstring ptr, byval as const zstring ptr ) as int32

/' These are the return codes for the seek callbacks '/
#define CURL_SEEKFUNC_OK 0
#define CURL_SEEKFUNC_FAIL 1     /' fail the entire transfer '/
#define CURL_SEEKFUNC_CANTSEEK 2
type curl_seek_callback as function cdecl( byval as any ptr, byval as curl_off_t, byval as int32 ) as int32 /' 'whence' '/

/' This is a return code for the read callback that, when returned,
   signals libcurl to immediately abort the current transfer. '/
#define CURL_READFUNC_ABORT &h10000000
/' This is a return code for the read callback that, when returned,
   signals libcurl to pause sending data on the current transfer. '/
#define CURL_READFUNC_PAUSE &h10000001

/' Return code for when the trailing headers' callback has terminated
   without any errors '/
#define CURL_TRAILERFUNC_OK 0
/' Return code for when was an error in the trailing header's list and we
  want to abort the request '/
#define CURL_TRAILERFUNC_ABORT 1

type curl_read_callback as function cdecl( byval as zstring ptr, byval as uinteger, byval as uinteger, byval as any ptr ) as uinteger

type curl_trailer_callback as function cdecl( byval as curl_slist__fwd ptr ptr, byval as any ptr ) as int32

