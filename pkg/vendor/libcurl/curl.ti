extern "C"

/' the error codes for the URL API '/
#if defined(TIKO_OS_WINDOWS)
type CURLUcode as int32
enum
  CURLUE_OK
  CURLUE_BAD_HANDLE           /' 1 '/
  CURLUE_BAD_PARTPOINTER      /' 2 '/
  CURLUE_MALFORMED_INPUT      /' 3 '/
  CURLUE_BAD_PORT_NUMBER      /' 4 '/
  CURLUE_UNSUPPORTED_SCHEME   /' 5 '/
  CURLUE_URLDECODE            /' 6 '/
  CURLUE_OUT_OF_MEMORY        /' 7 '/
  CURLUE_USER_NOT_ALLOWED     /' 8 '/
  CURLUE_UNKNOWN_PART         /' 9 '/
  CURLUE_NO_SCHEME            /' 10 '/
  CURLUE_NO_USER              /' 11 '/
  CURLUE_NO_PASSWORD          /' 12 '/
  CURLUE_NO_OPTIONS           /' 13 '/
  CURLUE_NO_HOST              /' 14 '/
  CURLUE_NO_PORT              /' 15 '/
  CURLUE_NO_QUERY             /' 16 '/
  CURLUE_NO_FRAGMENT          /' 17 '/
  CURLUE_NO_ZONEID            /' 18 '/
  CURLUE_BAD_FILE_URL         /' 19 '/
  CURLUE_BAD_FRAGMENT         /' 20 '/
  CURLUE_BAD_HOSTNAME         /' 21 '/
  CURLUE_BAD_IPV6             /' 22 '/
  CURLUE_BAD_LOGIN            /' 23 '/
  CURLUE_BAD_PASSWORD         /' 24 '/
  CURLUE_BAD_PATH             /' 25 '/
  CURLUE_BAD_QUERY            /' 26 '/
  CURLUE_BAD_SCHEME           /' 27 '/
  CURLUE_BAD_SLASHES          /' 28 '/
  CURLUE_BAD_USER             /' 29 '/
  CURLUE_LACKS_IDN            /' 30 '/
  CURLUE_TOO_LARGE            /' 31 '/
  CURLUE_BACKSLASH            /' 32 '/
  CURLUE_LAST
end enum
#elseif not (defined(TIKO_OS_WINDOWS))
type CURLUcode as uint32
enum
  CURLUE_OK
  CURLUE_BAD_HANDLE           /' 1 '/
  CURLUE_BAD_PARTPOINTER      /' 2 '/
  CURLUE_MALFORMED_INPUT      /' 3 '/
  CURLUE_BAD_PORT_NUMBER      /' 4 '/
  CURLUE_UNSUPPORTED_SCHEME   /' 5 '/
  CURLUE_URLDECODE            /' 6 '/
  CURLUE_OUT_OF_MEMORY        /' 7 '/
  CURLUE_USER_NOT_ALLOWED     /' 8 '/
  CURLUE_UNKNOWN_PART         /' 9 '/
  CURLUE_NO_SCHEME            /' 10 '/
  CURLUE_NO_USER              /' 11 '/
  CURLUE_NO_PASSWORD          /' 12 '/
  CURLUE_NO_OPTIONS           /' 13 '/
  CURLUE_NO_HOST              /' 14 '/
  CURLUE_NO_PORT              /' 15 '/
  CURLUE_NO_QUERY             /' 16 '/
  CURLUE_NO_FRAGMENT          /' 17 '/
  CURLUE_NO_ZONEID            /' 18 '/
  CURLUE_BAD_FILE_URL         /' 19 '/
  CURLUE_BAD_FRAGMENT         /' 20 '/
  CURLUE_BAD_HOSTNAME         /' 21 '/
  CURLUE_BAD_IPV6             /' 22 '/
  CURLUE_BAD_LOGIN            /' 23 '/
  CURLUE_BAD_PASSWORD         /' 24 '/
  CURLUE_BAD_PATH             /' 25 '/
  CURLUE_BAD_QUERY            /' 26 '/
  CURLUE_BAD_SCHEME           /' 27 '/
  CURLUE_BAD_SLASHES          /' 28 '/
  CURLUE_BAD_USER             /' 29 '/
  CURLUE_LACKS_IDN            /' 30 '/
  CURLUE_TOO_LARGE            /' 31 '/
  CURLUE_BACKSLASH            /' 32 '/
  CURLUE_LAST
end enum
#endif

#if defined(TIKO_OS_WINDOWS)
type CURLUPart as int32
enum
  CURLUPART_URL
  CURLUPART_SCHEME
  CURLUPART_USER
  CURLUPART_PASSWORD
  CURLUPART_OPTIONS
  CURLUPART_HOST
  CURLUPART_PORT
  CURLUPART_PATH
  CURLUPART_QUERY
  CURLUPART_FRAGMENT
  CURLUPART_ZONEID /' added in 7.65.0 '/
end enum
#elseif not (defined(TIKO_OS_WINDOWS))
type CURLUPart as uint32
enum
  CURLUPART_URL
  CURLUPART_SCHEME
  CURLUPART_USER
  CURLUPART_PASSWORD
  CURLUPART_OPTIONS
  CURLUPART_HOST
  CURLUPART_PORT
  CURLUPART_PATH
  CURLUPART_QUERY
  CURLUPART_FRAGMENT
  CURLUPART_ZONEID /' added in 7.65.0 '/
end enum
#endif

#define CURLU_DEFAULT_PORT (1 shl 0)      /' return default port number '/
#define CURLU_NO_DEFAULT_PORT (1 shl 1)
#define CURLU_DEFAULT_SCHEME (1 shl 2)
#define CURLU_NON_SUPPORT_SCHEME (1 shl 3) /' allow non-supported scheme '/
#define CURLU_PATH_AS_IS (1 shl 4)        /' leave dot sequences '/
#define CURLU_DISALLOW_USER (1 shl 5)     /' no user+password allowed '/
#define CURLU_URLDECODE (1 shl 6)         /' URL decode on get '/
#define CURLU_URLENCODE (1 shl 7)         /' URL encode on set '/
#define CURLU_APPENDQUERY (1 shl 8)       /' append a form style part '/
#define CURLU_GUESS_SCHEME (1 shl 9)      /' legacy curl-style guessing '/
#define CURLU_NO_AUTHORITY (1 shl 10)
#define CURLU_ALLOW_SPACE (1 shl 11)      /' Allow spaces in the URL '/
#define CURLU_PUNYCODE (1 shl 12)         /' get the hostname in punycode '/
#define CURLU_PUNY2IDN (1 shl 13)         /' punycode => IDN conversion '/
#define CURLU_GET_EMPTY (1 shl 14)
#define CURLU_NO_GUESS_SCHEME (1 shl 15)  /' for get, do not accept a guess '/

type Curl_URL_2__fwd as Curl_URL_2
type CURLU as Curl_URL_2

/'
 * curl_url() creates a new CURLU handle and returns a pointer to it.
 * Must be freed with curl_url_cleanup().
 '/
declare function curl_url( ) as CURLU ptr

/'
 * curl_url_cleanup() frees the CURLU handle and related resources used for
 * the URL parsing. It does not free strings previously returned with the URL
 * API.
 '/
declare sub curl_url_cleanup( byval u as CURLU ptr )

/'
 * curl_url_dup() duplicates a CURLU handle and returns a new copy. The new
 * handle must also be freed with curl_url_cleanup().
 '/
declare function curl_url_dup( byval in as const CURLU ptr ) as CURLU ptr

/'
 * curl_url_get() extracts a specific part of the URL from a CURLU
 * handle. Returns error code. The returned pointer MUST be freed with
 * curl_free() afterwards.
 '/
declare function curl_url_get( byval u as const CURLU ptr, byval what as CURLUPart, _
                               byval part as zstring ptr ptr, byval flags as uint32 ) as CURLUcode

/'
 * curl_url_set() sets a specific part of the URL in a CURLU handle. Returns
 * error code. The passed in string is copied. Passing a NULL instead of
 * a part string, clears that part.
 '/
declare function curl_url_set( byval u as CURLU ptr, byval what as CURLUPart, _
                               byval part as const zstring ptr, byval flags as uint32 ) as CURLUcode

/'
 * curl_url_strerror() turns a CURLUcode value into the equivalent human
 * readable error string. This is useful for printing meaningful error
 * messages.
 '/
declare function curl_url_strerror( byval error_ as CURLUcode ) as const zstring ptr

end extern

#endif /' CURLINC_URLAPI_H '/
/' ---- end urlapi.h ---- '/
