'' <stdarg.h>: built into tiko
#include once "crt/stdio.bi" /' needed for FILE '/

extern "C"

#ifndef CURL_TEMP_PRINTF
#if (((((defined(__GNUC__) orelse defined(__clang__)) orelse defined(__IAR_SYSTEMS_ICC__)) andalso 201112) andalso (201112 >= 199901)) andalso ((defined(CURL_NO_FMT_CHECKS)) = 0))
#if (0 andalso ((defined(__clang__)) = 0))
#ifdef __MINGW_PRINTF_FORMAT  /' mingw-w64 3.0.0+. Needs stdio.h. '/
'' C2T-TODO(function-like-macro) curl.h:4475 -- '__MINGW_PRINTF_FORMAT' is nothing tiko declares
'' #define CURL_TEMP_PRINTF(fmt, arg) \
''   __attribute__((format(__MINGW_PRINTF_FORMAT, fmt, arg)))
#else
#define CURL_TEMP_PRINTF(fmt, arg)
#endif
#else
'' C2T-TODO(function-like-macro) curl.h:4481 -- 'printf' is nothing tiko declares
'' #define CURL_TEMP_PRINTF(fmt, arg) \
''   __attribute__((format(printf, fmt, arg)))
#endif
#else
#define CURL_TEMP_PRINTF(fmt, arg)
#endif
#endif

declare function curl_mprintf( byval format as const zstring ptr, ... ) as int32
declare function curl_mfprintf( byval fd as FILE ptr, byval format as const zstring ptr, ... ) as int32
declare function curl_msprintf( byval buffer as zstring ptr, byval format as const zstring ptr, ... ) as int32
declare function curl_msnprintf( byval buffer as zstring ptr, byval maxlength as uinteger, _
                                 byval format as const zstring ptr, ... ) as int32
declare function curl_mvprintf( byval format as const zstring ptr, byval args as cva_list ) as int32
declare function curl_mvfprintf( byval fd as FILE ptr, byval format as const zstring ptr, byval args as cva_list ) as int32
declare function curl_mvsprintf( byval buffer as zstring ptr, byval format as const zstring ptr, byval args as cva_list ) as int32
declare function curl_mvsnprintf( byval buffer as zstring ptr, byval maxlength as uinteger, _
                                  byval format as const zstring ptr, byval args as cva_list ) as int32
declare function curl_maprintf( byval format as const zstring ptr, ... ) as zstring ptr
declare function curl_mvaprintf( byval format as const zstring ptr, byval args as cva_list ) as zstring ptr

#undef CURL_TEMP_PRINTF

end extern

#endif /' CURLINC_MPRINTF_H '/
/' ---- end mprintf.h ---- '/

/' the typechecker does not work in C++ (yet) '/
#if (((((defined(__GNUC__) andalso defined(__GNUC_MINOR__)) andalso ((__GNUC__ > 4) orelse ((__GNUC__ = 4) andalso (__GNUC_MINOR__ >= 3)))) orelse (defined(__clang__) andalso (__clang_major__ >= 14))) andalso ((0) = 0)) andalso ((defined(CURL_DISABLE_TYPECHECK)) = 0))
#include once "typecheck-gcc.ti"
#else
'' C2T-TODO(conditional) curl.h:4528 -- tiko would take this branch where clang does not
'' #if defined(__STDC__) && (__STDC__ >= 1)
/' This preprocessor magic ensures that application authors pass exactly three
   arguments to these functions. For compatibility with C++ global namespace
   '::' and reusing these symbols as method names, while also avoiding
   recursive macros, use a two-stage solution. '/
#if not (defined(TIKO_OS_WINDOWS))
'' C2T-TODO(function-like-macro) curl.h:4533 -- a ')' is missing
'' #define curl_exactly_three_arguments(a, b, c) (a, b, c)
#endif
#if not (defined(TIKO_OS_WINDOWS))
'' C2T-TODO(function-like-macro) curl.h:4534 -- 'curl_exactly_three_arguments' after the expression
'' #define curl_easy_setopt(handle, opt, param) \
''   curl_easy_setopt curl_exactly_three_arguments(handle, opt, param)
#endif
#if not (defined(TIKO_OS_WINDOWS))
'' C2T-TODO(function-like-macro) curl.h:4536 -- 'curl_exactly_three_arguments' after the expression
'' #define curl_easy_getinfo(handle, info, arg) \
''   curl_easy_getinfo curl_exactly_three_arguments(handle, info, arg)
#endif
#if not (defined(TIKO_OS_WINDOWS))
'' C2T-TODO(function-like-macro) curl.h:4538 -- 'curl_exactly_three_arguments' after the expression
'' #define curl_share_setopt(share, opt, param) \
''   curl_share_setopt curl_exactly_three_arguments(share, opt, param)
#endif
#if not (defined(TIKO_OS_WINDOWS))
'' C2T-TODO(function-like-macro) curl.h:4540 -- 'curl_exactly_three_arguments' after the expression
'' #define curl_multi_setopt(handle, opt, param) \
''   curl_multi_setopt curl_exactly_three_arguments(handle, opt, param)
#endif
'' C2T-TODO(conditional) curl.h:4542 -- tiko would take this branch where clang does not
'' #endif /* __STDC__ >= 1 */
#endif /' gcc >= 4.3 && !__cplusplus && !CURL_DISABLE_TYPECHECK '/

