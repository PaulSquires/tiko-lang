'' libssh2-residue.ti -- what libssh2.ti, libssh2_sftp.ti and libssh2_publickey.ti could not
'' carry, written by hand. Against libssh2 1.11.1's libssh2.h, libssh2_sftp.h and
'' libssh2_publickey.h, the files the three banners name by SHA-256.
''
'' 69 TODOs (58 + 9 + 2). What a program can call is here:
''   libssh2_socket_t, libssh2_session_handshake (Windows)
''                       libssh2.h's 'typedef SOCKET libssh2_socket_t': SOCKET is UINT_PTR. c2t
''                       refused it, and the one routine taking it, on Windows only.
''   libssh2_scp_send64  refused on every pass for time_t, which is 64 bits on all three targets
''                       (Windows' __time64_t, Linux's and macOS's long).
''   libssh2_scp_stat    the record libssh2_scp_recv2 fills -- c2t declares it only by name.
''                       MEASURED (claude-docs probes/ft1/stat/statlayout.c, with each host's C
''                       compiler): Windows _stati64 56 bytes; Linux x86-64 struct stat 144,
''                       arm64 128 (glibc's generic layout: a different one); macOS 144, its
''                       st_mtime before st_size (RFC-0004 P3). Only st_mode, st_size and st_mtime
''                       are named; the rest is padding. Pass it as cast( libssh2_struct_stat ptr, @st ).
''   LIBSSH2_SSH_BANNER, LIBSSH2_SSH_DEFAULT_BANNER, LIBSSH2_SSH_DEFAULT_BANNER_WITH_CRLF
''                       C's string-literal concatenation, written with & (tiko joins no
''                       adjacent literals).
''   the convenience macros over the _ex routines -- libssh2_session_init, libssh2_userauth_password,
''                       libssh2_channel_open_session, _forward_listen, _request_pty, _x11_req,
''                       _shell, _exec, _subsystem, _window_read, _window_write,
''                       libssh2_sftp_readdir: C's NULL is nullptr, its strlen crt's strlen
''                       (libssh2.ti includes crt/string.bi), sizeof("x") - 1 the literal's length.
''   LIBSSH2_SFTP_S_ISLNK .. _ISSOCK
''                       tiko's truth value: -1 where C's is 1. Test them, do not add them.
'' The other TODOs need nothing:
''   - the LIBSSH2_*_FUNC macros spell callback signatures in C; the routines that take
''     callbacks are translated with them expanded (libssh2_session_init_ex, _callback_set2).
''     A tiko callback is a cdecl proc with that signature.
''   - LIBSSH2_DEPRECATED is an attribute; LIBSSH2_SOCKET_CLOSE is closesocket / close, which a
''     program calls itself; the system headers are winsock2's, sys/types', sys/stat's, io.h's.
''   - libssh2_cb_generic is a function TYPE; libssh2_session_callback_set2 takes and returns
''     'sub cdecl( ) ptr', which is what it means.
''   - libssh2_scp_recv (deprecated: 'struct stat *', the 32-bit one on Windows): use
''     libssh2_scp_recv2. libssh2_publickey_attribute(_fast) build a C initializer list: fill a
''     libssh2_publickey_attribute record's five fields instead.
''
'' A c2t finding behind libssh2_scp_stat (claude-docs RFC-0004 P1): libssh2.h defines
'' LIBSSH2_USE_WIN32_LARGE_FILES in two branches, and c2t renamed the second, identical name as a
'' "case-insensitive collision" (_2); and it keeps the '#if defined(_MSC_VER)' compiler test as
'' text, which tiko does not define. So libssh2.ti's Windows libssh2_struct_stat names _stat where
'' the C library -- clang defines _MSC_VER -- uses _stati64. Both are only names there (nothing
'' declares either record), so the pointer is the same; libssh2_scp_stat is the layout.
#pragma once

#ifdef TIKO_OS_WINDOWS
    type libssh2_socket_t as uinteger
    extern "C"
    declare function libssh2_session_handshake( byval session as LIBSSH2_SESSION ptr, byval sock as libssh2_socket_t ) as int32
    end extern
#endif

extern "C"
declare function libssh2_scp_send64( byval session as LIBSSH2_SESSION ptr, byval path as const zstring ptr, _
                                     byval mode as int32, byval size as libssh2_int64_t, _
                                     byval mtime as int64, byval atime as int64 ) as LIBSSH2_CHANNEL ptr
end extern

#if defined(TIKO_OS_WINDOWS)
    type libssh2_scp_stat                       '' _stati64: 56 bytes
        as ubyte _r0(0 to 5)
        as uint16 st_mode                       '' 6
        as ubyte _r1(0 to 15)
        as int64 st_size                        '' 24
        as ubyte _r2(0 to 7)
        as int64 st_mtime                       '' 40
        as ubyte _r3(0 to 7)
    end type
#elseif defined(TIKO_OS_LINUX) and defined(TIKO_ARCH_ARM64)
    type libssh2_scp_stat                       '' glibc aarch64 struct stat (the generic one): 128 bytes
        as ubyte _r0(0 to 15)
        as uint32 st_mode                       '' 16
        as ubyte _r1(0 to 27)
        as int64 st_size                        '' 48
        as ubyte _r2(0 to 31)
        as int64 st_mtime                       '' 88 (st_mtim.tv_sec)
        as ubyte _r3(0 to 31)
    end type
#elseif defined(TIKO_OS_LINUX)
    type libssh2_scp_stat                       '' glibc x86-64 struct stat: 144 bytes
        as ubyte _r0(0 to 23)
        as uint32 st_mode                       '' 24
        as ubyte _r1(0 to 19)
        as int64 st_size                        '' 48
        as ubyte _r2(0 to 31)
        as int64 st_mtime                       '' 88 (st_mtim.tv_sec)
        as ubyte _r3(0 to 47)
    end type
#elseif defined(TIKO_OS_MACOS)
    type libssh2_scp_stat                       '' Darwin arm64 struct stat (64-bit inodes): 144 bytes
        as ubyte _r0(0 to 3)
        as uint16 st_mode                       '' 4
        as ubyte _r1(0 to 41)
        as int64 st_mtime                       '' 48 (st_mtimespec.tv_sec)
        as ubyte _r2(0 to 39)
        as int64 st_size                        '' 96
        as ubyte _r3(0 to 39)
    end type
#endif

#define LIBSSH2_SSH_BANNER ( "SSH-2.0-libssh2_" & LIBSSH2_VERSION_2 )
#define LIBSSH2_SSH_DEFAULT_BANNER LIBSSH2_SSH_BANNER
#define LIBSSH2_SSH_DEFAULT_BANNER_WITH_CRLF ( LIBSSH2_SSH_DEFAULT_BANNER & !"\r\n" )

#define libssh2_session_init( ) libssh2_session_init_ex( nullptr, nullptr, nullptr, nullptr )
#define libssh2_userauth_password( session, username, password ) _
    libssh2_userauth_password_ex( (session), (username), cuint( strlen( username ) ), _
                                  (password), cuint( strlen( password ) ), nullptr )
#define libssh2_channel_open_session( session ) _
    libssh2_channel_open_ex( (session), "session", 7, LIBSSH2_CHANNEL_WINDOW_DEFAULT, _
                             LIBSSH2_CHANNEL_PACKET_DEFAULT, nullptr, 0 )
#define libssh2_channel_forward_listen( session, port ) _
    libssh2_channel_forward_listen_ex( (session), nullptr, (port), nullptr, 16 )
#define libssh2_channel_request_pty( channel, term ) _
    libssh2_channel_request_pty_ex( (channel), (term), cuint( strlen( term ) ), nullptr, 0, _
                                    LIBSSH2_TERM_WIDTH, LIBSSH2_TERM_HEIGHT, _
                                    LIBSSH2_TERM_WIDTH_PX, LIBSSH2_TERM_HEIGHT_PX )
#define libssh2_channel_x11_req( channel, screen_number ) _
    libssh2_channel_x11_req_ex( (channel), 0, nullptr, nullptr, (screen_number) )
#define libssh2_channel_shell( channel ) _
    libssh2_channel_process_startup( (channel), "shell", 5, nullptr, 0 )
#define libssh2_channel_exec( channel, command_ ) _
    libssh2_channel_process_startup( (channel), "exec", 4, (command_), cuint( strlen( command_ ) ) )
#define libssh2_channel_subsystem( channel, subsystem ) _
    libssh2_channel_process_startup( (channel), "subsystem", 9, (subsystem), cuint( strlen( subsystem ) ) )
#define libssh2_channel_window_read( channel ) libssh2_channel_window_read_ex( (channel), nullptr, nullptr )
#define libssh2_channel_window_write( channel ) libssh2_channel_window_write_ex( (channel), nullptr )

#define libssh2_sftp_readdir( handle, buffer, buffer_maxlen, attrs ) _
    libssh2_sftp_readdir_ex( (handle), (buffer), (buffer_maxlen), nullptr, 0, (attrs) )
#define LIBSSH2_SFTP_S_ISLNK( m ) ( ( (m) and LIBSSH2_SFTP_S_IFMT ) = LIBSSH2_SFTP_S_IFLNK )
#define LIBSSH2_SFTP_S_ISREG( m ) ( ( (m) and LIBSSH2_SFTP_S_IFMT ) = LIBSSH2_SFTP_S_IFREG )
#define LIBSSH2_SFTP_S_ISDIR( m ) ( ( (m) and LIBSSH2_SFTP_S_IFMT ) = LIBSSH2_SFTP_S_IFDIR )
#define LIBSSH2_SFTP_S_ISCHR( m ) ( ( (m) and LIBSSH2_SFTP_S_IFMT ) = LIBSSH2_SFTP_S_IFCHR )
#define LIBSSH2_SFTP_S_ISBLK( m ) ( ( (m) and LIBSSH2_SFTP_S_IFMT ) = LIBSSH2_SFTP_S_IFBLK )
#define LIBSSH2_SFTP_S_ISFIFO( m ) ( ( (m) and LIBSSH2_SFTP_S_IFMT ) = LIBSSH2_SFTP_S_IFIFO )
#define LIBSSH2_SFTP_S_ISSOCK( m ) ( ( (m) and LIBSSH2_SFTP_S_IFMT ) = LIBSSH2_SFTP_S_IFSOCK )
