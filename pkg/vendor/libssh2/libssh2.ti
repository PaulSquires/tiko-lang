'' C2T-TODO(refused-type) libssh2.h:449 -- record '_LIBSSH2_POLLFD': field 'fd': field 'socket': 'SOCKET' is a system header's type
'' typedef struct _LIBSSH2_POLLFD {
''     unsigned char type; /* LIBSSH2_POLLFD_* below */
''
''     union {
''         libssh2_socket_t socket; /* File descriptors -- examined with
''                                     system select() call */
''         LIBSSH2_CHANNEL *channel; /* Examined by checking internal state */
''         LIBSSH2_LISTENER *listener; /* Read polls only -- are inbound
''                                        connections waiting to be accepted? */
''     } fd;
''
''     unsigned long events; /* Requested Events */
''     unsigned long revents; /* Returned Events */
'' } LIBSSH2_POLLFD;
#elseif not (defined(TIKO_OS_WINDOWS))
union _LIBSSH2_POLLFD_fd_t
    socket as libssh2_socket_t
    channel as LIBSSH2_CHANNEL ptr
    listener as LIBSSH2_LISTENER ptr
end union
type _LIBSSH2_POLLFD
    type as uint8       /' LIBSSH2_POLLFD_* below '/

    fd as _LIBSSH2_POLLFD_fd_t /' File descriptors -- examined with
                                    system select() call '/ /' Examined by checking internal state '/ /' Read polls only -- are inbound
                                       connections waiting to be accepted? '/

    events as culong      /' Requested Events '/
    revents as culong      /' Returned Events '/
end type
type LIBSSH2_POLLFD as _LIBSSH2_POLLFD
#endif

/' Poll FD Descriptor Types '/
#define LIBSSH2_POLLFD_SOCKET 1
#define LIBSSH2_POLLFD_CHANNEL 2
#define LIBSSH2_POLLFD_LISTENER 3

/' Note: Win32 Doesn't actually have a poll() implementation, so some of these
   values are faked with select() data '/
/' Poll FD events/revents -- Match sys/poll.h where possible '/
#define LIBSSH2_POLLFD_POLLIN &h0001
#define LIBSSH2_POLLFD_POLLPRI &h0002
#define LIBSSH2_POLLFD_POLLEXT &h0002
#define LIBSSH2_POLLFD_POLLOUT &h0004
/' revents only '/
#define LIBSSH2_POLLFD_POLLERR &h0008          /' Error Condition -- Socket '/
#define LIBSSH2_POLLFD_POLLHUP &h0010          /' HangUp/EOF -- Socket '/
#define LIBSSH2_POLLFD_SESSION_CLOSED &h0010   /' Session Disconnect '/
#define LIBSSH2_POLLFD_POLLNVAL &h0020
#define LIBSSH2_POLLFD_POLLEX &h0040
#define LIBSSH2_POLLFD_CHANNEL_CLOSED &h0080   /' Channel Disconnect '/
#define LIBSSH2_POLLFD_LISTENER_CLOSED &h0080  /' Listener Disconnect '/

#define HAVE_LIBSSH2_SESSION_BLOCK_DIRECTION
/' Block Direction Types '/
#define LIBSSH2_SESSION_BLOCK_INBOUND &h0001
#define LIBSSH2_SESSION_BLOCK_OUTBOUND &h0002

