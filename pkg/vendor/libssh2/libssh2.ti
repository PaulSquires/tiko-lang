#define HAVE_LIBSSH2_KNOWNHOST_API &h010101 /' since 1.1.1 '/
#define HAVE_LIBSSH2_VERSION_API &h010100   /' libssh2_version since 1.1 '/
#define HAVE_LIBSSH2_CRYPTOENGINE_API &h011100

type libssh2_knownhost
    magic as uint32      /' magic stored by the library '/
    node as any ptr /' handle to the internal representation of this host '/
    name as zstring ptr /' this is NULL if no plain text host name exists '/
    key as zstring ptr  /' key in base64/printable format '/
    typemask as int32
end type

/'
 * libssh2_knownhost_init()
 *
 * Init a collection of known hosts. Returns the pointer to a collection.
 *
 '/
declare function libssh2_knownhost_init( byval session as LIBSSH2_SESSION ptr ) as LIBSSH2_KNOWNHOSTS ptr

/'
 * libssh2_knownhost_add()
 *
 * Add a host and its associated key to the collection of known hosts.
 *
 * The 'type' argument specifies on what format the given host and keys are:
 *
 * plain  - ascii "hostname.domain.tld"
 * sha1   - SHA1(<salt> <host>) base64-encoded!
 * custom - another hash
 *
 * If 'sha1' is selected as type, the salt must be provided to the salt
 * argument. This too base64 encoded.
 *
 * The SHA-1 hash is what OpenSSH can be told to use in known_hosts files.  If
 * a custom type is used, salt is ignored and you must provide the host
 * pre-hashed when checking for it in the libssh2_knownhost_check() function.
 *
 * The keylen parameter may be omitted (zero) if the key is provided as a
 * NULL-terminated base64-encoded string.
 '/

/' host format (2 bits) '/
#define LIBSSH2_KNOWNHOST_TYPE_MASK &hFFFF
#define LIBSSH2_KNOWNHOST_TYPE_PLAIN 1
#define LIBSSH2_KNOWNHOST_TYPE_SHA1 2    /' always base64 encoded '/
#define LIBSSH2_KNOWNHOST_TYPE_CUSTOM 3

/' key format (2 bits) '/
#define LIBSSH2_KNOWNHOST_KEYENC_MASK (3 shl 16)
#define LIBSSH2_KNOWNHOST_KEYENC_RAW (1 shl 16)
#define LIBSSH2_KNOWNHOST_KEYENC_BASE64 (2 shl 16)

/' type of key (4 bits) '/
#define LIBSSH2_KNOWNHOST_KEY_MASK (15 shl 18)
#define LIBSSH2_KNOWNHOST_KEY_SHIFT 18
#define LIBSSH2_KNOWNHOST_KEY_RSA1 (1 shl 18)
#define LIBSSH2_KNOWNHOST_KEY_SSHRSA (2 shl 18)
#define LIBSSH2_KNOWNHOST_KEY_SSHDSS (3 shl 18)     /' deprecated '/
#define LIBSSH2_KNOWNHOST_KEY_ECDSA_256 (4 shl 18)
#define LIBSSH2_KNOWNHOST_KEY_ECDSA_384 (5 shl 18)
#define LIBSSH2_KNOWNHOST_KEY_ECDSA_521 (6 shl 18)
#define LIBSSH2_KNOWNHOST_KEY_ED25519 (7 shl 18)
#define LIBSSH2_KNOWNHOST_KEY_UNKNOWN (15 shl 18)

declare function libssh2_knownhost_add( byval hosts as LIBSSH2_KNOWNHOSTS ptr, _
_
                                        byval host as const zstring ptr, _
                                        byval salt as const zstring ptr, _
                                        byval key as const zstring ptr, byval keylen as uinteger, byval typemask as int32, _
                                        byval store as libssh2_knownhost ptr ptr ) as int32

/'
 * libssh2_knownhost_addc()
 *
 * Add a host and its associated key to the collection of known hosts.
 *
 * Takes a comment argument that may be NULL.  A NULL comment indicates
 * there is no comment and the entry will end directly after the key
 * when written out to a file.  An empty string "" comment will indicate an
 * empty comment which will cause a single space to be written after the key.
 *
 * The 'type' argument specifies on what format the given host and keys are:
 *
 * plain  - ascii "hostname.domain.tld"
 * sha1   - SHA1(<salt> <host>) base64-encoded!
 * custom - another hash
 *
 * If 'sha1' is selected as type, the salt must be provided to the salt
 * argument. This too base64 encoded.
 *
 * The SHA-1 hash is what OpenSSH can be told to use in known_hosts files.
 * If a custom type is used, salt is ignored and you must provide the host
 * pre-hashed when checking for it in the libssh2_knownhost_check() function.
 *
 * The keylen parameter may be omitted (zero) if the key is provided as a
 * NULL-terminated base64-encoded string.
 '/

declare function libssh2_knownhost_addc( byval hosts as LIBSSH2_KNOWNHOSTS ptr, _
_
                                         byval host as const zstring ptr, _
                                         byval salt as const zstring ptr, _
                                         byval key as const zstring ptr, byval keylen as uinteger, _
                                         byval comment as const zstring ptr, byval commentlen as uinteger, byval typemask as int32, _
                                         byval store as libssh2_knownhost ptr ptr ) as int32

/'
 * libssh2_knownhost_check()
 *
 * Check a host and its associated key against the collection of known hosts.
 *
 * The type is the type/format of the given host name.
 *
 * plain  - ascii "hostname.domain.tld"
 * custom - prehashed base64 encoded. Note that this cannot use any salts.
 *
 *
 * 'knownhost' may be set to NULL if you don't care about that info.
 *
 * Returns:
 *
 * LIBSSH2_KNOWNHOST_CHECK_* values, see below
 *
 '/

#define LIBSSH2_KNOWNHOST_CHECK_MATCH 0
#define LIBSSH2_KNOWNHOST_CHECK_MISMATCH 1
#define LIBSSH2_KNOWNHOST_CHECK_NOTFOUND 2
#define LIBSSH2_KNOWNHOST_CHECK_FAILURE 3

declare function libssh2_knownhost_check( byval hosts as LIBSSH2_KNOWNHOSTS ptr, _
_
                                          byval host as const zstring ptr, byval key as const zstring ptr, byval keylen as uinteger, _
                                          byval typemask as int32, _
                                          byval knownhost as libssh2_knownhost ptr ptr ) as int32

/' this function is identital to the above one, but also takes a port
   argument that allows libssh2 to do a better check '/
declare function libssh2_knownhost_checkp( byval hosts as LIBSSH2_KNOWNHOSTS ptr, _
_
                                           byval host as const zstring ptr, byval port as int32, _
                                           byval key as const zstring ptr, byval keylen as uinteger, _
                                           byval typemask as int32, _
                                           byval knownhost as libssh2_knownhost ptr ptr ) as int32

/'
 * libssh2_knownhost_del()
 *
 * Remove a host from the collection of known hosts. The 'entry' struct is
 * retrieved by a call to libssh2_knownhost_check().
 *
 '/
declare function libssh2_knownhost_del( byval hosts as LIBSSH2_KNOWNHOSTS ptr, _
_
                                        byval entry as libssh2_knownhost ptr ) as int32

/'
 * libssh2_knownhost_free()
 *
 * Free an entire collection of known hosts.
 *
 '/
declare sub libssh2_knownhost_free( byval hosts as LIBSSH2_KNOWNHOSTS ptr )

/'
 * libssh2_knownhost_readline()
 *
 * Pass in a line of a file of 'type'. It makes libssh2 read this line.
 *
 * LIBSSH2_KNOWNHOST_FILE_OPENSSH is the only supported type.
 *
 '/
declare function libssh2_knownhost_readline( byval hosts as LIBSSH2_KNOWNHOSTS ptr, _
_
                                             byval line_ as const zstring ptr, byval len_ as uinteger, byval type_ as int32 ) as int32

/'
 * libssh2_knownhost_readfile()
 *
 * Add hosts+key pairs from a given file.
 *
 * Returns a negative value for error or number of successfully added hosts.
 *
 * This implementation currently only knows one 'type' (openssh), all others
 * are reserved for future use.
 '/

#define LIBSSH2_KNOWNHOST_FILE_OPENSSH 1

declare function libssh2_knownhost_readfile( byval hosts as LIBSSH2_KNOWNHOSTS ptr, _
_
                                             byval filename as const zstring ptr, byval type_ as int32 ) as int32

/'
 * libssh2_knownhost_writeline()
 *
 * Ask libssh2 to convert a known host to an output line for storage.
 *
 * Note that this function returns LIBSSH2_ERROR_BUFFER_TOO_SMALL if the given
 * output buffer is too small to hold the desired output.
 *
 * This implementation currently only knows one 'type' (openssh), all others
 * are reserved for future use.
 *
 '/
declare function libssh2_knownhost_writeline( byval hosts as LIBSSH2_KNOWNHOSTS ptr, _
_
                                              byval known as libssh2_knownhost ptr, _
                                              byval buffer as zstring ptr, byval buflen as uinteger, _
                                              byval outlen as uinteger ptr, _ /' the amount of written data '/
                                              byval type_ as int32 ) as int32

/'
 * libssh2_knownhost_writefile()
 *
 * Write hosts+key pairs to a given file.
 *
 * This implementation currently only knows one 'type' (openssh), all others
 * are reserved for future use.
 '/

declare function libssh2_knownhost_writefile( byval hosts as LIBSSH2_KNOWNHOSTS ptr, _
_
                                              byval filename as const zstring ptr, byval type_ as int32 ) as int32

/'
 * libssh2_knownhost_get()
 *
 * Traverse the internal list of known hosts. Pass NULL to 'prev' to get
 * the first one. Or pass a pointer to the previously returned one to get the
 * next.
 *
 * Returns:
 * 0 if a fine host was stored in 'store'
 * 1 if end of hosts
 * [negative] on errors
 '/
declare function libssh2_knownhost_get( byval hosts as LIBSSH2_KNOWNHOSTS ptr, _
_
                                        byval store as libssh2_knownhost ptr ptr, _
                                        byval prev as libssh2_knownhost ptr ) as int32

#define HAVE_LIBSSH2_AGENT_API &h010202 /' since 1.2.2 '/

type libssh2_agent_publickey
    magic as uint32                  /' magic stored by the library '/
    node as any ptr /' handle to the internal representation of key '/
    blob as uint8 ptr              /' public key blob '/
    blob_len as uinteger           /' length of the public key blob '/
    comment as zstring ptr         /' comment in printable format '/
end type

/'
 * libssh2_agent_init()
 *
 * Init an ssh-agent handle. Returns the pointer to the handle.
 *
 '/
declare function libssh2_agent_init( byval session as LIBSSH2_SESSION ptr ) as LIBSSH2_AGENT ptr

/'
 * libssh2_agent_connect()
 *
 * Connect to an ssh-agent.
 *
 * Returns 0 if succeeded, or a negative value for error.
 '/
declare function libssh2_agent_connect( byval agent as LIBSSH2_AGENT ptr ) as int32

/'
 * libssh2_agent_list_identities()
 *
 * Request an ssh-agent to list identities.
 *
 * Returns 0 if succeeded, or a negative value for error.
 '/
declare function libssh2_agent_list_identities( byval agent as LIBSSH2_AGENT ptr ) as int32

/'
 * libssh2_agent_get_identity()
 *
 * Traverse the internal list of public keys. Pass NULL to 'prev' to get
 * the first one. Or pass a pointer to the previously returned one to get the
 * next.
 *
 * Returns:
 * 0 if a fine public key was stored in 'store'
 * 1 if end of public keys
 * [negative] on errors
 '/
declare function libssh2_agent_get_identity( byval agent as LIBSSH2_AGENT ptr, _
_
                                             byval store as libssh2_agent_publickey ptr ptr, _
                                             byval prev as libssh2_agent_publickey ptr ) as int32

/'
 * libssh2_agent_userauth()
 *
 * Do publickey user authentication with the help of ssh-agent.
 *
 * Returns 0 if succeeded, or a negative value for error.
 '/
declare function libssh2_agent_userauth( byval agent as LIBSSH2_AGENT ptr, _
_
                                         byval username as const zstring ptr, _
                                         byval identity as libssh2_agent_publickey ptr ) as int32

/'
 * libssh2_agent_sign()
 *
 * Sign a payload using a system-installed ssh-agent.
 *
 * Returns 0 if succeeded, or a negative value for error.
 '/
declare function libssh2_agent_sign( byval agent as LIBSSH2_AGENT ptr, _
_
                                     byval identity as libssh2_agent_publickey ptr, _
                                     byval sig as uint8 ptr ptr, _
                                     byval s_len as uinteger ptr, _
                                     byval data_ as const uint8 ptr, _
                                     byval d_len as uinteger, _
                                     byval method as const zstring ptr, _
                                     byval method_len as uint32 ) as int32

/'
 * libssh2_agent_disconnect()
 *
 * Close a connection to an ssh-agent.
 *
 * Returns 0 if succeeded, or a negative value for error.
 '/
declare function libssh2_agent_disconnect( byval agent as LIBSSH2_AGENT ptr ) as int32

/'
 * libssh2_agent_free()
 *
 * Free an ssh-agent handle.  This function also frees the internal
 * collection of public keys.
 '/
declare sub libssh2_agent_free( byval agent as LIBSSH2_AGENT ptr )

/'
 * libssh2_agent_set_identity_path()
 *
 * Allows a custom agent identity socket path beyond SSH_AUTH_SOCK env
 *
 '/
declare sub libssh2_agent_set_identity_path( byval agent as LIBSSH2_AGENT ptr, _
_
                                             byval path as const zstring ptr )

/'
 * libssh2_agent_get_identity_path()
 *
 * Returns the custom agent identity socket path if set
 *
 '/
declare function libssh2_agent_get_identity_path( byval agent as LIBSSH2_AGENT ptr ) as const zstring ptr

/'
 * libssh2_keepalive_config()
 *
 * Set how often keepalive messages should be sent.  WANT_REPLY
 * indicates whether the keepalive messages should request a response
 * from the server.  INTERVAL is number of seconds that can pass
 * without any I/O, use 0 (the default) to disable keepalives.  To
 * avoid some busy-loop corner-cases, if you specify an interval of 1
 * it will be treated as 2.
 *
 * Note that non-blocking applications are responsible for sending the
 * keepalive messages using libssh2_keepalive_send().
 '/
declare sub libssh2_keepalive_config( byval session as LIBSSH2_SESSION ptr, _
                                      byval want_reply as int32, _
                                      byval interval as uint32 )

/'
 * libssh2_keepalive_send()
 *
 * Send a keepalive message if needed.  SECONDS_TO_NEXT indicates how
 * many seconds you can sleep after this call before you need to call
 * it again.  Returns 0 on success, or LIBSSH2_ERROR_SOCKET_SEND on
 * I/O errors.
 '/
declare function libssh2_keepalive_send( byval session as LIBSSH2_SESSION ptr, _
                                         byval seconds_to_next as int32 ptr ) as int32

/' NOTE NOTE NOTE
   libssh2_trace() has no function in builds that aren't built with debug
   enabled
 '/
declare function libssh2_trace( byval session as LIBSSH2_SESSION ptr, byval bitmask as int32 ) as int32
#define LIBSSH2_TRACE_TRANS (1 shl 1)
#define LIBSSH2_TRACE_KEX (1 shl 2)
#define LIBSSH2_TRACE_AUTH (1 shl 3)
#define LIBSSH2_TRACE_CONN (1 shl 4)
#define LIBSSH2_TRACE_SCP (1 shl 5)
#define LIBSSH2_TRACE_SFTP (1 shl 6)
#define LIBSSH2_TRACE_ERROR (1 shl 7)
#define LIBSSH2_TRACE_PUBLICKEY (1 shl 8)
#define LIBSSH2_TRACE_SOCKET (1 shl 9)

type libssh2_trace_handler_func as sub cdecl( byval as LIBSSH2_SESSION ptr, byval as any ptr, byval as const zstring ptr, byval as uinteger )
declare function libssh2_trace_sethandler( byval session as LIBSSH2_SESSION ptr, _
                                           byval context as any ptr, _
                                           byval callback as libssh2_trace_handler_func ) as int32

end extern

#endif /' !RC_INVOKED '/

#endif /' LIBSSH2_H '/
