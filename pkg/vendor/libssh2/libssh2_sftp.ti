#ifndef LIBSSH2_SFTP_H
#define LIBSSH2_SFTP_H 1

#include once "libssh2.ti"

#ifndef TIKO_OS_WINDOWS
'' C2T-TODO(system-header) libssh2_sftp.h:46 -- <unistd.h> has no tiko counterpart in c2t's table
'' #include <unistd.h>
#endif

extern "C"

/' Note: Version 6 was documented at the time of writing
 * However it was marked as "DO NOT IMPLEMENT" due to pending changes
 *
 * Let's start with Version 3 (The version found in OpenSSH) and go from there
 '/
#define LIBSSH2_SFTP_VERSION 3

type _LIBSSH2_SFTP__fwd as _LIBSSH2_SFTP
type LIBSSH2_SFTP as _LIBSSH2_SFTP
type _LIBSSH2_SFTP_HANDLE__fwd as _LIBSSH2_SFTP_HANDLE
type LIBSSH2_SFTP_HANDLE as _LIBSSH2_SFTP_HANDLE
type _LIBSSH2_SFTP_ATTRIBUTES__fwd as _LIBSSH2_SFTP_ATTRIBUTES
type LIBSSH2_SFTP_ATTRIBUTES as _LIBSSH2_SFTP_ATTRIBUTES
type _LIBSSH2_SFTP_STATVFS__fwd as _LIBSSH2_SFTP_STATVFS
type LIBSSH2_SFTP_STATVFS as _LIBSSH2_SFTP_STATVFS

/' Flags for open_ex() '/
#define LIBSSH2_SFTP_OPENFILE 0
#define LIBSSH2_SFTP_OPENDIR 1

/' Flags for rename_ex() '/
#define LIBSSH2_SFTP_RENAME_OVERWRITE &h00000001
#define LIBSSH2_SFTP_RENAME_ATOMIC &h00000002
#define LIBSSH2_SFTP_RENAME_NATIVE &h00000004

/' Flags for stat_ex() '/
#define LIBSSH2_SFTP_STAT 0
#define LIBSSH2_SFTP_LSTAT 1
#define LIBSSH2_SFTP_SETSTAT 2

/' Flags for symlink_ex() '/
#define LIBSSH2_SFTP_SYMLINK 0
#define LIBSSH2_SFTP_READLINK 1
#define LIBSSH2_SFTP_REALPATH 2

/' Flags for sftp_mkdir() '/
#define LIBSSH2_SFTP_DEFAULT_MODE (-1)

/' SFTP attribute flag bits '/
#define LIBSSH2_SFTP_ATTR_SIZE &h00000001
#define LIBSSH2_SFTP_ATTR_UIDGID &h00000002
#define LIBSSH2_SFTP_ATTR_PERMISSIONS &h00000004
#define LIBSSH2_SFTP_ATTR_ACMODTIME &h00000008
#define LIBSSH2_SFTP_ATTR_EXTENDED &h80000000

/' SFTP statvfs flag bits '/
#define LIBSSH2_SFTP_ST_RDONLY &h00000001
#define LIBSSH2_SFTP_ST_NOSUID &h00000002

type _LIBSSH2_SFTP_ATTRIBUTES
    /' If flags & ATTR_* bit is set, then the value in this struct will be
     * meaningful Otherwise it should be ignored
     '/
    flags as culong

    filesize as libssh2_uint64_t
    uid as culong
    gid as culong
    permissions as culong
    atime as culong
    mtime as culong
end type

type _LIBSSH2_SFTP_STATVFS
    f_bsize as libssh2_uint64_t   /' file system block size '/
    f_frsize as libssh2_uint64_t  /' fragment size '/
    f_blocks as libssh2_uint64_t  /' size of fs in f_frsize units '/
    f_bfree as libssh2_uint64_t   /' # free blocks '/
    f_bavail as libssh2_uint64_t  /' # free blocks for non-root '/
    f_files as libssh2_uint64_t   /' # inodes '/
    f_ffree as libssh2_uint64_t   /' # free inodes '/
    f_favail as libssh2_uint64_t  /' # free inodes for non-root '/
    f_fsid as libssh2_uint64_t    /' file system ID '/
    f_flag as libssh2_uint64_t    /' mount flags '/
    f_namemax as libssh2_uint64_t /' maximum filename length '/
end type

/' SFTP filetypes '/
#define LIBSSH2_SFTP_TYPE_REGULAR 1
#define LIBSSH2_SFTP_TYPE_DIRECTORY 2
#define LIBSSH2_SFTP_TYPE_SYMLINK 3
#define LIBSSH2_SFTP_TYPE_SPECIAL 4
#define LIBSSH2_SFTP_TYPE_UNKNOWN 5
#define LIBSSH2_SFTP_TYPE_SOCKET 6
#define LIBSSH2_SFTP_TYPE_CHAR_DEVICE 7
#define LIBSSH2_SFTP_TYPE_BLOCK_DEVICE 8
#define LIBSSH2_SFTP_TYPE_FIFO 9

/'
 * Reproduce the POSIX file modes here for systems that are not POSIX
 * compliant.
 *
 * These is used in "permissions" of "struct _LIBSSH2_SFTP_ATTRIBUTES"
 '/
/' File type '/
#define LIBSSH2_SFTP_S_IFMT &o170000            /' type of file mask '/
#define LIBSSH2_SFTP_S_IFIFO &o010000           /' named pipe (fifo) '/
#define LIBSSH2_SFTP_S_IFCHR &o020000           /' character special '/
#define LIBSSH2_SFTP_S_IFDIR &o040000           /' directory '/
#define LIBSSH2_SFTP_S_IFBLK &o060000           /' block special '/
#define LIBSSH2_SFTP_S_IFREG &o100000           /' regular '/
#define LIBSSH2_SFTP_S_IFLNK &o120000           /' symbolic link '/
#define LIBSSH2_SFTP_S_IFSOCK &o140000          /' socket '/

/' File mode '/
/' Read, write, execute/search by owner '/
#define LIBSSH2_SFTP_S_IRWXU &o000700           /' RWX mask for owner '/
#define LIBSSH2_SFTP_S_IRUSR &o000400           /' R for owner '/
#define LIBSSH2_SFTP_S_IWUSR &o000200           /' W for owner '/
#define LIBSSH2_SFTP_S_IXUSR &o000100           /' X for owner '/
/' Read, write, execute/search by group '/
#define LIBSSH2_SFTP_S_IRWXG &o000070           /' RWX mask for group '/
#define LIBSSH2_SFTP_S_IRGRP &o000040           /' R for group '/
#define LIBSSH2_SFTP_S_IWGRP &o000020           /' W for group '/
#define LIBSSH2_SFTP_S_IXGRP &o000010           /' X for group '/
/' Read, write, execute/search by others '/
#define LIBSSH2_SFTP_S_IRWXO &o000007           /' RWX mask for other '/
#define LIBSSH2_SFTP_S_IROTH &o000004           /' R for other '/
#define LIBSSH2_SFTP_S_IWOTH &o000002           /' W for other '/
#define LIBSSH2_SFTP_S_IXOTH &o000001           /' X for other '/

