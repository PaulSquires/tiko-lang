/' SFTP File Transfer Flags -- (e.g. flags parameter to sftp_open())
 * Danger will robinson... APPEND doesn't have any effect on OpenSSH servers '/
#define LIBSSH2_FXF_READ &h00000001
#define LIBSSH2_FXF_WRITE &h00000002
#define LIBSSH2_FXF_APPEND &h00000004
#define LIBSSH2_FXF_CREAT &h00000008
#define LIBSSH2_FXF_TRUNC &h00000010
#define LIBSSH2_FXF_EXCL &h00000020

/' SFTP Status Codes (returned by libssh2_sftp_last_error() ) '/
#define LIBSSH2_FX_OK 0u
#define LIBSSH2_FX_EOF 1u
#define LIBSSH2_FX_NO_SUCH_FILE 2u
#define LIBSSH2_FX_PERMISSION_DENIED 3u
#define LIBSSH2_FX_FAILURE 4u
#define LIBSSH2_FX_BAD_MESSAGE 5u
#define LIBSSH2_FX_NO_CONNECTION 6u
#define LIBSSH2_FX_CONNECTION_LOST 7u
#define LIBSSH2_FX_OP_UNSUPPORTED 8u
#define LIBSSH2_FX_INVALID_HANDLE 9u
#define LIBSSH2_FX_NO_SUCH_PATH 10u
#define LIBSSH2_FX_FILE_ALREADY_EXISTS 11u
#define LIBSSH2_FX_WRITE_PROTECT 12u
#define LIBSSH2_FX_NO_MEDIA 13u
#define LIBSSH2_FX_NO_SPACE_ON_FILESYSTEM 14u
#define LIBSSH2_FX_QUOTA_EXCEEDED 15u
#define LIBSSH2_FX_UNKNOWN_PRINCIPLE 16u         /' Initial mis-spelling '/
#define LIBSSH2_FX_UNKNOWN_PRINCIPAL 16u
#define LIBSSH2_FX_LOCK_CONFlICT 17u             /' Initial mis-spelling '/
#define LIBSSH2_FX_LOCK_CONFLICT_2 17u
#define LIBSSH2_FX_DIR_NOT_EMPTY 18u
#define LIBSSH2_FX_NOT_A_DIRECTORY 19u
#define LIBSSH2_FX_INVALID_FILENAME 20u
#define LIBSSH2_FX_LINK_LOOP 21u

/' Returned by any function that would block during a read/write operation '/
'' C2T-NOTE(value) libssh2_sftp.h:220 -- clang's value; 'LIBSSH2_ERROR_EAGAIN' is nothing tiko declares
#define LIBSSH2SFTP_EAGAIN (-37)

/' SFTP API '/
declare function libssh2_sftp_init( byval session as LIBSSH2_SESSION ptr ) as LIBSSH2_SFTP ptr
declare function libssh2_sftp_shutdown( byval sftp as LIBSSH2_SFTP ptr ) as int32
declare function libssh2_sftp_last_error( byval sftp as LIBSSH2_SFTP ptr ) as culong
declare function libssh2_sftp_get_channel( byval sftp as LIBSSH2_SFTP ptr ) as LIBSSH2_CHANNEL ptr

/' File / Directory Ops '/
declare function libssh2_sftp_open_ex( byval sftp as LIBSSH2_SFTP ptr, _
_
                                       byval filename as const zstring ptr, _
                                       byval filename_len as uint32, _
                                       byval flags as culong, _
                                       byval mode as clong, byval open_type as int32 ) as LIBSSH2_SFTP_HANDLE ptr
#define libssh2_sftp_open(sftp, filename, flags, mode) libssh2_sftp_open_ex((sftp), (filename), cast(uint32, strlen((filename))), (flags), (mode), LIBSSH2_SFTP_OPENFILE)
#define libssh2_sftp_opendir_2(sftp, path) libssh2_sftp_open_ex((sftp), (path), cast(uint32, strlen((path))), 0, 0, LIBSSH2_SFTP_OPENDIR)
declare function libssh2_sftp_open_ex_r( byval sftp as LIBSSH2_SFTP ptr, _
_
                                         byval filename as const zstring ptr, _
                                         byval filename_len as uinteger, _
                                         byval flags as culong, _
                                         byval mode as clong, byval open_type as int32, _
                                         byval attrs as LIBSSH2_SFTP_ATTRIBUTES ptr ) as LIBSSH2_SFTP_HANDLE ptr
#define libssh2_sftp_open_r(sftp, filename, flags, mode, attrs) libssh2_sftp_open_ex_r((sftp), (filename), strlen((filename)), (flags), (mode), LIBSSH2_SFTP_OPENFILE, (attrs))

declare function libssh2_sftp_read( byval handle as LIBSSH2_SFTP_HANDLE ptr, _
                                    byval buffer as zstring ptr, byval buffer_maxlen as uinteger ) as integer

declare function libssh2_sftp_readdir_ex( byval handle as LIBSSH2_SFTP_HANDLE ptr, _
                                          byval buffer as zstring ptr, byval buffer_maxlen as uinteger, _
                                          byval longentry as zstring ptr, _
                                          byval longentry_maxlen as uinteger, _
                                          byval attrs as LIBSSH2_SFTP_ATTRIBUTES ptr ) as int32
'' C2T-TODO(function-like-macro) libssh2_sftp.h:263 -- 'NULL' is nothing tiko declares
'' #define libssh2_sftp_readdir(handle, buffer, buffer_maxlen, attrs) \
