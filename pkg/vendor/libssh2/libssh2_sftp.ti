''                             (attrs))

declare function libssh2_sftp_write( byval handle as LIBSSH2_SFTP_HANDLE ptr, _
                                     byval buffer as const zstring ptr, byval count as uinteger ) as integer
declare function libssh2_sftp_fsync( byval handle as LIBSSH2_SFTP_HANDLE ptr ) as int32

declare function libssh2_sftp_close_handle( byval handle as LIBSSH2_SFTP_HANDLE ptr ) as int32
#define libssh2_sftp_close(handle) libssh2_sftp_close_handle((handle))
#define libssh2_sftp_closedir(handle) libssh2_sftp_close_handle((handle))

declare sub libssh2_sftp_seek( byval handle as LIBSSH2_SFTP_HANDLE ptr, byval offset as uinteger )
declare sub libssh2_sftp_seek64( byval handle as LIBSSH2_SFTP_HANDLE ptr, _
                                 byval offset as libssh2_uint64_t )
#define libssh2_sftp_rewind(handle) libssh2_sftp_seek64((handle), 0)

declare function libssh2_sftp_tell( byval handle as LIBSSH2_SFTP_HANDLE ptr ) as uinteger
declare function libssh2_sftp_tell64( byval handle as LIBSSH2_SFTP_HANDLE ptr ) as libssh2_uint64_t

declare function libssh2_sftp_fstat_ex( byval handle as LIBSSH2_SFTP_HANDLE ptr, _
                                        byval attrs as LIBSSH2_SFTP_ATTRIBUTES ptr, _
                                        byval setstat as int32 ) as int32
#define libssh2_sftp_fstat(handle, attrs) libssh2_sftp_fstat_ex((handle), (attrs), 0)
#define libssh2_sftp_fsetstat(handle, attrs) libssh2_sftp_fstat_ex((handle), (attrs), 1)

/' Miscellaneous Ops '/
declare function libssh2_sftp_rename_ex( byval sftp as LIBSSH2_SFTP ptr, _
                                         byval source_filename as const zstring ptr, _
                                         byval srouce_filename_len as uint32, _
                                         byval dest_filename as const zstring ptr, _
                                         byval dest_filename_len as uint32, _
                                         byval flags as clong ) as int32
#define libssh2_sftp_rename(sftp, sourcefile, destfile) libssh2_sftp_rename_ex((sftp), (sourcefile), cast(uint32, strlen((sourcefile))), (destfile), cast(uint32, strlen((destfile))), ((LIBSSH2_SFTP_RENAME_OVERWRITE or LIBSSH2_SFTP_RENAME_ATOMIC) or LIBSSH2_SFTP_RENAME_NATIVE))

declare function libssh2_sftp_posix_rename_ex( byval sftp as LIBSSH2_SFTP ptr, _
                                               byval source_filename as const zstring ptr, _
                                               byval srouce_filename_len as uinteger, _
                                               byval dest_filename as const zstring ptr, _
                                               byval dest_filename_len as uinteger ) as int32
#define libssh2_sftp_posix_rename(sftp, sourcefile, destfile) libssh2_sftp_posix_rename_ex((sftp), (sourcefile), strlen((sourcefile)), (destfile), strlen((destfile)))

declare function libssh2_sftp_unlink_ex( byval sftp as LIBSSH2_SFTP ptr, _
                                         byval filename as const zstring ptr, _
                                         byval filename_len as uint32 ) as int32
#define libssh2_sftp_unlink(sftp, filename) libssh2_sftp_unlink_ex((sftp), (filename), cast(uint32, strlen((filename))))

declare function libssh2_sftp_fstatvfs( byval handle as LIBSSH2_SFTP_HANDLE ptr, _
                                        byval st as LIBSSH2_SFTP_STATVFS ptr ) as int32

declare function libssh2_sftp_statvfs( byval sftp as LIBSSH2_SFTP ptr, _
                                       byval path as const zstring ptr, _
                                       byval path_len as uinteger, _
                                       byval st as LIBSSH2_SFTP_STATVFS ptr ) as int32

declare function libssh2_sftp_mkdir_ex( byval sftp as LIBSSH2_SFTP ptr, _
                                        byval path as const zstring ptr, _
                                        byval path_len as uint32, byval mode as clong ) as int32
#define libssh2_sftp_mkdir(sftp, path, mode) libssh2_sftp_mkdir_ex((sftp), (path), cast(uint32, strlen((path))), (mode))

declare function libssh2_sftp_rmdir_ex( byval sftp as LIBSSH2_SFTP ptr, _
                                        byval path as const zstring ptr, _
                                        byval path_len as uint32 ) as int32
#define libssh2_sftp_rmdir(sftp, path) libssh2_sftp_rmdir_ex((sftp), (path), cast(uint32, strlen((path))))

declare function libssh2_sftp_stat_ex( byval sftp as LIBSSH2_SFTP ptr, _
                                       byval path as const zstring ptr, _
                                       byval path_len as uint32, _
                                       byval stat_type as int32, _
                                       byval attrs as LIBSSH2_SFTP_ATTRIBUTES ptr ) as int32
#define libssh2_sftp_stat_2(sftp, path, attrs) libssh2_sftp_stat_ex((sftp), (path), cast(uint32, strlen((path))), LIBSSH2_SFTP_STAT, (attrs))
#define libssh2_sftp_lstat_2(sftp, path, attrs) libssh2_sftp_stat_ex((sftp), (path), cast(uint32, strlen((path))), LIBSSH2_SFTP_LSTAT, (attrs))
#define libssh2_sftp_setstat_2(sftp, path, attrs) libssh2_sftp_stat_ex((sftp), (path), cast(uint32, strlen((path))), LIBSSH2_SFTP_SETSTAT, (attrs))

declare function libssh2_sftp_symlink_ex( byval sftp as LIBSSH2_SFTP ptr, _
                                          byval path as const zstring ptr, _
                                          byval path_len as uint32, _
                                          byval target as zstring ptr, _
                                          byval target_len as uint32, _
                                          byval link_type as int32 ) as int32
#define libssh2_sftp_symlink_2(sftp, orig, linkpath) libssh2_sftp_symlink_ex((sftp), (orig), cast(uint32, strlen((orig))), (linkpath), cast(uint32, strlen((linkpath))), LIBSSH2_SFTP_SYMLINK)
#define libssh2_sftp_readlink_2(sftp, path, target, maxlen) libssh2_sftp_symlink_ex((sftp), (path), cast(uint32, strlen((path))), (target), (maxlen), LIBSSH2_SFTP_READLINK)
#define libssh2_sftp_realpath_2(sftp, path, target, maxlen) libssh2_sftp_symlink_ex((sftp), (path), cast(uint32, strlen((path))), (target), (maxlen), LIBSSH2_SFTP_REALPATH)

end extern

