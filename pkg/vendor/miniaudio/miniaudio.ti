/' SECTION: miniaudio_engine.h '/
/'***********************************************************************************************************************************************************

Engine

***********************************************************************************************************************************************************'/
#if (((defined(MA_NO_ENGINE)) = 0) andalso ((defined(MA_NO_NODE_GRAPH)) = 0))
type ma_engine__fwd as ma_engine
type ma_sound__fwd as ma_sound


/' Sound flags. '/
#if defined(TIKO_OS_WINDOWS)
type ma_sound_flags as int32
enum
    /' Resource manager flags. '/
    MA_SOUND_FLAG_STREAM = 1                            /' MA_RESOURCE_MANAGER_DATA_SOURCE_FLAG_STREAM '/
    MA_SOUND_FLAG_DECODE = 2                            /' MA_RESOURCE_MANAGER_DATA_SOURCE_FLAG_DECODE '/
    MA_SOUND_FLAG_ASYNC = 4                             /' MA_RESOURCE_MANAGER_DATA_SOURCE_FLAG_ASYNC '/
    MA_SOUND_FLAG_WAIT_INIT = 8                         /' MA_RESOURCE_MANAGER_DATA_SOURCE_FLAG_WAIT_INIT '/
    MA_SOUND_FLAG_UNKNOWN_LENGTH = 16                   /' MA_RESOURCE_MANAGER_DATA_SOURCE_FLAG_UNKNOWN_LENGTH '/
    MA_SOUND_FLAG_LOOPING = 32                          /' MA_RESOURCE_MANAGER_DATA_SOURCE_FLAG_LOOPING '/

    /' ma_sound specific flags. '/
    MA_SOUND_FLAG_NO_DEFAULT_ATTACHMENT = 4096          /' Do not attach to the endpoint by default. Useful for when setting up nodes in a complex graph system. '/
    MA_SOUND_FLAG_NO_PITCH = 8192                       /' Disable pitch shifting with ma_sound_set_pitch() and ma_sound_group_set_pitch(). This is an optimization. '/
    MA_SOUND_FLAG_NO_SPATIALIZATION = 16384             /' Disable spatialization. '/
end enum
#elseif defined(TIKO_OS_LINUX)
type ma_sound_flags as uint32
enum
    /' Resource manager flags. '/
    MA_SOUND_FLAG_STREAM = 1                            /' MA_RESOURCE_MANAGER_DATA_SOURCE_FLAG_STREAM '/
    MA_SOUND_FLAG_DECODE = 2                            /' MA_RESOURCE_MANAGER_DATA_SOURCE_FLAG_DECODE '/
    MA_SOUND_FLAG_ASYNC = 4                             /' MA_RESOURCE_MANAGER_DATA_SOURCE_FLAG_ASYNC '/
    MA_SOUND_FLAG_WAIT_INIT = 8                         /' MA_RESOURCE_MANAGER_DATA_SOURCE_FLAG_WAIT_INIT '/
    MA_SOUND_FLAG_UNKNOWN_LENGTH = 16                   /' MA_RESOURCE_MANAGER_DATA_SOURCE_FLAG_UNKNOWN_LENGTH '/
    MA_SOUND_FLAG_LOOPING = 32                          /' MA_RESOURCE_MANAGER_DATA_SOURCE_FLAG_LOOPING '/

    /' ma_sound specific flags. '/
    MA_SOUND_FLAG_NO_DEFAULT_ATTACHMENT = 4096          /' Do not attach to the endpoint by default. Useful for when setting up nodes in a complex graph system. '/
    MA_SOUND_FLAG_NO_PITCH = 8192                       /' Disable pitch shifting with ma_sound_set_pitch() and ma_sound_group_set_pitch(). This is an optimization. '/
    MA_SOUND_FLAG_NO_SPATIALIZATION = 16384             /' Disable spatialization. '/
end enum
#endif

#ifndef MA_ENGINE_MAX_LISTENERS
#define MA_ENGINE_MAX_LISTENERS 4
#endif

'' C2T-NOTE(value) miniaudio.h:11152 -- clang's value; a cast, which tiko's preprocessor does not evaluate
#define MA_LISTENER_INDEX_CLOSEST 255

#if defined(TIKO_OS_WINDOWS)
type ma_engine_node_type as int32
enum
    ma_engine_node_type_sound
    ma_engine_node_type_group
end enum
#elseif defined(TIKO_OS_LINUX)
type ma_engine_node_type as uint32
enum
    ma_engine_node_type_sound
    ma_engine_node_type_group
end enum
#endif

type ma_engine_node_config
    pEngine as ma_engine__fwd ptr
    type as ma_engine_node_type
    channelsIn as ma_uint32
    channelsOut as ma_uint32
    sampleRate as ma_uint32             /' Only used when the type is set to ma_engine_node_type_sound. '/
    volumeSmoothTimeInPCMFrames as ma_uint32  /' The number of frames to smooth over volume changes. Defaults to 0 in which case no smoothing is used. '/
    monoExpansionMode as ma_mono_expansion_mode
    isPitchDisabled as ma_bool8         /' Pitching can be explicitly disabled with MA_SOUND_FLAG_NO_PITCH to optimize processing. '/
    isSpatializationDisabled as ma_bool8  /' Spatialization can be explicitly disabled with MA_SOUND_FLAG_NO_SPATIALIZATION. '/
    pinnedListenerIndex as ma_uint8     /' The index of the listener this node should always use for spatialization. If set to MA_LISTENER_INDEX_CLOSEST the engine will use the closest listener. '/
    resampling as ma_resampler_config
end type

declare function ma_engine_node_config_init( byval pEngine as ma_engine__fwd ptr, byval type_ as ma_engine_node_type, byval flags as ma_uint32 ) as ma_engine_node_config


/' Base node object for both ma_sound and ma_sound_group. '/
type ma_engine_node_fadeSettings_t
    volumeBeg as ma_atomic_float
    volumeEnd as ma_atomic_float
    fadeLengthInFrames as ma_atomic_uint64
    absoluteGlobalTimeInFrames as ma_atomic_uint64
end type
type ma_engine_node
    baseNode as ma_node_base                            /' Must be the first member for compatibility with the ma_node API. '/
    pEngine as ma_engine__fwd ptr                       /' A pointer to the engine. Set based on the value from the config. '/
    sampleRate as ma_uint32                             /' The sample rate of the input data. For sounds backed by a data source, this will be the data source's sample rate. Otherwise it'll be the engine's sample rate. '/
    volumeSmoothTimeInPCMFrames as ma_uint32
    monoExpansionMode as ma_mono_expansion_mode
    fader as ma_fader
    resampler as ma_resampler                           /' For pitch shift. '/
    spatializer as ma_spatializer
    panner as ma_panner
    volumeGainer as ma_gainer                           /' This will only be used if volumeSmoothTimeInPCMFrames is > 0. '/
    volume as ma_atomic_float                           /' Defaults to 1. '/
    oldVolume as float32                                /' The volume last applied by the mixing thread. '/
    pitch as float32
    oldPitch as float32                                 /' For determining whether or not the resampler needs to be updated to reflect the new pitch. The resampler will be updated on the mixing thread. '/
    oldDopplerPitch as float32                          /' For determining whether or not the resampler needs to be updated to take a new doppler pitch into account. '/
    isPitchDisabled as ma_bool32          /' When set to true, pitching will be disabled which will allow the resampler to be bypassed to save some computation. '/
    isSpatializationDisabled as ma_bool32 /' Set to false by default. When set to false, will not have spatialisation applied. '/
    pinnedListenerIndex as ma_uint32      /' The index of the listener this node should always use for spatialization. If set to MA_LISTENER_INDEX_CLOSEST the engine will use the closest listener. '/

    /' When setting a fade, it's not done immediately in ma_sound_set_fade(). It's deferred to the audio thread which means we need to store the settings here. '/
    fadeSettings as ma_engine_node_fadeSettings_t /' <-- Defaults to (~(ma_uint64)0) which is used to indicate that no fade should be applied. '/ /' <-- The time to start the fade. '/

    /' Memory management. '/
    _ownsHeap as ma_bool8
    _pHeap as any ptr
end type

declare function ma_engine_node_get_heap_size( byval pConfig as const ma_engine_node_config ptr, byval pHeapSizeInBytes as uinteger ptr ) as ma_result
declare function ma_engine_node_init_preallocated( byval pConfig as const ma_engine_node_config ptr, byval pHeap as any ptr, byval pEngineNode as ma_engine_node ptr ) as ma_result
declare function ma_engine_node_init( byval pConfig as const ma_engine_node_config ptr, byval pAllocationCallbacks as const ma_allocation_callbacks ptr, byval pEngineNode as ma_engine_node ptr ) as ma_result
declare sub ma_engine_node_uninit( byval pEngineNode as ma_engine_node ptr, byval pAllocationCallbacks as const ma_allocation_callbacks ptr )


#define MA_SOUND_SOURCE_CHANNEL_COUNT &hFFFFFFFF

/' Callback for when a sound reaches the end. '/
type ma_sound_end_proc as sub cdecl( byval as any ptr, byval as ma_sound__fwd ptr )

type ma_sound_config
    pFilePath as const zstring ptr              /' Set this to load from the resource manager. '/
    pFilePathW as const wstring ptr             /' Set this to load from the resource manager. '/
    pDataSource as ma_data_source ptr           /' Set this to load from an existing data source. '/
    pInitialAttachment as ma_node ptr           /' If set, the sound will be attached to an input of this node. This can be set to a ma_sound. If set to NULL, the sound will be attached directly to the endpoint unless MA_SOUND_FLAG_NO_DEFAULT_ATTACHMENT is set in `flags`. '/
    initialAttachmentInputBusIndex as ma_uint32 /' The index of the input bus of pInitialAttachment to attach the sound to. '/
    channelsIn as ma_uint32                     /' Ignored if using a data source as input (the data source's channel count will be used always). Otherwise, setting to 0 will cause the engine's channel count to be used. '/
    channelsOut as ma_uint32                    /' Set this to 0 (default) to use the engine's channel count. Set to MA_SOUND_SOURCE_CHANNEL_COUNT to use the data source's channel count (only used if using a data source as input). '/
    monoExpansionMode as ma_mono_expansion_mode /' Controls how the mono channel should be expanded to other channels when spatialization is disabled on a sound. '/
    flags as ma_uint32                          /' A combination of MA_SOUND_FLAG_* flags. '/
    volumeSmoothTimeInPCMFrames as ma_uint32    /' The number of frames to smooth over volume changes. Defaults to 0 in which case no smoothing is used. '/
    initialSeekPointInPCMFrames as ma_uint64    /' Initializes the sound such that it's seeked to this location by default. '/
    rangeBegInPCMFrames as ma_uint64
    rangeEndInPCMFrames as ma_uint64
    loopPointBegInPCMFrames as ma_uint64
    loopPointEndInPCMFrames as ma_uint64
    endCallback as ma_sound_end_proc            /' Fired when the sound reaches the end. Will be fired from the audio thread. Do not restart, uninitialize or otherwise change the state of the sound from here. Instead fire an event or set a variable to indicate to a different thread to change the start of the sound. Will not be fired in response to a scheduled stop with ma_sound_set_stop_time_*(). '/
    pEndCallbackUserData as any ptr
    pitchResampling as ma_resampler_config
    initNotifications as ma_resource_manager_pipeline_notifications
    pDoneFence as ma_fence ptr                  /' Deprecated. Use initNotifications instead. Released when the resource manager has finished decoding the entire sound. Not used with streams. '/
    isLooping as ma_bool32                      /' Deprecated. Use the MA_SOUND_FLAG_LOOPING flag in `flags` instead. '/
end type

declare function ma_sound_config_init( ) as ma_sound_config         /' Deprecated. Will be removed in version 0.12. Use ma_sound_config_2() instead. '/
declare function ma_sound_config_init_2( byval pEngine as ma_engine__fwd ptr ) as ma_sound_config  /' Will be renamed to ma_sound_config_init() in version 0.12. '/

type ma_sound
    engineNode as ma_engine_node        /' Must be the first member for compatibility with the ma_node API. '/
    pDataSource as ma_data_source ptr
    seekTarget as ma_uint64 /' The PCM frame index to seek to in the mixing thread. Set to (~(ma_uint64)0) to not perform any seeking. '/
    atEnd as ma_bool32
    endCallback as ma_sound_end_proc
    pEndCallbackUserData as any ptr
    pProcessingCache as float32 ptr     /' Will be null if pDataSource is null. '/
    processingCacheFramesRemaining as ma_uint32
    processingCacheCap as ma_uint32
    ownsDataSource as ma_bool8

    /'
    We're declaring a resource manager data source object here to save us a malloc when loading a
    sound via the resource manager, which I *think* will be the most common scenario.
    '/
    pResourceManagerDataSource as ma_resource_manager_data_source ptr
end type

/' Structure specifically for sounds played with ma_engine_play_sound(). Making this a separate structure to reduce overhead. '/
type ma_sound_inlined__fwd as ma_sound_inlined
type ma_sound_inlined
    sound as ma_sound
    pNext as ma_sound_inlined ptr
    pPrev as ma_sound_inlined ptr
end type

/' A sound group is just a sound. '/
type ma_sound_group_config as ma_sound_config
type ma_sound_group as ma_sound

declare function ma_sound_group_config_init( ) as ma_sound_group_config         /' Deprecated. Will be removed in version 0.12. Use ma_sound_config_2() instead. '/
declare function ma_sound_group_config_init_2( byval pEngine as ma_engine__fwd ptr ) as ma_sound_group_config  /' Will be renamed to ma_sound_config_init() in version 0.12. '/

type ma_engine_process_proc as sub cdecl( byval as any ptr, byval as float32 ptr, byval as ma_uint64 )

type ma_engine_config
    pResourceManager as ma_resource_manager ptr     /' Can be null in which case a resource manager will be created for you. '/
    pContext as ma_context ptr
    pDevice as ma_device ptr                        /' If set, the caller is responsible for calling ma_engine_data_callback() in the device's data callback. '/
    pPlaybackDeviceID as ma_device_id ptr           /' The ID of the playback device to use with the default listener. '/
    dataCallback as ma_device_data_proc             /' Can be null. Can be used to provide a custom device data callback. '/
    notificationCallback as ma_device_notification_proc
    pLog as ma_log ptr                              /' When set to NULL, will use the context's log. '/
    listenerCount as ma_uint32                      /' Must be between 1 and MA_ENGINE_MAX_LISTENERS. '/
    channels as ma_uint32                           /' The number of channels to use when mixing and spatializing. When set to 0, will use the native channel count of the device. '/
    sampleRate as ma_uint32                         /' The sample rate. When set to 0 will use the native sample rate of the device. '/
    periodSizeInFrames as ma_uint32                 /' If set to something other than 0, updates will always be exactly this size. The underlying device may be a different size, but from the perspective of the mixer that won't matter.'/
    periodSizeInMilliseconds as ma_uint32           /' Used if periodSizeInFrames is unset. '/
    gainSmoothTimeInFrames as ma_uint32             /' The number of frames to interpolate the gain of spatialized sounds across. If set to 0, will use gainSmoothTimeInMilliseconds. '/
    gainSmoothTimeInMilliseconds as ma_uint32       /' When set to 0, gainSmoothTimeInFrames will be used. If both are set to 0, a default value will be used. '/
    defaultVolumeSmoothTimeInPCMFrames as ma_uint32 /' Defaults to 0. Controls the default amount of smoothing to apply to volume changes to sounds. High values means more smoothing at the expense of high latency (will take longer to reach the new volume). '/
    preMixStackSizeInBytes as ma_uint32             /' A stack is used for internal processing in the node graph. This allows you to configure the size of this stack. Smaller values will reduce the maximum depth of your node graph. You should rarely need to modify this. '/
    allocationCallbacks as ma_allocation_callbacks
    noAutoStart as ma_bool32                        /' When set to true, requires an explicit call to ma_engine_start(). This is false by default, meaning the engine will be started automatically in ma_engine_init(). '/
    noDevice as ma_bool32                           /' When set to true, don't create a default device. ma_engine_read_pcm_frames() can be called manually to read data. '/
    monoExpansionMode as ma_mono_expansion_mode     /' Controls how the mono channel should be expanded to other channels when spatialization is disabled on a sound. '/
    pResourceManagerVFS as ma_vfs ptr               /' A pointer to a pre-allocated VFS object to use with the resource manager. This is ignored if pResourceManager is not NULL. '/
    onProcess as ma_engine_process_proc             /' Fired at the end of each call to ma_engine_read_pcm_frames(). For engine's that manage their own internal device (the default configuration), this will be fired from the audio thread, and you do not need to call ma_engine_read_pcm_frames() manually in order to trigger this. '/
    pProcessUserData as any ptr                     /' User data that's passed into onProcess. '/
    resourceManagerResampling as ma_resampler_config  /' The resampling config to use with the resource manager. '/
    pitchResampling as ma_resampler_config          /' The resampling config for the pitch and Doppler effects. You will typically want this to be a fast resampler. For high quality stuff, it's recommended that you pre-resample. '/
end type

declare function ma_engine_config_init( ) as ma_engine_config


type ma_engine
    nodeGraph as ma_node_graph                      /' An engine is a node graph. It should be able to be plugged into any ma_node_graph API (with a cast) which means this must be the first member of this struct. '/
    pResourceManager as ma_resource_manager ptr
    pDevice as ma_device ptr                        /' Optionally set via the config, otherwise allocated by the engine in ma_engine_init(). '/
    pLog as ma_log ptr
    sampleRate as ma_uint32
    listenerCount as ma_uint32
    listeners(0 to 3) as ma_spatializer_listener
    allocationCallbacks as ma_allocation_callbacks
    ownsResourceManager as ma_bool8
    ownsDevice as ma_bool8
    inlinedSoundLock as ma_spinlock                 /' For synchronizing access to the inlined sound list. '/
    pInlinedSoundHead as ma_sound_inlined ptr       /' The first inlined sound. Inlined sounds are tracked in a linked list. '/
    inlinedSoundCount as ma_uint32    /' The total number of allocated inlined sound objects. Used for debugging. '/
    gainSmoothTimeInFrames as ma_uint32             /' The number of frames to interpolate the gain of spatialized sounds across. '/
    defaultVolumeSmoothTimeInPCMFrames as ma_uint32
    monoExpansionMode as ma_mono_expansion_mode
    onProcess as ma_engine_process_proc
    pProcessUserData as any ptr
    pitchResamplingConfig as ma_resampler_config
end type

