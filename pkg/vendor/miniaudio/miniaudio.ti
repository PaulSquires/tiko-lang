declare sub ma_fader_set_fade( byval pFader as ma_fader ptr, byval volumeBeg as float32, byval volumeEnd as float32, byval lengthInFrames as ma_uint64 )
declare sub ma_fader_set_fade_ex( byval pFader as ma_fader ptr, byval volumeBeg as float32, byval volumeEnd as float32, byval lengthInFrames as ma_uint64, byval startOffsetInFrames as ma_int64 )
declare function ma_fader_get_current_volume( byval pFader as const ma_fader ptr ) as float32



/' Spatializer. '/
type ma_vec3f
    x as float32
    y as float32
    z as float32
end type

type ma_atomic_vec3f
    v as ma_vec3f
    lock as ma_spinlock
end type

#if defined(TIKO_OS_WINDOWS)
type ma_attenuation_model as int32
enum
    ma_attenuation_model_none           /' No distance attenuation and no spatialization. '/
    ma_attenuation_model_inverse        /' Equivalent to OpenAL's AL_INVERSE_DISTANCE_CLAMPED. '/
    ma_attenuation_model_linear         /' Linear attenuation. Equivalent to OpenAL's AL_LINEAR_DISTANCE_CLAMPED. '/
    ma_attenuation_model_exponential    /' Exponential attenuation. Equivalent to OpenAL's AL_EXPONENT_DISTANCE_CLAMPED. '/
end enum
#elseif defined(TIKO_OS_LINUX)
type ma_attenuation_model as uint32
enum
    ma_attenuation_model_none           /' No distance attenuation and no spatialization. '/
    ma_attenuation_model_inverse        /' Equivalent to OpenAL's AL_INVERSE_DISTANCE_CLAMPED. '/
    ma_attenuation_model_linear         /' Linear attenuation. Equivalent to OpenAL's AL_LINEAR_DISTANCE_CLAMPED. '/
    ma_attenuation_model_exponential    /' Exponential attenuation. Equivalent to OpenAL's AL_EXPONENT_DISTANCE_CLAMPED. '/
end enum
#endif

#if defined(TIKO_OS_WINDOWS)
type ma_positioning as int32
enum
    ma_positioning_absolute
    ma_positioning_relative
end enum
#elseif defined(TIKO_OS_LINUX)
type ma_positioning as uint32
enum
    ma_positioning_absolute
    ma_positioning_relative
end enum
#endif

#if defined(TIKO_OS_WINDOWS)
type ma_handedness as int32
enum
    ma_handedness_right
    ma_handedness_left
end enum
#elseif defined(TIKO_OS_LINUX)
type ma_handedness as uint32
enum
    ma_handedness_right
    ma_handedness_left
end enum
#endif


type ma_spatializer_listener_config
    channelsOut as ma_uint32
    pChannelMapOut as ma_channel ptr
    handedness as ma_handedness /' Defaults to right. Forward is -1 on the Z axis. In a left handed system, forward is +1 on the Z axis. '/
    coneInnerAngleInRadians as float32
    coneOuterAngleInRadians as float32
    coneOuterGain as float32
    speedOfSound as float32
    worldUp as ma_vec3f
end type

declare function ma_spatializer_listener_config_init( byval channelsOut as ma_uint32 ) as ma_spatializer_listener_config


type ma_spatializer_listener
    config as ma_spatializer_listener_config
    position as ma_atomic_vec3f  /' The absolute position of the listener. '/
    direction as ma_atomic_vec3f /' The direction the listener is facing. The world up vector is config.worldUp. '/
    velocity as ma_atomic_vec3f
    isEnabled as ma_bool32

    /' Memory management. '/
    _ownsHeap as ma_bool32
    _pHeap as any ptr
end type

declare function ma_spatializer_listener_get_heap_size( byval pConfig as const ma_spatializer_listener_config ptr, byval pHeapSizeInBytes as uinteger ptr ) as ma_result
