/' Stereo panner. '/
#if defined(TIKO_OS_WINDOWS)
type ma_pan_mode as int32
enum
    ma_pan_mode_balance = 0     /' Does not blend one side with the other. Technically just a balance. Compatible with other popular audio engines and therefore the default. '/
    ma_pan_mode_pan             /' A true pan. The sound from one side will "move" to the other side and blend with it. '/
end enum
#elseif defined(TIKO_OS_LINUX)
type ma_pan_mode as uint32
enum
    ma_pan_mode_balance = 0     /' Does not blend one side with the other. Technically just a balance. Compatible with other popular audio engines and therefore the default. '/
    ma_pan_mode_pan             /' A true pan. The sound from one side will "move" to the other side and blend with it. '/
end enum
#endif

type ma_panner_config
    format as ma_format
    channels as ma_uint32
    mode as ma_pan_mode
    pan as float32
end type

declare function ma_panner_config_init( byval format as ma_format, byval channels as ma_uint32 ) as ma_panner_config


type ma_panner
    format as ma_format
    channels as ma_uint32
    mode as ma_pan_mode
    pan as float32  /' -1..1 where 0 is no pan, -1 is left side, +1 is right side. Defaults to 0. '/
end type

declare function ma_panner_init( byval pConfig as const ma_panner_config ptr, byval pPanner as ma_panner ptr ) as ma_result
declare function ma_panner_process_pcm_frames( byval pPanner as ma_panner ptr, byval pFramesOut as any ptr, byval pFramesIn as const any ptr, byval frameCount as ma_uint64 ) as ma_result
declare sub ma_panner_set_mode( byval pPanner as ma_panner ptr, byval mode as ma_pan_mode )
declare function ma_panner_get_mode( byval pPanner as const ma_panner ptr ) as ma_pan_mode
declare sub ma_panner_set_pan( byval pPanner as ma_panner ptr, byval pan as float32 )
declare function ma_panner_get_pan( byval pPanner as const ma_panner ptr ) as float32



