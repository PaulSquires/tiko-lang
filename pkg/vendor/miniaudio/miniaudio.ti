    masterVolumeFactor as ma_atomic_float       /' Linear 0..1. Can be read and written simultaneously by different threads. Must be used atomically. '/
    duplexRB as ma_duplex_rb                    /' Intermediary buffer for duplex device on asynchronous backends. '/
    resampling as ma_device_resampling_t
    playback as ma_device_playback_t /' Set to NULL if using default ID, otherwise set to the address of "id". '/ /' If using an explicit device, will be set to a copy of the ID used for initialization. Otherwise cleared to 0. '/ /' Maybe temporary. Likely to be replaced with a query API. '/ /' Set to whatever was passed in when the device was initialized. '/ /' For implementing fixed sized buffer callbacks. Will be null if using variable sized callbacks. '/ /' How many valid frames are sitting in the intermediary buffer. '/ /' In external format. Can be null. '/
    capture as ma_device_capture_t /' Set to NULL if using default ID, otherwise set to the address of "id". '/ /' If using an explicit device, will be set to a copy of the ID used for initialization. Otherwise cleared to 0. '/ /' Maybe temporary. Likely to be replaced with a query API. '/ /' Set to whatever was passed in when the device was initialized. '/ /' For implementing fixed sized buffer callbacks. Will be null if using variable sized callbacks. '/ /' How many valid frames are sitting in the intermediary buffer. '/

    union
        alsa as ma_device_alsa_t /'snd_pcm_t*'/ /'snd_pcm_t*'/ /'struct pollfd*'/ /'struct pollfd*'/ /' eventfd for waking up from poll() when the playback device is stopped. '/ /' eventfd for waking up from poll() when the capture device is stopped. '/
        pulse as ma_device_pulse_t /'pa_mainloop*'/ /'pa_context*'/ /'pa_stream*'/ /'pa_stream*'/
        jack as ma_device_jack_t /'jack_client_t*'/ /'jack_port_t*'/ /'jack_port_t*'/ /' Typed as a float because JACK is always floating point. '/
        null_device as ma_device_null_device_t /' Read and written by multiple threads. Must be used atomically, and must be 32-bit for compiler compatibility. '/
    end union
end type
#endif
#if (defined(_MSC_VER) andalso ((defined(__clang__)) = 0))
    '' C2T-TODO(unreached-branch) miniaudio.h:8080 -- inside a branch no pass takes
''     #pragma warning(pop)
#elseif (defined(__clang__) orelse (defined(__GNUC__) andalso ((__GNUC__ > 4) orelse ((__GNUC__ = 4) andalso (__GNUC_MINOR__ >= 8)))))
