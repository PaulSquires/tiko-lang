#define ma_resource_manager_job_queue_post ma_job_queue_post
#define ma_resource_manager_job_queue_next ma_job_queue_next
#endif
/' END BACKWARDS COMPATIBILITY '/




/' Maximum job thread count will be restricted to this, but this may be removed later and replaced with a heap allocation thereby removing any limitation. '/
#ifndef MA_RESOURCE_MANAGER_MAX_JOB_THREAD_COUNT
#define MA_RESOURCE_MANAGER_MAX_JOB_THREAD_COUNT 64
#endif

#if defined(TIKO_OS_WINDOWS)
type ma_resource_manager_flags as int32
enum
    /' Indicates ma_resource_manager_next_job() should not block. Only valid when the job thread count is 0. '/
    MA_RESOURCE_MANAGER_FLAG_NON_BLOCKING = 1

    /' Disables any kind of multithreading. Implicitly enables MA_RESOURCE_MANAGER_FLAG_NON_BLOCKING. '/
    MA_RESOURCE_MANAGER_FLAG_NO_THREADING = 2
end enum
#elseif defined(TIKO_OS_LINUX)
type ma_resource_manager_flags as uint32
enum
    /' Indicates ma_resource_manager_next_job() should not block. Only valid when the job thread count is 0. '/
    MA_RESOURCE_MANAGER_FLAG_NON_BLOCKING = 1

    /' Disables any kind of multithreading. Implicitly enables MA_RESOURCE_MANAGER_FLAG_NON_BLOCKING. '/
    MA_RESOURCE_MANAGER_FLAG_NO_THREADING = 2
end enum
#endif

type ma_resource_manager_data_source_config
    pFilePath as const zstring ptr
    pFilePathW as const wstring ptr
    pNotifications as const ma_resource_manager_pipeline_notifications ptr
    initialSeekPointInPCMFrames as ma_uint64
    rangeBegInPCMFrames as ma_uint64
    rangeEndInPCMFrames as ma_uint64
    loopPointBegInPCMFrames as ma_uint64
    loopPointEndInPCMFrames as ma_uint64
    flags as ma_uint32
    isLooping as ma_bool32  /' Deprecated. Use the MA_RESOURCE_MANAGER_DATA_SOURCE_FLAG_LOOPING flag in `flags` instead. '/
end type

declare function ma_resource_manager_data_source_config_init( ) as ma_resource_manager_data_source_config


#if defined(TIKO_OS_WINDOWS)
type ma_resource_manager_data_supply_type as int32
enum
    ma_resource_manager_data_supply_type_unknown = 0    /' Used for determining whether or the data supply has been initialized. '/
    ma_resource_manager_data_supply_type_encoded        /' Data supply is an encoded buffer. Connector is ma_decoder. '/
    ma_resource_manager_data_supply_type_decoded        /' Data supply is a decoded buffer. Connector is ma_audio_buffer. '/
    ma_resource_manager_data_supply_type_decoded_paged  /' Data supply is a linked list of decoded buffers. Connector is ma_paged_audio_buffer. '/
end enum
#elseif defined(TIKO_OS_LINUX)
type ma_resource_manager_data_supply_type as uint32
enum
    ma_resource_manager_data_supply_type_unknown = 0    /' Used for determining whether or the data supply has been initialized. '/
    ma_resource_manager_data_supply_type_encoded        /' Data supply is an encoded buffer. Connector is ma_decoder. '/
    ma_resource_manager_data_supply_type_decoded        /' Data supply is a decoded buffer. Connector is ma_audio_buffer. '/
    ma_resource_manager_data_supply_type_decoded_paged  /' Data supply is a linked list of decoded buffers. Connector is ma_paged_audio_buffer. '/
end enum
#endif

type ma_resource_manager_data_supply_backend_t_encoded_t
    pData as const any ptr
    sizeInBytes as uinteger
end type
type ma_resource_manager_data_supply_backend_t_decoded_t
    pData as const any ptr
    totalFrameCount as ma_uint64
    decodedFrameCount as ma_uint64
    format as ma_format
    channels as ma_uint32
    sampleRate as ma_uint32
end type
type ma_resource_manager_data_supply_backend_t_decodedPaged_t
    data as ma_paged_audio_buffer_data
    decodedFrameCount as ma_uint64
    sampleRate as ma_uint32
end type
union ma_resource_manager_data_supply_backend_t
    encoded as ma_resource_manager_data_supply_backend_t_encoded_t
    decoded as ma_resource_manager_data_supply_backend_t_decoded_t
    decodedPaged as ma_resource_manager_data_supply_backend_t_decodedPaged_t
end union
type ma_resource_manager_data_supply
    type as ma_resource_manager_data_supply_type  /' Read and written from different threads so needs to be accessed atomically. '/
    backend as ma_resource_manager_data_supply_backend_t
end type

type ma_resource_manager_data_buffer_node
    hashedName32 as ma_uint32                       /' The hashed name. This is the key. '/
    refCount as ma_uint32
    result as ma_result               /' Result from asynchronous loading. When loading set to MA_BUSY. When fully loaded set to MA_SUCCESS. When deleting set to MA_UNAVAILABLE. '/
    executionCounter as ma_uint32     /' For allocating execution orders for jobs. '/
    executionPointer as ma_uint32     /' For managing the order of execution for asynchronous jobs relating to this object. Incremented as jobs complete processing. '/
    isDataOwnedByResourceManager as ma_bool32       /' Set to true when the underlying data buffer was allocated the resource manager. Set to false if it is owned by the application (via ma_resource_manager_register_*()). '/
    data as ma_resource_manager_data_supply
    pParent as ma_resource_manager_data_buffer_node ptr
    pChildLo as ma_resource_manager_data_buffer_node ptr
    pChildHi as ma_resource_manager_data_buffer_node ptr
end type

union ma_resource_manager_data_buffer_connector_t
    decoder as ma_decoder
    buffer as ma_audio_buffer
    pagedBuffer as ma_paged_audio_buffer
end union
type ma_resource_manager_data_buffer
    ds as ma_data_source_base                       /' Base data source. A data buffer is a data source. '/
    pResourceManager as ma_resource_manager__fwd ptr          /' A pointer to the resource manager that owns this buffer. '/
    pNode as ma_resource_manager_data_buffer_node ptr    /' The data node. This is reference counted and is what supplies the data. '/
    flags as ma_uint32                              /' The flags that were passed used to initialize the buffer. '/
    executionCounter as ma_uint32     /' For allocating execution orders for jobs. '/
    executionPointer as ma_uint32     /' For managing the order of execution for asynchronous jobs relating to this object. Incremented as jobs complete processing. '/
    seekTargetInPCMFrames as ma_uint64              /' Only updated by the public API. Never written nor read from the job thread. '/
    seekToCursorOnNextRead as ma_bool32             /' On the next read we need to seek to the frame cursor. '/
    result as ma_result               /' Keeps track of a result of decoding. Set to MA_BUSY while the buffer is still loading. Set to MA_SUCCESS when loading is finished successfully. Otherwise set to some other code. '/
    isLooping as ma_bool32            /' Can be read and written by different threads at the same time. Must be used atomically. '/
    isConnectorInitialized as ma_atomic_bool32      /' Used for asynchronous loading to ensure we don't try to initialize the connector multiple times while waiting for the node to fully load. '/
    connector as ma_resource_manager_data_buffer_connector_t /' Supply type is ma_resource_manager_data_supply_type_encoded '/ /' Supply type is ma_resource_manager_data_supply_type_decoded '/ /' Supply type is ma_resource_manager_data_supply_type_decoded_paged '/ /' Connects this object to the node's data supply. '/
end type

type ma_resource_manager_data_stream
    ds as ma_data_source_base                   /' Base data source. A data stream is a data source. '/
    pResourceManager as ma_resource_manager__fwd ptr      /' A pointer to the resource manager that owns this data stream. '/
    flags as ma_uint32                          /' The flags that were passed used to initialize the stream. '/
    decoder as ma_decoder                       /' Used for filling pages with data. This is only ever accessed by the job thread. The public API should never touch this. '/
    isDecoderInitialized as ma_bool32           /' Required for determining whether or not the decoder should be uninitialized in MA_JOB_TYPE_RESOURCE_MANAGER_FREE_DATA_STREAM. '/
    totalLengthInPCMFrames as ma_uint64         /' This is calculated when first loaded by the MA_JOB_TYPE_RESOURCE_MANAGER_LOAD_DATA_STREAM. '/
    relativeCursor as ma_uint32                 /' The playback cursor, relative to the current page. Only ever accessed by the public API. Never accessed by the job thread. '/
    absoluteCursor as ma_uint64   /' The playback cursor, in absolute position starting from the start of the file. '/
    currentPageIndex as ma_uint32               /' Toggles between 0 and 1. Index 0 is the first half of pPageData. Index 1 is the second half. Only ever accessed by the public API. Never accessed by the job thread. '/
    executionCounter as ma_uint32 /' For allocating execution orders for jobs. '/
    executionPointer as ma_uint32 /' For managing the order of execution for asynchronous jobs relating to this object. Incremented as jobs complete processing. '/

    /' Written by the public API, read by the job thread. '/
    isLooping as ma_bool32        /' Whether or not the stream is looping. It's important to set the looping flag at the data stream level for smooth loop transitions. '/

    /' Written by the job thread, read by the public API. '/
    pPageData as any ptr                        /' Buffer containing the decoded data of each page. Allocated once at initialization time. '/
    pageFrameCount(0 to 1) as ma_uint32  /' The number of valid PCM frames in each page. Used to determine the last valid frame. '/

    /' Written and read by both the public API and the job thread. These must be atomic. '/
    result as ma_result           /' Result from asynchronous loading. When loading set to MA_BUSY. When initialized set to MA_SUCCESS. When deleting set to MA_UNAVAILABLE. If an error occurs when loading, set to an error code. '/
    isDecoderAtEnd as ma_bool32   /' Whether or not the decoder has reached the end. '/
    isPageValid(0 to 1) as ma_bool32     /' Booleans to indicate whether or not a page is valid. Set to false by the public API, set to true by the job thread. Set to false as the pages are consumed, true when they are filled. '/
    seekCounter as ma_bool32      /' When 0, no seeking is being performed. When > 0, a seek is being performed and reading should be delayed with MA_BUSY. '/
end type

union ma_resource_manager_data_source_backend_t
    buffer as ma_resource_manager_data_buffer
    stream as ma_resource_manager_data_stream
end union
type ma_resource_manager_data_source
    backend as ma_resource_manager_data_source_backend_t /' Must be the first item because we need the first item to be the data source callbacks for the buffer or stream. '/

    flags as ma_uint32                        /' The flags that were passed in to ma_resource_manager_data_source_init(). '/
    executionCounter as ma_uint32   /' For allocating execution orders for jobs. '/
    executionPointer as ma_uint32   /' For managing the order of execution for asynchronous jobs relating to this object. Incremented as jobs complete processing. '/
end type

type ma_resource_manager_config
    allocationCallbacks as ma_allocation_callbacks
    pLog as ma_log ptr
    decodedFormat as ma_format      /' The decoded format to use. Set to ma_format_unknown (default) to use the file's native format. '/
    decodedChannels as ma_uint32    /' The decoded channel count to use. Set to 0 (default) to use the file's native channel count. '/
    decodedSampleRate as ma_uint32  /' the decoded sample rate to use. Set to 0 (default) to use the file's native sample rate. '/
    jobThreadCount as ma_uint32     /' Set to 0 if you want to self-manage your job threads. Defaults to 1. '/
    jobThreadStackSize as uinteger
    jobQueueCapacity as ma_uint32   /' The maximum number of jobs that can fit in the queue at a time. Defaults to MA_JOB_TYPE_RESOURCE_MANAGER_QUEUE_CAPACITY. Cannot be zero. '/
    flags as ma_uint32
    pVFS as ma_vfs ptr              /' Can be NULL in which case defaults will be used. '/
    ppCustomDecodingBackendVTables as ma_decoding_backend_vtable ptr ptr
    customDecodingBackendCount as ma_uint32
    pCustomDecodingBackendUserData as any ptr
    resampling as ma_resampler_config
end type

declare function ma_resource_manager_config_init( ) as ma_resource_manager_config

type ma_resource_manager
    config as ma_resource_manager_config
    pRootDataBufferNode as ma_resource_manager_data_buffer_node ptr /' The root buffer in the binary tree. '/
    dataBufferBSTLock as ma_mutex                                   /' For synchronizing access to the data buffer binary tree. '/
    jobThreads(0 to 63) as ma_thread                                /' The threads for executing jobs. '/
    jobQueue as ma_job_queue                                        /' Multi-consumer, multi-producer job queue for managing jobs for asynchronous decoding and streaming. '/
    defaultVFS as ma_default_vfs                                    /' Only used if a custom VFS is not specified. '/
    log as ma_log                                                   /' Only used if no log was specified in the config. '/
end type

