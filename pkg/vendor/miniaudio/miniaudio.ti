union ma_device_id_custom_t
    i as int32
    s as zstring * 256
    p as any ptr
end union
union ma_device_id
    wasapi(0 to 63) as ma_wchar_win32      /' WASAPI uses a wchar_t string for identification. '/
    dsound(0 to 15) as ma_uint8     /' DirectSound uses a GUID for identification. '/
    winmm as ma_uint32 /'UINT_PTR'/ /' When creating a device, WinMM expects a Win32 UINT_PTR for device identification. In practice it's actually just a UINT. '/
    alsa as zstring * 256           /' ALSA uses a name string for identification. '/
    pulse as zstring * 256          /' PulseAudio uses a name string for identification. '/
    jack as int32                   /' JACK always uses default devices. '/
    coreaudio as zstring * 256      /' Core Audio uses a string for identification. '/
    sndio as zstring * 256          /' "snd/0", etc. '/
    audio4 as zstring * 256         /' "/dev/audio", etc. '/
    oss as zstring * 64             /' "dev/dsp0", etc. "dev/dsp" for the default device. '/
    aaudio as ma_int32              /' AAudio uses a 32-bit integer for identification. '/
    opensl as ma_uint32             /' OpenSL|ES uses a 32-bit unsigned integer for identification. '/
    webaudio as zstring * 32        /' Web Audio always uses default devices for now, but if this changes it'll be a GUID. '/
    custom as ma_device_id_custom_t /' The custom backend could be anything. Give them a few options. '/
    nullbackend as int32            /' The null backend uses an integer for device IDs. '/
end union

