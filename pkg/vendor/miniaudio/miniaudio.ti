''         #define MA_GNUC_INLINE_HINT inline
    '' C2T-TODO(conditional) miniaudio.h:3990 -- tiko would take another branch where clang does not
''     #endif

    #if (((__GNUC__ > 3) orelse ((__GNUC__ = 3) andalso (__GNUC_MINOR__ >= 2))) orelse defined(__clang__))
'' c2t: export macro MA_INLINE (decoration, stripped where used)
        '' C2T-NOTE(decoration) miniaudio.h:3994 -- '__attribute__' means nothing to tiko: defined, empty
        #define MA_NO_INLINE
    #else
'' c2t: export macro MA_INLINE (decoration, stripped where used)
