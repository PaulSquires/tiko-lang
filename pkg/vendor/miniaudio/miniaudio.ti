/'***********************************************************************************************************************************************************

Resource Manager

***********************************************************************************************************************************************************'/
/' The resource manager cannot be enabled if there is no decoder. '/
#if (((defined(MA_NO_RESOURCE_MANAGER)) = 0) andalso defined(MA_NO_DECODING))
#define MA_NO_RESOURCE_MANAGER
#endif

#ifndef MA_NO_RESOURCE_MANAGER
type ma_resource_manager__fwd as ma_resource_manager
type ma_resource_manager_data_buffer_node__fwd as ma_resource_manager_data_buffer_node
type ma_resource_manager_data_buffer__fwd as ma_resource_manager_data_buffer
type ma_resource_manager_data_stream__fwd as ma_resource_manager_data_stream
type ma_resource_manager_data_source__fwd as ma_resource_manager_data_source

#if defined(TIKO_OS_WINDOWS)
type ma_resource_manager_data_source_flags as int32
enum
    MA_RESOURCE_MANAGER_DATA_SOURCE_FLAG_STREAM = 1                     /' When set, does not load the entire data source in memory. Disk I/O will happen on job threads. '/
    MA_RESOURCE_MANAGER_DATA_SOURCE_FLAG_DECODE = 2                     /' Decode data before storing in memory. When set, decoding is done at the resource manager level rather than the mixing thread. Results in faster mixing, but higher memory usage. '/
    MA_RESOURCE_MANAGER_DATA_SOURCE_FLAG_ASYNC = 4                      /' When set, the resource manager will load the data source asynchronously. '/
    MA_RESOURCE_MANAGER_DATA_SOURCE_FLAG_WAIT_INIT = 8                  /' When set, waits for initialization of the underlying data source before returning from ma_resource_manager_data_source_init(). '/
    MA_RESOURCE_MANAGER_DATA_SOURCE_FLAG_UNKNOWN_LENGTH = 16            /' Gives the resource manager a hint that the length of the data source is unknown and calling `ma_data_source_get_length_in_pcm_frames()` should be avoided. '/
    MA_RESOURCE_MANAGER_DATA_SOURCE_FLAG_LOOPING = 32                   /' When set, configures the data source to loop by default. '/
end enum
#elseif defined(TIKO_OS_LINUX)
type ma_resource_manager_data_source_flags as uint32
enum
    MA_RESOURCE_MANAGER_DATA_SOURCE_FLAG_STREAM = 1                     /' When set, does not load the entire data source in memory. Disk I/O will happen on job threads. '/
    MA_RESOURCE_MANAGER_DATA_SOURCE_FLAG_DECODE = 2                     /' Decode data before storing in memory. When set, decoding is done at the resource manager level rather than the mixing thread. Results in faster mixing, but higher memory usage. '/
    MA_RESOURCE_MANAGER_DATA_SOURCE_FLAG_ASYNC = 4                      /' When set, the resource manager will load the data source asynchronously. '/
    MA_RESOURCE_MANAGER_DATA_SOURCE_FLAG_WAIT_INIT = 8                  /' When set, waits for initialization of the underlying data source before returning from ma_resource_manager_data_source_init(). '/
    MA_RESOURCE_MANAGER_DATA_SOURCE_FLAG_UNKNOWN_LENGTH = 16            /' Gives the resource manager a hint that the length of the data source is unknown and calling `ma_data_source_get_length_in_pcm_frames()` should be avoided. '/
    MA_RESOURCE_MANAGER_DATA_SOURCE_FLAG_LOOPING = 32                   /' When set, configures the data source to loop by default. '/
end enum
#endif


/'
Pipeline notifications used by the resource manager. Made up of both an async notification and a fence, both of which are optional.
'/
type ma_resource_manager_pipeline_stage_notification
    pNotification as ma_async_notification ptr
    pFence as ma_fence ptr
end type

type ma_resource_manager_pipeline_notifications
    init as ma_resource_manager_pipeline_stage_notification  /' Initialization of the decoder. '/
    done as ma_resource_manager_pipeline_stage_notification  /' Decoding fully completed. '/
end type

declare function ma_resource_manager_pipeline_notifications_init( ) as ma_resource_manager_pipeline_notifications



