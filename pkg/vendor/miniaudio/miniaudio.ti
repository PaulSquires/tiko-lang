    pContext as ma_context ptr
    type as ma_device_type
    sampleRate as ma_uint32
    state as ma_atomic_device_state             /' The state of the device is variable and can change at any time on any thread. Must be used atomically. '/
    onData as ma_device_data_proc               /' Set once at initialization time and should not be changed after. '/
    onNotification as ma_device_notification_proc /' Set once at initialization time and should not be changed after. '/
    onStop as ma_stop_proc                      /' DEPRECATED. Use the notification callback instead. Set once at initialization time and should not be changed after. '/
    pUserData as any ptr                        /' Application defined data. '/
    startStopLock as ma_mutex
    wakeupEvent as ma_event
    startEvent as ma_event
    stopEvent as ma_event
    thread as ma_thread
    workResult as ma_result                     /' This is set by the worker thread after it's finished doing a job. '/
    isOwnerOfContext as ma_bool8                /' When set to true, uninitializing the device will also uninitialize the context. Set to true when NULL is passed into ma_device_init(). '/
    noPreSilencedOutputBuffer as ma_bool8
    noClip as ma_bool8
    noDisableDenormals as ma_bool8
    noFixedSizedCallback as ma_bool8
    masterVolumeFactor as ma_atomic_float       /' Linear 0..1. Can be read and written simultaneously by different threads. Must be used atomically. '/
    duplexRB as ma_duplex_rb                    /' Intermediary buffer for duplex device on asynchronous backends. '/
    resampling as ma_device_resampling_t
    playback as ma_device_playback_t /' Set to NULL if using default ID, otherwise set to the address of "id". '/ /' If using an explicit device, will be set to a copy of the ID used for initialization. Otherwise cleared to 0. '/ /' Maybe temporary. Likely to be replaced with a query API. '/ /' Set to whatever was passed in when the device was initialized. '/ /' For implementing fixed sized buffer callbacks. Will be null if using variable sized callbacks. '/ /' How many valid frames are sitting in the intermediary buffer. '/ /' In external format. Can be null. '/
    capture as ma_device_capture_t /' Set to NULL if using default ID, otherwise set to the address of "id". '/ /' If using an explicit device, will be set to a copy of the ID used for initialization. Otherwise cleared to 0. '/ /' Maybe temporary. Likely to be replaced with a query API. '/ /' Set to whatever was passed in when the device was initialized. '/ /' For implementing fixed sized buffer callbacks. Will be null if using variable sized callbacks. '/ /' How many valid frames are sitting in the intermediary buffer. '/

    union
        wasapi as ma_device_wasapi_t /'IAudioClient*'/ /'IAudioClient*'/ /'IAudioRenderClient*'/ /'IAudioCaptureClient*'/ /'IMMDeviceEnumerator*'/ /' Used for IMMNotificationClient notifications. Required for detecting default device changes. '/ /'HANDLE'/ /' Auto reset. Initialized to signaled. '/ /'HANDLE'/ /' Auto reset. Initialized to unsignaled. '/ /' Value from GetBufferSize(). internalPeriodSizeInFrames is not set to the _actual_ buffer size when low-latency shared mode is being used due to the way the IAudioClient3 API works. '/ /' Can be read and written simultaneously across different threads. Must be used atomically, and must be 32-bit. '/ /' Can be read and written simultaneously across different threads. Must be used atomically, and must be 32-bit. '/ /' When set to true, disables the use of AUDCLNT_STREAMFLAGS_AUTOCONVERTPCM. '/ /' When set to true, disables the use of AUDCLNT_STREAMFLAGS_SRC_DEFAULT_QUALITY. '/
        dsound as ma_device_dsound_t /'LPDIRECTSOUND'/ /'LPDIRECTSOUNDBUFFER'/ /'LPDIRECTSOUNDBUFFER'/ /'LPDIRECTSOUNDCAPTURE'/ /'LPDIRECTSOUNDCAPTUREBUFFER'/
        winmm as ma_device_winmm_t /'HWAVEOUT'/ /'HWAVEIN'/ /'HANDLE'/ /'HANDLE'/ /' [0,periods). Used as an index into pWAVEHDRPlayback. '/ /' [0,periods). Used as an index into pWAVEHDRCapture. '/ /' The number of PCM frames consumed in the buffer in pWAVEHEADER[iNextHeader]. '/ /' ^^^ '/ /'WAVEHDR*'/ /' One instantiation for each period. '/ /'WAVEHDR*'/ /' One instantiation for each period. '/ /' Used internally and is used for the heap allocated data for the intermediary buffer and the WAVEHDR structures. '/
        jack as ma_device_jack_t /'jack_client_t*'/ /'jack_port_t*'/ /'jack_port_t*'/ /' Typed as a float because JACK is always floating point. '/
        null_device as ma_device_null_device_t /' Read and written by multiple threads. Must be used atomically, and must be 32-bit for compiler compatibility. '/
    end union
end type
