'' Create a demuxer with a plm_buffer as source. This will also attempt to read
'' the pack and system headers from the buffer.

declare function plm_demux_create( byval buffer as plm_buffer_t ptr, byval destroy_when_done as int32 ) as plm_demux_t ptr


'' Destroy a demuxer and free all data.

declare sub plm_demux_destroy( byval self as plm_demux_t ptr )


'' Returns TRUE/FALSE whether pack and system headers have been found. This will
'' attempt to read the headers if non are present yet.

declare function plm_demux_has_headers( byval self as plm_demux_t ptr ) as int32


'' Probe the file for the actual number of video/audio streams. See
'' plm_probe() for the details.

declare function plm_demux_probe( byval self as plm_demux_t ptr, byval probesize as uinteger ) as int32


'' Returns the number of video streams found in the system header. This will
'' attempt to read the system header if non is present yet.

declare function plm_demux_get_num_video_streams( byval self as plm_demux_t ptr ) as int32


'' Returns the number of audio streams found in the system header. This will
'' attempt to read the system header if non is present yet.

declare function plm_demux_get_num_audio_streams( byval self as plm_demux_t ptr ) as int32


'' Rewind the internal buffer. See plm_buffer_rewind().

declare sub plm_demux_rewind( byval self as plm_demux_t ptr )


'' Get whether the file has ended. This will be cleared on seeking or rewind.

declare function plm_demux_has_ended( byval self as plm_demux_t ptr ) as int32


'' Seek to a packet of the specified type with a PTS just before specified time.
'' If force_intra is TRUE, only packets containing an intra frame will be
'' considered - this only makes sense when the type is PLM_DEMUX_PACKET_VIDEO_1.
'' Note that the specified time is considered 0-based, regardless of the first
'' PTS in the data source.

declare function plm_demux_seek( byval self as plm_demux_t ptr, byval time_ as float64, byval type_ as int32, byval force_intra as int32 ) as plm_packet_t ptr


'' Get the PTS of the first packet of this type. Returns PLM_PACKET_INVALID_TS
'' if not packet of this packet type can be found.

declare function plm_demux_get_start_time( byval self as plm_demux_t ptr, byval type_ as int32 ) as float64


'' Get the duration for the specified packet type - i.e. the span between the
'' the first PTS and the last PTS in the data source. This only makes sense when
'' the underlying data source is a file or fixed memory.

declare function plm_demux_get_duration( byval self as plm_demux_t ptr, byval type_ as int32 ) as float64


'' Decode and return the next packet. The returned packet_t is valid until
'' the next call to plm_demux_decode() or until the demuxer is destroyed.

declare function plm_demux_decode( byval self as plm_demux_t ptr ) as plm_packet_t ptr



'' -----------------------------------------------------------------------------
'' plm_video public API
'' Decode MPEG1 Video ("mpeg1") data into raw YCrCb frames


'' Create a video decoder with a plm_buffer as source.

declare function plm_video_create_with_buffer( byval buffer as plm_buffer_t ptr, byval destroy_when_done as int32 ) as plm_video_t ptr


'' Destroy a video decoder and free all data.

declare sub plm_video_destroy( byval self as plm_video_t ptr )


'' Get whether a sequence header was found and we can accurately report on
'' dimensions and framerate.

declare function plm_video_has_header( byval self as plm_video_t ptr ) as int32


'' Get the framerate in frames per second.

declare function plm_video_get_framerate( byval self as plm_video_t ptr ) as float64
declare function plm_video_get_pixel_aspect_ratio( byval self as plm_video_t ptr ) as float64


'' Get the display width/height.

declare function plm_video_get_width( byval self as plm_video_t ptr ) as int32
declare function plm_video_get_height( byval self as plm_video_t ptr ) as int32


'' Set "no delay" mode. When enabled, the decoder assumes that the video does
'' *not* contain any B-Frames. This is useful for reducing lag when streaming.
'' The default is FALSE.

declare sub plm_video_set_no_delay( byval self as plm_video_t ptr, byval no_delay as int32 )


'' Get the current internal time in seconds.

declare function plm_video_get_time( byval self as plm_video_t ptr ) as float64


'' Set the current internal time in seconds. This is only useful when you
'' manipulate the underlying video buffer and want to enforce a correct
'' timestamps.

declare sub plm_video_set_time( byval self as plm_video_t ptr, byval time_ as float64 )


'' Rewind the internal buffer. See plm_buffer_rewind().

declare sub plm_video_rewind( byval self as plm_video_t ptr )


'' Get whether the file has ended. This will be cleared on rewind.

declare function plm_video_has_ended( byval self as plm_video_t ptr ) as int32


'' Decode and return one frame of video and advance the internal time by
'' 1/framerate seconds. The returned frame_t is valid until the next call of
'' plm_video_decode() or until the video decoder is destroyed.

declare function plm_video_decode( byval self as plm_video_t ptr ) as plm_frame_t ptr


'' Convert the YCrCb data of a frame into interleaved R G B data. The stride
'' specifies the width in bytes of the destination buffer. I.e. the number of
'' bytes from one line to the next. The stride must be at least
'' (frame->width * bytes_per_pixel). The buffer pointed to by *dest must have a
'' size of at least (stride * frame->height).
'' Note that the alpha component of the dest buffer is always left untouched.

declare sub plm_frame_to_rgb( byval frame as plm_frame_t ptr, byval dest as uint8 ptr, byval stride as int32 )
declare sub plm_frame_to_bgr( byval frame as plm_frame_t ptr, byval dest as uint8 ptr, byval stride as int32 )
declare sub plm_frame_to_rgba( byval frame as plm_frame_t ptr, byval dest as uint8 ptr, byval stride as int32 )
declare sub plm_frame_to_bgra( byval frame as plm_frame_t ptr, byval dest as uint8 ptr, byval stride as int32 )
declare sub plm_frame_to_argb( byval frame as plm_frame_t ptr, byval dest as uint8 ptr, byval stride as int32 )
declare sub plm_frame_to_abgr( byval frame as plm_frame_t ptr, byval dest as uint8 ptr, byval stride as int32 )


'' -----------------------------------------------------------------------------
'' plm_audio public API
'' Decode MPEG-1 Audio Layer II ("mp2") data into raw samples


'' Create an audio decoder with a plm_buffer as source.

declare function plm_audio_create_with_buffer( byval buffer as plm_buffer_t ptr, byval destroy_when_done as int32 ) as plm_audio_t ptr


'' Destroy an audio decoder and free all data.

declare sub plm_audio_destroy( byval self as plm_audio_t ptr )


'' Get whether a frame header was found and we can accurately report on
'' samplerate.

declare function plm_audio_has_header( byval self as plm_audio_t ptr ) as int32


'' Get the samplerate in samples per second.

declare function plm_audio_get_samplerate( byval self as plm_audio_t ptr ) as int32


'' Get the current internal time in seconds.

declare function plm_audio_get_time( byval self as plm_audio_t ptr ) as float64


'' Set the current internal time in seconds. This is only useful when you
'' manipulate the underlying video buffer and want to enforce a correct
'' timestamps.

declare sub plm_audio_set_time( byval self as plm_audio_t ptr, byval time_ as float64 )


'' Rewind the internal buffer. See plm_buffer_rewind().

declare sub plm_audio_rewind( byval self as plm_audio_t ptr )


'' Get whether the file has ended. This will be cleared on rewind.

declare function plm_audio_has_ended( byval self as plm_audio_t ptr ) as int32


'' Decode and return one "frame" of audio and advance the internal time by
'' (PLM_AUDIO_SAMPLES_PER_FRAME/samplerate) seconds. The returned samples_t
'' is valid until the next call of plm_audio_decode() or until the audio
'' decoder is destroyed.

declare function plm_audio_decode( byval self as plm_audio_t ptr ) as plm_samples_t ptr



end extern






