'' Altered for tiko's vendor/SDL3: each SDL3/SDL_*.bi is SDL_*.ti beside this file, the
'' includes below say so, the '#inclib "SDL3"' is SDL3.tiko's '#foreignlib', and on Linux
'' SDL_endian.ti says little-endian itself rather than including endian.bi.

'' SDL_events.bi  (195) mod => mod_
'' SDL_stdinc.bi (526) SDL_log() => SDL_loga()

#pragma once

'' (the library: SDL3.tiko's #foreignlib)

