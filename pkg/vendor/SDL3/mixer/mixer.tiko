'' vendor/SDL3/mixer -- SDL3_mixer 3.2.4, SDL 3's audio mixer library (MIX_*), as one import:
''
''     #import "vendor/SDL3/mixer" link dynamic        (or neither)
''
'' It brings vendor/SDL3 with it: SDL's own names come across too, and SDL3 is linked.
'' The header is SDL_mixer.ti beside this file, the sdl3-freebasic binding (GaBurdis, MIT).
''
'' THE LIBRARY: as vendor/SDL3's -- 'link dynamic' alone. On Windows ../lib/SDL3_mixer.dll,
'' beside SDL3.dll, copied beside the program; on Linux the system's, '-lSDL3_mixer' from
'' the distribution's development package, and on macOS Homebrew's (brew install sdl3_mixer).
#module "mixer"

#import "vendor/SDL3" public

public #include once "SDL_mixer.ti"

#if defined( TIKO_OS_LINUX ) or defined( TIKO_OS_MACOS )
    #foreignlib SDL3_mixer dynamic "system:SDL3_mixer"
#else
    #foreignlib SDL3_mixer dynamic "../lib/SDL3_mixer"
#endif
