'
' tkMaskEdit -- a single-line text box whose input is shaped by a mask (docs/tkControls/MASKEDIT.md).
' The rules are tkMask's; this control is the box around them.
'
' THE SHAPE: a container (not a tab stop; a programmatic focus lands on the field) holding one
' tkTextBox child that fills it and keeps tkTextBox's whole look, theme and DPI handling. The
' child's edit filter is tkMask_Apply, so typing, Backspace / Delete, Cut / Copy / Paste and the
' context menu all pass through the mask while undo, the IME and the clipboard stay tkTextBox's.
'
' THE TEXT has two forms: the EDIT form (the template's shape: literals, prompts in empty slots)
' while focused, and what an unfocused box SHOWS: nothing when empty (the cue banner's turn, D-4),
' the prompts as spaces with HidePromptOnLeave, else the edit form. The swap is a silent SetText,
' so it resets the child's undo history (D-4); a box that shows its edit form unfocused never swaps.
'
' NOTIFICATIONS: Change on every user edit; Rejected( pos, reason, text ) for a refused edit or a
' paste that stopped part-way (after its Change); Commit on Enter and on focus loss, after which an
' invalid value turns the border to ErrorColor (ShowError); Focus. Every setter is silent.
'
' NUMERIC (M2): the text is always the display form ("$1,234.50"), regrouped as typed; the value is
' GetValue / SetValue, clamped into [Min, Max] on commit (Change when that moves it), never while
' typing; right-aligned when the mask is set.
'
' DATE / TIME / DATETIME (M3): segments typed with auto-advance (tkMask), Up / Down / PgUp / PgDn
' step the segment at the caret (one undo step, a Change); the value is TKDATE / TKTIME / TKDATETIME
' (Get/SetDateValue, Get/SetTimeValue, Get/SetDateTimeValue); a date outside its range, or one that
' does not exist (31/02), is flagged by IsValid and the error border on commit, never changed (D-13).
'
' REGEX (M4): free text kept only while it can still become a match of the pattern (PCRE2, through
' tkMaskEditRegex -- the host calls tkMaskEditRegex_Enable once, so a program without regex masks
' links no PCRE2); deleting is always allowed (D-14); complete = a full match; SetText keeps a
' value as given and IsValid says whether it matches.
#module "tkMaskEdit"

#import "../tkHost" public
#import "../tkTheme" public
#import "../tkTextBox" public
#import "../tkMask" public
#import "../tkCalendar" public
#import "../tkTimePanel" public
using tkHost
using tkPaint
using tkTheme
using tkTextBox
using tkMask
using tkCalendar
using tkTimePanel

public type TKMASKEDIT_COLORS as TKTEXTBOX_COLORS

public type MSK_ChangeCallbackSub as sub( byval hCtrl as TK_WIDGET ptr )
public type MSK_RejectedCallbackSub as sub( byval hCtrl as TK_WIDGET ptr, byval nPos as long, byval nReason as long, _
                                            byref sText as const ustring )
public type MSK_CommitCallbackSub as sub( byval hCtrl as TK_WIDGET ptr )
public type MSK_FocusCallbackSub as sub( byval hCtrl as TK_WIDGET ptr, byval bGotFocus as boolean )

public type TKMASKEDIT_STATE
    hWin          as TK_WIDGET ptr
    hEdit         as TK_WIDGET ptr       ' the tkTextBox child
    id            as long
    spec          as TKMASK_SPEC
    bMasked       as boolean             ' a mask is set (no mask: a plain text box)
    sEdit         as string              ' the edit form, UTF-8: the value while unfocused
    bFocused      as boolean
    bHidePrompt   as boolean
    nValueFormat  as long = TKMASK_FMT_RAW
    nCopyFormat   as long = TKMASK_FMT_LITERALS
    bShowError    as boolean = true
    bZeroWhenEmpty as boolean            ' NUMERIC: an empty box commits as 0
    nPendingRej   as long                ' a partial paste's reason, reported after its Change
    nPendingPos   as long
    sPendingIns   as string
    bRaw          as boolean             ' a spin: the filter takes the next ReplaceSel as it is
    nRawCaret     as long
    ChangeCallback   as MSK_ChangeCallbackSub
    RejectedCallback as MSK_RejectedCallbackSub
    CommitCallback   as MSK_CommitCallbackSub
    FocusCallback    as MSK_FocusCallbackSub
end type

private function ME( byval h as TK_WIDGET ptr ) as TKMASKEDIT_STATE ptr
    if h = 0 then return 0
    return cast( TKMASKEDIT_STATE ptr, h->pData )
end function

private function MeOfEdit( byval hEdit as TK_WIDGET ptr ) as TKMASKEDIT_STATE ptr
    return ME( tkWidget_Parent( hEdit ) )
end function

private function MeEditText( byval p as TKMASKEDIT_STATE ptr ) as string
    dim as ustring u = tkTextBox_GetText( p->hEdit )
    dim as string s = u
    return s
end function

private sub MeSetEditText( byval p as TKMASKEDIT_STATE ptr, byref s as const string )
    dim as ustring u = s
    tkTextBox_SetText( p->hEdit, u )
end sub

' What the child should hold now: the edit form while focused, the shown form otherwise.
private function MeShown( byval p as TKMASKEDIT_STATE ptr ) as string
    if p->bMasked = false then return p->sEdit
    if p->bFocused then return p->sEdit
    return tkMask_Display( p->spec, p->sEdit, p->bHidePrompt )
end function

' The child brought in line with sEdit and the focus (silent). Unchanged text is left alone, so
' its undo history survives.
private sub MeSync( byval p as TKMASKEDIT_STATE ptr )
    dim as string want = MeShown( p )
    if MeEditText( p ) <> want then MeSetEditText( p, want )
end sub

' The screen keyboard: a number pad when every editable slot takes digits (0 9 #).
private sub MeTextKind( byval p as TKMASKEDIT_STATE ptr )
    dim as long k = TK_TEXT_LINE
    if p->bMasked andalso (p->spec.kind = TKMASK_NUMERIC) then
        k = iif( p->spec.fmt.dec > 0, TK_TEXT_DECIMAL, TK_TEXT_INTEGER )
    elseif p->bMasked andalso (p->spec.kind >= TKMASK_DATE) andalso (p->spec.kind <= TKMASK_DATETIME) then
        k = TK_TEXT_INTEGER                    ' digits only: the separators come by themselves
    elseif p->bMasked andalso (p->spec.kind = TKMASK_FIXED) then
        k = TK_TEXT_INTEGER
        for i as long = 0 to p->spec.nSlots - 1
            select case p->spec.slots(i).kind
            case TKMS_LITERAL, TKMS_DIGIT, TKMS_DIGITSPACE, TKMS_DIGITSIGN
            case else : k = TK_TEXT_LINE : exit for
            end select
        next
    end if
    tkWidget_SetTextKind( p->hEdit, k )
end sub

private sub MeFireRejected( byval p as TKMASKEDIT_STATE ptr, byval nPos as long, byval nReason as long, byref ins as const string )
    if p->RejectedCallback = 0 then exit sub
    dim as ustring u = ins
    p->RejectedCallback( p->hWin, nPos, nReason, u )
end sub

' Enter or focus loss. NUMERIC: the value clamped into [Min, Max] (Change when that moves it), an
' empty box stamped 0 with ZeroWhenEmpty (silently, as tkTextBox's). Then the error tint for an
' invalid value, then Commit.
private sub MeCommit( byval p as TKMASKEDIT_STATE ptr )
    if p->bFocused then p->sEdit = MeEditText( p )
    if p->bMasked andalso (p->spec.kind = TKMASK_NUMERIC) then
        dim as float64 v
        if tkMask_GetNumber( p->spec, p->sEdit, v ) then
            dim as float64 c = tkMask_Clamp( p->spec, v )
            if c <> v then
                p->sEdit = tkMask_TextOfNumber( p->spec, c )
                MeSync( p )
                if p->ChangeCallback then p->ChangeCallback( p->hWin )
            end if
        elseif p->bZeroWhenEmpty andalso (p->bFocused = false) then
            p->sEdit = tkMask_TextOfNumber( p->spec, tkMask_Clamp( p->spec, 0 ) )
        end if
    end if
    if p->bMasked andalso p->bShowError then
        if tkMask_IsValid( p->spec, p->sEdit ) = false then tkTextBox_SetError( p->hEdit, true )
    end if
    if p->CommitCallback then p->CommitCallback( p->hWin )
end sub

' ---- the child's callbacks ----------------------------------------------------------------------
private function MeFilter( byval e as TKTEXTBOX_EDITINFO ptr ) as boolean
    dim as TKMASKEDIT_STATE ptr p = cast( TKMASKEDIT_STATE ptr, e->pUser )
    if (p = 0) orelse (p->bMasked = false) then
        e->outText = left( e->text, e->lo ) & e->ins & mid( e->text, e->hi + 1 )
        e->outCaret = e->lo + len( e->ins )
        return true
    end if
    if e->reason = TXT_EDIT_COPY then
        e->outText = tkMask_ValueTextRange( p->spec, e->text, e->lo, e->hi, p->nCopyFormat )
        return true
    end if
    if p->bRaw then
        ' a spin's whole new text, through ReplaceSel so it is one undo step
        p->bRaw = false
        e->outText = e->ins
        e->outCaret = p->nRawCaret
        return true
    end if
    dim as long reason
    select case e->reason
    case TXT_EDIT_BACKSPACE : reason = TKMASK_EDIT_BACKSPACE
    case TXT_EDIT_DELETE : reason = TKMASK_EDIT_DELETE
    case TXT_EDIT_PASTE : reason = TKMASK_EDIT_PASTE
    case TXT_EDIT_CUT : reason = TKMASK_EDIT_CUT
    case TXT_EDIT_REPLACE : reason = TKMASK_EDIT_REPLACE
    case else : reason = TKMASK_EDIT_TYPE
    end select
    dim as string s = e->text
    dim as int32 caret, rej
    if tkMask_Apply( p->spec, s, e->lo, e->hi, e->ins, reason, caret, rej ) = false then
        MeFireRejected( p, e->lo, rej, e->ins )
        return false
    end if
    if rej <> TKMASK_REJ_NONE then
        p->nPendingRej = rej : p->nPendingPos = caret : p->sPendingIns = e->ins
    end if
    e->outText = s
    e->outCaret = caret
    return true
end function

private sub MeOnEditChange( byval hEdit as TK_WIDGET ptr )
    dim as TKMASKEDIT_STATE ptr p = MeOfEdit( hEdit )
    if p = 0 then exit sub
    p->sEdit = MeEditText( p )
    if p->ChangeCallback then p->ChangeCallback( p->hWin )
    if p->nPendingRej <> TKMASK_REJ_NONE then
        dim as long r = p->nPendingRej
        p->nPendingRej = TKMASK_REJ_NONE
        MeFireRejected( p, p->nPendingPos, r, p->sPendingIns )
    end if
end sub

private sub MeOnEditFocus( byval hEdit as TK_WIDGET ptr, byval bGot as boolean )
    dim as TKMASKEDIT_STATE ptr p = MeOfEdit( hEdit )
    if p = 0 then exit sub
    if bGot then
        p->bFocused = true
        if p->bMasked then
            if tkMask_IsEmpty( p->spec, p->sEdit ) then
                p->sEdit = tkMask_Template( p->spec )
                MeSync( p )
                dim as long f = tkMask_FirstEmpty( p->spec, p->sEdit )
                if f < 0 then f = 0
                tkTextBox_SetSel( p->hEdit, f, f )
            elseif MeEditText( p ) <> p->sEdit then
                MeSync( p )
                if tkTextBox_GetSelectOnFocus( p->hEdit ) then tkTextBox_SetSel( p->hEdit, 0, -1 )
            end if
        end if
    else
        p->bFocused = false
        if p->bMasked then p->sEdit = MeEditText( p )
        MeCommit( p )
        if p->bMasked then MeSync( p )
    end if
    if p->FocusCallback then p->FocusCallback( p->hWin, bGot )
end sub

' A spin: the segment at the caret stepped by tkMask_Spin, landed through ReplaceSel (one undo
' step, the caret kept), then Change -- a user's edit.
private sub MeSpin( byval p as TKMASKEDIT_STATE ptr, byval delta as long )
    dim as string s = MeEditText( p )
    dim as integer a, b
    tkTextBox_GetSel( p->hEdit, a, b )
    dim as int32 caret = b
    if tkMask_Spin( p->spec, s, caret, delta ) = false then exit sub
    p->bRaw = true
    p->nRawCaret = caret
    tkTextBox_SetSel( p->hEdit, 0, -1 )
    dim as ustring u = s
    tkTextBox_ReplaceSel( p->hEdit, u )
    p->bRaw = false
    p->sEdit = MeEditText( p )
    if p->ChangeCallback then p->ChangeCallback( p->hWin )
end sub

private sub MeOnEditEnter( byval hEdit as TK_WIDGET ptr )
    dim as TKMASKEDIT_STATE ptr p = MeOfEdit( hEdit )
    if p then MeCommit( p )
end sub

' Insert toggles insert mode; a click never leaves the caret past the first empty slot (D-5).
private function MeOnEditMessage( byval m as TKTEXTBOX_MESSAGEINFO ptr ) as boolean
    dim as TKMASKEDIT_STATE ptr p = MeOfEdit( m->hTextBox )
    if (p = 0) orelse (p->bMasked = false) then return false
    select case m->msg
    case TKM_KEYDOWN
        dim as boolean bPlain = (m->mods and (SDL_KMOD_SHIFT or TK_KMOD_PRIMARY or SDL_KMOD_ALT)) = 0
        if (m->key = SDLK_INSERT) andalso bPlain then
            p->spec.overwrite = (p->spec.overwrite = false)
            return true
        end if
        ' DATE / TIME / DATETIME: Up / Down step the segment at the caret, PgUp / PgDn by 10 (D-12)
        select case p->spec.kind
        case TKMASK_DATE, TKMASK_TIME, TKMASK_DATETIME
            dim as long delta = 0
            select case m->key
            case SDLK_UP : delta = 1
            case SDLK_DOWN : delta = -1
            case SDLK_PAGEUP : delta = 10
            case SDLK_PAGEDOWN : delta = -10
            end select
            if (delta <> 0) andalso bPlain then
                if tkTextBox_GetReadOnly( p->hEdit ) = false then MeSpin( p, delta )
                return true
            end if
        end select
    case TKM_LBUTTONUP
        dim as integer a, b
        tkTextBox_GetSel( p->hEdit, a, b )
        if a = b then
            dim as long f = tkMask_FirstEmpty( p->spec, MeEditText( p ) )
            if (f >= 0) andalso (a > f) then tkTextBox_SetSel( p->hEdit, f, f )
        end if
    end select
    return false
end function

private function MeProc( byval w as TK_WIDGET ptr, byval m as TK_MSG ptr ) as boolean
    dim as TKMASKEDIT_STATE ptr p = ME( w )
    if p = 0 then return false
    select case m->msg
    case TKM_PAINT
        return true                          ' the field covers the control
    case TKM_SIZE
        tkWidget_SetPos( p->hEdit, 0, 0, w->cw, w->ch )
        return true
    case TKM_SETFOCUS
        ' the container is not a tab stop; a programmatic focus lands on the field
        tkHost_SetFocus( w->pHost, p->hEdit )
        return true
    case TKM_DESTROY
        delete p
        w->pData = 0
        return true
    end select
    return false
end function


' ==========================================================================================
' Public API
' ==========================================================================================
public function tkMaskEdit_Create( byval hParent as TK_WIDGET ptr, byval CtrlID as long ) as TK_WIDGET ptr
    if hParent = 0 then return 0
    dim as TKMASKEDIT_STATE ptr p = new TKMASKEDIT_STATE
    p->id = CtrlID
    dim as TK_WIDGET ptr w = tkWidget_CreateChild( hParent, CtrlID, @MeProc, p )
    p->hWin = w
    p->hEdit = tkTextBox_Create( w, CtrlID )
    tkTextBox_SetChangeCallback( p->hEdit, @MeOnEditChange )
    tkTextBox_SetFocusCallback( p->hEdit, @MeOnEditFocus )
    tkTextBox_SetEnterPressedCallback( p->hEdit, @MeOnEditEnter )
    tkTextBox_SetMessageCallback( p->hEdit, @MeOnEditMessage )
    tkTextBox_SetEditFilter( p->hEdit, @MeFilter, p )
    MeTextKind( p )
    return w
end function

' The tkTextBox inside: its look (font, colours, margins, cue banner, menu text) is set there.
' Its change / focus / enter / message callbacks and its edit filter belong to this control.
public function tkMaskEdit_GetEdit( byval hCtrl as TK_WIDGET ptr ) as TK_WIDGET ptr
    dim as TKMASKEDIT_STATE ptr p = ME( hCtrl )
    if p = 0 then return 0
    return p->hEdit
end function

public function tkMaskEdit_GetID( byval hCtrl as TK_WIDGET ptr ) as long
    dim as TKMASKEDIT_STATE ptr p = ME( hCtrl )
    if p = 0 then return 0
    return p->id
end function

' The mask (TKMASK_*, a pattern). FALSE, and the old mask kept, when the pattern does not compile
' (REGEX: also when no provider is registered -- tkMaskEditRegex_Enable -- or PCRE2 refuses the
' pattern; tkMask_RegexError says why). A new mask clears the value. Silent.
public function tkMaskEdit_SetMask( byval hCtrl as TK_WIDGET ptr, byval nKind as long, byref sMask as const ustring ) as boolean
    dim as TKMASKEDIT_STATE ptr p = ME( hCtrl )
    if p = 0 then return false
    dim as long oldKind = iif( p->bMasked, p->spec.kind, TKMASK_NONE )
    if tkMask_Compile( p->spec, nKind, sMask ) = false then return false
    ' an empty year spins to this year
    dim as TKDATETIME now_ = tkTimePanel_LocalNowDateTime( )
    if now_.wYear > 0 then p->spec.spinYear = now_.wYear
    ' a number reads from the right; the alignment follows only a change of kind, so a host's
    ' own SetTextAlign survives a new pattern of the same kind
    if (nKind = TKMASK_NUMERIC) andalso (oldKind <> TKMASK_NUMERIC) then tkTextBox_SetTextAlign( p->hEdit, TXT_ALIGN_RIGHT )
    if (nKind <> TKMASK_NUMERIC) andalso (oldKind = TKMASK_NUMERIC) then tkTextBox_SetTextAlign( p->hEdit, TXT_ALIGN_LEFT )
    p->bMasked = true
    p->sEdit = tkMask_Template( p->spec )
    tkTextBox_SetError( p->hEdit, false )
    MeSync( p )
    MeTextKind( p )
    return true
end function

public function tkMaskEdit_GetMaskKind( byval hCtrl as TK_WIDGET ptr ) as long
    dim as TKMASKEDIT_STATE ptr p = ME( hCtrl )
    if (p = 0) orelse (p->bMasked = false) then return TKMASK_NONE
    return p->spec.kind
end function

public function tkMaskEdit_GetMask( byval hCtrl as TK_WIDGET ptr ) as ustring
    dim as TKMASKEDIT_STATE ptr p = ME( hCtrl )
    if (p = 0) orelse (p->bMasked = false) then return ""
    return p->spec.pattern
end function

' The text in its edit form (literals, prompts in empty slots) -- also while unfocused.
public function tkMaskEdit_GetText( byval hCtrl as TK_WIDGET ptr ) as ustring
    dim as TKMASKEDIT_STATE ptr p = ME( hCtrl )
    if p = 0 then return ""
    if p->bFocused then p->sEdit = MeEditText( p )
    dim as ustring u = p->sEdit
    return u
end function

' Any form of the value (edit form, value form, raw), mapped into the mask as a paste would be;
' what does not fit is left out. Silent; clears the error tint.
public sub tkMaskEdit_SetText( byval hCtrl as TK_WIDGET ptr, byref sText as const ustring )
    dim as TKMASKEDIT_STATE ptr p = ME( hCtrl )
    if p = 0 then exit sub
    dim as string s = sText
    if p->bMasked then p->sEdit = tkMask_TextOfValue( p->spec, s ) else p->sEdit = s
    tkTextBox_SetError( p->hEdit, false )
    MeSync( p )
end sub

' The value in ValueFormat (TKMASK_FMT_*, default RAW); "" when empty.
public function tkMaskEdit_GetValueText( byval hCtrl as TK_WIDGET ptr ) as ustring
    dim as TKMASKEDIT_STATE ptr p = ME( hCtrl )
    if p = 0 then return ""
    if p->bFocused then p->sEdit = MeEditText( p )
    if p->bMasked = false then
        dim as ustring u0 = p->sEdit
        return u0
    end if
    dim as ustring u = tkMask_ValueText( p->spec, p->sEdit, p->nValueFormat )
    return u
end function

public sub tkMaskEdit_SetValueText( byval hCtrl as TK_WIDGET ptr, byref sValue as const ustring )
    tkMaskEdit_SetText( hCtrl, sValue )
end sub

public sub tkMaskEdit_Clear( byval hCtrl as TK_WIDGET ptr )
    tkMaskEdit_SetText( hCtrl, "" )
end sub

public function tkMaskEdit_IsEmpty( byval hCtrl as TK_WIDGET ptr ) as boolean
    dim as TKMASKEDIT_STATE ptr p = ME( hCtrl )
    if p = 0 then return true
    if p->bFocused then p->sEdit = MeEditText( p )
    if p->bMasked = false then return len( p->sEdit ) = 0
    return tkMask_IsEmpty( p->spec, p->sEdit )
end function

public function tkMaskEdit_IsComplete( byval hCtrl as TK_WIDGET ptr ) as boolean
    dim as TKMASKEDIT_STATE ptr p = ME( hCtrl )
    if p = 0 then return false
    if p->bFocused then p->sEdit = MeEditText( p )
    if p->bMasked = false then return true
    return tkMask_IsComplete( p->spec, p->sEdit )
end function

' ---- NUMERIC --------------------------------------------------------------------------------------
' The number shown (a percent mask's divided by 100); 0 when empty or not NUMERIC.
public function tkMaskEdit_GetValue( byval hCtrl as TK_WIDGET ptr ) as float64
    dim as TKMASKEDIT_STATE ptr p = ME( hCtrl )
    if p = 0 then return 0
    if p->bFocused then p->sEdit = MeEditText( p )
    dim as float64 v
    if p->bMasked andalso (p->spec.kind = TKMASK_NUMERIC) then tkMask_GetNumber( p->spec, p->sEdit, v )
    return v
end function

' v as the mask formats it (tkFormat_Number's text), as given: not clamped -- IsValid says when it is
' outside [Min, Max], and the next commit clamps it. Silent; clears the error tint.
public sub tkMaskEdit_SetValue( byval hCtrl as TK_WIDGET ptr, byval v as float64 )
    dim as TKMASKEDIT_STATE ptr p = ME( hCtrl )
    if (p = 0) orelse (p->bMasked = false) orelse (p->spec.kind <> TKMASK_NUMERIC) then exit sub
    p->sEdit = tkMask_TextOfNumber( p->spec, v )
    tkTextBox_SetError( p->hEdit, false )
    MeSync( p )
end sub

' The lowest value a commit leaves (each bound is off until set; ClearRange turns both off).
public sub tkMaskEdit_SetMin( byval hCtrl as TK_WIDGET ptr, byval v as float64 )
    dim as TKMASKEDIT_STATE ptr p = ME( hCtrl )
    if p = 0 then exit sub
    p->spec.hasMin = true
    p->spec.minV = v
end sub

public sub tkMaskEdit_SetMax( byval hCtrl as TK_WIDGET ptr, byval v as float64 )
    dim as TKMASKEDIT_STATE ptr p = ME( hCtrl )
    if p = 0 then exit sub
    p->spec.hasMax = true
    p->spec.maxV = v
end sub

public sub tkMaskEdit_ClearRange( byval hCtrl as TK_WIDGET ptr )
    dim as TKMASKEDIT_STATE ptr p = ME( hCtrl )
    if p = 0 then exit sub
    p->spec.hasMin = false
    p->spec.hasMax = false
end sub

' TRUE (and v) when the bound is set.
public function tkMaskEdit_GetMin( byval hCtrl as TK_WIDGET ptr, byref v as float64 ) as boolean
    dim as TKMASKEDIT_STATE ptr p = ME( hCtrl )
    v = 0
    if (p = 0) orelse (p->spec.hasMin = false) then return false
    v = p->spec.minV
    return true
end function

public function tkMaskEdit_GetMax( byval hCtrl as TK_WIDGET ptr, byref v as float64 ) as boolean
    dim as TKMASKEDIT_STATE ptr p = ME( hCtrl )
    v = 0
    if (p = 0) orelse (p->spec.hasMax = false) then return false
    v = p->spec.maxV
    return true
end function

' "-" toggles the sign (default on); off refuses it, typed or pasted.
public sub tkMaskEdit_SetAllowNegative( byval hCtrl as TK_WIDGET ptr, byval bAllow as boolean )
    dim as TKMASKEDIT_STATE ptr p = ME( hCtrl )
    if p then p->spec.allowNeg = bAllow
end sub

public function tkMaskEdit_GetAllowNegative( byval hCtrl as TK_WIDGET ptr ) as boolean
    dim as TKMASKEDIT_STATE ptr p = ME( hCtrl )
    if p = 0 then return true
    return p->spec.allowNeg
end function

' An empty box commits as 0 (clamped) when it loses the focus; off (default), empty stays empty.
public sub tkMaskEdit_SetZeroWhenEmpty( byval hCtrl as TK_WIDGET ptr, byval bZero as boolean )
    dim as TKMASKEDIT_STATE ptr p = ME( hCtrl )
    if p then p->bZeroWhenEmpty = bZero
end sub

public function tkMaskEdit_GetZeroWhenEmpty( byval hCtrl as TK_WIDGET ptr ) as boolean
    dim as TKMASKEDIT_STATE ptr p = ME( hCtrl )
    if p = 0 then return false
    return p->bZeroWhenEmpty
end function

' ---- DATE / TIME / DATETIME ---------------------------------------------------------------------
private function MeIsDT( byval p as TKMASKEDIT_STATE ptr ) as boolean
    if (p = 0) orelse (p->bMasked = false) then return false
    return (p->spec.kind >= TKMASK_DATE) andalso (p->spec.kind <= TKMASK_DATETIME)
end function

' The value in the box; FALSE unless it is complete and real.
private function MeDT( byval p as TKMASKEDIT_STATE ptr, byref dt as TKMASK_DT ) as boolean
    if p->bFocused then p->sEdit = MeEditText( p )
    return tkMask_GetDT( p->spec, p->sEdit, dt )
end function

private sub MeSetDT( byval p as TKMASKEDIT_STATE ptr, byref dt as const TKMASK_DT, byval bEmpty as boolean )
    if bEmpty then p->sEdit = tkMask_Template( p->spec ) else p->sEdit = tkMask_TextOfDT( p->spec, dt )
    tkTextBox_SetError( p->hEdit, false )
    MeSync( p )
end sub

' The date (DATE, DATETIME); all zero (wYear = 0, DatePicker's "no date") unless complete and real.
public function tkMaskEdit_GetDateValue( byval hCtrl as TK_WIDGET ptr ) as TKDATE
    dim as TKMASKEDIT_STATE ptr p = ME( hCtrl )
    dim as TKDATE r
    if (MeIsDT( p ) = false) orelse (p->spec.kind = TKMASK_TIME) then return r
    dim as TKMASK_DT dt
    if MeDT( p, dt ) = false then return r
    r.wYear = dt.y : r.wMonth = dt.mo : r.wDay = dt.d
    r.wDayOfWeek = tkTimePanel_DayOfWeek( dt.y, dt.mo, dt.d )
    return r
end function

' wYear = 0 empties the box; a DATETIME keeps its time part. Silent; clears the error tint.
public sub tkMaskEdit_SetDateValue( byval hCtrl as TK_WIDGET ptr, byval d as TKDATE )
    dim as TKMASKEDIT_STATE ptr p = ME( hCtrl )
    if (MeIsDT( p ) = false) orelse (p->spec.kind = TKMASK_TIME) then exit sub
    dim as TKMASK_DT dt
    MeDT( p, dt )
    dt.y = d.wYear : dt.mo = d.wMonth : dt.d = d.wDay
    MeSetDT( p, dt, d.wYear = 0 )
end sub

' The time (TIME, DATETIME); wHour = -1 (no time) unless complete and real.
public function tkMaskEdit_GetTimeValue( byval hCtrl as TK_WIDGET ptr ) as TKTIME
    dim as TKMASKEDIT_STATE ptr p = ME( hCtrl )
    dim as TKTIME r
    if (MeIsDT( p ) = false) orelse (p->spec.kind = TKMASK_DATE) then return r
    dim as TKMASK_DT dt
    if MeDT( p, dt ) = false then return r
    r.wHour = dt.h : r.wMinute = dt.mi : r.wSecond = dt.s
    return r
end function

' wHour < 0 empties the box; a DATETIME keeps its date part. Silent; clears the error tint.
public sub tkMaskEdit_SetTimeValue( byval hCtrl as TK_WIDGET ptr, byval t as TKTIME )
    dim as TKMASKEDIT_STATE ptr p = ME( hCtrl )
    if (MeIsDT( p ) = false) orelse (p->spec.kind = TKMASK_DATE) then exit sub
    dim as TKMASK_DT dt
    MeDT( p, dt )
    dt.h = t.wHour : dt.mi = t.wMinute : dt.s = t.wSecond
    MeSetDT( p, dt, t.wHour < 0 )
end sub

' DATETIME (DATE: the date at 00:00); wYear = 0 (no value) unless complete and real.
public function tkMaskEdit_GetDateTimeValue( byval hCtrl as TK_WIDGET ptr ) as TKDATETIME
    dim as TKMASKEDIT_STATE ptr p = ME( hCtrl )
    dim as TKDATETIME r
    if (MeIsDT( p ) = false) orelse (p->spec.kind = TKMASK_TIME) then return r
    dim as TKMASK_DT dt
    if MeDT( p, dt ) = false then return r
    return tkTimePanel_MakeDateTime( dt.y, dt.mo, dt.d, dt.h, dt.mi, dt.s )
end function

' wYear = 0 empties the box. Silent; clears the error tint.
public sub tkMaskEdit_SetDateTimeValue( byval hCtrl as TK_WIDGET ptr, byval v as TKDATETIME )
    dim as TKMASKEDIT_STATE ptr p = ME( hCtrl )
    if (MeIsDT( p ) = false) orelse (p->spec.kind = TKMASK_TIME) then exit sub
    dim as TKMASK_DT dt
    dt.y = v.wYear : dt.mo = v.wMonth : dt.d = v.wDay
    dt.h = v.wHour : dt.mi = v.wMinute : dt.s = v.wSecond
    MeSetDT( p, dt, v.wYear = 0 )
end sub

' The range IsValid checks (no clamping, D-13). The date setters set y / mo / d with 00:00:00, the
' time setters h / mi / s with no date, the DateTime setters both; wYear = 0 / wHour < 0 turns
' that bound off. One range is kept: the last setter of each bound wins.
private sub MeBound( byval p as TKMASKEDIT_STATE ptr, byval bMax as boolean, byval bOn as boolean, byref dt as const TKMASK_DT )
    if bMax then
        p->spec.hasMaxDT = bOn : p->spec.maxDT = dt
    else
        p->spec.hasMinDT = bOn : p->spec.minDT = dt
    end if
end sub

public sub tkMaskEdit_SetMinDate( byval hCtrl as TK_WIDGET ptr, byval d as TKDATE )
    dim as TKMASKEDIT_STATE ptr p = ME( hCtrl )
    if p = 0 then exit sub
    dim as TKMASK_DT dt
    dt.y = d.wYear : dt.mo = d.wMonth : dt.d = d.wDay
    MeBound( p, false, d.wYear > 0, dt )
end sub

public sub tkMaskEdit_SetMaxDate( byval hCtrl as TK_WIDGET ptr, byval d as TKDATE )
    dim as TKMASKEDIT_STATE ptr p = ME( hCtrl )
    if p = 0 then exit sub
    dim as TKMASK_DT dt
    dt.y = d.wYear : dt.mo = d.wMonth : dt.d = d.wDay
    dt.h = 23 : dt.mi = 59 : dt.s = 59               ' a DATETIME on the last day is still inside
    MeBound( p, true, d.wYear > 0, dt )
end sub

public sub tkMaskEdit_SetMinTime( byval hCtrl as TK_WIDGET ptr, byval t as TKTIME )
    dim as TKMASKEDIT_STATE ptr p = ME( hCtrl )
    if p = 0 then exit sub
    dim as TKMASK_DT dt
    dt.h = t.wHour : dt.mi = t.wMinute : dt.s = t.wSecond
    MeBound( p, false, t.wHour >= 0, dt )
end sub

public sub tkMaskEdit_SetMaxTime( byval hCtrl as TK_WIDGET ptr, byval t as TKTIME )
    dim as TKMASKEDIT_STATE ptr p = ME( hCtrl )
    if p = 0 then exit sub
    dim as TKMASK_DT dt
    dt.h = t.wHour : dt.mi = t.wMinute : dt.s = t.wSecond
    MeBound( p, true, t.wHour >= 0, dt )
end sub

public sub tkMaskEdit_SetMinDateTime( byval hCtrl as TK_WIDGET ptr, byval v as TKDATETIME )
    dim as TKMASKEDIT_STATE ptr p = ME( hCtrl )
    if p = 0 then exit sub
    dim as TKMASK_DT dt
    dt.y = v.wYear : dt.mo = v.wMonth : dt.d = v.wDay : dt.h = v.wHour : dt.mi = v.wMinute : dt.s = v.wSecond
    MeBound( p, false, v.wYear > 0, dt )
end sub

public sub tkMaskEdit_SetMaxDateTime( byval hCtrl as TK_WIDGET ptr, byval v as TKDATETIME )
    dim as TKMASKEDIT_STATE ptr p = ME( hCtrl )
    if p = 0 then exit sub
    dim as TKMASK_DT dt
    dt.y = v.wYear : dt.mo = v.wMonth : dt.d = v.wDay : dt.h = v.wHour : dt.mi = v.wMinute : dt.s = v.wSecond
    MeBound( p, true, v.wYear > 0, dt )
end sub

public sub tkMaskEdit_ClearDateRange( byval hCtrl as TK_WIDGET ptr )
    dim as TKMASKEDIT_STATE ptr p = ME( hCtrl )
    if p = 0 then exit sub
    p->spec.hasMinDT = false
    p->spec.hasMaxDT = false
end sub

' Empty, or complete (FIXED); empty, or inside [Min, Max] (NUMERIC); empty, or complete, real and
' inside the range (DATE / TIME / DATETIME).
public function tkMaskEdit_IsValid( byval hCtrl as TK_WIDGET ptr ) as boolean
    dim as TKMASKEDIT_STATE ptr p = ME( hCtrl )
    if p = 0 then return false
    if p->bFocused then p->sEdit = MeEditText( p )
    if p->bMasked = false then return true
    return tkMask_IsValid( p->spec, p->sEdit )
end function

' The character shown in an empty slot (default "_"; its first character counts).
public sub tkMaskEdit_SetPromptChar( byval hCtrl as TK_WIDGET ptr, byref sPrompt as const ustring )
    dim as TKMASKEDIT_STATE ptr p = ME( hCtrl )
    if p = 0 then exit sub
    if p->bFocused then p->sEdit = MeEditText( p )
    dim as string s = sPrompt
    tkMask_ChangePrompt( p->spec, p->sEdit, s )
    MeSync( p )
end sub

public function tkMaskEdit_GetPromptChar( byval hCtrl as TK_WIDGET ptr ) as ustring
    dim as TKMASKEDIT_STATE ptr p = ME( hCtrl )
    if p = 0 then return ""
    dim as ustring u = p->spec.prompt
    return u
end function

' Unfocused, the prompts show as spaces.
public sub tkMaskEdit_SetHidePromptOnLeave( byval hCtrl as TK_WIDGET ptr, byval bHide as boolean )
    dim as TKMASKEDIT_STATE ptr p = ME( hCtrl )
    if p = 0 then exit sub
    p->bHidePrompt = bHide
    MeSync( p )
end sub

public function tkMaskEdit_GetHidePromptOnLeave( byval hCtrl as TK_WIDGET ptr ) as boolean
    dim as TKMASKEDIT_STATE ptr p = ME( hCtrl )
    if p = 0 then return false
    return p->bHidePrompt
end function

' The form GetValueText returns (TKMASK_FMT_*; default RAW).
public sub tkMaskEdit_SetValueFormat( byval hCtrl as TK_WIDGET ptr, byval nFormat as long )
    dim as TKMASKEDIT_STATE ptr p = ME( hCtrl )
    if (p = 0) orelse (nFormat < TKMASK_FMT_RAW) orelse (nFormat > TKMASK_FMT_BOTH) then exit sub
    p->nValueFormat = nFormat
end sub

public function tkMaskEdit_GetValueFormat( byval hCtrl as TK_WIDGET ptr ) as long
    dim as TKMASKEDIT_STATE ptr p = ME( hCtrl )
    if p = 0 then return TKMASK_FMT_RAW
    return p->nValueFormat
end function

' The form Copy and Cut put on the clipboard (default LITERALS: literals kept, empty slots as spaces).
public sub tkMaskEdit_SetCopyFormat( byval hCtrl as TK_WIDGET ptr, byval nFormat as long )
    dim as TKMASKEDIT_STATE ptr p = ME( hCtrl )
    if (p = 0) orelse (nFormat < TKMASK_FMT_RAW) orelse (nFormat > TKMASK_FMT_BOTH) then exit sub
    p->nCopyFormat = nFormat
end sub

public function tkMaskEdit_GetCopyFormat( byval hCtrl as TK_WIDGET ptr ) as long
    dim as TKMASKEDIT_STATE ptr p = ME( hCtrl )
    if p = 0 then return TKMASK_FMT_LITERALS
    return p->nCopyFormat
end function

' Insert mode: typing shifts the filled slots right (WinForms); off (default) typing overwrites
' (D-3). The Insert key toggles it.
public sub tkMaskEdit_SetInsertMode( byval hCtrl as TK_WIDGET ptr, byval bInsert as boolean )
    dim as TKMASKEDIT_STATE ptr p = ME( hCtrl )
    if p then p->spec.overwrite = (bInsert = false)
end sub

public function tkMaskEdit_GetInsertMode( byval hCtrl as TK_WIDGET ptr ) as boolean
    dim as TKMASKEDIT_STATE ptr p = ME( hCtrl )
    if p = 0 then return false
    return p->spec.overwrite = false
end function

' The border turns ErrorColor when a committed value is not valid (default on).
public sub tkMaskEdit_SetShowError( byval hCtrl as TK_WIDGET ptr, byval bShow as boolean )
    dim as TKMASKEDIT_STATE ptr p = ME( hCtrl )
    if p = 0 then exit sub
    p->bShowError = bShow
    if bShow = false then tkTextBox_SetError( p->hEdit, false )
end sub

public function tkMaskEdit_GetShowError( byval hCtrl as TK_WIDGET ptr ) as boolean
    dim as TKMASKEDIT_STATE ptr p = ME( hCtrl )
    if p = 0 then return false
    return p->bShowError
end function

public function tkMaskEdit_GetError( byval hCtrl as TK_WIDGET ptr ) as boolean
    dim as TKMASKEDIT_STATE ptr p = ME( hCtrl )
    if p = 0 then return false
    return tkTextBox_GetError( p->hEdit )
end function

public function tkMaskEdit_HasFocus( byval hCtrl as TK_WIDGET ptr ) as boolean
    dim as TKMASKEDIT_STATE ptr p = ME( hCtrl )
    if p = 0 then return false
    return tkTextBox_HasFocus( p->hEdit )
end function

