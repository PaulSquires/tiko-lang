'
' tkTimer -- a component, not a control: a hidden, zero-size child widget that calls its Tick
' callback every Interval milliseconds while it is enabled. Never shown, never a tab stop, never hit.
' Being a widget, it has a handle, an id and a parent like any control, goes when its parent goes,
' and is enabled and disabled with tkWidget_Enable (a form's .Enabled). Interval 0 (the default)
' means stopped. The ticks arrive on the UI thread. Setters are silent.
#module "tkTimer"

#import "../tkHost" public
using tkHost

public type TMR_TickCallbackSub as sub( byval hTimer as TK_WIDGET ptr )

public type TKTIMER_STATE
    hWin      as TK_WIDGET ptr
    nInterval as long                     ' milliseconds; 0 = stopped
    Tick      as TMR_TickCallbackSub
end type

const as long TMR_TIMER_ID = TK_TIMER_APP

private function GetTimerPointer( byval h as TK_WIDGET ptr ) as TKTIMER_STATE ptr
    if h = 0 then return 0
    return cast( TKTIMER_STATE ptr, h->pData )
end function

' Running is enabled AND an interval: start, re-arm or stop to match.
private sub Sync( byval p as TKTIMER_STATE ptr )
    if p->hWin->isEnabled andalso (p->nInterval > 0) then
        tkWidget_SetTimer( p->hWin, TMR_TIMER_ID, p->nInterval )
    else
        tkWidget_KillTimer( p->hWin, TMR_TIMER_ID )
    end if
end sub

private function tkTimer_Proc( byval w as TK_WIDGET ptr, byval m as TK_MSG ptr ) as boolean
    dim as TKTIMER_STATE ptr p = GetTimerPointer( w )
    if p = 0 then return false
    select case m->msg
    case TKM_TIMER
        if m->timerId <> TMR_TIMER_ID then return false
        if p->Tick then p->Tick( w )
        return true
    case TKM_ENABLE
        Sync( p )
        return true
    case TKM_SHOW
        ' a component is never shown, whatever asks
        if m->bFlag then tkWidget_Show( w, false )
        return true
    case TKM_DESTROY
        tkWidget_KillTimer( w, TMR_TIMER_ID )
        delete p
        w->pData = 0
        return true
    end select
    return false
end function

public function tkTimer_Create( byval hParent as TK_WIDGET ptr, byval ctrlId as long ) as TK_WIDGET ptr
    if hParent = 0 then return 0
    dim as TKTIMER_STATE ptr p = new TKTIMER_STATE
    dim as TK_WIDGET ptr w = tkWidget_CreateChild( hParent, ctrlId, @tkTimer_Proc, p )
    p->hWin = w
    tkWidget_Show( w, false )
    return w
end function

public function tkTimer_GetInterval( byval h as TK_WIDGET ptr ) as long
    dim as TKTIMER_STATE ptr p = GetTimerPointer( h )
    return iif( p <> 0, p->nInterval, 0 )
end function

' Milliseconds between ticks; 0 or less stops it. A change starts the wait again.
public sub tkTimer_SetInterval( byval h as TK_WIDGET ptr, byval ms as long )
    dim as TKTIMER_STATE ptr p = GetTimerPointer( h )
    if p = 0 then exit sub
    p->nInterval = iif( ms > 0, ms, 0 )
    Sync( p )
end sub

' Enabled, with an interval: ticks are coming.
public function tkTimer_IsRunning( byval h as TK_WIDGET ptr ) as boolean
    dim as TKTIMER_STATE ptr p = GetTimerPointer( h )
    if p = 0 then return false
    return tkWidget_HasTimer( h, TMR_TIMER_ID )
end function

public sub tkTimer_SetTickCallback( byval h as TK_WIDGET ptr, byval usersub as TMR_TickCallbackSub )
    dim as TKTIMER_STATE ptr p = GetTimerPointer( h )
    if p then p->Tick = usersub
end sub
