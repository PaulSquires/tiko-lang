'
' tkSlider -- a value on a track, picked by dragging a thumb. New in tkControls (no Win32 sibling);
' the design is C:\dev\docs\tkControls\SLIDER.md. PHASES S0 + S1: one thumb; horizontal or
' vertical, optionally reversed; the track click jumps or pages; ticks, labels, the value tip,
' three fill modes, round or rect thumb. The range mode (two thumbs) is S2.
'
' TWO FILES, ONE MODULE: this one (types, the value model, input, the API) and tkSliderLayout.tiko
' (geometry, ticks and labels, painting, the value tip).
'
' THE VALUE MODEL (SLIDER.md §3.1): a double in [Min, Max]. Step > 0 is a grid anchored at Min;
' Step = 0 is continuous. Max is always reachable, even off the grid. SnapToTicks replaces the
' grid with the tick values. Every value -- user input and setters alike -- goes through one
' snap, computed fresh (no drift), then rounded to DecimalPlaces + 6 digits.
'
' GEOMETRY (§3.4, §4): "along" is the track's axis (x horizontal, y vertical), "across" the other.
' A vertical slider has Min at the BOTTOM; Reversed mirrors either orientation. ThumbSize is
' (along, across), so a horizontal rect thumb set to 10 x 20 is tall and narrow.
'
' NOTIFICATION (§6): setters are silent. ValueChanged fires for every USER change, each move of a
' live drag included; ValueCommitted when the user is done -- a drag released on a different
' value, or each key / wheel / page step. State first, callbacks last: a callback may destroy the
' slider, so every path notifies from snapshots and touches no state after.
'
' INPUT (§5): a press on the thumb drags it from where it was grabbed. A press elsewhere either
' jumps the thumb there and drags on (TKSL_CLICK_JUMP, the default) or pages by LargeChange toward
' the press and repeats while held (TKSL_CLICK_PAGE: 400 ms, then every 80 ms, until the thumb
' reaches the pointer). Esc during a drag puts the start value back. The wheel moves the slider only
' while focused by default (refused otherwise, so it scrolls the form). Keys along the axis follow
' the geometry (Right on a reversed horizontal slider decreases); the other arrows follow the value.
#module "tkSlider"

#import "../tkHost" public
#import "../tkTheme" public
#import "../tkTooltip" public
using tkHost
using tkPaint
using tkTheme
using tkTooltip

public enum
    TKSL_HORIZONTAL = 0
    TKSL_VERTICAL
end enum

' What a press on the track (off the thumb) does.
public enum
    TKSL_CLICK_JUMP = 0        ' the thumb comes to the pointer and the drag goes on (default)
    TKSL_CLICK_PAGE            ' LargeChange toward the pointer, repeated while held
end enum

' Where the wheel is taken.
public enum
    TKSL_WHEEL_FOCUSED = 0     ' only while the slider has the focus (default)
    TKSL_WHEEL_HOVER           ' whenever the pointer is over it
    TKSL_WHEEL_NEVER
end enum

public enum
    TKSL_FILL_MIN = 0          ' from the Min end to the thumb (default)
    TKSL_FILL_NONE
    TKSL_FILL_ORIGIN           ' from FillOrigin to the thumb, either side
end enum

' Which side of the track gets tick marks: Top = Left when vertical.
public enum
    TKSL_TICKS_NONE = 0
    TKSL_TICKS_TOPLEFT
    TKSL_TICKS_BOTTOMRIGHT
    TKSL_TICKS_BOTH
end enum

public enum
    TKSL_THUMB_ROUND = 0
    TKSL_THUMB_RECT            ' a rounded rectangle, ThumbSize along x across
end enum

' When the value tip shows over the thumb.
public enum
    TKSL_TIP_NONE = 0
    TKSL_TIP_DRAG              ' while dragging or paging (default)
    TKSL_TIP_FOCUSED           ' while focused, and so during keyboard changes too
end enum

' FormatValue's nWhere.
public enum
    TKSL_FMT_TICK = 0
    TKSL_FMT_TIP
end enum

' HitTest's answers.
public enum
    TKSL_PART_NONE = 0
    TKSL_PART_TRACK            ' the client outside the thumb's target and the tick bands
    TKSL_PART_THUMB0
    TKSL_PART_TICKS            ' a tick or label band (a press there acts as on the track)
end enum

' Sizes in design units, scaled at create and by TKM_SCALECHANGED. The two THICKNESSES (thumb
' border, focus ring) are rules, not sizes: never scaled (tkToggle's rule).
public const as long TKSLIDER_DEFAULT_TRACK      = 4      ' track thickness
public const as long TKSLIDER_DEFAULT_THUMB      = 16     ' thumb, along and across
public const as long TKSLIDER_DEFAULT_FOCUSGAP   = 3
public const as long TKSLIDER_DEFAULT_FOCUSTHICK = 1
public const as long TKSLIDER_DEFAULT_BORDER     = 2      ' the thumb's border
public const as long TKSLIDER_DEFAULT_LENGTH     = 120    ' GetIdealSize's travel, beyond the thumb
public const as long TKSLIDER_DEFAULT_TICKLEN    = 4
public const as long TKSLIDER_DEFAULT_TICKGAP    = 2      ' thumb band -> ticks
public const as long TKSLIDER_DEFAULT_LABELGAP   = 2      ' ticks -> labels
public const as long TKSLIDER_MIN_TICKSPACE      = 2      ' thinning: the least gap between shown ticks
public const as long TKSLIDER_MIN_LABELSPACE     = 6      ' thinning: the least gap between shown labels
public const as long TKSLIDER_RECT_CORNER        = 3      ' a rect thumb's corner radius
public const as long TKSLIDER_MIN_TARGET         = 24     ' the thumb's hit target, at least, across
public const as long TKSLIDER_REPEAT_DELAY       = 400
public const as long TKSLIDER_REPEAT_MS          = 80
public const as long TKSLIDER_MAX_TICKS          = 10000  ' a finer TickFrequency draws no ticks
public const as double TKSLIDER_DEFAULT_MIN = 0.0
public const as double TKSLIDER_DEFAULT_MAX = 100.0

' Precedence in each part: disabled > pressed > hot > normal.
public type TKSLIDER_COLORS
    BackColor                as ulong = &hFF21252Bul
    FocusRingColor           as ulong = &hFF569CD6ul
    TrackColor               as ulong = &hFF33373Ful
    TrackColorDisabled       as ulong = &hFF2C3037ul
    FillColor                as ulong = &hFF4A6C8Cul
    FillColorHot             as ulong = &hFF5C84AAul
    FillColorDisabled        as ulong = &hFF384654ul
    ThumbColor               as ulong = &hFF2C313Aul
    ThumbColorHot            as ulong = &hFF353B45ul
    ThumbColorPressed        as ulong = &hFF264F78ul
    ThumbColorDisabled       as ulong = &hFF2C3037ul
    ThumbBorderColor         as ulong = &hFF4A6C8Cul
    ThumbBorderColorHot      as ulong = &hFF5C84AAul
    ThumbBorderColorDisabled as ulong = &hFF484D56ul
    TickColor                as ulong = &hFF373C45ul
    TickColorDisabled        as ulong = &hFF2C3037ul
    LabelColor               as ulong = &hFF8A9099ul
    LabelColorDisabled       as ulong = &hFF545961ul
end type

' Everything a painter needs, all rects from Layout (never re-derive one). Ticks and labels are
' read with tkSlider_GetTickCount / GetTickPos / GetTickShown / GetLabelRect / GetLabelText.
public type TKSLIDER_PAINTINFO
    hSlider       as TK_WIDGET ptr
    b             as TK_PAINT ptr          ' borrowed for this frame
    rcClient      as TKRECT
    rcTrack       as TKRECT
    rcFill        as TKRECT                ' empty with TKSL_FILL_NONE
    rcThumb       as TKRECT
    rcFocus       as TKRECT                ' the ring's rect: rcThumb inflated by the ring band
    nHotThumb     as long                  ' 0, or -1
    nPressedThumb as long                  ' 0 while dragging or paging, else -1
    isEnabled     as boolean
    isFocused     as boolean
    isReadOnly    as boolean
    nOrientation  as long
    bReversed     as boolean
    nThumbShape   as long
    nValue        as double
end type

public type TKSLIDER_MESSAGEINFO
    hSlider as TK_WIDGET ptr
    msg     as long                        ' TKM_*
    x       as single
    y       as single
    key     as long
    mods    as long
    wheelX  as single
    wheelY  as single
end type

public type SLD_ValueChangedCallbackSub as sub( byval hSlider as TK_WIDGET ptr, byval nThumb as long, byval nValue as double )
public type SLD_ValueCommittedCallbackSub as sub( byval hSlider as TK_WIDGET ptr, byval nThumb as long, byval nValue as double )
public type SLD_FormatValueCallbackFunc as function( byval hSlider as TK_WIDGET ptr, byval nValue as double, byval nWhere as long ) as ustring
public type SLD_PaintCallbackSub as sub( byval p as TKSLIDER_PAINTINFO ptr )
public type SLD_MessageCallbackFunc as function( byval m as TKSLIDER_MESSAGEINFO ptr ) as boolean

public type TKSLIDER_STATE
    hWin              as TK_WIDGET ptr
    id                as long
    bColorsPinned     as boolean
    bShapePinned      as boolean
    wszTooltip        as ustring
    tip               as TKTIPHOST_STATE       ' the hover tooltip (TooltipText)
    vtip              as TKTIPHOST_STATE       ' the value tip: tracked, made on first use
    bTipShown         as boolean
    colors            as TKSLIDER_COLORS
    pFont             as TTF_Font ptr          ' labels and nothing else; 0 = the host's default
    ' value model
    nMin              as double = TKSLIDER_DEFAULT_MIN
    nMax              as double = TKSLIDER_DEFAULT_MAX
    nValue            as double
    nStep             as double = 1
    nSmall            as double = 1
    nLarge            as double = 10
    nDecimals         as long
    bSnapToTicks      as boolean
    ' ticks: values (built from TickFrequency or the user's list), then laid out
    nTickFreq         as double
    userTicks(any)    as double
    nUserTicks        as long
    tickVal(any)      as double
    nTicks            as long
    bTicksDirty       as boolean = true
    tickPos(any)      as long                  ' the tick's centre along the axis
    tickShown(any)    as boolean
    labelShown(any)   as boolean
    labelRc(any)      as TKRECT
    labelTxt(any)     as ustring
    nTickPlacement    as long = TKSL_TICKS_NONE
    bShowLabels       as boolean
    nLabelEvery       as long = 1
    ' behaviour
    isEnabled         as boolean = true
    isReadOnly        as boolean
    isFocused         as boolean
    nOrientation      as long = TKSL_HORIZONTAL
    bReversed         as boolean
    nTrackClick       as long = TKSL_CLICK_JUMP
    nFillMode         as long = TKSL_FILL_MIN
    nFillOrigin       as double
    nThumbShape       as long = TKSL_THUMB_ROUND
    nShowTip          as long = TKSL_TIP_DRAG
    nWheelMode        as long = TKSL_WHEEL_FOCUSED
    nWheelAccum       as long                  ' 120ths of a notch not yet applied
    nRepeatDelay      as long = TKSLIDER_REPEAT_DELAY
    nRepeatMs         as long = TKSLIDER_REPEAT_MS
    ' gesture
    isDragging        as boolean
    isPaging          as boolean
    nPageDir          as long                  ' +1 / -1 in value terms
    nGrab             as long                  ' pointer - thumb centre at the press, along
    nDragStart        as double                ' the value before the press (Esc, Commit)
    nHot              as long = -1
    lastX             as single
    lastY             as single
    ' geometry (pixels)
    nTrackThick       as long
    nThumbA           as long                  ' along
    nThumbX           as long                  ' across
    nBorderThick      as long = TKSLIDER_DEFAULT_BORDER
    nFocusGap         as long
    nFocusThick       as long = TKSLIDER_DEFAULT_FOCUSTHICK
    nTickLen          as long
    nTickGap          as long
    nLabelGap         as long
    bLayoutDirty      as boolean = true
    a0                as long                  ' the lower-coordinate end's thumb centre, along
    a1                as long                  ' the higher-coordinate end's
    rcTrack           as TKRECT
    rcFill            as TKRECT
    rcThumb           as TKRECT
    rcTarget          as TKRECT                ' what a press must land in to grab the thumb
    rcTicks1          as TKRECT                ' the top / left tick band (empty when none)
    rcTicks2          as TKRECT                ' the bottom / right tick band
    rcLabels          as TKRECT                ' the label band
    ' callbacks
    ChangedCallback   as SLD_ValueChangedCallbackSub
    CommittedCallback as SLD_ValueCommittedCallbackSub
    FormatCallback    as SLD_FormatValueCallbackFunc
    PaintCallback     as SLD_PaintCallbackSub
    MessageCallback   as SLD_MessageCallbackFunc

    declare function RingPad() as long
    declare function Span() as long
    declare function Inverted() as boolean
    declare function Snap( byval v as double ) as double
    declare function SnapToward( byval target as double, byval from as double ) as double
    declare function Differ( byval a as double, byval b as double ) as boolean
    declare function KeyStep() as double
    declare function CentreOf( byval v as double ) as long
    declare function ValueAt( byval px as long ) as double
    declare sub      BuildTicks()
    declare sub      Layout()
    declare sub      Refresh()
end type

' ---- shared with tkSliderLayout.tiko -------------------------------------------------------
declare function RoundTo( byval v as double, byval d as long ) as double
declare function RoundHalfAway( byval v as double ) as double
declare function Clamp_( byval v as double, byval lo as double, byval hi as double ) as double
declare function SL( byval w as TK_WIDGET ptr ) as TKSLIDER_STATE ptr
declare sub EnsureLayout( byval p as TKSLIDER_STATE ptr )
declare sub OnPaint( byval p as TKSLIDER_STATE ptr, byval b as TK_PAINT ptr )
declare sub RenderDefault( byval p as TKSLIDER_STATE ptr, byval pi as TKSLIDER_PAINTINFO ptr )
declare sub UpdateTip( byval p as TKSLIDER_STATE ptr )
declare sub HideTip( byval p as TKSLIDER_STATE ptr )
declare function FormatV( byval p as TKSLIDER_STATE ptr, byval v as double, byval nWhere as long ) as ustring
declare sub IdealSize( byval p as TKSLIDER_STATE ptr, byref nW as long, byref nH as long )

' ==========================================================================================
' The value model
' ==========================================================================================
' Half away from zero, to d decimal digits: drops binary residue (0.1 * 3).
function RoundTo( byval v as double, byval d as long ) as double
    if d < 0 then d = 0
    if d > 15 then d = 15
    dim as double k = 10.0 ^ d
    if v < 0 then return -int( (-v * k) + 0.5 ) / k
    return int( (v * k) + 0.5 ) / k
end function

function RoundHalfAway( byval v as double ) as double
    if v < 0 then return -int( -v + 0.5 )
    return int( v + 0.5 )
end function

function Clamp_( byval v as double, byval lo as double, byval hi as double ) as double
    if v < lo then return lo
    if v > hi then return hi
    return v
end function

function SL( byval w as TK_WIDGET ptr ) as TKSLIDER_STATE ptr
    if w = 0 then return 0
    return cast( TKSLIDER_STATE ptr, w->pData )
end function

sub EnsureLayout( byval p as TKSLIDER_STATE ptr )
    if p->bLayoutDirty then p->Layout()
end sub

' A quarter of a grid unit, or a hair of the range when continuous: below it is residue.
function TKSLIDER_STATE.Differ( byval a as double, byval b as double ) as boolean
    dim as double tol = (this.nMax - this.nMin) * 1e-9 + 1e-12
    if this.nStep > 0 then tol = this.nStep / 4
    return abs( a - b ) > tol
end function

' The tick values, sorted, inside [Min, Max]: the user's list when there is one, else Min + k *
' TickFrequency (k >= 0) plus Max. Too many (a frequency finer than MAX_TICKS) is none.
sub TKSLIDER_STATE.BuildTicks()
    this.bTicksDirty = false
    this.nTicks = 0
    erase this.tickVal
    dim as double tol = (this.nMax - this.nMin) * 1e-9 + 1e-12
    if this.nUserTicks > 0 then
        redim this.tickVal( 0 to this.nUserTicks - 1 )
        for i as long = 0 to this.nUserTicks - 1
            dim as double v = this.userTicks(i)
            if (v < this.nMin - tol) orelse (v > this.nMax + tol) then continue for
            v = Clamp_( v, this.nMin, this.nMax )
            ' insertion, skipping duplicates
            dim as long j = this.nTicks
            while (j > 0) andalso (this.tickVal(j - 1) > v)
                j -= 1
            wend
            if (j > 0) andalso (abs( this.tickVal(j - 1) - v ) <= tol) then continue for
            for k as long = this.nTicks to j + 1 step -1
                this.tickVal(k) = this.tickVal(k - 1)
            next
            this.tickVal(j) = v
            this.nTicks += 1
        next
    elseif (this.nTickFreq > 0) andalso (this.nMax > this.nMin) then
        dim as double nCount = (this.nMax - this.nMin) / this.nTickFreq
        if nCount > TKSLIDER_MAX_TICKS then exit sub
        redim this.tickVal( 0 to cint( int( nCount ) ) + 1 )
        dim as long k = 0
        do
            dim as double v = RoundTo( this.nMin + k * this.nTickFreq, this.nDecimals + 6 )
            if v >= this.nMax - tol then exit do
            this.tickVal(this.nTicks) = v
            this.nTicks += 1
            k += 1
        loop
        this.tickVal(this.nTicks) = this.nMax
        this.nTicks += 1
    end if
end sub

' The nearest legal value: a grid point (Min + n * Step) or Max itself, or with SnapToTicks the
' nearest tick; clamped, residue dropped.
function TKSLIDER_STATE.Snap( byval v as double ) as double
    v = Clamp_( v, this.nMin, this.nMax )
    if this.bSnapToTicks then
        if this.bTicksDirty then this.BuildTicks()
        if this.nTicks > 0 then
            dim as double best = this.tickVal(0)
            for i as long = 1 to this.nTicks - 1
                if abs( this.tickVal(i) - v ) < abs( best - v ) then best = this.tickVal(i)
            next
            return best
        end if
    end if
    if this.nStep > 0 then
        dim as double g = this.nMin + RoundHalfAway( (v - this.nMin) / this.nStep ) * this.nStep
        g = Clamp_( g, this.nMin, this.nMax )
        if abs( this.nMax - v ) < abs( v - g ) then g = this.nMax      ' Max is always legal
        v = g
    end if
    return Clamp_( RoundTo( v, this.nDecimals + 6 ), this.nMin, this.nMax )
end function

' A key / wheel / page step: the legal value at or before `target` seen from `from` (rounded
' TOWARD the start, so a step never overshoots), and if that is no move at all, the next legal
' value on. The direction is the request's, read BEFORE the clamp: at Max "up" clamps to Max
' itself and must not be taken for a step down (S0's selftest: Right at Max gave Max - 1).
function TKSLIDER_STATE.SnapToward( byval target as double, byval from as double ) as double
    if target = from then return from
    dim as boolean up = (target > from)
    if up andalso (this.Differ( from, this.nMax ) = false) then return from
    if (up = false) andalso (this.Differ( from, this.nMin ) = false) then return from
    target = Clamp_( target, this.nMin, this.nMax )
    if this.bSnapToTicks then
        if this.bTicksDirty then this.BuildTicks()
        if this.nTicks > 0 then
            ' the last tick on the way (toward the start), else the first one past `from`
            dim as double g = from
            dim as boolean found = false
            if up then
                for i as long = this.nTicks - 1 to 0 step -1
                    if (this.tickVal(i) <= target) andalso this.Differ( this.tickVal(i), from ) andalso (this.tickVal(i) > from) then g = this.tickVal(i) : found = true : exit for
                next
                if found = false then
                    for i as long = 0 to this.nTicks - 1
                        if (this.tickVal(i) > from) andalso this.Differ( this.tickVal(i), from ) then g = this.tickVal(i) : exit for
                    next
                end if
            else
                for i as long = 0 to this.nTicks - 1
                    if (this.tickVal(i) >= target) andalso this.Differ( this.tickVal(i), from ) andalso (this.tickVal(i) < from) then g = this.tickVal(i) : found = true : exit for
                next
                if found = false then
                    for i as long = this.nTicks - 1 to 0 step -1
                        if (this.tickVal(i) < from) andalso this.Differ( this.tickVal(i), from ) then g = this.tickVal(i) : exit for
                    next
                end if
            end if
            return g
        end if
    end if
    if this.nStep <= 0 then return Clamp_( RoundTo( target, this.nDecimals + 6 ), this.nMin, this.nMax )
    dim as double q = (target - this.nMin) / this.nStep
    dim as double n = iif( up, int( q + 1e-9 ), -int( -q + 1e-9 ) )      ' floor going up, ceil going down
    dim as double g = Clamp_( this.nMin + n * this.nStep, this.nMin, this.nMax )
    if up andalso (target >= this.nMax) then g = this.nMax
    if this.Differ( g, from ) = false then
        g = Clamp_( this.nMin + (n + iif( up, 1, -1 )) * this.nStep, this.nMin, this.nMax )
        if up andalso (g < from) then g = this.nMax
    end if
    return Clamp_( RoundTo( g, this.nDecimals + 6 ), this.nMin, this.nMax )
end function

' SmallChange, or Step when it is 0, or a hundredth of the range when both are.
function TKSLIDER_STATE.KeyStep() as double
    if this.nSmall > 0 then return this.nSmall
    if this.nStep > 0 then return this.nStep
    return (this.nMax - this.nMin) / 100
end function

function TKSLIDER_STATE.RingPad() as long
    return this.nFocusGap + this.nFocusThick
end function

function TKSLIDER_STATE.Span() as long
    return this.a1 - this.a0
end function

' Min sits at the HIGH coordinate end: a vertical slider (Min at the bottom), unless reversed;
' a reversed horizontal one.
function TKSLIDER_STATE.Inverted() as boolean
    return (this.nOrientation = TKSL_VERTICAL) xor this.bReversed
end function

' The thumb centre along the axis: a0 + round( fr * span ), or a1 - round( fr * span ) inverted.
function TKSLIDER_STATE.CentreOf( byval v as double ) as long
    dim as double fr = 0
    if this.nMax > this.nMin then fr = (v - this.nMin) / (this.nMax - this.nMin)
    dim as long d = cint( RoundHalfAway( Clamp_( fr, 0, 1 ) * this.Span() ) )
    return iif( this.Inverted(), this.a1 - d, this.a0 + d )
end function

' The snapped value under the coordinate px along the axis (clamped to the travel).
function TKSLIDER_STATE.ValueAt( byval px as long ) as double
    if this.Span() <= 0 then return this.nValue
    dim as double fr = (px - this.a0) / this.Span()
    if this.Inverted() then fr = (this.a1 - px) / this.Span()
    return this.Snap( this.nMin + Clamp_( fr, 0, 1 ) * (this.nMax - this.nMin) )
end function

sub TKSLIDER_STATE.Refresh()
    this.bLayoutDirty = true
    tkWidget_Invalidate( this.hWin )
end sub

' ==========================================================================================
' Notification: from snapshots, last, nothing touched after
' ==========================================================================================
private sub Notify( byval p as TKSLIDER_STATE ptr, byval bChanged as boolean, byval bCommitted as boolean )
    dim as TK_WIDGET ptr w = p->hWin
    dim as double v = p->nValue
    dim as SLD_ValueChangedCallbackSub cbChanged = p->ChangedCallback
    dim as SLD_ValueCommittedCallbackSub cbCommitted = p->CommittedCallback
    ' p may be gone after the first callback: only the snapshots are used from here
    if bChanged andalso (cbChanged <> 0) then cbChanged( w, 0, v )
    if bCommitted andalso (cbCommitted <> 0) then cbCommitted( w, 0, v )
end sub

' The value moved by the USER: set, re-lay out, move the tip. TRUE when it changed (the caller
' notifies).
private function UserSet( byval p as TKSLIDER_STATE ptr, byval v as double ) as boolean
    if p->Differ( v, p->nValue ) = false then return false
    p->nValue = v
    p->Refresh()
    UpdateTip( p )
    return true
end function

private function CallMessage( byval p as TKSLIDER_STATE ptr, byval m as TK_MSG ptr ) as boolean
    if p->MessageCallback = 0 then return false
    dim as TKSLIDER_MESSAGEINFO mi
    mi.hSlider = p->hWin
    mi.msg = m->msg
    mi.x = m->x : mi.y = m->y
    mi.key = m->key : mi.mods = m->mods
    mi.wheelX = m->wheelX : mi.wheelY = m->wheelY
    return p->MessageCallback( @mi )
end function

private function Along( byval p as TKSLIDER_STATE ptr, byval x as single, byval y as single ) as long
    return cint( iif( p->nOrientation = TKSL_VERTICAL, y, x ) )
end function

' ==========================================================================================
' The proc
' ==========================================================================================
public declare sub tkSlider_ApplyTheme( byval hSlider as TK_WIDGET ptr, byref t as TKTHEME_COLORS )
declare sub ApplyThemeShape( byval w as TK_WIDGET ptr )

' A drag ends without Esc: TRUE when the value differs from the press's (the caller commits).
private function EndDrag( byval p as TKSLIDER_STATE ptr ) as boolean
    if p->isDragging = false then return false
    p->isDragging = false
    tkWidget_Invalidate( p->hWin )
    UpdateTip( p )
    return p->Differ( p->nValue, p->nDragStart )
end function

private sub StopPaging( byval p as TKSLIDER_STATE ptr )
    if p->isPaging then tkWidget_KillTimer( p->hWin, TK_TIMER_AUTOREPEAT )
    p->isPaging = false
    p->nPageDir = 0
    tkWidget_Invalidate( p->hWin )
    UpdateTip( p )
end sub

private sub SetHot( byval p as TKSLIDER_STATE ptr, byval n as long )
    if n <> p->nHot then p->nHot = n : tkWidget_Invalidate( p->hWin )
end sub

private sub Rescale( byval p as TKSLIDER_STATE ptr, byval fOld as single, byval fNew as single )
    if (fOld <= 0) orelse (fNew <= 0) orelse (fOld = fNew) then exit sub
    dim as single k = fNew / fOld
    p->nTrackThick = cint( p->nTrackThick * k )
    p->nThumbA = cint( p->nThumbA * k )
    p->nThumbX = cint( p->nThumbX * k )
    p->nFocusGap = cint( p->nFocusGap * k )
    p->nTickLen = cint( p->nTickLen * k )
    p->nTickGap = cint( p->nTickGap * k )
    p->nLabelGap = cint( p->nLabelGap * k )
    if p->nTrackThick < 1 then p->nTrackThick = 1
    if p->nThumbA < 1 then p->nThumbA = 1
    if p->nThumbX < 1 then p->nThumbX = 1
    p->Refresh()
end sub

' One page step toward the pointer: TRUE when it moved.
private function PageStep( byval p as TKSLIDER_STATE ptr ) as boolean
    dim as double big = iif( p->nLarge > 0, p->nLarge, p->KeyStep() )
    return UserSet( p, p->SnapToward( p->nValue + p->nPageDir * big, p->nValue ) )
end function

' The paging has reached the pointer: the thumb's target covers it, or the value passed it.
private function PageReached( byval p as TKSLIDER_STATE ptr ) as boolean
    EnsureLayout( p )
    if tkRect_Contains( p->rcTarget, p->lastX, p->lastY ) then return true
    dim as double vAt = p->ValueAt( Along( p, p->lastX, p->lastY ) )
    if p->nPageDir > 0 then return p->nValue >= vAt
    return p->nValue <= vAt
end function

' The wheel, if this mode takes it now. Positive notches (up / right) increase.
private function OnWheel( byval p as TKSLIDER_STATE ptr, byval notches as single ) as boolean
    if notches = 0 then return false
    p->nWheelAccum += cint( notches * 120 )
    dim as long n = p->nWheelAccum \ 120
    if n = 0 then return true                           ' owned; the remainder is kept
    p->nWheelAccum -= n * 120
    dim as double v = p->nValue
    for i as long = 1 to abs( n )
        v = p->SnapToward( v + sgn( n ) * p->KeyStep(), v )
    next
    if UserSet( p, v ) then Notify( p, true, true )
    return true
end function

' Along the axis the keys follow the geometry; the cross-axis arrows follow the value (APG).
private function OnKey( byval p as TKSLIDER_STATE ptr, byval key as long ) as boolean
    dim as double v = p->nValue
    dim as long dirn = 0
    dim as long geo = iif( p->bReversed, -1, 1 )
    if p->nOrientation = TKSL_VERTICAL then
        select case key
        case SDLK_UP    : dirn = geo
        case SDLK_DOWN  : dirn = -geo
        case SDLK_RIGHT : dirn = 1
        case SDLK_LEFT  : dirn = -1
        end select
    else
        select case key
        case SDLK_RIGHT : dirn = geo
        case SDLK_LEFT  : dirn = -geo
        case SDLK_UP    : dirn = 1
        case SDLK_DOWN  : dirn = -1
        end select
    end if
    select case key
    case SDLK_UP, SDLK_DOWN, SDLK_LEFT, SDLK_RIGHT
        v = p->SnapToward( v + dirn * p->KeyStep(), v )
    case SDLK_PAGEUP   : v = p->SnapToward( v + iif( p->nLarge > 0, p->nLarge, p->KeyStep() ), v )
    case SDLK_PAGEDOWN : v = p->SnapToward( v - iif( p->nLarge > 0, p->nLarge, p->KeyStep() ), v )
    case SDLK_HOME     : v = p->Snap( p->nMin )
    case SDLK_END      : v = p->Snap( p->nMax )
    case else : return false
    end select
    if UserSet( p, v ) then Notify( p, true, true )
    return true                                         ' claimed, moved or not (at a limit)
end function

private function Proc( byval w as TK_WIDGET ptr, byval m as TK_MSG ptr ) as boolean
    dim as TKSLIDER_STATE ptr p = SL( w )
    if p = 0 then return false
    dim as TK_HOST ptr h = w->pHost

    select case m->msg
    case TKM_PAINT
        OnPaint( p, m->pPaint )
        return true

    case TKM_SIZE
        p->Refresh()
        return true

    case TKM_SCALECHANGED
        Rescale( p, m->fOld, m->fNew )
        return true

    case TKM_THEMECHANGED
        tkSlider_ApplyTheme( w, tkTheme_Of( w ) )
        return true

    case TKM_LBUTTONDOWN
        ' m->clicks is not read: a second click is an ordinary press
        if p->isEnabled = false then return true
        tkTipHost_Pop( @p->tip )
        tkHost_SetFocus( h, w )
        if CallMessage( p, m ) then return true
        if p->isReadOnly then return true
        EnsureLayout( p )
        if p->Span() <= 0 then return true
        p->lastX = m->x : p->lastY = m->y
        p->nDragStart = p->nValue
        dim as long at = Along( p, m->x, m->y )
        if tkRect_Contains( p->rcTarget, m->x, m->y ) then
            p->nGrab = at - p->CentreOf( p->nValue )
        elseif p->nTrackClick = TKSL_CLICK_PAGE then
            dim as double vAt = p->ValueAt( at )
            if p->Differ( vAt, p->nValue ) = false then return true
            p->nPageDir = iif( vAt > p->nValue, 1, -1 )
            p->isPaging = true
            SetHot( p, -1 )
            tkHost_SetCapture( w )
            tkWidget_SetTimer( w, TK_TIMER_AUTOREPEAT, p->nRepeatDelay )
            if PageStep( p ) then Notify( p, true, true ) else UpdateTip( p )
            return true
        else
            p->nGrab = 0                                 ' JUMP: the thumb comes to the pointer
            dim as boolean bJumped = UserSet( p, p->ValueAt( at ) )
            p->isDragging = true
            SetHot( p, 0 )
            tkHost_SetCapture( w )
            tkWidget_Invalidate( w )
            UpdateTip( p )
            if bJumped then Notify( p, true, false )
            return true
        end if
        p->isDragging = true
        SetHot( p, 0 )
        tkHost_SetCapture( w )
        tkWidget_Invalidate( w )
        UpdateTip( p )
        return true

    case TKM_MOUSEMOVE
        if p->isEnabled = false then return true
        p->lastX = m->x : p->lastY = m->y
        if p->isDragging then
            ' under capture moves come from anywhere: the value clamps, it never snaps back
            if UserSet( p, p->ValueAt( Along( p, m->x, m->y ) - p->nGrab ) ) then
                CallMessage( p, m )
                Notify( p, true, false )
                return true
            end if
        elseif p->isPaging = false then
            EnsureLayout( p )
            SetHot( p, iif( tkRect_Contains( p->rcTarget, m->x, m->y ), 0, -1 ) )
        end if
        CallMessage( p, m )
        return true

    case TKM_MOUSELEAVE
        if (p->isDragging = false) andalso (p->isPaging = false) then SetHot( p, -1 )
        CallMessage( p, m )
        return true

    case TKM_LBUTTONUP
        ' snapshot before releasing: TKM_CAPTURECHANGED arrives synchronously
        dim as boolean bCommit = EndDrag( p )
        if p->isPaging then StopPaging( p )
        if tkHost_GetCapture( h ) = w then tkHost_ReleaseCapture( h )
        EnsureLayout( p )
        if (tkRect_Contains( p->rcTarget, m->x, m->y ) = false) orelse (h->pHot <> w) then SetHot( p, -1 )
        CallMessage( p, m )                              ' result ignored
        if bCommit then Notify( p, false, true )
        return true

    case TKM_CAPTURECHANGED
        ' lost mid-gesture (another widget took it): a drag ends where it is, and stands
        if p->isPaging then StopPaging( p )
        if EndDrag( p ) then Notify( p, false, true )
        return true

    case TKM_TIMER
        if m->timerId = TK_TIMER_AUTOREPEAT then
            if p->isPaging = false then tkWidget_KillTimer( w, TK_TIMER_AUTOREPEAT ) : return true
            tkWidget_SetTimer( w, TK_TIMER_AUTOREPEAT, p->nRepeatMs )
            if PageReached( p ) then StopPaging( p ) : return true
            if PageStep( p ) then
                Notify( p, true, true )
            else
                StopPaging( p )
            end if
            return true
        end if

    case TKM_RBUTTONDOWN, TKM_RBUTTONUP
        CallMessage( p, m )                              ' reported, never acted on
        return true

    case TKM_SETFOCUS, TKM_KILLFOCUS
        dim as boolean bFocused = (m->msg = TKM_SETFOCUS)
        if bFocused <> p->isFocused then p->isFocused = bFocused : tkWidget_Invalidate( w )
        p->nWheelAccum = 0
        UpdateTip( p )
        CallMessage( p, m )                              ' result ignored: focus is a fact
        return true

    case TKM_KEYDOWN
        if p->isEnabled = false then return false
        if CallMessage( p, m ) then return true
        if m->key = SDLK_ESCAPE then
            if p->isDragging = false then return false   ' only a drag claims Esc
            dim as boolean bMoved = p->Differ( p->nValue, p->nDragStart )
            p->isDragging = false
            if bMoved then p->nValue = p->nDragStart : p->Refresh()
            if tkHost_GetCapture( h ) = w then tkHost_ReleaseCapture( h )
            tkWidget_Invalidate( w )
            UpdateTip( p )
            if bMoved then Notify( p, true, false )
            return true
        end if
        if p->isReadOnly orelse p->isDragging orelse p->isPaging then return false
        return OnKey( p, m->key )

    case TKM_MOUSEWHEEL
        if (p->isEnabled = false) orelse p->isReadOnly orelse p->isDragging orelse p->isPaging then return false
        select case p->nWheelMode
        case TKSL_WHEEL_NEVER : return false
        case TKSL_WHEEL_FOCUSED
            if p->isFocused = false then return false    ' refused: it bubbles (a scroll panel)
        end select
        if CallMessage( p, m ) then return true
        return OnWheel( p, m->wheelY + m->wheelX )

    case TKM_ENABLE
        p->isEnabled = m->bFlag
        if p->isEnabled = false then
            ' the host takes capture, focus and hot at once; a drag ends as it stands
            p->isDragging = false
            if p->isPaging then StopPaging( p )
            p->nHot = -1
            tkTipHost_Pop( @p->tip )
        end if
        UpdateTip( p )
        tkWidget_Invalidate( w )
        return true

    case TKM_SHOW
        if m->bFlag = false then
            p->isDragging = false
            if p->isPaging then StopPaging( p )
            p->nHot = -1
            HideTip( p )
        end if
        return true

    case TKM_DESTROY
        if p->isPaging then tkWidget_KillTimer( w, TK_TIMER_AUTOREPEAT )
        tkTipHost_Destroy( @p->vtip )
        tkTipHost_Destroy( @p->tip )
        delete p
        w->pData = 0
        return true
    end select
    return false
end function

' ==========================================================================================
' Public API
' ==========================================================================================
public declare function tkSlider_ThemeColors( byref t as TKTHEME_COLORS ) as TKSLIDER_COLORS

private function TipText( byval t as TK_TIP ptr, byval a as TK_WIDGET ptr, byval idx as long ) as ustring
    dim as TKSLIDER_STATE ptr p = SL( a )
    if p = 0 then return ""
    return p->wszTooltip
end function

' A child of hParent, created 0x0: size it from GetIdealSize, place it with tkWidget_SetPos.
public function tkSlider_Create( byval hParent as TK_WIDGET ptr, byval ctrlId as long ) as TK_WIDGET ptr
    if hParent = 0 then return 0
    dim as TK_HOST ptr pHost = hParent->pHost
    dim as TKSLIDER_STATE ptr p = new TKSLIDER_STATE
    p->id = ctrlId
    p->nTrackThick = tkHost_Scale( pHost, TKSLIDER_DEFAULT_TRACK )
    p->nThumbA = tkHost_Scale( pHost, TKSLIDER_DEFAULT_THUMB )
    p->nThumbX = p->nThumbA
    p->nFocusGap = tkHost_Scale( pHost, TKSLIDER_DEFAULT_FOCUSGAP )
    p->nTickLen = tkHost_Scale( pHost, TKSLIDER_DEFAULT_TICKLEN )
    p->nTickGap = tkHost_Scale( pHost, TKSLIDER_DEFAULT_TICKGAP )
    p->nLabelGap = tkHost_Scale( pHost, TKSLIDER_DEFAULT_LABELGAP )
    dim as TK_WIDGET ptr w = tkWidget_CreateChild( hParent, ctrlId, @Proc, p )
    w->isFocusable = true
    p->hWin = w
    p->colors = tkSlider_ThemeColors( tkTheme_Of( w ) )
    tkTheme_ResolveInto( w, tkTheme_Of( w ), cast( ulong ptr, @p->colors ), sizeof( TKSLIDER_COLORS ) \ 4, "Slider" )
    tkTipHost_Ensure( @p->tip, w, @TipText )
    ApplyThemeShape( w )
    return w
end function

public function tkSlider_GetID( byval hSlider as TK_WIDGET ptr ) as long
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p = 0 then return 0
    return p->id
end function

public function tkSlider_GetEnabled( byval hSlider as TK_WIDGET ptr ) as boolean
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p = 0 then return false
    return p->isEnabled
end function

' tkWidget_Enable: input stops, Tab skips it, capture / focus / hot go at once.
public sub tkSlider_SetEnabled( byval hSlider as TK_WIDGET ptr, byval isEnabled as boolean )
    if hSlider then tkWidget_Enable( hSlider, isEnabled )
end sub

public function tkSlider_GetFocused( byval hSlider as TK_WIDGET ptr ) as boolean
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p = 0 then return false
    return p->isFocused
end function

public sub tkSlider_Refresh( byval hSlider as TK_WIDGET ptr )
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p then p->Refresh()
end sub

' ---- value (every setter SILENT) ------------------------------------------------------------
public function tkSlider_GetValue( byval hSlider as TK_WIDGET ptr ) as double
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p = 0 then return 0
    return p->nValue
end function

' Snapped and clamped like any value.
public sub tkSlider_SetValue( byval hSlider as TK_WIDGET ptr, byval nValue as double )
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p = 0 then exit sub
    p->nValue = p->Snap( nValue )
    p->Refresh()
    UpdateTip( p )
end sub

public sub tkSlider_GetRange( byval hSlider as TK_WIDGET ptr, byref nMin as double, byref nMax as double )
    nMin = 0 : nMax = 0
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p = 0 then exit sub
    nMin = p->nMin : nMax = p->nMax
end sub

' An inverted pair is swapped. The ticks are rebuilt and the value re-snapped, silently.
public sub tkSlider_SetRange( byval hSlider as TK_WIDGET ptr, byval nMin as double, byval nMax as double )
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p = 0 then exit sub
    if nMin > nMax then swap nMin, nMax
    p->nMin = nMin : p->nMax = nMax
    p->bTicksDirty = true
    p->nValue = p->Snap( p->nValue )
    p->Refresh()
end sub

public function tkSlider_GetStep( byval hSlider as TK_WIDGET ptr ) as double
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p = 0 then return 0
    return p->nStep
end function

' The value grid from Min; 0 = continuous. Negative is 0. The value is re-snapped, silently.
public sub tkSlider_SetStep( byval hSlider as TK_WIDGET ptr, byval nStep as double )
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p = 0 then exit sub
    p->nStep = iif( nStep < 0, 0, nStep )
    p->nValue = p->Snap( p->nValue )
    p->Refresh()
end sub

public function tkSlider_GetSmallChange( byval hSlider as TK_WIDGET ptr ) as double
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p = 0 then return 0
    return p->nSmall
end function

' Arrow keys and one wheel notch. 0 = Step (or a hundredth of the range when continuous).
public sub tkSlider_SetSmallChange( byval hSlider as TK_WIDGET ptr, byval n as double )
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p then p->nSmall = iif( n < 0, 0, n )
end sub

public function tkSlider_GetLargeChange( byval hSlider as TK_WIDGET ptr ) as double
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p = 0 then return 0
    return p->nLarge
end function

' PgUp / PgDn and a PAGE track click. 0 = the small change.
public sub tkSlider_SetLargeChange( byval hSlider as TK_WIDGET ptr, byval n as double )
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p then p->nLarge = iif( n < 0, 0, n )
end sub

public function tkSlider_GetDecimalPlaces( byval hSlider as TK_WIDGET ptr ) as long
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p = 0 then return 0
    return p->nDecimals
end function

' The labels' and the tip's digits, and the residue rounding: 0..9. Not a grid -- Step is.
public sub tkSlider_SetDecimalPlaces( byval hSlider as TK_WIDGET ptr, byval nPlaces as long )
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p = 0 then exit sub
    if nPlaces < 0 then nPlaces = 0
    if nPlaces > 9 then nPlaces = 9
    p->nDecimals = nPlaces
    p->bTicksDirty = true
    p->nValue = p->Snap( p->nValue )
    p->Refresh()
end sub

' A programmatic key step: nSteps x SmallChange, as the arrow keys move. SILENT.
public sub tkSlider_StepBy( byval hSlider as TK_WIDGET ptr, byval nSteps as long )
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if (p = 0) orelse (nSteps = 0) then exit sub
    dim as double v = p->nValue
    for i as long = 1 to abs( nSteps )
        v = p->SnapToward( v + sgn( nSteps ) * p->KeyStep(), v )
    next
    p->nValue = v
    p->Refresh()
    UpdateTip( p )
end sub

' The text a tick label (TKSL_FMT_TICK) or the value tip (TKSL_FMT_TIP) shows for v: the
' FormatValue callback's, or v with DecimalPlaces digits.
public function tkSlider_FormatValue( byval hSlider as TK_WIDGET ptr, byval nValue as double, _
                                      byval nWhere as long = TKSL_FMT_TIP ) as ustring
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p = 0 then return ""
    return FormatV( p, nValue, nWhere )
end function

' ---- shape and behaviour -------------------------------------------------------------------
public function tkSlider_GetOrientation( byval hSlider as TK_WIDGET ptr ) as long
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p = 0 then return TKSL_HORIZONTAL
    return p->nOrientation
end function

' TKSL_HORIZONTAL | TKSL_VERTICAL; anything else is ignored. The host re-sizes (GetIdealSize).
public sub tkSlider_SetOrientation( byval hSlider as TK_WIDGET ptr, byval nOrientation as long )
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p = 0 then exit sub
    select case nOrientation
    case TKSL_HORIZONTAL, TKSL_VERTICAL
        p->nOrientation = nOrientation
        p->Refresh()
    end select
end sub

public function tkSlider_GetReversed( byval hSlider as TK_WIDGET ptr ) as boolean
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p = 0 then return false
    return p->bReversed
end function

' Min at the right (horizontal) or the top (vertical).
public sub tkSlider_SetReversed( byval hSlider as TK_WIDGET ptr, byval bReversed as boolean )
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p = 0 then exit sub
    p->bReversed = bReversed
    p->Refresh()
end sub

public function tkSlider_GetTrackClick( byval hSlider as TK_WIDGET ptr ) as long
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p = 0 then return TKSL_CLICK_JUMP
    return p->nTrackClick
end function

public sub tkSlider_SetTrackClick( byval hSlider as TK_WIDGET ptr, byval nMode as long )
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p = 0 then exit sub
    select case nMode
    case TKSL_CLICK_JUMP, TKSL_CLICK_PAGE : p->nTrackClick = nMode
    end select
end sub

public function tkSlider_GetFillMode( byval hSlider as TK_WIDGET ptr ) as long
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p = 0 then return TKSL_FILL_MIN
    return p->nFillMode
end function

public sub tkSlider_SetFillMode( byval hSlider as TK_WIDGET ptr, byval nMode as long )
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p = 0 then exit sub
    select case nMode
    case TKSL_FILL_MIN, TKSL_FILL_NONE, TKSL_FILL_ORIGIN
        p->nFillMode = nMode
        p->Refresh()
    end select
end sub

public function tkSlider_GetFillOrigin( byval hSlider as TK_WIDGET ptr ) as double
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p = 0 then return 0
    return p->nFillOrigin
end function

' TKSL_FILL_ORIGIN's start, a value (clamped to the range when drawn, kept as given).
public sub tkSlider_SetFillOrigin( byval hSlider as TK_WIDGET ptr, byval nOrigin as double )
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p = 0 then exit sub
    p->nFillOrigin = nOrigin
    p->Refresh()
end sub

public function tkSlider_GetThumbShape( byval hSlider as TK_WIDGET ptr ) as long
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p = 0 then return TKSL_THUMB_ROUND
    return p->nThumbShape
end function

public sub tkSlider_SetThumbShape( byval hSlider as TK_WIDGET ptr, byval nShape as long )
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p = 0 then exit sub
    select case nShape
    case TKSL_THUMB_ROUND, TKSL_THUMB_RECT
        p->nThumbShape = nShape
        tkWidget_Invalidate( hSlider )
    end select
end sub

public function tkSlider_GetShowValueTip( byval hSlider as TK_WIDGET ptr ) as long
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p = 0 then return TKSL_TIP_NONE
    return p->nShowTip
end function

public sub tkSlider_SetShowValueTip( byval hSlider as TK_WIDGET ptr, byval nMode as long )
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p = 0 then exit sub
    select case nMode
    case TKSL_TIP_NONE, TKSL_TIP_DRAG, TKSL_TIP_FOCUSED
        p->nShowTip = nMode
        UpdateTip( p )
    end select
end sub

' The value tip's tkTooltip (colours, style, font), or 0 before it was first shown.
public function tkSlider_GetValueTipHandle( byval hSlider as TK_WIDGET ptr ) as TK_TIP ptr
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p = 0 then return 0
    return tkTipHost_Tip( @p->vtip )
end function

public function tkSlider_IsValueTipShown( byval hSlider as TK_WIDGET ptr ) as boolean
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if (p = 0) orelse (p->bTipShown = false) then return false
    return tkTooltip_IsVisible( tkTipHost_Tip( @p->vtip ) )
end function

public function tkSlider_GetReadOnly( byval hSlider as TK_WIDGET ptr ) as boolean
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p = 0 then return false
    return p->isReadOnly
end function

' Focusable and ringed, but keys, wheel and mouse change nothing (Enabled is separate).
public sub tkSlider_SetReadOnly( byval hSlider as TK_WIDGET ptr, byval bReadOnly as boolean )
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p = 0 then exit sub
    p->isReadOnly = bReadOnly
    tkWidget_Invalidate( hSlider )
end sub

public function tkSlider_GetWheelMode( byval hSlider as TK_WIDGET ptr ) as long
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p = 0 then return TKSL_WHEEL_FOCUSED
    return p->nWheelMode
end function

' TKSL_WHEEL_FOCUSED | _HOVER | _NEVER; anything else is ignored.
public sub tkSlider_SetWheelMode( byval hSlider as TK_WIDGET ptr, byval nMode as long )
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p = 0 then exit sub
    select case nMode
    case TKSL_WHEEL_FOCUSED, TKSL_WHEEL_HOVER, TKSL_WHEEL_NEVER
        p->nWheelMode = nMode
        p->nWheelAccum = 0
    end select
end sub

public sub tkSlider_GetAutoRepeat( byval hSlider as TK_WIDGET ptr, byref nDelayMs as long, byref nIntervalMs as long )
    nDelayMs = 0 : nIntervalMs = 0
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p = 0 then exit sub
    nDelayMs = p->nRepeatDelay : nIntervalMs = p->nRepeatMs
end sub

' The PAGE click's repeat: the first delay, then the interval. Floored at 1 ms.
public sub tkSlider_SetAutoRepeat( byval hSlider as TK_WIDGET ptr, byval nDelayMs as long, byval nIntervalMs as long )
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p = 0 then exit sub
    p->nRepeatDelay = iif( nDelayMs < 1, 1, nDelayMs )
    p->nRepeatMs = iif( nIntervalMs < 1, 1, nIntervalMs )
end sub

' ---- ticks and labels: in tkSliderLayout.tiko ------------------------------------------------

' ---- geometry: raw pixels, the caller scales ------------------------------------------------
public function tkSlider_GetTrackSize( byval hSlider as TK_WIDGET ptr ) as long
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p = 0 then return 0
    return p->nTrackThick
end function

public sub tkSlider_SetTrackSize( byval hSlider as TK_WIDGET ptr, byval nThickness as long )
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p = 0 then exit sub
    p->nTrackThick = iif( nThickness < 1, 1, nThickness )
    p->Refresh()
end sub

' (along the track, across it): a horizontal slider's (width, height).
public sub tkSlider_GetThumbSize( byval hSlider as TK_WIDGET ptr, byref nAlong as long, byref nAcross as long )
    nAlong = 0 : nAcross = 0
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p = 0 then exit sub
    nAlong = p->nThumbA : nAcross = p->nThumbX
end sub

public sub tkSlider_SetThumbSize( byval hSlider as TK_WIDGET ptr, byval nAlong as long, byval nAcross as long )
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p = 0 then exit sub
    p->nThumbA = iif( nAlong < 1, 1, nAlong )
    p->nThumbX = iif( nAcross < 1, 1, nAcross )
    p->Refresh()
end sub

public sub tkSlider_GetTickSize( byval hSlider as TK_WIDGET ptr, byref nLength as long, byref nGap as long, byref nLabelGap as long )
    nLength = 0 : nGap = 0 : nLabelGap = 0
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p = 0 then exit sub
    nLength = p->nTickLen : nGap = p->nTickGap : nLabelGap = p->nLabelGap
end sub

' The tick mark's length, the gap from the thumb band to it, and from it to the labels.
public sub tkSlider_SetTickSize( byval hSlider as TK_WIDGET ptr, byval nLength as long, byval nGap as long, byval nLabelGap as long )
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p = 0 then exit sub
    p->nTickLen = iif( nLength < 1, 1, nLength )
    p->nTickGap = iif( nGap < 0, 0, nGap )
    p->nLabelGap = iif( nLabelGap < 0, 0, nLabelGap )
    p->Refresh()
end sub

public function tkSlider_GetBorderThickness( byval hSlider as TK_WIDGET ptr ) as long
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p = 0 then return 0
    return p->nBorderThick
end function

' The thumb's border, drawn inside it: repaints, never re-lays out. 0 = none. Pins it against
' the theme's BorderWidth.
public sub tkSlider_SetBorderThickness( byval hSlider as TK_WIDGET ptr, byval nThickness as long )
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p = 0 then exit sub
    p->nBorderThick = iif( nThickness < 0, 0, nThickness )
    p->bShapePinned = true
    tkWidget_Invalidate( hSlider )
end sub

public sub tkSlider_GetFocusRing( byval hSlider as TK_WIDGET ptr, byref nGap as long, byref nThickness as long )
    nGap = 0 : nThickness = 0
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p = 0 then exit sub
    nGap = p->nFocusGap : nThickness = p->nFocusThick
end sub

' The band is reserved round the whole control whether or not it has focus (the ring is drawn
' round the thumb, and the thumb may sit at either end).
public sub tkSlider_SetFocusRing( byval hSlider as TK_WIDGET ptr, byval nGap as long, byval nThickness as long )
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p = 0 then exit sub
    p->nFocusGap = iif( nGap < 0, 0, nGap )
    p->nFocusThick = iif( nThickness < 0, 0, nThickness )
    p->Refresh()
end sub

' Valid before the control is sized: along, ThumbAlong + LENGTH; across, the band block (thumb,
' ticks, labels); the ring band each side. (width, height) whatever the orientation.
public sub tkSlider_GetIdealSize( byval hSlider as TK_WIDGET ptr, byref nWidth as long, byref nHeight as long )
    nWidth = 0 : nHeight = 0
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p = 0 then exit sub
    IdealSize( p, nWidth, nHeight )
end sub

' 0 track, 1 fill, 2 thumb, 3 thumb's hit target. FALSE (rc empty) while there is no client.
private function GetPart( byval hSlider as TK_WIDGET ptr, byval nPart as long, byref rc as TKRECT ) as boolean
    tkRect_SetEmpty( rc )
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p = 0 then return false
    EnsureLayout( p )
    if p->bLayoutDirty then return false
    select case nPart
    case 1 : rc = p->rcFill
    case 2 : rc = p->rcThumb
    case 3 : rc = p->rcTarget
    case else : rc = p->rcTrack
    end select
    return true
end function

public function tkSlider_GetTrackRect( byval hSlider as TK_WIDGET ptr, byref rc as TKRECT ) as boolean
    return GetPart( hSlider, 0, rc )
end function

' Empty (but TRUE) with TKSL_FILL_NONE.
public function tkSlider_GetFillRect( byval hSlider as TK_WIDGET ptr, byref rc as TKRECT ) as boolean
    return GetPart( hSlider, 1, rc )
end function

' nThumb: 0 (the only thumb until range mode).
public function tkSlider_GetThumbRect( byval hSlider as TK_WIDGET ptr, byval nThumb as long, byref rc as TKRECT ) as boolean
    if nThumb <> 0 then tkRect_SetEmpty( rc ) : return false
    return GetPart( hSlider, 2, rc )
end function

public function tkSlider_GetThumbTarget( byval hSlider as TK_WIDGET ptr, byval nThumb as long, byref rc as TKRECT ) as boolean
    if nThumb <> 0 then tkRect_SetEmpty( rc ) : return false
    return GetPart( hSlider, 3, rc )
end function

' The thumb centre's coordinate along the axis for a value (snapped first). 0 when not laid out.
public function tkSlider_ValueToPos( byval hSlider as TK_WIDGET ptr, byval nValue as double ) as long
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p = 0 then return 0
    EnsureLayout( p )
    if p->bLayoutDirty then return 0
    return p->CentreOf( p->Snap( nValue ) )
end function

' The value a thumb centred on the coordinate along the axis would take (snapped, clamped).
public function tkSlider_PosToValue( byval hSlider as TK_WIDGET ptr, byval nPos as long ) as double
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p = 0 then return 0
    EnsureLayout( p )
    if p->bLayoutDirty then return p->nValue
    return p->ValueAt( nPos )
end function

' TKSL_PART_THUMB0 inside the thumb's target; TKSL_PART_TICKS in a tick or label band;
' TKSL_PART_TRACK elsewhere in the client.
public function tkSlider_HitTest( byval hSlider as TK_WIDGET ptr, byval x as long, byval y as long ) as long
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p = 0 then return TKSL_PART_NONE
    EnsureLayout( p )
    if p->bLayoutDirty then return TKSL_PART_NONE
    if (x < 0) orelse (y < 0) orelse (x >= hSlider->cw) orelse (y >= hSlider->ch) then return TKSL_PART_NONE
    if tkRect_Contains( p->rcTarget, x, y ) then return TKSL_PART_THUMB0
    if tkRect_Contains( p->rcTicks1, x, y ) orelse tkRect_Contains( p->rcTicks2, x, y ) _
       orelse tkRect_Contains( p->rcLabels, x, y ) then return TKSL_PART_TICKS
    return TKSL_PART_TRACK
end function

public function tkSlider_GetHotThumb( byval hSlider as TK_WIDGET ptr ) as long
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p = 0 then return -1
    return p->nHot
end function

public function tkSlider_GetPressedThumb( byval hSlider as TK_WIDGET ptr ) as long
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if (p = 0) orelse ((p->isDragging = false) andalso (p->isPaging = false)) then return -1
    return 0
end function

public function tkSlider_IsDragging( byval hSlider as TK_WIDGET ptr ) as boolean
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    return (p <> 0) andalso p->isDragging
end function

' A PAGE track press is held and repeating.
public function tkSlider_IsRepeating( byval hSlider as TK_WIDGET ptr ) as boolean
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    return (p <> 0) andalso p->isPaging
end function

' ---- tooltip (tkTipHost) -------------------------------------------------------------------
public sub tkSlider_SetTooltipText( byval hSlider as TK_WIDGET ptr, byval Text as ustring )
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p then p->wszTooltip = Text
end sub

public function tkSlider_GetTooltipText( byval hSlider as TK_WIDGET ptr ) as ustring
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p = 0 then return ""
    return p->wszTooltip
end function

public function tkSlider_GetTooltipHandle( byval hSlider as TK_WIDGET ptr ) as TK_TIP ptr
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p = 0 then return 0
    return tkTipHost_Tip( @p->tip )
end function

public sub tkSlider_SetHoverTime( byval hSlider as TK_WIDGET ptr, byval ms as long )
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p then tkTipHost_SetDelay( @p->tip, TK_TIPDELAY_INITIAL, ms )
end sub

public sub tkSlider_SetAutoPopTime( byval hSlider as TK_WIDGET ptr, byval ms as long )
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p then tkTipHost_SetDelay( @p->tip, TK_TIPDELAY_AUTOPOP, ms )
end sub

public sub tkSlider_SetReshowTime( byval hSlider as TK_WIDGET ptr, byval ms as long )
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p then tkTipHost_SetDelay( @p->tip, TK_TIPDELAY_RESHOW, ms )
end sub

' ---- appearance ----------------------------------------------------------------------------
public sub tkSlider_GetColors( byval hSlider as TK_WIDGET ptr, byval pColors as TKSLIDER_COLORS ptr )
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if (p = 0) orelse (pColors = 0) then exit sub
    *pColors = p->colors
end sub

' Copies the struct and PINS it: a theme change leaves this slider alone until UnpinColors.
public sub tkSlider_SetColors( byval hSlider as TK_WIDGET ptr, byval pColors as TKSLIDER_COLORS ptr )
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if (p = 0) orelse (pColors = 0) then exit sub
    p->colors = *pColors
    p->bColorsPinned = true
    tkWidget_Invalidate( hSlider )
end sub

' The slider's colours from the theme's roles (SLIDER.md §7.2).
public function tkSlider_ThemeColors( byref t as TKTHEME_COLORS ) as TKSLIDER_COLORS
    dim as TKSLIDER_COLORS c
    c.BackColor                = t.Window
    c.FocusRingColor           = t.FocusRing
    c.TrackColor               = t.Track
    c.TrackColorDisabled       = t.SurfaceDisabled
    c.FillColor                = t.Accent
    c.FillColorHot             = t.AccentHot
    c.FillColorDisabled        = t.BorderDisabled
    c.ThumbColor               = t.Surface
    c.ThumbColorHot            = t.SurfaceHot
    c.ThumbColorPressed        = t.Selected
    c.ThumbColorDisabled       = t.SurfaceDisabled
    c.ThumbBorderColor         = t.Accent
    c.ThumbBorderColorHot      = t.AccentHot
    c.ThumbBorderColorDisabled = t.BorderDisabled
    c.TickColor                = t.Divider
    c.TickColorDisabled        = t.BorderDisabled
    c.LabelColor               = t.TextDim
    c.LabelColorDisabled       = t.TextDisabled
    return c
end function

public sub tkSlider_ApplyTheme( byval hSlider as TK_WIDGET ptr, byref t as TKTHEME_COLORS )
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p = 0 then exit sub
    ApplyThemeShape( hSlider )
    if p->bColorsPinned then exit sub
    dim as TKTHEME_COLORS tr = tkTheme_Styled( hSlider, t )
    p->colors = tkSlider_ThemeColors( tr )
    tkTheme_ResolveInto( hSlider, tr, cast( ulong ptr, @p->colors ), sizeof( TKSLIDER_COLORS ) \ 4, "Slider" )
    tkWidget_Invalidate( hSlider )
end sub

' Hands the slider back to the theme, which is applied at once.
public sub tkSlider_UnpinColors( byval hSlider as TK_WIDGET ptr )
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p = 0 then exit sub
    p->bColorsPinned = false
    tkSlider_ApplyTheme( hSlider, tkTheme_Of( hSlider ) )
end sub

' ---- callbacks -----------------------------------------------------------------------------
' A paint callback's way to draw the slider as it would have been drawn, then add to it.
public sub tkSlider_PaintDefault( byval pi as TKSLIDER_PAINTINFO ptr )
    if pi = 0 then exit sub
    dim as TKSLIDER_STATE ptr p = SL( pi->hSlider )
    if p then RenderDefault( p, pi )
end sub

public sub tkSlider_SetPaintCallback( byval hSlider as TK_WIDGET ptr, byval usersub as SLD_PaintCallbackSub )
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p = 0 then exit sub
    p->PaintCallback = usersub
    tkWidget_Invalidate( hSlider )
end sub

public sub tkSlider_SetMessageCallback( byval hSlider as TK_WIDGET ptr, byval userfunc as SLD_MessageCallbackFunc )
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p then p->MessageCallback = userfunc
end sub

public sub tkSlider_SetValueChangedCallback( byval hSlider as TK_WIDGET ptr, byval usersub as SLD_ValueChangedCallbackSub )
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p then p->ChangedCallback = usersub
end sub

public sub tkSlider_SetValueCommittedCallback( byval hSlider as TK_WIDGET ptr, byval usersub as SLD_ValueCommittedCallbackSub )
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p then p->CommittedCallback = usersub
end sub

' The text of a tick label (nWhere TKSL_FMT_TICK) or the value tip (TKSL_FMT_TIP). An empty
' answer falls back to the default (the value with DecimalPlaces digits).
public sub tkSlider_SetFormatValueCallback( byval hSlider as TK_WIDGET ptr, byval userfunc as SLD_FormatValueCallbackFunc )
    dim as TKSLIDER_STATE ptr p = SL( hSlider )
    if p = 0 then exit sub
    p->FormatCallback = userfunc
    p->Refresh()
end sub

' The theme's shape until a shape setter ran: its BorderWidth is the thumb's border.
private sub ApplyThemeShape( byval w as TK_WIDGET ptr )
    dim as TKSLIDER_STATE ptr p = SL( w )
    if (p = 0) orelse p->bShapePinned then exit sub
    dim as TKTHEME_SHAPE sh = tkTheme_ShapeOf( w )
    p->nBorderThick = iif( sh.BorderWidth >= 0, sh.BorderWidth, TKSLIDER_DEFAULT_BORDER )
    tkWidget_Invalidate( w )
end sub
