'
' tkGauge -- a radial or linear gauge: one scale, coloured ranges, several pointers
' (needle, bar, marker), major / minor ticks with labels, the value as text and a caption. New in
' tkControls; the design is C:\dev\docs\tkControls\GAUGE-SPARKLINE.md §3 and §6 (phases GS2, GS3).
'
' THIS FILE draws one, with or without a widget: the spec, the 1-2-5 step, the ranges' text form,
' tkGauge_Layout (one GG_GEOM that the painter and the probes read), the painter,
' tkGauge_PaintInto (any TK_PAINT) and tkGauge_PaintPage (a print page, through
' tkPage_BeginCanvas: the same painter). The widget is tkGaugeWidget.tiko.
'
' THE RULES: angles are tkPaint's (0 = 3 o'clock, + clockwise); the default arc starts at 135 and
' sweeps 270. The gauge is FITTED TO ITS ARC, not to the full circle: a semicircle fills a 2:1 rect.
' Values are stored as given and DRAWN CLAMPED (D-1). Arcs are stroked along their centre radius
' with PaintPolylineF's mitred band (GS0: PaintPieRing cannot draw a band thinner than r / 10);
' a range whose two ends differ in width is a polygon. Sizes are design units scaled at layout.
#module "tkGauge"

#import "../tkHost" public
#import "../tkTheme" public
#import "../tkTooltip" public
#import "../tkPrint" public
using tkHost
using tkPaint
using tkTheme
using tkTooltip
using tkPrint

public enum
    TKGAUGE_RADIAL = 0
    TKGAUGE_LINEAR
end enum

public enum
    TKGAUGE_PTR_NEEDLE = 0
    TKGAUGE_PTR_BAR
    TKGAUGE_PTR_MARKER
end enum

' A linear gauge's long axis. HORIZONTAL runs Min at the left, VERTICAL Min at the bottom
' (SetReverse flips either).
public enum
    TKGAUGE_HORIZONTAL = 0
    TKGAUGE_VERTICAL
end enum

' Radial: ticks and labels inside the track (toward the hub) or outside it; BOTH reads as INSIDE.
' Linear: NEAR (= INSIDE) is below a horizontal track and left of a vertical one -- a chart's
' axis sides; FAR (= OUTSIDE) the other side; BOTH ticks both sides, labels on the near one.
' Needles (triangles) sit on the side without labels.
public enum
    TKGAUGE_SCALE_INSIDE = 0
    TKGAUGE_SCALE_OUTSIDE
    TKGAUGE_SCALE_NONE
    TKGAUGE_SCALE_BOTH
end enum
public const as int32 TKGAUGE_SCALE_NEAR = TKGAUGE_SCALE_INSIDE
public const as int32 TKGAUGE_SCALE_FAR  = TKGAUGE_SCALE_OUTSIDE

' Radial AUTO: below the hub for an arc under 300 degrees, at the centre otherwise; END reads as
' BELOW. Linear: anything but NONE is END -- right of a horizontal track, below a vertical one
' (the caption is left of it / above it), whichever way the scale runs.
public enum
    TKGAUGE_VALUE_AUTO = 0
    TKGAUGE_VALUE_CENTER
    TKGAUGE_VALUE_BELOW
    TKGAUGE_VALUE_NONE
    TKGAUGE_VALUE_END
end enum

public const as int32 TKGAUGE_DECIMALS_AUTO = -1
' Design units unless named a fraction.
public const as float32 TKGAUGE_DEFAULT_START      = 135
public const as float32 TKGAUGE_DEFAULT_SWEEP      = 270
public const as float32 TKGAUGE_DEFAULT_TRACKWIDTH = 0.12     ' a fraction of the radius
public const as int32 TKGAUGE_DEFAULT_TICKHINT   = 5
public const as int32 TKGAUGE_DEFAULT_MINORCOUNT = 4
public const as int32 TKGAUGE_DEFAULT_PADDING    = 4
public const as int32 TKGAUGE_TICKGAP    = 3
public const as int32 TKGAUGE_MAJORLEN   = 8
public const as int32 TKGAUGE_MINORLEN   = 4
public const as int32 TKGAUGE_MAJORTHICK = 2
public const as int32 TKGAUGE_MINORTHICK = 1
public const as int32 TKGAUGE_NEEDLEWIDTH = 6
public const as int32 TKGAUGE_MARKERWIDTH = 3
public const as int32 TKGAUGE_TEXTGAP    = 4
public const as float32 TKGAUGE_HUBFRAC  = 0.06               ' the hub's radius, a fraction of r (at least 1.6 x the needle's half width)

public type TKGAUGE_COLORS
    BackColor         as uint32 = &hFF21252Bul
    FaceColor         as uint32 = &hFF2C313Aul
    TrackColor        as uint32 = &hFF3E444Eul
    TickColor         as uint32 = &hFF969CA6ul
    LabelColor        as uint32 = &hFF969CA6ul
    NeedleColor       as uint32 = &hFF569CD6ul
    HubColor          as uint32 = &hFFC8CDD6ul
    BarColor          as uint32 = &hFF569CD6ul
    MarkerColor       as uint32 = &hFFE5C07Bul
    ValueTextColor    as uint32 = &hFFFFFFFFul
    CaptionColor      as uint32 = &hFF969CA6ul
    ForeColorDisabled as uint32 = &hFF606670ul
end type

' A zone of the scale. Widths are fractions of the track's, at each end (a taper).
public type TKGAUGE_RANGE
    fFrom   as float64
    fTo     as float64
    clr     as uint32
    fStartW as float32 = 1
    fEndW   as float32 = 1
end type

public type TKGAUGE_POINTER
    nKind    as int32 = TKGAUGE_PTR_NEEDLE
    fValue   as float64
    clr      as uint32                 ' 0 = the kind's colour from TKGAUGE_COLORS
    fWidth   as float32 = 1            ' x the kind's width (BAR: a fraction of the track)
    bVisible as boolean = true
end type

' Everything that decides a gauge's look, with or without a widget. Pointers and ranges are
' borrowed arrays.
public type TKGAUGE_SPEC
    nShape       as int32 = TKGAUGE_RADIAL
    nOrient      as int32 = TKGAUGE_HORIZONTAL   ' linear
    bReverse     as boolean                      ' linear: Max at the left / the bottom
    fMin         as float64 = 0
    fMax         as float64 = 100
    pPointers    as TKGAUGE_POINTER ptr
    nPointers    as int32
    pRanges      as TKGAUGE_RANGE ptr
    nRanges      as int32
    fStart       as float32 = TKGAUGE_DEFAULT_START
    fSweep       as float32 = TKGAUGE_DEFAULT_SWEEP
    fMajorStep   as float64               ' 0 = auto (1-2-5 for about nTickHint intervals)
    nTickHint    as int32 = TKGAUGE_DEFAULT_TICKHINT
    nMinorCount  as int32 = TKGAUGE_DEFAULT_MINORCOUNT
    nDecimals    as int32 = TKGAUGE_DECIMALS_AUTO
    nScale       as int32 = TKGAUGE_SCALE_INSIDE
    fTrackWidth  as float32 = TKGAUGE_DEFAULT_TRACKWIDTH   ' radial; a linear track fills what its scale leaves
    bShowFace    as boolean
    bBarOrigin   as boolean               ' FALSE: bars grow from Min
    fBarOrigin   as float64
    sCaption     as ustring
    sPrefix      as ustring
    sSuffix      as ustring
    sValueText   as ustring               ' "" = pointer 0 formatted (the widget's callback fills it)
    nValueText   as int32 = TKGAUGE_VALUE_AUTO
    nPadding     as int32 = TKGAUGE_DEFAULT_PADDING
    bEnabled     as boolean = true
    fText        as TTF_Font ptr          ' labels and caption; 0 = none drawn
    fValueFont   as TTF_Font ptr          ' 0 = fText
    fScale       as float32               ' 0 = the painter's
    pColors      as TKGAUGE_COLORS ptr    ' 0 = the app theme's
end type

' The layout: widget-local EDGE coordinates. One for the painter and the probes. A linear gauge
' is laid out on two axes: ALONG (x when horizontal, y when vertical) and ACROSS (the other).
public type GG_GEOM
    bLinear    as boolean
    bVert      as boolean
    p0         as float32           ' linear: Min's and Max's along positions (p0 > p1 when reversed / vertical)
    p1         as float32
    c0         as float32           ' linear: the track's across edges, c0 < c1 (tw = c1 - c0)
    c1         as float32
    nearSgn    as int32             ' linear: +1 when the near side is c1's (horizontal), -1 when c0's
    bTickNear  as boolean           ' linear: ticks on the near / far side (labels: near only)
    bTickFar   as boolean
    needNear   as float32           ' linear: room kept for needle triangles on that side
    needFar    as float32
    needH      as float32           ' linear: a needle triangle's height and half base
    needB      as float32
    rcFace     as TKRECT            ' linear: the face's box
    cx         as float32
    cy         as float32
    r          as float32           ' the track's outer radius
    tw         as float32           ' the track's width
    rIn        as float32           ' its inner radius
    hubR       as float32
    nw         as float32           ' the needle's half width at the hub
    fStep      as float64           ' the major step in force
    nLabDec    as int32             ' the labels' decimals
    nMajor     as int32
    majors(any) as float64
    labRc(any)  as TKRECT
    labS(any)   as ustring
    labOn(any)  as boolean
    nLabShown  as int32
    rcValue    as TKRECT            ' empty when not drawn
    sValue     as ustring
    rcCaption  as TKRECT
    fScale     as float32
end type


' ==========================================================================================
' Numbers: the 1-2-5 step, formatting
' ==========================================================================================
' 1, 2 or 5 x 10^n, near span / nIntervals.
public function tkGauge_NiceStep( byval fSpan as float64, byval nIntervals as int32 ) as float64
    if nIntervals < 1 then nIntervals = 1
    fSpan = abs( fSpan )
    if fSpan < 1e-12 then return 1
    dim as float64 raw = fSpan / nIntervals
    dim as float64 mag = 10 ^ int( log( raw ) / log( 10.0 ) )
    dim as float64 nrm = raw / mag
    if nrm <= 1.0001 then return mag
    if nrm <= 2.0001 then return 2 * mag
    if nrm <= 5.0001 then return 5 * mag
    return 10 * mag
end function

' The decimals a step needs: 0 for whole steps, else enough to show it (0.25 -> 2).
private function GgStepDecimals( byval fStep as float64 ) as int32
    for d as int32 = 0 to 6
        dim as float64 m = 10 ^ d
        if abs( fStep * m - cint( fStep * m ) ) < 1e-6 * m then return d
    next
    return 6
end function

' v with d decimals (TKGAUGE_DECIMALS_AUTO: up to 2, trailing zeros dropped). No "-0".
public function tkGauge_FormatValue( byval v as float64, byval nDecimals as int32 = TKGAUGE_DECIMALS_AUTO ) as string
    dim as int32 d = iif( nDecimals < 0, 2, nDecimals )
    if d > 9 then d = 9
    dim as int64 m = 1
    for k as int32 = 1 to d : m *= 10 : next
    dim as int64 n = clngint( v * m )
    dim as string s = iif( n < 0, "-", "" )
    n = abs( n )
    s &= str( n \ m )
    if d > 0 then
        dim as string fr = right( string( d, "0" ) & str( n mod m ), d )
        if nDecimals < 0 then
            while (len( fr ) > 0) andalso (right( fr, 1 ) = "0") : fr = left( fr, len( fr ) - 1 ) : wend
        end if
        if len( fr ) then s &= "." & fr
    end if
    return s
end function

private function GgHex( byval c as uint32 ) as string
    if (c shr 24) = 255 then return "#" & right( "000000" & hex( c and &hFFFFFFul ), 6 )
    return "#" & right( "00000000" & hex( c ), 8 )
end function

' "0..60=#2E7D32;60..85=#F9A825;85..100=#C62828": #RRGGBB (opaque) or #AARRGGBB. A malformed
' entry is skipped. Returns the count; rg() resized.
public function tkGauge_ParseRanges( byref sText as string, rg() as TKGAUGE_RANGE ) as int32
    dim as int32 n = 0
    erase rg
    dim as string t = sText & ";"
    dim as int32 a = 1
    for i as int32 = 1 to len( t )
        if mid( t, i, 1 ) <> ";" then continue for
        dim as string e = trim( mid( t, a, i - a ) )
        a = i + 1
        dim as int32 pDots = instr( e, ".." ), pEq = instr( e, "=" )
        if (pDots < 2) orelse (pEq < pDots + 3) then continue for
        dim as string sClr = trim( mid( e, pEq + 1 ) )
        if left( sClr, 1 ) <> "#" then continue for
        sClr = mid( sClr, 2 )
        if (len( sClr ) <> 6) andalso (len( sClr ) <> 8) then continue for
        dim as uint32 clr = valuint( "&h" & sClr )
        if len( sClr ) = 6 then clr or= &hFF000000ul
        redim preserve rg( 0 to n )
        rg(n).fFrom = val( left( e, pDots - 1 ) )
        rg(n).fTo = val( mid( e, pDots + 2, pEq - pDots - 2 ) )
        rg(n).clr = clr
        n += 1
    next
    return n
end function

public function tkGauge_FormatRanges( byval pRanges as TKGAUGE_RANGE ptr, byval n as int32 ) as string
    dim as string s = ""
    for i as int32 = 0 to n - 1
        if i > 0 then s &= ";"
        s &= str( pRanges[i].fFrom ) & ".." & str( pRanges[i].fTo ) & "=" & GgHex( pRanges[i].clr )
    next
    return s
end function


' ==========================================================================================
' Layout
' ==========================================================================================
private function GgClamp( byref s as TKGAUGE_SPEC, byval v as float64 ) as float64
    dim as float64 lo = s.fMin, hi = s.fMax
    if lo > hi then swap lo, hi
    if v < lo then return lo
    if v > hi then return hi
    return v
end function

' The angle of value v (clamped), degrees.
public function tkGauge_SpecValueToAngle( byref s as TKGAUGE_SPEC, byval v as float64 ) as float32
    if abs( s.fMax - s.fMin ) < 1e-12 then return s.fStart
    return s.fStart + s.fSweep * (GgClamp( s, v ) - s.fMin) / (s.fMax - s.fMin)
end function

private function GgFull( byref s as TKGAUGE_SPEC ) as boolean
    return abs( s.fSweep ) >= 359.9
end function

private function GgValueMode( byref s as TKGAUGE_SPEC ) as int32
    if s.nValueText = TKGAUGE_VALUE_NONE then return TKGAUGE_VALUE_NONE
    if s.nShape = TKGAUGE_LINEAR then return TKGAUGE_VALUE_END
    if s.nValueText = TKGAUGE_VALUE_END then return TKGAUGE_VALUE_BELOW
    if s.nValueText <> TKGAUGE_VALUE_AUTO then return s.nValueText
    return iif( abs( s.fSweep ) < 300, TKGAUGE_VALUE_BELOW, TKGAUGE_VALUE_CENTER )
end function

' Linear: the along position of value v (clamped); a collapsed scale puts everything at Min.
public function tkGauge_GeomValueToPos( byref s as TKGAUGE_SPEC, byref geo as GG_GEOM, byval v as float64 ) as float32
    if abs( s.fMax - s.fMin ) < 1e-12 then return geo.p0
    return geo.p0 + (geo.p1 - geo.p0) * (GgClamp( s, v ) - s.fMin) / (s.fMax - s.fMin)
end function

' Labels thinned to every n-th while neighbours overlap.
private sub GgThin( byref geo as GG_GEOM )
    dim as int32 stride = 1
    while stride < geo.nMajor
        dim as boolean bHit = false
        dim as int32 prev = -1
        for i as int32 = 0 to geo.nMajor - 1 step stride
            if (prev >= 0) andalso (tkRect_IsEmpty( tkRect_Intersect( geo.labRc(prev), geo.labRc(i) ) ) = false) then bHit = true : exit for
            prev = i
        next
        if bHit = false then exit while
        stride += 1
    wend
    geo.nLabShown = 0
    for i as int32 = 0 to geo.nMajor - 1
        geo.labOn(i) = ((i mod stride) = 0)
        if geo.labOn(i) then geo.nLabShown += 1
    next
end sub

' A box from along a0..a1 and across b0..b1 (either order).
private sub GgLinBox( byref geo as GG_GEOM, byref rc as TKRECT, byval a0 as float32, byval a1 as float32, byval b0 as float32, byval b1 as float32 )
    if a0 > a1 then swap a0, a1
    if b0 > b1 then swap b0, b1
    if geo.bVert then
        tkRect_Set( rc, cint( b0 ), cint( a0 ), cint( b1 ), cint( a1 ) )
    else
        tkRect_Set( rc, cint( a0 ), cint( b0 ), cint( a1 ), cint( b1 ) )
    end if
end sub

' The linear layout (from tkGauge_Layout, the majors and the label strings made).
private sub GgLayoutLinear( byref s as TKGAUGE_SPEC, byref rc as TKRECT, byref geo as GG_GEOM, byval vw as float32, _
                            byval vh as float32, byval cw as float32, byval ch as float32 )
    dim as float32 k = geo.fScale
    dim as float32 gap = TKGAUGE_TICKGAP * k, majLen = TKGAUGE_MAJORLEN * k, tgap = TKGAUGE_TEXTGAP * k
    geo.bLinear = true
    geo.bVert = (s.nOrient = TKGAUGE_VERTICAL)
    dim as boolean bv = geo.bVert
    geo.nearSgn = iif( bv, -1, 1 )
    geo.bTickNear = (s.nScale = TKGAUGE_SCALE_NEAR) orelse (s.nScale = TKGAUGE_SCALE_BOTH)
    geo.bTickFar = (s.nScale = TKGAUGE_SCALE_FAR) orelse (s.nScale = TKGAUGE_SCALE_BOTH)
    if geo.nMajor = 0 then geo.bTickNear = false : geo.bTickFar = false
    ' the labels' extents: along (centred on their tick) and across (stacked beyond it)
    dim as float32 labAlong = 0, labAcross = 0
    dim as boolean bLabels = (s.fText <> 0) andalso (geo.bTickNear orelse geo.bTickFar)
    if bLabels then
        dim as float32 lh = tkText_Height( s.fText )
        for i as int32 = 0 to geo.nMajor - 1
            dim as float32 lw = tkText_Width( s.fText, geo.labS(i) )
            dim as float32 la = iif( bv, lh, lw ), lc = iif( bv, lw, lh )
            if la > labAlong then labAlong = la
            if lc > labAcross then labAcross = lc
        next
    end if
    ' needles: a triangle beside the track, on the side without labels
    dim as float32 fwN = 0
    for i as int32 = 0 to s.nPointers - 1
        if s.pPointers[i].bVisible andalso (s.pPointers[i].nKind = TKGAUGE_PTR_NEEDLE) andalso (s.pPointers[i].fWidth > fwN) then fwN = s.pPointers[i].fWidth
    next
    geo.needH = 1.5 * TKGAUGE_NEEDLEWIDTH * k * fwN
    geo.needB = 0.75 * TKGAUGE_NEEDLEWIDTH * k * fwN
    dim as boolean bNeedNear = (geo.bTickNear = false) andalso geo.bTickFar
    if bNeedNear then geo.needNear = geo.needH else geo.needFar = geo.needH
    ' across: [low side][track][high side]; the near side is high when horizontal
    dim as float32 sideNear = geo.needNear, sideFar = geo.needFar
    if geo.bTickNear then sideNear += gap + majLen + iif( bLabels, gap + labAcross, 0 )
    if geo.bTickFar then sideFar += gap + majLen + iif( bLabels andalso (geo.bTickNear = false), gap + labAcross, 0 )
    dim as float32 m = s.nPadding * k
    tkRect_Set( geo.rcFace, cint( rc.left + m ), cint( rc.top + m ), cint( rc.right - m ), cint( rc.bottom - m ) )
    if s.bShowFace then m += 2 * k
    dim as float32 xLo = rc.left + m, xHi = rc.right - m, yLo = rc.top + m, yHi = rc.bottom - m
    dim as float32 aLo = iif( bv, yLo, xLo ), aHi = iif( bv, yHi, xHi )
    dim as float32 bLo = iif( bv, xLo, yLo ), bHi = iif( bv, xHi, yHi )
    dim as float32 lowW = iif( bv, sideNear, sideFar ), highW = iif( bv, sideFar, sideNear )
    geo.c0 = cint( bLo + lowW )
    geo.c1 = cint( bHi - highW )
    if geo.c1 - geo.c0 < 1 then geo.c1 = geo.c0 + 1
    geo.tw = geo.c1 - geo.c0
    ' along: [caption][track][value text]; the end labels and needle bases kept inside
    dim as float32 capA = iif( bv, ch, cw )
    dim as float32 valA = 0
    if vw > 0 then
        valA = iif( bv, vh, vw )
        if (bv = false) andalso (s.fValueFont <> 0 orelse s.fText <> 0) then
            ' room for the widest value the scale can show, so the track does not move with it
            dim as TTF_Font ptr fv = iif( s.fValueFont <> 0, s.fValueFont, s.fText )
            dim as float32 w0 = tkText_Width( fv, s.sPrefix & tkGauge_FormatValue( s.fMin, s.nDecimals ) & s.sSuffix )
            dim as float32 w1 = tkText_Width( fv, s.sPrefix & tkGauge_FormatValue( s.fMax, s.nDecimals ) & s.sSuffix )
            if w0 > valA then valA = w0
            if w1 > valA then valA = w1
        end if
    end if
    dim as float32 tLo = aLo + iif( capA > 0, capA + tgap, 0 ), tHi = aHi - iif( valA > 0, valA + tgap, 0 )
    dim as float32 inset = labAlong / 2
    if geo.needB > inset then inset = geo.needB
    if tLo < aLo + inset then tLo = aLo + inset
    if tHi > aHi - inset then tHi = aHi - inset
    tLo = cint( tLo ) : tHi = cint( tHi )
    if tHi - tLo < 1 then tHi = tLo + 1
    ' Min at the left (horizontal) or the bottom (vertical); Reverse flips
    dim as boolean bMinLow = not bv
    if s.bReverse then bMinLow = not bMinLow
    geo.p0 = iif( bMinLow, tLo, tHi ) : geo.p1 = iif( bMinLow, tHi, tLo )
    ' labels beyond the ticks: on the near side, or the far one for a FAR scale
    if bLabels then
        dim as float32 lh = tkText_Height( s.fText )
        dim as int32 sg = iif( geo.bTickNear, geo.nearSgn, -geo.nearSgn )
        dim as float32 edge = iif( sg > 0, geo.c1, geo.c0 )
        dim as float32 st = edge + sg * (iif( geo.bTickNear, geo.needNear, geo.needFar ) + gap + majLen + gap)
        for i as int32 = 0 to geo.nMajor - 1
            dim as float32 lw = tkText_Width( s.fText, geo.labS(i) )
            dim as float32 la = iif( bv, lh, lw ), lc = iif( bv, lw, lh )
            dim as float32 pa = tkGauge_GeomValueToPos( s, geo, geo.majors(i) )
            dim as float32 a0 = cint( pa - la / 2 )
            GgLinBox( geo, geo.labRc(i), a0, a0 + cint( la ), st, st + sg * cint( lc ) )
        next
        GgThin( geo )
    end if
    ' the caption before the track, the value text after it, centred on the track across
    dim as float32 cc = (geo.c0 + geo.c1) / 2
    if capA > 0 then
        if bv then
            dim as float32 x0 = cc - cw / 2
            if x0 < rc.left then x0 = rc.left
            if x0 + cw > rc.right then x0 = rc.right - cw
            GgLinBox( geo, geo.rcCaption, aLo, aLo + ch, cint( x0 ), cint( x0 ) + cint( cw ) )
        else
            GgLinBox( geo, geo.rcCaption, aLo, aLo + cint( cw ), cint( cc - ch / 2 ), cint( cc - ch / 2 ) + cint( ch ) )
        end if
    end if
    if valA > 0 then
        dim as float32 v0 = tHi + tgap
        if bv then
            dim as float32 x0 = cc - vw / 2
            if x0 < rc.left then x0 = rc.left
            if x0 + vw > rc.right then x0 = rc.right - vw
            GgLinBox( geo, geo.rcValue, cint( v0 ), cint( v0 ) + cint( vh ), cint( x0 ), cint( x0 ) + cint( vw ) )
        else
            GgLinBox( geo, geo.rcValue, cint( v0 ), cint( v0 ) + cint( vw ), cint( cc - vh / 2 ), cint( cc - vh / 2 ) + cint( vh ) )
        end if
    end if
end sub

' The unit arc's box (r = 1, centre 0,0) with the hub: the end points and every axis it crosses.
private sub GgArcBox( byref s as TKGAUGE_SPEC, byref x0 as float32, byref x1 as float32, byref y0 as float32, byref y1 as float32 )
    x0 = -TKGAUGE_HUBFRAC : x1 = TKGAUGE_HUBFRAC : y0 = -TKGAUGE_HUBFRAC : y1 = TKGAUGE_HUBFRAC
    dim as float64 a0 = s.fStart, a1 = s.fStart + s.fSweep
    if a0 > a1 then swap a0, a1
    dim as float64 ang(0 to 1) = { a0, a1 }
    for k as int32 = 0 to 1
        dim as float32 px = cos( ang(k) * 3.14159265358979 / 180 ), py = sin( ang(k) * 3.14159265358979 / 180 )
        if px < x0 then x0 = px
        if px > x1 then x1 = px
        if py < y0 then y0 = py
        if py > y1 then y1 = py
    next
    for q as int32 = -8 to 8
        dim as float64 aq = q * 90
        if (aq > a0) andalso (aq < a1) then
            select case ((q mod 4) + 4) mod 4
            case 0 : x1 = 1
            case 1 : y1 = 1
            case 2 : x0 = -1
            case 3 : y0 = -1
            end select
        end if
    next
end sub

public sub tkGauge_Layout( byref s as TKGAUGE_SPEC, byref rc as TKRECT, byval fScale as float32, byref geo as GG_GEOM )
    dim as GG_GEOM blank
    geo = blank
    dim as float32 k = iif( fScale > 0, fScale, 1 )
    geo.fScale = k
    dim as float64 lo = s.fMin, hi = s.fMax
    if lo > hi then swap lo, hi
    ' ---- the scale's majors ------------------------------------------------------------------
    geo.fStep = iif( s.fMajorStep > 0, s.fMajorStep, tkGauge_NiceStep( hi - lo, s.nTickHint ) )
    geo.nLabDec = iif( s.nDecimals >= 0, s.nDecimals, GgStepDecimals( geo.fStep ) )
    if (s.nScale <> TKGAUGE_SCALE_NONE) andalso (hi - lo > 1e-12) then
        dim as float64 v = int( lo / geo.fStep + 0.999999 ) * geo.fStep
        while (v <= hi + geo.fStep * 1e-6) andalso (geo.nMajor < 200)
            redim preserve geo.majors( 0 to geo.nMajor )
            geo.majors(geo.nMajor) = v
            geo.nMajor += 1
            v += geo.fStep
        wend
        ' a whole circle: Max sits on Min, so its label goes
        if GgFull( s ) andalso (geo.nMajor > 1) andalso (abs( geo.majors(geo.nMajor - 1) - hi ) < geo.fStep * 1e-6) _
           andalso (abs( geo.majors(0) - lo ) < geo.fStep * 1e-6) then geo.nMajor -= 1
    end if
    ' ---- text sizes ------------------------------------------------------------------------------
    dim as float32 gap = TKGAUGE_TICKGAP * k, majLen = TKGAUGE_MAJORLEN * k, tgap = TKGAUGE_TEXTGAP * k
    dim as float32 labMax = 0
    if geo.nMajor > 0 then
        redim geo.labRc( 0 to geo.nMajor - 1 ) : redim geo.labS( 0 to geo.nMajor - 1 ) : redim geo.labOn( 0 to geo.nMajor - 1 )
    end if
    for i as int32 = 0 to geo.nMajor - 1
        geo.labS(i) = tkGauge_FormatValue( geo.majors(i), geo.nLabDec )
        if s.fText then
            dim as float32 lw = tkText_Width( s.fText, geo.labS(i) ), lh = tkText_Height( s.fText )
            if lw > labMax then labMax = lw
            if lh > labMax then labMax = lh
        end if
    next
    dim as TTF_Font ptr fVal = iif( s.fValueFont <> 0, s.fValueFont, s.fText )
    dim as int32 vMode = GgValueMode( s )
    geo.sValue = s.sValueText
    if (len( geo.sValue ) = 0) andalso (s.nPointers > 0) andalso (s.pPointers <> 0) then
        geo.sValue = s.sPrefix & tkGauge_FormatValue( s.pPointers[0].fValue, s.nDecimals ) & s.sSuffix
    end if
    dim as float32 vh = 0, vw = 0, ch = 0, cw = 0
    if (vMode <> TKGAUGE_VALUE_NONE) andalso (fVal <> 0) andalso (len( geo.sValue ) > 0) then
        vh = tkText_Height( fVal ) : vw = tkText_Width( fVal, geo.sValue )
    end if
    if (s.fText <> 0) andalso (len( s.sCaption ) > 0) then ch = tkText_Height( s.fText ) : cw = tkText_Width( s.fText, s.sCaption )
    tkRect_SetEmpty( geo.rcValue ) : tkRect_SetEmpty( geo.rcCaption )
    if s.nShape = TKGAUGE_LINEAR then GgLayoutLinear( s, rc, geo, vw, vh, cw, ch ) : exit sub
    dim as float32 blockH = vh + iif( (vh > 0) andalso (ch > 0), tgap, 0 ) + ch
    ' ---- fit the arc ------------------------------------------------------------------------------
    geo.nw = TKGAUGE_NEEDLEWIDTH * k / 2
    dim as float32 m = s.nPadding * k
    if s.bShowFace then m += 2 * k
    if s.nScale = TKGAUGE_SCALE_OUTSIDE then m += gap + majLen + gap + labMax
    dim as float32 x0, x1, y0, y1
    GgArcBox( s, x0, x1, y0, y1 )
    dim as float32 bw = rc.right - rc.left - 2 * m, bh = rc.bottom - rc.top - 2 * m
    dim as float32 rr = bw / (x1 - x0)
    if bh / (y1 - y0) < rr then rr = bh / (y1 - y0)
    ' the text block below the hub hangs under the centre: hub + gap + block, where the hub is
    ' the larger of HUBFRAC x r and the needle's 1.6 x half width -- a constraint for each
    dim as float32 cBelow = 0
    if (vMode = TKGAUGE_VALUE_BELOW) andalso (blockH > 0) then
        cBelow = tgap + blockH
        dim as float32 r2 = (bh - cBelow) / (TKGAUGE_HUBFRAC - y0)
        if r2 < rr then rr = r2
        r2 = (bh - cBelow - geo.nw * 1.6) / (-y0)
        if (y0 < 0) andalso (r2 < rr) then rr = r2
    end if
    if rr < 1 then rr = 1
    geo.r = rr
    geo.tw = rr * s.fTrackWidth
    if geo.tw < 1 then geo.tw = 1
    geo.rIn = rr - geo.tw
    geo.hubR = rr * TKGAUGE_HUBFRAC
    if geo.hubR < geo.nw * 1.6 then geo.hubR = geo.nw * 1.6
    dim as float32 top = y0 * rr, bottom = y1 * rr
    if (cBelow > 0) andalso (geo.hubR + cBelow > bottom) then bottom = geo.hubR + cBelow
    geo.cx = rc.left + ((rc.right - rc.left) - (x1 - x0) * rr) / 2 - x0 * rr
    geo.cy = rc.top + ((rc.bottom - rc.top) - (bottom - top)) / 2 - top
    ' ---- labels: placed by their radial extent, then thinned while neighbours overlap --------------
    if s.fText then
        dim as float32 lh = tkText_Height( s.fText )
        for i as int32 = 0 to geo.nMajor - 1
            dim as float64 ang = tkGauge_SpecValueToAngle( s, geo.majors(i) ) * 3.14159265358979 / 180
            dim as float32 lw = tkText_Width( s.fText, geo.labS(i) )
            dim as float32 ext = abs( cos( ang ) ) * lw / 2 + abs( sin( ang ) ) * lh / 2
            dim as float32 rl
            if s.nScale = TKGAUGE_SCALE_OUTSIDE then rl = rr + gap + majLen + gap + ext else rl = geo.rIn - gap - majLen - gap - ext
            dim as float32 lx = geo.cx + rl * cos( ang ), ly = geo.cy + rl * sin( ang )
            tkRect_Set( geo.labRc(i), cint( lx - lw / 2 ), cint( ly - lh / 2 ), cint( lx - lw / 2 ) + cint( lw ), cint( ly - lh / 2 ) + cint( lh ) )
        next
        GgThin( geo )
        ' on a small gauge an inside label at the arc's ends can reach the hub: it goes (the hub is drawn
        ' over it, and half a "0" reads as a stray mark)
        if s.nScale <> TKGAUGE_SCALE_OUTSIDE then
            dim as TKRECT hub
            tkRect_Set( hub, cint( geo.cx - geo.hubR ), cint( geo.cy - geo.hubR ), cint( geo.cx + geo.hubR ), cint( geo.cy + geo.hubR ) )
            for i as int32 = 0 to geo.nMajor - 1
                if geo.labOn(i) andalso (tkRect_IsEmpty( tkRect_Intersect( geo.labRc(i), hub ) ) = false) then
                    geo.labOn(i) = false : geo.nLabShown -= 1
                end if
            next
        end if
    end if
    ' ---- the value text and caption ------------------------------------------------------------------
    if blockH > 0 then
        dim as float32 ty
        if vMode = TKGAUGE_VALUE_BELOW then ty = geo.cy + geo.hubR + tgap else ty = geo.cy - blockH / 2
        if vh > 0 then
            tkRect_Set( geo.rcValue, cint( geo.cx - vw / 2 ), cint( ty ), cint( geo.cx - vw / 2 ) + cint( vw ), cint( ty ) + cint( vh ) )
            ty += vh + iif( ch > 0, tgap, 0 )
        end if
        if ch > 0 then tkRect_Set( geo.rcCaption, cint( geo.cx - cw / 2 ), cint( ty ), cint( geo.cx - cw / 2 ) + cint( cw ), cint( ty ) + cint( ch ) )
    end if
end sub


' ==========================================================================================
' The painter
' ==========================================================================================
private function GgPen( byval b as TK_PAINT ptr, byval px as float32 ) as float32
    return px / iif( b->fScale > 0, b->fScale, 1 )
end function

' An arc band: centre radius rad, thickness px, stroked (GS0's mitred band; closed when whole).
private sub GgArc( byval b as TK_PAINT ptr, byref geo as GG_GEOM, byval a0 as float32, byval sweep as float32, _
                   byval rad as float32, byval thick as float32, byval clr as uint32 )
    if (abs( sweep ) < 0.01) orelse (thick <= 0) orelse (rad <= 0) then exit sub
    dim as boolean bWhole = abs( sweep ) >= 359.9
    dim as int32 n = cint( abs( sweep ) / 360 * (rad * 1.2 + 12) ) + 2
    if bWhole then n -= 1
    dim as SDL_FPoint pts(0 to n)
    for i as int32 = 0 to n
        dim as float64 a = (a0 + sweep * i / iif( bWhole, n + 1, n )) * 3.14159265358979 / 180
        pts(i).x = geo.cx + rad * cos( a ) : pts(i).y = geo.cy + rad * sin( a )
    next
    b->SetPenColor( clr )
    b->PaintPolylineF( @pts(0), n + 1, GgPen( b, thick ), bWhole, false )
end sub

' A tapered band: the outer edge on the track's outer radius, the inner one moving from w0 to w1.
private sub GgTaper( byval b as TK_PAINT ptr, byref geo as GG_GEOM, byval a0 as float32, byval sweep as float32, _
                     byval w0 as float32, byval w1 as float32, byval clr as uint32 )
    dim as int32 n = cint( abs( sweep ) / 360 * (geo.r * 1.2 + 12) ) + 2
    dim as SDL_FPoint pts(0 to 2 * n + 1)
    for i as int32 = 0 to n
        dim as float64 a = (a0 + sweep * i / n) * 3.14159265358979 / 180
        pts(i).x = geo.cx + geo.r * cos( a ) : pts(i).y = geo.cy + geo.r * sin( a )
        dim as float32 ri = geo.r - geo.tw * (w0 + (w1 - w0) * i / n)
        pts(2 * n + 1 - i).x = geo.cx + ri * cos( a ) : pts(2 * n + 1 - i).y = geo.cy + ri * sin( a )
    next
    b->SetBackColor( clr )
    b->PaintPolygonF( @pts(0), 2 * n + 2 )
end sub

' A radial segment from r0 to r1 at angle (degrees), thickness px, butt ends.
private sub GgRadial( byval b as TK_PAINT ptr, byref geo as GG_GEOM, byval angDeg as float32, byval r0 as float32, _
                      byval r1 as float32, byval thick as float32, byval clr as uint32 )
    dim as float64 a = angDeg * 3.14159265358979 / 180
    dim as SDL_FPoint pts(0 to 1)
    pts(0).x = geo.cx + r0 * cos( a ) : pts(0).y = geo.cy + r0 * sin( a )
    pts(1).x = geo.cx + r1 * cos( a ) : pts(1).y = geo.cy + r1 * sin( a )
    b->SetPenColor( clr )
    b->PaintPolylineF( @pts(0), 2, GgPen( b, thick ), false, false )
end sub

private sub GgDisc( byval b as TK_PAINT ptr, byval cx as float32, byval cy as float32, byval rad as float32, byval clr as uint32 )
    if rad <= 0 then exit sub
    ' about one segment per 1.25 px of rim: no visible facets on a big face
    dim as int32 n = cint( rad * 5 )
    if n < 24 then n = 24
    if n > 256 then n = 256
    dim as SDL_FPoint pts(0 to n - 1)
    for i as int32 = 0 to n - 1
        pts(i).x = cx + rad * cos( i * 2 * 3.14159265358979 / n ) : pts(i).y = cy + rad * sin( i * 2 * 3.14159265358979 / n )
    next
    b->SetBackColor( clr )
    b->PaintPolygonF( @pts(0), n )
end sub

private sub GgNeedle( byval b as TK_PAINT ptr, byref geo as GG_GEOM, byval angDeg as float32, byval fW as float32, byval clr as uint32 )
    dim as float64 a = angDeg * 3.14159265358979 / 180
    dim as float32 dx = cos( a ), dy = sin( a ), px = -dy, py = dx
    dim as float32 hw = geo.nw * fW, tipR = geo.r - geo.tw * 0.3, tail = geo.r * 0.12
    ' a blunt tip at least 1.5 px wide: a point thins below a pixel and fades out before it ends
    dim as float32 tw = hw * 0.15
    if tw < 0.75 then tw = 0.75
    dim as SDL_FPoint pts(0 to 5)
    pts(0).x = geo.cx + dx * tipR + px * tw : pts(0).y = geo.cy + dy * tipR + py * tw
    pts(1).x = geo.cx + px * hw : pts(1).y = geo.cy + py * hw
    pts(2).x = geo.cx - dx * tail + px * hw * 0.6 : pts(2).y = geo.cy - dy * tail + py * hw * 0.6
    pts(3).x = geo.cx - dx * tail - px * hw * 0.6 : pts(3).y = geo.cy - dy * tail - py * hw * 0.6
    pts(4).x = geo.cx - px * hw : pts(4).y = geo.cy - py * hw
    pts(5).x = geo.cx + dx * tipR - px * tw : pts(5).y = geo.cy + dy * tipR - py * tw
    b->SetBackColor( clr )
    b->PaintPolygonF( @pts(0), 6 )
end sub

private sub GgText( byval b as TK_PAINT ptr, byval f as TTF_Font ptr, byref s as ustring, byref rc as TKRECT, byval clr as uint32 )
    if (f = 0) orelse (len( s ) = 0) orelse tkRect_IsEmpty( rc ) then exit sub
    dim as TTF_Font ptr fWas = b->pFont
    dim as uint32 inkWas = b->clrFore
    b->SetFont( f )
    b->SetForeColor( clr )
    dim as TKRECT r = rc
    b->PaintText( s, @r, TK_DT_CENTER or TK_DT_VCENTER or TK_DT_NOCLIP )
    b->SetFont( fWas )
    b->SetForeColor( inkWas )
end sub

' ---- linear ----------------------------------------------------------------------------------
private sub GgLinPt( byref geo as GG_GEOM, byref pt as SDL_FPoint, byval a as float32, byval c as float32 )
    if geo.bVert then pt.x = c : pt.y = a else pt.x = a : pt.y = c
end sub

' A quad: along a0 across b0..e0, along a1 across b1..e1 (a taper when the two differ).
private sub GgLinQuad( byval b as TK_PAINT ptr, byref geo as GG_GEOM, byval a0 as float32, byval b0 as float32, byval e0 as float32, _
                       byval a1 as float32, byval b1 as float32, byval e1 as float32, byval clr as uint32 )
    if abs( a1 - a0 ) < 0.01 then exit sub
    dim as SDL_FPoint pts(0 to 3)
    GgLinPt( geo, pts(0), a0, b0 ) : GgLinPt( geo, pts(1), a1, b1 )
    GgLinPt( geo, pts(2), a1, e1 ) : GgLinPt( geo, pts(3), a0, e0 )
    b->SetBackColor( clr )
    b->PaintPolygonF( @pts(0), 4 )
end sub

' A tick across the track at along a, from across c0 to c1, butt ends. Its centre is snapped so
' its edges land on whole pixels: a 1 px tick stays one crisp pixel.
private sub GgLinTick( byval b as TK_PAINT ptr, byref geo as GG_GEOM, byval a as float32, byval c0 as float32, _
                       byval c1 as float32, byval thick as float32, byval clr as uint32 )
    a = int( a - thick / 2 + 0.5 ) + thick / 2
    dim as SDL_FPoint pts(0 to 1)
    GgLinPt( geo, pts(0), a, c0 ) : GgLinPt( geo, pts(1), a, c1 )
    b->SetPenColor( clr )
    b->PaintPolylineF( @pts(0), 2, GgPen( b, thick ), false, false )
end sub

private sub GgLinPaint( byval b as TK_PAINT ptr, byref s as TKGAUGE_SPEC, byref geo as GG_GEOM )
    dim as TKGAUGE_COLORS ptr c = s.pColors
    dim as boolean en = s.bEnabled
    dim as uint32 dis = c->ForeColorDisabled
    dim as float32 k = geo.fScale
    if s.bShowFace then
        dim as SDL_FPoint pts(0 to 3)
        pts(0).x = geo.rcFace.left : pts(0).y = geo.rcFace.top
        pts(1).x = geo.rcFace.right : pts(1).y = geo.rcFace.top
        pts(2).x = geo.rcFace.right : pts(2).y = geo.rcFace.bottom
        pts(3).x = geo.rcFace.left : pts(3).y = geo.rcFace.bottom
        b->SetBackColor( c->FaceColor )
        b->PaintPolygonF( @pts(0), 4 )
    end if
    GgLinQuad( b, geo, geo.p0, geo.c0, geo.c1, geo.p1, geo.c0, geo.c1, c->TrackColor )
    ' ranges: anchored on the scale's edge (the near one unless the scale is FAR), later on top
    dim as int32 sg = iif( s.nScale = TKGAUGE_SCALE_FAR, -geo.nearSgn, geo.nearSgn )
    dim as float32 anc = iif( sg > 0, geo.c1, geo.c0 )
    for i as int32 = 0 to s.nRanges - 1
        dim as TKGAUGE_RANGE ptr rg = @s.pRanges[i]
        dim as float32 a0 = tkGauge_GeomValueToPos( s, geo, rg->fFrom ), a1 = tkGauge_GeomValueToPos( s, geo, rg->fTo )
        dim as uint32 clr = iif( en, rg->clr, tkColor_Lerp( rg->clr, c->TrackColor, 0.7 ) )
        GgLinQuad( b, geo, a0, anc, anc - sg * geo.tw * rg->fStartW, a1, anc, anc - sg * geo.tw * rg->fEndW, clr )
    next
    ' ticks: minors, then majors, on each scale side beyond any needle room; then the labels
    if geo.nMajor > 0 then
        dim as uint32 clrTick = iif( en, c->TickColor, dis )
        dim as float32 gap = TKGAUGE_TICKGAP * k
        for side as int32 = 0 to 1
            if (side = 0) andalso (geo.bTickNear = false) then continue for
            if (side = 1) andalso (geo.bTickFar = false) then continue for
            dim as int32 sd = iif( side = 0, geo.nearSgn, -geo.nearSgn )
            dim as float32 st = iif( sd > 0, geo.c1, geo.c0 ) + sd * (iif( side = 0, geo.needNear, geo.needFar ) + gap)
            if s.nMinorCount > 0 then
                for i as int32 = 0 to geo.nMajor - 1
                    for j as int32 = 1 to s.nMinorCount
                        dim as float64 v = geo.majors(i) + geo.fStep * j / (s.nMinorCount + 1)
                        if v > iif( s.fMax > s.fMin, s.fMax, s.fMin ) + 1e-9 then exit for
                        GgLinTick( b, geo, tkGauge_GeomValueToPos( s, geo, v ), st, st + sd * TKGAUGE_MINORLEN * k, TKGAUGE_MINORTHICK * k, clrTick )
                    next
                next
            end if
            for i as int32 = 0 to geo.nMajor - 1
                GgLinTick( b, geo, tkGauge_GeomValueToPos( s, geo, geo.majors(i) ), st, st + sd * TKGAUGE_MAJORLEN * k, TKGAUGE_MAJORTHICK * k, clrTick )
            next
        next
        for i as int32 = 0 to geo.nMajor - 1
            if geo.labOn(i) then GgText( b, s.fText, geo.labS(i), geo.labRc(i), iif( en, c->LabelColor, dis ) )
        next
    end if
    ' pointers: bars, markers, needles
    dim as float32 cc = (geo.c0 + geo.c1) / 2
    dim as int32 order(0 to 2) = { TKGAUGE_PTR_BAR, TKGAUGE_PTR_MARKER, TKGAUGE_PTR_NEEDLE }
    for pass as int32 = 0 to 2
        for i as int32 = 0 to s.nPointers - 1
            dim as TKGAUGE_POINTER ptr p = @s.pPointers[i]
            if (p->bVisible = false) orelse (p->nKind <> order(pass)) then continue for
            dim as float32 pa = tkGauge_GeomValueToPos( s, geo, p->fValue )
            select case p->nKind
            case TKGAUGE_PTR_BAR
                dim as uint32 clr = iif( en, iif( p->clr <> 0, p->clr, c->BarColor ), dis )
                dim as float32 a0 = tkGauge_GeomValueToPos( s, geo, iif( s.bBarOrigin, s.fBarOrigin, s.fMin ) )
                dim as float32 hb = geo.tw * p->fWidth / 2
                GgLinQuad( b, geo, a0, cc - hb, cc + hb, pa, cc - hb, cc + hb, clr )
            case TKGAUGE_PTR_MARKER
                ' the bullet graph's target: across two thirds of the track
                dim as uint32 clr = iif( en, iif( p->clr <> 0, p->clr, c->MarkerColor ), dis )
                dim as float32 hm = geo.tw / 3
                if hm < 1.5 * k then hm = 1.5 * k
                GgLinTick( b, geo, pa, cc - hm, cc + hm, TKGAUGE_MARKERWIDTH * k * p->fWidth, clr )
            case else
                ' a triangle beside the track, its tip on the track's edge
                dim as uint32 clr = iif( en, iif( p->clr <> 0, p->clr, c->NeedleColor ), dis )
                dim as int32 sn = iif( geo.needNear > 0, geo.nearSgn, -geo.nearSgn )
                dim as float32 tip = iif( sn > 0, geo.c1, geo.c0 )
                dim as float32 hgt = 1.5 * TKGAUGE_NEEDLEWIDTH * k * p->fWidth, hb = 0.75 * TKGAUGE_NEEDLEWIDTH * k * p->fWidth
                dim as SDL_FPoint pts(0 to 2)
                GgLinPt( geo, pts(0), pa, tip )
                GgLinPt( geo, pts(1), pa + hb, tip + sn * hgt )
                GgLinPt( geo, pts(2), pa - hb, tip + sn * hgt )
                b->SetBackColor( clr )
                b->PaintPolygonF( @pts(0), 3 )
            end select
        next
    next
    GgText( b, iif( s.fValueFont <> 0, s.fValueFont, s.fText ), geo.sValue, geo.rcValue, iif( en, c->ValueTextColor, dis ) )
    GgText( b, s.fText, s.sCaption, geo.rcCaption, iif( en, c->CaptionColor, dis ) )
end sub

' The whole gauge from its layout (background not filled; the face is).
public sub tkGauge_PaintSpec( byval b as TK_PAINT ptr, byref s as TKGAUGE_SPEC, byref geo as GG_GEOM )
    if (b = 0) orelse (s.pColors = 0) then exit sub
    if geo.bLinear then GgLinPaint( b, s, geo ) : exit sub
    dim as TKGAUGE_COLORS ptr c = s.pColors
    dim as boolean en = s.bEnabled
    dim as uint32 dis = c->ForeColorDisabled
    dim as float32 k = geo.fScale
    dim as float32 sw = s.fSweep
    dim as float32 rMid = geo.r - geo.tw / 2
    if s.bShowFace then GgDisc( b, geo.cx, geo.cy, geo.r + 2 * k, c->FaceColor )
    GgArc( b, geo, s.fStart, sw, rMid, geo.tw, c->TrackColor )
    ' ranges, clamped to the scale, later on top
    for i as int32 = 0 to s.nRanges - 1
        dim as TKGAUGE_RANGE ptr rg = @s.pRanges[i]
        dim as float32 a0 = tkGauge_SpecValueToAngle( s, rg->fFrom ), a1 = tkGauge_SpecValueToAngle( s, rg->fTo )
        if abs( a1 - a0 ) < 0.01 then continue for
        dim as uint32 clr = iif( en, rg->clr, tkColor_Lerp( rg->clr, c->TrackColor, 0.7 ) )
        if abs( rg->fStartW - rg->fEndW ) < 0.001 then
            dim as float32 wr = geo.tw * rg->fStartW
            GgArc( b, geo, a0, a1 - a0, geo.r - wr / 2, wr, clr )
        else
            GgTaper( b, geo, a0, a1 - a0, rg->fStartW, rg->fEndW, clr )
        end if
    next
    ' ticks: minors between majors, then majors; inside or outside the track
    if (s.nScale <> TKGAUGE_SCALE_NONE) andalso (geo.nMajor > 0) then
        dim as uint32 clrTick = iif( en, c->TickColor, dis )
        dim as float32 gap = TKGAUGE_TICKGAP * k
        dim as float32 rT = iif( s.nScale = TKGAUGE_SCALE_OUTSIDE, geo.r + gap, geo.rIn - gap )
        dim as float32 dirn = iif( s.nScale = TKGAUGE_SCALE_OUTSIDE, 1.0, -1.0 )
        if s.nMinorCount > 0 then
            for i as int32 = 0 to geo.nMajor - 1
                dim as float64 v0 = geo.majors(i)
                for j as int32 = 1 to s.nMinorCount
                    dim as float64 v = v0 + geo.fStep * j / (s.nMinorCount + 1)
                    if v > iif( s.fMax > s.fMin, s.fMax, s.fMin ) + 1e-9 then exit for
                    GgRadial( b, geo, tkGauge_SpecValueToAngle( s, v ), rT, rT + dirn * TKGAUGE_MINORLEN * k, TKGAUGE_MINORTHICK * k, clrTick )
                next
            next
        end if
        for i as int32 = 0 to geo.nMajor - 1
            GgRadial( b, geo, tkGauge_SpecValueToAngle( s, geo.majors(i) ), rT, rT + dirn * TKGAUGE_MAJORLEN * k, TKGAUGE_MAJORTHICK * k, clrTick )
        next
        for i as int32 = 0 to geo.nMajor - 1
            if geo.labOn(i) then GgText( b, s.fText, geo.labS(i), geo.labRc(i), iif( en, c->LabelColor, dis ) )
        next
    end if
    ' pointers: bars, then markers, then needles (and the hub over them)
    dim as boolean bNeedle = false
    dim as int32 order(0 to 2) = { TKGAUGE_PTR_BAR, TKGAUGE_PTR_MARKER, TKGAUGE_PTR_NEEDLE }
    for pass as int32 = 0 to 2
        for i as int32 = 0 to s.nPointers - 1
            dim as TKGAUGE_POINTER ptr p = @s.pPointers[i]
            if (p->bVisible = false) orelse (p->nKind <> order(pass)) then continue for
            dim as float32 ang = tkGauge_SpecValueToAngle( s, p->fValue )
            select case p->nKind
            case TKGAUGE_PTR_BAR
                dim as uint32 clr = iif( en, iif( p->clr <> 0, p->clr, c->BarColor ), dis )
                dim as float32 a0 = tkGauge_SpecValueToAngle( s, iif( s.bBarOrigin, s.fBarOrigin, s.fMin ) )
                dim as float32 wb = geo.tw * p->fWidth
                GgArc( b, geo, a0, ang - a0, geo.r - geo.tw / 2, wb, clr )
            case TKGAUGE_PTR_MARKER
                dim as uint32 clr = iif( en, iif( p->clr <> 0, p->clr, c->MarkerColor ), dis )
                GgRadial( b, geo, ang, geo.rIn - 2 * k, geo.r + 2 * k, TKGAUGE_MARKERWIDTH * k * p->fWidth, clr )
            case else
                dim as uint32 clr = iif( en, iif( p->clr <> 0, p->clr, c->NeedleColor ), dis )
                GgNeedle( b, geo, ang, p->fWidth, clr )
                bNeedle = true
            end select
        next
    next
    if bNeedle then GgDisc( b, geo.cx, geo.cy, geo.hubR, iif( en, c->HubColor, dis ) )
    GgText( b, iif( s.fValueFont <> 0, s.fValueFont, s.fText ), geo.sValue, geo.rcValue, iif( en, c->ValueTextColor, dis ) )
    GgText( b, s.fText, s.sCaption, geo.rcCaption, iif( en, c->CaptionColor, dis ) )
end sub

public declare function tkGauge_ThemeColors( byref t as TKTHEME_COLORS ) as TKGAUGE_COLORS

' ---- the opts text: a report item's settings, "key=value;..." (tkReport's channel) ------------------
' A value escapes "%", ";" and "=" as %25, %3B, %3D (the barcode item's rule).
private function GgUnesc( byref s as const string ) as string
    dim as string o = ""
    dim as int32 i = 1
    while i <= len( s )
        if (mid( s, i, 1 ) = "%") andalso (i + 2 <= len( s )) then
            o &= chr( val( "&h" & mid( s, i + 1, 2 ) ) ) : i += 3
        else
            o &= mid( s, i, 1 ) : i += 1
        end if
    wend
    return o
end function

' The next "key=value" of rest (consumed); FALSE when rest is empty.
private function GgNextOpt( byref rest as string, byref k as string, byref v as string ) as boolean
    while len( rest )
        dim as int32 sc = instr( rest, ";" )
        dim as string kv = iif( sc > 0, left( rest, sc - 1 ), rest )
        rest = iif( sc > 0, mid( rest, sc + 1 ), "" )
        dim as int32 eq = instr( kv, "=" )
        if eq = 0 then continue while
        k = lcase( trim( left( kv, eq - 1 ) ) ) : v = GgUnesc( trim( mid( kv, eq + 1 ) ) )
        return true
    wend
    return false
end function

' Opts into a spec (defaults for what is absent). rg() and ptrs() hold what the spec points at; ptrs(0)
' is the value (its fValue the caller's). Keys: shape (radial linear) min max start sweep orient
' (horizontal vertical) reverse step minor hint dec scale (inside outside none both) track face
' ranges (the SetRangesText form, escaped) pointer (needle bar marker) width (pointer 0's) origin
' target (a MARKER pointer at that value) caption prefix suffix value (auto center below none end).
' FALSE for an unknown key or word; the spec then as far as it was read.
public function tkGauge_OptsToSpec( byref opts as const ustring, byref s as TKGAUGE_SPEC, rg() as TKGAUGE_RANGE, _
                                    ptrs() as TKGAUGE_POINTER ) as boolean
    dim as TKGAUGE_SPEC s0
    s = s0
    erase rg
    redim ptrs( 0 to 0 )
    dim as boolean ok = true, bShape = false, bKind = false
    dim as string rest = opts, k, v
    while GgNextOpt( rest, k, v )
        dim as string lv = lcase( v )
        select case k
        case "shape"
            bShape = true
            select case lv
            case "radial" : s.nShape = TKGAUGE_RADIAL
            case "linear" : s.nShape = TKGAUGE_LINEAR
            case else : ok = false
            end select
        case "min" : s.fMin = val( v )
        case "max" : s.fMax = val( v )
        case "start" : s.fStart = val( v )
        case "sweep" : s.fSweep = val( v )
        case "orient"
            select case lv
            case "horizontal", "h" : s.nOrient = TKGAUGE_HORIZONTAL
            case "vertical", "v" : s.nOrient = TKGAUGE_VERTICAL
            case else : ok = false
            end select
        case "reverse" : s.bReverse = (val( v ) <> 0) orelse (lv = "true")
        case "step" : s.fMajorStep = val( v )
        case "minor" : s.nMinorCount = iif( val( v ) < 0, 0, iif( val( v ) > 20, 20, val( v ) ) )   ' as the widget clamps
        case "hint" : s.nTickHint = iif( val( v ) < 1, 1, val( v ) )
        case "dec" : s.nDecimals = val( v )
        case "scale"
            select case lv
            case "inside", "near" : s.nScale = TKGAUGE_SCALE_INSIDE
            case "outside", "far" : s.nScale = TKGAUGE_SCALE_OUTSIDE
            case "none" : s.nScale = TKGAUGE_SCALE_NONE
            case "both" : s.nScale = TKGAUGE_SCALE_BOTH
            case else : ok = false
            end select
        case "track" : s.fTrackWidth = iif( val( v ) < 0.02, 0.02, iif( val( v ) > 0.5, 0.5, val( v ) ) )
        case "face" : s.bShowFace = (val( v ) <> 0) orelse (lv = "true")
        case "ranges" : tkGauge_ParseRanges( v, rg() )
        case "pointer"
            bKind = true
            select case lv
            case "needle" : ptrs(0).nKind = TKGAUGE_PTR_NEEDLE
            case "bar" : ptrs(0).nKind = TKGAUGE_PTR_BAR
            case "marker" : ptrs(0).nKind = TKGAUGE_PTR_MARKER
            case else : ok = false
            end select
        case "width" : if val( v ) > 0 then ptrs(0).fWidth = val( v )
        case "origin" : s.bBarOrigin = true : s.fBarOrigin = val( v )
        case "target"
            dim as int32 n = ubound( ptrs ) + 1
            redim preserve ptrs( 0 to n )
            ptrs(n).nKind = TKGAUGE_PTR_MARKER : ptrs(n).fValue = val( v )
        case "caption" : s.sCaption = v
        case "prefix" : s.sPrefix = v
        case "suffix" : s.sSuffix = v
        case "value"
            select case lv
            case "auto" : s.nValueText = TKGAUGE_VALUE_AUTO
            case "center" : s.nValueText = TKGAUGE_VALUE_CENTER
            case "below" : s.nValueText = TKGAUGE_VALUE_BELOW
            case "none" : s.nValueText = TKGAUGE_VALUE_NONE
            case "end" : s.nValueText = TKGAUGE_VALUE_END
            case else : ok = false
            end select
        case else : ok = false
        end select
    wend
    ' a linear gauge's value is a bar unless the opts name its pointer (as tkGauge_Create does)
    if bShape andalso (s.nShape = TKGAUGE_LINEAR) andalso (bKind = false) then ptrs(0).nKind = TKGAUGE_PTR_BAR
    if s.fMin > s.fMax then swap s.fMin, s.fMax
    s.pPointers = @ptrs(0) : s.nPointers = ubound( ptrs ) + 1
    s.nRanges = ubound( rg ) + 1
    s.pRanges = iif( s.nRanges > 0, @rg(0), cast( TKGAUGE_RANGE ptr, 0 ) )
    return ok
end function

' Widgetless: the gauge fitted into rc on any TK_PAINT. No background.
public sub tkGauge_PaintInto( byval b as TK_PAINT ptr, byref rc as TKRECT, byref s as TKGAUGE_SPEC )
    if b = 0 then exit sub
    dim as TKGAUGE_SPEC ss = s
    dim as TKGAUGE_COLORS cTheme
    if ss.pColors = 0 then
        cTheme = tkGauge_ThemeColors( tkTheme_Get() )
        ss.pColors = @cTheme
    end if
    dim as GG_GEOM geo
    tkGauge_Layout( ss, rc, iif( ss.fScale > 0, ss.fScale, iif( b->fScale > 0, b->fScale, 1.0 ) ), geo )
    tkGauge_PaintSpec( b, ss, geo )
end sub

' On a print page, in rc (points): the same painter on a canvas of TKPAGE_PXPERPT pixels per point,
' a design unit 1/96 inch (0.75 pt) as on a 96 dpi screen. Text: the spec's fonts must be page fonts;
' 0 = the page's current font (tkPage_SetFont), none set = no text. Colours: 0 = tkTheme_Light's, for
' paper. FALSE: nothing drawn.
public function tkGauge_PaintPage( byval pg as TK_PAGE ptr, byref rc as TKRECTF, byref s as TKGAUGE_SPEC ) as boolean
    dim as int32 w = cint( (rc.right - rc.left) * TKPAGE_PXPERPT ), h = cint( (rc.bottom - rc.top) * TKPAGE_PXPERPT )
    if (w <= 0) orelse (h <= 0) then return false
    dim as TK_PAINT cp
    dim as float32 k = TKPAGE_PXPERPT * 72 / 96           ' a design unit is 1/96 inch on paper
    if tkPage_BeginCanvas( pg, rc, w, h, k, cp ) = false then return false
    dim as TKGAUGE_SPEC ss = s
    ss.fScale = k
    if ss.fText = 0 then ss.fText = tkPage_GetFont( pg )
    dim as TKGAUGE_COLORS cPaper
    if ss.pColors = 0 then
        cPaper = tkGauge_ThemeColors( tkTheme_Light( ) )
        ss.pColors = @cPaper
    end if
    dim as TKRECT r
    tkRect_Set( r, 0, 0, w, h )
    tkGauge_PaintInto( @cp, r, ss )
    tkPage_EndCanvas( pg )
    return true
end function

' The colours from the theme's roles.
public function tkGauge_ThemeColors( byref t as TKTHEME_COLORS ) as TKGAUGE_COLORS
    dim as TKGAUGE_COLORS c
    c.BackColor = t.Window
    c.FaceColor = t.Surface
    c.TrackColor = t.Track
    c.TickColor = t.TextDim
    c.LabelColor = t.TextDim
    c.NeedleColor = t.Accent
    c.HubColor = t.Text
    c.BarColor = t.Accent
    c.MarkerColor = t.Warning
    c.ValueTextColor = t.TextStrong
    c.CaptionColor = t.TextDim
    c.ForeColorDisabled = t.TextDisabled
    return c
end function
