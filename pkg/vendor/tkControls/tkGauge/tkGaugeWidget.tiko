' ==========================================================================================
' Probes
' ==========================================================================================
public function tkGauge_ValueToAngle( byval hGauge as TK_WIDGET ptr, byval v as float64 ) as float32
    dim as TKGAUGE_STATE ptr p = GState( hGauge )
    if p = 0 then return 0
    return tkGauge_SpecValueToAngle( p->spec, v )
end function

' Linear: the along position (x when horizontal, y when vertical) value v is drawn at, clamped;
' radial: 0.
public function tkGauge_ValueToPos( byval hGauge as TK_WIDGET ptr, byval v as float64 ) as float32
    dim as TKGAUGE_STATE ptr p = GState( hGauge )
    if (p = 0) orelse (p->spec.nShape <> TKGAUGE_LINEAR) then return 0
    dim as TKGAUGE_SPEC s = LiveSpec( p )
    dim as GG_GEOM geo
    Geom( p, s, geo )
    return tkGauge_GeomValueToPos( s, geo, v )
end function

' The layout as painted now: centre, radii, the majors and their label boxes, the text boxes.
public sub tkGauge_GetGeom( byval hGauge as TK_WIDGET ptr, byref geo as GG_GEOM )
    dim as TKGAUGE_STATE ptr p = GState( hGauge )
    if p = 0 then exit sub
    dim as TKGAUGE_SPEC s = LiveSpec( p )
    Geom( p, s, geo )
end sub

public sub tkGauge_GetSpec( byval hGauge as TK_WIDGET ptr, byref s as TKGAUGE_SPEC )
    dim as TKGAUGE_STATE ptr p = GState( hGauge )
    if p then s = LiveSpec( p )
end sub


' ==========================================================================================
' Tooltip, colours, callbacks
' ==========================================================================================
public sub tkGauge_SetTooltipText( byval hGauge as TK_WIDGET ptr, byval Text as ustring )
    dim as TKGAUGE_STATE ptr p = GState( hGauge )
    if p then p->wszTooltip = Text
end sub

public function tkGauge_GetTooltipText( byval hGauge as TK_WIDGET ptr ) as ustring
    dim as TKGAUGE_STATE ptr p = GState( hGauge )
    if p = 0 then return ""
    return p->wszTooltip
end function

public sub tkGauge_SetTooltipCallback( byval hGauge as TK_WIDGET ptr, byval userfunc as GGE_TooltipCallbackFunc )
    dim as TKGAUGE_STATE ptr p = GState( hGauge )
    if p then p->TooltipCallback = userfunc
end sub

' Own text, then the callback, then the value text (pointer 0's target).
public function tkGauge_ResolveTooltipText( byval hGauge as TK_WIDGET ptr ) as ustring
    dim as TKGAUGE_STATE ptr p = GState( hGauge )
    if (p = 0) orelse (p->nPtr = 0) then return ""
    if len( p->wszTooltip ) then return p->wszTooltip
    if p->TooltipCallback then
        dim as ustring s = p->TooltipCallback( hGauge, p->target(0) )
        if len( s ) then return s
    end if
    return ValueText( p, p->target(0) )
end function

public function tkGauge_GetTooltipHandle( byval hGauge as TK_WIDGET ptr ) as TK_TIP ptr
    dim as TKGAUGE_STATE ptr p = GState( hGauge )
    if p = 0 then return 0
    return tkTipHost_Tip( @p->tip )
end function

public sub tkGauge_GetColors( byval hGauge as TK_WIDGET ptr, byval pColors as TKGAUGE_COLORS ptr )
    dim as TKGAUGE_STATE ptr p = GState( hGauge )
    if (p = 0) orelse (pColors = 0) then exit sub
    *pColors = p->colors
end sub

' Copies the struct and PINS it: a theme change leaves this gauge alone until UnpinColors.
public sub tkGauge_SetColors( byval hGauge as TK_WIDGET ptr, byval pColors as TKGAUGE_COLORS ptr )
    dim as TKGAUGE_STATE ptr p = GState( hGauge )
    if (p = 0) orelse (pColors = 0) then exit sub
    p->colors = *pColors
    p->bColorsPinned = true
    Refresh( p )
end sub

public sub tkGauge_ApplyTheme( byval hGauge as TK_WIDGET ptr, byref t as TKTHEME_COLORS )
    dim as TKGAUGE_STATE ptr p = GState( hGauge )
    if (p = 0) orelse p->bColorsPinned then exit sub
    dim as TKTHEME_COLORS tr = tkTheme_Styled( hGauge, t )
    p->colors = tkGauge_ThemeColors( tr )
    tkTheme_ResolveInto( hGauge, tr, cast( ulong ptr, @p->colors ), sizeof( TKGAUGE_COLORS ) \ 4, "Gauge" )
    Refresh( p )
end sub

public sub tkGauge_UnpinColors( byval hGauge as TK_WIDGET ptr )
    dim as TKGAUGE_STATE ptr p = GState( hGauge )
    if p = 0 then exit sub
    p->bColorsPinned = false
    tkGauge_ApplyTheme( hGauge, tkTheme_Of( hGauge ) )
end sub

public sub tkGauge_SetClickCallback( byval hGauge as TK_WIDGET ptr, byval usersub as GGE_ClickCallbackSub )
    dim as TKGAUGE_STATE ptr p = GState( hGauge )
    if p then p->ClickCallback = usersub
end sub

public sub tkGauge_SetValueFormatCallback( byval hGauge as TK_WIDGET ptr, byval userfunc as GGE_ValueFormatCallbackFunc )
    dim as TKGAUGE_STATE ptr p = GState( hGauge )
    if p = 0 then exit sub
    p->FormatCallback = userfunc
    Refresh( p )
end sub

public sub tkGauge_PaintDefault( byval pi as TKGAUGE_PAINTINFO ptr )
    if pi = 0 then exit sub
    dim as TKGAUGE_STATE ptr p = GState( pi->hGauge )
    if p then RenderDefault( p, pi )
end sub

public sub tkGauge_SetPaintCallback( byval hGauge as TK_WIDGET ptr, byval usersub as GGE_PaintCallbackSub )
    dim as TKGAUGE_STATE ptr p = GState( hGauge )
    if p = 0 then exit sub
    p->PaintCallback = usersub
    Refresh( p )
end sub

public sub tkGauge_SetMessageCallback( byval hGauge as TK_WIDGET ptr, byval userfunc as GGE_MessageCallbackFunc )
    dim as TKGAUGE_STATE ptr p = GState( hGauge )
    if p then p->MessageCallback = userfunc
end sub
