'
' tkRExpr -- formatting by mask, and running totals.
'
' THE MASKS are tkFormat's (the one formatter: tkReport_FormatValue, Format( ), tkMask): a number
' pattern of # 0 , . with literal text around it ("$#,##0.00", "0.0%", "#,##0 kg"); dates
' "dd/mm/yyyy" (yyyy mm dd, each once); times "hh:nn:ss"; true / false "Yes|No". Here a mask is
' parsed ONCE (RX_FMT = TKFMT) -- RD0's spike S1 measured re-reading it on every call as most of the
' cost.
#module "tkRExpr"

#import "../tkBind"
#import "../tkFormat"
#import "std/chrono"

using tkBind
using tkCalendar
using tkTimePanel
using tkFormat

function RxParseFmt( byref mask as const ustring ) as RX_FMT
    return tkFormat_Parse( mask )
end function

private function FmtDate( byval days as int64, byref mask as const ustring ) as string
    dim as int64 y, m, d
    RxCivilFromDays( days, y, m, d )
    return tkFormat_Date( y, m, d, mask )
end function

function RxFormatSlot( byref s as RX_SLOT, byref f as RX_FMT ) as ustring
    select case s.k
    case TKV_TEXT : return s.s
    case TKV_INT
        if len( f.mask ) = 0 then return str( s.i )
        return tkFormat_Number( s.i, f )
    case TKV_FLOAT : return tkFormat_Number( s.n, f )
    case TKV_BOOL : return tkFormat_Bool( s.i <> 0, f.mask, "Yes|No" )
    case TKV_DATE : return FmtDate( s.i, f.mask )
    case TKV_TIME : return tkFormat_Time( s.i, f.mask )
    end select
    return ""
end function

' A value as text by a mask: tkReport_FormatValue's masks and results.
public function tkRExpr_FormatValue( byref v as TK_VALUE, byref mask as const ustring = "", _
                                     byref boolText as const ustring = "Yes|No" ) as ustring
    if v.kind = TKV_BOOL then return tkFormat_Bool( v.b, mask, boolText )
    dim as RX_SLOT s
    RxValueToSlot( v, s )
    if (v.kind = TKV_DATE) orelse (v.kind = TKV_TIME) then
        ' an all-zero date / an unset time formats as tkReport does: from the fields as they are
        if s.k = TKV_EMPTY then
            if v.kind = TKV_DATE then return tkFormat_Date( v.d.wYear, v.d.wMonth, v.d.wDay, mask )
            return ""
        end if
    end if
    dim as RX_FMT f = RxParseFmt( mask )
    return RxFormatSlot( s, f )
end function

' ==========================================================================================
' Running totals
' ==========================================================================================
sub TKREXPR_ACC.Init( byval fn_ as int32, byval kind_ as int32 )
    fn = fn_
    kind = kind_
    Reset( )
end sub

sub TKREXPR_ACC.Reset( )
    rows = 0 : n = 0 : si = 0 : sf = 0
    best.Clear( )
end sub

sub TKREXPR_ACC.AddRow( )
    rows += 1
end sub

' A row's argument value. Empty values are counted as rows and otherwise ignored.
sub TKREXPR_ACC.Add( byref v as TK_VALUE )
    rows += 1
    if v.kind = TKV_EMPTY then exit sub
    if (v.kind = TKV_DATE) andalso (v.d.wYear = 0) then exit sub
    if (v.kind = TKV_TIME) andalso (v.t.wHour < 0) then exit sub
    n += 1
    select case fn
    case TKRX_AGG_SUM, TKRX_AGG_AVG
        if v.kind = TKV_INT then
            si += v.i
            sf += v.i
        else
            sf += v.f
        end if
    case TKRX_AGG_MIN, TKRX_AGG_MAX
        if n = 1 then
            best = v
        else
            dim as RX_SLOT a, b
            RxValueToSlot( v, a )
            RxValueToSlot( best, b )
            dim as int32 c = RxCompare( a, b )
            if ((fn = TKRX_AGG_MIN) andalso (c = -1)) orelse ((fn = TKRX_AGG_MAX) andalso (c = 1)) then best = v
        end if
    case TKRX_AGG_FIRST
        if n = 1 then best = v
    case TKRX_AGG_LAST
        best = v
    end select
end sub

sub TKREXPR_ACC.Result( byref r as TK_VALUE )
    select case fn
    case TKRX_AGG_SUM
        if kind = TKV_INT then r.SetInt( si ) else r.SetFloat( sf )
    case TKRX_AGG_AVG
        if n = 0 then r.Clear( ) else r.SetFloat( sf / n )
    case TKRX_AGG_COUNT
        r.SetInt( n )
    case TKRX_AGG_COUNTROWS, TKRX_AGG_GROUPCOUNT
        r.SetInt( rows )
    case else
        if n = 0 then r.Clear( ) else r = best
    end select
end sub

' Feeds aggregate k of x one row of ctx: its argument evaluated (or, for Count( ) / GroupCount( ),
' just the row).
public sub tkRExpr_AccAdd( byref acc as TKREXPR_ACC, byval x as TK_REXPR ptr, byval k as int32, byref ctx as TKREXPR_CTX )
    dim as TK_REXPR ptr arg = tkRExpr_AggArg( x, k )
    if arg = 0 then
        acc.AddRow( )
        exit sub
    end if
    dim as TK_VALUE v
    tkRExpr_Eval( arg, ctx, v )
    acc.Add( v )
end sub

' An accumulator ready for aggregate k of x.
public sub tkRExpr_AccInit( byref acc as TKREXPR_ACC, byval x as TK_REXPR ptr, byval k as int32 )
    dim as TK_REXPR ptr arg = tkRExpr_AggArg( x, k )
    acc.Init( tkRExpr_AggFn( x, k ), iif( arg, tkRExpr_Kind( arg ), TKV_INT ) )
end sub
