'' raylib-residue.ti -- what raylib.ti could not carry, written by hand. Against raylib 6.2's
'' raylib.h, the header raylib.ti's banner names by SHA-256. Each item is a C2T-TODO of that
'' translation that loses API; the others there -- RL_MALLOC, RL_CALLOC, RL_REALLOC and RL_FREE,
'' which choose the allocator raylib itself is BUILT with, and __declspec, part of RLAPI -- are
'' not for a program to use.
#pragma once

'' THE COLOURS (raylib.h:174-200). Each is 'CLITERAL(Color){ r, g, b, a }', a C compound
'' literal; c2t does not translate record values. Here each is a Color temporary.
#define LIGHTGRAY  type<Color>( 200, 200, 200, 255 )   '' Light Gray
#define GRAY       type<Color>( 130, 130, 130, 255 )   '' Gray
#define DARKGRAY   type<Color>( 80, 80, 80, 255 )      '' Dark Gray
#define YELLOW     type<Color>( 253, 249, 0, 255 )     '' Yellow
#define GOLD       type<Color>( 255, 203, 0, 255 )     '' Gold
#define ORANGE     type<Color>( 255, 161, 0, 255 )     '' Orange
#define PINK       type<Color>( 255, 109, 194, 255 )   '' Pink
#define RED        type<Color>( 230, 41, 55, 255 )     '' Red
#define MAROON     type<Color>( 190, 33, 55, 255 )     '' Maroon
#define GREEN      type<Color>( 0, 228, 48, 255 )      '' Green
#define LIME       type<Color>( 0, 158, 47, 255 )      '' Lime
#define DARKGREEN  type<Color>( 0, 117, 44, 255 )      '' Dark Green
#define SKYBLUE    type<Color>( 102, 191, 255, 255 )   '' Sky Blue
#define BLUE       type<Color>( 0, 121, 241, 255 )     '' Blue
#define DARKBLUE   type<Color>( 0, 82, 172, 255 )      '' Dark Blue
#define PURPLE     type<Color>( 200, 122, 255, 255 )   '' Purple
#define VIOLET     type<Color>( 135, 60, 190, 255 )    '' Violet
#define DARKPURPLE type<Color>( 112, 31, 126, 255 )    '' Dark Purple
#define BEIGE      type<Color>( 211, 176, 131, 255 )   '' Beige
#define BROWN      type<Color>( 127, 106, 79, 255 )    '' Brown
#define DARKBROWN  type<Color>( 76, 63, 47, 255 )      '' Dark Brown

#define WHITE      type<Color>( 255, 255, 255, 255 )   '' White
#define BLACK      type<Color>( 0, 0, 0, 255 )         '' Black
#define BLANK      type<Color>( 0, 0, 0, 0 )           '' Blank (Transparent)
#define MAGENTA    type<Color>( 255, 0, 255, 255 )     '' Magenta
#define RAYWHITE   type<Color>( 245, 245, 245, 255 )   '' My own White (raylib logo)
