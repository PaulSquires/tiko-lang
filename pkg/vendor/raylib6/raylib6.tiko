'' vendor/raylib6 -- raylib 6.2, the C library for games and graphics, as one import:
''
''     #import "vendor/raylib6" link dynamic        (or 'link static', or neither)
''
'' Every routine, type and constant of raylib.h is then callable as raylib documents it,
'' unqualified -- InitWindow, DrawText, RAYWHITE. The header is raylib.ti, translated from
'' raylib.h by 'tiko c2t' and committed; its banner names the C header and its SHA-256.
'' The colours -- C compound literals, 'CLITERAL(Color){ 200, 200, 200, 255 }' -- are there as
'' 'type<Color>(200, 200, 200, 255)'. It has no C2T-TODO: RL_MALLOC and its kin, which choose
'' the allocator raylib itself is built with, call malloc and the rest as raylib.h does.
''
'' raymath.h and rlgl.h are modules of their own, as they are headers of their own in C:
'' '#import "vendor/raylib6/raymath"' (Vector2Add, MatrixRotate, ...) and
'' '#import "vendor/raylib6/rlgl"' (rlPushMatrix, ...). Each brings this one with it.
''
'' THE LIBRARY: with 'link static' raylib is linked into the program, with the system
'' libraries it needs; with 'link dynamic' -- and when no '#import' says, which is this
'' package's default -- the shared library, which tiko copies beside the program: raylib.dll,
'' or libraylib.so.620 on Linux.
#module "raylib6"

'' NOT ON macOS YET (docs/tiko-macos D-M7-2): raylib there links Apple's frameworks -- Cocoa,
'' IOKit, OpenGL -- and '#foreignlib' has no way to name a framework.
#ifdef TIKO_OS_MACOS
    #error "vendor/raylib6 on macOS needs framework linking, not yet supported"
#endif

public #include once "raylib.ti"

#ifdef TIKO_LINK_STATIC
    #ifdef TIKO_OS_WINDOWS
        #foreignlib RAYLIB static "lib/raylib", _
            "system:winmm", "system:gdi32", "system:user32", "system:shell32"
    #else
        #foreignlib RAYLIB static "lib/raylib", _
            "system:GL", "system:m", "system:pthread", "system:dl", "system:rt", "system:X11"
    #endif
#else
    #foreignlib RAYLIB dynamic "lib/raylib"
#endif
