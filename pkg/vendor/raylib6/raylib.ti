''----------------------------------------------------------------------------------
'' Types and Structures Definition
''----------------------------------------------------------------------------------
'' Boolean type
#if ((0) = 0)
#if ((1 andalso (201112 >= 199901)) orelse (defined(_MSC_VER) andalso (_MSC_VER >= 1800)))
    '' <stdbool.h>: built into tiko
#elseif ((defined(bool)) = 0)
    #if defined(TIKO_OS_WINDOWS)
    type bool as int32
    enum
        false_ = 0
        true_ = 1
    end enum
    #elseif defined(TIKO_OS_LINUX)
    type bool as uint32
    enum
        false_ = 0
        true_ = 1
    end enum
    #endif
    #define RL_BOOL_TYPE
#endif
#endif

'' Vector2, 2 components
type Vector2
    x as float32            '' Vector x component
    y as float32            '' Vector y component
end type

'' Vector3, 3 components
type Vector3
    x as float32            '' Vector x component
    y as float32            '' Vector y component
    z as float32            '' Vector z component
end type

'' Vector4, 4 components
type Vector4
    x as float32            '' Vector x component
    y as float32            '' Vector y component
    z as float32            '' Vector z component
    w as float32            '' Vector w component
end type

'' Quaternion, 4 components (Vector4 alias)
type Quaternion as Vector4

'' Matrix, 4x4 components, column major, OpenGL style, right-handed
type Matrix
    m0 as float32
    m4 as float32
    m8 as float32
    m12 as float32          '' Matrix first row (4 components)
    m1 as float32
    m5 as float32
    m9 as float32
    m13 as float32          '' Matrix second row (4 components)
    m2 as float32
    m6 as float32
    m10 as float32
    m14 as float32          '' Matrix third row (4 components)
    m3 as float32
    m7 as float32
    m11 as float32
    m15 as float32          '' Matrix fourth row (4 components)
end type

'' Color, 4 components, R8G8B8A8 (32bit)
type Color
    r as uint8              '' Color red value
    g as uint8              '' Color green value
    b as uint8              '' Color blue value
    a as uint8              '' Color alpha value
end type

'' Rectangle, 4 components
type Rectangle
    x as float32            '' Rectangle top-left corner position x
    y as float32            '' Rectangle top-left corner position y
    width as float32        '' Rectangle width
    height as float32       '' Rectangle height
end type

'' Image, pixel data stored in CPU memory (RAM)
type Image
    data as any ptr         '' Image raw data
    width as int32          '' Image base width
    height as int32         '' Image base height
    mipmaps as int32        '' Mipmap levels, 1 by default
    format as int32         '' Data format (PixelFormat type)
end type

'' Texture, tex data stored in GPU memory (VRAM)
type Texture
    id as uint32            '' OpenGL texture id
    width as int32          '' Texture base width
    height as int32         '' Texture base height
    mipmaps as int32        '' Mipmap levels, 1 by default
    format as int32         '' Data format (PixelFormat type)
end type

'' Texture2D, same as Texture
type Texture2D as Texture

'' TextureCubemap, same as Texture
type TextureCubemap as Texture

'' RenderTexture, fbo for texture rendering
type RenderTexture
    id as uint32            '' OpenGL framebuffer object id
    texture as Texture      '' Color buffer attachment texture
    depth as Texture        '' Depth buffer attachment texture
end type

'' RenderTexture2D, same as RenderTexture
type RenderTexture2D as RenderTexture

'' NPatchInfo, n-patch layout info
type NPatchInfo
    source as Rectangle     '' Texture source rectangle
    left as int32           '' Left border offset
    top as int32            '' Top border offset
    right as int32          '' Right border offset
    bottom as int32         '' Bottom border offset
    layout as int32         '' Layout of the n-patch: 3x3, 1x3 or 3x1
end type

'' GlyphInfo, font characters glyphs info
type GlyphInfo
    value as int32          '' Character value (Unicode)
    offsetX as int32        '' Character offset X when drawing
    offsetY as int32        '' Character offset Y when drawing
    advanceX as int32       '' Character advance position X
    image as Image          '' Character image data
end type

'' Font, font texture and GlyphInfo array data
type Font
    baseSize as int32       '' Base size (default chars height)
    glyphCount as int32     '' Number of glyph characters
    glyphPadding as int32   '' Padding around the glyph characters
    texture as Texture2D    '' Texture atlas containing the glyphs
    recs as Rectangle ptr   '' Rectangles in texture for the glyphs
    glyphs as GlyphInfo ptr '' Glyphs info data
end type

'' Camera, defines position/orientation in 3d space
type Camera3D
    position as Vector3     '' Camera position
    target as Vector3       '' Camera target it looks-at
    up as Vector3           '' Camera up vector (rotation over its axis)
    fovy as float32         '' Camera field-of-view aperture in Y (degrees) in perspective, used as near plane height in world units in orthographic
    projection as int32     '' Camera projection: CAMERA_PERSPECTIVE or CAMERA_ORTHOGRAPHIC
end type

type Camera as Camera3D     '' Camera type fallback, defaults to Camera3D

'' Camera2D, defines position/orientation in 2d space
type Camera2D
    offset as Vector2       '' Camera offset (screen space offset from window origin, unscaled by DPI, real pixel size)
    target as Vector2       '' Camera target (world space target point that is mapped to screen space offset)
    rotation as float32     '' Camera rotation in degrees (pivots around target)
    zoom as float32         '' Camera zoom (scaling around target), must not be set to 0, set to 1.0f for no scale
end type

'' Mesh, vertex data and vao/vbo
type Mesh
    vertexCount as int32    '' Number of vertices stored in arrays
    triangleCount as int32  '' Number of triangles stored (indexed or not)

    '' Vertex attributes data
    vertices as float32 ptr '' Vertex position (XYZ - 3 components per vertex) (shader-location = 0)
    texcoords as float32 ptr       '' Vertex texture coordinates (UV - 2 components per vertex) (shader-location = 1)
    texcoords2 as float32 ptr      '' Vertex texture second coordinates (UV - 2 components per vertex) (shader-location = 5)
    normals as float32 ptr  '' Vertex normals (XYZ - 3 components per vertex) (shader-location = 2)
    tangents as float32 ptr '' Vertex tangents (XYZW - 4 components per vertex) (shader-location = 4)
    colors as uint8 ptr     '' Vertex colors (RGBA - 4 components per vertex) (shader-location = 3)
    indices as uint16 ptr    '' Vertex indices (in case vertex data comes indexed)

    '' Skin data for animation
    boneCount as int32      '' Number of bones (MAX: 256 bones)
    boneIndices as uint8 ptr    '' Vertex bone indices, up to 4 bones influence by vertex (skinning) (shader-location = 6)
    boneWeights as float32 ptr     '' Vertex bone weight, up to 4 bones influence by vertex (skinning) (shader-location = 7)

    '' Runtime animation vertex data (CPU skinning)
    '' NOTE: In case of GPU skinning, not used, pointers are NULL
    animVertices as float32 ptr    '' Animated vertex positions (after bones transformations)
    animNormals as float32 ptr     '' Animated normals (after bones transformations)

    '' OpenGL identifiers
    vaoId as uint32         '' OpenGL Vertex Array Object id
    vboId as uint32 ptr     '' OpenGL Vertex Buffer Objects id (default vertex data)
end type

'' Shader
type Shader
    id as uint32            '' Shader program id
    locs as int32 ptr       '' Shader locations array (RL_MAX_SHADER_LOCATIONS)
end type

'' MaterialMap
type MaterialMap
    texture as Texture2D    '' Material map texture
    color as Color          '' Material map color
    value as float32        '' Material map value
end type

'' Material, includes shader and maps
type Material
    shader as Shader        '' Material shader
    maps as MaterialMap ptr '' Material maps array (MAX_MATERIAL_MAPS)
    params(0 to 3) as float32        '' Material generic parameters (if required)
end type

'' Transform, vertex transformation data
type Transform
    translation as Vector3  '' Translation
    rotation as Quaternion  '' Rotation
    scale as Vector3        '' Scale
end type

'' Anim pose, an array of Transform[]
type ModelAnimPose as Transform ptr

'' Bone, skeletal animation bone
type BoneInfo
    name as zstring * 32    '' Bone name
    parent as int32         '' Bone parent
end type

'' Skeleton, animation bones hierarchy
type ModelSkeleton
    boneCount as uint32     '' Number of bones
    bones as BoneInfo ptr   '' Bones information (skeleton)
    bindPose as ModelAnimPose '' Bones base transformation (Transform[])
end type

'' Model, meshes, materials and animation data
type Model
    transform as Matrix     '' Local transform matrix

    meshCount as int32      '' Number of meshes
    materialCount as int32  '' Number of materials
    meshes as Mesh ptr      '' Meshes array
    materials as Material ptr    '' Materials array
    meshMaterial as int32 ptr      '' Mesh material number

    '' Animation data
    skeleton as ModelSkeleton '' Skeleton for animation

    '' Runtime animation data (CPU/GPU skinning)
    currentPose as ModelAnimPose '' Current animation pose (Transform[])
    boneMatrices as Matrix ptr   '' Bones animated transformation matrices
end type

'' ModelAnimation, contains a full animation sequence
type ModelAnimation
    name as zstring * 32    '' Animation name

    boneCount as uint32     '' Number of bones (per pose)
    keyframeCount as int32  '' Number of animation key frames
    keyframePoses as ModelAnimPose ptr '' Animation sequence keyframe poses [keyframe][pose]
end type

'' Ray, ray for raycasting
type Ray
    position as Vector3     '' Ray position (origin)
    direction as Vector3    '' Ray direction (normalized)
end type

'' RayCollision, ray hit information
type RayCollision
    hit as boolean          '' Did the ray hit something?
    distance as float32     '' Distance to the nearest hit
    point as Vector3        '' Point of the nearest hit
    normal as Vector3       '' Surface normal of hit
end type

'' BoundingBox
type BoundingBox
    min as Vector3          '' Minimum vertex box-corner
    max as Vector3          '' Maximum vertex box-corner
end type

'' Wave, audio wave data
type Wave
    frameCount as uint32        '' Total number of frames (considering channels)
    sampleRate as uint32        '' Frequency (samples per second)
    sampleSize as uint32        '' Bit depth (bits per sample): 8, 16, 32 (24 not supported)
    channels as uint32          '' Number of channels (1-mono, 2-stereo, ...)
    data as any ptr             '' Buffer data pointer
end type

'' Opaque structs declaration
'' NOTE: Actual structs are defined internally in raudio module
type rAudioBuffer__fwd as rAudioBuffer
type rAudioProcessor__fwd as rAudioProcessor

'' AudioStream, custom audio stream
type AudioStream
    buffer as rAudioBuffer ptr  '' Pointer to internal data used by the audio system
    processor as rAudioProcessor ptr '' Pointer to internal data processor, useful for audio effects

    sampleRate as uint32        '' Frequency (samples per second)
    sampleSize as uint32        '' Bit depth (bits per sample): 8, 16, 32 (24 not supported)
    channels as uint32          '' Number of channels (1-mono, 2-stereo, ...)
end type

'' Sound
type Sound
    stream as AudioStream       '' Audio stream
    frameCount as uint32        '' Total number of frames (considering channels)
end type

'' Music, audio stream, anything longer than ~10 seconds should be streamed
type Music
    stream as AudioStream       '' Audio stream
    frameCount as uint32        '' Total number of frames (considering channels)
    looping as boolean          '' Music looping enable

    ctxType as int32            '' Type of music context (audio filetype)
    ctxData as any ptr          '' Audio context data, depends on type
end type

'' VrDeviceInfo, Head-Mounted-Display device parameters
type VrDeviceInfo
    hResolution as int32            '' Horizontal resolution in pixels
    vResolution as int32            '' Vertical resolution in pixels
    hScreenSize as float32          '' Horizontal size in meters
    vScreenSize as float32          '' Vertical size in meters
    eyeToScreenDistance as float32  '' Distance between eye and display in meters
    lensSeparationDistance as float32   '' Lens separation distance in meters
    interpupillaryDistance as float32   '' IPD (distance between pupils) in meters
    lensDistortionValues(0 to 3) as float32  '' Lens distortion constant parameters
    chromaAbCorrection(0 to 3) as float32    '' Chromatic aberration correction parameters
end type

'' VrStereoConfig, VR stereo rendering configuration for simulator
type VrStereoConfig
    projection(0 to 1) as Matrix    '' VR projection matrices (per eye)
    viewOffset(0 to 1) as Matrix    '' VR view offset matrices (per eye)
    leftLensCenter(0 to 1) as float32        '' VR left lens center
    rightLensCenter(0 to 1) as float32       '' VR right lens center
    leftScreenCenter(0 to 1) as float32      '' VR left screen center
    rightScreenCenter(0 to 1) as float32     '' VR right screen center
    scale(0 to 1) as float32        '' VR distortion scale
    scaleIn(0 to 1) as float32      '' VR distortion scale in
end type

'' File path list
type FilePathList
    count as uint32                 '' Filepaths entries count
    paths as zstring ptr ptr        '' Filepaths entries
end type

'' Automation event
type AutomationEvent
    frame as uint32                 '' Event frame
    type as uint32                  '' Event type (AutomationEventType)
    params(0 to 3) as int32         '' Event parameters (if required)
end type

'' Automation event list
type AutomationEventList
    capacity as uint32              '' Events max entries (MAX_AUTOMATION_EVENTS)
    count as uint32                 '' Events entries count
    events as AutomationEvent ptr   '' Events entries
end type

''----------------------------------------------------------------------------------
'' Enumerators Definition
''----------------------------------------------------------------------------------
'' System/Window config flags
'' NOTE: Every bit registers one state (use it with bit masks)
'' By default all flags are set to 0
#if defined(TIKO_OS_WINDOWS)
type ConfigFlags as int32
enum
    FLAG_VSYNC_HINT = 64                    '' Set to try enabling V-Sync on GPU
    FLAG_FULLSCREEN_MODE = 2                '' Set to run program in fullscreen
    FLAG_WINDOW_RESIZABLE = 4               '' Set to allow resizable window
    FLAG_WINDOW_UNDECORATED = 8             '' Set to disable window decoration (frame and buttons)
    FLAG_WINDOW_HIDDEN = 128                '' Set to hide window
    FLAG_WINDOW_MINIMIZED = 512             '' Set to minimize window (iconify)
    FLAG_WINDOW_MAXIMIZED = 1024            '' Set to maximize window (expanded to monitor)
    FLAG_WINDOW_UNFOCUSED = 2048            '' Set to window non focused
    FLAG_WINDOW_TOPMOST = 4096              '' Set to window always on top
    FLAG_WINDOW_ALWAYS_RUN = 256            '' Set to allow windows running while minimized
    FLAG_WINDOW_TRANSPARENT = 16            '' Set to allow transparent framebuffer
    FLAG_WINDOW_HIGHDPI = 8192              '' Set to support HighDPI
    FLAG_WINDOW_MOUSE_PASSTHROUGH = 16384       '' Set to support mouse passthrough, only supported when FLAG_WINDOW_UNDECORATED
    FLAG_BORDERLESS_WINDOWED_MODE = 32768       '' Set to run program in borderless windowed mode
    FLAG_MSAA_4X_HINT = 32                  '' Set to try enabling MSAA 4X
    FLAG_INTERLACED_HINT = 65536            '' Set to try enabling interlaced video format (for V3D)
end enum
#elseif defined(TIKO_OS_LINUX)
type ConfigFlags as uint32
enum
    FLAG_VSYNC_HINT = 64                    '' Set to try enabling V-Sync on GPU
    FLAG_FULLSCREEN_MODE = 2                '' Set to run program in fullscreen
    FLAG_WINDOW_RESIZABLE = 4               '' Set to allow resizable window
    FLAG_WINDOW_UNDECORATED = 8             '' Set to disable window decoration (frame and buttons)
    FLAG_WINDOW_HIDDEN = 128                '' Set to hide window
    FLAG_WINDOW_MINIMIZED = 512             '' Set to minimize window (iconify)
    FLAG_WINDOW_MAXIMIZED = 1024            '' Set to maximize window (expanded to monitor)
    FLAG_WINDOW_UNFOCUSED = 2048            '' Set to window non focused
    FLAG_WINDOW_TOPMOST = 4096              '' Set to window always on top
    FLAG_WINDOW_ALWAYS_RUN = 256            '' Set to allow windows running while minimized
    FLAG_WINDOW_TRANSPARENT = 16            '' Set to allow transparent framebuffer
    FLAG_WINDOW_HIGHDPI = 8192              '' Set to support HighDPI
    FLAG_WINDOW_MOUSE_PASSTHROUGH = 16384       '' Set to support mouse passthrough, only supported when FLAG_WINDOW_UNDECORATED
    FLAG_BORDERLESS_WINDOWED_MODE = 32768       '' Set to run program in borderless windowed mode
    FLAG_MSAA_4X_HINT = 32                  '' Set to try enabling MSAA 4X
    FLAG_INTERLACED_HINT = 65536            '' Set to try enabling interlaced video format (for V3D)
end enum
#endif

'' Trace log level
'' NOTE: Organized by priority level
#if defined(TIKO_OS_WINDOWS)
type TraceLogLevel as int32
enum
    LOG_ALL = 0         '' Display all logs
    LOG_TRACE           '' Trace logging, intended for internal use only
    LOG_DEBUG           '' Debug logging, used for internal debugging, it should be disabled on release builds
    LOG_INFO            '' Info logging, used for program execution info
    LOG_WARNING         '' Warning logging, used on recoverable failures
    LOG_ERROR           '' Error logging, used on unrecoverable failures
    LOG_FATAL           '' Fatal logging, used to abort program: exit(EXIT_FAILURE)
    LOG_NONE            '' Disable logging
end enum
#elseif defined(TIKO_OS_LINUX)
type TraceLogLevel as uint32
enum
    LOG_ALL = 0         '' Display all logs
    LOG_TRACE           '' Trace logging, intended for internal use only
    LOG_DEBUG           '' Debug logging, used for internal debugging, it should be disabled on release builds
    LOG_INFO            '' Info logging, used for program execution info
    LOG_WARNING         '' Warning logging, used on recoverable failures
    LOG_ERROR           '' Error logging, used on unrecoverable failures
    LOG_FATAL           '' Fatal logging, used to abort program: exit(EXIT_FAILURE)
    LOG_NONE            '' Disable logging
end enum
#endif

'' Keyboard keys (US keyboard layout)
'' NOTE: Use GetKeyPressed() to allow redefining required keys for alternative layouts
#if defined(TIKO_OS_WINDOWS)
type KeyboardKey as int32
enum
    KEY_NULL = 0                    '' Key: NULL, used for no key pressed
    '' Alphanumeric keys
    KEY_APOSTROPHE = 39             '' Key: '
    KEY_COMMA = 44                  '' Key: ,
    KEY_MINUS = 45                  '' Key: -
    KEY_PERIOD = 46                 '' Key: .
    KEY_SLASH = 47                  '' Key: /
    KEY_ZERO = 48                   '' Key: 0
    KEY_ONE = 49                    '' Key: 1
    KEY_TWO = 50                    '' Key: 2
    KEY_THREE = 51                  '' Key: 3
    KEY_FOUR = 52                   '' Key: 4
    KEY_FIVE = 53                   '' Key: 5
    KEY_SIX = 54                    '' Key: 6
    KEY_SEVEN = 55                  '' Key: 7
    KEY_EIGHT = 56                  '' Key: 8
    KEY_NINE = 57                   '' Key: 9
    KEY_SEMICOLON = 59              '' Key: ;
    KEY_EQUAL = 61                  '' Key: =
    KEY_A = 65                      '' Key: A | a
    KEY_B = 66                      '' Key: B | b
    KEY_C = 67                      '' Key: C | c
    KEY_D = 68                      '' Key: D | d
    KEY_E = 69                      '' Key: E | e
    KEY_F = 70                      '' Key: F | f
    KEY_G = 71                      '' Key: G | g
    KEY_H = 72                      '' Key: H | h
    KEY_I = 73                      '' Key: I | i
    KEY_J = 74                      '' Key: J | j
    KEY_K = 75                      '' Key: K | k
    KEY_L = 76                      '' Key: L | l
    KEY_M = 77                      '' Key: M | m
    KEY_N = 78                      '' Key: N | n
    KEY_O = 79                      '' Key: O | o
    KEY_P = 80                      '' Key: P | p
    KEY_Q = 81                      '' Key: Q | q
    KEY_R = 82                      '' Key: R | r
    KEY_S = 83                      '' Key: S | s
    KEY_T = 84                      '' Key: T | t
    KEY_U = 85                      '' Key: U | u
    KEY_V = 86                      '' Key: V | v
    KEY_W = 87                      '' Key: W | w
    KEY_X = 88                      '' Key: X | x
    KEY_Y = 89                      '' Key: Y | y
    KEY_Z = 90                      '' Key: Z | z
    KEY_LEFT_BRACKET = 91           '' Key: [
    KEY_BACKSLASH = 92              '' Key: '\'
    KEY_RIGHT_BRACKET = 93          '' Key: ]
    KEY_GRAVE = 96                  '' Key: `
