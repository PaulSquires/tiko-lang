#if (defined(GRAPHICS_API_OPENGL_33) orelse defined(GRAPHICS_API_OPENGL_ES2))
'' Choose the current matrix to be transformed
declare sub rlMatrixMode( byval mode as int32 )

'' Push the current matrix into RLGL.State.stack
declare sub rlPushMatrix( )

'' Pop latest inserted matrix from RLGL.State.stack
declare sub rlPopMatrix( )

'' Reset current matrix to identity matrix
declare sub rlLoadIdentity( )

'' Multiply the current matrix by a translation matrix
declare sub rlTranslatef( byval x as float32, byval y as float32, byval z as float32 )

'' Multiply the current matrix by a rotation matrix
'' NOTE: The provided angle must be in degrees
declare sub rlRotatef( byval angle as float32, byval x as float32, byval y as float32, byval z as float32 )

'' Multiply the current matrix by a scaling matrix
declare sub rlScalef( byval x as float32, byval y as float32, byval z as float32 )

'' Multiply the current matrix by another matrix
declare sub rlMultMatrixf( byval matf as const float32 ptr )

'' Multiply the current matrix by a perspective matrix generated by parameters
declare sub rlFrustum( byval left_ as float64, byval right_ as float64, byval bottom as float64, byval top as float64, byval znear as float64, byval zfar as float64 )

'' Multiply the current matrix by an orthographic matrix generated by parameters
declare sub rlOrtho( byval left_ as float64, byval right_ as float64, byval bottom as float64, byval top as float64, byval znear as float64, byval zfar as float64 )
#endif

'' Set the viewport area (transformation from normalized device coordinates to window coordinates)
declare sub rlViewport( byval x as int32, byval y as int32, byval width_ as int32, byval height as int32 )

'' Set clip planes distances
declare sub rlSetClipPlanes( byval nearPlane as float64, byval farPlane as float64 )

'' Get cull plane distance near
declare function rlGetCullDistanceNear( ) as float64

'' Get cull plane distance far
declare function rlGetCullDistanceFar( ) as float64

''----------------------------------------------------------------------------------
'' Module Functions Definition - Vertex level operations
''----------------------------------------------------------------------------------
#if defined(GRAPHICS_API_OPENGL_11)
'' Fallback to OpenGL 1.1 function calls
''---------------------------------------
'' C2T-TODO(branch-unparsed) rlgl.h:1429 -- clang cannot parse the branch: redefinition of 'rlBegin'
'' void rlBegin(int mode)
'' {
''     switch (mode)
''     {
''         case RL_LINES: glBegin(GL_LINES); break;
''         case RL_TRIANGLES: glBegin(GL_TRIANGLES); break;
''         case RL_QUADS: glBegin(GL_QUADS); break;
''         default: break;
''     }
'' }

'' C2T-TODO(branch-unparsed) rlgl.h:1440 -- clang cannot parse the branch: redefinition of 'rlBegin'
'' void rlEnd(void) { glEnd(); }
'' void rlVertex2i(int x, int y) { glVertex2i(x, y); }
'' void rlVertex2f(float x, float y) { glVertex2f(x, y); }
'' void rlVertex3f(float x, float y, float z) { glVertex3f(x, y, z); }
'' void rlTexCoord2f(float x, float y) { glTexCoord2f(x, y); }
'' void rlNormal3f(float x, float y, float z) { glNormal3f(x, y, z); }
'' void rlColor4ub(unsigned char r, unsigned char g, unsigned char b, unsigned char a) { glColor4ub(r, g, b, a); }
'' void rlColor3f(float x, float y, float z) { glColor3f(x, y, z); }
'' void rlColor4f(float x, float y, float z, float w) { glColor4f(x, y, z, w); }
#endif
#if (defined(GRAPHICS_API_OPENGL_33) orelse defined(GRAPHICS_API_OPENGL_ES2))
'' Initialize drawing mode (how to organize vertex)
declare sub rlBegin( byval mode as int32 )

'' Finish vertex providing
declare sub rlEnd( )

'' Define one vertex (position)
'' NOTE: Vertex position data is the basic information required for drawing
declare sub rlVertex3f( byval x as float32, byval y as float32, byval z as float32 )

'' Define one vertex (position)
declare sub rlVertex2f( byval x as float32, byval y as float32 )

'' Define one vertex (position)
declare sub rlVertex2i( byval x as int32, byval y as int32 )

'' Define one vertex (texture coordinate)
'' NOTE: Texture coordinates are limited to QUADS only
declare sub rlTexCoord2f( byval x as float32, byval y as float32 )

'' Define one vertex (normal)
'' NOTE: Normals limited to TRIANGLES only?
declare sub rlNormal3f( byval x as float32, byval y as float32, byval z as float32 )

'' Define one vertex (color)
declare sub rlColor4ub( byval x as uint8, byval y as uint8, byval z as uint8, byval w as uint8 )

'' Define one vertex (color)
declare sub rlColor4f( byval r as float32, byval g as float32, byval b as float32, byval a as float32 )

'' Define one vertex (color)
declare sub rlColor3f( byval x as float32, byval y as float32, byval z as float32 )

#endif

''--------------------------------------------------------------------------------------
'' Module Functions Definition - OpenGL style functions (common to 1.1, 3.3+, ES2)
''--------------------------------------------------------------------------------------

'' Set current texture to use
declare sub rlSetTexture( byval id as uint32 )

'' Select and active a texture slot
declare sub rlActiveTextureSlot( byval slot as int32 )

'' Enable texture
declare sub rlEnableTexture( byval id as uint32 )

'' Disable texture
declare sub rlDisableTexture( )

'' Enable texture cubemap
declare sub rlEnableTextureCubemap( byval id as uint32 )

'' Disable texture cubemap
declare sub rlDisableTextureCubemap( )

'' Set texture parameters (wrap mode/filter mode)
declare sub rlTextureParameters( byval id as uint32, byval param as int32, byval value as int32 )

'' Set cubemap parameters (wrap mode/filter mode)
declare sub rlCubemapParameters( byval id as uint32, byval param as int32, byval value as int32 )

'' Enable shader program
declare sub rlEnableShader( byval id as uint32 )

'' Disable shader program
declare sub rlDisableShader( )

'' Enable rendering to texture (fbo)
declare sub rlEnableFramebuffer( byval id as uint32 )

'' return the active render texture (fbo)
declare function rlGetActiveFramebuffer( ) as uint32

'' Disable rendering to texture
declare sub rlDisableFramebuffer( )

'' Blit active framebuffer to main framebuffer
declare sub rlBlitFramebuffer( byval srcX as int32, byval srcY as int32, byval srcWidth as int32, byval srcHeight as int32, byval dstX as int32, byval dstY as int32, byval dstWidth as int32, byval dstHeight as int32, byval bufferMask as int32 )

'' Bind framebuffer object (fbo)
declare sub rlBindFramebuffer( byval target as uint32, byval framebuffer as uint32 )

'' Activate multiple draw color buffers
'' NOTE: One color buffer is always active by default
declare sub rlActiveDrawBuffers( byval count as int32 )

''----------------------------------------------------------------------------------
'' General render state configuration
''----------------------------------------------------------------------------------

'' Enable color blending
declare sub rlEnableColorBlend( )

'' Disable color blending
declare sub rlDisableColorBlend( )

'' Enable depth test
declare sub rlEnableDepthTest( )

'' Disable depth test
declare sub rlDisableDepthTest( )

'' Enable depth write
declare sub rlEnableDepthMask( )

'' Disable depth write
declare sub rlDisableDepthMask( )

'' Enable backface culling
declare sub rlEnableBackfaceCulling( )

'' Disable backface culling
declare sub rlDisableBackfaceCulling( )

'' Set color mask active for screen read/draw
declare sub rlColorMask( byval r as boolean, byval g as boolean, byval b as boolean, byval a as boolean )

'' Set face culling mode
declare sub rlSetCullFace( byval mode as int32 )

'' Enable scissor test
declare sub rlEnableScissorTest( )

'' Disable scissor test
declare sub rlDisableScissorTest( )

'' Scissor test
declare sub rlScissor( byval x as int32, byval y as int32, byval width_ as int32, byval height as int32 )

'' Enable wire mode
declare sub rlEnableWireMode( )

'' Disable wire mode
declare sub rlDisableWireMode( )

'' Enable point mode
declare sub rlEnablePointMode( )

'' Disable point mode
declare sub rlDisablePointMode( )

'' Set the line drawing width
declare sub rlSetLineWidth( byval width_ as float32 )

'' Get the line drawing width
declare function rlGetLineWidth( ) as float32

'' Set the point drawing size
declare sub rlSetPointSize( byval size as float32 )

'' Get the point drawing size
declare function rlGetPointSize( ) as float32

'' Enable line aliasing
declare sub rlEnableSmoothLines( )

'' Disable line aliasing
declare sub rlDisableSmoothLines( )

'' Enable stereo rendering
declare sub rlEnableStereoRender( )

'' Disable stereo rendering
declare sub rlDisableStereoRender( )

'' Check if stereo render is enabled
declare function rlIsStereoRenderEnabled( ) as boolean

'' Clear color buffer with color
declare sub rlClearColor( byval r as uint8, byval g as uint8, byval b as uint8, byval a as uint8 )

'' Clear used screen buffers (color and depth)
declare sub rlClearScreenBuffers( )

'' Check and log OpenGL error codes
declare sub rlCheckErrors( )

'' Set blend mode
declare sub rlSetBlendMode( byval mode as int32 )

'' Set blending mode factor and equation
declare sub rlSetBlendFactors( byval glSrcFactor as int32, byval glDstFactor as int32, byval glEquation as int32 )

'' Set blending mode factor and equation separately for RGB and alpha
declare sub rlSetBlendFactorsSeparate( byval glSrcRGB as int32, byval glDstRGB as int32, byval glSrcAlpha as int32, byval glDstAlpha as int32, byval glEqRGB as int32, byval glEqAlpha as int32 )

