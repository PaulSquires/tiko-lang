''----------------------------------------------------------------------------------
'' Types and Structures Definition
''----------------------------------------------------------------------------------
#if ((0) = 0)
#if ((1 andalso (201112 >= 199901)) orelse (defined(_MSC_VER) andalso (_MSC_VER >= 1800)))
    '' <stdbool.h>: built into tiko
#elseif ((defined(bool)) = 0)
    #if defined(TIKO_OS_WINDOWS)
    type bool as int32
    enum
        false_ = 0
        true_ = 1
    end enum
    #elseif defined(TIKO_OS_LINUX)
    type bool as uint32
    enum
        false_ = 0
        true_ = 1
    end enum
    #endif
    #define RL_BOOL_TYPE
#endif
#endif

#if ((defined(RL_MATRIX_TYPE)) = 0)
'' Matrix, 4x4 components, column major, OpenGL style, right handed
type Matrix
    m0 as float32
    m4 as float32
    m8 as float32
    m12 as float32              '' Matrix first row (4 components)
    m1 as float32
    m5 as float32
    m9 as float32
    m13 as float32              '' Matrix second row (4 components)
    m2 as float32
    m6 as float32
    m10 as float32
    m14 as float32              '' Matrix third row (4 components)
    m3 as float32
    m7 as float32
    m11 as float32
    m15 as float32              '' Matrix fourth row (4 components)
end type
#define RL_MATRIX_TYPE
#endif

'' Dynamic vertex buffers (position + texcoords + colors + indices arrays)
'' C2T-NOTE(branch) rlgl.h:386 -- an #if inside: the members are the ones this target's preprocessor keeps
type rlVertexBuffer
    elementCount as int32       '' Number of elements in the buffer (QUADS)

    vertices as float32 ptr     '' Vertex position (XYZ - 3 components per vertex) (shader-location = 0)
    texcoords as float32 ptr    '' Vertex texture coordinates (UV - 2 components per vertex) (shader-location = 1)
    normals as float32 ptr      '' Vertex normal (XYZ - 3 components per vertex) (shader-location = 2)
    colors as uint8 ptr         '' Vertex colors (RGBA - 4 components per vertex) (shader-location = 3)
    indices as uint32 ptr       '' Vertex indices (in case vertex data comes indexed) (6 indices per quad)
    vaoId as uint32             '' OpenGL Vertex Array Object id
    vboId(0 to 4) as uint32     '' OpenGL Vertex Buffer Objects id (5 types of vertex data)
end type

'' Draw call type
'' NOTE: Only texture changes register a new draw, other state-change-related elements are not
'' used at this moment (vaoId, shaderId, matrices), raylib forces a batch draw call if any
'' of those state-change happens (this is done in core module)
type rlDrawCall
    mode as int32               '' Drawing mode: LINES, TRIANGLES, QUADS
    vertexCount as int32        '' Number of vertex of the draw
    vertexAlignment as int32    '' Number of vertex required for index alignment (LINES, TRIANGLES)
    ''unsigned int vaoId;       // Vertex array id to be used on the draw -> Using RLGL.currentBatch->vertexBuffer.vaoId
    ''unsigned int shaderId;    // Shader id to be used on the draw -> Using RLGL.currentShaderId
    textureId as uint32         '' Texture id to be used on the draw -> Use to create new draw call if changes

    ''Matrix projection;        // Projection matrix for this draw -> Using RLGL.projection by default
    ''Matrix modelview;         // Modelview matrix for this draw -> Using RLGL.modelview by default
end type

'' rlRenderBatch type
type rlRenderBatch
    bufferCount as int32        '' Number of vertex buffers (multi-buffering support)
    currentBuffer as int32      '' Current buffer tracking in case of multi-buffering
    vertexBuffer as rlVertexBuffer ptr '' Dynamic buffer(s) for vertex data

    draws as rlDrawCall ptr     '' Draw calls array, depends on textureId
    drawCounter as int32        '' Draw calls counter
    currentDepth as float32     '' Current depth value for next draw
end type

'' OpenGL version
#if defined(TIKO_OS_WINDOWS)
type rlGlVersion as int32
enum
    RL_OPENGL_SOFTWARE = 0   '' Software rendering
    RL_OPENGL_11                '' OpenGL 1.1
    RL_OPENGL_21                '' OpenGL 2.1 (GLSL 120)
    RL_OPENGL_33                '' OpenGL 3.3 (GLSL 330)
    RL_OPENGL_43                '' OpenGL 4.3 (using GLSL 330)
    RL_OPENGL_ES_20             '' OpenGL ES 2.0 (GLSL 100)
    RL_OPENGL_ES_30             '' OpenGL ES 3.0 (GLSL 300 es)
end enum
#elseif defined(TIKO_OS_LINUX)
type rlGlVersion as uint32
enum
    RL_OPENGL_SOFTWARE = 0   '' Software rendering
    RL_OPENGL_11                '' OpenGL 1.1
    RL_OPENGL_21                '' OpenGL 2.1 (GLSL 120)
    RL_OPENGL_33                '' OpenGL 3.3 (GLSL 330)
    RL_OPENGL_43                '' OpenGL 4.3 (using GLSL 330)
    RL_OPENGL_ES_20             '' OpenGL ES 2.0 (GLSL 100)
    RL_OPENGL_ES_30             '' OpenGL ES 3.0 (GLSL 300 es)
end enum
#endif

'' Trace log level
'' NOTE: Organized by priority level
#if defined(TIKO_OS_WINDOWS)
type rlTraceLogLevel as int32
enum
    RL_LOG_ALL = 0              '' Display all logs
    RL_LOG_TRACE                '' Trace logging, intended for internal use only
    RL_LOG_DEBUG                '' Debug logging, used for internal debugging, it should be disabled on release builds
    RL_LOG_INFO                 '' Info logging, used for program execution info
    RL_LOG_WARNING              '' Warning logging, used on recoverable failures
    RL_LOG_ERROR                '' Error logging, used on unrecoverable failures
    RL_LOG_FATAL                '' Fatal logging, used to abort program: exit(EXIT_FAILURE)
    RL_LOG_NONE                 '' Disable logging
end enum
#elseif defined(TIKO_OS_LINUX)
type rlTraceLogLevel as uint32
enum
    RL_LOG_ALL = 0              '' Display all logs
    RL_LOG_TRACE                '' Trace logging, intended for internal use only
    RL_LOG_DEBUG                '' Debug logging, used for internal debugging, it should be disabled on release builds
    RL_LOG_INFO                 '' Info logging, used for program execution info
    RL_LOG_WARNING              '' Warning logging, used on recoverable failures
    RL_LOG_ERROR                '' Error logging, used on unrecoverable failures
    RL_LOG_FATAL                '' Fatal logging, used to abort program: exit(EXIT_FAILURE)
    RL_LOG_NONE                 '' Disable logging
end enum
#endif

'' Texture pixel formats
'' NOTE: Support depends on OpenGL version
#if defined(TIKO_OS_WINDOWS)
type rlPixelFormat as int32
enum
    RL_PIXELFORMAT_UNCOMPRESSED_GRAYSCALE = 1      '' 8 bit per pixel (no alpha)
    RL_PIXELFORMAT_UNCOMPRESSED_GRAY_ALPHA         '' 8*2 bpp (2 channels)
    RL_PIXELFORMAT_UNCOMPRESSED_R5G6B5             '' 16 bpp
    RL_PIXELFORMAT_UNCOMPRESSED_R8G8B8             '' 24 bpp
    RL_PIXELFORMAT_UNCOMPRESSED_R5G5B5A1           '' 16 bpp (1 bit alpha)
    RL_PIXELFORMAT_UNCOMPRESSED_R4G4B4A4           '' 16 bpp (4 bit alpha)
    RL_PIXELFORMAT_UNCOMPRESSED_R8G8B8A8           '' 32 bpp
    RL_PIXELFORMAT_UNCOMPRESSED_R32                '' 32 bpp (1 channel - float)
    RL_PIXELFORMAT_UNCOMPRESSED_R32G32B32          '' 32*3 bpp (3 channels - float)
    RL_PIXELFORMAT_UNCOMPRESSED_R32G32B32A32       '' 32*4 bpp (4 channels - float)
    RL_PIXELFORMAT_UNCOMPRESSED_R16                '' 16 bpp (1 channel - half float)
    RL_PIXELFORMAT_UNCOMPRESSED_R16G16B16          '' 16*3 bpp (3 channels - half float)
    RL_PIXELFORMAT_UNCOMPRESSED_R16G16B16A16       '' 16*4 bpp (4 channels - half float)
    RL_PIXELFORMAT_COMPRESSED_DXT1_RGB             '' 4 bpp (no alpha)
    RL_PIXELFORMAT_COMPRESSED_DXT1_RGBA            '' 4 bpp (1 bit alpha)
    RL_PIXELFORMAT_COMPRESSED_DXT3_RGBA            '' 8 bpp
    RL_PIXELFORMAT_COMPRESSED_DXT5_RGBA            '' 8 bpp
    RL_PIXELFORMAT_COMPRESSED_ETC1_RGB             '' 4 bpp
    RL_PIXELFORMAT_COMPRESSED_ETC2_RGB             '' 4 bpp
    RL_PIXELFORMAT_COMPRESSED_ETC2_EAC_RGBA        '' 8 bpp
    RL_PIXELFORMAT_COMPRESSED_PVRT_RGB             '' 4 bpp
    RL_PIXELFORMAT_COMPRESSED_PVRT_RGBA            '' 4 bpp
    RL_PIXELFORMAT_COMPRESSED_ASTC_4x4_RGBA        '' 8 bpp
    RL_PIXELFORMAT_COMPRESSED_ASTC_8x8_RGBA        '' 2 bpp
end enum
#elseif defined(TIKO_OS_LINUX)
type rlPixelFormat as uint32
enum
    RL_PIXELFORMAT_UNCOMPRESSED_GRAYSCALE = 1      '' 8 bit per pixel (no alpha)
    RL_PIXELFORMAT_UNCOMPRESSED_GRAY_ALPHA         '' 8*2 bpp (2 channels)
    RL_PIXELFORMAT_UNCOMPRESSED_R5G6B5             '' 16 bpp
    RL_PIXELFORMAT_UNCOMPRESSED_R8G8B8             '' 24 bpp
    RL_PIXELFORMAT_UNCOMPRESSED_R5G5B5A1           '' 16 bpp (1 bit alpha)
    RL_PIXELFORMAT_UNCOMPRESSED_R4G4B4A4           '' 16 bpp (4 bit alpha)
    RL_PIXELFORMAT_UNCOMPRESSED_R8G8B8A8           '' 32 bpp
    RL_PIXELFORMAT_UNCOMPRESSED_R32                '' 32 bpp (1 channel - float)
    RL_PIXELFORMAT_UNCOMPRESSED_R32G32B32          '' 32*3 bpp (3 channels - float)
    RL_PIXELFORMAT_UNCOMPRESSED_R32G32B32A32       '' 32*4 bpp (4 channels - float)
    RL_PIXELFORMAT_UNCOMPRESSED_R16                '' 16 bpp (1 channel - half float)
    RL_PIXELFORMAT_UNCOMPRESSED_R16G16B16          '' 16*3 bpp (3 channels - half float)
    RL_PIXELFORMAT_UNCOMPRESSED_R16G16B16A16       '' 16*4 bpp (4 channels - half float)
    RL_PIXELFORMAT_COMPRESSED_DXT1_RGB             '' 4 bpp (no alpha)
    RL_PIXELFORMAT_COMPRESSED_DXT1_RGBA            '' 4 bpp (1 bit alpha)
    RL_PIXELFORMAT_COMPRESSED_DXT3_RGBA            '' 8 bpp
    RL_PIXELFORMAT_COMPRESSED_DXT5_RGBA            '' 8 bpp
    RL_PIXELFORMAT_COMPRESSED_ETC1_RGB             '' 4 bpp
    RL_PIXELFORMAT_COMPRESSED_ETC2_RGB             '' 4 bpp
    RL_PIXELFORMAT_COMPRESSED_ETC2_EAC_RGBA        '' 8 bpp
    RL_PIXELFORMAT_COMPRESSED_PVRT_RGB             '' 4 bpp
    RL_PIXELFORMAT_COMPRESSED_PVRT_RGBA            '' 4 bpp
    RL_PIXELFORMAT_COMPRESSED_ASTC_4x4_RGBA        '' 8 bpp
    RL_PIXELFORMAT_COMPRESSED_ASTC_8x8_RGBA        '' 2 bpp
end enum
#endif

'' Texture parameters: filter mode
'' NOTE 1: Filtering considers mipmaps if available in the texture
'' NOTE 2: Filter is accordingly set for minification and magnification
#if defined(TIKO_OS_WINDOWS)
type rlTextureFilter as int32
enum
    RL_TEXTURE_FILTER_POINT = 0         '' No filter, pixel approximation
    RL_TEXTURE_FILTER_BILINEAR          '' Linear filtering
    RL_TEXTURE_FILTER_TRILINEAR         '' Trilinear filtering (linear with mipmaps)
    RL_TEXTURE_FILTER_ANISOTROPIC_4X    '' Anisotropic filtering 4x
    RL_TEXTURE_FILTER_ANISOTROPIC_8X    '' Anisotropic filtering 8x
    RL_TEXTURE_FILTER_ANISOTROPIC_16X   '' Anisotropic filtering 16x
end enum
#elseif defined(TIKO_OS_LINUX)
type rlTextureFilter as uint32
enum
    RL_TEXTURE_FILTER_POINT = 0         '' No filter, pixel approximation
    RL_TEXTURE_FILTER_BILINEAR          '' Linear filtering
    RL_TEXTURE_FILTER_TRILINEAR         '' Trilinear filtering (linear with mipmaps)
    RL_TEXTURE_FILTER_ANISOTROPIC_4X    '' Anisotropic filtering 4x
    RL_TEXTURE_FILTER_ANISOTROPIC_8X    '' Anisotropic filtering 8x
    RL_TEXTURE_FILTER_ANISOTROPIC_16X   '' Anisotropic filtering 16x
end enum
#endif

'' Color blending modes (pre-defined)
#if defined(TIKO_OS_WINDOWS)
type rlBlendMode as int32
enum
    RL_BLEND_ALPHA = 0                  '' Blend textures considering alpha (default)
    RL_BLEND_ADDITIVE                   '' Blend textures adding colors
    RL_BLEND_MULTIPLIED                 '' Blend textures multiplying colors
    RL_BLEND_ADD_COLORS                 '' Blend textures adding colors (alternative)
    RL_BLEND_SUBTRACT_COLORS            '' Blend textures subtracting colors (alternative)
    RL_BLEND_ALPHA_PREMULTIPLY          '' Blend premultiplied textures considering alpha
    RL_BLEND_CUSTOM                     '' Blend textures using custom src/dst factors (use rlSetBlendFactors())
    RL_BLEND_CUSTOM_SEPARATE            '' Blend textures using custom src/dst factors (use rlSetBlendFactorsSeparate())
end enum
#elseif defined(TIKO_OS_LINUX)
type rlBlendMode as uint32
enum
    RL_BLEND_ALPHA = 0                  '' Blend textures considering alpha (default)
    RL_BLEND_ADDITIVE                   '' Blend textures adding colors
    RL_BLEND_MULTIPLIED                 '' Blend textures multiplying colors
    RL_BLEND_ADD_COLORS                 '' Blend textures adding colors (alternative)
    RL_BLEND_SUBTRACT_COLORS            '' Blend textures subtracting colors (alternative)
    RL_BLEND_ALPHA_PREMULTIPLY          '' Blend premultiplied textures considering alpha
    RL_BLEND_CUSTOM                     '' Blend textures using custom src/dst factors (use rlSetBlendFactors())
    RL_BLEND_CUSTOM_SEPARATE            '' Blend textures using custom src/dst factors (use rlSetBlendFactorsSeparate())
end enum
#endif

