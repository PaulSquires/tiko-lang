    RL_SHADER_ATTRIB_FLOAT = 0          '' Shader attribute type: float
    RL_SHADER_ATTRIB_VEC2               '' Shader attribute type: vec2 (2 float)
    RL_SHADER_ATTRIB_VEC3               '' Shader attribute type: vec3 (3 float)
    RL_SHADER_ATTRIB_VEC4               '' Shader attribute type: vec4 (4 float)
end enum
#endif

'' Framebuffer attachment type
'' NOTE: By default up to 8 color channels defined, but it can be more
#if defined(TIKO_OS_WINDOWS)
type rlFramebufferAttachType as int32
enum
    RL_ATTACHMENT_COLOR_CHANNEL0 = 0        '' Framebuffer attachment type: color 0
    RL_ATTACHMENT_COLOR_CHANNEL1 = 1        '' Framebuffer attachment type: color 1
    RL_ATTACHMENT_COLOR_CHANNEL2 = 2        '' Framebuffer attachment type: color 2
    RL_ATTACHMENT_COLOR_CHANNEL3 = 3        '' Framebuffer attachment type: color 3
    RL_ATTACHMENT_COLOR_CHANNEL4 = 4        '' Framebuffer attachment type: color 4
    RL_ATTACHMENT_COLOR_CHANNEL5 = 5        '' Framebuffer attachment type: color 5
    RL_ATTACHMENT_COLOR_CHANNEL6 = 6        '' Framebuffer attachment type: color 6
    RL_ATTACHMENT_COLOR_CHANNEL7 = 7        '' Framebuffer attachment type: color 7
    RL_ATTACHMENT_DEPTH = 100               '' Framebuffer attachment type: depth
    RL_ATTACHMENT_STENCIL = 200             '' Framebuffer attachment type: stencil
end enum
#elseif defined(TIKO_OS_LINUX)
type rlFramebufferAttachType as uint32
enum
    RL_ATTACHMENT_COLOR_CHANNEL0 = 0        '' Framebuffer attachment type: color 0
    RL_ATTACHMENT_COLOR_CHANNEL1 = 1        '' Framebuffer attachment type: color 1
    RL_ATTACHMENT_COLOR_CHANNEL2 = 2        '' Framebuffer attachment type: color 2
    RL_ATTACHMENT_COLOR_CHANNEL3 = 3        '' Framebuffer attachment type: color 3
    RL_ATTACHMENT_COLOR_CHANNEL4 = 4        '' Framebuffer attachment type: color 4
    RL_ATTACHMENT_COLOR_CHANNEL5 = 5        '' Framebuffer attachment type: color 5
    RL_ATTACHMENT_COLOR_CHANNEL6 = 6        '' Framebuffer attachment type: color 6
    RL_ATTACHMENT_COLOR_CHANNEL7 = 7        '' Framebuffer attachment type: color 7
    RL_ATTACHMENT_DEPTH = 100               '' Framebuffer attachment type: depth
    RL_ATTACHMENT_STENCIL = 200             '' Framebuffer attachment type: stencil
end enum
#endif

'' Framebuffer texture attachment type
#if defined(TIKO_OS_WINDOWS)
type rlFramebufferAttachTextureType as int32
enum
    RL_ATTACHMENT_CUBEMAP_POSITIVE_X = 0    '' Framebuffer texture attachment type: cubemap, +X side
    RL_ATTACHMENT_CUBEMAP_NEGATIVE_X = 1    '' Framebuffer texture attachment type: cubemap, -X side
    RL_ATTACHMENT_CUBEMAP_POSITIVE_Y = 2    '' Framebuffer texture attachment type: cubemap, +Y side
    RL_ATTACHMENT_CUBEMAP_NEGATIVE_Y = 3    '' Framebuffer texture attachment type: cubemap, -Y side
    RL_ATTACHMENT_CUBEMAP_POSITIVE_Z = 4    '' Framebuffer texture attachment type: cubemap, +Z side
    RL_ATTACHMENT_CUBEMAP_NEGATIVE_Z = 5    '' Framebuffer texture attachment type: cubemap, -Z side
    RL_ATTACHMENT_TEXTURE2D = 100           '' Framebuffer texture attachment type: texture2d
    RL_ATTACHMENT_RENDERBUFFER = 200        '' Framebuffer texture attachment type: renderbuffer
end enum
#elseif defined(TIKO_OS_LINUX)
type rlFramebufferAttachTextureType as uint32
enum
    RL_ATTACHMENT_CUBEMAP_POSITIVE_X = 0    '' Framebuffer texture attachment type: cubemap, +X side
    RL_ATTACHMENT_CUBEMAP_NEGATIVE_X = 1    '' Framebuffer texture attachment type: cubemap, -X side
    RL_ATTACHMENT_CUBEMAP_POSITIVE_Y = 2    '' Framebuffer texture attachment type: cubemap, +Y side
    RL_ATTACHMENT_CUBEMAP_NEGATIVE_Y = 3    '' Framebuffer texture attachment type: cubemap, -Y side
    RL_ATTACHMENT_CUBEMAP_POSITIVE_Z = 4    '' Framebuffer texture attachment type: cubemap, +Z side
    RL_ATTACHMENT_CUBEMAP_NEGATIVE_Z = 5    '' Framebuffer texture attachment type: cubemap, -Z side
    RL_ATTACHMENT_TEXTURE2D = 100           '' Framebuffer texture attachment type: texture2d
    RL_ATTACHMENT_RENDERBUFFER = 200        '' Framebuffer texture attachment type: renderbuffer
end enum
#endif

'' Face culling mode
#if defined(TIKO_OS_WINDOWS)
type rlCullMode as int32
enum
    RL_CULL_FACE_FRONT = 0
    RL_CULL_FACE_BACK
end enum
#elseif defined(TIKO_OS_LINUX)
type rlCullMode as uint32
enum
    RL_CULL_FACE_FRONT = 0
    RL_CULL_FACE_BACK
end enum
#endif

''------------------------------------------------------------------------------------
'' Functions Declaration - Matrix operations
''------------------------------------------------------------------------------------

extern "C"

declare sub rlMatrixMode( byval mode as int32 )         '' Choose the current matrix to be transformed
declare sub rlPushMatrix( )                             '' Push the current matrix to stack
declare sub rlPopMatrix( )                              '' Pop latest inserted matrix from stack
declare sub rlLoadIdentity( )                           '' Reset current matrix to identity matrix
declare sub rlTranslatef( byval x as float32, byval y as float32, byval z as float32 )     '' Multiply the current matrix by a translation matrix
declare sub rlRotatef( byval angle as float32, byval x as float32, byval y as float32, byval z as float32 ) '' Multiply the current matrix by a rotation matrix
declare sub rlScalef( byval x as float32, byval y as float32, byval z as float32 )         '' Multiply the current matrix by a scaling matrix
declare sub rlMultMatrixf( byval matf as const float32 ptr )            '' Multiply the current matrix by another matrix
declare sub rlFrustum( byval left_ as float64, byval right_ as float64, byval bottom as float64, byval top as float64, byval znear as float64, byval zfar as float64 )
declare sub rlOrtho( byval left_ as float64, byval right_ as float64, byval bottom as float64, byval top as float64, byval znear as float64, byval zfar as float64 )
declare sub rlViewport( byval x as int32, byval y as int32, byval width_ as int32, byval height as int32 ) '' Set the viewport area
declare sub rlSetClipPlanes( byval nearPlane as float64, byval farPlane as float64 )    '' Set clip planes distances
declare function rlGetCullDistanceNear( ) as float64    '' Get cull plane distance near
declare function rlGetCullDistanceFar( ) as float64     '' Get cull plane distance far

''------------------------------------------------------------------------------------
'' Functions Declaration - Vertex level operations
''------------------------------------------------------------------------------------
declare sub rlBegin( byval mode as int32 )              '' Initialize drawing mode (how to organize vertex)
declare sub rlEnd( )                                    '' Finish vertex providing
declare sub rlVertex2i( byval x as int32, byval y as int32 )                    '' Define one vertex (position) - 2 int
declare sub rlVertex2f( byval x as float32, byval y as float32 )                '' Define one vertex (position) - 2 float
declare sub rlVertex3f( byval x as float32, byval y as float32, byval z as float32 )       '' Define one vertex (position) - 3 float
declare sub rlTexCoord2f( byval x as float32, byval y as float32 )              '' Define one vertex (texture coordinate) - 2 float
declare sub rlNormal3f( byval x as float32, byval y as float32, byval z as float32 )       '' Define one vertex (normal) - 3 float
declare sub rlColor4ub( byval r as uint8, byval g as uint8, byval b as uint8, byval a as uint8 ) '' Define one vertex (color) - 4 byte
declare sub rlColor3f( byval x as float32, byval y as float32, byval z as float32 )        '' Define one vertex (color) - 3 float
declare sub rlColor4f( byval x as float32, byval y as float32, byval z as float32, byval w as float32 ) '' Define one vertex (color) - 4 float

''------------------------------------------------------------------------------------
'' Functions Declaration - OpenGL style functions (common to 1.1, 3.3+, ES2)
'' NOTE: This functions are used to completely abstract raylib code from OpenGL layer,
'' some of them are direct wrappers over OpenGL calls, some others are custom
''------------------------------------------------------------------------------------

'' Vertex buffers state
declare function rlEnableVertexArray( byval vaoId as uint32 ) as boolean     '' Enable vertex array (VAO, if supported)
declare sub rlDisableVertexArray( )                     '' Disable vertex array (VAO, if supported)
declare sub rlEnableVertexBuffer( byval id as uint32 )  '' Enable vertex buffer (VBO)
declare sub rlDisableVertexBuffer( )                    '' Disable vertex buffer (VBO)
declare sub rlEnableVertexBufferElement( byval id as uint32 ) '' Enable vertex buffer element (VBO element)
declare sub rlDisableVertexBufferElement( )             '' Disable vertex buffer element (VBO element)
declare sub rlEnableVertexAttribute( byval index as uint32 ) '' Enable vertex attribute index
declare sub rlDisableVertexAttribute( byval index as uint32 ) '' Disable vertex attribute index
declare sub rlEnableStatePointer( byval vertexAttribType as int32, byval buffer as any ptr ) '' Enable attribute state pointer
declare sub rlDisableStatePointer( byval vertexAttribType as int32 ) '' Disable attribute state pointer

'' Textures state
declare sub rlActiveTextureSlot( byval slot as int32 )  '' Select and active a texture slot
declare sub rlEnableTexture( byval id as uint32 )       '' Enable texture
declare sub rlDisableTexture( )                         '' Disable texture
declare sub rlEnableTextureCubemap( byval id as uint32 )     '' Enable texture cubemap
declare sub rlDisableTextureCubemap( )                  '' Disable texture cubemap
declare sub rlTextureParameters( byval id as uint32, byval param as int32, byval value as int32 ) '' Set texture parameters (filter, wrap)
declare sub rlCubemapParameters( byval id as uint32, byval param as int32, byval value as int32 ) '' Set cubemap parameters (filter, wrap)

'' Shader state
declare sub rlEnableShader( byval id as uint32 )        '' Enable shader program
declare sub rlDisableShader( )                          '' Disable shader program

'' Framebuffer state
declare sub rlEnableFramebuffer( byval id as uint32 )   '' Enable render texture (fbo)
declare sub rlDisableFramebuffer( )                     '' Disable render texture (fbo), return to default framebuffer
declare function rlGetActiveFramebuffer( ) as uint32    '' Get the currently active render texture (fbo), 0 for default framebuffer
declare sub rlActiveDrawBuffers( byval count as int32 ) '' Activate multiple draw color buffers
declare sub rlBlitFramebuffer( byval srcX as int32, byval srcY as int32, byval srcWidth as int32, byval srcHeight as int32, byval dstX as int32, byval dstY as int32, byval dstWidth as int32, byval dstHeight as int32, byval bufferMask as int32 ) '' Blit active framebuffer to main framebuffer
declare sub rlBindFramebuffer( byval target as uint32, byval framebuffer as uint32 ) '' Bind framebuffer (FBO)

'' General render state
declare sub rlEnableColorBlend( )                       '' Enable color blending
declare sub rlDisableColorBlend( )                      '' Disable color blending
declare sub rlEnableDepthTest( )                        '' Enable depth test
declare sub rlDisableDepthTest( )                       '' Disable depth test
declare sub rlEnableDepthMask( )                        '' Enable depth write
declare sub rlDisableDepthMask( )                       '' Disable depth write
declare sub rlEnableBackfaceCulling( )                  '' Enable backface culling
declare sub rlDisableBackfaceCulling( )                 '' Disable backface culling
declare sub rlColorMask( byval r as boolean, byval g as boolean, byval b as boolean, byval a as boolean ) '' Color mask control
declare sub rlSetCullFace( byval mode as int32 )        '' Set face culling mode
declare sub rlEnableScissorTest( )                      '' Enable scissor test
declare sub rlDisableScissorTest( )                     '' Disable scissor test
declare sub rlScissor( byval x as int32, byval y as int32, byval width_ as int32, byval height as int32 ) '' Scissor test
declare sub rlEnablePointMode( )                        '' Enable point mode
declare sub rlDisablePointMode( )                       '' Disable point mode
declare sub rlSetPointSize( byval size as float32 )     '' Set the point drawing size
declare function rlGetPointSize( ) as float32           '' Get the point drawing size
declare sub rlEnableWireMode( )                         '' Enable wire mode
declare sub rlDisableWireMode( )                        '' Disable wire mode
declare sub rlSetLineWidth( byval width_ as float32 )   '' Set the line drawing width
declare function rlGetLineWidth( ) as float32           '' Get the line drawing width
declare sub rlEnableSmoothLines( )                      '' Enable line aliasing
declare sub rlDisableSmoothLines( )                     '' Disable line aliasing
declare sub rlEnableStereoRender( )                     '' Enable stereo rendering
declare sub rlDisableStereoRender( )                    '' Disable stereo rendering
declare function rlIsStereoRenderEnabled( ) as boolean  '' Check if stereo render is enabled

declare sub rlClearColor( byval r as uint8, byval g as uint8, byval b as uint8, byval a as uint8 ) '' Clear color buffer with color
declare sub rlClearScreenBuffers( )                     '' Clear used screen buffers (color and depth)
declare sub rlCheckErrors( )                            '' Check and log OpenGL error codes
declare sub rlSetBlendMode( byval mode as int32 )       '' Set blending mode
declare sub rlSetBlendFactors( byval glSrcFactor as int32, byval glDstFactor as int32, byval glEquation as int32 ) '' Set blending mode factor and equation (using OpenGL factors)
declare sub rlSetBlendFactorsSeparate( byval glSrcRGB as int32, byval glDstRGB as int32, byval glSrcAlpha as int32, byval glDstAlpha as int32, byval glEqRGB as int32, byval glEqAlpha as int32 ) '' Set blending mode factors and equations separately (using OpenGL factors)

''------------------------------------------------------------------------------------
'' Functions Declaration - rlgl functionality
''------------------------------------------------------------------------------------
'' rlgl initialization functions
declare sub rlglInit( byval width_ as int32, byval height as int32 )             '' Initialize rlgl (buffers, shaders, textures, states)
declare sub rlglClose( )                                '' De-initialize rlgl (buffers, shaders, textures)
declare sub rlLoadExtensions( byval loader as any ptr ) '' Load OpenGL extensions (loader function required)
declare function rlGetProcAddress( byval procName as const zstring ptr ) as any ptr     '' Get OpenGL procedure address
declare function rlGetVersion( ) as int32               '' Get current OpenGL version
declare sub rlSetFramebufferWidth( byval width_ as int32 )            '' Set current framebuffer width
declare function rlGetFramebufferWidth( ) as int32      '' Get default framebuffer width
declare sub rlSetFramebufferHeight( byval height as int32 )          '' Set current framebuffer height
declare function rlGetFramebufferHeight( ) as int32     '' Get default framebuffer height

declare function rlGetTextureIdDefault( ) as uint32     '' Get default texture id
declare function rlGetShaderIdDefault( ) as uint32      '' Get default shader id
declare function rlGetShaderLocsDefault( ) as int32 ptr '' Get default shader locations

'' Render batch management
'' NOTE: rlgl provides a default render batch to behave like OpenGL 1.1 immediate mode
'' but this render batch API is exposed in case of custom batches are required
declare function rlLoadRenderBatch( byval numBuffers as int32, byval bufferElements as int32 ) as rlRenderBatch '' Load a render batch system
declare sub rlUnloadRenderBatch( byval batch as rlRenderBatch )    '' Unload render batch system
declare sub rlDrawRenderBatch( byval batch as rlRenderBatch ptr )     '' Draw render batch data (Update->Draw->Reset)
declare sub rlSetRenderBatchActive( byval batch as rlRenderBatch ptr ) '' Set the active render batch for rlgl (NULL for default internal)
declare sub rlDrawRenderBatchActive( )                  '' Update and draw internal render batch
declare function rlCheckRenderBatchLimit( byval vCount as int32 ) as boolean         '' Check internal buffer overflow for a given number of vertex

declare sub rlSetTexture( byval id as uint32 )          '' Set current texture for render batch and check buffers limits

''------------------------------------------------------------------------------------------------------------------------

'' Vertex buffers management
declare function rlLoadVertexArray( ) as uint32         '' Load vertex array (vao) if supported
declare function rlLoadVertexBuffer( byval buffer as const any ptr, byval size as int32, byval dynamic_ as boolean ) as uint32 '' Load a vertex buffer object
declare function rlLoadVertexBufferElement( byval buffer as const any ptr, byval size as int32, byval dynamic_ as boolean ) as uint32 '' Load vertex buffer elements object
declare sub rlUpdateVertexBuffer( byval bufferId as uint32, byval data_ as const any ptr, byval dataSize as int32, byval offset as int32 ) '' Update vertex buffer object data on GPU buffer
declare sub rlUpdateVertexBufferElements( byval id as uint32, byval data_ as const any ptr, byval dataSize as int32, byval offset as int32 ) '' Update vertex buffer elements data on GPU buffer
declare sub rlUnloadVertexArray( byval vaoId as uint32 )     '' Unload vertex array (vao)
declare sub rlUnloadVertexBuffer( byval vboId as uint32 )    '' Unload vertex buffer object
declare sub rlSetVertexAttribute( byval index as uint32, byval compSize as int32, byval type_ as int32, byval normalized as boolean, byval stride as int32, byval offset as int32 ) '' Set vertex attribute data configuration
declare sub rlSetVertexAttributeDivisor( byval index as uint32, byval divisor as int32 ) '' Set vertex attribute data divisor
declare sub rlSetVertexAttributeDefault( byval locIndex as int32, byval value as const any ptr, byval attribType as int32, byval count as int32 ) '' Set vertex attribute default value, when attribute to provided
declare sub rlDrawVertexArray( byval offset as int32, byval count as int32 )    '' Draw vertex array (currently active vao)
declare sub rlDrawVertexArrayElements( byval offset as int32, byval count as int32, byval buffer as const any ptr ) '' Draw vertex array elements
declare sub rlDrawVertexArrayInstanced( byval offset as int32, byval count as int32, byval instances as int32 ) '' Draw vertex array (currently active vao) with instancing
declare sub rlDrawVertexArrayElementsInstanced( byval offset as int32, byval count as int32, byval buffer as const any ptr, byval instances as int32 ) '' Draw vertex array elements with instancing

'' Textures management
declare function rlLoadTexture( byval data_ as const any ptr, byval width_ as int32, byval height as int32, byval format as int32, byval mipmapCount as int32 ) as uint32 '' Load texture data
declare function rlLoadTextureDepth( byval width_ as int32, byval height as int32, byval useRenderBuffer as boolean ) as uint32 '' Load depth texture/renderbuffer (to be attached to fbo)
declare function rlLoadTextureCubemap( byval data_ as const any ptr, byval size as int32, byval format as int32, byval mipmapCount as int32 ) as uint32 '' Load texture cubemap data
declare sub rlUpdateTexture( byval id as uint32, byval offsetX as int32, byval offsetY as int32, byval width_ as int32, byval height as int32, byval format as int32, byval data_ as const any ptr ) '' Update texture with new data on GPU
declare sub rlGetGlTextureFormats( byval format as int32, byval glInternalFormat as uint32 ptr, byval glFormat as uint32 ptr, byval glType as uint32 ptr ) '' Get OpenGL internal formats
declare function rlGetPixelFormatName( byval format as uint32 ) as const zstring ptr              '' Get name string for pixel format
declare sub rlUnloadTexture( byval id as uint32 )                         '' Unload texture from GPU memory
declare sub rlGenTextureMipmaps( byval id as uint32, byval width_ as int32, byval height as int32, byval format as int32, byval mipmaps as int32 ptr ) '' Generate mipmap data for selected texture
declare function rlReadTexturePixels( byval id as uint32, byval width_ as int32, byval height as int32, byval format as int32 ) as any ptr '' Read texture pixel data
declare function rlReadScreenPixels( byval width_ as int32, byval height as int32 ) as uint8 ptr           '' Read screen pixel data (color buffer)

'' Framebuffer management (fbo)
declare function rlLoadFramebuffer( ) as uint32                           '' Load an empty framebuffer
declare sub rlFramebufferAttach( byval id as uint32, byval texId as uint32, byval attachType as int32, byval texType as int32, byval mipLevel as int32 ) '' Attach texture/renderbuffer to a framebuffer
declare function rlFramebufferComplete( byval id as uint32 ) as boolean   '' Verify framebuffer is complete
declare sub rlUnloadFramebuffer( byval id as uint32 )                     '' Delete framebuffer from GPU
'' WARNING: Copy and resize framebuffer functionality only defined for software backend
declare sub rlCopyFramebuffer( byval x as int32, byval y as int32, byval width_ as int32, byval height as int32, byval format as int32, byval pixels as any ptr ) '' Copy framebuffer pixel data to internal buffer
declare sub rlResizeFramebuffer( byval width_ as int32, byval height as int32 )                    '' Resize internal framebuffer

'' Shaders management
declare function rlLoadShader( byval code as const zstring ptr, byval type_ as int32 ) as uint32                    '' Load (compile) shader and return shader id (type: RL_VERTEX_SHADER, RL_FRAGMENT_SHADER, RL_COMPUTE_SHADER)
declare function rlLoadShaderProgram( byval vsCode as const zstring ptr, byval fsCode as const zstring ptr ) as uint32 '' Load shader from code strings
declare function rlLoadShaderProgramEx( byval vsId as uint32, byval fsId as uint32 ) as uint32 '' Load shader program, using already loaded shader ids
declare function rlLoadShaderProgramCompute( byval csId as uint32 ) as uint32   '' Load compute shader program
declare sub rlUnloadShader( byval id as uint32 )                                '' Unload shader, loaded with rlLoadShader()
declare sub rlUnloadShaderProgram( byval id as uint32 )                         '' Unload shader program
declare function rlGetLocationUniform( byval id as uint32, byval uniformName as const zstring ptr ) as int32       '' Get shader location uniform, requires shader program id
declare function rlGetLocationAttrib( byval id as uint32, byval attribName as const zstring ptr ) as int32         '' Get shader location attribute, requires shader program id
declare sub rlSetUniform( byval locIndex as int32, byval value as const any ptr, byval uniformType as int32, byval count as int32 ) '' Set shader value uniform
declare sub rlSetUniformMatrix( byval locIndex as int32, byval mat as Matrix )  '' Set shader value matrix
declare sub rlSetUniformMatrices( byval locIndex as int32, byval mat as const Matrix ptr, byval count as int32 )    '' Set shader value matrices
declare sub rlSetUniformSampler( byval locIndex as int32, byval textureId as uint32 )           '' Set shader value sampler
declare sub rlSetShader( byval id as uint32, byval locs as int32 ptr )          '' Set shader currently active (id and locations)

'' Compute shader management
declare sub rlComputeShaderDispatch( byval groupX as uint32, byval groupY as uint32, byval groupZ as uint32 ) '' Dispatch compute shader (equivalent to *draw* for graphics pipeline)

'' Shader buffer storage object management (ssbo)
declare function rlLoadShaderBuffer( byval size as uint32, byval data_ as const any ptr, byval usageHint as int32 ) as uint32 '' Load shader storage buffer object (SSBO)
declare sub rlUnloadShaderBuffer( byval ssboId as uint32 )                      '' Unload shader storage buffer object (SSBO)
declare sub rlUpdateShaderBuffer( byval id as uint32, byval data_ as const any ptr, byval dataSize as uint32, byval offset as uint32 ) '' Update SSBO buffer data
declare sub rlBindShaderBuffer( byval id as uint32, byval index as uint32 )     '' Bind SSBO buffer
declare sub rlReadShaderBuffer( byval id as uint32, byval dest as any ptr, byval count as uint32, byval offset as uint32 ) '' Read SSBO buffer data (GPU->CPU)
declare sub rlCopyShaderBuffer( byval destId as uint32, byval srcId as uint32, byval destOffset as uint32, byval srcOffset as uint32, byval count as uint32 ) '' Copy SSBO data between buffers
declare function rlGetShaderBufferSize( byval id as uint32 ) as uint32          '' Get SSBO buffer size

'' Buffer management
declare sub rlBindImageTexture( byval id as uint32, byval index as uint32, byval format as int32, byval readonly as boolean )  '' Bind image texture

'' Matrix state management
declare function rlGetMatrixModelview( ) as Matrix                        '' Get internal modelview matrix
declare function rlGetMatrixProjection( ) as Matrix                       '' Get internal projection matrix
declare function rlGetMatrixTransform( ) as Matrix                        '' Get internal accumulated transform matrix
declare function rlGetMatrixProjectionStereo( byval eye as int32 ) as Matrix                        '' Get internal projection matrix for stereo render (selected eye)
declare function rlGetMatrixViewOffsetStereo( byval eye as int32 ) as Matrix                        '' Get internal view offset matrix for stereo render (selected eye)
declare sub rlSetMatrixProjection( byval proj as Matrix )                 '' Set a custom projection matrix (replaces internal projection matrix)
declare sub rlSetMatrixModelview( byval view_ as Matrix )                 '' Set a custom modelview matrix (replaces internal modelview matrix)
declare sub rlSetMatrixProjectionStereo( byval right_ as Matrix, byval left_ as Matrix )        '' Set eyes projection matrices for stereo rendering
declare sub rlSetMatrixViewOffsetStereo( byval right_ as Matrix, byval left_ as Matrix )        '' Set eyes view offsets matrices for stereo rendering

'' Quick and dirty cube/quad buffers load->draw->unload
declare sub rlLoadDrawCube( )        '' Load and draw a cube
declare sub rlLoadDrawQuad( )        '' Load and draw a quad

end extern

#endif '' RLGL_H

/'**********************************************************************************
*
*   RLGL IMPLEMENTATION
*
***********************************************************************************'/

#if defined(RLGL_IMPLEMENTATION)

'' Expose OpenGL functions from glad in raylib
#if defined(BUILD_LIBTYPE_SHARED)
    #define GLAD_API_CALL_EXPORT
    #define GLAD_API_CALL_EXPORT_BUILD
#endif

#if defined(GRAPHICS_API_OPENGL_11)
    #if defined(GRAPHICS_API_OPENGL_SOFTWARE)
        #define RLSW_IMPLEMENTATION
        #define SW_MALLOC(sz) RL_MALLOC((sz))
        #define SW_CALLOC(n, sz) RL_CALLOC((n), (sz))
        #define SW_REALLOC(ptr, newSz) RL_REALLOC((ptr), (newSz))
        #define SW_FREE(ptr) RL_FREE((ptr))
        #include once "external/rlsw.ti"      '' OpenGL 1.1 software implementation
    #else
        #if 0
            '' C2T-TODO(system-header) rlgl.h:853 -- <OpenGL/gl.h> has no tiko counterpart in c2t's table
''             #include <OpenGL/gl.h>      // OpenGL 1.1 library for OSX
            '' C2T-TODO(system-header) rlgl.h:854 -- <OpenGL/glext.h> has no tiko counterpart in c2t's table
''             #include <OpenGL/glext.h>   // OpenGL extensions library
        #else
            '' APIENTRY for OpenGL function pointer declarations is required
            #if ((defined(APIENTRY)) = 0)
                #if defined(TIKO_OS_WINDOWS)
                    '' C2T-TODO(macro) rlgl.h:859 -- 'APIENTRY': '__stdcall' is nothing tiko declares
''                     #define APIENTRY __stdcall
                #else
                    #define APIENTRY
                #endif
            #endif
            '' WINGDIAPI definition. Some Windows OpenGL headers need it
            #if (((defined(WINGDIAPI)) = 0) andalso defined(TIKO_OS_WINDOWS))
                '' C2T-TODO(macro) rlgl.h:866 -- 'WINGDIAPI': '__declspec()' is nothing tiko declares
''                 #define WINGDIAPI __declspec(dllimport)
            #endif

            '' C2T-TODO(system-header) rlgl.h:869 -- <GL/gl.h> has no tiko counterpart in c2t's table
''             #include <GL/gl.h>          // OpenGL 1.1 library
        #endif
    #endif
#endif

#if defined(GRAPHICS_API_OPENGL_33)
    #define GLAD_MALLOC RL_MALLOC
    #define GLAD_FREE RL_FREE

    #define GLAD_GL_IMPLEMENTATION
    #include once "external/glad.ti"    '' GLAD extensions loading library, includes OpenGL headers
#endif

#if defined(GRAPHICS_API_OPENGL_ES3)
    '' C2T-TODO(system-header) rlgl.h:883 -- <GLES3/gl3.h> has no tiko counterpart in c2t's table
''     #include <GLES3/gl3.h>              // OpenGL ES 3.0 library
    #define GL_GLEXT_PROTOTYPES
    '' C2T-TODO(system-header) rlgl.h:885 -- <GLES2/gl2ext.h> has no tiko counterpart in c2t's table
''     #include <GLES2/gl2ext.h>           // OpenGL ES 2.0 extensions library
#elseif defined(GRAPHICS_API_OPENGL_ES2)
    '' NOTE: OpenGL ES 2.0 can be enabled on Desktop platforms,
    '' in that case, functions are loaded from a custom glad for OpenGL ES 2.0
    '' TODO: rlgl OpenGL ES 2.0 selection shouldn't depend on raylib platform macros, a specific GLAD shouldn't be neither required
    #if (defined(PLATFORM_DESKTOP_GLFW) orelse defined(PLATFORM_DESKTOP_SDL))
        #define GLAD_GLES2_IMPLEMENTATION
        #include once "external/glad_gles2.ti"
    #else
        #define GL_GLEXT_PROTOTYPES
        ''#include <EGL/egl.h>          // EGL library -> not required, platform layer
        '' C2T-TODO(system-header) rlgl.h:896 -- <GLES2/gl2.h> has no tiko counterpart in c2t's table
''         #include <GLES2/gl2.h>          // OpenGL ES 2.0 library
        '' C2T-TODO(system-header) rlgl.h:897 -- <GLES2/gl2ext.h> has no tiko counterpart in c2t's table
''         #include <GLES2/gl2ext.h>       // OpenGL ES 2.0 extensions library
    #endif

    '' It seems OpenGL ES 2.0 instancing entry points are not defined on Raspberry Pi
    '' provided headers (despite being defined in official Khronos GLES2 headers)
    '' TODO: Avoid raylib platform-dependent code on rlgl, it should be a completely portable library
    #if defined(PLATFORM_DRM)           '' Use CONFIG_DRM?
    '' C2T-TODO(refused-type) rlgl.h:904 -- typedef 'PFNGLDRAWARRAYSINSTANCEDEXTPROC_2': 'GLenum' is a system header's type
''     typedef void (GL_APIENTRYP PFNGLDRAWARRAYSINSTANCEDEXTPROC) (GLenum mode, GLint start, GLsizei count, GLsizei primcount);
    '' C2T-TODO(refused-type) rlgl.h:905 -- typedef 'PFNGLDRAWELEMENTSINSTANCEDEXTPROC_2': 'GLenum' is a system header's type
''     typedef void (GL_APIENTRYP PFNGLDRAWELEMENTSINSTANCEDEXTPROC) (GLenum mode, GLsizei count, GLenum type, const void *indices, GLsizei primcount);
    '' C2T-TODO(refused-type) rlgl.h:906 -- typedef 'PFNGLVERTEXATTRIBDIVISOREXTPROC_2': 'GLuint' is a system header's type
''     typedef void (GL_APIENTRYP PFNGLVERTEXATTRIBDIVISOREXTPROC) (GLuint index, GLuint divisor);
    #endif
#endif

