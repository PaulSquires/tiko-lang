''         // GL_KHR_texture_compression_astc_hdr
''         case 0x93B0: return "GL_COMPRESSED_RGBA_ASTC_4x4_KHR"; break;
''         case 0x93B1: return "GL_COMPRESSED_RGBA_ASTC_5x4_KHR"; break;
