''----------------------------------------------------------------------------------
'' Module Functions Definition - rlgl functionality
''----------------------------------------------------------------------------------

'' Initialize rlgl: OpenGL extensions, default buffers/shaders/textures, OpenGL states
declare sub rlglInit( byval width_ as int32, byval height as int32 )

'' Vertex Buffer Object deinitialization (memory free)
declare sub rlglClose( )

'' Load OpenGL extensions
'' NOTE: External loader function must be provided
declare sub rlLoadExtensions( byval loader as any ptr )

'' Get OpenGL procedure address
declare function rlGetProcAddress( byval procName as const zstring ptr ) as any ptr

'' Get current OpenGL version
declare function rlGetVersion( ) as int32

'' Set current framebuffer width
declare sub rlSetFramebufferWidth( byval width_ as int32 )

'' Set current framebuffer height
declare sub rlSetFramebufferHeight( byval height as int32 )

'' Get default framebuffer width
declare function rlGetFramebufferWidth( ) as int32

'' Get default framebuffer height
declare function rlGetFramebufferHeight( ) as int32

'' Get default internal texture (white texture)
'' NOTE: Default texture is a 1x1 pixel UNCOMPRESSED_R8G8B8A8
declare function rlGetTextureIdDefault( ) as uint32

'' Get default shader id
declare function rlGetShaderIdDefault( ) as uint32

'' Get default shader locs
declare function rlGetShaderLocsDefault( ) as int32 ptr

'' Render batch management
''------------------------------------------------------------------------------------------------
'' Load render batch
declare function rlLoadRenderBatch( byval numBuffers as int32, byval bufferElements as int32 ) as rlRenderBatch

'' Unload default internal buffers vertex data from CPU and GPU
declare sub rlUnloadRenderBatch( byval batch as rlRenderBatch )

'' Draw render batch
'' NOTE: Batch is reseted and current buffer is updated (for multi-buffer config)
declare sub rlDrawRenderBatch( byval batch as rlRenderBatch ptr )

'' Set the active render batch for rlgl
declare sub rlSetRenderBatchActive( byval batch as rlRenderBatch ptr )

'' Update and draw internal render batch
declare sub rlDrawRenderBatchActive( )

'' Check internal buffer overflow for a given number of vertex
'' and force a rlRenderBatch draw call if required
declare function rlCheckRenderBatchLimit( byval vCount as int32 ) as boolean

'' Textures data management
''-----------------------------------------------------------------------------------------
'' Convert image data to OpenGL texture (returns OpenGL valid Id)
declare function rlLoadTexture( byval data_ as const any ptr, byval width_ as int32, byval height as int32, byval format as int32, byval mipmapCount as int32 ) as uint32

'' Load depth texture/renderbuffer (to be attached to fbo)
'' WARNING: OpenGL ES 2.0 requires GL_OES_depth_texture and WebGL requires WEBGL_depth_texture extensions
declare function rlLoadTextureDepth( byval width_ as int32, byval height as int32, byval useRenderBuffer as boolean ) as uint32

'' Load texture cubemap
'' NOTE: Cubemap data is expected to be 6 images in a single data array (one after the other),
'' expected the following convention: +X, -X, +Y, -Y, +Z, -Z
declare function rlLoadTextureCubemap( byval data_ as const any ptr, byval size as int32, byval format as int32, byval mipmapCount as int32 ) as uint32

'' Update already loaded texture in GPU with new data
'' WARNING: Not possible to know safely if internal texture format is the expected one...
declare sub rlUpdateTexture( byval id as uint32, byval offsetX as int32, byval offsetY as int32, byval width_ as int32, byval height as int32, byval format as int32, byval data_ as const any ptr )

'' Get OpenGL internal formats and data type from raylib PixelFormat
declare sub rlGetGlTextureFormats( byval format as int32, byval glInternalFormat as uint32 ptr, byval glFormat as uint32 ptr, byval glType as uint32 ptr )

'' Unload texture from GPU memory
declare sub rlUnloadTexture( byval id as uint32 )

'' Generate mipmap data for selected texture
'' NOTE: Only supports GPU mipmap generation
declare sub rlGenTextureMipmaps( byval id as uint32, byval width_ as int32, byval height as int32, byval format as int32, byval mipmaps as int32 ptr )

'' Read texture pixel data
declare function rlReadTexturePixels( byval id as uint32, byval width_ as int32, byval height as int32, byval format as int32 ) as any ptr

'' Copy framebuffer pixel data to internal buffer
declare sub rlCopyFramebuffer( byval x as int32, byval y as int32, byval width_ as int32, byval height as int32, byval format as int32, byval pixels as any ptr )

'' Resize internal framebuffer
declare sub rlResizeFramebuffer( byval width_ as int32, byval height as int32 )

'' Read screen pixel data (color buffer)
declare function rlReadScreenPixels( byval width_ as int32, byval height as int32 ) as uint8 ptr

'' Framebuffer management (fbo)
''-----------------------------------------------------------------------------------------
'' Load a framebuffer to be used for rendering
'' NOTE: No textures attached
declare function rlLoadFramebuffer( ) as uint32

'' Attach color buffer texture to a framebuffer object (unloads previous attachment)
'' NOTE: Attach type: 0-Color, 1-Depth renderbuffer, 2-Depth texture
declare sub rlFramebufferAttach( byval id as uint32, byval texId as uint32, byval attachType as int32, byval texType as int32, byval mipLevel as int32 )

'' Verify render texture is complete
declare function rlFramebufferComplete( byval id as uint32 ) as boolean

'' Unload framebuffer from GPU memory
'' NOTE: All attached textures/cubemaps/renderbuffers are also deleted
declare sub rlUnloadFramebuffer( byval id as uint32 )

'' Vertex data management
''-----------------------------------------------------------------------------------------
'' Load a new attributes buffer
declare function rlLoadVertexBuffer( byval buffer as const any ptr, byval size as int32, byval dynamic_ as boolean ) as uint32

'' Load a new attributes element buffer
declare function rlLoadVertexBufferElement( byval buffer as const any ptr, byval size as int32, byval dynamic_ as boolean ) as uint32

'' Enable vertex buffer (VBO)
declare sub rlEnableVertexBuffer( byval id as uint32 )

'' Disable vertex buffer (VBO)
declare sub rlDisableVertexBuffer( )

'' Enable vertex buffer element (VBO element)
declare sub rlEnableVertexBufferElement( byval id as uint32 )

'' Disable vertex buffer element (VBO element)
declare sub rlDisableVertexBufferElement( )

'' Update vertex buffer with new data
'' NOTE: dataSize and offset must be provided in bytes
declare sub rlUpdateVertexBuffer( byval id as uint32, byval data_ as const any ptr, byval dataSize as int32, byval offset as int32 )

'' Update vertex buffer elements with new data
'' NOTE: dataSize and offset must be provided in bytes
declare sub rlUpdateVertexBufferElements( byval id as uint32, byval data_ as const any ptr, byval dataSize as int32, byval offset as int32 )

'' Enable vertex array object (VAO)
declare function rlEnableVertexArray( byval vaoId as uint32 ) as boolean

'' Disable vertex array object (VAO)
declare sub rlDisableVertexArray( )

'' Enable vertex attribute index
declare sub rlEnableVertexAttribute( byval index as uint32 )

'' Disable vertex attribute index
declare sub rlDisableVertexAttribute( byval index as uint32 )

'' Draw vertex array
declare sub rlDrawVertexArray( byval offset as int32, byval count as int32 )

'' Draw vertex array elements
declare sub rlDrawVertexArrayElements( byval offset as int32, byval count as int32, byval buffer as const any ptr )

'' Draw vertex array instanced
declare sub rlDrawVertexArrayInstanced( byval offset as int32, byval count as int32, byval instances as int32 )

'' Draw vertex array elements instanced
declare sub rlDrawVertexArrayElementsInstanced( byval offset as int32, byval count as int32, byval buffer as const any ptr, byval instances as int32 )

'' Enable vertex state pointer
declare sub rlEnableStatePointer( byval vertexAttribType as int32, byval buffer as any ptr )

'' Disable vertex state pointer
declare sub rlDisableStatePointer( byval vertexAttribType as int32 )

'' Load vertex array object (VAO)
declare function rlLoadVertexArray( ) as uint32

'' Set vertex attribute
declare sub rlSetVertexAttribute( byval index as uint32, byval compSize as int32, byval type_ as int32, byval normalized as boolean, byval stride as int32, byval offset as int32 )

'' Set vertex attribute divisor
declare sub rlSetVertexAttributeDivisor( byval index as uint32, byval divisor as int32 )

'' Unload vertex array object (VAO)
declare sub rlUnloadVertexArray( byval vaoId as uint32 )

'' Unload vertex buffer (VBO)
declare sub rlUnloadVertexBuffer( byval vboId as uint32 )

'' Shaders management
''-----------------------------------------------------------------------------------------------
'' Load (compile) shader and return shader id
declare function rlLoadShader( byval code as const zstring ptr, byval type_ as int32 ) as uint32

'' Load shader program from code strings
'' NOTE: If shader string is NULL, using default vertex/fragment shaders
declare function rlLoadShaderProgram( byval vsCode as const zstring ptr, byval fsCode as const zstring ptr ) as uint32

'' Load shader program from already loaded shader ids
declare function rlLoadShaderProgramEx( byval vsId as uint32, byval fsId as uint32 ) as uint32

'' Load compute shader program
declare function rlLoadShaderProgramCompute( byval csId as uint32 ) as uint32

'' Delete shader
declare sub rlUnloadShader( byval id as uint32 )

'' Unload shader program
declare sub rlUnloadShaderProgram( byval id as uint32 )

'' Get shader location uniform
'' NOTE: First parameter refers to shader program id
declare function rlGetLocationUniform( byval id as uint32, byval uniformName as const zstring ptr ) as int32

'' Get shader location attribute
'' NOTE: First parameter refers to shader program id
declare function rlGetLocationAttrib( byval id as uint32, byval attribName as const zstring ptr ) as int32

'' Set shader value uniform
declare sub rlSetUniform( byval locIndex as int32, byval value as const any ptr, byval uniformType as int32, byval count as int32 )

'' Set shader value attribute
declare sub rlSetVertexAttributeDefault( byval locIndex as int32, byval value as const any ptr, byval attribType as int32, byval count as int32 )

'' Set shader value uniform matrix
declare sub rlSetUniformMatrix( byval locIndex as int32, byval mat as Matrix )

'' Set shader value uniform matrix
declare sub rlSetUniformMatrices( byval locIndex as int32, byval matrices as const Matrix ptr, byval count as int32 )

'' Set shader value uniform sampler
declare sub rlSetUniformSampler( byval locIndex as int32, byval textureId as uint32 )

'' Set shader currently active (id and locations)
declare sub rlSetShader( byval id as uint32, byval locs as int32 ptr )

'' Dispatch compute shader (equivalent to *draw* for graphics pilepine)
declare sub rlComputeShaderDispatch( byval groupX as uint32, byval groupY as uint32, byval groupZ as uint32 )

'' Load shader storage buffer object (SSBO)
declare function rlLoadShaderBuffer( byval size as uint32, byval data_ as const any ptr, byval usageHint as int32 ) as uint32

'' Unload shader storage buffer object (SSBO)
declare sub rlUnloadShaderBuffer( byval ssboId as uint32 )

'' Update SSBO buffer data
declare sub rlUpdateShaderBuffer( byval id as uint32, byval data_ as const any ptr, byval dataSize as uint32, byval offset as uint32 )

'' Get SSBO buffer size
declare function rlGetShaderBufferSize( byval id as uint32 ) as uint32

'' Read SSBO buffer data (GPU->CPU)
declare sub rlReadShaderBuffer( byval id as uint32, byval dest as any ptr, byval count as uint32, byval offset as uint32 )

'' Bind SSBO buffer
declare sub rlBindShaderBuffer( byval id as uint32, byval index as uint32 )

'' Copy SSBO buffer data
declare sub rlCopyShaderBuffer( byval destId as uint32, byval srcId as uint32, byval destOffset as uint32, byval srcOffset as uint32, byval count as uint32 )

'' Bind image texture
declare sub rlBindImageTexture( byval id as uint32, byval index as uint32, byval format as int32, byval readonly as boolean )

'' Matrix state management
''-----------------------------------------------------------------------------------------
'' Get internal modelview matrix
declare function rlGetMatrixModelview( ) as Matrix

'' Get internal projection matrix
declare function rlGetMatrixProjection( ) as Matrix

'' Get internal accumulated transform matrix
declare function rlGetMatrixTransform( ) as Matrix

'' Get internal projection matrix for stereo render (selected eye)
declare function rlGetMatrixProjectionStereo( byval eye as int32 ) as Matrix

'' Get internal view offset matrix for stereo render (selected eye)
declare function rlGetMatrixViewOffsetStereo( byval eye as int32 ) as Matrix

'' Set a custom modelview matrix (replaces internal modelview matrix)
declare sub rlSetMatrixModelview( byval view_ as Matrix )

'' Set a custom projection matrix (replaces internal projection matrix)
declare sub rlSetMatrixProjection( byval projection as Matrix )

'' Set eyes projection matrices for stereo rendering
declare sub rlSetMatrixProjectionStereo( byval right_ as Matrix, byval left_ as Matrix )

'' Set eyes view offsets matrices for stereo rendering
declare sub rlSetMatrixViewOffsetStereo( byval right_ as Matrix, byval left_ as Matrix )

'' Load and draw a quad in NDC
declare sub rlLoadDrawQuad( )

'' Load and draw a cube in NDC
declare sub rlLoadDrawCube( )

'' Get name string for pixel format
declare function rlGetPixelFormatName( byval format as uint32 ) as const zstring ptr

''----------------------------------------------------------------------------------
'' Module Functions Definition
''----------------------------------------------------------------------------------
#if (defined(GRAPHICS_API_OPENGL_33) orelse defined(GRAPHICS_API_OPENGL_ES2))
'' Load default shader (just vertex positioning and texture coloring)
'' NOTE: This shader program is used for internal buffers
'' NOTE: Loaded: RLGL.State.defaultShaderId, RLGL.State.defaultShaderLocs
'' C2T-TODO(conditional) rlgl.h:4989 -- inside a conditional that stays a TODO
'' static void rlLoadShaderDefault(void)
'' {
''     RLGL.State.defaultShaderLocs = (int *)RL_CALLOC(RL_MAX_SHADER_LOCATIONS, sizeof(int));
''
''     // NOTE: All locations must be reseted to -1 (no location)
''     for (int i = 0; i < RL_MAX_SHADER_LOCATIONS; i++) RLGL.State.defaultShaderLocs[i] = -1;
''
''     // Vertex shader directly defined, no external file required
''     const char *defaultVShaderCode =
'' #if defined(GRAPHICS_API_OPENGL_21)
''     "#version 120                       \n"
''     "attribute vec3 vertexPosition;     \n"
''     "attribute vec2 vertexTexCoord;     \n"
''     "attribute vec4 vertexColor;        \n"
''     "varying vec2 fragTexCoord;         \n"
''     "varying vec4 fragColor;            \n"
'' #elif defined(GRAPHICS_API_OPENGL_33)
''     "#version 330                       \n"
''     "in vec3 vertexPosition;            \n"
''     "in vec2 vertexTexCoord;            \n"
''     "in vec4 vertexColor;               \n"
''     "out vec2 fragTexCoord;             \n"
''     "out vec4 fragColor;                \n"
'' #endif
''
'' #if defined(GRAPHICS_API_OPENGL_ES3)
''     "#version 300 es                    \n"
''     "precision highp float;             \n"     // Precision highp is mandatory in vertex shaders, mediump may run as fp16 and misplace vertices
''     "in vec3 vertexPosition;            \n"
''     "in vec2 vertexTexCoord;            \n"
''     "in vec4 vertexColor;               \n"
''     "out vec2 fragTexCoord;             \n"
''     "out vec4 fragColor;                \n"
'' #elif defined(GRAPHICS_API_OPENGL_ES2)
''     "#version 100                       \n"
''     "precision highp float;             \n"     // Precision highp is mandatory in vertex shaders, mediump may run as fp16 and misplace vertices
''     "attribute vec3 vertexPosition;     \n"
''     "attribute vec2 vertexTexCoord;     \n"
''     "attribute vec4 vertexColor;        \n"
''     "varying vec2 fragTexCoord;         \n"
''     "varying vec4 fragColor;            \n"
'' #endif
''
''     "uniform mat4 mvp;                  \n"
''     "void main()                        \n"
''     "{                                  \n"
''     "    fragTexCoord = vertexTexCoord; \n"
''     "    fragColor = vertexColor;       \n"
''     "    gl_Position = mvp*vec4(vertexPosition, 1.0); \n"
''     "}                                  \n";
''
''     // Fragment shader directly defined, no external file required
''     const char *defaultFShaderCode =
'' #if defined(GRAPHICS_API_OPENGL_21)
''     "#version 120                       \n"
''     "varying vec2 fragTexCoord;         \n"
''     "varying vec4 fragColor;            \n"
''     "uniform sampler2D texture0;        \n"
''     "uniform vec4 colDiffuse;           \n"
''     "void main()                        \n"
''     "{                                  \n"
''     "    vec4 texelColor = texture2D(texture0, fragTexCoord); \n"
''     "    gl_FragColor = texelColor*colDiffuse*fragColor;      \n"
''     "}                                  \n";
'' #elif defined(GRAPHICS_API_OPENGL_33)
''     "#version 330       \n"
''     "in vec2 fragTexCoord;              \n"
''     "in vec4 fragColor;                 \n"
''     "out vec4 finalColor;               \n"
''     "uniform sampler2D texture0;        \n"
''     "uniform vec4 colDiffuse;           \n"
''     "void main()                        \n"
''     "{                                  \n"
''     "    vec4 texelColor = texture(texture0, fragTexCoord);   \n"
''     "    finalColor = texelColor*colDiffuse*fragColor;        \n"
''     "}                                  \n";
'' #endif
''
'' #if defined(GRAPHICS_API_OPENGL_ES3)
''     "#version 300 es                    \n"
''     "#ifdef GL_FRAGMENT_PRECISION_HIGH  \n"
''     "precision highp float;             \n"
''     "#else                              \n"
''     "precision mediump float;           \n"
''     "#endif                             \n"
''     "in vec2 fragTexCoord;              \n"
''     "in vec4 fragColor;                 \n"
''     "out vec4 finalColor;               \n"
''     "uniform sampler2D texture0;        \n"
''     "uniform vec4 colDiffuse;           \n"
''     "void main()                        \n"
''     "{                                  \n"
''     "    vec4 texelColor = texture(texture0, fragTexCoord);   \n"
''     "    finalColor = texelColor*colDiffuse*fragColor;        \n"
''     "}                                  \n";
'' #elif defined(GRAPHICS_API_OPENGL_ES2)
''     "#version 100                       \n"
''     "#ifdef GL_FRAGMENT_PRECISION_HIGH  \n"
''     "precision highp float;             \n"
''     "#else                              \n"
''     "precision mediump float;           \n"
''     "#endif                             \n"
''     "varying vec2 fragTexCoord;         \n"
''     "varying vec4 fragColor;            \n"
''     "uniform sampler2D texture0;        \n"
''     "uniform vec4 colDiffuse;           \n"
''     "void main()                        \n"
''     "{                                  \n"
''     "    vec4 texelColor = texture2D(texture0, fragTexCoord); \n"
''     "    gl_FragColor = texelColor*colDiffuse*fragColor;      \n"
''     "}                                  \n";
'' #endif
''
''     // NOTE: Compiled vertex/fragment shaders are not deleted,
''     // they are kept for re-use as default shaders in case some shader loading fails
''     RLGL.State.defaultVShaderId = rlLoadShader(defaultVShaderCode, GL_VERTEX_SHADER);     // Compile default vertex shader
''     RLGL.State.defaultFShaderId = rlLoadShader(defaultFShaderCode, GL_FRAGMENT_SHADER);   // Compile default fragment shader
''
''     RLGL.State.defaultShaderId = rlLoadShaderProgramEx(RLGL.State.defaultVShaderId, RLGL.State.defaultFShaderId);
''
''     if (RLGL.State.defaultShaderId > 0)
''     {
''         TRACELOG(RL_LOG_INFO, "SHADER: [ID %i] Default shader loaded successfully", RLGL.State.defaultShaderId);
''
''         // Set default shader locations: attributes locations
''         RLGL.State.defaultShaderLocs[RL_SHADER_LOC_VERTEX_POSITION] = glGetAttribLocation(RLGL.State.defaultShaderId, RL_DEFAULT_SHADER_ATTRIB_NAME_POSITION);
''         RLGL.State.defaultShaderLocs[RL_SHADER_LOC_VERTEX_TEXCOORD01] = glGetAttribLocation(RLGL.State.defaultShaderId, RL_DEFAULT_SHADER_ATTRIB_NAME_TEXCOORD);
''         RLGL.State.defaultShaderLocs[RL_SHADER_LOC_VERTEX_COLOR] = glGetAttribLocation(RLGL.State.defaultShaderId, RL_DEFAULT_SHADER_ATTRIB_NAME_COLOR);
''
''         // Set default shader locations: uniform locations
''         RLGL.State.defaultShaderLocs[RL_SHADER_LOC_MATRIX_MVP] = glGetUniformLocation(RLGL.State.defaultShaderId, RL_DEFAULT_SHADER_UNIFORM_NAME_MVP);
''         RLGL.State.defaultShaderLocs[RL_SHADER_LOC_COLOR_DIFFUSE] = glGetUniformLocation(RLGL.State.defaultShaderId, RL_DEFAULT_SHADER_UNIFORM_NAME_COLOR);
''         RLGL.State.defaultShaderLocs[RL_SHADER_LOC_MAP_DIFFUSE] = glGetUniformLocation(RLGL.State.defaultShaderId, RL_DEFAULT_SHADER_SAMPLER2D_NAME_TEXTURE0);
''     }
''     else TRACELOG(RL_LOG_WARNING, "SHADER: [ID %i] Failed to load default shader", RLGL.State.defaultShaderId);
'' }

'' Unload default shader
'' NOTE: Unloads: RLGL.State.defaultShaderId, RLGL.State.defaultShaderLocs
'' C2T-TODO(static-inline) rlgl.h:5128 -- static function 'rlUnloadShaderDefault': no symbol to link against; port the body by hand
'' static void rlUnloadShaderDefault(void)
'' {
''     glUseProgram(0);
''
''     glDetachShader(RLGL.State.defaultShaderId, RLGL.State.defaultVShaderId);
''     glDetachShader(RLGL.State.defaultShaderId, RLGL.State.defaultFShaderId);
''     glDeleteShader(RLGL.State.defaultVShaderId);
''     glDeleteShader(RLGL.State.defaultFShaderId);
''
''     glDeleteProgram(RLGL.State.defaultShaderId);
''
''     RL_FREE(RLGL.State.defaultShaderLocs);
''
''     TRACELOG(RL_LOG_INFO, "SHADER: [ID %i] Default shader unloaded successfully", RLGL.State.defaultShaderId);
'' }

