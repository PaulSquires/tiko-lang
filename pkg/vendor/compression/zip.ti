/' default memLevel '/

/' tm_zip contain date/time info '/
type tm_zip_s
    tm_sec as int32         /' seconds after the minute - [0,59] '/
    tm_min as int32         /' minutes after the hour - [0,59] '/
    tm_hour as int32        /' hours since midnight - [0,23] '/
    tm_mday as int32        /' day of the month - [1,31] '/
    tm_mon as int32         /' months since January - [0,11] '/
    tm_year as int32        /' years - [1980..2044] '/
end type
type tm_zip as tm_zip_s

type zip_fileinfo
    tmz_date as tm_zip          /' date in understandable format           '/
    dosDate as uLong_          /' if dos_date == 0, tmu_date is used      '/
/'    uLong       flag;        '/ /' general purpose bit flag        2 bytes '/

    internal_fa as uLong_       /' internal file attributes        2 bytes '/
    external_fa as uLong_       /' external file attributes        4 bytes '/
end type

type zipcharpc as const zstring ptr


#define APPEND_STATUS_CREATE 0
#define APPEND_STATUS_CREATEAFTER 1
#define APPEND_STATUS_ADDINZIP 2

declare function zipOpen( byval pathname as const zstring ptr, byval append_ as int32 ) as zipFile
declare function zipOpen64( byval pathname as const any ptr, byval append_ as int32 ) as zipFile
/'
  Create a zipfile.
     pathname contain on Windows XP a filename like "c:\\zlib\\zlib113.zip" or on
       an Unix computer "zlib/zlib113.zip".
     if the file pathname exist and append==APPEND_STATUS_CREATEAFTER, the zip
       will be created at the end of the file.
         (useful if the file contain a self extractor code)
     if the file pathname exist and append==APPEND_STATUS_ADDINZIP, we will
       add files in existing zip (be sure you don't add file that doesn't exist)
     If the zipfile cannot be opened, the return value is NULL.
     Else, the return value is a zipFile Handle, usable with other function
       of this zip package.
 '/

/' Note : there is no delete function into a zipfile.
   If you want delete file into a zipfile, you must open a zipfile, and create another
   Of course, you can use RAW reading and writing to copy the file you did not want delete
 '/

declare function zipOpen2( byval pathname as const zstring ptr, _
                           byval append_ as int32, _
                           byval globalcomment as zipcharpc ptr, _
                           byval pzlib_filefunc_def as zlib_filefunc_def ptr ) as zipFile

declare function zipOpen2_64( byval pathname as const any ptr, _
                              byval append_ as int32, _
                              byval globalcomment as zipcharpc ptr, _
                              byval pzlib_filefunc_def as zlib_filefunc64_def ptr ) as zipFile

declare function zipOpen3( byval pathname as const any ptr, _
                           byval append_ as int32, _
                           byval globalcomment as zipcharpc ptr, _
                           byval pzlib_filefunc64_32_def as zlib_filefunc64_32_def ptr ) as zipFile

declare function zipOpenNewFileInZip( byval file as zipFile, _
                                      byval filename as const zstring ptr, _
                                      byval zipfi as const zip_fileinfo ptr, _
                                      byval extrafield_local as const any ptr, _
                                      byval size_extrafield_local as uInt, _
                                      byval extrafield_global as const any ptr, _
                                      byval size_extrafield_global as uInt, _
                                      byval comment as const zstring ptr, _
                                      byval method as int32, _
                                      byval level as int32 ) as int32

declare function zipOpenNewFileInZip64( byval file as zipFile, _
                                        byval filename as const zstring ptr, _
                                        byval zipfi as const zip_fileinfo ptr, _
                                        byval extrafield_local as const any ptr, _
                                        byval size_extrafield_local as uInt, _
                                        byval extrafield_global as const any ptr, _
                                        byval size_extrafield_global as uInt, _
                                        byval comment as const zstring ptr, _
                                        byval method as int32, _
                                        byval level as int32, _
                                        byval zip64 as int32 ) as int32

/'
  Open a file in the ZIP for writing.
  filename : the filename in zip (if NULL, '-' without quote will be used
  *zipfi contain supplemental information
  if extrafield_local!=NULL and size_extrafield_local>0, extrafield_local
    contains the extrafield data for the local header
  if extrafield_global!=NULL and size_extrafield_global>0, extrafield_global
    contains the extrafield data for the global header
  size_extrafield_local and size_extrafield_global are limited to 65535 by
    the format, or less depending on the presence of Zip64 subfields --
    size_extrafield_local needs to leave room for a 20-byte Zip64 subfield if
    zip64 is true, and size_extrafield_global needs to leave room for a 12 to
    28 byte Zip64 subfield in case the offset or length exceeds 2^32-1
  if comment != NULL, comment contains the comment string
  method contains the compression method (0 for store, Z_DEFLATED for deflate)
  level contains the level of compression (can be Z_DEFAULT_COMPRESSION)
  zip64 is set to 1 if a zip64 extended information block should be added to the local file header.
                    this MUST be '1' if the uncompressed size is >= 0xffffffff.

 '/


declare function zipOpenNewFileInZip2( byval file as zipFile, _
                                       byval filename as const zstring ptr, _
                                       byval zipfi as const zip_fileinfo ptr, _
                                       byval extrafield_local as const any ptr, _
                                       byval size_extrafield_local as uInt, _
                                       byval extrafield_global as const any ptr, _
                                       byval size_extrafield_global as uInt, _
                                       byval comment as const zstring ptr, _
                                       byval method as int32, _
                                       byval level as int32, _
                                       byval raw as int32 ) as int32


