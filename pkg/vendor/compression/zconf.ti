'' #      include <unixio.h>       /* for off_t */
#    endif
#    ifndef z_off_t
#      define z_off_t off_t
#    endif
#  endif
#endif

#if (defined(_LFS64_LARGEFILE) andalso (_LFS64_LARGEFILE - 0))
#  define Z_LFS64
#elseif ((((defined(TIKO_OS_WINDOWS) andalso ((0) = 0)) andalso ((defined(__BORLANDC__)) = 0)) andalso ((defined(UNDER_CE)) = 0)) andalso (0 orelse ((defined(__GNUC__)) = 0)))
#  define Z_LFS64       /' native Windows has 64-bit file offsets '/
#  define Z_WINLFS
#endif

#if (defined(_LARGEFILE64_SOURCE) andalso defined(Z_LFS64))
#  define Z_LARGE64
#endif

#if ((defined(_FILE_OFFSET_BITS) andalso ((_FILE_OFFSET_BITS - 0) = 64)) andalso defined(Z_LFS64))
#  define Z_WANT64
#endif

