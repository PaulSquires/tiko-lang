#ifdef Z_SOLO
#  ifdef TIKO_OS_WINDOWS
     type z_size_t as uint64
#  else
     type z_size_t as culong
#  endif
#else
'' C2T-TODO(macro) zconf.h:260 -- 'z_longlong': 'long' after the expression
'' #  define z_longlong long long
#  if defined(NO_SIZE_T)
     '' C2T-TODO(branch-unparsed) zconf.h:262 -- clang cannot parse the branch: expected ';' after top level declarator
''      typedef unsigned NO_SIZE_T z_size_t;
#  elseif defined(STDC)
'' <stddef.h>: built into tiko
     type z_size_t as uinteger
#  else
     type z_size_t as culong
#  endif
#  undef z_longlong
#endif

/' Maximum value for memLevel in deflateInit2 '/
#ifndef MAX_MEM_LEVEL
#  ifdef MAXSEG_64K
#    define MAX_MEM_LEVEL 8
#  else
#    define MAX_MEM_LEVEL 9
#  endif
#endif

/' Maximum value for windowBits in deflateInit2 and inflateInit2.
 * WARNING: reducing MAX_WBITS makes minigzip unable to extract .gz files
 * created by gzip. (Files created by minigzip can still be extracted by
 * gzip.)
 '/
#ifndef MAX_WBITS
#  define MAX_WBITS 15   /' 32K LZ77 window '/
#endif

/' The memory requirements for deflate are (in bytes):
            (1 << (windowBits+2)) +  (1 << (memLevel+9))
 that is: 128K for windowBits=15  +  128K for memLevel = 8  (default values)
 plus a few kilobytes for small objects. For example, if you want to reduce
 the default memory requirements from 256K to 128K, compile with
     make CFLAGS="-O -DMAX_WBITS=14 -DMAX_MEM_LEVEL=7"
 Of course this will generally degrade compression (there's no free lunch).

   The memory requirements for inflate are (in bytes) 1 << windowBits
 that is, 32K for windowBits=15 (default value) plus about 7 kilobytes
 for small objects.
'/

                        /' Type declarations '/

#ifndef OF /' function prototypes '/
#  ifdef STDC
#    define OF(args) (args)
#  else
'' C2T-TODO(function-like-macro) zconf.h:309 -- ')' cannot start an expression
'' #    define OF(args)  ()
#  endif
#endif

/' The following definitions for FAR are needed only for MSDOS mixed
 * model programming (small or medium model with some far allocations).
 * This was tested only with MSC; for other MSDOS compilers you may have
 * to define NO_MEMCPY in zutil.h.  If you don't need the mixed model,
 * just define FAR to be empty.
 '/
#ifdef SYS16BIT
#  if (defined(M_I86SM) orelse defined(M_I86MM))
     /' MSC small or medium model '/
'' C2T-TODO(branch-unparsed) zconf.h:322 -- clang cannot parse the branch: expected ';' after top level declarator
'' #    define SMALL_MEDIUM
'' c2t: export macro FAR (decoration, stripped where used)
#  endif
