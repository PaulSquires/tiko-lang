/'
 * Compile with -DMAXSEG_64K if the alloc function cannot allocate more
 * than 64k bytes at a time (needed on systems with 16-bit int).
 '/
#ifdef SYS16BIT
#  define MAXSEG_64K
#endif
#ifdef MSDOS
#  define UNALIGNED_OK
#endif

#if 1
#  ifndef STDC
#    define STDC
#  endif
#  if (201112 >= 199901)
#    ifndef STDC99
#      define STDC99
#    endif
#  endif
#endif
#if (((defined(STDC)) = 0) andalso (1 orelse 0))
#  define STDC_2
#endif
#if (((defined(STDC)) = 0) andalso (defined(__GNUC__) orelse defined(__BORLANDC__)))
#  define STDC_2
#endif
'' C2T-TODO(conditional) zconf.h:228 -- the passes translate it differently
'' #if !defined(STDC) && (defined(MSDOS) || defined(WINDOWS) || defined(WIN32))
'' C2T-TODO(conditional) zconf.h:229 -- inside a conditional that stays a TODO
'' #  define STDC
'' C2T-TODO(conditional) zconf.h:230 -- the passes translate it differently
'' #endif
#if (((defined(STDC)) = 0) andalso (defined(OS2) orelse defined(__HOS_AIX__)))
#  define STDC_2
#endif

#if (defined(__OS400__) andalso ((defined(STDC)) = 0))    /' iSeries (formerly AS/400). '/
#  define STDC_2
#endif

'' c2t: export macro const (decoration, stripped where used)

#ifndef z_const
