/' these methods can be overwritten by db plugins '/
type st_mariadb_methods
  db_connect as function cdecl( byval as MYSQL ptr, byval as const zstring ptr, byval as const zstring ptr, byval as const zstring ptr, byval as const zstring ptr, byval as uint32, byval as const zstring ptr, byval as culong ) as MYSQL ptr
  db_close as sub cdecl( byval as MYSQL ptr )
  db_command as function cdecl( byval as MYSQL ptr, byval as enum_server_command, byval as const zstring ptr, byval as uinteger, byval as my_bool, byval as any ptr ) as int32
  db_skip_result as sub cdecl( byval as MYSQL ptr )
  db_read_query_result as function cdecl( byval as MYSQL ptr ) as int32
  db_read_rows as function cdecl( byval as MYSQL ptr, byval as MYSQL_FIELD ptr, byval as uint32 ) as MYSQL_DATA ptr
  db_read_one_row as function cdecl( byval as MYSQL ptr, byval as uint32, byval as MYSQL_ROW, byval as culong ptr ) as int32
  /' prepared statements '/
  db_supported_buffer_type as function cdecl( byval as enum_field_types ) as my_bool
  db_read_prepare_response as function cdecl( byval as MYSQL_STMT ptr ) as my_bool
  db_read_stmt_result as function cdecl( byval as MYSQL ptr ) as int32
  db_stmt_get_result_metadata as function cdecl( byval as MYSQL_STMT ptr ) as my_bool
  db_stmt_get_param_metadata as function cdecl( byval as MYSQL_STMT ptr ) as my_bool
  db_stmt_read_all_rows as function cdecl( byval as MYSQL_STMT ptr ) as int32
  db_stmt_fetch as function cdecl( byval as MYSQL_STMT ptr, byval as uint8 ptr ptr, byval as culong ptr ) as int32
  db_stmt_fetch_to_bind as function cdecl( byval as MYSQL_STMT ptr, byval as uint8 ptr, byval as culong ) as int32
  db_stmt_flush_unbuffered as sub cdecl( byval as MYSQL_STMT ptr )
  set_error as sub cdecl( byval as MYSQL ptr, byval as uint32, byval as const zstring ptr, byval as const zstring ptr, ... )
  invalidate_stmts as sub cdecl( byval as MYSQL ptr, byval as const zstring ptr )
  api as st_mariadb_api ptr
  db_read_execute_response as function cdecl( byval as MYSQL_STMT ptr ) as int32
  db_execute_generate_request as function cdecl( byval as MYSQL_STMT ptr, byval as uinteger ptr, byval as my_bool ) as uint8 ptr
end type

