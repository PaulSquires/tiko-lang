  mysql_stmt_execute as function cdecl( byval as MYSQL_STMT ptr ) as int32
  mysql_stmt_fetch as function cdecl( byval as MYSQL_STMT ptr ) as int32
  mysql_stmt_fetch_column as function cdecl( byval as MYSQL_STMT ptr, byval as MYSQL_BIND ptr, byval as uint32, byval as culong ) as int32
