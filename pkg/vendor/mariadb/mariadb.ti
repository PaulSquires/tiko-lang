  MYSQL_STMT_EXECUTED
  MYSQL_STMT_WAITING_USE_OR_STORE
  MYSQL_STMT_USE_OR_STORE_CALLED
  MYSQL_STMT_USER_FETCHING  /' fetch_row_buff or fetch_row_unbuf '/
  MYSQL_STMT_FETCH_DONE
end enum
type enum_mysqlnd_stmt_state as mysql_stmt_state
#elseif not (defined(TIKO_OS_WINDOWS))
type mysql_stmt_state as uint32
enum
  MYSQL_STMT_INITTED = 0
  MYSQL_STMT_PREPARED
  MYSQL_STMT_EXECUTED
  MYSQL_STMT_WAITING_USE_OR_STORE
  MYSQL_STMT_USE_OR_STORE_CALLED
  MYSQL_STMT_USER_FETCHING  /' fetch_row_buff or fetch_row_unbuf '/
  MYSQL_STMT_FETCH_DONE
end enum
type enum_mysqlnd_stmt_state as mysql_stmt_state
#endif

union st_mysql_bind_u_t
    row_ptr as uint8 ptr
    indicator as zstring ptr
end union
type st_mysql_bind
  length as culong ptr             /' output length pointer '/
  is_null as my_bool ptr           /' Pointer to null indicator '/
  buffer as any ptr                /' buffer to get/put data '/
  /' set this if you want to track data truncations happened during fetch '/
  error as my_bool ptr
  u as st_mysql_bind_u_t /' for the current data position '/ /' indicator variable '/
  store_param_func as sub cdecl( byval as NET ptr, byval as st_mysql_bind ptr )
  fetch_result as sub cdecl( byval as st_mysql_bind ptr, byval as MYSQL_FIELD ptr, byval as uint8 ptr ptr )
  skip_result as sub cdecl( byval as st_mysql_bind ptr, byval as MYSQL_FIELD ptr, byval as uint8 ptr ptr )
  /' output buffer length, must be set when fetching str/binary '/
  buffer_length as culong
  offset as culong                 /' offset position for char/binary fetch '/
  length_value as culong           /' Used if length is 0 '/
  flags as uint32                  /' special flags, e.g. for dummy bind  '/
  pack_length as uint32            /' Internal length for packed data '/
  buffer_type as enum_field_types     /' buffer type '/
  error_value as my_bool           /' used if error is 0 '/
  is_unsigned as my_bool           /' set if integer type is unsigned '/
  long_data_used as my_bool        /' If used with mysql_send_long_data '/
  is_null_value as my_bool         /' Used if is_null is 0 '/
  extension as any ptr
end type
type MYSQL_BIND as st_mysql_bind

type st_mysqlnd_upsert_result
  warning_count as uint32
  server_status as uint32
  affected_rows as uint64
  last_insert_id as uint64
end type
type mysql_upsert_status as st_mysqlnd_upsert_result

type st_mysql_cmd_buffer
  buffer as uint8 ptr
  length as uinteger
end type
type MYSQL_CMD_BUFFER as st_mysql_cmd_buffer

type st_mysql_error_info
  error_no as uint32
  error as zstring * 513
  sqlstate as zstring * 6
end type
type mysql_error_info as st_mysql_error_info

type mysql_stmt_fetch_row_func as function cdecl( byval as MYSQL_STMT ptr, byval as uint8 ptr ptr, byval as culong ptr ) as int32
type ps_result_callback as sub cdecl( byval as any ptr, byval as uint32, byval as uint8 ptr ptr )
type ps_param_callback as function cdecl( byval as any ptr, byval as MYSQL_BIND ptr, byval as uint32 ) as my_bool

type st_mysql_stmt
  mem_root as MA_MEM_ROOT
  mysql as MYSQL ptr
  stmt_id as culong
  flags as culong                /' cursor is set here '/
  state as enum_mysqlnd_stmt_state
  fields as MYSQL_FIELD ptr
  field_count as uint32
  param_count as uint32
  send_types_to_server as uint8
  params as MYSQL_BIND ptr
  bind as MYSQL_BIND ptr
  result as MYSQL_DATA              /' we don't use mysqlnd's result set logic '/
  result_cursor as MYSQL_ROWS ptr
  bind_result_done as my_bool
  bind_param_done as my_bool

  upsert_status as mysql_upsert_status

  last_errno as uint32
  last_error as zstring * 513
  sqlstate as zstring * 6

  update_max_length as my_bool
  prefetch_rows as culong
  list as LIST

  cursor_exists as my_bool

  extension as any ptr
  fetch_row_func as mysql_stmt_fetch_row_func
  execute_count as uint32                /' count how many times the stmt was executed '/
  default_rset_handler as mysql_stmt_use_or_store_func
  request_buffer as uint8 ptr
  array_size as uint32
  row_size as uinteger
  prebind_params as uint32
  user_data as any ptr
  result_callback as ps_result_callback
  param_callback as ps_param_callback
  request_length as uinteger
  sql as MARIADB_CONST_STRING
end type

type ps_field_fetch_func as sub cdecl( byval as MYSQL_BIND ptr, byval as const MYSQL_FIELD ptr, byval as uint8 ptr ptr )
