#define MYSQL_NO_DATA 100
#define MYSQL_DATA_TRUNCATED 101
#define MYSQL_DATA_MALFORMED 102

'' C2T-NOTE(value) mariadb.h:1168 -- clang's value; a cast, which tiko's preprocessor does not evaluate
#define MYSQL_DEFAULT_PREFETCH_ROWS 1

/' Bind flags '/
#define MADB_BIND_DUMMY 1

'' C2T-TODO(function-like-macro) mariadb.h:1173 -- a C truth value (1) used as a number; tiko's is -1
'' #define MARIADB_STMT_BULK_SUPPORTED(stmt)\
''   ((stmt)->mysql && \
''   (!((stmt)->mysql->server_capabilities & CLIENT_MYSQL) &&\
''     ((stmt)->mysql->extension->mariadb_server_capabilities & \
''     (MARIADB_CLIENT_STMT_BULK_OPERATIONS >> 32))))

'' C2T-TODO(function-like-macro) mariadb.h:1179 -- a C truth value (1) used as a number; tiko's is -1
'' #define MARIADB_STMT_BULK_UNIT_RESULTS_SUPPORTED(stmt)\
''   ((stmt)->mysql && \
''   (!((stmt)->mysql->server_capabilities & CLIENT_MYSQL) &&\
''     ((stmt)->mysql->extension->mariadb_client_flag & \
''     (MARIADB_CLIENT_BULK_UNIT_RESULTS >> 32))))

'' C2T-TODO(function-like-macro) mariadb.h:1185 -- '{' after the expression
'' #define CLEAR_CLIENT_STMT_ERROR(a) \
'' do { \
''   (a)->last_errno= 0;\
''   strcpy((a)->sqlstate, "00000");\
''   (a)->last_error[0]= 0;\
'' } while (0)

