/' MariaDB-specific capabilities '/
#define MARIADB_CLIENT_FLAGS &hFFFFFFFF00000000ull
#define MARIADB_CLIENT_PROGRESS (1ull shl 32)
#define MARIADB_CLIENT_RESERVED_1 (1ull shl 33) /' Former COM_MULTI, don't use '/
#define MARIADB_CLIENT_STMT_BULK_OPERATIONS (1ull shl 34)
/' support of extended data type/format information, since 10.5.0 '/
