type st_dynamic_array__fwd as st_dynamic_array
type st_mysql_options_extension__fwd as st_mysql_options_extension
type st_mysql_options
    connect_timeout as uint32
    read_timeout as uint32
    write_timeout as uint32
    port as uint32
    protocol as uint32
    client_flag as culong
    host as zstring ptr
    user as zstring ptr
    password as zstring ptr
    unix_socket as zstring ptr
    db as zstring ptr
    init_command as st_dynamic_array ptr
    my_cnf_file as zstring ptr
    my_cnf_group as zstring ptr
    charset_dir as zstring ptr
    charset_name as zstring ptr
    ssl_key as zstring ptr    /' PEM key file '/
    ssl_cert as zstring ptr    /' PEM cert file '/
    ssl_ca as zstring ptr     /' PEM CA file '/
    ssl_capath as zstring ptr    /' PEM directory of CA-s? '/
    ssl_cipher as zstring ptr
    shared_memory_base_name as zstring ptr
    max_allowed_packet as culong
    use_ssl as my_bool  /' if to use SSL or not '/
    compress as my_bool
    named_pipe as my_bool
    reconnect as my_bool
    unused_1 as my_bool
    unused_2 as my_bool
    unused_3 as my_bool
    methods_to_use as mysql_option
    bind_address as zstring ptr
    secure_auth as my_bool
    report_data_truncation as my_bool
    /' function pointers for local infile support '/
    local_infile_init as function cdecl( byval as any ptr ptr, byval as const zstring ptr, byval as any ptr ) as int32
    local_infile_read as function cdecl( byval as any ptr, byval as zstring ptr, byval as uint32 ) as int32
    local_infile_end as sub cdecl( byval as any ptr )
    local_infile_error as function cdecl( byval as any ptr, byval as zstring ptr, byval as uint32 ) as int32
    local_infile_userdata as any ptr
    extension as st_mysql_options_extension ptr
end type

  type st_mariadb_methods__fwd as st_mariadb_methods
  type st_mariadb_extension__fwd as st_mariadb_extension
  type st_mysql
    net as NET  /' Communication parameters '/
    unused_0 as any ptr
    host as zstring ptr
      user as zstring ptr
      passwd as zstring ptr
      unix_socket as zstring ptr
      server_version as zstring ptr
      host_info as zstring ptr
    info as zstring ptr
      db as zstring ptr
    charset as const ma_charset_info_st ptr        /' character set '/
    fields as MYSQL_FIELD ptr
    field_alloc as MA_MEM_ROOT
    affected_rows as uint64
    insert_id as uint64            /' id if insert on table with NEXTNR '/
    extra_info as uint64            /' Used by mysqlshow '/
    thread_id as culong       /' Id for connection in server '/
    packet_length as culong
    port as uint32
    client_flag as culong
    server_capabilities as culong
    protocol_version as uint32
    field_count as uint32
    server_status as uint32
    server_language as uint32
    warning_count as uint32              /' warning count, added in 4.1 protocol '/
    options as st_mysql_options
    status as mysql_status
    free_me as my_bool  /' If free in mysql_close '/
    unused_1 as my_bool
    scramble_buff as zstring * 21
    /' madded after 3.23.58 '/
    unused_2 as my_bool
    unused_3 as any ptr
      unused_4 as any ptr
      unused_5 as any ptr
      unused_6 as any ptr
    stmts as LIST ptr
    methods as const st_mariadb_methods__fwd ptr
    thd as any ptr
    unbuffered_fetch_owner as my_bool ptr
    info_buffer as zstring ptr
    extension as st_mariadb_extension ptr
  end type
  type MYSQL as st_mysql

type st_mysql_res
  row_count as uint64
  field_count as uint32
    current_field as uint32
  fields as MYSQL_FIELD ptr
  data as MYSQL_DATA ptr
  data_cursor as MYSQL_ROWS ptr
  field_alloc as MA_MEM_ROOT
  row as MYSQL_ROW /' If unbuffered read '/
  current_row as MYSQL_ROW  /' buffer to current row '/
  lengths as culong ptr    /' column lengths of current row '/
  handle as MYSQL ptr  /' for unbuffered reads '/
  eof as my_bool /' Used my mysql_fetch_row '/
  is_ps as my_bool
end type
type MYSQL_RES as st_mysql_res

type MYSQL_PARAMETERS
  p_max_allowed_packet as culong ptr
  p_net_buffer_length as culong ptr
  extension as any ptr
end type


