#ifndef MYSQL_CLIENT_PLUGIN_HEADER
'' C2T-TODO(macro) mariadb.h:1408 -- 'MYSQL_CLIENT_PLUGIN_HEADER': 'type' after the expression
'' #define MYSQL_CLIENT_PLUGIN_HEADER                      \
''   int type;                                             \
''   unsigned int interface_version;                       \
''   const char *name;                                     \
''   const char *author;                                   \
''   const char *desc;                                     \
''   unsigned int version[3];                              \
''   const char *license;                                  \
''   void *mysql_api;                                      \
''   int (*init)(char *, size_t, int, va_list);            \
''   int (*deinit)(void);                                  \
''   int (*options)(const char *option, const void *);
type st_mysql_client_plugin
  type as int32
    interface_version as uint32
    name as const zstring ptr
    author as const zstring ptr
    desc as const zstring ptr
    version(0 to 2) as uint32
    license as const zstring ptr
    mysql_api as any ptr
    init as function cdecl( byval as zstring ptr, byval as uinteger, byval as int32, byval as cva_list ) as int32
    deinit as function cdecl(  ) as int32
    options as function cdecl( byval as const zstring ptr, byval as const any ptr ) as int32
end type

