  type st_mysql_field
    name as zstring ptr   /' Name of column '/
    org_name as zstring ptr  /' Name of original column (added after 3.23.58) '/
    table as zstring ptr   /' Table of column if column was a field '/
    org_table as zstring ptr  /' Name of original table (added after 3.23.58 '/
    db as zstring ptr             /' table schema (added after 3.23.58) '/
    catalog as zstring ptr        /' table catalog (added after 3.23.58) '/
    def as zstring ptr   /' Default value (set by mysql_list_fields) '/
    length as culong       /' Width of column '/
    max_length as culong      /' Max width of selected set '/
  /' added after 3.23.58 '/
    name_length as uint32
    org_name_length as uint32
    table_length as uint32
    org_table_length as uint32
    db_length as uint32
    catalog_length as uint32
    def_length as uint32
  /'*********************'/
    flags as uint32      /' Div flags '/
    decimals as uint32     /' Number of decimals in field '/
    charsetnr as uint32           /' char set number (added in 4.1) '/
    type as enum_field_types    /' Type of field. Se mysql_com.h for types '/
    extension as any ptr          /' added in 4.1 '/
  end type
  type MYSQL_FIELD as st_mysql_field

  type MYSQL_ROW as zstring ptr ptr  /' return data as array of strings '/
  type MYSQL_FIELD_OFFSET as uint32        /' offset to current field '/

