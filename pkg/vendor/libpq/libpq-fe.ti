/' close the current connection and free the PGconn data structure '/
declare sub PQfinish( byval conn as PGconn ptr )

/' get info about connection options known to PQconnectdb '/
declare function PQconndefaults( ) as PQconninfoOption ptr

/' parse connection options in same way as PQconnectdb '/
declare function PQconninfoParse( byval conninfo as const zstring ptr, byval errmsg as zstring ptr ptr ) as PQconninfoOption ptr

/' return the connection options used by a live connection '/
declare function PQconninfo( byval conn as PGconn ptr ) as PQconninfoOption ptr

/' free the data structure returned by PQconndefaults() or PQconninfoParse() '/
declare sub PQconninfoFree( byval connOptions as PQconninfoOption ptr )

/'
 * close the current connection and reestablish a new one with the same
 * parameters
 '/
/' Asynchronous (non-blocking) '/
declare function PQresetStart( byval conn as PGconn ptr ) as int32
declare function PQresetPoll( byval conn as PGconn ptr ) as PostgresPollingStatusType

/' Synchronous (blocking) '/
declare sub PQreset( byval conn as PGconn ptr )

/' Create a PGcancelConn that's used to cancel a query on the given PGconn '/
declare function PQcancelCreate( byval conn as PGconn ptr ) as PGcancelConn ptr

/' issue a cancel request in a non-blocking manner '/
declare function PQcancelStart( byval cancelConn as PGcancelConn ptr ) as int32

/' issue a blocking cancel request '/
declare function PQcancelBlocking( byval cancelConn as PGcancelConn ptr ) as int32

/' poll a non-blocking cancel request '/
declare function PQcancelPoll( byval cancelConn as PGcancelConn ptr ) as PostgresPollingStatusType
declare function PQcancelStatus( byval cancelConn as const PGcancelConn ptr ) as ConnStatusType
declare function PQcancelSocket( byval cancelConn as const PGcancelConn ptr ) as int32
declare function PQcancelErrorMessage( byval cancelConn as const PGcancelConn ptr ) as zstring ptr
declare sub PQcancelReset( byval cancelConn as PGcancelConn ptr )
declare sub PQcancelFinish( byval cancelConn as PGcancelConn ptr )


/' request a cancel structure '/
declare function PQgetCancel( byval conn as PGconn ptr ) as PGcancel ptr

/' free a cancel structure '/
declare sub PQfreeCancel( byval cancel as PGcancel ptr )

/' deprecated version of PQcancelBlocking, but one which is signal-safe '/
declare function PQcancel( byval cancel as PGcancel ptr, byval errbuf as zstring ptr, byval errbufsize as int32 ) as int32

/' deprecated version of PQcancel; not thread-safe '/
declare function PQrequestCancel( byval conn as PGconn ptr ) as int32

/' Accessor functions for PGconn objects '/
declare function PQdb( byval conn as const PGconn ptr ) as zstring ptr
declare function PQuser( byval conn as const PGconn ptr ) as zstring ptr
declare function PQpass( byval conn as const PGconn ptr ) as zstring ptr
declare function PQhost( byval conn as const PGconn ptr ) as zstring ptr
