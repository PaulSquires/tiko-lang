/'
 * PGconn encapsulates a connection to the backend.
 * The contents of this struct are not supposed to be known to applications.
 '/
type pg_conn__fwd as pg_conn
type PGconn as pg_conn

/'
 * PGcancelConn encapsulates a cancel connection to the backend.
 * The contents of this struct are not supposed to be known to applications.
 '/
type pg_cancel_conn__fwd as pg_cancel_conn
type PGcancelConn as pg_cancel_conn

/'
 * PGresult encapsulates the result of a query (or more precisely, of a single
 * SQL command --- a query string given to PQsendQuery can contain multiple
 * commands and thus return multiple PGresult objects).
 * The contents of this struct are not supposed to be known to applications.
 '/
type pg_result__fwd as pg_result
type PGresult as pg_result

/'
 * PGcancel encapsulates the information needed to cancel a running
 * query on an existing connection.
 * The contents of this struct are not supposed to be known to applications.
 '/
type pg_cancel__fwd as pg_cancel
type PGcancel as pg_cancel

/'
 * PGnotify represents the occurrence of a NOTIFY message.
 * Ideally this would be an opaque typedef, but it's so simple that it's
 * unlikely to change.
 * NOTE: in Postgres 6.4 and later, the be_pid is the notifying backend's,
 * whereas in earlier versions it was always your own backend's PID.
 '/
type pgNotify
	relname as zstring ptr  /' notification condition name '/
	be_pid as int32 /' process ID of notifying server process '/
	extra as zstring ptr   /' notification parameter '/
	/' Fields below here are private to libpq; apps should not use 'em '/
	next as pgNotify ptr    /' list link '/
end type
type PGnotify_2 as pgNotify

/' pg_usec_time_t is like time_t, but with microsecond resolution '/
type pg_usec_time_t as int64

/' Function types for notice-handling callbacks '/
type PQnoticeReceiver as sub cdecl( byval as any ptr, byval as const PGresult ptr )
type PQnoticeProcessor as sub cdecl( byval as any ptr, byval as const zstring ptr )

/' Print options for PQprint() '/
type pqbool as byte

type _PQprintOpt
	header as pqbool  /' print output field headings and row count '/
	align as pqbool  /' fill align the fields '/
	standard as pqbool /' old brain dead format '/
	html3 as pqbool  /' output html tables '/
	expanded as pqbool /' expand tables '/
	pager as pqbool  /' use pager for output if needed '/
	fieldSep as zstring ptr  /' field separator '/
	tableOpt as zstring ptr  /' insert to HTML <table ...> '/
	caption as zstring ptr  /' HTML <caption> '/
	fieldName as zstring ptr ptr  /' null terminated array of replacement field
								 * names '/
end type
type PQprintOpt as _PQprintOpt

/' ----------------
 * Structure for the conninfo parameter definitions returned by PQconndefaults
 * or PQconninfoParse.
 *
 * All fields except "val" point at static strings which must not be altered.
 * "val" is either NULL or a malloc'd current-value string.  PQconninfoFree()
 * will release both the val strings and the PQconninfoOption array itself.
 * ----------------
 '/
type _PQconninfoOption
	keyword as zstring ptr  /' The keyword of the option			'/
	envvar as zstring ptr   /' Fallback environment variable name	'/
	compiled as zstring ptr  /' Fallback compiled in default value	'/
	val as zstring ptr   /' Option's current value, or NULL		 '/
	label as zstring ptr   /' Label for field in connect dialog	'/
	dispchar as zstring ptr  /' Indicates how to display this field in a
								 * connect dialog. Values are: "" Display
								 * entered value as is "*" Password field -
								 * hide value "D"  Debug option - don't show
								 * by default '/
	dispsize as int32  /' Field size in characters for dialog	'/
end type
type PQconninfoOption as _PQconninfoOption

/' ----------------
 * PQArgBlock -- structure for PQfn() arguments
 * ----------------
 '/
union PQArgBlock_u_t
    ptr as int32 ptr
    integer as int32
end union
type PQArgBlock
	len as int32
	isint as int32
	u as PQArgBlock_u_t /' can't use void (dec compiler barfs)	 '/
end type

/' ----------------
 * PGresAttDesc -- Data about a single attribute (column) of a query result
 * ----------------
 '/
type pgresAttDesc
	name as zstring ptr   /' column name '/
	tableid as Oid  /' source table, if known '/
	columnid as int32  /' source column, if known '/
	format as int32 /' format code for value (text/binary) '/
	typid as Oid   /' type id '/
	typlen as int32 /' type size '/
	atttypmod as int32  /' type-specific modifier info '/
end type
type PGresAttDesc_2 as pgresAttDesc

/' ----------------
 * Exported functions of libpq
 * ----------------
 '/

/' === in fe-connect.c === '/

/' make a new client connection to the backend '/
/' Asynchronous (non-blocking) '/
declare function PQconnectStart( byval conninfo as const zstring ptr ) as PGconn ptr
declare function PQconnectStartParams( byval keywords as const zstring const ptr ptr, _
									byval values as const zstring const ptr ptr, byval expand_dbname as int32 ) as PGconn ptr
declare function PQconnectPoll( byval conn as PGconn ptr ) as PostgresPollingStatusType

/' Synchronous (blocking) '/
declare function PQconnectdb( byval conninfo as const zstring ptr ) as PGconn ptr
declare function PQconnectdbParams( byval keywords as const zstring const ptr ptr, _
								 byval values as const zstring const ptr ptr, byval expand_dbname as int32 ) as PGconn ptr
declare function PQsetdbLogin( byval pghost as const zstring ptr, byval pgport as const zstring ptr, _
							byval pgoptions as const zstring ptr, byval pgtty as const zstring ptr, _
							byval dbName as const zstring ptr, _
							byval login as const zstring ptr, byval pwd as const zstring ptr ) as PGconn ptr

