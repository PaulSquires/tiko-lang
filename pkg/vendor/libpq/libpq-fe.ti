declare function PQfullProtocolVersion( byval conn as const PGconn ptr ) as int32
declare function PQserverVersion( byval conn as const PGconn ptr ) as int32
declare function PQerrorMessage( byval conn as const PGconn ptr ) as zstring ptr
declare function PQsocket( byval conn as const PGconn ptr ) as int32
declare function PQbackendPID( byval conn as const PGconn ptr ) as int32
declare function PQpipelineStatus( byval conn as const PGconn ptr ) as PGpipelineStatus
declare function PQconnectionNeedsPassword( byval conn as const PGconn ptr ) as int32
declare function PQconnectionUsedPassword( byval conn as const PGconn ptr ) as int32
