'' hosts.tiko -- which targets this host can run, and which runtimes it cannot have.
'' Included by tikotest.tiko; split out at the 1500-line lint cap.

'' CAN THIS HOST RUN WHAT A BUILD FOR tgt PRODUCES? Both Windows targets' programs run on
'' Windows (win64 links MinGW's CRT, windows-x86_64 the UCRT; both are PE executables),
'' linux-x86_64's on Linux and macos-arm64's on a Mac. Anything else would need an
'' emulator, and is skipped.
function IsHostTarget_( byval tgt as string ) as boolean
    #if defined( __FB_WIN32__ )
        return (tgt = "win64") orelse (tgt = "windows-x86_64")
    #elseif defined( __FB_DARWIN__ )
        return (tgt = "macos-arm64")
    #else
        return (tgt = "linux-x86_64")
    #endif
end function

'' THE RUNTIME A TEST NAMES, WHEN THIS HOST CANNOT HAVE IT (docs/tiko-macos M8, D-M8-1): its
'' 'ENV: TKO_LIBPATH=' directory, if that directory is missing and is for a target whose
'' programs this host cannot run. 781 tests link for windows-x86_64 against
'' build/obj/rtlib/windows-x86_64, which build/test.sh makes on Windows alone. Such a test is
'' still RUN -- a compile error or a '-c' passes without the runtime, 32 of them on Linux --
'' but if it FAILS it is counted as skipped, not failed: off Windows each one failing at its
'' link buried the failures that mean something. On Windows the directory is the host's own,
'' so a failure there is a failure. "" when the test can run.
function MissingRuntime_( byref tc as TestCase ) as string
    for each e_ as string in tc.env
        if left( e_, 12 ) <> "TKO_LIBPATH=" then continue for
        dim as string d = mid( e_, 13 )
        dim as string tgt = ""
        if (instr( d, "windows-x86_64" ) > 0) orelse (instr( d, "win64" ) > 0) then
            tgt = "windows-x86_64"
        elseif instr( d, "linux-x86_64" ) > 0 then
            tgt = "linux-x86_64"
        elseif instr( d, "macos-arm64" ) > 0 then
            tgt = "macos-arm64"
        end if
        if len( tgt ) = 0 then continue for
        if IsHostTarget_( tgt ) then continue for
        if fs.IsDir( d ) = false then return d
    next
    return ""
end function

'' THIS HOST'S NAME, as a HOSTS: line spells it.
function HostName_( ) as string
    #if defined( __FB_WIN32__ )
        return "windows"
    #elseif defined( __FB_DARWIN__ )
        return "macos"
    #else
        return "linux"
    #endif
end function

'' WHAT THIS HOST CANNOT GIVE A TEST, or a target's run of it: "" when nothing. Two directives:
''
''     '' HOSTS: windows macos       the hosts it runs on -- an SDK or tool only they have
''     '' HOSTS[macos-arm64]: ...    the same, for that target's run alone
''     '' NEEDS: path                a file or directory it reads, which this checkout may
''                                   lack (toolchains/ is gitignored, and CI lays out only
''                                   the host's own toolchain)
''
'' tgt = "" asks about the whole test, before it runs; a target asks about that run, which is
'' then not made. Either way it is reported as skipped, not failed: a Linux runner has no
'' Windows SDK, and a failure for that reason buried the ones that mean something.
function Unmet_( byref tc as TestCase, byval tgt as string ) as string
    for each h_ as string in tc.hosts
        dim as int32 tb = instr( h_, chr( 9 ) )
        if left( h_, tb - 1 ) <> tgt then continue for
        dim as string list = " " & mid( h_, tb + 1 ) & " "
        if instr( list, " " & HostName_( ) & " " ) = 0 then return "a " & Trim_( list ) & " host"
    next
    if len( tgt ) > 0 then return ""
    for each n_ as string in tc.needs
        if fs.Exists( n_ ) = false then return n_
    next
    return ""
end function

'' THE FIRST LINES A FAILED RUN PRINTED, for a failure that names only an exit code: on a CI
'' runner nobody can rerun the test by hand to see why tiko-lang exited 5.
function FirstLines_( byref s as string ) as string
    dim as string r = "", ln = ""
    dim as int32 n = 0, at = 1
    while (at <= len( s )) andalso (n < 4)
        dim as int32 nl = instr( at, s, chr( 10 ) )
        if nl = 0 then nl = len( s ) + 1
        ln = rtrim( mid( s, at, nl - at ), chr( 13 ) )
        at = nl + 1
        if len( Trim_( ln ) ) = 0 then continue while
        r &= chr( 10 ) & "  " & ln : n += 1
    wend
    return r
end function
