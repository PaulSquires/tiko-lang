'' gencodepages.tiko -- writes pkg/std/codec/codecpages.tiko, the single-byte code-page
'' tables std/codec decodes and encodes with where the OS has no code pages (Linux).
''
'' The tables are WINDOWS' OWN ANSWERS, not a transcription of any published mapping:
'' every byte of every code page goes through MultiByteToWideChar, once with no flags
'' (the unit a lenient read gives) and once with MB_ERR_INVALID_CHARS (whether a strict
'' read refuses it). The encode direction needs no table of its own. A unit encodes to
'' the byte that decodes to it, and to nothing else. This program proves that rule
'' against WideCharToMultiByte( WC_NO_BEST_FIT_CHARS ) for all 65536 units of every code
'' page and refuses to write the file if a single unit disagrees.
''
'' Windows only. Run it from the tree's root:
''
''     TKO_LIBPATH=toolchains/tiko-windows/lib/windows-x86_64 bin/tiko.exe \
''         tools/gen/gencodepages.tiko -o build/gencodepages.exe
''     build/gencodepages.exe pkg/std/codec/codecpages.tiko
''
'' tests/codegen/src/codec-text.tiko checks the committed tables against the API again,
'' so a table that drifts from Windows fails the suite.
#import "std/fs"

extern "C"
    declare function gcp_MB2W stdcall alias "MultiByteToWideChar" ( byval cp as ulong, byval fl as ulong, _
        byval s as const ubyte ptr, byval n as long, byval w as ushort ptr, byval wn as long ) as long
    declare function gcp_W2MB stdcall alias "WideCharToMultiByte" ( byval cp as ulong, byval fl as ulong, _
        byval w as const ushort ptr, byval wn as long, byval s as ubyte ptr, byval n as long, _
        byval dc as const ubyte ptr, byval used as long ptr ) as long
end extern

const MB_ERR_INVALID_CHARS = 8
const WC_NO_BEST_FIT_CHARS = &h400
const NCP = 13

dim as ulong cps( 0 to NCP - 1 ) = { 1250, 1251, 1252, 1253, 1254, 1255, 1256, 1257, 1258, 28591, 28605, 437, 850 }
dim as string NL = chr( 10 )

if( len( command( 1 ) ) = 0 ) then
    print "usage: gencodepages <out.tiko>"
    end 2
end if

dim as string body, inval
dim as long ninval = 0

for c as long = 0 to NCP - 1
    dim as ulong cp = cps( c )
    dim as ushort t( 0 to 255 )
    dim as boolean bad( 0 to 255 )
    for b as long = 0 to 255
        dim as ubyte bb = b
        dim as ushort w( 0 to 3 )
        if( gcp_MB2W( cp, 0, @bb, 1, @w( 0 ), 4 ) <> 1 ) then
            print "code page"; cp; ": byte"; b; " is not one unit"
            end 1
        end if
        t( b ) = w( 0 )
        bad( b ) = ( gcp_MB2W( cp, MB_ERR_INVALID_CHARS, @bb, 1, @w( 0 ), 4 ) <> 1 )
        if( ( b < 128 ) andalso ( ( t( b ) <> b ) orelse bad( b ) ) ) then
            print "code page"; cp; ": byte"; b; " is not ASCII"
            end 1
        end if
    next
    for u as long = 0 to &hFFFF
        dim as ushort uu = u
        dim as ubyte o( 0 to 7 )
        dim as long used = 0
        dim as long r = gcp_W2MB( cp, WC_NO_BEST_FIT_CHARS, @uu, 1, @o( 0 ), 8, nullptr, @used )
        dim as long want = -1
        for b as long = 0 to 255
            if( t( b ) = u ) then want = b : exit for
        next
        dim as long got = iif( ( used <> 0 ) orelse ( r <> 1 ), -1, clng( o( 0 ) ) )
        if( want <> got ) then
            print "code page"; cp; ": U+"; hex( u, 4 ); " encodes to"; got; ", the table says"; want
            end 1
        end if
    next

    for row as long = 0 to 15
        body &= "    "
        for k as long = 0 to 7
            body &= "&h" & hex( t( 128 + row * 8 + k ), 4 )
            if( ( c < NCP - 1 ) orelse ( row < 15 ) orelse ( k < 7 ) ) then body &= ","
            if( k < 7 ) then body &= " "
        next
        body &= " _"
        if( row = 0 ) then body &= "    '' " & cp
        body &= NL
    next
    for b as long = 128 to 255
        if( bad( b ) ) then
            if( ninval > 0 ) then inval &= ", "
            inval &= "&h" & hex( ( cp shl 8 ) or b, 6 )
            ninval += 1
        end if
    next
next

dim as string cplist
for c as long = 0 to NCP - 1
    if( c > 0 ) then cplist &= ", "
    cplist &= cps( c )
next

dim as string o
o &= "#module ""codec""" & NL
o &= "'' std/codec: codecpages -- GENERATED by tools/gen/gencodepages.tiko; do not edit." & NL
o &= "''" & NL
o &= "'' Bytes 0x80-0xFF of each code page below, as Windows' MultiByteToWideChar decodes" & NL
o &= "'' them with no flags; bytes 0x00-0x7F are ASCII in every one. EncCpInvalid lists the" & NL
o &= "'' bytes MB_ERR_INVALID_CHARS refuses, as ( code page shl 8 ) or byte: a lenient read" & NL
o &= "'' gives the unit in the table (a private-use character), a strict read fails." & NL
o &= NL
o &= "const ENC_CP_COUNT = " & NCP & NL
o &= "const ENC_CP_INVALID = " & ninval & NL
o &= NL
o &= "dim shared as ulong EncCpIds( 0 to ENC_CP_COUNT - 1 ) = { " & cplist & " }" & NL
o &= NL
o &= "dim shared as ulong EncCpInvalid( 0 to ENC_CP_INVALID - 1 ) = { " & inval & " }" & NL
o &= NL
o &= "dim shared as ushort EncCpHigh( 0 to ENC_CP_COUNT * 128 - 1 ) = { _" & NL
o &= body
o &= "}" & NL

dim as fs.FsResultBool w = fs.WriteAllText( command( 1 ), o )
if( w.IsOk( ) = FALSE ) then
    print "cannot write "; command( 1 )
    end 1
end if
print "wrote "; command( 1 ); ": "; NCP; " code pages,"; ninval; " invalid bytes"
