'' MID statement into a string*N passes the 64-bit tagged length (audit Phase 4, Batch 0).
'' See the source's header.
'' TEST: cli
'' ARGS: -target win64-msvc tests/codegen/src/mid-fixstr.bas -o tests/codegen/midfixstr.exe
'' ENV: TKO_LIBPATH=toolchains/tiko-windows/lib/win64-msvc
'' EXPECT-EXIT: 0
'' RUN: tests/codegen/midfixstr.exe
'' EXPECT-RUN-EXIT: 0
'' EXPECT-RUN-OUT: [abXYefgh]
'' EXPECT-RUN-OUT: [abXYef12]
'' EXPECT-RUN-OUT: [azz]
'' EXPECT-RUN-OUT: [QQQttt]
