'' '#ifdef' and 'defined( )' over the builtins: fbc takes the true branch for '__FUNCTION__'
'' and '__FUNCTION_NQ__' too, which the parser and not a macro expands; tiko took neither.
'' TEST: cli
'' ARGS: -target windows-x86_64 tests/codegen/src/pp-ifdef-function-builtin.bas -o tests/codegen/ppifdeffunctionbuiltin.exe
'' ENV: TIKO_LIBPATH=build/obj/rtlib/windows-x86_64
'' EXPECT-EXIT: 0
'' RUN: tests/codegen/ppifdeffunctionbuiltin.exe
'' EXPECT-RUN-EXIT: 0
'' EXPECT-RUN-OUT: fnq defined
'' EXPECT-RUN-OUT: fn defined
'' EXPECT-RUN-OUT: line defined
'' EXPECT-RUN-OUT: filenq defined
'' EXPECT-RUN-OUT: path defined
'' EXPECT-RUN-OUT: defined() yes
