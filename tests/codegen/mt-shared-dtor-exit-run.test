'' Under -mt, a 'dim shared' destructor assigning a ustring ran after fb_hRtExit had
'' deleted the string lock and crashed at exit (lib/rt/src/c/msvccrtexe.c). Links the
'' PACKAGED runtime, so it fails until the toolchain is repackaged with that fix.
'' TEST: cli
'' ARGS: -target windows-x86_64 -mt tests/codegen/src/mt-shared-dtor-exit.tiko -o tests/codegen/mtshareddtorexit.exe
'' ENV: TIKO_LIBPATH=build/obj/rtlib/windows-x86_64
'' EXPECT-EXIT: 0
'' EXPECT-FILE: tests/codegen/mtshareddtorexit.exe
'' RUN: tests/codegen/mtshareddtorexit.exe
'' EXPECT-RUN-EXIT: 0
'' EXPECT-RUN-OUT: end
'' EXPECT-RUN-OUT: atexit-from-main
'' EXPECT-RUN-OUT: module-dtor
'' EXPECT-RUN-OUT: shared-dtor bye
