'' EXPECT-EXIT: 0
'' RUN: tests/codegen/letonetarget.exe
'' EXPECT-RUN-EXIT: 0
'' EXPECT-RUN-OUT:  1 23
'' EXPECT-RUN-OUT: -1 2-3
'' EXPECT-RUN-OUT:  10 2-3
'' EXPECT-RUN-OUT:  10 2-12
'' EXPECT-RUN-OUT:  4
