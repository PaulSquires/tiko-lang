'' pp: '##' keeps its spaces and the pasted name's case; 'a##_' vs 'a ##_'; a leading '##' (pp/token-pasting.bas, pp/macro_no_parentheses.bas)
'' TEST: cli
'' ARGS: -target windows-x86_64 tests/codegen/src/pp-paste-spacing.bas -o tests/codegen/pppastespacing.exe
'' ENV: TIKO_LIBPATH=build/obj/rtlib/windows-x86_64
'' EXPECT-EXIT: 0
'' RUN: tests/codegen/pppastespacing.exe
'' EXPECT-RUN-EXIT: 0
'' EXPECT-RUN-OUT: XY|X Y|X  Y|X  Y
'' EXPECT-RUN-OUT: X_Y|X _Y|X_|_X
'' EXPECT-RUN-OUT: Abc|Bar
'' EXPECT-RUN-OUT:  5
'' EXPECT-RUN-OUT:  8
