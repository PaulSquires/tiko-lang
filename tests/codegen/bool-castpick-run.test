'' A BOOLEAN DESTINATION TAKES THE CAST NEAREST A BYTE: integer before float, signed before
'' unsigned, small before large. tiko took the highest-ranked (double). Expected output is fbc-modern's.
'' TEST: cli
'' ARGS: -target win64-msvc tests/codegen/src/bool-castpick.bas -o tests/codegen/boolcastpick.exe
'' ENV: TKO_LIBPATH=toolchains/tiko-windows/lib/win64-msvc
'' EXPECT-EXIT: 0
'' RUN: tests/codegen/boolcastpick.exe
'' EXPECT-RUN-EXIT: 0
'' EXPECT-RUN-OUT: [byte]true
'' EXPECT-RUN-OUT: [longint]true
'' EXPECT-RUN-OUT: [short]true
'' EXPECT-RUN-OUT: [single]true
'' EXPECT-RUN-OUT: [byte]true
