'' ARGS: --emit-ir -target win64-msvc tests/codegen/src/cxx-var-names.bas
'' EXPECT-EXIT: 0
'' EXPECT-OUT: @"_Z4cppv"
'' EXPECT-OUT: @"_Z6CamelV"
'' EXPECT-OUT: @"_Z4arrv"
'' EXPECT-OUT: @"_ZN2cn3nsvE"
'' EXPECT-NOT: CPPV$
'' EXPECT-NOT: NSV$
