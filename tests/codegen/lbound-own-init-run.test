'' EXPECT-EXIT: 0
'' RUN: tests/codegen/lboundowninit.exe
'' EXPECT-RUN-EXIT: 0
'' EXPECT-RUN-OUT:  11             13            1             11            3
'' EXPECT-RUN-OUT:  11            3
'' EXPECT-RUN-OUT:  2             9             4             6
