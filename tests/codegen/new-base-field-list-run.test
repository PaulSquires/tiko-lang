'' EXPECT-EXIT: 0
'' RUN: tests/codegen/newbasefieldlist.exe
'' EXPECT-RUN-EXIT: 0
'' EXPECT-RUN-OUT:  1              2
'' EXPECT-RUN-OUT:  3             4             5
'' EXPECT-RUN-OUT:  6             0             0
