'' The #if evaluator over literal types (audit G5, tka-probes/phase4/pb): suffix width (& l ul ! f),
'' unsigned decimals 2^31..2^32-1, NOT and AND keeping unsigned, the ^ operator above negation, the C*
'' conversions, and single precision. Expected output is fbc-modern's; tiko refused 17 of these lines.
'' TEST: cli
'' ARGS: -target win64-msvc tests/codegen/src/pp-literal-types.bas -o tests/codegen/ppliteraltypes.exe
'' ENV: TKO_LIBPATH=toolchains/tiko-windows/lib/win64-msvc
'' EXPECT-EXIT: 0
'' RUN: tests/codegen/ppliteraltypes.exe
'' EXPECT-RUN-EXIT: 0
'' EXPECT-RUN-OUT: 2147483648& = -2147483648
'' EXPECT-RUN-OUT: 2147483648l = -2147483648
'' EXPECT-RUN-OUT: 2147483648! =  2147484000
'' EXPECT-RUN-OUT: 4294967295& = -1
'' EXPECT-RUN-OUT: 4294967295f =  4294967000
'' EXPECT-RUN-OUT: &hFFFFFFFF& = -1
'' EXPECT-RUN-OUT: &hFFFFFFFFl = -1
'' EXPECT-RUN-OUT: not 1u = 18446744073709551614
'' EXPECT-RUN-OUT: not 0ul = -1
'' EXPECT-RUN-OUT: 3000000000 \ -2 =  0
'' EXPECT-RUN-OUT: 1ul > -1 = -1
'' EXPECT-RUN-OUT: 2^10 =  1024
'' EXPECT-RUN-OUT: -2^2 = -4
'' EXPECT-RUN-OUT: 2^-1 =  0.5
'' EXPECT-RUN-OUT: 2^3^2 =  64
'' EXPECT-RUN-OUT: 2 * 3 ^ 2 =  18
'' EXPECT-RUN-OUT: cint( 2.5 ) =  2
'' EXPECT-RUN-OUT: cint( 3.5 ) =  4
'' EXPECT-RUN-OUT: clng( 4294967295 ) = -1
'' EXPECT-RUN-OUT: cuint( -1 ) = 18446744073709551615
'' EXPECT-RUN-OUT: cbyte( 300 ) =  44
'' EXPECT-RUN-OUT: cushort( -1 ) =  65535
'' EXPECT-RUN-OUT: csng( 1 / 3 ) =  0.3333333
'' EXPECT-RUN-OUT: 1f / 3 =  0.3333333333333333
'' EXPECT-RUN-OUT: 1f / 3f =  0.3333333
'' EXPECT-RUN-OUT: 1.5f * 2.5f =  3.75
'' EXPECT-RUN-OUT: 1.5f + 1.5 =  3
'' EXPECT-RUN-OUT: &hFFFFFFFFu and -1 = 4294967295
'' EXPECT-RUN-OUT: -1u = -1
'' EXPECT-RUN-OUT: -3000000000 = -3000000000
'' EXPECT-RUN-OUT: if 0 T
'' EXPECT-RUN-OUT: if 1 T
'' EXPECT-RUN-OUT: if 2 T
'' EXPECT-RUN-OUT: if 3 F
'' EXPECT-RUN-OUT: if 4 F
'' EXPECT-RUN-OUT: if 5 T
'' EXPECT-RUN-OUT: if 6 T
'' EXPECT-RUN-OUT: if 7 T
'' EXPECT-RUN-OUT: if 8 T
'' EXPECT-RUN-OUT: if 9 F
'' EXPECT-RUN-OUT: if 10 T
'' EXPECT-RUN-OUT: if 11 T
