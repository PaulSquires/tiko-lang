'' A compound operator over a UDT with '+=' overloads picks as fbc does -- long for every
'' integral value, double, single, string -- and a fixed-length string reaches the
'' 'byref as string' one (tiko did not compile that statement, TKO0994).
'' TEST: cli
'' ARGS: -target windows-x86_64 tests/codegen/src/selfop-overload-pick.bas -o tests/codegen/selfopoverloadpick.exe
'' ENV: TIKO_LIBPATH=build/obj/rtlib/windows-x86_64
'' EXPECT-EXIT: 0
'' RUN: tests/codegen/selfopoverloadpick.exe
'' EXPECT-RUN-EXIT: 0
'' EXPECT-RUN-OUT: long 1
'' EXPECT-RUN-OUT: long 2
'' EXPECT-RUN-OUT: long 3
'' EXPECT-RUN-OUT: long 4
'' EXPECT-RUN-OUT: long 5
'' EXPECT-RUN-OUT: double 1.5
'' EXPECT-RUN-OUT: single 1.5
'' EXPECT-RUN-OUT: string x
'' EXPECT-RUN-OUT: string yy
'' EXPECT-RUN-OUT: string zz
