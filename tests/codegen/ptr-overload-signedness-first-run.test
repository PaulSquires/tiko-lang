'' Pointer overloads over same-size integer pointees prefer the SAME SIGNEDNESS, then the signed/
'' unsigned counterpart: 'longint ptr' takes 'integer ptr' over 'ulongint ptr' (overload/pointers.bas).
'' TEST: cli
'' ARGS: -target win64-msvc tests/codegen/src/ptr-overload-signedness-first.bas -o tests/codegen/ptroverloadsignednessfirst.exe
'' ENV: TKO_LIBPATH=toolchains/tiko-windows/lib/win64-msvc
'' EXPECT-EXIT: 0
'' RUN: tests/codegen/ptroverloadsignednessfirst.exe
'' EXPECT-RUN-EXIT: 0
'' EXPECT-RUN-OUT: integer ptr    ulongint ptr  integer ptr   ulongint ptr
'' EXPECT-RUN-OUT: uinteger ptr  longint ptr   longint ptr   uinteger ptr
