'' UTF-8 literals concatenated into a wstring -- or compared against one -- are their decoded
'' characters: the second term's BYTES were appended as characters (wstring/utf8.bas).
'' TEST: cli
'' ARGS: -target windows-x86_64 tests/codegen/src/utf8-literal-wide-concat.bas -o tests/codegen/utf8literalwideconcat.exe
'' ENV: TIKO_LIBPATH=build/obj/rtlib/windows-x86_64
'' EXPECT-EXIT: 0
'' RUN: tests/codegen/utf8literalwideconcat.exe
'' EXPECT-RUN-EXIT: 0
'' EXPECT-RUN-OUT: -1              15            15           -1            -1
'' EXPECT-RUN-OUT:  9            -1
