'' TEST: cli
'' ARGS: -target macos-arm64 --emit-ir tests/codegen/src/weak-generic.tiko
'' EXPECT-EXIT: 0
'' EXPECT-OUT: define linkonce_odr i32 @"_Z5TwiceIiEi"(
'' EXPECT-NOT: comdat
