'' EXPECT-EXIT: 0
'' RUN: tests/codegen/ascwideconstfold.exe
'' EXPECT-RUN-EXIT: 0
'' EXPECT-RUN-OUT: 0              65            0             66            0
'' EXPECT-RUN-OUT: 4369          0             8738          4369
