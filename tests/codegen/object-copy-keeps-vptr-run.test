'' ARGS: -target windows-x86_64 tests/codegen/src/object-copy-keeps-vptr.bas -o tests/codegen/objectcopykeepsvptr.exe
'' ENV: TIKO_LIBPATH=build/obj/rtlib/windows-x86_64
'' EXPECT-EXIT: 0
'' RUN: tests/codegen/objectcopykeepsvptr.exe
'' EXPECT-RUN-EXIT: 0
'' EXPECT-RUN-OUT: -1
'' EXPECT-RUN-OUT: -1
'' EXPECT-RUN-OUT: -1
'' EXPECT-RUN-OUT: param         -1
'' EXPECT-RUN-OUT: param         -1
'' EXPECT-RUN-OUT: dim           -1
