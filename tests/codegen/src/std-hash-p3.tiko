'' std/hash phase P3 (C:\dev\docs\tiko-stdlib\RFC-0001 section 6), GENERATED: every expected
'' value below was computed by Python's hashlib, hmac and zlib, and by reference CRC-32C and
'' xxHash64 implementations checked against their published vectors first. Covers each
'' algorithm at every padding/stripe boundary length, streaming in every split of 200 bytes,
'' the million-'a' messages, HMAC RFC 4231 cases 1-4, 6, 7 over all six cryptographic
'' hashers (keys longer than the block included), Finish not disturbing the state, Reset,
'' DigestFile against a temp file, and ConstantTimeEquals.
#import "std/hash"
#import "std/containers"
#import "std/fs"
using containers

dim shared as integer fails = 0

sub Check( byref what as string, byval ok as boolean )
    if ok = false then
        print "FAIL "; what
        fails += 1
    end if
end sub

function Msg( byval n as long ) as Array( of ubyte )
    dim as Array( of ubyte ) a
    for i as long = 0 to n - 1
        a.Push( cubyte( ( i * 167 + 13 ) and 255 ) )
    next
    return a
end function

function Unhex( byref h as string ) as Array( of ubyte )
    dim as Array( of ubyte ) a
    for i as long = 1 to len( h ) step 2
        a.Push( cubyte( valint( "&h" & mid( h, i, 2 ) ) ) )
    next
    return a
end function

function HexOf( byref a as Array( of ubyte ) ) as string
    dim as string s
    for i as long = 0 to a.Count( ) - 1
        s &= lcase( hex( a[i], 2 ) )
    next
    return s
end function

