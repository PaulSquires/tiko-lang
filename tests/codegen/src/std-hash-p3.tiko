    for k as long = 0 to 21
        dim as Array( of ubyte ) m = Msg( lens( k ) )
        Check( "HASH_SHA512 len " & lens( k ), hash.DigestHex( hash.HASH_SHA512, m ) = want( k ) )
    next
end scope

'' ------------------------------------------------------------ streaming: every split of 200 bytes
scope
    dim as Array( of ubyte ) m = Msg( 200 )
    dim as long algs( 0 to 11 ) = { _
        hash.HASH_CRC32, hash.HASH_CRC32C, hash.HASH_ADLER32, hash.HASH_FNV1A32, hash.HASH_FNV1A64, hash.HASH_XXHASH64, hash.HASH_MD5, hash.HASH_SHA1, hash.HASH_SHA224, hash.HASH_SHA256, hash.HASH_SHA384, hash.HASH_SHA512 }
    dim as boolean ok = TRUE
    for a as long = 0 to 11
        dim as string whole = hash.DigestHex( cast( hash.HashAlgorithm, algs( a ) ), m )
        for cut as long = 0 to 200
            dim as hash.Hasher ptr h = hash.NewHasher( cast( hash.HashAlgorithm, algs( a ) ) )
            if cut > 0 then h->Update( @m[0], cut )
            if cut < 200 then h->Update( @m[cut], 200 - cut )
            if h->FinishHex( ) <> whole then ok = FALSE
            delete h
        next
    next
    Check( "streaming equals one-shot", ok )
end scope

'' ------------------------------------------------------------ the million-'a' messages
scope
    scope
        dim as hash.Md5 h
        dim as string chunk = string( 1000, "a" )
        for i as long = 1 to 1000
            h.UpdateRaw( chunk )
        next
        Check( "million a Md5", h.FinishHex( ) = "7707d6ae4e027c70eea2a935c2296f21" )
    end scope
    scope
        dim as hash.Sha1 h
        dim as string chunk = string( 1000, "a" )
        for i as long = 1 to 1000
            h.UpdateRaw( chunk )
        next
        Check( "million a Sha1", h.FinishHex( ) = "34aa973cd4c4daa4f61eeb2bdbad27316534016f" )
    end scope
    scope
        dim as hash.Sha256 h
        dim as string chunk = string( 1000, "a" )
        for i as long = 1 to 1000
            h.UpdateRaw( chunk )
        next
        Check( "million a Sha256", h.FinishHex( ) = "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0" )
    end scope
    scope
        dim as hash.Sha512 h
        dim as string chunk = string( 1000, "a" )
        for i as long = 1 to 1000
            h.UpdateRaw( chunk )
        next
        Check( "million a Sha512", h.FinishHex( ) = "e718483d0ce769644e2e42c7bc15b4638e1f98b13b2044285632a803afa973ebde0ff244877ea60a4cb0432ce577c31beb009c5c2c49aa2e4eadb217ad8cc09b" )
    end scope
end scope

'' ------------------------------------------------------------ HMAC
scope
    dim as Array( of ubyte ) key = Unhex( "0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b" )
    dim as Array( of ubyte ) dat = Unhex( "4869205468657265" )
    dim as hash.Hmac( of hash.Md5 ) mac = hash.Hmac( of hash.Md5 )( key )
    mac.UpdateBytes( dat )
    Check( "hmac Md5 case 0", mac.FinishHex( ) = "5ccec34ea9656392457fa1ac27f08fbc" )
end scope
