'' B-strings-2: 'u &= <chain>' on a ustring builds the chain in a temporary and appends it ONCE,
'' rather than folding the target into the chain and copying all of it on every append.
'' Every flavour of chain, and a chain that reads the target (still folded).
dim as ustring u = "U", u2 = "é"
dim as string s = "n"
dim as wstring * 8 w = "w"
dim as ustring a
for i as long = 1 to 3
    a &= "item" & i & ";"
next
print "[" & a & "] "; len( a )
a = "" : a &= s & "x" : print "[" & a & "]"
a = "" : a &= u2 & "x" & s : print "[" & a & "] "; len( a )
a = "" : a &= "w=" & w & "|" & u : print "[" & a & "]"
a = "" : a &= 1.5 & ":" & 42 : print "[" & a & "]"
a = "ab" : a &= mid( a, 2 ) & "|" & a : print "[" & a & "]"
a = "q" : a += u & "+" & s : print "[" & a & "]"
dim as ustring big
for i as long = 1 to 20000
    big &= "item" & i & ";"
next
print len( big ); " "; right( big, 11 )
