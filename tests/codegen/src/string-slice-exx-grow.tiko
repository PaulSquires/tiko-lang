'' -exx (docs/tiko-slices RFC-0002 §7, RFC-0001 §5): a callee's '&=' through a byref parameter reallocates the string a slice views -- runtime error 6 at the slice's use.
sub Grow( byref s as string )
    s &= string( 1000, "x" )
end sub
sub Peek2( byval v as const slice, byref s as string )
    Grow( s )
    print len( v ); " "; v[0]
end sub
dim as string s = "hello"
Peek2( s[0 to 2], s )
