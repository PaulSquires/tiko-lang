'' The test PKI for std/tls and std/http (C:\dev\docs\tiko-stdlib\RFC-0002): a root CA, a
'' leaf for localhost / 127.0.0.1 / ::1 valid 2026-2056, and the same leaf expired in 2021,
'' all EC P-256.  Made once with OpenSSL 3.0.13 by the script below; the keys are test keys
'' and protect nothing.
''
''   openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 -out ca.key
''   openssl req -x509 -new -key ca.key -sha256 -days 36500 -subj "/CN=tiko test root CA" \
''     -addext "basicConstraints=critical,CA:TRUE" -addext "keyUsage=critical,keyCertSign,cRLSign" -out ca.pem
''   openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 -out leaf.key
''   openssl req -new -key leaf.key -subj "/CN=localhost" -out leaf.csr
''   (ca.cnf: an `openssl ca` section with policy commonName=supplied and an extension
''    section: basicConstraints=critical,CA:FALSE, keyUsage=critical,digitalSignature,
''    extendedKeyUsage=serverAuth, subjectAltName=DNS:localhost,IP:127.0.0.1,IP:::1)
''   openssl ca -batch -config ca.cnf -cert ca.pem -keyfile ca.key -extensions leaf \
''     -startdate 20260101000000Z -enddate 20560101000000Z -in leaf.csr -out leaf.pem -notext
''   openssl ca ... -startdate 20200101000000Z -enddate 20210101000000Z -in leaf.csr -out expired.pem
