'' RUN: '@F( )' with an empty argument list is the procedure's address, as '@F' is -- for a
'' long and a ustring result, and called through a typed pointer. Output identical to
'' fbc-modern's. See the N_ADDROF case of mir/lowerexpr.tiko.
'' TEST: cli
'' ARGS: -target windows-x86_64 tests/codegen/src/addr-call-noargs.bas -o tests/codegen/addrcallnoargs.exe
'' ENV: TKO_LIBPATH=build/obj/rtlib/windows-x86_64
'' EXPECT-EXIT: 0
'' EXPECT-FILE: tests/codegen/addrcallnoargs.exe
'' RUN: tests/codegen/addrcallnoargs.exe
'' EXPECT-RUN-EXIT: 0
'' EXPECT-RUN-OUT: -1
'' EXPECT-RUN-OUT: -1
'' EXPECT-RUN-OUT:  42
