target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-w64-windows-gnu"


@"$str0" = private unnamed_addr constant [14 x i8] c"Hello, World!\00", align 1

define i32 @"main"(i32 %p0, ptr %p1) nounwind {
L0:
  %s0 = alloca i32, align 4
  store i32 0, ptr %s0, align 4
  call void @"fb_Init"(i32 %p0, ptr %p1, i32 0)
  %t4 = call ptr @"fb_StrAllocTempDescZEx"(ptr @"$str0", i64 13)
  call void @"fb_PrintString"(i32 0, ptr %t4, i32 1)
  call void @"fb_End"(i32 0)
  %t6 = load i32, ptr %s0, align 4
  ret i32 %t6

}

declare void @"fb_Init"(i32, ptr, i32)
declare ptr @"fb_StrAllocTempDescZEx"(ptr, i64)
declare void @"fb_PrintString"(i32, ptr, i32)
declare void @"fb_End"(i32)
