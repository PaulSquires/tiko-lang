target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-w64-windows-gnu"


define i32 @"main"(i32 %p0, ptr %p1) nounwind uwtable(sync) {
L0:
  %s0 = alloca i32, align 4
  store i32 0, ptr %s0, align 4
  call void @"fb_Init"(i32 %p0, ptr %p1, i32 0)
  %s1 = alloca i64, align 8
  store i64 4000000000, ptr %s1, align 8
  %t6 = load i64, ptr %s1, align 8
  call void @"fb_PrintLongint"(i32 0, i64 %t6, i32 1)
  call void @"fb_PrintLongint"(i32 0, i64 1, i32 1)
  call void @"fb_PrintLongint"(i32 0, i64 8, i32 1)
  call void @"fb_End"(i32 0)
  %t10 = load i32, ptr %s0, align 4
  ret i32 %t10

}

declare void @"fb_Init"(i32, ptr, i32)
declare void @"fb_PrintLongint"(i32, i64, i32)
declare void @"fb_End"(i32)
