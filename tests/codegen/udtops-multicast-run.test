'' WHICH 'operator cast' A BUILT-IN OPERATOR OR STATEMENT TAKES over a type casting to long,
'' double and string: '+' beside a string the string one (tiko left '"<" + n + ">"' untyped and
'' PRINT dropped it), arithmetic and conditions by the value met. Expected output is fbc-modern's.
'' TEST: cli
'' ARGS: -target windows-x86_64 tests/codegen/src/udtops-multicast.bas -o tests/codegen/udtopsmulticast.exe
'' ENV: TKO_LIBPATH=toolchains/tiko-windows/lib/windows-x86_64
'' EXPECT-EXIT: 0
'' RUN: tests/codegen/udtopsmulticast.exe
'' EXPECT-RUN-EXIT: 0
'' EXPECT-RUN-OUT: [S]sx
'' EXPECT-RUN-OUT: [S]<s>
'' EXPECT-RUN-OUT: [S]s
'' EXPECT-RUN-OUT: [l] 4
'' EXPECT-RUN-OUT: [d] 4.5
'' EXPECT-RUN-OUT: [l] 4
'' EXPECT-RUN-OUT: [d] 4.5
'' EXPECT-RUN-OUT: [l] 5
'' EXPECT-RUN-OUT: [d] 6
'' EXPECT-RUN-OUT: [l] 8
'' EXPECT-RUN-OUT: [d]-4.5
'' EXPECT-RUN-OUT: [l]-1
'' EXPECT-RUN-OUT: [d]-1
'' EXPECT-RUN-OUT: [d]t
'' EXPECT-RUN-OUT: [d] 1
'' EXPECT-RUN-OUT: [d] 4.5
'' EXPECT-RUN-OUT: [d] 4
'' EXPECT-RUN-OUT: [S] 1
