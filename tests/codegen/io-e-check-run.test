'' T68, RUN: under -e, OPEN of a missing file raises runtime error 2 and CLOSE of a closed
'' channel error 1, each reaching its handler -- fbc's rtlErrorCheck. They carried on.
'' TEST: cli
'' ARGS: -target windows-x86_64 -e tests/codegen/src/io-e-check.bas -o tests/codegen/ioecheck.exe
'' ENV: TIKO_LIBPATH=build/obj/rtlib/windows-x86_64
'' EXPECT-EXIT: 0
'' RUN: tests/codegen/ioecheck.exe
'' EXPECT-RUN-OUT: close: 1
'' EXPECT-RUN-OUT: open: 2
