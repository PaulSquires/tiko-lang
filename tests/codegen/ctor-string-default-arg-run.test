'' EXPECT-EXIT: 0
'' RUN: tests/codegen/ctorstringdefaultarg.exe
'' EXPECT-RUN-EXIT: 0
'' EXPECT-RUN-OUT: [,]true 7
'' EXPECT-RUN-OUT: [;]true 7
'' EXPECT-RUN-OUT: [,]true 7
'' EXPECT-RUN-OUT: [,]true 7
'' EXPECT-RUN-OUT: [,]true 7
'' EXPECT-RUN-OUT: [,]true 7
