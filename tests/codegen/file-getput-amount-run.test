'' RUN: file GET/PUT take the amount (in elements) and the bytes-read variable, keep an
'' elided position, and read into a dynamic array. 'put #1, , buf( 0 ), 10' wrote one
'' element (lof 0), nread stayed 0 and 'get #f, 1, dyn()' left the array zero.
'' Output identical to fbc-modern's.
'' TEST: cli
'' ARGS: -target windows-x86_64 tests/codegen/src/file-getput-amount.bas -o tests/codegen/filegetputamount.exe
'' ENV: TIKO_LIBPATH=build/obj/rtlib/windows-x86_64
'' EXPECT-EXIT: 0
'' RUN: tests/codegen/filegetputamount.exe
'' EXPECT-RUN-EXIT: 0
'' EXPECT-RUN-OUT: lof 40
'' EXPECT-RUN-OUT:  1 4 7 10 13 16 19 22 25 28 0 0
'' EXPECT-RUN-OUT: nread82528
'' EXPECT-RUN-OUT:  17179869185 42949672967 120259084313
'' EXPECT-RUN-OUT:  7 8 9
