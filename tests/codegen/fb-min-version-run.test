'' __FB_MIN_VERSION__( major, minor, patch ): -1 when the compiler is at least that version,
'' in an expression and in '#if'. tiko had no such builtin -- 'not declared' and an invalid
'' '#if'. It answers for TKO_FBC_COMPAT (1.20.0), as __FB_VER_MAJOR__ and the rest do.
'' TEST: cli
'' ARGS: -target win64-msvc tests/codegen/src/fb-min-version.bas -o tests/codegen/fbminversion.exe
'' ENV: TKO_LIBPATH=toolchains/tiko-windows/lib/win64-msvc
'' EXPECT-EXIT: 0
'' RUN: tests/codegen/fbminversion.exe
'' EXPECT-RUN-EXIT: 0
'' EXPECT-RUN-OUT: 1.20.0          1             20            0
'' EXPECT-RUN-OUT: -1
'' EXPECT-RUN-OUT: -1
'' EXPECT-RUN-OUT:  0
'' EXPECT-RUN-OUT:  0
'' EXPECT-RUN-OUT: -1
'' EXPECT-RUN-OUT: pp yes
