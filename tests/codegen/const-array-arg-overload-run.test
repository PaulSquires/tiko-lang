'' A const-element array argument binds only a const-element array parameter: 'ca()' takes
'' 'a() as const integer' even where the other argument fits the non-const overload better (overload/const.bas).
'' TEST: cli
'' ARGS: -target windows-x86_64 tests/codegen/src/const-array-arg-overload.bas -o tests/codegen/constarrayargoverload.exe
'' ENV: TIKO_LIBPATH=build/obj/rtlib/windows-x86_64
'' EXPECT-EXIT: 0
'' RUN: tests/codegen/constarrayargoverload.exe
'' EXPECT-RUN-EXIT: 0
'' EXPECT-RUN-OUT: () const integer, double
'' EXPECT-RUN-OUT: () const integer, integer
