'' EXPECT-EXIT: 0
'' RUN: tests/codegen/methodassignbyref.exe
'' EXPECT-RUN-EXIT: 0
'' EXPECT-RUN-OUT:  3
'' EXPECT-RUN-OUT:  5
'' EXPECT-RUN-OUT:  7
'' EXPECT-RUN-OUT:  8
'' EXPECT-RUN-OUT:  9
'' EXPECT-RUN-OUT: -1
'' EXPECT-RUN-OUT:  11
