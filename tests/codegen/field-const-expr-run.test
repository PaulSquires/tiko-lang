'' EXPECT-EXIT: 0
'' RUN: tests/codegen/fieldconstexpr.exe
'' EXPECT-RUN-EXIT: 0
'' EXPECT-RUN-OUT:  5              5             5             6             5
'' EXPECT-RUN-OUT:  1             2
