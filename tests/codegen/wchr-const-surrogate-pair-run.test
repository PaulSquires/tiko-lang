'' A constant 'wchr' above the BMP folds to a surrogate pair, as fbc folds it: wchr( &h10FFFF ) is
'' &hDBFF &hDFFF; a variable code still goes to the runtime, which truncates (string/wchr-surrogate.bas).
'' TEST: cli
'' ARGS: -target windows-x86_64 tests/codegen/src/wchr-const-surrogate-pair.bas -o tests/codegen/wchrconstsurrogatepair.exe
'' ENV: TIKO_LIBPATH=build/obj/rtlib/windows-x86_64
'' EXPECT-EXIT: 0
'' RUN: tests/codegen/wchrconstsurrogatepair.exe
'' EXPECT-RUN-EXIT: 0
'' EXPECT-RUN-OUT:  2             DBFF          DFFF
'' EXPECT-RUN-OUT:  2            D83D          DE00
'' EXPECT-RUN-OUT:  1            FFFF
