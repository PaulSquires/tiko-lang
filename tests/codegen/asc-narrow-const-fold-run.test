'' 'asc( S, n )' over a NARROW constant folds too, past an embedded NUL: a NUL inside the literal does not stop it
'' (string/asc.bas); the runtime stopped at the NUL.
'' TEST: cli
'' ARGS: -target windows-x86_64 tests/codegen/src/asc-narrow-const-fold.bas -o tests/codegen/ascnarrowconstfold.exe
'' ENV: TKO_LIBPATH=toolchains/tiko-windows/lib/windows-x86_64
'' EXPECT-EXIT: 0
'' RUN: tests/codegen/ascnarrowconstfold.exe
'' EXPECT-RUN-EXIT: 0
'' EXPECT-RUN-OUT: 0              65            0             66            0             65
'' EXPECT-RUN-OUT: 121
'' EXPECT-RUN-OUT: 113
