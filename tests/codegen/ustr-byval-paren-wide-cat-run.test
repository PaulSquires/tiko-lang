'' TE-011, RUN: a PARENTHESISED concatenation over a 'wstring * 260' array element, passed to a
'' 'byval as ustring' (and a 'byval as string') parameter, was TKO0994. Expected output is
'' fbc-modern 1.20's, byte for byte.
'' TEST: cli
'' ARGS: -target windows-x86_64 tests/codegen/src/ustr-byval-paren-wide-cat.tiko -o tests/codegen/ustrbyvalparenwcat.exe
'' ENV: TKO_LIBPATH=build/obj/rtlib/windows-x86_64
'' EXPECT-EXIT: 0
'' RUN: tests/codegen/ustrbyvalparenwcat.exe
'' EXPECT-RUN-EXIT: 0
'' EXPECT-RUN-OUT: [one:]  4
'' EXPECT-RUN-OUT: [one:]  4
'' EXPECT-RUN-OUT: [two-one]  7
'' EXPECT-RUN-OUT: [utwo]  4
'' EXPECT-RUN-OUT: {one!}
