'' ENV: TKO_LIBPATH=toolchains/tiko-windows/lib/windows-x86_64
'' EXPECT-EXIT: 0
'' RUN: tests/codegen/selfopfixstrcopyback.exe
'' EXPECT-RUN-EXIT: 0
'' EXPECT-RUN-OUT: [MOD]
'' EXPECT-RUN-OUT: [MOD]
