'' AN ARRAY NAMED BARE AS A GRAPHICS TARGET -- 'line array, ...', 'pset array, ...' -- is its
'' storage: a fixed array's own bytes, a dynamic one's first element, of any element type
'' (fbc's gfx/image-expr.bas). tiko declined every one. Output identical to fbc-modern's, on a
'' GFX_NULL screen.
'' TEST: cli
'' ARGS: -target windows-x86_64 tests/codegen/src/gfx-array-target.bas -o tests/codegen/gfxarraytarget.exe
'' ENV: TIKO_LIBPATH=build/obj/rtlib/windows-x86_64
'' ENV: TIKO_INCLUDE=toolchains/tiko-windows/inc
'' EXPECT-EXIT: 0
'' RUN: tests/codegen/gfxarraytarget.exe
'' EXPECT-RUN-EXIT: 0
'' EXPECT-RUN-OUT: FFFF0000      FFFF0000
'' EXPECT-RUN-OUT: FF0000FF      FF0000FF
'' EXPECT-RUN-OUT: FF000000      FF00FF00
'' EXPECT-RUN-OUT: FF010203
