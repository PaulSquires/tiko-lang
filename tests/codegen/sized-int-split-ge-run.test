'' The sized integer spellings, 'integer<8>= -128' with the '>=' split among them. The split
'' rewrites the shared token, so a backtracking parse now reads the flagged '=' as the '>'
'' it was (audit F-72, PAR-11).
'' TEST: cli
'' ARGS: -target win64-msvc tests/codegen/src/sized-int-split-ge.bas -o tests/codegen/sizedintsplitge.exe
'' ENV: TKO_LIBPATH=toolchains/tiko-windows/lib/win64-msvc
'' EXPECT-EXIT: 0
'' RUN: tests/codegen/sizedintsplitge.exe
'' EXPECT-RUN-EXIT: 0
'' EXPECT-RUN-OUT: -128
'' EXPECT-RUN-OUT:  5
'' EXPECT-RUN-OUT:  44
'' EXPECT-RUN-OUT:  8
