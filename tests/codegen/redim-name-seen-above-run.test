'' EXPECT-RUN-EXIT: 0
'' EXPECT-RUN-OUT:  0             -1             1             1
'' EXPECT-RUN-OUT:  0            -1             2             2
'' EXPECT-RUN-OUT:  0            -1             2             2
'' EXPECT-RUN-OUT:  0            -1             4             4
'' EXPECT-RUN-OUT:  0            -1             4             4
