'' An anonymous type or union is padded to its own alignment: (short, byte) inside a union is 4
'' bytes, so the field after it sits at 4 (structs/anon-align.bas); tiko had 3.
'' TEST: cli
'' ARGS: -target windows-x86_64 tests/codegen/src/anon-group-padding.bas -o tests/codegen/anongrouppadding.exe
'' ENV: TKO_LIBPATH=build/obj/rtlib/windows-x86_64
'' EXPECT-EXIT: 0
'' RUN: tests/codegen/anongrouppadding.exe
'' EXPECT-RUN-EXIT: 0
'' EXPECT-RUN-OUT:  6              4
'' EXPECT-RUN-OUT:  24            16
'' EXPECT-RUN-OUT:  6             2             4
