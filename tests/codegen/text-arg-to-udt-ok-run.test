'' ...and a UDT that a constructor from 'string' or 'wstring' builds still takes every text
'' argument, byref and byval, with the value fbc-modern 1.20 prints.
'' TEST: cli
'' ARGS: -target windows-x86_64 tests/codegen/src/text-arg-to-udt-ok.tiko -o tests/codegen/textargudtok.exe
'' ENV: TKO_LIBPATH=build/obj/rtlib/windows-x86_64
'' EXPECT-EXIT: 0
'' EXPECT-FILE: tests/codegen/textargudtok.exe
'' RUN: tests/codegen/textargudtok.exe
'' EXPECT-RUN-OUT: u 1111
'' EXPECT-RUN-OUT: w 1111
'' EXPECT-RUN-OUT: z 1111
'' EXPECT-RUN-OUT: fs 4444
