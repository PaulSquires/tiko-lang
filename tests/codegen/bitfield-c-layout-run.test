'' RUN: 'type T extern "c"' records lay out by MSVC's bit-field rule on windows-x86_64 --
'' a new unit whenever the declared type's size changes, '#pragma pack' capping the record's
'' alignment -- and every read and write goes through the right unit. Output identical to a
'' clang-compiled C twin of the same records (x86_64-pc-windows-msvc).
'' TEST: cli
'' ARGS: -target windows-x86_64 tests/codegen/src/bitfield-c-layout.bas -o tests/codegen/bitfieldclayout.exe
'' ENV: TKO_LIBPATH=toolchains/tiko-windows/lib/windows-x86_64
'' EXPECT-EXIT: 0
'' RUN: tests/codegen/bitfieldclayout.exe
'' EXPECT-RUN-EXIT: 0
'' EXPECT-RUN-OUT: bf_mixed 8
'' EXPECT-RUN-OUT: bf_mixed a 0500000000000000 5
'' EXPECT-RUN-OUT: bf_mixed b 0000000016000000 22
'' EXPECT-RUN-OUT: bf_mixed all fefffffffbffffff
'' EXPECT-RUN-OUT: bf_mixed all.a 6
'' EXPECT-RUN-OUT: bf_mixed all.b 27
'' EXPECT-RUN-OUT: bf_short_gap 8
'' EXPECT-RUN-OUT: bf_short_gap s 0d00000000000000 13
'' EXPECT-RUN-OUT: bf_short_gap c 0000b60000000000 182
'' EXPECT-RUN-OUT: bf_short_gap i 000000005b000000 91
'' EXPECT-RUN-OUT: bf_short_gap all f6ffdbffedffffff
'' EXPECT-RUN-OUT: bf_short_gap all.s 6
'' EXPECT-RUN-OUT: bf_short_gap all.c 219
'' EXPECT-RUN-OUT: bf_short_gap all.i 109
