'' sizeof of a wide constant -- wstr( "hello" ), a const over it, a type's const -- is
'' (chars + 1) * wchar, 12 on Windows (quirk/len-sizeof-udt-member.bas).
'' TEST: cli
'' ARGS: -target win64-msvc tests/codegen/src/wide-const-sizeof.bas -o tests/codegen/wideconstsizeof.exe
'' ENV: TKO_LIBPATH=toolchains/tiko-windows/lib/win64-msvc
'' EXPECT-EXIT: 0
'' RUN: tests/codegen/wideconstsizeof.exe
'' EXPECT-RUN-EXIT: 0
'' EXPECT-RUN-OUT:  12             12            12            5             5
