'' A BARE LIBRARY NAME ON AN ELF TARGET is lib<name>.so: 'lib/gammart' is looked for as
'' lib/libgammart.so, which the package does not hold (only gammart.dll is written), so the build
'' stops before anything is compiled -- which is also what lets a Windows host test it.
'' TEST: cli
'' ENV: TIKO_LIBPATH=build/obj/rtlib/windows-x86_64
'' ENV: TIKO_PKG=build/.vre/pkg
'' ENV: TIKO_MODCACHE=build/.vre/mc
'' CLEAN: build/.vre
'' COPY: tests/modules/src/vrt/pkg => build/.vre/pkg
'' WRITE: build/.vre/pkg/vendor/gamma/fonts/gamma.ttf :: a font\n
'' WRITE: build/.vre/pkg/vendor/gamma/lib/gammart.dll :: a library the program loads itself\n
'' ARGS: -target linux-x86_64 tests/modules/src/vrt/app/gamma.tiko -o build/.vre/gamma
'' EXPECT-EXIT: 1
'' EXPECT-OUT: error TKO0176: module 'vendor.gamma' needs 'lib/gammart' at run time, and there is no 'build/.vre/pkg/vendor/gamma/lib/libgammart.so'
'' EXPECT-NO-FILE: build/.vre/gamma
