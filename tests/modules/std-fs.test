'' EXPECT-EXIT: 0
'' RUN: tests/modules/stdfs.exe
'' EXPECT-RUN-OUT: -1 false
'' EXPECT-RUN-OUT: c .txt b a
'' EXPECT-RUN-OUT: 2 y.z
