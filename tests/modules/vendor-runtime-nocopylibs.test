'' '-nocopylibs' turns the runtime copy off with the library copy: the program builds and
'' nothing goes beside it.
'' TEST: cli
'' ENV: TIKO_LIBPATH=build/obj/rtlib/windows-x86_64
'' ENV: TIKO_PKG=build/.vrx/pkg
'' ENV: TIKO_MODCACHE=build/.vrx/mc
'' CLEAN: build/.vrx
'' COPY: tests/modules/src/vrt/pkg => build/.vrx/pkg
'' WRITE: build/.vrx/pkg/vendor/gamma/fonts/gamma.ttf :: a font\n
'' WRITE: build/.vrx/pkg/vendor/gamma/lib/gammart.dll :: a library the program loads itself\n
'' ARGS: -target windows-x86_64 -nocopylibs tests/modules/src/vrt/app/gamma.tiko -o build/.vrx/gamma.exe
'' EXPECT-EXIT: 0
'' EXPECT-FILE: build/.vrx/gamma.exe
'' EXPECT-NO-FILE: build/.vrx/gamma.ttf
'' EXPECT-NO-FILE: build/.vrx/gammart.dll
