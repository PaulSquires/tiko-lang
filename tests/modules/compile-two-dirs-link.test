'' TWO '-c' OBJECTS FROM TWO DIRECTORIES, ONE MODULE (tiko-build B0, 2026-10-11). a.o and b.o
'' each name their own 'acme.util.o' in a '-tkomod' record. The link told records apart by
'' path, so it took both copies and failed on duplicate symbols; it takes one per module now.
'' The root imports nothing, so the module comes from the records alone (compile-mixed-link
'' covers a root that imports it too).
'' TEST: cli
'' ENV: TKO_MODCACHE=build/.mct-2dir/cache
'' ENV: TKO_LIBPATH=toolchains/tiko-windows/lib/win64-msvc
'' CLEAN: build/.mct-2dir
'' CLEAN: build/.mct-2dir/one
'' CLEAN: build/.mct-2dir/two
'' STEP: -c -target win64-msvc -i tests/modules/src/mixed/libs tests/modules/src/mixed/app/a.bas -o build/.mct-2dir/one/a.o
'' STEP: -c -target win64-msvc -i tests/modules/src/mixed/libs tests/modules/src/mixed/app/b.bas -o build/.mct-2dir/two/b.o
'' ARGS: -m plain -target win64-msvc tests/modules/src/mixed/app/plain.bas build/.mct-2dir/one/a.o build/.mct-2dir/two/b.o -o build/.mct-2dir/app.exe
'' EXPECT-EXIT: 0
'' EXPECT-NOT: duplicate symbol
'' RUN: build/.mct-2dir/app.exe
'' EXPECT-RUN-OUT: a: 4
'' EXPECT-RUN-OUT: b: 6
'' EXPECT-RUN-OUT: plain
