'' 'std' IS NOT SHADOWABLE (RFC-0007 §3): -i names a directory holding a package called std,
'' whose strings.Repeat says SHADOWED; the program still gets the toolchain's.
'' TEST: cli
'' ARGS: -target windows-x86_64 -i toolchains/tiko-windows/inc -i tests/modules/src/stduse/roots tests/modules/src/stduse/main.bas -o tests/modules/stdshadow.exe
'' ENV: TIKO_LIBPATH=build/obj/rtlib/windows-x86_64
'' EXPECT-EXIT: 0
'' RUN: tests/modules/stdshadow.exe
'' EXPECT-RUN-OUT:  4 abc
'' EXPECT-RUN-OUT: true          true          false
'' EXPECT-RUN-OUT: a+b+c ababab
'' EXPECT-RUN-OUT: okit 007
'' EXPECT-RUN-OUT: c.txt .txt a/b
'' EXPECT-RUN-OUT: false true a\b
