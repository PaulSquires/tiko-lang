'' TWO VENDOR PACKAGES, TWO MODES (RFC-0002 V12): alpha dynamic and beta static in one
'' program. Each carried header is re-read with ITS module's TIKO_LINK_* defined around it
'' and undefined after, so neither sees the other's.
'' TEST: cli
'' ENV: TKO_LIBPATH=build/obj/rtlib/windows-x86_64
'' ENV: TKO_PKG=build/.vlm/pkg
'' ENV: TKO_MODCACHE=build/.vlm/mc
'' CLEAN: build/.vlm
'' COPY: tests/modules/src/vlink/pkg => build/.vlm/pkg
'' STEP: -target windows-x86_64 -lib tests/modules/src/vlink/libsrc/alpha_static.tiko -o build/.vlm/pkg/vendor/alpha/lib/alpha_windows_x86_64.a
'' STEP: -target windows-x86_64 -dll tests/modules/src/vlink/libsrc/alpha_dynamic.tiko -o build/.vlm/pkg/vendor/alpha/lib/alpha_windows_x86_64.dll
'' STEP: -target windows-x86_64 -lib tests/modules/src/vlink/libsrc/beta_static.tiko -o build/.vlm/pkg/vendor/beta/lib/beta_windows_x86_64.a
'' ARGS: -target windows-x86_64 tests/modules/src/vlink/app/mixed.tiko -o build/.vlm/mixed.exe
'' EXPECT-EXIT: 0
'' RUN: build/.vlm/mixed.exe
'' EXPECT-RUN-OUT:  2             alpha header: dynamic
'' EXPECT-RUN-OUT:  10           beta header: static
