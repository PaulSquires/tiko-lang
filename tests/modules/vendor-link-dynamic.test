'' 'link dynamic' (RFC-0002 V4-V7, V13): the DLL is linked and copied beside the program,
'' under the name it gives itself, so the program starts (alpha_id 2).
'' TEST: cli
'' ENV: TKO_LIBPATH=toolchains/tiko-windows/lib/windows-x86_64
'' ENV: TKO_PKG=build/.vld/pkg
'' ENV: TKO_MODCACHE=build/.vld/mc
'' CLEAN: build/.vld
'' COPY: tests/modules/src/vlink/pkg => build/.vld/pkg
'' STEP: -target windows-x86_64 -lib tests/modules/src/vlink/libsrc/alpha_static.tiko -o build/.vld/pkg/vendor/alpha/lib/alpha_windows_x86_64.a
'' STEP: -target windows-x86_64 -dll tests/modules/src/vlink/libsrc/alpha_dynamic.tiko -o build/.vld/pkg/vendor/alpha/lib/alpha_windows_x86_64.dll
'' STEP: -target windows-x86_64 -lib tests/modules/src/vlink/libsrc/beta_static.tiko -o build/.vld/pkg/vendor/beta/lib/beta_windows_x86_64.a
'' ARGS: -target windows-x86_64 tests/modules/src/vlink/app/dynamic.tiko -o build/.vld/dynamic.exe
'' EXPECT-EXIT: 0
'' EXPECT-FILE: build/.vld/alpha_windows_x86_64.dll
'' RUN: build/.vld/dynamic.exe
'' EXPECT-RUN-OUT:  2             alpha header: dynamic
