'' 'public #cinclude' IN A MODULE (book work item T101): the binding travels with the module's
'' interface, so an importer that never wrote #cinclude names geo.h's struct, its #define
'' constant and its C function bare, as if it had #cinclude'd the header itself.
'' TEST: cli
'' ARGS: -target windows-x86_64 --no-module-cache -ccachedir build/.cpub -i tests/modules/src/cpub/libs tests/modules/src/cpub/app/main.bas -o tests/modules/cincludepublic.exe
'' ENV: TIKO_LIBPATH=build/obj/rtlib/windows-x86_64
'' CLEAN: build/.cpub
'' EXPECT-EXIT: 0
'' RUN: tests/modules/cincludepublic.exe
'' EXPECT-RUN-OUT:  7
