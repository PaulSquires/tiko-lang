'' std/logs, a real module since 2026-10-10 (it was a facade over fb/logging.bi): a LogLevel
'' and its members, LevelName, LevelNameShort, LevelFromName; the default logger -- the
'' module's own object, so no FB_LOG_IMPLEMENT -- through an AsyncSink drained on shutdown;
'' and the exported macros of fb/logmacros.bi, now logs.LogInfo and logs.LogEventWarn, with
'' the call site this file's, and LogDebug filtered at run time.
'' TEST: cli
'' ARGS: -target windows-x86_64 -i toolchains/tiko-windows/inc tests/modules/src/stdfacade/logs.bas -o tests/modules/stdlogs.exe
'' ENV: TKO_LIBPATH=build/obj/rtlib/windows-x86_64
'' EXPECT-EXIT: 0
'' RUN: tests/modules/stdlogs.exe
'' EXPECT-RUN-OUT: WARN ERR
'' EXPECT-RUN-OUT: true -1
'' EXPECT-RUN-OUT: INFO   via the module  n=7
'' EXPECT-RUN-OUT: INFO   by the macro  (tests/modules/src/stdfacade/logs.bas:20 __FB_MAINPROC__)
'' EXPECT-RUN-OUT: WARN   an event  code=3  (tests/modules/src/stdfacade/logs.bas:21 __FB_MAINPROC__)
'' EXPECT-RUN-OUT: dropped0
