'' A BLOCK STRING THROUGH A MODULE INTERFACE. The interface is text: a public const and a
'' generic body holding block strings are written into it and re-lexed by the importer, so
'' each literal must spell back as ONE escaped line with its newline, '"' and '\' intact
'' (pp.bas BlockSpelling_).
'' TEST: cli
'' ARGS: -target windows-x86_64 -i tests/modules/src/blockstr/libs tests/modules/src/blockstr/app/main.bas -o tests/modules/blockstr.exe
'' ENV: TKO_LIBPATH=toolchains/tiko-windows/lib/windows-x86_64
'' EXPECT-EXIT: 0
'' EXPECT-FILE: tests/modules/blockstr.exe
'' RUN: tests/modules/blockstr.exe
'' EXPECT-RUN-OUT: usage: tool "x"|  -p  C:\path 29
'' EXPECT-RUN-OUT: <tag>7 6
