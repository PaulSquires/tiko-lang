'' NO 'link' (RFC-0002 V5): no TIKO_LINK_* anywhere, and the package's own '#else' decides --
'' alpha's is dynamic. Its header, re-read by the importer, sees no mode either.
'' TEST: cli
'' ENV: TKO_LIBPATH=build/obj/rtlib/windows-x86_64
'' ENV: TKO_PKG=build/.vlo/pkg
'' ENV: TKO_MODCACHE=build/.vlo/mc
'' CLEAN: build/.vlo
'' COPY: tests/modules/src/vlink/pkg => build/.vlo/pkg
'' STEP: -target windows-x86_64 -lib tests/modules/src/vlink/libsrc/alpha_static.tiko -o build/.vlo/pkg/vendor/alpha/lib/alpha_windows_x86_64.a
'' STEP: -target windows-x86_64 -dll tests/modules/src/vlink/libsrc/alpha_dynamic.tiko -o build/.vlo/pkg/vendor/alpha/lib/alpha_windows_x86_64.dll
'' STEP: -target windows-x86_64 -lib tests/modules/src/vlink/libsrc/beta_static.tiko -o build/.vlo/pkg/vendor/beta/lib/beta_windows_x86_64.a
'' ARGS: -target windows-x86_64 tests/modules/src/vlink/app/omitted.tiko -o build/.vlo/omitted.exe
'' EXPECT-EXIT: 0
'' RUN: build/.vlo/omitted.exe
'' EXPECT-RUN-OUT:  2             alpha header: no mode
