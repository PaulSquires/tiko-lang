'' AN EXPLICIT 'link' BEATS AN OMITTED ONE (RFC-0002 V5): two roots import alpha, one with
'' 'link static' and one without; alpha is linked statically for both.
'' TEST: cli
'' ENV: TKO_LIBPATH=toolchains/tiko-windows/lib/windows-x86_64
'' ENV: TKO_PKG=build/.vlx/pkg
'' ENV: TKO_MODCACHE=build/.vlx/mc
'' CLEAN: build/.vlx
'' COPY: tests/modules/src/vlink/pkg => build/.vlx/pkg
'' STEP: -target windows-x86_64 -lib tests/modules/src/vlink/libsrc/alpha_static.tiko -o build/.vlx/pkg/vendor/alpha/lib/alpha_windows_x86_64.a
'' STEP: -target windows-x86_64 -dll tests/modules/src/vlink/libsrc/alpha_dynamic.tiko -o build/.vlx/pkg/vendor/alpha/lib/alpha_windows_x86_64.dll
'' STEP: -target windows-x86_64 -lib tests/modules/src/vlink/libsrc/beta_static.tiko -o build/.vlx/pkg/vendor/beta/lib/beta_windows_x86_64.a
'' ARGS: -target windows-x86_64 tests/modules/src/vlink/app/static.tiko tests/modules/src/vlink/app/omitted2.tiko -o build/.vlx/both.exe
'' EXPECT-EXIT: 0
'' EXPECT-NO-FILE: build/.vlx/alpha_windows_x86_64.dll
'' RUN: build/.vlx/both.exe
'' EXPECT-RUN-OUT:  1             alpha header: static
