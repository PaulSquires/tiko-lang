'' The committed vendor/pl_mpeg header -- pl_mpeg.ti, translated by 'tiko c2t' from the declaration
'' half of pl_mpeg.h (c871f2b, patched), and its residue -- as an importer reads it: no library
'' needed. It names the frame and sample records, both decode callbacks, the FILE ptr routine the
'' patch made compile, the demuxer with a residue packet type, and a conversion.
#include once "../../../../pkg/vendor/pl_mpeg/pl_mpeg.ti"
#include once "../../../../pkg/vendor/pl_mpeg/pl_mpeg-residue.ti"

private sub OnVideo cdecl( byval plm as plm_t ptr, byval frame as plm_frame_t ptr, byval user as any ptr )
    print frame->time, frame->y.width, frame->cb.height, frame->cr.data[0]
end sub

private sub OnAudio cdecl( byval plm as plm_t ptr, byval samples as plm_samples_t ptr, byval user as any ptr )
    print samples->time, samples->count, samples->interleaved(PLM_AUDIO_SAMPLES_PER_FRAME * 2 - 1)
end sub

dim as plm_t ptr plm = plm_create_with_filename( "x.mpg" )
plm_set_video_decode_callback( plm, @OnVideo, nullptr )
plm_set_audio_decode_callback( plm, @OnAudio, nullptr )
plm_set_audio_lead_time( plm, 0.1 )
print plm_get_width( plm ), plm_get_framerate( plm ), plm_get_samplerate( plm ), plm_get_duration( plm )
plm_decode( plm, 1 / 25 )
dim as plm_frame_t ptr f = plm_seek_frame( plm, 1.0, 1 )
dim as uint8 rgb(0 to 320 * 240 * 3 - 1)
if f then plm_frame_to_rgb( f, @rgb(0), 320 * 3 )
print plm_has_ended( plm )
plm_destroy( plm )
dim as plm_t ptr p2 = plm_create_with_file( fopen( "x.mpg", "rb" ), 1 )
plm_destroy( p2 )
dim as plm_buffer_t ptr buf = plm_buffer_create_with_capacity( PLM_BUFFER_DEFAULT_SIZE )
dim as plm_demux_t ptr dmx = plm_demux_create( buf, 0 )
print plm_demux_get_start_time( dmx, PLM_DEMUX_PACKET_VIDEO_1 ), PLM_DEMUX_PACKET_AUDIO_1, sizeof( plm_samples_t )
plm_demux_destroy( dmx )
