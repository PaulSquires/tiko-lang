'' TE-010: vendor/PsControls helpers that hosts call are public -- PsColorPicker_ContrastColor
'' (public API in the PsControls README) and PsListTree's GetListTreePointer (as PsCalendar's
'' GetCalendarPointer is).
#import "sys/win"
#import "vendor/PsControls/PsColorPicker"
#import "vendor/PsControls/PsListTree"
#import "vendor/PsControls/PsCalendar"

dim as COLORREF c = PsColorPicker.PsColorPicker_ContrastColor( BGR( 0, 0, 0 ) )
dim as PsListTree.PSLISTTREE_STATE ptr pList = PsListTree.GetListTreePointer( NULL )
dim as PsCalendar.PSCALENDAR_STATE ptr pCal = PsCalendar.GetCalendarPointer( NULL )
print c, pList, pCal
