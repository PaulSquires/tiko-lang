'' A module exporting types with auto-properties (autoprop-iface.test), one of them generic.
#module "shapes"
public type Pt
    declare property X as long get, set
    declare property Label as string = "pt" get, private set
    declare sub Rename( byval s as string )
    declare static property Made as long = 5 get, private set
end type
sub Pt.Rename( byval s as string )
    this.Label = s
    Made += 1
end sub
public type Box( of T )
    declare property V as T get, set
end type
public sub Show( byref p as Pt )
    print p.Label; p.X
end sub
