'' The committed vendor/libssh2 headers -- libssh2.ti, libssh2_sftp.ti and libssh2_publickey.ti,
'' translated by 'tiko c2t' from libssh2 1.11.1's headers -- and the hand-written
'' libssh2-residue.ti, as an importer reads them: no library needed. Names every residue item
'' (Windows' handshake and socket type, scp_send64, the scp stat record where it is declared,
'' the banners, each convenience macro, the S_IS tests) and one routine from each header.
#include once "../../../../pkg/vendor/libssh2/libssh2.ti"
#include once "../../../../pkg/vendor/libssh2/libssh2_sftp.ti"
#include once "../../../../pkg/vendor/libssh2/libssh2_publickey.ti"
#include once "../../../../pkg/vendor/libssh2/libssh2-residue.ti"
dim as LIBSSH2_SESSION ptr s = libssh2_session_init( )
dim as libssh2_socket_t sock
dim as int32 rc = libssh2_session_handshake( s, sock )
rc = libssh2_userauth_password( s, "user", "pass" )
dim as LIBSSH2_CHANNEL ptr ch = libssh2_channel_open_session( s )
rc = libssh2_channel_exec( ch, "true" ) + libssh2_channel_shell( ch ) + libssh2_channel_subsystem( ch, "sftp" )
rc += libssh2_channel_request_pty( ch, "vt100" ) + libssh2_channel_x11_req( ch, 0 )
dim as culong wr = libssh2_channel_window_read( ch ) + libssh2_channel_window_write( ch )
dim as LIBSSH2_LISTENER ptr l = libssh2_channel_forward_listen( s, 8022 )
ch = libssh2_scp_send64( s, "/tmp/x", &o644, 10, 0, 0 )
#if defined(TIKO_OS_WINDOWS) or defined(TIKO_OS_LINUX)
dim as libssh2_scp_stat st
ch = libssh2_scp_recv2( s, "/tmp/x", cast( libssh2_struct_stat ptr, @st ) )
print sizeof( st ), offsetof( libssh2_scp_stat, st_size ), st.st_mode, st.st_mtime
#endif
dim as LIBSSH2_SFTP ptr sf = libssh2_sftp_init( s )
dim as LIBSSH2_SFTP_HANDLE ptr h = libssh2_sftp_open_ex( sf, "d", 1, 0, 0, LIBSSH2_SFTP_OPENDIR )
dim as zstring * 256 nm
dim as LIBSSH2_SFTP_ATTRIBUTES at
rc = libssh2_sftp_readdir( h, @nm, 256, @at )
print LIBSSH2_SFTP_S_ISDIR( at.permissions ), LIBSSH2_SFTP_S_ISREG( at.permissions ), LIBSSH2_SFTP_S_ISLNK( at.permissions )
print LIBSSH2_SFTP_S_ISCHR( 0 ), LIBSSH2_SFTP_S_ISBLK( 0 ), LIBSSH2_SFTP_S_ISFIFO( 0 ), LIBSSH2_SFTP_S_ISSOCK( 0 )
dim as LIBSSH2_PUBLICKEY ptr pk = libssh2_publickey_init( s )
print LIBSSH2_SSH_BANNER, LIBSSH2_SSH_DEFAULT_BANNER_WITH_CRLF, *libssh2_version( 0 ), wr, l <> nullptr, pk <> nullptr
libssh2_session_free( s )
