'' std/tasks 'using'd, and the PROGRAM'S OWN CONTEXT: its own declaration beats the using,
'' as fbc's lookup does, and so does its own '#include once "windows.bi"'.
#import "std/tasks"
#include once "windows.bi"
using tasks
dim w as Context
dim c as tasks.Context
print sizeof( w ) > 100; c.IsCancelled( )
