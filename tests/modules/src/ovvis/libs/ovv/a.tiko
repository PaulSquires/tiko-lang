'' The public overloads: 'operator =' on T, and Show( long ) made public by its 'declare'.
#module "ovv"

public type T
    v as long
end type

public operator = ( byref a as T, byref b as T ) as boolean
    return a.v = b.v
end operator

public declare sub Show overload ( byval n as long )

sub Show( byval n as long )
    print "long"; n
end sub
