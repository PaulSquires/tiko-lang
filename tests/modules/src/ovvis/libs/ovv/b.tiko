'' The private overloads of the same two names, each reached only from inside the module.
#module "ovv"

public type U
    w as long
end type

private operator = ( byref a as U, byref b as U ) as boolean
    return a.w = b.w
end operator

private sub Show overload ( byref s as string )
    print "string "; s
end sub

public function SameU( byval x as long, byval y as long ) as boolean
    dim as U a, b
    a.w = x
    b.w = y
    Show( "inside" )
    return a = b
end function
