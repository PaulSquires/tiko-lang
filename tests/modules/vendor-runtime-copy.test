'' [vendor.<module>] runtime: each listed file of an imported module is copied flat beside
'' the program -- a font by its path, and 'lib/gammart', which has no extension, as the
'' shared library a Windows target names gammart.dll.
'' TEST: cli
'' ENV: TKO_LIBPATH=build/obj/rtlib/windows-x86_64
'' ENV: TKO_PKG=build/.vrc/pkg
'' ENV: TKO_MODCACHE=build/.vrc/mc
'' CLEAN: build/.vrc
'' COPY: tests/modules/src/vrt/pkg => build/.vrc/pkg
'' WRITE: build/.vrc/pkg/vendor/gamma/fonts/gamma.ttf :: a font\n
'' WRITE: build/.vrc/pkg/vendor/gamma/lib/gammart.dll :: a library the program loads itself\n
'' ARGS: -target windows-x86_64 tests/modules/src/vrt/app/gamma.tiko -o build/.vrc/gamma.exe
'' EXPECT-EXIT: 0
'' EXPECT-FILE: build/.vrc/gamma.ttf
'' EXPECT-FILE: build/.vrc/gammart.dll
'' EXPECT-NO-FILE: build/.vrc/libgammart.so
'' RUN: build/.vrc/gamma.exe
'' EXPECT-RUN-OUT: 7
