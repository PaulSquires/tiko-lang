'' '-nocopylibs' (RFC-0002 V13): the program links dynamically and nothing is copied.
'' TEST: cli
'' ENV: TIKO_LIBPATH=build/obj/rtlib/windows-x86_64
'' ENV: TIKO_PKG=build/.vln/pkg
'' ENV: TIKO_MODCACHE=build/.vln/mc
'' CLEAN: build/.vln
'' COPY: tests/modules/src/vlink/pkg => build/.vln/pkg
'' STEP: -target windows-x86_64 -lib tests/modules/src/vlink/libsrc/alpha_static.tiko -o build/.vln/pkg/vendor/alpha/lib/alpha_windows_x86_64.a
'' STEP: -target windows-x86_64 -dll tests/modules/src/vlink/libsrc/alpha_dynamic.tiko -o build/.vln/pkg/vendor/alpha/lib/alpha_windows_x86_64.dll
'' STEP: -target windows-x86_64 -lib tests/modules/src/vlink/libsrc/beta_static.tiko -o build/.vln/pkg/vendor/beta/lib/beta_windows_x86_64.a
'' ARGS: -target windows-x86_64 -nocopylibs tests/modules/src/vlink/app/dynamic.tiko -o build/.vln/dynamic.exe
'' EXPECT-EXIT: 0
'' EXPECT-FILE: build/.vln/dynamic.exe
'' EXPECT-NO-FILE: build/.vln/alpha_windows_x86_64.dll
