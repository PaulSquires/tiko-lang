'' The binding of refused.h: each refused record that a pointer reaches gets an alias that
'' introduces it ('X__fwd'), a pointer to it keeps its name and its const, and the inline
'' 'time' -- which writes nothing -- is not in the rename ledger.
'' TEST: cli
'' ARGS: -cimport tests/cimport/src/refused.h -cimport-out -
'' EXPECT-EXIT: 0
'' EXPECT-OUT: type ref_over__fwd as ref_over
'' EXPECT-OUT: type ref_pun__fwd as ref_pun
'' EXPECT-OUT: type ref_late__fwd as ref_late
'' EXPECT-OUT: declare sub ref_use cdecl alias "ref_use" ( byval p as ref_over ptr )
'' EXPECT-OUT: declare sub ref_use_const cdecl alias "ref_use_const" ( byval p as const ref_pun ptr )
'' EXPECT-OUT: o as ref_over ptr
'' EXPECT-OUT: declare sub ref_early cdecl alias "ref_early" ( byval p as ref_late__ptr )
'' EXPECT-NOT: names were changed
