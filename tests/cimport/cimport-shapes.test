'' -cimport writes a binding: the shapes a header is made of, for every target. The
'' expectations are shapes.h's own declarations, which are the same for all three; what
'' each target's system headers add is build/cimportdiff.sh's to compare with fbc-modern.
''
'' A forward reference through a hoisted alias, the opaque handle C meant, a string, a
'' fixed char array, a 2-D array, anonymous union and struct members, procedure-pointer
'' types, #pragma pack, over-alignment, enums, a variadic, and names FreeBASIC reserves.
'' TEST: cli
'' ARGS: -cimport tests/cimport/src/shapes.h -cimport-out -
'' EXPECT-EXIT: 0
'' EXPECT-OUT: '' Generated by tiko -cimport. Do not edit.
'' EXPECT-OUT: procedure  print -> print_  (FreeBASIC reserved)
'' EXPECT-OUT: type later__ptr as later ptr
'' EXPECT-OUT: next as later__ptr
'' EXPECT-OUT: back as uses_later ptr
'' EXPECT-OUT: type handle_t as any ptr
'' EXPECT-OUT: fixed as zstring const ptr
'' EXPECT-OUT: buf as zstring * 16
'' EXPECT-OUT: grid(0 to 2, 0 to 3) as long
'' EXPECT-OUT: type variant_pair_t extern "c"
'' EXPECT-OUT: union anon_host extern "c"
'' EXPECT-OUT: type compare_fn as function cdecl( byval as const any ptr, byval as const any ptr ) as long
'' EXPECT-OUT: type notify_fn as sub cdecl( byval as any ptr, byval as long, ... )
'' EXPECT-OUT: cmp as compare_fn
'' EXPECT-OUT: type packed1 field = 1
'' EXPECT-OUT: SHAPES_TWO = 2
'' EXPECT-OUT: NEG = -5
'' EXPECT-OUT: declare function shapes_log cdecl alias "shapes_log" ( byval level as long, byval fmt as const zstring ptr, ... ) as long
'' EXPECT-OUT: declare sub shapes_sort cdecl alias "shapes_sort" ( byval base_ as any ptr, byval n as size_t, byval size as size_t, byval cmp as compare_fn )
'' EXPECT-OUT: extern shapes_version alias "shapes_version" as const zstring const ptr
'' EXPECT-OUT: extern shapes_table(0 to 7) alias "shapes_table" as long
'' EXPECT-OUT: declare function print_ cdecl alias "print" ( byval s as const zstring ptr ) as long
'' EXPECT-OUT: mod_ as long
'' EXPECT-OUT[win64]: type mode_t2 as ulong
'' EXPECT-OUT[windows-x86_64]: type mode_t2 as long
'' EXPECT-OUT[linux-x86_64]: type mode_t2 as ulong
'' EXPECT-NOT: error TKO
