'' Every imported record is laid out by tiko and compared with clang's layout; one that
'' differs is refused with the difference in the ledger, and whatever holds it by value
'' goes with it -- the rest of the binding is still written. See src/layout.h.
''
'' Every record is written 'extern "c"', so tiko lays it out by the target's C rule: the
'' bit-fields of lay_bits share a unit with 'tail' on linux-x86_64 and not on Windows, and a
'' packed record embeds at C's offset 1 -- both kept everywhere. An over-aligned record is
'' kept, its size padded to C's. A member over-aligned by an attribute has no FreeBASIC
'' spelling and is refused on every target; a '#pragma pack' that changes no alignment is
'' invisible to the importer and refused where it moved a bit-field -- linux-x86_64 only.
'' TEST: cli
'' ARGS: -cimport tests/cimport/src/layout.h -cimport-out -
'' EXPECT-EXIT: 0
'' EXPECT-OUT: struct    lay_member_aligned          tiko lays it out in 20 bytes aligned to 4, clang in 32 aligned to 16; member 'x' is at bit 32 in tiko's layout and bit 128 in clang's
'' EXPECT-OUT: struct    lay_holds_aligned           field 'm': uses 'lay_member_aligned', which was skipped
'' EXPECT-OUT: type lay_bits extern "c"
'' EXPECT-OUT: type lay_holds_bits extern "c"
'' EXPECT-OUT: type lay_points_bits extern "c"
'' EXPECT-OUT: b as lay_bits ptr
'' EXPECT-OUT: type lay_packed field = 1 extern "c"
'' EXPECT-OUT: type lay_holds_packed extern "c"
'' EXPECT-OUT: type lay_holds_packed4 extern "c"
'' EXPECT-OUT: __cimport_pad(0 to 7) as ubyte
'' EXPECT-OUT: type lay_plain extern "c"
'' EXPECT-NOT: type lay_member_aligned
'' EXPECT-NOT: type lay_holds_aligned
'' EXPECT-OUT[linux-x86_64]: struct    lay_pack8_bits              member 'b' is at bit 32 in tiko's layout and bit 30 in clang's
'' EXPECT-OUT[win64]: type lay_pack8_bits extern "c"
'' EXPECT-OUT[windows-x86_64]: type lay_pack8_bits extern "c"
