'' msvc/stl, called from tiko: must print what driver.cpp prints.
#include once "../../show.bi"

extern "C"
    declare function stl_sum( byval csv as const zstring ptr ) as long
    declare function stl_parse( byval s as const zstring ptr ) as long
    declare function stl_last( ) as const zstring ptr
    declare function stl_poly( ) as double
    declare function stl_banner( ) as const zstring ptr
    declare function stl_arrays( ) as long
end extern

show_i( "sum", stl_sum( "5,3,9,3" ) )
show_s( "last.before", stl_last( ) )
show_i( "parse.ok", stl_parse( "42" ) )
show_s( "last.ok", stl_last( ) )
show_i( "parse.bad", stl_parse( "4x" ) )
show_s( "last.bad", stl_last( ) )
show_i( "parse.range", stl_parse( "99999999999999999999" ) )
show_s( "last.range", stl_last( ) )
show_d( "poly", stl_poly( ) )
show_s( "banner", stl_banner( ) )
show_s( "banner.again", stl_banner( ) )
show_i( "arrays.aligned", stl_arrays( ) )
