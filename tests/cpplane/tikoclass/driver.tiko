'' tikoclass, with the class defined in tiko: must print what driver.cpp prints.
#include once "../show.bi"

extern "C++"
type Shape extends object
    as double w
    declare virtual destructor( )
    declare const virtual function area( ) as double
end type
declare function measure( byref s as const Shape ) as double
declare sub destroy( byval s as Shape ptr )
end extern

destructor Shape( )
    show_s( "~Shape", "deleted" )
end destructor

const function Shape.area( ) as double
    return w * w
end function

dim as Shape ptr s = new Shape
s->w = 3
show_d( "measure", measure( *s ) )
destroy( s )
show_s( "end", "ok" )
