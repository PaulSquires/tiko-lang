'' VTABLES AND RTTI RECORDS ARE INTERNAL; OBJECT'S RECORD IS NOT. fbc writes each
'' module's copies as 'static' -- see vtable-two-modules.test for the link failure the
'' strong ones caused. The one record that must stay EXTERNAL is Object's, which lives
'' in the runtime and is only referenced; a D's chain reaches it through B's.
'' TEST: cli
'' ARGS: -target windows-x86_64 --emit-ir -i tests/driver/src tests/driver/src/vtable-two-b.bas -o tests/driver/vtabletwo.ll
'' EXPECT-EXIT: 0
'' EXPECT-FILE: tests/driver/vtabletwo.ll
'' EXPECT-FILE-HAS: tests/driver/vtabletwo.ll :: @"_ZTSN1BE" = internal global
'' EXPECT-FILE-HAS: tests/driver/vtabletwo.ll :: @"_ZTVN1BE" = internal global
'' EXPECT-FILE-HAS: tests/driver/vtabletwo.ll :: @"_ZTSN1DE" = internal global
'' EXPECT-FILE-HAS: tests/driver/vtabletwo.ll :: @"_ZTVN1DE" = internal global
'' EXPECT-FILE-HAS: tests/driver/vtabletwo.ll :: @"__fb_ZTS6Object" = external global
