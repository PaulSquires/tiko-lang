'' 'tiko clean' removes the copies (copy_to) as well as the artefact, and nothing else in the
'' directory: dist/app.ini stays.
'' TEST: cli
'' ENV: TKO_MODCACHE=build/.bcc/cache
'' ENV: TKO_LIBPATH=build/obj/rtlib/windows-x86_64
'' CLEAN: build/.bcc
'' COPY: tests/driver/src/build-copyto => build/.bcc/pkg
'' STEP: build -target windows-x86_64 --manifest build/.bcc/pkg
'' ARGS: clean -target windows-x86_64 --manifest build/.bcc/pkg --message-format json
'' EXPECT-EXIT: 0
'' EXPECT-OUT: {"event":"clean","target":"app","path":"build/.bcc/pkg/dist/app.exe","removed":true}
'' EXPECT-NO-FILE: build/.bcc/pkg/dist/app.exe
'' EXPECT-NO-FILE: build/.bcc/pkg/out/debug/app.exe
'' EXPECT-FILE: build/.bcc/pkg/dist/app.ini
