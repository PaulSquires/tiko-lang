'' THE SECOND 'tiko build' COMPILES NO ROOT (tiko-build RFC-0001 §6, PLAN B3): both roots hit
'' the unit cache, and the program linked from the cached objects runs as before. b's
'' top-level code runs first: it is a module constructor, a is main.
'' TEST: cli
'' ENV: TIKO_MODCACHE=build/.uch/cache
'' ENV: TIKO_LIBPATH=build/obj/rtlib/windows-x86_64
'' CLEAN: build/.uch
'' COPY: tests/driver/src/unitcache => build/.uch/src
'' STEP: build -target windows-x86_64 build/.uch/src/a.tiko build/.uch/src/b.tiko -o build/.uch/app.exe
'' ARGS: build -target windows-x86_64 build/.uch/src/a.tiko build/.uch/src/b.tiko -o build/.uch/app.exe -v
'' EXPECT-EXIT: 0
'' EXPECT-OUT: unit build/.uch/src/a.tiko: hit
'' EXPECT-OUT: unit build/.uch/src/b.tiko: hit
'' RUN: build/.uch/app.exe
'' EXPECT-RUN-OUT: b top
'' EXPECT-RUN-OUT: a top
'' EXPECT-RUN-OUT: b says 7
