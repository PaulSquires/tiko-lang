'' A ROOT'S OWN EDIT MISSES THAT ROOT ONLY (PLAN B3): a.tiko changed, so it misses on its
'' 'source' key line; b.tiko hits; the program prints a's new text.
'' TEST: cli
'' ENV: TKO_MODCACHE=build/.ucb/cache
'' ENV: TKO_LIBPATH=build/obj/rtlib/windows-x86_64
'' CLEAN: build/.ucb
'' COPY: tests/driver/src/unitcache => build/.ucb/src
'' STEP: build -target windows-x86_64 build/.ucb/src/a.tiko build/.ucb/src/b.tiko -o build/.ucb/app.exe
'' WRITE: build/.ucb/src/a.tiko :: '' edited\ndeclare sub FromB( )\nprint "a top edited"\nFromB( )\n
'' ARGS: build -target windows-x86_64 build/.ucb/src/a.tiko build/.ucb/src/b.tiko -o build/.ucb/app.exe -v
'' EXPECT-EXIT: 0
'' EXPECT-OUT: unit build/.ucb/src/a.tiko: miss (source
'' EXPECT-OUT: unit build/.ucb/src/b.tiko: hit
'' RUN: build/.ucb/app.exe
'' EXPECT-RUN-OUT: a top edited
