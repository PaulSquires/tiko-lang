'' '--version' NAMES THE CLANG A BUILD WOULD RUN, on its third line.
'' TEST: cli
'' HOSTS: windows
''     (TIKO_CLANG below is Git for Windows' true.exe)
'' ENV: TIKO_CLANG=C:/Program Files/Git/usr/bin/true.exe
'' ARGS: --version
'' EXPECT-EXIT: 0
'' EXPECT-OUT: llvm C:/Program Files/Git/usr/bin/true.exe
