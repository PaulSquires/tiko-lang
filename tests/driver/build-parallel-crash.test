'' A CHILD THAT DIES IS TKO0167, AND EXIT 6 (tiko-build B4, RFC §4.2): TKO_TEST_CHILD_EXIT makes
'' each child exit 99 before compiling -- any code a tiko does not exit with is a crash. The
'' unit is not compiled again here, and nothing is linked.
'' TEST: cli
'' ENV: TKO_MODCACHE=build/.bpc/cache
'' ENV: TKO_LIBPATH=toolchains/tiko-windows/lib/win64-msvc
'' ENV: TKO_TEST_CHILD_EXIT=99
'' CLEAN: build/.bpc
'' COPY: tests/driver/src/unitcache => build/.bpc/src
'' ARGS: build -target win64-msvc build/.bpc/src/a.tiko build/.bpc/src/b.tiko -o build/.bpc/app.exe -j 4
'' EXPECT-EXIT: 6
'' EXPECT-OUT: error TKO0167: compiling 'build/.bpc/src/a.tiko' crashed with exit code 99
'' EXPECT-NO-FILE: build/.bpc/app.exe
