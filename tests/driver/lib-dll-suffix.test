'' A 'lib "name.dll"' clause LINKS on the MSVC target: the trailing '.dll' is dropped
'' before the name reaches lld-link as '-l', so it finds name.lib. See the source's
'' header; fbc-modern builds the same program and prints -1.
'' TEST: cli
'' ARGS: -target windows-x86_64 tests/driver/src/lib-dll-suffix.bas -o tests/driver/libdllsuffix.exe
'' ENV: TKO_LIBPATH=build/obj/rtlib/windows-x86_64
'' EXPECT-EXIT: 0
'' EXPECT-FILE: tests/driver/libdllsuffix.exe
