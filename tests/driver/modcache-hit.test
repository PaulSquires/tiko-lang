'' THE MODULE CACHE (ADR 0017; RFC-0005 §4): the second build of a program finds both of its
'' modules in the cache and compiles neither -- and the program the cached objects link into
'' still runs. -v says hit or miss per module.
'' TEST: cli
'' ENV: TIKO_MODCACHE=build/.mct-hit/cache
'' ENV: TIKO_LIBPATH=build/obj/rtlib/windows-x86_64
'' CLEAN: build/.mct-hit
'' COPY: tests/driver/src/modcache => build/.mct-hit
'' STEP: -v -target windows-x86_64 -i build/.mct-hit/libs build/.mct-hit/app/main.bas -o build/.mct-hit/app.exe
'' STEP-OUT: module acme.leaf: miss (new)
'' STEP-OUT: module acme.middle: miss (new)
'' ARGS: -v -target windows-x86_64 -i build/.mct-hit/libs build/.mct-hit/app/main.bas -o build/.mct-hit/app.exe
'' EXPECT-EXIT: 0
'' EXPECT-OUT: module acme.leaf: hit
'' EXPECT-OUT: module acme.middle: hit
'' EXPECT-NOT: miss
'' RUN: build/.mct-hit/app.exe
'' EXPECT-RUN-OUT:  14
