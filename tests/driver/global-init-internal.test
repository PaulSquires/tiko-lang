'' _GLOBAL__I AND _GLOBAL__D ARE INTERNAL, AND STILL REGISTERED. fbc emits both as
'' module-local functions; see global-init-two-modules.test for the link failure the
'' external ones caused. Internal is only half of it: an internal function nothing
'' calls would be dropped, so the ctor/dtor tables must still name them.
'' TEST: cli
'' ARGS: -target windows-x86_64 --emit-ir tests/driver/src/global-init-b.bas -o tests/driver/globalinit.ll
'' EXPECT-EXIT: 0
'' EXPECT-FILE: tests/driver/globalinit.ll
'' EXPECT-FILE-HAS: tests/driver/globalinit.ll :: define internal void @"_GLOBAL__I"()
'' EXPECT-FILE-HAS: tests/driver/globalinit.ll :: define internal void @"_GLOBAL__D"()
'' EXPECT-FILE-HAS: tests/driver/globalinit.ll :: i32 65535, ptr @"_GLOBAL__I", ptr null
'' EXPECT-FILE-HAS: tests/driver/globalinit.ll :: i32 65535, ptr @"_GLOBAL__D", ptr null
