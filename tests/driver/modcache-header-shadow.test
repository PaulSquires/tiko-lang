'' A HEADER THAT APPEARS EARLIER IN THE SEARCH SHADOWS THE CACHED ONE (audit Phase 5): acme.leaf
'' includes "leafcfg.bi", found on -i the first time; a leafcfg.bi created later beside
'' leaf.bas -- the first place '#include' looks -- is what fbc would read. The candidate tried
'' and missed is an ABSENT dependency in deps.txt, and its appearing is a miss.
'' TEST: cli
'' ENV: TKO_MODCACHE=build/.mct-shadow/cache
'' ENV: TKO_LIBPATH=toolchains/tiko-windows/lib/win64-msvc
'' CLEAN: build/.mct-shadow
'' COPY: tests/driver/src/modcache => build/.mct-shadow
'' WRITE: build/.mct-shadow/libs/acme/leaf/leaf.bas :: #module "leaf"\n#include once "leafcfg.bi"\npublic function Seed( ) as long\n    return LEAF_BASE\nend function\n
'' STEP: -v -target win64-msvc -i build/.mct-shadow/libs -i build/.mct-shadow/inc build/.mct-shadow/app/main.bas -o build/.mct-shadow/app.exe
'' WRITE: build/.mct-shadow/libs/acme/leaf/leafcfg.bi :: const LEAF_BASE = 50\n
'' ARGS: -v -target win64-msvc -i build/.mct-shadow/libs -i build/.mct-shadow/inc build/.mct-shadow/app/main.bas -o build/.mct-shadow/app.exe
'' EXPECT-EXIT: 0
'' EXPECT-OUT: module acme.leaf: miss
'' RUN: build/.mct-shadow/app.exe
'' EXPECT-RUN-OUT:  100
