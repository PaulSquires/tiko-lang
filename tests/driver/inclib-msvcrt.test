'' '#inclib "msvcrt"' on windows-x86_64 is satisfied by ucrtbase and never reaches the
'' linker. See the source's header. fbc-modern and tiko both print 4.
'' TEST: cli
'' ARGS: -target windows-x86_64 tests/driver/src/inclib-msvcrt.bas -o tests/driver/inclibmsvcrt.exe
'' ENV: TKO_LIBPATH=build/obj/rtlib/windows-x86_64
'' EXPECT-EXIT: 0
'' EXPECT-FILE: tests/driver/inclibmsvcrt.exe
'' EXPECT-FILE-HAS: tests/driver/inclibmsvcrt.exe :: ucrtbase.dll
'' EXPECT-FILE-NOT-HAS: tests/driver/inclibmsvcrt.exe :: msvcrt.dll
