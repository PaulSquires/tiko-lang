'' '#inclib "msvcrt"' on win64-msvc is satisfied by ucrtbase and never reaches the
'' linker. See the source's header. fbc-modern and tiko both print 4.
'' TEST: cli
'' ARGS: -target win64-msvc tests/driver/src/inclib-msvcrt.bas -o tests/driver/inclibmsvcrt.exe
'' ENV: TKO_LIBPATH=toolchains/tiko-windows/lib/win64-msvc
'' EXPECT-EXIT: 0
'' EXPECT-FILE: tests/driver/inclibmsvcrt.exe
'' EXPECT-FILE-HAS: tests/driver/inclibmsvcrt.exe :: ucrtbase.dll
'' EXPECT-FILE-NOT-HAS: tests/driver/inclibmsvcrt.exe :: msvcrt.dll
