'' A WINDOWS EXECUTABLE GETS A MANIFEST (driver/winmanifest.ti): run as the invoker, supported on
'' Windows 7 to 11, per-monitor DPI aware. Written beside the output as '<out>.manifest.res', linked,
'' and deleted with the build's other temporaries.
'' TEST: cli
'' ARGS: -target windows-x86_64 tests/driver/src/manifest-dpi.bas -o tests/driver/manifestdefault.exe
'' ENV: TIKO_LIBPATH=build/obj/rtlib/windows-x86_64
'' EXPECT-EXIT: 0
'' EXPECT-FILE: tests/driver/manifestdefault.exe
'' EXPECT-FILE-HAS: tests/driver/manifestdefault.exe :: <requestedExecutionLevel level="asInvoker"
'' EXPECT-FILE-HAS: tests/driver/manifestdefault.exe :: {8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}
'' EXPECT-FILE-HAS: tests/driver/manifestdefault.exe :: PerMonitorV2
'' EXPECT-NO-FILE: tests/driver/manifestdefault.exe.manifest.res
