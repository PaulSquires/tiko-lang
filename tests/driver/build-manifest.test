'' 'tiko build' OF A MANIFEST'S TARGETS (tiko-build RFC-0001 §5, PLAN B2): with no target named,
'' every [target.*] in file order, under the 'debug' profile, into out/debug/ beside tiko.toml.
'' [target.app.defines] reaches app's roots ("greeting on") and not the module they import,
'' which still returns 42 (a module never sees a root's defines). --manifest names the
'' package: the fixture is copied under build/ so out/ lands there.
'' TEST: cli
'' ENV: TKO_MODCACHE=build/.bmf/cache
'' ENV: TKO_LIBPATH=build/obj/rtlib/windows-x86_64
'' CLEAN: build/.bmf
'' COPY: tests/driver/src/build-pkg => build/.bmf/pkg
'' ARGS: build -target windows-x86_64 --manifest build/.bmf/pkg --message-format json
'' EXPECT-EXIT: 0
'' EXPECT-OUT: {"event":"build-start","format":1,"target":"app","profile":"debug","roots":["build/.bmf/pkg/src/main.tiko","build/.bmf/pkg/src/other.tiko"]}
'' EXPECT-OUT: {"event":"unit","kind":"module","unit":"demo.src.util","status":"miss"}
'' EXPECT-OUT: {"event":"artifact","kind":"exe","path":"build/.bmf/pkg/out/debug/app.exe"}
'' EXPECT-OUT: {"event":"build-start","format":1,"target":"tool","profile":"debug","roots":["build/.bmf/pkg/tools/tool.tiko"]}
'' EXPECT-OUT: {"event":"artifact","kind":"exe","path":"build/.bmf/pkg/out/debug/tool.exe"}
'' EXPECT-OUT: {"event":"build-end","target":"tool","errors":0,"warnings":0,"exit":0,
'' RUN: build/.bmf/pkg/out/debug/app.exe
'' EXPECT-RUN-OUT: greeting on
'' EXPECT-RUN-OUT: main: 42
'' EXPECT-RUN-OUT: other
