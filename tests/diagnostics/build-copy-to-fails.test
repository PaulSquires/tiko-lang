'' TKO0171: a copy_to that cannot be written -- here a directory name that is a FILE -- fails
'' the build with exit 5, after the artefact itself was written.
'' TEST: cli
'' ENV: TIKO_MODCACHE=build/.bcf/cache
'' ENV: TIKO_LIBPATH=build/obj/rtlib/windows-x86_64
'' CLEAN: build/.bcf
'' COPY: tests/driver/src/build-copyto => build/.bcf/pkg
'' COPY: tests/diagnostics/src/build-copyto-bad.toml => build/.bcf/pkg/tiko.toml
'' ARGS: build -target windows-x86_64 --manifest build/.bcf/pkg
'' EXPECT-EXIT: 5
'' EXPECT-OUT: error TKO0171: could not copy 'build/.bcf/pkg/out/debug/app.exe' to 'build/.bcf/pkg/main.tiko/app.exe'
