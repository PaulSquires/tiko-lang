'' RFC 0018 V5: every EXPLICIT relocation of a 'nomove' type is refused. Lines asserted.
type Pinned nomove
    as long v
end type

type Holder
    as Pinned p
end type

type Free_
    as long v
end type

dim as Pinned a, b
dim as Holder h1, h2
dim as Pinned c = move( a )
dim as Holder h3 = move( h1 )
swap a, b
swap h1, h2
redim as Pinned arr( 0 to 1 )
redim preserve arr( 0 to 3 )
redim arr( 0 to 7 )
dim as Free_ f1, f2
swap f1, f2
