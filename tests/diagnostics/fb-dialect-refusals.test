'' EXPECT-OUT: fb-dialect-refusals.bas(12,1): error TKO0409: 'CALL'
'' EXPECT-OUT: fb-dialect-refusals.bas(13,8): error TKO0409: 'LPRINT'
'' EXPECT-OUT: fb-dialect-refusals.bas(14,1): error TKO0409: 'OPTION'
'' EXPECT-OUT: fb-dialect-refusals.bas(15,6): error TKO0409: 'GOSUB'
'' EXPECT-OUT: fb-dialect-refusals.bas(16,8): error TKO0409: 'DEFINT'
'' EXPECT-OUT: fb-dialect-refusals.bas(17,8): error TKO0409: 'DEFLNG'
'' EXPECT-OUT: fb-dialect-refusals.bas(18,1): error TKO0944: a line number is not available in the fb dialect
'' EXPECT-OUT: fb-dialect-refusals.bas(19,1): error TKO0944
'' EXPECT-OUT: fb-dialect-refusals.bas(22,9): error TKO0652
