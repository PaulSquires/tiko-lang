'' ARGS: -c tests/diagnostics/src/overload-alias-dup2.bas -o tests/diagnostics/src/overload-alias-dup2.o
'' EXPECT-EXIT: 1
'' EXPECT-OUT: overload-alias-dup2.bas(4,1): error TKO0677
'' EXPECT-NOT: TKO0113
