'' ARGS: -c -i tests/diagnostics/src/modules/order/libs tests/diagnostics/src/modules/order/libs/acme/inproc -o tests/diagnostics/orderlocal.o
'' EXPECT-EXIT: 1
'' EXPECT-OUT: inproc.bas(4,11): error TKO0743: 'v' is not declared
