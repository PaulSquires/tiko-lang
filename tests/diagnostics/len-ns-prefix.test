'' EXPECT-OUT: len-ns-prefix.bas(17,
'' EXPECT-OUT: len-ns-prefix.bas(18,
'' EXPECT-OUT: len-ns-prefix.bas(19,
'' EXPECT-OUT: len-ns-prefix.bas(20,
'' EXPECT-NOT: len-ns-prefix.bas(21,
'' EXPECT-MAX-DIAG: 5
