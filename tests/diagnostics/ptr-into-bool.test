dim shared as long ptr lp
dim as boolean bo
dim as byte by
dim as long l
sub TakeBool( byval x as boolean ) : end sub
function RetB( ) as boolean
    return lp
end function
function RetL( ) as long
    return lp
end function
bo = lp
dim as boolean b2 = lp
TakeBool( lp )
bo = cbool( lp )
bo = nullptr
by = nullptr
l = nullptr
bo = cptr( any ptr, 0 )
bo = cbool( nullptr )
bo = ( lp <> nullptr )
