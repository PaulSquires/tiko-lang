declare function f_UF( byval x as UF ) as UF
declare sub g_UF( byval i as long, byval x as UF )
declare function f_B13( byval x as B13 ) as B13
declare sub g_B13( byval i as long, byval x as B13 )
declare function f_B17( byval x as B17 ) as B17
declare sub g_B17( byval i as long, byval x as B17 )
declare sub hfa9( byval a as double, byval b as double, byval c as double, byval d as double, byval e as double, byval f as double, byval x as D3, byval g as double )
declare sub gpr7( byval a as longint, byval b as longint, byval c as longint, byval d as longint, byval e as longint, byval f as longint, byval g as longint, byval x as L2, byval h as longint )
function k_C1( byval x as C1 ) as C1
    return x
end function
function k_C3( byval x as C3 ) as C3
    return x
end function
function k_S3( byval x as S3 ) as S3
    return x
end function
function k_I1( byval x as I1 ) as I1
    return x
end function
function k_I5( byval x as I5 ) as I5
    return x
end function
function k_I2( byval x as I2 ) as I2
    return x
end function
function k_I3( byval x as I3 ) as I3
    return x
