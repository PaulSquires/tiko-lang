'' tests/abi/apple/sig.tiko -- tiko's side of build/aapcsig.sh, the same shapes as sig.c.
type C1
    a as byte
end type
type C3
    a as byte
    b as byte
    c as byte
end type
type S3
    a as short
    b as byte
end type
type I1
    a as long
end type
type I5
    a as long
    b as byte
end type
type I2
    a as long
    b as long
end type
type I3
    a as long
    b as long
    c as long
end type
type L2
    a as longint
    b as longint
end type
type L12
    a as longint
    b as long
end type
type L3
    a as longint
    b as longint
    c as longint
end type
type F1
    a as single
end type
type F2
    a as single
    b as single
end type
type F3
    a as single
    b as single
    c as single
end type
type F4
    a as single
    b as single
    c as single
    d as single
end type
type F5
    a as single
    b as single
    c as single
    d as single
    e as single
end type
type D1
    a as double
end type
type D2
    a as double
    b as double
end type
type D3
    a as double
    b as double
    c as double
end type
type D4
    a as double
    b as double
    c as double
    d as double
end type
type D5
    a as double
    b as double
    c as double
    d as double
    e as double
end type
type FD
    a as single
    b as double
end type
type FI
    a as single
    b as long
end type
type FA3
    a(0 to 2) as single
end type
type NF4
    x as F2
    y as F2
end type
type DA2
    a(0 to 1) as double
end type
union UF
    a as single
    b as single
end union
type B13
    a(0 to 12) as byte
end type
type B17
    a(0 to 16) as byte
end type
extern "C"
declare function f_C1( byval x as C1 ) as C1
declare sub g_C1( byval i as long, byval x as C1 )
declare function f_C3( byval x as C3 ) as C3
declare sub g_C3( byval i as long, byval x as C3 )
declare function f_S3( byval x as S3 ) as S3
declare sub g_S3( byval i as long, byval x as S3 )
