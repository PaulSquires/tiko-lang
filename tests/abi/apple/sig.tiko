declare function f_F5( byval x as F5 ) as F5
declare sub g_F5( byval i as long, byval x as F5 )
declare function f_D1( byval x as D1 ) as D1
declare sub g_D1( byval i as long, byval x as D1 )
declare function f_D2( byval x as D2 ) as D2
declare sub g_D2( byval i as long, byval x as D2 )
declare function f_D3( byval x as D3 ) as D3
declare sub g_D3( byval i as long, byval x as D3 )
declare function f_D4( byval x as D4 ) as D4
declare sub g_D4( byval i as long, byval x as D4 )
declare function f_D5( byval x as D5 ) as D5
declare sub g_D5( byval i as long, byval x as D5 )
declare function f_FD( byval x as FD ) as FD
declare sub g_FD( byval i as long, byval x as FD )
declare function f_FI( byval x as FI ) as FI
declare sub g_FI( byval i as long, byval x as FI )
declare function f_FA3( byval x as FA3 ) as FA3
