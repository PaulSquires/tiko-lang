function k_FI( byval x as FI ) as FI
    return x
end function
function k_FA3( byval x as FA3 ) as FA3
    return x
end function
function k_NF4( byval x as NF4 ) as NF4
    return x
end function
function k_DA2( byval x as DA2 ) as DA2
    return x
end function
function k_UF( byval x as UF ) as UF
    return x
end function
function k_B13( byval x as B13 ) as B13
    return x
end function
function k_B17( byval x as B17 ) as B17
    return x
end function
end extern
sub call_C1( byref p as C1 )
    g_C1( 1, p )
    dim as C1 r = f_C1( p )
end sub
sub call_C3( byref p as C3 )
    g_C3( 1, p )
    dim as C3 r = f_C3( p )
end sub
