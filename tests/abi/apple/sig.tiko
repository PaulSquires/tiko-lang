declare function f_I2( byval x as I2 ) as I2
declare sub g_I2( byval i as long, byval x as I2 )
declare function f_I3( byval x as I3 ) as I3
declare sub g_I3( byval i as long, byval x as I3 )
declare function f_L2( byval x as L2 ) as L2
declare sub g_L2( byval i as long, byval x as L2 )
declare function f_L12( byval x as L12 ) as L12
declare sub g_L12( byval i as long, byval x as L12 )
declare function f_L3( byval x as L3 ) as L3
declare sub g_L3( byval i as long, byval x as L3 )
declare function f_F1( byval x as F1 ) as F1
declare sub g_F1( byval i as long, byval x as F1 )
