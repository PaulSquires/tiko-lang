    dim as C3 r = c_take_C3( 7, v )
    c_chk_C3( @r )
    dim fp as function( byval n as long, byval v as C3 ) as C3 = @c_take_C3
    dim as C3 r2 = fp( 7, v )
    c_chk_C3( @r2 )
    c_cb_C3( @t_take_C3 )
end sub
