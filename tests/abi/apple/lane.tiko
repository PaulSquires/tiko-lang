declare sub c_seen_big( byval a0 as long, byval a1 as long, byval a2 as long, byval a3 as long, byval a4 as long, byval a5 as long, byval a6 as long, byval a7 as B33 ptr, byval a8 as long, byval a9 as MIX24 ptr )
