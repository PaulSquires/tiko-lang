function tk_pb( byval p as long, byval k as long ) as longint
    dim as longint b = 10 * p + k + 1
    if (k and 1) <> 0 then b = -b
    return b
end function
function tk_pc( byval p as long, byval k as long ) as byte
    return cbyte( tk_pb( p, k ) )
end function
function tk_ps( byval p as long, byval k as long ) as short
    return cshort( tk_pb( p, k ) * 257 )
end function
function tk_pi( byval p as long, byval k as long ) as long
    return clng( tk_pb( p, k ) * 65537 )
end function
function tk_pl( byval p as long, byval k as long ) as longint
    return tk_pb( p, k ) * &h100000001ll
end function
function tk_pf( byval p as long, byval k as long ) as single
    return csng( tk_pb( p, k ) ) + 0.5
end function
function tk_pd( byval p as long, byval k as long ) as double
    return cdbl( tk_pb( p, k ) ) + 0.25
end function

sub tfill_C1( byref v as C1, byval p as long )
    v.a = tk_pc( p, 0 )
end sub
function t_take_C1( byval n as long, byval v as C1 ) as C1
    c_seen_C1( n, @v )
    dim as C1 r
    tfill_C1( r, 4 )
    return r
end function
sub trun_C1( )
    dim as C1 v
    tfill_C1( v, 1 )
    dim as C1 r = c_take_C1( 7, v )
    c_chk_C1( @r )
    dim fp as function( byval n as long, byval v as C1 ) as C1 = @c_take_C1
    dim as C1 r2 = fp( 7, v )
    c_chk_C1( @r2 )
    c_cb_C1( @t_take_C1 )
end sub
sub tfill_C3( byref v as C3, byval p as long )
    v.a = tk_pc( p, 0 )
    v.b = tk_pc( p, 1 )
    v.c = tk_pc( p, 2 )
end sub
function t_take_C3( byval n as long, byval v as C3 ) as C3
    c_seen_C3( n, @v )
    dim as C3 r
    tfill_C3( r, 4 )
    return r
end function
sub trun_C3( )
    dim as C3 v
