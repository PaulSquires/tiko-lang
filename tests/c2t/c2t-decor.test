'' tiko c2t: export macros defined through each other collapse; a feature switch is not an export macro.
'' Everything after the clang line is asserted byte for byte; the tiko and clang versions
'' in the banner depend on the host, so only the lines around them are.
'' TEST: cli
'' CLEAN: build/.c2t/decor
'' ARGS: c2t tests/c2t/src/decor.h -o build/.c2t/decor/decor.ti
'' EXPECT-EXIT: 2
'' EXPECT-FILE-HAS: build/.c2t/decor/decor.ti :: '' decor.ti -- tiko header translated by c2t (tiko 
'' EXPECT-FILE-HAS: build/.c2t/decor/decor.ti :: ) from the C header "decor.h"\n''   source sha256 : 67143ba753410ad4df4d3da6aeacbbd7691d3a0ccc4fa2ea798a5e8c4b896a0d\n''   clang         : 
'' EXPECT-FILE-HAS: build/.c2t/decor/decor.ti :: ''   passes        : x86_64-pc-windows-msvc\n''   options       : (none)\n''\n'' Generated from C. Search for C2T-TODO and translate those parts by hand.\n''\n'' 4 items need manual translation:\n''   line 20  decor.h:5  C2T-TODO(not-yet)  FEATURE_X\n''   line 26  decor.h:14  C2T-TODO(not-yet)  FEATURE_X\n''   line 28  decor.h:15  C2T-TODO(not-yet)  lib_feature\n''   line 30  decor.h:16  C2T-TODO(not-yet)  #endif\n'' =============================================================================\n\n/' decor.h -- export macros, one defined through another, and a feature switch. '/\n#pragma once\n\n'' C2T-TODO(not-yet) decor.h:5 -- macro definition -- c2t P1 translates no declarations yet\n'' #define FEATURE_X\n'' c2t: export macro LIB_EXPORT (decoration, stripped where used)\n'' c2t: export macro LIBAPI (decoration, stripped where used)\n'' c2t: export macro LIBCALL (decoration, stripped where used)\n\n'' C2T-TODO(not-yet) decor.h:14 -- conditional directive -- c2t P1 translates no declarations yet\n'' #ifdef FEATURE_X\n'' C2T-TODO(not-yet) decor.h:15 -- declaration -- c2t P1 translates no declarations yet\n'' LIBAPI int LIBCALL lib_feature(void);\n'' C2T-TODO(not-yet) decor.h:16 -- conditional directive -- c2t P1 translates no declarations yet\n'' #endif\n\n
