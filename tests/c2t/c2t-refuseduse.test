'' EXPECT-FILE-HAS: build/.c2t/refuseduse/refuseduse.ti :: ''   passes        : x86_64-pc-windows-msvc, x86_64-pc-linux-gnu\n''   options       : --verify\n''\n'' Generated from C. Search for C2T-TODO and translate those parts by hand.\n''\n'' 1 item needs manual translation:\n''   line 19  refuseduse.h:4  C2T-TODO(refused-type)  _POLLER, POLLER\n'' =============================================================================\n\n/' refuseduse.h -- a record left as a TODO, and a declaration that points to it. '/\nextern "C"\n\n'' <stddef.h>: built into tiko\n\n'' C2T-TODO(refused-type) refuseduse.h:4 -- record '_POLLER': field 'pad': 'max_align_t' is a system header's type\n'' typedef struct _POLLER {\n''     max_align_t pad;\n''     int events;\n'' } POLLER;\n\ntype _POLLER__fwd as _POLLER\ndeclare function poller_wait( byval fds as _POLLER ptr, byval nfds as uint32 ) as int32\n\nend extern\n
