'' EXPECT-FILE-HAS: build/.c2t/inline/inline.ti :: ''   passes        : x86_64-pc-windows-msvc, x86_64-pc-linux-gnu\n''   options       : --verify\n''\n'' Generated from C. Search for C2T-TODO and translate those parts by hand.\n''\n'' 2 items need manual translation:\n''   line 23  inline.h:7  C2T-TODO(static-inline)  clamp\n''   line 30  inline.h:13  C2T-TODO(static-inline)  helper\n'' =============================================================================\n\n/' inline.h -- inline functions (RFC-0001 D15). '/\n#pragma once\n\nextern "C"\n\n'' C2T-NOTE(inline) inline.h:5 -- inline: links only if the library exports 'twice'\ndeclare function twice( byval x as int32 ) as int32                          /' links only if the library exports it '/\n\n'' C2T-TODO(static-inline) inline.h:7 -- static inline function 'clamp': no symbol to link against; port the body by hand\n'' static inline int clamp(int v, int lo, int hi)    /* no symbol: a TODO with its body */\n'' {\n''     /* the body is quoted whole */\n''     return v < lo ? lo : (v > hi ? hi : v);\n'' }\n\n'' C2T-TODO(static-inline) inline.h:13 -- static function 'helper': no symbol to link against; port the body by hand\n'' static int helper(void);                          /* static, no body here: a TODO too */\ndeclare function plain( byval v as int32 ) as int32\n\nend extern\n
