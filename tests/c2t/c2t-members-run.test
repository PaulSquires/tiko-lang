'' The macros c2t writes for members.h's field reads work: '.', '->', a field of a field.
'' TEST: cli
'' ENV: TIKO_LIBPATH=build/obj/rtlib/windows-x86_64
'' CLEAN: build/.c2t/members-run
'' STEP-EXIT: 2
'' STEP: c2t tests/c2t/src/members.h -o build/.c2t/members-run/members.ti
'' ARGS: -target windows-x86_64 tests/c2t/src/members-use.tiko -o build/.c2t/members-run/use.exe
'' EXPECT-EXIT: 0
'' RUN: build/.c2t/members-run/use.exe
'' EXPECT-RUN-OUT:  1 1 9
