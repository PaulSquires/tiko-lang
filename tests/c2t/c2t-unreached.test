'' tiko c2t: branches no pass takes are translated by a branch pass that forces each on -- an #if/#elif/#else chain, nesting, #error, macro values from clang; under a conditional c2t cannot translate they stay C, and a branch clang cannot parse keeps a branch-unparsed TODO.
'' Everything after the clang line is asserted byte for byte; the tiko and clang versions
'' in the banner depend on the host, so only the lines around them are.
'' TEST: cli
'' CLEAN: build/.c2t/unreached
'' ARGS: c2t tests/c2t/src/unreached.h --verify -o build/.c2t/unreached/unreached.ti
'' EXPECT-EXIT: 2
'' EXPECT-FILE-HAS: build/.c2t/unreached/unreached.ti :: '' unreached.ti -- tiko header translated by c2t (tiko 
'' EXPECT-FILE-HAS: build/.c2t/unreached/unreached.ti :: ) from the C header "unreached.h"\n''   source sha256 : 96f2083321422010ea12472ce492e138674f37b974827e7da89f2564aac9e62a\n''   clang         : 
'' EXPECT-FILE-HAS: build/.c2t/unreached/unreached.ti :: ''   passes        : x86_64-pc-windows-msvc, x86_64-pc-linux-gnu\n''   options       : --verify\n''\n'' Generated from C. Search for C2T-TODO and translate those parts by hand.\n''\n'' 5 items need manual translation:\n''   line 81  unreached.h:60  C2T-TODO(conditional)  #if\n''   line 83  unreached.h:61  C2T-TODO(conditional)  double\n''   line 85  unreached.h:62  C2T-TODO(conditional)  #endif\n''   line 91  unreached.h:67  C2T-TODO(system-header)  <ur_sys_does_not_exist.h>\n''   line 98  unreached.h:73  C2T-TODO(branch-unparsed)\n'' =============================================================================\n\n/' unreached.h -- branches no pass takes, translated by forcing each one on. '/\n#pragma once\n\n#include once "crt/long.bi"\n\nextern "C"\n\n'' <stdint.h>: built into tiko\n\ntype ur_ctx__fwd as ur_ctx\n\n/' An untaken #ifdef: a typedef, a function, macros -- one whose value only clang knows. '/\n#ifdef UR_WITH_EXTRA\ntype ur_extra_t as int32\n#define UR_EXTRA_MAX (1 shl 4)\n'' C2T-NOTE(value) unreached.h:13 -- clang's value; a cast, which tiko's preprocessor does not evaluate\n#define UR_EXTRA_CAST 44\ndeclare function ur_extra( byval c as ur_ctx ptr, byval n as ur_extra_t ) as int32\n#endif\n\n/' An #elif chain: the first branch is taken, the two after it are not. '/\n#if (defined(TIKO_OS_WINDOWS) orelse defined(TIKO_OS_LINUX))\n#define UR_KIND 1\n#elseif 0\n#define UR_KIND 2\ndeclare function ur_apple_only( ) as int32\n#else\n#define UR_KIND 3\ndeclare function ur_elsewhere( ) as int32\n#endif\n\n/' Nested: both branches inside an untaken one are untaken too. '/\n#ifdef UR_WITH_OUTER\n#define UR_OUTER_ON 1\n#ifdef UR_WITH_INNER\ndeclare function ur_inner( byval x as int32 ) as int32\n#else\ndeclare function ur_outer( byval x as int32 ) as int32\n#endif\n#endif\n\n/' An #error is a branch's way of saying 'not here'; what follows it is translated. '/\n#ifdef UR_WITH_STRICT\n#error "UR_WITH_STRICT is not supported"\ndeclare function ur_strict( ) as int32\n#endif\n\n/' A test of the compiler is the program's to answer: kept as written, every branch\n   translated for each target. '/\n#if defined(_MSC_VER)\ntype ur_u64 as uint64\n#elseif (defined(__GNUC__) andalso (__GNUC__ >= 4))\ntype ur_u64 as uint64\n#else\ntype ur_u64 as culong\n#endif\n#ifdef __clang__\n#define UR_CC 1\n#else\n#define UR_CC 2\n#endif\n\n/' Under a conditional c2t cannot translate, an untaken branch stays C. '/\n'' C2T-TODO(conditional) unreached.h:60 -- a division whose operands may be integers or floats\n'' #if defined(UR_UNSTATABLE) && (UR_UNSTATABLE / 0)\n'' C2T-TODO(conditional) unreached.h:61 -- inside a conditional that stays a TODO\n'' #define double long\n'' C2T-TODO(conditional) unreached.h:62 -- a division whose operands may be integers or floats\n'' #endif\n\n/' Headers this host does not have are left out of the parse; the rest is translated. '/\n#ifdef UR_WITH_MISSING\n#include once "ur_does_not_exist.ti"\n'' C2T-TODO(system-header) unreached.h:67 -- <ur_sys_does_not_exist.h> has no tiko counterpart in c2t's table\n'' #include <ur_sys_does_not_exist.h>\ndeclare function ur_missing( ) as int32\n#endif\n\n/' A branch clang cannot parse even when forced on keeps its TODO. '/\n#ifdef UR_WITH_CXX\n'' C2T-TODO(branch-unparsed) unreached.h:73 -- clang cannot parse the branch: unknown type name 'template'\n'' template <class T> T ur_twice(T x);\n#endif\n\nend extern\n
