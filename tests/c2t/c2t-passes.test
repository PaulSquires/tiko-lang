'' tiko c2t: the Windows and Linux passes merged: shared text once, per-target text under a synthesised guard, the header's own #ifdef kept, a compiler-identity group kept as written, a --pass define; --verify per target.
'' Everything after the clang line is asserted byte for byte; the tiko and clang versions
'' in the banner depend on the host, so only the lines around them are.
'' TEST: cli
'' CLEAN: build/.c2t/passes
'' ARGS: c2t tests/c2t/src/passes.h --pass -DWITH_EXTRAS --verify -o build/.c2t/passes/passes.ti
'' EXPECT-EXIT: 0
'' EXPECT-FILE-HAS: build/.c2t/passes/passes.ti :: '' passes.ti -- tiko header translated by c2t (tiko 
'' EXPECT-FILE-HAS: build/.c2t/passes/passes.ti :: ) from the C header "passes.h"\n''   source sha256 : 5506442e046b477b334a96a7fa71e04397caa9f224cb468ec4d1e62ad01081cd\n''   clang         : 
'' EXPECT-FILE-HAS: build/.c2t/passes/passes.ti :: ''   passes        : x86_64-pc-windows-msvc, x86_64-pc-linux-gnu, x86_64-pc-windows-msvc -DWITH_EXTRAS, x86_64-pc-linux-gnu -DWITH_EXTRAS\n''   options       : --pass -DWITH_EXTRAS --verify\n''\n'' Generated from C. Search for C2T-TODO and translate those parts by hand.\n''\n'' Nothing needs manual translation.\n'' =============================================================================\n\n/' passes.h -- what differs between Windows and Linux, and between --pass configurations. '/\n#pragma once\n\n#include once "crt/long.bi"\n\nextern "C"\n\n'' <stddef.h>: built into tiko\n\n/' The same on both targets: written once. '/\ntype native_t as clong                  /' clong is the target's width already '/\ndeclare function shared_fn( byval n as native_t ) as int32\n\n/' A different spelling per target: guarded by the merge. '/\n#if defined(TIKO_OS_WINDOWS)\ntype WideCell\n    ch as uint16                        /' 2 bytes on Windows, 4 on Linux '/\n    attr as int32\nend type\n#elseif defined(TIKO_OS_LINUX)\ntype WideCell\n    ch as int32                         /' 2 bytes on Windows, 4 on Linux '/\n    attr as int32\nend type\n#endif\n\n/' The header's own platform split: tiko's #ifdef does the selecting. '/\n#ifdef TIKO_OS_WINDOWS\ntype native_handle as any ptr\ndeclare function win_only_fn( byval h as native_handle ) as int32\n#else\ntype native_handle as int32\ndeclare function posix_only_fn( byval fd as native_handle ) as int32\n#endif\n\n/' A compiler's identity: kept as written -- the program that includes it decides. '/\n#if defined(_MSC_VER)\ndeclare function msvc_only_fn( ) as int32\n#endif\n\n/' A feature switch, translated with --pass "-DWITH_EXTRAS". '/\n#ifdef WITH_EXTRAS\ndeclare function extras_fn( byval level as int32 ) as int32\n#endif\n\nend extern\n
