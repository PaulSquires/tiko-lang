'' The record constants c2t writes for reclit.h's compound literals are values a program uses.
'' TEST: cli
'' ENV: TIKO_LIBPATH=build/obj/rtlib/windows-x86_64
'' CLEAN: build/.c2t/reclit-run
'' STEP-EXIT: 2
'' STEP: c2t tests/c2t/src/reclit.h -o build/.c2t/reclit-run/reclit.ti
'' ARGS: -target windows-x86_64 tests/c2t/src/reclit-use.tiko -o build/.c2t/reclit-run/use.exe
'' EXPECT-EXIT: 0
'' RUN: build/.c2t/reclit-run/use.exe
'' EXPECT-RUN-OUT:  200 200 200 255 0 0.5 3 12
