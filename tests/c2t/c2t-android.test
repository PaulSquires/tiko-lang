'' tiko c2t: Android's two passes (--android-sysroot) beside Windows, Linux and macOS: __ANDROID__ as TIKO_OS_ANDROID, __linux__ / __unix__ as Linux-or-Android, __gnu_linux__ Linux's alone, a union guard, a guard by Android's architecture (aarch64's unsigned char), __ANDROID_API__ kept a TODO; --verify per target.
'' Everything after the clang line is asserted byte for byte; the tiko and clang versions
'' in the banner depend on the host, so only the lines around them are. The sysroot is a
'' stand-in: the header includes only clang's own <stdint.h>, so no NDK or SDK is needed
'' (claude-docs docs/tiko-vendor/RFC-0007).
'' TEST: cli
'' CLEAN: build/.c2t/android
'' ARGS: c2t tests/c2t/src/android.h --macos-sysroot tests/c2t/src/sysroot --android-sysroot tests/c2t/src/sysroot --verify -o build/.c2t/android/android.ti
'' EXPECT-EXIT: 2
'' EXPECT-FILE-HAS: build/.c2t/android/android.ti :: '' android.ti -- tiko header translated by c2t (tiko 
'' EXPECT-FILE-HAS: build/.c2t/android/android.ti :: ) from the C header "android.h"\n''   source sha256 : b3e6fc4c58fbeeb5f6cca5f0414a40aa03e3b0740b1dcd6933ce739105af3fa8\n''   clang         : 
'' EXPECT-FILE-HAS: build/.c2t/android/android.ti :: ''   passes        : x86_64-pc-windows-msvc, x86_64-pc-linux-gnu, arm64-apple-macosx13.0, x86_64-linux-android29, aarch64-linux-android29\n''   options       : --macos-sysroot tests/c2t/src/sysroot --android-sysroot tests/c2t/src/sysroot --verify\n''\n'' Generated from C. Search for C2T-TODO and translate those parts by hand.\n''\n'' 2 items need manual translation:\n''   line 83  android.h:46  C2T-TODO(conditional)  #if\n''   line 88  android.h:48  C2T-TODO(conditional)  #endif\n'' =============================================================================\n\n/' android.h -- Android's passes beside Windows, Linux and macOS: Android's own branch, what\n   Linux and Android share, and what differs between Android's two architectures. '/\n#pragma once\n\n#include once "crt/long.bi"\n\nextern "C"\n\n'' <stdint.h>: built into tiko\n\n/' The same on every target: written once. '/\ndeclare function an_shared( byval n as int32 ) as int32\n\n/' Android's own branch comes first: Android defines __linux__ too. '/\n#if defined(TIKO_OS_ANDROID)\ntype an_lock\n    w(0 to 9) as int32\nend type                                                /' Bionic's: 40 bytes, 4-aligned '/\n#elseif (defined(TIKO_OS_LINUX) orelse defined(TIKO_OS_ANDROID))\ntype an_lock\n    w(0 to 4) as int64\nend type                                                /' glibc's: 40 bytes, 8-aligned '/\n#else\ntype an_lock\n    p as any ptr\nend type\n#endif\ndeclare function an_lock_init( byval l as an_lock ptr ) as int32\n\n/' A Linux kernel, Linux's and Android's alike: tiko says both. '/\n#if (defined(TIKO_OS_LINUX) orelse defined(TIKO_OS_ANDROID))\ndeclare function an_kernel_fn( ) as int32\n#endif\n#if ((defined(TIKO_OS_LINUX) orelse defined(TIKO_OS_ANDROID)) = 0)\ndeclare function an_not_unix_fn( ) as int32\n#endif\n\n/' glibc's alone: clang defines no __gnu_linux__ for Android. '/\n#ifdef TIKO_OS_LINUX\ndeclare function an_glibc_fn( ) as int32\n#endif\n\n/' An architecture inside Android: the header's own #if selects. '/\n#if (defined(TIKO_OS_ANDROID) andalso defined(TIKO_ARCH_ARM64))\ndeclare function an_android_arm64_fn( ) as int32\n#endif\n\n/' The merge: long on Linux and Android, long long on Windows and macOS -- a union guard. '/\n#if (defined(TIKO_OS_WINDOWS) orelse defined(TIKO_OS_MACOS))\ntype an_i64 as int64\n#elseif (defined(TIKO_OS_LINUX) orelse defined(TIKO_OS_ANDROID))\ntype an_i64 as clong\n#endif\n\n/' A plain char is unsigned on aarch64 Android alone: guarded by the architecture. '/\n#if not ((defined(TIKO_OS_ANDROID) andalso defined(TIKO_ARCH_ARM64)))\ntype an_chr\n    c as byte\n    n as int32\nend type\n#elseif (defined(TIKO_OS_ANDROID) andalso defined(TIKO_ARCH_ARM64))\ntype an_chr\n    c as ubyte\n    n as int32\nend type\n#endif\n\n/' Android's API level has no tiko name: the conditional stays C. '/\n'' C2T-TODO(conditional) android.h:46 -- '__ANDROID_API__' has no tiko equivalent\n'' #if defined(__ANDROID_API__) && __ANDROID_API__ >= 26\n#if defined(TIKO_OS_ANDROID)\ndeclare function an_api26_fn( ) as int32\n#endif\n'' C2T-TODO(conditional) android.h:48 -- '__ANDROID_API__' has no tiko equivalent\n'' #endif\n\nend extern\n
