'' tiko c2t: the declarations P2 translates -- typedefs, records, enums, variables, functions -- and the ones it leaves as TODOs.
'' Everything after the clang line is asserted byte for byte; the tiko and clang versions
'' in the banner depend on the host, so only the lines around them are.
'' TEST: cli
'' CLEAN: build/.c2t/decls
'' ARGS: c2t tests/c2t/src/decls.h -o build/.c2t/decls/decls.ti
'' EXPECT-EXIT: 2
'' EXPECT-FILE-HAS: build/.c2t/decls/decls.ti :: '' decls.ti -- tiko header translated by c2t (tiko 
'' EXPECT-FILE-HAS: build/.c2t/decls/decls.ti :: ) from the C header "decls.h"\n''   source sha256 : c5a0ec2001e569977eecce995efdd9422a7154c43d42be9c7e4fbadbde7b19e9\n''   clang         : 
'' EXPECT-FILE-HAS: build/.c2t/decls/decls.ti :: ''   passes        : x86_64-pc-windows-msvc\n''   options       : (none)\n''\n'' Generated from C. Search for C2T-TODO and translate those parts by hand.\n''\n'' Renamed:\n''   procedure  print -> print_   (tiko reserved word)\n''   parameter  configure.width -> configure.width_   (tiko reserved word)\n''\n'' 6 items need manual translation:\n''   line 28  decls.h:5  C2T-TODO(not-yet)  <stddef.h>\n''   line 30  decls.h:6  C2T-TODO(not-yet)  <stdint.h>\n''   line 32  decls.h:7  C2T-TODO(not-yet)  <stdio.h>\n''   line 44  decls.h:16  C2T-TODO(not-yet)  handler_fn\n''   line 106  decls.h:59  C2T-TODO(no-prototype)  legacy\n''   line 108  decls.h:60  C2T-TODO(refused-type)  open_log\n'' =============================================================================\n\n/' decls.h -- the declarations c2t P2 translates, and the ones it leaves as TODOs. '/\n#pragma once\n\n#include once "crt/long.bi"\n\n'' C2T-TODO(not-yet) decls.h:5 -- #include -- translated from c2t P6\n'' #include <stddef.h>\n'' C2T-TODO(not-yet) decls.h:6 -- #include -- translated from c2t P6\n'' #include <stdint.h>\n'' C2T-TODO(not-yet) decls.h:7 -- #include -- translated from c2t P6\n'' #include <stdio.h>\n\n/' ---- typedefs '/\nextern "C"\n\ntype u32 as uint32                  /' a scalar '/\ntype cstr as const zstring ptr      /' a pointer '/\ntype count_t as uinteger            /' a system typedef c2t spells itself '/\ntype byte_t as uint8\ntype native_t as clong              /' clong: the target's width '/\ntype compare_fn as function cdecl( byval as const any ptr, byval as const any ptr ) as int32   /' a function pointer '/\n'' C2T-TODO(not-yet) decls.h:16 -- typedef 'handler_fn' names a function type, not a pointer to one\n'' typedef void handler_fn(int code);  /* a function type, not a pointer: a TODO */\n\n/' ---- records '/\ntype Later__fwd as Later            /' defined below: pointers to it are Later__fwd ptr '/\ntype Opaque__fwd as Opaque          /' never defined: pointers to it are Opaque ptr '/\n\ntype Holder\n    name as zstring * 16   /' a string field '/\n    grid(0 to 1, 0 to 2) as int32\n    scale as float32\n    next as Later__fwd ptr /' defined further down '/\nend type\n\nunion Value\n    i as int32\n    d as float64\nend union\n\ntype Later\n    owner as Holder ptr\n    self as Later ptr   /' itself: Later ptr '/\nend type\n\ntype Packed field = 1\n    c as byte\n    i as int32\nend type                                                                   /' P3 '/\ntype Bits\n    a : 3 as uint32\n    b : 5 as uint32\nend type                                                                   /' P3 '/\n\n/' ---- enums '/\ntype Mode as int32\nenum\n    MODE_A\n    MODE_B = 4\n    MODE_C\nend enum\nenum\n    ANON_X = 1\n    ANON_Y = 2\nend enum\ntype Big as int32\nenum\n    BIG = -2147483648\nend enum\n\n/' ---- variables '/\nextern lib_counter as int32\nextern lib_names(0 to 3) as const zstring ptr\n\n/' ---- functions '/\ndeclare function print_ alias "print"( byval fmt as const zstring ptr, ... ) as int32              /' 'print' is a tiko word '/\ndeclare sub configure( byval width_ as int32, _                      /' first '/\n                       _ '' a comment line between parameters\n                       byval height as int32 ) /' last '/\ndeclare sub opaque_use( byval o as Opaque ptr, byval l as Later ptr, byval h as Holder )\ndeclare function pick( byval n as count_t, byval m as native_t, byval flags as u32 ) as compare_fn\n'' C2T-NOTE(inline) decls.h:58 -- inline: links only if the library exports 'inc'\ndeclare function inc( byval v as int32 ) as int32\n'' C2T-TODO(no-prototype) decls.h:59 -- 'legacy()' declares no parameter list; C allows any arguments\n'' int legacy();\n'' C2T-TODO(refused-type) decls.h:60 -- 'open_log' return type: 'FILE' is a system header's type\n'' FILE *open_log(const char *path);              /* a system type: a TODO */\ndeclare sub use_packed( byval p as Packed ptr )                    /' a record left as a TODO: Packed ptr '/\n\n'' C2T-NOTE(static-assert) decls.h:63 -- a C compile-time check; nothing to declare\n'' _Static_assert(sizeof(u32) == 4, "u32");\n\nend extern\n
