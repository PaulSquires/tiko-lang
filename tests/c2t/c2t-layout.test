'' tiko c2t: --verify lays the translation out with tiko and refuses the records whose layout differs from clang's, and what holds them by value.
'' Everything after the clang line is asserted byte for byte; the tiko and clang versions
'' in the banner depend on the host, so only the lines around them are.
'' TEST: cli
'' CLEAN: build/.c2t/layout
'' ARGS: c2t tests/c2t/src/layout.h --verify -o build/.c2t/layout/layout.ti
'' EXPECT-EXIT: 2
'' EXPECT-FILE-HAS: build/.c2t/layout/layout.ti :: '' layout.ti -- tiko header translated by c2t (tiko 
'' EXPECT-FILE-HAS: build/.c2t/layout/layout.ti :: ) from the C header "layout.h"\n''   source sha256 : ab163efa756351b981dd3ad338fee63282b28f6f59e1f70088083b75b3560c2d\n''   clang         : 
'' EXPECT-FILE-HAS: build/.c2t/layout/layout.ti :: ''   passes        : x86_64-pc-windows-msvc, x86_64-pc-linux-gnu\n''   options       : --verify\n''\n'' Generated from C. Search for C2T-TODO and translate those parts by hand.\n''\n'' 4 items need manual translation:\n''   line 22  layout.h:6  C2T-TODO(layout)  Mixed\n''   line 25  layout.h:6  C2T-TODO(layout)  Mixed\n''   line 37  layout.h:7  C2T-TODO(layout)  Plain\n''   line 40  layout.h:8  C2T-TODO(refused-type)  Holds\n'' =============================================================================\n\n/' layout.h -- records tiko lays out differently from clang (MSVC bit-field rules), which\n   --verify refuses; what holds one by value goes with it, a pointer to one stays. '/\n#pragma once\n\n#if defined(TIKO_OS_WINDOWS)\n'' C2T-TODO(layout) layout.h:6 -- record 'Mixed': tiko's layout differs from clang's on windows-x86_64: tiko lays it out in 1 bytes aligned to 1, clang in 8 aligned to 4; member 'b' is at bit 3 in tiko's layout and bit 32 in clang's\n'' struct Mixed { char a : 3; int b : 5; };        /* MSVC starts a new unit at 'int' */\n#elseif defined(TIKO_OS_LINUX)\n'' C2T-TODO(layout) layout.h:6 -- record 'Mixed': tiko's layout differs from clang's on linux-x86_64: tiko lays it out in 1 bytes aligned to 1, clang in 4 aligned to 4\n'' struct Mixed { char a : 3; int b : 5; };        /* MSVC starts a new unit at 'int' */\n#endif\nextern "C"\n\n#if defined(TIKO_OS_WINDOWS)\ntype Plain\n    x : 3 as uint32\n    y : 5 as uint32\n    c as byte\nend type\n#elseif defined(TIKO_OS_LINUX)\n'' C2T-TODO(layout) layout.h:7 -- record 'Plain': tiko's layout differs from clang's on linux-x86_64: tiko lays it out in 8 bytes aligned to 4, clang in 4 aligned to 4; member 'c' is at bit 32 in tiko's layout and bit 8 in clang's\n'' struct Plain { unsigned x : 3; unsigned y : 5; char c; };\n#endif\n'' C2T-TODO(refused-type) layout.h:8 -- record 'Holds': field 'm': uses 'Mixed', which was skipped\n'' struct Holds { struct Mixed m; int n; };        /* holds a refused record by value */\n#if defined(TIKO_OS_WINDOWS)\ntype Mixed__fwd as Mixed\ndeclare sub take( byval m as Mixed ptr, byval p as Plain ptr )    /' a pointer to one is fine '/\n#elseif defined(TIKO_OS_LINUX)\ntype Mixed__fwd as Mixed\ntype Plain__fwd as Plain\ndeclare sub take( byval m as Mixed ptr, byval p as Plain ptr )    /' a pointer to one is fine '/\n#endif\n\nend extern\n
