'' tiko c2t: bit-field records MSVC and SysV lay out differently get 'extern "c"' (and only those, and packed ones), so tiko lays them out by the target's C rule and --verify agrees on both targets.
'' Everything after the clang line is asserted byte for byte; the tiko and clang versions
'' in the banner depend on the host, so only the lines around them are.
'' TEST: cli
'' CLEAN: build/.c2t/layout
'' ARGS: c2t tests/c2t/src/layout.h --verify -o build/.c2t/layout/layout.ti
'' EXPECT-EXIT: 0
'' EXPECT-FILE-HAS: build/.c2t/layout/layout.ti :: '' layout.ti -- tiko header translated by c2t (tiko 
'' EXPECT-FILE-HAS: build/.c2t/layout/layout.ti :: ) from the C header "layout.h"\n''   source sha256 : 07ac36abd8b5aea788c5d2d57d37f65d4f7bb5b193b80e4dc574ab069cce4536\n''   clang         : 
'' EXPECT-FILE-HAS: build/.c2t/layout/layout.ti :: ''   passes        : x86_64-pc-windows-msvc, x86_64-pc-linux-gnu\n''   options       : --verify\n''\n'' Generated from C. Search for C2T-TODO and translate those parts by hand.\n''\n'' Nothing needs manual translation.\n'' =============================================================================\n\n/' layout.h -- records whose bit-fields MSVC and SysV lay out differently: written with\n   'extern "c"', tiko lays each out by its target's C rule, and --verify agrees with clang. '/\n#pragma once\n\nextern "C"\n\ntype Mixed extern "c"\n    a : 3 as byte\n    b : 5 as int32\nend type                                        /' MSVC starts a new unit at 'int' '/\ntype Plain extern "c"\n    x : 3 as uint32\n    y : 5 as uint32\n    c as byte\nend type\ntype Holds\n    m as Mixed\n    n as int32\nend type                                        /' holds one by value '/\ndeclare sub take( byval m as Mixed ptr, byval p as Plain ptr )    /' and a pointer to each '/\n\nend extern\n
