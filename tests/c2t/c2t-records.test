'' tiko c2t: bit-fields, anonymous unions and structs, nested and unnamed-type records, packing, field renames; over-alignment and flexible arrays refused; every layout checked with --verify.
'' Everything after the clang line is asserted byte for byte; the tiko and clang versions
'' in the banner depend on the host, so only the lines around them are.
'' TEST: cli
'' CLEAN: build/.c2t/records
'' ARGS: c2t tests/c2t/src/records.h --verify -o build/.c2t/records/records.ti
'' EXPECT-EXIT: 2
'' EXPECT-FILE-HAS: build/.c2t/records/records.ti :: '' records.ti -- tiko header translated by c2t (tiko 
'' EXPECT-FILE-HAS: build/.c2t/records/records.ti :: ) from the C header "records.h"\n''   source sha256 : 9f3741bb8d287ad3987b2640e894c9732e76d9e57ff0de0528739f1ed91c5e18\n''   clang         : 
'' EXPECT-FILE-HAS: build/.c2t/records/records.ti :: ''   passes        : x86_64-pc-windows-msvc, x86_64-pc-linux-gnu\n''   options       : --verify\n''\n'' Generated from C. Search for C2T-TODO and translate those parts by hand.\n''\n'' Renamed:\n''   type       Case -> Case_   (tiko reserved word)\n''   field      Case_.handler -> handler_2   (case-insensitive collision)\n''\n'' 2 items need manual translation:\n''   line 73  records.h:46  C2T-TODO(refused-type)  Big\n''   line 78  records.h:50  C2T-TODO(refused-type)  Flex\n'' =============================================================================\n\n/' records.h -- the record shapes c2t P3 translates, and the ones it refuses. '/\n#pragma once\n\nextern "C"\n\n'' <stdint.h>: built into tiko\n\n/' Bit-fields, one unnamed (padding). '/\ntype Flags extern "c"\n    visible : 1 as uint32   /' shown '/\n    __cimport_bits2 : 3 as uint32   /' padding '/\n    layer : 4 as uint32\n    color as uint32         /' a tiko word as a field name '/\nend type\n\n/' An anonymous union inside a struct, and an anonymous struct inside that. '/\ntype Variant\n    kind as int32\n    union\n        i as int32          /' when kind == 0 '/\n        d as float64        /' when kind == 1 '/\n        type\n            lo as int16\n            hi as int16\n        end type\n    end union\nend type\n\n/' A named record declared inside another, and a field of an unnamed record type. '/\ntype Inner\n    a as int32\nend type\ntype Outer_point_t\n    x as int32\n    y as int32\nend type\ntype Outer\n    inner as Inner\n    point as Outer_point_t\nend type\n\n'' c2t: #pragma pack(push, 1) -- carried by 'field = N' on each record it packs\ntype Packed1 field = 1 extern "c"\n    tag as uint8\n    value as uint32         /' at offset 1 '/\nend type\n'' c2t: #pragma pack(pop) -- carried by 'field = N' on each record it packs\n\n/' Case-insensitive collisions between fields. '/\ntype Case_\n    Handler as int32\n    handler_2 as int32\nend type\n\n'' C2T-TODO(refused-type) records.h:46 -- record 'Big': over-aligned record (alignment 32) has no tiko spelling\n'' typedef struct Big {\n''     _Alignas(32) char data[32];   /* over-aligned: refused */\n'' } Big;\n\n'' C2T-TODO(refused-type) records.h:50 -- record 'Flex': field 'bytes': flexible array member -- reach it by pointer arithmetic\n'' typedef struct Flex {\n''     int  count;\n''     char bytes[];           /* a flexible array member: refused */\n'' } Flex;\n\nend extern\n
