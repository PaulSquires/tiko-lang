'' EXPECT-FILE-HAS: build/.c2t/macros/macros.ti :: ''   passes        : x86_64-pc-windows-msvc, x86_64-pc-linux-gnu\n''   options       : --verify\n''\n'' Generated from C. Search for C2T-TODO and translate those parts by hand.\n''\n'' 10 items need manual translation:\n''   line 48  macros.h:21  C2T-TODO(macro)  M_NULLP\n''   line 63  macros.h:35  C2T-TODO(macro)  M_WIDE\n''   line 75  macros.h:46  C2T-TODO(function-like-macro)  F_ISPOW2\n''   line 77  macros.h:47  C2T-TODO(function-like-macro)  F_HALF\n''   line 79  macros.h:48  C2T-TODO(function-like-macro)  F_STR\n''   line 81  macros.h:49  C2T-TODO(function-like-macro)  F_CAT\n''   line 83  macros.h:50  C2T-TODO(function-like-macro)  F_LOG\n''   line 92  macros.h:58  C2T-TODO(unreached-branch)  ON_OTHER\n''   line 100  macros.h:65  C2T-TODO(conditional)  _MSC_VER\n''   line 105  macros.h:67  C2T-TODO(conditional)  #endif\n'' =============================================================================\n\n/' macros.h -- every row of RFC-0001 section 5.5, the function-like refusals, the #if forms. '/\n#pragma once\n\nextern "C"\n\n#define M_XOR (&h0F xor &h3C)\n#define M_OR ((1 or 2) or 4)\n#define M_AND (&hFF and &h0F)\n#define M_NOT (not 0)\n#define M_SHL (1 shl 6)\n#define M_SHR (256 shr 2)\n#define M_SUM ((1 + 2) shl 3)       /' C: (1 + 2) << 3; tiko's shl binds tighter '/\n'' C2T-NOTE(value) macros.h:12 -- clang's value; '(1 andalso 2)' is -1 in tiko\n#define M_LAND 1                    /' a C truth value is 1; tiko's is -1: clang's value '/\n#define M_LOR (0 orelse 0)\n#define M_MOD (17 mod 5)\n'' C2T-NOTE(value) macros.h:15 -- clang's value; '(3 = 3)' is -1 in tiko\n#define M_EQ 1\n'' C2T-NOTE(value) macros.h:16 -- clang's value; '((0) = 0)' is -1 in tiko\n#define M_LNOT 1\n#define M_IDIV (7 \\ 2)              /' integer division is \\ in tiko '/\n#define M_FDIV (7.0 / 2)\n#define M_TERN iif(1, 10, 20)\n'' C2T-NOTE(value) macros.h:20 -- clang's value; a cast, which tiko's preprocessor does not evaluate\n#define M_CAST 44\n'' C2T-TODO(macro) macros.h:21 -- 'M_NULLP': a pointer cast\n'' #define M_NULLP   ((void*)0)        /* a pointer: a TODO */\n#define M_HEX &h1Fu\n#define M_OCT &o17\n#define M_BIN &b101\n#define M_ULL 18446744073709551615ull\n#define M_LONG 100\n#define M_FLOAT 1.5f\n#define M_DOUBLE 2.25\n#define M_CHAR 97\n#define M_ESC 10\n#define M_STR "plain"\n#define M_STRESC !"tab\\there\\n"\n#define M_OCTSTR !"\\&h1B[0m"\n#define M_CONCAT "abcd"\n'' C2T-TODO(macro) macros.h:35 -- 'M_WIDE': a wide or UTF string literal\n'' #define M_WIDE    L"wide"           /* a wide string: a TODO */\n#define M_REF (M_SHL + 1)           /' an earlier macro '/\n#define M_EMPTY\n#define M_ALIAS lib_function\n\ndeclare function lib_function( byval x as int32 ) as int32\n\n/' function-like '/\n#define F_MAX(a, b) iif(((a) > (b)), (a), (b))\n#define F_SQ(x) ((x) * (x))\n#define F_CALL(x) lib_function((x))\n'' C2T-TODO(function-like-macro) macros.h:46 -- a C truth value (1) used as a number; tiko's is -1\n'' #define F_ISPOW2(x)   (((x) & ((x) - 1)) == 0)   /* a truth value as a number: a TODO */\n'' C2T-TODO(function-like-macro) macros.h:47 -- a division whose operands may be integers or floats\n'' #define F_HALF(x)     ((x) / 2)                  /* integer or float division: a TODO */\n'' C2T-TODO(function-like-macro) macros.h:48 -- '#' cannot start an expression\n'' #define F_STR(x)      #x                         /* stringify: a TODO */\n'' C2T-TODO(function-like-macro) macros.h:49 -- '##' after the expression\n'' #define F_CAT(a, b)   a##b                       /* paste: a TODO */\n'' C2T-TODO(function-like-macro) macros.h:50 -- variadic: tiko has no __VA_ARGS__\n'' #define F_LOG(...)    lib_function(0)            /* variadic: a TODO */\n\n/' conditions '/\n#if (defined(TIKO_OS_WINDOWS) andalso ((0) = 0))\n#define ON_WINDOWS 1\n#elseif defined(TIKO_OS_LINUX)\n#define ON_LINUX 1\n#else\n'' C2T-TODO(unreached-branch) macros.h:58 -- inside a branch this pass does not take\n'' #define ON_OTHER 1\n#endif\n\n#if (M_SHL = 64)\n#define SHL_OK 1\n#endif\n\n'' C2T-TODO(conditional) macros.h:65 -- '_MSC_VER' has no tiko equivalent\n'' #ifdef _MSC_VER                     /* a compiler's identity: the group is a TODO */\n#if defined(TIKO_OS_WINDOWS)\n#define BY_MSVC 1\n#endif\n'' C2T-TODO(conditional) macros.h:67 -- '_MSC_VER' has no tiko equivalent\n'' #endif\n\nend extern\n
