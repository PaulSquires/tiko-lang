'' EXPECT-OUT: = call ptr fb_Date()
'' EXPECT-OUT: = call ptr F()
'' EXPECT-OUT: = call ptr fb_CurDir()
'' EXPECT-OUT: declare ptr fb_Command(i32 $0)
'' EXPECT-NOT: func.addr
