'' ARGS: --dump-ir tests/mir/src/instr-ustr-wide-needle.bas
'' EXPECT-EXIT: 0
'' EXPECT-OUT: verify: ok
'' EXPECT-OUT: 0 statements not lowered
'' EXPECT-OUT: fb_WstrToUStr(
'' EXPECT-OUT: fb_UStrInstr(
'' EXPECT-OUT: fb_UStrInstrRev(
