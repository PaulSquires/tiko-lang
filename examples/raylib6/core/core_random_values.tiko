'' raylib [core] example - random values
''
'' Example complexity rating: [★☆☆☆] 1/4
''
'' Example originally created with raylib 1.1, last time updated with raylib 1.1
''
'' Example licensed under an unmodified zlib/libpng license, which is an OSI-certified,
'' BSD-like license that allows static linking with closed source software
''
'' Copyright (c) 2014-2025 Ramon Santamaria (@raysan5)
''
'' Ported to tiko from raylib 6.2's examples/core/core_random_values.c.
'' Build it with 'tiko core_random_values.tiko'.
'' A number on its command line closes it after that many frames.

'' raylib linked DYNAMICALLY: raylib.dll is copied beside the program (on Linux,
'' libraylib.so.620). Write 'link static' instead to build raylib into the program.
#import "vendor/raylib6" link dynamic

dim as long maxFrames = valint( command( 1 ) )   '' a frame count closes it unattended
dim as long frameCount = 0

const screenWidth = 800
const screenHeight = 450

InitWindow( screenWidth, screenHeight, "raylib [core] example - random values" )

'' SetRandomSeed( &haabbccff )   '' Set a custom random seed if desired, by default: "time(NULL)"

dim as long randValue = GetRandomValue( -8, 5 )   '' Get a random integer number between -8 and 5 (both included)

dim as ulong framesCounter = 0   '' Variable used to count frames

SetTargetFPS( 60 )              '' Set our game to run at 60 frames-per-second

'' Main game loop
do while not WindowShouldClose( )    '' Detect window close button or ESC key
    '' Update
    framesCounter += 1

    '' Every two seconds (120 frames) a new random value is generated
    if ((framesCounter \ 120) mod 2) = 1 then
        randValue = GetRandomValue( -8, 5 )
        framesCounter = 0
    end if

    '' Draw
    BeginDrawing( )

        ClearBackground( RAYWHITE )

        DrawText( "Every 2 seconds a new random value is generated:", 130, 100, 20, MAROON )

        DrawText( TextFormat( "%i", randValue ), 360, 180, 80, LIGHTGRAY )

    EndDrawing( )
    frameCount += 1
    if frameCount = maxFrames then exit do
loop

CloseWindow( )        '' Close window and OpenGL context
