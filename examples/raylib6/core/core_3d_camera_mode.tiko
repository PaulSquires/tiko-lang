'' raylib [core] example - 3d camera mode
''
'' Example complexity rating: [★☆☆☆] 1/4
''
'' Example originally created with raylib 1.0, last time updated with raylib 1.0
''
'' Example licensed under an unmodified zlib/libpng license, which is an OSI-certified,
'' BSD-like license that allows static linking with closed source software
''
'' Copyright (c) 2014-2025 Ramon Santamaria (@raysan5)
''
'' Ported to tiko from raylib 6.2's examples/core/core_3d_camera_mode.c.
'' Build it with 'tiko core_3d_camera_mode.tiko'.
'' A number on its command line closes it after that many frames.

'' raylib linked DYNAMICALLY: raylib.dll is copied beside the program (on Linux,
'' libraylib.so.620). Write 'link static' instead to build raylib into the program.
#import "vendor/raylib" link dynamic

dim as long maxFrames = valint( command( 1 ) )   '' a frame count closes it unattended
dim as long frameCount = 0

const screenWidth = 800
const screenHeight = 450

InitWindow( screenWidth, screenHeight, "raylib [core] example - 3d camera mode" )

'' Define the camera to look into our 3d world
dim as Camera3D cam
cam.position = type<Vector3>( 0.0, 10.0, 10.0 )   '' Camera position
cam.target = type<Vector3>( 0.0, 0.0, 0.0 )       '' Camera looking at point
cam.up = type<Vector3>( 0.0, 1.0, 0.0 )           '' Camera up vector (rotation towards target)
cam.fovy = 45.0                                   '' Camera field-of-view Y
cam.projection = CAMERA_PERSPECTIVE               '' Camera mode type

dim as Vector3 cubePosition = ( 0.0, 0.0, 0.0 )

SetTargetFPS( 60 )              '' Set our game to run at 60 frames-per-second

'' Main game loop
do while not WindowShouldClose( )    '' Detect window close button or ESC key
    '' Update
    '' TODO: Update your variables here

    '' Draw
    BeginDrawing( )

        ClearBackground( RAYWHITE )

        BeginMode3D( cam )

            DrawCube( cubePosition, 2.0, 2.0, 2.0, RED )
            DrawCubeWires( cubePosition, 2.0, 2.0, 2.0, MAROON )

            DrawGrid( 10, 1.0 )

        EndMode3D( )

        DrawText( "Welcome to the third dimension!", 10, 40, 20, DARKGRAY )

        DrawFPS( 10, 10 )

    EndDrawing( )
    frameCount += 1
    if frameCount = maxFrames then exit do
loop

CloseWindow( )        '' Close window and OpenGL context
