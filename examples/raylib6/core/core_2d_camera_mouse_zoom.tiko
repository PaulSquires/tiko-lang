'' raylib [core] example - 2d camera mouse zoom
''
'' Example complexity rating: [★★☆☆] 2/4
''
'' Example originally created with raylib 4.2, last time updated with raylib 4.2
''
'' Example contributed by Jeffery Myers (@JeffM2501) and reviewed by Ramon Santamaria (@raysan5)
''
'' Example licensed under an unmodified zlib/libpng license, which is an OSI-certified,
'' BSD-like license that allows static linking with closed source software
''
'' Copyright (c) 2022-2025 Jeffery Myers (@JeffM2501)
''
'' Ported to tiko from raylib 6.2's examples/core/core_2d_camera_mouse_zoom.c.
'' Build it with 'tiko core_2d_camera_mouse_zoom.tiko'.
'' A number on its command line closes it after that many frames.

'' raylib linked DYNAMICALLY: raylib.dll is copied beside the program (on Linux,
'' libraylib.so.620). Write 'link static' instead to build raylib into the program.
#import "vendor/raylib" link dynamic
#import "vendor/raylib/rlgl"
#import "vendor/raylib/raymath"

dim as long maxFrames = valint( command( 1 ) )   '' a frame count closes it unattended
dim as long frameCount = 0

const screenWidth = 800
const screenHeight = 450

InitWindow( screenWidth, screenHeight, "raylib [core] example - 2d camera mouse zoom" )

dim as Camera2D cam
cam.zoom = 1.0

dim as long zoomMode = 0       '' 0-Mouse Wheel, 1-Mouse Move

SetTargetFPS( 60 )       '' Set our game to run at 60 frames-per-second

'' Main game loop
do while not WindowShouldClose( )        '' Detect window close button or ESC key
    '' Update
    if IsKeyPressed( KEY_ONE ) then
        zoomMode = 0
    elseif IsKeyPressed( KEY_TWO ) then
        zoomMode = 1
    end if

    '' Translate based on mouse right click
    if IsMouseButtonDown( MOUSE_BUTTON_LEFT ) then
        dim as Vector2 delta = GetMouseDelta( )
        delta = Vector2Scale( delta, -1.0 / cam.zoom )
        cam.target = Vector2Add( cam.target, delta )
    end if

    if zoomMode = 0 then
        '' Zoom based on mouse wheel
        dim as single wheel = GetMouseWheelMove( )
        if wheel <> 0 then
            '' Get the world point that is under the mouse
            dim as Vector2 mouseWorldPos = GetScreenToWorld2D( GetMousePosition( ), cam )

            '' Set the offset to where the mouse is, mouse is scaled to viewport space, but offset is in unscaled pixels
            cam.offset = Vector2Multiply( GetMousePosition( ), GetWindowScaleDPI( ) )

            '' Set the target to match, so that the camera maps the world space point
            '' under the cursor to the screen space point under the cursor at any zoom
            cam.target = mouseWorldPos

            '' Zoom increment
            '' Uses log scaling to provide consistent zoom speed
            dim as single scale = 0.2 * wheel
            cam.zoom = Clamp( exp( log( cam.zoom ) + scale ), 0.125, 64.0 )
        end if
    else
        '' Zoom based on mouse right click
        if IsMouseButtonPressed( MOUSE_BUTTON_RIGHT ) then
            '' Get the world point that is under the mouse
            dim as Vector2 mouseWorldPos = GetScreenToWorld2D( GetMousePosition( ), cam )

            '' Set the offset to where the mouse is, mouse is scaled to viewport space, but offset is in unscaled pixels
            cam.offset = Vector2Multiply( GetMousePosition( ), GetWindowScaleDPI( ) )

            '' Set the target to match, so that the camera maps the world space point
            '' under the cursor to the screen space point under the cursor at any zoom
            cam.target = mouseWorldPos
        end if
        if IsMouseButtonDown( MOUSE_BUTTON_RIGHT ) then
            '' Zoom increment
            '' Uses log scaling to provide consistent zoom speed
            dim as single deltaX = GetMouseDelta( ).x
            dim as single scale = 0.005 * deltaX
            cam.zoom = Clamp( exp( log( cam.zoom ) + scale ), 0.125, 64.0 )
        end if
    end if

    '' Draw
    BeginDrawing( )
        ClearBackground( RAYWHITE )

        BeginMode2D( cam )
            '' Draw the 3d grid, rotated 90 degrees and centered around 0,0
            '' just so we have something in the XY plane
            rlPushMatrix( )
                rlTranslatef( 0, 25 * 50, 0 )
                rlRotatef( 90, 1, 0, 0 )
                DrawGrid( 100, 50 )
            rlPopMatrix( )

            '' Draw a reference circle
            DrawCircle( GetScreenWidth( ) \ 2, GetScreenHeight( ) \ 2, 50, MAROON )
        EndMode2D( )

        '' Draw mouse reference
        DrawCircleV( GetMousePosition( ), 4, DARKGRAY )
        DrawTextEx( GetFontDefault( ), TextFormat( "[%i, %i]", GetMouseX( ), GetMouseY( ) ), _
            Vector2Add( GetMousePosition( ), type<Vector2>( -44, -24 ) ), 20, 2, BLACK )

        DrawText( "[1][2] Select mouse zoom mode (Wheel or Move)", 20, 20, 20, DARKGRAY )
        if zoomMode = 0 then
            DrawText( "Mouse left button drag to move, mouse wheel to zoom", 20, 50, 20, DARKGRAY )
        else
            DrawText( "Mouse left button drag to move, mouse press and move to zoom", 20, 50, 20, DARKGRAY )
        end if

    EndDrawing( )
    frameCount += 1
    if frameCount = maxFrames then exit do
loop

CloseWindow( )        '' Close window and OpenGL context
