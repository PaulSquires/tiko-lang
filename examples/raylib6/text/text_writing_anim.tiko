'' raylib [text] example - writing anim
''
'' Example complexity rating: [★★☆☆] 2/4
''
'' Example originally created with raylib 1.4, last time updated with raylib 1.4
''
'' Example licensed under an unmodified zlib/libpng license, which is an OSI-certified,
'' BSD-like license that allows static linking with closed source software
''
'' Copyright (c) 2016-2025 Ramon Santamaria (@raysan5)
''
'' Ported to tiko from raylib 6.2's examples/text/text_writing_anim.c.
'' Build it with 'tiko text_writing_anim.tiko'.
'' A number on its command line closes it after that many frames.

'' raylib linked DYNAMICALLY: raylib.dll is copied beside the program (on Linux,
'' libraylib.so.620). Write 'link static' instead to build raylib into the program.
#import "vendor/raylib6" link dynamic

dim as long maxFrames = valint( command( 1 ) )   '' a frame count closes it unattended
dim as long frameCount = 0

const screenWidth = 800
const screenHeight = 450

InitWindow( screenWidth, screenHeight, "raylib [text] example - writing anim" )

dim as ustring message = !"This sample illustrates a text writing\nanimation effect! Check it out! ;)"

dim as long framesCounter = 0

SetTargetFPS( 60 )              '' Set our game to run at 60 frames-per-second

'' Main game loop
do while not WindowShouldClose( )    '' Detect window close button or ESC key
    '' Update
    if IsKeyDown( KEY_SPACE ) then framesCounter += 8 else framesCounter += 1

    if IsKeyPressed( KEY_ENTER ) then framesCounter = 0

    '' Draw
    BeginDrawing( )

        ClearBackground( RAYWHITE )

        DrawText( TextSubtext( message, 0, framesCounter \ 10 ), 210, 160, 20, MAROON )

        DrawText( "PRESS [ENTER] to RESTART!", 240, 260, 20, LIGHTGRAY )
        DrawText( "HOLD [SPACE] to SPEED UP!", 239, 300, 20, LIGHTGRAY )

    EndDrawing( )
    frameCount += 1
    if frameCount = maxFrames then exit do
loop

CloseWindow( )        '' Close window and OpenGL context
