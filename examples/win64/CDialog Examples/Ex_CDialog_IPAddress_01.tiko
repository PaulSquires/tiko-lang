#import "sys/win"
#import "sys/win/gui"
using win, gui

' // Forward declaration
DECLARE FUNCTION DlgProc (BYVAL hDlg AS HWND, BYVAL uMsg AS DWORD, BYVAL wParam AS DWORD, BYVAL lParam AS LPARAM) AS INT_PTR

CONST IDC_IPADDRESS = 1001
CONST IDC_LABEL = 1002

' ========================================================================================
' Main
' ========================================================================================
FUNCTION main (BYVAL nCmdShow AS LONG = SW_SHOW) AS LONG

   ' // Set process DPI aware
   SetProcessDpiAwareness(PROCESS_SYSTEM_DPI_AWARE)
   ' // Enable visual styles without including a manifest file
   EnableVisualStyles

   ' // Create a new dialog using dialog units
   DIM pDlg AS CDialog
   pDlg.DialogNew(0, "CDialog - IPAddress", 50, 50, 220, 80, WS_OVERLAPPEDWINDOW OR DS_CENTER)

   ' // Add a label
   pDlg.ControlAdd("Label", IDC_LABEL, "", 20, 15, 180, 12, WS_BORDER)

   ' // Add an IPAddress control
   pDlg.ControlAdd("IPAddress", IDC_IPADDRESS, "", 75, 40, 70, 12)

   ' // Anchor the controls
   pDlg.ControlAnchor(IDC_IPADDRESS, ANCHOR_WIDTH)
   pDlg.ControlAnchor(IDC_LABEL, ANCHOR_WIDTH)

   ' // Display and activate the dialog as modal
   pDlg.DialogShowModal(@DlgProc)

   RETURN pDlg.DialogEndResult

END FUNCTION
' ========================================================================================

' ========================================================================================
' Dialog callback procedure
' ========================================================================================
FUNCTION DlgProc (BYVAL hDlg AS HWND, BYVAL uMsg AS DWORD, BYVAL wParam AS DWORD, BYVAL lParam AS LPARAM) AS INT_PTR
   
   ' // Pointer to the dialog class
   STATIC pDlg AS CDialog PTR
   
   SELECT CASE uMsg

      CASE WM_INITDIALOG
         ' // Get a pointer to the CDialog class
         pDlg = cast(CDialog PTR, lParam)
         RETURN TRUE

      CASE WM_COMMAND
         SELECT CASE CBCTL(wParam, lParam)
            CASE IDCANCEL
               ' // If ESC key pressed, close the application by sending an WM_CLOSE message
               IF CBCTLMSG(wParam, lParam) = BN_CLICKED THEN
                  pDlg->DialogSend(WM_CLOSE, 0, 0)
               END IF
            CASE IDC_IPADDRESS
               IF CBCTLMSG(wParam, lParam) = EN_CHANGE THEN
                  ' Sample code: Get the address in string form
                  DIM wszText AS WSTRING * 260 = pDlg->ControlGetText(IDC_IPADDRESS)
                  pDlg->ControlSetText(IDC_LABEL, wszText)
               END IF
         END SELECT
      CASE WM_NOTIFY
         ' // Notification messages
         DIM ptnmhdr AS NMHDR PTR = CAST(NMHDR PTR, lParam)
         SELECT CASE ptnmhdr->idFrom
            CASE IDC_IPADDRESS
               IF ptnmhdr->code = IPN_FIELDCHANGED THEN
                  ' *** Put your code here ***
               END IF
         END SELECT

      CASE WM_CLOSE
         ' // End the application
         pDlg->DialogEnd

   END SELECT

   RETURN FALSE

END FUNCTION
' ========================================================================================

' ========================================================================================
' // Call main() and return the error code to the OS
' ========================================================================================
END main()
' ========================================================================================
