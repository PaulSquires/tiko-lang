#import "sys/win"
#import "sys/win/gui"
using win, gui

#define IDC_LISTBOX 1001
#define IDC_PATH 1002

' // Forward declaration
DECLARE FUNCTION DlgProc (BYVAL hDlg AS HWND, BYVAL uMsg AS DWORD, BYVAL wParam AS DWORD, BYVAL lParam AS LPARAM) AS INT_PTR

' ========================================================================================
' Main
' ========================================================================================
FUNCTION main (BYVAL nCmdShow AS LONG = SW_SHOW) AS LONG

   ' // Set process DPI aware
   SetProcessDpiAwareness(PROCESS_SYSTEM_DPI_AWARE)
   ' // Enable visual styles
   EnableVisualStyles

   ' // Create a new dialog
   DIm pDlg AS CDialog
   pDlg.DialogNewPixels(NULL, "CDialog - DlgDirList", 0, 0, 320, 360, WS_OVERLAPPEDWINDOW OR DS_CENTER)

   ' // Add a label to display the path
   pDlg.ControlAdd("Label", IDC_PATH, "",  8, 8, 300, 23)
   ' // Anchor the label
   pDlg.ControlAnchor(IDC_PATH, ANCHOR_WIDTH)

   ' // Add a listbox
   DIM hListBox AS HWND = pDlg.ControlAdd("ListBox", IDC_LISTBOX, "", 8, 30, 300, 280)

   ' // Anchor the listbox
   pDlg.ControlAnchor(IDC_LISTBOX, ANCHOR_HEIGHT_WIDTH)

   ' // Fill the list box with the file names of a folder
   DlgDirListW(pdlg.hDialog, GetExePath, IDC_LISTBOX, IDC_PATH, 0)
   ' // Select the first item
   ListBox.SetCurSel(hListBox, 0)

   ' // Add a cancel button
   pDlg.ControlAdd("Button", IDCANCEL, "&Cancel", 233, 325, 75, 23)
   ' // Anchor the button
   pDlg.ControlAnchor(IDCANCEL, ANCHOR_BOTTOM_RIGHT)

   ' // Display and activate the dialog as modal
   pDlg.DialogShowModal(@DlgProc)

   RETURN pDlg.DialogEndResult

END FUNCTION
' ========================================================================================

' ========================================================================================
' Dialog callback procedure
' ========================================================================================
FUNCTION DlgProc (BYVAL hDlg AS HWND, BYVAL uMsg AS DWORD, BYVAL wParam AS DWORD, BYVAL lParam AS LPARAM) AS INT_PTR
   
   ' // Pointer to the dialog class
   STATIC pDlg AS CDialog PTR
   
   SELECT CASE uMsg

      CASE WM_INITDIALOG
         ' // Get a pointer to the CDialog class
         pDlg = cast(CDialog PTR, lParam)
         RETURN TRUE

      CASE WM_COMMAND
         SELECT CASE CBCTL(wParam, lParam)
            CASE IDCANCEL
               ' // If ESC key pressed, close the application by sending an WM_CLOSE message
               IF CBCTLMSG(wParam, lParam) = BN_CLICKED THEN
                  pDlg->DialogSend(WM_CLOSE, 0, 0)
               END IF
            CASE IDC_LISTBOX
               IF CBCTLMSG(wParam, lParam) = LBN_DBLCLK THEN
                  ' // Get the current selection
                  DIM curSel AS LONG = ListBox.GetCurSel(pDlg->ControlHandle(IDC_LISTBOX))
                  ' // Get the length of the ListBox item text
                  DIM ustrText AS USTRING = ListBox.GetText(pDlg->ControlHandle(IDC_LISTBOX), curSel)
                  MessageBoxW(hDlg, ustrText, "Message", MB_OK)
               END IF
         END SELECT

      CASE WM_CLOSE
         ' // End the application
         pDlg->DialogEnd(0)

   END SELECT

   RETURN FALSE

END FUNCTION
' ========================================================================================

' ========================================================================================
' // Call main() and return the error code to the OS
' ========================================================================================
END main()
' ========================================================================================
