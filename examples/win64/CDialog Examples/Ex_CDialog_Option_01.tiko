#import "sys/win"
#import "sys/win/gui"
using win, gui

' // Forward declaration
DECLARE FUNCTION DlgProc (BYVAL hDlg AS HWND, BYVAL uMsg AS DWORD, BYVAL wParam AS DWORD, BYVAL lParam AS LPARAM) AS INT_PTR

CONST IDC_GROUPBOX = 1001
CONST IDC_OPTION1 = 1002
CONST IDC_OPTION2 = 1003
CONST IDC_OPTION3 = 1004

' ========================================================================================
' Main
' ========================================================================================
FUNCTION main (BYVAL nCmdShow AS LONG = SW_SHOW) AS LONG

   ' // Set process DPI aware
   SetProcessDpiAwareness(PROCESS_SYSTEM_DPI_AWARE)
   ' // Enable visual styles without including a manifest file
   EnableVisualStyles

   ' // Create a new dialog using dialog units
   DIM pDlg AS CDialog
   pDlg.DialogNewPixels(0, "CDialog with option buttons", 0, 0, 275, 180, WS_OVERLAPPEDWINDOW OR DS_CENTER)

   ' // Add a frame control
   pDlg.ControlAdd("GroupBox", IDC_GROUPBOX, "Options", 10, 10, 255, 110)
   ' // Add three radio buttons (the first one should have the WS_GROUP style)
   pDlg.ControlAdd("Option", IDC_OPTION1, "Option 1", 60, 40, 75, 23, WS_GROUP)
   pDlg.ControlAdd("Option", IDC_OPTION2, "Option 2", 60, 60, 75, 23)
   pDlg.ControlAdd("Option", IDC_OPTION3, "Option 3", 60, 80, 75, 23)
   ' // Check the second radio button
   pDlg.ControlSetOption(IDC_OPTION2, IDC_OPTION1, IDC_OPTION3)

   ' // Add a cancel button to the dialog
   pDlg.ControlAdd("Button", IDCANCEL, "&Cancel", 95, 140, 80, 23, BS_DEFPUSHBUTTON)

   ' // Anchor the button to the bottom and the right side of the dialog
   pDlg.ControlAnchor(IDC_GROUPBOX, ANCHOR_WIDTH)
   pDlg.ControlAnchor(IDCANCEL, ANCHOR_CENTER_HORZ_BOTTOM)

   ' // Display and activate the dialog as modal
   pDlg.DialogShowModal(@DlgProc)

   RETURN pDlg.DialogEndResult

END FUNCTION
' ========================================================================================

' ========================================================================================
' Dialog callback procedure
' ========================================================================================
FUNCTION DlgProc (BYVAL hDlg AS HWND, BYVAL uMsg AS DWORD, BYVAL wParam AS DWORD, BYVAL lParam AS LPARAM) AS INT_PTR
   
   ' // Pointer to the dialog class
   STATIC pDlg AS CDialog PTR
   
   SELECT CASE uMsg

      CASE WM_INITDIALOG
         ' // Get a pointer to the CDialog class
         pDlg = cast(CDialog PTR, lParam)
         RETURN TRUE

      CASE WM_COMMAND
         SELECT CASE CBCTL(wParam, lParam)
            CASE IDCANCEL
               ' // If ESC key pressed, close the application by sending an WM_CLOSE message
               IF CBCTLMSG(wParam, lParam) = BN_CLICKED THEN
                  pDlg->DialogSend(WM_CLOSE, 0, 0)
               END IF
         END SELECT

      CASE WM_CLOSE
         ' // End the application
         pDlg->DialogEnd(0)

   END SELECT

   RETURN FALSE

END FUNCTION
' ========================================================================================

' ========================================================================================
' // Call main() and return the error code to the OS
' ========================================================================================
END main()
' ========================================================================================
