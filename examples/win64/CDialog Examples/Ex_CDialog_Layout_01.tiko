#import "sys/win"
#import "sys/win/gui"
using win, gui

' // Forward declaration
DECLARE FUNCTION DlgProc(BYVAL hDlg AS HWND, BYVAL uMsg AS DWORD, BYVAL wParam AS DWORD, BYVAL lParam AS LPARAM) AS INT_PTR

' // Control identifiers
ENUM
   IDC_EDIT1 = 1001
   IDC_EDIT2
   IDC_LABEL
   IDC_GROUPBOX
   IDC_COMBOBOX
END ENUM

' ========================================================================================
' Main
' ========================================================================================
FUNCTION main (BYVAL nCmdShow AS LONG = SW_SHOW) AS LONG

   ' // Set process DPI aware
   SetProcessDpiAwareness(PROCESS_SYSTEM_DPI_AWARE)
   ' // Enable visual styles
   EnableVisualStyles

   ' // Create a new dialog
   DIM pDlg AS CDialog
   pDlg.DialogNewPixels(0, "CDialog - Colors and Layout Demo",,, 450, 180, WS_OVERLAPPEDWINDOW OR DS_CENTER)

   ' // Set the dialog's backgroung color
   pDlg.DialogSetColor(-1, RGB_GOLD)
   ' pDlg.DialogDisableRepaintOnResize(TRUE)    ' // optional: disable repaint on resizing

   ' // Add an Edit control
   pDlg.ControlAdd("Edit", IDC_EDIT1, "", 15, 15, 305, 23)
   ' // Add a multiline Edit control
   pDlg.ControlAdd("Edit", IDC_EDIT2, "", 15, 45, 305, 80, WS_TABSTOP OR WS_VSCROLL OR ES_LEFT OR ES_AUTOHSCROLL OR ES_MULTILINE OR ES_NOHIDESEL OR ES_WANTRETURN)
   ' // Add more controls
   pDlg.ControlAdd("Groupbox", IDC_GROUPBOX, "Groupbox", 335, 8, 100, 155)
   ' // Disable themes for the GroupBox control; otherwise, the caption colors can't be changed
   SetWindowTheme(pDlg.ControlHandle(IDC_GROUPBOX), "", "")

   pDlg.ControlAdd("Button", IDCANCEL, "&Close", 245, 140, 75, 23)
   pDlg.ControlAdd("Label", IDC_LABEL, "Label", 15, 140, 75, 23)
   ' // Add a combobox control
   DIM hCombo AS HWND = pDlg.ControlAdd("ComboBox", IDC_COMBOBOX, "", 345, 30, 80, 100)
   ' // Fill the control with some data
   DIM ustrText AS USTRING
   FOR i AS LONG = 1 TO 9
      ustrText = "Item " & RIGHT("00" & STR(i), 2)
      Combo.AddString(hCombo, ustrText)
   NEXT

   ' // Set control's colors
   pDlg.ControlSetColor(IDC_EDIT1, RGB_WHITE, RGB_CORAL)
   pDlg.ControlSetColor(IDC_EDIT2, RGB_WHITE, RGB_LIGHTBLUE)
   pDlg.ControlSetColor(IDC_LABEL, RGB_YELLOW, RGB_GREEN)
   pDlg.ControlSetColor(IDC_GROUPBOX, RGB_WHITE, RGB_RED)

   ' // Anchor the controls
   pDlg.ControlAnchor(IDC_EDIT1, ANCHOR_WIDTH)
   pDlg.ControlAnchor(IDC_EDIT2, ANCHOR_HEIGHT_WIDTH)
   pDlg.ControlAnchor(IDCANCEL, ANCHOR_BOTTOM_RIGHT)
   pDlg.ControlAnchor(IDC_LABEL, ANCHOR_BOTTOM)
   pDlg.ControlAnchor(IDC_GROUPBOX, ANCHOR_HEIGHT_RIGHT)
   pDlg.ControlAnchor(IDC_COMBOBOX, ANCHOR_RIGHT)

   ' // Display and activate the dialog as modal
   pDlg.DialogShowModal(@DlgProc)

   ' // Display and activate the dialog as modeless
'   pDlg.DialogShowModeless(@DlgProc)

   ' // Message handler loop
'   DO
'      pDlg.DialogDoEvents
'   LOOP WHILE IsWindow(pDlg.hDialog)

   FUNCTION = pDlg.DialogEndResult

END FUNCTION
' ========================================================================================

' ========================================================================================
' Dialog callback procedure
' ========================================================================================
FUNCTION DlgProc (BYVAL hDlg AS HWND, BYVAL uMsg AS DWORD, BYVAL wParam AS DWORD, BYVAL lParam AS LPARAM) AS INT_PTR

   ' // Pointer to the dialog class
   STATIC pDlg AS CDialog PTR

   SELECT CASE uMsg

      CASE WM_INITDIALOG
         ' // Get a pointer to the CDialog class
         pDlg = cast(CDialog PTR, lParam)
         RETURN TRUE

      CASE WM_COMMAND
         SELECT CASE CBCTL(wParam, lParam)
            CASE IDCANCEL
               ' // If ESC key pressed, close the application by sending an WM_CLOSE message
               IF CBCTLMSG(wParam, lParam) = BN_CLICKED THEN
                  pDlg->DialogSend(WM_CLOSE, 0, 0)
               END IF
         END SELECT

      CASE WM_CLOSE
         ' // Multiline edit controls send a WM_CLOSE message when the Esc key is pressed.
         ' // This is a workaround; the proper way is to subclass the control and eat the ESC key.
         IF GetFocus = pDlg->ControlHandle(IDC_EDIT2) THEN RETURN TRUE   ' // abort
         ' // End the application
         pDlg->DialogEnd
   END SELECT

END FUNCTION
' ========================================================================================

' ========================================================================================
' // Call main() and return the error code to the OS
' ========================================================================================
END main()
' ========================================================================================
