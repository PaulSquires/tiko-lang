#import "sys/win"
#import "sys/win/gui"
using win, gui

' // Forward declaration
DECLARE FUNCTION DlgProc (BYVAL hDlg AS HWND, BYVAL uMsg AS DWORD, BYVAL wParam AS DWORD, BYVAL lParam AS LPARAM) AS INT_PTR

CONST IDC_UPDOWN = 1001
CONST IDC_TEXTBOX = 1002

' ========================================================================================
' Main
' ========================================================================================
FUNCTION main (BYVAL nCmdShow AS LONG = SW_SHOW) AS LONG

   ' // Set process DPI aware
   SetProcessDpiAwareness(PROCESS_SYSTEM_DPI_AWARE)
   ' // Enable visual styles without including a manifest file
   EnableVisualStyles

   ' // Create a new dialog using dialog units
   DIM pDlg AS CDialog
   pDlg.DialogNew(NULL, "CDialog UpDown Control", 50, 50, 190, 85, WS_OVERLAPPEDWINDOW OR DS_CENTER)

   ' // Add a label control
   pDlg.ControlAdd("Label", -1, "How many lines?", 46, 29, 57, 12)
   ' // Add an edit control
   pDlg.ControlAdd("Edit", IDC_TEXTBOX, "", 114, 29, 29, 12)
   ' // Add an UpDown control (the size and position will be automatically adjusted to the buddy control)
   pDlg.ControlAdd("UpDown",IDC_UPDOWN)

   ' // Set the edit control as buddy of the updown control
   DIM hUpDown AS HWND = pDlg.ControlHandle(IDC_UPDOWN)
   DIM hTextBox AS HWND = pDlg.ControlHandle(IDC_TEXTBOX)
   UpDown.SetBuddy(hUpDown, hTextBox)
   ' // Set the base
   UpDown.SetBase(hUpDown, 10)
   ' // Set the range
   UpDown.SetRange32(hUpDown, 0, 100)
   ' // Set the default initial value
   UpDown.SetPos32(hUpDown, 1)

   ' // Add a cancel button
   pDlg.ControlAdd("Button", IDCANCEL, "&Close", 120, 60, 50, 12)

   ' // Anchor the controls
   pDlg.ControlAnchor(IDCANCEL, ANCHOR_BOTTOM_RIGHT)

   ' // Display and activate the dialog as modal
   pDlg.DialogShowModal(@DlgProc)

   RETURN pDlg.DialogEndResult

END FUNCTION
' ========================================================================================

' ========================================================================================
' Dialog callback procedure
' ========================================================================================
FUNCTION DlgProc (BYVAL hDlg AS HWND, BYVAL uMsg AS DWORD, BYVAL wParam AS DWORD, BYVAL lParam AS LPARAM) AS INT_PTR
   
   ' // Pointer to the dialog class
   STATIC pDlg AS CDialog PTR
   
   SELECT CASE uMsg

      CASE WM_INITDIALOG
         ' // Get a pointer to the CDialog class
         pDlg = cast(CDialog PTR, lParam)
         RETURN TRUE

      CASE WM_COMMAND
         SELECT CASE CBCTL(wParam, lParam)
            CASE IDCANCEL
               ' // If ESC key pressed, close the application by sending an WM_CLOSE message
               IF CBCTLMSG(wParam, lParam) = BN_CLICKED THEN
                  pDlg->DialogSend(WM_CLOSE, 0, 0)
               END IF
         END SELECT

      CASE WM_NOTIFY
         ' // Process notification messages
         DIM tUD AS NMUPDOWN
         CBNMTYPESET(tUD, wParam, lParam)
         IF tUD.hdr.idFrom = IDC_UPDOWN THEN
            IF tUD.hdr.code = UDN_DELTAPOS THEN
               ' Put your code here, e.g.
               ' tUD.iPos -> ' Up-down control's current position.
               ' tUD.iDelta -> ' Proposed change in the up-down control's position.
            END IF
            ' Return TRUE to prevent the change in the control's position, or FALSE to allow the change.
            RETURN TRUE
         END IF

      CASE WM_CLOSE
         ' // End the application
         pDlg->DialogEnd(0)

   END SELECT

   RETURN FALSE

END FUNCTION
' ========================================================================================

' ========================================================================================
' // Call main() and return the error code to the OS
' ========================================================================================
END main()
' ========================================================================================
