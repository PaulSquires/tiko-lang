#import "sys/win"
#import "sys/win/gui"
using win, gui

' // Forward declaration
DECLARE FUNCTION DlgProc (BYVAL hDlg AS HWND, BYVAL uMsg AS DWORD, BYVAL wParam AS DWORD, BYVAL lParam AS LPARAM) AS INT_PTR

CONST IDC_LINE1 = 1001
CONST IDC_LINE2 = 1002
CONST IDC_LINE3 = 1003

' ========================================================================================
' Main
' ========================================================================================
FUNCTION main (BYVAL nCmdShow AS LONG = SW_SHOW) AS LONG

   ' // Set process DPI aware
   SetProcessDpiAwareness(PROCESS_SYSTEM_DPI_AWARE)
   ' // Enable visual styles without including a manifest file
   EnableVisualStyles

   ' // Create a new dialog using dialog units
   DIM pDlg AS CDialog
   pDlg.DialogNew(NULL, "CDialog with Line controls", , , 195, 100, WS_OVERLAPPEDWINDOW OR DS_CENTER)

   ' // Add the Line controls
   pDlg.ControlAdd("Line", IDC_LINE1, "", 10, 10, 175, 1, WS_VISIBLE OR SS_ETCHEDFRAME OR SS_NOTIFY)
   pDlg.ControlAdd("Line", IDC_LINE2, "", 10, 20, 175, 10, WS_VISIBLE OR SS_ETCHEDFRAME OR SS_NOTIFY)
   pDlg.ControlAdd("Line", IDC_LINE3, "", 10, 40, 175, 25, WS_VISIBLE OR SS_ETCHEDFRAME OR SS_NOTIFY)

   ' // Add a button
   pDlg.ControlAdd("Button", IDCANCEL, "&Close", 135, 75, 50, 12)

   ' // Anchor the controls
   pDlg.ControlAnchor(IDC_LINE1, ANCHOR_WIDTH)
   pDlg.ControlAnchor(IDC_LINE2, ANCHOR_WIDTH)
   pDlg.ControlAnchor(IDC_LINE3, ANCHOR_WIDTH)
   pDlg.ControlAnchor(IDCANCEL, ANCHOR_BOTTOM_RIGHT)

   ' // Display and activate the dialog as modal
   pDlg.DialogShowModal(@DlgProc)

   RETURN pDlg.DialogEndResult

END FUNCTION
' ========================================================================================

' ========================================================================================
' Dialog callback procedure
' ========================================================================================
FUNCTION DlgProc (BYVAL hDlg AS HWND, BYVAL uMsg AS DWORD, BYVAL wParam AS DWORD, BYVAL lParam AS LPARAM) AS INT_PTR
   
   ' // Pointer to the dialog class
   STATIC pDlg AS CDialog PTR
   
   SELECT CASE uMsg

      CASE WM_INITDIALOG
         ' // Get a pointer to the CDialog class
         pDlg = cast(CDialog PTR, lParam)
         RETURN TRUE

      CASE WM_COMMAND
         SELECT CASE CBCTL(wParam, lParam)
            CASE IDCANCEL
               ' // If ESC key pressed, close the application by sending an WM_CLOSE message
               IF CBCTLMSG(wParam, lParam) = BN_CLICKED THEN
                  pDlg->DialogSend(WM_CLOSE, 0, 0)
               END IF
            CASE IDC_LINE1
               IF CBCTLMSG(wParam, lParam) = BN_CLICKED THEN
                  MessageBoxW(hDlg, "Line 1 clicked", "Messaage", MB_OK)
               END IF
            CASE IDC_LINE2
               IF CBCTLMSG(wParam, lParam) = BN_CLICKED THEN
                  MessageBoxW(hDlg, "Line 2 clicked", "Message", MB_OK)
               END IF
            CASE IDC_LINE3
               IF CBCTLMSG(wParam, lParam) = BN_CLICKED THEN
                  MessageBoxW(hDlg, "Line 3 clicked", "Message", MB_OK)
               END IF
         END SELECT

      CASE WM_CLOSE
         ' // End the application
         pDlg->DialogEnd

   END SELECT

   RETURN FALSE

END FUNCTION
' ========================================================================================

' ========================================================================================
' // Call main() and return the error code to the OS
' ========================================================================================
END main()
' ========================================================================================
