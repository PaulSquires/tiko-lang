#import "sys/win"
#import "sys/win/gui"
using win, gui

' // Forward declaration
DECLARE FUNCTION DlgProc (BYVAL hDlg AS HWND, BYVAL uMsg AS DWORD, BYVAL wParam AS DWORD, BYVAL lParam AS LPARAM) AS INT_PTR

CONST IDC_LABEL = 1001
CONST IDC_DTPICKER = 1002

' ========================================================================================
' Main
' ========================================================================================
FUNCTION main (BYVAL nCmdShow AS LONG = SW_SHOW) AS LONG

   ' // Set process DPI aware
   SetProcessDpiAwareness(PROCESS_SYSTEM_DPI_AWARE)
   ' // Enable visual styles without including a manifest file
   EnableVisualStyles

   ' // Create a new dialog using dialog units
   DIM pDlg AS CDialog
   pDlg.DialogNew(NULL, "CDialog with a DateTimePicker", 50, 50, 190, 80, WS_OVERLAPPEDWINDOW OR DS_CENTER)

   ' // Add a label
   pDlg.ControlAdd("Label", IDC_LABEL, "", 25, 15, 150, 12)
   ' // Add a date time picker control to the dialog
   DIM hDTP AS HWND = pDlg.ControlAdd("DateTimePicker", IDC_DTPICKER, "", 35, 30, 115, 12)
   ' // Set the date
   DIM st AS SYSTEMTIME
   st.wDay = 1
   st.wMonth = 7
   st.wYear = 2025
   DTP.SetSystemTime(hDTP, GDT_VALID, @st)

   ' // Anchor the controls
   pDlg.ControlAnchor(IDC_LABEL, ANCHOR_WIDTH)
   pDlg.ControlAnchor(IDC_DTPICKER, ANCHOR_WIDTH)

   ' // Display and activate the dialog as modal
   pDlg.DialogShowModal(@DlgProc)

   RETURN pDlg.DialogEndResult

END FUNCTION
' ========================================================================================

' ========================================================================================
' Dialog callback procedure
' ========================================================================================
FUNCTION DlgProc (BYVAL hDlg AS HWND, BYVAL uMsg AS DWORD, BYVAL wParam AS DWORD, BYVAL lParam AS LPARAM) AS INT_PTR
   
   ' // Pointer to the dialog class
   STATIC pDlg AS CDialog PTR
   
   SELECT CASE uMsg

      CASE WM_INITDIALOG
         ' // Get a pointer to the CDialog class
         pDlg = cast(CDialog PTR, lParam)
         RETURN TRUE

      CASE WM_COMMAND
         SELECT CASE CBCTL(wParam, lParam)
            CASE IDCANCEL
               ' // If ESC key pressed, close the application by sending an WM_CLOSE message
               IF CBCTLMSG(wParam, lParam) = BN_CLICKED THEN
                   pDlg->DialogSend(WM_CLOSE, 0, 0)
               END IF
         END SELECT
         
      CASE WM_NOTIFY
         ' // Notification messages
         DIM dt AS NMDATETIMECHANGE
         CBNMTYPESET(dt, wParam, lParam)
         IF dt.nmhdr.idfrom = IDC_DTPICKER THEN
            IF dt.nmhdr.code = DTN_DATETIMECHANGE THEN
               ' // Get the selected date
               DIM wszDate AS WSTRING * 260
               GetDateFormatW LOCALE_USER_DEFAULT, DATE_LONGDATE, @dt.st, NULL, wszDate, SIZEOF(wszDate)\2
               DIM hLabel AS HWND = GetDlgItem(hDlg, IDC_LABEL)
               SetWindowTextW(hLabel, "Selected date: " & wszDate)
            END IF
         END IF

      CASE WM_CLOSE
         ' // End the application
         pDlg->DialogEnd

   END SELECT

   RETURN FALSE

END FUNCTION
' ========================================================================================

' ========================================================================================
' // Call main() and return the error code to the OS
' ========================================================================================
END main()
' ========================================================================================
