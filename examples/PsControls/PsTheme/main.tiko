' ========================================================================================
' PsTheme gallery -- one of each common control under the shared theme.
'
' The three option buttons switch the theme: System follows the Windows light/dark setting
' live (change it in Settings and watch), Light and Dark fix it. No control here is given a
' colour or a font: the theme and the form's fonts reach each one as it is created.
' ========================================================================================

#import "vendor/PsControls/PsApp"
#import "vendor/PsControls/PsMenuBar"
#import "vendor/PsControls/PsPopupMenu"
#import "vendor/PsControls/PsOptionButton"
#import "vendor/PsControls/PsButton"
#import "vendor/PsControls/PsCheckBox"
#import "vendor/PsControls/PsToggle"
#import "vendor/PsControls/PsComboBox"
#import "vendor/PsControls/PsTextBox"
#import "vendor/PsControls/PsNumericUpDown"
#import "vendor/PsControls/PsDatePicker"
#import "vendor/PsControls/PsProgressBar"

using PsApp
using PsBufferPaint
using PsTheme
using PsRegistry
using PsMenuBar
using PsPopupMenu
using PsOptionButton
using PsButton
using PsCheckBox
using PsToggle
using PsComboBox
using PsTextBox
using PsNumericUpDown
using PsDatePicker
using PsProgressBar

enum
    IDC_MENUBAR = 100
    IDC_SYSTEM
    IDC_LIGHT
    IDC_DARK
    IDC_BUTTON
    IDC_CHECK
    IDC_TOGGLE
    IDC_COMBO
    IDC_TEXT
    IDC_NUMBER
    IDC_DATE
    IDC_PROGRESS
end enum

const ROW_COUNT = 9
dim shared gLabels( 0 to ROW_COUNT - 1 ) as ustring
dim shared app as PsApplication


' ---- layout: a label column the form paints, a control column -------------------------
private function RowTop( byval f as PsForm ptr, byval i as long ) as long
    return f->ScaleY( 30 ) + f->ScaleY( 16 ) + (i * f->ScaleY( 44 ))
end function

sub Gallery_OnPaint( byval f as PsForm ptr, byref b as PsPaintBuffer )
    dim as PSTHEME_COLORS t = app.Theme()
    b.SetBackColor( t.Window )
    b.PaintClientRect()
    b.SetFont( f->Font( PSFONT_UI ) )
    b.SetColors( t.TextDim, t.Window )
    for i as long = 0 to ROW_COUNT - 1
        dim as RECT rc
        SetRect( @rc, f->ScaleX( 16 ), RowTop( f, i ), f->ScaleX( 150 ), RowTop( f, i ) + f->ScaleY( 32 ) )
        b.PaintText( gLabels(i), @rc, DT_LEFT or DT_VCENTER or DT_SINGLELINE )
    next
end sub

private sub Place( byval f as PsForm ptr, byval id as long, byval row as long, byval x as long, _
                   byval w as long, byval h as long )
    dim as long y = RowTop( f, row ) + ((f->ScaleY( 32 ) - h) \ 2)
    SetWindowPos( f->Item( id ), null, x, y, w, h, SWP_NOZORDER or SWP_SHOWWINDOW )
end sub

sub Gallery_OnSize( byval f as PsForm ptr, byval cx as long, byval cy as long )
    dim as long x = f->ScaleX( 160 )
    dim as long w, h
    SetWindowPos( f->Item( IDC_MENUBAR ), null, 0, 0, cx, f->ScaleY( 30 ), SWP_NOZORDER or SWP_SHOWWINDOW )

    dim as long xo = x
    for id as long = IDC_SYSTEM to IDC_DARK
        PsOptionButton_GetIdealSize( f->Item( id ), w, h )
        Place( f, id, 0, xo, w, h )
        xo += w + f->ScaleX( 16 )
    next
    PsButton_GetIdealSize( f->Item( IDC_BUTTON ), w, h ) : Place( f, IDC_BUTTON, 1, x, w, h )
    PsCheckBox_GetIdealSize( f->Item( IDC_CHECK ), w, h ) : Place( f, IDC_CHECK, 2, x, w, h )
    PsToggle_GetIdealSize( f->Item( IDC_TOGGLE ), w, h ) : Place( f, IDC_TOGGLE, 3, x, w, h )
    PsComboBox_GetIdealSize( f->Item( IDC_COMBO ), w, h ) : Place( f, IDC_COMBO, 4, x, w, h )
    Place( f, IDC_TEXT, 5, x, cx - x - f->ScaleX( 16 ), f->ScaleY( 30 ) )
    PsNumericUpDown_GetIdealSize( f->Item( IDC_NUMBER ), w, h ) : Place( f, IDC_NUMBER, 6, x, w, h )
    PsDatePicker_GetIdealSize( f->Item( IDC_DATE ), w, h ) : Place( f, IDC_DATE, 7, x, w, h )
    Place( f, IDC_PROGRESS, 8, x, cx - x - f->ScaleX( 16 ), f->ScaleY( 10 ) )
end sub

sub ThemeChoice_Changed( byval h as HWND, byval isChecked as boolean )
    if isChecked = false then exit sub
    select case GetDlgCtrlID( h )
    case IDC_SYSTEM : app.SetThemeMode( PSAPP_THEME_SYSTEM )
    case IDC_LIGHT  : app.SetThemeMode( PSAPP_THEME_LIGHT )
    case IDC_DARK   : app.SetThemeMode( PSAPP_THEME_DARK )
    end select
end sub

function Gallery_Build( ) as PsForm ptr
    dim as PsForm ptr f = app.NewForm( "PsTheme gallery", 560, 500 )
    dim as HWND hwnd = f->hWindow

    dim as HWND hBar = PsMenuBar_Create( hwnd, IDC_MENUBAR )
    PsMenuBar_AddItem( hBar, "File", 1 )
    PsMenuBar_AddItem( hBar, "View", 2 )
    dim as HWND hFile = PsPopupMenu_Create( hwnd )
    PsPopupMenu_AddItem( hFile, 1001, "New", "Ctrl+N" )
    PsPopupMenu_AddItem( hFile, 1002, "Disabled", "", true )
    PsPopupMenu_AddSeparator( hFile )
    PsPopupMenu_AddItem( hFile, 1003, "Exit", "Alt+F4" )
    PsMenuBar_SetDropDown( hBar, 0, hFile )
    dim as HWND hView = PsPopupMenu_Create( hwnd )
    PsPopupMenu_AddItem( hView, 2001, "Checked", "", false, true )
    PsMenuBar_SetDropDown( hBar, 1, hView )

    gLabels(0) = "Theme"
    dim as ustring names(0 to 2) = { "System", "Light", "Dark" }
    for i as long = 0 to 2
        dim as HWND hOpt = PsOptionButton_Create( hwnd, IDC_SYSTEM + i )
        PsOptionButton_SetText( hOpt, names(i) )
        PsOptionButton_SetCheckChangedCallback( hOpt, @ThemeChoice_Changed )
    next
    PsOptionButton_SetChecked( f->Item( IDC_SYSTEM ), true )

    gLabels(1) = "Button"
    PsButton_SetText( PsButton_Create( hwnd, IDC_BUTTON ), "Press me" )
    gLabels(2) = "Check box"
    dim as HWND hChk = PsCheckBox_Create( hwnd, IDC_CHECK )
    PsCheckBox_SetText( hChk, "Remember this" )
    PsCheckBox_SetChecked( hChk, true )
    gLabels(3) = "Toggle"
    PsToggle_SetChecked( PsToggle_Create( hwnd, IDC_TOGGLE ), true )
    gLabels(4) = "Combo box"
    dim as HWND hCbo = PsComboBox_Create( hwnd, IDC_COMBO )
    PsComboBox_AddItem( hCbo, "First choice" )
    PsComboBox_AddItem( hCbo, "Second choice" )
    PsComboBox_SetCurSel( hCbo, 0 )
    gLabels(5) = "Text box"
    PsTextBox_SetCueBannerText( PsTextBox_Create( hwnd, IDC_TEXT ), "Type here" )
    gLabels(6) = "Number"
    PsNumericUpDown_SetValue( PsNumericUpDown_Create( hwnd, IDC_NUMBER ), 42 )
    gLabels(7) = "Date"
    PsDatePicker_Create( hwnd, IDC_DATE )
    gLabels(8) = "Progress"
    dim as HWND hPrg = PsProgressBar_Create( hwnd, IDC_PROGRESS )
    PsProgressBar_SetRange( hPrg, 0, 100 )
    PsProgressBar_SetPos( hPrg, 60 )

    f->OnPaint( @Gallery_OnPaint )
    f->OnSize( @Gallery_OnSize )
    return f
end function


#include once "selftest.tiko"

app.Init( )
dim as PsForm ptr frmMain = Gallery_Build( )
if ThemeSelfTest_Enabled( ) then end ThemeSelfTest_Run( frmMain )
' "main.exe light" or "main.exe dark" starts in that theme.
select case lcase( command( 1 ) )
case "light"
    app.SetThemeMode( PSAPP_THEME_LIGHT )
    PsOptionButton_SetChecked( frmMain->Item( IDC_LIGHT ), true )
case "dark"
    app.SetThemeMode( PSAPP_THEME_DARK )
    PsOptionButton_SetChecked( frmMain->Item( IDC_DARK ), true )
end select
end app.Run( frmMain )
