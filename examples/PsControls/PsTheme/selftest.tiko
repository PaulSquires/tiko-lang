' ========================================================================================
' PsApp P3 self-test, gated on PSTHEME_SELFTEST=1 (RFC-0001 section 11):
'   - every control on the gallery follows Dark and Light exactly as its adapter says;
'   - a pinned control is left alone, and UnpinColors hands it back;
'   - a control created later is themed at once; the form's fonts reached the controls;
'   - the title bar follows IsDark; WM_SETTINGCHANGE "ImmersiveColorSet" restores the system theme;
'   - INFO lines: how far each adapter's Dark output is from the control's built-in default.
' ========================================================================================

dim shared gTT_Pass as long
dim shared gTT_Fail as long

private sub TT_Check( byval bOK as boolean, byval what as string, byval detail as string = "" )
    dim as string s
    if bOK then
        gTT_Pass += 1
        s = "PASS  " & what
    else
        gTT_Fail += 1
        s = "FAIL  " & what
    end if
    if len( detail ) then s &= "   [" & detail & "]"
    print s
end sub

function ThemeSelfTest_Enabled( ) as boolean
    return environ( "PSTHEME_SELFTEST" ) = "1"
end function

' Every PS<X>_COLORS type is a run of COLORREFs, so two of them compare as COLORREF arrays.
private function TT_DiffCount( byval a as any ptr, byval b as any ptr, byval cb as long ) as long
    dim as COLORREF ptr pa = a, pb = b
    dim as long n = 0
    for i as long = 0 to (cb \ sizeof( COLORREF )) - 1
        if pa[i] <> pb[i] then n += 1
    next
    return n
end function

#macro TT_ADAPTER( X, T, hCtl, theme, tag )
scope
    dim as T got
    dim as T want = X##_ThemeColors( theme )
    X##_GetColors( hCtl, @got )
    dim as long nd = TT_DiffCount( @got, @want, sizeof( T ) )
    TT_Check( nd = 0, #X & " follows the " & tag & " theme", str( nd ) & " fields differ" )
end scope
#endmacro

#macro TT_DARKINFO( X, T )
scope
    dim as T d
    dim as T k = X##_ThemeColors( PsTheme_Dark() )
    dim as string s = "INFO  " & #X & ": Dark differs from the built-in default in " & _
                      str( TT_DiffCount( @d, @k, sizeof( T ) ) ) & " of " & str( sizeof( T ) \ sizeof( COLORREF ) ) & " fields"
    print s
end scope
#endmacro

private sub TT_AllFollow( byval f as PsForm ptr, byref t as PSTHEME_COLORS, byval tag as string )
    TT_ADAPTER( PsButton, PSBUTTON_COLORS, f->Item( IDC_BUTTON ), t, tag )
    TT_ADAPTER( PsCheckBox, PSCHECKBOX_COLORS, f->Item( IDC_CHECK ), t, tag )
    TT_ADAPTER( PsOptionButton, PSOPTIONBUTTON_COLORS, f->Item( IDC_LIGHT ), t, tag )
    TT_ADAPTER( PsToggle, PSTOGGLE_COLORS, f->Item( IDC_TOGGLE ), t, tag )
    TT_ADAPTER( PsComboBox, PSCOMBOBOX_COLORS, f->Item( IDC_COMBO ), t, tag )
    TT_ADAPTER( PsNumericUpDown, PSNUMERICUPDOWN_COLORS, f->Item( IDC_NUMBER ), t, tag )
    TT_ADAPTER( PsDatePicker, PSDATEPICKER_COLORS, f->Item( IDC_DATE ), t, tag )
    TT_ADAPTER( PsProgressBar, PSPROGRESSBAR_COLORS, f->Item( IDC_PROGRESS ), t, tag )
    TT_Check( PsTextBox_GetBackColor( f->Item( IDC_TEXT ) ) = t.Surface, "PsTextBox follows the " & tag & " theme" )
end sub

dim shared gTT_DpiOld as long
dim shared gTT_DpiNew as long
private sub TT_OnDpi( byval f as PsForm ptr, byval oldDpi as long, byval newDpi as long )
    gTT_DpiOld = oldDpi
    gTT_DpiNew = newDpi
end sub

' The gallery's controls (the option buttons, button, check box, toggle, combo, text box, number,
' date picker, progress bar) and the menubar.
private function TT_AllAtDpi( byval f as PsForm ptr, byval dpi as long ) as long
    dim as long nWrong = 0
    for id as long = IDC_MENUBAR to IDC_PROGRESS
        dim as CWindow ptr p = CWindowPtr( f->Item( id ) )
        if (p = 0) orelse (clng( p->DPI ) <> dpi) then nWrong += 1
    next
    return nWrong
end function

' Sends the WM_DPICHANGED Windows would, with the window's rect scaled about its top-left corner.
private sub TT_SendDpi( byval f as PsForm ptr, byval newDpi as long )
    dim as HWND h = f->hWindow
    dim as long oldDpi = clng( f->DPI )
    dim as RECT rc
    ..GetWindowRect( h, @rc )
    dim as RECT rcNew
    SetRect( @rcNew, rc.left, rc.top, rc.left + MulDiv( rc.right - rc.left, newDpi, oldDpi ), _
             rc.top + MulDiv( rc.bottom - rc.top, newDpi, oldDpi ) )
    SendMessageW( h, &h02E0, MAKEWPARAM( newDpi, newDpi ), cast( LPARAM, @rcNew ) )
end sub

private function TT_TitleBarDark( byval h as HWND ) as boolean
    dim as BOOL v = FALSE
    DwmGetWindowAttribute( h, 20, @v, sizeof( v ) )
    return v <> 0
end function

function ThemeSelfTest_Run( byval f as PsForm ptr ) as long
    print "=== PsTheme self-test ==="
    dim as HWND hForm = f->hWindow
    dim as PSTHEME_COLORS tDark = PsTheme_Dark()
    dim as PSTHEME_COLORS tLight = PsTheme_Light()
    dim as PSTHEME_COLORS tSys = PsTheme_System()

    ' ---- start-up: the system theme, the form's fonts -----------------------------------
    TT_Check( PsTheme_Equal( app.Theme(), tSys ), "Init applied the system theme", _
              iif( tSys.IsDark, "system is dark", "system is light" ) )
    TT_AllFollow( f, tSys, "start-up" )
    TT_Check( PsButton_GetFont( f->Item( IDC_BUTTON ) ) = f->Font( PSFONT_UI ), "a new button got the form's UI font" )
    TT_Check( PsTextBox_GetFont( f->Item( IDC_TEXT ) ) = f->Font( PSFONT_UI ), "a new text box got the form's UI font" )

    ' ---- switching ----------------------------------------------------------------------
    app.SetThemeMode( PSAPP_THEME_DARK )
    TT_AllFollow( f, tDark, "Dark" )
    TT_Check( TT_TitleBarDark( hForm ), "the title bar is dark under Dark" )
    app.SetThemeMode( PSAPP_THEME_LIGHT )
    TT_AllFollow( f, tLight, "Light" )
    TT_Check( TT_TitleBarDark( hForm ) = false, "the title bar is light under Light" )

    ' ---- pinning ------------------------------------------------------------------------
    dim as HWND hBtn = f->Item( IDC_BUTTON )
    dim as PSBUTTON_COLORS mine, got
    dim as COLORREF ptr pm = cast( COLORREF ptr, @mine )
    for i as long = 0 to (sizeof( mine ) \ sizeof( COLORREF )) - 1
        pm[i] = BGR( 200, 30, 30 )
    next
    PsButton_SetColors( hBtn, @mine )
    app.SetThemeMode( PSAPP_THEME_DARK )
    PsButton_GetColors( hBtn, @got )
    TT_Check( TT_DiffCount( @got, @mine, sizeof( mine ) ) = 0, "a pinned button keeps its own colours through a switch" )
    PsButton_UnpinColors( hBtn )
    TT_ADAPTER( PsButton, PSBUTTON_COLORS, hBtn, tDark, "Dark (after UnpinColors)" )

    ' ---- a control created later ----------------------------------------------------------
    dim as HWND hLate = PsButton_Create( hForm, 999 )
    TT_ADAPTER( PsButton, PSBUTTON_COLORS, hLate, tDark, "Dark (created after the switch)" )
    DestroyWindow( hLate )

    ' ---- following the system -----------------------------------------------------------
    app.SetThemeMode( PSAPP_THEME_SYSTEM )
    TT_Check( PsTheme_Equal( app.Theme(), tSys ), "SYSTEM mode restores the system theme" )
    app.SetTheme( iif( tSys.IsDark, tLight, tDark ) )        ' out of step with Windows
    SendMessageW( hForm, WM_SETTINGCHANGE, 0, cast( LPARAM, @wstr( "ImmersiveColorSet" ) ) )
    TT_Check( PsTheme_Equal( app.Theme(), tSys ), "WM_SETTINGCHANGE ImmersiveColorSet brings it back in step" )
    app.SetThemeMode( PSAPP_THEME_LIGHT )
    SendMessageW( hForm, WM_SETTINGCHANGE, 0, cast( LPARAM, @wstr( "ImmersiveColorSet" ) ) )
    TT_Check( PsTheme_Equal( app.Theme(), tLight ), "a fixed mode ignores the Windows setting" )

    ' ---- how far Dark is from the built-in defaults (information, not a pass/fail) ---------
    TT_DARKINFO( PsButton, PSBUTTON_COLORS )
    TT_DARKINFO( PsCheckBox, PSCHECKBOX_COLORS )
    TT_DARKINFO( PsOptionButton, PSOPTIONBUTTON_COLORS )
    TT_DARKINFO( PsToggle, PSTOGGLE_COLORS )
    TT_DARKINFO( PsComboBox, PSCOMBOBOX_COLORS )
    TT_DARKINFO( PsNumericUpDown, PSNUMERICUPDOWN_COLORS )
    TT_DARKINFO( PsDatePicker, PSDATEPICKER_COLORS )
    TT_DARKINFO( PsProgressBar, PSPROGRESSBAR_COLORS )

    ' ---- per-monitor DPI (P4): a simulated monitor change, out and back -------------------
    f->OnDpiChanged( @TT_OnDpi )
    dim as long dpi0 = clng( f->DPI )
    dim as long dpi1 = iif( dpi0 = 96, 144, 96 )
    dim as long w0, h0, w1, h1, w2, h2
    PsButton_GetIdealSize( f->Item( IDC_BUTTON ), w0, h0 )
    dim as HFONT hUI0 = f->Font( PSFONT_UI )
    TT_Check( TT_AllAtDpi( f, dpi0 ) = 0, "every control starts at the form's DPI", "dpi=" & str( dpi0 ) )

    TT_SendDpi( f, dpi1 )
    dim as RECT rcWant, rcGot
    ..GetWindowRect( hForm, @rcGot )
    TT_Check( clng( f->DPI ) = dpi1, "the form takes the new DPI", str( dpi0 ) & " -> " & str( dpi1 ) )
    TT_Check( (gTT_DpiOld = dpi0) andalso (gTT_DpiNew = dpi1), "OnDpiChanged reports old and new" )
    TT_Check( TT_AllAtDpi( f, dpi1 ) = 0, "every control moved to the new DPI", _
              "wrong=" & str( TT_AllAtDpi( f, dpi1 ) ) )
    TT_Check( f->Font( PSFONT_UI ) <> hUI0, "the UI font was re-created" )
    TT_Check( PsTextBox_GetFont( f->Item( IDC_TEXT ) ) = f->Font( PSFONT_UI ), "the text box holds the new font" )
    TT_Check( PsButton_GetFont( f->Item( IDC_BUTTON ) ) = f->Font( PSFONT_UI ), "the button holds the new font" )
    PsButton_GetIdealSize( f->Item( IDC_BUTTON ), w1, h1 )
    dim as double rw = w1 / w0, rexp = dpi1 / dpi0
    TT_Check( abs( rw - rexp ) <= 0.15 * rexp, "the button's ideal width follows the DPI", _
              str( w0 ) & " -> " & str( w1 ) & " (x" & left( str( rw ), 5 ) & ", DPI x" & left( str( rexp ), 5 ) & ")" )

    TT_SendDpi( f, dpi0 )
    PsButton_GetIdealSize( f->Item( IDC_BUTTON ), w2, h2 )
    TT_Check( (abs( w2 - w0 ) <= 2) andalso (abs( h2 - h0 ) <= 2), "out and back restores the ideal size within 2 px", _
              str( w0 ) & "x" & str( h0 ) & " -> " & str( w2 ) & "x" & str( h2 ) )
    TT_Check( TT_AllAtDpi( f, dpi0 ) = 0, "every control is back at the original DPI" )

    ' ---- tear-down ----------------------------------------------------------------------
    PostMessageW( hForm, WM_CLOSE, 0, 0 )
    app.Run( f )
    dim as PSTHEME_COLORS tAfter
    TT_Check( PsRegistry_GetTheme( tAfter ) = false, "Run's tear-down clears the theme" )

    print "=== PsTheme: " & str( gTT_Pass ) & "/" & str( gTT_Pass + gTT_Fail ) & " assertions passed"
    return gTT_Fail
end function
