' ========================================================================================
' PsApp starter -- copy this folder to begin a PsControls application.
'
' A form with a menubar, a text box, a combobox and an OK button, and a modal About box.
' vendor/PsControls/PsApp does the rest: COM, GDI+, DPI awareness, the glyph font, the
' message pump (with every control's pump obligation), tab navigation and tear-down.
' ========================================================================================

#import "vendor/PsControls/PsApp"
#import "vendor/PsControls/PsMenuBar"
#import "vendor/PsControls/PsPopupMenu"
#import "vendor/PsControls/PsTextBox"
#import "vendor/PsControls/PsComboBox"
#import "vendor/PsControls/PsButton"

using PsApp
using PsBufferPaint
using PsRegistry
using PsMenuBar
using PsPopupMenu
using PsTextBox
using PsComboBox
using PsButton

enum
    IDC_MENUBAR = 100
    IDC_NAME
    IDC_GREETING
    IDC_OK
end enum

enum
    IDM_FILE_EXIT = 1000
    IDM_HELP_ABOUT
end enum

dim shared app as PsApplication

' The palette. PsMenuBar's and PsPopupMenu's colour types have no defaults (zero is black on
' black), so a program sets them; the button, combobox and text box defaults are used as they
' are. RFC-0001 phase P3 replaces this with a shared theme every control follows.
const CLR_BACK     = BGR( 33, 37, 43)
const CLR_SURFACE  = BGR( 44, 49, 58)
const CLR_TEXT     = BGR(200,205,214)
const CLR_TEXT_DIM = BGR( 90, 96,106)
const CLR_HOT      = BGR( 38, 79,120)
const CLR_HOT_TEXT = BGR(255,255,255)

sub ApplyMenuColors( byval hPopup as HWND )
    dim as PSPOPUPMENU_COLORS c
    c.BackColor = CLR_SURFACE : c.ForeColor = CLR_TEXT
    c.BackColorHot = CLR_HOT  : c.ForeColorHot = CLR_HOT_TEXT
    c.ForeColorDisabled = CLR_TEXT_DIM : c.BorderColor = CLR_HOT
    PsPopupMenu_SetColors( hPopup, @c )
end sub


' ========================================================================================
' The About box: a modal PsForm. ShowModal disables the owner, pumps until EndModal (or Esc,
' or the close box), re-enables the owner and destroys the form.
' ========================================================================================
sub About_OnPaint( byval f as PsForm ptr, byref b as PsPaintBuffer )
    b.SetBackColor( GetSysColor( COLOR_WINDOW ) )
    b.PaintClientRect()
    dim as RECT rc
    GetClientRect( f->hWindow, @rc )
    rc.top += f->ScaleY( 24 )
    b.SetFont( f->Font( PSFONT_UI_LARGE ) )
    b.SetColors( GetSysColor( COLOR_WINDOWTEXT ), GetSysColor( COLOR_WINDOW ) )
    b.PaintText( "PsApp starter", @rc, DT_CENTER )
    rc.top += f->ScaleY( 32 )
    b.SetFont( f->Font( PSFONT_UI ) )
    b.PaintText( "Built with tiko and vendor/PsControls", @rc, DT_CENTER )
end sub

sub About_OnSize( byval f as PsForm ptr, byval cx as long, byval cy as long )
    dim as long bw, bh
    PsButton_GetIdealSize( f->Item( IDOK ), bw, bh )
    SetWindowPos( f->Item( IDOK ), null, (cx - bw) \ 2, cy - bh - f->ScaleY( 16 ), bw, bh, _
                  SWP_NOZORDER or SWP_SHOWWINDOW )
end sub

sub ShowAbout( byval owner as PsForm ptr )
    dim as PsForm ptr dlg = app.NewForm( "About", 360, 200, _
            WS_POPUP or WS_CAPTION or WS_SYSMENU or WS_CLIPCHILDREN, _
            WS_EX_CONTROLPARENT or WS_EX_DLGMODALFRAME, owner->hWindow )
    dim as HWND hOk = PsButton_Create( dlg->hWindow, IDOK )
    PsButton_SetText( hOk, "OK" )
    PsButton_SetFont( hOk, dlg->Font( PSFONT_UI ) )
    PsButton_SetClickCallback( hOk, _
        sub( byval h as HWND, byval id as long )
            PsForm.FromHwnd( h )->EndModal( IDOK )
        end sub )
    dlg->OnPaint( @About_OnPaint )
    dlg->OnSize( @About_OnSize )
    dlg->ShowModal( owner->hWindow )
end sub


' ========================================================================================
' The main form
' ========================================================================================
sub frmMain_OnPaint( byval f as PsForm ptr, byref b as PsPaintBuffer )
    b.SetBackColor( CLR_BACK )
    b.PaintClientRect()
end sub

sub frmMain_OnSize( byval f as PsForm ptr, byval cx as long, byval cy as long )
    dim as long pad  = f->ScaleX( 16 )
    dim as long barH = f->ScaleY( 30 )
    dim as long rowH = f->ScaleY( 30 )

    SetWindowPos( f->Item( IDC_MENUBAR ), null, 0, 0, cx, barH, SWP_NOZORDER or SWP_SHOWWINDOW )
    SetWindowPos( f->Item( IDC_NAME ), null, pad, barH + pad, cx - (2 * pad), rowH, _
                  SWP_NOZORDER or SWP_SHOWWINDOW )

    dim as long w, h
    PsComboBox_GetIdealSize( f->Item( IDC_GREETING ), w, h )
    SetWindowPos( f->Item( IDC_GREETING ), null, pad, barH + (2 * pad) + rowH, w, h, _
                  SWP_NOZORDER or SWP_SHOWWINDOW )

    PsButton_GetIdealSize( f->Item( IDC_OK ), w, h )
    SetWindowPos( f->Item( IDC_OK ), null, cx - pad - w, cy - pad - h, w, h, _
                  SWP_NOZORDER or SWP_SHOWWINDOW )
end sub

sub frmMain_MenuCommand( byval hBar as HWND, byval id as long )
    dim as PsForm ptr f = PsForm.FromHwnd( hBar )
    select case id
    case IDM_FILE_EXIT
        f->Close()
    case IDM_HELP_ABOUT
        ShowAbout( f )
    end select
end sub

sub frmMain_OkClick( byval hOk as HWND, byval id as long )
    dim as PsForm ptr f = PsForm.FromHwnd( hOk )
    dim as ustring wszName = PsTextBox_GetText( f->Item( IDC_NAME ) )
    if len( wszName ) = 0 then wszName = "world"
    dim as wstring * 256 wszTitle = PsComboBox_GetText( f->Item( IDC_GREETING ) ) & ", " & wszName
    SetWindowTextW( f->hWindow, wszTitle )
end sub

function frmMain_Build( ) as PsForm ptr
    dim as PsForm ptr f = app.NewForm( "PsApp starter", 520, 300 )
    dim as HFONT hFont = f->Font( PSFONT_UI )

    ' The menubar. Its dropdowns belong to it from SetDropDown on: its filter drives them.
    dim as HWND hBar = PsMenuBar_Create( f->hWindow, IDC_MENUBAR )
    PsMenuBar_SetFont( hBar, hFont )
    dim as PSMENUBAR_COLORS bc
    bc.BackColor = CLR_BACK : bc.ForeColor = CLR_TEXT
    bc.BackColorHot = CLR_SURFACE : bc.ForeColorHot = CLR_HOT_TEXT
    PsMenuBar_SetColors( hBar, @bc )
    PsMenuBar_SetCommandCallback( hBar, @frmMain_MenuCommand )
    PsMenuBar_AddItem( hBar, "File", 1 )
    PsMenuBar_AddItem( hBar, "Help", 2 )
    dim as HWND hFile = PsPopupMenu_Create( f->hWindow )
    PsPopupMenu_SetFonts( hFile, hFont )
    ApplyMenuColors( hFile )
    PsPopupMenu_AddItem( hFile, IDM_FILE_EXIT, "Exit", "Alt+F4" )
    PsMenuBar_SetDropDown( hBar, 0, hFile )
    dim as HWND hHelp = PsPopupMenu_Create( f->hWindow )
    PsPopupMenu_SetFonts( hHelp, hFont )
    ApplyMenuColors( hHelp )
    PsPopupMenu_AddItem( hHelp, IDM_HELP_ABOUT, "About..." )
    PsMenuBar_SetDropDown( hBar, 1, hHelp )

    dim as HWND hName = PsTextBox_Create( f->hWindow, IDC_NAME )
    PsTextBox_SetFont( hName, hFont )
    PsTextBox_SetCueBannerText( hName, "Your name" )

    dim as HWND hGreet = PsComboBox_Create( f->hWindow, IDC_GREETING )
    PsComboBox_SetFont( hGreet, hFont )
    PsComboBox_AddItem( hGreet, "Hello" )
    PsComboBox_AddItem( hGreet, "Good morning" )
    PsComboBox_AddItem( hGreet, "Welcome" )
    PsComboBox_SetCurSel( hGreet, 0 )

    dim as HWND hOk = PsButton_Create( f->hWindow, IDC_OK )
    PsButton_SetText( hOk, "OK" )
    PsButton_SetFont( hOk, hFont )
    PsButton_SetClickCallback( hOk, @frmMain_OkClick )

    f->OnPaint( @frmMain_OnPaint )
    f->OnSize( @frmMain_OnSize )
    return f
end function


' The self-test (PSAPP_SELFTEST=1). Delete this line and selftest.tiko when copying the starter.
#include once "selftest.tiko"

app.Init( )
dim as PsForm ptr frmMain = frmMain_Build( )
if PsAppSelfTest_Enabled( ) then end PsAppSelfTest_Run( app, frmMain )
end app.Run( frmMain )
