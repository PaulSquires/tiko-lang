' ========================================================================================
' PsApp self-test, gated on PSAPP_SELFTEST=1. Asserts what RFC-0001 section 11 lists for P1:
' the registry, the pump's filters, modal forms, OnClose, first-tab focus, OnSize geometry and
' FromHwnd. Prints PASS/FAIL lines and returns the number of failures as the exit code.
' ========================================================================================

dim shared gST_Pass as long
dim shared gST_Fail as long
dim shared gST_FilterSaw as boolean
dim shared gST_FormSaw as boolean
dim shared gST_TimerTicks as long

const WM_ST_PROBE = WM_APP + 77
const IDT_ST = 7

private sub ST_Check( byval bOK as boolean, byval what as string, byval detail as string = "" )
    dim as string s
    if bOK then
        gST_Pass += 1
        s = "PASS  " & what
    else
        gST_Fail += 1
        s = "FAIL  " & what
    end if
    if len( detail ) then s &= "   [" & detail & "]"
    print s
end sub

function PsAppSelfTest_Enabled( ) as boolean
    return environ( "PSAPP_SELFTEST" ) = "1"
end function

' The app filter under test: claims the probe message, so the form must never see it, and ends
' the modal loop it arrives in.
private function ST_Filter( byval pMsg as MSG ptr ) as boolean
    if pMsg->message <> WM_ST_PROBE then return false
    gST_FilterSaw = true
    dim as PsForm ptr f = PsForm.FromHwnd( pMsg->hwnd )
    if f then f->EndModal( 77 )
    return true
end function

private function ST_FormProbe( byval f as PsForm ptr, byval uMsg as UINT, byval wParam as WPARAM, _
                               byval lParam as LPARAM, byref result as LRESULT ) as boolean
    gST_FormSaw = true
    return true
end function

' First tick posts the probe into the modal form's queue; the filter ends the loop.
private sub ST_ModalTimer( byval f as PsForm ptr, byval id as UINT_PTR )
    gST_TimerTicks += 1
    if gST_TimerTicks = 1 then PostMessageW( f->hWindow, WM_ST_PROBE, 0, 0 )
    if gST_TimerTicks > 40 then f->EndModal( -1 )          ' safety net: never hang the test
end sub

dim shared gST_SelOld as long = -2
dim shared gST_SelNew as long = -2
private sub ST_SelChange( byval h as HWND, byval idxOld as long, byval idxNew as long )
    gST_SelOld = idxOld
    gST_SelNew = idxNew
end sub

private sub ST_CloseTimer( byval f as PsForm ptr, byval id as UINT_PTR )
    KillTimer( f->hWindow, id )
    f->Close()
end sub

private function ST_RefuseClose( byval f as PsForm ptr ) as boolean
    return false
end function

private function ST_RectOf( byval h as HWND, byval hParent as HWND ) as RECT
    dim as RECT rc
    GetWindowRect( h, @rc )
    MapWindowPoints( null, hParent, cast( POINT ptr, @rc ), 2 )
    return rc
end function


function PsAppSelfTest_Run( byref app as PsApplication, byval f as PsForm ptr ) as long
    print "=== PsApp self-test ==="
    dim as HWND hForm  = f->hWindow
    dim as HWND hBar   = f->Item( IDC_MENUBAR )
    dim as HWND hName  = f->Item( IDC_NAME )
    dim as HWND hGreet = f->Item( IDC_GREETING )
    dim as HWND hOk    = f->Item( IDC_OK )

    ' ---- the registry --------------------------------------------------------------------
    ' Rows: the menubar and the combobox (their dropdowns were handed over). Globals: PsTextBox.
    ST_Check( PsRegistry_Count() = 2, "rows: menubar + combobox, popups handed over", _
              "count=" & str( PsRegistry_Count() ) )
    ST_Check( PsRegistry_GlobalCount() = 1, "one global filter (PsTextBox)", _
              "globals=" & str( PsRegistry_GlobalCount() ) )
    ST_Check( PsRegistry_HasRow( hBar ) andalso PsRegistry_HasRow( hGreet ), "menubar and combobox have rows" )
    ST_Check( PsRegistry_HasRow( PsMenuBar_GetDropDown( hBar, 0 ) ) = false, "a menubar dropdown has no row" )

    dim as HWND hCtx = PsPopupMenu_Create( hForm )
    ST_Check( PsRegistry_HasRow( hCtx ), "a standalone popup has a row" )
    dim as HWND hSub = PsPopupMenu_Create( hForm )
    PsPopupMenu_AddItem( hCtx, 1, "Sub" )
    PsPopupMenu_SetItemSubMenu( hCtx, 1, hSub )
    ST_Check( PsRegistry_HasRow( hSub ) = false, "an attached submenu has no row" )
    DestroyWindow( hCtx )                 ' destroys the attached submenu with it
    ST_Check( PsRegistry_Count() = 2, "destroying the popup removes its row", _
              "count=" & str( PsRegistry_Count() ) )

    dim as HWND hName2 = PsTextBox_Create( hForm, 999 )
    ST_Check( PsRegistry_GlobalCount() = 1, "a second text box shares the global filter" )
    DestroyWindow( hName2 )
    ST_Check( PsRegistry_GlobalCount() = 1, "...and one destroyed keeps the other's reference" )

    ' ---- show: first layout, first-tab focus ----------------------------------------------
    f->Show( SW_SHOWNORMAL )
    dim as HWND hFocus = GetFocus()
    ST_Check( (hFocus = hName) orelse (IsChild( hName, hFocus ) <> 0), "focus on the first tab stop after Show", _
              "focus=&h" & hex( cast( integer, hFocus ) ) )

    ' ---- OnSize geometry -----------------------------------------------------------------
    f->SetClientSize( 600, 400 )          ' DIPs; CWindow scales
    dim as RECT rcClient
    GetClientRect( hForm, @rcClient )
    dim as long pad = f->ScaleX( 16 )
    dim as RECT rcOk = ST_RectOf( hOk, hForm )
    ST_Check( abs( rcOk.right - (rcClient.right - pad) ) <= 1, "OK button right edge = client - pad", _
              "right=" & str( rcOk.right ) & " expect=" & str( rcClient.right - pad ) )
    ST_Check( abs( rcOk.bottom - (rcClient.bottom - pad) ) <= 1, "OK button bottom edge = client - pad", _
              "bottom=" & str( rcOk.bottom ) & " expect=" & str( rcClient.bottom - pad ) )
    dim as RECT rcBar = ST_RectOf( hBar, hForm )
    ST_Check( (rcBar.right - rcBar.left) = rcClient.right, "menubar spans the client width", _
              "w=" & str( rcBar.right - rcBar.left ) )

    ' ---- FromHwnd ------------------------------------------------------------------------
    dim as HWND hInner = GetWindow( hName, GW_CHILD )
    ST_Check( PsForm.FromHwnd( hInner ) = f, "FromHwnd from a control's child window" )
    ST_Check( PsForm.FromHwnd( PsMenuBar_GetDropDown( hBar, 0 ) ) = f, "FromHwnd from an owned popup" )
    ST_Check( PsForm.FromHwnd( GetDesktopWindow() ) = 0, "FromHwnd of a foreign window is null" )

    ' ---- modal + pump filter -------------------------------------------------------------
    app.AddMessageFilter( @ST_Filter )
    dim as PsForm ptr dlg = app.NewForm( "modal", 200, 100, WS_POPUP or WS_CAPTION, _
                                         WS_EX_CONTROLPARENT, hForm )
    dlg->OnMessage( WM_ST_PROBE, @ST_FormProbe )
    dlg->OnTimer( @ST_ModalTimer )
    SetTimer( dlg->hWindow, IDT_ST, 20, null )
    dim as HWND hDlg = dlg->hWindow
    dim as long code = dlg->ShowModal( hForm )
    ST_Check( code = 77, "ShowModal returns EndModal's code", "code=" & str( code ) )
    ST_Check( gST_FilterSaw, "the app filter saw the posted message" )
    ST_Check( gST_FormSaw = false, "a claimed message never reaches the form" )
    ST_Check( IsWindowEnabled( hForm ) <> 0, "the owner is enabled after ShowModal" )
    ST_Check( IsWindow( hDlg ) = 0, "the modal form is destroyed after ShowModal" )
    app.RemoveMessageFilter( @ST_Filter )

    ' ---- OnClose -------------------------------------------------------------------------
    dim as PsForm ptr g = app.NewForm( "closable", 200, 100 )
    dim as HWND hG = g->hWindow
    g->OnClose( @ST_RefuseClose )
    g->Close()
    ST_Check( IsWindow( hG ) <> 0, "OnClose returning FALSE cancels the close" )
    g->OnClose( 0 )
    g->Close()
    ST_Check( IsWindow( hG ) = 0, "with no OnClose, Close destroys the form" )

    ' ---- Run: the pump drives an open dropdown, then ends with the main form --------------
    ' End + Enter reach the combobox's list only through its registered filter: nothing in
    ' this program calls PsComboBox_FilterMessage. (End, not Down: the list opens with no row
    ' highlighted, so Down would land on the item already selected and change nothing.)
    PsComboBox_SetSelChangeCallback( hGreet, @ST_SelChange )
    ST_Check( PsComboBox_DropDown( hGreet ), "the combobox opens" )
    PostMessageW( hForm, WM_KEYDOWN, VK_END, 0 )
    PostMessageW( hForm, WM_KEYDOWN, VK_RETURN, 0 )
    ' Closed from a timer, not posted now: Enter makes the list POST its pick to the combobox,
    ' and a WM_CLOSE already in the queue would destroy the form ahead of it.
    f->OnTimer( @ST_CloseTimer )
    SetTimer( hForm, IDT_ST, 150, null )
    dim as long rc = app.Run( f )
    ST_Check( (gST_SelOld = 0) andalso (gST_SelNew = 2), "End + Enter through the pump picked the last item", _
              "sel " & str( gST_SelOld ) & " -> " & str( gST_SelNew ) )
    ST_Check( rc = 0, "Run returns when the main form closes", "rc=" & str( rc ) )
    ST_Check( IsWindow( hForm ) = 0, "the main form is gone after Run" )
    ST_Check( PsRegistry_Count() = 0, "every row is gone after Run", "count=" & str( PsRegistry_Count() ) )
    ST_Check( PsRegistry_GlobalCount() = 0, "every global filter released after Run" )
    ST_Check( PsApp_Instance() = 0, "the application is torn down" )

    print "=== PsApp: " & str( gST_Pass ) & "/" & str( gST_Pass + gST_Fail ) & " assertions passed"
    return gST_Fail
end function
