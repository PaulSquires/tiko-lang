' ========================================================================================
' PsApp worker example -- background work that reports back to the window.
'
' A goroutine (std/tasks) does the work; it never touches a window. Every progress step goes
' back to the UI thread through app.RunOnUI, which queues the call and wakes the message loop.
' Built with -mt (tiko.toml), which std/tasks requires.
' ========================================================================================

#import "std/tasks"
#import "vendor/PsControls/PsApp"
#import "vendor/PsControls/PsButton"
#import "vendor/PsControls/PsProgressBar"

using tasks
using PsApp
using PsBufferPaint
using PsButton
using PsProgressBar

enum
    IDC_START = 100
    IDC_PROGRESS
end enum

const STEPS = 100

dim shared app as PsApplication
dim shared gStatus as ustring          ' set in frmMain_Build


' ========================================================================================
' The worker. It runs on another thread: it computes, then hands each result to the UI
' thread. The payload here is the step number itself, so nothing is allocated.
' ========================================================================================
declare sub Ui_Progress( byval payload as any ptr )
declare sub Ui_Done( byval payload as any ptr )

sub Worker( byval nSteps as long )
    for i as long = 1 to nSteps
        Sleep 20                                        ' stands in for real work
        app.RunOnUI( @Ui_Progress, cast( any ptr, cast( integer, i ) ) )
    next
    app.RunOnUI( @Ui_Done )
end sub


' ========================================================================================
' UI-thread side
' ========================================================================================
dim shared gForm as PsForm ptr

sub Ui_Progress( byval payload as any ptr )
    dim as long i = cast( long, cast( integer, payload ) )
    PsProgressBar_SetPos( gForm->Item( IDC_PROGRESS ), i )
    gStatus = "Working... step " & str( i ) & " of " & str( STEPS )
    InvalidateRect( gForm->hWindow, null, false )
end sub

sub Ui_Done( byval payload as any ptr )
    gStatus = "Done."
    EnableWindow( gForm->Item( IDC_START ), true )
    InvalidateRect( gForm->hWindow, null, false )
end sub

sub Start_Click( byval h as HWND, byval id as long )
    EnableWindow( h, false )
    PsProgressBar_SetPos( gForm->Item( IDC_PROGRESS ), 0 )
    spawn Worker( STEPS )
end sub

sub frmMain_OnPaint( byval f as PsForm ptr, byref b as PsPaintBuffer )
    b.SetBackColor( BGR( 33, 37, 43 ) )
    b.PaintClientRect()
    dim as RECT rc
    GetClientRect( f->hWindow, @rc )
    rc.left += f->ScaleX( 16 )
    rc.top  += f->ScaleY( 104 )
    b.SetFont( f->Font( PSFONT_UI ) )
    b.SetColors( BGR( 200, 205, 214 ), BGR( 33, 37, 43 ) )
    b.PaintText( gStatus, @rc, DT_LEFT )
end sub

sub frmMain_OnSize( byval f as PsForm ptr, byval cx as long, byval cy as long )
    dim as long pad = f->ScaleX( 16 )
    dim as long w, h
    PsButton_GetIdealSize( f->Item( IDC_START ), w, h )
    SetWindowPos( f->Item( IDC_START ), null, pad, pad, w, h, SWP_NOZORDER or SWP_SHOWWINDOW )
    SetWindowPos( f->Item( IDC_PROGRESS ), null, pad, pad + h + pad, cx - (2 * pad), f->ScaleY( 12 ), _
                  SWP_NOZORDER or SWP_SHOWWINDOW )
end sub

function frmMain_Build( ) as PsForm ptr
    dim as PsForm ptr f = app.NewForm( "PsApp worker", 480, 180 )
    gForm = f
    gStatus = "Press Start."

    dim as HWND hStart = PsButton_Create( f->hWindow, IDC_START )
    PsButton_SetText( hStart, "Start" )
    PsButton_SetFont( hStart, f->Font( PSFONT_UI ) )
    PsButton_SetClickCallback( hStart, @Start_Click )

    dim as HWND hBar = PsProgressBar_Create( f->hWindow, IDC_PROGRESS )
    PsProgressBar_SetRange( hBar, 0, STEPS )

    f->OnPaint( @frmMain_OnPaint )
    f->OnSize( @frmMain_OnSize )
    return f
end function


' The self-test (PSAPPWORKER_SELFTEST=1).
#include once "selftest.tiko"

app.Init( )
dim as PsForm ptr frmMain = frmMain_Build( )
if WorkerSelfTest_Enabled( ) then end WorkerSelfTest_Run( frmMain )
end app.Run( frmMain )
