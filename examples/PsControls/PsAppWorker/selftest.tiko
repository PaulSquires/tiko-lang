' ========================================================================================
' PsApp P2 self-test, gated on PSAPPWORKER_SELFTEST=1 (RFC-0001 section 11):
'   - 4 goroutines x 1000 RunOnUI calls: every call arrives exactly once, in order per
'     goroutine, and runs on the UI thread;
'   - a window-less timer fires, and stops after KillTimer;
'   - RunOnUI after Run has returned is refused.
' ========================================================================================

const FLOOD_WORKERS = 4
const FLOOD_CALLS   = 1000

dim shared gWT_Pass as long
dim shared gWT_Fail as long
dim shared gWT_Last( 0 to FLOOD_WORKERS - 1 ) as long
dim shared gWT_Arrived as long
dim shared gWT_OutOfOrder as long
dim shared gWT_OffThread as long
dim shared gWT_TimerA as long
dim shared gWT_TimerAId as long
dim shared gWT_TimerAAfterKill as long
dim shared gWT_Ticks as long
dim shared gWT_DemoPos as long = -1
dim shared gWT_DemoEnabled as boolean

private sub WT_Check( byval bOK as boolean, byval what as string, byval detail as string = "" )
    dim as string s
    if bOK then
        gWT_Pass += 1
        s = "PASS  " & what
    else
        gWT_Fail += 1
        s = "FAIL  " & what
    end if
    if len( detail ) then s &= "   [" & detail & "]"
    print s
end sub

function WorkerSelfTest_Enabled( ) as boolean
    return environ( "PSAPPWORKER_SELFTEST" ) = "1"
end function

' payload = worker * 65536 + sequence (1-based); nothing allocated, nothing to free.
private sub WT_OnUI( byval payload as any ptr )
    dim as long v = cast( long, cast( integer, payload ) )
    dim as long w = v \ 65536
    dim as long n = v mod 65536
    if app.IsUIThread() = false then gWT_OffThread += 1
    if (w >= 0) andalso (w < FLOOD_WORKERS) then
        if n <> gWT_Last(w) + 1 then gWT_OutOfOrder += 1
        gWT_Last(w) = n
    end if
    gWT_Arrived += 1
end sub

sub WT_Flood( byval w as long )
    for i as long = 1 to FLOOD_CALLS
        app.RunOnUI( @WT_OnUI, cast( any ptr, cast( integer, w * 65536 + i ) ) )
    next
end sub

private sub WT_TimerA( byval id as long, byval payload as any ptr )
    if gWT_TimerAId = 0 then
        gWT_TimerAAfterKill += 1          ' fired after KillTimer
        exit sub
    end if
    gWT_TimerA += 1
    if gWT_TimerA = 3 then
        app.KillTimer( id )
        gWT_TimerAId = 0
    end if
end sub

' The watchdog: ends the run once everything has arrived (or after ~10 s).
private sub WT_Watch( byval id as long, byval payload as any ptr )
    gWT_Ticks += 1
    dim as boolean bDone = (gWT_Arrived >= FLOOD_WORKERS * FLOOD_CALLS) andalso (gWT_TimerAId = 0) _
                           andalso (gStatus = "Done.")
    if bDone orelse (gWT_Ticks > 200) then
        app.KillTimer( id )
        dim as PsForm ptr f = cast( PsForm ptr, payload )
        gWT_DemoPos = PsProgressBar_GetPos( f->Item( IDC_PROGRESS ) )
        gWT_DemoEnabled = (IsWindowEnabled( f->Item( IDC_START ) ) <> 0)
        cast( PsForm ptr, payload )->Close()
    end if
end sub

function WorkerSelfTest_Run( byval f as PsForm ptr ) as long
    print "=== PsApp worker self-test ==="
    for w as long = 0 to FLOOD_WORKERS - 1
        spawn WT_Flood( w )
    next
    ' The demo's own path: Start spawns the worker, which reports every step through RunOnUI.
    PsButton_Click( f->Item( IDC_START ) )
    gWT_TimerAId = app.SetTimer( 30, @WT_TimerA )
    WT_Check( gWT_TimerAId <> 0, "SetTimer returns an id" )
    app.SetTimer( 50, @WT_Watch, f )

    dim as long rc = app.Run( f )

    WT_Check( gWT_Arrived = FLOOD_WORKERS * FLOOD_CALLS, "every RunOnUI call arrived exactly once", _
              str( gWT_Arrived ) & " of " & str( FLOOD_WORKERS * FLOOD_CALLS ) )
    WT_Check( gWT_OutOfOrder = 0, "calls arrive in order per thread", "out of order=" & str( gWT_OutOfOrder ) )
    WT_Check( gWT_OffThread = 0, "every call ran on the UI thread", "off thread=" & str( gWT_OffThread ) )
    WT_Check( gWT_TimerA = 3, "the timer fired until it was killed", "fired=" & str( gWT_TimerA ) )
    WT_Check( gWT_TimerAAfterKill = 0, "the timer never fired after KillTimer", _
              "after kill=" & str( gWT_TimerAAfterKill ) )
    WT_Check( gWT_Ticks <= 200, "finished before the watchdog gave up", "ticks=" & str( gWT_Ticks ) )
    WT_Check( gWT_DemoPos = STEPS, "the demo's worker drove the progress bar to the end", _
              "pos=" & str( gWT_DemoPos ) )
    WT_Check( gWT_DemoEnabled, "...and its Done step re-enabled Start" )
    WT_Check( app.RunOnUI( @WT_OnUI, 0 ) = false, "RunOnUI after Run is refused" )

    print "=== PsApp worker: " & str( gWT_Pass ) & "/" & str( gWT_Pass + gWT_Fail ) & " assertions passed"
    return gWT_Fail
end function
