' tkInfoBar self-test. Real windows, real SDL events; scale pinned at 1.0 and 1.75. Geometry is
' asserted against tkNotify's design constants scaled, not eyeballed. Also: tkLayout's two rules
' (a hidden dock takes no slice; a dock may take its height from tkLayout_SetHeightFunc), and
' that PaintText honours its colour's alpha (the toast fade depends on it).
#import "vendor/tkControls/tkInfoBar"
#import "vendor/tkControls/tkButton"
#import "vendor/tkControls/tkLabel"
#import "vendor/tkControls/tkLayout"
#import "vendor/tkControls/tkTest"
using tkInfoBar
using tkNotify
using tkButton
using tkLabel
using tkLayout
using tkTheme
using tkTest
using tkHost
using tkPaint

dim shared as long gActions, gLastAction, gClosing, gClosed, gLastReason, gHeights, gLastHeight
dim shared as boolean gVeto
dim shared as TK_LAYOUT ptr gLayout

sub OnAction( byval h as TK_WIDGET ptr, byval id as long )
    gActions += 1
    gLastAction = id
end sub

function OnClosing( byval h as TK_WIDGET ptr, byval reason as long ) as boolean
    gClosing += 1
    gLastReason = reason
    return gVeto = false
end function

sub OnClosed( byval h as TK_WIDGET ptr, byval reason as long )
    gClosed += 1
    gLastReason = reason
end sub

sub OnHeight( byval h as TK_WIDGET ptr, byval cyDesign as long )
    gHeights += 1
    gLastHeight = cyDesign
    if gLayout then tkLayout_Apply( gLayout )
end sub

function Px( byval h as TK_HOST ptr, byval v as long ) as long
    return cint( v * h->fScale )
end function

function RectStr( byref rc as TKRECT ) as string
    return tkRect_Str( rc )
end function

function Near( byval a as long, byval b as long, byval tol as long = 1 ) as boolean
    return abs( a - b ) <= tol
end function

' For the text-alpha probe: the surface's own paint hook draws one string at a chosen alpha.
dim shared as long gProbeAlpha = -1
sub ProbePaint( byval h as TK_HOST ptr, byval p as TK_PAINT ptr )
    if gProbeAlpha < 0 then exit sub
    dim as TKRECT rc
    tkRect_Set( rc, 0, 0, Px( h, 200 ), Px( h, 40 ) )
    p->SetBackColor( &hFF000000ul )
    p->PaintRect( @rc )
    p->SetFont( h->pDefaultFont )
    p->SetForeColor( tkColor_WithAlpha( &hFFFFFFFFul, gProbeAlpha ) )
    p->PaintText( "WWWW alpha probe", @rc, TK_DT_LEFT or TK_DT_VCENTER )
end sub

sub RunPass( byval fScale as single )
    tkTest_Begin( "scale " & fScale )
    dim as TK_HOST ptr h = tkHost_Create( "tkInfoBar selftest", 640, 480, tkHost_FontDir() & TK_FONT_UI, fScale )
    h->clrBack = &hFF102030ul
    dim as TK_WIDGET ptr root_ = tkHost_Root( h )
    dim as TK_WIDGET ptr B = tkInfoBar_Create( root_, 7 )
    dim as TK_WIDGET ptr btn = tkButton_Create( root_, 8 )
    tkButton_SetText( btn, "Next" )
    tkWidget_SetPos( btn, Px( h, 20 ), Px( h, 400 ), Px( h, 100 ), Px( h, 30 ) )
    tkHost_Show( h )
    tkTest_PumpFor( h, 50 )
    gActions = 0 : gClosing = 0 : gClosed = 0 : gHeights = 0 : gVeto = false : gLayout = 0

    ' ---- starts closed ----
    tkTest_Check( "starts closed", tkInfoBar_IsOpen( B ) = false )
    tkTest_Check( "closed = hidden", B->isVisible = false )
    tkTest_Check( "closed wants no height", tkInfoBar_GetPreferredHeight( B, 500 ) = 0 )
    tkTest_Check( "severity Info by default", tkInfoBar_GetSeverity( B ) = TKN_INFO )
    tkTest_Check( "closable by default", tkInfoBar_GetClosable( B ) )

    tkInfoBar_SetActionCallback( B, @OnAction )
    tkInfoBar_SetClosingCallback( B, @OnClosing )
    tkInfoBar_SetClosedCallback( B, @OnClosed )
    tkInfoBar_SetHeightChangedCallback( B, @OnHeight )

    tkInfoBar_SetTitle( B, "Update available" )
    tkInfoBar_SetMessage( B, "Version 0.1.7 is ready." )
    tkTest_Check( "title reads back", tkInfoBar_GetTitle( B ) = "Update available" )
    tkTest_Check( "message reads back", tkInfoBar_GetMessage( B ) = "Version 0.1.7 is ready." )
    dim as long id1 = tkInfoBar_AddAction( B, "Install" )
    dim as long id2 = tkInfoBar_AddAction( B, "Later" )
    tkTest_Check( "action ids are 1, 2", (id1 = 1) andalso (id2 = 2), id1 & "," & id2 )
    tkTest_Check( "action count", tkInfoBar_GetActionCount( B ) = 2 )
    tkTest_Check( "action text", tkInfoBar_GetActionText( B, 2 ) = "Later" )
    tkTest_Check( "no height signal while closed", gHeights = 0, str( gHeights ) )

    ' ---- open: a layout signal, never a focus move ----
    tkInfoBar_SetOpen( B, true )
    tkTest_Check( "open = visible", B->isVisible andalso tkInfoBar_IsOpen( B ) )
    tkTest_Check( "opening moves no focus", tkHost_GetFocus( h ) = 0 )
    tkTest_Check( "open fires no Closing / Closed", (gClosing = 0) andalso (gClosed = 0) )

    ' ---- LINE geometry at a wide width ----
    dim as long W = Px( h, 620 )
    dim as long prefW = tkInfoBar_GetPreferredHeight( B, W )
    tkWidget_SetPos( B, Px( h, 10 ), Px( h, 10 ), W, prefW )
    tkTest_Check( "wide: one line", tkInfoBar_GetCurrentLayout( B ) = TKN_LAYOUT_LINE )
    dim as TTF_Font ptr fText = h->pDefaultFont
    dim as long textH = tkText_Height( fText )
    dim as long btnH = textH + 2 * Px( h, TKNOTIFY_BTNPADY )
    dim as long rowH = Px( h, TKNOTIFY_CLOSECELL )
    if btnH > rowH then rowH = btnH
    ' the bold title is the same point size; its height can differ by a pixel, so compare >= the row
    tkTest_Check( "LINE height = tallest of close cell / button / text + padding", _
                  (prefW >= rowH + 2 * Px( h, TKNOTIFY_PADY )) andalso (prefW <= rowH + 2 * Px( h, TKNOTIFY_PADY ) + 2), _
                  prefW & " vs " & (rowH + 2 * Px( h, TKNOTIFY_PADY )) )
    tkTest_Check( "height signal on open, in design units", (gHeights >= 1) andalso Near( gLastHeight, cint( prefW / h->fScale ) ), _
                  gHeights & " / " & gLastHeight )
    dim as TKRECT rcClose, rcA1, rcA2, rcBody
    tkInfoBar_GetPartRect( B, TKN_PART_CLOSE, rcClose )
    tkInfoBar_GetPartRect( B, TKN_PART_ACTION1, rcA1 )
    tkInfoBar_GetPartRect( B, TKN_PART_ACTION1 + 1, rcA2 )
    tkInfoBar_GetPartRect( B, TKN_PART_BODY, rcBody )
    tkTest_Check( "close sits at the right padding", rcClose.right = W - Px( h, TKNOTIFY_PADX ), RectStr( rcClose ) )
    tkTest_Check( "close is the scaled cell", (tkRect_Width( rcClose ) = Px( h, TKNOTIFY_CLOSECELL )) andalso (tkRect_Height( rcClose ) = Px( h, TKNOTIFY_CLOSECELL )), RectStr( rcClose ) )
    tkTest_Check( "actions left of close, in order, a gap apart", _
                  (rcA2.right = rcClose.left - Px( h, TKNOTIFY_BTNGAP )) andalso (rcA1.right = rcA2.left - Px( h, TKNOTIFY_BTNGAP )), _
                  RectStr( rcA1 ) & " " & RectStr( rcA2 ) & " " & RectStr( rcClose ) )
    tkTest_Check( "button width = text + padding", tkRect_Width( rcA1 ) = tkText_Width( fText, "Install" ) + 2 * Px( h, TKNOTIFY_BTNPADX ), RectStr( rcA1 ) )
    tkTest_Check( "button height", tkRect_Height( rcA1 ) = btnH, RectStr( rcA1 ) )
    tkTest_Check( "LINE: parts centred on one row", _
                  Near( (rcA1.top + rcA1.bottom) \ 2, prefW \ 2 ) andalso Near( (rcClose.top + rcClose.bottom) \ 2, prefW \ 2 ), _
                  RectStr( rcA1 ) & " " & RectStr( rcClose ) & " cy " & prefW )
    tkTest_Check( "body is the whole bar", (rcBody.right = W) andalso (rcBody.bottom = prefW), RectStr( rcBody ) )

    ' ---- STACKED below the break width ----
    dim as long Wn = Px( h, 260 )
    dim as long prefN = tkInfoBar_GetPreferredHeight( B, Wn )
    tkWidget_SetPos( B, Px( h, 10 ), Px( h, 10 ), Wn, prefN )
    tkTest_Check( "narrow: stacked", tkInfoBar_GetCurrentLayout( B ) = TKN_LAYOUT_STACKED )
    tkTest_Check( "stacked is taller", prefN > prefW, prefN & " vs " & prefW )
    tkInfoBar_GetPartRect( B, TKN_PART_CLOSE, rcClose )
    tkInfoBar_GetPartRect( B, TKN_PART_ACTION1, rcA1 )
    tkInfoBar_GetPartRect( B, TKN_PART_ACTION1 + 1, rcA2 )
    dim as long textX = Px( h, TKNOTIFY_PADX ) + Px( h, TKNOTIFY_GLYPHCELL ) + Px( h, TKNOTIFY_GLYPHGAP )
    tkTest_Check( "stacked: actions start at the text column", rcA1.left = textX, RectStr( rcA1 ) & " col " & textX )
    tkTest_Check( "stacked: actions share a row", rcA1.top = rcA2.top, RectStr( rcA1 ) & " " & RectStr( rcA2 ) )
    tkTest_Check( "stacked: actions are the last row", rcA1.bottom = prefN - Px( h, TKNOTIFY_PADY ), RectStr( rcA1 ) & " cy " & prefN )
    tkTest_Check( "stacked: close on the first row, top right", (rcClose.right = Wn - Px( h, TKNOTIFY_PADX )) andalso (rcClose.top < rcA1.top), RectStr( rcClose ) )
    tkInfoBar_SetLayoutMode( B, TKN_LAYOUT_LINE )
    tkTest_Check( "forced LINE stays one line when narrow", tkInfoBar_GetCurrentLayout( B ) = TKN_LAYOUT_LINE )
    tkInfoBar_SetLayoutMode( B, TKN_LAYOUT_AUTO )
    tkWidget_SetPos( B, Px( h, 10 ), Px( h, 10 ), W, prefW )

    ' ---- paint: the severity's fill, the glyph ----
    dim as TKNOTIFY_COLORS c
    tkInfoBar_GetColors( B, @c )
    dim as long sx = B->x + Px( h, 4 ), sy = B->y + prefW \ 2
    tkHost_RenderTo( h, false )
    tkTest_Check( "Info fill", (tkTest_PixelAt( h, sx, sy ) and &hFFFFFFul) = (c.InfoBack and &hFFFFFFul), hex( tkTest_PixelAt( h, sx, sy ) ) & " vs " & hex( c.InfoBack ) )
    dim as TKRECT rcG
    tkInfoBar_GetPartRect( B, TKN_PART_BODY, rcG )
    dim as ulong c0
    dim as long gx = B->x + Px( h, TKNOTIFY_PADX ), gy = B->y + prefW \ 2 - Px( h, TKNOTIFY_GLYPHCELL ) \ 2
    tkTest_Check( "glyph draws", tkTest_TonesIn( h, gx, gy, Px( h, TKNOTIFY_GLYPHCELL ), Px( h, TKNOTIFY_GLYPHCELL ), c0 ) > 2 )
    tkInfoBar_SetSeverity( B, TKN_ERROR )
    tkHost_RenderTo( h, false )
    tkTest_Check( "Error fill", (tkTest_PixelAt( h, sx, sy ) and &hFFFFFFul) = (c.ErrorBack and &hFFFFFFul), hex( tkTest_PixelAt( h, sx, sy ) ) & " vs " & hex( c.ErrorBack ) )
    tkInfoBar_SetSeverity( B, TKN_SUCCESS )
    tkHost_RenderTo( h, false )
    tkTest_Check( "Success fill", (tkTest_PixelAt( h, sx, sy ) and &hFFFFFFul) = (c.SuccessBack and &hFFFFFFul) )
    tkTest_Check( "success glyph draws", tkTest_TonesIn( h, gx, gy, Px( h, TKNOTIFY_GLYPHCELL ), Px( h, TKNOTIFY_GLYPHCELL ), c0 ) > 2 )
    tkInfoBar_SetSeverity( B, 99 )
    tkTest_Check( "a bad severity is refused", tkInfoBar_GetSeverity( B ) = TKN_SUCCESS )
    tkInfoBar_SetSeverity( B, TKN_INFO )

    ' ---- mouse ----
    tkInfoBar_GetPartRect( B, TKN_PART_ACTION1, rcA1 )
    tkInfoBar_GetPartRect( B, TKN_PART_ACTION1 + 1, rcA2 )
    tkInfoBar_GetPartRect( B, TKN_PART_CLOSE, rcClose )
    dim as long a2x = B->x + (rcA2.left + rcA2.right) \ 2, a2y = B->y + (rcA2.top + rcA2.bottom) \ 2
    dim as long a1x = B->x + (rcA1.left + rcA1.right) \ 2, a1y = B->y + (rcA1.top + rcA1.bottom) \ 2
    tkTest_Click( h, a2x, a2y )
    tkTest_PumpFor( h, 20 )
    tkTest_Check( "click an action: its id", (gActions = 1) andalso (gLastAction = 2), gActions & " id " & gLastAction )
    tkTest_Check( "an action does not close", tkInfoBar_IsOpen( B ) )
    tkTest_Check( "a click takes no focus", tkHost_GetFocus( h ) = 0 )
    tkTest_Click( h, B->x + Px( h, 4 ), B->y + Px( h, 4 ) )
    tkTest_PumpFor( h, 20 )
    tkTest_Check( "body click: nothing", gActions = 1 )
    tkTest_PushButton( h, true, a1x, a1y )
    tkTest_PushMotion( h, Px( h, 600 ), Px( h, 300 ) )
    tkTest_PushButton( h, false, Px( h, 600 ), Px( h, 300 ) )
    tkTest_PumpFor( h, 20 )
    tkTest_Check( "a press released outside is not an action", gActions = 1, str( gActions ) )
    tkTest_Check( "capture released", tkHost_GetCapture( h ) = 0 )
    tkInfoBar_SetActionEnabled( B, 1, false )
    tkTest_Click( h, a1x, a1y )
    tkTest_PumpFor( h, 20 )
    tkTest_Check( "a disabled action does nothing", gActions = 1 )
    tkTest_Check( "enabled reads back", tkInfoBar_GetActionEnabled( B, 1 ) = false )
    tkInfoBar_SetActionEnabled( B, 1, true )

    ' close: vetoed, then allowed
    dim as long cxm = B->x + (rcClose.left + rcClose.right) \ 2, cym = B->y + (rcClose.top + rcClose.bottom) \ 2
    gVeto = true
    tkTest_Click( h, cxm, cym )
    tkTest_PumpFor( h, 20 )
    tkTest_Check( "Closing asked with BUTTON", (gClosing = 1) andalso (gLastReason = TKN_CLOSE_BUTTON), gClosing & " r " & gLastReason )
    tkTest_Check( "a veto keeps it open", tkInfoBar_IsOpen( B ) andalso (gClosed = 0) )
    gVeto = false
    dim as long hBefore = gHeights
    tkTest_Click( h, cxm, cym )
    tkTest_PumpFor( h, 20 )
    tkTest_Check( "close button closes", (tkInfoBar_IsOpen( B ) = false) andalso (B->isVisible = false) )
    tkTest_Check( "Closed with BUTTON", (gClosed = 1) andalso (gLastReason = TKN_CLOSE_BUTTON), gClosed & " r " & gLastReason )
    tkTest_Check( "close signals height 0", (gHeights = hBefore + 1) andalso (gLastHeight = 0), gHeights & " / " & gLastHeight )

    ' ---- keyboard ----
    gClosing = 0 : gClosed = 0
    tkInfoBar_SetOpen( B, true )
    tkTest_Check( "programmatic open: no callbacks", (gClosing = 0) andalso (gClosed = 0) )
    tkTest_Check( "a tab stop while it has parts", B->isFocusable )
    tkHost_FocusNext( h )
    tkTest_Check( "Tab reaches the bar first", tkHost_GetFocus( h ) = B )
    tkTest_Check( "...on its first action", tkInfoBar_GetFocusPart( B ) = TKN_PART_ACTION1, str( tkInfoBar_GetFocusPart( B ) ) )
    tkTest_PushKey( h, SDLK_TAB )
    tkTest_Check( "Tab: the second action", tkInfoBar_GetFocusPart( B ) = TKN_PART_ACTION1 + 1, str( tkInfoBar_GetFocusPart( B ) ) )
    tkTest_PushKey( h, SDLK_RETURN )
    tkTest_Check( "Enter presses it", (gActions = 2) andalso (gLastAction = 2), gActions & " id " & gLastAction )
    tkTest_PushKey( h, SDLK_SPACE )
    tkTest_Check( "Space presses it", gActions = 3, str( gActions ) )
    dim as TK_MSG mc
    mc.msg = TKM_CHAR : mc.text = " "
    tkTest_Check( "the space's character is swallowed", tkWidget_Send( B, @mc ) )
    mc.text = "x"
    tkTest_Check( "other characters are not claimed", tkWidget_Send( B, @mc ) = false )
    tkTest_PushKey( h, SDLK_TAB )
    tkTest_Check( "Tab: the close button", tkInfoBar_GetFocusPart( B ) = TKN_PART_CLOSE, str( tkInfoBar_GetFocusPart( B ) ) )
    tkTest_PushKey( h, SDLK_TAB )
    tkTest_Check( "Tab past the last part leaves the bar", tkHost_GetFocus( h ) = btn )
    tkTest_PushKey( h, SDLK_TAB, SDL_KMOD_SHIFT )
    tkTest_Check( "Shift+Tab comes back", tkHost_GetFocus( h ) = B )
    tkInfoBar_SetActionEnabled( B, 1, false )
    tkTest_PushKey( h, SDLK_TAB )     ' whichever part it landed on, Tab never visits a disabled action
    tkTest_Check( "a disabled action is skipped", tkInfoBar_GetFocusPart( B ) <> TKN_PART_ACTION1, str( tkInfoBar_GetFocusPart( B ) ) )
    tkInfoBar_SetActionEnabled( B, 1, true )
    tkHost_SetFocus( h, B )
    tkTest_PushKey( h, SDLK_ESCAPE )
    tkTest_Check( "Esc closes with KEY", (gClosed = 1) andalso (gLastReason = TKN_CLOSE_KEY) andalso (tkInfoBar_IsOpen( B ) = false), gClosed & " r " & gLastReason )
    tkTest_Check( "...and focus moves on, not lost", tkHost_GetFocus( h ) = btn )
    tkInfoBar_SetOpen( B, true )
    tkInfoBar_SetClosable( B, false )
    tkHost_SetFocus( h, B )
    tkTest_PushKey( h, SDLK_ESCAPE )
    tkTest_Check( "not closable: Esc does nothing", tkInfoBar_IsOpen( B ) )
    tkInfoBar_SetClosable( B, true )
    tkInfoBar_SetTabStop( B, false )
    tkTest_Check( "SetTabStop( false ) takes it out of Tab order", B->isFocusable = false )
    tkInfoBar_SetTabStop( B, true )

    ' ---- programmatic close is silent; SetText opens and closes ----
    gClosing = 0 : gClosed = 0
    hBefore = gHeights
    tkInfoBar_SetOpen( B, false )
    tkTest_Check( "programmatic close: no Closing / Closed", (gClosing = 0) andalso (gClosed = 0) )
    tkTest_Check( "...but the layout is told", (gHeights = hBefore + 1) andalso (gLastHeight = 0), gHeights & " / " & gLastHeight )
    tkInfoBar_SetText( B, "Payment overdue" )
    tkTest_Check( "SetText with text opens", tkInfoBar_IsOpen( B ) andalso (tkInfoBar_GetMessage( B ) = "Payment overdue") )
    tkInfoBar_SetText( B, "" )
    tkTest_Check( "SetText empty closes", tkInfoBar_IsOpen( B ) = false )
    tkTest_Check( "...silently", (gClosing = 0) andalso (gClosed = 0) )

    ' ---- tkLayout: a hidden dock takes nothing; the dock height comes from the bar ----
    dim as TK_WIDGET ptr content = tkLabel_Create( root_, 9 )
    dim as TK_WIDGET ptr strip = tkLabel_Create( root_, 10 )
    gLayout = tkLayout_Create( )
    tkLayout_AddContainer( gLayout, root_, 640, 480 )
    tkLayout_Add( gLayout, B, 0, 0, 640, 40, , TK_DOCK_TOP )
    tkLayout_Add( gLayout, strip, 0, 0, 640, 24, , TK_DOCK_TOP )
    tkLayout_Add( gLayout, content, 0, 0, 640, 100, , TK_DOCK_FILL )
    tkLayout_SetHeightFunc( gLayout, B, @tkInfoBar_GetPreferredHeight )
    tkLayout_Apply( gLayout )
    tkTest_Check( "closed bar: the next dock starts at the top", strip->y = 0, str( strip->y ) )
    tkTest_Check( "a dock without a height function keeps its design height", strip->ch = Px( h, 24 ), str( strip->ch ) )
    tkTest_Check( "fill below it", content->y = Px( h, 24 ), str( content->y ) )
    tkInfoBar_SetText( B, "Payment overdue" )          ' opens: HeightChanged -> Apply
    dim as long want = tkInfoBar_GetPreferredHeight( B, root_->cw )
    tkTest_Check( "open bar: docked at its preferred height", (B->y = 0) andalso (B->ch = want) andalso (B->cw = root_->cw), B->y & " " & B->ch & " vs " & want )
    tkTest_Check( "...and the next dock moved down by exactly that", strip->y = want, strip->y & " vs " & want )
    tkInfoBar_SetMessage( B, string( 40, "w" ) & " " & string( 40, "w" ) & " " & string( 40, "w" ) & " " & string( 40, "w" ) )
    dim as long want2 = tkInfoBar_GetPreferredHeight( B, root_->cw )
    tkTest_Check( "a message that wraps is taller", want2 > want, want2 & " vs " & want )
    tkTest_Check( "...and the layout followed", (B->ch = want2) andalso (strip->y = want2), B->ch & " " & strip->y & " vs " & want2 )
    tkInfoBar_SetOpen( B, false )
    tkTest_Check( "closed again: the strip is given back", (strip->y = 0) andalso (content->y = Px( h, 24 )), strip->y & " " & content->y )
    tkLayout_Destroy( gLayout )
    gLayout = 0

    ' ---- colours ----
    dim as TKNOTIFY_COLORS cp = c
    cp.InfoBack = &hFF123456ul
    tkInfoBar_SetColors( B, @cp )
    dim as TKNOTIFY_COLORS cr
    tkInfoBar_GetColors( B, @cr )
    tkTest_Check( "colours read back", cr.InfoBack = &hFF123456ul )
    tkInfoBar_ApplyTheme( B, tkTheme_Get( ) )
    tkInfoBar_GetColors( B, @cr )
    tkTest_Check( "pinned colours survive a theme", cr.InfoBack = &hFF123456ul )
    tkInfoBar_UnpinColors( B )
    tkInfoBar_GetColors( B, @cr )
    tkTest_Check( "unpin returns to the theme", cr.InfoBack = tkNotify_ThemeColors( tkTheme_Get( ) ).InfoBack, hex( cr.InfoBack ) )

    ' ---- PaintText honours its colour's alpha (a toast's fade depends on it) ----
    gProbeAlpha = 255
    h->OnPaint = @ProbePaint
    tkHost_RenderTo( h, false )
    tkTest_Check( "text at alpha 255 draws", tkTest_TonesIn( h, 0, 0, Px( h, 200 ), Px( h, 40 ), c0 ) > 2 )
    gProbeAlpha = 0
    tkHost_RenderTo( h, false )
    tkTest_Check( "text at alpha 0 draws nothing (PaintText honours alpha)", tkTest_TonesIn( h, 0, 0, Px( h, 200 ), Px( h, 40 ), c0 ) = 1, hex( c0 ) )
    gProbeAlpha = -1
    h->OnPaint = 0

    tkHost_Destroy( h )
end sub

if tkTest_Init() = false then end 99
RunPass( 1.0 )
RunPass( 1.75 )
dim as long nFail = tkTest_Report( "tkInfoBar" )
tkTest_Quit()
end nFail
