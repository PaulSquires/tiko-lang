format = 1

[form]
caption = "Appointment"
width = 360
height = 200
data_type = "apptdata.Appt"
data_module = "../apptdata"

[[control]]
name = "tpStart"
type = "TimePicker"
parent = ""
x = 16
y = 16
w = 130
h = 28
bind = "Start"

[control.props]
Format = "h:mm tt"
Step = 900

[control.events]
TimeChanged = "OnStartChanged"

[[control]]
name = "tpAt"
type = "TimePicker"
parent = ""
x = 160
y = 60
w = 110
h = 28
bind = "Stamp"

[[control]]
name = "dpDay"
type = "DatePicker"
parent = ""
x = 16
y = 60
w = 130
h = 28
bind = "Stamp"
