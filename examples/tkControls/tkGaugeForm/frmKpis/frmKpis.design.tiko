    return false
end function

function Form.navKpis_MoveTo( byval i as int32 ) as boolean
    dim byref as Array( of kpidata.Kpi ) a_ = Kpis
    if (i < 0) orelse (i >= a_.Count( )) then return false
    dim as int32 cur = tkNavigator_GetPosition( navKpis.Handle )
    if (cur >= 0) andalso (cur < a_.Count( )) then
        if cur = i then return true
        if IsDirty( a_[cur] ) then
            if SaveTo( a_[cur] ) = false then return false
        end if
    end if
    tkNavigator_SetCount( navKpis.Handle, a_.Count( ) )
    tkNavigator_SetPosition( navKpis.Handle, i )
    LoadFrom( a_[i] )
    return true
end function

sub Form.navKpis_Refresh( )
    dim byref as Array( of kpidata.Kpi ) a_ = Kpis
    tkNavigator_SetCount( navKpis.Handle, a_.Count( ) )
    if a_.Count( ) = 0 then
        tkNavigator_SetPosition( navKpis.Handle, -1 )
        dim as kpidata.Kpi blank_
        LoadFrom( blank_ )
        exit sub
    end if
    dim as int32 cur = tkNavigator_GetPosition( navKpis.Handle )
    if cur < 0 then cur = 0
    tkNavigator_SetPosition( navKpis.Handle, cur )
    LoadFrom( a_[cur] )
end sub

function Form.navKpis_Current( ) as int32
    return tkNavigator_GetPosition( navKpis.Handle )
end function

function Form.navKpis_Go_( byval action as int32, byval target as int32 ) as boolean
    dim byref as Array( of kpidata.Kpi ) a_ = Kpis
    dim as int32 cur = tkNavigator_GetPosition( navKpis.Handle )
    select case action
    case TKNAV_NEW
        if (cur >= 0) andalso (cur < a_.Count( )) then
            if IsDirty( a_[cur] ) then
                if SaveTo( a_[cur] ) = false then return false
            end if
        end if
        dim as kpidata.Kpi blank_
        a_.Push( blank_ )
        tkNavigator_SetCount( navKpis.Handle, a_.Count( ) )
        tkNavigator_SetPosition( navKpis.Handle, a_.Count( ) - 1 )
        navKpis_Refresh( )
        return true
    case TKNAV_DELETE
        if (cur < 0) orelse (cur >= a_.Count( )) then return false
        a_.Remove( cur )
        tkNavigator_SetCount( navKpis.Handle, a_.Count( ) )
        navKpis_Refresh( )
        return true
    end select
    return navKpis_MoveTo( target )
end function
