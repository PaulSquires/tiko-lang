' tkGaugeForm self-test (GAUGE-SPARKLINE.md GS4). frmKpis was written as a .tkform and generated by
' tkEdit --generate-forms; this steps its navigator the way a user does (pushed clicks on its buttons)
' and checks what each record's gauges and sparkline show: B1's load-only Bind through LoadFrom (a
' float, an int32 through tkBind's float conversion, a text series), B4's navigator, and SaveTo
' leaving the display controls' fields alone.
#import "vendor/tkControls/tkTest"
#import "vendor/tkControls/tkApp"
#import "vendor/tkControls/tkForms"
#import "vendor/tkControls/tkBind"
#import "vendor/tkControls/tkTextBox"
#import "vendor/tkControls/tkNavigator"
#import "vendor/tkControls/tkGauge"
#import "vendor/tkControls/tkSparkline"
#import "std/containers"
#import "./frmKpis"
#import "./kpidata"
using tkApp
using tkForms
using tkBind
using tkTextBox
using tkNavigator
using tkGauge
using tkSparkline
using tkHost
using tkPaint
using tkTest
using containers

function NewKpi( byref name_ as const ustring, byval score as float64, byval fill as int32, byref trend as const ustring ) as kpidata.Kpi
    dim as kpidata.Kpi k
    k.Name = name_ : k.Score = score : k.Fill = fill : k.Trend = trend
    return k
end function

sub ClickPart( byval h as TK_HOST ptr, byval nav as TK_WIDGET ptr, byval part as long )
    dim as TKRECT rc, a
    tkNavigator_GetPartRect( nav, part, rc )
    tkWidget_AbsRect( nav, a )
    dim as single x = a.left + (rc.left + rc.right) / 2, y = a.top + (rc.top + rc.bottom) / 2
    tkTest_PushMotion( h, x, y )
    tkTest_Click( h, x, y )
    tkTest_PumpFor( h, 20 )
end sub

sub Kpis( byval owner as TK_FORM ptr )
    tkTest_Begin( "a designed form with gauges and a sparkline" )
    dim as frmKpis.Form f
    f.Build( owner )
    dim as TK_HOST ptr h = tkForm_Host( f.Handle )
    f.Show( )
    tkTest_PumpFor( h, 60 )
    dim as TK_WIDGET ptr nav = f.navKpis.Handle, gs = f.ggScore.Handle, gf = f.ggFill.Handle, sp = f.spTrend.Handle

    tkTest_Check( "the generated form made its controls with their shapes and rows", _
                  (tkGauge_GetShape( gs ) = TKGAUGE_RADIAL) andalso (tkGauge_GetShape( gf ) = TKGAUGE_LINEAR) _
                  andalso (tkGauge_GetMax( gs ) = 10) andalso (tkGauge_GetRangeCount( gs ) = 3) andalso (tkGauge_GetSuffix( gf ) = " %") _
                  andalso (tkSparkline_GetKind( sp ) = TKSPARK_COLUMN) andalso (tkSparkline_GetMarkers( sp ) = (TKSPARK_MK_HIGH or TKSPARK_MK_LAST)) )

    f.Kpis.Push( NewKpi( "North", 7.5, 64, "3,5,4,6,8" ) )
    f.Kpis.Push( NewKpi( "South", 4.25, 31, "6,,5,2" ) )
    f.Kpis.Push( NewKpi( "East", 9, 88, "" ) )
    f.navKpis_Refresh( )
    tkTest_Check( "Refresh: the first record's score, fill (an int32) and trend", (tkGauge_GetValue( gs ) = 7.5) _
                  andalso (tkGauge_GetValue( gf ) = 64) andalso (tkSparkline_GetDataText( sp ) = "3,5,4,6,8") andalso (tkSparkline_GetCount( sp ) = 5), _
                  tkGauge_GetValue( gs ) & " " & tkGauge_GetValue( gf ) & " " & tkSparkline_GetDataText( sp ) )

    ClickPart( h, nav, TKNAV_NEXT )
    tkTest_Check( "Next: the second record, a missing point kept", (f.navKpis_Current( ) = 1) andalso (tkGauge_GetValue( gs ) = 4.25) _
                  andalso (tkGauge_GetValue( gf ) = 31) andalso (tkSparkline_GetDataText( sp ) = "6,,5,2") andalso (tkSparkline_IsPresent( sp, 1 ) = false), _
                  tkSparkline_GetDataText( sp ) )

    ClickPart( h, nav, TKNAV_NEXT )
    tkTest_Check( "an empty series clears the sparkline", (f.navKpis_Current( ) = 2) andalso (tkSparkline_GetCount( sp ) = 0) _
                  andalso (tkGauge_GetValue( gs ) = 9), str( tkSparkline_GetCount( sp ) ) )

    ' the user edits the name: SaveTo writes it, and never the display controls' load-only fields
    tkTextBox_SetText( f.txtName.Handle, "Far East" )
    tkGauge_SetValue( gs, 1 ) : tkGauge_SetValue( gf, 2 ) : tkSparkline_SetDataText( sp, "1,1" )
    dim as kpidata.Kpi rec = f.Kpis[2]
    dim as boolean saved = f.SaveTo( rec )
    tkTest_Check( "SaveTo: the name saved, the score, fill and trend untouched (load only)", saved andalso (rec.Name = "Far East") _
                  andalso (rec.Score = 9) andalso (rec.Fill = 88) andalso (rec.Trend = ""), rec.Name & " " & rec.Score & " " & rec.Fill & " '" & rec.Trend & "'" )

    ClickPart( h, nav, TKNAV_FIRST )
    tkTest_Check( "First: back to the first record", (tkGauge_GetValue( gs ) = 7.5) andalso (tkSparkline_GetDataText( sp ) = "3,5,4,6,8") )
    f.Close( )
    tkTest_PumpFor( h, 40 )
end sub

if tkTest_Init() = false then end 99
dim as TKAPP_OPTIONS opts
if tkApp_Init( opts ) = false then
    print "tkApp_Init failed"
    end 98
end if
dim as TK_FORM ptr mainForm = tkApp_NewForm( "owner", 200, 120, 0, 1.0 )
tkForm_Show( mainForm )
tkTest_PumpFor( tkForm_Host( mainForm ), 50 )
Kpis( mainForm )
dim as long nFail = tkTest_Report( "tkGaugeForm" )
tkApp_Shutdown( )
end nFail
