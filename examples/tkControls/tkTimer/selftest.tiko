' tkTimer self-test. A real host and the real SDL timer thread: ticks are counted while the host is
' pumped. Timing is loose on purpose (a busy machine delivers late), so the checks are counts that
' only a running timer reaches, and zeros that only a stopped one keeps.
#import "vendor/tkControls/tkTimer"
#import "vendor/tkControls/tkTest"
using tkTimer
using tkTest
using tkHost

dim shared as long gTicks
dim shared as TK_WIDGET ptr gFrom

sub OnTick( byval hTimer as TK_WIDGET ptr )
    gTicks += 1
    gFrom = hTimer
end sub

sub RunPass( )
    tkTest_Begin( "timer" )
    dim as TK_HOST ptr h = tkHost_Create( "tkTimer selftest", 320, 200, tkHost_FontDir() & TK_FONT_UI, 1.0 )
    tkHost_Show( h )
    dim as TK_WIDGET ptr t = tkTimer_Create( tkHost_Root( h ), 7 )
    tkTimer_SetTickCallback( t, @OnTick )

    tkTest_Check( "created", t <> 0 )
    tkTest_Check( "hidden and never a tab stop", (t->isVisible = false) andalso (t->isFocusable = false) )
    tkWidget_Show( t, true )
    tkTest_Check( "...and stays hidden when shown", t->isVisible = false )
    tkTest_Check( "a component is not hit", tkHost_HitTest( h, 1, 1 ) <> t )

    ' Interval 0 (the default) is stopped
    gTicks = 0
    tkTest_PumpFor( h, 150 )
    tkTest_Check( "Interval 0: no ticks", (tkTimer_GetInterval( t ) = 0) andalso (gTicks = 0) andalso (tkTimer_IsRunning( t ) = false), str( gTicks ) )

    ' an interval starts it
    tkTimer_SetInterval( t, 20 )
    tkTest_Check( "an interval starts it", tkTimer_IsRunning( t ) andalso (tkTimer_GetInterval( t ) = 20) )
    tkTest_PumpFor( h, 300 )
    tkTest_Check( "it ticks", gTicks >= 3, str( gTicks ) )
    tkTest_Check( "the tick names its timer", gFrom = t )

    ' disabled: no ticks; enabled again: ticking again
    tkWidget_Enable( t, false )
    tkTest_Check( "disabled: stopped", tkTimer_IsRunning( t ) = false )
    tkTest_PumpFor( h, 30 )                 ' a tick already queued may still arrive
    gTicks = 0
    tkTest_PumpFor( h, 200 )
    tkTest_Check( "disabled: no ticks", gTicks = 0, str( gTicks ) )
    tkTimer_SetInterval( t, 25 )
    tkTest_Check( "an interval while disabled does not start it", tkTimer_IsRunning( t ) = false )
    tkWidget_Enable( t, true )
    tkTest_Check( "enabled: running again", tkTimer_IsRunning( t ) )
    tkTest_PumpFor( h, 300 )
    tkTest_Check( "enabled: ticking again", gTicks >= 3, str( gTicks ) )

    ' a negative interval is 0: stopped
    tkTimer_SetInterval( t, -5 )
    tkTest_Check( "a negative interval stops it", (tkTimer_GetInterval( t ) = 0) andalso (tkTimer_IsRunning( t ) = false) )
    tkTest_PumpFor( h, 30 )
    gTicks = 0
    tkTest_PumpFor( h, 150 )
    tkTest_Check( "...and no ticks follow", gTicks = 0, str( gTicks ) )

    ' destroyed while running: its timer goes with it
    tkTimer_SetInterval( t, 15 )
    tkWidget_Destroy( t )
    gTicks = 0
    tkTest_PumpFor( h, 150 )
    tkTest_Check( "destroyed: no ticks", gTicks = 0, str( gTicks ) )
    tkTest_Check( "...and the procedures refuse the handle's absence", (tkTimer_GetInterval( 0 ) = 0) andalso (tkTimer_IsRunning( 0 ) = false) )

    tkHost_Destroy( h )
end sub

if tkTest_Init() = false then end 99
RunPass( )
dim as long nFail = tkTest_Report( "tkTimer" )
tkTest_Quit()
end nFail
