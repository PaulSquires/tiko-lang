' tkGridForm self-test (tkDataGrid G5). frmGrid and frmLive were written as .tkforms and generated by
' tkEdit's code generator; this drives their generated grid code. frmGrid copies: LoadFrom fills a
' DataGrid from the record's array (a column per field, each in its kind), <name>_Item( ) names the
' current row's element, SaveTo writes every row back -- an edited cell, an added row -- with an open
' edit committed first. frmLive (G5b, ItemsLive) shows the arrays in place: edits, added and deleted
' rows land in them at once, SaveTo copies only into another record, _Fill binds a form member.
#import "vendor/tkControls/tkTest"
#import "vendor/tkControls/tkApp"
#import "vendor/tkControls/tkForms"
#import "vendor/tkControls/tkBind"
#import "vendor/tkControls/tkDataGrid"
#import "vendor/tkControls/tkTextBox"
#import "./frmGrid"
#import "./frmLive"
#import "./griddata"
#import "std/containers"
#import "std/chrono"
using tkApp
using tkForms
using tkBind
using tkDataGrid
using tkTextBox
using tkHost
using tkTest
using containers

function NewLine( byref item as const ustring, byval qty as long, byval price as double, byval paid as boolean, byval d as long ) as griddata.Line
    dim as griddata.Line l
    l.Item = item : l.Qty = qty : l.Price = price : l.Paid = paid
    l.Due = chrono.LocalDate( 2026, 11, d )
    return l
end function

sub Lines( byval owner as TK_FORM ptr )
    tkTest_Begin( "a designed form with a DataGrid" )
    dim as frmGrid.Form f
    f.Build( owner )
    dim as TK_HOST ptr h = tkForm_Host( f.Handle )
    f.Show( )
    tkTest_PumpFor( h, 60 )
    dim as TK_WIDGET ptr g = f.grdLines.Handle
    tkTest_Check( "the designed columns, in their kinds", (tkDataGrid_GetColumnCount( g ) = 6) andalso (tkDataGrid_GetColumnCaption( g, 3 ) = "Paid") _
        andalso tkDataGrid_GetAllowAddRows( g ) )

    dim as griddata.Order r
    r.Lines.Push( NewLine( "Tea", 2, 4.5, true, 3 ) ) : r.Lines.Push( NewLine( "Cups", 6, 1.25, false, 9 ) )
    tkTest_Check( "LoadFrom: true", f.LoadFrom( r ) )
    tkTest_Check( "a row per line, each field in its column's kind", (tkDataGrid_GetRowCount( g ) = 2) andalso (tkDataGrid_GetCellText( g, 1, 0 ) = "Cups") _
        andalso (tkDataGrid_GetCellFloat( g, 1, 1 ) = 6) andalso tkDataGrid_GetCellBool( g, 0, 3 ) andalso (tkDataGrid_GetCellText( g, 1, 4 ) = "2026-11-09") _
        andalso (tkDataGrid_GetCellFloat( g, 0, 5 ) = 9), tkDataGrid_GetCellText( g, 1, 4 ) & " " & tkDataGrid_GetCellFloat( g, 0, 5 ) )
    tkDataGrid_SetCurrentCell( g, 1, 0 )
    tkTest_Check( "_Item( ) is the current row's element", (f.grdLines_Item( ) = 1) andalso (r.Lines[f.grdLines_Item( )].Item = "Cups") )

    ' edits and an added row go back with SaveTo; the method column is not written
    tkDataGrid_SetCellFloat( g, 0, 1, 5 )
    dim as integer nr = tkDataGrid_AddRow( g )
    tkDataGrid_SetCellText( g, nr, 0, "Pot" )
    tkDataGrid_SetCellFloat( g, nr, 2, 30 )
    tkDataGrid_SetCellText( g, nr, 4, "2026-12-01" )
    dim as griddata.Order r2
    tkTest_Check( "SaveTo: every row back, the edit and the new line", f.SaveTo( r2 ) andalso (r2.Lines.Count( ) = 3) andalso (r2.Lines[0].Qty = 5) _
        andalso (r2.Lines[2].Item = "Pot") andalso (r2.Lines[2].Price = 30) andalso (r2.Lines[2].Due.Month = 12) andalso (r2.Lines[1].Paid = false), _
        str( r2.Lines.Count( ) ) )

    ' an open edit the grid refuses stops the save, and nothing is written
    tkDataGrid_SetCurrentCell( g, 0, 1 )
    tkDataGrid_BeginEdit( g, 0, 1 )
    tkTextBox_SetText( tkDataGrid_GetEditor( g ), "lots" )
    dim as griddata.Order r3
    r3.Lines.Push( NewLine( "keep", 1, 1, false, 1 ) )
    tkTest_Check( "an open edit that will not parse stops SaveTo", (f.SaveTo( r3 ) = false) andalso (r3.Lines.Count( ) = 1) andalso (r3.Lines[0].Item = "keep") )
    tkDataGrid_EndEdit( g, false )

    f.Close( )
    tkTest_PumpFor( h, 40 )
end sub

sub Live( byval owner as TK_FORM ptr )
    tkTest_Begin( "a designed form with live DataGrids (ItemsLive)" )
    dim as frmLive.Form f
    f.Build( owner )
    dim as TK_HOST ptr h = tkForm_Host( f.Handle )
    f.Show( )
    tkTest_PumpFor( h, 60 )
    dim as TK_WIDGET ptr g = f.grdLines.Handle
    dim as griddata.Order r
    r.Lines.Push( NewLine( "Tea", 2, 4.5, true, 3 ) ) : r.Lines.Push( NewLine( "Cups", 6, 1.25, false, 9 ) )
    tkTest_Check( "LoadFrom binds: the grid shows the record's array, an edit lands in it at once", f.LoadFrom( r ) _
        andalso tkDataGrid_HasSource( g ) andalso (tkDataGrid_GetRowCount( g ) = 2) andalso tkDataGrid_SetCellFloat( g, 0, 1, 7 ) _
        andalso (r.Lines[0].Qty = 7) andalso (tkDataGrid_GetCellFloat( g, 0, 3 ) = 31.5), str( r.Lines[0].Qty ) )
    tkTest_Check( "a method column opens no editor", tkDataGrid_BeginEdit( g, 0, 3 ) = false )

    dim as integer nr = tkDataGrid_AddRow( g )
    dim as long nAdded = r.Lines.Count( )
    tkDataGrid_SetCellText( g, nr, 0, "Pot" )
    tkTest_Check( "an added row and a deleted row change the array", (nAdded = 3) andalso (r.Lines[2].Item = "Pot") _
        andalso tkDataGrid_DeleteRows( g, 0 ) andalso (r.Lines.Count( ) = 2) andalso (r.Lines[0].Item = "Cups"), str( nAdded ) & " " & str( r.Lines.Count( ) ) )

    ' sorting shows the rows in another order; the array keeps its own, and _Item( ) is its index
    dim as TKDG_SORTKEY keys(0)
    keys(0).col = 0 : keys(0).bDescending = true
    tkDataGrid_SetSortKeys( g, keys() )
    tkDataGrid_SetCurrentCell( g, tkDataGrid_ViewToModel( g, 0 ), 0 )
    tkTest_Check( "sorted, the array keeps its order and _Item( ) is the element's index", (tkDataGrid_ViewToModel( g, 0 ) = 1) _
        andalso (r.Lines[0].Item = "Cups") andalso (f.grdLines_Item( ) = 1) andalso (r.Lines[1].Item = "Pot") )
    tkDataGrid_ClearSort( g )

    dim as griddata.Order r2
    tkTest_Check( "SaveTo: the shown record is left as it is, another record gets a copy", f.SaveTo( r ) andalso (r.Lines.Count( ) = 2) _
        andalso f.SaveTo( r2 ) andalso (r2.Lines.Count( ) = 2) andalso (r2.Lines[1].Item = "Pot") andalso (r2.Lines[0].Qty = 6) )

    ' ItemsSource: a form member, bound by _Fill; the program's own change shows after Reset
    f.Stock.Push( NewLine( "Tea", 40, 0, false, 1 ) ) : f.Stock.Push( NewLine( "Cups", 12, 0, false, 1 ) )
    f.grdStock_Fill( )
    dim as TK_WIDGET ptr gs = f.grdStock.Handle
    dim as long nBefore = tkDataGrid_GetRowCount( gs )
    f.Stock.Push( NewLine( "Pot", 3, 0, false, 1 ) )
    tkDataGrid_Reset( gs )
    tkTest_Check( "_Fill binds a form member; the program's own push shows after Reset", (nBefore = 2) andalso (tkDataGrid_GetRowCount( gs ) = 3) _
        andalso (tkDataGrid_GetCellText( gs, 2, 0 ) = "Pot") andalso tkDataGrid_SetCellFloat( gs, 1, 1, 11 ) andalso (f.Stock[1].Qty = 11) )

    f.Close( )
    tkTest_PumpFor( h, 40 )
end sub

if tkTest_Init() = false then end 99
dim as TKAPP_OPTIONS opts
if tkApp_Init( opts ) = false then
    print "tkApp_Init failed"
    end 98
end if
dim as TK_FORM ptr mainForm = tkApp_NewForm( "owner", 200, 120, 0, 1.0 )
tkForm_Show( mainForm )
tkTest_PumpFor( tkForm_Host( mainForm ), 50 )
Lines( mainForm )
Live( mainForm )
dim as long nFail = tkTest_Report( "tkGridForm" )
tkApp_Shutdown( )
end nFail
