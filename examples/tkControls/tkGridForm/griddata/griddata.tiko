' The records frmGrid binds (tkDataGrid G5): an order whose lines fill a DataGrid (ItemsField), a
' column per field -- text, numbers, a bool, a date -- and one method column the grid only shows.
#module "griddata"

#import "std/containers" public
#import "std/chrono" public
using containers

public type Line
    Item as ustring
    Qty as long
    Price as double
    Paid as boolean
    Due as chrono.LocalDate
    declare function Total( ) as double
end type

function Line.Total( ) as double
    return this.Qty * this.Price
end function

public type Order
    Lines as Array( of Line )
end type
