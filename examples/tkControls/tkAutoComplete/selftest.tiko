' tkAutoComplete self-test (phases A1 and A2): silent setters and the item store; typing opens and narrows
' the list while the EDIT keeps the focus and the popup is not focusable; keys and characters sent
' to the open list reach the edit; the popup is reused while its row count holds and replaced when
' it changes; the arrows, paging, preview and Escape; commit (order of events), submit, Tab; the
' closed-list keys; the mouse (hover never previews, click commits, a click in the edit closes);
' geometry (popup size and place, row rects, matched characters painted in the match colour where
' the run is and not after it); the status rows; the debounce; theme and pinned colours; an owner
' accelerator; focus loss. A2: the search face -- glyph and clear cells and the text's margins,
' the clear button's showing, hover and click, Search's debounce, Enter, Escape, commit, the glyph
' font. Two passes each, 1.0 and 1.75; every input is a pushed SDL event.
'
'   selftest            exit code = number of failures
#import "vendor/tkControls/tkAutoComplete"
#import "vendor/tkControls/tkTest"
using tkAutoComplete
using tkTextBox
using tkVScrollBar
using tkMatch
using tkTheme
using tkTest
using tkHost
using tkPaint

dim shared as string gLog
dim shared as long gChanged, gChangedList, gSelected, gSelIdx, gSubmits, gSubIdx, gHighlights, gHiIdx
dim shared as long gDrops, gAccels
dim shared as longint gSelId
dim shared as ustring gSubText

sub OnChanged( byval h as TK_WIDGET ptr, byval bFromList as boolean )
    gChanged += 1
    if bFromList then gChangedList += 1
    gLog &= iif( bFromList, "T1;", "T0;" )
end sub
sub OnSelected( byval h as TK_WIDGET ptr, byval idx as long, byval id as longint )
    gSelected += 1 : gSelIdx = idx : gSelId = id
    gLog &= "I" & idx & ";"
end sub
sub OnSubmit( byval h as TK_WIDGET ptr, byref text as const ustring, byval idx as long )
    gSubmits += 1 : gSubText = text : gSubIdx = idx
    gLog &= "S" & idx & ";"
end sub
sub OnHighlight( byval h as TK_WIDGET ptr, byval idx as long )
    gHighlights += 1 : gHiIdx = idx
end sub
sub OnDrop( byval h as TK_WIDGET ptr, byval isOpen as boolean )
    gDrops += 1
    gLog &= iif( isOpen, "O;", "C;" )
end sub
function OnPreKey( byval h as TK_HOST ptr, byval m as TK_MSG ptr ) as boolean
    if (m->key = SDLK_S) andalso ((m->mods and SDL_KMOD_CTRL) <> 0) then gAccels += 1 : return true
    return false
end function

sub ResetLog( )
    gLog = "" : gChanged = 0 : gChangedList = 0 : gSelected = 0 : gSelIdx = -9 : gSubmits = 0
    gSubIdx = -9 : gHighlights = 0 : gHiIdx = -9 : gDrops = 0 : gAccels = 0 : gSelId = 0 : gSubText = ""
end sub

' Let a queued "did focus leave the application?" check run while no popup is up (tkComboBox's
' selftest has the same reason: a test window that is not the active one closes popups 150 ms on).
sub Settle( byval h as TK_HOST ptr )
    tkTest_PumpFor( h, 200 )
end sub

' The edit's text, empty, focused.
sub Fresh( byval h as TK_HOST ptr, byval ac as TK_WIDGET ptr )
    tkAutoComplete_SetText( ac, "" )
    tkHost_SetFocus( h, ac )
    Settle( h )
    ResetLog( )
end sub

sub TypeText( byval h as TK_HOST ptr, byref s as ustring )
    for i as long = 1 to len( s )
        tkTest_PushText( h, mid( s, i, 1 ) )
    next
end sub

' Pixels of the popup's back buffer within dist (summed RGB) of colour c.
function CountNear( byval h as TK_HOST ptr, byval x as long, byval y as long, byval w as long, byval hh as long, _
                    byval c as ulong ) as long
    dim as long n = 0
    for yy as long = y to y + hh - 1
        for xx as long = x to x + w - 1
            dim as ulong px = tkTest_PixelAt( h, xx, yy )
            dim as long d = abs( cast( long, (px shr 16) and 255 ) - cast( long, (c shr 16) and 255 ) ) + _
                            abs( cast( long, (px shr 8) and 255 ) - cast( long, (c shr 8) and 255 ) ) + _
                            abs( cast( long, px and 255 ) - cast( long, c and 255 ) )
            if d < 120 then n += 1
        next
    next
    return n
end function

' The items: source order matters (the rows are in it). Car 01..12 with a disabled "Carp" after
' Car 02; Cab 01..04; Café Noir; Dog 01..05.
sub Fill( byval ac as TK_WIDGET ptr )
    tkAutoComplete_BeginUpdate( ac )
    for i as long = 1 to 12
        tkAutoComplete_AddItem( ac, "Car " & right( "0" & i, 2 ), 100 + i )
        if i = 2 then
            dim as TKAUTOCOMPLETE_ITEM it
            it.text = "Carp" : it.id = 99 : it.enabled = false : it.detail = "fish"
            tkAutoComplete_AddItemEx( ac, it )
        end if
    next
    for i as long = 1 to 4
        tkAutoComplete_AddItem( ac, "Cab " & right( "0" & i, 2 ), 200 + i )
    next
    dim as ustring cafe = "Café Noir"
    tkAutoComplete_AddItem( ac, cafe, 300 )
    for i as long = 1 to 5
        tkAutoComplete_AddItem( ac, "Dog " & right( "0" & i, 2 ), 400 + i )
    next
    tkAutoComplete_EndUpdate( ac )
end sub

sub RunPass( byval fScale as single )
    tkTest_Begin( "scale " & fScale )
    dim as TK_HOST ptr h = tkHost_Create( "tkAutoComplete selftest", 640, 520, tkHost_FontDir() & TK_FONT_UI, fScale )
    if h = 0 then tkTest_Check( "host", false, *SDL_GetError() ) : exit sub
    tkHost_Show( h )
    tkTest_PumpFor( h, 300 )
    dim as TK_WIDGET ptr ac = tkAutoComplete_Create( tkHost_Root( h ), 10 )
    tkWidget_SetPos( ac, tkHost_Scale( h, 20 ), tkHost_Scale( h, 20 ), tkHost_Scale( h, 260 ), tkHost_Scale( h, 30 ) )
    dim as TK_WIDGET ptr other = tkTextBox_Create( tkHost_Root( h ), 11, false )
    tkWidget_SetPos( other, tkHost_Scale( h, 320 ), tkHost_Scale( h, 20 ), tkHost_Scale( h, 200 ), tkHost_Scale( h, 30 ) )
    dim as TK_WIDGET ptr ed = tkAutoComplete_GetEditHandle( ac )
    tkAutoComplete_SetTextChangedCallback( ac, @OnChanged )
    tkAutoComplete_SetItemSelectedCallback( ac, @OnSelected )
    tkAutoComplete_SetHighlightCallback( ac, @OnHighlight )
    tkAutoComplete_SetDropDownCallback( ac, @OnDrop )
    h->OnPreKey = @OnPreKey
    ResetLog( )

    ' ---- the store, silently ----
    Fill( ac )
    tkTest_Check( "items: 23 added", tkAutoComplete_GetCount( ac ) = 23, str( tkAutoComplete_GetCount( ac ) ) )
    tkTest_Check( "find by id / by text (case-blind)", (tkAutoComplete_FindItemById( ac, 300 ) = 17) andalso _
        (tkAutoComplete_FindItemByText( ac, "cab 02" ) = 14) andalso (tkAutoComplete_FindItemById( ac, 7777 ) = -1) )
    dim as TKAUTOCOMPLETE_ITEM it
    tkTest_Check( "GetItem round trip", tkAutoComplete_GetItem( ac, 2, it ) andalso (it.text = "Carp") andalso _
        (it.enabled = false) andalso (it.detail = "fish") andalso (it.id = 99) )
    tkAutoComplete_SetSelectedIndex( ac, 5 )
    tkTest_Check( "SetSelectedIndex: the text and the id", (tkAutoComplete_GetText( ac ) = "Car 05") andalso _
        (tkAutoComplete_GetSelectedId( ac ) = 105) )
    tkAutoComplete_InsertItem( ac, 0, it )
    tkTest_Check( "insert before the selection moves it", tkAutoComplete_GetSelectedIndex( ac ) = 6 )
    tkAutoComplete_DeleteItem( ac, 0 )
    tkTest_Check( "delete before it moves it back", tkAutoComplete_GetSelectedIndex( ac ) = 5 )
    tkAutoComplete_SetText( ac, "free" )
    tkTest_Check( "SetText selects nothing", (tkAutoComplete_GetSelectedIndex( ac ) = -1) andalso (tkAutoComplete_GetQueryText( ac ) = "free") )
    tkTest_Check( "no setter notifies, none opens the list", (gChanged + gSelected + gDrops + gHighlights = 0) andalso _
        (tkAutoComplete_IsDroppedDown( ac ) = false), gLog )

    ' ---- typing opens; the edit keeps the focus ----
    Fresh( h, ac )
    tkTest_Check( "focus to the control lands in its edit", tkHost_GetFocus( h ) = ed )
    TypeText( h, "c" )
    dim as TK_HOST ptr lst = tkAutoComplete_GetListHandle( ac )
    tkTest_Check( "typing opens the list", tkAutoComplete_IsDroppedDown( ac ) andalso (lst <> 0), gLog )
    tkTest_Check( "'c': 18 rows (Car, Carp, Cab, Café)", tkAutoComplete_GetResultCount( ac ) = 18, str( tkAutoComplete_GetResultCount( ac ) ) )
    if lst then
        tkTest_Check( "the popup is not focusable", (SDL_GetWindowFlags( lst->win ) and SDL_WINDOW_NOT_FOCUSABLE) <> 0 )
    end if
    tkTest_Check( "the edit still has the focus", tkHost_GetFocus( h ) = ed )
    tkTest_Check( "TextChanged (typed), DropDown(open)", (gChanged = 1) andalso (gChangedList = 0) andalso (gLog = "T0;O;"), gLog )
    dim as long gen0 = tkAutoComplete_GetListGeneration( ac )
    TypeText( h, "a" )
    tkTest_Check( "a character to the open list reaches the edit", tkAutoComplete_GetText( ac ) = "ca", tkAutoComplete_GetText( ac ) )
    tkTest_Check( "'ca' keeps 18 rows and the same popup", (tkAutoComplete_GetResultCount( ac ) = 18) andalso _
        (tkAutoComplete_GetListGeneration( ac ) = gen0) )
    TypeText( h, "r" )
    tkTest_Check( "'car': 13 rows, still 8 shown, same popup", (tkAutoComplete_GetResultCount( ac ) = 13) andalso _
        (tkAutoComplete_GetListGeneration( ac ) = gen0) )
    tkTest_PushKey( h, SDLK_LEFT )
    tkTest_Check( "Left goes to the edit (caret moves), the list stays", (tkTextBox_GetCaret( ed ) = 2) andalso tkAutoComplete_IsDroppedDown( ac ) )
    tkTest_PushKey( h, SDLK_END )
    tkTest_PushKey( h, SDLK_BACKSPACE )
    tkTest_PushKey( h, SDLK_BACKSPACE )
    TypeText( h, "b" )
    tkTest_Check( "End, Backspace x2 via the list, then 'b': 'cb' matches nothing, closed", (tkAutoComplete_GetText( ac ) = "cb") andalso _
        (tkAutoComplete_IsDroppedDown( ac ) = false), tkAutoComplete_GetText( ac ) )
    tkAutoComplete_SetText( ac, "" )
    Fresh( h, ac )
    TypeText( h, "cab" )
    tkTest_Check( "'cab': 4 rows", tkAutoComplete_GetResultCount( ac ) = 4 )
    dim as long gen1 = tkAutoComplete_GetListGeneration( ac )
    TypeText( h, " 0" )
    tkTest_Check( "'cab 0' keeps 4: the popup is reused", tkAutoComplete_GetListGeneration( ac ) = gen1 )
    tkTest_PushKey( h, SDLK_BACKSPACE )
    tkTest_PushKey( h, SDLK_BACKSPACE )
    tkTest_PushKey( h, SDLK_BACKSPACE )
    tkTest_Check( "Backspace back to 'ca': 18 rows, a NEW popup (the row count changed)", _
        (tkAutoComplete_GetText( ac ) = "ca") andalso (tkAutoComplete_GetResultCount( ac ) = 18) andalso _
        (tkAutoComplete_GetListGeneration( ac ) = gen1 + 1), tkAutoComplete_GetText( ac ) & " gen " & tkAutoComplete_GetListGeneration( ac ) - gen1 & " " & gLog )

    ' ---- geometry ----
    lst = tkAutoComplete_GetListHandle( ac )
    if lst then
        dim as long pw, ph
        tkHost_PixelSize( lst, pw, ph )
        dim as long bw = tkHost_Scale( h, 1 ), rh = tkHost_Scale( h, TKAUTOCOMPLETE_DEFAULT_LISTITEMHEIGHT )
        tkTest_Check( "popup width = the control's", pw = ac->cw, pw & " vs " & ac->cw )
        tkTest_Check( "popup height = 8 rows + borders", ph = 2 * bw + 8 * rh, ph & " vs " & (2 * bw + 8 * rh) )
        dim as TKRECT r0, r1
        tkAutoComplete_GetListItemRect( ac, 0, r0 )
        tkAutoComplete_GetListItemRect( ac, 1, r1 )
        dim as long sbw = tkHost_Scale( h, TKVSCROLL_DEFAULT_WIDTH )
        tkTest_Check( "row rects: height, stacking, scroll bar room", (r0.bottom - r0.top = rh) andalso (r1.top = r0.bottom) andalso _
            (r0.top = bw) andalso (r0.left = bw) andalso (r0.right = pw - bw - sbw), r0.left & "," & r0.top & "," & r0.right & "," & r0.bottom )
        dim as TKRECT r8
        tkTest_Check( "row 8 is scrolled out", tkAutoComplete_GetListItemRect( ac, 8, r8 ) = false )
        ' the popup's place: under the control, left edges aligned. SDL3 gives a popup's position
        ' RELATIVE TO ITS PARENT, in OS window units.
        dim as long ox = 0, oy = 0, px, py
        SDL_GetWindowPosition( lst->win, @px, @py )
        dim as TKRECT a
        tkWidget_AbsRect( ac, a )
        dim as single d = h->fDensity
        dim as long ex = cint( a.left / d ), ey = cint( a.bottom / d )
        tkTest_Check( "popup under the control, left aligned (+-1)", (abs( (px - ox) - ex ) <= 1) andalso (abs( (py - oy) - ey ) <= 1), _
            "at " & (px - ox) & "," & (py - oy) & " want " & ex & "," & ey )
    end if

    ' ---- arrows, preview, Escape ----
    Fresh( h, ac )
    TypeText( h, "car" )
    ResetLog( )
    tkTest_PushKey( h, SDLK_DOWN )
    tkTest_Check( "Down: row 0, previewed, query kept", (tkAutoComplete_GetHighlight( ac ) = 0) andalso _
        (tkAutoComplete_GetText( ac ) = "Car 01") andalso (tkAutoComplete_GetQueryText( ac ) = "car") andalso (gHiIdx = 0) )
    tkTest_PushKey( h, SDLK_DOWN )
    tkTest_PushKey( h, SDLK_DOWN )
    tkTest_Check( "Down skips the disabled row (Carp)", (tkAutoComplete_GetHighlight( ac ) = 3) andalso _
        (tkAutoComplete_GetText( ac ) = "Car 03"), str( tkAutoComplete_GetHighlight( ac ) ) )
    tkTest_Check( "a preview is no change: nothing re-filtered", (gChanged = 0) andalso (tkAutoComplete_GetResultCount( ac ) = 13) )
    tkTest_PushKey( h, SDLK_UP ) : tkTest_PushKey( h, SDLK_UP ) : tkTest_PushKey( h, SDLK_UP )
    tkTest_Check( "Up past row 0: no row, the typed text back", (tkAutoComplete_GetHighlight( ac ) = -1) andalso _
        (tkAutoComplete_GetText( ac ) = "car") )
    tkTest_PushKey( h, SDLK_UP )
    tkTest_Check( "Up from no row: the last row", tkAutoComplete_GetHighlight( ac ) = 12 )
    tkTest_PushKey( h, SDLK_HOME, SDL_KMOD_LCTRL )
    tkTest_Check( "Ctrl+Home: the first row", tkAutoComplete_GetHighlight( ac ) = 0 )
    tkTest_PushKey( h, SDLK_PAGEDOWN )
    tkTest_Check( "PgDn: a page on (8 rows: row 7)", tkAutoComplete_GetHighlight( ac ) = 7, str( tkAutoComplete_GetHighlight( ac ) ) )
    tkTest_Check( "the highlight stays in view", tkAutoComplete_GetListTopIndex( ac ) = 0 )
    tkTest_PushKey( h, SDLK_END, SDL_KMOD_LCTRL )
    tkTest_Check( "Ctrl+End: the last row, scrolled into view", (tkAutoComplete_GetHighlight( ac ) = 12) andalso _
        (tkAutoComplete_GetListTopIndex( ac ) = 5), str( tkAutoComplete_GetListTopIndex( ac ) ) )
    ResetLog( )
    tkTest_PushKey( h, SDLK_ESCAPE )
    tkTest_Check( "Escape: closed, the typed text back, nothing selected", (tkAutoComplete_IsDroppedDown( ac ) = false) andalso _
        (tkAutoComplete_GetText( ac ) = "car") andalso (gSelected = 0) andalso (gLog = "C;"), gLog )

    ' ---- commit: order, text, value ----
    tkTest_PushKey( h, SDLK_DOWN )
    tkTest_Check( "Down on a closed list opens it at row 0", tkAutoComplete_IsDroppedDown( ac ) andalso (tkAutoComplete_GetHighlight( ac ) = 0) )
    tkTest_PushKey( h, SDLK_DOWN )
    ResetLog( )
    tkTest_PushKey( h, SDLK_RETURN )
    tkTest_Check( "Enter commits: closed FIRST, then TextChanged(list), then ItemSelected", gLog = "C;T1;I1;", gLog )
    tkTest_Check( "the item's text, index and id", (tkAutoComplete_GetText( ac ) = "Car 02") andalso _
        (tkAutoComplete_GetSelectedIndex( ac ) = 1) andalso (gSelId = 102) andalso (tkAutoComplete_GetSelectedId( ac ) = 102) )
    tkTest_Check( "no stray character from Enter", tkAutoComplete_GetText( ac ) = "Car 02" )
    TypeText( h, "x" )
    tkTest_Check( "typing again unselects", tkAutoComplete_GetSelectedIndex( ac ) = -1 )

    ' ---- submit ----
    tkAutoComplete_SetSubmitCallback( ac, @OnSubmit )
    Fresh( h, ac )
    TypeText( h, "ca" )
    tkTest_PushKey( h, SDLK_RETURN )
    tkTest_Check( "Enter with no row: Submit( text, -1 ), the list closed", (gSubmits = 1) andalso (gSubIdx = -1) andalso _
        (gSubText = "ca") andalso (tkAutoComplete_IsDroppedDown( ac ) = false) andalso (gSelected = 0), gLog )
    tkAutoComplete_SetSelectedIndex( ac, 17 )
    ResetLog( )
    tkTest_PushKey( h, SDLK_RETURN )
    tkTest_Check( "Enter on a closed list: Submit with the selected item", (gSubmits = 1) andalso (gSubIdx = 17), gLog )
    tkAutoComplete_SetSubmitCallback( ac, 0 )

    ' ---- Up / Alt+Down on a closed list, Alt+Up ----
    Fresh( h, ac )
    tkAutoComplete_SetText( ac, "do" )
    tkTest_PushKey( h, SDLK_UP )
    tkTest_Check( "Up on a closed list opens it at the last row", tkAutoComplete_IsDroppedDown( ac ) andalso _
        (tkAutoComplete_GetHighlight( ac ) = 4) andalso (tkAutoComplete_GetText( ac ) = "Dog 05") )
    tkTest_PushKey( h, SDLK_UP, SDL_KMOD_LALT )
    tkTest_Check( "Alt+Up closes and keeps the text shown", (tkAutoComplete_IsDroppedDown( ac ) = false) andalso _
        (tkAutoComplete_GetText( ac ) = "Dog 05") andalso (tkAutoComplete_GetQueryText( ac ) = "Dog 05") )
    tkAutoComplete_SetText( ac, "do" )
    tkTest_PushKey( h, SDLK_DOWN, SDL_KMOD_LALT )
    tkTest_Check( "Alt+Down opens with no row", tkAutoComplete_IsDroppedDown( ac ) andalso (tkAutoComplete_GetHighlight( ac ) = -1) )
    tkTest_PushKey( h, SDLK_ESCAPE )

    ' ---- Tab commits and moves on ----
    Fresh( h, ac )
    TypeText( h, "dog" )
    tkTest_PushKey( h, SDLK_DOWN )
    tkTest_PushKey( h, SDLK_DOWN )
    tkTest_PushKey( h, SDLK_TAB )
    tkTest_Check( "Tab commits the row and the focus moves on", (tkAutoComplete_GetSelectedIndex( ac ) = 19) andalso _
        (tkHost_GetFocus( h ) = other) andalso (tkAutoComplete_IsDroppedDown( ac ) = false), str( tkAutoComplete_GetSelectedIndex( ac ) ) )
    tkTest_Check( "no stray Tab character", tkAutoComplete_GetText( ac ) = "Dog 02" )

    ' ---- the mouse ----
    Fresh( h, ac )
    TypeText( h, "car" )
    lst = tkAutoComplete_GetListHandle( ac )
    if lst then
        dim as TKRECT r
        tkAutoComplete_GetListItemRect( ac, 3, r )
        tkTest_PushMotion( lst, (r.left + r.right) / 2, (r.top + r.bottom) / 2 )
        tkTest_Check( "hover highlights, never previews", (tkAutoComplete_GetHighlight( ac ) = 3) andalso (tkAutoComplete_GetText( ac ) = "car") )
        tkAutoComplete_GetListItemRect( ac, 2, r )
        tkTest_PushMotion( lst, (r.left + r.right) / 2, (r.top + r.bottom) / 2 )
        tkTest_Click( lst, (r.left + r.right) / 2, (r.top + r.bottom) / 2 )
        tkTest_Check( "a click on the disabled row does nothing", tkAutoComplete_IsDroppedDown( ac ) andalso (gSelected = 0) )
        tkAutoComplete_GetListItemRect( ac, 4, r )
        tkTest_Click( lst, (r.left + r.right) / 2, (r.top + r.bottom) / 2 )
        tkTest_Check( "a click commits its row", (tkAutoComplete_GetText( ac ) = "Car 04") andalso (gSelected = 1) andalso _
            (tkAutoComplete_IsDroppedDown( ac ) = false) )
    end if
    Fresh( h, ac )
    TypeText( h, "car" )
    tkTest_Click( h, tkTest_CX( ed ), tkTest_CY( ed ) )
    tkTest_Check( "a click in the edit closes the list, the edit keeps the focus", (tkAutoComplete_IsDroppedDown( ac ) = false) andalso _
        (tkHost_GetFocus( h ) = ed) )

    ' ---- the matched characters are painted in the match colour, where the run is ----
    dim as TKAUTOCOMPLETE_COLORS cc
    tkAutoComplete_GetColors( ac, @cc )
    cc.ListBackColor = &hFF000000ul : cc.ListForeColor = &hFF00FF00ul : cc.MatchForeColor = &hFFFF0000ul
    cc.ListBackColorHot = &hFF000080ul
    tkAutoComplete_SetColors( ac, @cc )
    Fresh( h, ac )
    TypeText( h, "dog" )
    lst = tkAutoComplete_GetListHandle( ac )
    if lst then
        tkHost_RenderTo( lst, false )
        dim as TKRECT r
        tkAutoComplete_GetListItemRect( ac, 0, r )
        dim as long pad = tkHost_Scale( h, TKAUTOCOMPLETE_ROWPAD )
        dim as TTF_Font ptr f = h->pDefaultFont
        dim as long xRun = r.left + pad, wRun = tkText_Width( f, "Dog" ), wRest = tkText_Width( f, " 01" )
        dim as long redIn = CountNear( lst, xRun, r.top, wRun, r.bottom - r.top, cc.MatchForeColor )
        dim as long redOut = CountNear( lst, xRun + wRun + 1, r.top, wRest, r.bottom - r.top, cc.MatchForeColor )
        dim as long greenOut = CountNear( lst, xRun + wRun + 1, r.top, wRest, r.bottom - r.top, cc.ListForeColor )
        tkTest_Check( "the run 'Dog' is in the match colour, ' 01' is not", (redIn > 10) andalso (redOut = 0) andalso (greenOut > 5), _
            "red in " & redIn & ", red after " & redOut & ", green after " & greenOut )
    end if
    tkTest_PushKey( h, SDLK_ESCAPE )

    ' ---- status rows ----
    tkAutoComplete_SetEmptyText( ac, "No matches" )
    Fresh( h, ac )
    TypeText( h, "zz" )
    tkTest_Check( "nothing matches: the empty-text row is up", tkAutoComplete_IsDroppedDown( ac ) andalso (tkAutoComplete_GetResultCount( ac ) = 0) )
    tkTest_PushKey( h, SDLK_DOWN )
    tkTest_Check( "the status row takes no highlight", tkAutoComplete_GetHighlight( ac ) = -1 )
    tkTest_PushKey( h, SDLK_ESCAPE )
    tkAutoComplete_SetEmptyText( ac, "" )
    Fresh( h, ac )
    TypeText( h, "zz" )
    tkTest_Check( "nothing matches, no empty text: closed", tkAutoComplete_IsDroppedDown( ac ) = false )
    tkAutoComplete_SetMaxResults( ac, 5 )
    Fresh( h, ac )
    TypeText( h, "c" )
    tkTest_Check( "capped at 5: 5 rows, 18 matches, a 6th (status) row", (tkAutoComplete_GetResultCount( ac ) = 5) andalso _
        (tkAutoComplete_GetMatchCount( ac ) = 18) )
    lst = tkAutoComplete_GetListHandle( ac )
    if lst then
        dim as long pw, ph
        tkHost_PixelSize( lst, pw, ph )
        tkTest_Check( "the popup holds 6 rows", ph = 2 * tkHost_Scale( h, 1 ) + 6 * tkHost_Scale( h, TKAUTOCOMPLETE_DEFAULT_LISTITEMHEIGHT ), str( ph ) )
    end if
    tkTest_PushKey( h, SDLK_ESCAPE )
    tkAutoComplete_SetMaxResults( ac, TKAUTOCOMPLETE_DEFAULT_MAXRESULTS )

    ' ---- modes: contains, fuzzy ranks ----
    tkAutoComplete_SetFilterMode( ac, TKMATCH_CONTAINS )
    Fresh( h, ac )
    TypeText( h, "noir" )
    tkTest_Check( "contains: 'noir' finds Café Noir", (tkAutoComplete_GetResultCount( ac ) = 1) andalso (tkAutoComplete_GetResultItem( ac, 0 ) = 17) )
    tkTest_PushKey( h, SDLK_ESCAPE )
    tkAutoComplete_SetFilterMode( ac, TKMATCH_FUZZY )
    Fresh( h, ac )
    TypeText( h, "cf" )
    tkTest_Check( "fuzzy: 'cf' ranks Café Noir first", (tkAutoComplete_GetResultCount( ac ) >= 1) andalso (tkAutoComplete_GetResultItem( ac, 0 ) = 17) )
    tkTest_PushKey( h, SDLK_ESCAPE )
    tkAutoComplete_SetFilterMode( ac, TKMATCH_PREFIX )

    ' ---- the debounce ----
    tkAutoComplete_SetDelay( ac, 150 )
    Fresh( h, ac )
    dim as long genD = tkAutoComplete_GetListGeneration( ac )
    TypeText( h, "car" )
    tkTest_Check( "Delay: three changes, nothing open yet", (gChanged = 3) andalso (tkAutoComplete_IsDroppedDown( ac ) = false) )
    tkTest_PumpFor( h, 300 )
    ' (not "still open": 300 ms is past tkHost's 150 ms focus check, which closes popups when the
    ' test window is not the active application)
    tkTest_Check( "Delay: one filter after the pause, one popup", _
        (tkAutoComplete_GetListGeneration( ac ) = genD + 1) andalso (tkAutoComplete_GetResultCount( ac ) = 13), _
        "gen +" & (tkAutoComplete_GetListGeneration( ac ) - genD) & " rows " & tkAutoComplete_GetResultCount( ac ) )
    tkTest_PushKey( h, SDLK_ESCAPE )
    tkAutoComplete_SetDelay( ac, 0 )

    ' ---- an owner accelerator, focus loss ----
    Fresh( h, ac )
    TypeText( h, "car" )
    tkTest_PushKey( h, SDLK_S, SDL_KMOD_LCTRL )
    tkTest_Check( "Ctrl+S reaches the owner's accelerators; the list closes; the edit is untouched", (gAccels = 1) andalso _
        (tkAutoComplete_IsDroppedDown( ac ) = false) andalso (tkAutoComplete_GetText( ac ) = "car") )
    Fresh( h, ac )
    TypeText( h, "car" )
    tkHost_SetFocus( h, other )
    tkTest_Check( "focus leaving closes the list", tkAutoComplete_IsDroppedDown( ac ) = false )

    ' ---- theme and pinned colours ----
    tkAutoComplete_UnpinColors( ac )
    dim as TKAUTOCOMPLETE_COLORS want = tkAutoComplete_ThemeColors( tkTheme_Of( ac ) ), got
    tkAutoComplete_GetColors( ac, @got )
    dim as TKTEXTBOX_COLORS ec
    tkTextBox_GetColors( ed, @ec )
    tkTest_Check( "unpinned: the theme's colours, the edit's follow", (got.ListBackColor = want.ListBackColor) andalso _
        (got.MatchForeColor = want.MatchForeColor) andalso (ec.BackColor = got.BackColor) andalso (ec.BorderColor = got.BorderColor) )
    got.BackColor = &hFF123456ul
    tkAutoComplete_SetColors( ac, @got )
    tkAutoComplete_ApplyTheme( ac, tkTheme_Of( ac ) )
    tkAutoComplete_GetColors( ac, @got )
    tkTextBox_GetColors( ed, @ec )
    tkTest_Check( "pinned: a theme change leaves them; the edit has them", (got.BackColor = &hFF123456ul) andalso (ec.BackColor = &hFF123456ul) )

    tkHost_Destroy( h )
end sub

' ==========================================================================================
' A2: the search face
' ==========================================================================================
dim shared as long gSearches
dim shared as ustring gSearchText

sub OnSearch( byval h as TK_WIDGET ptr, byref text as const ustring )
    gSearches += 1 : gSearchText = text
    gLog &= "Q[" & text & "];"
end sub

' Pixels of the main window's back buffer near colour c, in the control-local rect rc of w.
function InkIn( byval h as TK_HOST ptr, byval w as TK_WIDGET ptr, byref rc as TKRECT, byval c as ulong ) as long
    dim as TKRECT a
    tkWidget_AbsRect( w, a )
    return CountNear( h, a.left + rc.left, a.top + rc.top, rc.right - rc.left, rc.bottom - rc.top, c )
end function

sub SearchPass( byval fScale as single )
    tkTest_Begin( "search " & fScale )
    dim as TK_HOST ptr h = tkHost_Create( "tkAutoComplete search", 640, 360, tkHost_FontDir() & TK_FONT_UI, fScale )
    if h = 0 then tkTest_Check( "host", false, *SDL_GetError() ) : exit sub
    tkHost_Show( h )
    tkTest_PumpFor( h, 300 )
    dim as TK_WIDGET ptr ac = tkAutoComplete_Create( tkHost_Root( h ), 20 )
    tkWidget_SetPos( ac, tkHost_Scale( h, 20 ), tkHost_Scale( h, 20 ), tkHost_Scale( h, 300 ), tkHost_Scale( h, 32 ) )
    dim as TK_WIDGET ptr other = tkTextBox_Create( tkHost_Root( h ), 21, false )
    tkWidget_SetPos( other, tkHost_Scale( h, 360 ), tkHost_Scale( h, 20 ), tkHost_Scale( h, 200 ), tkHost_Scale( h, 32 ) )
    dim as TK_WIDGET ptr ed = tkAutoComplete_GetEditHandle( ac )
    tkAutoComplete_SetTextChangedCallback( ac, @OnChanged )
    tkAutoComplete_SetSearchCallback( ac, @OnSearch )
    dim as long cell = tkHost_Scale( h, TKAUTOCOMPLETE_GLYPHCELL )
    dim as TKRECT rg, rcl, rt

    ' ---- the input style has no face ----
    tkTest_Check( "input style: no glyph, no clear button, no Escape-clears", (tkAutoComplete_GetGlyphRect( ac, rg ) = false) andalso _
        (tkAutoComplete_GetClearButton( ac ) = false) andalso (tkAutoComplete_GetClearOnEscape( ac ) = false) )
    ' ---- the search style ----
    tkAutoComplete_SetStyle( ac, TKAC_STYLE_SEARCH )
    tkTest_Check( "search style: glyph cell at the left, full height", tkAutoComplete_GetGlyphRect( ac, rg ) andalso _
        (rg.left = 0) andalso (rg.top = 0) andalso (rg.right = cell) andalso (rg.bottom = ac->ch), rg.left & "," & rg.right & "," & rg.bottom )
    tkTest_Check( "an empty box shows no clear button", tkAutoComplete_GetClearRect( ac, rcl ) = false )
    tkTextBox_GetTextRect( ed, rt )
    tkTest_Check( "the text keeps clear of both cells", (rt.left >= cell) andalso (rt.right <= ac->cw - cell), rt.left & ".." & rt.right & " cell " & cell )
    gSearches = 0 : ResetLog( )
    tkHost_SetFocus( h, ac )
    Settle( h )
    TypeText( h, "abc" )
    tkTest_Check( "the clear button appears with text, at the right", tkAutoComplete_GetClearRect( ac, rcl ) andalso _
        (rcl.right = ac->cw) andalso (rcl.left = ac->cw - cell) andalso (rcl.bottom = ac->ch) )
    tkTest_Check( "Search waits for the pause", gSearches = 0 )
    tkTest_PumpFor( h, 350 )
    tkTest_Check( "one Search after the pause, with the text", (gSearches = 1) andalso (gSearchText = "abc"), gLog )
    tkTest_PushKey( h, SDLK_BACKSPACE ) : tkTest_PushKey( h, SDLK_BACKSPACE ) : tkTest_PushKey( h, SDLK_BACKSPACE )
    tkTest_PumpFor( h, 350 )
    tkTest_Check( "erased to empty: one Search(empty), the clear button gone", (gSearches = 2) andalso (gSearchText = "") andalso _
        (tkAutoComplete_GetClearRect( ac, rcl ) = false), gLog )
    TypeText( h, "q" )
    tkTest_PushKey( h, SDLK_RETURN )
    tkTest_Check( "Enter searches at once", (gSearches = 3) andalso (gSearchText = "q") )
    tkTest_PumpFor( h, 350 )
    tkTest_Check( "and the pending one is dropped", gSearches = 3, gLog )

    ' ---- the clear button: hover, click ----
    dim as TKAUTOCOMPLETE_COLORS cc
    tkAutoComplete_GetColors( ac, @cc )
    cc.GlyphColor = &hFF00FF00ul : cc.GlyphColorHot = &hFFFF0000ul : cc.BackColor = &hFF000000ul
    tkAutoComplete_SetColors( ac, @cc )
    tkAutoComplete_GetClearRect( ac, rcl )
    tkHost_RenderTo( h, false )
    tkTest_Check( "the clear cross is drawn (glyph colour)", InkIn( h, ac, rcl, cc.GlyphColor ) > 3 )
    tkTest_Check( "the lens is drawn (glyph colour)", InkIn( h, ac, rg, cc.GlyphColor ) > 3 )
    dim as TKRECT a
    tkWidget_AbsRect( ac, a )
    tkTest_PushMotion( h, a.left + (rcl.left + rcl.right) / 2, a.top + (rcl.top + rcl.bottom) / 2 )
    tkHost_RenderTo( h, false )
    tkTest_Check( "hovered, the cross takes the hot colour", (InkIn( h, ac, rcl, cc.GlyphColorHot ) > 3) andalso (InkIn( h, ac, rcl, cc.GlyphColor ) = 0) )
    ResetLog( ) : gSearches = 0
    tkHost_SetFocus( h, other )
    tkTest_Click( h, a.left + (rcl.left + rcl.right) / 2, a.top + (rcl.top + rcl.bottom) / 2 )
    tkTest_Check( "a click on clear: empty, TextChanged, Search(empty) at once, focus in the box", _
        (tkAutoComplete_GetText( ac ) = "") andalso (gLog = "T0;Q[];") andalso (tkHost_GetFocus( h ) = ed) andalso _
        (tkAutoComplete_GetClearRect( ac, rcl ) = false), gLog )
    tkHost_SetFocus( h, other )
    tkTest_Click( h, a.left + (rg.left + rg.right) / 2, a.top + (rg.top + rg.bottom) / 2 )
    tkTest_Check( "a click on the glyph focuses the box", tkHost_GetFocus( h ) = ed )

    ' ---- Escape ----
    TypeText( h, "zz" )
    ResetLog( ) : gSearches = 0
    tkTest_PushKey( h, SDLK_ESCAPE )
    tkTest_Check( "Escape with text: cleared, Search(empty) at once", (tkAutoComplete_GetText( ac ) = "") andalso (gLog = "T0;Q[];"), gLog )
    ResetLog( )
    tkTest_PushKey( h, SDLK_ESCAPE )
    tkTest_Check( "Escape on an empty box is left alone", gLog = "", gLog )

    ' ---- with suggestions: the first Escape closes the list, the second clears ----
    tkAutoComplete_AddItem( ac, "alpha", 1 )
    tkAutoComplete_AddItem( ac, "alpine", 2 )
    tkAutoComplete_AddItem( ac, "beta", 3 )
    Settle( h )
    TypeText( h, "al" )
    tkTest_Check( "suggestions in the search face", tkAutoComplete_IsDroppedDown( ac ) andalso (tkAutoComplete_GetResultCount( ac ) = 2) )
    tkTest_PushKey( h, SDLK_ESCAPE )
    tkTest_Check( "Escape #1 closes the list, the text stays", (tkAutoComplete_IsDroppedDown( ac ) = false) andalso (tkAutoComplete_GetText( ac ) = "al") )
    tkTest_PushKey( h, SDLK_ESCAPE )
    tkTest_Check( "Escape #2 clears", tkAutoComplete_GetText( ac ) = "" )
    Settle( h )
    TypeText( h, "al" )
    tkTest_PushKey( h, SDLK_DOWN )
    tkTest_PushKey( h, SDLK_DOWN )
    ResetLog( ) : gSearches = 0
    tkTest_PushKey( h, SDLK_RETURN )
    tkTest_Check( "a commit searches at once for the item", (gSearches = 1) andalso (gSearchText = "alpine"), gLog )

    ' ---- no delay: Search per change ----
    tkAutoComplete_SetSearchDelay( ac, 0 )
    tkAutoComplete_SetText( ac, "" )
    gSearches = 0
    TypeText( h, "xyz" )
    tkTest_Check( "SearchDelay 0: one Search per change", (gSearches = 3) andalso (gSearchText = "xyz") )
    tkTest_PushKey( h, SDLK_ESCAPE )

    ' ---- a glyph font draws the glyphs instead ----
    dim as TTF_Font ptr fIcons = tkHost_OpenFont( h, tkHost_FontDir() & TK_FONT_ICONS, 12 )
    tkAutoComplete_SetGlyphFont( ac, fIcons )
    tkHost_RenderTo( h, false )
    tkTest_Check( "glyph font: the search glyph has ink", (fIcons <> 0) andalso (InkIn( h, ac, rg, cc.GlyphColor ) > 3) )
    tkAutoComplete_SetSearchGlyph( ac, 0 )
    tkTextBox_GetTextRect( ed, rt )
    tkTest_Check( "SearchGlyph 0: no glyph cell, the text starts at the left", (tkAutoComplete_GetGlyphRect( ac, rg ) = false) andalso (rt.left < cell) )
    tkAutoComplete_SetStyle( ac, TKAC_STYLE_INPUT )
    tkTextBox_GetTextRect( ed, rt )
    tkTest_Check( "back to input: no face, full-width text", (tkAutoComplete_GetClearButton( ac ) = false) andalso (rt.right > ac->cw - cell) )
    tkHost_Destroy( h )
end sub

if tkTest_Init() = false then end 99
RunPass( 1.0 )
RunPass( 1.75 )
SearchPass( 1.0 )
SearchPass( 1.75 )
dim as long nFail = tkTest_Report( "tkAutoComplete" )
tkTest_Quit()
end nFail
