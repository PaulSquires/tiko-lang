' tkMaskForm self-test (MASKEDIT.md M5). frmOrder was written as a .tkform and generated by tkEdit
' --generate-forms; this drives the generated code: six MaskEdits made with their masks, a record
' loaded through each one's canonical bind text (a phone and a postcode as text, a regex code, a
' price as a float64, a TKDATE, a TKTIME), saved back, and SaveTo refusing an incomplete phone and a
' date that does not exist through tkMaskEdit's validator. A presenter stands in for the message box.
#import "vendor/tkControls/tkTest"
#import "vendor/tkControls/tkApp"
#import "vendor/tkControls/tkForms"
#import "vendor/tkControls/tkBind"
#import "vendor/tkControls/tkMask"
#import "vendor/tkControls/tkMaskEdit"
#import "vendor/tkControls/tkMaskEditRegex"
#import "./frmOrder"
#import "./orderdata"
using tkApp
using tkForms
using tkBind
using tkMask
using tkMaskEdit
using tkMaskEditRegex
using tkCalendar
using tkTimePanel
using tkHost
using tkTest

dim shared as int32 gShown
dim shared as ustring gShownText

sub Presenter( byval f as TK_FORM ptr, byref e as TKBIND_ERRORS, byval bLoading as boolean )
    gShown += 1
    gShownText = e.Text( )
end sub

function Shown( byval w as TK_WIDGET ptr ) as ustring
    return tkMaskEdit_GetText( w )
end function

sub Order( byval owner as TK_FORM ptr )
    tkTest_Begin( "a designed form with masks" )
    tkBind_SetErrorPresenter( @Presenter )
    dim as frmOrder.Form f
    f.Build( owner )
    dim as TK_HOST ptr h = tkForm_Host( f.Handle )
    f.Show( )
    tkTest_PumpFor( h, 60 )

    tkTest_Check( "the generated form made each mask with its kind", _
        (tkMaskEdit_GetMaskKind( f.mePhone.Handle ) = TKMASK_FIXED) andalso (tkMaskEdit_GetMask( f.mePhone.Handle ) = "(999) 000-0000") _
        andalso (tkMaskEdit_GetMaskKind( f.meCode.Handle ) = TKMASK_REGEX) andalso (tkMaskEdit_GetMaskKind( f.mePrice.Handle ) = TKMASK_NUMERIC) _
        andalso (tkMaskEdit_GetMaskKind( f.meBorn.Handle ) = TKMASK_DATE) andalso (tkMaskEdit_GetMaskKind( f.meAppt.Handle ) = TKMASK_TIME) )
    tkTest_Check( "... the regex one too, its provider enabled before Build", Shown( f.meCode.Handle ) = "" )
    tkTest_Check( "... and ValueFormat", tkMaskEdit_GetValueFormat( f.mePhone.Handle ) = TKMASK_FMT_LITERALS )

    dim as orderdata.Order r
    r.Phone = "(555) 123-4567" : r.Postcode = "k1a0b1" : r.Code = "AB123456" : r.Price = 1234.5
    r.Born.wYear = 1990 : r.Born.wMonth = 2 : r.Born.wDay = 28
    r.Appt = tkTimePanel_MakeTime( 9, 5 )
    tkTest_Check( "LoadFrom: true, nothing reported", f.LoadFrom( r ) andalso (gShown = 0), gShownText )
    tkTest_Check( "LoadFrom: each field through its mask", (Shown( f.mePhone.Handle ) = "(555) 123-4567") _
        andalso (Shown( f.mePost.Handle ) = "K1A 0B1") andalso (Shown( f.meCode.Handle ) = "AB123456") _
        andalso (Shown( f.mePrice.Handle ) = "$1,234.50") andalso (Shown( f.meBorn.Handle ) = "28/02/1990") _
        andalso (Shown( f.meAppt.Handle ) = "09:05"), Shown( f.mePost.Handle ) & " " & Shown( f.mePrice.Handle ) & " " & Shown( f.meBorn.Handle ) )

    dim as orderdata.Order r2
    tkTest_Check( "SaveTo: true", f.SaveTo( r2 ) andalso (gShown = 0), gShownText )
    tkTest_Check( "SaveTo: each field back in its own type", (r2.Phone = "(555) 123-4567") andalso (r2.Postcode = "K1A0B1") _
        andalso (r2.Code = "AB123456") andalso (r2.Price = 1234.5) andalso (r2.Born.wYear = 1990) andalso (r2.Born.wMonth = 2) _
        andalso (r2.Born.wDay = 28) andalso (r2.Appt.wHour = 9) andalso (r2.Appt.wMinute = 5), r2.Postcode & " " & r2.Price )

    ' an incomplete phone and a date that does not exist: nothing written, both reported
    tkMaskEdit_SetText( f.mePhone.Handle, "555123" )
    tkMaskEdit_SetText( f.meBorn.Handle, "31021990" )
    dim as orderdata.Order r3
    r3.Phone = "untouched"
    tkTest_Check( "SaveTo: false on an incomplete phone and 31/02", f.SaveTo( r3 ) = false )
    tkTest_Check( "  ... nothing written", r3.Phone = "untouched" )
    tkTest_Check( "  ... the validator's messages, one per control", (gShown = 1) _
        andalso (gShownText = "Phone: is incomplete" & !"\n" & "Born: is not a real date, or is outside its range"), gShownText )

    ' Required: an empty phone is reported as required, not as incomplete
    tkMaskEdit_Clear( f.mePhone.Handle )
    tkMaskEdit_SetText( f.meBorn.Handle, "28021990" )
    tkTest_Check( "SaveTo: false on an empty required phone", (f.SaveTo( r3 ) = false) andalso (gShownText = "Phone: is required"), gShownText )

    tkBind_SetErrorPresenter( 0 )
    f.Close( )
    tkTest_PumpFor( h, 40 )
end sub

if tkTest_Init() = false then end 99
dim as TKAPP_OPTIONS opts
if tkApp_Init( opts ) = false then
    print "tkApp_Init failed"
    end 98
end if
tkMaskEditRegex_Enable( )                      ' a Regex mask needs it before the form is built
dim as TK_FORM ptr mainForm = tkApp_NewForm( "owner", 200, 120, 0, 1.0 )
tkForm_Show( mainForm )
tkTest_PumpFor( tkForm_Host( mainForm ), 50 )
Order( mainForm )
dim as int32 nFail = tkTest_Report( "tkMaskForm" )
tkApp_Shutdown( )
end nFail
