' tkGauge demo (phase GS2, radial): a speedometer (270 degrees, ranges, needle, outside labels), a
' 180-degree KPI (a bar and a target marker), a whole-circle progress ring (a bar, the value at the
' centre, no scale), a +-50 bar from 0 with tapered ranges, and a small widgetless gauge. Values
' move every 1.5 s, eased over 600 ms; click a gauge to send it a new value at once.
'
'   demo                     interactive
'   demo --shot out.bmp      render once, save the window, exit
'   demo --scale 1.75        pin the scale instead of asking the display
#import "vendor/tkControls/tkGauge"
using tkGauge
using tkTheme
using tkHost
using tkPaint

const TIMER_MOVE = TK_TIMER_APP + 1

dim shared as TK_HOST ptr gHost
dim shared as TTF_Font ptr gFont, gBig
dim shared as TK_WIDGET ptr gG(0 to 3)

function S_( byval v as int32 ) as int32
    return tkHost_Scale( gHost, v )
end function

sub NewValues( byval only as TK_WIDGET ptr = 0 )
    for i as int32 = 0 to 3
        if (only <> 0) andalso (gG(i) <> only) then continue for
        dim as float64 lo = tkGauge_GetMin( gG(i) ), hi = tkGauge_GetMax( gG(i) )
        tkGauge_SetValue( gG(i), lo + rnd * (hi - lo) )
    next
end sub

sub Gauge_Click( byval hGauge as TK_WIDGET ptr, byval id as int32 )
    NewValues( hGauge )
end sub

function MoveProc( byval w as TK_WIDGET ptr, byval m as TK_MSG ptr ) as boolean
    if (m->msg <> TKM_TIMER) orelse (m->timerId <> TIMER_MOVE) then return false
    NewValues( )
    return true
end function

sub Form_Paint( byval h as TK_HOST ptr, byval b as TK_PAINT ptr )
    dim as TKTHEME_COLORS t = tkTheme_Of( tkHost_Root( h ) )
    dim as TKRECT rc
    b->SetFont( gFont )
    b->SetColors( t.TextDim, t.Window )
    tkRect_Set( rc, S_( 700 ), S_( 230 ), S_( 860 ), S_( 250 ) )
    b->PaintText( "PaintInto (no widget)", @rc, TK_DT_CENTER or TK_DT_VCENTER )
    ' a widgetless gauge: a 0..10 rating as a semicircle
    dim as TKGAUGE_POINTER pp
    pp.fValue = 7.5
    dim as TKGAUGE_RANGE rg(0 to 1)
    rg(0).fFrom = 0 : rg(0).fTo = 5 : rg(0).clr = t.Error
    rg(1).fFrom = 5 : rg(1).fTo = 10 : rg(1).clr = t.Success
    dim as TKGAUGE_SPEC s
    s.fMax = 10 : s.fStart = 180 : s.fSweep = 180
    s.pPointers = @pp : s.nPointers = 1 : s.pRanges = @rg(0) : s.nRanges = 2
    s.fText = gFont : s.sCaption = "Score" : s.fScale = h->fScale
    tkRect_Set( rc, S_( 700 ), S_( 255 ), S_( 860 ), S_( 355 ) )
    tkGauge_PaintInto( b, rc, s )
end sub

private function ArgValue( byref name_ as string ) as string
    for i as int32 = 1 to 20
        if command( i ) = "" then exit for
        if command( i ) = name_ then return command( i + 1 )
    next
    return ""
end function

private sub SaveShot( byref path as string )
    tkHost_Render( gHost )
    tkHost_RenderTo( gHost, false )
    dim as SDL_Surface ptr s = SDL_RenderReadPixels( gHost->renderer, 0 )
    if s then
        SDL_SaveBMP( s, strptr( path ) )
        print "shot: " & path & "  " & s->w & "x" & s->h & "  scale=" & gHost->fScale
        SDL_DestroySurface( s )
    end if
end sub

function Add( byval id as int32, byval x as int32, byval y as int32, byval cw as int32, byval ch as int32 ) as TK_WIDGET ptr
    dim as TK_WIDGET ptr w = tkGauge_Create( tkHost_Root( gHost ), id )
    tkWidget_SetPos( w, S_( x ), S_( y ), S_( cw ), S_( ch ) )
    tkGauge_SetFont( w, gFont )
    tkGauge_SetValueFont( w, gBig )
    tkGauge_SetAnimation( w, 600 )
    tkGauge_SetClickCallback( w, @Gauge_Click )
    return w
end function

' ---- main --------------------------------------------------------------------------------
if SDL_Init( SDL_INIT_VIDEO ) = false then print "SDL_Init: " & *SDL_GetError() : end 1
if TTF_Init() = false then print "TTF_Init: " & *SDL_GetError() : end 1
randomize 11
gHost = tkHost_Create( "tkGauge on SDL3", 880, 380, tkHost_FontDir() & TK_FONT_UI, val( ArgValue( "--scale" ) ) )
if gHost = 0 then print "host: " & *SDL_GetError() : end 1
dim as TKTHEME_COLORS t = tkTheme_Of( tkHost_Root( gHost ) )
gHost->clrBack = t.Window
gFont = tkHost_OpenFont( gHost, tkHost_FontDir() & TK_FONT_UI, 9 )
gBig = tkHost_OpenFont( gHost, tkHost_FontDir() & TK_FONT_UI_BOLD, 18 )

' a speedometer: 0..240, ranges, outside labels
gG(0) = Add( 1, 10, 10, 260, 260 )
tkGauge_SetRange( gG(0), 0, 240 )
tkGauge_SetMajorStep( gG(0), 40 )
tkGauge_SetScalePlacement( gG(0), TKGAUGE_SCALE_OUTSIDE )
tkGauge_SetRangesText( gG(0), "0..120=#3C8C46;120..180=#C8A032;180..240=#C04646" )
tkGauge_SetCaption( gG(0), "Speed" )
tkGauge_SetSuffix( gG(0), " km/h" )
tkGauge_SetDecimals( gG(0), 0 )
tkGauge_SetShowFace( gG(0), true )

' a KPI: a semicircle, a bar and a target marker
gG(1) = Add( 2, 280, 10, 260, 160 )
tkGauge_SetAngles( gG(1), 180, 180 )
tkGauge_SetPointerKind( gG(1), 0, TKGAUGE_PTR_BAR )
dim as int32 iTarget = tkGauge_AddPointer( gG(1), TKGAUGE_PTR_MARKER )
tkGauge_SetPointerValue( gG(1), iTarget, 75 )
tkGauge_SetSuffix( gG(1), " %" )
tkGauge_SetDecimals( gG(1), 0 )
tkGauge_SetCaption( gG(1), "Quarter target 75 %" )

' a whole-circle progress ring: no scale, the value at the centre
gG(2) = Add( 3, 560, 10, 140, 140 )
tkGauge_SetAngles( gG(2), 270, 360 )
tkGauge_SetPointerKind( gG(2), 0, TKGAUGE_PTR_BAR )
tkGauge_SetScalePlacement( gG(2), TKGAUGE_SCALE_NONE )
tkGauge_SetTrackWidth( gG(2), 0.16 )
tkGauge_SetSuffix( gG(2), " %" )
tkGauge_SetDecimals( gG(2), 0 )
tkGauge_SetCaption( gG(2), "Done" )

' -50..50: a bar from 0, tapered ranges, a needle on top
gG(3) = Add( 4, 280, 180, 260, 190 )
tkGauge_SetRange( gG(3), -50, 50 )
tkGauge_SetAngles( gG(3), 150, 240 )
tkGauge_SetPointerKind( gG(3), 0, TKGAUGE_PTR_BAR )
tkGauge_SetBarOrigin( gG(3), 0 )
tkGauge_SetPointerWidth( gG(3), 0, 0.5 )
tkGauge_AddRange( gG(3), -50, -25, tkRGB( 192, 70, 70 ) )
tkGauge_SetRangeWidth( gG(3), 0, 1, 0.3 )
tkGauge_AddRange( gG(3), 25, 50, tkRGB( 60, 140, 70 ) )
tkGauge_SetRangeWidth( gG(3), 1, 0.3, 1 )
tkGauge_SetCaption( gG(3), "Balance" )

' first values: no easing for the opening frame
for i as int32 = 0 to 3 : tkGauge_SetAnimation( gG(i), 0 ) : next
tkGauge_SetValue( gG(0), 96 )
tkGauge_SetValue( gG(1), 62 )
tkGauge_SetValue( gG(2), 68 )
tkGauge_SetValue( gG(3), 18 )
for i as int32 = 0 to 3 : tkGauge_SetAnimation( gG(i), 600 ) : next

dim as TK_WIDGET ptr mover = tkWidget_CreateChild( tkHost_Root( gHost ), 99, @MoveProc, 0 )
tkWidget_SetPos( mover, 0, 0, 0, 0 )
tkWidget_SetTimer( mover, TIMER_MOVE, 1500 )

gHost->OnPaint = @Form_Paint
tkHost_Show( gHost )
dim as string shot = ArgValue( "--shot" )
if len( shot ) then
    tkHost_Pump( gHost )
    SaveShot( shot )
else
    tkHost_Run( gHost )
end if
tkHost_Destroy( gHost )
TTF_Quit()
SDL_Quit()
