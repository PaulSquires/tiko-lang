' tkMaskEdit self-test (MASKEDIT.md M1: FIXED masks). Real windows, real SDL event queue: typing is
' pushed as the SDL text events a keyboard produces, keys and clicks as SDL key and button events.
' The mask rules themselves are tkMask's suite; this one checks the box around them -- the filter
' wiring, the edit / shown forms and the focus swap, the notifications and their order, the
' caret rules, the clipboard forms, insert mode, the error tint, silent setters, the keyboard kind.
' Two passes, scale pinned at 1.0 and at 1.75.
'
'   selftest            exit code = number of failures
#import "vendor/tkControls/tkMaskEdit"
#import "vendor/tkControls/tkTest"
#import "vendor/tkControls/tkMaskEditRegex"
using tkMaskEdit
using tkMask
using tkMaskEditRegex
using tkTextBox
using tkCalendar
using tkTimePanel
using tkBind
using tkTheme
using tkTest
using tkHost
using tkPaint

dim shared as int32 gChanges, gRejects, gCommits, gFocusIn, gFocusOut, gLastReason
dim shared as string gOrder

sub OnChange( byval hCtrl as TK_WIDGET ptr )
    gChanges += 1
    gOrder &= "C"
end sub

sub OnRejected( byval hCtrl as TK_WIDGET ptr, byval nPos as int32, byval nReason as int32, byref sText as const ustring )
    gRejects += 1
    gLastReason = nReason
    gOrder &= "R"
end sub

sub OnCommit( byval hCtrl as TK_WIDGET ptr )
    gCommits += 1
end sub

sub OnFocus( byval hCtrl as TK_WIDGET ptr, byval bGot as boolean )
    if bGot then gFocusIn += 1 else gFocusOut += 1
end sub

sub Reset_()
    gChanges = 0 : gRejects = 0 : gCommits = 0 : gFocusIn = 0 : gFocusOut = 0 : gLastReason = -1 : gOrder = ""
end sub

function Sel( byval w as TK_WIDGET ptr ) as string
    dim as integer a, b
    tkTextBox_GetSel( tkMaskEdit_GetEdit( w ), a, b )
    return a & "," & b
end function

function Shown( byval w as TK_WIDGET ptr ) as string
    dim as ustring u = tkTextBox_GetText( tkMaskEdit_GetEdit( w ) )
    dim as string s = u
    return s
end function

function TextOf( byval w as TK_WIDGET ptr ) as string
    dim as ustring u = tkMaskEdit_GetText( w )
    dim as string s = u
    return s
end function

' One character per text event, as a keyboard types.
sub TypeEach( byval h as TK_HOST ptr, byref s as const string )
    for i as int32 = 1 to len( s )
        tkTest_PushText( h, mid( s, i, 1 ) )
    next
end sub

' Click at the caret point of byte offset off in the field.
sub ClickOffset( byval h as TK_HOST ptr, byval w as TK_WIDGET ptr, byval off as int32 )
    dim as TK_WIDGET ptr e = tkMaskEdit_GetEdit( w )
    dim as int32 px, py
    tkTextBox_PosFromChar( e, off, px, py )
    dim as TKRECT a
    tkWidget_AbsRect( e, a )
    tkTest_Click( h, a.left + px + 1, a.top + py + tkHost_Scale( h, 6 ), SDL_BUTTON_LEFT )
end sub

' ==========================================================================================
sub RunPass( byval fScale as float32 )
    tkTest_Begin( "scale " & fScale )
    dim as TK_HOST ptr h = tkHost_Create( "tkMaskEdit selftest", 520, 260, tkHost_FontDir() & TK_FONT_UI, fScale )
    if h = 0 then tkTest_Check( "host created", false, *SDL_GetError() ) : exit sub
    dim as TK_WIDGET ptr root = tkHost_Root( h )
    dim as TK_WIDGET ptr w = tkMaskEdit_Create( root, 100 )
    dim as TK_WIDGET ptr other = tkTextBox_Create( root, 101 )
    dim as int32 ww = tkHost_Scale( h, 220 ), wh = tkHost_Scale( h, 28 )
    tkWidget_SetPos( w, tkHost_Scale( h, 20 ), tkHost_Scale( h, 20 ), ww, wh )
    tkWidget_SetPos( other, tkHost_Scale( h, 20 ), tkHost_Scale( h, 80 ), ww, wh )
    tkMaskEdit_SetChangeCallback( w, @OnChange )
    tkMaskEdit_SetRejectedCallback( w, @OnRejected )
    tkMaskEdit_SetCommitCallback( w, @OnCommit )
    tkMaskEdit_SetFocusCallback( w, @OnFocus )
    tkHost_Pump( h )
    dim as TK_WIDGET ptr e = tkMaskEdit_GetEdit( w )

    ' ---- shape ---------------------------------------------------------------------------------
    dim as TKRECT ra, rb
    tkWidget_AbsRect( w, ra ) : tkWidget_AbsRect( e, rb )
    tkTest_Check( "the field fills the control", (ra.left = rb.left) andalso (ra.top = rb.top) andalso _
        (ra.right = rb.right) andalso (ra.bottom = rb.bottom) andalso (ra.right - ra.left = ww) )
    tkTest_Check( "the control is not a tab stop, the field is", (w->isFocusable = false) andalso e->isFocusable )

    ' ---- no mask: a plain text box ----------------------------------------------------------------
    tkHost_SetFocus( h, w )
    tkTest_Check( "a programmatic focus lands on the field", tkHost_GetFocus( h ) = e )
    Reset_()
    TypeEach( h, "ab" )
    tkTest_Check( "no mask: typing is plain", (TextOf( w ) = "ab") andalso (gChanges = 2) andalso (gRejects = 0), TextOf( w ) )
    tkHost_SetFocus( h, other )

    ' ---- SetMask -------------------------------------------------------------------------------------
    Reset_()
    tkTest_Check( "SetMask FIXED", tkMaskEdit_SetMask( w, TKMASK_FIXED, "(999) 000-0000" ) )
    tkMask_SetRegexProvider( 0, 0 )                           ' as a program that never enables it
    tkTest_Check( "REGEX is refused while no provider is registered", tkMaskEdit_SetMask( w, TKMASK_REGEX, "[A-Z]+" ) = false )
    tkTest_Check( "a bad pattern is refused, the mask kept", (tkMaskEdit_SetMask( w, TKMASK_FIXED, "99\" ) = false) _
        andalso (tkMaskEdit_GetMask( w ) = "(999) 000-0000") andalso (tkMaskEdit_GetMaskKind( w ) = TKMASK_FIXED) )
    tkTest_Check( "unfocused and empty: nothing shown (the cue banner's turn)", Shown( w ) = "", Shown( w ) )
    tkTest_Check( "GetText is the edit form: the template", TextOf( w ) = "(___) ___-____" )
    tkTest_Check( "empty", tkMaskEdit_IsEmpty( w ) andalso tkMaskEdit_IsValid( w ) andalso (tkMaskEdit_IsComplete( w ) = false) )
    tkTest_Check( "a digits-only mask asks for a number pad", tkWidget_GetTextKind( e ) = TK_TEXT_INTEGER, "" & tkWidget_GetTextKind( e ) )

    ' ---- focus in, typing --------------------------------------------------------------------------
    tkHost_SetFocus( h, w )
    tkTest_Check( "focus shows the template, the caret in the first slot", (Shown( w ) = "(___) ___-____") andalso (Sel( w ) = "1,1"), _
        Shown( w ) & " " & Sel( w ) )
    TypeEach( h, "5551234567" )
    tkTest_Check( "typing through the mask", (TextOf( w ) = "(555) 123-4567") andalso (gChanges = 10), TextOf( w ) & " " & gChanges )
    tkTest_Check( "complete", tkMaskEdit_IsComplete( w ) andalso tkMaskEdit_IsValid( w ) )
    tkTest_Check( "GetValueText RAW", tkMaskEdit_GetValueText( w ) = "5551234567" )
    Reset_()
    tkTextBox_SetSel( e, 1, 1 )
    TypeEach( h, "a" )
    tkTest_Check( "a refused character: Rejected, no change", (gRejects = 1) andalso (gChanges = 0) andalso _
        (gLastReason = TKMASK_REJ_CLASS) andalso (TextOf( w ) = "(555) 123-4567") )
    TypeEach( h, "9" )
    tkTest_Check( "typing overwrites", (TextOf( w ) = "(955) 123-4567") andalso (Sel( w ) = "2,2"), TextOf( w ) & " " & Sel( w ) )
    tkTest_PushKey( h, SDLK_BACKSPACE )
    tkTest_Check( "Backspace leaves a prompt", (TextOf( w ) = "(_55) 123-4567") andalso (Sel( w ) = "1,1"), TextOf( w ) & " " & Sel( w ) )
    tkTest_PushKey( h, SDLK_Z, TK_KMOD_PRIMARY )
    tkTest_Check( "Undo", TextOf( w ) = "(955) 123-4567", TextOf( w ) )

    ' ---- insert mode -----------------------------------------------------------------------------
    tkTextBox_SetSel( e, 0, -1 )
    tkTest_PushKey( h, SDLK_DELETE )
    tkTest_Check( "Delete over everything empties every slot", TextOf( w ) = "(___) ___-____", TextOf( w ) )
    TypeEach( h, "123" )
    tkTest_PushKey( h, SDLK_INSERT )
    tkTest_Check( "Insert turns insert mode on", tkMaskEdit_GetInsertMode( w ) )
    tkTextBox_SetSel( e, 1, 1 )
    TypeEach( h, "9" )
    tkTest_Check( "insert mode shifts the filled slots", TextOf( w ) = "(912) 3__-____", TextOf( w ) )
    tkTest_PushKey( h, SDLK_INSERT )
    tkTest_Check( "Insert again: overwrite", tkMaskEdit_GetInsertMode( w ) = false )

    ' ---- paste, copy ---------------------------------------------------------------------------------
    Reset_()
    tkHost_SetClipboardText( "555x67" )
    tkTextBox_SetSel( e, 0, -1 )
    tkTest_PushKey( h, SDLK_V, TK_KMOD_PRIMARY )
    tkTest_Check( "a paste stops at the refused character", TextOf( w ) = "(555) ___-____", TextOf( w ) )
    tkTest_Check( "... Change, then Rejected", (gOrder = "CR") andalso (gLastReason = TKMASK_REJ_CLASS), gOrder )
    tkTextBox_SetSel( e, 0, -1 )
    tkTest_PushKey( h, SDLK_C, TK_KMOD_PRIMARY )
    tkTest_Check( "Copy: literals, empty slots as spaces", tkHost_GetClipboardText() = "(555)    -    ", "[" & tkHost_GetClipboardText() & "]" )
    tkMaskEdit_SetCopyFormat( w, TKMASK_FMT_RAW )
    tkTest_PushKey( h, SDLK_C, TK_KMOD_PRIMARY )
    tkTest_Check( "Copy in RAW", tkHost_GetClipboardText() = "555" )
    tkMaskEdit_SetCopyFormat( w, TKMASK_FMT_LITERALS )

    ' ---- the caret after a click (D-5) -----------------------------------------------------------
    tkTextBox_SetSel( e, 0, 0 )
    ClickOffset( h, w, 12 )
    tkTest_Check( "a click past the first empty slot lands there", Sel( w ) = "6,6", Sel( w ) )
    ClickOffset( h, w, 2 )
    tkTest_Check( "a click before it stays", Sel( w ) = "2,2", Sel( w ) )

    ' ---- commit, error tint, focus out ---------------------------------------------------------------
    Reset_()
    tkTest_PushKey( h, SDLK_RETURN )
    tkTest_Check( "Enter commits; incomplete shows the error", (gCommits = 1) andalso tkMaskEdit_GetError( w ) )
    tkTextBox_SetSel( e, 6, 6 )
    TypeEach( h, "1234567" )
    tkTest_Check( "the next change clears the error", tkMaskEdit_GetError( w ) = false )
    tkHost_SetFocus( h, other )
    tkTest_Check( "focus out commits a valid value, no error", (gCommits = 2) andalso (tkMaskEdit_GetError( w ) = false) _
        andalso (gFocusOut = 1) )
    tkTest_Check( "unfocused, a filled box shows its edit form", Shown( w ) = "(555) 123-4567", Shown( w ) )
    tkMaskEdit_SetText( w, "555123" )
    tkMaskEdit_SetHidePromptOnLeave( w, true )
    tkTest_Check( "HidePromptOnLeave: prompts as spaces", Shown( w ) = "(555) 123-    ", "[" & Shown( w ) & "]" )
    tkHost_SetFocus( h, w )
    tkTest_Check( "focus brings the prompts back", Shown( w ) = "(555) 123-____", Shown( w ) )
    tkHost_SetFocus( h, other )
    tkTest_Check( "focus out with an incomplete value: the error", tkMaskEdit_GetError( w ) )
    tkMaskEdit_SetHidePromptOnLeave( w, false )

    ' ---- silent setters, value forms, prompt ---------------------------------------------------------
    Reset_()
    tkMaskEdit_SetText( w, "(444) 555-6666" )
    tkTest_Check( "SetText clears the error", tkMaskEdit_GetError( w ) = false )
    tkMaskEdit_SetValueText( w, "4445556666" )
    tkMaskEdit_SetPromptChar( w, "*" )
    tkMaskEdit_Clear( w )
    tkMaskEdit_SetMask( w, TKMASK_FIXED, ">LL-000" )
    tkTest_Check( "every setter is silent", (gChanges = 0) andalso (gRejects = 0) andalso (gCommits = 0), gChanges & gRejects & gCommits )
    tkTest_Check( "a letter mask asks for a line keyboard", tkWidget_GetTextKind( e ) = TK_TEXT_LINE )
    tkTest_Check( "the prompt survives a new mask", TextOf( w ) = "**-***", TextOf( w ) )
    tkMaskEdit_SetText( w, "ab123" )
    tkTest_Check( "SetText maps a raw value, upper-cased", TextOf( w ) = "AB-123", TextOf( w ) )
    tkMaskEdit_SetValueFormat( w, TKMASK_FMT_LITERALS )
    tkTest_Check( "GetValueText LITERALS", tkMaskEdit_GetValueText( w ) = "AB-123" )
    tkMaskEdit_SetValueFormat( w, TKMASK_FMT_RAW )
    tkMaskEdit_SetReadOnly( w, true )
    tkHost_SetFocus( h, w )
    tkTextBox_SetSel( e, 0, 0 )
    TypeEach( h, "z" )
    tkTest_Check( "read-only refuses typing", (TextOf( w ) = "AB-123") andalso (gChanges = 0) )
    tkMaskEdit_SetReadOnly( w, false )
    tkHost_SetFocus( h, other )

    ' ---- NUMERIC (M2) ------------------------------------------------------------------------------
    Reset_()
    tkTest_Check( "SetMask NUMERIC", tkMaskEdit_SetMask( w, TKMASK_NUMERIC, "$#,##0.00" ) )
    tkTest_Check( "a number is right-aligned and asks for a decimal pad", (tkMaskEdit_GetTextAlign( w ) = TXT_ALIGN_RIGHT) _
        andalso (tkWidget_GetTextKind( e ) = TK_TEXT_DECIMAL) )
    tkTest_Check( "an empty number shows and holds nothing", (Shown( w ) = "") andalso (TextOf( w ) = "") andalso tkMaskEdit_IsEmpty( w ) )
    tkHost_SetFocus( h, w )
    TypeEach( h, "1234.5" )
    tkTest_Check( "typing a number: grouped as typed, '.' only moves", (TextOf( w ) = "$1,234.50") andalso (gChanges = 5) _
        andalso (tkMaskEdit_GetValue( w ) = 1234.5), TextOf( w ) & " " & gChanges )
    Reset_()
    tkMaskEdit_SetMin( w, 0 ) : tkMaskEdit_SetMax( w, 1000 )
    tkTest_Check( "IsValid sees the range", tkMaskEdit_IsValid( w ) = false )
    tkTest_PushKey( h, SDLK_RETURN )
    tkTest_Check( "Enter clamps to Max: one Change, one Commit, no error", (TextOf( w ) = "$1,000.00") andalso (gChanges = 1) _
        andalso (gCommits = 1) andalso (tkMaskEdit_GetError( w ) = false), TextOf( w ) & " " & gChanges & gCommits )
    Reset_()
    tkMaskEdit_SetAllowNegative( w, false )
    TypeEach( h, "-" )
    tkTest_Check( "AllowNegative off: '-' rejected", (gRejects = 1) andalso (gLastReason = TKMASK_REJ_SIGN) andalso (gChanges = 0) )
    tkMaskEdit_SetAllowNegative( w, true )
    TypeEach( h, "-" )
    tkTest_Check( "'-' toggles the sign", TextOf( w ) = "$-1,000.00", TextOf( w ) )
    tkHost_SetFocus( h, other )
    tkTest_Check( "focus out clamps to Min", (TextOf( w ) = "$0.00") andalso (Shown( w ) = "$0.00") andalso (gChanges = 2) _
        andalso (gCommits = 1), TextOf( w ) & " " & gChanges & gCommits )
    tkTest_Check( "GetValueText is the plain number", tkMaskEdit_GetValueText( w ) = "0.00" )
    Reset_()
    tkMaskEdit_SetValue( w, 250.5 )
    tkTest_Check( "SetValue formats, silently", (Shown( w ) = "$250.50") andalso (tkMaskEdit_GetValue( w ) = 250.5) andalso (gChanges = 0) )
    tkMaskEdit_SetValue( w, 5000 )
    tkTest_Check( "SetValue does not clamp; IsValid says so", (TextOf( w ) = "$5,000.00") andalso (tkMaskEdit_IsValid( w ) = false) )
    tkMaskEdit_ClearRange( w )
    tkTest_Check( "ClearRange", tkMaskEdit_IsValid( w ) )
    tkMaskEdit_Clear( w )
    tkMaskEdit_SetZeroWhenEmpty( w, true )
    tkHost_SetFocus( h, w )
    tkHost_SetFocus( h, other )
    tkTest_Check( "ZeroWhenEmpty stamps 0 on focus loss, silently", (Shown( w ) = "$0.00") andalso (gChanges = 0), Shown( w ) )
    tkMaskEdit_SetZeroWhenEmpty( w, false )
    tkHost_SetClipboardText( "abc" )
    tkHost_SetFocus( h, w )
    tkTextBox_SetSel( e, 0, -1 )
    tkTest_PushKey( h, SDLK_V, TK_KMOD_PRIMARY )
    tkTest_Check( "a paste that is not a number is refused whole", (gLastReason = TKMASK_REJ_NOTNUMBER) andalso (TextOf( w ) = "$0.00") )
    tkHost_SetClipboardText( "-1,250.756" )
    tkTest_PushKey( h, SDLK_V, TK_KMOD_PRIMARY )
    tkTest_Check( "a pasted number's extra decimals stop the paste", TextOf( w ) = "$-1,250.75", TextOf( w ) )
    tkHost_SetFocus( h, other )
    tkTest_Check( "a percent mask", tkMaskEdit_SetMask( w, TKMASK_NUMERIC, "0.0%" ) )
    tkMaskEdit_SetValue( w, 0.125 )
    tkTest_Check( "... shows x 100, reads / 100", (Shown( w ) = "12.5%") andalso (abs( tkMaskEdit_GetValue( w ) - 0.125 ) < 1e-12) )
    tkMaskEdit_SetMask( w, TKMASK_FIXED, "000" )
    tkTest_Check( "back to FIXED: left-aligned", tkMaskEdit_GetTextAlign( w ) = TXT_ALIGN_LEFT )

    ' ---- DATE / TIME / DATETIME (M3) ---------------------------------------------------------------
    Reset_()
    tkTest_Check( "SetMask DATE", tkMaskEdit_SetMask( w, TKMASK_DATE, "dd/mm/yyyy" ) )
    tkTest_Check( "a date is left-aligned and asks for a number pad", (tkMaskEdit_GetTextAlign( w ) = TXT_ALIGN_LEFT) _
        andalso (tkWidget_GetTextKind( e ) = TK_TEXT_INTEGER) )
    tkHost_SetFocus( h, w )
    TypeEach( h, "25122026" )
    dim as TKDATE dv = tkMaskEdit_GetDateValue( w )
    tkTest_Check( "typing a date, the separators by themselves", (TextOf( w ) = "25/12/2026") andalso (gChanges = 8) _
        andalso (dv.wYear = 2026) andalso (dv.wMonth = 12) andalso (dv.wDay = 25) andalso (dv.wDayOfWeek = 5), TextOf( w ) )
    Reset_()
    tkTextBox_SetSel( e, 4, 4 )
    tkTest_PushKey( h, SDLK_UP )
    tkTest_Check( "Up steps the segment at the caret, wrapping; one Change; the caret kept", (TextOf( w ) = "25/01/2026") _
        andalso (gChanges = 1) andalso (Sel( w ) = "4,4"), TextOf( w ) & " " & Sel( w ) )
    tkTest_PushKey( h, SDLK_Z, TK_KMOD_PRIMARY )
    tkTest_Check( "a spin is one undo step", TextOf( w ) = "25/12/2026", TextOf( w ) )
    tkTextBox_SetSel( e, 4, 4 )
    tkTest_PushKey( h, SDLK_PAGEUP )
    tkTest_Check( "PgUp steps by 10", TextOf( w ) = "25/10/2026", TextOf( w ) )
    tkTextBox_SetSel( e, 0, 0 )
    tkTest_PushKey( h, SDLK_DOWN )
    tkTest_Check( "Down on the day", TextOf( w ) = "24/10/2026", TextOf( w ) )
    tkMaskEdit_SetReadOnly( w, true )
    tkTest_PushKey( h, SDLK_UP )
    tkTest_Check( "read-only does not spin", TextOf( w ) = "24/10/2026" )
    tkMaskEdit_SetReadOnly( w, false )
    Reset_()
    tkMaskEdit_SetText( w, "31022026" )
    tkTest_Check( "31/02 is not valid, and there is no date value", (TextOf( w ) = "31/02/2026") andalso _
        (tkMaskEdit_IsValid( w ) = false) andalso (tkMaskEdit_GetDateValue( w ).wYear = 0) andalso tkMaskEdit_IsComplete( w ) )
    tkTest_PushKey( h, SDLK_RETURN )
    tkTest_Check( "... Enter shows the error, the text unchanged", tkMaskEdit_GetError( w ) andalso (TextOf( w ) = "31/02/2026") _
        andalso (gCommits = 1) )
    dim as TKDATE dmin, dset
    dmin.wYear = 2026 : dmin.wMonth = 1 : dmin.wDay = 1
    tkMaskEdit_SetMinDate( w, dmin )
    dset.wYear = 2025 : dset.wMonth = 12 : dset.wDay = 31
    tkMaskEdit_SetDateValue( w, dset )
    tkTest_Check( "SetDateValue, silently; MinDate makes it invalid", (TextOf( w ) = "31/12/2025") andalso _
        (tkMaskEdit_IsValid( w ) = false) andalso (gChanges = 0) )
    tkHost_SetFocus( h, other )
    tkTest_Check( "focus out flags a date before MinDate, never changes it (D-13)", tkMaskEdit_GetError( w ) _
        andalso (TextOf( w ) = "31/12/2025") andalso (gChanges = 0) )
    tkMaskEdit_ClearDateRange( w )
    tkTest_Check( "ClearDateRange", tkMaskEdit_IsValid( w ) )
    dset.wYear = 0
    tkMaskEdit_SetDateValue( w, dset )
    tkTest_Check( "wYear = 0 empties the box", tkMaskEdit_IsEmpty( w ) andalso (Shown( w ) = "") )

    tkTest_Check( "SetMask TIME", tkMaskEdit_SetMask( w, TKMASK_TIME, "hh:nn" ) )
    dim as TKTIME tv = tkTimePanel_MakeTime( 23, 5 )
    tkMaskEdit_SetTimeValue( w, tv )
    tkTest_Check( "SetTimeValue / GetTimeValue", (TextOf( w ) = "23:05") andalso (tkMaskEdit_GetTimeValue( w ).wHour = 23) _
        andalso (tkMaskEdit_GetTimeValue( w ).wMinute = 5) )
    tkHost_SetFocus( h, w )
    tkTextBox_SetSel( e, 0, 0 )
    tkTest_PushKey( h, SDLK_UP )
    tkTest_Check( "Up wraps an hour 23 to 00", TextOf( w ) = "00:05", TextOf( w ) )
    tkHost_SetFocus( h, other )
    tkTest_Check( "a TIME has no date value", tkMaskEdit_GetDateValue( w ).wYear = 0 )

    tkTest_Check( "SetMask DATETIME", tkMaskEdit_SetMask( w, TKMASK_DATETIME, "yyyy-mm-dd hh:nn" ) )
    dim as TKDATETIME xv = tkTimePanel_MakeDateTime( 2026, 11, 26, 9, 30 )
    tkMaskEdit_SetDateTimeValue( w, xv )
    dim as TKDATETIME xg = tkMaskEdit_GetDateTimeValue( w )
    tkTest_Check( "SetDateTimeValue / GetDateTimeValue", (TextOf( w ) = "2026-11-26 09:30") andalso (xg.wYear = 2026) _
        andalso (xg.wDay = 26) andalso (xg.wHour = 9) andalso (xg.wMinute = 30), TextOf( w ) )
    dset.wYear = 2027 : dset.wMonth = 1 : dset.wDay = 2
    tkMaskEdit_SetDateValue( w, dset )
    tkTest_Check( "SetDateValue keeps a DATETIME's time", TextOf( w ) = "2027-01-02 09:30", TextOf( w ) )
    tkMaskEdit_SetMask( w, TKMASK_FIXED, "000" )

    ' ---- REGEX (M4), through tkMaskEditRegex / PCRE2 -----------------------------------------------
    Reset_()
    tkMaskEditRegex_Enable( )
    tkTest_Check( "a pattern PCRE2 refuses: FALSE and its message", (tkMaskEdit_SetMask( w, TKMASK_REGEX, "(ab" ) = false) _
        andalso (instr( tkMaskEditRegex_LastError( ), "missing closing parenthesis" ) > 0), tkMaskEditRegex_LastError( ) )
    tkTest_Check( "SetMask REGEX", tkMaskEdit_SetMask( w, TKMASK_REGEX, "[A-Z]{2}\d{6,8}" ) )
    tkTest_Check( "a regex asks for a line keyboard, left-aligned", (tkWidget_GetTextKind( e ) = TK_TEXT_LINE) _
        andalso (tkMaskEdit_GetTextAlign( w ) = TXT_ALIGN_LEFT) )
    tkHost_SetFocus( h, w )
    TypeEach( h, "a" )
    tkTest_Check( "a character that cannot lead to a match: Rejected", (gRejects = 1) andalso (gLastReason = TKMASK_REJ_PATTERN) _
        andalso (TextOf( w ) = "") )
    TypeEach( h, "AB12345" )
    tkTest_Check( "a partial match is not complete", (TextOf( w ) = "AB12345") andalso (tkMaskEdit_IsComplete( w ) = false) )
    TypeEach( h, "678" )
    tkTest_Check( "eight digits: complete", (TextOf( w ) = "AB12345678") andalso tkMaskEdit_IsComplete( w ) andalso tkMaskEdit_IsValid( w ) )
    TypeEach( h, "9" )
    tkTest_Check( "a ninth digit is refused", (TextOf( w ) = "AB12345678") andalso (gRejects = 2) )
    tkTextBox_SetSel( e, 1, 2 )
    tkTest_PushKey( h, SDLK_DELETE )
    tkTest_Check( "deleting is allowed even when it breaks the match (D-14)", (TextOf( w ) = "A12345678") _
        andalso (tkMaskEdit_IsValid( w ) = false) )
    tkHost_SetFocus( h, other )
    tkTest_Check( "... and the commit shows the error", tkMaskEdit_GetError( w ) )
    tkMaskEdit_SetText( w, "XY123" )
    tkTest_Check( "SetText keeps a value as given; IsValid says it is incomplete", (TextOf( w ) = "XY123") _
        andalso (tkMaskEdit_IsValid( w ) = false) andalso (tkMaskEdit_GetError( w ) = false) )
    tkHost_SetClipboardText( "CD7654321" )
    tkHost_SetFocus( h, w )
    tkTextBox_SetSel( e, 0, -1 )
    tkTest_PushKey( h, SDLK_V, TK_KMOD_PRIMARY )
    tkTest_Check( "a matching paste", TextOf( w ) = "CD7654321" )
    tkHost_SetClipboardText( "cd1" )
    tkTextBox_SetSel( e, 0, -1 )
    tkTest_PushKey( h, SDLK_V, TK_KMOD_PRIMARY )
    tkTest_Check( "a paste that cannot match is refused whole", (TextOf( w ) = "CD7654321") andalso (gLastReason = TKMASK_REJ_PATTERN) )
    tkHost_SetFocus( h, other )
    tkTest_Check( "a (?x) pattern with a # comment at its end", tkMaskEdit_SetMask( w, TKMASK_REGEX, "(?x) [a-c]+  # letters" ) )
    tkHost_SetFocus( h, w )
    TypeEach( h, "cab" )
    TypeEach( h, "d" )
    tkTest_Check( "... works as the pattern says", (TextOf( w ) = "cab") andalso tkMaskEdit_IsComplete( w ), TextOf( w ) )
    tkHost_SetFocus( h, other )
    tkTest_Check( "a Unicode class", tkMaskEdit_SetMask( w, TKMASK_REGEX, "\p{Lu}\d" ) )
    tkHost_SetFocus( h, w )
    tkTest_PushText( h, chr( &hC3, &h89 ) )
    TypeEach( h, "1" )
    tkTest_Check( "... takes an upper-case E-acute then a digit", (TextOf( w ) = chr( &hC3, &h89 ) & "1") andalso tkMaskEdit_IsComplete( w ) )
    tkHost_SetFocus( h, other )
    tkMaskEdit_SetMask( w, TKMASK_FIXED, "000" )

    ' ---- the designer's two properties and the bind text (M5) ------------------------------------
    Reset_()
    dim as TK_WIDGET ptr w2 = tkMaskEdit_Create( root, 102 )
    tkMaskEdit_SetMaskPattern( w2, "dd/mm/yyyy" )
    tkTest_Check( "Mask before MaskKind: no mask yet (not a FIXED pattern)", (tkMaskEdit_GetMask( w2 ) = "dd/mm/yyyy") _
        andalso (tkMaskEdit_GetMaskKind( w2 ) = TKMASK_FIXED) andalso (TextOf( w2 ) = "") )
    tkMaskEdit_SetMaskKind( w2, TKMASK_DATE )
    tkTest_Check( "... MaskKind after it sets the mask", (tkMaskEdit_GetMaskKind( w2 ) = TKMASK_DATE) andalso (TextOf( w2 ) = "__/__/____") )
    tkMaskEdit_SetMaskKind( w2, TKMASK_NUMERIC )
    tkMaskEdit_SetMaskPattern( w2, "$#,##0.00" )
    tkTest_Check( "MaskKind then Mask", (tkMaskEdit_GetMaskKind( w2 ) = TKMASK_NUMERIC) andalso (tkMaskEdit_GetMask( w2 ) = "$#,##0.00") )
    tkWidget_Destroy( w2 )

    tkMaskEdit_SetMask( w, TKMASK_FIXED, "(999) 000-0000" )
    tkMaskEdit_SetBindText( w, "5551234567" )
    tkTest_Check( "FIXED bind text: the value text", (TextOf( w ) = "(555) 123-4567") andalso (tkMaskEdit_GetBindText( w ) = "5551234567") )
    dim as TKBIND_ERRORS be
    dim as ustring us
    tkMaskEdit_SetText( w, "555123" )
    tkBind_Check( be, w, "Phone", us, tkMaskEdit_GetBindText( w ), tkBind_Rule( ) )
    tkTest_Check( "an incomplete value: the validator's INCOMPLETE", (be.Count = 1) andalso (be.Items( 0 ).Code = TKBIND_ERR_INCOMPLETE) _
        andalso (be.Text( ) = "Phone: is incomplete"), be.Text( ) )
    be.Clear( )
    tkMaskEdit_Clear( w )
    tkBind_Check( be, w, "Phone", us, tkMaskEdit_GetBindText( w ), tkBind_Rule( true ) )
    tkTest_Check( "empty: Required, not the validator", (be.Count = 1) andalso (be.Items( 0 ).Code = TKBIND_ERR_REQUIRED) )
    be.Clear( )
    tkMaskEdit_SetMask( w, TKMASK_NUMERIC, "$#,##0.00" )
    dim as float64 price = 99.5
    tkMaskEdit_SetBindText( w, tkBind_Text( price ) )
    tkTest_Check( "NUMERIC bind text in: tkBind_Text of a double", (TextOf( w ) = "$99.50") andalso (tkMaskEdit_GetBindText( w ) = "99.50") )
    tkBind_Put( price, tkMaskEdit_GetBindText( w ) )
    tkTest_Check( "... and out into the double", price = 99.5 )
    tkMaskEdit_SetMask( w, TKMASK_DATE, "dd/mm/yyyy" )
    dim as TKDATE bd
    bd.wYear = 2026 : bd.wMonth = 12 : bd.wDay = 25
    tkMaskEdit_SetBindText( w, tkBind_Text( bd ) )
    tkTest_Check( "DATE bind text: ISO both ways", (TextOf( w ) = "25/12/2026") andalso (tkMaskEdit_GetBindText( w ) = "2026-12-25") )
    tkMaskEdit_SetText( w, "31022026" )
    tkBind_Check( be, w, "Born", bd, tkMaskEdit_GetBindText( w ), tkBind_Rule( ) )
    tkTest_Check( "31/02: the bind text is as shown, the validator refuses it", (tkMaskEdit_GetBindText( w ) = "31/02/2026") _
        andalso (be.Count = 1) andalso (be.Items( 0 ).Code = TKBIND_ERR_NOTDATE), be.Text( ) )
    be.Clear( )
    tkMaskEdit_SetMask( w, TKMASK_TIME, "hh:nn" )
    tkMaskEdit_SetBindText( w, "14:30:00" )
    tkTest_Check( "TIME bind text", (TextOf( w ) = "14:30") andalso (tkMaskEdit_GetBindText( w ) = "14:30:00") )
    tkMaskEdit_SetMask( w, TKMASK_DATETIME, "yyyy-mm-dd hh:nn" )
    tkMaskEdit_SetBindText( w, "2026-12-25T14:30:00" )
    tkTest_Check( "DATETIME bind text", (TextOf( w ) = "2026-12-25 14:30") andalso (tkMaskEdit_GetBindText( w ) = "2026-12-25T14:30:00"), _
        tkMaskEdit_GetBindText( w ) )
    tkMaskEdit_SetBindText( w, "2027-01-02" )
    tkTest_Check( "... a date alone is that day at 00:00", TextOf( w ) = "2027-01-02 00:00", TextOf( w ) )
    tkMaskEdit_SetMask( w, TKMASK_FIXED, "000" )

    ' ---- colours are the field's -----------------------------------------------------------------
    dim as TKMASKEDIT_COLORS c1, c2
    tkMaskEdit_GetColors( w, @c1 )
    tkTextBox_GetColors( e, @c2 )
    tkTest_Check( "colours are the field's", (c1.BackColor = c2.BackColor) andalso (c1.FocusBorderColor = c2.FocusBorderColor) )
    dim as TKTHEME_COLORS th = tkTheme_Of( w )
    tkTest_Check( "ThemeColors is tkTextBox's", tkMaskEdit_ThemeColors( th ).ErrorColor = tkTextBox_ThemeColors( th ).ErrorColor )

    tkHost_Destroy( h )
end sub

' ==========================================================================================
if tkTest_Init() = false then end 99
RunPass( 1.0 )
RunPass( 1.75 )
dim as int32 nFail = tkTest_Report( "tkMaskEdit" )
tkTest_Quit()
end nFail
