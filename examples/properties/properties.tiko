'' properties.tiko -- a tour of tiko's properties, one feature per section.
''
''   tiko examples/properties/properties.tiko
''   examples/properties/properties
''
''  1  the classic form: a getter and a setter, defined one by one
''  2  auto-properties: get, set / get, private set / get (init-only) / get, init
''  3  static auto-properties
''  4  property blocks: one definition, a get section and a set section, 'value'
''  5  any number of indices, in a block too
''  6  static properties written by hand
''  7  properties in a namespace
''  8  combination operators and swap
''  9  a property passed byref is written back through its setter
'' 10  a UDT property, assigned a type<> literal
'' 11  a generic type: auto-properties and field initialisers per instance
'' 12  a property through an interface
'' 13  what the compiler refuses (in comments)


'' ===========================================================================
''  1. THE CLASSIC FORM
''     A getter and a setter share a name. They are declared in the type and
''     defined one by one; the setter can check what it is given, and a
''     property with no setter is read-only.
'' ===========================================================================
type Thermostat
    declare property Celsius( ) as double
    declare property Celsius( byval v as double )
    declare property Fahrenheit( ) as double       '' read-only: computed on demand
private:
    as double c = 20
end type

property Thermostat.Celsius( ) as double
    return c
end property

property Thermostat.Celsius( byval v as double )
    if v < -273.15 then v = -273.15                 '' nothing is colder than absolute zero
    c = v
end property

property Thermostat.Fahrenheit( ) as double
    return c * 9 / 5 + 32
end property


'' ===========================================================================
''  2. AUTO-PROPERTIES
''     A declaration ending in an accessor list is an auto-property. The
''     compiler adds a hidden private field and writes both accessors; an
''     '= value' gives the field its first value.
''
''       get, set            read and written anywhere, like a field
''       get, private set    read anywhere, written only inside the type
''       get                 init-only: written only by the type's constructors
''       get, init           the same, spelled out
'' ===========================================================================
type Person
    declare property Name as ustring get, set
    declare property Age as long = 18 get, set
    declare property Id as long get
    declare property Country as ustring = "Canada" get, init
    declare property Email as ustring get, private set
    declare constructor( byval newId as long, byval newName as ustring )
    declare sub ChangeEmail( byval address as ustring )
end type

constructor Person( byval newId as long, byval newName as ustring )
    Id = newId                                      '' init-only: allowed here, and only here
    Name = newName
    Email = lcase( newName ) & "@example.com"
end constructor

sub Person.ChangeEmail( byval address as ustring )
    if instr( address, "@" ) = 0 then return       '' the type decides what a valid address is
    Email = address                                 '' private set: allowed inside the type
end sub


'' ===========================================================================
''  3. STATIC AUTO-PROPERTIES
''     One value for the whole type, kept in a hidden static member. A static
''     'get' alone is set by its initialiser and nothing else.
'' ===========================================================================
type Widget
    declare static property Made as long get, private set
    declare static property Limit as long = 1000 get
    declare property Serial as long get
    declare constructor( )
end type

constructor Widget( )
    Made += 1                                       '' a private static setter, from inside the type
    Serial = Made
end constructor


'' ===========================================================================
''  4. PROPERTY BLOCKS
''     One definition holds both accessors: a 'get' section and a 'set'
''     section, either of which may be left out. Inside both, 'value' is what
''     crosses the boundary:
''       set: the incoming value (it may be changed, like a byval parameter)
''       get: the result -- returned at 'end get', or at 'exit property'
'' ===========================================================================
type Account
    declare property Balance( ) as double
    declare property Balance( byval v as double )
    declare property Standing( ) as ustring
private:
    as double bal = 0
end type

property Account.Balance as double
get
    value = bal
end get
set
    if value < 0 then
        print "  (refused a negative balance:"; value; ")"
        exit property
    end if
    bal = int( value * 100 + 0.5 ) / 100           '' round to the cent
end set
end property

property Account.Standing as ustring
get
    value = "overdrawn"
    if bal <= 0 then exit property                  '' returns "overdrawn"
    value = "low"
    if bal < 100 then exit property
    value = "healthy"
end get
end property


'' ===========================================================================
''  5. ANY NUMBER OF INDICES
''     An indexed property takes its indices in the parentheses; the setter
''     takes its value after them. Blocks take indices too.
'' ===========================================================================
type Board
    declare property Square( byval row as long, byval col as long ) as ustring
    declare property Square( byval row as long, byval col as long, byval v as ustring )
private:
    as ustring cells( 0 to 2, 0 to 2 )
end type

property Board.Square( byval row as long, byval col as long ) as ustring
get
    value = cells( row, col )
    if len( value ) = 0 then value = "."            '' an empty square reads as '.'
end get
set
    cells( row, col ) = ucase( value )
end set
end property


'' ===========================================================================
''  6. STATIC PROPERTIES WRITTEN BY HAND
''     No 'this': the property belongs to the type. Use it as Type.Name,
''     through any object, or by its bare name inside the type.
'' ===========================================================================
type Logger
    declare property Name as ustring = "app" get, set     '' one per logger
    declare static property Level( ) as long          '' one for them all
    declare static property Level( byval v as long )
    declare sub Message( byval lvl as long, byval msg as ustring )
private:
    static as long current
end type

dim as long Logger.current = 1

property Logger.Level( ) as long
    return current
end property

property Logger.Level( byval v as long )
    if v < 0 then v = 0
    if v > 3 then v = 3
    current = v
end property

sub Logger.Message( byval lvl as long, byval msg as ustring )
    if lvl <= Level then print "  ["; Name; ""; lvl; "] "; msg   '' bare names, inside the type
end sub


'' ===========================================================================
''  7. PROPERTIES IN A NAMESPACE
''     A namespace (or the module itself) may declare a property too. It has
''     no 'this': use it as Namespace.Name, or bare inside the namespace.
'' ===========================================================================
namespace Audio
    dim as long volumeLevel = 5
    declare property Volume( ) as long
    declare property Volume( byval v as long )
end namespace

property Audio.Volume( ) as long
    return volumeLevel
end property

property Audio.Volume( byval v as long )
    volumeLevel = iif( v < 0, 0, iif( v > 10, 10, v ) )
end property


'' ===========================================================================
''  9. (helpers for section 9)
'' ===========================================================================
sub Twice( byref n as long )
    n *= 2
end sub

sub Shout( byref s as ustring )
    s = ucase( s ) & "!"
end sub

sub Inspect( byref n as const long )                  '' const: never written back
    print "  peeked at"; n
end sub


'' ===========================================================================
'' 10. A UDT PROPERTY
'' ===========================================================================
type Point2
    as long x, y
end type

type Sprite
    declare property Position as Point2 get, set
    declare property Visible as boolean = true get, set
end type


'' ===========================================================================
'' 11. A GENERIC TYPE
''     Each instance gets its own field initialisers and its own auto-property
''     values: sizeof( T ) below is worked out once per instance.
'' ===========================================================================
type Buffer( of T )
    declare property Capacity as long = 4 get, set
    declare property ItemBytes as long = sizeof( T ) get
    declare property TotalBytes( ) as long
end type

property Buffer( of T ).TotalBytes( ) as long
    return Capacity * ItemBytes
end property


'' ===========================================================================
'' 12. A PROPERTY THROUGH AN INTERFACE
''     An interface declares properties like methods; a class maps its own
''     properties onto them, under any name.
'' ===========================================================================
interface IShape
    declare property Area( ) as double
    declare property Label( ) as ustring
end interface

class Circle
    implements IShape
    declare property Radius as double = 1 get, set
    declare property Area( ) as double implements IShape.Area
    declare property Label( ) as ustring implements IShape.Label
end class

property Circle.Area( ) as double
    return 3.14159265 * Radius * Radius
end property

property Circle.Label( ) as ustring
    return "circle r=" & Radius
end property

class Square
    implements IShape
    declare property Side as double = 1 get, set
    declare property SqArea( ) as double implements IShape.Area
    declare property Label( ) as ustring implements IShape.Label
end class

property Square.SqArea( ) as double
    return Side * Side
end property

property Square.Label( ) as ustring
    return "square s=" & Side
end property

sub Describe( byval s as IShape )
    print "  "; s.Label; " has area"; s.Area
end sub


'' ===========================================================================
''  THE TOUR
'' ===========================================================================

print "1. classic"
dim as Thermostat t
print "  "; t.Celsius; " C ="; t.Fahrenheit; " F"
t.Celsius = 100
print "  "; t.Celsius; " C ="; t.Fahrenheit; " F"
t.Celsius = -500
print "  clamped to"; t.Celsius

print "2. auto-properties"
dim as Person p = Person( 7, "Ada" )
print "  "; p.Name; ", id"; p.Id; ", age"; p.Age; ", "; p.Country; ", "; p.Email
p.Age = 36
p.ChangeEmail( "not an address" )                   '' refused by the type
p.ChangeEmail( "ada@engines.org" )
print "  "; p.Name; ", age"; p.Age; ", "; p.Email

print "3. static auto-properties"
print "  made"; Widget.Made; " of"; Widget.Limit
dim as Widget w1, w2, w3
print "  made"; Widget.Made; " of"; Widget.Limit; ", w3 is serial"; w3.Serial
print "  through an object:"; w1.Made

print "4. property blocks"
dim as Account acct
print "  "; acct.Balance; " -> "; acct.Standing
acct.Balance = 42.678
print "  "; acct.Balance; " -> "; acct.Standing
acct.Balance = -5
acct.Balance = 250
print "  "; acct.Balance; " -> "; acct.Standing

print "5. indices"
dim as Board b
b.Square( 0, 0 ) = "x"
b.Square( 1, 1 ) = "o"
b.Square( 2, 2 ) = "x"
for r as long = 0 to 2
    print "  ";
    for c as long = 0 to 2
        print b.Square( r, c ); " ";
    next
    print
next

print "6. static properties"
dim as Logger net, disk
net.Name = "net" : disk.Name = "disk"
Logger.Level = 2                                    '' through the type...
net.Message( 1, "shown" )
disk.Message( 3, "hidden" )
disk.Level = 99                                     '' ...or through any object: the same value
print "  level clamped to"; net.Level

print "7. namespace properties"
Audio.Volume = 8
print "  volume"; Audio.Volume
Audio.Volume = 25
print "  volume"; Audio.Volume

print "8. combination operators and swap"
t.Celsius = 20
t.Celsius += 1.5                                    '' get, add, set
print "  "; t.Celsius
p.Name &= " Lovelace"                               '' a string property: &= and +=
print "  "; p.Name
p.Age -= 1
print "  age"; p.Age
dim as Thermostat t2
t2.Celsius = 5
swap t.Celsius, t2.Celsius                          '' two getters, then two setters
print "  swapped:"; t.Celsius; t2.Celsius

print "9. byref write-back"
Twice( p.Age )                                      '' getter -> temporary -> Twice -> setter
print "  age doubled:"; p.Age
Shout( p.Name )
print "  "; p.Name
Twice( p.Id )                                       '' init-only outside its constructors: not written back
print "  id still"; p.Id
Inspect( p.Age )                                      '' a const byref parameter: nothing to write back

print "10. a UDT property"
dim as Sprite sp
sp.Position = type<Point2>( 3, 4 )
print "  at"; sp.Position.x; ","; sp.Position.y; ", visible: "; sp.Visible
sp.Visible = false
print "  visible: "; sp.Visible

print "11. a generic type"
dim as Buffer( of byte ) small
dim as Buffer( of double ) wide
wide.Capacity = 10
print "  byte buffer:  "; small.Capacity; " x"; small.ItemBytes; " ="; small.TotalBytes; " bytes"
print "  double buffer:"; wide.Capacity; " x"; wide.ItemBytes; " ="; wide.TotalBytes; " bytes"

print "12. through an interface"
dim as Circle ci
ci.Radius = 2
dim as Square sq
sq.Side = 3
Describe( @ci )
Describe( @sq )


'' ===========================================================================
'' 13. WHAT THE COMPILER REFUSES
''     Each line below, uncommented, stops the build with the error shown.
'' ===========================================================================
'' p.Id = 8                                 '' TKO0596: init-only, only a constructor of 'Person' may assign it
'' p.Email = "x@y.z"                        '' TKO0625: the setter is private to Person
'' Widget.Made = 0                          '' TKO0625: the setter is private to Widget
'' Widget.Limit = 5                         '' TKO0590: a static init-only property: only its initialiser sets it
'' t.Fahrenheit = 50                        '' TKO0680: no setter, Fahrenheit is read-only
''
'' property Person.Age( ) as long           '' TKO0594: an auto-property's accessors are synthesised,
''     return 0                             ''          they cannot be written by hand
'' end property
