'' cimportverify.ti -- the imported records' layout, tiko's against clang's. D16 §3.
''
'' A binding is text, and the text says what C said -- members, order, 'field = N' -- but
'' not where each member lands: tiko lays it out. The two agree for nearly every record
'' and not for all, and a record laid out wrongly does not fail, it reads its neighbour's
'' bytes. So the binding is laid out here with tiko's own frontend, and every record is
'' compared with the layout clang wrote to the manifest.

#pragma once

#include once "tko.ti"
#include once "driver/driver.ti"

namespace Tko.CImportDriver

'' Lays 'text' out and compares it with 'manifest' ("record <name> <size> <align>" /
'' "  field <name> <bit> <width>"). Every record that disagrees is pushed to 'badName'
'' with the difference in 'badWhy'. False when the binding did not compile at all -- a
'' bug in the importer, reported where the binding failed.
declare function VerifyLayout _
    ( byref ctx as Tko.CompilerContext, byref text as string, byref manifest as string, _
      byref badName as Tko.StrVec, byref badWhy as Tko.StrVec ) as boolean

end namespace

#include once "cimport/import.ti"

namespace Tko.CImportDriver

'' IMPORT, CHECK, REFUSE, IMPORT AGAIN -- '-cimport' and '#cinclude' alike. Every record
'' is laid out by tiko and compared with clang's layout; one that differs is refused with
'' the difference in the ledger, and the header imported again, so what held it by value
'' goes with it. 'prefix' is the text of the bindings a delta import builds on, which the
'' check has to see for the new one to compile. Returns 0 imported, CImportRun's rc when
'' the import failed, 5 when a binding did not compile (an importer bug; the errors are
'' already reported against it).
declare function ImportChecked _
    ( byref ctx as Tko.CompilerContext, byref api as Tko.CImport.ClangApi, _
      byref io as Tko.CImport.CImportOptions, byref res as Tko.CImport.CImportResult, _
      byref prefix as string ) as long

end namespace
