'' driver.ti -- pipeline orchestration.
''
'' The driver owns the CompilerContext chain (docs/plan/01 section 3) and is the only
'' module permitted to spawn processes, read the environment, or touch the filesystem
'' outside SourceManager.
''
'' Phase 2 status: the chain is built, inputs are loaded and diagnosed, and the
'' pipeline stops there. Every later phase adds one step to Run( ) and nothing else
'' about this module changes shape.

#ifndef __TKO_DRIVER_BI__
#define __TKO_DRIVER_BI__

#include once "tko.ti"
#include once "driver/options.ti"
#include once "diag/engine.ti"
#include once "source/manager.ti"
#include once "support/intern.ti"
#include once "lexer/lexer.ti"
#include once "types/type.ti"
#include once "driver/phasetime.ti"
#include once "driver/objqueue.ti"

namespace Tko

    '' THE UNIT BEING COMPILED (review ARCH-05, LATER-PLAN G step 1). CompilerContext holds
    '' three kinds of state, and only these fields are the CURRENT UNIT's -- written as a unit
    '' starts, read while it compiles, and meaningless between units:
    ''
    ''   process  names, sources, diags, options (as parsed), keywords, types, toolErrors,
    ''            the build graph (iface*, pkg*, modObjPaths, importsBuilt), scan, build,
    ''            timing, objq, cinclude
    ''   caches   ppLits + ppLexed (the lexed headers every unit shares), ifaceIndex /
    ''            ifaceAdjFirst / ifaceAdjTo (the graph's index, rebuilt with it)
    ''   unit     this type, ctx.unit
    ''
    '' 'link.threadSafe' (LinkState, below) is written as units compile, and is NOT a
    '' unit field: one unit making a thread makes the whole LINK threaded, and __FB_MT__ is -1
    '' from that call on and in every unit compiled AFTER it -- fbc-modern 1.20 does exactly that
    '' (measured 2026-10-24, 'print __FB_MT__': 'fbc a.bas b.bas' with the thread in a gives a
    '' and b -1, 'fbc b.bas a.bas' gives b 0; tests/codegen/mt-order-*-run.test), so it is
    '' process state a unit discovers.
    type UnitState
        '' A MODULE UNIT BEING COMPILED (ADR 0017): its chain ('acme.net.http'), its name
        '' ('http'), and its files in order. modFileCount = 0 for a classic compile.
        as string                 modChain
        as string                 modName
        as int32                   modFileCount
        as FileIdVec              modFiles
        '' ...and its PACKAGE: the name, and the root its relative imports stay inside.
        as string                 modPkgName
        as string                 modPkgRoot
        '' ...and the link mode the program's '#import ... link' chose for it (RFC-0002 V4-V6):
        '' 0 none, else Tko.PP_LINK_STATIC / PP_LINK_DYNAMIC -- TIKO_LINK_STATIC or
        '' TIKO_LINK_DYNAMIC in its unit, and a line of its cache key.
        as int32                  modLinkMode
        as FileIdVec              unitFilesRead
        as StrVec                 unitProbesMissed   '' include candidates that were absent
        as boolean                unitThreadRtl
        as boolean                unitUsesClock      '' expanded __DATE__ / __TIME__: never stored
    end type

    '' WHAT THE UNITS ASK OF THE LINK (review ARCH-05, LATER-PLAN G step 2): process state the
    '' units DISCOVER as they compile, gathered for the one link -- not options, which are what
    '' the command line said and are not written once it is parsed. fbc gathers the same way:
    '' every unit's '#inclib' reaches the link, and one unit's thread call makes it threaded.
    type LinkState
        '' '#libpath', in source order -- the SECOND of options' three search lists.
        as StrVec  pragmaLibPaths
        as StrVec  pragmaLibs        '' '#inclib', and 'declare ... lib "name"'
        '' '#foreignlib', already resolved to exact files. Named as FILES on the
        '' link line rather than through '-l', which is the point of the feature:
        '' the binding said which file, so the linker does no searching of its own.
        as StrVec  pragmaLibFiles
        '' A unit made a thread (PpNoteThreaded, Mir.UsesThreadRtl), or an input object or a
        '' cached module asked for -mt. LinkThreadSafe( ctx ) adds the command line's '-mt'.
        as boolean threadSafe
    end type

    '' One per tiko-lang process invocation. Nothing in the compiler is global; everything
    '' hangs off this, which is what makes parallel compilation possible later and
    '' in-process fuzzing possible now.
    type CompilerContext
        as Interner          names
        as SourceManager     sources
        as DiagnosticEngine  diags
        as DriverOptions     options
        as LinkState         link
        as KeywordMap        keywords
        as TypeContext       types
        '' How many of diags' errors are TOOLCHAIN failures (driver.tiko, ToolFail_). The
        '' exit code tells the two apart -- 1 for the program, 3/4/5 for the machine --
        '' and 'the engine holds an error' no longer can, now that both are diagnostics.
        as int32              toolErrors

        '' SHARED BY EVERY COMPILATION UNIT OF THIS INVOCATION: the lexed token vectors,
        '' and the literal pool their tokens index. A header included by all 92 of
        '' tiko-lang's own modules was lexed 92 times when the cache lived on the
        '' preprocessor's engine, which is per unit -- 29.4 MB of 34.8 MB lexed was a
        '' file some earlier unit had already lexed. The pool has to travel with the
        '' cache: MergeLiterals rewrites a token's literal index IN THE CACHED VECTOR,
        '' so the tokens are bound to whichever pool was current when they were lexed.
        '' See PpConfig.sharedLits.
        as LiteralVec             ppLits
        as containers.Array( of any ptr ) ppLexed
        '' '#cinclude's session -- libclang and this run's bindings (cinclude.tiko), made
        '' at the first #cinclude and freed with the context.
        as any ptr                cinclude
        as UnitState              unit         '' the unit being compiled -- UnitState above
        '' THE MODULES OF THE BUILD (src/driver/modiface.tiko), by graph node: each one's
        '' chain, its interface once it has been compiled (FILE_NONE until then), and the
        '' import edges between them; and the roots' package root, where a root's import is
        '' resolved from.
        as StrVec                 ifaceChains
        as StrVec                 ifaceDirs
        '' ...each one's interface text -- what its cache entry records (modcache.tiko), with
        '' the unit's own read files and thread use (UnitState).
        as StrVec                 ifaceTexts
        as FileIdVec              ifaceFiles
        '' ...and its public headers apart, '<chain>.pub.tki', or FILE_NONE: read only where
        '' the import, a 'public' re-export or another interface's '' uses wants them.
        as FileIdVec              ifacePubFiles
        '' '-c' OF A PROGRAM THAT IMPORTS (RFC-0005 §6): each module's object, written as
        '' <chain>.o beside the output, absolute -- what the roots' '.fbctinf' records name.
        as StrVec                 modObjPaths
        '' THE PACKAGES OF THE BUILD (src/driver/modresolve.tiko; RFC-0007 §1, §4), as they are
        '' found: each name once, with its root; a manifest's dependencies and [defines],
        '' flattened and keyed by the package's index; and the root manifest's say over its
        '' dependencies' defines.
        as StrVec                 pkgNames
        as StrVec                 pkgRoots
        as StrVec                 pkgDepOwner
        as StrVec                 pkgDepName
        as StrVec                 pkgDepPath
        as StrVec                 pkgDefOwner
        as StrVec                 pkgDefText
        as StrVec                 pkgDdDep
        as StrVec                 pkgDdText
        '' ...and each manifest's [vendor.<module>] links (tiko-vendor RFC-0002 V7, V10): the
        '' package's index, the module's path below it, its modes as "|static|dynamic|".
        as StrVec                 pkgLinkOwner
        as StrVec                 pkgLinkMod
        as StrVec                 pkgLinkModes
        '' ...and [vendor.<module>] runtime: the package's index, the module's path below it, its
        '' files joined by LF, as written.
        as StrVec                 pkgRtOwner
        as StrVec                 pkgRtMod
        as StrVec                 pkgRtFiles
        '' THE FILES THE PROGRAM'S MODULES NEED AT RUN TIME, each one's path: found from the
        '' module graph by BuildImports, so a module the cache supplies has them too, and
        '' copied beside the output after the link (CopyVendorLibs).
        as StrVec                 runtimeFiles
        as boolean                pkgRootKnown
        as string                 pkgRootName
        as string                 pkgRootDir
        '' ...and the build order, as indices into ifaceChains: what modules initialise in.
        as FileIdVec              ifaceOrder
        as FileIdVec              ifaceEdgeFrom
        as FileIdVec              ifaceEdgeTo
        '' ...INDEXED, with them and nowhere else (IndexInterfaces, modiface.tiko): each chain's
        '' index, and each module's edge targets in edge order, ifaceAdjTo[ifaceAdjFirst[n] ..
        '' ifaceAdjFirst[n + 1] - 1]. Every closure, cache key and init order scanned the whole
        '' chain list or edge list per module.
        as containers.Map( of string, int32 ) ifaceIndex
        as FileIdVec              ifaceAdjFirst
        as FileIdVec              ifaceAdjTo
        as string                 ifaceRootDir
        '' THE MODULES THE ROOTS IMPORT ARE BUILT (src/driver/modbuild.tiko), so a root's
        '' '#import' is not TKO0992.
        as boolean                importsBuilt
        '' THE EDITOR SCAN'S RESULT (src/driver/scan.ti, a Tko.Scan.ScanResult), when this
        '' run is one: every unit then stops after Check and is harvested into it. 0 for
        '' every other run. An 'any ptr' so this header need not include the scan's.
        as any ptr                scan
        '' THE 'tiko build' LISTENING, when this run is one (src/build/events.ti, a
        '' Tko.Build.Observer): told each unit, the artefact and the totals. 0 otherwise.
        as any ptr                build
        '' WHERE THE TIME WENT, phase by phase (driver/phasetime.ti); printed by '--time-passes'.
        as PhaseTimes             timing
        '' THE clang -c RUNS STARTED AND NOT YET WAITED FOR (driver/objqueue.ti).
        as ObjQueue               objq

        declare constructor( )
        declare destructor( )
    end type

    '' Does the link take the thread-safe runtime -- and is __FB_MT__ -1 for the next unit?
    private function LinkThreadSafe( byref ctx as CompilerContext ) as boolean
        return ctx.options.threadSafe orelse ctx.link.threadSafe
    end function

end namespace

namespace Tko.Driver

    '' Returns a process exit code from Tko.ExitCode.
    '' 'restartDepth' IS THE '#cmdline' RESTART and nothing else. Zero is the run the
    '' user asked for; one is the re-run with the arguments the SOURCE asked for
    '' appended. It is a parameter rather than a flag inside Run( ) because the
    '' restart IS a second Run( ) -- main.tiko stays one line, and the whole compiler
    '' remains reachable in-process.
    '' 'scanOut', when given, is a Tko.Scan.ScanResult the run fills instead of printing --
    '' how parser.dll (src/api) drives a scan through the same command line as a CLI run.
    '' 'buildOut', when given, is the Tko.Build.Observer of a 'tiko build' (src/build).
    declare function Run _
        ( byref args as Tko.StrVec, byval restartDepth as int32 = 0, _
          byval scanOut as any ptr = nullptr, byval buildOut as any ptr = nullptr ) as int32

    '' The output a run with these options writes when no '-o' names one, by fbc's rule.
    declare function DefaultOutput( byref o as Tko.DriverOptions ) as string

end namespace

#endif
