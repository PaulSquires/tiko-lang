'' manifest.ti -- a package's tiko.toml (ADR 0017; RFC-0007 §2). See manifest.tiko.

#pragma once

#include once "tko.ti"
#include once "driver/driver.ti"

namespace Tko.Modules

type Manifest
    as string  dir_          '' the directory holding tiko.toml
    as string  name          '' [package] name, lower case
    '' [dependencies] x = { path = "..." }: the key, and the path resolved against dir_.
    as StrVec  depNames
    as StrVec  depPaths
    '' [defines], as NAME=value, the form '-d' takes.
    as StrVec  defines
    '' [dependencies.x.defines]: honoured only in the root's manifest. ddDep[k] is x.
    as StrVec  ddDep
    as StrVec  ddDefine
    '' [target.<name>], [target.<name>.defines], [target.<name>.<os>] and [profile.<name>]
    '' (tiko-build RFC-0001 §5): what to build, read only by 'tiko build' (src/build). Kept as
    '' records -- the table's name, the key, the value, an array's elements joined by LF; a
    '' define is key 'define', value NAME=value; a key of an OS table is '<key>@<os>' -- in
    '' file order, each name once in *Names.
    as StrVec  targetNames
    as StrVec  tgtName
    as StrVec  tgtKey
    as StrVec  tgtVal
    as StrVec  profileNames
    as StrVec  prfName
    as StrVec  prfKey
    as StrVec  prfVal
    '' [vendor.<module>] links = ["static", "dynamic"] (tiko-vendor RFC-0002 V7, V10): the
    '' link modes a module of this package ships, which '#import ... link' may ask for. The
    '' module's path below the package, dotted, and its modes as "|static|dynamic|".
    as StrVec  vendorMods
    as StrVec  vendorLinks
end type

'' READ dir_/tiko.toml. False with the reason reported (TKO0144) when it is not the subset
'' RFC-0007 §2 allows; when the file is not there, false and nothing reported -- ask
'' HasManifest first.
declare function HasManifest( byref dir_ as string ) as boolean
declare function LoadManifest _
    ( byref ctx as Tko.CompilerContext, byref dir_ as string, byref m as Manifest ) as boolean

end namespace
