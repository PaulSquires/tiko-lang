'' winmanifest.ti -- the manifest every Windows executable gets.
''
'' A PROGRAM WITH NO MANIFEST IS RUN IN COMPATIBILITY MODE. Windows then reports an older version
'' to it, may decide from its name alone ('setup', 'install', 'update') that it is an installer
'' and ask for elevation, and scales its windows as bitmaps on a high-DPI display unless the
'' program itself asks otherwise. So the link of a Windows EXECUTABLE adds one (the author's
'' decision, 2026-11-13): run as the invoker, supported on Windows 7 to 11, per-monitor DPI aware
'' (V2, with 'true/pm' for the systems before it).
''
'' THE PROGRAM'S OWN WINS. A '.res' of the link that already holds an RT_MANIFEST (type 24) --
'' an '.rc' with '1 24 "app.manifest"', as the Win32 examples have -- means none is added: two
'' would be a duplicate resource at the link. Not for a DLL (whose manifest is resource 2 and
'' optional) nor a static library, and nothing off Windows.
''
'' WRITTEN AS A '.res' DIRECTLY, not through llvm-rc: the format is two fixed headers and the
'' XML, and an executable that needs no resource compiler should not start needing one.

#pragma once

#include once "tko.ti"
#include once "types/type.ti"
#include once "driver/options.ti"

namespace Tko
namespace WinManifest

    '' The XML the default manifest holds.
    declare function DefaultXml( ) as string

    '' Does the '.res' at path hold a resource of type RT_MANIFEST (24)? FALSE for a file that
    '' cannot be read or is not a resource file.
    declare function ResHasManifest( byref path as string ) as boolean

    '' Writes the default manifest as a '.res' at path. FALSE when it cannot be written.
    declare function WriteDefaultRes( byref path as string ) as boolean

    '' The link's part: for a Windows executable whose '.res' inputs hold no manifest, the
    '' default one is written beside the output, added to objs and to temps (deleted after the
    '' link). Returns "" when done or not needed, else the path that could not be written.
    declare function AddToLink( byref objs as StrVec, byref temps as StrVec, byref outputPath as string, _
                                byval target as TargetId, byval outKind as OutputKind ) as string

end namespace
end namespace
