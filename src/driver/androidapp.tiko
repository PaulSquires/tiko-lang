'' androidapp.tiko -- 'tiko -app': the APK. See androidapp.ti for the pipeline; every step and
'' every choice in it was measured first by hand (docs/tiko-android A4, probes/a4/apkprobe.sh).

#import "std/containers"
#import "std/fs"
#include once "driver/androidapp.ti"
#include once "driver/modresolve.ti"
#include once "codegen/toolchain.ti"
#include once "support/spawn.ti"
#include once "types/type.ti"

namespace Tko.AndroidApp

#ifdef __FB_WIN32__
    const EXE_ = ".exe"
#else
    const EXE_ = ""
#endif

'' THE APP'S FIXED FACTS (D-A4-3): Android 10 and up, as the NDK link's triple says
'' (aarch64/x86_64-linux-android29); built against Android 16's API.
const MIN_SDK_ = "29"
const TARGET_SDK_ = "36"

private function Q_( byref s as string ) as string
    return Tko.Spawn.QuoteArg( s )
end function

private function Slash_( byval p as string ) as string
    for i as int32 = 0 to len( p ) - 1
        if p[i] = asc( "\" ) then p[i] = asc( "/" )
    next
    return p
end function

private function Abi_( byval t as Tko.TargetId ) as string
    select case t
    case Tko.TARGET_ANDROID_X86_64 : return "x86_64"
    case Tko.TARGET_ANDROID_ARM64  : return "arm64-v8a"
    end select
    return ""
end function

private function Stage_( byref ctx as Tko.CompilerContext ) as string
    return Slash_( ctx.options.outputPath ) & ".stage"
end function

function LinkPath( byref ctx as Tko.CompilerContext ) as string
    if ctx.options.app = false then return ""
    return Slash_( ctx.options.outputPath ) & ".libmain.so"
end function

'' The subdirectory of 'root' with the highest version that holds 'need': build-tools/<ver>,
'' platforms/android-<api>.
private function Newest_( byref root as string, byref need as string ) as string
    dim as string best, bestKey
    dim as string d = dir( root & "/*", &h10 )
    while len( d ) > 0
        if (d <> ".") andalso (d <> "..") andalso fs.IsFile( root & "/" & d & "/" & need ) then
            dim as string v = d
            if left( v, 8 ) = "android-" then v = mid( v, 9 )
            dim as string k = Tko.Codegen.AndroidVersionKey( v )
            if k > bestKey then
                bestKey = k
                best = root & "/" & d
            end if
        end if
        d = dir( )
    wend
    return best
end function

private function Sdk_( byref why as string ) as string
    dim as string sdks( 0 to 2 )
    Tko.Codegen.AndroidSdkCandidates( sdks() )
    for i as int32 = 0 to 2
        if (len( sdks( i ) ) > 0) andalso fs.IsDir( sdks( i ) & "/build-tools" ) then return sdks( i )
    next
    why = "no Android SDK with build-tools -- set ANDROID_HOME to one; it needs " & _
          """build-tools;<version>"" and ""platforms;android-" & TARGET_SDK_ & """ (sdkmanager)"
    return ""
end function

'' A JDK: jar, keytool and the java that runs apksigner.jar. JAVA_HOME, else Android Studio's own.
private function Jdk_( byref why as string ) as string
    dim as string cands( 0 to 1 )
    cands( 0 ) = Slash_( environ( "JAVA_HOME" ) )
    #if defined( __FB_WIN32__ )
        if len( environ( "ProgramFiles" ) ) > 0 then cands( 1 ) = Slash_( environ( "ProgramFiles" ) ) & "/Android/Android Studio/jbr"
    #elseif defined( __FB_DARWIN__ )
        cands( 1 ) = "/Applications/Android Studio.app/Contents/jbr/Contents/Home"
    #else
        cands( 1 ) = "/opt/android-studio/jbr"
    #endif
    for i as int32 = 0 to 1
        dim as string j = cands( i )
        while (len( j ) > 1) andalso (right( j, 1 ) = "/")
            j = left( j, len( j ) - 1 )
        wend
        if (len( j ) > 0) andalso fs.IsFile( j & "/bin/jar" & EXE_ ) andalso fs.IsFile( j & "/bin/keytool" & EXE_ ) then return j
    next
    why = "no JDK -- set JAVA_HOME to one (17 or later): jar, keytool and apksigner are Java"
    return ""
end function

'' THE DEBUG KEY, where Android Studio keeps it: ANDROID_USER_HOME, else ~/.android.
private function Keystore_( ) as string
    dim as string h = Slash_( environ( "ANDROID_USER_HOME" ) )
    if len( h ) = 0 then
        #ifdef __FB_WIN32__
            h = Slash_( environ( "USERPROFILE" ) ) & "/.android"
        #else
            h = environ( "HOME" ) & "/.android"
        #endif
    end if
    return h & "/debug.keystore"
end function

'' The output's name without its directory or extension: 'demo' for 'out/demo.apk'.
private function Stem_( byref p as string ) as string
    dim as string s = mid( Slash_( p ), instrrev( Slash_( p ), "/" ) + 1 )
    dim as int32 dot = instrrev( s, "." )
    if dot > 1 then s = left( s, dot - 1 )
    return s
end function

'' A Java package segment from a name: lower case, [a-z0-9_], starting with a letter.
private function Segment_( byref s as string ) as string
    dim as string r = lcase( s )
    for i as int32 = 0 to len( r ) - 1
        dim as uint8 ch = r[i]
        if ((ch < asc( "a" )) orelse (ch > asc( "z" ))) andalso _
           ((ch < asc( "0" )) orelse (ch > asc( "9" ))) then r[i] = asc( "_" )
    next
    if (len( r ) = 0) orelse (r[0] < asc( "a" )) orelse (r[0] > asc( "z" )) then r = "app" & r
    return r
end function

'' An application id as Android takes it: two or more dot-separated segments, each a letter
'' followed by letters, digits or '_'.
private function IdOk_( byref id as string ) as boolean
    dim as int32 segs = 1
    dim as boolean atStart = true
    for i as int32 = 0 to len( id ) - 1
        dim as uint8 ch = id[i]
        dim as boolean letter = ((ch >= asc( "a" )) andalso (ch <= asc( "z" ))) orelse _
                                ((ch >= asc( "A" )) andalso (ch <= asc( "Z" )))
        if ch = asc( "." ) then
            if atStart then return false
            segs += 1
            atStart = true
        elseif atStart then
            if letter = false then return false
            atStart = false
        elseif (letter = false) andalso (ch <> asc( "_" )) andalso _
               ((ch < asc( "0" )) orelse (ch > asc( "9" ))) then
            return false
        end if
    next
    return (segs >= 2) andalso (atStart = false)
end function

private function Xml_( byref s as string ) as string
    dim as string r
    for i as int32 = 0 to len( s ) - 1
        select case s[i]
        case asc( "&" ) : r &= "&amp;"
        case asc( "<" ) : r &= "&lt;"
        case asc( ">" ) : r &= "&gt;"
        case asc( """" ) : r &= "&quot;"
        case asc( "'" ) : r &= "&apos;"
        case else : r &= chr( s[i] )
        end select
    next
    return r
end function

'' SDL's own manifest (android-project), less what an app built here cannot use: TikoActivity
'' (SDL static in libmain.so, D-A4-2), the system's fullscreen theme and default icon rather than
'' resources (SDL's AppTheme is that theme), and extractNativeLibs=false -- the .so is stored
'' and 16 KB-aligned in the APK and mapped from it.
private function Manifest_( byref id as string, byref label as string ) as string
    dim as string nl = chr( 10 )
    return "<?xml version=""1.0"" encoding=""utf-8""?>" & nl & _
        "<manifest xmlns:android=""http://schemas.android.com/apk/res/android""" & nl & _
        "    package=""" & id & """ android:versionCode=""1"" android:versionName=""1.0"">" & nl & _
        "    <uses-feature android:glEsVersion=""0x00020000"" />" & nl & _
        "    <uses-feature android:name=""android.hardware.touchscreen"" android:required=""false"" />" & nl & _
        "    <application android:label=""" & Xml_( label ) & """ android:icon=""@android:drawable/sym_def_app_icon""" & nl & _
        "        android:theme=""@android:style/Theme.NoTitleBar.Fullscreen"" android:hardwareAccelerated=""true""" & nl & _
        "        android:extractNativeLibs=""false"">" & nl & _
        "        <activity android:name=""org.tiko.app.TikoActivity""" & nl & _
        "            android:label=""" & Xml_( label ) & """ android:alwaysRetainTaskState=""true"" android:launchMode=""singleInstance""" & nl & _
        "            android:configChanges=""layoutDirection|locale|grammaticalGender|fontScale|fontWeightAdjustment|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation""" & nl & _
        "            android:preferMinimalPostProcessing=""true"" android:exported=""true"">" & nl & _
        "            <intent-filter>" & nl & _
        "                <action android:name=""android.intent.action.MAIN"" />" & nl & _
        "                <category android:name=""android.intent.category.LAUNCHER"" />" & nl & _
        "            </intent-filter>" & nl & _
        "        </activity>" & nl & _
        "    </application>" & nl & _
        "</manifest>" & nl
end function

'' One tool, waited for; its output goes where tiko's does. 0 when it succeeded.
private function Run_( byref ctx as Tko.CompilerContext, byref exe as string, byref args as string ) as int32
    if ctx.options.verbose then print Q_( exe ) & " " & args
    return Tko.Spawn.Wait( Tko.Spawn.Start( exe, args ) )
end function

private function Copy_( byref src as string, byref dst as string, byref why as string ) as boolean
    dim as fs.FsResultBool r = fs.CopyFile( src, dst, true )
    if r.IsOk( ) then return true
    why = "cannot copy '" & src & "' to '" & dst & "'"
    return false
end function

private function Package_( byref ctx as Tko.CompilerContext, byref why as string ) as boolean
    dim as string stage = Stage_( ctx )
    dim as string abi = Abi_( ctx.options.target )
    dim as string outApk = Slash_( ctx.options.outputPath )
    fs.RemoveDirAll( stage )
    fs.CreateDirAll( stage & "/lib/" & abi )
    if Copy_( LinkPath( ctx ), stage & "/lib/" & abi & "/libmain.so", why ) = false then return false

    '' WHO THE APP IS: -appid, else org.tiko.<name>; -applabel, else the name.
    dim as string stem = Stem_( outApk )
    dim as string id = ctx.options.appId
    if len( id ) = 0 then id = "org.tiko." & Segment_( stem )
    if IdOk_( id ) = false then
        why = "'" & id & "' is not an application id: two or more segments like 'com.example.game', " & _
              "each a letter then letters, digits or '_'"
        return false
    end if
    dim as string label = ctx.options.appLabel
    if len( label ) = 0 then label = stem
    if (len( ctx.options.appAssets ) > 0) andalso (fs.IsDir( ctx.options.appAssets ) = false) then
        why = "-appassets: '" & ctx.options.appAssets & "' is not a directory"
        return false
    end if

    '' SDL'S JAVA, which only vendor/SDL3 carries: an app is an SDL3 program. Found beside the
    '' SDL3 archive the link took (lib/SDL3_android_<arch>.a -> lib/android/classes.dex).
    dim as string dex
    for each lf as string in ctx.link.pragmaLibFiles
        dim as string cand = Tko.Modules.DirOfFile( Tko.Modules.NormPath( Tko.Modules.AbsPath( lf ) ) ) & "/android/classes.dex"
        if fs.IsFile( cand ) then
            dex = cand
            exit for
        end if
    next
    if len( dex ) = 0 then
        why = "an app is an SDL3 program, and this one does not '#import ""vendor/SDL3""' " & _
              "(or vendor/SDL3 has no lib/android/classes.dex: build/vendorfetch.sh --target " & _
              Tko.TargetName( ctx.options.target ) & ")"
        return false
    end if

    dim as string sdk = Sdk_( why )
    if len( sdk ) = 0 then return false
    dim as string bt = Newest_( sdk & "/build-tools", "lib/apksigner.jar" )
    if (len( bt ) = 0) orelse (fs.IsFile( bt & "/aapt2" & EXE_ ) = false) orelse (fs.IsFile( bt & "/zipalign" & EXE_ ) = false) then
        why = "the SDK at '" & sdk & "' has no build-tools with aapt2, zipalign and apksigner (sdkmanager ""build-tools;<version>"")"
        return false
    end if
    dim as string plat = Newest_( sdk & "/platforms", "android.jar" )
    if len( plat ) = 0 then
        why = "the SDK at '" & sdk & "' has no platform (sdkmanager ""platforms;android-" & TARGET_SDK_ & """)"
        return false
    end if
    dim as string jdk = Jdk_( why )
    if len( jdk ) = 0 then return false

    '' THE STAGE: classes.dex and the manifest beside lib/<abi>/libmain.so; the modules' run-time
    '' files (tkHost's fonts) flat in assets/, where SDL_IOFromFile finds them by name.
    if Copy_( dex, stage & "/classes.dex", why ) = false then return false
    dim as boolean haveAssets = (ctx.runtimeFiles.Count > 0)
    if haveAssets then fs.CreateDirAll( stage & "/assets" )
    for each rf as string in ctx.runtimeFiles
        dim as string src = Tko.Modules.NormPath( Tko.Modules.AbsPath( rf ) )
        if Copy_( src, stage & "/assets/" & mid( src, instrrev( src, "/" ) + 1 ), why ) = false then return false
    next
    dim as int32 fh = freefile
    if open( stage & "/AndroidManifest.xml" for output as #fh ) <> 0 then
        why = "cannot write '" & stage & "/AndroidManifest.xml'"
        return false
    end if
    print #fh, Manifest_( id, label );
    close #fh

    dim as int32 rc
    dim as string args = "link -o " & Q_( stage & "/base.apk" ) & " -I " & Q_( plat & "/android.jar" ) & _
        " --manifest " & Q_( stage & "/AndroidManifest.xml" ) & _
        " --min-sdk-version " & MIN_SDK_ & " --target-sdk-version " & TARGET_SDK_
    if haveAssets then args &= " -A " & Q_( stage & "/assets" )
    if len( ctx.options.appAssets ) > 0 then args &= " -A " & Q_( Slash_( ctx.options.appAssets ) )
    rc = Run_( ctx, bt & "/aapt2" & EXE_, args )
    if rc <> 0 then why = "aapt2 failed (exit " & rc & ")" : return false

    '' STORED (-0): a native library mapped from the APK must not be compressed, and jar's
    '' -C keeps the entry names relative to the stage.
    rc = Run_( ctx, jdk & "/bin/jar" & EXE_, "-u0Mf " & Q_( stage & "/base.apk" ) & _
        " -C " & Q_( stage ) & " classes.dex -C " & Q_( stage ) & " lib/" & abi & "/libmain.so" )
    if rc <> 0 then why = "jar failed (exit " & rc & ")" : return false

    rc = Run_( ctx, bt & "/zipalign" & EXE_, "-P 16 -f 4 " & Q_( stage & "/base.apk" ) & " " & Q_( stage & "/aligned.apk" ) )
    if rc <> 0 then why = "zipalign failed (exit " & rc & ")" : return false

    dim as string ks = Keystore_( )
    if fs.IsFile( ks ) = false then
        fs.CreateDirAll( Tko.Modules.DirOfFile( ks ) )
        rc = Run_( ctx, jdk & "/bin/keytool" & EXE_, "-genkeypair -keystore " & Q_( ks ) & _
            " -storepass android -alias androiddebugkey -keypass android -keyalg RSA -keysize 2048" & _
            " -validity 10000 -dname " & Q_( "CN=Android Debug,O=Android,C=US" ) )
        if rc <> 0 then why = "keytool could not make the debug key '" & ks & "' (exit " & rc & ")" : return false
    end if
    '' NO v4 SIGNATURE: it is a second file (<apk>.idsig) for incremental installs only.
    rc = Run_( ctx, jdk & "/bin/java" & EXE_, "-jar " & Q_( bt & "/lib/apksigner.jar" ) & " sign --ks " & Q_( ks ) & _
        " --ks-pass pass:android --key-pass pass:android --ks-key-alias androiddebugkey" & _
        " --v4-signing-enabled false --out " & Q_( outApk ) & " " & Q_( stage & "/aligned.apk" ) )
    if rc <> 0 then why = "apksigner failed (exit " & rc & ")" : return false
    return true
end function

function Package( byref ctx as Tko.CompilerContext, byref why as string ) as boolean
    dim as boolean ok = Package_( ctx, why )
    if ctx.options.keepTemps = false then
        fs.RemoveDirAll( Stage_( ctx ) )
        fs.RemoveFile( LinkPath( ctx ) )
    end if
    return ok
end function

end namespace
