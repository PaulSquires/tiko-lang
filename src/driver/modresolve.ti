'' modresolve.ti -- where an '#import' path leads (ADR 0017; RFC-0007 §3). See
'' modresolve.tiko.

#pragma once

#include once "tko.ti"
#include once "driver/driver.ti"
#include once "pp/pp.ti"

namespace Tko.Modules

'' WHERE A MODULE IS, and what it is called. Paths are '/'-separated and LEXICAL: a path
'' the user gave relative stays relative, so what the graph prints and what a test's
'' golden holds is the same on every machine.
type ModWhere
    as string dir_       '' the module's directory
    as string chain      '' package name, then the directory path below the package root:
                         '' 'acme.net.http'. Lower case: FreeBASIC names are not cased.
    as string pkgName    '' the first chain component
    as string pkgRoot    '' the package's root directory, which relative imports stay inside
end type

'' THE PACKAGE OF THE ROOT FILES when no manifest names one (RFC-0007 §1): the first
'' root file's directory, called 'main'.
const ANON_PACKAGE = "main"

'' Lexical normalisation: '\' to '/', '.' dropped, '..' applied where it can be.
declare function NormPath( byref p as string ) as string
declare function JoinPath( byref a as string, byref b as string ) as string
declare function DirOfFile( byref p as string ) as string
'' p made absolute against the current directory, and normalised ('/'-separated).
declare function AbsPath( byref p as string ) as string

'' RESOLVE ONE IMPORT, read in a file of the package pkgName rooted at pkgRoot, whose own
'' directory is fromDir. On failure the diagnostic is already reported at rec.loc.
''
'' The search, first hit wins (RFC-0007 §3; sources 2 and 3, the manifest's, are phase P8):
''   1. './' or '../': relative to fromDir, and never outside pkgRoot (TKO0142)
''   4. each -i directory, then each TIKO_PATH entry, holding a directory named S
''   5. the toolchain's pkg/ directory
'' 'std' skips 4: the standard library always comes from the toolchain.
'' THE .bas FILES OF A MODULE DIRECTORY, sorted case-folded so the order is the same on
'' every host.
declare sub ModuleFiles( byref dir_ as string, byref files as Tko.StrVec )

'' WHAT A DIRECTORY GIVEN ON THE COMMAND LINE IS CALLED, for 'tiko -c <dir>' (phase P2). Under
'' a package search root, its path below that root: 'libs/acme/net/http' with '-i libs' is
'' acme.net.http. Under none, a module of the anonymous package: 'main.http'.
declare sub ChainForDir( byref ctx as Tko.CompilerContext, byref dir_ as string, byref outw as ModWhere )

'' THE PACKAGES OF ONE BUILD (RFC-0007): forgotten at the start of each graph.
declare sub SearchPaths( byref ctx as Tko.CompilerContext, byref roots as Tko.StrVec, byref pkg as string )
declare sub ResetPackages( byref ctx as Tko.CompilerContext )

'' THE ROOTS' PACKAGE: the nearest tiko.toml's at or above the first root's directory, else
'' the anonymous 'main' there. False when that manifest is malformed (reported).
declare function RootPackage _
    ( byref ctx as Tko.CompilerContext, byref name_ as string, byref root as string ) as boolean

'' A PACKAGE'S [defines], as NAME=value, with the root manifest's [dependencies.x.defines]
'' over them: what every module of the package is compiled with.
declare sub PackageDefines( byref ctx as Tko.CompilerContext, byref name_ as string, byref outv as Tko.StrVec )
'' A module's [vendor.<module>] links, "|static|dynamic|", or "" (RFC-0002 V7).
declare function LinkModesOf( byref ctx as Tko.CompilerContext, byref name_ as string, byref chain as string ) as string
'' PackageDefines of ctx.unit.modPkgName, and the TIKO_LINK_* of ctx.unit.modLinkMode (RFC-0002 V6).
declare sub ModuleDefines( byref ctx as Tko.CompilerContext, byref outv as Tko.StrVec )
'' A module's [vendor.<module>] runtime: each entry as written, and its path below 'dir_', with
'' a bare library name spelled as the target names a shared library.
declare sub RuntimeFilesOf _
    ( byref ctx as Tko.CompilerContext, byref name_ as string, byref chain as string, _
      byref dir_ as string, byref entries as Tko.StrVec, byref paths as Tko.StrVec )
'' The linked vendor packages' .dll / .so (RFC-0002 V13), and ctx.runtimeFiles, copied beside
'' 'outPath'; false, with the pair that failed, when a copy did.
declare function CopyVendorLibs _
    ( byref ctx as Tko.CompilerContext, byref outPath as string, _
      byref failSrc as string, byref failDst as string ) as boolean

declare function ResolveImport _
    ( byref ctx as Tko.CompilerContext, byref rec as Tko.PpImport, _
      byref fromDir as string, byref pkgName as string, byref pkgRoot as string, _
      byref outw as ModWhere ) as boolean

end namespace
