'' modiface.tiko -- a module's interface, read into the units that import it (ADR 0017;
'' RFC-0002 §2, RFC-0004 §4-5).
''
'' EACH MODULE OF THE BUILD, once compiled, leaves its interface behind as a source file
'' held in memory (tkiemit.tiko writes it). An '#import' then reads that file in where it
'' stands -- and before it the interface of every module it depends on, dependencies
'' first and each once: the interface names its own imports' types by their namespaces,
'' so those have to be declared already.
''
'' THE INTERFACE IS A NAMESPACE, '__tko_mod_acme_net_http', that nothing written in source
'' names. The '#import' binds its alias -- 'http', or what 'as' says -- to the same scope,
'' so 'http.Fetch( )' and 'using http' work as they do for any namespace; and the mangler
'' writes the module's chain where the namespace would go, so the importer's 'Fetch' is
'' the symbol the module defined.
''
'' NOT YET: an alias is the whole unit's rather than its file's (M22), and a name the
'' interface does not call 'public' is found as readily as one it does.

#import "std/containers"
#include once "driver/modiface.ti"
#include once "driver/modresolve.ti"
#include once "driver/tkiemit.ti"
#include once "symbols/modsym.ti"
#include once "support/text.ti"

namespace Tko.Modules

private function InUnit_( byref ctx as Tko.CompilerContext, byval f as Tko.FileId ) as boolean
    for each m as uint32 in ctx.modFiles
        if m = cast( uint32, f ) then return true
    next
    return false
end function

function ImportIndex( byref ctx as Tko.CompilerContext, byref rec as Tko.PpImport ) as int32
    if ctx.ifaceChains.Count = 0 then return -1
    dim as Tko.FileId f = ctx.sources.Decode( rec.loc ).file
    dim as string fromDir = DirOfFile( ctx.sources.PathOf( f ) )
    '' Read from a module's file, in the module's package; from a root, in the roots'.
    dim as string pn, pr
    RootPackage( ctx, pn, pr )
    if InUnit_( ctx, f ) then
        pn = ctx.modPkgName
        pr = ctx.modPkgRoot
    end if
    dim as ModWhere w
    if ResolveImport( ctx, rec, fromDir, pn, pr, w ) = false then return -1
    return ChainIndex( ctx, w.chain )
end function

'' THE GRAPH'S CHAINS ARE DISTINCT (NodeFor_ in modgraph.tiko makes one node per chain), so
'' the first index of a chain, which ImportIndex's scan returned, is the only one -- the
'' scans that kept the last, or every, match found the same. Edges keep their order within
'' a module: Closure_ visits them as its scan of the whole list did.
sub IndexInterfaces( byref ctx as Tko.CompilerContext )
    dim as int32 n = ctx.ifaceChains.Count
    ctx.ifaceIndex.Clear( )
    for i as int32 = 0 to n - 1
        ctx.ifaceIndex.Add( ctx.ifaceChains[i], i )
    next
    ctx.ifaceAdjFirst.Clear( )
    for i as int32 = 0 to n
        ctx.ifaceAdjFirst.Push( 0 )
    next
    for e as int32 = 0 to ctx.ifaceEdgeFrom.Count - 1
        dim as int32 f = cast( int32, ctx.ifaceEdgeFrom[e] )
        if (f >= 0) andalso (f < n) then ctx.ifaceAdjFirst[f + 1] += 1
    next
    for i as int32 = 1 to n
        ctx.ifaceAdjFirst[i] += ctx.ifaceAdjFirst[i - 1]
    next
    dim as Tko.FileIdVec fill
    ctx.ifaceAdjTo.Clear( )
    for i as int32 = 0 to n - 1
        fill.Push( ctx.ifaceAdjFirst[i] )
    next
    for e as int32 = 0 to cast( int32, ctx.ifaceAdjFirst[n] ) - 1
        ctx.ifaceAdjTo.Push( 0 )
    next
    for e as int32 = 0 to ctx.ifaceEdgeFrom.Count - 1
        dim as int32 f = cast( int32, ctx.ifaceEdgeFrom[e] )
        if (f < 0) orelse (f >= n) then continue for
        ctx.ifaceAdjTo[fill[f]] = ctx.ifaceEdgeTo[e]
        fill[f] += 1
    next
end sub

function ChainIndex( byref ctx as Tko.CompilerContext, byref chain as string ) as int32
    dim as int32 at = -1
    if ctx.ifaceIndex.TryGet( chain, at ) then return at
    return -1
end function

'' Module n's interface, after every one it depends on.
private sub Closure_ _
    ( byref ctx as Tko.CompilerContext, byval n as int32, byref seen as containers.Array( of uint8 ), _
      byref order as containers.Array( of int32 ) )
    if seen[n] <> 0 then return
    seen[n] = 1
    for a as int32 = cast( int32, ctx.ifaceAdjFirst[n] ) to cast( int32, ctx.ifaceAdjFirst[n + 1] ) - 1
        Closure_( ctx, cast( int32, ctx.ifaceAdjTo[a] ), seen, order )
    next
    order.Push( n )
end sub

'' The chains module n's interface names on its '' <tag> lines -- the last word of each.
private sub Tagged_( byref ctx as Tko.CompilerContext, byval n as int32, byref tag as string, _
                     byref outv as containers.Array( of int32 ) )
    dim as string t = ctx.ifaceTexts[n]
    dim as string lead = "'' " & tag & " "
    dim as int32 p = 1
    while p <= len( t )
        dim as int32 e = instr( p, t, chr( 10 ) )
        if e = 0 then e = len( t ) + 1
        dim as string ln = mid( t, p, e - p )
        p = e + 1
        if left( ln, 2 ) <> "''" then exit while
        if left( ln, len( lead ) ) <> lead then continue while
        dim as int32 at = ChainIndex( ctx, mid( ln, instrrev( ln, " " ) + 1 ) )
        if at >= 0 then outv.Push( at )
    wend
end sub

'' WHOSE PUBLIC HEADERS AN IMPORT READS: the module imported, what it re-exports through
'' 'public' (and they in turn), and every module an interface of the closure uses. The other
'' modules of the closure are read for their declarations alone, so a C header one of them
'' carries publicly does not reach a program that never asked for it.
private sub Wanted_ _
    ( byref ctx as Tko.CompilerContext, byval n as int32, byref order as containers.Array( of int32 ), _
      byref want as containers.Array( of uint8 ) )
    dim as containers.Array( of int32 ) work
    work.Push( n )
    while work.Count > 0
        dim as int32 m = work[work.Count - 1]
        work.Pop( )
        if want[m] <> 0 then continue while
        want[m] = 1
        Tagged_( ctx, m, "reexport", work )
    wend
    for each m as int32 in order
        dim as containers.Array( of int32 ) used
        Tagged_( ctx, m, "uses", used )
        for each u as int32 in used
            want[u] = 1
        next
    next
end sub

private function Hook_ _
    ( byval c as any ptr, byref rec as Tko.PpImport, byref files as Tko.FileIdVec, _
      byref chain as string ) as boolean
    dim as Tko.CompilerContext ptr ctx = cast( Tko.CompilerContext ptr, c )
    dim as int32 n = ImportIndex( *ctx, rec )
    if n < 0 then return false
    chain = ctx->ifaceChains[n]
    dim as containers.Array( of uint8 ) seen, want
    for i as int32 = 0 to ctx->ifaceChains.Count - 1
        seen.Push( 0 )
        want.Push( 0 )
    next
    dim as containers.Array( of int32 ) order
    Closure_( *ctx, n, seen, order )
    Wanted_( *ctx, n, order, want )
    '' Each interface, and after it its public headers where they are wanted: before any
    '' interface that uses them, because that one comes later in the order.
    for each m as int32 in order
        if ctx->ifaceFiles[m] <> cast( uint32, Tko.FILE_NONE ) then files.Push( ctx->ifaceFiles[m] )
        if (want[m] <> 0) andalso (ctx->ifacePubFiles[m] <> cast( uint32, Tko.FILE_NONE )) then
            files.Push( ctx->ifacePubFiles[m] )
        end if
    next
    return true
end function

sub InstallImports( byref ctx as Tko.CompilerContext, byref cfg as Tko.PpConfig )
    cfg.importCtx = @ctx
    cfg.importFn = @Hook_
end sub

private function Folded_( byref ctx as Tko.CompilerContext, byref s as string ) as Tko.InternId
    return ctx.names.Fold( ctx.names.GetString( s ) )
end function

'' AN ALIAS SHARES ITS MODULE'S SCOPE: 'http.X', 'using http' and 'http.T' as a type all work
'' as for any namespace. The mangler never sees it: the scope's owner is the module's own.
private sub BindView_ _
    ( byref syms as Tko.SymbolTable, byval asid as Tko.SymbolId, byval nsSid as uint32, _
      byval parent as Tko.ScopeId )
    dim as Tko.Symbol ptr a = syms.SymbolAt( asid )
    dim as Tko.Symbol ptr ns = syms.SymbolAt( cast( Tko.SymbolId, nsSid ) )
    if (a = nullptr) orelse (ns = nullptr) then return
    a->inner = ns->inner
end sub

'' A MODULE'S RE-EXPORTS (RFC-0002 §6), from its interface's '' reexport <alias> <chain>
'' lines: each alias, a view of that module, declared public inside the module's own
'' namespace -- 'http.esc.Url'.
private sub BindReexports_ _
    ( byref ctx as Tko.CompilerContext, byref syms as Tko.SymbolTable, _
      byref nsOf as containers.Array( of uint32 ) )
    for n as int32 = 0 to ctx.ifaceChains.Count - 1
        if nsOf[n] = 0 then continue for
        dim as string t = ctx.ifaceTexts[n]
        dim as int32 p = 1
        while p <= len( t )
            dim as int32 e = instr( p, t, chr( 10 ) )
            if e = 0 then e = len( t ) + 1
            dim as string ln = mid( t, p, e - p )
            p = e + 1
            if left( ln, 2 ) <> "''" then exit while
            if left( ln, 12 ) <> "'' reexport " then continue while
            dim as string rest = mid( ln, 13 )
            dim as int32 sp = instr( rest, " " )
            if sp = 0 then continue while
            dim as string al = left( rest, sp - 1 )
            dim as string ch = mid( rest, sp + 1 )
            dim as int32 m = ChainIndex( ctx, ch )
            if m < 0 then continue while
            if nsOf[m] = 0 then continue while
            dim as Tko.Symbol ptr host = syms.SymbolAt( cast( Tko.SymbolId, nsOf[n] ) )
            if host = nullptr then continue while
            dim as Tko.ScopeId hs = host->inner
            dim as boolean dup = false
            dim as Tko.SymbolId rsid = syms.DeclareSym( hs, Folded_( ctx, al ), Tko.SYM_NAMESPACE, _
                                                        Tko.LOC_NONE, dup )
            if dup then continue while
            BindView_( syms, rsid, nsOf[m], hs )
        wend
    next
end sub

'' A MODULE'S OVERLOADS OF A HEADER'S NAMES (RFC-0001 F4), from its interface's '' joins
'' <name> lines: 'public function GetWindowText overload( byval hWin as HWND ) as ustring'
'' joined windows.bi's GetWindowText in the module, and joins it here too. Each public
'' member of that name in the module's namespace gets a twin in this unit's own set for the
'' name (SymbolTable.JoinTwin), so a bare call chooses among the header's declarations and
'' the module's by signature, and links to what the module defined; 'qo.GetWindowText' still
'' reaches the namespace alone. Only a module this unit imports itself: one it reads for
'' another's sake lends its types, not its names.
private sub JoinOverloads_ _
    ( byref ctx as Tko.CompilerContext, byref syms as Tko.SymbolTable, _
      byval n as int32, byval nsSid as uint32, byval modScope as Tko.ScopeId )
    dim as Tko.Symbol ptr ns = syms.SymbolAt( cast( Tko.SymbolId, nsSid ) )
    if ns = nullptr then return
    dim as Tko.ScopeId inner = ns->inner
    if inner = Tko.SCOPE_NONE then return
    dim as string t = ctx.ifaceTexts[n]
    dim as int32 p = 1
    while p <= len( t )
        dim as int32 e = instr( p, t, chr( 10 ) )
        if e = 0 then e = len( t ) + 1
        dim as string ln = mid( t, p, e - p )
        p = e + 1
        if left( ln, 2 ) <> "''" then exit while
        if left( ln, 9 ) <> "'' joins " then continue while
        dim as Tko.InternId nm = Folded_( ctx, trim( mid( ln, 10 ) ) )
        '' The members first: each twin is a new symbol, and the table may move.
        dim as containers.Array( of uint32 ) members
        dim as Tko.SymbolId cur = syms.LookupLocal( inner, nm )
        dim as Tko.Symbol ptr hs = syms.SymbolAt( cur )
        if hs = nullptr then continue while
        if hs->kind <> cast( uint8, Tko.SYM_PROC ) then cur = hs->altClass
        dim as int32 guard = 0
        while (cur <> Tko.SYMBOL_NONE) andalso (guard < 100000)
            guard += 1
            dim as Tko.Symbol ptr ms = syms.SymbolAt( cur )
            if ms = nullptr then exit while
            if ms->kind <> cast( uint8, Tko.SYM_PROC ) then exit while
            if (ms->parent = inner) andalso (ms->diedAt = 0) andalso _
               ((ms->flags and Tko.SYMF_PUBLIC) <> 0) then members.Push( cast( uint32, cur ) )
            cur = ms->nextOverload
        wend
        for each m as uint32 in members
            syms.JoinTwin( modScope, cast( Tko.SymbolId, m ) )
        next
    wend
end sub

'' WHICH FILE OF A MODULE UNIT 'loc' is in, 1-based, or 0 for a header's or nothing's.
private function UnitFileOf_ _
    ( byref ctx as Tko.CompilerContext, byval loc as Tko.SourceLoc, _
      byref lo as Tko.FileIdVec, byref hi as Tko.FileIdVec ) as uint32
    for i as int32 = 0 to lo.Count - 1
        if (loc >= lo[i]) andalso (loc <= hi[i]) then return cast( uint32, i + 1 )
    next
    return 0
end function

'' AN IMPORT BELONGS TO THE FILE THAT WRITES IT (M22): in a unit of several files, every
'' node's file, for SymbolTable.AliasHidden. A node of a header is its own file's, not the
'' includer's, and is left 0 -- an alias written in a header is the includer's choice.
private sub MapNodeFiles_ _
    ( byref ctx as Tko.CompilerContext, byref ast as Tko.AstArena, byref syms as Tko.SymbolTable, _
      byref lo as Tko.FileIdVec, byref hi as Tko.FileIdVec )
    syms.nodeModFile.Clear( )
    syms.nodeModFile.Push( 0 )
    for i as int32 = 1 to ast.Count( )
        syms.nodeModFile.Push( UnitFileOf_( ctx, ast.Loc( cast( Tko.NodeId, i ) ), lo, hi ) )
    next
end sub

sub BindImports _
    ( byref ctx as Tko.CompilerContext, byref ast as Tko.AstArena, _
      byref syms as Tko.SymbolTable, byref info as Tko.SemanticInfo, _
      byref imports as Tko.PpImportVec )

    if ctx.ifaceChains.Count = 0 then return
    dim as Tko.ScopeId modScope = Tko.ModSym.ModuleScope( syms )

    '' Each interface this unit read: its namespace, for the mangler.
    dim as containers.Array( of uint32 ) nsOf       '' by module index: the namespace symbol, or 0
    dim as Tko.FileIdVec read_
    for i as int32 = 0 to ctx.ifaceChains.Count - 1
        nsOf.Push( 0 )
        if ctx.ifaceFiles[i] = cast( uint32, Tko.FILE_NONE ) then continue for
        read_.Push( ctx.ifaceFiles[i] )
        dim as Tko.SymbolId sid = syms.LookupLocal( modScope, _
            Folded_( ctx, InterfaceNamespace( ctx.ifaceChains[i] ) ) )
        dim as Tko.Symbol ptr s = syms.SymbolAt( sid )
        while (s <> nullptr) andalso (s->kind <> cast( uint8, Tko.SYM_NAMESPACE ))
            sid = s->altClass
            s = syms.SymbolAt( sid )
        wend
        if s = nullptr then continue for
        nsOf[i] = cast( uint32, sid )
        syms.importNs.Push( cast( uint32, sid ) )
        syms.importChains.Push( Tko.Text.UpperAscii( ctx.ifaceChains[i] ) )
    next
    Tko.ModSym.MarkImported( ast, syms, info, ctx.sources, read_ )
    BindReexports_( ctx, syms, nsOf )

    '' Each '#import''s alias, bound to its module's scope.
    dim as containers.Array( of uint32 ) aliasSym, aliasMod, aliasRec
    '' ...and, in a unit of several files, the file each one is written in (M22).
    dim as Tko.FileIdVec lo, hi
    if ctx.modFileCount > 1 then
        for each f as uint32 in ctx.modFiles
            dim as Tko.FileId fid = cast( Tko.FileId, f )
            dim as Tko.SourceFile ptr sf = ctx.sources.FileAt( fid )
            if sf = nullptr then continue for
            lo.Push( cast( uint32, ctx.sources.LocFor( fid, 0 ) ) )
            hi.Push( cast( uint32, ctx.sources.LocFor( fid, sf->text.Count ) ) )
        next
    end if
    for k as int32 = 0 to imports.Count - 1
        dim as int32 n = ImportIndex( ctx, imports[k] )
        if n < 0 then continue for
        if nsOf[n] = 0 then continue for
        dim as Tko.InternId an = Folded_( ctx, imports[k].alias_ )
        dim as boolean dup = false
        dim as Tko.SymbolId asid = syms.DeclareSym( modScope, an, Tko.SYM_NAMESPACE, imports[k].loc, dup )
        if dup then
            dim as int32 mine = -1
            for q as int32 = 0 to aliasSym.Count - 1
                if aliasSym[q] = cast( uint32, asid ) then mine = q
            next
            if mine < 0 then
                ctx.diags.Report( Tko.TKO0863, Tko.PointRange( imports[k].loc ), imports[k].alias_ )
            elseif aliasMod[mine] <> cast( uint32, n ) then
                ctx.diags.Report( Tko.TKO0862, Tko.PointRange( imports[k].loc ), _
                                  imports[k].alias_, imports[aliasRec[mine]].path )
            elseif lo.Count > 0 then
                '' The same module under the same alias, imported by another file too.
                syms.aliasPairSym.Push( cast( uint32, asid ) )
                syms.aliasPairFile.Push( UnitFileOf_( ctx, imports[k].loc, lo, hi ) )
            end if
            continue for
        end if
        BindView_( syms, asid, nsOf[n], modScope )
        if lo.Count > 0 then
            syms.aliasPairSym.Push( cast( uint32, asid ) )
            syms.aliasPairFile.Push( UnitFileOf_( ctx, imports[k].loc, lo, hi ) )
        end if
        syms.importPaths.Push( imports[k].path )
        syms.importAliases.Push( Tko.Text.LowerAscii( imports[k].alias_ ) )
        syms.importLocs.Push( cast( uint32, imports[k].loc ) )
        aliasSym.Push( cast( uint32, asid ) )
        aliasMod.Push( cast( uint32, n ) )
        aliasRec.Push( cast( uint32, k ) )
    next
    if syms.aliasPairSym.Count > 0 then MapNodeFiles_( ctx, ast, syms, lo, hi )
    '' Each module imported here once, however many aliases name it: the first alias of each.
    dim as containers.Array( of uint8 ) joined
    for i as int32 = 0 to ctx.ifaceChains.Count - 1
        joined.Push( 0 )
    next
    for q as int32 = 0 to aliasMod.Count - 1
        dim as boolean first_ = (joined[aliasMod[q]] = 0)
        joined[aliasMod[q]] = 1
        if first_ then
            JoinOverloads_( ctx, syms, cast( int32, aliasMod[q] ), nsOf[aliasMod[q]], modScope )
        end if
    next
end sub

sub InitOrder( byref ctx as Tko.CompilerContext, byref outv as Tko.StrVec )
    outv.Clear( )
    dim as int32 self_ = -1
    if ctx.modFileCount > 0 then
        self_ = ChainIndex( ctx, ctx.modChain )
        if self_ < 0 then return
    end if
    '' What self_ imports directly, marked by module: an edge scan per module in the order.
    dim as containers.Array( of uint8 ) direct
    if self_ >= 0 then
        for i as int32 = 0 to ctx.ifaceChains.Count - 1
            direct.Push( 0 )
        next
        for a as int32 = cast( int32, ctx.ifaceAdjFirst[self_] ) to cast( int32, ctx.ifaceAdjFirst[self_ + 1] ) - 1
            dim as uint32 t = ctx.ifaceAdjTo[a]
            if t < cast( uint32, direct.Count ) then direct[t] = 1
        next
    end if
    for each o as uint32 in ctx.ifaceOrder
        dim as boolean wanted = (self_ < 0)
        if wanted = false then wanted = (o < cast( uint32, direct.Count )) andalso (direct[o] <> 0)
        if wanted then outv.Push( ctx.ifaceChains[o] )
    next
end sub

sub PublishInterface _
    ( byref ctx as Tko.CompilerContext, byref pr as Tko.PpResult, _
      byref ast as Tko.AstArena, byref syms as Tko.SymbolTable, _
      byref info as Tko.SemanticInfo )

    dim as int32 self_ = ChainIndex( ctx, ctx.modChain )
    if self_ < 0 then return
    '' The namespaces of the module's own imports, for the names its interface spells
    '' through their aliases.
    dim as Tko.StrVec aliases, spaces
    for k as int32 = 0 to pr.imports.Count - 1
        dim as int32 n = ImportIndex( ctx, pr.imports[k] )
        if n < 0 then continue for
        aliases.Push( Tko.Text.LowerAscii( pr.imports[k].alias_ ) )
        spaces.Push( InterfaceNamespace( ctx.ifaceChains[n] ) )
    next
    dim as string text_ = WriteInterface( ctx, pr.tokens, ast, syms, info, aliases, spaces, _
                                          pr.modHeaders, @pr )
    '' ...and what it re-exports, in the header (RFC-0002 §6): '' reexport <alias> <chain>.
    dim as string rx = ""
    for k as int32 = 0 to pr.imports.Count - 1
        if pr.imports[k].isPublic = false then continue for
        dim as int32 n = ImportIndex( ctx, pr.imports[k] )
        if n < 0 then continue for
        rx &= "'' reexport " & Tko.Text.LowerAscii( pr.imports[k].alias_ ) & " " & ctx.ifaceChains[n] & chr( 10 )
    next
    if len( rx ) > 0 then
        dim as int32 l2 = instr( instr( text_, chr( 10 ) ) + 1, text_, chr( 10 ) )
        text_ = left( text_, l2 ) & rx & mid( text_, l2 + 1 )
    end if
    SetInterface( ctx, self_, text_ )
end sub

sub SetInterface( byref ctx as Tko.CompilerContext, byval n as int32, byref text_ as string )
    ctx.ifaceTexts[n] = text_
    dim as string main_ = "", pub_ = ""
    dim as boolean inPub = false
    dim as int32 p = 1
    while p <= len( text_ )
        dim as int32 e = instr( p, text_, chr( 10 ) )
        if e = 0 then e = len( text_ )
        dim as string ln = mid( text_, p, e - p + 1 )
        p = e + 1
        if left( ln, 10 ) = "'' tki-pub" then
            inPub = (mid( ln, 11, 4 ) <> "-end")
            '' The marker's line stays, as a blank: the lines below keep their numbers.
            main_ &= chr( 10 )
            continue while
        end if
        if inPub then
            pub_ &= ln
            main_ &= chr( 10 )
        else
            main_ &= ln
        end if
    wend
    ctx.ifaceFiles[n] = cast( uint32, ctx.sources.AddVirtual( ctx.ifaceChains[n] & ".tki", main_ ) )
    ctx.ifacePubFiles[n] = cast( uint32, Tko.FILE_NONE )
    if len( pub_ ) > 0 then
        ctx.ifacePubFiles[n] = cast( uint32, ctx.sources.AddVirtual( ctx.ifaceChains[n] & ".pub.tki", pub_ ) )
    end if
end sub

end namespace
