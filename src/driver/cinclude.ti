'' cinclude.ti -- '#cinclude': the preprocessor's hook into the C importer. D16 phase C.
''
'' The preprocessor never includes the importer. MakePpConfig hands it a function and a
'' context, and '#cinclude "h"' calls them for the binding's FileId, which it then enters
'' exactly as '#include' enters a file.

#pragma once

#include once "tko.ti"
#include once "driver/driver.ti"
#include once "pp/pp.ti"

namespace Tko.CImportDriver

'' Point 'cfg' at this invocation's importer.
declare sub ConfigureHook( byref cfg as Tko.PpConfig, byref ctx as Tko.CompilerContext )

'' The session hung on CompilerContext.cinclude, freed with the context.
declare sub FreeSession( byval p as any ptr )

end namespace
