'' modresolve.tiko -- where an '#import' path leads. The preprocessor has already checked
'' its form (src/pp/ppmodule.tiko); this finds the directory, and names the module.

#import "std/containers"
#import "std/fs"
#include once "driver/modresolve.ti"
#include once "driver/manifest.ti"
#include once "support/text.ti"
#include once "codegen/dllimplib.ti"
#include once "codegen/target.ti"
#include once "build/events.ti"

namespace Tko.Modules


'' Paths compare CASE-INSENSITIVELY on Windows, where the filesystem does, and exactly
'' elsewhere.
private function SamePath_( byref a as string, byref b as string ) as boolean
    #ifdef __FB_WIN32__
        return Tko.Text.LowerAscii( a ) = Tko.Text.LowerAscii( b )
    #else
        return a = b
    #endif
end function

function NormPath( byref p as string ) as string
    dim as string s = p
    for i as int32 = 0 to len( s ) - 1
        if s[i] = 92 then s[i] = 47
    next

    '' The part no '..' may climb above: '/', or a drive 'C:/'.
    dim as string prefix = ""
    if left( s, 1 ) = "/" then
        prefix = "/"
        s = mid( s, 2 )
    elseif (len( s ) >= 3) andalso (mid( s, 2, 2 ) = ":/") then
        prefix = left( s, 3 )
        s = mid( s, 4 )
    end if

    dim as Tko.StrVec segs
    dim as int32 st = 1
    do
        dim as int32 sl = instr( st, s, "/" )
        dim as string seg = iif( sl = 0, mid( s, st ), mid( s, st, sl - st ) )
        if (seg = "") orelse (seg = ".") then
            '' nothing
        elseif seg = ".." then
            dim as boolean canPop = (segs.Count > 0)
            if canPop then canPop = (segs[segs.Count - 1] <> "..")
            if canPop then
                segs.Pop( )
            elseif len( prefix ) = 0 then
                segs.Push( ".." )          '' a relative path may begin above its base
            end if
        else
            segs.Push( seg )
        end if
        if sl = 0 then exit do
        st = sl + 1
    loop

    dim as string outp = prefix
    for i as int32 = 0 to segs.Count - 1
        if i > 0 then outp += "/"
        outp += segs[i]
    next
    if len( outp ) = 0 then outp = "."
    return outp
end function

function JoinPath( byref a as string, byref b as string ) as string
    if (len( a ) = 0) orelse (a = ".") then return NormPath( b )
    return NormPath( a & "/" & b )
end function

function AbsPath( byref p as string ) as string
    dim as boolean absolute_ = (instr( p, ":" ) > 0) orelse (left( p, 1 ) = "/")
    if absolute_ then return NormPath( p )
    return JoinPath( curdir( ), p )
end function

function DirOfFile( byref p as string ) as string
    dim as string n = NormPath( p )
    dim as int32 sl = instrrev( n, "/" )
    if sl = 0 then return "."
    if sl = 1 then return "/"
    dim as string d = left( n, sl - 1 )
    if right( d, 1 ) = ":" then d += "/"
    return d
end function

'' Is p the directory root, or inside it?
private function IsWithin_( byref p as string, byref root as string ) as boolean
    if root = "." then
        dim as boolean up = (p = "..") orelse (left( p, 3 ) = "../")
        dim as boolean abs_ = (left( p, 1 ) = "/") orelse (mid( p, 2, 1 ) = ":")
        return (up = false) andalso (abs_ = false)
    end if
    if SamePath_( p, root ) then return true
    dim as string pre = left( p, len( root ) + 1 )
    return SamePath_( pre, root & "/" )
end function

'' What follows root in p, which is inside it: "" for root itself.
private function Below_( byref p as string, byref root as string ) as string
    if root = "." then return iif( p = ".", "", p )
    if len( p ) <= len( root ) then return ""
    return mid( p, len( root ) + 2 )
end function

private function ChainOf_( byref pkgName as string, byref rel as string ) as string
    dim as string c = Tko.Text.LowerAscii( pkgName )
    if len( rel ) = 0 then return c
    dim as string r = Tko.Text.LowerAscii( rel )
    for i as int32 = 0 to len( r ) - 1
        if r[i] = 47 then r[i] = 46
    next
    return c & "." & r
end function

'' THE PACKAGE SEARCH ROOTS, in order: each -i the user gave (not the bundled header
'' directory, which cmdline.tiko appends after them), then each TKO_PATH entry.
private sub SearchRoots_( byref ctx as Tko.CompilerContext, byref roots as Tko.StrVec )
    for i as int32 = 0 to ctx.options.userIncludeCount - 1
        roots.Push( NormPath( ctx.options.includePaths[i] ) )
    next
    dim as string env_ = environ( "TKO_PATH" )
    #ifdef __FB_WIN32__
        const SEP = ";"
    #else
        const SEP = ":"
    #endif
    dim as int32 st = 1
    while st <= len( env_ )
        dim as int32 sp = instr( st, env_, SEP )
        dim as string one_ = iif( sp = 0, mid( env_, st ), mid( env_, st, sp - st ) )
        if len( one_ ) > 0 then roots.Push( NormPath( one_ ) )
        if sp = 0 then exit while
        st = sp + 1
    wend
end sub

'' THE TOOLCHAIN'S PACKAGE TREE: --pkg-dir, else TKO_PKG, else <exe-dir>/pkg, else
'' <exe-dir>/../pkg -- the same two layouts the default include directory is found in
'' (cmdline.tiko). --pkg-dir is for a host whose executable is not tiko's: in the editor's
'' parser.dll, <exe-dir> is the editor's folder.
private function PkgDir_( byref ctx as Tko.CompilerContext ) as string
    if len( ctx.options.pkgDir ) > 0 then return NormPath( ctx.options.pkgDir )
    dim as string env_ = environ( "TKO_PKG" )
    if len( env_ ) > 0 then return NormPath( env_ )
    dim as string exeDir = exepath( )
    if len( exeDir ) = 0 then return ""
    dim as string cand = JoinPath( exeDir, "pkg" )
    if fs.IsDir( cand ) then return cand
    cand = JoinPath( exeDir, "../pkg" )
    if fs.IsDir( cand ) then return cand
    return ""
end function

'' ONE FILE BESIDE THE OUTPUT, as 'nm' -- left alone when a copy there has the same size and is
'' no older -- and told to the build observer either way, so 'tiko build''s copy_to takes it.
private function CopyBeside_ _
    ( byref ctx as Tko.CompilerContext, byref src as string, byref outDir as string, _
      byref outSpelled as string, byref nm as string, byref failSrc as string, _
      byref failDst as string ) as boolean
    dim as string dst = JoinPath( outDir, nm )
    if SamePath_( dst, src ) = false then
        dim as boolean fresh = false
        dim as fs.FsResultInfo rs = fs.Stat( src )
        dim as fs.FsResultInfo rd = fs.Stat( dst )
        if rs.IsOk( ) andalso rd.IsOk( ) then
            dim as fs.FileInfo fsrc = rs.Value( )
            dim as fs.FileInfo fdst = rd.Value( )
            fresh = (fsrc.Size( ) = fdst.Size( )) andalso (fsrc.ModifiedUtc( ) <= fdst.ModifiedUtc( ))
        end if
        if fresh = false then
            dim as fs.FsResultBool r = fs.CopyFile( src, dst, true )
            if r.IsOk( ) = false then
                failSrc = src
                failDst = dst
                return false
            end if
        end if
    end if
    Tko.Build.OnRuntimeLib( ctx.build, JoinPath( outSpelled, nm ) )
    return true
end function

'' A VENDOR PACKAGE'S DYNAMIC LIBRARIES, BESIDE THE OUTPUT (tiko-vendor RFC-0002 V13). The
'' library stays in the toolchain's pkg/vendor/<module>/lib, where neither Windows' loader nor
'' an ELF $ORIGIN or a Mach-O @loader_path looks, so a 'link dynamic' program would not
'' start: measured, they exit 'cannot open shared object' / 0xC0000135 / dyld's 'Library not
'' loaded'. Each linked file under pkg/vendor that is a '.dll', a '.so' or a '.dylib' -- or
'' a Windows import library with its '.dll' beside it -- is copied
'' into the output's directory, unless a copy there has the same size and is no older.
'' Then each file of ctx.runtimeFiles, under its own name. False at the first copy that fails,
'' naming it.
function CopyVendorLibs _
    ( byref ctx as Tko.CompilerContext, byref outPath as string, _
      byref failSrc as string, byref failDst as string ) as boolean
    dim as string pk = PkgDir_( ctx )
    dim as string vdir = ""
    if len( pk ) > 0 then vdir = NormPath( AbsPath( JoinPath( pk, "vendor" ) ) ) & "/"
    dim as string outDir = DirOfFile( AbsPath( outPath ) )
    '' ...and as the output is spelled, for what the build observer is told.
    dim as string outSpelled = DirOfFile( outPath )
    for each lf as string in ctx.link.pragmaLibFiles
        if len( vdir ) = 0 then exit for
        dim as string src = NormPath( AbsPath( lf ) )
        if SamePath_( left( src, len( vdir ) ), vdir ) = false then continue for
        dim as string low = Tko.Text.LowerAscii( src )
        dim as string run_ = ""
        if (right( low, 4 ) = ".dll") orelse (right( low, 3 ) = ".so") orelse (instr( low, ".so." ) > 0) _
           orelse (right( low, 6 ) = ".dylib") then
            run_ = src
        elseif right( low, 6 ) = ".dll.a" then
            run_ = left( src, len( src ) - 2 )
        elseif right( low, 4 ) = ".lib" then
            run_ = left( src, len( src ) - 4 ) & ".dll"
        end if
        if (len( run_ ) = 0) orelse (fs.IsFile( run_ ) = false) then continue for
        '' A LIBRARY GOES BY THE NAME IT GIVES ITSELF, not by its file's. A DLL's is its export
        '' directory's, which is what the import library names and the loader looks for: SQLite's
        '' sqlite3.dll stored as sqlite3_windows_x86_64.dll is still loaded as sqlite3.dll. An ELF
        '' library's is its soname, which the program records as NEEDED: raylib's release .so,
        '' stored as raylib_linux_x86_64.so, is looked for as libraylib.so.620. (A library a
        '' vendor package builds itself gets its file name as its soname, so it keeps that --
        '' and so does every '.dylib': vendorfetch.sh gives it '@rpath/' and its file name as
        '' its install name, the name dyld looks for.)
        dim as string nm = mid( run_, instrrev( run_, "/" ) + 1 )
        dim as string lrun = Tko.Text.LowerAscii( run_ )
        if right( lrun, 4 ) = ".dll" then
            dim as string why
            dim as string def_ = Tko.Codegen.DllDefText( run_, why )
            if left( def_, 9 ) = "LIBRARY " & chr( 34 ) then
                dim as int32 q = instr( 10, def_, chr( 34 ) )
                if q > 10 then nm = mid( def_, 10, q - 10 )
            end if
        elseif (right( lrun, 3 ) = ".so") orelse (instr( lrun, ".so." ) > 0) then
            dim as string son = Tko.Codegen.ElfSoname( run_ )
            if len( son ) > 0 then nm = son
        end if
        if CopyBeside_( ctx, run_, outDir, outSpelled, nm, failSrc, failDst ) = false then return false
    next
    '' THE FILES A MODULE NEEDS AT RUN TIME ([vendor.<module>] runtime), flat, by their own
    '' names: a font, a library the program loads itself, which no link names.
    for each rf as string in ctx.runtimeFiles
        dim as string src = NormPath( AbsPath( rf ) )
        dim as string nm = mid( src, instrrev( src, "/" ) + 1 )
        if CopyBeside_( ctx, src, outDir, outSpelled, nm, failSrc, failDst ) = false then return false
    next
    return true
end function

'' WHERE AN IMPORT IS LOOKED FOR, for 'tiko metadata' (src/build): the search roots in order
'' and the toolchain's package tree, as SearchRoots_ and PkgDir_ find them.
sub SearchPaths( byref ctx as Tko.CompilerContext, byref roots as Tko.StrVec, byref pkg as string )
    SearchRoots_( ctx, roots )
    pkg = PkgDir_( ctx )
end sub

sub ResetPackages( byref ctx as Tko.CompilerContext )
    ctx.pkgNames.Clear( ) : ctx.pkgRoots.Clear( )
    ctx.pkgDepOwner.Clear( ) : ctx.pkgDepName.Clear( ) : ctx.pkgDepPath.Clear( )
    ctx.pkgDefOwner.Clear( ) : ctx.pkgDefText.Clear( )
    ctx.pkgDdDep.Clear( ) : ctx.pkgDdText.Clear( )
    ctx.pkgLinkOwner.Clear( ) : ctx.pkgLinkMod.Clear( ) : ctx.pkgLinkModes.Clear( )
    ctx.pkgRtOwner.Clear( ) : ctx.pkgRtMod.Clear( ) : ctx.pkgRtFiles.Clear( )
    ctx.pkgRootKnown = false
end sub

private function PkgIndex_( byref ctx as Tko.CompilerContext, byref name_ as string ) as int32
    for i as int32 = 0 to ctx.pkgNames.Count - 1
        if ctx.pkgNames[i] = name_ then return i
    next
    return -1
end function

'' THE TOOLCHAIN'S OWN PACKAGES (RFC-0007 §3; tiko-vendor RFC-0002 V3): 'std'; 'vendor', the
'' C libraries the toolchain ships; and 'sys', the operating-system support built on them
'' (sys/win). An '#import' of any of them is looked for in the toolchain's pkg/ alone, so no
'' project, -i directory, TKO_PATH entry or dependency can stand in for one. 'db' is an
'' ordinary name.
private function Reserved_( byref lname as string ) as boolean
    return (lname = "std") orelse (lname = "vendor") orelse (lname = "sys")
end function

'' ONE PACKAGE NAME, ONE ROOT (TKO0149). The first time a name is met its manifest, if it
'' has one, is read: its name must be the one the package was found by (TKO0146), and a
'' reserved name belongs to the toolchain (TKO0148).
private function Register_ _
    ( byref ctx as Tko.CompilerContext, byref name_ as string, byref root as string, _
      byval isRoot as boolean ) as boolean
    dim as string n = Tko.Text.LowerAscii( name_ )
    dim as int32 at = PkgIndex_( ctx, n )
    if at >= 0 then
        if SamePath_( ctx.pkgRoots[at], NormPath( root ) ) then return true
        ctx.diags.ReportGlobal( Tko.TKO0149, n, ctx.pkgRoots[at], NormPath( root ) )
        return false
    end if
    ctx.pkgNames.Push( n )
    ctx.pkgRoots.Push( NormPath( root ) )
    dim as string idx = str( ctx.pkgNames.Count - 1 )
    if HasManifest( root ) = false then return true
    dim as Manifest m
    if LoadManifest( ctx, root, m ) = false then return false
    if (isRoot = false) andalso (m.name <> n) then
        ctx.diags.ReportGlobal( Tko.TKO0146, n, "its tiko.toml names it '" & m.name & "'" )
        return false
    end if
    if Reserved_( m.name ) then
        dim as string pk = PkgDir_( ctx )
        dim as boolean toolchain_ = (len( pk ) > 0)
        if toolchain_ then toolchain_ = SamePath_( NormPath( root ), JoinPath( pk, m.name ) )
        if toolchain_ = false then
            ctx.diags.ReportGlobal( Tko.TKO0148, m.name )
            return false
        end if
    end if
    for k as int32 = 0 to m.depNames.Count - 1
        ctx.pkgDepOwner.Push( idx ) : ctx.pkgDepName.Push( m.depNames[k] ) : ctx.pkgDepPath.Push( m.depPaths[k] )
    next
    for each d as string in m.defines
        ctx.pkgDefOwner.Push( idx ) : ctx.pkgDefText.Push( d )
    next
    for k as int32 = 0 to m.vendorMods.Count - 1
        ctx.pkgLinkOwner.Push( idx ) : ctx.pkgLinkMod.Push( m.vendorMods[k] ) : ctx.pkgLinkModes.Push( m.vendorLinks[k] )
    next
    for k as int32 = 0 to m.vendorRtMods.Count - 1
        ctx.pkgRtOwner.Push( idx ) : ctx.pkgRtMod.Push( m.vendorRtMods[k] ) : ctx.pkgRtFiles.Push( m.vendorRtFiles[k] )
    next
    if isRoot then
        for k as int32 = 0 to m.ddDep.Count - 1
            ctx.pkgDdDep.Push( Tko.Text.LowerAscii( m.ddDep[k] ) ) : ctx.pkgDdText.Push( m.ddDefine[k] )
        next
    end if
    return true
end function

function RootPackage _
    ( byref ctx as Tko.CompilerContext, byref name_ as string, byref root as string ) as boolean
    if ctx.pkgRootKnown then
        name_ = ctx.pkgRootName
        root = ctx.pkgRootDir
        return true
    end if
    ctx.pkgRootKnown = true
    dim as string first_ = DirOfFile( ctx.sources.PathOf( cast( Tko.FileId, 1 ) ) )
    ctx.pkgRootName = ANON_PACKAGE
    ctx.pkgRootDir = first_
    '' The nearest tiko.toml at or above the first root's directory.
    '' Found by the absolute path, and kept in the roots' own spelling -- the first root's
    '' directory with as many '..' as it took -- since paths compare lexically.
    dim as string abs_ = DirOfFile( ctx.sources.AbsPathOf( cast( Tko.FileId, 1 ) ) )
    dim as string d = abs_
    dim as string rel = first_
    for guard as int32 = 0 to 64
        if HasManifest( d ) then
            dim as Manifest m
            if LoadManifest( ctx, d, m ) = false then return false
            ctx.pkgRootName = m.name
            ctx.pkgRootDir = NormPath( rel )
            exit for
        end if
        dim as string up_ = DirOfFile( d )
        if (len( up_ ) = 0) orelse SamePath_( up_, d ) then exit for
        d = up_
        rel = JoinPath( rel, ".." )
    next
    name_ = ctx.pkgRootName
    root = ctx.pkgRootDir
    if ctx.pkgRootName = ANON_PACKAGE then return true
    return Register_( ctx, ctx.pkgRootName, ctx.pkgRootDir, true )
end function

'' A MODULE'S PATH BELOW ITS PACKAGE, as a [vendor.<module>] table names it: 'vendor.SDL3.image'
'' of package 'vendor' is 'sdl3.image'; a package's root module goes by the package's name.
private function ModBelow_( byref name_ as string, byref chain as string ) as string
    dim as string below = Tko.Text.LowerAscii( chain )
    dim as string pre = Tko.Text.LowerAscii( name_ ) & "."
    if left( below, len( pre ) ) = pre then below = mid( below, len( pre ) + 1 )
    return below
end function

'' THE LINK MODES MODULE 'chain' OF PACKAGE 'name_' SHIPS, "|static|dynamic|" -- its
'' manifest's [vendor.<module>] links -- or "" when it declares none: such a module takes no
'' '#import ... link' (tiko-vendor RFC-0002 V7).
function LinkModesOf( byref ctx as Tko.CompilerContext, byref name_ as string, byref chain as string ) as string
    dim as int32 at = PkgIndex_( ctx, Tko.Text.LowerAscii( name_ ) )
    if at < 0 then return ""
    dim as string idx = str( at )
    dim as string below = ModBelow_( name_, chain )
    for k as int32 = 0 to ctx.pkgLinkOwner.Count - 1
        if (ctx.pkgLinkOwner[k] = idx) andalso (Tko.Text.LowerAscii( ctx.pkgLinkMod[k] ) = below) then
            return ctx.pkgLinkModes[k]
        end if
    next
    return ""
end function

'' THE FILES MODULE 'chain' OF PACKAGE 'name_' NEEDS AT RUN TIME -- its manifest's
'' [vendor.<module>] runtime -- each entry as written and its path below the module's directory
'' 'dir_', as '#foreignlib "lib/x"' is. An entry whose file name has no extension is a shared
'' library, spelled as the target spells one: 'lib/x' is lib/x.dll for a Windows target,
'' lib/libx.so for an ELF one, lib/libx.dylib for Mach-O.
sub RuntimeFilesOf _
    ( byref ctx as Tko.CompilerContext, byref name_ as string, byref chain as string, _
      byref dir_ as string, byref entries as Tko.StrVec, byref paths as Tko.StrVec )
    dim as int32 at = PkgIndex_( ctx, Tko.Text.LowerAscii( name_ ) )
    if at < 0 then return
    dim as string idx = str( at )
    dim as string below = ModBelow_( name_, chain )
    dim as Tko.Codegen.ObjFormat ofmt = Tko.Codegen.TargetFor( ctx.options.target ).objFormat
    for k as int32 = 0 to ctx.pkgRtOwner.Count - 1
        if (ctx.pkgRtOwner[k] <> idx) orelse (Tko.Text.LowerAscii( ctx.pkgRtMod[k] ) <> below) then continue for
        dim as string v = ctx.pkgRtFiles[k]
        dim as int32 st = 1
        while st <= len( v )
            dim as int32 nl_ = instr( st, v, chr( 10 ) )
            if nl_ = 0 then nl_ = len( v ) + 1
            dim as string one = mid( v, st, nl_ - st )
            st = nl_ + 1
            dim as string e = NormPath( one )
            dim as int32 sl = instrrev( e, "/" )
            dim as string base_ = mid( e, sl + 1 )
            if instr( base_, "." ) = 0 then
                select case ofmt
                case Tko.Codegen.OBJ_COFF : e &= ".dll"
                case Tko.Codegen.OBJ_ELF  : e = left( e, sl ) & "lib" & base_ & ".so"
                case else                 : e = left( e, sl ) & "lib" & base_ & ".dylib"
                end select
            end if
            entries.Push( one )
            paths.Push( JoinPath( dir_, e ) )
        wend
    next
end sub

'' WHAT A MODULE UNIT IS COMPILED WITH besides its files: its package's defines, and
'' TIKO_LINK_STATIC or TIKO_LINK_DYNAMIC when the program chose a link mode for it
'' (tiko-vendor RFC-0002 V6) -- bodied "1", as TIKO_OS_WINDOWS is.
sub ModuleDefines( byref ctx as Tko.CompilerContext, byref outv as Tko.StrVec )
    PackageDefines( ctx, ctx.unit.modPkgName, outv )
    if ctx.unit.modLinkMode = Tko.PP_LINK_STATIC then outv.Push( "TIKO_LINK_STATIC=1" )
    if ctx.unit.modLinkMode = Tko.PP_LINK_DYNAMIC then outv.Push( "TIKO_LINK_DYNAMIC=1" )
end sub

sub PackageDefines( byref ctx as Tko.CompilerContext, byref name_ as string, byref outv as Tko.StrVec )
    outv.Clear( )
    dim as int32 at = PkgIndex_( ctx, Tko.Text.LowerAscii( name_ ) )
    if at < 0 then return
    dim as string idx = str( at )
    for k as int32 = 0 to ctx.pkgDefOwner.Count - 1
        if ctx.pkgDefOwner[k] = idx then outv.Push( ctx.pkgDefText[k] )
    next
    '' The root's [dependencies.<this>.defines], key by key.
    for k as int32 = 0 to ctx.pkgDdDep.Count - 1
        if ctx.pkgDdDep[k] <> ctx.pkgNames[at] then continue for
        dim as string kk = Tko.Text.LowerAscii( left( ctx.pkgDdText[k], instr( ctx.pkgDdText[k], "=" ) ) )
        dim as boolean replaced = false
        for q as int32 = 0 to outv.Count - 1
            if Tko.Text.LowerAscii( left( outv[q], instr( outv[q], "=" ) ) ) = kk then
                outv[q] = ctx.pkgDdText[k]
                replaced = true
            end if
        next
        if replaced = false then outv.Push( ctx.pkgDdText[k] )
    next
end sub

sub ModuleFiles( byref dir_ as string, byref files as Tko.StrVec )
    dim as containers.Array( of fs.DirEntry ) entries
    if fs.ListDir( dir_, entries ).IsOk( ) = false then return
    for k as int32 = 0 to entries.Count - 1
        if entries[k].IsFile( ) = false then continue for
        dim as string nm = entries[k].Name( )
        '' A MODULE'S SOURCES are '.tiko' files, and the legacy '.bas' (T14). A '.ti' is a header.
        dim as string lnm = Tko.Text.LowerAscii( nm )
        if (right( lnm, 4 ) <> ".bas") andalso (right( lnm, 5 ) <> ".tiko") then continue for
        '' Insertion sort: a module is a handful of files.
        dim as string key = Tko.Text.LowerAscii( nm )
        dim as int32 at = files.Count
        files.Push( nm )
        while at > 0
            if Tko.Text.LowerAscii( files[at - 1] ) <= key then exit while
            files[at] = files[at - 1]
            at -= 1
        wend
        files[at] = nm
    next
end sub

sub ChainForDir( byref ctx as Tko.CompilerContext, byref dir_ as string, byref outw as ModWhere )
    dim as string d = NormPath( dir_ )
    dim as Tko.StrVec roots
    SearchRoots_( ctx, roots )
    dim as string pk = PkgDir_( ctx )
    if len( pk ) > 0 then roots.Push( pk )
    for i as int32 = 0 to roots.Count - 1
        if IsWithin_( d, roots[i] ) = false then continue for
        if SamePath_( d, roots[i] ) then continue for
        dim as string rel = Below_( d, roots[i] )
        dim as int32 sl = instr( rel, "/" )
        dim as string first_ = iif( sl = 0, rel, left( rel, sl - 1 ) )
        dim as string rest = iif( sl = 0, "", mid( rel, sl + 1 ) )
        outw.dir_ = d
        outw.pkgName = Tko.Text.LowerAscii( first_ )
        outw.pkgRoot = JoinPath( roots[i], first_ )
        outw.chain = ChainOf_( first_, rest )
        return
    next
    dim as int32 sl = instrrev( d, "/" )
    outw.dir_ = d
    outw.pkgName = ANON_PACKAGE
    outw.pkgRoot = DirOfFile( d )
    outw.chain = ChainOf_( ANON_PACKAGE, mid( d, sl + 1 ) )
end sub

function ResolveImport _
    ( byref ctx as Tko.CompilerContext, byref rec as Tko.PpImport, _
      byref fromDir as string, byref pkgName as string, byref pkgRoot as string, _
      byref outw as ModWhere ) as boolean

    dim as string p = rec.path
    dim as Tko.SourceRange at = Tko.PointRange( rec.loc )

    '' ---- 1. relative, inside the importing file's package.
    dim as boolean relative = (left( p, 2 ) = "./") orelse (left( p, 3 ) = "../")
    if relative then
        dim as string target = JoinPath( fromDir, p )
        if IsWithin_( target, pkgRoot ) = false then
            ctx.diags.Report( Tko.TKO0142, at, p, pkgRoot )
            return false
        end if
        if fs.IsDir( target ) = false then
            ctx.diags.Report( Tko.TKO0140, at, p, target )
            return false
        end if
        outw.dir_ = target
        outw.pkgName = pkgName
        outw.pkgRoot = pkgRoot
        outw.chain = ChainOf_( pkgName, Below_( target, pkgRoot ) )
        return true
    end if

    dim as int32 sl = instr( p, "/" )
    dim as string first_ = iif( sl = 0, p, left( p, sl - 1 ) )
    dim as string rest = iif( sl = 0, "", mid( p, sl + 1 ) )
    dim as string lfirst = Tko.Text.LowerAscii( first_ )

    '' ---- 2 and 3: the current package, and its manifest's dependencies. A reserved name skips them.
    if Reserved_( lfirst ) = false then
        dim as string proot = ""
        if lfirst = Tko.Text.LowerAscii( pkgName ) then proot = pkgRoot
        if len( proot ) = 0 then
            dim as string owner = str( PkgIndex_( ctx, Tko.Text.LowerAscii( pkgName ) ) )
            for k as int32 = 0 to ctx.pkgDepName.Count - 1
                if (ctx.pkgDepOwner[k] = owner) andalso (ctx.pkgDepName[k] = lfirst) then proot = ctx.pkgDepPath[k]
            next
            if len( proot ) > 0 then
                if fs.IsDir( proot ) = false then
                    ctx.diags.ReportGlobal( Tko.TKO0146, lfirst, "no directory at '" & proot & "'" )
                    return false
                end if
                if Register_( ctx, lfirst, proot, false ) = false then return false
            end if
        end if
        if len( proot ) > 0 then
            dim as string target = iif( len( rest ) = 0, proot, JoinPath( proot, rest ) )
            if fs.IsDir( target ) = false then
                ctx.diags.Report( Tko.TKO0140, at, p, target )
                return false
            end if
            outw.dir_ = target
            outw.pkgName = lfirst
            outw.pkgRoot = proot
            outw.chain = ChainOf_( first_, rest )
            return true
        end if
    end if

    '' ---- 4 and 5: a package named by the first segment.

    dim as Tko.StrVec roots
    if Reserved_( lfirst ) = false then SearchRoots_( ctx, roots )
    dim as string pk = PkgDir_( ctx )
    if len( pk ) > 0 then roots.Push( pk )

    dim as string tried = ""
    for i as int32 = 0 to roots.Count - 1
        dim as string proot = JoinPath( roots[i], first_ )
        if fs.IsDir( proot ) = false then
            tried += iif( len( tried ) > 0, ", ", "" ) & proot
            continue for
        end if
        '' THE PACKAGE IS FOUND, so this is the answer whether or not the module is in it:
        '' a later root holding another package of the same name does not get a say.
        dim as string target = iif( len( rest ) = 0, proot, JoinPath( proot, rest ) )
        if fs.IsDir( target ) = false then
            ctx.diags.Report( Tko.TKO0140, at, p, target )
            return false
        end if
        if Register_( ctx, lfirst, proot, false ) = false then return false
        outw.dir_ = target
        outw.pkgName = lfirst
        outw.pkgRoot = proot
        outw.chain = ChainOf_( first_, rest )
        return true
    next

    if len( tried ) = 0 then tried = "no -i, no TKO_PATH, and no toolchain pkg/ directory"
    ctx.diags.Report( Tko.TKO0140, at, p, tried )
    return false
end function

end namespace
