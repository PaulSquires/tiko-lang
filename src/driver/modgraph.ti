'' modgraph.ti -- the build graph: every module the inputs import, their order, and the
'' cycle report (ADR 0017; RFC-0005 §1-2). See modgraph.tiko.

#pragma once

#include once "tko.ti"
#include once "driver/driver.ti"
#include once "pp/pp.ti"

namespace Tko.Modules

'' THE GRAPH, as parallel arrays: one index per module, one per edge.
type ModGraph
    as Tko.StrVec chains
    as Tko.StrVec dirs
    as Tko.StrVec pkgNames
    as Tko.StrVec pkgRoots
    as Tko.IdVec  firstLoc      '' where the module was first imported, for TKO0147
    '' THE LINK MODE THE PROGRAM CHOSE for each module (tiko-vendor RFC-0002 V4-V5): 0 when
    '' no import wrote 'link', else Tko.PP_LINK_*, and the import that chose it.
    as Tko.IdVec  linkMode
    as Tko.IdVec  linkLoc
    '' Each module's files, as FileIds: fileIds[fileFirst[n] .. + fileCount[n] - 1].
    as Tko.IdVec  fileFirst
    as Tko.IdVec  fileCount
    as Tko.IdVec  fileIds
    as Tko.IdVec  edgeFrom
    as Tko.IdVec  edgeTo
    as Tko.IdVec  edgeLoc       '' the '#import', for TKO0906
    '' INDEXES, so nothing scans the whole graph per node: each chain's node (NodeFor_), and
    '' once the graph is complete (Adjacency_) each node's outgoing edges and incoming edges,
    '' in edge order -- outEdge[outFirst[n] .. outFirst[n + 1] - 1], likewise in*.
    as containers.Map( of string, int32 ) nodeOf
    as Tko.IdVec  outFirst
    as Tko.IdVec  outEdge
    as Tko.IdVec  inFirst
    as Tko.IdVec  inEdge
    '' The depth-first search: 0 unvisited, 1 on the stack, 2 done.
    as Tko.IdVec  color
    as Tko.IdVec  stackNode
    as Tko.IdVec  stackEdge     '' the edge that reached stackNode[k]; unused for k = 0
    as boolean    cycled
    '' Dependencies first, ties by chain.
    as Tko.IdVec  order
    '' WHAT EACH ROOT IMPORTS ITSELF: root r's modules are rootMods[rootFirst[r - 1] ..
    '' rootFirst[r] - 1]. A root has no node, so these are not edges (AddImports_).
    as Tko.IdVec  rootFirst
    as Tko.IdVec  rootMods
end type

'' THE GRAPH OF THE FIRST rootCount SOURCES: every module they reach, its files loaded, the
'' cycle check, the order. quiet: the headers' own diagnostics are left to the compile.
'' False when an error was reported.
declare function BuildGraph _
    ( byref ctx as Tko.CompilerContext, byval rootCount as int32, byval quiet as boolean, _
      byref g as ModGraph ) as boolean

'' '--print-graph'. Reads the header of each of the first rootCount source files and of
'' every file of every module they reach, and prints one line per module in build order:
''
''     chain  directory  [the chains it imports]
''
'' Returns the exit code; nothing is printed once an error has been reported.
declare function PrintGraph( byref ctx as Tko.CompilerContext, byval rootCount as int32 ) as int32

end namespace
