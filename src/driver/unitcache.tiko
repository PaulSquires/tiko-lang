'' unitcache.tiko -- see unitcache.ti.

#import "std/containers"
#import "std/fs"
#include once "driver/unitcache.ti"
#include once "driver/unit.ti"
#include once "driver/modcache.ti"
#include once "driver/modbuild.ti"
#include once "driver/modresolve.ti"
#include once "support/diskcache.ti"
#include once "support/text.ti"
#include once "support/spawn.ti"
#include once "support/platform.ti"
#include once "build/events.ti"
#include once "codegen/target.ti"

namespace Tko.UnitCache

'' The name a unit's last key is kept under, for -v's miss reason: one per source path.
private function Chain_( byref ctx as Tko.CompilerContext, byval i as int32 ) as string
    dim as string p = ctx.sources.AbsPathOf( cast( Tko.FileId, i ) )
    #ifdef __FB_WIN32__
        p = Tko.Text.LowerAscii( p )
    #endif
    return "unit-" & Tko.DiskCache.Hash( p )
end function

'' THE REST OF THE COMMAND LINE, in order: what the option lines of a key do not name still
'' reaches it. Not the inputs (each unit keys its own source; a link keys its objects), and
'' not what cannot reach an object or a link: the output, the diagnostics file, -v, the
'' console's colour, a child's unit.
private function ArgsLine_( byref ctx as Tko.CompilerContext, byref args as Tko.StrVec ) as string
    dim as string r = ""
    dim as int32 k = 0
    while k < args.Count
        dim as string w = args[k]
        k += 1
        if (w = "-o") orelse (w = "-x") orelse (w = "--diagnostics-file") orelse (w = "--build-only-unit") then
            k += 1
            continue while
        end if
        '' ...nor --frontend-only: a check keys a unit as the build that stored it did.
        if (w = "-v") orelse (w = "--time-passes") orelse (left( w, 8 ) = "--color=") then continue while
        if w = "--frontend-only" then continue while
        dim as boolean isInput = false
        for each x as string in ctx.options.inputs
            if x = w then isInput = true
        next
        if isInput then continue while
        r &= " " & w
    wend
    return r
end function

sub Open _
    ( byref ctx as Tko.CompilerContext, byref args as Tko.StrVec, byval restartDepth as int32, _
      byval eligible as boolean, byref s as Store )

    s.root = ""
    '' A 'tiko build', or one of its children (--build-only-unit), which runs as a classic
    '' compile but must store the root it was given.
    dim as boolean isChild = (ctx.options.buildOnlyUnit > 0)
    if ((ctx.build = nullptr) andalso (isChild = false)) orelse (eligible = false) orelse (restartDepth > 0) then return
    '' TIKO_TEST_CHILD_EXIT: a child that dies with this code before it compiles anything, so
    '' a test can reach TKO0167 (tests/driver/build-parallel-crash). Read in a child only.
    if isChild andalso (valint( environ( "TIKO_TEST_CHILD_EXIT" ) ) <> 0) then end valint( environ( "TIKO_TEST_CHILD_EXIT" ) )
    if Tko.DiskCache.CompilerStamp( ) = "" then return
    s.root = Tko.Modules.ModuleCacheRoot( ctx )
    s.args = ArgsLine_( ctx, args )
    s.lookupOnly = ctx.options.frontendOnly
end sub

function TryHit _
    ( byref ctx as Tko.CompilerContext, byref s as Store, byval i as int32, byref key as string, _
      byref linkObjs as Tko.StrVec, byref tempObjs as Tko.StrVec ) as boolean

    key = ""
    if len( s.root ) = 0 then return false
    dim as Tko.FileId id = cast( Tko.FileId, i )
    dim as string hitObj, hitIface, hitLibs
    if s.state.Count > i then
        '' THE PROBE'S ANSWER, when RunChildren made one: no second look.
        key = s.pkey[i]
        dim as boolean cached = (s.state[i] = UNIT_HIT) orelse (s.state[i] = UNIT_CHILD)
        if cached = false then return false
        hitObj = s.pobj[i] : hitLibs = s.plibs[i]
    else
        key = Tko.Modules.UnitKey( ctx, id, Tko.Driver.IsMainUnit_( ctx, id, i ), i = 1, s.args )
        if Tko.Modules.ModuleCacheLookup( ctx, s.root, key, hitObj, hitIface, hitLibs ) = false then
            if ctx.options.verbose then
                print "unit " & ctx.sources.PathOf( id ) & ": miss (" & _
                      Tko.Modules.MissReason( s.root, Chain_( ctx, i ), key ) & ")"
            end if
            return false
        end if
        if ctx.options.verbose then print "unit " & ctx.sources.PathOf( id ) & ": hit"
    end if
    '' AN ARCHIVE NAMES ITS MEMBERS AFTER THEIR SOURCES, so the entry's obj.o is copied to the
    '' name the compile would have given it (unit.tiko).
    if ctx.options.outKind = Tko.OUT_STATICLIB then
        dim as string mp = Tko.Driver.StripExt_( ctx.sources.PathOf( id ) ) & ".o"
        fs.CopyFile( hitObj, mp, true )
        tempObjs.Push( mp )
        hitObj = mp
    end if
    linkObjs.Push( hitObj )
    Tko.Modules.ReplayLibs( ctx, hitLibs )
    return true
end function

sub Before( byref ctx as Tko.CompilerContext, byref linkObjs as Tko.StrVec, byref m as Mark )
    m.libs0 = ctx.link.pragmaLibs.Count
    m.paths0 = ctx.link.pragmaLibPaths.Count
    m.files0 = ctx.link.pragmaLibFiles.Count
    m.objs0 = linkObjs.Count
    m.errs0 = ctx.diags.ErrorCount( )
    m.warns0 = ctx.diags.WarningCount( )
end sub

function After _
    ( byref ctx as Tko.CompilerContext, byref s as Store, byval i as int32, byref key as string, _
      byref m as Mark, byref linkObjs as Tko.StrVec ) as string

    if len( key ) = 0 then return "compiled"
    if s.lookupOnly then return "checked"
    dim as string why = ""
    if ctx.diags.ErrorCount( ) <> m.errs0 then
        why = "it has errors"
    elseif ctx.diags.WarningCount( ) <> m.warns0 then
        why = "it has warnings, which a cached object would not report again"
    elseif ctx.unit.unitUsesClock then
        why = "it expands __DATE__, __DATE_ISO__ or __TIME__"
    elseif linkObjs.Count <= m.objs0 then
        why = "it made no object"
    end if
    dim as string dl
    if len( why ) = 0 then
        if Tko.Modules.ModuleCacheDeps( ctx, dl ) = false then why = "a file it read cannot be stamped"
    end if
    if len( why ) > 0 then
        '' TKO0169, a note, under -v only: a build that is merely slower is not a problem.
        if ctx.options.verbose then ctx.diags.ReportGlobal( Tko.TKO0169, ctx.sources.PathOf( cast( Tko.FileId, i ) ), why )
        return "miss"
    end if
    s.keys.Push( key )
    s.chains.Push( Chain_( ctx, i ) )
    s.objs.Push( linkObjs[linkObjs.Count - 1] )
    s.libs.Push( Tko.Modules.LibsSince( ctx, m.libs0, m.paths0, m.files0 ) )
    s.deps.Push( dl )
    return "miss"
end function

sub Commit( byref ctx as Tko.CompilerContext, byref s as Store )
    if len( s.root ) = 0 then return
    for k as int32 = 0 to s.keys.Count - 1
        if fs.IsFile( s.objs[k] ) = false then continue for
        Tko.Modules.ModuleCacheCommit( s.root, s.keys[k], s.chains[k], s.objs[k], "", s.libs[k], s.deps[k] )
    next
end sub

function Crashed( byref s as Store, byval i as int32 ) as boolean
    if s.state.Count <= i then return false
    return s.state[i] = UNIT_CRASHED
end function

sub Report( byref ctx as Tko.CompilerContext, byref s as Store, byval i as int32, byref status as string )
    if i <= s.emitted then exit sub
    dim as string st = status
    if (s.state.Count > i) andalso (s.state[i] = UNIT_CHILD) then st = "miss"
    Tko.Build.OnUnit( ctx.build, "root", ctx.sources.PathOf( cast( Tko.FileId, i ) ), st )
    s.emitted = i
end sub

'' Unit i against the cache, without compiling: its state, key, and a hit's object and libs.
private sub Probe_( byref ctx as Tko.CompilerContext, byref s as Store, byval i as int32, byval hitState as int32 )
    dim as Tko.FileId id = cast( Tko.FileId, i )
    dim as string key = Tko.Modules.UnitKey( ctx, id, Tko.Driver.IsMainUnit_( ctx, id, i ), i = 1, s.args )
    dim as string hitObj, hitIface, hitLibs
    s.pkey[i] = key
    if Tko.Modules.ModuleCacheLookup( ctx, s.root, key, hitObj, hitIface, hitLibs ) then
        s.state[i] = hitState
        s.pobj[i] = hitObj
        s.plibs[i] = hitLibs
    end if
end sub

'' Send the events of every unit from the frontier on whose outcome is settled -- a hit, or
'' a child's that the cache now holds -- and stop at the first that is not: the loop sends
'' that one, and the rest, in order. So the events come in unit order whatever order the
'' children finish in, and -j 1 and -j 8 send the same ones.
private sub Advance_( byref ctx as Tko.CompilerContext, byref s as Store, byval srcCount as int32 )
    while s.emitted < srcCount
        dim as int32 nx = s.emitted + 1
        dim as boolean settled = (s.state[nx] = UNIT_HIT) orelse (s.state[nx] = UNIT_CHILD)
        if settled = false then exit while
        Report( ctx, s, nx, "hit" )
    wend
end sub

function RunChildren _
    ( byref ctx as Tko.CompilerContext, byref s as Store, byref args as Tko.StrVec, _
      byval srcCount as int32 ) as int32

    s.emitted = 0
    if len( s.root ) = 0 then return Tko.EXIT_OK
    '' NOT IN A CHILD, and not for an archive, whose module members every child would write
    '' beside the output at once (modbuild.tiko ArchiveMemberPath).
    if ctx.options.buildOnlyUnit > 0 then return Tko.EXIT_OK
    if ctx.options.outKind = Tko.OUT_STATICLIB then return Tko.EXIT_OK
    if s.lookupOnly then return Tko.EXIT_OK
    dim as int32 jobs = Tko.Spawn.DefaultJobs( )
    if (jobs < 2) orelse (srcCount < 2) then return Tko.EXIT_OK
    dim as string exe = Tko.Platform.SelfPath( )
    if len( exe ) = 0 then return Tko.EXIT_OK

    '' THE PROBE: every root against the cache.
    for i as int32 = 0 to srcCount
        '' cast: an enum CONSTANT passed byref arrives as 0 -- tiko's own bug, which the seed
        '' that builds this source has too (repro in the B4 notes); a cast is an expression.
        s.state.Push( cast( uint32, UNIT_MISS ) ) : s.pkey.Push( "" ) : s.pobj.Push( "" ) : s.plibs.Push( "" )
    next
    dim as Tko.IdVec misses
    for i as int32 = 1 to srcCount
        Probe_( ctx, s, i, UNIT_HIT )
        if s.state[i] = UNIT_MISS then misses.Push( i )
        '' -v's line for the unit, as TryHit prints it when no probe ran -- and the miss's
        '' reason now, before a child's entry replaces the key it is told against.
        if ctx.options.verbose then
            dim as string pth = ctx.sources.PathOf( cast( Tko.FileId, i ) )
            if s.state[i] = UNIT_HIT then
                print "unit " & pth & ": hit"
            else
                print "unit " & pth & ": miss (" & Tko.Modules.MissReason( s.root, Chain_( ctx, i ), s.pkey[i] ) & ")"
            end if
        end if
    next
    Advance_( ctx, s, srcCount )
    if misses.Count < 2 then return Tko.EXIT_OK

    '' THE CHILDREN: this run's command line, each argument quoted, plus the one root.
    dim as string base_ = ""
    for each a as string in args
        base_ &= Tko.Spawn.QuoteArg( a ) & " "
    next
    dim as int32 rc = Tko.EXIT_OK
    dim as Tko.IdVec running
    dim as containers.Array( of int64 ) procs
    dim as int32 nextMiss = 0
    dim as boolean stopStarting = false
    while (nextMiss < misses.Count) orelse (running.Count > 0)
        '' Start up to the budget -- none after a child failed: the loop compiles the rest.
        while (stopStarting = false) andalso (nextMiss < misses.Count) andalso (running.Count < jobs)
            dim as int32 u = misses[nextMiss]
            nextMiss += 1
            dim as Tko.Spawn.Proc p = Tko.Spawn.Start( exe, base_ & "--build-only-unit " & u, true )
            if p = 0 then
                s.state[u] = UNIT_REDO
                continue while
            end if
            running.Push( u ) : procs.Push( p )
        wend
        if running.Count = 0 then exit while
        '' The OLDEST child first: one wait at a time, and the events want the earliest units.
        dim as int32 u0 = running[0]
        dim as int32 crc = Tko.Spawn.Wait( procs[0] )
        for k as int32 = 1 to running.Count - 1
            running[k - 1] = running[k] : procs[k - 1] = procs[k]
        next
        running.Pop( ) : procs.Pop( )
        '' A tiko exits 0 to 5; anything else is a crash (Windows' 0xC0000005 reads negative).
        if (crc < -1) orelse (crc > Tko.EXIT_TOOL_FAILED) then
            s.state[u0] = UNIT_CRASHED
            rc = Tko.Driver.ToolFail_( ctx, Tko.EXIT_CHILD_CRASHED, Tko.TKO0167, _
                    ctx.sources.PathOf( cast( Tko.FileId, u0 ) ), str( crc ) )
            stopStarting = true
            continue while
        end if
        if crc <> Tko.EXIT_OK then stopStarting = true
        '' Did it store the unit? Then this run links its entry; else the loop compiles it.
        s.state[u0] = UNIT_REDO
        Probe_( ctx, s, u0, UNIT_CHILD )
        if ctx.options.verbose andalso (s.state[u0] = UNIT_CHILD) then
            print "unit " & ctx.sources.PathOf( cast( Tko.FileId, u0 ) ) & ": compiled by a parallel job"
        end if
        Advance_( ctx, s, srcCount )
    wend
    return rc
end function


'' ---- A LINK THAT HAS NOTHING NEW (tiko-build B5, RFC 6.4) -----------------------------------
''
'' A RECORD IN THE POOL (modcache.ti LinkRecordPath) says what the artefact's last link was
'' made of: the compiler, the command line less its inputs, and every object and library
'' file with its size and write time -- a root just compiled has a new time, a cache hit the
'' entry's own -- and, last, the artefact as it was left. A 'tiko build' whose link would
'' read the same skips it; anything that differs, the artefact deleted or touched included,
'' links. A classic run never skips, nor a build with no pool: "" is no signature.
''
'' It was '<output>.link', beside the artefact: one more file in the user's output directory,
'' removed by nothing but 'tiko clean'. In the pool it is trimmed like an entry; a record
'' that outlives its artefact cannot match, since it names the artefact's stamp.
'' True the first time 'key' is offered to 'seen', false after. A SET: it was one string of
'' NUL-separated keys searched with instr, every request a scan of all before it.
private function FirstTime_( byref seen as containers.Set( of string ), byref key as string ) as boolean
    return seen.Add( key )
end function

'' A LIBRARY ONCE, by the rule the link line itself applies (codegen/toolchain.tiko): on a COFF
'' target the name is case-folded and a trailing '.dll' dropped, so 'dwmapi.dll', 'DWMAPI.DLL'
'' and 'dwmapi' are one '-ldwmapi'; elsewhere the name is compared as written. Every
'' 'declare ... lib "dwmapi.dll"' is a request of its own -- AfxNova's DWM header makes 31 --
'' and the record listed each one. The first spelling is the one recorded.
private function LibKey_( byref l as string, byval coff as boolean ) as string
    if coff = false then return l
    dim as string k = lcase( l )
    if (len( k ) > 4) andalso (right( k, 4 ) = ".dll") then k = left( k, len( k ) - 4 )
    return k
end function

function LinkSignature _
    ( byref ctx as Tko.CompilerContext, byref s as Store, byref args as Tko.StrVec, _
      byref linkObjs as Tko.StrVec ) as string
    if (ctx.build = nullptr) orelse (len( ctx.options.outputPath ) = 0) then return ""
    if len( s.root ) = 0 then return ""
    dim as string rec = Tko.Modules.LinkRecordPath( ctx.options.outputPath )
    if len( rec ) = 0 then return ""
    dim as string stamp_ = Tko.DiskCache.CompilerStamp( )
    if len( stamp_ ) = 0 then return ""
    dim as string nl = chr( 10 )
    '' Format 2: libraries, library paths and library files each once (format 1 listed every
    '' request). A record of the other format never matches, so the first build relinks.
    dim as string sig = "link-format 2" & nl & "tiko " & stamp_ & nl & "args" & ArgsLine_( ctx, args ) & nl
    for each o as string in linkObjs
        sig &= "obj " & Tko.DiskCache.Stamp( o ) & chr( 9 ) & Tko.Modules.AbsPath( o ) & nl
    next
    dim as boolean coff = (Tko.Codegen.TargetFor( ctx.options.target ).objFormat = Tko.Codegen.OBJ_COFF)
    dim as containers.Set( of string ) seen
    for each l as string in ctx.link.pragmaLibs
        if FirstTime_( seen, "lib " & LibKey_( l, coff ) ) then sig &= "lib " & l & nl
    next
    for each l as string in ctx.link.pragmaLibPaths
        if FirstTime_( seen, "libpath " & l ) then sig &= "libpath " & l & nl
    next
    for each l as string in ctx.link.pragmaLibFiles
        if FirstTime_( seen, "libfile " & l ) then sig &= "libfile " & Tko.DiskCache.Stamp( l ) & chr( 9 ) & l & nl
    next
    sig &= "mt " & iif( Tko.LinkThreadSafe( ctx ), 1, 0 ) & nl
    return sig
end function

function LinkUpToDate( byref ctx as Tko.CompilerContext, byref sig as string ) as boolean
    if len( sig ) = 0 then return false
    dim as string art = Tko.DiskCache.Stamp( ctx.options.outputPath )
    if len( art ) = 0 then return false
    dim as string rec = Tko.Modules.LinkRecordPath( ctx.options.outputPath )
    dim as string had
    if Tko.DiskCache.ReadAll( rec, had ) = false then return false
    if had <> sig & "artifact " & art & chr( 10 ) then return false
    '' ...and written again, so a link skipped for a week is not trimmed as unused.
    Tko.DiskCache.Commit( rec, had, 0 )
    return true
end function

sub LinkRecord( byref ctx as Tko.CompilerContext, byref sig as string, byval linked as boolean )
    if len( sig ) = 0 then return
    '' The record an older tiko left beside the artefact goes too.
    if fs.IsFile( ctx.options.outputPath & ".link" ) then kill( ctx.options.outputPath & ".link" )
    dim as string rec = Tko.Modules.LinkRecordPath( ctx.options.outputPath )
    if fs.IsFile( rec ) then fs.RemoveFile( rec )
    if linked = false then return
    dim as string art = Tko.DiskCache.Stamp( ctx.options.outputPath )
    if len( art ) = 0 then return
    dim as string ld = Tko.Modules.DirOfFile( rec )
    if fs.IsDir( ld ) = false then fs.CreateDirAll( ld )
    Tko.DiskCache.Commit( rec, sig & "artifact " & art & chr( 10 ), 0 )
end sub

end namespace
