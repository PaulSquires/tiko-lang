'' manifest.tiko -- a package's tiko.toml (ADR 0017; RFC-0007 §2).
''
'' A TOML SUBSET, read line by line: '#' comments, '[table]' and '[a.b.c]' headers, bare and
'' quoted keys, basic strings with \\ \" \n \t \uXXXX, literal strings, integers, booleans,
'' inline tables and single-line arrays of strings. Anything else -- a multi-line string, a
'' float, a date, an array of tables -- is TKO0144 with the line, and so is a key or table
'' the manifest does not have. What is read:
''
''     [package]                  name (required); version, description, license, authors,
''                                repository accepted and unused (v2's)
''     [dependencies]             x = { path = "..." }, or a [dependencies.x] table
''     [defines]                  NAME = "value": the package's modules see NAME
''     [dependencies.x.defines]   the root's say over dependency x's defines
''     [vendor.<module>]          links = ["static", "dynamic"]: the link modes the module
''                                ships, for '#import ... link' (tiko-vendor RFC-0002 V7, V10);
''                                runtime = ["..."]: files copied beside a program that
''                                imports the module, relative to its directory

#import "std/containers"
#import "std/fs"
#include once "driver/manifest.ti"
#include once "driver/modresolve.ti"
#include once "support/diskcache.ti"
#include once "support/text.ti"

namespace Tko.Modules

function HasManifest( byref dir_ as string ) as boolean
    return fs.IsFile( JoinPath( dir_, "tiko.toml" ) )
end function

type TomlCursor_
    as string  s
    as int32    p             '' 1-based
    as string  err_
end type

private sub Ws_( byref c as TomlCursor_ )
    while c.p <= len( c.s )
        dim as uint8 ch = c.s[c.p - 1]
        if (ch <> 32) andalso (ch <> 9) then exit while
        c.p += 1
    wend
end sub

private function AtEnd_( byref c as TomlCursor_ ) as boolean
    Ws_( c )
    if c.p > len( c.s ) then return true
    return c.s[c.p - 1] = asc( "#" )
end function

'' A key: bare [A-Za-z0-9_-]+, or a quoted string.
private function Key_( byref c as TomlCursor_, byref k as string ) as boolean
    Ws_( c )
    if c.p > len( c.s ) then return false
    dim as uint8 ch = c.s[c.p - 1]
    if (ch = 34) orelse (ch = 39) then
        dim as int32 q = instr( c.p + 1, c.s, chr( ch ) )
        if q = 0 then
            c.err_ = "unterminated quoted key"
            return false
        end if
        k = mid( c.s, c.p + 1, q - c.p - 1 )
        c.p = q + 1
        return true
    end if
    dim as int32 st = c.p
    while c.p <= len( c.s )
        ch = c.s[c.p - 1]
        dim as boolean ok = ((ch >= 48) andalso (ch <= 57)) orelse ((ch >= 65) andalso (ch <= 90)) orelse _
                            ((ch >= 97) andalso (ch <= 122)) orelse (ch = 95) orelse (ch = 45)
        if ok = false then exit while
        c.p += 1
    wend
    if c.p = st then
        c.err_ = "expected a key"
        return false
    end if
    k = mid( c.s, st, c.p - st )
    return true
end function

'' A value, as its text: a string's contents, an integer or a boolean spelled as written.
'' kind: "s" string, "i" integer, "b" boolean, "t" inline table (text between the braces),
'' "a" array (the strings, chr(10)-separated).
private function Value_( byref c as TomlCursor_, byref v as string, byref kind as string ) as boolean
    Ws_( c )
    if c.p > len( c.s ) then
        c.err_ = "expected a value"
        return false
    end if
    dim as uint8 ch = c.s[c.p - 1]
    if ch = 34 then
        if mid( c.s, c.p, 3 ) = chr( 34, 34, 34 ) then
            c.err_ = "multi-line strings are not in the subset tiko reads"
            return false
        end if
        v = ""
        c.p += 1
        while c.p <= len( c.s )
            ch = c.s[c.p - 1]
            if ch = 34 then
                c.p += 1
                kind = "s"
                return true
            end if
            if ch = 92 then
                c.p += 1
                if c.p > len( c.s ) then exit while
                dim as uint8 e = c.s[c.p - 1]
                select case e
                case 92 : v &= chr( 92 )
                case 34 : v &= chr( 34 )
                case asc( "n" ) : v &= chr( 10 )
                case asc( "t" ) : v &= chr( 9 )
                case asc( "u" )
                    dim as int32 cp = valint( "&h" & mid( c.s, c.p + 1, 4 ) )
                    if cp < 128 then v &= chr( cp ) else v &= "?"
                    c.p += 4
                case else
                    c.err_ = "unknown escape in a string"
                    return false
                end select
                c.p += 1
                continue while
            end if
            v &= chr( ch )
            c.p += 1
        wend
        c.err_ = "unterminated string"
        return false
    end if
    if ch = 39 then
        dim as int32 q = instr( c.p + 1, c.s, "'" )
        if q = 0 then
            c.err_ = "unterminated string"
            return false
        end if
        v = mid( c.s, c.p + 1, q - c.p - 1 )
        c.p = q + 1
        kind = "s"
        return true
    end if
    if ch = asc( "{" ) then
        dim as int32 q = instr( c.p, c.s, "}" )
        if q = 0 then
            c.err_ = "unterminated inline table"
            return false
        end if
        v = mid( c.s, c.p + 1, q - c.p - 1 )
        c.p = q + 1
        kind = "t"
        return true
    end if
    if ch = asc( "[" ) then
        dim as TomlCursor_ a
        a.s = mid( c.s, c.p + 1 )
        a.p = 1
        v = ""
        dim as int32 n = 0
        do
            Ws_( a )
            if a.p > len( a.s ) then
                c.err_ = "unterminated array (arrays are single-line)"
                return false
            end if
            if a.s[a.p - 1] = asc( "]" ) then exit do
            dim as string one_, k2
            if Value_( a, one_, k2 ) = false then
                c.err_ = a.err_
                return false
            end if
            if k2 <> "s" then
                c.err_ = "only arrays of strings are in the subset tiko reads"
                return false
            end if
            '' AN EMPTY STRING NAMES NOTHING -- no file, no library, no option, no directory --
            '' and the elements travel joined by LF, where it would vanish: 'copy_to = [""]'
            '' copied nowhere and said nothing. The directory of tiko.toml itself is ".".
            if len( one_ ) = 0 then
                c.err_ = "an empty string in an array names nothing (tiko.toml's own directory is ""."")"
                return false
            end if
            v &= iif( n > 0, chr( 10 ), "" ) & one_
            n += 1
            Ws_( a )
            if (a.p <= len( a.s )) andalso (a.s[a.p - 1] = asc( "," )) then a.p += 1
        loop
        c.p += a.p + 1   '' past the closing bracket: it stopped ON it, and every array was "text after the value"
        kind = "a"
        return true
    end if
    dim as int32 st = c.p
    while c.p <= len( c.s )
        ch = c.s[c.p - 1]
        if (ch = 32) orelse (ch = 9) orelse (ch = asc( "," )) orelse (ch = asc( "}" )) orelse (ch = asc( "#" )) then exit while
        c.p += 1
    wend
    v = mid( c.s, st, c.p - st )
    if (v = "true") orelse (v = "false") then
        kind = "b"
        return true
    end if
    dim as boolean digits = (len( v ) > 0)
    for i as int32 = 0 to len( v ) - 1
        dim as uint8 d = v[i]
        dim as boolean ok = ((d >= 48) andalso (d <= 57)) orelse ((i = 0) andalso ((d = 43) orelse (d = 45))) orelse (d = 95)
        if ok = false then digits = false
    next
    if digits then
        kind = "i"
        return true
    end if
    c.err_ = "'" & v & "' is not a value tiko reads (floats and dates are not in the subset)"
    return false
end function

'' { path = "../x" }: the path, or "" with the reason in err_.
private function InlinePath_( byref inner as string, byref err_ as string ) as string
    dim as TomlCursor_ c
    c.s = inner
    c.p = 1
    dim as string path_ = ""
    do
        Ws_( c )
        if c.p > len( c.s ) then exit do
        dim as string k, v, kind
        if Key_( c, k ) = false then
            err_ = c.err_
            return ""
        end if
        Ws_( c )
        if (c.p > len( c.s )) orelse (c.s[c.p - 1] <> asc( "=" )) then
            err_ = "expected '=' after '" & k & "'"
            return ""
        end if
        c.p += 1
        if Value_( c, v, kind ) = false then
            err_ = c.err_
            return ""
        end if
        if k = "path" then
            if kind <> "s" then
                err_ = "a dependency's path is a string"
                return ""
            end if
            path_ = v
        elseif k <> "version" then
            err_ = "a dependency takes 'path' in v1, not '" & k & "'"
            return ""
        end if
        Ws_( c )
        if (c.p <= len( c.s )) andalso (c.s[c.p - 1] = asc( "," )) then c.p += 1
    loop
    if len( path_ ) = 0 then err_ = "a dependency needs 'path' in v1"
    return path_
end function

'' A NAME in [target.NAME] / [profile.NAME]: a word an output file can be named after.
private function BuildName_( byref n as string ) as boolean
    if len( n ) = 0 then return false
    for i as int32 = 0 to len( n ) - 1
        dim as uint8 ch = n[i]
        dim as boolean ok = ((ch >= 97) andalso (ch <= 122)) orelse ((ch >= 48) andalso (ch <= 57)) orelse _
                            (ch = 95) orelse (ch = 45)
        if ok = false then return false
    next
    return true
end function

'' The OS tables of a target: [target.x.windows], [target.x.linux], [target.x.macos] hold the
'' array keys that are true of a build for that OS only -- a '.rc' that a Linux build refuses
'' (TKO0108), a library one platform has. They add to the target's own; another OS's are dropped.
private function OsTable_( byref s as string ) as boolean
    return (s = "windows") orelse (s = "linux") orelse (s = "macos")
end function

'' [target.x], [target.x.defines], [target.x.<os>], [profile.x]: "" when the header is one,
'' else why not.
private function BuildTable_( byref m as Manifest, byref table_ as string ) as string
    dim as boolean isT = (left( table_, 7 ) = "target.")
    if (isT = false) andalso (left( table_, 8 ) <> "profile.") then return "unknown table [" & table_ & "]"
    dim as string rest = mid( table_, iif( isT, 8, 9 ) )
    dim as int32 dt = instr( rest, "." )
    if dt > 0 then
        dim as string sub_ = mid( rest, dt + 1 )
        if (isT = false) orelse ((sub_ <> "defines") andalso (OsTable_( sub_ ) = false)) then return "unknown table [" & table_ & "]"
        rest = left( rest, dt - 1 )
    end if
    if BuildName_( rest ) = false then
        return "'" & rest & "' is not a name a target or profile may have (letters, digits, '_' and '-')"
    end if
    dim as boolean seen = false
    if isT then
        for each x as string in m.targetNames
            if x = rest then seen = true
        next
        if seen = false then m.targetNames.Push( rest )
    else
        for each x as string in m.profileNames
            if x = rest then seen = true
        next
        if seen = false then m.profileNames.Push( rest )
    end if
    return ""
end function

'' [vendor.<module>] runtime = ["fonts/x.ttf", "lib/x"]: "" when it is one, else why not. Each
'' entry is a path below the module's directory -- '..' may climb out of it, as '#foreignlib'
'' "../lib/x" does -- never an absolute one, which would tie the package to one machine.
private function RuntimeKey_ _
    ( byref m as Manifest, byref table_ as string, byref v as string, byref kind as string ) as string
    if kind <> "a" then return "'runtime' in [" & table_ & "] is an array of strings"
    if len( v ) = 0 then return "'runtime' in [" & table_ & "] is empty"
    dim as int32 st = 1
    while st <= len( v )
        dim as int32 nl_ = instr( st, v, chr( 10 ) )
        if nl_ = 0 then nl_ = len( v ) + 1
        dim as string one = mid( v, st, nl_ - st )
        st = nl_ + 1
        dim as uint8 c0 = one[0]
        if (c0 = 47) orelse (c0 = 92) orelse (instr( one, ":" ) > 0) then
            return "'runtime' in [" & table_ & "] holds paths relative to the module's directory, not '" & one & "'"
        end if
    wend
    m.vendorRtMods.Push( mid( table_, 8 ) )
    m.vendorRtFiles.Push( v )
    return ""
end function

private function OneOf_( byref v as string, byref allowed as string ) as boolean
    return instr( "|" & allowed & "|", "|" & v & "|" ) > 0
end function

'' One 'key = value' inside a [target.x] / [target.x.defines] / [target.x.<os>] / [profile.x] table.
private function BuildKey_ _
    ( byref m as Manifest, byref table_ as string, byref k as string, byref v as string, _
      byref kind as string ) as string

    dim as boolean isT = (left( table_, 7 ) = "target.")
    dim as string rest = mid( table_, iif( isT, 8, 9 ) )
    dim as int32 dt = instr( rest, "." )
    if dt > 0 then
        dim as string sub_ = mid( rest, dt + 1 )
        if OsTable_( sub_ ) then
            select case k
            case "sources", "resources", "libs", "libpaths", "options"
            case else
                return "unknown key '" & k & "' in [" & table_ & "]: an OS table holds sources, " & _
                       "resources, libs, libpaths and options"
            end select
            if kind <> "a" then return "'" & k & "' in [" & table_ & "] is an array of strings"
            m.tgtName.Push( left( rest, dt - 1 ) ) : m.tgtKey.Push( k & "@" & sub_ ) : m.tgtVal.Push( v )
            return ""
        end if
        if kind <> "s" then return "a define's value is a string"
        m.tgtName.Push( left( rest, dt - 1 ) ) : m.tgtKey.Push( "define" ) : m.tgtVal.Push( k & "=" & v )
        return ""
    end if
    dim as string want, allowed
    if isT then
        select case k
        case "kind"      : want = "s" : allowed = "exe|dll|lib"
        case "subsystem" : want = "s" : allowed = "gui|console"
        case "main", "output" : want = "s"
        case "sources", "resources", "libs", "libpaths", "options", "copy_to" : want = "a"
        case "inherits", "errors", "opt", "debug"
            return "unknown key '" & k & "' in [" & table_ & "]: it is a [profile.<name>] key, " & _
                   "and a key belongs to the table header above it"
        case else
            return "unknown key '" & k & "' in [" & table_ & "]"
        end select
    else
        select case k
        case "inherits" : want = "s"
        case "errors"   : want = "s" : allowed = "|e|ex|exx"
        case "opt"      : want = "i" : allowed = "0|1|2|3"
        case "debug"    : want = "b"
        case "options"  : want = "a"
        '' A TARGET'S KEY UNDER A PROFILE, the usual way: written after the last table header
        '' of the file -- an editor's [profile.editor], say -- where TOML gives it to that table.
        case "main", "output", "kind", "subsystem", "sources", "resources", "libs", "libpaths", "copy_to"
            return "unknown key '" & k & "' in [" & table_ & "]: it is a [target.<name>] key, " & _
                   "and a key belongs to the table header above it"
        case else
            return "unknown key '" & k & "' in [" & table_ & "]"
        end select
    end if
    if kind <> want then
        dim as string what = "a string"
        if want = "a" then what = "an array of strings"
        if want = "i" then what = "an integer"
        if want = "b" then what = "true or false"
        return "'" & k & "' in [" & table_ & "] is " & what
    end if
    if (len( allowed ) > 0) andalso (OneOf_( v, allowed ) = false) then
        return "'" & k & "' in [" & table_ & "] is one of " & allowed & ", not '" & v & "'"
    end if
    if isT then
        m.tgtName.Push( rest ) : m.tgtKey.Push( k ) : m.tgtVal.Push( v )
    else
        m.prfName.Push( rest ) : m.prfKey.Push( k ) : m.prfVal.Push( v )
    end if
    return ""
end function

function LoadManifest _
    ( byref ctx as Tko.CompilerContext, byref dir_ as string, byref m as Manifest ) as boolean

    dim as string file_ = JoinPath( dir_, "tiko.toml" )
    dim as string text_
    if Tko.DiskCache.ReadAll( file_, text_ ) = false then return false
    m.dir_ = NormPath( dir_ )
    m.name = ""
    dim as string table_ = ""
    dim as int32 lineNo = 0
    dim as int32 p = 1
    dim as boolean ok = true
    while p <= len( text_ )
        dim as int32 e = instr( p, text_, chr( 10 ) )
        if e = 0 then e = len( text_ ) + 1
        dim as string ln = mid( text_, p, e - p )
        p = e + 1
        lineNo += 1
        if right( ln, 1 ) = chr( 13 ) then ln = left( ln, len( ln ) - 1 )
        dim as TomlCursor_ c
        c.s = ln
        c.p = 1
        if AtEnd_( c ) then continue while
        dim as string why = ""
        if c.s[c.p - 1] = asc( "[" ) then
            if mid( c.s, c.p, 2 ) = "[[" then
                why = "arrays of tables are not in the subset tiko reads"
            else
                dim as int32 q = instr( c.p, c.s, "]" )
                if q = 0 then
                    why = "unterminated table header"
                else
                    table_ = Tko.Text.LowerAscii( trim( mid( c.s, c.p + 1, q - c.p - 1 ) ) )
                    c.p = q + 1
                    if AtEnd_( c ) = false then why = "text after a table header"
                    dim as boolean known = (table_ = "package") orelse (table_ = "dependencies") orelse (table_ = "defines")
                    if (known = false) andalso (left( table_, 7 ) = "vendor.") then
                        known = true
                        dim as string vm = mid( table_, 8 )
                        dim as boolean okName = (len( vm ) > 0)
                        for q as int32 = 0 to len( vm ) - 1
                            dim as uint8 ch = vm[q]
                            dim as boolean wordCh = ((ch >= 97) andalso (ch <= 122)) orelse ((ch >= 48) andalso (ch <= 57)) orelse _
                                                    (ch = 95) orelse (ch = 46)
                            if wordCh = false then okName = false
                        next
                        if okName = false then why = "'" & vm & "' in [vendor.<module>] is not a module path"
                    end if
                    if known = false then
                        dim as boolean depT = (left( table_, 13 ) = "dependencies.")
                        if depT = false then why = BuildTable_( m, table_ )
                    end if
                end if
            end if
        else
            dim as string k, v, kind
            if Key_( c, k ) = false then
                why = c.err_
            else
                Ws_( c )
                if (c.p > len( c.s )) orelse (c.s[c.p - 1] <> asc( "=" )) then
                    why = "expected '=' after '" & k & "'"
                else
                    c.p += 1
                    if Value_( c, v, kind ) = false then
                        why = c.err_
                    elseif AtEnd_( c ) = false then
                        why = "text after the value of '" & k & "'"
                    end if
                end if
            end if
            if len( why ) = 0 then
                select case table_
                case "package"
                    select case k
                    case "name"
                        if kind <> "s" then why = "[package] name is a string" else m.name = Tko.Text.LowerAscii( v )
                    case "version", "description", "license", "authors", "repository"
                    case else
                        why = "unknown key '" & k & "' in [package]"
                    end select
                case "dependencies"
                    if kind <> "t" then
                        why = "a dependency is an inline table: " & k & " = { path = ""..."" }"
                    else
                        dim as string pth = InlinePath_( v, why )
                        if len( why ) = 0 then
                            m.depNames.Push( Tko.Text.LowerAscii( k ) )
                            m.depPaths.Push( JoinPath( m.dir_, pth ) )
                        end if
                    end if
                case "defines"
                    if kind <> "s" then why = "a define's value is a string" else m.defines.Push( k & "=" & v )
                case else
                    if left( table_, 7 ) = "vendor." then
                        if k = "runtime" then
                            why = RuntimeKey_( m, table_, v, kind )
                        elseif k <> "links" then
                            why = "unknown key '" & k & "' in [" & table_ & "]"
                        elseif kind <> "a" then
                            why = "'links' in [" & table_ & "] is an array of strings"
                        else
                            dim as string modes = "|"
                            dim as int32 st = 1
                            while st <= len( v )
                                dim as int32 nl_ = instr( st, v, chr( 10 ) )
                                if nl_ = 0 then nl_ = len( v ) + 1
                                dim as string one = mid( v, st, nl_ - st )
                                st = nl_ + 1
                                if (one <> "static") andalso (one <> "dynamic") then
                                    why = "'links' in [" & table_ & "] holds ""static"" and ""dynamic"", not '" & one & "'"
                                end if
                                modes &= one & "|"
                            wend
                            if modes = "|" then why = "'links' in [" & table_ & "] is empty"
                            if len( why ) = 0 then
                                m.vendorMods.Push( mid( table_, 8 ) )
                                m.vendorLinks.Push( modes )
                            end if
                        end if
                        exit select
                    end if
                    if (left( table_, 7 ) = "target.") orelse (left( table_, 8 ) = "profile.") then
                        why = BuildKey_( m, table_, k, v, kind )
                        exit select
                    end if
                    '' [dependencies.x] or [dependencies.x.defines]
                    dim as string rest = mid( table_, 14 )
                    dim as int32 dt = instr( rest, "." )
                    if dt = 0 then
                        if k <> "path" then
                            why = "a dependency takes 'path' in v1, not '" & k & "'"
                        elseif kind <> "s" then
                            why = "a dependency's path is a string"
                        else
                            m.depNames.Push( rest )
                            m.depPaths.Push( JoinPath( m.dir_, v ) )
                        end if
                    elseif mid( rest, dt + 1 ) = "defines" then
                        if kind <> "s" then
                            why = "a define's value is a string"
                        else
                            m.ddDep.Push( left( rest, dt - 1 ) )
                            m.ddDefine.Push( k & "=" & v )
                        end if
                    else
                        why = "unknown table [" & table_ & "]"
                    end if
                end select
                if len( table_ ) = 0 then why = "'" & k & "' is outside any table"
            end if
        end if
        if len( why ) > 0 then
            ctx.diags.ReportGlobal( Tko.TKO0144, file_ & "(" & lineNo & "): " & why )
            ok = false
        end if
    wend
    if ok andalso (len( m.name ) = 0) then
        ctx.diags.ReportGlobal( Tko.TKO0144, file_ & ": [package] name is required" )
        ok = false
    end if
    return ok
end function

end namespace
