'' cicache.ti -- the #cinclude cache. D16 phase C. See cicache.tiko.

#pragma once

#include once "tko.ti"
#include once "driver/driver.ti"
#include once "cimport/import.ti"

namespace Tko.CImportDriver

'' The cache's directory: -ccachedir, else the user's cache directory. "" with -cnocache.
declare function CacheRoot( byref ctx as Tko.CompilerContext ) as string

'' The whole key: the import's own key (headers, options, UNICODE) and everything else a
'' binding depends on that is not a file clang read.
declare function CacheKey _
    ( byref ctx as Tko.CompilerContext, byref api as Tko.CImport.ClangApi, _
      byref importKey as string ) as string

'' A hit: the entry exists, its key is this one, and every file clang read is unchanged.
'' Hands back the binding's path and text and the state it seeds.
declare function CacheLookup _
    ( byref root as string, byref key as string, byref bindingPath as string, _
      byref text as string, byref state as string ) as boolean

'' Commit an entry; returns the binding's path, or "" when it could not be written.
declare function CacheStore _
    ( byref root as string, byref key as string, byref text as string, _
      byref state as string, byref deps as Tko.StrVec ) as string

end namespace
