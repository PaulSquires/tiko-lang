'' modbuild.ti -- building the modules a program imports (ADR 0017; RFC-0005 §3). See
'' modbuild.tiko.

#pragma once

#include once "tko.ti"
#include once "driver/driver.ti"

namespace Tko.Modules

'' THE MODULES THE FIRST rootCount SOURCES IMPORT, each compiled once, dependencies first,
'' into an object that joins the link. Nothing when no root imports anything. False, with
'' the reason reported, when the graph or a module failed.
'' 'scanOnly' IS THE EDITOR SCAN (src/driver/scan.tiko): each module runs the front end only,
'' publishes its interface and is harvested -- no object, and the module cache is neither
'' read nor written (nor its directory made).
declare function BuildImports _
    ( byref ctx as Tko.CompilerContext, byval rootCount as int32, _
      byref linkObjs as Tko.StrVec, byref tempObjs as Tko.StrVec, _
      byref toolExit as int32, byval scanOnly as boolean = false ) as boolean

'' WHERE A MODULE'S OBJECT GOES when the output is a static library, whose members keep
'' their names: '<chain>.o' beside the archive -- 'std.strings.o'.
declare function ArchiveMemberPath( byref ctx as Tko.CompilerContext ) as string
declare function LibsSince _
    ( byref ctx as Tko.CompilerContext, byval libs0 as int32, byval paths0 as int32, _
      byval files0 as int32 ) as string
declare sub ReplayLibs( byref ctx as Tko.CompilerContext, byref libs as string )

'' '--emit-tki <dir>': THE INTERFACE OF THE MODULE IN dir_, printed, built the way a program
'' that imports it builds it -- its own imports first, its package's [defines] applied, the
'' module cache used -- because a module that imports is compiled against interfaces only
'' that build makes. The exit code.
declare function EmitInterface( byref ctx as Tko.CompilerContext, byref dir_ as string ) as int32

end namespace
