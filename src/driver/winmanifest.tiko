'' winmanifest.tiko -- see the header.

#import "std/containers"
#include once "driver/winmanifest.ti"
#include once "support/text.ti"

namespace Tko
namespace WinManifest

function DefaultXml( ) as string
    dim as string nl = chr( 13, 10 )
    return "<?xml version=""1.0"" encoding=""UTF-8"" standalone=""yes""?>" & nl _
         & "<assembly xmlns=""urn:schemas-microsoft-com:asm.v1"" manifestVersion=""1.0"">" & nl _
         & "  <trustInfo xmlns=""urn:schemas-microsoft-com:asm.v3"">" & nl _
         & "    <security>" & nl _
         & "      <requestedPrivileges>" & nl _
         & "        <requestedExecutionLevel level=""asInvoker"" uiAccess=""false""/>" & nl _
         & "      </requestedPrivileges>" & nl _
         & "    </security>" & nl _
         & "  </trustInfo>" & nl _
         & "  <compatibility xmlns=""urn:schemas-microsoft-com:compatibility.v1"">" & nl _
         & "    <application>" & nl _
         & "      <supportedOS Id=""{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}""/>" & nl _
         & "      <supportedOS Id=""{1f676c76-80e1-4239-95bb-83d0f6d0da78}""/>" & nl _
         & "      <supportedOS Id=""{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}""/>" & nl _
         & "      <supportedOS Id=""{35138b9a-5d96-4fbd-8e2d-a2440225f93a}""/>" & nl _
         & "    </application>" & nl _
         & "  </compatibility>" & nl _
         & "  <application xmlns=""urn:schemas-microsoft-com:asm.v3"">" & nl _
         & "    <windowsSettings>" & nl _
         & "      <dpiAware xmlns=""http://schemas.microsoft.com/SMI/2005/WindowsSettings"">true/pm</dpiAware>" & nl _
         & "      <dpiAwareness xmlns=""http://schemas.microsoft.com/SMI/2016/WindowsSettings"">PerMonitorV2, PerMonitor</dpiAwareness>" & nl _
         & "    </windowsSettings>" & nl _
         & "  </application>" & nl _
         & "</assembly>" & nl
end function

'' A little-endian WORD at 0-based offset o of s.
private function Word_( byref s as string, byval o as int64 ) as uint32
    return cast( uint32, asc( s, o + 1 ) ) or (cast( uint32, asc( s, o + 2 ) ) shl 8)
end function

private function Dword_( byref s as string, byval o as int64 ) as uint32
    return Word_( s, o ) or (Word_( s, o + 2 ) shl 16)
end function

'' The '.res' format: entries, each a header -- DataSize, HeaderSize, TYPE, NAME (each 0xFFFF and an
'' ordinal WORD, or a NUL-ended UTF-16 name), then version, flags, language and characteristics --
'' and its data, every entry aligned to a DWORD. The first is an empty one (type 0).
function ResHasManifest( byref path as string ) as boolean
    dim as int32 fh = freefile
    if open( path for binary access read as #fh ) <> 0 then return false
    dim as int64 n = lof( fh )
    dim as string s = space( n )
    if n > 0 then get #fh, , s
    close #fh
    dim as int64 o = 0
    while o + 32 <= n
        dim as int64 dataSize = Dword_( s, o )
        dim as int64 headerSize = Dword_( s, o + 4 )
        if (headerSize < 16) orelse (o + headerSize + dataSize > n) then return false
        if Word_( s, o + 8 ) = &hFFFF then
            if Word_( s, o + 10 ) = 24 then return true
        end if
        o += headerSize + dataSize
        o = (o + 3) and not 3
    wend
    return false
end function

private function Header_( byval dataSize as uint32, byval typeOrd as int32, byval nameOrd as int32, byval flags as int32, byval lang as int32 ) as string
    return mkl( dataSize ) & mkl( 32 ) & mkshort( -1 ) & mkshort( typeOrd ) & mkshort( -1 ) & mkshort( nameOrd ) _
         & mkl( 0 ) & mkshort( flags ) & mkshort( lang ) & mkl( 0 ) & mkl( 0 )
end function

function WriteDefaultRes( byref path as string ) as boolean
    dim as string xml = DefaultXml( )
    '' the empty entry every .res starts with, then RT_MANIFEST 1: moveable, pure, discardable; US English
    dim as string body = mkl( 0 ) & mkl( 32 ) & mkshort( -1 ) & mkshort( 0 ) & mkshort( -1 ) & mkshort( 0 ) _
                       & mkl( 0 ) & mkshort( 0 ) & mkshort( 0 ) & mkl( 0 ) & mkl( 0 )
    body &= Header_( len( xml ), 24, 1, &h1030, &h0409 ) & xml
    while (len( body ) and 3) <> 0
        body &= chr( 0 )
    wend
    kill( path )
    dim as int32 fh = freefile
    if open( path for binary access write as #fh ) <> 0 then return false
    put #fh, , body
    close #fh
    return true
end function

function AddToLink( byref objs as StrVec, byref temps as StrVec, byref outputPath as string, _
                    byval target as TargetId, byval outKind as OutputKind ) as string
    if (outKind <> OUT_EXE) orelse (TargetIsWindows( target ) = false) then return ""
    for i as int32 = 0 to objs.Count - 1
        dim as string o = objs[i]
        if (len( o ) > 4) andalso (Tko.Text.LowerAscii( right( o, 4 ) ) = ".res") then
            if ResHasManifest( o ) then return ""
        end if
    next
    dim as string resPath = outputPath & ".manifest.res"
    if WriteDefaultRes( resPath ) = false then return resPath
    objs.Push( resPath )
    temps.Push( resPath )
    return ""
end function

end namespace
end namespace
