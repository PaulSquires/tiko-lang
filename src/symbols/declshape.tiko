'' declshape.tiko -- WHAT AN ARRAY OR CONST DECLARATION MAY NOT SAY, beyond CheckArrayDeclShapes_
'' (latesweeps.tiko): CheckDeclShape_, asked of every N_VAR, and CheckFieldShape_, of every N_FIELD.
''
'' Included from latesweeps2.tiko, below staticdef.tiko, in the same namespace and over the same Ctx.
''
'' Measured on fbc-modern 1.20, 2026-09-29:
''
''     common array(0) as integer               error 136   COMMON's array is dynamic: no bounds
''     common array(0 to 3), common shared ...  error 136   (dim/common-with-subscript)
''     common array() / (any) as integer        fine        an EXTERN takes bounds, too
''
''     extern array(0 to ...) as integer        error 281   '...' needs an initializer to count
''     dim array(0 to ...) as integer           error 281   (dim/extern-array-init-3)
''     dim array(0 to ...) as integer = {1, 2}  fine
''
''     redim array(0 to ...) => { 1, 2 }        error 76    '...' on a DYNAMIC array
''     redim array(0 to ...) [as integer]       error 76    (dim/dynamic-ellipsis-2)
''
''     dim as const integer foo = any           error 237   a const needs a real value
''     static ... / foo(0 to 1) the same        error 237   (const/any_const)
''     dim as integer foo = any                 fine
''
'' tiko accepted each refused line.

'' TWO MORE A VARIABLE'S TYPE MAY NOT BE, measured the same day:
''
''     dim x as any  /  static x as any  /  dim as any a, b    error 24   (dim/dim-bad-datatype-1
''     dim byref x as any = ...                               error 24    writes one with an
''     dim x as any ptr                                       fine        alias "char")
''
''     type t as t : dim as t x                               error 24   (typedef/void)
''     type t as u : type u as t : dim as t x                 error 71
''     type t as t : dim as t ptr p                           fine
''
'' A typedef whose chain comes back to itself has no type at all; tiko gave the variable none
'' and said nothing.
private function TypedefCycles_ ( byref c as Ctx, byval tr as NodeId, byval scope_ as ScopeId ) as boolean
    dim as StmtPayload ptr tp = c.ast->StmtOf( tr )
    dim as SymbolId sid = c.info->RefOf( tr )
    if (sid = SYMBOL_NONE) andalso (tp->name <> 0) andalso (tp->ownerName = 0) then sid = c.syms->LookupTyped( scope_, tp->name, true )
    dim as containers.Array( of uint32 ) seen
    for hop as int32 = 0 to 31
        dim as Symbol ptr sy = c.syms->SymbolAt( sid )
        if (sy = nullptr) orelse (sy->kind <> cast( uint8, SYM_TYPEDEF )) then return false
        for s as int32 = 0 to seen.Count - 1
            if seen[s] = cast( uint32, sid ) then return true
        next
        seen.Push( cast( uint32, sid ) )
        dim as NodeId ta = cast( NodeId, sy->payload )
        if (ta = NODE_NONE) orelse (c.ast->Kind( ta ) <> N_TYPEREF) then return false
        if (c.ast->Flags( ta ) and (NF_PTR or NF_ARRAY or NF_PROC_TYPE)) <> 0 then return false
        dim as StmtPayload ptr tap = c.ast->StmtOf( ta )
        if (tap->ownerName <> 0) orelse (tap->count <> 0) orelse (tap->name = 0) then return false
        dim as SymbolId nsid = c.info->RefOf( ta )
        if nsid = SYMBOL_NONE then nsid = c.syms->LookupTyped( cast( ScopeId, sy->parent ), tap->name, true )
        sid = nsid
    next
    return false
end function

'' Is this node the bare word 'any'.
private function IsAnyNode_ ( byref c as Ctx, byval n as NodeId ) as boolean
    if (n = NODE_NONE) orelse (c.ast->Kind( n ) <> N_IDENT) then return false
    return lcase( SpellOf_( c, n ) ) = "any"
end function

'' A BARE 'zstring' OR 'wstring' AS A VARIABLE'S OR A FIELD'S TYPE -- fbc's error 28, "Expected
'' pointer", for every way to declare one, measured on fbc-modern 1.20, 2026-10-16:
''
''     extern / dim / dim shared / static / common / redim  x as zstring      error 28
''     dim x() as zstring, extern x(0 to 3) as wstring, 'dim as zstring x'   error 28
''     type T : f as zstring : end type, f(0 to 3) as zstring                 error 28
''     x as zstring * 4, x as zstring ptr, dim byref r as zstring = *p        fine
''     type Z as zstring : dim x as Z                                         fine
''
'' fbc judges the keyword AS WRITTEN, so an alias passes. tiko took every refused line and
'' gave the variable no storage: an extern lowered to 'external global void', which clang
'' refused (TKO0113) -- c2t's 'const char sqlite3_version[]' read as 'as const zstring'.
'' 'n' is the item's type reference; the keyword, or "" when it is not a bare one.
private function BareStrWord_ ( byref c as Ctx, byval n as NodeId ) as string
    if (n = NODE_NONE) orelse (c.ast->Kind( n ) <> N_TYPEREF) then return ""
    if (c.ast->Flags( n ) and (NF_PTR or NF_PROC_TYPE)) <> 0 then return ""
    dim as StmtPayload ptr tp = c.ast->StmtOf( n )
    if tp->c <> NODE_NONE then return ""
    select case cast( TokenKind, tp->op )
    case KW_ZSTRING : return "zstring"
    case KW_WSTRING : return "wstring"
    end select
    return ""
end function

sub CheckDeclShape_ ( byref c as Ctx, byval id as NodeId )
    dim as StmtPayload ptr sp = c.ast->StmtOf( id )
    dim as TokenKind op = cast( TokenKind, sp->op )
    for k as int32 = 0 to sp->count - 1
        dim as NodeId item = c.ast->ChildAt( sp->first, k )
        if (item = NODE_NONE) orelse (c.ast->Kind( item ) <> N_VAR_ITEM) then continue for
        dim as StmtPayload ptr ip = c.ast->StmtOf( item )
        dim as string nm = c.names->Spelling( ip->name )
        '' A BARE zstring/wstring (see BareStrWord_) -- a 'dim byref' reference is fine.
        if ((c.ast->Flags( item ) or c.ast->Flags( id )) and NF_BYREF) = 0 then
            dim as string bw = BareStrWord_( c, ip->a )
            if len( bw ) then
                c.diags->Report( TKO0996, PointRange( c.ast->Loc( item ) ), nm, bw )
                continue for
            end if
        end if
        '' 'redim shared' INSIDE A SCOPE OR A PROCEDURE over an array declared elsewhere --
        '' 'common array( )' above it, say -- is fbc's 96 (61 in a procedure), as a new one
        '' is (dim/redim-shared-in-a-scope-with-a-common-above). CheckSharedInBlock_ judges
        '' the SYMBOLS a shared declaration makes, and this one makes none.
        if (op = KW_REDIM) andalso ((c.ast->Flags( id ) and NF_SHARED) <> 0) then
            dim as SymScope ptr rsc = c.syms->ScopeAt( c.info->ScopeOf( id ) )
            if (rsc <> nullptr) andalso ((rsc->kind = cast( uint8, SCOPEK_BLOCK )) orelse (rsc->kind = cast( uint8, SCOPEK_PROC ))) then
                dim as Symbol ptr rs = c.syms->SymbolAt( c.info->RefOf( item ) )
                if rs = nullptr then rs = c.syms->SymbolAt( c.syms->LookupTyped( c.info->ScopeOf( id ), ip->name, false ) )
                if (rs <> nullptr) andalso (rs->payload <> cast( uint32, item )) then
                    c.diags->Report( TKO0726, PointRange( c.ast->Loc( item ) ), nm )
                    continue for
                end if
            end if
        end if
        '' THE BOUNDS: none, all 'any', or written -- and whether one is '...'.
        dim as boolean written = false, ell = false
        if (ip->c <> NODE_NONE) andalso (c.ast->Kind( ip->c ) = N_BLOCK) then
            dim as ListPayload ptr bl = c.ast->ListOf( ip->c )
            for b as int32 = 0 to bl->count - 1
                dim as NodeId bn = c.ast->ChildAt( bl->first, b )
                if bn = NODE_NONE then continue for
                if IsAnyNode_( c, bn ) = false then written = true
                if c.ast->Kind( bn ) = N_ELLIPSIS then ell = true
                if c.ast->Kind( bn ) = N_CASE_RANGE then
                    '' A declaration's range is a STATEMENT payload, 'a' to 'b' (decl.tiko).
                    dim as StmtPayload ptr rp = c.ast->StmtOf( bn )
                    if (rp->a <> NODE_NONE) andalso (c.ast->Kind( rp->a ) = N_ELLIPSIS) then ell = true
                    if (rp->b <> NODE_NONE) andalso (c.ast->Kind( rp->b ) = N_ELLIPSIS) then ell = true
                end if
            next
        end if
        if (op = KW_COMMON) andalso written then
            c.diags->Report( TKO0894, PointRange( c.ast->Loc( item ) ), nm )
            continue for
        end if
        if ell then
            if op = KW_REDIM then
                c.diags->Report( TKO0896, PointRange( c.ast->Loc( item ) ), nm )
                continue for
            end if
            if (ip->b = NODE_NONE) orelse (op = KW_EXTERN) then
                c.diags->Report( TKO0895, PointRange( c.ast->Loc( item ) ), nm )
                continue for
            end if
        end if
        '' A VARIABLE OF TYPE ANY, and one whose typedef is itself (see TypedefCycles_).
        if (ip->a <> NODE_NONE) andalso (c.ast->Kind( ip->a ) = N_TYPEREF) andalso (op <> KW_REDIM) then
            if (c.ast->Flags( ip->a ) and (NF_PTR or NF_PROC_TYPE)) = 0 then
                if cast( TokenKind, c.ast->StmtOf( ip->a )->op ) = KW_ANY then
                    c.diags->Report( TKO0898, PointRange( c.ast->Loc( item ) ), nm )
                    continue for
                end if
                if TypedefCycles_( c, ip->a, c.info->ScopeOf( id ) ) then
                    c.diags->Report( TKO0899, PointRange( c.ast->Loc( item ) ), _
                                     c.names->Spelling( c.ast->StmtOf( ip->a )->name ) )
                    continue for
                end if
            end if
        end if
        '' AN ARRAY OF A TYPE WHOSE DESTRUCTOR IS STDCALL OR PASCAL: fbc's 172 for a REDIM and
        '' 175 for a DIM, fixed or dynamic -- the runtime destroys elements through a cdecl
        '' callback (fbc-modern 1.20, 2026-09-29; dim/redim-array-dtor-mismatch). A cdecl one
        '' written out is fine, and so is a scalar.
        if (((c.ast->Flags( item ) and NF_ARRAY) <> 0) orelse (op = KW_REDIM)) andalso (ip->a <> NODE_NONE) then
            dim as TypeId et = c.types->Unqualify( c.info->TypeOf_( ip->a ) )
            if c.types->Kind( et ) = TK_UDT then
                dim as Symbol ptr dts = StructorOf_( c, et, "__dtor" )
                if (dts <> nullptr) andalso (dts->payload <> 0) then
                    dim as NodeId dd = cast( NodeId, dts->payload )
                    if c.ast->Kind( dd ) = N_PROC then
                        if (c.ast->StmtOf( dd )->extra and (PF_STDCALL or PF_PASCAL)) <> 0 then
                            c.diags->Report( TKO0913, PointRange( c.ast->Loc( item ) ), nm, c.names->Spelling( c.types->NameOf( et ) ) )
                            continue for
                        end if
                    end if
                end if
            end if
        end if
        '' '= any' OVER A CONST: the const is on the type reference the item was declared with.
        if (op <> KW_REDIM) andalso IsAnyNode_( c, ip->b ) andalso (ip->a <> NODE_NONE) then
            if (c.ast->Flags( ip->a ) and NF_CONST) <> 0 then
                c.diags->Report( TKO0897, PointRange( c.ast->Loc( ip->b ) ), nm )
            end if
        end if
    next
end sub

'' A FIELD WHOSE TYPEDEF IS ITSELF is the same mistake in a TYPE, measured the same way on
'' fbc-modern 1.20, 2026-10-15:
''
''     type t as t : type G : a as t : end type                error 24
''     type Uint8 as uint8 : type G : d(0 to 3) as Uint8 ...   error 24
''     type t as t : type G : p as t ptr : end type            fine
''
'' The second is the one that matters. A program's own declaration of a fixed-width name
'' replaces the prelude's for the whole program (resolveunbound.tiko's SameFixedWidth_), so
'' 'type Uint8 as uint8' -- what a C 'typedef uint8_t Uint8;' reads as -- names itself, as it
'' does to fbc, which has no uint8 at all. tiko gave the field no type and said nothing:
'' ComputeUdtLayouts then refused the whole record, every use of it was TKO0994, and
'' 'tiko c2t --verify' reported it as "tiko did not lay it out".
sub CheckFieldShape_ ( byref c as Ctx, byval id as NodeId )
    dim as StmtPayload ptr fp = c.ast->StmtOf( id )
    dim as string bw = BareStrWord_( c, fp->a )
    '' ('type B extends wstring' makes a field 'base' of that type -- the parser's, which no
    '' user field can be: BASE is a keyword. fbc accepts the extends.)
    if len( bw ) andalso (lcase( c.names->Spelling( fp->name ) ) <> "base") then
        c.diags->Report( TKO0996, PointRange( c.ast->Loc( id ) ), c.names->Spelling( fp->name ), bw )
        exit sub
    end if
    if (fp->a = NODE_NONE) orelse (c.ast->Kind( fp->a ) <> N_TYPEREF) then exit sub
    if (c.ast->Flags( fp->a ) and (NF_PTR or NF_PROC_TYPE)) <> 0 then exit sub
    if TypedefCycles_( c, fp->a, c.info->ScopeOf( id ) ) = false then exit sub
    c.diags->Report( TKO0899, PointRange( c.ast->Loc( id ) ), _
                     c.names->Spelling( c.ast->StmtOf( fp->a )->name ) )
end sub

'' TWO THINGS A PROCEDURE MAY NOT SAY, measured on fbc-modern 1.20, 2026-09-29:
''
''     constructor T( ) : print "foo" : constructor( 5 )      error 169  (structs/ctor-chain-
''     ...after a 'dim', after another chain call, in an IF    error 169   not-first-1)
''     constructor T( ) : constructor( 5 ) : print "foo"      fine
''
''     operator ->( byref x as UDT ) as integer               error 141  (overload/op-fieldderef-
''     ...'as UDT ptr', 'as integer ptr'                      error 141   bad-result-type)
''     ...'as UDT', 'byref as UDT'                            fine
''
'' The chain call is an N_AMBIGUOUS over a call to the bare name 'constructor'. The '->'
'' result is judged only where it is WRITTEN a pointer or a builtin: fb/comptr.bi and
'' fb/sharedptr.bi define a generic 'byref as T', which fbc accepts for a scalar T until
'' the arrow is used. tiko accepted every refused line.
'' A BARE 'zstring' OR 'wstring' BY VALUE -- fbc's error 28, "Expected pointer": a BYVAL parameter
'' of one, declared or defined, and a DEFINITION's result. Measured on fbc-modern 1.20: 'byref'
'' and a 'zstring ptr' are fine, a plain 'z as zstring' is byref already, and 'declare
'' function f( ) as wstring' alone is accepted. tiko took them and the IR failed later --
'' TKO0993 from the verifier for a result, TKO0113 from clang for a parameter.
private function IsBareCharStr_( byref c as Ctx, byval t as TypeId ) as boolean
    if t = TYPE_NONE then return false
    t = c.types->Unqualify( t )
    if c.types->Kind( t ) <> TK_BUILTIN then return false
    return (c.types->BuiltinOf( t ) = TY_ZSTRING) orelse (c.types->BuiltinOf( t ) = TY_WSTRING)
end function

private sub CheckBareStrByValue_ ( byref c as Ctx, byval id as NodeId, byval sp as StmtPayload ptr )
    for i as int32 = 0 to sp->count - 1
        dim as NodeId prm = c.ast->ChildAt( sp->first, i )
        if c.ast->Kind( prm ) <> N_PARAM then continue for
        if (c.ast->Flags( prm ) and NF_BYVAL_WRITTEN) = 0 then continue for
        dim as StmtPayload ptr pp = c.ast->StmtOf( prm )
        if pp->a = NODE_NONE then continue for
        if IsBareCharStr_( c, c.info->TypeOf_( pp->a ) ) then
            c.diags->Report( TKO0963, PointRange( c.ast->Loc( prm ) ) )
            return
        end if
    next
    if (sp->b = NODE_NONE) orelse (sp->a = NODE_NONE) then return
    if ((sp->extra and PF_BYREF_RESULT) <> 0) orelse ((c.ast->Flags( id ) and NF_BYREF) <> 0) then return   '' a byref result: NF_BYREF on the N_PROC
    if IsBareCharStr_( c, c.info->TypeOf_( sp->a ) ) then c.diags->Report( TKO0963, PointRange( c.ast->Loc( id ) ) )
end sub

sub CheckProcShape_ ( byref c as Ctx, byval id as NodeId )
    dim as StmtPayload ptr sp = c.ast->StmtOf( id )
    CheckBareStrByValue_( c, id, sp )
    select case cast( TokenKind, sp->op )
    case KW_CONSTRUCTOR
        if (sp->b = NODE_NONE) orelse (c.ast->Kind( sp->b ) <> N_BLOCK) then return
        dim as ListPayload ptr bp = c.ast->ListOf( sp->b )
        dim as NodeId first_ = NODE_NONE
        if bp->count > 0 then first_ = cast( NodeId, c.ast->ChildSlot( bp->first ) )
        '' Every chain call inside the body: node ids run in source order, and the body's
        '' own nodes lie between the procedure's first parameter and the block.
        for i as int32 = cast( int32, sp->b ) - 1 to 1 step -1
            dim as NodeKind nk = c.ast->Kind( cast( NodeId, i ) )
            if (nk = N_PROC) orelse (nk = N_TYPE) orelse (nk = N_MODULE) then exit for
            if nk <> N_AMBIGUOUS then continue for
            dim as NodeId ca = c.ast->StmtOf( i )->a
            if (ca = NODE_NONE) orelse (c.ast->Kind( ca ) <> N_CALL) then continue for
            dim as NodeId ct = c.ast->ListOf( ca )->target
            if (ct = NODE_NONE) orelse (c.ast->Kind( ct ) <> N_IDENT) then continue for
            dim as string cw = lcase( SpellOf_( c, ct ) )
            if (cw <> "constructor") andalso (cw <> "base") then continue for
            if cast( NodeId, i ) = first_ then continue for
            if cw = "base" then
                c.diags->Report( TKO0982, PointRange( c.ast->Loc( cast( NodeId, i ) ) ) )
            else
                c.diags->Report( TKO0908, PointRange( c.ast->Loc( cast( NodeId, i ) ) ) )
            end if
        next
    case KW_OPERATOR
        if (sp->extra and PF_GENERIC_PROC) <> 0 then return
        if Text.LowerAscii( c.names->Spelling( sp->name ) ) <> "->" then return
        if ProcOwner_( c, id ) <> TYPE_NONE then return
        if (sp->a = NODE_NONE) orelse (c.ast->Kind( sp->a ) <> N_TYPEREF) then return
        dim as uint16 rf = c.ast->Flags( sp->a )
        if (rf and NF_PROC_TYPE) <> 0 then return
        dim as boolean bad = ((rf and NF_PTR) <> 0)
        if bad = false then
            dim as TokenKind rk = cast( TokenKind, c.ast->StmtOf( sp->a )->op )
            bad = IsTypeKeyword( rk ) andalso (rk <> KW_CONST)
        end if
        if bad then c.diags->Report( TKO0909, PointRange( c.ast->Loc( id ) ) )
    end select
end sub

'' A POINTER INTO AN INTEGER OF ANOTHER SIZE, measured on fbc-modern 1.20, 2026-09-29, 64-bit:
''
''     dim shared a as long = @i  /  dim a as byte = @i  /  as ulong    error 24
''     a = @i  (a as long)                                            error 181
''     dim a as integer = @i  /  as ulongint  /  as any ptr           fine
''
'' dim/global-init-nonptrsizedint-from-offset writes the first. A float is TKO0670's.
''
'' ...AND A BOOLEAN, of any width: 'bo = p', 'dim as boolean b = p' and 'return p' from a
'' function 'as boolean' are fbc's 181 / 24 / 181 (2026-10-13), and tiko took all three.
'' A POINTER CONSTANT is fbc's warning 5 only, into any of these -- 'by = NP' with 'const NP
'' as any ptr = 0', so 'by = nullptr' too -- and is TKO0968's, not this error's.
function PtrIntNarrow_ ( byref c as Ctx, byval lt as TypeId, byval rt as TypeId, byval rhs as NodeId ) as boolean
    if (lt = TYPE_NONE) orelse (rt = TYPE_NONE) then return false
    '' ONLY A RUN-TIME POINTER: an address, a variable or a field. 'b = cptr( any ptr, 0 )' is a
    '' constant null, and fbc takes it into a byte (numbers/cast-nullptr.bas).
    for up as int32 = 0 to 15
        if (rhs = NODE_NONE) orelse (c.ast->Kind( rhs ) <> N_PAREN) then exit for
        dim as ListPayload ptr pp = c.ast->ListOf( rhs )
        if pp->count <> 1 then exit for
        rhs = cast( NodeId, c.ast->ChildSlot( pp->first ) )
    next
    if rhs = NODE_NONE then return false
    select case c.ast->Kind( rhs )
    case N_ADDROF, N_MEMBER
    case N_IDENT
        dim as Symbol ptr rs = c.syms->SymbolAt( c.info->RefOf( rhs ) )
        if rs <> nullptr then
            if rs->kind = cast( uint8, SYM_CONSTANT ) then return false
        end if
    case else
        return false
    end select
    dim as TypeId lu = c.types->Unqualify( lt ), ru = c.types->Unqualify( rt )
    if c.types->Kind( lu ) = TK_REFERENCE then lu = c.types->Unqualify( c.types->Inner( lu ) )
    if c.types->Kind( ru ) = TK_REFERENCE then ru = c.types->Unqualify( c.types->Inner( ru ) )
    if (c.types->Kind( ru ) <> TK_POINTER) orelse (c.types->Kind( lu ) <> TK_BUILTIN) then return false
    select case c.types->BuiltinOf( lu )
    case TY_BYTE, TY_UBYTE, TY_SHORT, TY_USHORT, TY_LONG, TY_ULONG, TY_INTEGER, TY_UINTEGER, TY_LONGINT, TY_ULONGINT
        return (c.types->Layout( lu ).size * 8) <> c.types->target.pointerBits
    case TY_BOOLEAN
        return true
    end select
    return false
end function

sub CheckPtrIntWidth_ ( byref c as Ctx, byval id as NodeId )
    dim as StmtPayload ptr sp = c.ast->StmtOf( id )
    if c.ast->Kind( id ) = N_AMBIGUOUS then
        if c.info->AmbiguousOf( id ) <> AMB_ASSIGN then return
        if (sp->a = NODE_NONE) orelse (sp->b = NODE_NONE) then return
        if PtrIntNarrow_( c, c.info->TypeOf_( sp->a ), c.info->TypeOf_( sp->b ), sp->b ) then
            c.diags->Report( TKO0910, PointRange( c.ast->Loc( id ) ), c.types->Name( c.types->Unqualify( c.info->TypeOf_( sp->a ) ) ) )
        end if
        return
    end if
    for k as int32 = 0 to sp->count - 1
        dim as NodeId item = c.ast->ChildAt( sp->first, k )
        if (item = NODE_NONE) orelse (c.ast->Kind( item ) <> N_VAR_ITEM) then continue for
        dim as StmtPayload ptr ip = c.ast->StmtOf( item )
        if (ip->a = NODE_NONE) orelse (ip->b = NODE_NONE) then continue for
        if (c.ast->Flags( item ) and NF_ARRAY) <> 0 then continue for
        if PtrIntNarrow_( c, c.info->TypeOf_( ip->a ), c.info->TypeOf_( ip->b ), ip->b ) then
            c.diags->Report( TKO0910, PointRange( c.ast->Loc( item ) ), c.types->Name( c.types->Unqualify( c.info->TypeOf_( ip->a ) ) ) )
        end if
    next
end sub

'' A TYPE LITERAL THAT BUILDS NOTHING, measured the same day:
''
''     type<UDT>( ) / type<UDT> / type( ), UDT of plain fields         error 9    (structs/anon-
''     ...over a UDT with a constructor, a string field, or OBJECT      fine        missing-initializer)
''     type<UDT>( 1 ) / type( 1 ), UDT extends OBJECT, no constructor   error 99   (structs/anon-
''     ...over a plain UDT, or one that only has a destructor           fine        ctorcall-no-match)
''
'' An empty literal over a type fbc has no constructor for has nothing to build; a type that
'' extends OBJECT has a vtable, so it is constructed and never filled field by field. A type
'' holding a string is TKO0757's where it is an initializer, and is not judged here.
'' ExtendsObject_ is latechecks.tiko's.
'' Does a field of this type, or of one it extends, have a default initializer -- so fbc
'' writes the type a constructor? 'i as integer = 123' is one (structs/anon-access.bas).
private function FieldHasInit_ ( byref c as Ctx, byval t as TypeId ) as boolean
    for guard as int32 = 0 to 31
        if (t = TYPE_NONE) orelse (c.types->Kind( t ) <> TK_UDT) then return false
        dim as Symbol ptr us = UdtSymbolOf_( c, t )
        if (us = nullptr) orelse (us->inner = SCOPE_NONE) then return false
        dim as SymScope ptr sc = c.syms->ScopeAt( us->inner )
        dim as SymbolId cur = iif( sc <> nullptr, sc->firstSym, SYMBOL_NONE )
        for g2 as int32 = 0 to 9999
            if cur = SYMBOL_NONE then exit for
            dim as Symbol ptr f = c.syms->SymbolAt( cur )
            if f = nullptr then exit for
            if (f->kind = cast( uint8, SYM_FIELD )) andalso (f->payload <> 0) then
                dim as NodeId fn = cast( NodeId, f->payload )
                if c.ast->Kind( fn ) = N_FIELD then
                    dim as StmtPayload ptr fp = c.ast->StmtOf( fn )
                    if fp->c <> NODE_NONE then return true
                    if (fp->b <> NODE_NONE) andalso ((f->flags and SYMF_BITFIELD) = 0) then return true
                end if
            end if
            cur = f->nextInScope
        next
        t = BaseOf_( c, t )
    next
    return false
end function

sub CheckTypeLiteral_ ( byref c as Ctx, byval id as NodeId )
    if (c.ast->Flags( id ) and NF_TYPE_LITERAL) = 0 then return
    dim as ListPayload ptr lp = c.ast->ListOf( id )
    dim as TypeId t = TYPE_NONE
    if lp->target <> NODE_NONE then t = c.info->TypeOf_( lp->target )
    if t = TYPE_NONE then t = c.info->TypeOf_( id )
    if t = TYPE_NONE then return
    t = c.types->Unqualify( t )
    if c.types->Kind( t ) = TK_REFERENCE then t = c.types->Unqualify( c.types->Inner( t ) )
    if c.types->Kind( t ) <> TK_UDT then return
    dim as InternId tn = c.types->NameOf( t )
    if tn = 0 then return
    dim as string h = left( c.names->Spelling( tn ), 1 )
    if (h = "(") orelse (h = "$") orelse (h = "~") then return
    if instr( c.names->Spelling( tn ), "<" ) > 0 then return
    if StructorOf_( c, t, "__ctor" ) <> nullptr then return
    if lp->count = 0 then
        if TcNeedsCtor_( c, t, 0 ) orelse FieldHasInit_( c, t ) then return
        c.diags->Report( TKO0911, PointRange( c.ast->Loc( id ) ), c.names->Spelling( tn ) )
    elseif ExtendsObject_( c, t ) then
        c.diags->Report( TKO0912, PointRange( c.ast->Loc( id ) ), c.names->Spelling( tn ) )
    end if
end sub

'' A WHOLE ARRAY AS THE DATA OF A FILE GET OR PUT -- fbc's error 73, "Array access, index
'' expected": 'put #0, , values' over 'dim values( 0 to 0 )', a dynamic one the same (fbc-modern
'' 1.20, 2026-09-29; expressions/nidxarray-3). 'values( )' writes the whole array and
'' 'values( 0 )' one element; a fixed-length string is not this. The GRAPHICS forms take a bare
'' array and are not judged: bit 1 of 'extra' marks the file form.
'' AN AMOUNT FOR WHAT HAS ITS OWN LENGTH -- fbc's error 277, "Elements must be empty for
'' strings and arrays", measured on fbc-modern 1.20: 'get #1, 21, s, 4' over a var-len string,
'' a 'string * 10' and a whole array 'a( )', GET and PUT alike. A zstring or wstring buffer,
'' an element 'a( 0 )' and a number take one. tiko accepted all of them (audit F-71).
private sub CheckFileGetPutAmount_ ( byref c as Ctx, byval sp as StmtPayload ptr )
    if sp->count < 3 then return
    dim as NodeId amt = cast( NodeId, c.ast->ChildSlot( sp->first + 2 ) )
    if (amt = NODE_NONE) orelse (c.ast->Kind( amt ) = N_ELIDED) then return
    dim as NodeId v = cast( NodeId, c.ast->ChildSlot( sp->first + 1 ) )
    if (v = NODE_NONE) orelse (c.ast->Kind( v ) = N_ELIDED) then return
    dim as boolean bad = false
    if c.ast->Kind( v ) = N_CALL then
        dim as ListPayload ptr lp = c.ast->ListOf( v )
        if (lp->count = 0) andalso (lp->target <> NODE_NONE) then
            if c.ast->Kind( lp->target ) = N_IDENT then
                dim as Symbol ptr vs = c.syms->SymbolAt( c.info->RefOf( lp->target ) )
                if vs <> nullptr then
                    if (vs->kind = cast( uint8, SYM_VARIABLE )) andalso (vs->type_ <> TYPE_NONE) then
                        dim as TypeId at_ = c.types->Unqualify( vs->type_ )
                        if c.types->Kind( at_ ) = TK_REFERENCE then at_ = c.types->Unqualify( c.types->Inner( at_ ) )
                        bad = (c.types->Kind( at_ ) = TK_ARRAY)
                    end if
                end if
            end if
        end if
    end if
    if bad = false then
        dim as TypeId t = c.info->TypeOf_( v )
        if t = TYPE_NONE then return
        t = c.types->Unqualify( t )
        if c.types->Kind( t ) = TK_REFERENCE then t = c.types->Unqualify( c.types->Inner( t ) )
        if c.types->Kind( t ) = TK_BUILTIN then
            bad = (c.types->BuiltinOf( t ) = TY_STRING)
        else
            dim as TypeId fe = Tko.Check.FixedStringElem( t, *c.types )
            if fe <> TYPE_NONE then bad = (c.types->BuiltinOf( fe ) = TY_FIXSTR)
        end if
    end if
    if bad then c.diags->Report( TKO0959, PointRange( c.ast->Loc( amt ) ) )
end sub

sub CheckFileGetPutArray_ ( byref c as Ctx, byval id as NodeId )
    dim as StmtPayload ptr sp = c.ast->StmtOf( id )
    select case cast( TokenKind, sp->op )
    case KW_GET, KW_PUT
    case else
        return
    end select
    if (sp->extra and 1) = 0 then return
    CheckFileGetPutAmount_( c, sp )
    for i as int32 = 0 to sp->count - 1
        dim as NodeId ch = c.ast->ChildAt( sp->first, i )
        if (ch = NODE_NONE) orelse (c.ast->Kind( ch ) <> N_IDENT) then continue for
        dim as Symbol ptr vs = c.syms->SymbolAt( c.info->RefOf( ch ) )
        if (vs = nullptr) orelse (vs->kind <> cast( uint8, SYM_VARIABLE )) orelse (vs->type_ = TYPE_NONE) then continue for
        dim as TypeId vt = c.types->Unqualify( vs->type_ )
        if c.types->Kind( vt ) = TK_REFERENCE then vt = c.types->Unqualify( c.types->Inner( vt ) )
        if c.types->Kind( vt ) <> TK_ARRAY then continue for
        if Tko.Check.FixedStringElem( vt, *c.types ) <> TYPE_NONE then continue for
        c.diags->Report( TKO0914, PointRange( c.ast->Loc( ch ) ), c.names->Spelling( vs->name ) )
    next
end sub

'' 'UDT( )' OVER A TYPE WITH NOTHING TO CONSTRUCT -- fbc's error 42, "Variable not declared",
'' measured on fbc-modern 1.20, 2026-09-30: 'DtorUdt( )' and 'DtorUdt( 1 )' over a type with
'' only a destructor, and 'P( )' over one of plain fields, in an initializer or as a
'' parameter's default (functions/paraminit-undeclared-1). A type with a constructor, a
'' string field, a field initializer or OBJECT is constructed, and the call is fine.
sub CheckUdtCallNoCtor_ ( byref c as Ctx, byval id as NodeId )
    dim as ListPayload ptr lp = c.ast->ListOf( id )
    if lp->target = NODE_NONE then return
    dim as Symbol ptr ts = nullptr
    if c.ast->Kind( lp->target ) = N_IDENT then
        ts = c.syms->SymbolAt( c.info->RefOf( lp->target ) )
    elseif c.ast->Kind( lp->target ) = N_MEMBER then
        '' A QUALIFIED TYPE -- 'N.Info( )', and 'fs.FileInfo( )' through a module's alias --
        '' is the same call, fbc's error 42 the same. Only an N_IDENT was asked about, so
        '' it went on to lowering, which built a call with no receiver: 'fs.Stat( p
        '' ).ValueOr( fs.FileInfo( ) ).Size( )' printed 0 for a 5-byte file, and over a
        '' named Result the MIR verifier stopped it (fs RFC-0002 section 10.5 G6). Only a
        '' TYPE is taken here: 'obj.member( )' is a method or an index.
        ts = c.syms->SymbolAt( c.info->RefOf( lp->target ) )
        if ts = nullptr then
            dim as NodeId rhs = c.ast->BinaryOf( lp->target )->rhs
            ts = c.syms->SymbolAt( c.info->RefOf( rhs ) )
        end if
        if ts = nullptr then return
        if (ts->kind <> cast( uint8, SYM_UDT )) andalso (ts->kind <> cast( uint8, SYM_TYPEDEF )) then return
    end if
    if ts = nullptr then return
    dim as TypeId t = TYPE_NONE
    select case cast( SymbolKind, ts->kind )
    case SYM_UDT, SYM_TYPEDEF
        t = c.types->Unqualify( c.info->TypeOf_( id ) )
    '' ...AND A VALUE THAT SHARES ITS NAME WITH THE TYPE: 'dim u as U' then 'U( 3 )', where
    '' the name binds to the variable. CheckCalledExpr_ leaves a name a type shares to the
    '' type's constructor, so with no constructor nothing reported it and lowering stopped
    '' with TKO0994; fbc's error 72. An ARRAY of that name is subscripted, and is fine.
    case SYM_VARIABLE, SYM_PARAMETER
        if (ts->flags and SYMF_REDIM) <> 0 then return
        dim as NodeId dn = cast( NodeId, ts->payload )
        if (dn > 0) andalso (dn <= c.ast->Count( )) then
            if (c.ast->Flags( dn ) and NF_ARRAY) <> 0 then return
        end if
        if ts->type_ <> TYPE_NONE then
            dim as TypeId vt = c.types->Unqualify( ts->type_ )
            if c.types->Kind( vt ) = TK_REFERENCE then vt = c.types->Unqualify( c.types->Inner( vt ) )
            if (c.types->Kind( vt ) = TK_ARRAY) orelse c.types->IsDynArray( vt ) then return
        end if
        dim as Symbol ptr tys = c.syms->SymbolAt( c.syms->LookupTyped( ts->parent, ts->name, true ) )
        if tys = nullptr then return
        if (tys->kind <> cast( uint8, SYM_UDT )) andalso (tys->kind <> cast( uint8, SYM_TYPEDEF )) then return
        if tys->type_ <> TYPE_NONE then t = c.types->Unqualify( tys->type_ )
    case else
        return
    end select
    if (t = TYPE_NONE) orelse (c.types->Kind( t ) <> TK_UDT) then return
    dim as InternId tn = c.types->NameOf( t )
    if tn = 0 then return
    dim as string h = left( c.names->Spelling( tn ), 1 )
    if (h = "(") orelse (h = "$") orelse (h = "~") then return
    if instr( c.names->Spelling( tn ), "<" ) > 0 then return
    if StructorOf_( c, t, "__ctor" ) <> nullptr then return
    if TcNeedsCtor_( c, t, 0 ) orelse FieldHasInit_( c, t ) then return
    c.diags->Report( TKO0917, PointRange( c.ast->Loc( lp->target ) ), c.names->Spelling( tn ) )
end sub

'' A STRING CONSTANT'S INITIALISER THAT IS NO CONSTANT -- fbc's error 11, "Expected constant",
'' at the 'const'. Measured on fbc-modern 1.20, 2026-10-22, one 'const K = ...' each: fbc
'' folds 'str', 'wstr', 'chr', 'wchr', and 'lcase' / 'ucase' with their second argument,
'' and refuses 'string', 'wstring', 'space', 'wspace', 'left', 'right', 'mid', 'trim',
'' 'ltrim', 'rtrim', 'hex', 'oct', 'bin', 'whex', 'woct', 'wbin', the one-argument 'lcase' /
'' 'ucase', every 'mk*', a call to the program's own function, and a variable. tiko accepted every one,
'' and the constant's first USE was TKO0994: lowering folds only what fbc folds
'' (ConstStringTextOf_), so 'const K = "ab" & string( 3, "0" )' had no text to give.
'' Only a STRING constant is asked, and only those shapes: a name, a literal and anything
'' else is left to lowering. fs RFC-0002 section 10.5 G4.
private function ConstStrInitBad_ ( byref c as Ctx, byval e as NodeId, byval depth as int32 ) as NodeId
    if (e = NODE_NONE) orelse (depth > 4096) then return NODE_NONE
    select case c.ast->Kind( e )
    case N_PAREN
        dim as ListPayload ptr pl = c.ast->ListOf( e )
        if pl->count <> 1 then return NODE_NONE
        return ConstStrInitBad_( c, cast( NodeId, c.ast->ChildSlot( pl->first ) ), depth + 1 )
    case N_BINARY
        dim as BinaryPayload ptr bp = c.ast->BinaryOf( e )
        select case cast( TokenKind, bp->op )
        case TK_AMP, TK_PLUS
        case else
            return NODE_NONE
        end select
        dim as NodeId bad = ConstStrInitBad_( c, bp->lhs, depth + 1 )
        if bad <> NODE_NONE then return bad
        return ConstStrInitBad_( c, bp->rhs, depth + 1 )
    case N_IDENT
        dim as Symbol ptr s = c.syms->SymbolAt( c.info->RefOf( e ) )
        if s = nullptr then return NODE_NONE
        select case cast( SymbolKind, s->kind )
        case SYM_VARIABLE, SYM_PARAMETER
            return e
        end select
        return NODE_NONE
    case N_CALL
        dim as ListPayload ptr lp = c.ast->ListOf( e )
        if (lp->target = NODE_NONE) orelse (c.ast->Kind( lp->target ) <> N_IDENT) then return NODE_NONE
        dim as Symbol ptr ps = c.syms->SymbolAt( c.info->RefOf( lp->target ) )
        if ps = nullptr then ps = c.syms->SymbolAt( c.info->RefOf( e ) )
        if ps <> nullptr then
            if ps->kind = cast( uint8, SYM_PROC ) then return e     '' the program's own
            return NODE_NONE
        end if
        dim as InternId nm = c.ast->IdentOf( lp->target )->name
        select case Text.LowerAscii( c.names->Spelling( nm ) )
        case "string", "wstring", "space", "wspace", "left", "right", "mid", _
             "trim", "ltrim", "rtrim", "hex", "oct", "bin", "whex", "woct", "wbin", _
             "mki", "mkl", "mks", "mkd", "mkshort", "mklongint"
            return e
        case "lcase", "ucase"
            if lp->count < 2 then return e
        end select
        return NODE_NONE
    end select
    return NODE_NONE
end function

'' ANY CONSTANT'S INITIALISER THAT READS A VARIABLE OR CALLS A PROCEDURE -- fbc's error 11 again,
'' at the 'const'. Measured on fbc-modern 1.20, 2026-11-07, one 'const K = ...' each over
'' 'function f', 'declare function ext', 'dim shared g as integer' and 'dim shared uu as U': fbc
'' refuses 'f( 4 )', 'ext( 4 )', 'f( 4 ) + 1', 'g', '-g', 'not g', '( g )', '1 + g * 2', '@g',
'' 'uu.a', 'cast( integer, g )', 'cint( g )', 'cbyte( g )', 'abs( g )' and 'iif( g, 2, 3 )', and
'' folds 'sizeof( g )', 'len( g )', 'offsetof( U, a )', and 'abs', 'sgn', 'int', 'fix', 'sqr',
'' 'sin', 'log', 'cint', 'cast', 'asc', 'len' and 'iif' over constants. tiko accepted every one
'' and lowered the initialiser at each USE (lowerstr.tiko's unfolded-integer path), so
'' 'const K = f( 4 )' called f once per read, and 'as int32 a( 0 to K )' in a TYPE became a
'' dynamic array's descriptor. Only those shapes are asked: a builtin's arguments are walked,
'' 'sizeof' / 'len' / 'offsetof' / 'lbound' / 'ubound' are not, and anything else is let be --
'' a missing error is a gap, a false one a wrong compiler.
private function ConstInitBad_ ( byref c as Ctx, byval e as NodeId, byval depth as int32 ) as NodeId
    if (e = NODE_NONE) orelse (depth > 4096) then return NODE_NONE
    select case c.ast->Kind( e )
    case N_PAREN
        dim as ListPayload ptr pl = c.ast->ListOf( e )
        if pl->count <> 1 then return NODE_NONE
        return ConstInitBad_( c, cast( NodeId, c.ast->ChildSlot( pl->first ) ), depth + 1 )
    case N_BINARY
        dim as BinaryPayload ptr bp = c.ast->BinaryOf( e )
        dim as NodeId bad = ConstInitBad_( c, bp->lhs, depth + 1 )
        if bad <> NODE_NONE then return bad
        return ConstInitBad_( c, bp->rhs, depth + 1 )
    case N_UNARY, N_ADDROF
        return ConstInitBad_( c, c.ast->UnaryOf( e )->operand, depth + 1 )
    case N_IDENT
        dim as Symbol ptr s = c.syms->SymbolAt( c.info->RefOf( e ) )
        if s = nullptr then return NODE_NONE
        select case cast( SymbolKind, s->kind )
        case SYM_VARIABLE, SYM_PARAMETER, SYM_FIELD
            return e
        end select
        return NODE_NONE
    case N_MEMBER
        dim as Symbol ptr ms = c.syms->SymbolAt( c.info->RefOf( e ) )
        if ms <> nullptr then
            select case cast( SymbolKind, ms->kind )
            case SYM_VARIABLE, SYM_PARAMETER
                return e
            end select
        end if
        return ConstInitBad_( c, c.ast->BinaryOf( e )->lhs, depth + 1 )
    case N_CALL
        dim as ListPayload ptr lp = c.ast->ListOf( e )
        if (lp->target = NODE_NONE) orelse (c.ast->Kind( lp->target ) <> N_IDENT) then return NODE_NONE
        dim as Symbol ptr ps = c.syms->SymbolAt( c.info->RefOf( lp->target ) )
        if ps = nullptr then ps = c.syms->SymbolAt( c.info->RefOf( e ) )
        if ps <> nullptr then
            select case cast( SymbolKind, ps->kind )
            case SYM_PROC, SYM_VARIABLE, SYM_PARAMETER, SYM_FIELD    '' a call, or an array element
                return e
            end select
            return NODE_NONE
        end if
        select case Text.LowerAscii( c.names->Spelling( c.ast->IdentOf( lp->target )->name ) )
        case "sizeof", "len", "offsetof", "lbound", "ubound"
            return NODE_NONE
        end select
        for a as int32 = 0 to lp->count - 1
            dim as NodeId bad = ConstInitBad_( c, cast( NodeId, c.ast->ChildSlot( lp->first + a ) ), depth + 1 )
            if bad <> NODE_NONE then return bad
        next
    end select
    return NODE_NONE
end function

sub CheckConstStrInit_ ( byref c as Ctx, byval id as NodeId )
    dim as StmtPayload ptr sp = c.ast->StmtOf( id )
    dim as int32 spFirst = sp->first, spCount = sp->count
    for i as int32 = 0 to spCount - 1
        dim as NodeId item = cast( NodeId, c.ast->ChildSlot( spFirst + i ) )
        if c.ast->Kind( item ) <> N_VAR_ITEM then continue for
        dim as NodeId v = c.ast->StmtOf( item )->b
        if v = NODE_NONE then continue for
        dim as NodeId bad = NODE_NONE
        if IsStringyType_( c, c.info->TypeOf_( v ) ) then bad = ConstStrInitBad_( c, v, 0 )
        if bad = NODE_NONE then bad = ConstInitBad_( c, v, 0 )
        if bad = NODE_NONE then continue for
        if c.ast->Kind( bad ) = N_CALL then bad = c.ast->ListOf( bad )->target
        c.diags->Report( TKO0605, PointRange( c.ast->Loc( bad ) ) )
    next
end sub

'' '*@type<UDT>( 1 ) = x' -- A STORE THROUGH THE ADDRESS OF A TEMPORARY, fbc's error 24
'' (structs/anon-invalid-initializer-2). '@type<UDT>( 1 )' read, or taken into a pointer,
'' is fbc's.
private function StripParens_ ( byref c as Ctx, byval n as NodeId ) as NodeId
    for up as int32 = 0 to 15
        if (n = NODE_NONE) orelse (c.ast->Kind( n ) <> N_PAREN) then exit for
        dim as ListPayload ptr pp = c.ast->ListOf( n )
        if pp->count <> 1 then exit for
        n = cast( NodeId, c.ast->ChildSlot( pp->first ) )
    next
    return n
end function

sub CheckAssignTempDeref_ ( byref c as Ctx, byval id as NodeId )
    if c.info->AmbiguousOf( id ) <> AMB_ASSIGN then return
    dim as StmtPayload ptr sp = c.ast->StmtOf( id )
    dim as NodeId d = StripParens_( c, sp->a )
    if (d = NODE_NONE) orelse (c.ast->Kind( d ) <> N_DEREF) then return
    dim as NodeId ad = StripParens_( c, c.ast->UnaryOf( d )->operand )
    if (ad = NODE_NONE) orelse (c.ast->Kind( ad ) <> N_ADDROF) then return
    dim as NodeId lit = StripParens_( c, c.ast->UnaryOf( ad )->operand )
    if (lit = NODE_NONE) orelse (c.ast->Kind( lit ) <> N_TUPLE) then return
    if (c.ast->Flags( lit ) and NF_TYPE_LITERAL) = 0 then return
    c.diags->Report( TKO0918, PointRange( c.ast->Loc( id ) ) )
end sub

'' A STRING LITERAL FOR A POINTER IN AN ARRAY'S '{ }' INITIALIZER -- fbc refuses it, with
'' error 24 for a 'zstring ptr' element and 14 or 3 for a UDT field of one, measured on
'' fbc-modern 1.20, 2026-09-30 (dim/udt-init-bad-1). '@"a"' is the spelling; and a SCALAR
'' 'dim u as UDT = ( "a" )' is fine to fbc, so only an array's elements are judged.
private function PtrStrElemBad_ ( byref c as Ctx, byval el as TypeId, byval e as NodeId ) as NodeId
    if e = NODE_NONE then return NODE_NONE
    if c.types->Kind( el ) = TK_POINTER then
        e = StripParens_( c, e )
        if (e <> NODE_NONE) andalso (c.ast->Kind( e ) = N_STRING_LIT) then return e
        return NODE_NONE
    end if
    '' A UDT's element is its OWN parenthesised list -- '( "a" )' is one field's value, so
    '' the parens are not stripped here.
    if c.types->Kind( el ) <> TK_UDT then return NODE_NONE
    dim as NodeKind ek = c.ast->Kind( e )
    if (ek <> N_TUPLE) andalso (ek <> N_PAREN) then
        return NODE_NONE
    end if
    dim as Symbol ptr us = UdtSymbolOf_( c, el )
    if (us = nullptr) orelse (us->inner = SCOPE_NONE) then return NODE_NONE
    dim as ListPayload ptr lp = c.ast->ListOf( e )
    dim as SymScope ptr sc = c.syms->ScopeAt( us->inner )
    dim as SymbolId cur = iif( sc <> nullptr, sc->firstSym, SYMBOL_NONE )
    dim as int32 k = 0
    for guard as int32 = 0 to 9999
        if (cur = SYMBOL_NONE) orelse (k >= lp->count) then exit for
        dim as Symbol ptr f = c.syms->SymbolAt( cur )
        if f = nullptr then exit for
        if (f->kind = cast( uint8, SYM_FIELD )) andalso ((f->flags and SYMF_STATIC) = 0) andalso (f->name <> c.baseName) then
            dim as NodeId fe = StripParens_( c, c.ast->ChildAt( lp->first, k ) )
            k += 1
            if (fe <> NODE_NONE) andalso (c.ast->Kind( fe ) = N_STRING_LIT) andalso (f->type_ <> TYPE_NONE) then
                if c.types->Kind( c.types->Unqualify( f->type_ ) ) = TK_POINTER then return fe
            end if
        end if
        cur = f->nextInScope
    next
    return NODE_NONE
end function

sub CheckPtrStringInit_ ( byref c as Ctx, byval id as NodeId )
    dim as StmtPayload ptr sp = c.ast->StmtOf( id )
    for k as int32 = 0 to sp->count - 1
        dim as NodeId item = c.ast->ChildAt( sp->first, k )
        if (item = NODE_NONE) orelse (c.ast->Kind( item ) <> N_VAR_ITEM) then continue for
        dim as StmtPayload ptr ip = c.ast->StmtOf( item )
        if (ip->b = NODE_NONE) orelse (c.ast->Kind( ip->b ) <> N_INITIALIZER) then continue for
        if ip->a = NODE_NONE then continue for
        dim as TypeId el = c.types->Unqualify( c.info->TypeOf_( ip->a ) )
        if el = TYPE_NONE then continue for
        dim as ListPayload ptr lp = c.ast->ListOf( ip->b )
        for j as int32 = 0 to lp->count - 1
            dim as NodeId bad = PtrStrElemBad_( c, el, c.ast->ChildAt( lp->first, j ) )
            if bad <> NODE_NONE then
                '' fbc reports a UDT element's bad field where it chokes: the next element's '('.
                dim as NodeId at_ = bad
                if (c.types->Kind( el ) = TK_UDT) andalso (j + 1 < lp->count) then at_ = c.ast->ChildAt( lp->first, j + 1 )
                c.diags->Report( TKO0653, PointRange( c.ast->Loc( at_ ) ), c.names->Spelling( ip->name ) )
                exit for
            end if
        next
    next
end sub

'' 'for i as foo ptr = 0 to 3' OVER A FORWARD TYPE -- fbc's error 71 at the NEXT: the step is
'' pointer arithmetic, and the pointee has no size (compound/for-ptr-fwdref). Reported at the
'' body block, which is the NEXT line when the body is empty and the first statement otherwise.
sub CheckForPtrFwd_ ( byref c as Ctx, byval id as NodeId )
    dim as StmtPayload ptr sp = c.ast->StmtOf( id )
    if sp->a = NODE_NONE then return
    dim as TypeId t = TYPE_NONE
    if sp->c <> NODE_NONE then t = c.info->TypeOf_( sp->c )
    if t = TYPE_NONE then t = c.info->TypeOf_( sp->a )
    if t = TYPE_NONE then return
    t = c.types->Unqualify( t )
    if c.types->Kind( t ) = TK_REFERENCE then t = c.types->Unqualify( c.types->Inner( t ) )
    if c.types->Kind( t ) <> TK_POINTER then return
    dim as TypeId pt = c.types->Unqualify( c.types->Inner( t ) )
    if c.types->Kind( pt ) <> TK_FORWARD then return
    dim as NodeId at_ = iif( sp->b <> NODE_NONE, sp->b, id )
    c.diags->Report( TKO0810, PointRange( c.ast->Loc( at_ ) ), c.names->Spelling( c.types->NameOf( pt ) ) )
end sub

'' A FOR WRITES ITS COUNTER, so a const one is fbc's 119: 'dim as const integer c' then
'' 'for c = 1 to 2' ran the loop. A counter declared by the FOR itself is new storage.
'' A FOR COUNTER IS A SCALAR VARIABLE -- fbc's 52, "Expected scalar counter", for a field
'' ('for t.x = 1 to 3'), an array element, a byref parameter, and its 14 for '*p'. tiko
'' ran none of those loops (MIR-7), and since F-01 stopped them as unlowered. A UDT
'' variable is a counter too -- its 'operator for' / 'next' -- and a byval parameter is.
sub CheckForScalarCounter_ ( byref c as Ctx, byval id as NodeId )
    dim as StmtPayload ptr sp = c.ast->StmtOf( id )
    if (sp->a = NODE_NONE) orelse (sp->c <> NODE_NONE) then return
    dim as boolean bad = (c.ast->Kind( sp->a ) <> N_IDENT)
    if bad = false then
        dim as Symbol ptr s = c.syms->SymbolAt( c.info->RefOf( sp->a ) )
        if s = nullptr then return
        select case cast( SymbolKind, s->kind )
        case SYM_VARIABLE
        case SYM_PARAMETER
            bad = ((s->flags and SYMF_BYREF) <> 0) orelse (c.types->Kind( s->type_ ) = TK_REFERENCE)
        case SYM_FIELD
            bad = true
        case else
            return
        end select
    end if
    if bad then c.diags->Report( TKO0953, PointRange( c.ast->Loc( sp->a ) ) )
end sub

sub CheckForConstCounter_ ( byref c as Ctx, byval id as NodeId )
    dim as StmtPayload ptr sp = c.ast->StmtOf( id )
    if (sp->a = NODE_NONE) orelse (sp->c <> NODE_NONE) then return
    if c.ast->Kind( sp->a ) <> N_IDENT then return
    dim as Symbol ptr s = c.syms->SymbolAt( c.info->RefOf( sp->a ) )
    if s = nullptr then return
    dim as boolean k = cbool( (s->flags and SYMF_CONST) <> 0 ) orelse _
                       cbool( cast( SymbolKind, s->kind ) = SYM_CONSTANT ) orelse c.types->IsConst( s->type_ )
    if k = false then return
    c.diags->Report( TKO0617, PointRange( c.ast->Loc( sp->a ) ), c.names->Spelling( s->name ) )
end sub

'' A CAPTURING LAMBDA WHOSE PARAMETER IS THE ENCLOSING GENERIC'S TYPE PARAMETER -- fbc's error
'' 59 at the generic, measured on fbc-modern 1.20, 2026-09-30 (generics/fail-lambda-capture-
'' typaram): the closure's invoke member is built outside the binding that gives T a meaning.
'' A non-capturing lambda, or a capturing one with concrete parameters, is fine. tiko lowers
'' the case, but fbc's limitation is the one to match. The lifted procedure carries the
'' generic's type parameters in 'c' and the closure as its first parameter, '__tko_cl'.
sub CheckLambdaTypeParam_ ( byref c as Ctx, byval id as NodeId )
    dim as StmtPayload ptr sp = c.ast->StmtOf( id )
    if left( lcase( c.names->Spelling( sp->name ) ), 13 ) <> "__tko_lambda_" then return
    if (sp->c = NODE_NONE) orelse (c.ast->Kind( sp->c ) <> N_BLOCK) then return
    dim as ListPayload ptr tp = c.ast->ListOf( sp->c )
    if tp->count = 0 then return
    dim as boolean capturing = false
    for i as int32 = 0 to sp->count - 1
        dim as NodeId pn = c.ast->ChildAt( sp->first, i )
        if (pn = NODE_NONE) orelse (c.ast->Kind( pn ) <> N_PARAM) then continue for
        dim as StmtPayload ptr pp = c.ast->StmtOf( pn )
        if lcase( c.names->Spelling( pp->name ) ) = "__tko_cl" then
            capturing = true
            continue for
        end if
        if capturing = false then continue for
        if (pp->a = NODE_NONE) orelse (c.ast->Kind( pp->a ) <> N_TYPEREF) then continue for
        if (c.ast->Flags( pp->a ) and (NF_PTR or NF_PROC_TYPE)) <> 0 then continue for
        dim as InternId pt = c.ast->StmtOf( pp->a )->name
        if pt = 0 then continue for
        for j as int32 = 0 to tp->count - 1
            dim as NodeId tn = c.ast->ChildAt( tp->first, j )
            if (tn = NODE_NONE) orelse (c.ast->Kind( tn ) <> N_IDENT) then continue for
            if c.names->Fold( c.ast->IdentOf( tn )->name ) = c.names->Fold( pt ) then
                c.diags->Report( TKO0921, PointRange( c.ast->Loc( sp->c ) ), c.names->Spelling( pp->name ), c.names->Spelling( pt ) )
                return
            end if
        next
    next
end sub

'' A NAME TWO USINGS BOTH REACH -- fbc's error 255, "Ambiguous symbol access, explicit scope
'' resolution required", measured on fbc-modern 1.20, 2026-09-30 (namespace/dups_fail):
''
''     using a : using b : print foo            a.foo and b.foo           error 255
''     using c : print foo                      c.foo, and a.foo through c's own 'using a'
''     ...with 'dim as integer foo' declared in the scope first            fine
''
'' A USING applies from where it is written, so each one is taken at its node id (source
'' order), against the scope it sits in. Resolve records the namespace on the N_USING node.
private sub CollectNsNamed_ ( byref c as Ctx, byval ns as ScopeId, byval nm as InternId, _
                              byref got as containers.Array( of uint32 ), byval depth as int32 )
    if (ns = SCOPE_NONE) orelse (depth > 8) then return
    dim as SymbolId sid = c.syms->LookupLocal( ns, nm )
    '' ...NOT A MODULE'S PRIVATE NAME: the interface carries it, imported and not public, so the
    '' module's own code can link, but a lookup does not see it (Lookup's PublicOnly). Counted
    '' here, it made a bare call TKO0919 'ambiguous' beside another module's public one
    '' (tiko-editor TE-012).
    if sid <> SYMBOL_NONE then
        dim as Symbol ptr ps_ = c.syms->SymbolAt( sid )
        if (ps_ <> nullptr) andalso (c.syms->privileged = false) then
            if (ps_->flags and (SYMF_IMPORTED or SYMF_PUBLIC)) = SYMF_IMPORTED then sid = SYMBOL_NONE
        end if
    end if
    if sid <> SYMBOL_NONE then
        dim as boolean seen = false
        for i as int32 = 0 to got.Count - 1
            if got[i] = cast( uint32, sid ) then seen = true
        next
        if seen = false then got.Push( cast( uint32, sid ) )
    end if
    dim as int32 i = c.syms->UsingFirst( ns )
    while i >= 0
        if c.syms->UsingHere( i ) then
            CollectNsNamed_( c, cast( ScopeId, c.syms->usingInner[i] ), nm, got, depth + 1 )
        end if
        i = c.syms->usingNext[i]
    wend
end sub

'' A DECLARATION AN '#import' READ: in a module's interface, or in a header it includes --
'' sys/win's windows.bi, which declares CONTEXT and DECIMAL. SymbolTable.importLocLo.
private function FromImport_ ( byref c as Ctx, byval at as SourceLoc ) as boolean
    dim as int32 lo = 0, hi = c.syms->importLocLo.Count - 1
    while lo <= hi
        dim as int32 m = (lo + hi) \ 2
        if cast( uint32, at ) < c.syms->importLocLo[m] then
            hi = m - 1
        elseif cast( uint32, at ) > c.syms->importLocHi[m] then
            lo = m + 1
        else
            return true
        end if
    wend
    return false
end function

'' ...BUT NOT A NAME A MODULE'S OVERLOADS JOINED (RFC-0001 F4): windows.bi's GetWindowText
'' and qo's are one set, twinned into the unit's own (SymbolTable.JoinTwin), and a bare
'' call chooses among them by signature (tests/modules/overload-join-using).
private function JoinedName_ ( byref c as Ctx, byval nm as InternId ) as boolean
    for q as int32 = 0 to c.syms->joinCopy.Count - 1
        dim as Symbol ptr ts = c.syms->SymbolAt( cast( SymbolId, c.syms->joinCopy[q] ) )
        if (ts <> nullptr) andalso (ts->name = nm) then return true
    next
    return false
end function

sub CheckUsingAmbiguity_ ( byref c as Ctx )
    dim as containers.Array( of uint32 ) uNode, uScope, uInner, uFile
    dim as int32 total = c.ast->Count( )
    for n as int32 = 1 to total - 1
        if c.ast->Kind( cast( NodeId, n ) ) <> N_USING then continue for
        dim as Symbol ptr ns = c.syms->SymbolAt( c.info->RefOf( cast( NodeId, n ) ) )
        if (ns = nullptr) orelse (ns->kind <> cast( uint8, SYM_NAMESPACE )) orelse (ns->inner = SCOPE_NONE) then continue for
        uNode.Push( cast( uint32, n ) )
        uScope.Push( cast( uint32, c.info->ScopeOf( cast( NodeId, n ) ) ) )
        uInner.Push( cast( uint32, ns->inner ) )
        uFile.Push( c.syms->UsingFileOf( cast( uint32, n ), ns->inner ) )
    next
    if uNode.Count < 1 then return
    '' ...BUCKETED BY THE SCOPE THEY STAND IN, node order kept: every name asked every using
    '' of the unit at every scope of its chain, which with CollectNsNamed_'s own scan was
    '' cubic in usings (docs/tiko-speed/LOOKUPS.md M1). uHead by ScopeId, uNext by u, -1 none.
    dim as containers.Array( of int32 ) uHead, uTail, uNext
    for u as int32 = 0 to uNode.Count - 1
        dim as int32 bs = cast( int32, uScope[u] )
        while uHead.Count <= bs
            uHead.Push( -1 )
            uTail.Push( -1 )
        wend
        uNext.Push( -1 )
        if uHead[bs] < 0 then
            uHead[bs] = u
        else
            uNext[uTail[bs]] = u
        end if
        uTail[bs] = u
    next
    '' The right side of a member access is qualified, and not this question.
    dim as containers.Array( of uint8 ) qualified
    for n as int32 = 0 to total
        qualified.Push( 0 )
    next
    for n as int32 = 1 to total - 1
        if c.ast->Kind( cast( NodeId, n ) ) <> N_MEMBER then continue for
        dim as NodeId r = c.ast->BinaryOf( n )->rhs
        if (r > 0) andalso (cast( int32, r ) < total) then qualified[cast( int32, r )] = 1
    next
    for n as int32 = 1 to total - 1
        dim as NodeId x = cast( NodeId, n )
        dim as InternId nm = 0
        select case c.ast->Kind( x )
        case N_IDENT
            if qualified[n] <> 0 then continue for
            nm = c.ast->IdentOf( n )->name
        case N_TYPEREF
            '' ...AND A TYPE NAME: 'dim x as T' over two usings that each declare a T is fbc's
            '' 255 too (measured, fbc-modern 1.20, 2026-10-21). Only a bare one: 'na.T' keeps
            '' its qualifier in ownerName.
            dim as StmtPayload ptr tp = c.ast->StmtOf( n )
            if tp->ownerName <> 0 then continue for
            nm = tp->name
        case else
            continue for
        end select
        if nm = 0 then continue for
        '' A USE WRITTEN IN A HEADER AN '#import' READ is that header's, against its own
        '' declarations -- not the program's text, and not this question. windows.bi's BGR( )
        '' casts to its own WORD, and a 'using' that offers some 'Word' expands it in the
        '' program but must not make the header's own spelling ambiguous.
        if FromImport_( c, c.ast->Loc( x ) ) then continue for
        dim as Symbol ptr s = c.syms->SymbolAt( c.info->RefOf( x ) )
        if s = nullptr then continue for
        select case cast( SymbolKind, s->kind )
        case SYM_VARIABLE, SYM_CONSTANT, SYM_PROC, SYM_ENUMCONST, SYM_UDT, SYM_TYPEDEF, SYM_ENUM
        case else
            continue for
        end select
        dim as SymScope ptr home = c.syms->ScopeAt( s->parent )
        if home = nullptr then continue for
        if (home->kind <> cast( uint8, SCOPEK_NAMESPACE )) andalso (FromImport_( c, s->loc ) = false) then continue for
        '' AN EXPRESSION'S NAME HAS NO SCOPE RECORDED; its statement does, and is built after
        '' it -- the first node past it with a scope is the statement it sits in.
        dim as ScopeId sc = c.info->ScopeOf( x )
        for f as int32 = n + 1 to total - 1
            if sc <> SCOPE_NONE then exit for
            sc = c.info->ScopeOf( cast( NodeId, f ) )
        next
        '' A NAME DECLARED ANYWHERE ON THE CHAIN, above the use, is what the use means: it
        '' beats every using (T58, Lookup). Otherwise the usings of EVERY scope on the chain
        '' are asked together -- fbc's 255 names an inner using's and an outer one's alike.
        ''
        '' ...UNLESS AN '#import' DECLARED IT. sys/win's windows.bi is an imported module's
        '' text, not the program's, so its CONTEXT does not beat 'using tasks''s Context: it is
        '' one more candidate. It won silently, and 'c.Done( )' then asked CPU registers for
        '' a method. A program's own declaration, or its own '#include', still wins.
        dim as boolean declared = false
        dim as SymbolId hdr = SYMBOL_NONE
        dim as ScopeId walk = sc
        for guard as int32 = 0 to 255
            if walk = SCOPE_NONE then exit for
            dim as SymbolId lid = c.syms->LookupLocal( walk, nm )
            dim as Symbol ptr loc_ = c.syms->SymbolAt( lid )
            if loc_ <> nullptr then
                if (loc_->declAt = 0) orelse (loc_->declAt < cast( uint32, n )) then
                    if FromImport_( c, loc_->loc ) andalso (JoinedName_( c, nm ) = false) then hdr = lid : exit for
                    declared = true
                end if
            end if
            if declared then exit for
            dim as SymScope ptr ss = c.syms->ScopeAt( walk )
            if ss = nullptr then exit for
            walk = ss->parent
        next
        if declared then continue for
        '' Two are enough to report, so the walk stops there; nothing else reads 'got'.
        dim as containers.Array( of uint32 ) got
        if hdr <> SYMBOL_NONE then got.Push( cast( uint32, hdr ) )
        for guard as int32 = 0 to 255
            if (sc = SCOPE_NONE) orelse (got.Count >= 2) then exit for
            dim as int32 u = -1
            if cast( int32, sc ) < uHead.Count then u = uHead[cast( int32, sc )]
            while (u >= 0) andalso (got.Count < 2)
                '' Node order: every later using of the bucket stands at or below n too.
                if uNode[u] >= cast( uint32, n ) then exit while
                if c.syms->UsingFileSees( uFile[u], cast( uint32, n ) ) then
                    CollectNsNamed_( c, cast( ScopeId, uInner[u] ), nm, got, 0 )
                end if
                u = uNext[u]
            wend
            dim as SymScope ptr ss = c.syms->ScopeAt( sc )
            if ss = nullptr then exit for
            sc = ss->parent
        next
        if got.Count >= 2 then
            c.diags->Report( TKO0919, PointRange( c.ast->Loc( x ) ), c.names->Spelling( nm ) )
            if hdr <> SYMBOL_NONE then
                c.diags->Report( TKO0866, PointRange( c.syms->SymbolAt( hdr )->loc ), c.names->Spelling( nm ) )
            end if
        end if
    next
end sub

'' A BARE 'type( ... )' WITH NO SINGLE TYPE TO BUILD -- fbc's error 71, "Incomplete type",
'' measured on fbc-modern 1.20, 2026-09-30:
''
''     f( type( 0 ) ) over an OVERLOADED f                      structs/anon-ambigious-argument
''     if type( 0 ) then                                        expressions/typeini-error-recovery-2
''     f( type( 0 ) ) over one 'byref as integer' f             fine: the parameter is the type
''
'' tiko reached emission with no type for the literal: an internal error for the first, and
'' IR clang refused for the second. One passed to a single procedure takes its parameter's.
sub CheckBareTypeLiterals_ ( byref c as Ctx )
    dim as int32 total = c.ast->Count( )
    dim as containers.Array( of uint8 ) argOf
    for n as int32 = 0 to total
        argOf.Push( 0 )
    next
    for n as int32 = 1 to total - 1
        if c.ast->Kind( cast( NodeId, n ) ) <> N_CALL then continue for
        dim as ListPayload ptr lp = c.ast->ListOf( n )
        if lp->target = NODE_NONE then continue for
        dim as Symbol ptr hs = c.syms->SymbolAt( c.info->RefOf( lp->target ) )
        if hs = nullptr then hs = c.syms->SymbolAt( c.info->RefOf( cast( NodeId, n ) ) )
        dim as uint8 mark = 1
        if (hs <> nullptr) andalso (hs->kind = cast( uint8, SYM_PROC )) andalso (hs->nextOverload <> SYMBOL_NONE) then mark = 2
        for i as int32 = 0 to lp->count - 1
            dim as NodeId a = c.ast->ChildAt( lp->first, i )
            if (a > 0) andalso (cast( int32, a ) < total) then argOf[cast( int32, a )] = mark
        next
    next
    '' ...AND WHERE NOTHING SUPPLIES ONE: a condition, or the object of a member access. Check
    '' types a context-less literal as an anonymous TUPLE, so its having a type says nothing
    '' there ('print x.i = type( 1, 2 ).i' is fbc's 71 too). Only these positions are judged:
    '' an assignment, a return, 'function =' or a nested '{ }' initializer takes a type from
    '' what it fills, and 'no type recorded' was wrong for several of those (the corpus).
    for n as int32 = 1 to total - 1
        dim as NodeId cn = NODE_NONE, cn2 = NODE_NONE
        select case c.ast->Kind( cast( NodeId, n ) )
        case N_IF_BRANCH, N_WHILE, N_DO
            cn = c.ast->StmtOf( n )->a
        case N_MEMBER
            cn = c.ast->BinaryOf( n )->lhs
        end select
        if (cn > 0) andalso (cast( int32, cn ) < total) then argOf[cast( int32, cn )] = 3
        if (cn2 > 0) andalso (cast( int32, cn2 ) < total) then argOf[cast( int32, cn2 )] = 3
    next
    for n as int32 = 1 to total - 1
        dim as NodeId id = cast( NodeId, n )
        if c.ast->Kind( id ) <> N_TUPLE then continue for
        if (c.ast->Flags( n ) and NF_TYPE_LITERAL) = 0 then continue for
        if c.ast->ListOf( n )->target <> NODE_NONE then continue for
        dim as boolean bad = (argOf[n] = 2) orelse (argOf[n] = 3)
        if bad then c.diags->Report( TKO0925, PointRange( c.ast->Loc( id ) ) )
    next
end sub
