'' resolvedefer.tiko -- a GOTO that crosses a DEFER, fbc's error 349.
''
'' Included from resolvestmt.tiko. Run from Resolve's WalkStmt, which visits statements in
'' source order and has each one's scope in hand.
''
'' A defer is registered LEXICALLY: its scope's cleanup runs it whether or not control
'' passed over it. So a jump that skips it and lands where it is in scope would run a
'' statement that "was never reached", and fbc refuses the jump:
''
''     error 349: Branch crossing a DEFER statement, to label: SKIP
''
'' Measured on fbc-modern 1.20, 2026-09-25, 25 probes. Reported on the GOTO's line, once for
'' each defer crossed:
''
''     goto L : defer ... : L:                        same scope                  349
''     goto L : scope : defer ... : L: : end scope    into the defer's scope      349
''     scope : goto L : end scope : defer ... : L:    out of a scope, then past   349
''     if c then goto L / select, a loop body, a FUNCTION, a scope at module level  349
''     goto L : scope : defer ... : end scope : L:    the defer's scope has closed accepted
''     if c then : defer ... : else : L:              the other branch            accepted
''     goto L : if 1 then defer ... : L:              a single-line IF's own scope accepted
''     L: : defer ... : goto L                        backward                    accepted
''     scope : defer ... : goto L : end scope : L:    out of the defer's scope    accepted
''     on n goto L1, L2 past a defer                                              accepted
''     goto L / defer : print "y" / L:     'defer :' first on a line is a LABEL accepted
''
'' So: a FORWARD goto, a defer after it, and the label inside the defer's scope. Every
'' goto, defer and label is numbered as the walk meets it; at a label, each earlier goto
'' to that name is checked against the defers met since it. Keyed by the procedure, as
'' labels are. The discovery pass of generic.tiko walks a unit twice, so the lists are
'' reset between the two, and what is reported is remembered by location.

private function DeferProcScope_ ( byref c as Ctx, byval s as Tko.ScopeId ) as Tko.ScopeId
    dim as Tko.ScopeId cur = s
    for guard as long = 0 to 4095
        if cur = Tko.SCOPE_NONE then exit for
        dim as Tko.SymScope ptr ss = c.syms->ScopeAt( cur )
        if ss = 0 then exit for
        if ss->kind <> Tko.SCOPEK_BLOCK then return cur
        cur = ss->parent
    next
    return Tko.SCOPE_NONE
end function

private function DeferScopeHolds_ _
    ( byref c as Ctx, byval outer as Tko.ScopeId, byval inner as Tko.ScopeId ) as boolean
    dim as Tko.ScopeId cur = inner
    for guard as long = 0 to 4095
        if cur = Tko.SCOPE_NONE then exit for
        if cur = outer then return true
        dim as Tko.SymScope ptr ss = c.syms->ScopeAt( cur )
        if ss = 0 then exit for
        cur = ss->parent
    next
    return false
end function

sub DeferCrossingReset_ ( byref c as Ctx )
    c.xgName.Clear( ) : c.xgNode.Clear( ) : c.xgProc.Clear( ) : c.xgSeq.Clear( )
    c.xdScope.Clear( ) : c.xdNode.Clear( ) : c.xdProc.Clear( ) : c.xdSeq.Clear( )
    c.xSeenGoto.Clear( ) : c.xSeenDefer.Clear( )
end sub

private sub DeferCrossReport_ ( byref c as Ctx, byval g as long, byval d as long, byval nm as Tko.InternId )
    dim as Tko.SourceLoc gl = c.ast->Loc( cast( Tko.NodeId, c.xgNode[g] ) )
    dim as Tko.SourceLoc dl = c.ast->Loc( cast( Tko.NodeId, c.xdNode[d] ) )
    for i as long = 0 to c.xSeenGoto.Count - 1
        if (c.xSeenGoto[i] = cast( ulong, gl )) andalso (c.xSeenDefer[i] = cast( ulong, dl )) then return
    next
    c.xSeenGoto.Push( cast( ulong, gl ) )
    c.xSeenDefer.Push( cast( ulong, dl ) )
    c.diags->Report( Tko.TKO0827, Tko.PointRange( gl ), c.names->Spelling( nm ) )
end sub

private sub DeferCrossing_ ( byref c as Ctx, byval id as Tko.NodeId, byval here as Tko.ScopeId )
    dim as Tko.NodeKind k = c.ast->Kind( id )
    if (k <> Tko.N_GOTO) andalso (k <> Tko.N_DEFER) andalso (k <> Tko.N_LABEL) then return
    dim as Tko.StmtPayload ptr sp = StmtOf( c, id )
    dim as Tko.ScopeId proc = DeferProcScope_( c, here )
    c.xSeq += 1
    select case k
    case Tko.N_GOTO
        if sp->name = 0 then return
        c.xgName.Push( cast( ulong, sp->name ) ) : c.xgNode.Push( cast( ulong, id ) )
        c.xgProc.Push( cast( ulong, proc ) ) : c.xgSeq.Push( c.xSeq )
    case Tko.N_DEFER
        '' A bare 'defer' is TKO0828 and defers nothing -- parser/defer.tiko.
        if sp->b = Tko.NODE_NONE then return
        c.xdScope.Push( cast( ulong, here ) ) : c.xdNode.Push( cast( ulong, id ) )
        c.xdProc.Push( cast( ulong, proc ) ) : c.xdSeq.Push( c.xSeq )
    case Tko.N_LABEL
        if c.xdScope.Count = 0 then return
        for g as long = 0 to c.xgName.Count - 1
            if c.xgName[g] <> cast( ulong, sp->name ) then continue for
            if c.xgProc[g] <> cast( ulong, proc ) then continue for
            for d as long = 0 to c.xdScope.Count - 1
                if c.xdProc[d] <> cast( ulong, proc ) then continue for
                if c.xdSeq[d] < c.xgSeq[g] then continue for
                if DeferScopeHolds_( c, cast( Tko.ScopeId, c.xdScope[d] ), here ) then
                    DeferCrossReport_( c, g, d, sp->name )
                end if
            next
        next
    end select
end sub
