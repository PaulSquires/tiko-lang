'' sem.tiko -- THE POST-CHECK PASS, Tko.Sem.Run: the tree walk and the sweeps, in their order.
''
'' Run alone (LATER-PLAN E step 3, review ARCH-01). The walk and the member-access checks are in
'' semwalk.tiko; the sweeps in semassign, semproc, semdecl, semsweep and semlate; what each
'' calls in another is declared in semcalls.ti. Tko.Vis until 2026-10-24.

#import "std/containers"
#include once "symbols/sem.ti"
#include once "diag/diagids.ti"
#include once "symbols/check.ti"
#include once "symbols/modsym.ti"
#include once "types/udtlayout.ti"

namespace Tko.Sem

#include once "symbols/visctx.ti"
#include once "symbols/semcalls.ti"

sub Run( byref u as FrontUnit )

    dim as Ctx c
    c.srcMgr = u.src
    c.errFlags = u.errFlags
    VisRunGen_( true )
    c.ast = u.ast
    c.syms = u.syms
    c.types = u.types
    c.names = u.names
    c.diags = u.diags
    c.info = u.info
    c.baseName = c.names->GetString( "base" )
    c.root = u.root
    RecordFirstRedims_( c )
    RecordChosenOverloads_( c )
    RecordPropertyStores_( c )       '' after it: a plain store's setter replaces the getter
    Walk_( c, u.root, TYPE_NONE )
    WalkGenericInstances_( c )     '' not in the tree -- visinst.tiko
    '' The OTHER thing that needs Check to have finished: half the shapes are 'var', and
    '' an inferred type does not exist until Check has run.
    CheckStaticStringInits( c )
    CheckPropertyUses_( c )          '' propaccess.tiko: swap, '@' and '()' over a property
    CheckQualifiedStringInits_( c )
    CheckImplicitStructors_( c )
    CheckFixLenParams_( c )
    CheckNestedStatics_( c )
    CheckSharedInits_( c )
    CheckQualifiedInits_( c )
    CheckOutsideNamespace_( c ) : DefineQualifiedExterns_( c )
    CheckStructorOutsideNamespace_( c )
    CheckConstBounds_( c )
    CheckReturnStyles_( c ) : CheckSubReturnValue_( c )
    CheckByrefResultSet_( c )
    CheckAliasAgrees_( c )
    CheckDuplicateOverloads_( c )
    CheckBitfieldWidths_( c )
    CheckArrayDeclShapes_( c )
    CheckRedimRank_( c )
    CheckUnionInitGroups_( c )
    CheckStaticInitFromVar_( c )
    CheckSharedInBlock_( c )
    RunLateSweeps2_( c )
    CheckByrefBinding_( c )
    CheckConstDeclTypes_( c )
    CheckBaseHasDefaultCtor_( c )
    CheckPrivateBaseStructor_( c )
    CheckExternInitAndDefaultCtor_( c )
    CheckUnionMembers_( c )
    CheckVirtualNeedsObject_( c )
    ApplyIfaceWraps_( c )            '' last: it grows the AST pools -- semiface.tiko
end sub

end namespace
