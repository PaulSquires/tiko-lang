'' modsym.tiko -- which symbols are module code, and what a module lets out (ADR 0017;
'' RFC-0002 §3-4).
''
'' MODULE CODE is decided by WHERE A NAME IS DECLARED: at module level, or in a namespace at
'' module level, in one of the unit's own files. A header the module includes -- windows.bi
'' -- is not module code: its names keep their classic link names, which is what lets them
'' mean the same thing to every unit of the program. A declaration a header's MACRO writes
'' into a module file carries the header's location, and is classic too.
''
'' THE WORDS WRITTEN are read off the declarations, where the parser left them
'' (PF_VIS_PUBLIC, PF_VIS_PRIVATE), and put on every symbol of that name in that scope: an
'' overload set is one name, and 'public declare' above a plain definition makes the
'' definition public.

#import "std/containers"
#include once "symbols/modsym.ti"
#include once "support/text.ti"

namespace Tko.ModSym

sub Begin _
    ( byref syms as Tko.SymbolTable, byref files as Tko.FileIdVec, byref chain as string )

    syms.modFileCount = files.Count
    syms.modFiles.Clear( )
    for each f as uint32 in files
        syms.modFiles.Push( f )
    next
    syms.selfChain.Clear( )
    dim as int32 st = 1
    do
        dim as int32 dt = instr( st, chain, "." )
        dim as string one_ = iif( dt = 0, mid( chain, st ), mid( chain, st, dt - st ) )
        if len( one_ ) > 0 then syms.selfChain.Push( Tko.Text.UpperAscii( one_ ) )
        if dt = 0 then exit do
        st = dt + 1
    loop
end sub

'' At module level: the MODULE scope, through any number of namespaces and nothing else.
private function ModuleLevel_( byref syms as Tko.SymbolTable, byval sc as Tko.ScopeId ) as boolean
    dim as Tko.ScopeId cur = sc
    while cur <> Tko.SCOPE_NONE
        dim as Tko.SymScope ptr s = syms.ScopeAt( cur )
        if s = nullptr then return false
        if s->kind = cast( uint8, Tko.SCOPEK_MODULE ) then return true
        if s->kind <> cast( uint8, Tko.SCOPEK_NAMESPACE ) then return false
        cur = s->parent
    wend
    return false
end function

private function InUnit_ _
    ( byref syms as Tko.SymbolTable, byref src as Tko.SourceManager, _
      byval loc as Tko.SourceLoc ) as boolean
    if loc = Tko.LOC_NONE then return false
    dim as uint32 f = cast( uint32, src.Decode( loc ).file )
    for each m as uint32 in syms.modFiles
        if m = f then return true
    next
    return false
end function

private function MarkKey_( byval sc as Tko.ScopeId, byval nm as Tko.InternId ) as int64
    return (cast( int64, cast( uint32, sc ) ) shl 32) or cast( int64, cast( uint32, nm ) )
end function

'' THE WORDS ARE GATHERED FIRST and put on the symbols in one pass: a scan of the whole table per
'' declaration was declarations x symbols, and an importer of sys/win -- tens of thousands of
'' public names over as many symbols -- spent minutes in it per unit (tracks-2026).
private sub MarkNamed_ _
    ( byref marks as containers.Map( of int64, uint32 ), byval sc as Tko.ScopeId, _
      byval nm as Tko.InternId, byval f as uint32 )
    if nm = 0 then return
    dim as int64 key = MarkKey_( sc, nm )
    dim as uint32 had = 0
    marks.TryGet( key, had )
    marks.Put( key, had or f )
end sub

private function InFiles_ _
    ( byref src as Tko.SourceManager, byref files as Tko.FileIdVec, _
      byval loc as Tko.SourceLoc ) as boolean
    if loc = Tko.LOC_NONE then return false
    dim as uint32 f = cast( uint32, src.Decode( loc ).file )
    for each m as uint32 in files
        if m = f then return true
    next
    return false
end function

'' THE WORDS WRITTEN on every declaration -- of the files given, or of any file when there
'' are none -- put on the symbols they declared.
private sub MarkWords_ _
    ( byref ast as Tko.AstArena, byref syms as Tko.SymbolTable, _
      byref info as Tko.SemanticInfo, byref src as Tko.SourceManager, _
      byref only as Tko.FileIdVec )

    dim as containers.Map( of int64, uint32 ) marks
    for n as int32 = 1 to ast.Count( )
        dim as Tko.NodeId id = cast( Tko.NodeId, n )
        dim as Tko.NodeKind k = ast.Kind( id )
        select case k
        case Tko.N_PROC, Tko.N_VAR, Tko.N_CONST, Tko.N_TYPE, Tko.N_ENUM, Tko.N_TYPEDEF, _
             Tko.N_NAMESPACE, Tko.N_INTERFACE
        case else
            continue for
        end select
        dim as Tko.StmtPayload ptr sp = ast.StmtOf( n )
        dim as uint32 vis = sp->extra and (Tko.PF_VIS_PUBLIC or Tko.PF_VIS_PRIVATE)
        if vis = 0 then continue for
        if only.Count > 0 then
            if InFiles_( src, only, ast.Loc( n ) ) = false then continue for
        end if
        dim as uint32 f = iif( (vis and Tko.PF_VIS_PUBLIC) <> 0, Tko.SYMF_PUBLIC, Tko.SYMF_PRIVDECL )
        '' A NODE THAT OPENS A SCOPE -- a procedure, a type, a namespace -- records the one it
        '' opens (collect.tiko), and its name is declared in the one around it: the scope
        '' whose owner is the node's own name steps out once.
        dim as Tko.ScopeId sc = info.ScopeOf( id )
        dim as Tko.SymScope ptr os = syms.ScopeAt( sc )
        if os <> nullptr then
            dim as Tko.Symbol ptr ow = syms.SymbolAt( os->owner )
            if ow <> nullptr then
                if ow->name = sp->name then sc = os->parent
            end if
        end if
        if ModuleLevel_( syms, sc ) = false then continue for
        if (k = Tko.N_VAR) orelse (k = Tko.N_CONST) then
            for i as int32 = 0 to sp->count - 1
                dim as Tko.NodeId item = ast.ChildAt( sp->first, i )
                if ast.Kind( item ) <> Tko.N_VAR_ITEM then continue for
                MarkNamed_( marks, sc, ast.StmtOf( item )->name, f )
            next
        elseif k = Tko.N_ENUM then
            '' AN ENUM'S CONSTANTS ARE AS PUBLIC AS IT IS -- the copies a plain enum puts in
            '' the scope around it and the ones in its own. 'shapes.GREEN' of a 'public enum'
            '' was TKO0860 in an importer, and an anonymous enum's had no other spelling.
            MarkNamed_( marks, sc, sp->name, f )
            dim as Tko.ScopeId inner = Tko.SCOPE_NONE
            if sp->name <> 0 then
                dim as Tko.Symbol ptr es = syms.SymbolAt( syms.LookupLocal( sc, sp->name ) )
                if es <> nullptr then
                    if es->kind = cast( uint8, Tko.SYM_ENUM ) then inner = es->inner
                end if
            end if
            for i as int32 = 0 to sp->count - 1
                dim as Tko.NodeId item = ast.ChildAt( sp->first, i )
                if ast.Kind( item ) <> Tko.N_ENUM_ITEM then continue for
                dim as Tko.InternId inm = ast.StmtOf( item )->name
                MarkNamed_( marks, sc, inm, f )
                if inner <> Tko.SCOPE_NONE then MarkNamed_( marks, inner, inm, f )
            next
        else
            MarkNamed_( marks, sc, sp->name, f )
        end if
    next

    if marks.Count( ) = 0 then return
    for si as int32 = 1 to syms.Count( )
        dim as Tko.Symbol ptr s = syms.SymbolAt( cast( Tko.SymbolId, si ) )
        if s = nullptr then continue for
        if s->name = 0 then continue for
        dim as uint32 f = 0
        if marks.TryGet( MarkKey_( s->parent, s->name ), f ) then s->flags or= f
    next
end sub

sub Mark _
    ( byref ast as Tko.AstArena, byref syms as Tko.SymbolTable, _
      byref info as Tko.SemanticInfo, byref src as Tko.SourceManager, _
      byref diags as Tko.DiagnosticEngine )

    if syms.modFileCount = 0 then return

    for si as int32 = 1 to syms.Count( )
        dim as Tko.Symbol ptr s = syms.SymbolAt( cast( Tko.SymbolId, si ) )
        if s = nullptr then continue for
        if ModuleLevel_( syms, s->parent ) = false then continue for
        if InUnit_( syms, src, s->loc ) = false then continue for
        s->flags or= Tko.SYMF_MODSRC
        '' 'common' SHARES STORAGE BY SPELLING across units, which is the coupling modules
        '' replace (RFC-0003 §4).
        if (s->flags and Tko.SYMF_COMMON) <> 0 then
            diags.Report( Tko.TKO0366, Tko.PointRange( s->loc ), "'common'" )
        end if
    next
    dim as Tko.FileIdVec any_
    MarkWords_( ast, syms, info, src, any_ )

    '' A PUBLIC NAME SPELLED LIKE ITS MODULE (M27): 'http.http' would name it, and an
    '' importer that wrote 'using http' could no longer tell the module from the name.
    if (syms.selfChain.Count = 0) orelse (syms.names = nullptr) then return
    dim as string self_ = syms.selfChain[syms.selfChain.Count - 1]
    for si as int32 = 1 to syms.Count( )
        dim as Tko.Symbol ptr s = syms.SymbolAt( cast( Tko.SymbolId, si ) )
        if s = nullptr then continue for
        if (s->flags and (Tko.SYMF_MODSRC or Tko.SYMF_PUBLIC)) <> (Tko.SYMF_MODSRC or Tko.SYMF_PUBLIC) then continue for
        dim as Tko.SymScope ptr ps = syms.ScopeAt( s->parent )
        if ps = nullptr then continue for
        if ps->kind <> cast( uint8, Tko.SCOPEK_MODULE ) then continue for
        if Tko.Text.UpperAscii( syms.names->Spelling( s->name ) ) <> self_ then continue for
        diags.Report( Tko.TKO0870, Tko.PointRange( s->loc ), _
                      syms.names->Spelling( s->name ), Tko.Text.LowerAscii( self_ ) )
    next
end sub

sub MarkImported _
    ( byref ast as Tko.AstArena, byref syms as Tko.SymbolTable, _
      byref info as Tko.SemanticInfo, byref src as Tko.SourceManager, _
      byref ifaces as Tko.FileIdVec )

    if ifaces.Count = 0 then return
    for si as int32 = 1 to syms.Count( )
        dim as Tko.Symbol ptr s = syms.SymbolAt( cast( Tko.SymbolId, si ) )
        if s = nullptr then continue for
        if ModuleLevel_( syms, s->parent ) = false then continue for
        if InFiles_( src, ifaces, s->loc ) = false then continue for
        s->flags or= Tko.SYMF_IMPORTED
    next
    MarkWords_( ast, syms, info, src, ifaces )
end sub

function ModuleScope( byref syms as Tko.SymbolTable ) as Tko.ScopeId
    for sc as int32 = 1 to syms.ScopeCount( )
        dim as Tko.SymScope ptr ss = syms.ScopeAt( cast( Tko.ScopeId, sc ) )
        if ss = nullptr then continue for
        if ss->kind = cast( uint8, Tko.SCOPEK_MODULE ) then return cast( Tko.ScopeId, sc )
    next
    return Tko.SCOPE_GLOBAL
end function

function OrderFree( byref syms as Tko.SymbolTable, byval sid as Tko.SymbolId ) as boolean
    dim as Tko.Symbol ptr s = syms.SymbolAt( sid )
    if s = nullptr then return false
    '' The module's own names, and in an importer the names its interface brought in: the
    '' interface is the module's text, in the module's order, which had none.
    const ORDERLESS = Tko.SYMF_MODSRC or Tko.SYMF_IMPORTED
    '' An enum's member, or a type's, goes with its owner.
    if (s->flags and ORDERLESS) = 0 then
        dim as Tko.SymScope ptr ps = syms.ScopeAt( s->parent )
        if ps = nullptr then return false
        select case ps->kind
        case cast( uint8, Tko.SCOPEK_TYPE )     '' an enum opens one too
        case else
            return false
        end select
        s = syms.SymbolAt( ps->owner )
        if s = nullptr then return false
        if (s->flags and ORDERLESS) = 0 then return false
    end if
    if s->kind = cast( uint8, Tko.SYM_VARIABLE ) then
        return (s->flags and (Tko.SYMF_SHARED or Tko.SYMF_EXTERN)) <> 0
    end if
    return true
end function

sub Inherit( byref syms as Tko.SymbolTable, byval sid as Tko.SymbolId, byval from as Tko.SymbolId )
    dim as Tko.Symbol ptr s = syms.SymbolAt( sid )
    dim as Tko.Symbol ptr f = syms.SymbolAt( from )
    if (s = nullptr) orelse (f = nullptr) then return
    s->flags or= (f->flags and Tko.SYMF_MODMASK)
end sub

sub ProcLinkage _
    ( byref syms as Tko.SymbolTable, byval sid as Tko.SymbolId, _
      byref isPrivate as boolean, byref isExported as boolean, byref isHidden as boolean )

    dim as Tko.Symbol ptr s = syms.SymbolAt( sid )
    if s = nullptr then return
    '' A MEMBER TAKES ITS TYPE'S VISIBILITY: a public type's methods are public, and a
    '' module-private type's hidden. 'private:' sections are access, not linkage.
    if (s->flags and Tko.SYMF_MODSRC) = 0 then
        dim as Tko.SymScope ptr ps = syms.ScopeAt( s->parent )
        if ps = nullptr then return
        if ps->kind <> cast( uint8, Tko.SCOPEK_TYPE ) then return
        s = syms.SymbolAt( ps->owner )
        if s = nullptr then return
        if (s->flags and Tko.SYMF_MODSRC) = 0 then return
    end if
    if isPrivate then return
    if (s->flags and Tko.SYMF_PRIVDECL) <> 0 then
        isPrivate = true
        return
    end if
    if (s->flags and Tko.SYMF_PUBLIC) <> 0 then return
    isHidden = true
    isExported = false
end sub

'' THE FIRST MODULE-PRIVATE NAMED TYPE 't' is built from, or SYMBOL_NONE. Through pointers,
'' references, arrays and a procedure type's result and parameters. A PUBLIC typedef is a
'' name the importer has, whatever it stands for, so the walk stops there; a generic's type
'' parameter is declared in the generic, not at module level, and is never module code.
private function HiddenTypeIn_ _
    ( byref syms as Tko.SymbolTable, byref types as Tko.TypeContext, _
      byval t as Tko.TypeId, byval depth as int32 ) as Tko.SymbolId

    if (t = Tko.TYPE_NONE) orelse (depth > 16) then return Tko.SYMBOL_NONE
    select case types.Kind( t )
    case Tko.TK_POINTER, Tko.TK_REFERENCE, Tko.TK_ARRAY
        return HiddenTypeIn_( syms, types, types.Inner( t ), depth + 1 )
    case Tko.TK_PROC
        dim as Tko.SymbolId h = HiddenTypeIn_( syms, types, types.Inner( t ), depth + 1 )
        for i as int32 = 0 to types.ProcParamCount( t ) - 1
            if h <> Tko.SYMBOL_NONE then exit for
            h = HiddenTypeIn_( syms, types, types.ProcParam( t, i ), depth + 1 )
        next
        return h
    case Tko.TK_UDT, Tko.TK_ENUM, Tko.TK_TYPEDEF, Tko.TK_FORWARD
        dim as Tko.InternId tn = types.NameOf( t )
        if tn = 0 then return Tko.SYMBOL_NONE
        dim as Tko.ScopeId ds = cast( Tko.ScopeId, types.DeclScopeOf( t ) )
        dim as Tko.SymbolId ts = syms.LookupLocalTyped( ds, tn, true )
        dim as Tko.Symbol ptr ns = syms.SymbolAt( ts )
        if ns = nullptr then return Tko.SYMBOL_NONE
        if (ns->flags and Tko.SYMF_MODSRC) = 0 then return Tko.SYMBOL_NONE
        if (ns->flags and Tko.SYMF_PUBLIC) <> 0 then return Tko.SYMBOL_NONE
        return ts
    end select
    return Tko.SYMBOL_NONE
end function

'' WHAT AN IMPORTER SEES of 's': a public module-level declaration, or a member of a public
'' type that is not 'private:' or 'protected:'. Its name as a message spells it.
private function Exposed_ _
    ( byref syms as Tko.SymbolTable, byval s as Tko.Symbol ptr, byref what as string ) as boolean

    const PUB = Tko.SYMF_MODSRC or Tko.SYMF_PUBLIC
    what = syms.names->Spelling( s->name )
    if (s->flags and PUB) = PUB then return true
    dim as Tko.SymScope ptr ps = syms.ScopeAt( s->parent )
    if ps = nullptr then return false
    if ps->kind <> cast( uint8, Tko.SCOPEK_TYPE ) then return false
    dim as Tko.Symbol ptr ow = syms.SymbolAt( ps->owner )
    if ow = nullptr then return false
    if ow->kind <> cast( uint8, Tko.SYM_UDT ) then return false
    if (ow->flags and PUB) <> PUB then return false
    if (s->flags and (Tko.SYMF_MEMB_PRIVATE or Tko.SYMF_MEMB_PROTECTED)) <> 0 then return false
    what = syms.names->Spelling( ow->name ) & "." & what
    return true
end function

sub CheckPublicTypes _
    ( byref syms as Tko.SymbolTable, byref types as Tko.TypeContext, _
      byref diags as Tko.DiagnosticEngine )

    if (syms.modFileCount = 0) orelse (syms.names = nullptr) then return
    dim as uint32 savePos = syms.usePos
    syms.usePos = Tko.USEPOS_LATEST
    for si as int32 = 1 to syms.Count( )
        dim as Tko.Symbol ptr s = syms.SymbolAt( cast( Tko.SymbolId, si ) )
        if s = nullptr then continue for
        if (s->flags and Tko.SYMF_GENERIC_INST) <> 0 then continue for
        select case s->kind
        case cast( uint8, Tko.SYM_PROC ), cast( uint8, Tko.SYM_VARIABLE ), _
             cast( uint8, Tko.SYM_CONSTANT ), cast( uint8, Tko.SYM_FIELD ), _
             cast( uint8, Tko.SYM_TYPEDEF )
        case else
            continue for
        end select
        dim as string what
        if Exposed_( syms, s, what ) = false then continue for
        '' A typedef is checked for what it stands for: its own name is the public one.
        dim as Tko.TypeId t = s->type_
        if (s->kind = cast( uint8, Tko.SYM_TYPEDEF )) andalso (types.Kind( t ) = Tko.TK_TYPEDEF) then
            t = types.Inner( t )
        end if
        dim as Tko.SymbolId h = HiddenTypeIn_( syms, types, t, 0 )
        '' A procedure's parameters are the symbols of the scope it opens.
        if (h = Tko.SYMBOL_NONE) andalso (s->kind = cast( uint8, Tko.SYM_PROC )) then
            dim as Tko.SymScope ptr ins = syms.ScopeAt( s->inner )
            dim as Tko.SymbolId p = iif( ins = nullptr, Tko.SYMBOL_NONE, ins->firstSym )
            while (p <> Tko.SYMBOL_NONE) andalso (h = Tko.SYMBOL_NONE)
                dim as Tko.Symbol ptr ps = syms.SymbolAt( p )
                if ps = nullptr then exit while
                if ps->kind = cast( uint8, Tko.SYM_PARAMETER ) then
                    h = HiddenTypeIn_( syms, types, ps->type_, 0 )
                end if
                p = ps->nextInScope
            wend
        end if
        if h = Tko.SYMBOL_NONE then continue for
        diags.Report( Tko.TKO0868, Tko.PointRange( s->loc ), _
                      syms.names->Spelling( syms.SymbolAt( h )->name ), what )
    next
    syms.usePos = savePos
end sub

end namespace
