'' basector.tiko -- A BASE WITH NO DEFAULT CONSTRUCTOR: what the derived type must then write
'' itself. CheckBaseHasDefaultCtor_, asked once over every UDT and constructor definition.
''
'' Included from latesweeps2.tiko, below declshape.tiko, in the same namespace and over the same
'' Ctx. It was in latechecks.tiko, which is at the line cap.
''
'' Measured on fbc-modern 1.20, 2026-09-30, over a Parent whose only constructor is
'' 'constructor( byval as integer )':
''
''     type Child extends Parent : j as integer : end type       error 186, at 'end type'
''     ...declares 'constructor( )' and nothing else             error 188, at 'end type'
''     ...declares only 'constructor( byref as const Child )'    fine
''     ...declares both, each calling 'base( ... )'              fine (structs/base-init.bas)
''     ...one of them without 'base( ... )'                      error 185, at its 'end constructor'
''     ...'constructor( 5 )' delegating to one that calls base   fine
''
'' 186 is the implicit DEFAULT constructor, 188 the implicit COPY constructor -- fbc can make
'' neither without a default one to call in the base -- and 185 a written constructor that
'' leaves the base to its default. tiko reported every derived type, at its 'type' line.

'' The base has constructors, and none takes no argument. A declaration that cannot be read
'' counts as a default: not knowing is not grounds for refusing.
private function BaseLacksDefaultCtor_ ( byref c as Ctx, byval base_ as TypeId ) as boolean
    if base_ = TYPE_NONE then return false
    dim as Symbol ptr walk = StructorOf_( c, base_, "__ctor" )
    if walk = nullptr then return false
    for guard as int32 = 0 to 999
        if walk = nullptr then exit for
        dim as int32 req = RequiredParams_( c, cast( NodeId, walk->payload ) )
        if (req = 0) orelse (req = -1) then return false
        walk = c.syms->SymbolAt( walk->nextOverload )
    next
    return true
end function

'' A written copy constructor -- or, with 'nm' = "let", an assignment: its first parameter is
'' this type by reference, CONST as 'wantConst' says, and nothing after it is required.
'' 'byref as Child' without the const is still fbc's 188, whose message names
'' 'constructor(byref as const UDT)' (structs/base-init-missing-1.bas). And a non-const
'' 'operator let( byref as Child )' asks for 'constructor( byref as Child )' as well: fbc's
'' 187 (structs/implicit-copyctor-impossible.bas), fine once both are written.
private function HasCopyCtor_ ( byref c as Ctx, byval t as TypeId, byval wantConst as boolean = true, byref nm as string = "__ctor" ) as boolean
    dim as Symbol ptr ct = StructorOf_( c, t, nm )
    for guard as int32 = 0 to 999
        if ct = nullptr then exit for
        dim as NodeId cd = cast( NodeId, ct->payload )
        if (cd = NODE_NONE) orelse (c.ast->Kind( cd ) <> N_PROC) then return (nm = "__ctor")
        dim as StmtPayload ptr cp = @c.ast->stmts[cast( int32, c.ast->nodes[cast( int32, cd )].data )]
        if RequiredParams_( c, cd ) = 1 then
            for i as int32 = 0 to cp->count - 1
                dim as NodeId pn = cast( NodeId, c.ast->children[cp->first + i] )
                if c.ast->Kind( pn ) <> N_PARAM then continue for
                dim as NodeId pta = c.ast->stmts[cast( int32, c.ast->nodes[cast( int32, pn )].data )].a
                if pta = NODE_NONE then exit for
                dim as TypeId pt = c.info->TypeOf_( pta )
                if c.types->Kind( c.types->Unqualify( pt ) ) = TK_REFERENCE then pt = c.types->Inner( c.types->Unqualify( pt ) )
                if (c.types->Unqualify( pt ) = t) andalso (c.types->IsConst( pt ) = wantConst) then return true
                exit for
            next
        end if
        ct = c.syms->SymbolAt( ct->nextOverload )
    next
    return false
end function

'' Does this constructor body OPEN with 'base( ... )', or delegate with 'constructor( ... )'?
'' Only its first statement counts: a later 'base( 2 )' is fbc's 170, "not at top of
'' constructor", which tiko reports as this same missing initializer.
private function CtorCallsBase_ ( byref c as Ctx, byval body as NodeId ) as boolean
    if (body = NODE_NONE) orelse (c.ast->Kind( body ) <> N_BLOCK) then return true
    dim as InternId ctorNm = c.names->Fold( c.names->GetString( "constructor" ) )
    dim as ListPayload ptr bp = @c.ast->lists[cast( int32, c.ast->nodes[cast( int32, body )].data )]
    for i as int32 = 0 to bp->count - 1
        dim as NodeId st = cast( NodeId, c.ast->children[bp->first + i] )
        if st = NODE_NONE then continue for
        dim as NodeId call_ = st
        if c.ast->Kind( st ) = N_AMBIGUOUS then
            dim as StmtPayload ptr sp = @c.ast->stmts[cast( int32, c.ast->nodes[cast( int32, st )].data )]
            if sp->op <> 0 then return false
            call_ = sp->a
        end if
        if (call_ = NODE_NONE) orelse (c.ast->Kind( call_ ) <> N_CALL) then return false
        dim as NodeId tg = c.ast->lists[cast( int32, c.ast->nodes[cast( int32, call_ )].data )].target
        if (tg = NODE_NONE) orelse (c.ast->Kind( tg ) <> N_IDENT) then return false
        dim as InternId nm = c.names->Fold( c.ast->idents[cast( int32, c.ast->nodes[cast( int32, tg )].data )].name )
        return (nm = c.names->Fold( c.baseName )) orelse (nm = ctorNm)
    next
    return false
end function

private sub CheckBaseHasDefaultCtor_( byref c as Ctx )
    for i as int32 = 0 to c.syms->symbols.Count - 1
        dim as Symbol ptr s = @c.syms->symbols[i]
        if s->kind <> cast( uint8, SYM_UDT ) then continue for
        if s->type_ = TYPE_NONE then continue for
        if BaseLacksDefaultCtor_( c, BaseOf_( c, s->type_ ) ) = false then continue for
        if StructorOf_( c, s->type_, "__ctor" ) = nullptr then
            c.diags->Report( TKO0654, PointRange( s->loc ), c.names->Spelling( s->name ) )
        elseif HasCopyCtor_( c, s->type_ ) = false then
            c.diags->Report( TKO0926, PointRange( s->loc ), c.names->Spelling( s->name ) )
        elseif HasCopyCtor_( c, s->type_, false, "let" ) andalso (HasCopyCtor_( c, s->type_, false ) = false) then
            c.diags->Report( TKO0926, PointRange( s->loc ), c.names->Spelling( s->name ) )
        end if
    next
    '' Each constructor DEFINED over such a type must initialize its base itself.
    for n as int32 = 1 to c.ast->Count( ) - 1
        if c.ast->Kind( cast( NodeId, n ) ) <> N_PROC then continue for
        dim as StmtPayload ptr sp = @c.ast->stmts[cast( int32, c.ast->nodes[n].data )]
        if sp->op <> cast( uint16, KW_CONSTRUCTOR ) then continue for
        if sp->b = NODE_NONE then continue for
        dim as Symbol ptr us = c.syms->SymbolAt( c.syms->LookupTyped( c.info->ScopeOf( cast( NodeId, n ) ), sp->name, true ) )
        if (us = nullptr) orelse (us->kind <> cast( uint8, SYM_UDT )) orelse (us->type_ = TYPE_NONE) then continue for
        if BaseLacksDefaultCtor_( c, BaseOf_( c, us->type_ ) ) = false then continue for
        if CtorCallsBase_( c, sp->b ) then continue for
        dim as SourceLoc at = c.ast->Loc( cast( NodeId, n ) )
        for k as int32 = 0 to c.ast->procEnds.Count - 2 step 2
            if c.ast->procEnds[k] = cast( uint32, n ) then at = cast( SourceLoc, c.ast->procEnds[k + 1] )
        next
        c.diags->Report( TKO0927, PointRange( at ), c.names->Spelling( us->name ) )
    next
end sub
