'' udtstrtype.tiko -- the string type a UDT term has in a string context. Moved out of
'' intrinsics.tiko (at the cap), which includes it in the same place.

'' CSIGN / CUNSG. Measured in tests/types/expected/fbc-conv.txt, and not guessable: the
'' result is the argument's signed or unsigned COUNTERPART, and the argument itself
'' where there is none -- with a fixed-length string an asymmetric case, since 'cunsg'
'' of a ZSTRING * n is that same type while 'csign' of it is BYTE.
'' THE RESULT TYPE OF A UDT'S 'operator cast' THAT YIELDS A STRING, or TYPE_NONE.
''
'' 'operator cast' may be declared several times over different targets -- as long, as
'' string, as zstring -- and they hang off one symbol as a chain, so the first is not
'' necessarily the one being asked about.
private function UdtStringCastType_ _
    ( byref c as Ctx, byval t as Tko.TypeId ) as Tko.TypeId

    if t = Tko.TYPE_NONE then return Tko.TYPE_NONE
    dim as Tko.TypeId u = c.types->Unqualify( t )
    if c.types->Kind( u ) <> Tko.TK_UDT then return Tko.TYPE_NONE
    '' FBC'S PICK FIRST -- the cast scoring best against STRING (castpick.tiko), the one lowering
    '' calls (lowercastpick.tiko ScoredStrTerm_), so the type and the call cannot disagree:
    '' [as ustring, as string] is STRING, [as ustring, byref as zstring] ZSTRING, either order.
    dim as long spOc, spCls
    dim as Tko.SymbolId spSym = Tko.Check.StrCastPick( *c.ast, *c.syms, *c.types, *c.names, u, Tko.Check.CT_STRING, spOc, spCls )
    if spOc = Tko.Check.CP_OK then
        select case spCls
        case Tko.Check.CR_STRING  : return c.types->Builtin( Tko.TY_STRING )
        case Tko.Check.CR_USTRING : return c.types->Builtin( Tko.TY_USTRING )
        case Tko.Check.CR_CHAR    : return c.types->Builtin( Tko.TY_ZSTRING )
        case Tko.Check.CR_WCHAR   : return c.types->Builtin( Tko.TY_WSTRING )
        end select
    end if
    '' NOTHING SCORED CLEANLY -- no text cast, a tie, or a pointer or number winning -- is no
    '' string type: the diagnostics own those (strcastcheck.tiko). C4: the declaration-order walk
    '' that answered here instead is gone; it could only disagree with the call.
    return Tko.TYPE_NONE
end function
