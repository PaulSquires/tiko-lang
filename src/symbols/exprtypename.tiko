'' exprtypename.tiko -- A TYPE NAMED IN EXPRESSION POSITION, as 'sizeof( T )' names one.
''
'' Split out of resolve.tiko at the 1500-line lint cap and included from it, inside its
'' namespace, where GparamTypeOf_ used to be. WalkExpr asks this only after every symbol
'' lookup has declined, so a variable of the same name still wins.
''
'' A TYPE PARAMETER of the generic being instantiated, innermost first.
''
'' ...OR 'cva_list' (T84). 'sizeof( cva_list )' parses the name as an expression, and
'' only ResolveTypeRef predefined it (resolvetype.tiko), so it was TKO0743 where fbc-modern
'' 1.20 gives 8 on win64. Measured 2026-10-03: 'sizeof' and 'len' of it, of a variable of
'' it, of 'typeof' a variable and of an alias of it all agree, 8 on win64 and 24 on Linux.
private function TypeNamedInExpr_( byref c as Ctx, byval nm as Tko.InternId ) as Tko.TypeId
    if nm = 0 then return Tko.TYPE_NONE
    for gi as int32 = c.gparamName.Count - 1 to 0 step -1
        if cast( Tko.InternId, c.gparamName[gi] ) = nm then
            return cast( Tko.TypeId, c.gparamType[gi] )
        end if
    next
    if Tko.Text.LowerAscii( c.names->Spelling( nm ) ) = "cva_list" then
        return c.types->Builtin( Tko.TY_CVA_LIST )
    end if
    return Tko.TYPE_NONE
end function
