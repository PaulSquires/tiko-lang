'' genericset.tiko -- A NAME THAT IS BOTH A GENERIC PROCEDURE AND AN ORDINARY ONE.
''
'' Split out of generic.tiko at the 1500-line cap and included from it, just ahead of
'' InstantiateGenericProc_, its one user.

private function IsGenericProcSym_( byref c as Ctx, byval sid as Tko.SymbolId ) as boolean
    dim as Tko.Symbol ptr s = c.syms->SymbolAt( sid )
    if s = nullptr then return false
    if s->kind <> cast( uint8, Tko.SYM_PROC ) then return false
    dim as Tko.NodeId pn = cast( Tko.NodeId, s->payload )
    if pn = Tko.NODE_NONE then return false
    if c.ast->Kind( pn ) <> Tko.N_PROC then return false
    return ((StmtOf( c, pn )->extra and Tko.PF_GENERIC_PROC) <> 0)
end function

'' WHICH GENERIC A CALL OF THIS NAME REACHES, given the head of its overload chain -- the
'' FIRST declaration of the name. A generic procedure cannot be overloaded in fbc-modern
'' (generics.txt: one name, one generic), yet a name that is ALSO an ordinary procedure
'' compiles, and which one wins depends on which was declared first. Measured, fbc-modern
'' 1.20, over 'H overload ( byval v as long )' (and '( byref v as string )') beside
'' 'H( of K )( byref k as K )':
''
''   ORDINARY FIRST, the generic after it: the generic takes EVERY call it is offered --
''   'H( l )' and 'H( 5 )' as well as 'H( s )', exact ordinary matches included, whatever
''   the parameter modes and wherever later ordinary overloads sit. A call it cannot infer
''   is error 340, not a fall back to the ordinary ones; 'H( of long )( l )' reaches it
''   too. '@H' still takes the ordinary procedure (not a call; not here).
''
''   GENERIC FIRST, an ordinary one after it: the generic is HIDDEN. 'H( s )' with only
''   'byval v as long' beside it is error 58, and 'H( of long )( l )' is error 42.
''
'' So: a generic head with any ordinary overload after it reaches nothing; otherwise the
'' chain's generic, or none. tiko took whichever was the HEAD, which is the opposite:
'' an ordinary head ignored the generic, and a call only it could take reached lowering
'' untyped (TKO0994) or as a body with no return (the MIR verifier).
private function GenericOfSet_( byref c as Ctx, byval head as Tko.SymbolId ) as Tko.SymbolId
    dim as Tko.SymbolId found = Tko.SYMBOL_NONE
    dim as boolean ordinary = false
    dim as Tko.SymbolId cur = head
    dim as int32 guard = 0
    while (cur <> Tko.SYMBOL_NONE) andalso (guard < 4096)
        guard += 1
        dim as Tko.Symbol ptr s = c.syms->SymbolAt( cur )
        if s = nullptr then exit while
        if s->kind <> cast( uint8, Tko.SYM_PROC ) then exit while
        if IsGenericProcSym_( c, cur ) then
            if found = Tko.SYMBOL_NONE then found = cur
        elseif (s->flags and Tko.SYMF_GENERIC_INST) = 0 then
            ordinary = true                 '' an INSTANCE chained here is the generic's own
        end if
        cur = s->nextOverload
    wend
    if (found = head) andalso ordinary then return Tko.SYMBOL_NONE
    return found
end function

'' THE FIRST ORDINARY PROCEDURE of the chain that starts at 'head', or SYMBOL_NONE.
private function FirstOrdinaryOf_( byref c as Ctx, byval head as Tko.SymbolId ) as Tko.SymbolId
    dim as Tko.SymbolId cur = head
    dim as int32 guard = 0
    while (cur <> Tko.SYMBOL_NONE) andalso (guard < 4096)
        guard += 1
        dim as Tko.Symbol ptr s = c.syms->SymbolAt( cur )
        if s = nullptr then exit while
        if s->kind <> cast( uint8, Tko.SYM_PROC ) then exit while
        if (IsGenericProcSym_( c, cur ) = false) andalso ((s->flags and Tko.SYMF_GENERIC_INST) = 0) then return cur
        cur = s->nextOverload
    wend
    return Tko.SYMBOL_NONE
end function
