'' collinitshared.tiko -- A SHARED COLLECTION INITIALISER NAMES NO FRAME VARIABLE.
''
''     dim n as long = 5
''     dim shared a as Array( of long ) = { n }     TKO0668, as fbc's error 272 for any
''                                                  shared initialiser that names 'n'
''
'' A 'dim shared' or namespace variable's collection initialiser runs in the MODULE
'' INITIALISER, before main's frame exists (mir/lowermodinit.tiko). Its brace list was
'' detached by Resolve (collinit.tiko), so CheckSharedRef_ never saw the elements: this hands
'' it the arguments of each recorded call. Included from latechecks.tiko, after
'' CheckSharedRef_.

sub CollInitSharedRefs_ ( byref c as Ctx, byval s as Symbol ptr )
    if s = nullptr then return
    if s->kind <> cast( uint8, SYM_VARIABLE ) then return
    if s->payload <= 0 then return
    dim as NodeId item = cast( NodeId, s->payload )
    if c.ast->Kind( item ) <> N_VAR_ITEM then return
    dim as NodeId blk = CollInitOf( *c.ast, item )
    if blk = NODE_NONE then return
    dim as boolean inModule = ((s->flags and SYMF_SHARED) <> 0)
    if inModule = false then
        dim as SymScope ptr sc = c.syms->ScopeAt( s->parent )
        if sc <> nullptr then inModule = (sc->kind = cast( uint8, SCOPEK_NAMESPACE ))
    end if
    if inModule = false then return
    dim as ListPayload ptr bl = @c.ast->lists[cast( int32, c.ast->nodes[cast( int32, blk )].data )]
    dim as int32 first_ = bl->first
    dim as int32 count_ = bl->count
    for k as int32 = 0 to count_ - 1
        dim as NodeId st = cast( NodeId, c.ast->children[first_ + k] )
        '' The statement's call: CheckSharedRef_ walks its ARGUMENTS and not its callee,
        '' which is 'x.Push' -- the variable itself.
        CheckSharedRef_( c, c.ast->stmts[cast( int32, c.ast->nodes[cast( int32, st )].data )].a, s->name )
    next
end sub
