declare sub CheckWithSubject_ ( byref c as Ctx, byval id as NodeId )
declare function PlainUdtOperand_ ( byref c as Ctx, byval t as TypeId ) as boolean
declare function TupleLike_ ( byref c as Ctx, byval t as TypeId ) as boolean
declare sub CheckRecursiveType_ ( byref c as Ctx, byval id as NodeId )
