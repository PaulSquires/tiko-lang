'' assertlayout.tiko -- '#assert' OVER A UDT'S SIZE OR A FIELD'S OFFSET. Included from
'' latesweeps4.tiko, above AssertSize_, in the same namespace and over the same Ctx.
''
'' Measured on fbc-modern 1.20, 2026-10-15 -- error 308 for each of these, and every true
'' twin accepted, over a 16-byte G ('d( 0 to 15 ) as ubyte'), an H of a G and a long, and
'' a 'dim x as H':
''
''     sizeof( G ) = 99     sizeof( H ) = 21     offsetof( H, b ) = 17     sizeof( x ) = 22
''
'' TypeContext.Layout knows no UDT this early -- ComputeUdtLayouts runs after this pass --
'' so each condition read as unknown, and unknown is silent: '#assert sizeof( T ) = N'
'' held for EVERY N, and no #assert-based test could see a layout regression at all. The
'' layouts here are ComputeUdtLayouts' own, the ones codegen uses, built once per pass on
'' first use; a UDT that has none (still waiting on a field) stays unknown as before.
private function AssertLayouts_ ( byref c as Ctx ) as UdtLayouts ptr
    if c.udtsBuilt = false then
        ComputeUdtLayouts( *c.syms, *c.types, c.udts )
        c.udtsBuilt = true
    end if
    return @c.udts
end function

'' A UDT's size, or -1.
function AssertUdtSize_ ( byref c as Ctx, byval u as TypeId ) as int64
    dim as UdtLayouts ptr ls = AssertLayouts_( c )
    dim as int32 ix = ls->Find( u )
    if ix < 0 then return -1
    if ls->udts[ix].size <= 0 then return -1
    return ls->udts[ix].size
end function

'' 'offsetof( T, f )' or 'offsetof( T, a.b )', walked as LowerOffsetOf walks it: the type
'' written as a UDT's or typedef's name, the field a path of names. Anything else -- a
'' user procedure of the name, a field the layout does not hold -- is false, unknown.
function AssertOffsetOf_ ( byref c as Ctx, byval n as NodeId, byref v as int64 ) as boolean
    if c.ast->Kind( n ) <> N_CALL then return false
    dim as ListPayload ptr lp = c.ast->ListOf( n )
    if (lp->count <> 2) orelse (lp->target = NODE_NONE) then return false
    if c.ast->Kind( lp->target ) <> N_IDENT then return false
    if c.info->RefOf( lp->target ) <> SYMBOL_NONE then return false
    if lcase( c.names->Spelling( _
        c.ast->IdentOf( lp->target )->name ) ) <> "offsetof" then return false
    dim as NodeId tn = Unparen3_( c, cast( NodeId, c.ast->children[lp->first] ) )
    dim as Symbol ptr ts = c.syms->SymbolAt( c.info->RefOf( tn ) )
    if ts = nullptr then return false
    if (ts->kind <> cast( uint8, SYM_UDT )) andalso (ts->kind <> cast( uint8, SYM_TYPEDEF )) then return false
    dim as NodeId fn = cast( NodeId, c.ast->children[lp->first + 1] )
    dim as containers.Array( of uint32 ) path
    while c.ast->Kind( fn ) = N_MEMBER
        dim as BinaryPayload ptr mbp = c.ast->BinaryOf( fn )
        if c.ast->Kind( mbp->rhs ) <> N_IDENT then return false
        path.Push( cast( uint32, mbp->rhs ) )
        fn = mbp->lhs
    wend
    if c.ast->Kind( fn ) <> N_IDENT then return false
    path.Push( cast( uint32, fn ) )
    dim as UdtLayouts ptr ls = AssertLayouts_( c )
    dim as int64 off = 0
    dim as TypeId cur = ts->type_
    for i as int32 = path.Count - 1 to 0 step -1
        if cur = TYPE_NONE then return false
        cur = c.types->Unqualify( cur )
        if c.types->Kind( cur ) <> TK_UDT then return false
        dim as boolean found = false
        dim as TypeId ft = TYPE_NONE
        off += ls->FieldOffsetType( cur, c.ast->idents[cast( int32, c.ast->nodes[cast( int32, path[i] )].data )].name, found, ft )
        if found = false then return false
        cur = ft
    next
    v = off
    return true
end function
