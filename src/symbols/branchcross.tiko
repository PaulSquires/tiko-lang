'' branchcross.tiko -- A GOTO THAT JUMPS OVER A DEFINITION NEEDING CONSTRUCTION, fbc's error 105:
''
''     error 105: Branch crossing local array, var-len string or object definition, to label: L
''
'' Included from latesweeps2.tiko, below recursivetype.tiko, in the same namespace and over the
'' same Ctx. CheckBranchCross_ is asked of every N_GOTO.
''
'' Measured on fbc-modern 1.20, 2026-09-28. Reported on the GOTO's line, once for each variable
'' crossed:
''
''     goto L : dim as string s : L:                     a var-len string, with or without '='
''     goto L : var s = "abc" : L:                       ...inferred
''     goto L : dim as long a( 0 to 3 ) : L:             any local array, fixed, dynamic, REDIM
''     goto L : dim as U x : L:                          U with a constructor, a vtable
''                                                       (EXTENDS OBJECT) or a field needing one
''     goto L : scope : dim as string s : L: : end scope into the definition's scope
''     sub F( ) : goto L : dim as string s : L:          the same inside a procedure
''
'' and accepted:
''
''     an integer, a pointer, a 'zstring * 8' or 'string * 8', a UDT with none of the above
''     (a destructor ALONE is not one); a SHARED or STATIC variable; a backward jump; a jump
''     out of the definition's scope, or over a scope that has closed; 'on n goto'.
''
'' tiko accepted every one, and at the label a string or an object nobody constructed was in
'' scope. The walk is by node id, which is source order, and by the scopes Collect recorded.
''
'' ...AND A TEMPORARY a statement defines, TKO0881, when the label is INSIDE that statement:
''
''     goto L : select case s + "1" : case "1" : L:       a string subject that is COMPUTED --
''     goto L : select case lcase( w ) : ... L:            a concatenation, a call. A plain
''                                                        variable or a literal makes none.
''     goto L : for x as UDT = 1 to 2 step 1 : L:          the counter (as a definition), the
''                                                        end value, the step value -- a UDT
''                                                        needing construction, whatever the
''                                                        bounds are written as.
''
'' A jump from one CASE to another, and a label after 'end select' or 'next', are fbc's. A
'' statement's node is made after its body, so 'inside' is: the goto before the statement's
'' first child, and the label between that child and the statement's own node.

'' THE PROCEDURE a scope belongs to: its nearest ancestor that is not a block.
private function BxProcScope_ ( byref c as Ctx, byval s as ScopeId ) as ScopeId
    dim as ScopeId cur = s
    for guard as int32 = 0 to 4095
        if cur = SCOPE_NONE then exit for
        dim as SymScope ptr ss = c.syms->ScopeAt( cur )
        if ss = nullptr then exit for
        if ss->kind <> SCOPEK_BLOCK then return cur
        cur = ss->parent
    next
    return SCOPE_NONE
end function

'' Is 'outer' the scope 'inner' is, or one of its ancestors?
private function BxHolds_ ( byref c as Ctx, byval outer as ScopeId, byval inner as ScopeId ) as boolean
    dim as ScopeId cur = inner
    for guard as int32 = 0 to 4095
        if cur = SCOPE_NONE then exit for
        if cur = outer then return true
        dim as SymScope ptr ss = c.syms->ScopeAt( cur )
        if ss = nullptr then exit for
        cur = ss->parent
    next
    return false
end function

'' Does this item, which declares its own variable, need constructing?
private function BxNeedsCtor_ _
    ( byref c as Ctx, byval item as NodeId, byval s as Symbol ptr ) as boolean
    if (c.ast->nodes[cast( int32, item )].flags and NF_ARRAY) <> 0 then return true
    if (s->flags and SYMF_REDIM) <> 0 then return true
    dim as TypeId t = c.types->Unqualify( s->type_ )
    if t = TYPE_NONE then return false
    if c.types->IsDynArray( t ) then return true
    if c.types->Kind( t ) = TK_BUILTIN then
        select case c.types->BuiltinOf( t )
        case TY_STRING, TY_USTRING : return true
        end select
        return false
    end if
    return TcNeedsCtor_( c, t, 0 )
end function

'' Does a SELECT CASE over this subject hold it in a string temporary: a string, computed?
private function BxSelectTemp_ ( byref c as Ctx, byval e as NodeId ) as boolean
    if e = NODE_NONE then return false
    dim as TypeId t = c.types->Unqualify( c.info->TypeOf_( e ) )
    '' ...a FIXED one too: 'lcase( w )' over a 'wstring * 10' is typed 'wstring * 1'.
    if c.types->Kind( t ) = TK_ARRAY then t = c.types->Unqualify( c.types->Inner( t ) )
    if c.types->Kind( t ) <> TK_BUILTIN then return false
    select case c.types->BuiltinOf( t )
    case TY_STRING, TY_USTRING, TY_WSTRING, TY_ZSTRING, TY_FIXSTR, TY_FIXUSTR
    case else
        return false
    end select
    '' ONLY A LITERAL OR A VARIABLE'S OWN NAME is used where it stands. Measured: a field
    '' ('ts.s'), a dereference ('*pz', '*ps'), an array element ('sa( 1 )') and a PARAMETER,
    '' byref or byval, are each copied into the temporary -- fbc's 105 for every one.
    dim as NodeId u = Unparen3_( c, e )
    select case c.ast->Kind( u )
    case N_STRING_LIT, N_STRCAT
        return false
    case N_IDENT
        dim as Symbol ptr vs = c.syms->SymbolAt( c.info->RefOf( u ) )
        if vs <> nullptr then
            if vs->kind = cast( uint8, SYM_VARIABLE ) then return false
        end if
    end select
    return true
end function

private sub CheckBranchCross_ ( byref c as Ctx, byval id as NodeId )
    '' THE LABELS AND THE LOCAL DEFINITIONS, in node order, once per tree.
    static as int32 lab( ), vars( ), tmps( )
    static as int32 nLab, nVar, nTmp
    static as any ptr forAst = nullptr
    static as int32 forCount = -1
    static as uint32 forGen = 0
    dim as int32 n = c.ast->Count( )
    if (forAst <> cast( any ptr, c.ast )) orelse (forCount <> n) orelse (forGen <> VisRunGen_( )) then
        redim lab( 0 to 15 ) : redim vars( 0 to 15 ) : redim tmps( 0 to 15 )
        nLab = 0 : nVar = 0 : nTmp = 0
        for i as int32 = 1 to n
            dim as NodeKind ik = c.ast->Kind( cast( NodeId, i ) )
            if ik = N_LABEL then
                if nLab > ubound( lab ) then redim preserve lab( 0 to nLab * 2 )
                lab( nLab ) = i : nLab += 1
            elseif (ik = N_SELECT) orelse (ik = N_FOR) then
                if nTmp > ubound( tmps ) then redim preserve tmps( 0 to nTmp * 2 )
                tmps( nTmp ) = i : nTmp += 1
            elseif ik = N_VAR then
                dim as StmtPayload ptr vp = @c.ast->stmts[cast( int32, c.ast->nodes[i].data )]
                select case cast( TokenKind, vp->op )
                case KW_DIM, KW_VAR, KW_REDIM
                case else
                    continue for
                end select
                if (c.ast->nodes[i].flags and (NF_SHARED or NF_STATIC)) <> 0 then continue for
                if nVar > ubound( vars ) then redim preserve vars( 0 to nVar * 2 )
                vars( nVar ) = i : nVar += 1
            end if
        next
        forAst = c.ast : forCount = n : forGen = VisRunGen_( )
    end if

    dim as StmtPayload ptr gp = @c.ast->stmts[cast( int32, c.ast->nodes[cast( int32, id )].data )]
    if gp->name = 0 then return
    dim as ScopeId gproc = BxProcScope_( c, c.info->ScopeOf( id ) )
    '' The label: FORWARD, in the same procedure.
    dim as int32 lid = 0
    for i as int32 = 0 to nLab - 1
        if lab( i ) <= id then continue for
        dim as StmtPayload ptr lp = @c.ast->stmts[cast( int32, c.ast->nodes[lab( i )].data )]
        if lp->name <> gp->name then continue for
        if BxProcScope_( c, c.info->ScopeOf( cast( NodeId, lab( i ) ) ) ) <> gproc then continue for
        lid = lab( i )
        exit for
    next
    if lid = 0 then return
    dim as ScopeId lscope = c.info->ScopeOf( cast( NodeId, lid ) )
    for v as int32 = 0 to nVar - 1
        dim as int32 vid = vars( v )
        if vid <= id then continue for
        if vid >= lid then exit for
        dim as ScopeId vscope = c.info->ScopeOf( cast( NodeId, vid ) )
        if BxHolds_( c, vscope, lscope ) = false then continue for
        dim as StmtPayload ptr vp = @c.ast->stmts[cast( int32, c.ast->nodes[vid].data )]
        for j as int32 = 0 to vp->count - 1
            dim as NodeId it = cast( NodeId, c.ast->children[vp->first + j] )
            if (it < 1) orelse (c.ast->Kind( it ) <> N_VAR_ITEM) then continue for
            dim as StmtPayload ptr ip = @c.ast->stmts[cast( int32, c.ast->nodes[cast( int32, it )].data )]
            dim as Symbol ptr s = c.syms->SymbolAt( c.syms->LookupLocal( vscope, ip->name ) )
            if s = nullptr then continue for
            '' ONLY A DEFINITION: a REDIM of an array declared earlier defines nothing here.
            if cast( NodeId, s->payload ) <> it then continue for
            if BxNeedsCtor_( c, it, s ) = false then continue for
            c.diags->Report( TKO0880, PointRange( c.ast->Loc( id ) ), _
                c.names->Spelling( gp->name ), c.names->Spelling( ip->name ) )
        next
    next

    '' THE TEMPORARIES of a SELECT CASE or a FOR the label is inside.
    for t as int32 = 0 to nTmp - 1
        dim as int32 sid = tmps( t )
        if sid <= lid then continue for
        dim as StmtPayload ptr tp = @c.ast->stmts[cast( int32, c.ast->nodes[sid].data )]
        dim as NodeId head = tp->a
        if (head = NODE_NONE) orelse (head <= id) orelse (head >= lid) then continue for
        dim as string gname = c.names->Spelling( gp->name )
        if c.ast->Kind( cast( NodeId, sid ) ) = N_SELECT then
            if BxSelectTemp_( c, head ) then
                c.diags->Report( TKO0881, PointRange( c.ast->Loc( id ) ), gname, "the SELECT CASE subject" )
            end if
            continue for
        end if
        '' A FOR over a UDT that needs constructing.
        dim as TypeId ct = TYPE_NONE
        if tp->c <> NODE_NONE then ct = c.info->TypeOf_( tp->c )
        if ct = TYPE_NONE then ct = c.info->TypeOf_( head )
        ct = c.types->Unqualify( ct )
        if c.types->Kind( ct ) <> TK_UDT then continue for
        if TcNeedsCtor_( c, ct, 0 ) = false then continue for
        if (tp->c <> NODE_NONE) andalso (c.ast->Kind( head ) = N_IDENT) then
            c.diags->Report( TKO0880, PointRange( c.ast->Loc( id ) ), gname, _
                c.names->Spelling( c.ast->idents[cast( int32, c.ast->nodes[cast( int32, head )].data )].name ) )
        end if
        c.diags->Report( TKO0881, PointRange( c.ast->Loc( id ) ), gname, "the FOR's end value" )
        if tp->count >= 3 then
            if c.ast->children[tp->first + 2] <> NODE_NONE then
                c.diags->Report( TKO0881, PointRange( c.ast->Loc( id ) ), gname, "the FOR's step value" )
            end if
        end if
    next
end sub
