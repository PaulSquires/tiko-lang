'' resolveamb.tiko -- an N_AMBIGUOUS statement, resolved into a call or an assignment.
''
'' Split out of resolve.tiko at the 1500-line cap and included from it in the same place.


'' The parser's three-way ambiguity, decided now that the target's symbol is known
'' (docs/plan/07 section 8). The payoff is the diagnostic: where fbc reports a syntax
'' error, tiko-lang can say what the name actually is.

'' An array type from a declaration's bounds, or the base type unchanged when there are
'' none.
''
'' THE PARSER SPELLS BOUNDS TWO DIFFERENT WAYS, which is why this takes node lists
'' rather than a payload:
''
''   N_FIELD      flat (lo, hi) children          as long f(0 to 3)
''   N_VAR_ITEM   an N_BLOCK of N_CASE_RANGE      dim as long a(0 to 9)
''
'' Both are collected into (lo, hi) pairs here so the arithmetic exists once. Assuming
'' the field shape for both is what left every LOCAL array typed as its element -- four
'' bytes where forty were needed -- and that went unnoticed only because indexing was
'' not lowered either.
''
'' A missing low bound means 0: 'a(9)' is 'a(0 to 9)'. BOUNDS ARE RETAINED, not just
'' their product, because indexing needs each dimension's stride and its lbound bias.
'' Nothing is folded when any bound is non-constant.

'' '<call>( args ) = value' RE-READ AS '<call>( args = value )'.
''
'' True when it applies, and the statement has been REWRITTEN by then: the call's
'' LAST argument becomes an '=' over itself and the assigned value, which is what
'' fbc parses. False leaves everything untouched.
''
'' Refused for anything but a CALL whose callee is a procedure -- an array
'' subscript is spelled the same way and IS an assignment -- and refused when any
'' candidate of matching arity returns BYREF, because that one is a real
'' assignment through the returned reference.
private function ReadCallAssignAsCall_ _
    ( byref c as Ctx, byval id as Tko.NodeId, byval sp as Tko.StmtPayload ptr, _
      byval sid as Tko.SymbolId ) as boolean

    if sp->a = Tko.NODE_NONE then return false
    if sp->b = Tko.NODE_NONE then return false
    if c.ast->Kind( sp->a ) <> Tko.N_CALL then return false
    '' Only a plain '=': '+=' and its family are never a comparison, and neither is '=>'.
    if cast( Tko.TokenKind, sp->op ) <> Tko.TK_EQ then return false
    if (c.ast->nodes[cast( int32, id )].flags and Tko.NF_FAT_ARROW) <> 0 then return false
    dim as Tko.Symbol ptr s = c.syms->SymbolAt( sid )
    '' A MEMBER CALL HAS NOT BOUND YET. Resolve runs before Check, so
    '' 'a.At( 2 ) = 88' has no RefOf on its member node and 'sid' falls back to the
    '' BASE -- the variable 'a' -- which is not a procedure, and the whole rule
    '' declined. The comment below has always said this case folds; it did not.
    ''
    '' It was invisible while a byref member result was double-loaded: the store
    '' went through the loaded VALUE and landed somewhere harmless, so the program
    '' printed the 0 fbc prints, for the wrong reason. Fixing the lvalue path made
    '' it print 88 and exposed this.
    ''
    '' The member is therefore looked up BY NAME in the base's own type scope --
    '' what matters is only whether the name is a PROCEDURE, not which overload.
    if s <> nullptr then
        if s->kind <> cast( uint8, Tko.SYM_PROC ) then
            dim as Tko.NodeId cal2 = ListOf( c, sp->a )->target
            if c.ast->Kind( cal2 ) = Tko.N_MEMBER then
                dim as Tko.BinaryPayload ptr mb2 = _
                    @c.ast->binaries[cast( int32, c.ast->nodes[cast( int32, cal2 )].data )]
                '' THE BASE VARIABLE'S DECLARED TYPE, not the expression's. Resolve
                '' runs before Check, so TypeOf_ on the base is TYPE_NONE here --
                '' measured -- while the symbol the base bound to already carries it.
                dim as Tko.TypeId bt2 = c.types->Unqualify( s->type_ )
                if c.types->Kind( bt2 ) = Tko.TK_UDT then
                    dim as Tko.InternId tn2 = c.types->NameOf( bt2 )
                    if tn2 <> 0 then
                        dim as Tko.ScopeId ds2 = _
                            cast( Tko.ScopeId, c.types->DeclScopeOf( bt2 ) )
                        dim as Tko.SymbolId ts2 = _
                            c.syms->LookupLocalTyped( ds2, tn2, true )
                        if ts2 = Tko.SYMBOL_NONE then _
                            ts2 = c.syms->LookupTyped( ds2, tn2, true )
                        dim as Tko.Symbol ptr tsy2 = c.syms->SymbolAt( ts2 )
                        if tsy2 <> nullptr then
                            if tsy2->inner <> Tko.SCOPE_NONE then
                                dim as Tko.SymbolId mm2 = c.syms->LookupLocal( _
                                    tsy2->inner, IdentNameOf( c, mb2->rhs ) )
                                dim as Tko.Symbol ptr msy2 = c.syms->SymbolAt( mm2 )
                                if msy2 <> nullptr then
                                    if msy2->kind = cast( uint8, Tko.SYM_PROC ) then
                                        '' A PROPERTY IS NOT FOLDED. 'p.Item( 2 ) = 7'
                                        '' is a SETTER CALL, which is the one member
                                        '' shape where the '=' really is the value --
                                        '' measured, fbc prints 7 for it where it
                                        '' prints 0 for the ordinary byref member.
                                        dim as Tko.NodeId mpn2 = _
                                            cast( Tko.NodeId, msy2->payload )
                                        dim as boolean isProp2 = false
                                        if mpn2 <> Tko.NODE_NONE then
                                            if c.ast->Kind( mpn2 ) = Tko.N_PROC then
                                                isProp2 = (StmtOf( c, mpn2 )->op = _
                                                    cast( uint16, Tko.KW_PROPERTY ))
                                            end if
                                        end if
                                        if isProp2 = false then s = msy2
                                    end if
                                end if
                            end if
                        end if
                    end if
                end if
            end if
        end if
    end if
    if s = nullptr then return false
    if s->kind <> cast( uint8, Tko.SYM_PROC ) then return false

    dim as Tko.ListPayload ptr lp = ListOf( c, sp->a )
    '' EXACTLY ONE WRITTEN ARGUMENT, not "at least one" (T19). fbc re-reads 'f( x ) = v' because
    '' '( x ) = v' is itself an expression -- the parentheses belong to it, not to the call --
    '' and '( a, b )' is not one. Measured on fbc-modern 1.20, 2026-10-02: 'Two( 0, 1 ) = 42',
    '' 'Three( 1, 1, 1 ) = 42', 'a.At2( 2, 2 ) = 88' and 'OptB( 5, 1 ) = 9' over byref results
    '' all ASSIGN, with no warning; 'OptB( 5 ) = 9' folds and warns. tiko folded every one, and
    '' the store the writer meant never happened.
    if lp->count <> 1 then return false

    '' ONE OR MORE WRITTEN ARGUMENTS. With NONE there is nothing to fold the '='
    '' into, and fbc keeps the assignment: measured, 'br0( ) = 456' is
    '' 'vr = BR0( ); *vr = 456' and the program prints 456, while 'br( 1 ) = 456'
    '' over the same shape with an argument prints 0.
    if lp->count < 1 then return false

    '' THE REWRITE. The arena is plain data, so the node is appended the way the
    '' parser appends one; nothing else here builds nodes, which is why this is
    '' spelled out rather than borrowed.
    dim as int32 lastIx = lp->first + lp->count - 1
    dim as Tko.BinaryPayload bp
    bp.op = cast( uint16, Tko.TK_EQ )
    bp.lhs = cast( Tko.NodeId, c.ast->children[lastIx] )
    bp.rhs = sp->b
    c.ast->binaries.Push( bp )
    dim as Tko.AstNode bn
    bn.kind = cast( uint16, Tko.N_BINARY )
    bn.flags = Tko.NF_FOLDED_EQ         '' Check's warning 34 reads it -- byrefcheck.tiko (T19)
    bn.loc = c.ast->Loc( id )
    bn.data = cast( uint32, c.ast->binaries.Count - 1 )
    c.ast->nodes.Push( bn )
    c.ast->children[lastIx] = cast( uint32, c.ast->nodes.Count - 1 )

    '' The statement is now a CALL and nothing else: its assigned value has moved
    '' inside the argument, and leaving 'b' set would lower it twice.
    sp->b = Tko.NODE_NONE
    sp->op = 0
    return true
end function

'' '.Proc .Fn( x )' INSIDE A NAMESPACE IS A CALL WITH AN ARGUMENT, and not a member of
'' whatever '.Proc' returns. A leading '.' is FreeBASIC's global-scope shorthand, so BOTH
'' dots start a name -- and the postfix parser, which has no symbols, reads the second as
'' a member access of the first. docs/plan/04 section 6 says the parser cannot decide
'' this; fbc decides it with the symbol table, and so does this.
''
'' AfxNova writes it constantly inside 'namespace AfxNova' -- '.SetFocus
'' .GetNextDlgTabItem( GetParent( hwnd ), hwnd, 0 )' -- and it is what 180 of its 409
'' examples reported first, as TKO0630 ('.' reaches a member of a value). It only ever
'' surfaced when the first call returned a POINTER, because that is the shape Check
'' complains about rather than one it silently mistypes.
''
'' THE TEST IS WHAT THE BASE IS, exactly as in fbc: a PROCEDURE takes an argument list,
'' so the dot after it begins one. A VARIABLE does not, so '.gvar.field' stays a member
'' access. Measured on fbc 1.20.0, and whitespace decides nothing -- '.OuterP.InnerP( h,
'' 0 )' with no space at all still evaluates the inner call first, as the argument.
''
'' AN ASSIGNMENT IS LEFT ALONE. '.gvar .field1 = 7' assigns through the member, which is
'' the reading this rule must not take away; folding an '=' into a call argument is
'' ReadCallAssignAsCall_'s question and it has its own measurements.
private function ReadDotArgAsCall_ _
    ( byref c as Ctx, byval id as Tko.NodeId, byval sp as Tko.StmtPayload ptr, _
      byval scope_ as Tko.ScopeId ) as boolean

    if sp->op <> 0 then return false
    if sp->a = Tko.NODE_NONE then return false

    '' The member access that swallowed the argument: the head itself, or the callee of
    '' the call wrapped around it when the argument was written with parentheses.
    dim as Tko.NodeId mnode = sp->a
    if c.ast->Kind( mnode ) = Tko.N_CALL then mnode = ListOf( c, mnode )->target
    if mnode = Tko.NODE_NONE then return false
    if c.ast->Kind( mnode ) <> Tko.N_MEMBER then return false

    dim as Tko.BinaryPayload ptr mb = _
        @c.ast->binaries[cast( int32, c.ast->nodes[cast( int32, mnode )].data )]
    dim as Tko.NodeId base_ = mb->lhs
    if base_ = Tko.NODE_NONE then return false

    '' A PLAIN NAME MAY BE THE CALLEE TOO -- 'G4 .G1( p ), q' is the same statement as
    '' '.G4 .G1( p ), q' with the callee written without its dot, and AfxNova's window
    '' procedures write both. It cannot be waved through the way a leading-dot base is,
    '' because 'mk.x' over a PARAMETERLESS FUNCTION returning a UDT is a real member
    '' access -- measured, fbc prints 42 for it -- and is spelled identically. What
    '' separates them is whether the member BOUND: WalkExpr has already run over the
    '' head, so a genuine 'mk.x' has its field here and this one has nothing.
    if c.ast->Kind( base_ ) = Tko.N_IDENT then
        if c.info->RefOf( mnode ) <> Tko.SYMBOL_NONE then return false
    else
        if c.ast->Kind( base_ ) <> Tko.N_MEMBER then return false

        '' ...and the base has to be a LEADING-DOT name itself -- '.x', whose own base is
        '' absent, or '..x', whose base is the global-scope marker. 'a.b.c' over a real
        '' variable is none of this and is left exactly as it parsed.
        dim as Tko.BinaryPayload ptr bb = _
            @c.ast->binaries[cast( int32, c.ast->nodes[cast( int32, base_ )].data )]
        dim as boolean leadingDot = (bb->lhs = Tko.NODE_NONE)
        if leadingDot = false then
            leadingDot = (c.ast->Kind( bb->lhs ) = Tko.N_GLOBALSCOPE)
        end if
        if leadingDot = false then return false
    end if

    '' WHAT THE BASE BOUND TO. WalkExpr has already run over the head, so a name that
    '' resolves at all has its symbol here; one that does not is left to the ordinary
    '' path and its ordinary diagnostic.
    dim as Tko.Symbol ptr bs = c.syms->SymbolAt( c.info->RefOf( base_ ) )
    '' ...OR A RUNTIME PROCEDURE, which binds to nothing: 'deallocate .pStart' inside a WITH is
    '' fbc's call with the member as its argument, and parsed as 'deallocate.pStart' it
    '' declined (fbc-examples r2ice09, fbsound). Only an UNBOUND plain name -- a user's own
    '' variable called 'kill' is a symbol and takes the path above.
    dim as boolean rtlBase = false
    if (bs = nullptr) andalso (c.ast->Kind( base_ ) = Tko.N_IDENT) then
        dim as boolean rtlOverloadable
        rtlBase = RtlProcName_( Tko.Text.LowerAscii( c.names->Spelling( _
            c.ast->idents[cast( int32, c.ast->nodes[cast( int32, base_ )].data )].name ) ), rtlOverloadable )
    end if
    if rtlBase = false then
        if bs = nullptr then return false
        if bs->kind <> cast( uint8, Tko.SYM_PROC ) then return false
    end if

    '' THE REWRITE. Dropping the member's base turns '<.Proc>.Fn' back into the '.Fn'
    '' it was written as, and the whole of what the postfix parser built becomes the
    '' call's FIRST argument -- ahead of any paren-less ones, which were already the
    '' second and later: '.SendMessageW .GetParent( hwnd ), WM_NOTIFY' is one call of
    '' four arguments, not a member access followed by three.
    dim as Tko.NodeId newArg = sp->a
    mb->lhs = Tko.NODE_NONE

    dim as int32 oldFirst = sp->first
    dim as int32 oldCount = sp->count

    '' AN ELIDED FIRST ARGUMENT IS THE HOLE THIS CALL LEFT, and it is filled rather
    '' than pushed past. '.Take3 .InnerP( h, 0 ), 1, 2' reaches here as the head plus
    '' '<elided>, 1, 2': the postfix parser had already taken '.InnerP( h, 0 )' into
    '' the head, so the comma after it produced a placeholder for an argument that was
    '' no longer in the list -- the same shape ParseAmbiguous lifts for 'proc (x), y',
    '' which only handles the one-argument group. Prepending in front of it made a
    '' four-argument call of a three-argument SUB, and the call declined to lower.
    dim as int32 skip = 0
    if oldCount > 0 then
        if c.ast->Kind( cast( Tko.NodeId, c.ast->children[oldFirst] ) ) = _
           Tko.N_ELIDED then skip = 1
    end if

    '' ...AND A ONE-ARGUMENT GROUP WAS LIFTED RATHER THAN LEFT AS A CALL. The parser
    '' keeps '( p, q )' as an N_CALL around the member and leaves the placeholder
    '' behind it, which is the case above; a SINGLE '( p )' is the shape ParseAmbiguous
    '' lifts for 'proc (x), y', so the head stays a bare member and 'p' arrives as an
    '' ordinary argument with NO placeholder in front of it. The missing placeholder is
    '' what says so.
    ''
    '' Left alone, '.G4 .G1( p ), q, 3, 4' became a FIVE-argument call of a
    '' four-argument procedure -- '.G1' as a function POINTER, then p, q, 3, 4 -- which
    '' the verifier caught and the program printed as garbage. Seven of these in
    '' AfxNova's CImageCtx alone: '.SendMessageW .GetParent( hwnd ), uMsg, wParam,
    '' lParam'.
    if (skip = 0) andalso (oldCount > 0) andalso (c.ast->Kind( sp->a ) = Tko.N_MEMBER) then
        dim as uint32 inner = c.ast->children[oldFirst]
        dim as int32 liftFirst = c.ast->children.Count
        c.ast->children.Push( inner )
        dim as Tko.ListPayload lp2
        lp2.target = newArg
        lp2.first = liftFirst
        lp2.count = 1
        c.ast->lists.Push( lp2 )
        dim as Tko.AstNode cn
        cn.kind = cast( uint16, Tko.N_CALL )
        cn.flags = 0
        cn.loc = c.ast->Loc( newArg )
        cn.data = cast( uint32, c.ast->lists.Count - 1 )
        c.ast->nodes.Push( cn )
        newArg = cast( Tko.NodeId, c.ast->nodes.Count - 1 )
        '' THE SIDE TABLES ARE SIZED TO THE NODE COUNT, and this node did not exist when
        '' they were sized: without this its binding and its type are written past the
        '' end and read back as nothing, so the call resolved to no callee and the
        '' statement declined in silence -- which is worse than the five-argument call
        '' it replaced.
        c.info->Resize( c.ast->nodes.Count )
        skip = 1
    end if

    '' THROUGH A LOCAL. Pushing an element of the same vector passes a reference into
    '' storage the push may have just reallocated.
    dim as int32 newFirst = c.ast->children.Count
    c.ast->children.Push( cast( uint32, newArg ) )
    for i as int32 = skip to oldCount - 1
        dim as uint32 ch = c.ast->children[oldFirst + i]
        c.ast->children.Push( ch )
    next
    sp->first = newFirst
    sp->count = oldCount + 1 - skip
    sp->a = base_
    c.ast->nodes[cast( int32, base_ )].flags or= Tko.NF_CALL_TARGET  '' the statement's callee

    '' RE-WALKED, because the first walk bound it as a member of the base and this is
    '' not that any more: the name has to find the one at global scope now.
    WalkExpr( c, newArg, scope_ )
    return true
end function

'' THE SYMBOL THE CALL'S NAME MEANS, which is not always what the head lookup found.
'' Resolve runs before Check, so a MEMBER call has not bound yet: 'o.Opt( 7 ) = 3' has
'' no RefOf on its member node and the head falls back to the BASE -- the variable 'o'
'' -- exactly as ReadCallAssignAsCall_ records below. The member is therefore looked up
'' BY NAME in the base's own type scope, which is that rule's workaround and this one's.
private function PropertyNameSym_ _
    ( byref c as Ctx, byval callNode as Tko.NodeId, _
      byval headSid as Tko.SymbolId ) as Tko.SymbolId

    dim as Tko.Symbol ptr hs = c.syms->SymbolAt( headSid )
    if hs <> nullptr then
        if hs->kind = cast( uint8, Tko.SYM_PROC ) then return headSid
    end if

    dim as Tko.NodeId callee = ListOf( c, callNode )->target
    if callee = Tko.NODE_NONE then return headSid
    if c.ast->Kind( callee ) <> Tko.N_MEMBER then return headSid

    '' It may have bound after all -- a qualified name does.
    dim as Tko.SymbolId msid = c.info->RefOf( callee )
    dim as Tko.Symbol ptr ms = c.syms->SymbolAt( msid )
    if ms <> nullptr then
        if ms->kind = cast( uint8, Tko.SYM_PROC ) then return msid
    end if

    if hs = nullptr then return headSid
    dim as Tko.TypeId bt = c.types->Unqualify( hs->type_ )
    if c.types->Kind( bt ) <> Tko.TK_UDT then return headSid
    dim as Tko.InternId tn = c.types->NameOf( bt )
    if tn = 0 then return headSid

    dim as Tko.ScopeId ds = cast( Tko.ScopeId, c.types->DeclScopeOf( bt ) )
    dim as Tko.SymbolId ts = c.syms->LookupLocalTyped( ds, tn, true )
    if ts = Tko.SYMBOL_NONE then ts = c.syms->LookupTyped( ds, tn, true )
    dim as Tko.Symbol ptr tsy = c.syms->SymbolAt( ts )
    if tsy = nullptr then return headSid
    if tsy->inner = Tko.SCOPE_NONE then return headSid

    dim as Tko.BinaryPayload ptr mb = _
        @c.ast->binaries[cast( int32, c.ast->nodes[cast( int32, callee )].data )]
    dim as Tko.SymbolId mm = c.syms->LookupLocal( tsy->inner, IdentNameOf( c, mb->rhs ) )
    if mm = Tko.SYMBOL_NONE then return headSid
    return mm
end function

'' Whether this name's overload chain holds a PROPERTY SETTER -- a property with no
'' result. One chain carries all four accessors, so the question is only whether a
'' setter is among them; which one runs is LowerPropertySet_'s to decide, and it has
'' the assigned value that the decision needs.
private function HasPropertySetter_ _
    ( byref c as Ctx, byval sid as Tko.SymbolId ) as boolean

    dim as Tko.SymbolId cur = sid
    dim as int32 guard = 0
    while (cur <> Tko.SYMBOL_NONE) andalso (guard < 1000)
        guard += 1
        dim as Tko.Symbol ptr s = c.syms->SymbolAt( cur )
        if s = nullptr then exit while
        if s->kind <> cast( uint8, Tko.SYM_PROC ) then exit while
        dim as Tko.NodeId pn = cast( Tko.NodeId, s->payload )
        if (pn <> Tko.NODE_NONE) andalso (c.ast->Kind( pn ) = Tko.N_PROC) then
            dim as Tko.StmtPayload ptr pp = StmtOf( c, pn )
            if pp->op = cast( uint16, Tko.KW_PROPERTY ) then
                '' No result node is what makes a property a SETTER.
                if pp->a = Tko.NODE_NONE then return true
            end if
        end if
        cur = s->nextOverload
    wend
    return false
end function

private sub ResolveAmbiguous _
    ( byref c as Ctx, byval id as Tko.NodeId, byval scope_ as Tko.ScopeId )

    dim as Tko.StmtPayload ptr sp = StmtOf( c, id )
    WalkExpr( c, sp->a, scope_ )
    WalkExpr( c, sp->b, scope_ )
    for i as int32 = 0 to sp->count - 1
        WalkExpr( c, cast( Tko.NodeId, c.ast->children[sp->first + i] ), scope_ )
    next

    dim as boolean isAssign = (sp->op <> 0)

    '' 'function = expr' names no symbol, so it cannot reach the lookup below -- but it
    '' is the SAME statement as 'f = expr' inside f, and both belong in one bucket. The
    '' keyword form used to decline at a different line from the name form, which is
    '' the shape that made 'amb other' mislead for four commits.
    if c.ast->Kind( sp->a ) = Tko.N_FUNCRESULT then
        c.info->SetAmbiguous( id, Tko.AMB_RESULT )
        c.st->assigns += 1
        return
    end if

    '' '.Proc .Fn( x )' -- see ReadDotArgAsCall_. It rewrites 'a' and the argument list
    '' in place, so everything below reads the corrected statement.
    ReadDotArgAsCall_( c, id, sp, scope_ )

    '' The target's head symbol: for a.b.c the head is a.
    dim as Tko.NodeId head = sp->a
    dim as int32 guard = 0
    while guard < 64
        guard += 1
        dim as Tko.NodeKind hk = c.ast->Kind( head )
        if hk = Tko.N_MEMBER then
            head = c.ast->binaries[cast( int32, c.ast->nodes[cast( int32, head )].data )].lhs
        elseif (hk = Tko.N_CALL) orelse (hk = Tko.N_INDEX) then
            head = ListOf( c, head )->target
        else
            exit while
        end if
    wend

    '' A QUALIFIED name binds on the MEMBER node itself, so prefer that over the head:
    '' for 'ns.Greet( 1 )' the head is the namespace and tells us nothing useful, while
    '' the member resolved to the procedure.
    dim as Tko.SymbolId sid = c.info->RefOf( head )
    if c.ast->Kind( sp->a ) = Tko.N_MEMBER then
        dim as Tko.SymbolId qsid = c.info->RefOf( sp->a )
        if qsid <> Tko.SYMBOL_NONE then sid = qsid
    elseif c.ast->Kind( sp->a ) = Tko.N_CALL then
        dim as Tko.NodeId callee = ListOf( c, sp->a )->target
        if c.ast->Kind( callee ) = Tko.N_MEMBER then
            dim as Tko.SymbolId qsid = c.info->RefOf( callee )
            if qsid <> Tko.SYMBOL_NONE then sid = qsid
        end if
    end if
    dim as Tko.Symbol ptr s = c.syms->SymbolAt( sid )

    '' 'o.Prop( i ) = v' IS A SETTER CALL, and the target is not an expression.
    ''
    '' fbc binds the setter with the written arguments FIRST and the assigned value
    '' LAST -- measured on 1.20.0: with 'property Opt( byval idx as long, byval mask as
    '' long )', 'o.Opt( 7 ) = 3' calls Opt( 7, 3 ). Lowering already does this
    '' (LowerPropertySet_ takes the value and puts it in the last parameter); what was
    '' missing is that CHECK first typed the target as an ordinary expression, where a
    '' setter is deliberately not a candidate -- see overload.tiko, 'A PROPERTY SETTER
    '' IS NOT CALLABLE AS AN EXPRESSION'. With a getter of the same arity beside it
    '' that typing happened to succeed and nothing showed; with only a plain getter and
    '' an indexed setter, as AfxNova's CRichEditCtx declares TypographyOptions, no
    '' candidate had the written arity and it reported TKO0632 over a program fbc
    '' compiles.
    ''
    '' THE MARK GOES ON THE CALL, not on the statement. The statement stays AMB_ASSIGN,
    '' which is the path lowering already takes to LowerPropertySet_; the call carries
    '' the fact that its arity is one short of the setter's on purpose, which is what
    '' the resolver needs and the only thing it needs.
    if isAssign andalso (sp->a <> Tko.NODE_NONE) then
        if c.ast->Kind( sp->a ) = Tko.N_CALL then
            if HasPropertySetter_( c, PropertyNameSym_( c, sp->a, sid ) ) then
                c.info->SetAmbiguous( sp->a, Tko.AMB_PROPERTY_SET )
            end if
        end if
    end if

    '' 'f( 123 ) = 123' WHERE f RETURNS BYVAL IS NOT AN ASSIGNMENT AT ALL.
    ''
    '' fbc warns and RE-READS the statement as the call 'f( 123 = 123 )' --
    '' warning 34, "'=' parsed as equality operator in function argument, not
    '' assignment to BYREF function result" -- and emits
    '' '_Z2F1u7INTEGER( -1ll )', the comparison's value passed as the argument.
    '' Only a BYREF result makes the assignment form legal, because only that
    '' has an address to store through.
    ''
    '' AND IT DOES NOT DEPEND ON THE RESULT BEING BYVAL, which the warning's own
    '' wording suggests and measurement refutes: 'br( 1 ) = 456' over a BYREF
    '' result warns and prints 0 too, and so does 'a.At( 2 ) = 88' over a byref
    '' MEMBER. What decides is that ARGUMENTS WERE WRITTEN -- 'br0( ) = 456' with
    '' none is the assignment, and prints 456.
    ''
    '' The BRACKET spelling is untouched: 'a[ 1 ] = 99' over an 'operator []' is
    '' 'vr = _ZN1TixEi( &A, 1 ); *vr = 99' -- measured -- and its callee is a
    '' VARIABLE rather than a procedure, which is what the test below asks.
    if isAssign then
        if ReadCallAssignAsCall_( c, id, sp, sid ) then
            c.info->SetAmbiguous( id, Tko.AMB_CALL )
            c.st->calls += 1
            return
        end if
    end if

    if isAssign then
        '' fbc error 119, "Cannot modify a constant" -- for the SYMBOLIC form
        '' ('const i = 0' then 'i = 0') and for the QUALIFIER ('dim as const integer
        '' i' then 'i = 1') alike, and for a compound assignment the same way.
        ''
        '' ONLY WHEN THE TARGET IS THE BARE NAME. 'p = ...' over a 'const integer ptr'
        '' is LEGAL -- the const is on the POINTEE, and the pointer itself is writable
        '' -- so the test is on the symbol's own type, never on what it points at,
        '' and a member or an index is left alone until there is a measurement for it.
        dim as boolean bareName = (c.ast->Kind( sp->a ) = Tko.N_IDENT)
        if bareName andalso (s <> nullptr) then
            dim as boolean symConst = ((s->flags and Tko.SYMF_CONST) <> 0) orelse _
                                      (cast( Tko.SymbolKind, s->kind ) = Tko.SYM_CONSTANT)
            dim as boolean typeConst = c.types->IsConst( s->type_ )
            if symConst orelse typeConst then
                c.diags->Report( Tko.TKO0617, Tko.PointRange( c.ast->Loc( sp->a ) ), _
                                 c.names->Spelling( s->name ) )
                c.info->SetAmbiguous( id, Tko.AMB_ERROR )
                return
            end if
        end if

        '' Assigning to the enclosing function name is BASIC's result assignment.
        dim as boolean isResult = (c.currentProc <> Tko.SYMBOL_NONE) andalso _
                                  (sid = c.currentProc)
        '' ...AND ANY OTHER FUNCTION'S NAME IS NOT A TARGET AT ALL (T54). 'NoArg = 42' at module
        '' level, or inside another procedure, is fbc's error 317, "Function result assignment
        '' outside of the function" -- byref result or not, measured. tiko read it as an
        '' assignment to the procedure itself, and the program segfaulted at that line. A
        '' PROPERTY is a setter call, and another overload of the current function is its own
        '' result, so neither is judged.
        if (isResult = false) andalso bareName andalso (s <> nullptr) then
            if s->kind = cast( uint8, Tko.SYM_PROC ) then
                dim as Tko.NodeId fpn = cast( Tko.NodeId, s->payload )
                dim as boolean isFunc = false
                if (fpn <> Tko.NODE_NONE) andalso (c.ast->Kind( fpn ) = Tko.N_PROC) then
                    isFunc = (StmtOf( c, fpn )->op = cast( uint16, Tko.KW_FUNCTION ))
                end if
                dim as boolean ownOverload = false
                dim as Tko.SymbolId ov = sid
                for guard as int32 = 0 to 255
                    if ov = Tko.SYMBOL_NONE then exit for
                    if ov = c.currentProc then ownOverload = true
                    ov = c.syms->SymbolAt( ov )->nextOverload
                next
                if isFunc andalso (ownOverload = false) then
                    c.diags->Report( Tko.TKO0939, Tko.PointRange( c.ast->Loc( sp->a ) ), _
                                     c.names->Spelling( s->name ) )
                    c.info->SetAmbiguous( id, Tko.AMB_ERROR )
                    return
                end if
            end if
        end if
        if isResult then
            c.info->SetAmbiguous( id, Tko.AMB_RESULT )
        else
            c.info->SetAmbiguous( id, Tko.AMB_ASSIGN )
        end if
        c.st->assigns += 1
        return
    end if

    if s = nullptr then
        c.info->SetAmbiguous( id, Tko.AMB_CALL )
        c.st->calls += 1
        return
    end if

    select case cast( Tko.SymbolKind, s->kind )
    case Tko.SYM_PROC
        c.info->SetAmbiguous( id, Tko.AMB_CALL )
        c.st->calls += 1
    case Tko.SYM_UDT, Tko.SYM_ENUM, Tko.SYM_TYPEDEF, Tko.SYM_NAMESPACE
        '' ...UNLESS THE TYPE NAME IS ONLY THE BASE. 'UDT( ).copyToGlobal( )'
        '' constructs an ANONYMOUS TEMPORARY and calls a member on it -- the statement
        '' is a CALL, and the type name is the receiver's constructor, not the callee.
        '' The member does not bind (its base is a temporary), so the head's symbol --
        '' the TYPE -- was what reached here and the diagnostic fired on a legal
        '' statement. fbc emits '_ZN3UDTC1Ev( &TMP$2$0 ); _ZN3UDT12COPYTOGLOBALEv(
        '' &TMP$2$0 );' and prints 123.
        if c.ast->Kind( sp->a ) = Tko.N_CALL then
            dim as Tko.NodeId uc = ListOf( c, sp->a )->target
            if c.ast->Kind( uc ) = Tko.N_MEMBER then
                c.info->SetAmbiguous( id, Tko.AMB_CALL )
                c.st->calls += 1
                return
            end if
        end if
        '' This is the diagnostic the ambiguous node exists to make possible.
        dim as Tko.SourceRange r = Tko.PointRange( c.ast->Loc( id ) )
        c.diags->Report( Tko.TKO0602, r, c.names->Spelling( s->name ), _
                         Tko.SymbolKindName( cast( Tko.SymbolKind, s->kind ) ) )
        c.info->SetAmbiguous( id, Tko.AMB_ERROR )
    case else
        c.info->SetAmbiguous( id, Tko.AMB_CALL )
        c.st->calls += 1
    end select
end sub

'' A TYPE BUILT OVER SOMETHING NOT RESOLVED YET.
''
'' 'type t as u const ptr' written before 'type u as integer' resolves to a POINTER
'' TO NOTHING -- non-NONE, so 'dim as t p' looked resolved and never landed on the
'' pending list. BackpatchTypedefs then fixed the TYPEDEF and never came back to the
'' variable, whose slot stayed void: '*p = 0' had an untyped target and declined.
''
'' Refusing to BUILD the pointer was tried and is far too blunt -- 'any ptr' has no
'' element type either, and an unresolved 'typeof' none yet -- so it left those
'' declarations untyped instead and cost 540 corpus statements. The type is built as
'' before; this only says the declaration is worth revisiting.
private function TypeIsIncomplete_ _
    ( byref c as Ctx, byval t as Tko.TypeId ) as boolean

    dim as Tko.TypeId u = t
    for depth as int32 = 0 to 15
        if u = Tko.TYPE_NONE then return false
        u = c.types->Unqualify( u )
        select case c.types->Kind( u )
        case Tko.TK_POINTER, Tko.TK_REFERENCE, Tko.TK_ARRAY
            dim as Tko.TypeId inner = c.types->Inner( u )
            '' THE POINTEE IS MISSING -- which is what an unresolved element leaves.
            '' 'any ptr' is NOT this: its element is the ANY builtin, a real type.
            if inner = Tko.TYPE_NONE then return true
            u = inner
        case Tko.TK_TYPEDEF
            '' The placeholder Collect gives every typedef, still unfilled.
            return true
        case else
            return false
        end select
    next
    return false
end function
