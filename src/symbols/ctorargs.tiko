'' ctorargs.tiko -- AN ARGUMENT A TYPE'S ONLY CONSTRUCTOR CANNOT TAKE, fbc's error 58.
''
'' Included from latesweeps2.tiko, below declshape.tiko, in the same namespace and over the same Ctx.

'' ...AND WHAT A DIRECT CALL REFUSES THAT ProcPtrArgBad_ DOES NOT ASK. 'T( v )' over one
'' constructor is an ordinary call, so it takes the rule 'g( v )' over the same parameter takes
'' (argmismatch.tiko AmBadPair_, which this pass cannot reach). Measured on fbc-modern 1.20,
'' 2026-10-19, as 'var x = T( v )': lowering found no conversion for any of these and stopped
'' on TKO0994.
''
''     a pointer, a boolean or an enum into a string parameter      58
''     an enum variable into 'byref as long'                        58
''     a pointer into a boolean, a float, 'byref as long' or an     warning 2, then 24
''         integer not of pointer size                              (58 for the byref)
''     a float, a boolean or a narrower integer VARIABLE into a     warning 1, then 24
''         pointer -- a literal, a constant or 'i + 1' binds
''
'' What binds and still had no constructor -- an enum into a pointer, a pointer into an enum --
'' is structpick.tiko's LoneScalarStructor.
private function ExplicitArgBad_ ( byref c as Ctx, byval pt as TypeId, byval arg as NodeId ) as boolean
    if pt = TYPE_NONE then return false
    dim as TypeId at = c.info->TypeOf_( arg )
    if at = TYPE_NONE then return false
    if c.ast->Kind( arg ) = N_UNARY then
        dim as UnaryPayload ptr aup = _
            c.ast->UnaryOf( arg )
        if cast( TokenKind, aup->op ) = KW_BYVAL then return false
    end if
    dim as TypeId pv = c.types->Unqualify( pt )
    dim as boolean isRef = (c.types->Kind( pv ) = TK_REFERENCE)
    if isRef then pv = c.types->Unqualify( c.types->Inner( pv ) )
    dim as TypeId av = c.types->Unqualify( at )
    if c.types->Kind( av ) = TK_REFERENCE then av = c.types->Unqualify( c.types->Inner( av ) )
    dim as TypeKind pk = c.types->Kind( pv )
    dim as TypeKind ak = c.types->Kind( av )
    dim as int32 pc = ArgClass_( c, pv )
    dim as int32 ac = ArgClass_( c, av )
    if pc = 1 then
        return (ak = TK_POINTER) orelse (ac = 3) orelse (ak = TK_ENUM)
    end if
    if ak = TK_POINTER then
        if pc = 3 then return true
        if pc = 2 then
            if isRef orelse IsFloatBuiltin_( c, pv ) then return true
            return (c.types->Layout( pv ).size <> c.types->Layout( av ).size)
        end if
        return false
    end if
    if pk = TK_POINTER then
        if ((ac = 2) orelse (ac = 3)) andalso NamedLvalue_( c, arg ) then
            if (ac = 3) orelse IsFloatBuiltin_( c, av ) then return true
            return (c.types->Layout( av ).size <> c.types->Layout( pv ).size)
        end if
        return false
    end if
    if (ak = TK_ENUM) andalso isRef andalso (pk <> TK_ENUM) then return NamedLvalue_( c, arg )
    return false
end function

'' CheckDirectCallArgs_ (latechecks.tiko) judges a SUB or FUNCTION's arguments and leaves a
'' structor alone, so 'T( 1, "hi" )' over 'constructor( byval a as long, byref w as long )'
'' compiled, and the constructor read a string descriptor as its long. Measured on
'' fbc-modern 1.20, 2026-10-02, every shape is error 58, "Type mismatch, at parameter 2":
''
''     dim x as T = T( 1, "hi" )      var z = T( 4, "w" )      x = T( 5, "v" )
''     g( T( 2, "x" ) )               dim q as T ptr = new T( 3, "y" )
''
'' -- byref or byval, a literal or a string variable. The rule is ProcPtrArgBad_'s, the one
'' an ordinary call is judged by, so the two cannot drift apart.
''
'' ONE CONSTRUCTOR ONLY. Over an overload set fbc says 99, "No matching overloaded
'' function", which is not this report. And not a ONE-ARGUMENT call over a UDT value: 'C( c1 )'
'' over only 'constructor( byval a as long )' is 58 for plain fields, but give C a string
'' field and fbc accepts it -- the implicit copy constructor is a second candidate, and the
'' symbol table does not hold it. Saying nothing is the side that cannot be wrong.

private sub CheckCtorArgsOf_ _
    ( byref c as Ctx, byval t as TypeId, byval argFirst as int32, byval argCount as int32 )

    if argCount <= 0 then return
    t = c.types->Unqualify( t )
    if (t = TYPE_NONE) orelse (c.types->Kind( t ) <> TK_UDT) then return
    dim as InternId tn = c.types->NameOf( t )
    if tn = 0 then return
    '' Not an anonymous, synthesised or generic type -- CheckUdtCallNoCtor_'s exclusions.
    dim as string h = left( c.names->Spelling( tn ), 1 )
    if (h = "(") orelse (h = "$") orelse (h = "~") then return
    if instr( c.names->Spelling( tn ), "<" ) > 0 then return
    dim as Symbol ptr s = StructorOf_( c, t, "__ctor" )
    if s = nullptr then return
    if s->kind <> cast( uint8, SYM_PROC ) then return
    if (s->nextOverload <> SYMBOL_NONE) orelse ((s->flags and SYMF_OVERLOAD) <> 0) then return
    dim as NodeId decl = cast( NodeId, s->payload )
    if (decl = NODE_NONE) orelse (c.ast->Kind( decl ) <> N_PROC) then return
    if (c.ast->StmtOf( decl )->extra and PF_GENERIC_PROC) <> 0 then return

    if argCount = 1 then
        dim as TypeId a0 = c.types->Unqualify( c.info->TypeOf_( cast( NodeId, c.ast->ChildSlot( argFirst ) ) ) )
        if c.types->Kind( a0 ) = TK_REFERENCE then a0 = c.types->Unqualify( c.types->Inner( a0 ) )
        if c.types->Kind( a0 ) = TK_UDT then return
    end if

    for i as int32 = 0 to argCount - 1
        dim as NodeId warg = cast( NodeId, c.ast->ChildSlot( argFirst + i ) )
        if c.ast->Kind( warg ) = N_ELIDED then continue for
        dim as NodeId prm = ProcDeclParam_( c.ast, decl, i )
        if prm = NODE_NONE then exit for
        if (c.ast->Flags( prm ) and NF_ARRAY) <> 0 then continue for
        dim as NodeId pref = c.ast->StmtOf( prm )->a
        if pref = NODE_NONE then continue for
        dim as TypeId pt = c.info->TypeOf_( pref )
        if pt = TYPE_NONE then continue for
        if (c.ast->Flags( prm ) and NF_BYREF) <> 0 then pt = c.types->Reference( pt )
        if ProcPtrArgBad_( c, pt, warg ) orelse ExplicitArgBad_( c, pt, warg ) then
            c.diags->Report( TKO0698, PointRange( c.ast->Loc( warg ) ) )
            return
        end if
    next
end sub

'' A COUNT OF ARGUMENTS NO CONSTRUCTOR TAKES (T82) -- fbc's error 1, "Argument count
'' mismatch", over one constructor, and 99, "No matching overloaded function", over a set.
'' Measured on fbc-modern 1.20, 2026-10-03, in every shape CheckCtorArgsOf_ lists, through a
'' typedef as well. tiko said nothing and built the value from SOME constructor:
'' 'TimeSpan( 0, 1, 30, 0 )' against constructors of three and five gave thirty minutes.
''
'' Each candidate takes from its count of parameters without a default to its count of
'' parameters (no upper end past '...'). ONE ARGUMENT OF A UDT TYPE is left alone: the implicit
'' copy constructor is a candidate the symbol table does not hold (see the note above). Nor
'' a generic candidate, whose parameters are not instantiated here. Returns true if reported.
private function CheckCtorArity_ _
    ( byref c as Ctx, byval t as TypeId, byval argFirst as int32, byval argCount as int32, _
      byval at as NodeId ) as boolean

    t = c.types->Unqualify( t )
    if (t = TYPE_NONE) orelse (c.types->Kind( t ) <> TK_UDT) then return false
    dim as InternId tn = c.types->NameOf( t )
    if tn = 0 then return false
    dim as string h = left( c.names->Spelling( tn ), 1 )
    if (h = "(") orelse (h = "$") orelse (h = "~") then return false
    if instr( c.names->Spelling( tn ), "<" ) > 0 then return false
    dim as Symbol ptr s = StructorOf_( c, t, "__ctor" )
    if s = nullptr then return false
    if s->kind <> cast( uint8, SYM_PROC ) then return false

    if argCount = 1 then
        dim as NodeId a0n = cast( NodeId, c.ast->ChildSlot( argFirst ) )
        dim as TypeId a0 = c.types->Unqualify( c.info->TypeOf_( a0n ) )
        if a0 = TYPE_NONE then return false
        if c.types->Kind( a0 ) = TK_REFERENCE then a0 = c.types->Unqualify( c.types->Inner( a0 ) )
        if c.types->Kind( a0 ) = TK_UDT then return false
    end if

    dim as int32 candidates = 0, lo = 0, hi = 0
    dim as Symbol ptr cs = s
    while cs <> nullptr
        if cs->kind <> cast( uint8, SYM_PROC ) then return false
        dim as NodeId decl = cast( NodeId, cs->payload )
        if (decl = NODE_NONE) orelse (c.ast->Kind( decl ) <> N_PROC) then return false
        dim as StmtPayload ptr pp = c.ast->StmtOf( decl )
        if (pp->extra and PF_GENERIC_PROC) <> 0 then return false
        dim as int32 need = 0, np = 0
        dim as boolean variadic = false
        for i as int32 = 0 to pp->count - 1
            dim as NodeId prm = c.ast->ChildAt( pp->first, i )
            if c.ast->Kind( prm ) <> N_PARAM then continue for
            dim as StmtPayload ptr psp = c.ast->StmtOf( prm )
            '' ...a TYPED variadic ('args( ) as T ...') takes any count, none included.
            if (psp->op = cast( uint16, TK_ELLIPSIS )) orelse ((c.ast->Flags( prm ) and NF_VARIADIC) <> 0) then
                variadic = true
                continue for
            end if
            np += 1
            if psp->b = NODE_NONE then need = np
        next
        '' One candidate that takes this many settles it.
        if argCount >= need then
            if variadic orelse (argCount <= np) then return false
        end if
        candidates += 1
        lo = need
        hi = np
        if cs->nextOverload = SYMBOL_NONE then exit while
        cs = c.syms->SymbolAt( cs->nextOverload )
    wend

    dim as string shown = c.names->Spelling( tn ) & ".constructor"
    if candidates = 1 then
        dim as string takes = str( hi )
        if lo <> hi then takes = lo & " to " & hi
        c.diags->Report( TKO0775, PointRange( c.ast->Loc( at ) ), str( argCount ), shown, takes )
    else
        c.diags->Report( TKO0632, PointRange( c.ast->Loc( at ) ), shown )
    end if
    return true
end function

'' A CONVERTING INITIALISER NO CONSTRUCTOR TAKES -- 'dim as T x = v', v not a T. fbc's error
'' 24, "Invalid data types" (58 for a few), measured on fbc-modern 1.20, 2026-10-19: a long
'' into 'byref as string' or 'byref as wstring', a string, ustring or "lit" into 'byval as
'' long', a double into 'byref as wstring' (58). tiko built a value from the constructor
'' anyway, or stopped on TKO0994. The explicit 'T( v )' was judged (CheckCtorArgsOf_); this
'' form never was.
''
'' STRICTER THAN 'T( v )'. fbc resolves the initialiser's constructor as an overload, even a
'' single one, so what a lone call only warns about is refused here -- measured, each 24 as an
'' initialiser and a warning or nothing as 'T( v )':
''
''     a pointer into any parameter that is not a pointer       'long ptr' into 'integer'
''     a pointer into another pointer, unless one is 'any ptr', the pointee is the same (no
''         'const' dropped), a derived UDT, or a same-size integer ('ulong ptr' into 'long ptr')
''     a number into a pointer, unless an integer of pointer size, a literal or an enum:
''         'long', 'ulong', 'double', 'boolean' and 'const K as long' are 24; 'integer',
''         'longint', '5' and 'v + 1' over an integer are not
''     anything into an enum but that enum -- '0' included
''     an enum variable into 'byref as long' (58)
''
'' and the rest is ProcPtrArgBad_, the explicit call's rule. Over a SET, refused when no
'' candidate takes it: 'byval as long' beside the copy constructor is 24 for a string, and so
'' are 'long' and 'double' for a pointer. A parameter of ANOTHER UDT may build one from the
'' value ('byref u as U', U built from a long, takes 5) and declines the whole question; the
'' copy constructor takes nothing that is not a T. A UDT value is JudgeConversion_'s
'' (latesweeps2.tiko). Not judged: a generic constructor, an array or variadic parameter, a
'' generic instance.

'' Does pointer value 'av' convert to pointer parameter 'pv' in an initialiser?
private function InitPtrTakes_ ( byref c as Ctx, byval av as TypeId, byval pv as TypeId ) as boolean
    dim as TypeId ai = c.types->Inner( av )
    dim as TypeId pi = c.types->Inner( pv )
    dim as TypeId au = c.types->Unqualify( ai )
    dim as TypeId pu = c.types->Unqualify( pi )
    if (c.types->Kind( au ) = TK_BUILTIN) andalso (c.types->BuiltinOf( au ) = TY_ANY) then return true
    if (c.types->Kind( pu ) = TK_BUILTIN) andalso (c.types->BuiltinOf( pu ) = TY_ANY) then return true
    if c.types->IsConst( ai ) andalso (c.types->IsConst( pi ) = false) then return false
    if au = pu then return true
    if (c.types->Kind( au ) = TK_UDT) andalso (c.types->Kind( pu ) = TK_UDT) then
        return (c.types->BaseDistance( au, pu ) >= 0)
    end if
    return (Tko.Check.PtrCastScore( *c.types, av, pv ) > 0)
end function

'' One candidate's first parameter 'prm' against the value 'arg': 1 refused, 0 taken, -1
'' cannot tell. 't' is the type being built.
private function InitArgFit_ _
    ( byref c as Ctx, byval t as TypeId, byval prm as NodeId, byval arg as NodeId ) as int32

    if (c.ast->Flags( prm ) and (NF_ARRAY or NF_VARIADIC)) <> 0 then return -1
    dim as NodeId pref = c.ast->StmtOf( prm )->a
    if pref = NODE_NONE then return -1
    dim as TypeId pt = c.info->TypeOf_( pref )
    if pt = TYPE_NONE then return -1
    dim as boolean isRef = ((c.ast->Flags( prm ) and NF_BYREF) <> 0)
    if isRef then pt = c.types->Reference( pt )
    dim as TypeId pv = c.types->Unqualify( pt )
    if c.types->Kind( pv ) = TK_REFERENCE then pv = c.types->Unqualify( c.types->Inner( pv ) )
    dim as TypeId av = c.types->Unqualify( c.info->TypeOf_( arg ) )
    if c.types->Kind( av ) = TK_REFERENCE then av = c.types->Unqualify( c.types->Inner( av ) )
    dim as TypeKind pk = c.types->Kind( pv )
    dim as TypeKind ak = c.types->Kind( av )
    if pk = TK_UDT then
        if pv = t then return 1
        return -1
    end if
    if ProcPtrArgBad_( c, pt, arg ) then return 1
    if ak = TK_POINTER then
        if pk <> TK_POINTER then return 1
        return iif( InitPtrTakes_( c, av, pv ), 0, 1 )
    end if
    if pk = TK_POINTER then
        if ak = TK_ENUM then return 0
        dim as int32 cls = ArgClass_( c, av )
        if cls = 3 then return 1
        if cls = 2 then
            if IsFloatBuiltin_( c, av ) then return 1
            if c.ast->Kind( arg ) = N_INT_LIT then return 0
            if c.types->Layout( av ).size <> c.types->Layout( pv ).size then return 1
        end if
        return 0
    end if
    if pk = TK_ENUM then return iif( av = pv, 0, 1 )
    if (ak = TK_ENUM) andalso isRef andalso (av <> pv) then
        if NamedLvalue_( c, arg ) then return 1
    end if
    return 0
end function

'' Is 't' a type these checks judge, and 'init' a value they judge? Not an anonymous,
'' synthesised or generic type; not a UDT value (JudgeConversion_'s), a tuple or 'this'.
function StructorJudged_ ( byref c as Ctx, byref t as TypeId, byval init as NodeId ) as boolean
    t = c.types->Unqualify( t )
    if (t = TYPE_NONE) orelse (c.types->Kind( t ) <> TK_UDT) then return false
    dim as InternId tn = c.types->NameOf( t )
    if tn = 0 then return false
    dim as string h = left( c.names->Spelling( tn ), 1 )
    if (h = "(") orelse (h = "$") orelse (h = "~") then return false
    if instr( c.names->Spelling( tn ), "<" ) > 0 then return false
    if IsThisBase_( c, init ) then return false
    dim as TypeId av = c.info->TypeOf_( init )
    if av = TYPE_NONE then return false
    av = c.types->Unqualify( av )
    if c.types->Kind( av ) = TK_REFERENCE then av = c.types->Unqualify( c.types->Inner( av ) )
    select case c.types->Kind( av )
    case TK_BUILTIN, TK_POINTER, TK_ENUM
    case TK_ARRAY
        if ArgClass_( c, av ) <> 1 then return false
    case else
        return false
    end select
    return true
end function

'' Does one of t's constructors ('__ctor') or 'let' operators ('let') take 'init' as its one
'' argument? 1 none does -- none declared included -- 0 one does, -1 cannot tell.
private function StructorChainFit_ _
    ( byref c as Ctx, byval t as TypeId, byval init as NodeId, byref nm as string ) as int32

    dim as Symbol ptr s = StructorOf_( c, t, nm )
    if s = nullptr then
        '' An inherited 'let' is not judged.
        if nm = "let" then
            if BaseOf_( c, t ) <> TYPE_NONE then
                if DeclaresAnywhere_( c, BaseOf_( c, t ), "let" ) then return -1
            end if
        end if
        return 1
    end if
    dim as int32 guard = 0
    while (s <> nullptr) andalso (guard < 4096)
        guard += 1
        if s->kind <> cast( uint8, SYM_PROC ) then return -1
        dim as NodeId decl = cast( NodeId, s->payload )
        if (decl = NODE_NONE) orelse (c.ast->Kind( decl ) <> N_PROC) then return -1
        dim as StmtPayload ptr pp = c.ast->StmtOf( decl )
        if (pp->extra and PF_GENERIC_PROC) <> 0 then return -1
        '' One argument: a first parameter, every other one defaulted.
        dim as NodeId first_ = NODE_NONE
        dim as boolean oneArg = true
        for i as int32 = 0 to pp->count - 1
            dim as NodeId prm = c.ast->ChildAt( pp->first, i )
            if c.ast->Kind( prm ) <> N_PARAM then continue for
            dim as StmtPayload ptr psp = c.ast->StmtOf( prm )
            if psp->op = cast( uint16, TK_ELLIPSIS ) then return -1
            if first_ = NODE_NONE then
                first_ = prm
            elseif psp->b = NODE_NONE then
                oneArg = false
            end if
        next
        if (first_ <> NODE_NONE) andalso oneArg then
            dim as int32 fit = InitArgFit_( c, t, first_, init )
            if fit <> 1 then return fit
        end if
        s = c.syms->SymbolAt( s->nextOverload )
    wend
    return 1
end function

'' True when no constructor of 't' takes the initialiser 'init'. A type with none is
'' JudgeConversion_'s.
function CtorInitRefused_ ( byref c as Ctx, byval t as TypeId, byval init as NodeId ) as boolean
    if StructorJudged_( c, t, init ) = false then return false
    if StructorOf_( c, t, "__ctor" ) = nullptr then return false
    return (StructorChainFit_( c, t, init, "__ctor" ) = 1)
end function

'' ...AND A FUNCTION'S RESULT. Measured on fbc-modern 1.20, 2026-10-19, a function 'as T' given
'' a value that is not a T:
''
''     return v        a constructor taking v, as the initialiser's rule above, or failing
''                     that an 'operator let' taking it -- 'return s' over 'constructor(
''                     byval as long )' and 'let( byref as string )' builds by the let
''     function = v    an 'operator let' taking v, and nothing else: it is an ASSIGNMENT,
''                     so a constructor does not rescue it (Rescued_'s table)
''
'' -- otherwise error 181 (58 for a few), and with neither declared too. tiko accepted all
'' of them, or stopped on TKO0994; and refused 'return d' over a type with only 'let(
'' byval as long )', which fbc takes. 'byAssign' is true for 'function ='.
function ResultValueRefused_ _
    ( byref c as Ctx, byval t as TypeId, byval v as NodeId, byval byAssign as boolean ) as boolean
    if StructorJudged_( c, t, v ) = false then return false
    if byAssign = false then
        if StructorChainFit_( c, t, v, "__ctor" ) <> 1 then return false
    end if
    return (StructorChainFit_( c, t, v, "let" ) = 1)
end function

'' ...AND EACH ELEMENT OF AN ARRAY'S BRACE LIST: 'dim as T a( 0 to 1 ) = { 1, "x" }' is 24 for
'' the "x", a nested list one level per dimension. A paren list builds a UDT element field by
'' field and is braceinit.tiko's.
private sub CheckCtorInitList_ _
    ( byref c as Ctx, byval n as NodeId, byval elemT as TypeId, byval depth as int32 )
    if depth > 16 then return
    dim as ListPayload ptr lp = c.ast->ListOf( n )
    dim as int32 first_ = lp->first
    dim as int32 count_ = lp->count
    for i as int32 = 0 to count_ - 1
        dim as NodeId el = cast( NodeId, c.ast->ChildSlot( first_ + i ) )
        select case c.ast->Kind( el )
        case N_INITIALIZER
            CheckCtorInitList_( c, el, elemT, depth + 1 )
        case N_TUPLE, N_PAREN, N_ELIDED
        case else
            if CtorInitRefused_( c, elemT, el ) then c.diags->Report( TKO0738, PointRange( c.ast->Loc( el ) ) )
        end select
    next
end sub

'' A brace list 'init' for a variable or field of type 't', when t is an array of a UDT.
sub CheckCtorArrayInit_ ( byref c as Ctx, byval t as TypeId, byval init as NodeId )
    if (t = TYPE_NONE) orelse (init = NODE_NONE) then return
    if c.ast->Kind( init ) <> N_INITIALIZER then return
    dim as TypeId u = c.types->Unqualify( t )
    if c.types->Kind( u ) <> TK_ARRAY then return
    dim as int32 guard = 0
    while (c.types->Kind( u ) = TK_ARRAY) andalso (guard < 16)
        guard += 1
        u = c.types->Unqualify( c.types->Inner( u ) )
    wend
    if c.types->Kind( u ) <> TK_UDT then return
    CheckCtorInitList_( c, init, u, 0 )
end sub

'' ...AND A FIELD'S: 'type H : dim as T f = v : end type' is the same 24 (58), measured over
'' the same shapes. A variable's is asked from CheckUdtInits_ (latesweeps2.tiko).
sub CheckFieldCtorInits_ ( byref c as Ctx )
    for i as int32 = 0 to c.syms->symbols.Count - 1
        dim as Symbol ptr s = @c.syms->symbols[i]
        if s->kind <> cast( uint8, SYM_FIELD ) then continue for
        if s->type_ = TYPE_NONE then continue for
        '' A bitfield's payload is its width, and its type never a UDT or an array.
        dim as TypeKind fk = c.types->Kind( c.types->Unqualify( s->type_ ) )
        if (fk <> TK_UDT) andalso (fk <> TK_ARRAY) then continue for
        if s->payload = 0 then continue for
        dim as NodeId fn = cast( NodeId, s->payload )
        if c.ast->Kind( fn ) <> N_FIELD then continue for
        '' The initialiser is in 'c': on an N_FIELD 'b' is a bitfield's width.
        dim as NodeId iv = c.ast->StmtOf( fn )->c
        if iv = NODE_NONE then continue for
        if fk = TK_ARRAY then
            CheckCtorArrayInit_( c, s->type_, iv )
        elseif CtorInitRefused_( c, s->type_, iv ) then
            c.diags->Report( TKO0738, PointRange( c.ast->Loc( fn ) ) )
        end if
    next
end sub

'' 'T( ... )' naming the type, and 'new T( ... )'.
sub CheckCtorCallArgs_ ( byref c as Ctx, byval id as NodeId, byval k as NodeKind )
    dim as ListPayload ptr lp = c.ast->ListOf( id )
    if lp->target = NODE_NONE then return
    if k = N_NEW then
        dim as int32 first, count
        NewCtorArgs_( c, id, first, count )
        '' 'new T' with no list is a default construction, judged elsewhere.
        if count > 0 then
            if CheckCtorArity_( c, c.info->TypeOf_( lp->target ), first, count, id ) then return
        end if
        CheckCtorArgsOf_( c, c.info->TypeOf_( lp->target ), first, count )
        return
    end if
    '' ...OR A QUALIFIED ONE (T87): 'chrono.TimeSpan( 0, 1, 30, 0 )', 'FB.TimeSpan( ... )',
    '' 'N.P( 1, 2 )' -- an N_MEMBER, whose type is the reference of its right-hand name.
    '' Only an N_IDENT was judged, so the chapter's own example compiled and crashed.
    dim as NodeId tg = lp->target
    if (c.ast->Kind( tg ) <> N_IDENT) andalso (c.ast->Kind( tg ) <> N_MEMBER) then return
    dim as SymbolId tsid = c.info->RefOf( tg )
    if (tsid = SYMBOL_NONE) andalso (c.ast->Kind( tg ) = N_MEMBER) then
        tsid = c.info->RefOf( c.ast->BinaryOf( tg )->rhs )
    end if
    dim as Symbol ptr ts = c.syms->SymbolAt( tsid )
    if ts = nullptr then return
    if (ts->kind <> cast( uint8, SYM_UDT )) andalso (ts->kind <> cast( uint8, SYM_TYPEDEF )) then return
    if CheckCtorArity_( c, c.info->TypeOf_( id ), lp->first, lp->count, id ) then return
    CheckCtorArgsOf_( c, c.info->TypeOf_( id ), lp->first, lp->count )
end sub
