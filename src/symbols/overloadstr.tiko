'' overloadstr.tiko -- A CONSTANT STRING ARGUMENT, COSTED AS THE LITERAL IT IS.
''
'' Included from overload.tiko, just above ResolveCall_, for the 1500-line lint cap: whether
'' a concatenation is a ustring or a wide one (moved here unchanged), the width of a constant
'' string argument, which string parameters that width is asked of,
'' and what a CONST string costs against a byval one.

'' Whether a string concatenation has a USTRING term anywhere in it -- see ResolveCall_.
'' A '+' counts only where it is itself a string operation; 'u & (n + 1)' has none.
private function ConcatHasUString_ _
    ( byref c as Ctx, byval id as Tko.NodeId ) as boolean

    if id = Tko.NODE_NONE then return false
    '' A PARENTHESISED CHAIN IS LOOKED INTO. Measured, '#print typeof( ucase( "x" & ( u &
    '' "y" ) ) )' is USTRING; typed STRING, 'print' of it went to fb_PrintString.
    if c.ast->Kind( id ) = Tko.N_PAREN then
        dim as Tko.ListPayload ptr pp = _
            c.ast->ListOf( id )
        if pp->count <> 1 then return false
        return ConcatHasUString_( c, cast( Tko.NodeId, c.ast->children[pp->first] ) )
    end if
    dim as Tko.TypeId t = TypeOf_( c, id )
    if t = Tko.TYPE_NONE then return false
    dim as Tko.TypeId u = c.types->Unqualify( t )
    if c.types->Kind( u ) = Tko.TK_REFERENCE then u = c.types->Unqualify( c.types->Inner( u ) )
    if c.types->Kind( u ) <> Tko.TK_BUILTIN then return UdtCastsToUStr_( c, u )   '' a UDT term casting to a ustring (T50)
    dim as Tko.BuiltinType bt = c.types->BuiltinOf( u )
    if bt = Tko.TY_USTRING then return true
    if c.ast->Kind( id ) <> Tko.N_BINARY then return false
    if bt <> Tko.TY_STRING then return false
    dim as Tko.BinaryPayload ptr bp = _
        c.ast->BinaryOf( id )
    dim as Tko.TokenKind op = cast( Tko.TokenKind, bp->op )
    if (op <> Tko.TK_AMP) andalso (op <> Tko.TK_PLUS) then return false
    if ConcatHasUString_( c, bp->lhs ) then return true
    return ConcatHasUString_( c, bp->rhs )
end function

'' AN IIF ARM'S TYPE, with a ustring CHAIN as the USTRING fbc types it -- see the iif row
'' in intrinsics.tiko. Only a STRING-typed concatenation is reconsidered: a UDT arm that
'' casts to a ustring is still that UDT.
private function IifUStrChainArm_ _
    ( byref c as Ctx, byval arm as Tko.NodeId, byval t as Tko.TypeId ) as Tko.TypeId
    if t = Tko.TYPE_NONE then return t
    if c.types->Kind( t ) <> Tko.TK_BUILTIN then return t
    if c.types->BuiltinOf( t ) <> Tko.TY_STRING then return t
    if ConcatHasUString_( c, arm ) then return c.types->Builtin( Tko.TY_USTRING )
    return t
end function

'' Whether an UNTYPED '+' or '&' concatenation has a term whose UDT casts to WSTRING and
'' to no other string -- see ResolveCall_. AfxNova's DWSTRING concatenates that way,
'' through 'cast( ) byref as const wstring', and Check leaves the result untyped because
'' lowering decides the width per term. fbc types it: measured, '#print typeof( a + " 2026" )'
'' over such a type is WSTRING * 1, and 'mk( a + " 2027" )' calls the wstring overload
'' of 'mk' even with a 'byval n as long' one declared first.
private function ConcatHasWideCastTerm_ _
    ( byref c as Ctx, byval id as Tko.NodeId ) as boolean

    if id = Tko.NODE_NONE then return false
    dim as Tko.TypeId t = TypeOf_( c, id )
    if c.ast->Kind( id ) = Tko.N_BINARY then
        '' A TYPED binary is some other operation -- a user 'operator +' among them.
        if t <> Tko.TYPE_NONE then return false
        dim as Tko.BinaryPayload ptr bp = _
            c.ast->BinaryOf( id )
        dim as Tko.TokenKind op = cast( Tko.TokenKind, bp->op )
        if (op <> Tko.TK_AMP) andalso (op <> Tko.TK_PLUS) then return false
        if ConcatHasWideCastTerm_( c, bp->lhs ) then return true
        return ConcatHasWideCastTerm_( c, bp->rhs )
    end if
    if t = Tko.TYPE_NONE then return false
    dim as Tko.TypeId u = c.types->Unqualify( t )
    if c.types->Kind( u ) = Tko.TK_REFERENCE then u = c.types->Unqualify( c.types->Inner( u ) )
    if c.types->Kind( u ) <> Tko.TK_UDT then return false
    dim as boolean hasWide = false
    dim as Tko.SymbolId cs = UdtMemberSym_( c, u, "cast" )
    while cs <> Tko.SYMBOL_NONE
        dim as Tko.Symbol ptr cse = c.syms->SymbolAt( cs )
        if cse = nullptr then exit while
        if cse->type_ <> Tko.TYPE_NONE then
            dim as Tko.TypeId ru = c.types->Unqualify( cse->type_ )
            if c.types->Kind( ru ) = Tko.TK_REFERENCE then ru = c.types->Unqualify( c.types->Inner( ru ) )
            if c.types->Kind( ru ) = Tko.TK_BUILTIN then
                select case c.types->BuiltinOf( ru )
                case Tko.TY_WSTRING
                    hasWide = true
                case Tko.TY_STRING, Tko.TY_ZSTRING, Tko.TY_USTRING
                    return false
                end select
            end if
        end if
        cs = cse->nextOverload
    wend
    return hasWide
end function

'' A CONSTANT STRING ARGUMENT, and its width: 1 narrow, 2 wide, 3 a numeric literal (a
'' constant with no width, which '&' may join to a string), 0 anything else.
''
'' fbc folds a constant string into a LITERAL, and a literal is a ZSTRING -- a WSTRING when
'' any term has a unicode escape -- not a STRING. Measured 2026-09-19, one probe per pair
'' over { string, byval string, zstring ptr, byref zstring, wstring ptr }: "zz", '"z" "z"',
'' '"z" & "z"', '"z" + "z"', '"z" & 1', '( "zz" )', 'const C = "zz"', 'const C as string
'' = "zz"' and 'C1 & "z"' all choose exactly as a 'zstring * 8' variable does, and a
'' literal with a unicode escape, a wide CONST and a wide-and-narrow concatenation exactly
'' as a 'wstring * 8' one. A string VARIABLE, or 'sv & "z"', is a STRING and is not this.
private function ConstStrArgWidth_ _
    ( byref c as Ctx, byval a as Tko.NodeId, byval depth as int32 = 0 ) as int32

    if (a = Tko.NODE_NONE) orelse (depth > 16) then return 0
    select case c.ast->Kind( a )
    case Tko.N_STRING_LIT
        if c.ast->LiteralOf( a )->strWide <> 0 then
            return 2
        end if
        return 1
    case Tko.N_INT_LIT, Tko.N_FLOAT_LIT
        return 3
    case Tko.N_STRCAT, Tko.N_PAREN
        '' Adjacent literals are one; a parenthesis holds one expression.
        dim as Tko.ListPayload ptr lp = _
            c.ast->ListOf( a )
        dim as boolean isCat = (c.ast->Kind( a ) = Tko.N_STRCAT)
        if lp->count < 1 then return 0
        if (isCat = false) andalso (lp->count <> 1) then return 0
        dim as int32 w = 0
        for i as int32 = 0 to lp->count - 1
            dim as Tko.NodeId e = c.ast->ChildAt( lp->first, i )
            dim as int32 wi = ConstStrArgWidth_( c, e, depth + 1 )
            if wi = 0 then return 0
            if isCat then
                if wi = 3 then return 0
            end if
            if wi > w then w = wi
        next
        return w
    case Tko.N_BINARY
        dim as Tko.BinaryPayload ptr bp = _
            c.ast->BinaryOf( a )
        dim as Tko.TokenKind op = cast( Tko.TokenKind, bp->op )
        if (op <> Tko.TK_AMP) andalso (op <> Tko.TK_PLUS) then return 0
        dim as int32 lw = ConstStrArgWidth_( c, bp->lhs, depth + 1 )
        dim as int32 rw = ConstStrArgWidth_( c, bp->rhs, depth + 1 )
        if (lw = 0) orelse (rw = 0) then return 0
        '' '&' takes a number on either side and '+' does not; one side must be a string.
        if (lw = 3) andalso (rw = 3) then return 0
        if (op = Tko.TK_PLUS) andalso ((lw = 3) orelse (rw = 3)) then return 0
        if (lw = 2) orelse (rw = 2) then return 2
        return 1
    case Tko.N_IDENT
        dim as Tko.Symbol ptr ks = c.syms->SymbolAt( c.info->RefOf( a ) )
        if ks = nullptr then return 0
        if ks->kind <> cast( uint8, Tko.SYM_CONSTANT ) then return 0
        '' A PREDECLARED constant -- 'true', 'false' -- carries a VALUE here, not a node.
        if (ks->payload <= 0) orelse (ks->payload >= c.ast->nodes.Count) then return 0
        dim as Tko.NodeId item = cast( Tko.NodeId, ks->payload )
        if c.ast->Kind( item ) <> Tko.N_VAR_ITEM then return 0
        return ConstStrArgWidth_( c, StmtOf( c, item )->b, depth + 1 )
    end select
    return 0
end function

'' Is this parameter type one of the string family, or a pointer to a zstring or wstring --
'' the parameters the widths above were measured against, and the only ones they change.
private function StrFamilyParam_ _
    ( byref c as Ctx, byval pt as Tko.TypeId ) as boolean

    if pt = Tko.TYPE_NONE then return false
    pt = c.types->Unqualify( pt )
    if c.types->Kind( pt ) = Tko.TK_REFERENCE then pt = c.types->Unqualify( c.types->Inner( pt ) )
    dim as boolean isPtr = (c.types->Kind( pt ) = Tko.TK_POINTER)
    if isPtr then pt = c.types->Unqualify( c.types->Inner( pt ) )
    if c.types->Kind( pt ) <> Tko.TK_BUILTIN then return false
    select case c.types->BuiltinOf( pt )
    case Tko.TY_ZSTRING, Tko.TY_WSTRING
        return true
    case Tko.TY_STRING, Tko.TY_USTRING
        return (isPtr = false)
    end select
    return false
end function

'' Is this the builtin STRING, const or not?
private function IsVarStrType_( byref c as Ctx, byval t as Tko.TypeId ) as boolean
    if t = Tko.TYPE_NONE then return false
    t = c.types->Unqualify( t )
    if c.types->Kind( t ) <> Tko.TK_BUILTIN then return false
    return (c.types->BuiltinOf( t ) = Tko.TY_STRING)
end function

'' A CONST STRING TO A NON-CONST BYVAL STRING, and a NON-CONST string to a CONST one:
'' fbc scores a same-type match whose CONST differs one tier down, below every full-tier
'' string conversion and above the half tier -- CONV_STR_CONST_COPY and the tiers around
'' it are in check.ti. Measured, a 'dim as const string' argument offered { byval string,
'' zstring ptr } takes zstring ptr, and offered { byval string, wstring ptr } takes string.

'' A '&' / '+' STRING CHAIN WITH A WIDE TERM IS A WSTRING, for choosing an overload -- the
'' wide counterpart of ConcatHasUString_, which ResolveCall_ asks straight after, so a
'' USTRING term still wins. Check types every '&' as STRING, because lowering decides the
'' width per term; measured, fbc types '"a" & wstr( 5 )' as WSTRING * 3, and
'' 'MCase( wchr( &hE9 ) & "cole" )' calls fb_WStrMCase. The STRING answer chose
'' fb_StrMCase instead, and the chain was narrowed to reach it: the e-acute became '?',
'' and the title-cased result came back with U+FFFD where fbc's has an E-acute. That was
'' the last assertion fbstr_transform failed.
private function ConcatHasWideStr_ _
    ( byref c as Ctx, byval id as Tko.NodeId ) as boolean

    if id = Tko.NODE_NONE then return false
    if c.ast->Kind( id ) = Tko.N_PAREN then
        dim as Tko.ListPayload ptr pp = _
            c.ast->ListOf( id )
        if pp->count <> 1 then return false
        return ConcatHasWideStr_( c, cast( Tko.NodeId, c.ast->children[pp->first] ) )
    end if
    dim as Tko.TypeId t = TypeOf_( c, id )
    if t = Tko.TYPE_NONE then return false
    dim as Tko.TypeId u = c.types->Unqualify( t )
    if c.types->Kind( u ) = Tko.TK_REFERENCE then u = c.types->Unqualify( c.types->Inner( u ) )
    '' 'wstring * N' is an ARRAY of the builtin.
    if c.types->Kind( u ) = Tko.TK_ARRAY then u = c.types->Unqualify( c.types->Inner( u ) )
    if c.types->Kind( u ) <> Tko.TK_BUILTIN then return false
    dim as Tko.BuiltinType bt = c.types->BuiltinOf( u )
    if bt = Tko.TY_WSTRING then return true
    if c.ast->Kind( id ) <> Tko.N_BINARY then return false
    if bt <> Tko.TY_STRING then return false
    dim as Tko.BinaryPayload ptr bp = _
        c.ast->BinaryOf( id )
    dim as Tko.TokenKind op = cast( Tko.TokenKind, bp->op )
    if (op <> Tko.TK_AMP) andalso (op <> Tko.TK_PLUS) then return false
    if ConcatHasWideStr_( c, bp->lhs ) then return true
    return ConcatHasWideStr_( c, bp->rhs )
end function

'' A CONST-ELEMENT ARRAY reaches only a const-element array parameter: offered 'a() as integer'
'' and 'a() as const integer', 'ca()' over 'dim ca( ... ) as const integer' takes the const one
'' whatever the other arguments say (overload/const.bas). tiko let it bind the non-const one.
private function ArrayConstMismatch_( byref c as Ctx, byval e as Tko.NodeId, byval pt as Tko.TypeId ) as boolean
    if (e = Tko.NODE_NONE) orelse (pt = Tko.TYPE_NONE) orelse (c.ast->Kind( e ) <> Tko.N_CALL) then return false
    dim as Tko.ListPayload ptr lp = c.ast->ListOf( e )
    if lp->target = Tko.NODE_NONE then return false
    '' THE CONST MAY SIT ON THE ARRAY OR ON ITS ELEMENT, either side.
    dim as Tko.TypeId at0 = c.info->TypeOf_( lp->target )
    dim as Tko.TypeId at = c.types->Unqualify( at0 )
    if c.types->Kind( at ) <> Tko.TK_ARRAY then return false
    if (c.types->IsConst( at0 ) = false) andalso (c.types->IsConst( c.types->Inner( at ) ) = false) then return false
    dim as Tko.TypeId pa0 = pt
    if c.types->Kind( c.types->Unqualify( pa0 ) ) = Tko.TK_REFERENCE then pa0 = c.types->Inner( c.types->Unqualify( pa0 ) )
    '' The parameter's type here is its ELEMENT's, an array of it or not.
    dim as Tko.TypeId pa = c.types->Unqualify( pa0 )
    if c.types->Kind( pa ) = Tko.TK_ARRAY then return (c.types->IsConst( pa0 ) = false) andalso (c.types->IsConst( c.types->Inner( pa ) ) = false)
    return (c.types->IsConst( pa0 ) = false)
end function
