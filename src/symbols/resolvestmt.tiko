'' resolvestmt.tiko -- checks one STATEMENT needs its scope for, made once per statement from
'' Resolve's WalkStmt, which has that scope in hand.
''
'' Included from resolveintr.tiko, inside Resolve's namespace, after resolvertl.tiko.

'' A 'defer' DIRECTLY AT MODULE LEVEL IS fbc's ERROR 348, "DEFER is not allowed at module
'' level" -- and directly in a NAMESPACE, which is module level too. Measured on
'' fbc-modern 1.20, 2026-09-25:
''
''     defer print "d" : print "a"               at module level        348
''     namespace N : defer print "d"             in a namespace          348
''     scope / if / for / do / while / select    a block at module level accepted
''     sub S( ) : defer print "d"                in a procedure          accepted
''
'' tiko accepted the first two. At module level it ran the deferred statement when the
'' program ended; in a namespace it never ran it at all. A block opens its own scope
'' (Collect), so the statement's scope says which case this is.
private sub DeferAtModule_ ( byref c as Ctx, byval id as Tko.NodeId, byval here as Tko.ScopeId )
    if c.ast->Kind( id ) <> Tko.N_DEFER then return
    dim as Tko.SymScope ptr ss = c.syms->ScopeAt( here )
    if ss = nullptr then return
    select case ss->kind
    case Tko.SCOPEK_GLOBAL, Tko.SCOPEK_MODULE, Tko.SCOPEK_NAMESPACE
        c.diags->Report( Tko.TKO0814, Tko.PointRange( c.ast->Loc( id ) ) )
    end select
end sub

'' A GENERIC MEMBER DEFINED OUT OF LINE REPEATS THE TYPE'S '( of ... )' LIST, and it must be
'' the SAME list -- fbc's error 341, "Type parameter list does not match the generic's
'' declaration". Measured on fbc-modern 1.20, 2026-09-25, over 'type Stack( of T )' and
'' 'type Pair( of K, V )':
''
''     sub Stack( of U ).Push( ... )        a renamed parameter                 341
''     sub Stack( of T, U ).Push( ... )     one too many                        341
''     sub Pair( of K ).SetK( ... )         one too few                         341
''     sub Pair( of V, K ).SetK( ... )      the same names, in another order    341
''     sub Stack( of t ).Push( ... )        the case differs, as names may      accepted
''
'' tiko accepted all four. The renamed one failed only if the generic was INSTANTIATED --
'' TKO0808, 'u' is not declared -- and the others never. The parser keeps the list in 'c'
'' and the owner in 'ownerName'; names intern folded, so comparing them is fbc's rule.
private sub GenericMemberList_ ( byref c as Ctx, byval id as Tko.NodeId, byval here as Tko.ScopeId )
    if c.ast->Kind( id ) <> Tko.N_PROC then return
    dim as Tko.StmtPayload ptr sp = StmtOf( c, id )
    if (sp->extra and Tko.PF_GENERIC_PROC) = 0 then return
    if (sp->ownerName = 0) orelse (sp->c = Tko.NODE_NONE) then return
    if c.ast->Kind( sp->c ) <> Tko.N_BLOCK then return
    dim as Tko.Symbol ptr gs = c.syms->SymbolAt( LookupDottedType_( c, here, sp->ownerName ) )
    if gs = nullptr then return
    if gs->kind <> cast( uint8, Tko.SYM_UDT ) then return
    if (gs->flags and Tko.SYMF_GENERIC_INST) <> 0 then return
    dim as Tko.NodeId gn = cast( Tko.NodeId, gs->payload )
    if gn = Tko.NODE_NONE then return
    if c.ast->Kind( gn ) <> Tko.N_TYPE then return
    dim as Tko.NodeId glist = StmtOf( c, gn )->b
    if glist = Tko.NODE_NONE then return                 '' not generic: a generic METHOD
    if c.ast->Kind( glist ) <> Tko.N_BLOCK then return
    dim as Tko.ListPayload ptr dl = ListOf( c, sp->c )
    dim as Tko.ListPayload ptr gl = ListOf( c, glist )
    dim as boolean same = (dl->count = gl->count)
    if same then
        for i as int32 = 0 to gl->count - 1
            if IdentNameOf( c, cast( Tko.NodeId, c.ast->children[dl->first + i] ) ) <> _
               IdentNameOf( c, cast( Tko.NodeId, c.ast->children[gl->first + i] ) ) then
                same = false
            end if
        next
    end if
    if same then return
    '' Once per SOURCE LOCATION: an instantiation re-parses the member into new nodes.
    dim as uint32 at = cast( uint32, c.ast->Loc( id ) )
    if c.genArgSeen.Contains( at ) then return
    c.genArgSeen.Put( at, 1 )
    dim as string want
    for i as int32 = 0 to gl->count - 1
        if i > 0 then want &= ", "
        want &= c.names->Spelling( IdentNameOf( c, cast( Tko.NodeId, c.ast->children[gl->first + i] ) ) )
    next
    c.diags->Report( Tko.TKO0817, Tko.PointRange( c.ast->Loc( id ) ), _
                     c.names->Spelling( gs->name ) & "." & c.names->Spelling( sp->name ), want )
end sub

#include once "symbols/resolvedefer.tiko"

'' A NAME THAT IS ONLY A LABEL -- 'on n goto s10', 'restore lbl'. A label is declared under
'' a key no written name reaches (DeclareLabel_, collectdecl.tiko), so that a variable of
'' the same name is never shadowed by it; a name that finds NOTHING else is looked for
'' under that key, which binds it exactly as it was bound before.
function LabelRef_ ( byref c as Ctx, byval scope_ as Tko.ScopeId, byval nm as Tko.InternId ) as Tko.SymbolId
    if nm = 0 then return Tko.SYMBOL_NONE
    return c.syms->Lookup( scope_, c.names->GetString( "$label:" & c.names->Spelling( c.names->Fold( nm ) ) ) )
end function

sub StatementChecks_ ( byref c as Ctx, byval id as Tko.NodeId, byval here as Tko.ScopeId )
    RtlNameClash_( c, id, here )
    DeferAtModule_( c, id, here )
    DeferCrossing_( c, id, here )
    GenericMemberList_( c, id, here )
end sub
