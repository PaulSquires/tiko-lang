'' redimrank.tiko -- see redimrank.ti.
''
'' Moved out of visibility.tiko, whose RecordFirstRedims_ walked the same items inline,
'' when overload resolution needed the answer too: check.tiko is its own compilation unit
'' and could not reach a private helper in another one.

#import "std/containers"
#include once "symbols/redimrank.ti"
#include once "lexer/token.ti"

namespace Tko.RedimRank

function ItemRank _
    ( byref ast as AstArena, byref syms as SymbolTable, byref types as TypeContext, _
      byref info as SemanticInfo, byval item as NodeId, byref sid as SymbolId, _
      byval scope_ as ScopeId = SCOPE_NONE ) as long

    sid = SYMBOL_NONE
    if ast.Kind( item ) <> N_VAR_ITEM then return 0
    dim as StmtPayload ptr ip = @ast.stmts[cast( long, ast.nodes[cast( long, item )].data )]
    dim as long written = 0
    if (ip->c <> NODE_NONE) andalso (ast.Kind( ip->c ) = N_BLOCK) then
        written = ast.lists[cast( long, ast.nodes[cast( long, ip->c )].data )].count
    end if
    if written <= 0 then return 0
    '' 'redim this.a( ... )' names its array through the member reference in 'b'.
    dim as NodeId tgt = item
    if (ip->b <> NODE_NONE) andalso (ip->extra = cast( ushort, KW_REDIM )) then tgt = ip->b
    dim as SymbolId found = info.RefOf( tgt )
    '' A DECLARING REDIM -- 'redim array( 0 to 0 ) as integer' over an existing array -- binds
    '' nothing on its item, so the first redim of dim/dynamic-wrong-dimensions-extern-redim-
    '' redim went unrecorded and the second, of another rank, was never judged (fbc's 36).
    if (found = SYMBOL_NONE) andalso (tgt = item) andalso (scope_ <> SCOPE_NONE) then
        found = syms.LookupTyped( scope_, ip->name, false )
    end if
    dim as Symbol ptr s = syms.SymbolAt( found )
    if s = 0 then return 0
    if s->type_ = TYPE_NONE then return 0
    dim as TypeId u = types.Unqualify( s->type_ )
    if types.IsDynArray( u ) = false then return 0
    if types.DynRank( u ) <> 0 then return 0
    sid = found
    return written
end function

function FirstRank _
    ( byref ast as AstArena, byref syms as SymbolTable, byref types as TypeContext, _
      byref info as SemanticInfo, byval target as SymbolId ) as long

    if target = SYMBOL_NONE then return 0
    for n as long = 0 to ast.Count( ) - 1
        if ast.Kind( cast( NodeId, n ) ) <> N_VAR then continue for
        dim as StmtPayload ptr sp = @ast.stmts[cast( long, ast.nodes[n].data )]
        if sp->op <> cast( ushort, KW_REDIM ) then continue for
        for i as long = 0 to sp->count - 1
            dim as SymbolId sid
            dim as long r = ItemRank( ast, syms, types, info, _
                                      cast( NodeId, ast.children[sp->first + i] ), sid, info.ScopeOf( cast( NodeId, n ) ) )
            if (r > 0) andalso (sid = target) then return r
        next
    next
    return 0
end function

end namespace
