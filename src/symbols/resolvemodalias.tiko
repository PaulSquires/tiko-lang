'' resolvemodalias.tiko -- a module's type aliases, resolved ahead of everything else; and
'' an imported module's overloads of a header's names, settled after it.
''
'' Split out of resolve.tiko at the 1500-line cap and included from it, inside namespace
'' Tko.Resolve, just ahead of Run, its one caller.

'' A MODULE'S TYPE ALIASES, BEFORE THE WALK (ADR 0017; RFC-0003 §5). A module's
'' declarations have no order, so 'as Widget ptr' in one file may name 'type Widget as
'' Widget_' in a file that sorts after it. Met where the walk reaches it, the alias still
'' held Collect's placeholder when the field was typed, and a method call through the field
'' bound nothing and lowered to nothing -- fbx/scripting's 'm_pDictionary->Release', whose
'' IDictionary is declared in fbxScrRun.tiko, after CDicObj.tiko (2026-09-29). An IMPORTER
'' too: the interface is the module's text in the module's order, so 'declare function F(
'' byval p as Er ptr )' reached it above 'type Er as Er_', and the call it made was to
'' F(void*), which nothing defines. Classic code cannot meet it: fbc's order puts the alias
'' first. Repeated while an alias of an alias resolves; the walk resolves each one again.
''
'' RUN BEFORE DISCOVERY AS WELL AS AFTER IT. Discovery walks the files in order, and what it
'' resolves over a placeholder stays on the node: 'type T2 as Array( of T1 )' with T1 in a
'' later file, and 'function Make( ) as T2' beside it, came out over T1's placeholder -- a
'' second instance, which a pass after discovery corrected for the alias alone, so 'return x'
'' was TKO0738 (tests/modules/alias-instance-later-file). After discovery it runs again for
'' what discovery's instantiations settle.
private sub ModuleTypedefsFirst_( byref c as Ctx )
    for r as int32 = 1 to 8
        dim as boolean progress = false
        for n as int32 = 1 to c.ast->Count( )
            dim as Tko.NodeId id = cast( Tko.NodeId, n )
            if c.ast->Kind( id ) <> Tko.N_TYPEDEF then continue for
            dim as Tko.StmtPayload ptr tsp = StmtOf( c, id )
            if tsp->name = 0 then continue for
            dim as Tko.ScopeId here = c.info->ScopeOf( id )
            dim as Tko.SymbolId tsid = c.syms->LookupLocalTyped( here, tsp->name, true )
            dim as Tko.Symbol ptr ts = c.syms->SymbolAt( tsid )
            if ts = nullptr then continue for
            if ts->kind <> cast( uint8, Tko.SYM_TYPEDEF ) then continue for
            if Tko.ModSym.OrderFree( *c.syms, tsid ) = false then continue for
            dim as Tko.TypeId aliased = ResolveTypeRef( c, tsp->a, here )
            if (aliased = Tko.TYPE_NONE) orelse (aliased = ts->type_) then continue for
            if c.types->Kind( aliased ) = Tko.TK_TYPEDEF then continue for
            ts->type_ = aliased
            progress = true
        next
        if progress = false then exit for
    next
end sub

'' The written parameter types of procedure symbol sid, or false when one is not known.
private function ParamTypes_ _
    ( byref c as Ctx, byval sid as Tko.SymbolId, byref outv as containers.Array( of uint32 ) ) as boolean
    outv.Clear( )
    dim as Tko.Symbol ptr s = c.syms->SymbolAt( sid )
    if s = nullptr then return false
    dim as Tko.NodeId pn = cast( Tko.NodeId, s->payload )
    if (pn = Tko.NODE_NONE) orelse (c.ast->Kind( pn ) <> Tko.N_PROC) then return false
    dim as Tko.StmtPayload ptr pp = StmtOf( c, pn )
    for i as int32 = 0 to pp->count - 1
        dim as Tko.NodeId prm = cast( Tko.NodeId, c.ast->children[pp->first + i] )
        if c.ast->Kind( prm ) <> Tko.N_PARAM then continue for
        dim as Tko.StmtPayload ptr ps = StmtOf( c, prm )
        if ps->op = cast( uint16, Tko.TK_ELLIPSIS ) then return false
        dim as Tko.TypeId t = c.info->TypeOf_( ps->a )
        if t = Tko.TYPE_NONE then return false
        outv.Push( cast( uint32, t ) )
    next
    return true
end function

'' AN IMPORTED MODULE'S OVERLOAD OF A HEADER'S NAME (RFC-0001 F4), AFTER THE WALK: each twin
'' JoinTwin made takes the result type the walk gave its original, which is the symbol
'' its declaration's node names. And one the set cannot tell apart from a member declared
'' before it -- the same parameter types, written or reached -- is TKO0677, as it would be
'' in one source file: a bare call could choose neither.
private sub JoinTwinsAfter_( byref c as Ctx )
    dim as Tko.ScopeId ms = Tko.ModSym.ModuleScope( *c.syms )
    for q as int32 = 0 to c.syms->joinCopy.Count - 1
        dim as Tko.SymbolId tw = cast( Tko.SymbolId, c.syms->joinCopy[q] )
        dim as Tko.Symbol ptr ts = c.syms->SymbolAt( tw )
        dim as Tko.Symbol ptr os = c.syms->SymbolAt( cast( Tko.SymbolId, c.syms->joinOrig[q] ) )
        if (ts = nullptr) orelse (os = nullptr) then continue for
        if ts->type_ = Tko.TYPE_NONE then ts->type_ = os->type_
        dim as containers.Array( of uint32 ) mine, theirs
        if ParamTypes_( c, tw, mine ) = false then continue for
        dim as Tko.SymbolId cur = c.syms->LookupLocal( ms, ts->name )
        dim as Tko.Symbol ptr hs = c.syms->SymbolAt( cur )
        if hs = nullptr then continue for
        if hs->kind <> cast( uint8, Tko.SYM_PROC ) then cur = hs->altClass
        dim as int32 guard = 0
        while (cur <> Tko.SYMBOL_NONE) andalso (cur <> tw) andalso (guard < 100000)
            guard += 1
            dim as Tko.Symbol ptr xs = c.syms->SymbolAt( cur )
            if xs = nullptr then exit while
            if xs->kind <> cast( uint8, Tko.SYM_PROC ) then exit while
            dim as boolean same = (xs->diedAt = 0) andalso (xs->payload <> ts->payload)
            if same then same = ParamTypes_( c, cur, theirs )
            if same then same = (theirs.Count = mine.Count)
            if same then
                for k as int32 = 0 to mine.Count - 1
                    if theirs[k] <> mine[k] then same = false
                next
            end if
            if same then
                c.diags->Report( Tko.TKO0677, Tko.PointRange( ts->loc ), c.names->Spelling( ts->name ) )
                c.diags->AddNote( Tko.TKO0901, Tko.PointRange( xs->loc ) )
                exit while
            end if
            cur = xs->nextOverload
        wend
    next
end sub

'' A MODULE'S OWN OVERLOAD OF A HEADER'S NAME (RFC-0001 F4), AFTER THE WALK: 'public
'' function GetDesktopWindow overload( ) as HWND' has windows.bi's parameters exactly, so no
'' call could choose between them. Collect no longer takes it for the header's body
'' (UndefinedProcWithArity), which made it a definition of user32's procedure with nothing
'' to say so; it is TKO0677 here, where the parameter types are known.
private sub ModuleJoinsAfter_( byref c as Ctx )
    dim as Tko.ScopeId ms = Tko.ModSym.ModuleScope( *c.syms )
    if ms = Tko.SCOPE_NONE then return
    dim as int32 total = c.syms->Count( )
    for si as int32 = 1 to total
        dim as Tko.SymbolId sid = cast( Tko.SymbolId, si )
        dim as Tko.Symbol ptr s = c.syms->SymbolAt( sid )
        if s = nullptr then continue for
        if s->kind <> cast( uint8, Tko.SYM_PROC ) then continue for
        if (s->parent <> ms) orelse (s->diedAt <> 0) then continue for
        if (s->flags and Tko.SYMF_MODSRC) = 0 then continue for
        dim as Tko.NodeId pn = cast( Tko.NodeId, s->payload )
        if (pn = Tko.NODE_NONE) orelse (c.ast->Kind( pn ) <> Tko.N_PROC) then continue for
        if (StmtOf( c, pn )->extra and Tko.PF_OVERLOAD) = 0 then continue for
        dim as containers.Array( of uint32 ) mine, theirs
        if ParamTypes_( c, sid, mine ) = false then continue for
        dim as Tko.SymbolId cur = c.syms->LookupLocal( ms, s->name )
        dim as Tko.Symbol ptr hs = c.syms->SymbolAt( cur )
        if hs = nullptr then continue for
        if hs->kind <> cast( uint8, Tko.SYM_PROC ) then cur = hs->altClass
        dim as int32 guard = 0
        while (cur <> Tko.SYMBOL_NONE) andalso (guard < 100000)
            guard += 1
            dim as Tko.Symbol ptr xs = c.syms->SymbolAt( cur )
            if xs = nullptr then exit while
            if xs->kind <> cast( uint8, Tko.SYM_PROC ) then exit while
            '' A header's: not the module's, not an import's twin (JoinTwinsAfter_ has
            '' those), not the prelude's.
            dim as boolean same = (xs->diedAt = 0) andalso _
                ((xs->flags and (Tko.SYMF_MODSRC or Tko.SYMF_IMPORTED)) = 0)
            if same then same = (c.srcMgr->IsBuiltin( xs->loc ) = false)
            if same then same = ParamTypes_( c, cur, theirs )
            if same then same = (theirs.Count = mine.Count)
            if same then
                for k as int32 = 0 to mine.Count - 1
                    if theirs[k] <> mine[k] then same = false
                next
            end if
            if same then
                c.diags->Report( Tko.TKO0677, Tko.PointRange( s->loc ), c.names->Spelling( s->name ) )
                c.diags->AddNote( Tko.TKO0901, Tko.PointRange( xs->loc ) )
                exit while
            end if
            cur = xs->nextOverload
        wend
    next
end sub
