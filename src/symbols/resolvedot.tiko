'' resolvedot.tiko -- A DOTTED TYPE NAME, resolved through its qualifiers.
''
'' Split out of resolve.tiko at the 1500-line cap and included from it in the same place.
'' Nothing in it changed in the move.

'' A possibly-dotted NAMESPACE path -- 'a', 'a.b', 'a.b.c' -- resolved to its symbol.
''
'' The same walk LookupDottedType_ does, and separate from it for one reason: a
'' NAMESPACE is not a type name, so the LookupLocalTyped that walk uses for every
'' component after the first would not find one.
private function LookupDottedNamespace_ _
    ( byref c as Ctx, byval scope_ as Tko.ScopeId, _
      byval path as Tko.InternId ) as Tko.SymbolId

    dim as string qpath = c.names->Spelling( path )
    dim as Tko.ScopeId sc = scope_
    dim as boolean first_ = true
    dim as int32 at = 0
    '' A LEADING '..' IS THE GLOBAL ROOT. 'using ..outer1' inside a namespace names
    '' the outer1 at file scope, not one relative to here -- fbc accepts it and
    '' prints 7 for the probe. Split on '.', the prefix yields an EMPTY first
    '' component, which this refused outright, so the using was never recorded and
    '' every name it was meant to import went unresolved.
    if left( qpath, 2 ) = ".." then
        at = 2
        '' The MODULE scope, which is where a file-scope namespace is declared:
        '' SCOPE_GLOBAL above it holds the builtins and nothing a program writes.
        dim as Tko.ScopeId root = scope_
        dim as int32 rg = 0
        while (root <> Tko.SCOPE_NONE) andalso (rg < 1024)
            rg += 1
            dim as Tko.SymScope ptr rs = c.syms->ScopeAt( root )
            if rs = nullptr then exit while
            if rs->parent = Tko.SCOPE_GLOBAL then exit while
            if rs->parent = Tko.SCOPE_NONE then exit while
            root = rs->parent
        wend
        sc = root
    end if
    dim as Tko.SymbolId found = Tko.SYMBOL_NONE
    dim as int32 guard = 0

    while (at <= len( qpath )) andalso (guard < 64)
        guard += 1
        dim as int32 dot = instr( at + 1, qpath, "." )
        dim as int32 stop_ = dot
        if stop_ = 0 then stop_ = len( qpath ) + 1
        dim as string comp = mid( qpath, at + 1, stop_ - at - 1 )
        if len( comp ) = 0 then return Tko.SYMBOL_NONE
        dim as Tko.InternId cid = c.names->GetString( comp )

        dim as Tko.SymbolId sid
        if first_ then
            sid = c.syms->Lookup( sc, cid )
        else
            sid = c.syms->LookupLocal( sc, cid )
        end if
        dim as Tko.Symbol ptr sym = c.syms->SymbolAt( sid )
        if sym = nullptr then return Tko.SYMBOL_NONE
        found = sid
        first_ = false

        if dot = 0 then exit while
        if sym->kind <> cast( uint8, Tko.SYM_NAMESPACE ) then return Tko.SYMBOL_NONE
        if sym->inner = Tko.SCOPE_NONE then return Tko.SYMBOL_NONE
        sc = cast( Tko.ScopeId, sym->inner )
        at = dot
    wend
    return found
end function

'' The inner scope of what a UDT extends, or SCOPE_NONE. The fact lives in the symbol
'' table as a FIELD named 'base', which is where InheritedMember_ reads it too --
'' TypeContext's own baseType is filled by Check and this runs in Resolve.
private function BaseScopeOf_ _
    ( byref c as Ctx, byval sc as Tko.ScopeId ) as Tko.ScopeId

    dim as Tko.SymbolId bf = _
        c.syms->LookupLocal( sc, c.names->Fold( c.names->GetString( "base" ) ) )
    if bf = Tko.SYMBOL_NONE then return Tko.SCOPE_NONE
    dim as Tko.Symbol ptr b = c.syms->SymbolAt( bf )
    if b = nullptr then return Tko.SCOPE_NONE
    if b->type_ = Tko.TYPE_NONE then return Tko.SCOPE_NONE
    dim as Tko.TypeId bt = c.types->Unqualify( b->type_ )
    if c.types->Kind( bt ) <> Tko.TK_UDT then return Tko.SCOPE_NONE
    dim as Tko.InternId tn = c.types->NameOf( bt )
    if tn = 0 then return Tko.SCOPE_NONE
    dim as Tko.ScopeId ds = cast( Tko.ScopeId, c.types->DeclScopeOf( bt ) )
    dim as Tko.SymbolId us = c.syms->LookupLocalTyped( ds, tn, true )
    if us = Tko.SYMBOL_NONE then us = c.syms->LookupTyped( ds, tn, true )
    dim as Tko.Symbol ptr usy = c.syms->SymbolAt( us )
    if usy = nullptr then return Tko.SCOPE_NONE
    return cast( Tko.ScopeId, usy->inner )
end function
'' A possibly-dotted name -- 'UDT', 'ns.UDT', 'a.b.UDT' -- resolved to its symbol.
''
'' Only the FIRST component is visible from the starting scope; each later one is looked
'' up INSIDE what the previous opened. Shared by qualified type references and by
'' BindThis, which needs the same walk for a structor defined outside its namespace.
private function LookupDottedType_ _
    ( byref c as Ctx, byval scope_ as Tko.ScopeId, _
      byval path as Tko.InternId ) as Tko.SymbolId

    dim as string qpath = c.names->Spelling( path )
    dim as Tko.ScopeId sc = scope_
    dim as boolean first_ = true
    dim as int32 at = 0
    dim as Tko.SymbolId found = Tko.SYMBOL_NONE

    while at <= len( qpath )
        dim as int32 dot = instr( at + 1, qpath, "." )
        dim as int32 stop_ = dot
        if stop_ = 0 then stop_ = len( qpath ) + 1
        dim as string comp = mid( qpath, at + 1, stop_ - at - 1 )
        if len( comp ) = 0 then return Tko.SYMBOL_NONE
        dim as Tko.InternId cid = c.names->GetString( comp )

        dim as Tko.SymbolId sid
        if first_ then
            sid = c.syms->Lookup( sc, cid )
        else
            sid = c.syms->LookupLocalTyped( sc, cid, true )
            '' ...AND THEN IN WHAT THAT TYPE EXTENDS. A STATIC member is called through
            '' a type NAME, and it may be the DERIVED one: fbc compiles 'Child.foo( )'
            '' over a foo declared on Parent and emits '_ZN6PARENT3FOOEv(  );' for it,
            '' the same call it emits for 'Parent.foo( )' on the line above. Searching
            '' only the type's own scope missed it, the walk fell back to resolving
            '' 'Child' itself, and that is a SYM_UDT -- "'child' is a type, not a
            '' procedure".
            dim as Tko.ScopeId bsc = sc
            dim as int32 bdepth = 0
            do while (sid = Tko.SYMBOL_NONE) andalso (bdepth < 32)
                bsc = BaseScopeOf_( c, bsc )
                if bsc = Tko.SCOPE_NONE then exit do
                sid = c.syms->LookupLocalTyped( bsc, cid, true )
                bdepth += 1
            loop
        end if
        dim as Tko.Symbol ptr sym = c.syms->SymbolAt( sid )
        if sym = nullptr then return Tko.SYMBOL_NONE
        found = sid
        first_ = false

        if dot = 0 then exit while
        '' Only a NAMESPACE or a UDT opens a scope to descend into.
        dim as boolean opens = _
            (sym->kind = cast( uint8, Tko.SYM_NAMESPACE )) orelse _
            (sym->kind = cast( uint8, Tko.SYM_UDT ))
        if (opens = false) orelse (sym->inner = Tko.SCOPE_NONE) then
            return Tko.SYMBOL_NONE
        end if
        sc = sym->inner
        at = dot
    wend
    return found
end function

'' 'dim UDT.i as integer' -- the DEFINITION of a static member variable. MEASURED with
'' fbc: it is error 147 unless the type DECLARED 'static i as ...'. Both ways of getting
'' it wrong are refused -- no such member at all (member-var-bad-3-*), and a member that
'' is an ordinary FIELD rather than a static one (member-var-bad-4-*) -- and the good
'' spelling beside them compiles, so the STATIC is what is being demanded, not the name.
''
'' Declines rather than reports whenever the owner does not resolve to a UDT: a qualifier
'' naming a namespace, a generic, or something not collected yet is somebody else's
'' diagnostic, and guessing here would refuse a file fbc accepts.
private sub CheckStaticMemberVar_ _
    ( byref c as Ctx, byval scope_ as Tko.ScopeId, byval item as Tko.NodeId, _
      byval ownerName as Tko.InternId, byval memberName as Tko.InternId )

    if (ownerName = 0) orelse (memberName = 0) then return
    dim as Tko.SymbolId osid = LookupDottedType_( c, scope_, ownerName )
    dim as Tko.Symbol ptr osym = c.syms->SymbolAt( osid )
    if osym = nullptr then return
    if osym->kind <> cast( uint8, Tko.SYM_UDT ) then return
    if osym->inner = Tko.SCOPE_NONE then return

    '' THE BASES TOO. A static declared on the parent is reachable through the child's
    '' name -- the same walk LookupDottedType_ makes for a static CALL.
    dim as Tko.ScopeId sc = osym->inner
    dim as Tko.SymbolId msid = c.syms->LookupLocalTyped( sc, memberName, true )
    dim as int32 bdepth = 0
    do while (msid = Tko.SYMBOL_NONE) andalso (bdepth < 32)
        sc = BaseScopeOf_( c, sc )
        if sc = Tko.SCOPE_NONE then exit do
        msid = c.syms->LookupLocalTyped( sc, memberName, true )
        bdepth += 1
    loop

    dim as Tko.Symbol ptr msym = c.syms->SymbolAt( msid )
    if msym <> nullptr then
        if (msym->flags and Tko.SYMF_STATIC) <> 0 then return
    end if
    c.diags->Report( Tko.TKO0661, Tko.PointRange( c.ast->Loc( item ) ), _
                     c.names->Spelling( ownerName ) & "." & _
                     c.names->Spelling( memberName ) )
end sub

'' A FIELD NAMED LIKE A NAMESPACE, as the base of 'enc.KindName( Enc )' inside a method of a type
'' with a field 'Enc', or of 'enc.Kind.B' in that field's initializer (tkEdit TK-001). Names fold
'' case, so the base bound to the field; nothing was said, and lowering stopped on TKO0994. Looked
'' past -- the base rebound to the namespace of that name outside the type -- where fbc reads the
'' namespace: from the type's own scope (a field's initializer, as ResolveTypeRefAt_ does for a
'' qualified type, 306951f52). In a METHOD BODY fbc reads the field (error 3, fbc-modern 1.20,
'' 2026-10-26) and so does this, leaving TKO0835 to refuse it -- EXCEPT through an '#import' alias,
'' which fbc has no form of: a module is looked past there too, as a method named like one is
'' (TS-005). Never when the field is a UDT (its own members win) or the namespace lacks the member.
private sub LookPastField_ _
    ( byref c as Ctx, byval mlhs as Tko.NodeId, byval mrhs as Tko.NodeId, byval scope_ as Tko.ScopeId )

    if c.ast->Kind( mlhs ) <> Tko.N_IDENT then return
    if c.ast->Kind( mrhs ) <> Tko.N_IDENT then return
    dim as Tko.Symbol ptr fs_ = c.syms->SymbolAt( c.info->RefOf( mlhs ) )
    if fs_ = nullptr then return
    if fs_->kind <> cast( uint8, Tko.SYM_FIELD ) then return
    if fs_->type_ <> Tko.TYPE_NONE then
        if c.types->Kind( c.types->Unqualify( fs_->type_ ) ) = Tko.TK_UDT then return
    end if
    dim as Tko.SymScope ptr usc = c.syms->ScopeAt( fs_->parent )
    if usc = nullptr then return
    dim as Tko.SymbolId nsid = c.syms->Lookup( usc->parent, IdentNameOf( c, mlhs ) )
    dim as Tko.Symbol ptr ns_ = c.syms->SymbolAt( nsid )
    if ns_ = nullptr then return
    if ns_->kind <> cast( uint8, Tko.SYM_NAMESPACE ) then return
    if (fs_->parent <> scope_) andalso (ModuleView_( c, nsid ) = false) then return
    c.syms->privileged = c.syms->IsImportNs( nsid )
    dim as Tko.SymbolId msid = c.syms->LookupInNamespace( ns_->inner, IdentNameOf( c, mrhs ) )
    c.syms->privileged = false
    if msid <> Tko.SYMBOL_NONE then c.info->SetRef( mlhs, nsid )
end sub
