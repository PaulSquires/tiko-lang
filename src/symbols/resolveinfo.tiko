'' resolveinfo.tiko -- SemanticInfo, the per-node side tables. Moved out of resolve.tiko at
'' the 1500-line cap, included from it in the same place, inside namespace Tko; nothing
'' about the code changed in the move.

'' -------------------------------------------------------------- side tables

sub SemanticInfo.Resize( byval nodeCount as int32 )
    dim as int32 want = nodeCount + 1
    while this.refSymbol.Count < want
        this.refSymbol.Push( 0 )
        this.nodeType.Push( 0 )
        this.nodeScope.Push( 0 )
        this.ambiguous.Push( 0 )
        this.instFrame.Push( 0 )
        this.decision.Push( 0 )
    wend
end sub

sub SemanticInfo.SetRef( byval n as NodeId, byval s as SymbolId )
    if cast( int32, n ) < this.refSymbol.Count then
        if this.refSymbol[cast( int32, n )] <> cast( uint32, s ) then this.version += 1
    end if
    if cast( int32, n ) < this.refSymbol.Count then
        this.refSymbol[cast( int32, n )] = cast( uint32, s )
    end if
end sub

function SemanticInfo.RefOf( byval n as NodeId ) as SymbolId
    if cast( int32, n ) >= this.refSymbol.Count then return SYMBOL_NONE
    return cast( SymbolId, this.refSymbol[cast( int32, n )] )
end function

sub SemanticInfo.SetType( byval n as NodeId, byval t as TypeId )
    if cast( int32, n ) < this.nodeType.Count then
        if this.nodeType[cast( int32, n )] <> cast( uint32, t ) then this.version += 1
        this.nodeType[cast( int32, n )] = cast( uint32, t )
    end if
end sub

function SemanticInfo.TypeOf_( byval n as NodeId ) as TypeId
    if cast( int32, n ) >= this.nodeType.Count then return TYPE_NONE
    return cast( TypeId, this.nodeType[cast( int32, n )] )
end function

sub SemanticInfo.SetScope( byval n as NodeId, byval s as ScopeId )
    if cast( int32, n ) < this.nodeScope.Count then
        this.nodeScope[cast( int32, n )] = cast( uint32, s )
    end if
end sub

function SemanticInfo.ScopeOf( byval n as NodeId ) as ScopeId
    if cast( int32, n ) >= this.nodeScope.Count then return SCOPE_NONE
    return cast( ScopeId, this.nodeScope[cast( int32, n )] )
end function

sub SemanticInfo.SetAmbiguous( byval n as NodeId, byval a as AmbiguousResolution )
    if cast( int32, n ) < this.ambiguous.Count then
        this.ambiguous[cast( int32, n )] = cast( uint8, a )
    end if
end sub

function SemanticInfo.AmbiguousOf( byval n as NodeId ) as AmbiguousResolution
    if cast( int32, n ) >= this.ambiguous.Count then return AMB_UNRESOLVED
    return cast( AmbiguousResolution, this.ambiguous[cast( int32, n )] )
end function

sub SemanticInfo.SetInstFrame( byval n as NodeId, byval f as int32 )
    if cast( int32, n ) < this.instFrame.Count then
        this.instFrame[cast( int32, n )] = cast( uint32, f )
    end if
end sub

function SemanticInfo.InstFrameOf( byval n as NodeId ) as int32
    if cast( int32, n ) >= this.instFrame.Count then return 0
    return cast( int32, this.instFrame[cast( int32, n )] )
end function

sub SemanticInfo.SetDecision( byval n as NodeId, byval s as SymbolId )
    if cast( int32, n ) < this.decision.Count then
        if this.decision[cast( int32, n )] <> cast( uint32, s ) then this.version += 1
        this.decision[cast( int32, n )] = cast( uint32, s )
    end if
end sub

function SemanticInfo.DecisionOf( byval n as NodeId ) as SymbolId
    if cast( int32, n ) >= this.decision.Count then return SYMBOL_NONE
    return cast( SymbolId, this.decision[cast( int32, n )] )
end function
