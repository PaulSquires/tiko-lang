'' checkwalk.tiko -- the linear pass that types every expression node.
''
'' Split out of check.tiko at the 1500-line lint cap and INCLUDED into it, inside the
'' same namespace, exactly as checkinfer.tiko and checkeach.tiko are. Nothing moved
'' changed in the move.

'' 'q += w' OVER A UDT WITH NO 'operator +=' IS 'q = q + w' -- the BINARY operator, bound
'' here on the statement node, which nothing else binds, for LowerCompoundUserOp_
'' (mir/lowerswap.tiko). Measured on fbc-modern 1.20, 2026-09-25: with only a global
'' 'operator +( Q, Q ) as Q', 'q1 += q2' calls it and assigns the result; so do
'' 'q1 += 5' over '+( Q, long ) as Q', 'k += q1' over '+( long, Q ) as long' and 'q1 &= q2'.
'' tiko dropped the first, second and fourth in silence and died in emission on the third.
'' A member self-operator is lowering's first choice (SelfOpMemberCall_), so a type
'' declaring one of the name is left to it; and the result has to go back into the target
'' as lowering stores it -- a UDT target takes its own type, a scalar one a scalar.
private function CompoundBinOp_( byval op as Tko.TokenKind, byref selfNm as string ) as Tko.TokenKind
    select case op
    case Tko.TK_PLUSEQ   : selfNm = "+=" : return Tko.TK_PLUS
    case Tko.TK_MINUSEQ  : selfNm = "-=" : return Tko.TK_MINUS
    case Tko.TK_STAREQ   : selfNm = "*=" : return Tko.TK_STAR
    case Tko.TK_SLASHEQ  : selfNm = "/=" : return Tko.TK_SLASH
    case Tko.TK_BSLASHEQ : selfNm = "\=" : return Tko.TK_BACKSLASH
    case Tko.TK_CARETEQ  : selfNm = "^=" : return Tko.TK_CARET
    case Tko.TK_AMPEQ    : selfNm = "&=" : return Tko.TK_AMP
    case Tko.KW_AND, Tko.KW_OR, Tko.KW_XOR, Tko.KW_IMP, Tko.KW_EQV, _
         Tko.KW_MOD, Tko.KW_SHL, Tko.KW_SHR
        selfNm = lcase( Tko.TokenKindText( op ) ) & "="
        return op
    end select
    return Tko.TK_EOF
end function

private sub CompoundUserOp_( byref c as Ctx, byval n as Tko.NodeId )
    dim as Tko.StmtPayload ptr sp = c.ast->StmtOf( n )
    if (sp->a = Tko.NODE_NONE) orelse (sp->b = Tko.NODE_NONE) then return
    dim as string selfNm = ""
    dim as Tko.TokenKind bop = CompoundBinOp_( cast( Tko.TokenKind, sp->op ), selfNm )
    if bop = Tko.TK_EOF then return
    dim as Tko.TypeId lt = c.types->Unqualify( c.info->TypeOf_( sp->a ) )
    dim as Tko.TypeId rt = c.types->Unqualify( c.info->TypeOf_( sp->b ) )
    if (lt = Tko.TYPE_NONE) orelse (rt = Tko.TYPE_NONE) then return
    if c.types->Kind( lt ) = Tko.TK_REFERENCE then lt = c.types->Unqualify( c.types->Inner( lt ) )
    if c.types->Kind( rt ) = Tko.TK_REFERENCE then rt = c.types->Unqualify( c.types->Inner( rt ) )
    if (c.types->Kind( lt ) = Tko.TK_TUPLE) orelse (c.types->Kind( rt ) = Tko.TK_TUPLE) then return
    dim as boolean lUdt = IsUdtOperand_( c, lt )
    if (lUdt orelse IsUdtOperand_( c, rt )) = false then return
    if lUdt then
        if UdtOperatorNamed_( c, lt, selfNm ) <> Tko.SYMBOL_NONE then return
    end if
    dim as int32 uopSeen
    dim as Tko.SymbolId uop = UserBinaryOp_( c, bop, lt, rt, uopSeen )
    dim as Tko.Symbol ptr us = c.syms->SymbolAt( uop )
    if us = nullptr then return
    dim as Tko.TypeId ot = c.types->Unqualify( us->type_ )
    if ot = Tko.TYPE_NONE then return
    if lUdt then
        if ot <> lt then return
    elseif IsUdtOperand_( c, ot ) then
        return
    end if
    c.info->SetRef( n, uop )
end sub

private sub WalkAll( byref c as Ctx )
    '' Every expression node in the arena, in id order. Expressions are created
    '' bottom-up by the parser, so a child always has a LOWER id than its parent and
    '' one linear pass types the whole tree without recursion into statements.
    '' ...INSIDE THE FRAME of the instantiation a re-parsed body belongs to (instframe.tiko).
    dim as int32 inFrame = 0
    for i as int32 = 1 to c.ast->Count( )
        if c.diags->Stopped( ) then exit for      '' past the error cap
        dim as Tko.NodeId n = cast( Tko.NodeId, i )
        dim as int32 nf = c.info->InstFrameOf( n )
        if nf <> inFrame then
            if inFrame > 0 then c.diags->LeaveInst( inFrame )
            if nf > 0 then c.diags->EnterInst( nf )
            inFrame = nf
        end if
        c.syms->usePos = cast( uint32, i )    '' which side of an '#undef': see UndefSym
        select case c.ast->Kind( n )
        case Tko.N_INT_LIT, Tko.N_FLOAT_LIT, Tko.N_STRING_LIT, Tko.N_STRCAT, _
             Tko.N_IDENT, Tko.N_PAREN, Tko.N_UNARY, Tko.N_BINARY, _
             Tko.N_DEREF, Tko.N_ADDROF, Tko.N_CALL, Tko.N_MEMBER, _
             Tko.N_INDEX, Tko.N_NEW, Tko.N_TUPLE
            '' N_INDEX was missing from this list, so 'p[i]' was never typed however
            '' well the case for it was written -- the cache is what lowering reads,
            '' and nothing ever filled it. A missing case here is invisible: the type
            '' function has the answer and no one asks it.
            ''
            TypeOf_( c, n )

        case Tko.N_INTRINSIC
            '' AN INTRINSIC THAT CAN BE AN EXPRESSION, and only those. The case in
            '' TypeOf_ has had an answer for 'input( n )' since it was written, and
            '' nothing ever asked: 'dim as string s = input( 3 )' is typed by its
            '' DESTINATION and lowered, while 'print input( 3 )' declined, because
            '' PRINT classifies an item by its type and the cache was empty. Every
            '' intrinsic in expression position was in that state.
            ''
            '' NAMED RATHER THAN ASKING ABOUT EVERY N_INTRINSIC, because most of them
            '' are STATEMENTS: PRINT has no type and never will, and asking would
            '' count eighteen of them as 'untyped' in a file that has none.
            dim as Tko.StmtPayload ptr wsp = _
                c.ast->StmtOf( n )
            select case cast( Tko.TokenKind, wsp->op )
            case Tko.KW_CLOSE, Tko.KW_OPEN, Tko.KW_GET, Tko.KW_PUT, _
                 Tko.KW_INPUT, Tko.KW_WINPUT, Tko.KW_THREADCALL
                TypeOf_( c, n )
            end select

        case Tko.N_AMBIGUOUS
            '' A CALL WRITTEN AS A STATEMENT IS NOT AN N_CALL NODE. 'W 1, 2' is this
            '' statement's own callee and children, so nothing here ever costed its
            '' arguments -- and lowering then used whatever Resolve had bound, which is
            '' the HEAD of the overload chain. Every overloaded statement call went to
            '' the first candidate: 'screeninfo w, h' over INTEGERs called the 32-bit
            '' entry point with int64 pointers.
            ''
            '' The chosen symbol is recorded on the CALLEE IDENT, which is where
            '' LowerStmtCall reads it from.
            if c.info->AmbiguousOf( n ) = Tko.AMB_CALL then
                dim as Tko.StmtPayload ptr asp = _
                    c.ast->StmtOf( n )
                '' AN N_MEMBER CALLEE IS THE SAME STATEMENT. 'f.bar 1' over an
                '' overloaded member costed nothing either, and its binding lives on the
                '' MEMBER node -- which is where LowerStmtCall reads it from, so
                '' re-costing it through the same node is all this needs. Without it
                ''
                ''     declare sub bar
                ''     declare function bar( byval i as integer ) as integer
                ''
                '' sent 'f.bar 1' to the SUB, so the call passed a receiver and an
                '' argument to something declaring only a receiver: the verifier's
                '' 'calls FOO.BAR with 2 arguments, which declares 1'.
                dim as boolean calleeIsName = false
                if asp->a <> Tko.NODE_NONE then
                    select case c.ast->Kind( asp->a )
                    case Tko.N_IDENT, Tko.N_MEMBER
                        calleeIsName = true
                    end select
                end if
                if asp->a <> Tko.NODE_NONE then
                    if calleeIsName then
                        dim as Tko.SymbolId ac = c.info->RefOf( asp->a )
                        dim as Tko.Symbol ptr acs = c.syms->SymbolAt( ac )
                        if acs <> nullptr then
                            '' Only when there is a choice to make: a single candidate
                            '' is already bound, and re-costing it could only take a
                            '' binding away.
                            if (acs->kind = cast( uint8, Tko.SYM_PROC )) andalso _
                               (acs->nextOverload <> Tko.SYMBOL_NONE) then
                                ResolveCall_( c, asp->a, ac, asp->first, asp->count )
                            end if
                        end if
                    end if
                end if
            elseif c.info->AmbiguousOf( n ) = Tko.AMB_ASSIGN then
                CompoundUserOp_( c, n )
            end if
        end select
    next
    if inFrame > 0 then c.diags->LeaveInst( inFrame )
    DecideProcAddrs_( c )   '' checkdecide.tiko: '@f' by its target type
    DecideCtorCalls_( c )   '' ...and which constructor each 'T( args )' runs
    DecidePtrCastArgs_( c )   '' ...and an 'any ptr' argument two pointer casts reach (fbc 98)
    DecideCtorConvArgs_( c )   '' ...and a UDT argument two constructors take equally (fbc 98)
    DecideByrefNumArgs_( c )   '' ...and a byref number given another type's lvalue (fbc 58)
    c.syms->usePos = Tko.USEPOS_LATEST
end sub
