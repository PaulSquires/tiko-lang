'' resolvearr.tiko -- ARRAY BOUNDS and INITIALIZER COUNTS, at Resolve time.
''
'' Split out of resolve.tiko at the 1500-line cap and included from it in the same
'' place, exactly as resolvedot.tiko is.

'' How many elements the initializer has at nesting level 'depth'. N_INITIALIZER is a
'' LIST node, so its children come from the list pool -- reading a statement payload
'' here would land on an unrelated node, which is the mistake this codebase has made
'' six times.
function InitCountAt _
    ( byref c as Ctx, byval init as Tko.NodeId, byval depth as int32 ) as int32

    dim as Tko.NodeId n = init
    for level as int32 = 0 to depth
        if n = Tko.NODE_NONE then return -1
        if c.ast->Kind( n ) <> Tko.N_INITIALIZER then return -1
        dim as Tko.ListPayload ptr lp = _
            c.ast->ListOf( n )
        if level = depth then return lp->count
        if lp->count = 0 then return -1
        n = cast( Tko.NodeId, c.ast->ChildSlot( lp->first ) )
    next
    return -1
end function




'' A FIELD'S ARRAY TYPE: its bounds' fixed array -- or, for 'redim a( 2 to 6 ) as T', a
'' DYNAMIC array of that rank, whose bounds the constructor applies (lowerdesc.tiko
'' RedimFieldInit_). Their names are bound here, as a field initialiser's are.
function FieldArrayType_ _
    ( byref c as Ctx, byval t as Tko.TypeId, byval sp as Tko.StmtPayload ptr, _
      byval here as Tko.ScopeId ) as Tko.TypeId
    if (sp->count < 2) orelse (t = Tko.TYPE_NONE) then return ArrayFromBounds( c, t, sp->first, sp->count, here )
    '' ...AND SO IS 'dim a( i to i )' WITH A BOUND THAT IS NOT CONSTANT: ArrayFromBounds makes it
    '' dynamic, and the constructor sizes it from the bounds bound here (dynamic-array-fields.bas).
    if sp->op <> cast( uint16, Tko.KW_REDIM ) then
        dim as Tko.TypeId fat = ArrayFromBounds( c, t, sp->first, sp->count, here )
        if c.types->IsDynArray( fat ) = false then return fat
        '' ...UNLESS A FIELD SHADOWED THE CONSTANT. 'as single bias( bias )' names the
        '' module's 'const bias' -- fbc sizes it 0 to 3 -- but looked up in the type's own
        '' scope the bound found the FIELD, was not constant, and the field silently became a
        '' dynamic array whose constructor then declined (fbc-examples r2ice06). The type's
        '' enclosing scope is asked before giving up.
        dim as Tko.SymScope ptr hsc = c.syms->ScopeAt( here )
        if hsc <> nullptr then
            if hsc->parent <> Tko.SCOPE_NONE then
                dim as Tko.TypeId pat = ArrayFromBounds( c, t, sp->first, sp->count, hsc->parent )
                if c.types->IsDynArray( pat ) = false then return pat
            end if
        end if
    end if
    '' 'redim g( any )' is a plain dynamic field, unsized: ArrayFromBounds already answers that.
    for i as int32 = 0 to sp->count - 1
        dim as Tko.NodeId bn = c.ast->ChildAt( sp->first, i )
        if c.ast->Kind( bn ) = Tko.N_IDENT then
            if Tko.Text.LowerAscii( c.names->Spelling( c.ast->IdentOf( bn )->name ) ) = "any" then
                return ArrayFromBounds( c, t, sp->first, sp->count, here )
            end if
        end if
    next
    for i as int32 = 0 to sp->count - 1
        WalkExpr( c, c.ast->ChildAt( sp->first, i ), here )
    next
    return c.types->DynArrayOf( t, sp->count \ 2 )
end function

'' N_FIELD: flat (lo, hi) children.
function ArrayFromBounds _
    ( byref c as Ctx, byval base_ as Tko.TypeId, byval first as int32, _
      byval count as int32, _
      byval scope_ as Tko.ScopeId = Tko.SCOPE_NONE ) as Tko.TypeId

    dim as containers.Array( of uint32 ) los, his
    dim as int32 i = 0
    while i + 1 < count + 1 andalso i + 1 <= count - 1
        los.Push( c.ast->ChildSlot( first + i ) )
        his.Push( c.ast->ChildSlot( first + i + 1 ) )
        i += 2
    wend
    return ArrayFromPairs( c, base_, los, his, Tko.NODE_NONE, false, scope_ )
end function

'' A FIXED LOCAL ARRAY THAT IS RETURNED. A TIKO EXTENSION, beside the array result itself
'' (arrresult.tiko):
''
''     function f( ) as integer( )
''         dim as integer t( 100 )
''         return t
''     end function
''
'' A result is MOVED out -- its descriptor handed to the caller -- and a fixed array has no
'' descriptor to hand over: its elements sit in this frame. So a fixed array that the body
'' names in a 'return' or a 'function =' is given a DYNAMIC array type of the same rank here,
'' and the declaration's bounds -- constants, folded -- size it at the 'dim', as they do any
'' 'dim a( 1 to n )'. Its elements live on the heap from the start, and the return moves
'' their descriptor: no element is ever copied. Only a plain local of an array-returning
'' procedure is taken; SHARED, STATIC, BYREF and initialised items keep their fixed type. The
'' symbol is marked SYMF_RETURNED_FIXED, so 'erase t' still clears it rather than freeing it.

'' Does this statement, or one nested in it, return the array named 'nm'? Only statements are
'' entered -- an expression holds no 'return' of this procedure.
private function NamesReturned_ _
    ( byref c as Ctx, byval id as Tko.NodeId, byval nm as Tko.InternId, _
      byval procName as Tko.InternId, byval depth as int32 ) as boolean

    if (id = Tko.NODE_NONE) orelse (depth > 200) then return false
    dim as Tko.NodeKind k = c.ast->Kind( id )
    if k = Tko.N_BLOCK then
        dim as Tko.ListPayload ptr lp = ListOf( c, id )
        for i as int32 = 0 to lp->count - 1
            if NamesReturned_( c, c.ast->ChildAt( lp->first, i ), nm, procName, depth + 1 ) then return true
        next
        return false
    end if
    if Tko.NodeKindCategory( k ) <> Tko.NCAT_STMT then return false
    dim as Tko.StmtPayload ptr sp = StmtOf( c, id )
    dim as Tko.NodeId v = Tko.NODE_NONE
    if k = Tko.N_RETURN then v = sp->a
    if (k = Tko.N_AMBIGUOUS) andalso (sp->op = cast( uint16, Tko.TK_EQ )) andalso (sp->a <> Tko.NODE_NONE) then
        '' 'function = t', and 'f = t' with the procedure's own name.
        if c.ast->Kind( sp->a ) = Tko.N_FUNCRESULT then v = sp->b
        if IdentNameOf( c, sp->a ) = procName then v = sp->b
    end if
    for guard as int32 = 0 to 15
        if v = Tko.NODE_NONE then exit for
        dim as Tko.NodeKind vk = c.ast->Kind( v )
        if vk = Tko.N_IDENT then return (IdentNameOf( c, v ) = nm)
        if (vk <> Tko.N_PAREN) andalso (vk <> Tko.N_CALL) then exit for
        '' '( t )', and 't( )' -- the array's name with an empty subscript.
        dim as Tko.ListPayload ptr vl = ListOf( c, v )
        if vk = Tko.N_CALL then
            if vl->count <> 0 then exit for
            v = vl->target
        else
            if vl->count <> 1 then exit for
            v = cast( Tko.NodeId, c.ast->ChildSlot( vl->first ) )
        end if
    next
    if NamesReturned_( c, sp->a, nm, procName, depth + 1 ) then return true
    if NamesReturned_( c, sp->b, nm, procName, depth + 1 ) then return true
    if NamesReturned_( c, sp->c, nm, procName, depth + 1 ) then return true
    for i as int32 = 0 to sp->count - 1
        if NamesReturned_( c, c.ast->ChildAt( sp->first, i ), nm, procName, depth + 1 ) then return true
    next
    return false
end function

'' A fixed array type 't' for the local 'nm' -- or, when that local is marked
'' SYMF_RETURNED_FIXED, the dynamic array of the same element and rank. Also called by the
'' revisit of an item whose element type was not complete yet (generictypedef.tiko), which
'' would otherwise rebuild the fixed type over the promotion.
function KeepReturnedDyn_ _
    ( byref c as Ctx, byval here as Tko.ScopeId, byval nm as Tko.InternId, _
      byval t as Tko.TypeId ) as Tko.TypeId

    if t = Tko.TYPE_NONE then return t
    if (c.types->Kind( t ) <> Tko.TK_ARRAY) orelse c.types->IsDynArray( t ) then return t
    dim as Tko.Symbol ptr vs = c.syms->SymbolAt( c.syms->LookupLocalTyped( here, nm, false ) )
    if vs = nullptr then return t
    if (vs->flags and Tko.SYMF_RETURNED_FIXED) = 0 then return t
    '' One fixed array type carries every dimension, over its element.
    dim as int32 rank = c.types->types[cast( int32, t )].dims
    dim as Tko.TypeId el = c.types->Inner( t )
    if (rank < 1) orelse (el = Tko.TYPE_NONE) then return t
    return c.types->DynArrayOf( el, rank )
end function

'' 't', the type Resolve built for a local item -- or, for a fixed array the procedure returns,
'' the dynamic array of the same element and rank.
function ReturnedLocalArray_ _
    ( byref c as Ctx, byval declNode as Tko.NodeId, byval item as Tko.NodeId, _
      byval t as Tko.TypeId, byval here as Tko.ScopeId ) as Tko.TypeId

    if t = Tko.TYPE_NONE then return t
    if c.types->Kind( t ) <> Tko.TK_ARRAY then return t
    if c.types->IsDynArray( t ) then return t
    if Tko.Check.FixedStringElem( t, *c.types ) <> Tko.TYPE_NONE then return t
    if c.ast->Kind( declNode ) <> Tko.N_VAR then return t
    dim as uint16 fl = c.ast->Flags( declNode ) or c.ast->Flags( item )
    if (fl and (Tko.NF_SHARED or Tko.NF_STATIC or Tko.NF_BYREF)) <> 0 then return t
    dim as Tko.StmtPayload ptr ip = StmtOf( c, item )
    if (ip->b <> Tko.NODE_NONE) orelse (ip->c = Tko.NODE_NONE) then return t
    dim as Tko.Symbol ptr ps = c.syms->SymbolAt( c.currentProc )
    if ps = nullptr then return t
    if ps->kind <> cast( uint8, Tko.SYM_PROC ) then return t
    dim as Tko.NodeId pn = cast( Tko.NodeId, ps->payload )
    if pn = Tko.NODE_NONE then return t
    if c.ast->Kind( pn ) <> Tko.N_PROC then return t
    dim as Tko.StmtPayload ptr pp = StmtOf( c, pn )
    if (pp->extra and Tko.PF_ARRAY_RESULT) = 0 then return t
    if NamesReturned_( c, pp->b, ip->name, ps->name, 0 ) = false then return t
    dim as Tko.Symbol ptr vs = c.syms->SymbolAt( c.syms->LookupLocalTyped( here, ip->name, false ) )
    if vs = nullptr then return t
    if vs->kind <> cast( uint8, Tko.SYM_VARIABLE ) then return t
    '' ...STILL A FIXED ARRAY TO 'erase', which clears its elements and keeps them. Without the
    '' mark 'erase t' freed it, and the next 't( 3 )' read through a null pointer.
    vs->flags or= Tko.SYMF_RETURNED_FIXED
    return KeepReturnedDyn_( c, here, ip->name, t )
end function
