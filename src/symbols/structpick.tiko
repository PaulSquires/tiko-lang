'' structpick.tiko -- WHICH CONSTRUCTOR, OR WHICH 'operator let', FOR A SET OF ARGUMENT TYPES.
''
'' One resolver for the whole compiler (overload re-pick refactor, Phase 2). It was
'' lowering's PickCtor (mir/lowerstore.tiko) with its CtorUserConvCost_ (mir/lowerctor.tiko),
'' while Check's late access check chose a constructor by a narrower rule of its own
'' (latechecks.tiko CtorChosenBy_). Both now ask this; the cost model is the one overload
'' resolution uses -- fitted to 1,274 measured fbc choices.

#import "std/containers"
#include once "symbols/check.ti"

namespace Tko.Check

private function SpStmt_( byref ast as Tko.AstArena, byval n as Tko.NodeId ) as Tko.StmtPayload ptr
    return ast.StmtOf( n )
end function

private function SpProcNode_( byref ast as Tko.AstArena, byref syms as Tko.SymbolTable, byval sid as Tko.SymbolId ) as Tko.NodeId
    dim as Tko.Symbol ptr s = syms.SymbolAt( sid )
    if s = nullptr then return Tko.NODE_NONE
    dim as Tko.NodeId pn = cast( Tko.NodeId, s->payload )
    if pn = Tko.NODE_NONE then return Tko.NODE_NONE
    if ast.Kind( pn ) <> Tko.N_PROC then return Tko.NODE_NONE
    return pn
end function

private function SpParamCount_( byref ast as Tko.AstArena, byref syms as Tko.SymbolTable, byval sid as Tko.SymbolId ) as int32
    dim as Tko.NodeId pn = SpProcNode_( ast, syms, sid )
    if pn = Tko.NODE_NONE then return 0
    dim as Tko.StmtPayload ptr pp = SpStmt_( ast, pn )
    dim as int32 n = 0
    for i as int32 = 0 to pp->count - 1
        if ast.Kind( ast.ChildAt( pp->first, i ) ) = Tko.N_PARAM then n += 1
    next
    return n
end function

private function SpParamType_( byref ast as Tko.AstArena, byref syms as Tko.SymbolTable, _
    byref info as Tko.SemanticInfo, byval sid as Tko.SymbolId, byval idx as int32 ) as Tko.TypeId
    dim as Tko.NodeId pn = SpProcNode_( ast, syms, sid )
    if pn = Tko.NODE_NONE then return Tko.TYPE_NONE
    dim as Tko.StmtPayload ptr pp = SpStmt_( ast, pn )
    dim as int32 seen = 0
    for i as int32 = 0 to pp->count - 1
        dim as Tko.NodeId prm = ast.ChildAt( pp->first, i )
        if ast.Kind( prm ) <> Tko.N_PARAM then continue for
        if seen = idx then return info.TypeOf_( SpStmt_( ast, prm )->a )
        seen += 1
    next
    return Tko.TYPE_NONE
end function

'' The constructor ('__ctor'), destructor ('__dtor') or 'let' chain of a UDT, or NONE: they
'' live in the type's scope under synthetic names, having no names of their own.
function StructorNamed _
    ( byref syms as Tko.SymbolTable, byref types as Tko.TypeContext, byref names as Tko.Interner, _
      byval t as Tko.TypeId, byref which as string ) as Tko.SymbolId

    if t = Tko.TYPE_NONE then return Tko.SYMBOL_NONE
    if types.Kind( t ) <> Tko.TK_UDT then return Tko.SYMBOL_NONE
    dim as Tko.InternId tn = types.NameOf( t )
    if tn = 0 then return Tko.SYMBOL_NONE
    dim as Tko.ScopeId ds = cast( Tko.ScopeId, types.DeclScopeOf( t ) )
    dim as Tko.Symbol ptr s = syms.SymbolAt( syms.LookupTyped( ds, tn, true ) )
    if s = nullptr then return Tko.SYMBOL_NONE
    if s->inner = Tko.SCOPE_NONE then return Tko.SYMBOL_NONE
    return syms.LookupLocal( s->inner, names.Fold( names.GetString( which ) ) )
end function

'' A UDT PARAMETER THE ARGUMENT REACHES THROUGH ONE OF THAT UDT'S OWN CONSTRUCTORS. The
'' standard conversions alone found nothing for 'dim as X x2 = 13' over 'constructor X(
'' byref w as W )' and 'constructor W( byval v as long )', where fbc writes '_ZN1WC1Ei(
'' &TMP$38$0, 13 ); _ZN1XC1ER1W( &X2$0, &TMP$38$0 )'. CONV_USERDEF plus the standard
'' conversion into that constructor's parameter, one level only: a copy constructor never
'' counts.
function StructorUserConvCost _
    ( byref ast as Tko.AstArena, byref syms as Tko.SymbolTable, byref types as Tko.TypeContext, _
      byref names as Tko.Interner, byref info as Tko.SemanticInfo, _
      byval at as Tko.TypeId, byval pt as Tko.TypeId ) as int32

    if (at = Tko.TYPE_NONE) orelse (pt = Tko.TYPE_NONE) then return CONV_NONE
    dim as Tko.TypeId t = types.Unqualify( pt )
    if types.Kind( t ) = Tko.TK_REFERENCE then t = types.Unqualify( types.Inner( t ) )
    if types.Kind( t ) <> Tko.TK_UDT then return CONV_NONE
    dim as int32 best = CONV_NONE
    dim as Tko.SymbolId cur = StructorNamed( syms, types, names, t, "__ctor" )
    dim as int32 guard = 0
    while (cur <> Tko.SYMBOL_NONE) andalso (guard < 1000)
        guard += 1
        dim as Tko.Symbol ptr s = syms.SymbolAt( cur )
        if s = nullptr then exit while
        if SpParamCount_( ast, syms, cur ) = 1 then
            dim as Tko.TypeId cpt = SpParamType_( ast, syms, info, cur, 0 )
            if cpt <> Tko.TYPE_NONE then
                dim as Tko.TypeId cu = types.Unqualify( cpt )
                if types.Kind( cu ) = Tko.TK_REFERENCE then cu = types.Unqualify( types.Inner( cu ) )
                if cu <> t then
                    dim as int32 sc = ConversionCost( at, cpt, types )
                    if sc < CONV_NONE then
                        if (CONV_USERDEF + sc) < best then best = CONV_USERDEF + sc
                    end if
                end if
            end if
        end if
        cur = s->nextOverload
    wend
    return best
end function

'' 1 a narrow string (string, zstring, ustring), 2 a wstring, 0 anything else.
private function StrKind_( byref types as Tko.TypeContext, byval t as Tko.TypeId ) as int32
    if t = Tko.TYPE_NONE then return 0
    if types.Kind( t ) <> Tko.TK_BUILTIN then return 0
    select case types.BuiltinOf( t )
    case Tko.TY_STRING, Tko.TY_ZSTRING, Tko.TY_USTRING : return 1
    case Tko.TY_WSTRING : return 2
    end select
    return 0
end function

'' DOES A UDT DECLARE A CAST YIELDING TEXT -- a string of any width, or a character pointer?
'' Measured on fbc-modern: a type casting only to long and double is error 24 as a 'string'
'' initialiser, 181 assigned to one and 58 passed as one; tiko converted the number.
function UdtHasStrCast _
    ( byref syms as Tko.SymbolTable, byref types as Tko.TypeContext, _
      byref names as Tko.Interner, byval udt as Tko.TypeId ) as boolean

    dim as Tko.TypeId u = types.Unqualify( udt )
    if types.Kind( u ) = Tko.TK_REFERENCE then u = types.Unqualify( types.Inner( u ) )
    if types.Kind( u ) <> Tko.TK_UDT then return false
    dim as Tko.SymbolId cur = StructorNamed( syms, types, names, u, "cast" )
    dim as int32 guard = 0
    while (cur <> Tko.SYMBOL_NONE) andalso (guard < 4096)
        guard += 1
        dim as Tko.Symbol ptr cs = syms.SymbolAt( cur )
        if cs = nullptr then exit while
        dim as Tko.TypeId rt = types.Unqualify( cs->type_ )
        if rt <> Tko.TYPE_NONE then
            if types.Kind( rt ) = Tko.TK_REFERENCE then rt = types.Unqualify( types.Inner( rt ) )
            if types.Kind( rt ) = Tko.TK_POINTER then rt = types.Unqualify( types.Inner( rt ) )
            if StrKind_( types, rt ) <> 0 then return true
        end if
        cur = cs->nextOverload
    wend
    return false
end function

'' WHAT A TEXT CAST COSTS INTO A TEXT PARAMETER, past the user conversion itself: 0 for the
'' identical type, more the further fbc ranks the pair. Measured on fbc-modern -- a UDT casting
'' to each of the four, passed to a type constructible from every subset of them:
''
''     cast yields   preference                              (= is a tie: fbc's 98)
''     string        string < zstring < ustring = wstring
''     ustring       ustring < zstring < string = wstring
''     wstring       wstring < string = ustring = zstring
''     zstring       zstring < string < ustring < wstring
''
'' It was the WIDTH alone, with ustring counted narrow: string and ustring tied, the tie
'' read as "no pick", and lowering then took the first constructor in the chain -- the
'' ustring one with an EMPTY value when it was declared first, an internal compiler error
'' (TKO0994) when a boolean one was.
private function TextCastRank_ _
    ( byref types as Tko.TypeContext, byval rt as Tko.TypeId, byval p as Tko.TypeId ) as int32

    dim as Tko.BuiltinType a = types.BuiltinOf( rt ), b = types.BuiltinOf( p )
    if a = b then return 0
    select case a
    case Tko.TY_STRING, Tko.TY_USTRING
        if b = Tko.TY_ZSTRING then return 1
        return 2
    case Tko.TY_ZSTRING
        select case b
        case Tko.TY_STRING  : return 1
        case Tko.TY_USTRING : return 2
        end select
        return 3
    end select
    return 2
end function

'' StructorCastCost's POINTER arm: CONV_USERDEF for a cast on 'a' yielding exactly 'p' -- a typed
'' pointer, never 'any ptr' -- and CONV_NONE otherwise. See StructorCastCost.
private function PtrCastCtorCost_ _
    ( byref syms as Tko.SymbolTable, byref types as Tko.TypeContext, _
      byref names as Tko.Interner, byval a as Tko.TypeId, byval p as Tko.TypeId ) as int32

    dim as Tko.TypeId pe = types.Unqualify( types.Inner( p ) )
    if types.Kind( pe ) = Tko.TK_BUILTIN then
        if types.BuiltinOf( pe ) = Tko.TY_ANY then return CONV_NONE
    end if
    dim as Tko.SymbolId cur = StructorNamed( syms, types, names, a, "cast" )
    dim as int32 guard = 0
    while (cur <> Tko.SYMBOL_NONE) andalso (guard < 4096)
        guard += 1
        dim as Tko.Symbol ptr cs = syms.SymbolAt( cur )
        if cs = nullptr then exit while
        dim as Tko.TypeId rt = types.Unqualify( cs->type_ )
        if rt <> Tko.TYPE_NONE then
            if types.Kind( rt ) = Tko.TK_REFERENCE then rt = types.Unqualify( types.Inner( rt ) )
            if rt = p then return CONV_USERDEF
            '' ...or the same pointee under a 'const' the parameter adds: fbc passes a 'zstring ptr'
            '' cast to 'constructor( byval as const zstring ptr )', and tiko refused it (TKO0698).
            if (types.Kind( rt ) = Tko.TK_POINTER) andalso (types.Unqualify( types.Inner( rt ) ) = pe) then
                if types.IsConst( types.Inner( rt ) ) = false then return CONV_USERDEF + CONV_CONST_ADD
            end if
        end if
        cur = cs->nextOverload
    wend
    return CONV_NONE
end function

'' A UDT ARGUMENT REACHING A CONSTRUCTOR'S (or 'let's) STRING OR NUMERIC PARAMETER THROUGH ITS OWN
'' 'operator cast', or CONV_NONE. Measured on fbc-modern: S casting to string (or 'byref as
'' wstring') and T constructible from 'byref/byval as string' or 'byref as wstring' -- 'T( s )',
'' 'dim as T q = s', a T argument and an operand all run [cast][ctor]; and over numbers every
'' CONVERTING pair does too (a 'double' cast into 'constructor( byval as long )', 'short' into
'' 'integer', ...). fbc REFUSES the pairs whose types are IDENTICAL -- 'long' into 'long',
'' 'double' into 'double', boolean -- in every context: 58 as an argument, 20 as an operand, 24
'' as an initialiser, 99 for 'T( x )', 181 returned; and so does tiko, the author's call
'' (2026-10-10; tiko took them before). A numeric cast is the one NumericCastPick takes for the
'' parameter, so a second, converting cast beside the identical one does not rescue it (58).
'' POINTERS ARE THE MIRROR IMAGE, measured: only a cast yielding EXACTLY the parameter's typed
'' pointer runs -- 'long ptr', 'zstring ptr', 'E ptr' -- while 'any ptr' even into 'any ptr',
'' and every converting pointer pair, are 58 (tiko refused them all, TKO0698).
function StructorCastCost _
    ( byref ast as Tko.AstArena, byref syms as Tko.SymbolTable, byref types as Tko.TypeContext, _
      byref names as Tko.Interner, byval at as Tko.TypeId, byval pt as Tko.TypeId ) as int32

    if (at = Tko.TYPE_NONE) orelse (pt = Tko.TYPE_NONE) then return CONV_NONE
    dim as Tko.TypeId a = types.Unqualify( at )
    if types.Kind( a ) = Tko.TK_REFERENCE then a = types.Unqualify( types.Inner( a ) )
    if types.Kind( a ) <> Tko.TK_UDT then return CONV_NONE
    dim as Tko.TypeId p = types.Unqualify( pt )
    if types.Kind( p ) = Tko.TK_REFERENCE then p = types.Unqualify( types.Inner( p ) )
    if StrKind_( types, p ) = 0 then
        if types.Kind( p ) = Tko.TK_POINTER then return PtrCastCtorCost_( syms, types, names, a, p )
        if NumericCastRank( types, p ) = 0 then return CONV_NONE
        dim as Tko.SymbolId nc = NumericCastPick( syms, types, names, a, p )
        if nc = Tko.SYMBOL_NONE then return CONV_NONE
        dim as int32 sc = ConversionCost( types.Unqualify( syms.SymbolAt( nc )->type_ ), p, types )
        if sc >= CONV_NONE then return CONV_NONE
        if sc = 0 then return CONV_NONE    '' IDENTICAL types: fbc's refusal, above
        if sc > 0 then sc = CONV_NUMERIC   '' a cast then ANY conversion: one flat score, as fbc ranks it
        return CONV_USERDEF + sc + 2   '' a string cast beats a numeric one, as UserConvCost_ prices them
    end if
    dim as int32 best = CONV_NONE
    dim as Tko.SymbolId cur = StructorNamed( syms, types, names, a, "cast" )
    dim as int32 guard = 0
    while (cur <> Tko.SYMBOL_NONE) andalso (guard < 4096)
        guard += 1
        dim as Tko.Symbol ptr cs = syms.SymbolAt( cur )
        if cs = nullptr then exit while
        dim as Tko.TypeId rt = types.Unqualify( cs->type_ )
        dim as Tko.NodeId pn = cast( Tko.NodeId, cs->payload )
        dim as boolean byrefRes = false
        if (pn <> Tko.NODE_NONE) andalso (ast.Kind( pn ) = Tko.N_PROC) then
            byrefRes = ((ast.Flags( pn ) and Tko.NF_BYREF) <> 0)
        end if
        if rt <> Tko.TYPE_NONE then
            if types.Kind( rt ) = Tko.TK_REFERENCE then rt = types.Unqualify( types.Inner( rt ) )
            if byrefRes andalso (types.Kind( rt ) = Tko.TK_POINTER) then rt = types.Unqualify( types.Inner( rt ) )
            dim as int32 rk = StrKind_( types, rt )
            if rk <> 0 then
                dim as int32 cost = CONV_USERDEF + TextCastRank_( types, rt, p )
                if cost < best then best = cost
            end if
        end if
        cur = cs->nextOverload
    wend
    return best
end function

'' THE CONSTRUCTOR (or 'let') OVERLOAD FOR A SET OF ARGUMENT TYPES, from the chain at
'' 'first_'; NONE for no viable one, and NONE for a tie -- an ambiguous construction, not
'' a silent pick. 'tiesOut', when given, receives how many other candidates tied the winner
'' -- non-zero only for that ambiguous NONE.
function PickStructor _
    ( byref ast as Tko.AstArena, byref syms as Tko.SymbolTable, byref types as Tko.TypeContext, _
      byref names as Tko.Interner, byref info as Tko.SemanticInfo, _
      byval first_ as Tko.SymbolId, byref argT as containers.Array( of uint32 ), _
      byval tiesOut as int32 ptr = nullptr ) as Tko.SymbolId

    dim as Tko.SymbolId best = Tko.SYMBOL_NONE
    dim as int32 bestCost = CONV_NONE
    dim as int32 ties = 0
    dim as Tko.SymbolId cur = first_
    while cur <> Tko.SYMBOL_NONE
        dim as Tko.Symbol ptr s = syms.SymbolAt( cur )
        if s = nullptr then exit while
        dim as Tko.NodeId pn = SpProcNode_( ast, syms, cur )
        if pn <> Tko.NODE_NONE then
            dim as Tko.StmtPayload ptr pp = SpStmt_( ast, pn )
            dim as int32 np = 0
            for i as int32 = 0 to pp->count - 1
                if ast.Kind( ast.ChildAt( pp->first, i ) ) = Tko.N_PARAM then np += 1
            next
            '' A TYPED VARIADIC LAST PARAMETER takes any number of arguments past the fixed
            '' ones, each costed against its element type (docs/tiko-params/RFC-0001). This
            '' sees TYPES only, so a spread 'T( a( ) )' and a one-element 'T( x )' cost alike
            '' and pick the same constructor; lowering, which has the nodes, tells them apart.
            dim as Tko.NodeId tvp = Tko.NODE_NONE
            for i as int32 = pp->count - 1 to 0 step -1
                dim as Tko.NodeId lp_ = ast.ChildAt( pp->first, i )
                if ast.Kind( lp_ ) <> Tko.N_PARAM then continue for
                if (ast.Flags( lp_ ) and Tko.NF_VARIADIC) <> 0 then tvp = lp_
                exit for
            next
            if tvp <> Tko.NODE_NONE then np -= 1
            '' A CONSTRUCTOR WITH DEFAULTED TRAILING PARAMETERS IS VIABLE FOR THE SHORTER
            '' CALL. 'constructor( byval c as long, byval os as long = 0 )' answers 'A( 5 )'
            '' -- measured, fbc emits '_ZN1AC1Eii( &A1, 5, 0 )' -- and exact arity alone
            '' found none, so 'dim as A a1 = A( 5 )' default-constructed and then copied.
            dim as boolean arityOk = (np = argT.Count)
            if (tvp <> Tko.NODE_NONE) andalso (argT.Count >= np) then arityOk = true
            if (arityOk = false) andalso (np > argT.Count) then
                arityOk = true
                dim as int32 sd = 0
                for i as int32 = 0 to pp->count - 1
                    dim as Tko.NodeId prm = ast.ChildAt( pp->first, i )
                    if ast.Kind( prm ) <> Tko.N_PARAM then continue for
                    if prm = tvp then exit for
                    if sd >= argT.Count then
                        if SpStmt_( ast, prm )->b = Tko.NODE_NONE then
                            arityOk = false
                            exit for
                        end if
                    end if
                    sd += 1
                next
            end if
            if arityOk then
                dim as int32 total = 0
                dim as int32 ai = 0
                dim as boolean viable = true
                for i as int32 = 0 to pp->count - 1
                    dim as Tko.NodeId prm = ast.ChildAt( pp->first, i )
                    if ast.Kind( prm ) <> Tko.N_PARAM then continue for
                    if prm = tvp then exit for   '' packed below
                    '' The defaulted tail costs nothing: there is no argument to convert.
                    if ai >= argT.Count then exit for
                    dim as Tko.TypeId at2 = cast( Tko.TypeId, argT[ai] )
                    dim as Tko.TypeId pt2 = info.TypeOf_( SpStmt_( ast, prm )->a )
                    dim as int32 cost = 0
                    '' AN ARRAY PARAMETER IS MATCHED BY ITS ELEMENT TYPE: its declared type IS
                    '' the element, the array-ness is the node's flag (structs/udt-array-ops-1).
                    if (ast.Flags( prm ) and Tko.NF_ARRAY) <> 0 then
                        dim as Tko.TypeId ae = at2
                        if ae <> Tko.TYPE_NONE then
                            if types.Kind( ae ) = Tko.TK_ARRAY then ae = types.Inner( ae )
                        end if
                        cost = ConversionCost( ae, pt2, types )
                    else
                        cost = ConversionCost( at2, pt2, types )
                        if cost >= CONV_NONE then cost = StructorUserConvCost( ast, syms, types, names, info, at2, pt2 )
                        if cost >= CONV_NONE then cost = StructorCastCost( ast, syms, types, names, at2, pt2 )
                    end if
                    ai += 1
                    if cost >= CONV_NONE then
                        viable = false
                        exit for
                    end if
                    total += cost
                next
                if viable andalso (tvp <> Tko.NODE_NONE) then
                    dim as Tko.TypeId vpt = info.TypeOf_( SpStmt_( ast, tvp )->a )
                    dim as boolean spread = (argT.Count = ai + 1)
                    for k as int32 = ai to argT.Count - 1
                        dim as Tko.TypeId vat = cast( Tko.TypeId, argT[k] )
                        if vat <> Tko.TYPE_NONE then
                            if types.Kind( vat ) = Tko.TK_ARRAY then vat = types.Inner( vat ) else spread = false
                        end if
                        dim as int32 vc = ConversionCost( vat, vpt, types )
                        if vc >= CONV_NONE then vc = StructorUserConvCost( ast, syms, types, names, info, vat, vpt )
                        if vc >= CONV_NONE then vc = StructorCastCost( ast, syms, types, names, vat, vpt )
                        if vc >= CONV_NONE then
                            viable = false
                            exit for
                        end if
                        total += vc
                    next
                    if viable andalso (spread = false) then total += CONV_EXPANDED
                end if
                if viable then
                    '' THE FIRST VIABLE CANDIDATE IS KEPT WHATEVER IT COSTS, as in ResolveCall_: a
                    '' packed typed variadic's total is above CONV_NONE by design (CONV_EXPANDED).
                    if (best = Tko.SYMBOL_NONE) orelse (total < bestCost) then
                        bestCost = total
                        best = cur
                        ties = 0
                    elseif total = bestCost then
                        ties += 1
                    end if
                end if
            end if
        end if
        cur = s->nextOverload
    wend
    if tiesOut <> nullptr then *tiesOut = iif( best = Tko.SYMBOL_NONE, 0, ties )
    if ties > 0 then return Tko.SYMBOL_NONE
    return best
end function

'' A NUMBER, AN ENUM OR A POINTER -- what Coerce converts between on its own.
private function SpScalar_( byref types as Tko.TypeContext, byval t as Tko.TypeId ) as boolean
    if t = Tko.TYPE_NONE then return false
    dim as Tko.TypeId u = types.Unqualify( t )
    select case types.Kind( u )
    case Tko.TK_POINTER, Tko.TK_ENUM
        return true
    case Tko.TK_BUILTIN
        select case types.BuiltinOf( u )
        case Tko.TY_BOOLEAN, Tko.TY_BYTE, Tko.TY_UBYTE, Tko.TY_SHORT, Tko.TY_USHORT, Tko.TY_LONG, _
             Tko.TY_ULONG, Tko.TY_INTEGER, Tko.TY_UINTEGER, Tko.TY_LONGINT, Tko.TY_ULONGINT, _
             Tko.TY_SINGLE, Tko.TY_DOUBLE
            return true
        end select
    end select
    return false
end function

'' THE ONE CONSTRUCTOR (or 'let') OF A CHAIN, when PickStructor finds it unviable and every
'' argument and BYVAL parameter is a number, an enum or a pointer. fbc's single procedure only
'' warns where its overload resolution refuses: 'T( e1 )' over 'constructor( byval p as long
'' ptr )' with an enum, and 'T( p )' over 'byval as E' with a pointer, are warnings 1 and 2
'' (fbc-modern 1.20, 2026-10-19), and ConversionCost costs neither -- so no constructor was
'' picked, and lowering stopped on TKO0994. Check judges what a lone constructor takes
'' (ctorargs.tiko); what passes is a Coerce. NONE for a set, a generic or anything else.
function LoneScalarStructor _
    ( byref ast as Tko.AstArena, byref syms as Tko.SymbolTable, byref types as Tko.TypeContext, _
      byref info as Tko.SemanticInfo, byval first_ as Tko.SymbolId, _
      byref argT as containers.Array( of uint32 ) ) as Tko.SymbolId

    dim as Tko.Symbol ptr s = syms.SymbolAt( first_ )
    if s = nullptr then return Tko.SYMBOL_NONE
    if s->nextOverload <> Tko.SYMBOL_NONE then return Tko.SYMBOL_NONE
    if (s->flags and Tko.SYMF_OVERLOAD) <> 0 then return Tko.SYMBOL_NONE
    dim as Tko.NodeId pn = SpProcNode_( ast, syms, first_ )
    if pn = Tko.NODE_NONE then return Tko.SYMBOL_NONE
    dim as Tko.StmtPayload ptr pp = SpStmt_( ast, pn )
    if (pp->extra and Tko.PF_GENERIC_PROC) <> 0 then return Tko.SYMBOL_NONE
    dim as int32 ai = 0
    for i as int32 = 0 to pp->count - 1
        dim as Tko.NodeId prm = ast.ChildAt( pp->first, i )
        if ast.Kind( prm ) <> Tko.N_PARAM then continue for
        dim as Tko.StmtPayload ptr psp = SpStmt_( ast, prm )
        if psp->op = cast( uint16, Tko.TK_ELLIPSIS ) then return Tko.SYMBOL_NONE
        if (ast.Flags( prm ) and (Tko.NF_VARIADIC or Tko.NF_ARRAY)) <> 0 then return Tko.SYMBOL_NONE
        if ai >= argT.Count then
            if psp->b = Tko.NODE_NONE then return Tko.SYMBOL_NONE   '' a missing argument
            ai += 1
            continue for
        end if
        if SpScalar_( types, info.TypeOf_( psp->a ) ) = false then return Tko.SYMBOL_NONE
        dim as Tko.TypeId at = cast( Tko.TypeId, argT[ai] )
        if at <> Tko.TYPE_NONE then
            if types.Kind( types.Unqualify( at ) ) = Tko.TK_REFERENCE then at = types.Inner( types.Unqualify( at ) )
        end if
        if SpScalar_( types, at ) = false then return Tko.SYMBOL_NONE
        '' A BYREF parameter only as a pointer given an enum, which gets a temporary of its own
        '' type (mir/lowerbyref.tiko ByrefConvArg_); any other pair would pass the wrong width.
        if (ast.Flags( prm ) and Tko.NF_BYREF) <> 0 then
            if types.Kind( types.Unqualify( info.TypeOf_( psp->a ) ) ) <> Tko.TK_POINTER then return Tko.SYMBOL_NONE
            if types.Kind( types.Unqualify( at ) ) <> Tko.TK_ENUM then return Tko.SYMBOL_NONE
        end if
        ai += 1
    next
    if ai < argT.Count then return Tko.SYMBOL_NONE
    return first_
end function

'' WHICH NUMERIC 'operator cast' A UDT VALUE TAKES (overload re-pick refactor, Phase 4). Measured on
'' fbc-modern, over a type casting to BYTE (100) and DOUBLE (2.75), in either declaration order:
''
''     x + 1, x + n (long), x * 2, x \ 2, x = 100       the BYTE cast     101 200 50 -1
''     x + d (double), x + s (single)                    the DOUBLE cast   4.25
''     dim as long k = x / dim as byte b = x             BYTE              100
''     dim as double d = x / dim as single g = x         DOUBLE            2.75
''     -x, abs( x ), sqr( x ), int( x ), x + y (two UDTs) DOUBLE           -2.75 ...
''
'' -- the cast CHEAPEST to convert to what the value meets ('want': the other operand or
'' the destination), the higher-ranked on a tie; with nothing to meet, the highest-ranked
'' (NumericCastRank). Lowering ranked always, so 'x + 1' added 2.75 and 'dim as long k =
'' x' stored 3 where fbc has 101 and 100; Check typed 'x + 1' DOUBLE where fbc says
'' INTEGER. A number is an ENUM or any builtin that is not a string flavour or VOID.
'' WHICH POINTER 'operator cast' SERVES A POINTER, AND HOW WELL -- fbc's own scoring, read in
'' symb-proc.bas (hCheckCastOvl, symbFindCastOvlProc, hCheckCastOvlEx) and measured on fbc-modern
'' 1.20, 2026-10-17, over 21 x 21 pointees (every builtin, 'any', a base, a derived and an
'' unrelated UDT, 'const zstring', 'const byte') in four contexts: a single procedure, an
'' overload set, an initialiser and an assignment.
''
'' A cast is scored against the TARGET pointer with the CAST'S RESULT on the left:
''
''     the same pointee, const or not                    exact (a matching const scores higher)
''     'any ptr' on either side                          HALF
''     integer pointees of the SAME SIZE                 HALF less the closeness rank of the
''                                                       target's pointee in the row of the
''                                                       result's (symb_dtypeMatchTB)
''     anything else -- another size, a float, a UDT     no match: not derived-to-base either
''
'' -- zstring/byte/ubyte/boolean are one size, short/ushort/wstring another (wchar is 4 bytes
'' on Linux, so there 'wstring' pairs with long/ulong). The best score is the cast, and two at
'' the best are fbc's error 98. What a single procedure, an initialiser and an assignment take
'' is exactly that pick (PtrCastFit).
''
'' AN OVERLOAD SET ASKS ONE THING MORE (PtrCastBindsInSet): the pick is scored back, the
'' parameter now on the left, and a score of exactly HALF becomes NO MATCH -- hCheckCastOvlEx
'' maps [HALF, TYPE) onto [CONV - (TYPE - HALF), CONV), and CONV - (TYPE - HALF) is zero. That
'' is every 'any ptr' cast, and the same-size pair ranked FIRST in the parameter's row -- which
'' is the pointee itself, except for the string characters, whose own row puts them last:
'' 'ubyte ptr' is first in zstring's row and 'ushort ptr' in wstring's, so those two reach
'' the single procedure and not the set, while 'byte ptr' and 'short ptr' (ranked second)
'' reach both. tiko had only 'exact or any ptr': fbc's same-size casts were TKO0698 on a single
'' procedure and TKO0994, an internal error, in a set.

'' fbc's numeric types in its own order, BOOLEAN .. DOUBLE with ENUM between UINTEGER and LONG
'' (FB_DATATYPE, symb.bi): the index the rank table below is built over. -1 for anything else.
private function FbcDt_( byref types as Tko.TypeContext, byval t as Tko.TypeId ) as int32
    if types.Kind( t ) = Tko.TK_ENUM then return 9
    if types.Kind( t ) <> Tko.TK_BUILTIN then return -1
    select case types.BuiltinOf( t )
    case Tko.TY_BOOLEAN  : return 0
    case Tko.TY_BYTE     : return 1
    case Tko.TY_UBYTE    : return 2
    case Tko.TY_ZSTRING  : return 3
    case Tko.TY_SHORT    : return 4
    case Tko.TY_USHORT   : return 5
    case Tko.TY_WSTRING  : return 6
    case Tko.TY_INTEGER  : return 7
    case Tko.TY_UINTEGER : return 8
    case Tko.TY_LONG     : return 10
    case Tko.TY_ULONG    : return 11
    case Tko.TY_LONGINT  : return 12
    case Tko.TY_ULONGINT : return 13
    case Tko.TY_SINGLE   : return 14
    case Tko.TY_DOUBLE   : return 15
    end select
    return -1
end function

'' Size, signedness and signed kind (typeToSigned) of an FbcDt_ index; W is the wchar width,
'' and wchar is unsigned on both targets (ushort, ulong).
private function FbcSize_( byval d as int32, byval w as int32 ) as int32
    select case d
    case 0, 1, 2, 3 : return 1
    case 4, 5       : return 2
    case 6          : return w
    case 10, 11, 14 : return 4
    end select
    return 8
end function

private function FbcSigned_( byval d as int32 ) as boolean
    select case d
    case 0, 1, 4, 7, 9, 10, 12, 14, 15 : return true
    end select
    return false
end function

private function FbcKind_( byval d as int32, byval w as int32 ) as int32
    select case d
    case 2, 3 : return 1
    case 5    : return 4
    case 6    : if w = 2 then return 4 else return 10
    case 8    : return 7
    case 11   : return 10
    case 13   : return 12
    end select
    return d
end function

'' closestType( d, a, b ) = b, with a <> b: fbc's rules in its order, the first that decides.
private function FbcCloser_( byval d as int32, byval a as int32, byval b as int32, byval w as int32 ) as boolean
    '' not enum, not zstring, not wstring
    for k as int32 = 0 to 2
        dim as int32 x = 9
        if k = 1 then x = 3
        if k = 2 then x = 6
        if (a <> x) andalso (b = x) then return false
        if (b <> x) andalso (a = x) then return true
    next
    '' not boolean, for a non-boolean row
    if d <> 0 then
        if (a <> 0) andalso (b = 0) then return false
        if (b <> 0) andalso (a = 0) then return true
    end if
    '' the row's class (integer or float)
    dim as boolean ca = ((a < 14) = (d < 14))
    dim as boolean cb = ((b < 14) = (d < 14))
    if ca <> cb then return cb
    '' at least as large, then the nearer size
    dim as int32 sd = FbcSize_( d, w ), sa = FbcSize_( a, w ), sb = FbcSize_( b, w )
    if (sa >= sd) <> (sb >= sd) then return (sb >= sd)
    if abs( sa - sd ) <> abs( sb - sd ) then return (abs( sb - sd ) < abs( sa - sd ))
    '' the same signedness, then the same kind, then [u]integer
    if (FbcSigned_( a ) = FbcSigned_( d )) <> (FbcSigned_( b ) = FbcSigned_( d )) then return (FbcSigned_( b ) = FbcSigned_( d ))
    dim as int32 kd = FbcKind_( d, w )
    if (FbcKind_( a, w ) = kd) <> (FbcKind_( b, w ) = kd) then return (FbcKind_( b, w ) = kd)
    if (FbcKind_( a, w ) = 7) <> (FbcKind_( b, w ) = 7) then return (FbcKind_( b, w ) = 7)
    return false
end function

'' Where X ranks in D's row, 0 the closest: symbDataInit's exchange sort, as written.
private function FbcMatchRank_( byval d as int32, byval x as int32, byval w as int32 ) as int32
    dim as int32 rk(0 to 15)
    for i as int32 = 0 to 15
        rk(i) = i
    next
    for i as int32 = 0 to 14
        for j as int32 = i + 1 to 15
            if FbcCloser_( d, rk(i), rk(j), w ) then swap rk(i), rk(j)
        next
    next
    for i as int32 = 0 to 15
        if rk(i) = x then return i
    next
    return 15
end function

const PCS_FULL as int32 = 5000
const PCS_TYPE as int32 = 4000
const PCS_HALF as int32 = 3000

'' How well a cast yielding the pointer RES serves the pointer DST, 0 for not at all; see above.
'' Swap the two and it is the overload set's second question.
function PtrCastScore( byref types as Tko.TypeContext, byval res as Tko.TypeId, byval dst as Tko.TypeId ) as int32
    dim as Tko.TypeId r = types.Unqualify( res )
    dim as Tko.TypeId d = types.Unqualify( dst )
    if (types.Kind( r ) <> Tko.TK_POINTER) orelse (types.Kind( d ) <> Tko.TK_POINTER) then return 0
    dim as Tko.TypeId ri = types.Inner( r )
    dim as Tko.TypeId di = types.Inner( d )
    dim as Tko.TypeId ru = types.Unqualify( ri )
    dim as Tko.TypeId du = types.Unqualify( di )
    if ru = du then
        if types.IsConst( ri ) = types.IsConst( di ) then return PCS_FULL
        return PCS_TYPE
    end if
    if (types.Kind( ru ) = Tko.TK_BUILTIN) andalso (types.BuiltinOf( ru ) = Tko.TY_ANY) then return PCS_HALF
    if (types.Kind( du ) = Tko.TK_BUILTIN) andalso (types.BuiltinOf( du ) = Tko.TY_ANY) then return PCS_HALF
    '' the same depth of pointer below, and then the same-size integer rule on what is left
    for guard as int32 = 0 to 31
        if (types.Kind( ru ) <> Tko.TK_POINTER) orelse (types.Kind( du ) <> Tko.TK_POINTER) then exit for
        ru = types.Unqualify( types.Inner( ru ) )
        du = types.Unqualify( types.Inner( du ) )
    next
    dim as int32 a = FbcDt_( types, ru ), b = FbcDt_( types, du )
    if (a < 0) orelse (b < 0) orelse (a >= 14) orelse (b >= 14) then return 0
    if ru = du then return PCS_TYPE
    dim as int32 w = types.Layout( types.Builtin( Tko.TY_WSTRING ) ).size
    if FbcSize_( a, w ) <> FbcSize_( b, w ) then return 0
    return PCS_HALF - 10 * FbcMatchRank_( a, b, w )
end function

'' The pick, fbc's way: the UDT's pointer cast scoring best for the pointer WANT (TYPE_NONE when
'' none is named: the 'any ptr' cast, else the first). ties = how many share the best score; best =
'' that score, 0 when nothing matches. A 'byref as' result is the thing itself, not a pointer, and
'' is skipped when AST is given.
private function PtrCastBest_ _
    ( byval ast as Tko.AstArena ptr, byref syms as Tko.SymbolTable, byref types as Tko.TypeContext, _
      byref names as Tko.Interner, byval udt as Tko.TypeId, byval want as Tko.TypeId, _
      byref nPtr as int32, byref best as int32, byref ties as int32 ) as Tko.SymbolId

    nPtr = 0 : best = 0 : ties = 0
    if udt = Tko.TYPE_NONE then return Tko.SYMBOL_NONE
    dim as Tko.TypeId u = types.Unqualify( udt )
    if types.Kind( u ) = Tko.TK_REFERENCE then u = types.Unqualify( types.Inner( u ) )
    if types.Kind( u ) <> Tko.TK_UDT then return Tko.SYMBOL_NONE
    dim as Tko.TypeId w = Tko.TYPE_NONE
    if want <> Tko.TYPE_NONE then
        w = types.Unqualify( want )
        if types.Kind( w ) = Tko.TK_REFERENCE then w = types.Unqualify( types.Inner( w ) )
        if types.Kind( w ) <> Tko.TK_POINTER then w = Tko.TYPE_NONE
    end if
    dim as Tko.SymbolId pick = Tko.SYMBOL_NONE, first = Tko.SYMBOL_NONE, anyp = Tko.SYMBOL_NONE
    dim as Tko.SymbolId cur = StructorNamed( syms, types, names, u, "cast" )
    dim as int32 guard = 0
    while (cur <> Tko.SYMBOL_NONE) andalso (guard < 4096)
        guard += 1
        dim as Tko.Symbol ptr cs = syms.SymbolAt( cur )
        if cs = nullptr then exit while
        dim as Tko.TypeId rt = types.Unqualify( cs->type_ )
        dim as boolean byrefRes = false
        if ast <> nullptr then
            dim as Tko.NodeId pn = cast( Tko.NodeId, cs->payload )
            if (pn <> Tko.NODE_NONE) andalso (ast->Kind( pn ) = Tko.N_PROC) then
                byrefRes = ((ast->Flags( pn ) and Tko.NF_BYREF) <> 0)
            end if
        end if
        if (rt <> Tko.TYPE_NONE) andalso (byrefRes = false) then
            if types.Kind( rt ) = Tko.TK_POINTER then
                nPtr += 1
                if first = Tko.SYMBOL_NONE then first = cur
                if w <> Tko.TYPE_NONE then
                    dim as int32 sc = PtrCastScore( types, rt, w )
                    if sc > best then
                        best = sc : ties = 1 : pick = cur
                    elseif (sc = best) andalso (sc > 0) then
                        ties += 1
                    end if
                elseif anyp = Tko.SYMBOL_NONE then
                    dim as Tko.TypeId ri = types.Unqualify( types.Inner( rt ) )
                    if (types.Kind( ri ) = Tko.TK_BUILTIN) andalso (types.BuiltinOf( ri ) = Tko.TY_ANY) then anyp = cur
                end if
            end if
        end if
        cur = cs->nextOverload
    wend
    if w <> Tko.TYPE_NONE then return pick
    if anyp <> Tko.SYMBOL_NONE then return anyp
    return first
end function

'' THE POINTER 'operator cast' LOWERING CALLS -- the pick above. Measured on fbc-modern, with
'' casts to 'any ptr', 'long ptr' and 'double ptr' in any order:
''
''     dim as double ptr p = x / byval double ptr / p = x     the EXACT pointer       [double]
''     dim as byte ptr p = x  (long ptr + any ptr)             the 'any ptr' one       [any]
''     if x then              (long ptr + any ptr)             the 'any ptr' one       [any]
''     dim as any ptr p = x   (long ptr + double ptr)          error 98, ambiguous
''
'' tiko took the first pointer overload every time, and 'pd' read a long's bytes as a double.
'' WANT is the destination, TYPE_NONE where none is named; where fbc is ambiguous, or nothing
'' matches (a call Check has already refused), this keeps the first.
function PtrCastPick _
    ( byref syms as Tko.SymbolTable, byref types as Tko.TypeContext, byref names as Tko.Interner, _
      byval udt as Tko.TypeId, byval want as Tko.TypeId ) as Tko.SymbolId

    dim as int32 nPtr, best, ties
    dim as Tko.SymbolId pick = PtrCastBest_( nullptr, syms, types, names, udt, want, nPtr, best, ties )
    if pick <> Tko.SYMBOL_NONE then return pick
    if nPtr = 0 then return Tko.SYMBOL_NONE
    return PtrCastBest_( nullptr, syms, types, names, udt, Tko.TYPE_NONE, nPtr, best, ties )
end function

'' DOES A UDT'S POINTER 'operator cast' REACH THE POINTER WANT? -1 when it declares none (not
'' this question), 0 when one does, 1 when none does, 2 when several do and none is better --
'' error 98. 'long ptr' into 'byte ptr' is error 24 by initialiser, 181 by assignment, 58 as
'' an argument.
function PtrCastFit _
    ( byref ast as Tko.AstArena, byref syms as Tko.SymbolTable, byref types as Tko.TypeContext, _
      byref names as Tko.Interner, byval udt as Tko.TypeId, byval want as Tko.TypeId ) as int32

    if (udt = Tko.TYPE_NONE) orelse (want = Tko.TYPE_NONE) then return -1
    dim as Tko.TypeId u = types.Unqualify( udt )
    if types.Kind( u ) = Tko.TK_REFERENCE then u = types.Unqualify( types.Inner( u ) )
    if types.Kind( u ) <> Tko.TK_UDT then return -1
    dim as Tko.TypeId w = types.Unqualify( want )
    if types.Kind( w ) = Tko.TK_REFERENCE then w = types.Unqualify( types.Inner( w ) )
    if types.Kind( w ) <> Tko.TK_POINTER then return -1
    dim as int32 nPtr, best, ties
    PtrCastBest_( @ast, syms, types, names, u, w, nPtr, best, ties )
    if nPtr = 0 then return -1
    if best = 0 then return 1
    if ties > 1 then return 2
    return 0
end function

'' IN AN OVERLOAD SET, does the cast yielding RES -- when it is the pick -- bind the pointer
'' parameter DST? Not when scored back it is exactly HALF; see above.
function PtrCastBindsInSet( byref types as Tko.TypeContext, byval res as Tko.TypeId, byval dst as Tko.TypeId ) as boolean
    return (PtrCastScore( types, dst, res ) <> PCS_HALF)
end function

'' Is the cast RES the one fbc picks for the pointer DST among the UDT's casts, and the only
'' one at its score? overload.tiko asks it of each cast it scores.
function PtrCastIsPick _
    ( byref ast as Tko.AstArena, byref syms as Tko.SymbolTable, byref types as Tko.TypeContext, _
      byref names as Tko.Interner, byval udt as Tko.TypeId, byval cast_ as Tko.SymbolId, _
      byval dst as Tko.TypeId ) as boolean

    dim as int32 nPtr, best, ties
    dim as Tko.SymbolId pick = PtrCastBest_( @ast, syms, types, names, udt, dst, nPtr, best, ties )
    return (pick = cast_) andalso (best > 0) andalso (ties = 1)
end function

'' WHICH NUMERIC 'operator cast' AN ARGUMENT TAKES FOR A NUMERIC PARAMETER -- the same pick as the
'' pointer one above (symbFindCastOvlProc / hCheckCastOvl), measured on fbc-modern 1.20,
'' 2026-10-17, over 11 cast types (every integer width, single, double, boolean, an enum) alone
'' and in pairs, against single procedures and overload sets:
''
''     the parameter's own type                          exact
''     any other number                                  HALF less the closeness rank of the
''                                                       cast's type in the PARAMETER's row
''     an enum cast, into anything but that enum         nothing -- fbc's 58
''     a string, pointer or 'byref as zstring' cast      nothing
''
'' -- the best wins, two at the best are 98. An enum parameter ranks as INTEGER. NumericCastPick
'' answers a different question (what an operand or a destination meets) and is not this.
private function NumCastScore_ _
    ( byref types as Tko.TypeContext, byval r as Tko.TypeId, byval d as Tko.TypeId ) as int32
    if r = d then return PCS_FULL
    if types.Kind( r ) = Tko.TK_ENUM then return 0
    dim as int32 a = FbcDt_( types, r )
    if (a < 0) orelse (a = 3) orelse (a = 6) then return 0
    dim as int32 b = 7
    if types.Kind( d ) <> Tko.TK_ENUM then b = FbcDt_( types, d )
    if (b < 0) orelse (b = 3) orelse (b = 6) then return 0
    dim as int32 w = types.Layout( types.Builtin( Tko.TY_WSTRING ) ).size
    return PCS_HALF - 10 * FbcMatchRank_( b, a, w )
end function

'' IN AN OVERLOAD SET, does the picked cast yielding R bind the numeric parameter D? Not when,
'' scored back with the parameter on the left, it is exactly HALF -- D ranked first in R's row,
'' which is R itself: a 'long' cast never reaches an overloaded 'long' parameter.
function NumCastBindsInSet( byref types as Tko.TypeContext, byval r as Tko.TypeId, byval d as Tko.TypeId ) as boolean
    dim as int32 a = FbcDt_( types, types.Unqualify( r ) ), b = FbcDt_( types, types.Unqualify( d ) )
    if (a < 0) orelse (b < 0) then return true
    return (FbcMatchRank_( a, b, types.Layout( types.Builtin( Tko.TY_WSTRING ) ).size ) <> 0)
end function

'' Is D a parameter type this pick serves: a number or an enum, not a string flavour.
function NumCastParam( byref types as Tko.TypeContext, byval d as Tko.TypeId ) as boolean
    dim as Tko.TypeId u = types.Unqualify( d )
    if types.Kind( u ) = Tko.TK_REFERENCE then u = types.Unqualify( types.Inner( u ) )
    if types.Kind( u ) = Tko.TK_ENUM then return true
    dim as int32 b = FbcDt_( types, u )
    return (b >= 0) andalso (b <> 3) andalso (b <> 6)
end function

'' The cast fbc picks for the numeric parameter D, or NONE when nothing scores; TIES is how many
'' share the best score (more than one: fbc's 98, or no match in an overload set).
function NumCastArgPick _
    ( byref ast as Tko.AstArena, byref syms as Tko.SymbolTable, byref types as Tko.TypeContext, _
      byref names as Tko.Interner, byval udt as Tko.TypeId, byval d as Tko.TypeId, _
      byref ties as int32 ) as Tko.SymbolId

    ties = 0
    if (udt = Tko.TYPE_NONE) orelse (d = Tko.TYPE_NONE) then return Tko.SYMBOL_NONE
    dim as Tko.TypeId u = types.Unqualify( udt )
    if types.Kind( u ) = Tko.TK_REFERENCE then u = types.Unqualify( types.Inner( u ) )
    if types.Kind( u ) <> Tko.TK_UDT then return Tko.SYMBOL_NONE
    dim as Tko.TypeId du = types.Unqualify( d )
    if types.Kind( du ) = Tko.TK_REFERENCE then du = types.Unqualify( types.Inner( du ) )
    dim as Tko.SymbolId pick = Tko.SYMBOL_NONE
    dim as int32 best = 0
    dim as Tko.SymbolId cur = StructorNamed( syms, types, names, u, "cast" )
    dim as int32 guard = 0
    while (cur <> Tko.SYMBOL_NONE) andalso (guard < 4096)
        guard += 1
        dim as Tko.Symbol ptr cs = syms.SymbolAt( cur )
        if cs = nullptr then exit while
        dim as Tko.TypeId rt = types.Unqualify( cs->type_ )
        if rt <> Tko.TYPE_NONE then
            if types.Kind( rt ) = Tko.TK_REFERENCE then rt = types.Unqualify( types.Inner( rt ) )
            '' a 'byref as' result spelled as a pointer to it is the thing itself
            dim as Tko.NodeId pn = cast( Tko.NodeId, cs->payload )
            if (pn <> Tko.NODE_NONE) andalso (ast.Kind( pn ) = Tko.N_PROC) andalso (types.Kind( rt ) = Tko.TK_POINTER) then
                if (ast.StmtOf( pn )->extra and Tko.PF_BYREF_RESULT) <> 0 then
                    rt = types.Unqualify( types.Inner( rt ) )
                end if
            end if
            dim as int32 sc = NumCastScore_( types, rt, du )
            if sc > best then
                best = sc : ties = 1 : pick = cur
            elseif (sc = best) andalso (sc > 0) then
                ties += 1
            end if
        end if
        cur = cs->nextOverload
    wend
    return pick
end function

'' A UDT WITH NO NUMERIC CAST BUT A 'byref as zstring|wstring' ONE, MEETING A NUMBER, is its FIRST
'' CHARACTER: measured on fbc-modern, over "ab", 'z + 1' is 98, '1 + z' 98, 'z * 2' 194, 'z = 97'
'' -1, 'z + 1.5' 98.5 -- fbc's character class is integer, and a reference to one reads it.
'' tiko concatenated ("ab1") or failed to lower. Returns that cast, or NONE; CHARTYPE is ubyte
'' for zstring and the target's wchar (ushort on Windows, ulong on Linux) for wstring.
function CharRefCastPick _
    ( byref ast as Tko.AstArena, byref syms as Tko.SymbolTable, byref types as Tko.TypeContext, _
      byref names as Tko.Interner, byval udt as Tko.TypeId, byref charType as Tko.TypeId ) as Tko.SymbolId

    charType = Tko.TYPE_NONE
    if udt = Tko.TYPE_NONE then return Tko.SYMBOL_NONE
    dim as Tko.TypeId u = types.Unqualify( udt )
    if types.Kind( u ) = Tko.TK_REFERENCE then u = types.Unqualify( types.Inner( u ) )
    if types.Kind( u ) <> Tko.TK_UDT then return Tko.SYMBOL_NONE
    if NumericCastPick( syms, types, names, u, Tko.TYPE_NONE ) <> Tko.SYMBOL_NONE then return Tko.SYMBOL_NONE
    '' A WIDE REFERENCE BEATS A NARROW ONE, either order: fbc's numeric pick takes the more precise
    '' type, and WCHAR ranks above CHAR -- measured, 'if u' and 'u + 1' over [byref as zstring,
    '' byref as wstring] call the wstring one. NARROW holds the first zstring one, for no wstring.
    dim as Tko.SymbolId narrow = Tko.SYMBOL_NONE
    dim as Tko.SymbolId cur = StructorNamed( syms, types, names, u, "cast" )
    dim as int32 guard = 0
    while (cur <> Tko.SYMBOL_NONE) andalso (guard < 4096)
        guard += 1
        dim as Tko.Symbol ptr cs = syms.SymbolAt( cur )
        if cs = nullptr then exit while
        dim as Tko.TypeId rt = types.Unqualify( cs->type_ )
        dim as boolean byRes = false
        dim as Tko.NodeId pn = cast( Tko.NodeId, cs->payload )
        if (pn <> Tko.NODE_NONE) andalso (ast.Kind( pn ) = Tko.N_PROC) then
            byRes = ((ast.Flags( pn ) and Tko.NF_BYREF) <> 0) orelse _
                    ((ast.StmtOf( pn )->extra and Tko.PF_BYREF_RESULT) <> 0)
        end if
        if rt <> Tko.TYPE_NONE then
            if types.Kind( rt ) = Tko.TK_REFERENCE then rt = types.Unqualify( types.Inner( rt ) ) : byRes = true
            if byRes andalso (types.Kind( rt ) = Tko.TK_POINTER) then rt = types.Unqualify( types.Inner( rt ) )
            if byRes andalso (types.Kind( rt ) = Tko.TK_BUILTIN) then
                select case types.BuiltinOf( rt )
                case Tko.TY_ZSTRING
                    if narrow = Tko.SYMBOL_NONE then narrow = cur
                case Tko.TY_WSTRING
                    charType = types.Builtin( iif( types.target.wcharBytes = 4, Tko.TY_ULONG, Tko.TY_USHORT ) )
                    return cur
                end select
            end if
        end if
        cur = cs->nextOverload
    wend
    if narrow <> Tko.SYMBOL_NONE then charType = types.Builtin( Tko.TY_UBYTE )
    return narrow
end function

function NumericCastPick _
    ( byref syms as Tko.SymbolTable, byref types as Tko.TypeContext, byref names as Tko.Interner, _
      byval udt as Tko.TypeId, byval want as Tko.TypeId ) as Tko.SymbolId

    if udt = Tko.TYPE_NONE then return Tko.SYMBOL_NONE
    dim as Tko.TypeId u = types.Unqualify( udt )
    if types.Kind( u ) = Tko.TK_REFERENCE then u = types.Unqualify( types.Inner( u ) )
    if types.Kind( u ) <> Tko.TK_UDT then return Tko.SYMBOL_NONE
    '' Only a NUMBER is something to meet: a UDT, a string or a pointer leaves the rank.
    dim as Tko.TypeId w = Tko.TYPE_NONE
    if want <> Tko.TYPE_NONE then
        w = types.Unqualify( want )
        if types.Kind( w ) = Tko.TK_REFERENCE then w = types.Unqualify( types.Inner( w ) )
        '' A BOOLEAN meets the cast nearest a BYTE: measured, fbc takes byte over double and ubyte,
        '' short over ulong, longint over single, single over double for 'dim as boolean b = m'.
        if types.Kind( w ) = Tko.TK_BUILTIN then
            if types.BuiltinOf( w ) = Tko.TY_BOOLEAN then w = types.Builtin( Tko.TY_BYTE )
        end if
        if NumericCastRank( types, w ) = 0 then w = Tko.TYPE_NONE
    end if
    dim as Tko.SymbolId best = Tko.SYMBOL_NONE
    dim as int32 bestCost = CONV_NONE, bestRank = 0
    dim as Tko.SymbolId cur = StructorNamed( syms, types, names, u, "cast" )
    dim as int32 guard = 0
    while (cur <> Tko.SYMBOL_NONE) andalso (guard < 4096)
        guard += 1
        dim as Tko.Symbol ptr cs = syms.SymbolAt( cur )
        if cs = nullptr then exit while
        dim as Tko.TypeId rt = types.Unqualify( cs->type_ )
        dim as int32 rk = 0
        if rt <> Tko.TYPE_NONE then
            if types.Kind( rt ) = Tko.TK_ENUM then rk = NumericCastRank( types, rt )
            if types.Kind( rt ) = Tko.TK_BUILTIN then
                select case types.BuiltinOf( rt )
                case Tko.TY_STRING, Tko.TY_ZSTRING, Tko.TY_WSTRING, Tko.TY_USTRING, Tko.TY_VOID
                case else
                    rk = NumericCastRank( types, rt )
                    if rk = 0 then rk = 1   '' a number the rank table does not list still counts
                end select
            end if
        end if
        if rk > 0 then
            dim as int32 cost = 0
            if w <> Tko.TYPE_NONE then cost = ConversionCost( rt, w, types )
            if (cost < bestCost) orelse ((cost = bestCost) andalso (rk > bestRank)) then
                best = cur : bestCost = cost : bestRank = rk
            end if
        end if
        cur = cs->nextOverload
    wend
    return best
end function

'' THE COPY CONSTRUCTOR of a UDT, or NONE: a constructor whose FIRST parameter is the type itself
'' (by reference, const or not) and, with DEFAULTED, whose every other parameter has a default.
'' TWO QUESTIONS, and fbc answers them differently. Measured on fbc-modern, with
'' 'constructor( byref r as T, byval extra as long = 0 )' beside 'constructor( byval n as long )':
''
''     dim as T b = a              the defaulted one copies      101   (DEFAULTED = true)
''     dim as T g = gives( )       it copies on return AND here  205
''     takes( a ) / byval          no copy at all                  1   (DEFAULTED = false)
''
'' fbc's own copy-constructor FACT (symb-comp.bas, symbCheckCompCtor) counts a constructor of
'' exactly one parameter, so the type stays trivial -- passed by value, returned in registers --
'' while an initialiser still resolves the overload and finds the defaulted copy.
function CopyStructorOf _
    ( byref ast as Tko.AstArena, byref syms as Tko.SymbolTable, byref types as Tko.TypeContext, _
      byref names as Tko.Interner, byref info as Tko.SemanticInfo, byval t as Tko.TypeId, _
      byval defaulted as boolean ) as Tko.SymbolId

    if t = Tko.TYPE_NONE then return Tko.SYMBOL_NONE
    dim as Tko.TypeId u = types.Unqualify( t )
    if types.Kind( u ) <> Tko.TK_UDT then return Tko.SYMBOL_NONE
    dim as Tko.SymbolId cur = StructorNamed( syms, types, names, u, "__ctor" )
    dim as int32 guard = 0
    while (cur <> Tko.SYMBOL_NONE) andalso (guard < 10000)
        guard += 1
        dim as Tko.Symbol ptr s = syms.SymbolAt( cur )
        if s = nullptr then exit while
        dim as Tko.NodeId pn = SpProcNode_( ast, syms, cur )
        if pn <> Tko.NODE_NONE then
            dim as Tko.StmtPayload ptr pp = SpStmt_( ast, pn )
            dim as int32 seen = 0
            dim as boolean ok = false
            for i as int32 = 0 to pp->count - 1
                dim as Tko.NodeId prm = ast.ChildAt( pp->first, i )
                if ast.Kind( prm ) <> Tko.N_PARAM then continue for
                if seen = 0 then
                    dim as Tko.TypeId pt = info.TypeOf_( SpStmt_( ast, prm )->a )
                    if pt = Tko.TYPE_NONE then exit for
                    pt = types.Unqualify( pt )
                    if types.Kind( pt ) = Tko.TK_REFERENCE then pt = types.Unqualify( types.Inner( pt ) )
                    ok = (pt = u)
                    if ok = false then exit for
                elseif (defaulted = false) orelse (SpStmt_( ast, prm )->b = Tko.NODE_NONE) then
                    ok = false
                    exit for
                end if
                seen += 1
            next
            if ok then return cur
        end if
        cur = s->nextOverload
    wend
    return Tko.SYMBOL_NONE
end function

'' A STRING CAST REACHING A STRING OF ITS OWN WIDTH -- narrow to narrow, wide to wide -- is
'' closer than one changing width. Measured, offered 'p( byref as const wstring )' and
'' 'p( byref as const string )', a UDT with 'operator cast( ) byref as zstring' picks STRING
'' and one with 'byref as wstring' WSTRING. Both scored the flat cast-and-convert tier, and
'' the call was ambiguous (structs/implicit-cast.bas). USTRING counts as wide.
function StringSameWidth _
    ( byref types as Tko.TypeContext, byval a as Tko.TypeId, byval b as Tko.TypeId ) as boolean

    if (types.Kind( a ) <> Tko.TK_BUILTIN) orelse (types.Kind( b ) <> Tko.TK_BUILTIN) then return false
    dim as Tko.BuiltinType ab = types.BuiltinOf( a ), bb = types.BuiltinOf( b )
    select case ab
    case Tko.TY_STRING, Tko.TY_ZSTRING
        return (bb = Tko.TY_STRING) orelse (bb = Tko.TY_ZSTRING)
    case Tko.TY_WSTRING, Tko.TY_USTRING
        return (bb = Tko.TY_WSTRING) orelse (bb = Tko.TY_USTRING)
    end select
    return false
end function

end namespace
