'' derive.tiko -- Sem's judgement of 'derive' lines and of 'hashvalue( k )' (RFC 0019).
''
'' WHERE EACH ERROR IS REPORTED (R7, R8):
''
''   a type that is not generic    at its 'derive' line, once, whether or not anything is
''                                 compared or hashed (CheckDerives_)
''   a generic instance            at the comparison or the hashvalue( ) that needs it, with a
''                                 note at the template's 'derive' line -- so Box( of Opaque_ )
''                                 with 'derive equal' compiles until two of them are compared
''   a type read from an interface never: the module that declares it judged it already
''
'' What a field may be is symbols/derivetype.tiko's, shared with Check and lowering.

#import "std/containers"
#include once "symbols/sem.ti"
#include once "diag/diagids.ti"
#include once "symbols/check.ti"
#include once "symbols/modsym.ti"
#include once "types/udtlayout.ti"

namespace Tko.Sem

#include once "symbols/visctx.ti"
#include once "symbols/semcalls.ti"

private function UdtSymOfType_( byref c as Ctx, byval t as TypeId ) as Symbol ptr
    if c.types->Kind( t ) <> TK_UDT then return nullptr
    dim as InternId tn = c.types->NameOf( t )
    if tn = 0 then return nullptr
    dim as ScopeId ds = cast( ScopeId, c.types->DeclScopeOf( t ) )
    dim as SymbolId ts = c.syms->LookupLocalTyped( ds, tn, true )
    if ts = SYMBOL_NONE then ts = c.syms->LookupTyped( ds, tn, true )
    return c.syms->SymbolAt( ts )
end function

private function IsGenericInst_( byref c as Ctx, byval t as TypeId ) as boolean
    '' An instance's symbol carries its TEMPLATE's N_TYPE (generic.tiko), whose 'b' is the
    '' parameter list; no flag marks the instance's own UDT symbol.
    dim as Symbol ptr s = UdtSymOfType_( c, t )
    if s = nullptr then return false
    dim as NodeId tn = cast( NodeId, s->payload )
    if (tn = NODE_NONE) orelse (c.ast->Kind( tn ) <> N_TYPE) then return false
    return c.ast->StmtOf( tn )->b <> NODE_NONE
end function

private sub NoteDeriveLine_( byref c as Ctx, byval locNode as NodeId )
    if locNode <> NODE_NONE then c.diags->AddNote( TKO0901, PointRange( c.ast->Loc( locNode ) ) )
end sub

'' TKO1261 / TKO1262 for type t at 'at', with its first gap. True when one was reported.
private function ReportGap_( byref c as Ctx, byval t as TypeId, byval hashGap as boolean, _
                             byval at as SourceLoc, byval locNode as NodeId, byval withNote as boolean ) as boolean
    dim as SymbolId f = SYMBOL_NONE : dim as TypeId ft = TYPE_NONE
    '' A BITFIELD IS NOT DERIVED in this build: its value is bits inside a shared unit, which the
    '' lowering does not extract (RFC 0019 section 13, a P1 limit).
    dim as containers.Array( of uint32 ) bfs, bft
    Tko.Check.DeriveFields( *c.syms, *c.types, *c.names, t, bfs, bft )
    for i as int32 = 0 to bfs.Count - 1
        dim as Symbol ptr bs = c.syms->SymbolAt( cast( SymbolId, bfs[i] ) )
        if bs = nullptr then continue for
        if (bs->flags and SYMF_BITFIELD) = 0 then continue for
        c.diags->Report( TKO0992, PointRange( at ), "derive over the bitfield '" & c.names->Spelling( bs->name ) & "'" )
        if withNote then NoteDeriveLine_( c, locNode )
        return true
    next
    dim as boolean gap
    if hashGap then
        gap = Tko.Check.DeriveHashGap( *c.ast, *c.syms, *c.types, *c.names, t, f, ft )
    else
        gap = Tko.Check.DeriveEqualGap( *c.ast, *c.syms, *c.types, *c.names, *c.info, t, f, ft )
    end if
    if gap = false then return false
    dim as Symbol ptr fs = c.syms->SymbolAt( f )
    dim as string fname = iif( fs <> nullptr, c.names->Spelling( fs->name ), "?" )
    c.diags->Report( iif( hashGap, TKO1262, TKO1261 ), PointRange( at ), c.types->Name( t ), fname, c.types->Name( ft ) )
    if withNote then NoteDeriveLine_( c, locNode )
    return true
end function

'' Called from CheckUdtCompare_ (proccheck.tiko) for '=' / '<>' over two of one type with no
'' operator bound: true when the comparison is a derived one, judged here.
function DerivedCompareJudged_ _
    ( byref c as Ctx, byval id as NodeId, byref opnm as string, byval lt as TypeId, byval rt as TypeId ) as boolean
    if (opnm <> "=") andalso (opnm <> "<>") then return false
    if (lt <> rt) orelse (c.types->Kind( lt ) <> TK_UDT) then return false
    if c.info->RefOf( id ) <> SYMBOL_NONE then return false
    dim as NodeId ln
    if (Tko.Check.DeriveMaskOf( *c.ast, *c.syms, *c.types, lt, ln ) and DERIVE_EQUAL) = 0 then return false
    if IsGenericInst_( c, lt ) then ReportGap_( c, lt, false, c.ast->Loc( id ), ln, true )
    return true
end function

'' 'hashvalue( k )', unbound (the program's own hashvalue is left alone). Called from
'' CheckArgConversions_ (assigncheck.tiko) as TryCastJudged_ is: true when this is that call.
function HashValueJudged_( byref c as Ctx, byval id as NodeId ) as boolean
    dim as ListPayload ptr lp = c.ast->ListOf( id )
    if (lp->count <> 1) orelse (c.ast->Kind( lp->target ) <> N_IDENT) then return false
    if c.names->Spelling( c.names->Fold( c.ast->IdentOf( lp->target )->name ) ) <> "hashvalue" then return false
    if c.info->RefOf( lp->target ) <> SYMBOL_NONE then return false
    dim as NodeId an = c.ast->ChildAt( lp->first, 0 )
    dim as TypeId at = c.info->TypeOf_( an )
    if at = TYPE_NONE then return true                         '' already reported where it failed
    dim as int32 hk = Tko.Check.HashKindOf( *c.ast, *c.syms, *c.types, *c.names, at )
    if hk = Tko.Check.HK_NONE then
        c.diags->Report( TKO1266, PointRange( c.ast->Loc( an ) ), c.types->Name( c.types->Unqualify( at ) ) )
    elseif hk = Tko.Check.HK_DERIVED then
        dim as TypeId ut = c.types->Unqualify( at )
        if c.types->Kind( ut ) = TK_REFERENCE then ut = c.types->Unqualify( c.types->Inner( ut ) )
        if IsGenericInst_( c, ut ) then
            dim as NodeId ln
            Tko.Check.DeriveMaskOf( *c.ast, *c.syms, *c.types, ut, ln )
            ReportGap_( c, ut, true, c.ast->Loc( an ), ln, true )
        end if
    end if
    return true
end function

'' Every type that is not generic and not read from an interface, judged at its 'derive' line.
sub CheckDerives_( byref c as Ctx )
    if c.ast->deriveLists.Count = 0 then return
    for i as int32 = 1 to c.syms->Count( ) - 1
        dim as Symbol ptr s = c.syms->SymbolAt( cast( SymbolId, i ) )
        if s = nullptr then continue for
        if s->kind <> cast( uint8, SYM_UDT ) then continue for
        if (s->flags and SYMF_IMPORTED) <> 0 then continue for
        dim as NodeId tn = cast( NodeId, s->payload )
        if (tn = NODE_NONE) orelse (c.ast->Kind( tn ) <> N_TYPE) then continue for
        if c.ast->StmtOf( tn )->b <> NODE_NONE then continue for   '' a template: its instances answer
        dim as NodeId ln
        dim as uint32 mask = DeriveOf( *c.ast, tn, ln )
        if mask = 0 then continue for
        dim as TypeId t = s->type_
        if (t = TYPE_NONE) orelse (c.types->Kind( t ) <> TK_UDT) then continue for
        dim as SourceLoc at = c.ast->Loc( ln )
        dim as string tname = c.types->Name( t )
        if (mask and DERIVE_EQUAL) <> 0 then
            for k as int32 = 0 to 1
                dim as string opn = iif( k = 0, "=", "<>" )
                dim as SymbolId w = Tko.Check.UdtWrittenCmpOp( *c.ast, *c.syms, *c.types, *c.names, *c.info, t, opn )
                if w <> SYMBOL_NONE then
                    c.diags->Report( TKO1263, PointRange( at ), tname, opn )
                    dim as Symbol ptr ws = c.syms->SymbolAt( w )
                    if ws <> nullptr then
                        if ws->payload <> 0 then c.diags->AddNote( TKO0901, PointRange( c.ast->Loc( cast( NodeId, ws->payload ) ) ) )
                    end if
                end if
            next
            ReportGap_( c, t, false, at, ln, false )
        end if
        if (mask and DERIVE_HASH) <> 0 then
            if (mask and DERIVE_EQUAL) = 0 then
                c.diags->Report( TKO1264, PointRange( at ), tname )
            elseif Tko.Check.UdtHashOfMethod( *c.ast, *c.syms, *c.types, *c.names, t ) <> SYMBOL_NONE then
                c.diags->Report( TKO1265, PointRange( at ), tname )
            else
                ReportGap_( c, t, true, at, ln, false )
            end if
        end if
    next
end sub

end namespace
