'' resolvesel.tiko -- what 'SELECT CASE AS CONST' refuses that a plain SELECT accepts.
''
'' Included from resolve.tiko, inside its namespace.
''
'' AS CONST is not a hint. fbc builds a JUMP TABLE for it, and a table has to be
'' indexed by a number that is known now, so four things it accepts in a plain SELECT
'' become errors here. Measured, one probe each:
''
''     case is > 5            error 9    refused at the 'is' -- in the PARSER
''     case y                 error 11   "Expected constant"
''     case 1 to 0            error 323  start greater than end
''     case 0 to 8192         error 69   "Range too large"
''
'' THE SPAN IS ACROSS THE WHOLE STATEMENT, not per case, and that is the part a
'' per-case test gets wrong. 'case 0 to 100' followed by 'case 11000 to 11100' is 202
'' values and fbc still refuses it, at the SECOND case: what it measures is
'' max - min + 1 over every case seen so far, and the limit is 8192. Bisected:
''
''     case 0 to 8191                     8192 values   accepted
''     case 0 to 8192                     8193          error 69
''     case 1 to 8192                     8192          accepted
''     case 0 / case 8191                 span 8192     accepted
''     case 0 / case 8192                 span 8193     error 69
''     case -4000 to 0 / case 1 to 4191   span 8192     accepted
''     case -4000 to 0 / case 1 to 4192   span 8193     error 69
''
'' -- so it is the SPAN and not the count, and a negative start is no different.
''
'' AND A VALUE APPEARS ONCE: a repeated one is fbc's error 4, "Duplicated definition"
'' (TKO0977), over a repeat in one case, across two cases, or inside an earlier range.
''
'' NOT DONE HERE: fbc's error 24, "Invalid data types", for a non-integral subject
'' ('select case as const' over a string or a float). That needs the subject's TYPE,
'' and this runs while types are still being resolved -- proccheck.tiko does it.
const SELCONST_SPAN_MAX = 8192

'' One case value, folded. Returns false when it does not fold -- the caller reports.
private function SelConstVal_ _
    ( byref c as Ctx, byval id as Tko.NodeId, byval here as Tko.ScopeId, _
      byref outv as int64 ) as boolean

    dim as Tko.Check.ConstVal v = Tko.Check.ConstOf( _
        *c.ast, id, *c.srcMgr, *c.names, 64, c.syms, here )
    if v.known = false then return false
    outv = v.value
    return true
end function

'' 'const N = lbound( a )' NEEDS A BOUND THAT IS KNOWN NOW -- fbc error 11, "Expected
'' constant". A FIXED array's bounds are known and fold; a DYNAMIC one's are not, a BYDESC
'' parameter's are not, an ELLIPSIS bound is not, and a VARIABLE dimension argument means
'' fbc cannot tell which bound is being asked for even when it knows them all.
''
'' MEASURED:
''     dim a(0 to 3) as integer   : const N = lbound( a )       OK
''     dim a() as integer         : const N = lbound( a )       error 11
''     dim a(0 to 3, 1 to 5) ...  : const N = ubound( a, 2 )    OK
''     ...                        : const N = ubound( a, i )    error 11
''     dim n as integer = lbound( a )                           OK -- a DIM is not a const
''
'' IT REPORTS ONLY WHAT IT CAN POSITIVELY ESTABLISH IS NOT CONSTANT -- a DYNAMIC array, or
'' a dimension argument that does not fold. Asking "did the fold succeed" instead measured
'' THIS compiler's folder against fbc's rather than measuring fbc: tiko-lang does not fold
'' lbound of a FIXED array either, so all three of the accepted lines above were refused.
private sub ConstBoundCheck_ _
    ( byref c as Ctx, byval item as Tko.NodeId, byval here as Tko.ScopeId )

    dim as Tko.StmtPayload ptr ip = StmtOf( c, item )
    if ip = nullptr then return
    if ip->b = Tko.NODE_NONE then return
    if c.ast->Kind( ip->b ) <> Tko.N_CALL then return
    dim as Tko.ListPayload ptr lp = _
        @c.ast->lists[cast( int32, c.ast->nodes[cast( int32, ip->b )].data )]
    if lp->target = Tko.NODE_NONE then return
    if c.ast->Kind( lp->target ) <> Tko.N_IDENT then return
    '' A USER SYMBOL OF THAT NAME IS NOT THE INTRINSIC.
    if c.info->RefOf( lp->target ) <> Tko.SYMBOL_NONE then return
    dim as Tko.InternId nm = _
        c.ast->idents[cast( int32, c.ast->nodes[cast( int32, lp->target )].data )].name
    dim as string spell = c.names->Spelling( nm )
    if (spell <> "lbound") andalso (spell <> "ubound") then return
    if lp->count < 1 then return

    '' THE DIMENSION ARGUMENT, when written: 'ubound( a, 2 )' is constant, 'ubound( a, i )'
    '' is not -- and fbc refuses the latter even over an array whose bounds it knows,
    '' because it cannot tell WHICH bound is being asked for.
    if lp->count >= 2 then
        dim as Tko.NodeId dimArg = cast( Tko.NodeId, c.ast->children[lp->first + 1] )
        dim as int64 dv = 0
        if SelConstVal_( c, dimArg, here, dv ) = false then
            c.diags->Report( Tko.TKO0674, Tko.PointRange( c.ast->Loc( ip->b ) ) )
            return
        end if
    end if

    '' THE ARRAY ITSELF IS ASKED ABOUT LATER, in the post-Check pass: here its symbol has
    '' no type yet -- this walk is what gives declarations theirs -- so IsDynArray said no
    '' to every one of them.
end sub

'' INTEGER DIVISION BY A CONSTANT ZERO -- fbc error 100, at CONSTANT-EVALUATION time.
'' The fold already declines on a zero divisor; it declined SILENTLY, so 'print 1 \\ 0'
'' compiled.
''
'' MEASURED, and every part of the boundary matters:
''     print 1 \\ 0                  error 100
''     print 1 mod 0                error 100
''     const K = 0 : print 1 \\ K    error 100   a NAMED constant counts
''     print 1 / 0                  OK          FLOAT division is not this
''     dim z as integer = 0
''     print 1 \\ z                  OK          a variable is not constant
private sub DivByConstZero_ _
    ( byref c as Ctx, byval id as Tko.NodeId, byval here as Tko.ScopeId )

    dim as Tko.BinaryPayload ptr bp = _
        @c.ast->binaries[cast( int32, c.ast->nodes[cast( int32, id )].data )]
    select case cast( Tko.TokenKind, bp->op )
    case Tko.TK_BACKSLASH, Tko.KW_MOD
    case else
        return
    end select
    if bp->rhs = Tko.NODE_NONE then return
    dim as int64 rv = 0
    if SelConstVal_( c, bp->rhs, here, rv ) = false then return
    if rv <> 0 then return
    c.diags->Report( Tko.TKO0671, Tko.PointRange( c.ast->Loc( id ) ) )
end sub

'' Reports on the FIRST case that pushes the span over, which is where fbc reports it.
private sub SelectConstCheck_ _
    ( byref c as Ctx, byval id as Tko.NodeId, byval here as Tko.ScopeId )

    dim as Tko.StmtPayload ptr sp = StmtOf( c, id )
    if sp = nullptr then return
    if cast( Tko.TokenKind, sp->op ) <> Tko.KW_CONST then return
    if sp->b = Tko.NODE_NONE then return

    dim as Tko.ListPayload ptr lp = _
        @c.ast->lists[cast( int32, c.ast->nodes[cast( int32, sp->b )].data )]

    dim as boolean seen = false
    dim as int64 lo = 0, hi = 0
    '' Every value or range so far, for the DUPLICATE test: fbc's error 4 at the case that
    '' repeats one -- 'case 1, 1', 'case 1' twice, 'case 3' inside an earlier '2 to 4',
    '' and two ranges that share an end. A plain SELECT takes the first match instead.
    dim as containers.Array( of int64 ) prevLo, prevHi
    '' ...SPLIT INTO POINTS AND RANGES, to find the FIRST earlier one that overlaps without
    '' scanning them all per case (cases^2 for a big 'select case as const'): ptAt is a point
    '' value -> its first k, rangeK every range's k in order. The answer is the same k.
    dim as containers.Map( of int64, int32 ) ptAt
    dim as containers.Array( of int32 ) rangeK
    dim as int32 nPoints = 0

    for i as int32 = 0 to lp->count - 1
        dim as Tko.NodeId cs = cast( Tko.NodeId, c.ast->children[lp->first + i] )
        if c.ast->Kind( cs ) <> Tko.N_CASE then continue for
        dim as Tko.StmtPayload ptr csp = StmtOf( c, cs )
        if csp = nullptr then continue for

        for j as int32 = 0 to csp->count - 1
            dim as Tko.NodeId pn = cast( Tko.NodeId, c.ast->children[csp->first + j] )
            if pn = Tko.NODE_NONE then continue for

            dim as int64 a = 0, b = 0
            dim as Tko.NodeId loc = pn

            if c.ast->Kind( pn ) = Tko.N_CASE_RANGE then
                dim as Tko.StmtPayload ptr rp = StmtOf( c, pn )
                if rp = nullptr then continue for
                '' 'case is <rel>' already drew TKO0419 in the parser; folding it
                '' here would draw a second error for one mistake.
                if cast( Tko.TokenKind, rp->op ) <> 0 then continue for
                if SelConstVal_( c, rp->a, here, a ) = false then
                    c.diags->Report( Tko.TKO0614, Tko.PointRange( c.ast->Loc( rp->a ) ) )
                    continue for
                end if
                if SelConstVal_( c, rp->b, here, b ) = false then
                    c.diags->Report( Tko.TKO0614, Tko.PointRange( c.ast->Loc( rp->b ) ) )
                    continue for
                end if
                if a > b then
                    c.diags->Report( Tko.TKO0615, Tko.PointRange( c.ast->Loc( pn ) ) )
                    continue for
                end if
            else
                if SelConstVal_( c, pn, here, a ) = false then
                    c.diags->Report( Tko.TKO0614, Tko.PointRange( c.ast->Loc( pn ) ) )
                    continue for
                end if
                b = a
            end if

            dim as int32 hit = -1
            for r as int32 = 0 to rangeK.Count - 1
                dim as int32 k = rangeK[r]
                if (a <= prevHi[k]) andalso (b >= prevLo[k]) then
                    hit = k
                    exit for
                end if
            next
            dim as int32 pk = -1
            if a = b then
                if ptAt.TryGet( a, pk ) then
                    if (hit < 0) orelse (pk < hit) then hit = pk
                end if
            elseif ((b - a) > 0) andalso ((b - a) < nPoints) andalso (b < &h7FFFFFFFFFFFFFFFll) then
                for v as int64 = a to b
                    if ptAt.TryGet( v, pk ) then
                        if (hit < 0) orelse (pk < hit) then hit = pk
                    end if
                next
            else
                for k as int32 = 0 to prevLo.Count - 1
                    if (hit >= 0) andalso (k >= hit) then exit for
                    if (prevLo[k] = prevHi[k]) andalso (a <= prevHi[k]) andalso (b >= prevLo[k]) then
                        hit = k
                        exit for
                    end if
                next
            end if
            if hit >= 0 then
                c.diags->Report( Tko.TKO0977, Tko.PointRange( c.ast->Loc( loc ) ), _
                                 str( iif( a > prevLo[hit], a, prevLo[hit] ) ) )
            end if
            if a = b then
                if ptAt.Contains( a ) = false then ptAt.Put( a, prevLo.Count )
                nPoints += 1
            else
                rangeK.Push( prevLo.Count )
            end if
            prevLo.Push( a )
            prevHi.Push( b )

            if seen = false then
                seen = true
                lo = a
                hi = b
            else
                if a < lo then lo = a
                if b > hi then hi = b
            end if

            if (hi - lo + 1) > SELCONST_SPAN_MAX then
                c.diags->Report( Tko.TKO0616, Tko.PointRange( c.ast->Loc( loc ) ), _
                                 str( SELCONST_SPAN_MAX ) )
                return
            end if
        next
    next
end sub
