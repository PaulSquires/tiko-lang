'' builtinarity.tiko -- A BUILTIN WITH THE WRONG NUMBER OF ARGUMENTS, OR NONE: CheckBuiltinArity_,
'' asked of every N_CALL, CheckBuiltinStmt_, of every N_AMBIGUOUS, and CheckBareBuiltin_, of
'' every N_IDENT.
''
'' Included from latesweeps4.tiko, in the same namespace and over the same Ctx; moved out of it
'' 2026-10-10, when it reached the line cap.

'' A BUILTIN FUNCTION WITH THE WRONG NUMBER OF ARGUMENTS, or none at all. Measured on
'' fbc-modern 1.20, 2026-09-28, over each name with 0, 1, 2 and 3 arguments and with none:
''
''     one exactly        len sizeof abs sqr sgn int fix sin cos tan atn exp log frac str
''     one or two         asc ucase lcase trim ltrim rtrim
''     two or three       mid instr
''     one or more        chr
''     two exactly        name -- the function form of NAME; 0 and 1 were TKO0994 (2026-10-11)
''
'' Too few is error 9 (16 for mid and instr), too many error 7, and the bare name error 6.
'' tiko dropped every one of those statements in silence -- 'print len( s, 2 )' printed
'' nothing. Library functions ('val', 'hex', 'left', 'space') are fbc's overloaded
'' declarations with their own errors, and are not in the table.
private function BuiltinArity_ ( byref nm as string, byref lo as int32, byref hi as int32 ) as boolean
    select case nm
    case "len", "sizeof", "abs", "sqr", "sgn", "int", "fix", "sin", "cos", "tan", "atn", _
         "exp", "log", "frac", "str"
        lo = 1 : hi = 1
    case "asc", "ucase", "lcase", "trim", "ltrim", "rtrim"
        lo = 1 : hi = 2
    case "mid", "instr"
        lo = 2 : hi = 3
    case "chr"
        lo = 1 : hi = 9999
    case "name"
        lo = 2 : hi = 2
    case else
        return false
    end select
    return true
end function

'' THE RUNTIME BUILTINS LOWERING CLAIMS BY SPELLING (lowerbuiltin.tiko BuiltinProcRtl), by
'' argument count. Lowering reported TKO0801 when one of these declined in a statement it then
'' dropped; the count is the part a sweep can judge, so it is judged here (review MIR-04,
'' LATER-PLAN D step 1). Measured on fbc-modern 1.20, 2026-10-24: each name as a statement and
'' as a call with 0 to 4 integer arguments, and with a string first argument where it takes one.
'' Too few or too many is fbc's error 1 (99 for bsave, dylibsymbol and reset's second). Left
'' out: width and seek, whose statement and function forms take different counts, and end,
'' which is a statement keyword.
private function RtlBuiltinArity_ ( byref nm as string, byref lo as int32, byref hi as int32 ) as boolean
    select case nm
    case "mutexcreate", "getkey"
        lo = 0 : hi = 0
    case "allocate", "deallocate", "mutexdestroy", "mutexlock", "mutexunlock", "chain", _
         "dylibload", "dylibfree", "setdate", "settime", "pointcoord"
        lo = 1 : hi = 1
    case "stop", "reset", "screenlist"
        lo = 0 : hi = 1
    case "pcopy"
        lo = 0 : hi = 2
    case "callocate", "run"
        lo = 1 : hi = 2
    case "bload"
        lo = 1 : hi = 3
    case "reallocate", "dylibsymbol", "out", "pmap"
        lo = 2 : hi = 2
    case "wait"
        lo = 2 : hi = 3
    case "bsave"
        lo = 2 : hi = 4
    case "clear"
        lo = 3 : hi = 3
    case else
        return false
    end select
    return true
end function

'' ...AND THE LIBRARY FUNCTIONS WRITTEN AS A STATEMENT WITH NOTHING AFTER THEM: 'hex' alone on a
'' line. fbc: error 99 for hex, oct, bin and their w-forms, left, right and the val family, 1 for
'' space and wspace (measured with the table above). With an argument each is a value used as a
'' statement -- another rule's business (valuestmt.tiko).
private function NeedsArguments_ ( byref nm as string ) as boolean
    select case nm
    case "hex", "oct", "bin", "whex", "woct", "wbin", "space", "wspace", "left", "right", _
         "val", "valint", "vallng", "valuint", "valulng"
        return true
    end select
    return false
end function

private function UnboundName_ ( byref c as Ctx, byval n as NodeId ) as string
    if (n = NODE_NONE) orelse (c.ast->Kind( n ) <> N_IDENT) then return ""
    if c.info->RefOf( n ) <> SYMBOL_NONE then return ""
    return lcase( c.names->Spelling( c.ast->IdentOf( n )->name ) )
end function

'' 'wait 1', 'stop 1, 2', 'hex': a statement whose callee is an unbound builtin's spelling, with
'' arguments no form of it takes. Reported at the callee, where lowering reported it.
private sub CheckBuiltinStmt_ ( byref c as Ctx, byval id as NodeId )
    select case c.info->AmbiguousOf( id )
    case AMB_CALL, AMB_UNRESOLVED
    case else
        return
    end select
    dim as StmtPayload ptr sp = c.ast->StmtOf( id )
    if sp->b <> NODE_NONE then return
    dim as string nm = UnboundName_( c, sp->a )
    if len( nm ) = 0 then return
    dim as int32 lo, hi
    dim as boolean bad = false
    if RtlBuiltinArity_( nm, lo, hi ) then
        bad = (sp->count < lo) orelse (sp->count > hi)
    elseif sp->count = 0 then
        bad = NeedsArguments_( nm )
    end if
    if bad then c.diags->Report( TKO0801, PointRange( c.ast->Loc( sp->a ) ), nm )
end sub

private sub CheckBuiltinArity_ ( byref c as Ctx, byval id as NodeId )
    dim as ListPayload ptr lp = c.ast->ListOf( id )
    if (lp->target = NODE_NONE) orelse (c.ast->Kind( lp->target ) <> N_IDENT) then return
    if c.info->RefOf( lp->target ) <> SYMBOL_NONE then return
    if c.info->RefOf( id ) <> SYMBOL_NONE then return
    dim as string nm = lcase( c.names->Spelling( _
        c.ast->IdentOf( lp->target )->name ) )
    dim as int32 lo, hi
    if BuiltinArity_( nm, lo, hi ) = false then
        if RtlBuiltinArity_( nm, lo, hi ) = false then return
    end if
    if (lp->count >= lo) andalso (lp->count <= hi) then return
    c.diags->Report( TKO0801, PointRange( c.ast->Loc( id ) ), nm )
end sub

'' Is 'id' the FIELD of an 'offsetof( T, field )'? Then it names a field and no builtin:
'' 'offsetof( FBSTRING, len )' over tiko-rt's descriptor was TKO0872, "'len' needs an
'' argument list" (fbc accepts it). Asked only when about to report, so the scan over
'' every call costs the ordinary path nothing.
private function IsOffsetofField_ ( byref c as Ctx, byval id as NodeId ) as boolean
    for i as int32 = 1 to c.ast->Count( )
        if c.ast->Kind( cast( NodeId, i ) ) <> N_CALL then continue for
        dim as ListPayload ptr lp = c.ast->ListOf( i )
        if lp->count <> 2 then continue for
        if cast( NodeId, c.ast->ChildSlot( lp->first + 1 ) ) <> id then continue for
        if (lp->target = NODE_NONE) orelse (c.ast->Kind( lp->target ) <> N_IDENT) then continue for
        dim as string cn = lcase( c.names->Spelling( _
            c.ast->IdentOf( lp->target )->name ) )
        return (cn = "offsetof")
    next
    return false
end function

'' ...and the bare name, 'print len': a name no call owns (NF_CALL_TARGET marks one that is).
private sub CheckBareBuiltin_ ( byref c as Ctx, byval id as NodeId )
    if (c.ast->Flags( id ) and NF_CALL_TARGET) <> 0 then return
    if c.info->RefOf( id ) <> SYMBOL_NONE then return
    dim as string nm = lcase( c.names->Spelling( c.ast->IdentOf( id )->name ) )
    dim as int32 lo, hi
    if BuiltinArity_( nm, lo, hi ) = false then return
    if IsOffsetofField_( c, id ) then return
    c.diags->Report( TKO0872, PointRange( c.ast->Loc( id ) ), nm )
end sub
