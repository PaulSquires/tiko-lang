'' procptrdecl.tiko -- WHERE A PROCEDURE POINTER'S PARAMETER DEFAULTS ARE WRITTEN.
''
'' Included, as private functions, by the late check that counts a pointer call's
'' arguments (symbols/latechecks.tiko) and by the lowering that fills the omitted ones in
'' (mir/lowerparam.tiko). Fully qualified, so it lands in either namespace.
''
'' A DEFAULT BELONGS TO THE DECLARATION, NOT TO THE TYPE. Measured on fbc:
''
''     type FP2 as function( byval as integer, byval as integer = 7 ) as integer
''     dim fq as FP2 = @g3                 '' g3 itself has no default
''     dim fr as function( byval as integer, byval as integer = 9 ) as integer = fp2
''
'' 'fq(1)' passes 7 and 'fr(1)' passes 9 -- the pointer's own declaration decides -- and
'' assigning across the two spellings is accepted, so the defaults are no part of the
'' type's identity. tiko's type table is structural and keeps none, which is why a call
'' through a pointer passed NOTHING for an omitted argument: 'pf2()' in
'' pointers/procptr-optional-arg.bas went out with no argument where fbc passes 2.
''
'' So the answer is a NODE -- an N_PROC, or a procedure N_TYPEREF -- whose N_PARAM
'' children carry the defaults in 'b'. NODE_NONE means the declaration was not found,
'' and both callers then refuse to guess.

'' The declaration's N_PARAM for parameter 'idx', the ellipsis not counted.
function ProcDeclParam_ _
    ( byval ast as Tko.AstArena ptr, byval decl as Tko.NodeId, _
      byval idx as int32 ) as Tko.NodeId

    if decl = Tko.NODE_NONE then return Tko.NODE_NONE
    dim as Tko.StmtPayload ptr dp = _
        @ast->stmts[cast( int32, ast->nodes[cast( int32, decl )].data )]
    dim as int32 seen = 0
    for i as int32 = 0 to dp->count - 1
        dim as Tko.NodeId prm = cast( Tko.NodeId, ast->children[dp->first + i] )
        if ast->Kind( prm ) <> Tko.N_PARAM then continue for
        dim as Tko.StmtPayload ptr pp = _
            @ast->stmts[cast( int32, ast->nodes[cast( int32, prm )].data )]
        if pp->op = cast( uint16, Tko.TK_ELLIPSIS ) then continue for
        if seen = idx then return prm
        seen += 1
    next
    return Tko.NODE_NONE
end function

'' The declaration behind the procedure-pointer VALUE of expression 'e'.
function ProcPtrDeclOf_ _
    ( byval ast as Tko.AstArena ptr, byval syms as Tko.SymbolTable ptr, _
      byval types as Tko.TypeContext ptr, byval info as Tko.SemanticInfo ptr, _
      byval names as Tko.Interner ptr, byval e as Tko.NodeId, _
      byval depth as int32 = 0 ) as Tko.NodeId

    if e = Tko.NODE_NONE then return Tko.NODE_NONE
    '' A cycle -- 'var p = p' -- or a chain nobody writes.
    if depth > 24 then return Tko.NODE_NONE
    dim as int32 dat = cast( int32, ast->nodes[cast( int32, e )].data )
    dim as Tko.NodeId nx = Tko.NODE_NONE

    select case ast->Kind( e )
    case Tko.N_PROC
        return e

    case Tko.N_TYPEREF
        dim as uint16 fl = ast->nodes[cast( int32, e )].flags
        if (fl and Tko.NF_PROC_TYPE) <> 0 then return e
        if (fl and Tko.NF_PTR) <> 0 then
            '' 'as FP ptr' -- the pointee's declaration.
            nx = ast->stmts[dat].a
        else
            '' A NAME: a typedef's symbol keeps its own type reference.
            dim as Tko.Symbol ptr ts = syms->SymbolAt( info->RefOf( e ) )
            if ts = nullptr then return Tko.NODE_NONE
            if ts->kind <> cast( uint8, Tko.SYM_TYPEDEF ) then return Tko.NODE_NONE
            nx = cast( Tko.NodeId, ts->payload )
        end if

    case Tko.N_PAREN
        if ast->lists[dat].count < 1 then return Tko.NODE_NONE
        nx = cast( Tko.NodeId, ast->children[ast->lists[dat].first] )

    case Tko.N_DEREF, Tko.N_ADDROF
        nx = ast->unaries[dat].operand

    case Tko.N_INDEX
        nx = ast->lists[dat].target

    case Tko.N_IDENT, Tko.N_MEMBER
        dim as Tko.SymbolId sid = info->RefOf( e )
        if (sid = Tko.SYMBOL_NONE) andalso (ast->Kind( e ) = Tko.N_MEMBER) then
            sid = info->RefOf( ast->binaries[dat].rhs )
        end if
        dim as Tko.Symbol ptr s = syms->SymbolAt( sid )
        if s = nullptr then return Tko.NODE_NONE
        dim as Tko.NodeId dn = Tko.NODE_NONE
        select case cast( Tko.SymbolKind, s->kind )
        case Tko.SYM_PROC
            '' '@f' and 'procptr( f )' -- the procedure's own parameters.
            dn = cast( Tko.NodeId, s->payload )
            if dn = Tko.NODE_NONE then return Tko.NODE_NONE
            if ast->Kind( dn ) <> Tko.N_PROC then return Tko.NODE_NONE
            return dn
        case Tko.SYM_VARIABLE, Tko.SYM_FIELD
            dn = cast( Tko.NodeId, s->payload )
            if dn = Tko.NODE_NONE then return Tko.NODE_NONE
            dim as Tko.NodeKind dk = ast->Kind( dn )
            if (dk <> Tko.N_VAR_ITEM) andalso (dk <> Tko.N_FIELD) then return Tko.NODE_NONE
            dim as Tko.StmtPayload ptr vp = _
                @ast->stmts[cast( int32, ast->nodes[cast( int32, dn )].data )]
            nx = vp->a
            '' 'var pf = procptr( f )' -- no type written, so the initialiser says.
            if (nx = Tko.NODE_NONE) andalso (dk = Tko.N_VAR_ITEM) then
                if vp->extra <> cast( uint16, Tko.KW_REDIM ) then nx = vp->b
            end if
        case Tko.SYM_PARAMETER
            '' A PARAMETER'S SYMBOL HOLDS NO NODE, so its procedure is asked for the
            '' parameter of that name.
            dim as Tko.SymScope ptr sc = syms->ScopeAt( s->parent )
            if sc = nullptr then return Tko.NODE_NONE
            dim as Tko.Symbol ptr os = syms->SymbolAt( sc->owner )
            if os = nullptr then return Tko.NODE_NONE
            dn = cast( Tko.NodeId, os->payload )
            if dn = Tko.NODE_NONE then return Tko.NODE_NONE
            if ast->Kind( dn ) <> Tko.N_PROC then return Tko.NODE_NONE
            dim as Tko.StmtPayload ptr opp = _
                @ast->stmts[cast( int32, ast->nodes[cast( int32, dn )].data )]
            for i as int32 = 0 to opp->count - 1
                dim as Tko.NodeId prm = cast( Tko.NodeId, ast->children[opp->first + i] )
                if ast->Kind( prm ) <> Tko.N_PARAM then continue for
                dim as Tko.StmtPayload ptr pp = _
                    @ast->stmts[cast( int32, ast->nodes[cast( int32, prm )].data )]
                if pp->name = Tko.INTERN_NONE then continue for
                if names->Fold( pp->name ) = s->name then
                    nx = pp->a
                    exit for
                end if
            next
        case else
            return Tko.NODE_NONE
        end select

    case Tko.N_CALL
        dim as Tko.NodeId tgt = ast->lists[dat].target
        if tgt = Tko.NODE_NONE then return Tko.NODE_NONE
        '' 'procptr( f )' IS the procedure.
        if ast->Kind( tgt ) = Tko.N_IDENT then
            dim as Tko.InternId inm = _
                ast->idents[cast( int32, ast->nodes[cast( int32, tgt )].data )].name
            if Tko.Text.LowerAscii( names->Spelling( inm ) ) = "procptr" then
                if ast->lists[dat].count < 1 then return Tko.NODE_NONE
                nx = cast( Tko.NodeId, ast->children[ast->lists[dat].first] )
            end if
        end if
        if nx = Tko.NODE_NONE then
            '' AN ARRAY ELEMENT has the array's own declaration: 'fa( 0 )( 1 )'.
            dim as Tko.Symbol ptr ts = syms->SymbolAt( info->RefOf( tgt ) )
            if ts <> nullptr then
                if ts->type_ <> Tko.TYPE_NONE then
                    dim as Tko.TypeId tu = types->Unqualify( ts->type_ )
                    dim as boolean isArr = (types->Kind( tu ) = Tko.TK_ARRAY)
                    if isArr = false then isArr = types->IsDynArray( tu )
                    if isArr then nx = tgt
                end if
            end if
        end if
        if nx = Tko.NODE_NONE then
            '' A CALL'S RESULT has the result type of whatever was called: 'h( 1 )( 2 )'.
            dim as Tko.NodeId cd = ProcPtrDeclOf_( ast, syms, types, info, names, tgt, depth + 1 )
            if cd = Tko.NODE_NONE then return Tko.NODE_NONE
            nx = ast->stmts[cast( int32, ast->nodes[cast( int32, cd )].data )].a
        end if

    case else
        return Tko.NODE_NONE
    end select

    return ProcPtrDeclOf_( ast, syms, types, info, names, nx, depth + 1 )
end function
