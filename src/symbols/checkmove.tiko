'' checkmove.tiko -- WHAT 'move( x )' MAY MOVE FROM (RFC 0018 V3, docs/architecture/decisions):
'' TKO1258-1260. Asked of every N_CALL by latesweeps2.tiko; builtinarity.tiko already counts
'' its one argument (TKO0801).
''
'' 'move( x )' relocates x's object into a temporary and resets x to its default state
'' (mir/lowermove.tiko). So x must be an OBJECT OF A TYPE, it must have AN ADDRESS -- a
'' variable, a parameter, a field, an array element, a dereference -- and it must be
'' WRITABLE, because resetting it writes it. A temporary is accepted with a warning: it is
'' moved already, and 'move' passes it through. A program's own procedure called 'move'
'' binds the name and none of this applies.

#import "std/containers"
#include once "symbols/sem.ti"
#include once "diag/diagids.ti"
#include once "symbols/check.ti"
#include once "types/udtlayout.ti"
#include once "support/text.ti"

namespace Tko.Sem

#include once "symbols/visctx.ti"
#include once "symbols/semcalls.ti"

'' The type 'n' designates, a reference seen through.
private function DesignatedType_ ( byref c as Ctx, byval n as NodeId ) as TypeId
    dim as TypeId t = c.info->TypeOf_( n )
    if t = TYPE_NONE then return t
    if c.types->Kind( c.types->Unqualify( t ) ) = TK_REFERENCE then t = c.types->Inner( c.types->Unqualify( t ) )
    return t
end function

'' Does 'n' reach a CONST object through a chain of '.' -- 'c.f' over 'dim as const T c'?
'' Check types a field as the field's own type, so the object's const has to be asked of each
'' base in turn; a '->' stops there, its pointer's pointee answering for itself.
private function MoveFromConst_ ( byref c as Ctx, byval n as NodeId ) as boolean
    for guard as int32 = 0 to 31
        if n = NODE_NONE then return false
        if c.types->IsConst( DesignatedType_( c, n ) ) then return true
        if c.ast->Kind( n ) = N_IDENT then
            dim as Symbol ptr vs = c.syms->SymbolAt( c.info->RefOf( n ) )
            if vs <> nullptr then
                if cast( SymbolKind, vs->kind ) = SYM_CONSTANT then return true
                if c.types->IsConst( vs->type_ ) then return true
            end if
        end if
        select case c.ast->Kind( n )
        case N_MEMBER
            if (c.ast->Flags( n ) and NF_ARROW) <> 0 then return false
            n = c.ast->BinaryOf( n )->lhs
        case N_PAREN
            dim as ListPayload ptr pl = c.ast->ListOf( n )
            if pl->count <> 1 then return false
            n = cast( NodeId, c.ast->ChildSlot( pl->first ) )
        case N_CALL
            '' 'a( i )' -- an element: its array is asked, an element of a const array being const.
            dim as NodeId t = c.ast->ListOf( n )->target
            if t = NODE_NONE then return false
            if c.ast->Kind( t ) = N_IDENT then
                dim as Symbol ptr asy = c.syms->SymbolAt( c.info->RefOf( t ) )
                if asy = nullptr then return false
                dim as TypeId art = c.types->Unqualify( asy->type_ )
                if c.types->IsConst( asy->type_ ) then return true
                if c.types->Kind( art ) = TK_ARRAY then return c.types->IsConst( c.types->Inner( art ) )
                return false
            end if
            if c.ast->Kind( t ) <> N_MEMBER then return false
            n = t
        case else
            return false
        end select
    next
    return false
end function

'' Is 'n' AN OBJECT WITH AN ADDRESS -- something 'move' can reset -- rather than a value?
'' 'a( i )' is spelled as a call, so a call counts when its head is a VARIABLE, a PARAMETER
'' or a FIELD (an array) rather than a procedure.
private function MoveSourceHasAddress_ ( byref c as Ctx, byval n as NodeId ) as boolean
    for guard as int32 = 0 to 31
        if n = NODE_NONE then return false
        select case c.ast->Kind( n )
        case N_IDENT
            dim as Symbol ptr s = c.syms->SymbolAt( c.info->RefOf( n ) )
            if s = nullptr then return false
            select case cast( SymbolKind, s->kind )
            case SYM_VARIABLE, SYM_PARAMETER, SYM_FIELD
                return true
            end select
            return false
        case N_MEMBER
            dim as Symbol ptr fs = c.syms->SymbolAt( c.info->RefOf( n ) )
            if fs = nullptr then return false
            return (cast( SymbolKind, fs->kind ) = SYM_FIELD)
        case N_DEREF, N_INDEX
            return true
        case N_PAREN
            dim as ListPayload ptr pl = c.ast->ListOf( n )
            if pl->count <> 1 then return false
            n = cast( NodeId, c.ast->ChildSlot( pl->first ) )
        case N_CALL
            dim as NodeId t = c.ast->ListOf( n )->target
            if t = NODE_NONE then return false
            dim as Symbol ptr ts = c.syms->SymbolAt( c.info->RefOf( t ) )
            if ts = nullptr then return false
            select case cast( SymbolKind, ts->kind )
            case SYM_VARIABLE, SYM_PARAMETER, SYM_FIELD
                return true
            end select
            return false
        case else
            return false
        end select
    next
    return false
end function

'' What the diagnostic calls x: its name, or a phrase.
private function MoveSpelling_ ( byref c as Ctx, byval n as NodeId ) as string
    dim as string r = SpellOf_( c, n )
    if len( r ) = 0 then r = "this object"
    return r
end function

sub CheckMoveCall_ ( byref c as Ctx, byval id as NodeId )
    dim as ListPayload ptr lp = c.ast->ListOf( id )
    if lp->count <> 1 then return   '' TKO0801's
    if (lp->target = NODE_NONE) orelse (c.ast->Kind( lp->target ) <> N_IDENT) then return
    if c.info->RefOf( lp->target ) <> SYMBOL_NONE then return
    if c.info->RefOf( id ) <> SYMBOL_NONE then return
    if lcase( c.names->Spelling( c.ast->IdentOf( lp->target )->name ) ) <> "move" then return
    dim as NodeId a = cast( NodeId, c.ast->ChildSlot( lp->first ) )
    if a = NODE_NONE then return
    dim as TypeId at = c.info->TypeOf_( a )
    if at = TYPE_NONE then return   '' an untyped argument has been reported already
    if c.types->Kind( c.types->Unqualify( at ) ) = TK_REFERENCE then at = c.types->Inner( c.types->Unqualify( at ) )
    if c.types->Kind( c.types->Unqualify( at ) ) <> TK_UDT then
        c.diags->Report( TKO1258, PointRange( c.ast->Loc( a ) ), c.types->Name( at ) )
        return
    end if
    if MoveSourceHasAddress_( c, a ) = false then
        '' A VALUE OF THE TYPE is a temporary -- a call's result, an operator's, a type
        '' literal -- and moved already.
        c.diags->Report( TKO1260, PointRange( c.ast->Loc( a ) ) )
        return
    end if
    if MoveFromConst_( c, a ) then
        c.diags->Report( TKO1259, PointRange( c.ast->Loc( a ) ), MoveSpelling_( c, a ) )
    end if
end sub

end namespace
