'' byrefcheck.tiko -- WHAT A BYREF RESULT MAY AND MAY NOT BE ASSIGNED.
''
'' Split out of visibility.tiko at the 1500-line lint cap and included from it, at the exact
'' spot the three checks stood, inside its namespace.

'' A DEFINITION MUST REPEAT THE DECLARATION'S 'byref' -- fbc error 20, "Type mismatch",
'' and it is symmetric: declaring BYREF and defining byval is refused, and so is the
'' reverse. Measured both ways, with 'both BYREF' accepted.
''
'' The symbol's payload is the DECLARATION node -- a definition joins its declare rather
'' than chaining beside it -- so the two nodes are both to hand here and nowhere else.
sub CheckByrefResultAgrees_ ( byref c as Ctx, byval id as NodeId )
    dim as StmtPayload ptr sp = _
        c.ast->StmtOf( id )
    if sp->b = NODE_NONE then return
    dim as Symbol ptr s = c.syms->SymbolAt( c.info->RefOf( id ) )
    if s = nullptr then return
    dim as NodeId decl = cast( NodeId, s->payload )
    if decl = NODE_NONE then return
    if decl = id then return
    if c.ast->Kind( decl ) <> N_PROC then return
    dim as uint16 a2 = cast( uint16, c.ast->Flags( decl ) and NF_BYREF )
    dim as uint16 b2 = cast( uint16, c.ast->Flags( id ) and NF_BYREF )
    if a2 = b2 then return
    c.diags->Report( TKO0651, PointRange( c.ast->Loc( id ) ), _
                     c.names->Spelling( sp->name ) )
end sub

declare function ByrefResultUdtBad_ ( byref c as Ctx, byval v as NodeId, byval resultType as TypeId ) as boolean
declare function ByrefCallValue_ ( byref c as Ctx, byval v as NodeId ) as boolean

'' A BYREF RESULT MUST BE ASSIGNED SOMETHING OF EXACTLY ITS TYPE -- fbc error 318, "Type
'' mismatch in byref function result assignment". A byref result hands back the storage
'' itself, so there is nowhere for a conversion to happen.
''
'' EXACTLY is the word. Measured, against 'function f( ) byref as integer':
''     static i as integer          OK
''     static i as double           error 318
''     static i as long             error 318   -- the SAME SIZE, and still refused
''     static i as const integer    error 318   -- the qualifier counts
''     ...and 'byref as const integer' takes the const one, so it is identity, not width.
sub CheckByrefResultType_ _
    ( byref c as Ctx, byval id as NodeId, byval byrefResult as boolean, _
      byval resultType as TypeId )

    if byrefResult = false then return
    dim as StmtPayload ptr sp = _
        c.ast->StmtOf( id )
    '' ...AND 'return v', the same binding (CheckByrefResultValue_): measured on fbc-modern
    '' 1.20, 'return s' over a 'static as double' into 'byref as long' is 318 as 'function = s'
    '' is. Only 'function =' was judged.
    dim as NodeId rv = sp->b
    if c.ast->Kind( id ) = N_RETURN then
        rv = sp->a
    elseif c.info->AmbiguousOf( id ) <> AMB_RESULT then
        return
    end if
    if rv = NODE_NONE then return
    '' ONLY WHAT WAS MEASURED: a NAMED variable of a non-string scalar builtin, on both
    '' sides. The corpus scan reported no false rejection, and this suite's own MIR tests
    '' then found four -- every one of them a STRING:
    ''
    ''     operator U.cast( ) byref as const zstring : operator = this._data
    ''         'zstring * N' is an ARRAY of TY_ZSTRING, never identical to plain zstring
    ''     function refZ( ) byref as zstring : function = "also good"
    ''         a LITERAL, and fbc takes it
    ''     function refI( ) byref as integer : function = byval pi
    ''         not a name at all
    ''
    '' fbc's real rule here is wider than identity for those shapes and this pass cannot
    '' model it, so they are declined rather than guessed at. A CLEAN CORPUS SCAN IS NOT
    '' PROOF: 1222 files said nothing about any of the four.
    '' A STRING LITERAL INTO A 'byref as STRING' RESULT -- fbc error 318 -- while the same
    '' literal into a 'byref as zstring' result is accepted (above). Measured both.
    if c.ast->Kind( rv ) = N_STRING_LIT then
        dim as TypeId lrt = resultType
        if lrt = TYPE_NONE then return
        if c.types->Kind( lrt ) = TK_REFERENCE then lrt = c.types->Inner( lrt )
        lrt = c.types->Unqualify( lrt )
        if c.types->Kind( lrt ) <> TK_BUILTIN then return
        if c.types->BuiltinOf( lrt ) = TY_STRING then
            c.diags->Report( TKO0667, PointRange( c.ast->Loc( rv ) ) )
        end if
        return
    end if
    if ByrefResultUdtBad_( c, rv, resultType ) then
        c.diags->Report( TKO0667, PointRange( c.ast->Loc( rv ) ) )
        return
    end if
    '' ...and a BYREF CALL's result is storage of its own type, judged as a name is.
    if (c.ast->Kind( rv ) <> N_IDENT) andalso (ByrefCallValue_( c, rv ) = false) then return
    dim as TypeId rt = resultType
    dim as TypeId vt = c.info->TypeOf_( rv )
    if (rt = TYPE_NONE) orelse (vt = TYPE_NONE) then return
    if rt = vt then return
    '' A REFERENCE ON EITHER SIDE IS THE SAME TYPE. A byref parameter's type is spelled
    '' as one, and returning it is the ordinary way to pass storage through.
    if c.types->Kind( rt ) = TK_REFERENCE then rt = c.types->Inner( rt )
    if c.types->Kind( vt ) = TK_REFERENCE then vt = c.types->Inner( vt )
    if rt = vt then return

    '' CONST GOES ONE WAY ONLY, and the two directions are not symmetric -- measured:
    ''     byref as integer       <- const integer     error 318   dropping it
    ''     byref as const integer <- integer           OK          adding it
    '' So the unqualified types must be identical, and a const value additionally
    '' demands a const result. Comparing the qualified ids outright refused the second
    '' line, which is a file fbc accepts.
    '' Both sides a NON-STRING scalar builtin -- see the header.
    if c.types->Kind( c.types->Unqualify( rt ) ) <> TK_BUILTIN then return
    if c.types->Kind( c.types->Unqualify( vt ) ) <> TK_BUILTIN then return
    select case c.types->BuiltinOf( c.types->Unqualify( rt ) )
    case TY_STRING, TY_ZSTRING, TY_WSTRING, TY_USTRING, TY_FIXSTR, TY_FIXUSTR
        return
    end select
    select case c.types->BuiltinOf( c.types->Unqualify( vt ) )
    case TY_STRING, TY_ZSTRING, TY_WSTRING, TY_USTRING, TY_FIXSTR, TY_FIXUSTR
        return
    end select

    dim as boolean valueConst = c.types->IsConst( vt )
    dim as boolean resConst = c.types->IsConst( rt )
    if c.types->Unqualify( rt ) <> c.types->Unqualify( vt ) then
        c.diags->Report( TKO0667, PointRange( c.ast->Loc( rv ) ) )
        return
    end if
    if valueConst andalso (resConst = false) then
        c.diags->Report( TKO0667, PointRange( c.ast->Loc( rv ) ) )
    end if
end sub

'' A BYVAL PARAMETER fbc PASSES BY A HIDDEN REFERENCE is the caller's storage, not a local:
'' measured on fbc-modern 1.20, 2026-09-30, 'function = u' in a byref-result function is
'' fine over 'byval u as string', and over a UDT with a destructor -- written, inherited,
'' or implied by a string, destructor-bearing or dynamic-array field, in an array too -- or
'' one that extends OBJECT (functions/temp-strings.bas). A plain-data UDT, a scalar or a
'' pointer is still error 272, and so is a UDT with only a copy constructor or 'let'.
private function PassedByHiddenRef_ ( byref c as Ctx, byval t as TypeId, byval depth as int32 = 0 ) as boolean
    if (t = TYPE_NONE) orelse (depth > 16) then return false
    dim as TypeId u = c.types->Unqualify( t )
    if c.types->IsDynArray( u ) then return (depth > 0)
    select case c.types->Kind( u )
    case TK_BUILTIN
        select case c.types->BuiltinOf( u )
        case TY_STRING, TY_USTRING
            return true
        end select
        return false
    case TK_ARRAY
        return PassedByHiddenRef_( c, c.types->Inner( u ), depth + 1 )
    case TK_UDT
    case else
        return false
    end select
    if ExtendsObject_( c, u ) then return true
    dim as TypeId b = u
    for g as int32 = 0 to 63
        if b = TYPE_NONE then exit for
        if StructorOf_( c, b, "__dtor" ) <> nullptr then return true
        dim as ScopeId ds = cast( ScopeId, c.types->DeclScopeOf( b ) )
        dim as SymbolId ts = c.syms->LookupLocalTyped( ds, c.types->NameOf( b ), true )
        if ts = SYMBOL_NONE then ts = c.syms->LookupTyped( ds, c.types->NameOf( b ), true )
        dim as Symbol ptr s = c.syms->SymbolAt( ts )
        if (s <> nullptr) andalso (s->inner <> SCOPE_NONE) then
            dim as SymScope ptr sc = c.syms->ScopeAt( s->inner )
            dim as SymbolId cur = iif( sc <> nullptr, sc->firstSym, SYMBOL_NONE )
            while cur <> SYMBOL_NONE
                dim as Symbol ptr f = c.syms->SymbolAt( cur )
                if f = nullptr then exit while
                if (f->kind = cast( uint8, SYM_FIELD )) andalso ((f->flags and SYMF_STATIC) = 0) andalso (f->type_ <> u) then
                    if PassedByHiddenRef_( c, f->type_, depth + 1 ) then return true
                end if
                cur = f->nextInScope
            wend
        end if
        b = BaseOf_( c, b )
    next
    return false
end function

'' A CALL OF A FUNCTION THAT RETURNS BYREF: storage, not a temporary.
private function ByrefCallValue_ ( byref c as Ctx, byval v as NodeId ) as boolean
    if c.ast->Kind( v ) <> N_CALL then return false
    dim as ListPayload ptr lp = c.ast->ListOf( v )
    dim as Symbol ptr ts = c.syms->SymbolAt( c.info->RefOf( lp->target ) )
    if ts = nullptr then return false
    if ts->kind <> cast( uint8, SYM_PROC ) then return false
    dim as NodeId cd = cast( NodeId, ts->payload )
    if (cd = NODE_NONE) orelse (c.ast->Kind( cd ) <> N_PROC) then return false
    return ((c.ast->Flags( cd ) and NF_BYREF) <> 0)
end function

'' A UDT ON EITHER SIDE OF A BYREF RESULT -- fbc's 318 too, measured on fbc-modern 1.20 over
'' 'byref as B' given a shared U, a byref U call or a shared long, 'byref as U' given a long or
'' a byref long call, and 'byref as long' given a byref U call, by 'return' and 'function ='
'' alike. The same type or a type derived from the result's is the storage itself and binds.
'' A byref result is never CONSTRUCTED, so a constructor taking the value does not help. Not
'' a local (CheckByrefResultValue_'s 272) nor a string flavour on the other side.
private function ByrefResultUdtBad_ ( byref c as Ctx, byval v as NodeId, byval resultType as TypeId ) as boolean
    if (resultType = TYPE_NONE) orelse (v = NODE_NONE) then return false
    if c.ast->Kind( v ) = N_IDENT then
        dim as Symbol ptr s = c.syms->SymbolAt( c.info->RefOf( v ) )
        if s = nullptr then return false
        select case cast( SymbolKind, s->kind )
        case SYM_VARIABLE
            if (s->flags and (SYMF_SHARED or SYMF_STATIC or SYMF_EXTERN or SYMF_COMMON)) = 0 then return false
        case SYM_PARAMETER
            if IsThisBase_( c, v ) then return false
            if s->type_ = TYPE_NONE then return false
            if c.types->Kind( c.types->Unqualify( s->type_ ) ) <> TK_REFERENCE then return false
        case else
            return false
        end select
    elseif ByrefCallValue_( c, v ) = false then
        return false
    end if
    dim as TypeId rt = c.types->Unqualify( resultType )
    if c.types->Kind( rt ) = TK_REFERENCE then rt = c.types->Unqualify( c.types->Inner( rt ) )
    dim as TypeId vt = c.info->TypeOf_( v )
    if vt = TYPE_NONE then return false
    vt = c.types->Unqualify( vt )
    if c.types->Kind( vt ) = TK_REFERENCE then vt = c.types->Unqualify( c.types->Inner( vt ) )
    dim as boolean rUdt = (c.types->Kind( rt ) = TK_UDT)
    dim as boolean vUdt = (c.types->Kind( vt ) = TK_UDT)
    if (rUdt orelse vUdt) = false then return false
    if rUdt andalso vUdt then return (c.types->BaseDistance( vt, rt ) < 0)
    dim as TypeId other = iif( rUdt, vt, rt )
    select case c.types->Kind( other )
    case TK_POINTER, TK_ENUM
        return true
    case TK_BUILTIN
        select case c.types->BuiltinOf( other )
        case TY_STRING, TY_ZSTRING, TY_WSTRING, TY_USTRING, TY_FIXSTR, TY_FIXUSTR, TY_ANY, TY_VOID
            return false
        end select
        return true
    end select
    return false
end function

'' A BYREF RESULT CANNOT RETURN A LOCAL -- fbc error 272, "Local symbols can't be
'' referenced". The caller is handed a reference, and the frame it points into is gone by
'' the time it is read. Measured, all three shapes:
''
''     function = x.i           x a local UDT              error 272
''     function = array( i )    array a local array        error 272
''     function = f1( )         a call's RESULT is a temp  error 272
''     function = g             g SHARED                   OK
''
'' THE BASE OF THE CHAIN IS WHAT MATTERS: 'x.i' is local because x is, and 'array( i )'
'' because array is. So the walk goes down to the head of the member and index chain, and
'' a CALL is refused outright unless it returns byref itself.
sub CheckByrefResultValue_ _
    ( byref c as Ctx, byval id as NodeId, byval byrefResult as boolean )

    if byrefResult = false then return
    dim as StmtPayload ptr sp = _
        c.ast->StmtOf( id )
    '' ...AND 'return v', THE SAME BINDING: measured on fbc-modern 1.20, 'return v' over a
    '' local, a byval parameter, a local's field or element, '(v)' or a by-value call's
    '' result is error 272 and 'return 5' error 24, exactly as 'function = v' -- in a
    '' 'byref as long', 'byref as string' and 'byref as T' function alike. Only 'function ='
    '' was judged, so 'return v' handed the caller the address of a dead frame.
    dim as NodeId rv = sp->b
    if c.ast->Kind( id ) = N_RETURN then
        rv = sp->a
    elseif c.info->AmbiguousOf( id ) <> AMB_RESULT then
        return
    end if
    if rv = NODE_NONE then return

    '' THE VALUE MUST HAVE AN ADDRESS. Measured, in a 'byref as integer' function:
    ''     function = 123               error 24     function = @g       error 24
    ''     function = g + 1             error 3      function = iif(..)  error 24
    ''     function = type<UDT>( 123 )  error 24
    '' ...and 'function = "also good"' in a 'byref as zstring' function is ACCEPTED,
    '' so a string literal is left alone.
    select case c.ast->Kind( rv )
    case N_INT_LIT, N_FLOAT_LIT, N_ADDROF, N_BINARY, N_IIF
        c.diags->Report( TKO0711, PointRange( c.ast->Loc( rv ) ) )
        return
    case N_TUPLE
        if (c.ast->Flags( rv ) and NF_TYPE_LITERAL) <> 0 then
            c.diags->Report( TKO0711, PointRange( c.ast->Loc( rv ) ) )
            return
        end if
    end select

    '' Down to the head of the chain.
    dim as NodeId head = rv
    dim as int32 guard = 0
    while guard < 64
        guard += 1
        dim as NodeKind hk = c.ast->Kind( head )
        if hk = N_MEMBER then
            '' THROUGH A POINTER IS SOMEBODY ELSE'S STORAGE: 'return n->value' and 'return
            '' b->items( i )' bind what the local points at, not the local -- pkg/std's
            '' containers do both. The arrow is the flag (CheckDeref_), and so is any
            '' member of a pointer-typed base.
            if (c.ast->Flags( head ) and NF_ARROW) <> 0 then return
            dim as BinaryPayload ptr hmp = c.ast->BinaryOf( head )
            if cast( TokenKind, hmp->op ) = TK_ARROW then return
            head = hmp->lhs
        elseif hk = N_CALL then
            '' AN ARRAY SUBSCRIPT IS SPELLED LIKE A CALL. 'x.a(0)' over a FIELD array
            '' stopped the walk here: the branch below resolved the target 'x.a' to a
            '' SYM_FIELD, which is neither a proc nor a variable, and the statement was
            '' let through. Descending into the target continues to 'x' -- which is the
            '' local the rule is about. A real CALL still stops, and is judged below.
            dim as ListPayload ptr cl = _
                c.ast->ListOf( head )
            dim as Symbol ptr cts = c.syms->SymbolAt( c.info->RefOf( cl->target ) )
            if cts = nullptr then exit while
            if cts->kind <> cast( uint8, SYM_FIELD ) then exit while
            head = cl->target
        elseif (hk = N_INDEX) orelse (hk = N_PAREN) then
            dim as ListPayload ptr lp = _
                c.ast->ListOf( head )
            if hk = N_PAREN then
                if lp->count <> 1 then exit while
                head = cast( NodeId, c.ast->children[lp->first] )
            else
                '' 'p[ i ]' over a POINTER is a dereference too.
                dim as TypeId ixt = c.info->TypeOf_( lp->target )
                if ixt <> TYPE_NONE then
                    if c.types->Kind( c.types->Unqualify( ixt ) ) = TK_POINTER then return
                end if
                head = lp->target
            end if
        else
            exit while
        end if
    wend
    if head = NODE_NONE then return

    if c.ast->Kind( head ) = N_CALL then
        '' A CALL's result is a temporary -- unless the callee returns BYREF, in which
        '' case what comes back is already somebody else's storage.
        dim as ListPayload ptr lp = _
            c.ast->ListOf( head )
        dim as Symbol ptr ts = c.syms->SymbolAt( c.info->RefOf( lp->target ) )
        if ts = nullptr then
            '' 'iif( a, b, c )' IS A TEMPORARY -- error 24 -- and it binds no symbol.
            if c.ast->Kind( lp->target ) = N_IDENT then
                dim as string tn = c.names->Spelling( _
                    c.ast->IdentOf( lp->target )->name )
                if lcase( tn ) = "iif" then
                    c.diags->Report( TKO0711, PointRange( c.ast->Loc( rv ) ) )
                end if
            end if
            return
        end if
        if ts->kind <> cast( uint8, SYM_PROC ) then
            '' An INDEXING expression, not a call: fall through to the variable test.
            if ts->kind <> cast( uint8, SYM_VARIABLE ) then return
            if (ts->flags and (SYMF_SHARED or SYMF_STATIC or SYMF_EXTERN or _
                               SYMF_COMMON)) <> 0 then return
            c.diags->Report( TKO0650, PointRange( c.ast->Loc( rv ) ) )
            return
        end if
        dim as NodeId cd = cast( NodeId, ts->payload )
        if (cd <> NODE_NONE) andalso (c.ast->Kind( cd ) = N_PROC) then
            if (c.ast->Flags( cd ) and NF_BYREF) <> 0 then return
        end if
        c.diags->Report( TKO0650, PointRange( c.ast->Loc( rv ) ) )
        return
    end if

    if c.ast->Kind( head ) <> N_IDENT then return
    dim as Symbol ptr s = c.syms->SymbolAt( c.info->RefOf( head ) )
    if s = nullptr then return
    '' A BYVAL PARAMETER IS A LOCAL TOO -- error 272 for 'function = i' over 'byval i as
    '' integer', while a BYREF one is the caller's storage and passes. Measured both.
    '' A parameter's symbol carries no node; its TYPE says how it is passed -- Resolve
    '' types a byref one as a REFERENCE and a bydesc one as an ARRAY. 'this' is a
    '' pointer to the caller's object and is exempt.
    if s->kind = cast( uint8, SYM_PARAMETER ) then
        if IsThisBase_( c, head ) then return
        if s->type_ = TYPE_NONE then return
        if PassedByHiddenRef_( c, s->type_ ) then return
        select case c.types->Kind( c.types->Unqualify( s->type_ ) )
        case TK_REFERENCE, TK_ARRAY
            return
        end select
        c.diags->Report( TKO0650, PointRange( c.ast->Loc( rv ) ), _
                         c.names->Spelling( s->name ) )
        return
    end if
    if s->kind <> cast( uint8, SYM_VARIABLE ) then return
    if (s->flags and (SYMF_SHARED or SYMF_STATIC or SYMF_EXTERN or _
                      SYMF_COMMON)) <> 0 then return
    c.diags->Report( TKO0650, PointRange( c.ast->Loc( rv ) ), _
                     c.names->Spelling( s->name ) )
end sub

'' 'f( x ) = v' OVER A BYREF RESULT READ AS 'f( x = v )' -- fbc's warning 34, "'=' parsed as
'' equality operator in function argument, not assignment to BYREF function result" (T19).
''
'' Both compilers read the statement as a call with the comparison as its argument -- see
'' ReadCallAssignAsCall_ in resolveamb.tiko -- so the store the writer meant never happens.
'' fbc says so; tiko said nothing, and 'SlotAt( 0 ) = 42' simply left the slot at 0.
'' Measured on fbc-modern 1.20, 2026-10-02:
''
''     SlotAt( 0 ) = 42     SlotAt 0 = 42     a.At( 2 ) = 88     warning 34
''     Two( 0, 1 ) = 42     -- two arguments                    no warning
''     Plain( 0 ) = 42      -- a byval result                   no warning
''     SlotAt( 0 = 42 )     ( SlotAt( 0 ) ) = 42     NoArg( ) = 42    no warning
sub CheckEqParsedAsArg_ ( byref c as Ctx, byval id as NodeId )
    if c.info->AmbiguousOf( id ) <> AMB_CALL then return
    dim as StmtPayload ptr sp = c.ast->StmtOf( id )
    if sp->a = NODE_NONE then return
    dim as NodeId callee = sp->a
    dim as NodeId arg = NODE_NONE
    if c.ast->Kind( sp->a ) = N_CALL then
        '' 'f( x ) = v': ReadCallAssignAsCall_ folded the '=' into the last argument and
        '' marked the comparison it built. Exactly one argument was written.
        dim as ListPayload ptr lp = c.ast->ListOf( sp->a )
        if lp->count <> 1 then return
        arg = cast( NodeId, c.ast->children[lp->first] )
        if c.ast->Kind( arg ) <> N_BINARY then return
        if (c.ast->Flags( arg ) and NF_FOLDED_EQ) = 0 then return
        callee = lp->target
    else
        '' 'f x = v': a call without parentheses whose one argument is the comparison.
        select case c.ast->Kind( sp->a )
        case N_IDENT, N_MEMBER
        case else
            return
        end select
        if sp->count <> 1 then return
        arg = cast( NodeId, c.ast->children[sp->first] )
        if c.ast->Kind( arg ) <> N_BINARY then return
        if cast( TokenKind, c.ast->BinaryOf( arg )->op ) <> TK_EQ then return
    end if
    dim as Symbol ptr s = c.syms->SymbolAt( c.info->RefOf( sp->a ) )
    if (s = nullptr) andalso (callee <> NODE_NONE) then s = c.syms->SymbolAt( c.info->RefOf( callee ) )
    if s = nullptr then return
    if s->kind <> cast( uint8, SYM_PROC ) then return
    '' ANY OVERLOAD OF THE NAME WITH A BYREF RESULT, not the one the call chose: fbc's own
    '' warnings/byref-function-assign-2 has 'f1( 123 ) = 123' warn where the one-argument
    '' f1 returns by value and only 'f1( )' is byref -- measured, warning 34 on all ten of
    '' its lines of that shape.
    dim as boolean anyByref = false
    dim as SymbolId cur = c.syms->LookupLocal( s->parent, s->name )
    if cur = SYMBOL_NONE then cur = c.info->RefOf( sp->a )
    for guard as int32 = 0 to 255
        dim as Symbol ptr os = c.syms->SymbolAt( cur )
        if os = nullptr then exit for
        if os->kind = cast( uint8, SYM_PROC ) then
            dim as NodeId pn = cast( NodeId, os->payload )
            if pn <> NODE_NONE then
                if c.ast->Kind( pn ) = N_PROC then
                    if (c.ast->Flags( pn ) and NF_BYREF) <> 0 then anyByref = true
                end if
            end if
        end if
        if anyByref then exit for
        cur = os->nextOverload
    next
    if anyByref = false then return
    c.diags->Report( TKO0931, PointRange( c.ast->Loc( id ) ), c.names->Spelling( s->name ) )
end sub

'' ...AND 'f( a, b ) = v' OVER A BYVAL RESULT, which is no assignment at all: fbc's error 3,
'' "Expected End-of-Line, found '='", for 'P2( 0, 1 ) = 42' and 'P0( ) = 42' alike, measured.
'' tiko accepted both and dropped the statement in silence. With one argument the statement
'' is re-read as a call instead (ReadCallAssignAsCall_), and with two or more it is the byref
'' result's assignment -- so this is what is left: a call that returns a value, not a place.
'' A property setter and an array element are assignments, and are not calls to a procedure.
sub CheckByvalResultTarget_ ( byref c as Ctx, byval id as NodeId )
    if c.info->AmbiguousOf( id ) <> AMB_ASSIGN then return
    dim as StmtPayload ptr sp = c.ast->StmtOf( id )
    if sp->a = NODE_NONE then return
    if c.ast->Kind( sp->a ) <> N_CALL then return
    if c.info->AmbiguousOf( sp->a ) = AMB_PROPERTY_SET then return
    dim as Symbol ptr s = c.syms->SymbolAt( c.info->RefOf( sp->a ) )
    if s = nullptr then
        dim as NodeId tg = c.ast->ListOf( sp->a )->target
        if tg <> NODE_NONE then s = c.syms->SymbolAt( c.info->RefOf( tg ) )
    end if
    if s = nullptr then return
    if s->kind <> cast( uint8, SYM_PROC ) then return
    dim as NodeId pn = cast( NodeId, s->payload )
    if (pn = NODE_NONE) orelse (c.ast->Kind( pn ) <> N_PROC) then return
    if (c.ast->Flags( pn ) and NF_BYREF) <> 0 then return
    dim as StmtPayload ptr pp = c.ast->StmtOf( pn )
    if cast( TokenKind, pp->op ) <> KW_FUNCTION then return
    c.diags->Report( TKO0932, PointRange( c.ast->Loc( sp->a ) ), c.names->Spelling( s->name ) )
end sub
