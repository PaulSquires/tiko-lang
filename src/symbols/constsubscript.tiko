'' constsubscript.tiko -- A CONSTANT SUBSCRIPT OUTSIDE A FIXED ARRAY'S CONSTANT BOUNDS: TKO0960,
'' asked of every N_CALL by CheckConstSubscript_.
''
'' Included from latesweeps4.tiko, in the same namespace and over the same Ctx. MOVED HERE FROM
'' LOWERING 2026-10-24 (review MIR-04, LATER-PLAN D step 1): lowerboundchk.tiko reported it as it
'' emitted the -exx check, which is the one judgement lowering made on its own, and the reason a
'' build stopped by an earlier error could not stop before lowering without losing it.
''
'' fbc's error 92, "Array out-of-bounds", under -exx or -earray only -- measured on fbc-modern
'' 1.20: 'print a( 0 )' over 'a( 1 to 3 )', a field array, a shared one read in a SUB (audit
'' F-71). One report per subscripted node, the FIRST dimension out of range, at the node: what
'' lowering's dedup over the engine's pending list produced, with no dedup needed here -- the
'' sweep visits a node once.
''
'' WHAT COUNTS AS CONSTANT is Check's fold (ConstOf), not lowering's reading of the MIR it had
'' just emitted (a literal, through a sign extension or a negation). The fold sees more -- a
'' CONST name, '1 + 3' -- which is what fbc's own constant folding sees.
'' THE SCOPE A NAME IN THE SUBSCRIPT IS LOOKED UP IN, for a CONST. An expression node has no
'' scope recorded, so: a subscript that IS a name bound to a constant is looked up where that
'' constant lives -- 'q( M )' over a procedure's own 'const M' -- then the nearest of the
'' subscript, the subscripted node and its target that has one, then the module.
private function UseScope_ ( byref c as Ctx, byval a as NodeId, byval b as NodeId, byval t as NodeId ) as ScopeId
    if c.ast->Kind( a ) = N_IDENT then
        dim as Symbol ptr s = c.syms->SymbolAt( c.info->RefOf( a ) )
        if s <> nullptr then
            if s->kind = cast( uint8, SYM_CONSTANT ) then return s->parent
        end if
    end if
    if c.info->ScopeOf( a ) <> SCOPE_NONE then return c.info->ScopeOf( a )
    if c.info->ScopeOf( b ) <> SCOPE_NONE then return c.info->ScopeOf( b )
    if c.info->ScopeOf( t ) <> SCOPE_NONE then return c.info->ScopeOf( t )
    return SCOPE_GLOBAL
end function

private sub CheckConstSubscript_ ( byref c as Ctx, byval id as NodeId )
    if (c.errFlags and 8) = 0 then return
    if c.srcMgr = nullptr then return
    dim as ListPayload ptr lp = @c.ast->lists[cast( int32, c.ast->nodes[cast( int32, id )].data )]
    if lp->target = NODE_NONE then return
    dim as TypeId at = c.info->TypeOf_( lp->target )
    if at = TYPE_NONE then return
    if c.types->Kind( at ) <> TK_ARRAY then return
    if c.types->IsDynArray( at ) then return
    '' THE RANK FROM THE RETAINED BOUNDS, as lowering's ArrayStrides takes it: a subscript count
    '' that does not match is another error, and lowering emitted no check for it.
    dim as int32 rank = 0
    do
        dim as boolean known
        c.types->ArrayBound( at, rank, false, known )
        if known = false then exit do
        rank += 1
    loop
    if (rank = 0) orelse (lp->count <> rank) then return
    for k as int32 = 0 to rank - 1
        dim as boolean lk, hk
        dim as int64 lo = c.types->ArrayBound( at, k, false, lk )
        dim as int64 hi = c.types->ArrayBound( at, k, true, hk )
        if (lk = false) orelse (hk = false) then return
        dim as NodeId ix = cast( NodeId, c.ast->children[lp->first + k] )
        dim as Check.ConstVal cv = Check.ConstOf( *c.ast, ix, *c.srcMgr, *c.names, 64, _
            c.syms, UseScope_( c, ix, id, lp->target ), 0, c.types, c.info )
        if cv.known = false then continue for
        if (cv.value >= lo) andalso (cv.value <= hi) then continue for
        c.diags->Report( TKO0960, PointRange( c.ast->Loc( id ) ), str( cv.value ), str( lo ), str( hi ) )
        return
    next
end sub
