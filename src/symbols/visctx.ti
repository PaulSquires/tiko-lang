'' visctx.ti -- the post-Check pass's context (visibility.tiko and the files it includes).
'' Its own header since visibility.tiko reached the 1500-line cap.

#pragma once

'' THE SYMBOL TABLE BY FOLDED NAME, for the latesweeps owner-path rules: is there exactly one
'' namespace (one type) of this name, and which scope is it. Those rules ran once per QUALIFIED
'' DECLARATION and scanned every symbol each time -- 'function CWindow.Foo' times all of
'' windows.bi -- which was 1.18 s of PsCalendar's 4.96 s build (speed audit, 2026-10-07).
'' Indexed by folded InternId; built on first use and again whenever the table has grown, so a
'' symbol declared by an earlier sweep is never missed.
type OwnerIndex
    as int32                  builtAt = -1   '' symbols.Count when built; -1 = never
    as containers.Array( of int32 )   nsHits, nsInner, udtHits, udtInner
    as containers.Array( of uint8 )  head           '' a namespace, type or typedef has this name
end type

'' EVERY SYM_PROC BY FOLDED NAME, table order kept: ProcNamedAnywhere_, ArrowOperatorAnywhere_
'' and CmpOpMayApply_ (proccheck.tiko) scanned the whole symbol table per expression they
'' judged. Symbols are only ever appended and keep their name and kind in this pass, so the
'' index catches up to symbols.Count on each use (builtTo) rather than being rebuilt.
'' head/tail: name -> first/last entry; an entry is a symbol id, chained by nxt.
type ProcNameIndex
    as int32                  builtTo = 0
    as containers.Map( of uint32, int32 ) head, tail
    as containers.Array( of int32 )  nxt
    as containers.Array( of uint32 ) sid
end type

type Ctx
    as AstArena ptr         ast
    as SymbolTable ptr      syms
    as TypeContext ptr      types
    as Interner ptr         names
    as DiagnosticEngine ptr diags
    as SemanticInfo ptr     info
    as InternId             baseName
    '' THE FIRST REDIM OF A RANK-0 DYNAMIC ARRAY FIXES ITS RANK. 'dim a( )' then
    '' 'redim a( 0 to 0 )' makes a one-dimensional array, and 'a( 0, 0 )' or a second
    '' 'redim a( 0 to 0, 0 to 0 )' after it is fbc error 36 -- five corpus files. Recorded
    '' in source order before the walk, by symbol; consulted by the two rank tests.
    as NodeIdVec             redimSym
    as NodeIdVec             redimRank
    as NodeIdVec             redimItem
    '' ...and sid -> its FIRST entry, item -> its entry: each rank test scanned the table per
    '' subscript or redim. Pushed only beside the three above, by RecordFirstRedims_.
    as containers.Map( of uint32, int32 ) redimAt, redimOfItem
    '' The overload each CALLEE node's call chose, indexed by node id -- see
    '' RecordChosenOverloads_. Local to this pass on purpose.
    as NodeIdVec             chosenFor
    as NodeId                root
    '' THE SYMBOL TABLE BY FOLDED NAME, for the owner-path sweeps -- see OwnerIndex.
    as OwnerIndex            owners
    '' EVERY PROCEDURE BY NAME, for proccheck.tiko -- see ProcNameIndex.
    as ProcNameIndex         procsByName
    '' EVERY UDT'S LAYOUT, for '#assert sizeof( T )' and 'offsetof' -- built on first use by
    '' AssertLayouts_ (assertlayout.tiko), since the layout pass proper runs after this one.
    as UdtLayouts            udts
    as boolean               udtsBuilt
    '' For Check.ConstOf, which reads literals' text: nullptr from a caller that has no
    '' sources, and the checks that fold a constant then stay silent.
    as SourceManager ptr     srcMgr
end type
