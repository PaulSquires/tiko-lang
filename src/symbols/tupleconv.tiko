'' tupleconv.tiko -- A TUPLE ELEMENT THAT CANNOT TAKE ITS VALUE: fbc's errors 24 and 181.
''
'' Included from assigncheck.tiko, which is included from visibility.tiko, inside its
'' namespace, after BaseOf_, DerivesFrom_ and StructorOf_.
''
'' A tuple literal fills its elements one by one, and fbc refuses a value an element
'' cannot take -- error 24 in a declaration's initialiser, 181 in an assignment or a
'' 'return'. Measured on fbc-modern 1.20, 2026-09-25, over '( value, true )':
''
''     element V, which NEEDS CONSTRUCTING       a long, a string, 0, a W    refused
''       -- a constructor of its own, a string    a V, or a type derived from V  accepted
''       field, or 'extends object' --            a long, V with 'let' from long  accepted
''     element V with only a destructor, or only an 'operator cast', or neither:
''       a plain type                             a long                      accepted
''     element string                             a number                    refused
''     element long                               a string                    refused
''     element boolean, double                    a number, a boolean         accepted
''
'' So a type that needs constructing takes another type's value only through its own
'' 'operator let' -- which is how mir/lowerudtlit.tiko converts one -- and a string and a
'' number do not convert into each other. tiko accepted every one of these. A constructor
'' from the value's type is NOT enough: 'constructor( byval x as long )' and no 'let' is
'' refused. And the 'let' has to TAKE the value: a string into a type whose only 'let' is
'' from a long is refused too (fbc's 7 there).

'' Is this a tuple -- the kind, or the synthesized name Check gives one?
function TcTuple_ ( byref c as Ctx, byval t as TypeId ) as boolean
    t = c.types->Unqualify( t )
    if c.types->Kind( t ) = TK_TUPLE then return true
    if c.types->Kind( t ) <> TK_UDT then return false
    dim as InternId nm = c.types->NameOf( t )
    if nm = 0 then return false
    dim as string h = left( c.names->Spelling( nm ), 1 )
    return (h = "(") orelse (h = "$") orelse (h = "~")
end function

'' Does a UDT need constructing: a constructor of its own, a vtable, or a field that does?
function TcNeedsCtor_ ( byref c as Ctx, byval t as TypeId, byval depth as int32 ) as boolean
    if depth > 8 then return false
    t = c.types->Unqualify( t )
    if c.types->Kind( t ) <> TK_UDT then return false
    if StructorOf_( c, t, "__ctor" ) <> nullptr then return true
    dim as InternId tn = c.types->NameOf( t )
    if tn = 0 then return false
    if lcase( c.names->Spelling( tn ) ) = "object" then return true
    dim as ScopeId ds = cast( ScopeId, c.types->DeclScopeOf( t ) )
    dim as SymbolId ts = c.syms->LookupLocalTyped( ds, tn, true )
    if ts = SYMBOL_NONE then ts = c.syms->LookupTyped( ds, tn, true )
    dim as Symbol ptr s = c.syms->SymbolAt( ts )
    if (s = nullptr) orelse (s->inner = SCOPE_NONE) then return false
    dim as SymScope ptr sc = c.syms->ScopeAt( s->inner )
    if sc = nullptr then return false
    dim as SymbolId cur = sc->firstSym
    for guard as int32 = 0 to 9999
        if cur = SYMBOL_NONE then exit for
        dim as Symbol ptr f = c.syms->SymbolAt( cur )
        if f = nullptr then exit for
        if f->kind = cast( uint8, SYM_FIELD ) then
            dim as TypeId ft = c.types->Unqualify( f->type_ )
            if c.types->IsDynArray( ft ) then return true
            if c.types->Kind( ft ) = TK_BUILTIN then
                select case c.types->BuiltinOf( ft )
                case TY_STRING, TY_USTRING : return true
                end select
            end if
            if TcNeedsCtor_( c, ft, depth + 1 ) then return true
        end if
        cur = f->nextInScope
    next
    return false
end function

'' A string, of any kind -- a fixed-length one is an array of the character.
private function TcString_ ( byref c as Ctx, byval t as TypeId ) as boolean
    t = c.types->Unqualify( t )
    if c.types->Kind( t ) = TK_ARRAY then t = c.types->Unqualify( c.types->Inner( t ) )
    if c.types->Kind( t ) <> TK_BUILTIN then return false
    select case c.types->BuiltinOf( t )
    case TY_STRING, TY_ZSTRING, TY_WSTRING, TY_USTRING, TY_FIXSTR, TY_FIXUSTR : return true
    end select
    return false
end function

private function TcNumber_ ( byref c as Ctx, byval t as TypeId ) as boolean
    t = c.types->Unqualify( t )
    if c.types->Kind( t ) = TK_ENUM then return true
    if c.types->Kind( t ) <> TK_BUILTIN then return false
    select case c.types->BuiltinOf( t )
    case TY_BYTE, TY_UBYTE, TY_SHORT, TY_USHORT, TY_LONG, TY_ULONG, TY_INTEGER, TY_UINTEGER, _
         TY_LONGINT, TY_ULONGINT, TY_SINGLE, TY_DOUBLE, TY_BOOLEAN
        return true
    end select
    return false
end function

'' Can a parameter of type 'pt' take a value of type 'vu'? The same two rules, and a UDT
'' parameter takes its own type or one derived from it.
private function TcParamTakes_ ( byref c as Ctx, byval pt as TypeId, byval vu as TypeId ) as boolean
    pt = c.types->Unqualify( pt )
    if c.types->Kind( pt ) = TK_REFERENCE then pt = c.types->Unqualify( c.types->Inner( pt ) )
    if (pt = TYPE_NONE) orelse (pt = vu) then return true
    if TcString_( c, pt ) andalso TcNumber_( c, vu ) then return false
    if TcNumber_( c, pt ) andalso TcString_( c, vu ) then return false
    if c.types->Kind( pt ) = TK_UDT then
        if c.types->Kind( vu ) <> TK_UDT then return false
        return DerivesFrom_( c, vu, pt )
    end if
    return true
end function

'' Does one of the type's 'operator let' overloads take a value of type 'vu'?
private function TcLetTakes_ ( byref c as Ctx, byval eu as TypeId, byval vu as TypeId ) as boolean
    dim as Symbol ptr ls = StructorOf_( c, eu, "let" )
    for guard as int32 = 0 to 255
        if ls = nullptr then exit for
        dim as NodeId pn = cast( NodeId, ls->payload )
        if (pn <> NODE_NONE) andalso (c.ast->Kind( pn ) = N_PROC) then
            dim as StmtPayload ptr pp = c.ast->StmtOf( pn )
            for i as int32 = 0 to pp->count - 1
                dim as NodeId prm = c.ast->ChildAt( pp->first, i )
                if c.ast->Kind( prm ) <> N_PARAM then continue for
                dim as StmtPayload ptr qp = c.ast->StmtOf( prm )
                if TcParamTakes_( c, c.info->TypeOf_( qp->a ), vu ) then return true
                exit for
            next
        end if
        ls = c.syms->SymbolAt( ls->nextOverload )
    next
    return false
end function


'' A type as the source spells it: '(integer, integer)', never the '$tup:8:8' key.
private function TcName_ ( byref c as Ctx, byval t as TypeId ) as string
    dim as TypeId u = c.types->Unqualify( t )
    if TcTuple_( c, u ) then return TupleSpelling_( c, u )
    return c.types->Name( t )
end function

'' Can element type 'et' take a value of type 'vt'?
private function TcTakes_ ( byref c as Ctx, byval et as TypeId, byval vt as TypeId ) as boolean
    dim as TypeId eu = c.types->Unqualify( et ), vu = c.types->Unqualify( vt )
    if c.types->Kind( vu ) = TK_REFERENCE then vu = c.types->Unqualify( c.types->Inner( vu ) )
    if (eu = TYPE_NONE) orelse (vu = TYPE_NONE) orelse (eu = vu) then return true
    if TcString_( c, eu ) andalso TcNumber_( c, vu ) then return false
    if TcNumber_( c, eu ) andalso TcString_( c, vu ) then return false
    if c.types->Kind( eu ) <> TK_UDT then return true
    '' A TUPLE ELEMENT TAKES A TUPLE VALUE OF ITS OWN TYPE ONLY. Two tuple types never convert:
    '' '( t, 3 )' with 't' a '(integer, integer)', for a '((long, long), long)', is fbc's 181.
    '' A nested LITERAL never gets here -- TupleConvBad_ recurses into it and builds it at the
    '' element's type.
    if TcTuple_( c, eu ) then return (TcTuple_( c, vu ) = false)
    if (c.types->Kind( vu ) = TK_UDT) andalso DerivesFrom_( c, vu, eu ) then return true
    '' A TYPE DECLARING 'let' CONVERTS THROUGH IT, whether or not it needs constructing:
    '' 'L' with only 'let( byval x as long )' takes a long and a double and refuses a
    '' string. Without one, only a type that needs constructing refuses.
    if StructorOf_( c, eu, "let" ) <> nullptr then return TcLetTakes_( c, eu, vu )
    return (TcNeedsCtor_( c, eu, 0 ) = false)
end function

'' A TUPLE VALUE -- not a literal -- of ANOTHER tuple type. A literal is built at its target's
'' type; a value is not converted, and tiko copied its bytes instead: a '(integer, integer)'
'' into a '(long, long)' read back as '5, 0'. Measured on fbc-modern 1.20, 2026-09-29:
''
''     dim as (long, long) b = a         error 24      b = a  /  *p = a       error 181
''     return t  /  function = t         error 181     S( a ), byval or byref  error 58
''
'' with 'a' and 't' a '(integer, integer)'. The same tuple spelled with other element names or
'' through a typedef is ONE type and passes. TKO0738 for the first four -- the argument is
'' TKO0698, assigncheck.tiko.
private function TupleValueBad_ ( byref c as Ctx, byval t as TypeId, byval rn as NodeId ) as boolean
    dim as TypeId tu = c.types->Unqualify( t )
    if TcTuple_( c, tu ) = false then return false
    dim as TypeId vu = c.types->Unqualify( c.info->TypeOf_( rn ) )
    if c.types->Kind( vu ) = TK_REFERENCE then vu = c.types->Unqualify( c.types->Inner( vu ) )
    if (vu = TYPE_NONE) orelse (vu = tu) then return false
    if TcTuple_( c, vu ) = false then return false
    c.diags->Report( TKO0738, PointRange( c.ast->Loc( rn ) ) )
    return true
end function

'' The tuple literal 'rn' against the tuple type 't'. The first element that cannot take
'' its value is reported -- fbc reports one error per statement -- and nested literals
'' are judged by their own elements.
'' 'type( ... )' OVER A RECORD THAT HOLDS TEXT (T30) -- see typelitstr.tiko for the measurement.
'' The first var-len 'string' field of t -- or 'ustring' too, with wantU -- through record
'' fields, or 0. A type with a constructor, or a base, builds its fields itself and is not
'' judged: 'type( ... )' over one is a constructor call.
function TlTextField_ _
    ( byref c as Ctx, byval t as TypeId, byval depth as int32, byval wantU as boolean ) as Symbol ptr
    if depth > 8 then return nullptr
    t = c.types->Unqualify( t )
    if c.types->Kind( t ) = TK_REFERENCE then t = c.types->Unqualify( c.types->Inner( t ) )
    if c.types->Kind( t ) <> TK_UDT then return nullptr
    if TcTuple_( c, t ) then return nullptr
    if StructorOf_( c, t, "__ctor" ) <> nullptr then return nullptr
    if BaseOf_( c, t ) <> TYPE_NONE then return nullptr
    dim as InternId tn = c.types->NameOf( t )
    if tn = 0 then return nullptr
    dim as ScopeId ds = cast( ScopeId, c.types->DeclScopeOf( t ) )
    dim as SymbolId ts = c.syms->LookupLocalTyped( ds, tn, true )
    if ts = SYMBOL_NONE then ts = c.syms->LookupTyped( ds, tn, true )
    dim as Symbol ptr s = c.syms->SymbolAt( ts )
    if (s = nullptr) orelse (s->inner = SCOPE_NONE) then return nullptr
    dim as SymScope ptr sc = c.syms->ScopeAt( s->inner )
    if sc = nullptr then return nullptr
    dim as SymbolId cur = sc->firstSym
    for guard as int32 = 0 to 9999
        if cur = SYMBOL_NONE then exit for
        dim as Symbol ptr f = c.syms->SymbolAt( cur )
        if f = nullptr then exit for
        if (f->kind = cast( uint8, SYM_FIELD )) andalso (f->type_ <> TYPE_NONE) then
            dim as TypeId ft = c.types->Unqualify( f->type_ )
            if c.types->Kind( ft ) = TK_BUILTIN then
                if c.types->BuiltinOf( ft ) = TY_STRING then return f
                if wantU andalso (c.types->BuiltinOf( ft ) = TY_USTRING) then return f
            elseif c.types->Kind( ft ) = TK_UDT then
                dim as Symbol ptr deeper = TlTextField_( c, ft, depth + 1, wantU )
                if deeper <> nullptr then return deeper
            end if
        end if
        cur = f->nextInScope
    next
    return nullptr
end function

'' A non-empty 'type( ... )' with no type of its own -- Check types it as a tuple -- filling
'' 'dest', a record that holds text: TKO0929, fbc's 99. An assignment, a 'return' and a
'' 'dim' ask this; a literal Check typed as the record itself -- an argument, 'type<T>( )' --
'' is typelitstr.tiko's sweep. In a 'dim', a 'string' field is TKO0757's already.
private function TypeLitTextBad_ _
    ( byref c as Ctx, byval dest as TypeId, byval rn as NodeId, byval isDim as boolean ) as boolean
    if (rn = NODE_NONE) orelse (dest = TYPE_NONE) then return false
    while c.ast->Kind( rn ) = N_PAREN
        dim as ListPayload ptr pl = c.ast->ListOf( rn )
        if pl->count <> 1 then exit while
        rn = cast( NodeId, c.ast->ChildSlot( pl->first ) )
    wend
    if c.ast->Kind( rn ) <> N_TUPLE then return false
    if (c.ast->Flags( rn ) and NF_TYPE_LITERAL) = 0 then return false
    dim as ListPayload ptr lp = c.ast->ListOf( rn )
    if (lp->count = 0) orelse (lp->target <> NODE_NONE) then return false
    if TcTuple_( c, c.info->TypeOf_( rn ) ) = false then return false
    dim as Symbol ptr f = TlTextField_( c, dest, 0, true )
    if f = nullptr then return false
    if isDim andalso (TlTextField_( c, dest, 0, false ) <> nullptr) then return false
    dim as TypeId du = c.types->Unqualify( dest )
    if c.types->Kind( du ) = TK_REFERENCE then du = c.types->Unqualify( c.types->Inner( du ) )
    c.diags->Report( TKO0929, PointRange( c.ast->Loc( rn ) ), c.types->Name( du ), c.names->Spelling( f->name ) )
    return true
end function

private function TupleConvBad_ _
    ( byref c as Ctx, byval t as TypeId, byval rn as NodeId, byval depth as int32 ) as boolean
    if (rn = NODE_NONE) orelse (depth > 8) then return false
    '' '( ( 1, 2 ) )' is the literal inside.
    while c.ast->Kind( rn ) = N_PAREN
        dim as ListPayload ptr pl = c.ast->ListOf( rn )
        if pl->count <> 1 then exit while
        rn = cast( NodeId, c.ast->ChildSlot( pl->first ) )
    wend
    if c.ast->Kind( rn ) <> N_TUPLE then return TupleValueBad_( c, t, rn )
    '' AN INTERFACE IS NO RECORD TO FILL: its two hidden words are a reference only a conversion
    '' builds (docs/tiko-interfaces §7.1). '( p, q )' and 'type<I>( p, q )' would forge one.
    if c.types->IsInterface( t ) then
        c.diags->Report( TKO1009, PointRange( c.ast->Loc( rn ) ), "( ... )", c.types->Name( c.types->Unqualify( t ) ), "" )
        return true
    end if
    if (c.ast->Flags( rn ) and NF_TYPE_LITERAL) <> 0 then return false
    t = c.types->Unqualify( t )
    if TcTuple_( c, t ) = false then return false
    dim as ListPayload ptr lp = c.ast->ListOf( rn )
    if lp->target <> NODE_NONE then return false
    '' The element types, in order, off the tuple's own scope.
    dim as InternId tn = c.types->NameOf( t )
    if tn = 0 then return false
    dim as ScopeId ds = cast( ScopeId, c.types->DeclScopeOf( t ) )
    dim as SymbolId ts = c.syms->LookupLocalTyped( ds, tn, true )
    if ts = SYMBOL_NONE then ts = c.syms->LookupTyped( ds, tn, true )
    dim as Symbol ptr s = c.syms->SymbolAt( ts )
    if (s = nullptr) orelse (s->inner = SCOPE_NONE) then return false
    dim as SymScope ptr sc = c.syms->ScopeAt( s->inner )
    if sc = nullptr then return false
    dim as containers.Array( of uint32 ) ets
    dim as SymbolId cur = sc->firstSym
    for guard as int32 = 0 to 9999
        if cur = SYMBOL_NONE then exit for
        dim as Symbol ptr f = c.syms->SymbolAt( cur )
        if f = nullptr then exit for
        if f->kind = cast( uint8, SYM_FIELD ) then ets.Push( cast( uint32, f->type_ ) )
        cur = f->nextInScope
    next
    '' A count that does not match is the arity rule's (TKO0825), not this one.
    if ets.Count <> lp->count then return false
    for i as int32 = 0 to lp->count - 1
        dim as NodeId e = c.ast->ChildAt( lp->first, i )
        dim as TypeId et = cast( TypeId, ets[i] )
        if c.ast->Kind( e ) = N_TUPLE then
            if TupleConvBad_( c, et, e, depth + 1 ) then return true
            continue for
        end if
        dim as TypeId vt = c.info->TypeOf_( e )
        if TcTakes_( c, et, vt ) = false then
            c.diags->Report( TKO0831, PointRange( c.ast->Loc( e ) ), TcName_( c, vt ), TcName_( c, et ) )
            return true
        end if
    next
    return false
end function
