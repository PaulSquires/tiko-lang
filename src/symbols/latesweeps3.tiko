'' latesweeps3.tiko -- THE REST OF THE POST-CHECK SWEEPS.
''
'' Split out of latesweeps2.tiko at the 1500-line lint cap and included from it, at the
'' exact spot these subs stood, inside the same namespace. Nothing in them changed in
'' the move. They are the later rules -- const writes, a constant's type, REDIM shape,
'' THREADCALL, a byref default, a cast's string size and what an aggregate initializer
'' may fill -- and every helper from latesweeps2.tiko above the include is in scope.

'' The name an expression carries, for the diagnostic's '%0'.
private function SpellOf_ ( byref c as Ctx, byval n as NodeId ) as string
    if n = NODE_NONE then return ""
    if c.ast->Kind( n ) <> N_IDENT then return ""
    return c.names->Spelling( _
        c.ast->idents[cast( int32, c.ast->nodes[cast( int32, n )].data )].name )
end function

'' A WRITE TARGET AS THE READER WROTE IT (T34): '*pc', 'pc[ ]', 'pt->v', '( *pc )'. TKO0617
'' over a dereference said "cannot modify ''" -- SpellOf_ spells a bare name and nothing else.
private function ExprSpelling_ ( byref c as Ctx, byval n as NodeId, byval depth as int32 = 0 ) as string
    if (n = NODE_NONE) orelse (depth > 8) then return ""
    dim as string r = ""
    select case c.ast->Kind( n )
    case N_IDENT
        return SpellOf_( c, n )
    case N_DEREF
        r = ExprSpelling_( c, c.ast->unaries[cast( int32, c.ast->nodes[cast( int32, n )].data )].operand, depth + 1 )
        if len( r ) then r = "*" & r
    case N_INDEX
        r = ExprSpelling_( c, c.ast->lists[cast( int32, c.ast->nodes[cast( int32, n )].data )].target, depth + 1 )
        if len( r ) then r &= "[ ]"
    case N_PAREN
        dim as ListPayload ptr pl = @c.ast->lists[cast( int32, c.ast->nodes[cast( int32, n )].data )]
        if pl->count = 1 then r = ExprSpelling_( c, cast( NodeId, c.ast->children[pl->first] ), depth + 1 )
        if len( r ) then r = "( " & r & " )"
    case N_MEMBER
        dim as BinaryPayload ptr mb = @c.ast->binaries[cast( int32, c.ast->nodes[cast( int32, n )].data )]
        r = ExprSpelling_( c, mb->lhs, depth + 1 )
        dim as string rr = SpellOf_( c, mb->rhs )
        if (len( r ) > 0) andalso (len( rr ) > 0) then
            r &= iif( (c.ast->nodes[cast( int32, n )].flags and NF_ARROW) <> 0, "->", "." ) & rr
        else
            r = ""
        end if
    case N_CALL
        r = SpellOf_( c, c.ast->lists[cast( int32, c.ast->nodes[cast( int32, n )].data )].target )
        if len( r ) then r &= "( ... )"
    end select
    return r
end function

'' ...or, when it has no spelling of its own, a phrase rather than an empty pair of quotes.
private function TargetSpelling_ ( byref c as Ctx, byval n as NodeId ) as string
    dim as string r = ExprSpelling_( c, n )
    if len( r ) = 0 then r = "this target"
    return r
end function

'' NOTHING CONST MAY BE WRITTEN -- fbc error 119, "Cannot modify a constant". The simple
'' case, an assignment straight to a const VARIABLE, is CheckAssignTarget_'s; these are the
'' spellings that reach const storage through an expression, and every one was measured:
''
''     *p = 1          p as const integer ptr          error 119
''     *p = 1          p as integer const ptr          ACCEPTED -- the POINTEE is writable
''     cast( const integer, i ) = 1                    error 24
''     *cptr( const integer ptr, pci ) = 123           error 119
''     swap a, b       either one const                error 119
''     let( i ) = x    i a const                       error 119
''     *p = 0          p from 'var p = @( x.n )', n a const FIELD    error 119
''     (*strptr( s ))[0] = c    s a const string       error 119
''
'' ALL OF THEM ASK ONE QUESTION -- is the type this expression designates CONST -- so the
'' target's own type answers it, and a const POINTER answers 'no' because its POINTEE is
'' what a dereference designates. That is the distinction the const-pointer parser fix
'' made expressible; before it every one of these was a coin toss.
private function ConstDesignated_ ( byref c as Ctx, byval n as NodeId ) as boolean
    if n = NODE_NONE then return false
    dim as TypeId t = c.info->TypeOf_( n )
    if t = TYPE_NONE then return false
    if c.types->Kind( t ) = TK_REFERENCE then t = c.types->Inner( t )
    if c.types->IsConst( t ) then return true
    '' 's[ 0 ] = 1' OVER A CONST STRING is fbc's 119 too -- a var-len, fixed, or bare zstring
    '' or wstring, '(*strptr( s ))[ 0 ]' among them -- but the subscript's own type is a plain
    '' UBYTE, so the BASE is asked. A pointer base is not: its pointee answered above.
    if (c.ast->Kind( n ) <> N_INDEX) andalso (c.ast->Kind( n ) <> N_CALL) then return false
    dim as NodeId xb = c.ast->lists[cast( int32, c.ast->nodes[cast( int32, n )].data )].target
    if xb = NODE_NONE then return false
    '' 'a( 0 ) = 5' over 'dim as const integer a( 2 )' -- fbc's 119 -- and 'S[ 0 ] = 65' over
    '' 'const S = "abc"': the first wrote the element, the second stopped as unlowered.
    if c.ast->Kind( xb ) = N_IDENT then
        dim as Symbol ptr bs = c.syms->SymbolAt( c.info->RefOf( xb ) )
        if bs <> 0 then
            if cast( SymbolKind, bs->kind ) = SYM_CONSTANT then return true
            dim as TypeId at0 = c.types->Unqualify( bs->type_ )
            if (c.ast->Kind( n ) = N_CALL) andalso (c.types->Kind( at0 ) = TK_ARRAY) then
                return c.types->IsConst( c.types->Inner( at0 ) ) orelse c.types->IsConst( bs->type_ )
            end if
        end if
    end if
    if c.ast->Kind( n ) = N_CALL then return false
    dim as TypeId bt = c.info->TypeOf_( xb )
    if bt = TYPE_NONE then return false
    if c.types->Kind( bt ) = TK_REFERENCE then bt = c.types->Inner( bt )
    if c.types->Kind( bt ) = TK_POINTER then return false
    if c.types->IsConst( bt ) then return true
    if c.types->Kind( bt ) = TK_ARRAY then return c.types->IsConst( c.types->Inner( bt ) )
    return false
end function

'' The assignment targets CheckAssignTarget_ does not reach: a DEREFERENCE and a CAST.
'' A plain N_IDENT is left to it so nothing is reported twice.
private sub CheckConstWriteTarget_ ( byref c as Ctx, byval id as NodeId )
    if c.info->AmbiguousOf( id ) <> AMB_ASSIGN then return
    dim as StmtPayload ptr sp = _
        @c.ast->stmts[cast( int32, c.ast->nodes[cast( int32, id )].data )]
    if sp->a = NODE_NONE then return
    dim as NodeKind k = c.ast->Kind( sp->a )
    dim as boolean judged = (k = N_DEREF) orelse (k = N_INDEX)
    if k = N_CALL then
        '' 'cast( const T, x ) = ...' -- a CAST is not a call, and its result type is
        '' what is being written. A real call on the left is a property or an array
        '' subscript and is somebody else's question.
        dim as ListPayload ptr lp = _
            @c.ast->lists[cast( int32, c.ast->nodes[cast( int32, sp->a )].data )]
        if lp->target <> NODE_NONE then
            if c.ast->Kind( lp->target ) = N_IDENT then
                '' A SUBSCRIPTED VARIABLE -- an array element -- is judged like an index.
                dim as Symbol ptr ts = c.syms->SymbolAt( c.info->RefOf( lp->target ) )
                if ts <> 0 then judged = (cast( SymbolKind, ts->kind ) = SYM_VARIABLE)
                if c.info->RefOf( lp->target ) = SYMBOL_NONE then
                    dim as string cn = lcase( c.names->Spelling( _
                        c.ast->idents[cast( int32, c.ast->nodes[cast( int32, lp->target )].data )].name ) )
                    judged = (cn = "cast") orelse (cn = "cptr")
                    '' 'strptr( s ) = 0' -- fbc types strptr of a VAR-LEN string as a CONST
                    '' pointer, so assigning to the call is its 119, const string or not.
                    '' A fixed one's is error 24 instead and is not judged here.
                    if ((cn = "strptr") orelse (cn = "sadd")) andalso (lp->count >= 1) then
                        dim as TypeId st0 = c.info->TypeOf_( cast( NodeId, c.ast->children[lp->first] ) )
                        if c.types->Kind( st0 ) = TK_REFERENCE then st0 = c.types->Inner( st0 )
                        st0 = c.types->Unqualify( st0 )
                        if c.types->Kind( st0 ) = TK_BUILTIN then
                            select case c.types->BuiltinOf( st0 )
                            case TY_STRING, TY_USTRING
                                c.diags->Report( TKO0617, PointRange( c.ast->Loc( sp->a ) ), SpellOf_( c, sp->a ) )
                            end select
                        end if
                        return
                    end if
                    '' 'mid( s, i, n ) = v' WRITES INTO s, so a const string there is
                    '' fbc's 119 -- while a const INDEX argument is fine. The call's own
                    '' type is the string it returns, so argument 0 is what is judged.
                    if cn = "mid" then
                        if lp->count >= 1 then
                            dim as NodeId m0 = cast( NodeId, c.ast->children[lp->first] )
                            if ConstDesignated_( c, m0 ) then
                                c.diags->Report( TKO0617, _
                                    PointRange( c.ast->Loc( m0 ) ), SpellOf_( c, m0 ) )
                            end if
                        end if
                        return
                    end if
                end if
            end if
        end if
    end if
    if judged = false then return
    if ConstDesignated_( c, sp->a ) = false then return
    c.diags->Report( TKO0617, PointRange( c.ast->Loc( sp->a ) ), TargetSpelling_( c, sp->a ) )
end sub

'' SWAP WRITES BOTH OPERANDS, so a const on either side is fbc's 119. Measured both ways.
'' SWAP EXCHANGES STORAGE AND CONVERTS NOTHING, so its two operands must be of the same
'' KIND -- fbc error 20. Measured across the whole grid, and the kinds are broad:
''
''     string  <-> integer          error 20      integer <-> long      accepted
''     UDT     <-> any ptr          error 20      integer <-> double    accepted
''     Parent  <-> Child            error 20      integer <-> boolean   accepted
''     string  <-> any ptr          error 20      zstring * 8 <-> string   accepted
''                                                integer ptr <-> any ptr  accepted
''                                                two of the SAME udt      accepted
''
'' So NUMBER, STRING, POINTER and each UDT are the four kinds, a fixed string counts as a
'' STRING (it is an array of a character builtin), and two UDTs must be the same type.
'' Anything else -- an array that is not a fixed string, a procedure -- is declined.
private function SwapKindOf_ _
    ( byref c as Ctx, byval t as TypeId, byref udt as TypeId ) as int32
    udt = TYPE_NONE
    dim as TypeId u = ValueType_( c, t )
    if u = TYPE_NONE then return 0
    if c.types->Kind( u ) = TK_ARRAY then
        dim as TypeId el = c.types->Unqualify( c.types->Inner( u ) )
        if c.types->Kind( el ) = TK_BUILTIN then
            select case c.types->BuiltinOf( el )
            case TY_USTRING, TY_FIXUSTR : return 5
            case TY_ZSTRING, TY_WSTRING, TY_FIXSTR
                return 2
            end select
        end if
        return 0
    end if
    if c.types->Kind( u ) = TK_POINTER then return 3
    if c.types->Kind( u ) = TK_UDT then
        udt = u
        return 4
    end if
    if c.types->Kind( u ) <> TK_BUILTIN then return 0
    select case c.types->BuiltinOf( u )
    '' A USTRING, var-length or fixed, is a FIFTH kind: fbc swaps two of them through
    '' fb_UStrSwap and refuses one against any narrow string, error 20 (measured: 'swap s, u',
    '' 'swap u, f' over a string * 4, 'swap z, u', 'swap s, uf' over a ustring * 4).
    case TY_USTRING, TY_FIXUSTR : return 5
    case TY_STRING, TY_ZSTRING, TY_WSTRING, TY_FIXSTR
        return 2
    case TY_BYTE, TY_UBYTE, TY_SHORT, TY_USHORT, TY_LONG, TY_ULONG, _
         TY_INTEGER, TY_UINTEGER, TY_LONGINT, TY_ULONGINT, TY_SINGLE, TY_DOUBLE, _
         TY_BOOLEAN
        return 1
    end select
    return 0
end function

'' EIGHT LEVELS OF POINTER IS THE LIMIT -- fbc error 274, "Too many levels of pointer
'' indirection". Measured exactly at the boundary, and it counts THROUGH TYPEDEFS:
''
''     dim p as integer ptr x8                                  accepted
''     dim p as integer ptr x9                                  error 274
''     type t as integer ptr x4 : dim p as t ptr x4             accepted
''     type t as integer ptr x4 : dim p as t ptr x5             error 274
''     type t as integer ptr x4 : type u as t ptr x4 : dim p as u ptr   error 274
''
'' The RESOLVED type is what carries the answer, so the count is a walk down Inner( ) --
'' a typedef has already been substituted by the time this runs.
private function PointerDepth_ ( byref c as Ctx, byval t as TypeId ) as int32
    dim as int32 n = 0
    dim as TypeId u = c.types->Unqualify( t )
    while (u <> TYPE_NONE) andalso (n < 64)
        if c.types->Kind( u ) <> TK_POINTER then exit while
        n += 1
        u = c.types->Unqualify( c.types->Inner( u ) )
    wend
    return n
end function

'' TWO WAYS TO GET fbc's 158 FROM OUTSIDE, both measured with their accepted twins:
''
''     namespace ns { dim shared arr( ) }
''       redim ns.arr( 4 to 5 ) as integer            accepted
''       redim SHARED ns.arr( 4 to 5 ) as integer     error 158 -- SHARED re-declares
''     namespace ns { extern i as integer }
''       dim ns.i as integer                          accepted -- defines the extern
''       ...a SECOND 'dim ns.i as integer'            error 158
''     namespace ns { extern arr( ) as integer }
''       redim ns.arr( ) as integer  (once)           accepted
''       ...a SECOND 'redim ns.arr( )'                error 158
''       redim ns.arr( ) then redim ns.arr( 0 to 2 )  accepted -- the second RE-DIMENSIONS
''     type U { static i( ) as integer }
''       redim U.i( ) as integer  (once)              accepted
''       ...a SECOND one                              error 158
''
'' The second half turns on the same distinction TKO0751 needed: EMPTY parens declare and
'' written BOUNDS re-dimension, so only a bounds-less qualified declaration is a
'' DEFINITION, and only a second definition of one name is the error.
'' Is this qualified item a DEFINITION -- a type written and no bounds?
private function IsOutsideDefinition_ ( byref c as Ctx, byval item as NodeId ) as boolean
    if c.ast->Kind( item ) <> N_VAR_ITEM then return false
    if (c.ast->nodes[cast( int32, item )].flags and NF_QUALIFIED) = 0 then return false
    dim as StmtPayload ptr ip = _
        @c.ast->stmts[cast( int32, c.ast->nodes[cast( int32, item )].data )]
    if ip->ownerName = 0 then return false
    if ip->a = NODE_NONE then return false
    if ip->c <> NODE_NONE then
        if c.ast->Kind( ip->c ) = N_BLOCK then
            if c.ast->lists[cast( int32, _
                c.ast->nodes[cast( int32, ip->c )].data )].count > 0 then return false
        end if
    end if
    return true
end function

'' ONE STATEMENT LIST AT A TIME. Comparing qualified definitions across the WHOLE file
'' called two independent ones a duplicate: dim/member-var.bas declares a 'type UDT' with
'' a static member inside SEVERAL test blocks and defines 'UDT.a' in each, and
'' namespace/outside.bas does the same with 'varB.i2'. Two definitions collide only when
'' they sit in the SAME list, which is what fbc means by a redefinition here.
private sub CheckOutsideRange_ ( byref c as Ctx, byval blk as NodeId )
    if blk = NODE_NONE then return
    dim as NodeKind bk = c.ast->Kind( blk )
    dim as int32 lf = 0, lc = 0
    if bk = N_NAMESPACE then
        '' A NAMESPACE KEEPS ITS STATEMENTS AS ITS OWN CHILDREN, not in a block in 'b', so
        '' nothing inside one was ever judged here.
        dim as StmtPayload ptr nsp = @c.ast->stmts[cast( int32, c.ast->nodes[cast( int32, blk )].data )]
        lf = nsp->first : lc = nsp->count
    elseif (bk = N_BLOCK) orelse (bk = N_MODULE) then
        dim as ListPayload ptr bl = @c.ast->lists[cast( int32, c.ast->nodes[cast( int32, blk )].data )]
        lf = bl->first : lc = bl->count
    else
        return
    end if
    for i as int32 = 0 to lc - 1
        dim as NodeId st = cast( NodeId, c.ast->children[lf + i] )
        if st = NODE_NONE then continue for
        dim as NodeKind sk = c.ast->Kind( st )
        '' Descend into everything that carries a statement list of its own.
        if sk = N_NAMESPACE then
            CheckOutsideRange_( c, st )
            continue for
        end if
        if sk = N_PROC then
            dim as StmtPayload ptr pp = _
                @c.ast->stmts[cast( int32, c.ast->nodes[cast( int32, st )].data )]
            CheckOutsideRange_( c, pp->b )
            continue for
        end if
        if sk = N_SCOPE then
            dim as StmtPayload ptr cp = _
                @c.ast->stmts[cast( int32, c.ast->nodes[cast( int32, st )].data )]
            CheckOutsideRange_( c, cp->b )
            continue for
        end if
        if sk <> N_VAR then continue for
        dim as StmtPayload ptr sp = _
            @c.ast->stmts[cast( int32, c.ast->nodes[cast( int32, st )].data )]
        dim as boolean isShared = _
            ((c.ast->nodes[cast( int32, st )].flags and NF_SHARED) <> 0)
        for k as int32 = 0 to sp->count - 1
            dim as NodeId item = cast( NodeId, c.ast->children[sp->first + k] )
            if c.ast->Kind( item ) <> N_VAR_ITEM then continue for
            if (c.ast->nodes[cast( int32, item )].flags and NF_QUALIFIED) = 0 then continue for
            dim as StmtPayload ptr ip = _
                @c.ast->stmts[cast( int32, c.ast->nodes[cast( int32, item )].data )]
            if ip->ownerName = 0 then continue for
            '' INSIDE A NAMESPACE, ONLY A NAMESPACE NESTED IN IT MAY BE NAMED. Measured on
            '' fbc-modern 1.20, 2026-09-29, with 'extern i1 as integer' in namespace a:
            ''
            ''     namespace a : dim shared a.i1 ...          error 131   the namespace itself
            ''     namespace b : dim shared a.i1 ...          error 131   a sibling
            ''     namespace ns.a : dim shared a.i1 ...       error 131   namespace/outside-var-12
            ''     namespace a : dim shared b.i1 ...          fine        b nested in a
            ''
            '' tiko accepted the three. At module level the TKO0761 rule below is the one asked.
            dim as SymScope ptr cur = c.syms->ScopeAt( c.info->ScopeOf( st ) )
            if cur <> 0 then
                if cur->kind = cast( uint8, SCOPEK_NAMESPACE ) then
                    dim as ScopeId os = NamespaceScopeOf_( c, ip->ownerName )
                    '' ...AND ONLY A NAMESPACE: 'dim as integer A.i1' DEFINES A STATIC MEMBER of a
                    '' type A declared beside it (dim/member-var.bas), which fbc takes. The owner's
                    '' first name is looked up from here, and anything but a namespace is let be.
                    dim as string oq = c.names->Spelling( ip->ownerName )
                    if instr( oq, "." ) > 0 then oq = left( oq, instr( oq, "." ) - 1 )
                    dim as Symbol ptr oh = c.syms->SymbolAt( c.syms->Lookup( c.info->ScopeOf( st ), c.names->GetString( oq ) ) )
                    if (oh = 0) orelse (oh->kind <> cast( uint8, SYM_NAMESPACE )) then os = SCOPE_NONE
                    if os <> SCOPE_NONE then
                        dim as boolean nested = false
                        dim as SymScope ptr up = c.syms->ScopeAt( os )
                        for hop as int32 = 0 to 63
                            if up = 0 then exit for
                            if up->parent = c.info->ScopeOf( st ) then nested = true : exit for
                            up = c.syms->ScopeAt( up->parent )
                        next
                        if nested = false then
                            c.diags->Report( TKO0886, PointRange( c.ast->Loc( item ) ), _
                                             c.names->Spelling( ip->ownerName ) & "." & _
                                             c.names->Spelling( ip->name ) )
                        end if
                    end if
                    '' The rules below were only ever asked at module level and in procedure
                    '' bodies -- a namespace body was not walked -- and they stay that way.
                    continue for
                end if
            end if
            if isShared then
                if NamespaceScopeOf_( c, ip->ownerName ) <> SCOPE_NONE then
                    c.diags->Report( TKO0761, PointRange( c.ast->Loc( item ) ), _
                                     c.names->Spelling( ip->ownerName ) & "." & _
                                     c.names->Spelling( ip->name ) )
                    continue for
                end if
            end if
            if IsOutsideDefinition_( c, item ) = false then continue for
            dim as InternId wo = c.names->Fold( ip->ownerName )
            dim as InternId wn = c.names->Fold( ip->name )
            dim as boolean seen = false
            for m as int32 = 0 to i - 1
                dim as NodeId ps = cast( NodeId, c.ast->children[lf + m] )
                if ps = NODE_NONE then continue for
                if c.ast->Kind( ps ) <> N_VAR then continue for
                dim as StmtPayload ptr pv = _
                    @c.ast->stmts[cast( int32, c.ast->nodes[cast( int32, ps )].data )]
                for j as int32 = 0 to pv->count - 1
                    dim as NodeId pit = cast( NodeId, c.ast->children[pv->first + j] )
                    if IsOutsideDefinition_( c, pit ) = false then continue for
                    dim as StmtPayload ptr pip = _
                        @c.ast->stmts[cast( int32, c.ast->nodes[cast( int32, pit )].data )]
                    if c.names->Fold( pip->ownerName ) <> wo then continue for
                    if c.names->Fold( pip->name ) <> wn then continue for
                    seen = true
                next
            next
            if seen = false then continue for
            c.diags->Report( TKO0762, PointRange( c.ast->Loc( item ) ), _
                             c.names->Spelling( ip->ownerName ) & "." & _
                             c.names->Spelling( ip->name ) )
        next
    next
end sub

private sub CheckOutsideDefinitions_( byref c as Ctx )
    CheckOutsideRange_( c, c.root )
end sub

'' AN ARRAY DECLARATION IS ALL 'any' OR ALL WRITTEN BOUNDS -- fbc's error 9 with the
'' bounds first and 94 with 'any' first, but one refusal either way. Measured:
''
''     dim a( 0 to 0, any )    error 9      dim a( any, any )        accepted
''     dim a( any, 0 to 0 )    error 94     dim a( 0 to 0, 0 to 1 )  accepted
''                                          dim a( any )             accepted
''
'' The two spellings sit side by side in the bounds block: a written range is an
'' N_CASE_RANGE and an 'any' is a bare N_IDENT, so the mix is visible without resolving
'' anything.
''
'' ...AND A TYPE'S ARRAY FIELD IS DECLARED WITH 'dim', NOT 'redim' -- 'type UDT { redim
'' array( ) as integer }' is fbc's 9 as well, while 'array( any ) as integer' is the form.
private sub CheckArrayBoundKinds_( byref c as Ctx )
    for n as int32 = 0 to c.ast->Count( ) - 1
        dim as NodeId id = cast( NodeId, n )
        if c.ast->Kind( id ) <> N_VAR_ITEM then continue for
        dim as StmtPayload ptr ip = _
            @c.ast->stmts[cast( int32, c.ast->nodes[n].data )]
        if ip->c = NODE_NONE then continue for
        if c.ast->Kind( ip->c ) <> N_BLOCK then continue for
        dim as ListPayload ptr bl = _
            @c.ast->lists[cast( int32, c.ast->nodes[cast( int32, ip->c )].data )]
        if bl->count < 2 then continue for
        dim as boolean sawAny = false
        dim as boolean sawBounds = false
        for i as int32 = 0 to bl->count - 1
            dim as NodeId b = cast( NodeId, c.ast->children[bl->first + i] )
            if b = NODE_NONE then continue for
            if c.ast->Kind( b ) = N_CASE_RANGE then
                sawBounds = true
            elseif c.ast->Kind( b ) = N_IDENT then
                dim as string bn = lcase( c.names->Spelling( _
                    c.ast->idents[cast( int32, c.ast->nodes[cast( int32, b )].data )].name ) )
                if bn = "any" then sawAny = true
            end if
        next
        if (sawAny andalso sawBounds) = false then continue for
        c.diags->Report( TKO0765, PointRange( c.ast->Loc( id ) ), _
                         c.names->Spelling( ip->name ) )
    next
end sub

private sub CheckRedimInType_( byref c as Ctx )
    for n as int32 = 0 to c.ast->Count( ) - 1
        dim as NodeId id = cast( NodeId, n )
        if c.ast->Kind( id ) <> N_TYPE then continue for
        dim as StmtPayload ptr sp = _
            @c.ast->stmts[cast( int32, c.ast->nodes[n].data )]
        for i as int32 = 0 to sp->count - 1
            dim as NodeId m = cast( NodeId, c.ast->children[sp->first + i] )
            if m = NODE_NONE then continue for
            if c.ast->Kind( m ) <> N_VAR then continue for
            dim as StmtPayload ptr mp = _
                @c.ast->stmts[cast( int32, c.ast->nodes[cast( int32, m )].data )]
            if mp->op <> cast( uint16, KW_REDIM ) then continue for
            '' ...ONLY WITH EMPTY PARENS. 'redim a( 0 to 0 )' and 'redim a( any )' inside a
            '' type are both accepted -- structs/dynamic-array-fields.bas says in a comment
            '' that REDIM makes a dynamic array there even with constant bounds, and
            '' structs/udt-array-ops-1.bas writes the 'any' form. Only a field with NOTHING
            '' between the parentheses is fbc's 9, which is the same empty-parens-versus-
            '' bounds distinction TKO0751 and TKO0762 turn on.
            for k as int32 = 0 to mp->count - 1
                dim as NodeId it = cast( NodeId, c.ast->children[mp->first + k] )
                if c.ast->Kind( it ) <> N_VAR_ITEM then continue for
                dim as StmtPayload ptr ipp = _
                    @c.ast->stmts[cast( int32, c.ast->nodes[cast( int32, it )].data )]
                if ipp->c <> NODE_NONE then
                    if c.ast->Kind( ipp->c ) = N_BLOCK then
                        if c.ast->lists[cast( int32, _
                            c.ast->nodes[cast( int32, ipp->c )].data )].count > 0 then continue for
                    end if
                end if
                c.diags->Report( TKO0766, PointRange( c.ast->Loc( m ) ) )
                exit for
            next
            continue for
        next
    next
end sub

private sub CheckPointerDepth_( byref c as Ctx )
    for n as int32 = 0 to c.ast->Count( ) - 1
        dim as NodeId id = cast( NodeId, n )
        if c.ast->Kind( id ) <> N_TYPEREF then continue for
        '' ONLY THE OUTERMOST typeref of a chain is judged: the inner ones are the same
        '' type one level shallower, and reporting each would give nine diagnostics for
        '' one declaration. A typeref whose PARENT is another typeref is an inner one --
        '' which is what a pointer wrapper is, so the test is on the node's own flags.
        if (c.ast->nodes[n].flags and NF_PTR) = 0 then continue for
        dim as int32 depth = PointerDepth_( c, c.info->TypeOf_( id ) )
        if depth <= 8 then continue for
        c.diags->Report( TKO0760, PointRange( c.ast->Loc( id ) ) )
        return
    next
end sub

private sub CheckSwapTypes_ ( byref c as Ctx, byval id as NodeId )
    dim as StmtPayload ptr sp = _
        @c.ast->stmts[cast( int32, c.ast->nodes[cast( int32, id )].data )]
    if cast( TokenKind, sp->op ) <> KW_SWAP then return
    if (sp->a = NODE_NONE) orelse (sp->b = NODE_NONE) then return
    dim as TypeId au, bu
    dim as int32 ak = SwapKindOf_( c, c.info->TypeOf_( sp->a ), au )
    dim as int32 bk = SwapKindOf_( c, c.info->TypeOf_( sp->b ), bu )
    if (ak = 0) orelse (bk = 0) then return
    '' A UDT WITH A CONVERSION OPERATOR IS NOT THIS QUESTION. 'swap str( u1 ), u2' over a
    '' type that casts to a zstring is accepted by fbc, and this suite's own
    '' swap-udt-zstring test writes exactly that mixed spelling -- which overload runs is
    '' not modelled here, so any 'cast' at all declines.
    if au <> TYPE_NONE then
        if DeclaresAnywhere_( c, au, "cast" ) then return
    end if
    if bu <> TYPE_NONE then
        if DeclaresAnywhere_( c, bu, "cast" ) then return
    end if
    dim as boolean bad = (ak <> bk)
    if (bad = false) andalso (ak = 4) then bad = (au <> bu)
    if bad = false then return
    c.diags->Report( TKO0759, PointRange( c.ast->Loc( id ) ) )
end sub

private sub CheckSwapConst_ ( byref c as Ctx, byval id as NodeId )
    dim as StmtPayload ptr sp = _
        @c.ast->stmts[cast( int32, c.ast->nodes[cast( int32, id )].data )]
    if cast( TokenKind, sp->op ) <> KW_SWAP then return
    for pass_ as int32 = 0 to 1
        dim as NodeId v = sp->a
        if pass_ = 1 then v = sp->b
        if v = NODE_NONE then continue for
        '' A LITERAL and a NAMED CONSTANT are TKO0642's, not this rule's -- reporting them
        '' here too put two diagnostics on one 'swap K, b'. What TKO0642 does not see is a
        '' variable whose TYPE is const, which is what rtl-swap.bas writes.
        dim as boolean bad = ConstDesignated_( c, v )
        if bad then
            c.diags->Report( TKO0617, PointRange( c.ast->Loc( v ) ), _
                             SpellOf_( c, v ) )
            return
        end if
    next
end sub

'' A CONSTANT'S TYPE MUST BE ONE A VALUE CAN BE FOLDED INTO -- fbc error 24. Measured
'' across the whole set, and the accepted side is wide:
''
''     integer  double  single  longint  ubyte  boolean       accepted
''     string (plain)   any pointer      an enum              accepted
''     any              string * 20      zstring * 20         error 24
''     wstring * 20     a UDT            a UDT with no '='    error 24
''
'' A FIXED STRING IS AN ARRAY of a character builtin in this type model, which is what the
'' TK_ARRAY test below is reading; a const ARRAY is not a thing FreeBASIC has.
private sub CheckConstDeclTypes2_( byref c as Ctx )
    for n as int32 = 0 to c.ast->Count( ) - 1
        dim as NodeId id = cast( NodeId, n )
        if c.ast->Kind( id ) <> N_CONST then continue for
        dim as StmtPayload ptr sp = _
            @c.ast->stmts[cast( int32, c.ast->nodes[n].data )]
        for i as int32 = 0 to sp->count - 1
            dim as NodeId item = cast( NodeId, c.ast->children[sp->first + i] )
            if c.ast->Kind( item ) <> N_VAR_ITEM then continue for
            dim as StmtPayload ptr ip = _
                @c.ast->stmts[cast( int32, c.ast->nodes[cast( int32, item )].data )]
            '' WITHOUT AN EXPLICIT TYPE there is nothing to judge: 'const k = 1' infers.
            if ip->a = NODE_NONE then continue for
            dim as TypeId t = c.types->Unqualify( c.info->TypeOf_( ip->a ) )
            if t = TYPE_NONE then continue for
            dim as boolean bad = false
            select case c.types->Kind( t )
            case TK_UDT, TK_ARRAY
                bad = true
            case TK_BUILTIN
                bad = (c.types->BuiltinOf( t ) = TY_ANY)
            end select
            if bad = false then continue for
            c.diags->Report( TKO0748, PointRange( c.ast->Loc( item ) ), _
                             c.names->Spelling( ip->name ) )
        next
    next
end sub

'' WHAT 'threadcall' CAN RUN. Two fbc errors, both measured over the whole threads/
'' family, and the accepted side of each measured beside it:
''
''     threadcall goodSub( )                 accepted
''     threadcall someFunction( )            error 289 -- a FUNCTION is not a sub
''     threadcall bc.BadMember( )            error 289 -- and neither is a qualified call
''     threadcall pascalSub( )               error 288 -- the calling convention
''     threadcall cdeclSub( ) / stdcallSub( )  accepted
''     threadcall f( u )  u a BYVAL UDT holding an ARRAY, STRING or BITFIELD   error 288
''     threadcall f( u )  u a byval UNION, or a UDT with an anonymous one   error 288
''     threadcall f( u )  u a byval UDT holding a BITFIELD        error 288
''     threadcall f( u )  u a byval PLAIN UDT                     accepted
''
'' The 288 cases are all the same shape: the thread trampoline copies each byval argument,
'' and fbc will not copy an aggregate whose layout it cannot pass through one pointer.
private function ThreadUnsupportedUdt_ _
    ( byref c as Ctx, byval t as TypeId, byref why as string, byval depth as int32 ) as boolean

    if depth > 8 then return false
    dim as TypeId u = c.types->Unqualify( t )
    if c.types->Kind( u ) <> TK_UDT then return false
    dim as Symbol ptr ts = UdtSymbolOf_( c, u )
    if ts = 0 then return false
    if (ts->flags and SYMF_UNION_KIND) <> 0 then
        why = "a union cannot be passed to a thread"
        return true
    end if
    if ts->inner = SCOPE_NONE then return false
    for i as int32 = 0 to c.syms->symbols.Count - 1
        dim as Symbol ptr f = @c.syms->symbols[i]
        if f->parent <> ts->inner then continue for
        if f->kind <> cast( uint8, SYM_FIELD ) then continue for
        if (f->flags and SYMF_UNION) <> 0 then
            why = "a union field cannot be passed to a thread"
            return true
        end if
        if (f->flags and SYMF_BITFIELD) <> 0 then
            why = "a bitfield cannot be passed to a thread"
            return true
        end if
        if f->type_ = TYPE_NONE then continue for
        dim as TypeId ft = c.types->Unqualify( f->type_ )
        if c.types->Kind( ft ) = TK_BUILTIN then
            if c.types->BuiltinOf( ft ) = TY_STRING then
                why = "a string field cannot be passed byval to a thread"
                return true
            end if
        end if
        if c.types->Kind( ft ) = TK_ARRAY then
            '' A FIXED STRING is an array of a character builtin and is not this.
            dim as TypeId el = c.types->Unqualify( c.types->Inner( ft ) )
            dim as boolean fixstr = false
            if c.types->Kind( el ) = TK_BUILTIN then
                select case c.types->BuiltinOf( el )
                case TY_ZSTRING, TY_WSTRING, TY_USTRING, TY_FIXSTR, TY_FIXUSTR
                    fixstr = true
                end select
            end if
            if fixstr = false then
                why = "an array field cannot be passed to a thread"
                return true
            end if
        end if
        if c.types->Kind( ft ) = TK_UDT then
            if ThreadUnsupportedUdt_( c, ft, why, depth + 1 ) then return true
        end if
    next
    return false
end function

private sub CheckThreadCall_ ( byref c as Ctx, byval id as NodeId )
    dim as StmtPayload ptr sp = _
        @c.ast->stmts[cast( int32, c.ast->nodes[cast( int32, id )].data )]
    if cast( TokenKind, sp->op ) <> KW_THREADCALL then return
    '' THE CALL IS THE ONE CHILD, not 'a': the parser pushes it into the child list.
    if sp->count < 1 then return
    dim as NodeId tcall = cast( NodeId, c.ast->children[sp->first] )
    if tcall = NODE_NONE then return
    if c.ast->Kind( tcall ) <> N_CALL then
        '' 'threadcall NoArgs' WITHOUT PARENTHESES is the name alone, no N_CALL. It runs
        '' no more than the other spelling does, so it gets TKO0797 too -- and only that.
        dim as Symbol ptr bare = c.syms->SymbolAt( c.info->RefOf( tcall ) )
        if bare = 0 then return
        if bare->kind <> cast( uint8, SYM_PROC ) then return
        dim as NodeId bdecl = cast( NodeId, bare->payload )
        if bdecl = NODE_NONE then return
        if c.ast->Kind( bdecl ) <> N_PROC then return
        dim as StmtPayload ptr bp = _
            @c.ast->stmts[cast( int32, c.ast->nodes[cast( int32, bdecl )].data )]
        if cast( TokenKind, bp->op ) = KW_FUNCTION then return
        c.diags->Report( TKO0797, PointRange( c.ast->Loc( tcall ) ), _
                         c.names->Spelling( bp->name ) )
        return
    end if
    dim as ListPayload ptr lp = _
        @c.ast->lists[cast( int32, c.ast->nodes[cast( int32, tcall )].data )]
    if lp->target = NODE_NONE then return

    '' A QUALIFIED CALL is not a plain sub either -- 'bc.BadMember( )' is fbc's 289.
    if c.ast->Kind( lp->target ) = N_MEMBER then
        c.diags->Report( TKO0749, PointRange( c.ast->Loc( tcall ) ), "this member call" )
        return
    end if
    dim as Symbol ptr callee = c.syms->SymbolAt( c.info->RefOf( tcall ) )
    if callee = 0 then callee = c.syms->SymbolAt( c.info->RefOf( lp->target ) )
    if callee = 0 then return
    if callee->kind <> cast( uint8, SYM_PROC ) then return
    dim as NodeId decl = cast( NodeId, callee->payload )
    if decl = NODE_NONE then return
    if c.ast->Kind( decl ) <> N_PROC then return
    dim as StmtPayload ptr pp = _
        @c.ast->stmts[cast( int32, c.ast->nodes[cast( int32, decl )].data )]

    '' A FUNCTION IS NOT A SUB. The result type is what says so: a SUB has none.
    if cast( TokenKind, pp->op ) = KW_FUNCTION then
        c.diags->Report( TKO0749, PointRange( c.ast->Loc( tcall ) ), _
                         c.names->Spelling( pp->name ) )
        return
    end if
    if (pp->extra and PF_PASCAL) <> 0 then
        c.diags->Report( TKO0750, PointRange( c.ast->Loc( tcall ) ), _
                         c.names->Spelling( pp->name ), _
                         "the PASCAL calling convention is not supported" )
        return
    end if
    for i as int32 = 0 to pp->count - 1
        dim as NodeId prm = cast( NodeId, c.ast->children[pp->first + i] )
        if c.ast->Kind( prm ) <> N_PARAM then continue for
        '' BYVAL ONLY. The byval side is consistent and was measured whole: a UDT holding
        '' an ARRAY, a STRING or a BITFIELD, and a UNION, are each fbc's 288, while a plain
        '' UDT, an integer and a string PARAMETER are all accepted.
        ''
        '' THE BYREF SIDE IS NOT MODELLED, because it does not reduce to "contains X" and
        '' guessing it refused threads/threadcall.bas, which fbc compiles:
        ''
        ''     byref, UDT holding an array only          error 288
        ''     byref, that UDT plus a STRING field       ACCEPTED
        ''     byref, that UDT plus a BITFIELD           ACCEPTED
        ''     byref, a UNION                            error 288
        ''
        '' Whatever decides that, it is not the field list alone, so the whole byref half
        '' is declined rather than half-modelled.
        if (c.ast->nodes[cast( int32, prm )].flags and NF_BYREF) <> 0 then continue for
        if (c.ast->nodes[cast( int32, prm )].flags and NF_ARRAY) <> 0 then continue for
        dim as StmtPayload ptr prp = _
            @c.ast->stmts[cast( int32, c.ast->nodes[cast( int32, prm )].data )]
        if prp->a = NODE_NONE then continue for
        dim as string why = ""
        if ThreadUnsupportedUdt_( c, c.info->TypeOf_( prp->a ), why, 0 ) then
            c.diags->Report( TKO0750, PointRange( c.ast->Loc( tcall ) ), _
                             c.names->Spelling( pp->name ), why )
            return
        end if
    next

    '' A THREADCALL fbc ACCEPTS, and neither runtime can run: TKO0797. Only after every
    '' error above, so a call that is refused is not also warned about.
    c.diags->Report( TKO0797, PointRange( c.ast->Loc( tcall ) ), _
                     c.names->Spelling( pp->name ) )
end sub

'' 'x IS T' -- fbc's errors 299, 297 and 298, checked in that order. Measured over 28
'' probes against fbc-modern win64 (2026-09-19); tiko accepted every one of them:
''
''     the operand is not a UDT -- a number, a pointer, a STRING    299 Expected a CLASS
''     the operand's type does not extend OBJECT                    297 no RTTI
''     T is not a UDT ('va is integer')                             299
''     T does not extend OBJECT                                     297
''     T is not STRICTLY DERIVED from the operand's static type     298 no hierarchical relation
''
'' The operand is judged before T: 'vu is integer' over a type with no RTTI is 297, not
'' 299. And the last rule is the one that looks wrong and is not -- the SAME type, a
'' BASE, OBJECT itself and an unrelated type are all refused, so 'va is A' over an A
'' does not compile. Only a proper descendant, at any depth, is accepted, and it is the
'' operand's STATIC type that counts: through a variable, '*p', a byref parameter, a
'' field and a call result alike.
private function DerivesStrictly_ _
    ( byref c as Ctx, byval derived as TypeId, byval base_ as TypeId ) as boolean
    dim as TypeId cur = BaseOf_( c, derived )
    dim as int32 guard = 0
    while (cur <> TYPE_NONE) andalso (guard < 64)
        guard += 1
        if c.types->Unqualify( cur ) = base_ then return true
        cur = BaseOf_( c, cur )
    wend
    return false
end function

private sub CheckIsTest_ ( byref c as Ctx, byval id as NodeId )
    dim as BinaryPayload ptr bp = _
        @c.ast->binaries[cast( int32, c.ast->nodes[cast( int32, id )].data )]
    if cast( TokenKind, bp->op ) <> KW_IS then return
    dim as TypeId lt = c.info->TypeOf_( bp->lhs )
    dim as TypeId rt = c.info->TypeOf_( bp->rhs )
    '' AN UNTYPED SIDE has already been reported -- an undeclared T is TKO0743.
    if (lt = TYPE_NONE) orelse (rt = TYPE_NONE) then return
    lt = c.types->Unqualify( lt )
    rt = c.types->Unqualify( rt )
    dim as SourceRange r = PointRange( c.ast->Loc( id ) )
    if c.types->Kind( lt ) <> TK_UDT then
        c.diags->Report( TKO0800, r, c.types->Name( lt ) )
    elseif ExtendsObject_( c, lt ) = false then
        c.diags->Report( TKO0799, r, c.types->Name( lt ) )
    elseif c.types->Kind( rt ) <> TK_UDT then
        c.diags->Report( TKO0800, r, c.types->Name( rt ) )
    elseif ExtendsObject_( c, rt ) = false then
        c.diags->Report( TKO0799, r, c.types->Name( rt ) )
    elseif DerivesStrictly_( c, rt, lt ) = false then
        c.diags->Report( TKO0798, r, c.types->Name( rt ), c.types->Name( lt ) )
    end if
end sub

'' TWO THINGS EVERY REDIM MUST HAVE. Measured, with the accepted line beside each:
''
''     redim array( 1 to 2 )                     error 147 -- it DECLARES, with no type
''     redim shared a( 0 to 1 )                  error 147
''     redim a$( 0 to 1 )                        error 147 -- a suffix is not a type
''     extern a( ) as integer : redim a( )       error 147 -- still declares nothing typed
''     redim array( 1 to 2 ) as integer          accepted
''     dim a( ) as integer : redim a( 0 to 2 )   accepted -- the DIM gave it a type
''     redim a( 0 to 2 ) as integer : redim a( 0 to 3 )    accepted -- so did the first
''     sub s( a( ) as integer ) : redim a( 0 to 2 )        accepted -- so did the parameter
''
''     redim array as integer                    error 63 -- no bounds at all
''     redim a$                                  error 63
''     dim a( ) as integer : redim a as integer  error 63
''
'' The first rule is about a redim that DECLARES: the ordinary re-dimensioning of an array
'' something else already declared needs no type, which is the commonest spelling there is.
'' The symbol's own declaration item is what says which this is -- when the redim item IS
'' the declaration, nothing else typed the array.
private sub CheckRedimDeclShape_( byref c as Ctx )
    for n as int32 = 0 to c.ast->Count( ) - 1
        dim as NodeId id = cast( NodeId, n )
        if c.ast->Kind( id ) <> N_VAR then continue for
        dim as StmtPayload ptr sp = _
            @c.ast->stmts[cast( int32, c.ast->nodes[n].data )]
        if sp->op <> cast( uint16, KW_REDIM ) then continue for
        for i as int32 = 0 to sp->count - 1
            dim as NodeId item = cast( NodeId, c.ast->children[sp->first + i] )
            if c.ast->Kind( item ) <> N_VAR_ITEM then continue for
            dim as StmtPayload ptr ip = _
                @c.ast->stmts[cast( int32, c.ast->nodes[cast( int32, item )].data )]

            '' BOUNDS FIRST: without them there is no array to re-dimension at all, and
            '' that is the error whether or not a type was written.
            '' NO PARENTHESES AT ALL is the 63: there is no array here to re-dimension.
            '' EMPTY parens 'a( )' are a different thing and are read below.
            dim as boolean hasParens = false
            dim as int32 bounds = 0
            if ip->c <> NODE_NONE then
                if c.ast->Kind( ip->c ) = N_BLOCK then
                    hasParens = true
                    bounds = c.ast->lists[cast( int32, _
                        c.ast->nodes[cast( int32, ip->c )].data )].count
                end if
            end if
            if hasParens = false then
                '' ...UNLESS THE TARGET IS NOT AN ARRAY AT ALL, which is TKO0695's. 'redim
                '' scalar' over an 'extern scalar as integer' is one fbc error, and putting
                '' both on it made two -- caught by this suite's outside-namespace-2 test.
                dim as Symbol ptr ns = c.syms->SymbolAt( c.info->RefOf( item ) )
                if ns <> 0 then
                    if ns->type_ <> TYPE_NONE then
                        if c.types->Kind( c.types->Unqualify( ns->type_ ) ) <> TK_ARRAY then
                            continue for
                        end if
                    end if
                end if
                c.diags->Report( TKO0752, PointRange( c.ast->Loc( item ) ), _
                                 c.names->Spelling( ip->name ) )
                continue for
            end if

            if ip->a <> NODE_NONE then continue for
            '' A QUALIFIED or object-target redim names something declared elsewhere.
            if (c.ast->nodes[cast( int32, item )].flags and NF_QUALIFIED) <> 0 then continue for
            if (ip->b <> NODE_NONE) andalso (ip->extra = cast( uint16, KW_REDIM )) then continue for
            '' WITHOUT A TYPE the redim must be RE-dimensioning something already declared,
            '' and it must actually write bounds. Measured, and both halves are needed:
            ''
            ''     dim a( ) as integer : redim a( 0 to 2 )   accepted
            ''     dim a( ) as integer : redim a( )          error 147 -- empty parens
            ''     redim array( 1 to 2 )                     error 147 -- nothing declared it
            ''     redim a( ) as integer                     accepted
            dim as boolean declaredElsewhere = _
                (c.info->RefOf( item ) <> SYMBOL_NONE)
            if declaredElsewhere andalso (bounds > 0) then continue for
            c.diags->Report( TKO0751, PointRange( c.ast->Loc( item ) ), _
                             c.names->Spelling( ip->name ) )
        next
    next
end sub

'' A BYREF PARAMETER WITH A DEFAULT NEEDS A COMPLETE TYPE -- fbc error 71. The default
'' has to be materialised somewhere for the reference to point at, and neither 'any' nor a
'' forward declaration says how big that is. Measured, and the DEFAULT is what makes the
'' difference:
''
''     declare sub f( byref x as any = 0 )               error 71
''     declare sub f( byref x as any )                   accepted
''     type td as forward : declare sub f( byref x as td = 0 )   error 71
''     type td as forward : declare sub f( byref x as td )       accepted
private sub CheckByrefParamDefault_ ( byref c as Ctx, byval id as NodeId )
    if (c.ast->nodes[cast( int32, id )].flags and NF_BYREF) = 0 then return
    dim as StmtPayload ptr sp = _
        @c.ast->stmts[cast( int32, c.ast->nodes[cast( int32, id )].data )]
    if sp->b = NODE_NONE then return
    if sp->a = NODE_NONE then return
    dim as TypeId t = c.info->TypeOf_( sp->a )
    dim as boolean incomplete = false
    if t = TYPE_NONE then
        incomplete = true
    else
        dim as TypeId u = c.types->Unqualify( t )
        select case c.types->Kind( u )
        case TK_FORWARD
            incomplete = true
        case TK_BUILTIN
            incomplete = (c.types->BuiltinOf( u ) = TY_ANY)
        end select
    end if
    if incomplete = false then return
    c.diags->Report( TKO0755, PointRange( c.ast->Loc( id ) ), _
                     c.names->Spelling( sp->name ) )
end sub

#include once "symbols/latesweeps4.tiko"


'' A CAST TO A STRING TYPE NEEDS A SIZE -- fbc error 28. 'cast( zstring, "a" )' and
'' 'cast( wstring, wstr( "a" ) )' name a type with no storage to cast into, while
'' 'cast( zstring * 4, z )' and 'cast( zstring ptr, @z )' are both fine. A cast to a plain
'' STRING is fbc's error 20 and a different question, so only the character types are read.
private sub CheckCastStringSize_ ( byref c as Ctx, byval id as NodeId )
    dim as ListPayload ptr lp = _
        @c.ast->lists[cast( int32, c.ast->nodes[cast( int32, id )].data )]
    if lp->target = NODE_NONE then return
    if c.ast->Kind( lp->target ) <> N_IDENT then return
    if c.info->RefOf( lp->target ) <> SYMBOL_NONE then return
    dim as string cn = lcase( c.names->Spelling( _
        c.ast->idents[cast( int32, c.ast->nodes[cast( int32, lp->target )].data )].name ) )
    if (cn <> "cast") andalso (cn <> "cptr") then return
    if lp->count < 1 then return
    dim as NodeId tref = cast( NodeId, c.ast->children[lp->first] )
    if tref = NODE_NONE then return
    if c.ast->Kind( tref ) <> N_TYPEREF then return
    dim as TypeId t = c.types->Unqualify( c.info->TypeOf_( tref ) )
    if t = TYPE_NONE then return
    '' A POINTER ON ONE SIDE AND NOT THE OTHER, first and for every target type -- see
    '' CheckCastPtrPair_. It reports at most one diagnostic and says so.
    if lp->count = 2 then
        if CheckCastPtrPair_( c, id, cn, t, cast( NodeId, c.ast->children[lp->first + 1] ) ) then return
    end if
    '' A SIZED string is an ARRAY of the character type and a POINTER is a pointer; only
    '' the bare builtin has nothing to cast into.
    if c.types->Kind( t ) <> TK_BUILTIN then return
    select case c.types->BuiltinOf( t )
    case TY_ZSTRING, TY_WSTRING
        c.diags->Report( TKO0756, PointRange( c.ast->Loc( id ) ) )
    '' ...BUT A USTRING TARGET OVER A USTRING IS NOT ONE. Measured, fbc TAKES
    '' 'cast( ustring, u )' and 'cptr( ustring, u )', and tiko reported both -- it REFUSED
    '' CODE fbc COMPILES, and lowers correctly once it is let through.
    ''
    '' THE OTHER OPERANDS fbc TAKES THERE ARE LEFT REFUSED, deliberately. Its front end
    '' accepts 'cptr( ustring, i )', 'cast( ustring, d )' and 'cast( ustring, b )' and then
    '' emits C that the C compiler REJECTS -- '(FBUSTRING*)&(FBUSTRING)I$0', "conversion to
    '' non-scalar type requested" -- so there is no behaviour to match. 'cast( ustring, uf )'
    '' over a 'ustring * N' does build under fbc, and tiko cannot lower it: it dropped the
    '' statement silently, which is worse than saying so. Both are gaps, not compatibility.
    case TY_USTRING
        if lp->count = 2 then
            dim as TypeId uot = c.info->TypeOf_( cast( NodeId, c.ast->children[lp->first + 1] ) )
            if uot <> TYPE_NONE then
                dim as TypeId uu = c.types->Unqualify( uot )
                if c.types->Kind( uu ) = TK_REFERENCE then uu = c.types->Unqualify( c.types->Inner( uu ) )
                if c.types->Kind( uu ) = TK_BUILTIN then
                    if c.types->BuiltinOf( uu ) = TY_USTRING then return
                end if
            end if
        end if
        c.diags->Report( TKO0756, PointRange( c.ast->Loc( id ) ) )
    '' ...AND A CAST TO A PLAIN STRING OF A WIDE VALUE IS fbc's ERROR 20. Measured, every
    '' spelling of one: 'cast( string, w )' over a 'wstring * 10', '*pw', 'wstr( 5 )',
    '' 'trim( w )' and '"a" & w' are all "Type mismatch". tiko took each as the identity
    '' and handed the wide value on, where a narrow one belonged.
    '' ...AND EVERYTHING ELSE fbc REFUSES THERE -- a ustring, a zstring, a fixed-length
    '' string, a number, a constant string, a UDT with no narrow cast. See CastStrOperandWhy_.
    '' 'cptr( string, x )' TAKES EXACTLY WHAT 'cast' DOES, and refuses the rest as error 28
    '' rather than 20. Measured over 18 operands, the two spellings agree on every one:
    '' 's', 's & "t"', 'chr( i )', 'hex( 255 )', '"a" & i', 'ucase( "lit" )' and a UDT
    '' casting to STRING are taken by both; a literal, a CONST, a folded chain, a zstring,
    '' a 'string * 8', a ustring, a number and every wide spelling by neither.
    case TY_STRING
        if lp->count <> 2 then return
        dim as NodeId cop = cast( NodeId, c.ast->children[lp->first + 1] )
        if ExprIsWide_( c, cop ) then
            c.diags->Report( TKO0802, PointRange( c.ast->Loc( id ) ), cn )
            return
        end if
        dim as string why = CastStrOperandWhy_( c, cop )
        if len( why ) > 0 then
            c.diags->Report( TKO0803, PointRange( c.ast->Loc( id ) ), cn, why )
        end if
    end select
end sub

'' WHAT AN AGGREGATE INITIALIZER CANNOT FILL -- both fbc's error 24, and the two halves
'' differ in exactly one way, which was measured:
''
''     type U { s as string } : dim shared x as U = ( "123" )   error 24
''     ...the same from a VARIABLE                              error 24
''     ...the same declared LOCAL, inside a sub                 error 24  -- any storage
''     ...the same with NO initializer                          accepted
''     type U { a:1 as integer } : dim shared x as U = ( 1 )    error 24
''     ...as 'var shared x = type<U>( 1 )'                      error 24
''     ...the same declared LOCAL, inside a sub                 ACCEPTED  -- static only
''     type U { i as integer } : dim shared x as U = ( 1 )      accepted
''     dim as (long, string) s = ( 1, "hello" )                 accepted -- a TUPLE
''     ...and any type with a CONSTRUCTOR                        accepted -- a ctor CALL
''
'' So a VAR-LEN STRING field is refused wherever the variable lives, and a BITFIELD only
'' when the storage is static: a local one is filled by generated code rather than by the
'' loader, and fbc will do that for a bitfield but not for a string.
private function UdtHoldsKind_ _
    ( byref c as Ctx, byval t as TypeId, byval wantString as boolean, _
      byval depth as int32 ) as Symbol ptr

    if depth > 8 then return 0
    dim as TypeId u = ValueType_( c, t )
    if u = TYPE_NONE then return 0
    if c.types->Kind( u ) <> TK_UDT then return 0
    '' A TUPLE IS NOT A UDT FOR THIS RULE, even though it is synthesised as one:
    '' 'dim as (long, string) s = ( 1, "hello" )' is accepted by fbc and is what this
    '' suite's own tuple-compare and tuple-destructure tests write, while the identical
    '' shape over a NAMED type holding a string is error 24.
    if TupleLike_( c, u ) then return 0
    dim as Symbol ptr ts = UdtSymbolOf_( c, u )
    if ts = 0 then return 0
    if ts->inner = SCOPE_NONE then return 0
    for i as int32 = 0 to c.syms->symbols.Count - 1
        dim as Symbol ptr f = @c.syms->symbols[i]
        if f->parent <> ts->inner then continue for
        if f->kind <> cast( uint8, SYM_FIELD ) then continue for
        if wantString then
            if f->type_ <> TYPE_NONE then
                dim as TypeId ft = c.types->Unqualify( f->type_ )
                if c.types->Kind( ft ) = TK_BUILTIN then
                    if c.types->BuiltinOf( ft ) = TY_STRING then return f
                end if
            end if
        else
            if (f->flags and SYMF_BITFIELD) <> 0 then return f
        end if
        if f->type_ <> TYPE_NONE then
            dim as TypeId ft2 = c.types->Unqualify( f->type_ )
            if c.types->Kind( ft2 ) = TK_UDT then
                dim as Symbol ptr deeper = UdtHoldsKind_( c, ft2, wantString, depth + 1 )
                if deeper <> 0 then return deeper
            end if
        end if
    next
    return 0
end function

'' '= ANY' OVER A VAR-LENGTH STRING IS fbc's ERROR 24, "Invalid data types". Measured,
'' and the boundary is narrower than "anything with a string in it":
''
''     dim as string s = any               error 24
''     dim as string s(0 to 2) = any       error 24
''     dim as string s(any) = any          error 24
''     as string s = any        (a field)  error 24
''     s(0 to 2) as string = any (a field) error 24
''
''     dim as string * 8 s = any           ACCEPTED -- a fixed-length string is bytes
''     dim as ustring s = any              ACCEPTED, in every one of those shapes
''     i as inner = any, inner holding a
''     var-len string                      ACCEPTED
''
'' So it is the DECLARED type being TY_STRING, or an array whose element is, and not
'' whether a string can be reached through the type. That last line is the one worth
'' keeping: fbc leaves inner's descriptor uninitialised and then DESTROYS it, which is
'' its own hazard and not something this rule may be widened to cover.
private function AnyInitOf_( byref c as Ctx, byval s as Symbol ptr ) as NodeId
    if s = 0 then return NODE_NONE
    if s->payload = 0 then return NODE_NONE
    dim as NodeId item = cast( NodeId, s->payload )
    dim as NodeId init = NODE_NONE
    dim as StmtPayload ptr sp = _
        @c.ast->stmts[cast( int32, c.ast->nodes[cast( int32, item )].data )]
    select case c.ast->Kind( item )
    case N_VAR_ITEM
        init = sp->b
    case N_FIELD
        '' A BITFIELD's payload is its WIDTH IN BITS, not a node. Reading it as one
        '' indexes the AST with a 3 -- the mistake lowerfieldinit.tiko records.
        if (s->flags and SYMF_BITFIELD) <> 0 then return NODE_NONE
        init = sp->c
    case else
        return NODE_NONE
    end select
    if init = NODE_NONE then return NODE_NONE
    if c.ast->Kind( init ) <> N_IDENT then return NODE_NONE
    dim as IdentPayload ptr ip = _
        @c.ast->idents[cast( int32, c.ast->nodes[cast( int32, init )].data )]
    if Tko.Text.LowerAscii( c.names->Spelling( ip->name ) ) <> "any" then return NODE_NONE
    return init
end function

private function IsVarLenStringDecl_( byref c as Ctx, byval t as TypeId ) as boolean
    if t = TYPE_NONE then return false
    dim as TypeId u = t
    if c.types->Kind( u ) = TK_ARRAY then u = c.types->Inner( u )
    if u = TYPE_NONE then return false
    if c.types->Kind( u ) <> TK_BUILTIN then return false
    return (c.types->BuiltinOf( u ) = TY_STRING)
end function

private sub CheckAnyInitTypes_( byref c as Ctx )
    for i as int32 = 0 to c.syms->symbols.Count - 1
        dim as Symbol ptr s = @c.syms->symbols[i]
        dim as boolean isVarOrField = (s->kind = cast( uint8, SYM_VARIABLE )) orelse _
                                      (s->kind = cast( uint8, SYM_FIELD ))
        if isVarOrField = false then continue for
        if IsVarLenStringDecl_( c, s->type_ ) = false then continue for
        dim as NodeId init = AnyInitOf_( c, s )
        if init = NODE_NONE then continue for
        c.diags->Report( TKO0771, PointRange( c.ast->Loc( init ) ), _
                         c.names->Spelling( s->name ) )
    next
end sub

#include once "symbols/aggctorfield.tiko"   '' UdtHasCtorField_ -- split out at the line cap

private sub CheckAggregateInitFields_( byref c as Ctx )
    for i as int32 = 0 to c.syms->symbols.Count - 1
        dim as Symbol ptr s = @c.syms->symbols[i]
        if s->kind <> cast( uint8, SYM_VARIABLE ) then continue for
        if s->type_ = TYPE_NONE then continue for
        if s->payload = 0 then continue for
        dim as NodeId item = cast( NodeId, s->payload )
        if c.ast->Kind( item ) <> N_VAR_ITEM then continue for
        dim as StmtPayload ptr ip = _
            @c.ast->stmts[cast( int32, c.ast->nodes[cast( int32, item )].data )]
        if ip->b = NODE_NONE then continue for
        select case c.ast->Kind( ip->b )
        case N_TUPLE, N_PAREN, N_INITIALIZER
        case else
            continue for
        end select
        '' A CONSTRUCTOR MAKES THE PARENTHESES A CALL, not an aggregate, and then no field
        '' is filled by a list at all: 'dim d as BBDerived = ( 5678 )' over a type with a
        '' constructor is accepted by fbc even though the type inherits a string field.
        '' structs/derived-ptr-assign.bas writes exactly that, and the differential scan
        '' caught this rule refusing it -- the same distinction TKO0746 needed.
        if DeclaresAnywhere_( c, ValueType_( c, s->type_ ), "__ctor" ) then continue for
        dim as Symbol ptr sf = UdtHoldsKind_( c, s->type_, true, 0 )
        if sf <> 0 then
            c.diags->Report( TKO0757, PointRange( c.ast->Loc( item ) ), _
                             c.names->Spelling( s->name ) )
            continue for
        end if
        if (c.ast->Kind( ip->b ) <> N_INITIALIZER) andalso (UdtHasCtorField_( c, s->type_, 0 ) <> 0) then
            c.diags->Report( TKO0965, PointRange( c.ast->Loc( item ) ), c.names->Spelling( s->name ) )
            continue for
        end if
        '' THE BITFIELD HALF IS STATIC-STORAGE ONLY -- 'shared', 'static', 'extern', 'common'.
        '' A plain module-level 'dim' is NOT: measured on fbc-modern, 'dim as T z = ( 1, 6 )'
        '' and '( 1, k )' over bitfields compile and run at module level, and only 'dim
        '' shared' / 'static' are error 24. This counted module level as static too and
        '' refused both (structs/bitfield_init.bas).
        if (s->flags and (SYMF_SHARED or SYMF_STATIC or SYMF_EXTERN or SYMF_COMMON)) = 0 then continue for
        dim as Symbol ptr bf = UdtHoldsKind_( c, s->type_, false, 0 )
        if bf = 0 then continue for
        c.diags->Report( TKO0758, PointRange( c.ast->Loc( item ) ), _
                         c.names->Spelling( s->name ) )
    next
end sub

'' A STATIC-STORAGE INITIALISER IS A CONSTANT -- fbc error 11, "Expected constant" -- over
'' every type fbc fills from the image rather than by running a constructor. Measured:
''
''     static as P v = mkp( 3 )               error 11    P plain data
''     static as long v = f( )                error 11    ...a scalar, and 'f' paren-less
''     dim shared as P v = mkp( 3 )           error 11    ...'static' at module level,
''     namespace ns : dim as P v = mkp( 3 )   error 11       'var shared', a namespace
''     static as P v = gm.mk( )               error 11    a method
''     static as P v = gp                     error 11    a variable of the type
''     static as P v = type<P>( gx, 2 )       error 11    a run-time value INSIDE a
''     static as P v = ( 1, f( ) )            error 11       literal, a tuple, a { } list
''     static as long v = gx + 1              error 11       or an operator
''     static as long v = gp.a                error 11    a field of a variable
''     static as long v = arr( 1 )            error 11    an element
''     static as P v = *cast( P ptr, 0 )      error 11    a dereference
''     static as TD v = makd( )               error 11    a DESTRUCTOR alone changes nothing
''
''     static as P v = type<P>( KK, 2 )       accepted    constants
''     static as long ptr v = @gx             accepted    an address
''     static as long v = len( f( ) )         accepted    and sizeof, asc, abs, cint, sgn,
''     static as double v = atn( 1 ) * 4      accepted       rgb, sqr, sin, chr, iif( 1, 2, 3 )
''     static as HC v = HC( gx )              accepted    A CONSTRUCTOR RUNS CODE: a written
''     static as SS v = mkss( )               accepted       one, or the implicit one a string
''                                                           field, a field initialiser, a
''                                                           member with one or OBJECT brings
''
'' tiko accepted every refused line and lowered it to storage nothing wrote: 'static as P
'' v = mkp( 3 )' printed zeros. IT REPORTS ONLY WHAT IT CAN POSITIVELY ESTABLISH, as
'' CheckConstBounds_ does: a BUILTIN is judged by its ARGUMENTS -- 'cast( long, gx )',
'' 'str( gx )', 'iif( gx, 1, 2 )' are 11 because gx is -- and never by asking whether it
'' folds, which would measure this compiler's folder rather than fbc. The exceptions are
'' NAMED, each measured: the builtins that evaluate nothing, and hex, oct, bin, val and
'' peek with their variants, which fbc never folds even over constants. Any other builtin
'' fbc refuses over constants -- 'left( "abc", 1 )', 'space( 3 )', 'cvi( "abcd" )' -- is
'' not reported. See RunTimeLeaf_.

'' Filled from the image: no constructor runs over it, written or implicit. Anything this
'' does not recognise answers no, which only ever means not judged.
private function LoaderFilled_ _
    ( byref c as Ctx, byval t as TypeId, byval depth as int32 ) as boolean

    if (t = TYPE_NONE) orelse (depth > 8) then return false
    dim as TypeId u = c.types->Unqualify( t )
    if c.types->IsDynArray( u ) then return false
    select case c.types->Kind( u )
    case TK_ARRAY
        return LoaderFilled_( c, c.types->Inner( u ), depth + 1 )
    case TK_POINTER
        return true
    case TK_BUILTIN
        '' A VAR-LEN STRING cannot be initialised at all -- TKO0628, fbc's 87.
        select case c.types->BuiltinOf( u )
        case TY_STRING, TY_USTRING
            return false
        end select
        return true
    case TK_UDT
    case else
        return false
    end select
    if DeclaresAnywhere_( c, u, "__ctor" ) then return false
    if ExtendsObject_( c, u ) then return false
    dim as Symbol ptr ts = UdtSymbolOf_( c, u )
    if ts = 0 then return false
    if ts->inner = SCOPE_NONE then return false
    dim as SymScope ptr sc = c.syms->ScopeAt( ts->inner )
    if sc = 0 then return false
    dim as SymbolId cur = sc->firstSym
    dim as int32 guard = 0
    while (cur <> SYMBOL_NONE) andalso (guard < 100000)
        guard += 1
        dim as Symbol ptr f = c.syms->SymbolAt( cur )
        if f = 0 then exit while
        if f->kind = cast( uint8, SYM_FIELD ) then
            '' A FIELD INITIALISER is the implicit constructor's work. A BITFIELD's
            '' payload is its width, not a node -- see AnyInitOf_.
            if ((f->flags and SYMF_BITFIELD) = 0) andalso (f->payload <> 0) then
                dim as NodeId fn = cast( NodeId, f->payload )
                if c.ast->Kind( fn ) = N_FIELD then
                    if c.ast->stmts[cast( int32, c.ast->nodes[cast( int32, fn )].data )].c <> NODE_NONE then
                        return false
                    end if
                end if
            end if
            if LoaderFilled_( c, f->type_, depth + 1 ) = false then return false
        end if
        cur = f->nextInScope
    wend
    return true
end function

'' Static storage, as fbc means it here: SHARED or STATIC, or declared in a NAMESPACE. A
'' TYPE's static member is another rule and not measured, so it answers no.
private function StaticStorage_ ( byref c as Ctx, byval s as Symbol ptr ) as boolean
    if (s->flags and (SYMF_EXTERN or SYMF_COMMON or SYMF_BYREF)) <> 0 then return false
    dim as boolean flagged = ((s->flags and (SYMF_SHARED or SYMF_STATIC)) <> 0)
    dim as ScopeId cur = s->parent
    dim as int32 guard = 0
    while (cur <> SCOPE_NONE) andalso (guard < 1000)
        guard += 1
        dim as SymScope ptr sc = c.syms->ScopeAt( cur )
        if sc = 0 then exit while
        if sc->kind = cast( uint8, SCOPEK_TYPE ) then return false
        if sc->kind = cast( uint8, SCOPEK_PROC ) then return flagged
        if sc->kind = cast( uint8, SCOPEK_NAMESPACE ) then return true
        cur = sc->parent
    wend
    return flagged
end function

'' The first sub-expression POSITIVELY computed at run time, or NODE_NONE. Walked through
'' operators, parentheses, tuples and { } lists only -- never into an address, a builtin
'' call's arguments ('len( f( ) )' folds) or anything else.
private function RunTimeLeaf_ _
    ( byref c as Ctx, byval n as NodeId, byval ptrTarget as boolean, _
      byval depth as int32 ) as NodeId

    if (n = NODE_NONE) orelse (depth > 64) then return NODE_NONE
    select case c.ast->Kind( n )
    case N_IDENT
        dim as Symbol ptr s = c.syms->SymbolAt( c.info->RefOf( n ) )
        if s = 0 then return NODE_NONE
        select case s->kind
        case cast( uint8, SYM_VARIABLE ), cast( uint8, SYM_PARAMETER )
            return n
        case cast( uint8, SYM_PROC )
            '' A paren-less CALL -- unless a procedure pointer is being initialised,
            '' where a bare name is not measured.
            if ptrTarget = false then return n
        end select
    case N_MEMBER
        dim as Symbol ptr ms = c.syms->SymbolAt( c.info->RefOf( n ) )
        if ms <> 0 then
            select case ms->kind
            case cast( uint8, SYM_VARIABLE ), cast( uint8, SYM_PROC )
                return n
            case cast( uint8, SYM_CONSTANT ), cast( uint8, SYM_ENUMCONST )
                return NODE_NONE
            end select
        end if
        '' A FIELD reads its object: 'gp.a' is run time exactly when 'gp' is.
        dim as BinaryPayload ptr mp = _
            @c.ast->binaries[cast( int32, c.ast->nodes[cast( int32, n )].data )]
        return RunTimeLeaf_( c, mp->lhs, ptrTarget, depth + 1 )
    case N_CALL
        '' A PROCEDURE'S call, or an array ELEMENT. A type's constructor call is neither.
        dim as ListPayload ptr lp = _
            @c.ast->lists[cast( int32, c.ast->nodes[cast( int32, n )].data )]
        if lp->target = NODE_NONE then return NODE_NONE
        select case c.ast->Kind( lp->target )
        case N_IDENT, N_MEMBER
        case else
            return NODE_NONE
        end select
        dim as Symbol ptr cs = c.syms->SymbolAt( c.info->RefOf( n ) )
        if cs = 0 then cs = c.syms->SymbolAt( c.info->RefOf( lp->target ) )
        if cs <> 0 then
            if (cs->kind = cast( uint8, SYM_PROC )) orelse _
               (cs->kind = cast( uint8, SYM_VARIABLE )) then return n
            return NODE_NONE
        end if

        '' A BUILTIN has no symbol. 'iif', 'cast', 'cint' and 'str' all parse as a call
        '' on the builtin's name, with the type of a 'cast' as an N_TYPEREF argument.
        if c.ast->Kind( lp->target ) <> N_IDENT then return NODE_NONE
        dim as string bn = Tko.Text.LowerAscii( c.names->Spelling( _
            c.ast->idents[cast( int32, c.ast->nodes[cast( int32, lp->target )].data )].name ) )
        select case bn
        case "sizeof", "lbound", "ubound", "offsetof", "typeof", _
             "procptr", "varptr", "strptr", "sadd"
            '' ANSWERED FROM A TYPE OR A DECLARATION, evaluating nothing: fbc accepts
            '' 'sizeof( gx )', 'lbound( garr )' and 'offsetof( P, b )'.
            return NODE_NONE
        case "len"
            '' ...and LEN over anything but a STRING is its size: 'len( gx )' is accepted,
            '' 'len( gs )' and 'len( str( gx ) )' are fbc's 11.
            if lp->count < 1 then return NODE_NONE
            dim as NodeId la = cast( NodeId, c.ast->children[lp->first] )
            dim as TypeId lt = c.info->TypeOf_( la )
            if lt = TYPE_NONE then return NODE_NONE
            dim as TypeId ludt
            if SwapKindOf_( c, lt, ludt ) <> 2 then return NODE_NONE
            return RunTimeLeaf_( c, la, ptrTarget, depth + 1 )
        case "hex", "oct", "bin", "whex", "woct", "wbin", _
             "val", "valint", "vallng", "valuint", "valulng", "peek"
            '' NEVER FOLDED, EVEN OVER CONSTANTS. Measured, fbc gives 11 for 'hex( 255 )',
            '' 'hex( KK )', 'oct( 8 )', 'bin( 5, 8 )', 'whex( 255 )', 'val( "12" )',
            '' 'valint( "0" )', 'peek( long, @gx )' and 'peek( integer, 0 )' -- each of which
            '' a plain local accepts -- while 'str( 1 )', 'chr( 65 )' and 'cint( 2.5 )' fold.
            '' So the call is run time whatever its arguments are.
            return n
        case "iif"
            if lp->count <> 3 then return NODE_NONE
            dim as NodeId ic = cast( NodeId, c.ast->children[lp->first] )
            dim as NodeId ia = cast( NodeId, c.ast->children[lp->first + 1] )
            dim as NodeId ib = cast( NodeId, c.ast->children[lp->first + 2] )
            dim as NodeId cl = RunTimeLeaf_( c, ic, ptrTarget, depth + 1 )
            if cl <> NODE_NONE then return cl
            '' A CONSTANT CONDITION IS FOLDED AND ONLY THE ARM IT PICKS IS JUDGED --
            '' measured, 'iif( 0, gx, 2 )' and 'iif( 1, 2, gx )' are accepted while
            '' 'iif( 1, gx, 2 )' and 'iif( 0, 2, gx )' are 11. A WRITTEN integer is read
            '' here; any other constant condition is judged only when BOTH arms are run
            '' time, which is true whichever one it picks.
            if c.ast->Kind( ic ) = N_INT_LIT then
                if c.ast->literals[cast( int32, c.ast->nodes[cast( int32, ic )].data )].intValue <> 0 then
                    return RunTimeLeaf_( c, ia, ptrTarget, depth + 1 )
                end if
                return RunTimeLeaf_( c, ib, ptrTarget, depth + 1 )
            end if
            dim as NodeId al = RunTimeLeaf_( c, ia, ptrTarget, depth + 1 )
            if al = NODE_NONE then return NODE_NONE
            if RunTimeLeaf_( c, ib, ptrTarget, depth + 1 ) = NODE_NONE then return NODE_NONE
            return al
        end select
        '' EVERY OTHER BUILTIN EVALUATES ITS ARGUMENTS, so it is run time when one of them
        '' is: 'cast( long, gx )', 'cint( gx )', 'str( gx )', 'chr( gx )', 'left( "abc", gx )',
        '' 'asc( str( gx ) )', 'sin( gd )' -- all 11. 'cptr( long ptr, @gx )' and 'str( 1 )'
        '' are accepted and have no run-time argument.
        for i as int32 = 0 to lp->count - 1
            dim as NodeId ba = RunTimeLeaf_( c, _
                cast( NodeId, c.ast->children[lp->first + i] ), ptrTarget, depth + 1 )
            if ba <> NODE_NONE then return ba
        next
    case N_DEREF
        return n
    case N_BINARY
        dim as BinaryPayload ptr bp = _
            @c.ast->binaries[cast( int32, c.ast->nodes[cast( int32, n )].data )]
        dim as NodeId l = RunTimeLeaf_( c, bp->lhs, ptrTarget, depth + 1 )
        if l <> NODE_NONE then return l
        return RunTimeLeaf_( c, bp->rhs, ptrTarget, depth + 1 )
    case N_UNARY
        dim as UnaryPayload ptr up = _
            @c.ast->unaries[cast( int32, c.ast->nodes[cast( int32, n )].data )]
        return RunTimeLeaf_( c, up->operand, ptrTarget, depth + 1 )
    case N_PAREN, N_TUPLE, N_INITIALIZER
        dim as ListPayload ptr tp = _
            @c.ast->lists[cast( int32, c.ast->nodes[cast( int32, n )].data )]
        for i as int32 = 0 to tp->count - 1
            dim as NodeId e = RunTimeLeaf_( c, _
                cast( NodeId, c.ast->children[tp->first + i] ), ptrTarget, depth + 1 )
            if e <> NODE_NONE then return e
        next
    end select
    return NODE_NONE
end function

private sub CheckStaticInitConst_( byref c as Ctx )
    for i as int32 = 0 to c.syms->symbols.Count - 1
        dim as Symbol ptr s = @c.syms->symbols[i]
        if s->kind <> cast( uint8, SYM_VARIABLE ) then continue for
        if s->type_ = TYPE_NONE then continue for
        if s->payload = 0 then continue for
        dim as NodeId item = cast( NodeId, s->payload )
        if c.ast->Kind( item ) <> N_VAR_ITEM then continue for
        if (c.ast->nodes[cast( int32, item )].flags and NF_BYREF) <> 0 then continue for
        dim as StmtPayload ptr ip = _
            @c.ast->stmts[cast( int32, c.ast->nodes[cast( int32, item )].data )]
        if ip->b = NODE_NONE then continue for
        if StaticStorage_( c, s ) = false then continue for
        if LoaderFilled_( c, s->type_, 0 ) = false then continue for
        dim as TypeId vt = c.types->Unqualify( s->type_ )
        if c.types->Kind( vt ) = TK_ARRAY then vt = c.types->Unqualify( c.types->Inner( vt ) )

        '' A BARE VARIABLE is TKO0725, whose message says so. CheckStaticInitFromVar_
        '' already reports the SHARED or STATIC scalar; the rest -- a variable of a UDT,
        '' or any in a namespace -- is reported here, once.
        if c.ast->Kind( ip->b ) = N_IDENT then
            dim as Symbol ptr src = c.syms->SymbolAt( c.info->RefOf( ip->b ) )
            if src <> 0 then
                if src->kind = cast( uint8, SYM_VARIABLE ) then
                    dim as boolean flagged = ((s->flags and (SYMF_SHARED or SYMF_STATIC)) <> 0)
                    if flagged andalso (c.types->Kind( vt ) = TK_BUILTIN) then continue for
                    c.diags->Report( TKO0725, PointRange( c.ast->Loc( item ) ), _
                                     c.names->Spelling( s->name ) )
                    continue for
                end if
            end if
        end if

        '' '@x' OF A MODULE-LEVEL LOCAL: a 'dim' or 'static' at module level that is not SHARED
        '' lives in the main procedure's frame, so its address is no constant -- fbc's 272,
        '' "Local symbols can't be referenced", for 'static' and 11 for 'dim', from a namespace
        '' variable's initializer (fbc-modern 1.20, 2026-09-29; dim/shared-init-using-static-5).
        '' A SHARED target's is TKO0668's, and a module-level 'static' target is fine
        '' (tests/diagnostics/static-source-init): only a NAMESPACE's variable is judged.
        dim as SymScope ptr tsc = c.syms->ScopeAt( s->parent )
        dim as boolean nsTarget = (tsc <> 0) andalso (tsc->kind = cast( uint8, SCOPEK_NAMESPACE ))
        if nsTarget andalso ((s->flags and SYMF_SHARED) = 0) andalso (c.ast->Kind( ip->b ) = N_ADDROF) then
            dim as NodeId ao = c.ast->unaries[cast( int32, c.ast->nodes[cast( int32, ip->b )].data )].operand
            if (ao <> NODE_NONE) andalso (c.ast->Kind( ao ) = N_IDENT) then
                dim as Symbol ptr asrc = c.syms->SymbolAt( c.info->RefOf( ao ) )
                if (asrc <> 0) andalso (asrc->kind = cast( uint8, SYM_VARIABLE )) then
                    if (asrc->flags and (SYMF_SHARED or SYMF_EXTERN or SYMF_COMMON)) = 0 then
                        dim as SymScope ptr ascp = c.syms->ScopeAt( asrc->parent )
                        if (ascp <> 0) andalso ((ascp->kind = cast( uint8, SCOPEK_MODULE )) orelse (ascp->kind = cast( uint8, SCOPEK_GLOBAL ))) then
                            c.diags->Report( TKO0778, PointRange( c.ast->Loc( ip->b ) ), c.names->Spelling( s->name ) )
                            continue for
                        end if
                    end if
                end if
            end if
        end if
        dim as boolean ptrTarget = (c.types->Kind( vt ) = TK_POINTER)
        dim as NodeId leaf = RunTimeLeaf_( c, ip->b, ptrTarget, 0 )
        if leaf = NODE_NONE then continue for
        c.diags->Report( TKO0778, PointRange( c.ast->Loc( leaf ) ), _
                         c.names->Spelling( s->name ) )
    next
end sub

#include once "symbols/initorder.tiko"
