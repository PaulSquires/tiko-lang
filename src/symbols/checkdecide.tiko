'' checkdecide.tiko -- THE OVERLOAD DECISIONS CHECK RECORDS FOR LOWERING (audit Phase 4).
''
'' Included from check.tiko below overload.tiko and above intrinsics.tiko, which asks it. Each function here makes a choice the MIR
'' layer used to make again by itself, with its own copy of the rule; the answer goes on
'' the node -- RefOf, or SemanticInfo.decision for a choice the node implies without
'' naming it -- and lowering reads it (TKO_PICK_AUDIT=1 reports where the two differ).

'' 'x[ i ]' OVER A UDT: WHICH 'operator []'. By conversion cost over the written index,
'' uniquely; on a tie, or with nothing viable or no typed index, the chain HEAD. That is the
'' rule LowerUdtIndexOp_ applied, while Check typed the node by the HEAD: with 'operator []'
'' overloaded on integer and on string (overload/op-ptrindex.bas), the node's type and the
'' procedure lowering called could be two different overloads.
private function IndexOperatorFor_ _
    ( byref c as Ctx, byval ut as Tko.TypeId, byval ie0 as Tko.NodeId ) as Tko.SymbolId

    dim as Tko.SymbolId ixs = UdtOperatorNamed_( c, ut, "[]" )
    if (ixs = Tko.SYMBOL_NONE) orelse (ie0 = Tko.NODE_NONE) then return ixs
    dim as Tko.TypeId at0 = c.types->Unqualify( TypeOf_( c, ie0 ) )
    if at0 = Tko.TYPE_NONE then return ixs
    dim as Tko.SymbolId best = Tko.SYMBOL_NONE
    dim as int32 bestCost = CONV_NONE, ties = 0
    dim as Tko.SymbolId cur = ixs
    dim as int32 guard = 0
    while (cur <> Tko.SYMBOL_NONE) andalso (guard < 4096)
        guard += 1
        dim as Tko.Symbol ptr cs = c.syms->SymbolAt( cur )
        if cs = nullptr then exit while
        dim as Tko.TypeId cpt = ProcParamTypeAt_( c, cur, 0 )
        if cpt <> Tko.TYPE_NONE then
            dim as Tko.TypeId cpu = c.types->Unqualify( cpt )
            if c.types->Kind( cpu ) = Tko.TK_REFERENCE then cpu = c.types->Unqualify( c.types->Inner( cpu ) )
            dim as int32 cst = ConversionCost( at0, cpu, *c.types )
            if cst < CONV_NONE then
                if cst < bestCost then
                    bestCost = cst : best = cur : ties = 0
                elseif cst = bestCost then
                    ties += 1
                end if
            end if
        end if
        cur = cs->nextOverload
    wend
    if (best <> Tko.SYMBOL_NONE) andalso (ties = 0) then return best
    return ixs
end function

'' 'len( u )' OVER A UDT: THE 'operator len' DECLARED FOR ITS TYPE, or nothing (the intrinsic).
'' Looked up from the TYPE'S DECLARING SCOPE, which is where a type's operators live -- an
'' imported module's 'sys2.Meter' finds sys2's -- and only an exact parameter match counts.
'' Check walked from the name bound at the call and missed the module's; lowering found it,
'' and with no exact match called the chain HEAD -- 'len( b1 )' over a type without one ran
'' another type's operator: fbc prints 12 (the size), tiko printed 77.
function LenOperatorFor_( byref c as Ctx, byval lat as Tko.TypeId ) as Tko.SymbolId
    lat = c.types->Unqualify( lat )
    if c.types->Kind( lat ) = Tko.TK_REFERENCE then lat = c.types->Unqualify( c.types->Inner( lat ) )
    if c.types->Kind( lat ) <> Tko.TK_UDT then return Tko.SYMBOL_NONE
    dim as Tko.ScopeId lsc = cast( Tko.ScopeId, c.types->DeclScopeOf( lat ) )
    if lsc = Tko.SCOPE_NONE then return Tko.SYMBOL_NONE
    dim as Tko.SymbolId lop = c.syms->Lookup( lsc, c.names->Fold( c.names->GetString( "len" ) ) )
    dim as int32 guard = 0
    while (lop <> Tko.SYMBOL_NONE) andalso (guard < 4096)
        guard += 1
        dim as Tko.Symbol ptr lsy = c.syms->SymbolAt( lop )
        if lsy = nullptr then exit while
        if lsy->kind <> cast( uint8, Tko.SYM_PROC ) then exit while
        dim as Tko.TypeId lpu = c.types->Unqualify( ProcParamTypeAt_( c, lop, 0 ) )
        if c.types->Kind( lpu ) = Tko.TK_REFERENCE then lpu = c.types->Unqualify( c.types->Inner( lpu ) )
        if (lpu = lat) andalso (lsy->type_ <> Tko.TYPE_NONE) then return lop
        lop = lsy->nextOverload
    wend
    return Tko.SYMBOL_NONE
end function

'' WHERE A CALL'S OVERLOAD WALK STARTS: a PROPERTY's chain HEAD. Typing 't.P' binds the member
'' to its no-index getter (PropertyReadAccessor_), which need not be first -- and a chain is
'' singly linked, so 't.P( 7 )' resolved from there could not see an indexed getter declared
'' before it: TKO0632 where fbc calls it. Anything else starts where Resolve bound it.
function CallChainStart_( byref c as Ctx, byval callee as Tko.SymbolId ) as Tko.SymbolId
    dim as Tko.Symbol ptr s = c.syms->SymbolAt( callee )
    if s = nullptr then return callee
    if s->kind <> cast( uint8, Tko.SYM_PROC ) then return callee
    dim as Tko.NodeId pn = cast( Tko.NodeId, s->payload )
    if (pn = Tko.NODE_NONE) orelse (c.ast->Kind( pn ) <> Tko.N_PROC) then return callee
    if StmtOf( c, pn )->op <> cast( uint16, Tko.KW_PROPERTY ) then return callee
    dim as Tko.SymbolId h = c.syms->LookupLocal( s->parent, s->name )
    if h = Tko.SYMBOL_NONE then return callee
    return h
end function

declare function ProcTypeOfSymbol_( byref c as Ctx, byval sid as Tko.SymbolId ) as Tko.TypeId   '' intrinsics.tiko

'' ONE PARAMETER'S BYREF FLAG off a procedure symbol, counting N_PARAMs (lowering's ParamIsByref).
private function ProcParamByref_( byref c as Ctx, byval proc_ as Tko.SymbolId, byval idx as int32 ) as boolean
    dim as Tko.Symbol ptr s = c.syms->SymbolAt( proc_ )
    if s = nullptr then return false
    dim as Tko.NodeId pn = cast( Tko.NodeId, s->payload )
    if (pn = Tko.NODE_NONE) orelse (c.ast->Kind( pn ) <> Tko.N_PROC) then return false
    dim as Tko.StmtPayload ptr pp = StmtOf( c, pn )
    dim as int32 seen = 0
    for i as int32 = 0 to pp->count - 1
        dim as Tko.NodeId prm = cast( Tko.NodeId, c.ast->children[pp->first + i] )
        if c.ast->Kind( prm ) <> Tko.N_PARAM then continue for
        if seen = idx then return ((c.ast->nodes[cast( int32, prm )].flags and Tko.NF_BYREF) <> 0)
        seen += 1
    next
    return false
end function

'' A RESULT TYPE: a SUB spells its absence as TYPE_NONE on a declaration and VOID on a type.
private function SameResult_( byref c as Ctx, byval a as Tko.TypeId, byval b as Tko.TypeId ) as boolean
    dim as boolean av = (a = Tko.TYPE_NONE), bv = (b = Tko.TYPE_NONE)
    if av = false then
        if c.types->Kind( a ) = Tko.TK_BUILTIN then av = (c.types->BuiltinOf( a ) = Tko.TY_VOID)
    end if
    if bv = false then
        if c.types->Kind( b ) = Tko.TK_BUILTIN then bv = (c.types->BuiltinOf( b ) = Tko.TY_VOID)
    end if
    if av andalso bv then return true
    if av orelse bv then return false
    return (c.types->Unqualify( a ) = c.types->Unqualify( b ))
end function

'' '@f' OR 'procptr( f )' WITH A TARGET TYPE, over an overload set: the overload whose
'' signature the target names -- parameter count, result, and each parameter's type and
'' byref-ness exactly. Measured, fbc takes it for a store, an initialiser and an argument
'' ('_Z1Fd' for 'dim p as sub( byval as double ) = @f'). Lowering chose it alone
'' (lowerprocptr.tiko ProcPtrByType_) while Check typed '@f' from the overload Resolve bound;
'' now the choice is recorded on 'f' and '@f' is typed by it (overload re-pick refactor).
'' Does this procedure take a 'this' -- a non-static member of a TYPE?
private function ProcHasReceiver_( byref c as Ctx, byval sid as Tko.SymbolId ) as boolean
    dim as Tko.Symbol ptr s = c.syms->SymbolAt( sid )
    if s = nullptr then return false
    dim as Tko.NodeId pn = cast( Tko.NodeId, s->payload )
    if (pn = Tko.NODE_NONE) orelse (c.ast->Kind( pn ) <> Tko.N_PROC) then return false
    if (StmtOf( c, pn )->extra and Tko.PF_STATIC) <> 0 then return false
    dim as Tko.SymScope ptr osc = c.syms->ScopeAt( s->parent )
    return (osc <> nullptr) andalso (osc->kind = cast( uint8, Tko.SCOPEK_TYPE ))
end function

private sub DecideProcAddr_( byref c as Ctx, byval v as Tko.NodeId, byval wantT as Tko.TypeId )
    if (v = Tko.NODE_NONE) orelse (wantT = Tko.TYPE_NONE) then return
    dim as Tko.NodeId fnE = Tko.NODE_NONE
    select case c.ast->Kind( v )
    case Tko.N_ADDROF
        fnE = c.ast->unaries[cast( int32, c.ast->nodes[cast( int32, v )].data )].operand
    case Tko.N_CALL
        dim as Tko.ListPayload ptr lp = @c.ast->lists[cast( int32, c.ast->nodes[cast( int32, v )].data )]
        if (lp->count <> 1) orelse (lp->target = Tko.NODE_NONE) then return
        fnE = cast( Tko.NodeId, c.ast->children[lp->first] )
    case else
        return
    end select
    if fnE = Tko.NODE_NONE then return
    dim as Tko.SymbolId first_ = c.info->RefOf( fnE )
    dim as Tko.Symbol ptr s = c.syms->SymbolAt( first_ )
    if s = nullptr then return
    if (s->kind <> cast( uint8, Tko.SYM_PROC )) orelse (s->nextOverload = Tko.SYMBOL_NONE) then return
    dim as Tko.TypeId st = c.types->Unqualify( wantT )
    if c.types->Kind( st ) = Tko.TK_POINTER then st = c.types->Unqualify( c.types->Inner( st ) )
    if c.types->Kind( st ) <> Tko.TK_PROC then return
    dim as int32 want = c.types->ProcParamCount( st )
    dim as Tko.TypeId wantRet = c.types->Inner( st )
    dim as Tko.SymbolId cur = first_
    dim as int32 guard = 0
    while (cur <> Tko.SYMBOL_NONE) andalso (guard < 4096)
        guard += 1
        dim as Tko.Symbol ptr cs = c.syms->SymbolAt( cur )
        if cs = nullptr then exit while
        if cs->kind = cast( uint8, Tko.SYM_PROC ) then
            '' AN INSTANCE MEMBER'S TYPE STARTS WITH ITS RECEIVER (ProcTypeOfSymbol_), so the wanted
            '' signature is one longer than the declared parameters and they compare one place on:
            '' 'var fp = procptr( T.proc )' wanted 'sub( byref as T )' and matched 'proc( byref as const T )'.
            dim as int32 rcv = iif( ProcHasReceiver_( c, cur ), 1, 0 )
            dim as boolean ok = (ProcParamCount_( c, cur ) + rcv = want)
            if ok then ok = SameResult_( c, cs->type_, wantRet )
            for i as int32 = 0 to want - 1 - rcv
                if ok = false then exit for
                dim as Tko.TypeId wp = c.types->ProcParam( st, i + rcv )
                if wp = Tko.TYPE_NONE then
                    ok = false
                    exit for
                end if
                dim as boolean wRef = (c.types->Kind( wp ) = Tko.TK_REFERENCE)
                if wRef then wp = c.types->Inner( wp )
                dim as Tko.TypeId gp = ProcParamTypeAt_( c, cur, i )
                if gp = Tko.TYPE_NONE then
                    ok = false
                    exit for
                end if
                if c.types->Kind( gp ) = Tko.TK_REFERENCE then gp = c.types->Inner( gp )
                if c.types->Unqualify( gp ) <> c.types->Unqualify( wp ) then ok = false
                if ok then ok = (ProcParamByref_( c, cur, i ) = wRef)
            next
            if ok then
                c.info->SetDecision( fnE, cur )
                if c.ast->Kind( v ) = Tko.N_ADDROF then
                    if c.info->TypeOf_( v ) = ProcTypeOfSymbol_( c, first_ ) then c.info->SetType( v, ProcTypeOfSymbol_( c, cur ) )
                end if
                return
            end if
        end if
        cur = cs->nextOverload
    wend
end sub

'' EVERY CONTEXT THAT GIVES A VALUE A TARGET TYPE, as lowering's LowerExprWant_ callers do: an
'' initialiser (the variable's type), an assignment (the target's), and a call's arguments
'' (each parameter's). Run once the whole unit is typed.
private sub DecideProcAddrs_( byref c as Ctx )
    for i as int32 = 1 to c.ast->Count( )
        dim as Tko.NodeId n = cast( Tko.NodeId, i )
        select case c.ast->Kind( n )
        case Tko.N_VAR
            '' Each declarator's VARIABLE, found as lowering finds it: by name in the statement's
            '' scope (a qualified 'T.x' static member is not a procedure pointer's shape).
            dim as Tko.StmtPayload ptr vp = StmtOf( c, n )
            for k as int32 = 0 to vp->count - 1
                dim as Tko.NodeId item = cast( Tko.NodeId, c.ast->children[vp->first + k] )
                if c.ast->Kind( item ) <> Tko.N_VAR_ITEM then continue for
                dim as Tko.StmtPayload ptr ip = StmtOf( c, item )
                if ip->b = Tko.NODE_NONE then continue for
                if (c.ast->nodes[cast( int32, item )].flags and Tko.NF_QUALIFIED) <> 0 then continue for
                dim as Tko.Symbol ptr vs = c.syms->SymbolAt( c.syms->LookupLocalTyped( c.info->ScopeOf( n ), ip->name, false ) )
                if vs <> nullptr then DecideProcAddr_( c, ip->b, vs->type_ )
            next
        case Tko.N_AMBIGUOUS
            dim as Tko.StmtPayload ptr ap = StmtOf( c, n )
            if c.info->AmbiguousOf( n ) = Tko.AMB_ASSIGN then
                if (ap->a <> Tko.NODE_NONE) andalso (ap->b <> Tko.NODE_NONE) then DecideProcAddr_( c, ap->b, c.info->TypeOf_( ap->a ) )
            elseif c.info->AmbiguousOf( n ) = Tko.AMB_CALL then
                if ap->a <> Tko.NODE_NONE then
                    dim as Tko.SymbolId cal = c.info->RefOf( ap->a )
                    for k as int32 = 0 to ap->count - 1
                        DecideProcAddr_( c, cast( Tko.NodeId, c.ast->children[ap->first + k] ), ProcParamTypeAt_( c, cal, k ) )
                    next
                end if
            end if
        case Tko.N_CALL
            dim as Tko.ListPayload ptr lp = @c.ast->lists[cast( int32, c.ast->nodes[cast( int32, n )].data )]
            dim as Tko.SymbolId cal = c.info->RefOf( n )
            if (cal = Tko.SYMBOL_NONE) andalso (lp->target <> Tko.NODE_NONE) then cal = c.info->RefOf( lp->target )
            dim as Tko.Symbol ptr cls = c.syms->SymbolAt( cal )
            if cls <> nullptr then
                if cls->kind = cast( uint8, Tko.SYM_PROC ) then
                    for k as int32 = 0 to lp->count - 1
                        DecideProcAddr_( c, cast( Tko.NodeId, c.ast->children[lp->first + k] ), ProcParamTypeAt_( c, cal, k ) )
                    next
                end if
            end if
        end select
    next
end sub

'' 'T( args )' -- WHICH CONSTRUCTOR, by the shared resolver (structpick.tiko), recorded on the
'' call for lowering's EmitTypeCtorInto_. Only when every argument is typed: an untyped one
'' has no cost, and lowering keeps its arity answer for that case.
private sub DecideCtorCall_( byref c as Ctx, byval id as Tko.NodeId, byval cp as Tko.ListPayload ptr, byval t as Tko.TypeId )
    if (t = Tko.TYPE_NONE) orelse (cp->count <= 0) then return
    t = c.types->Unqualify( t )
    if c.types->Kind( t ) <> Tko.TK_UDT then return
    dim as containers.Array( of uint32 ) argT
    for i as int32 = 0 to cp->count - 1
        dim as Tko.NodeId an = cast( Tko.NodeId, c.ast->children[cp->first + i] )
        dim as Tko.TypeId at = TypeOf_( c, an )
        if at = Tko.TYPE_NONE then return
        '' A CONCATENATION IS THE WIDEST OF ITS TERMS, as ResolveCall_ types it for an overload.
        if c.ast->Kind( an ) = Tko.N_BINARY then
            if ConcatHasWideStr_( c, an ) then at = c.types->Builtin( Tko.TY_WSTRING )
            if ConcatHasUString_( c, an ) then at = c.types->Builtin( Tko.TY_USTRING )
        end if
        argT.Push( cast( uint32, at ) )
    next
    dim as Tko.SymbolId first_ = Tko.Check.StructorNamed( *c.syms, *c.types, *c.names, t, "__ctor" )
    if first_ = Tko.SYMBOL_NONE then return
    dim as Tko.SymbolId pick = Tko.Check.PickStructor( *c.ast, *c.syms, *c.types, *c.names, *c.info, first_, argT )
    c.info->SetDecision( id, pick )
    '' ONE UDT ARGUMENT NO CONSTRUCTOR TAKES -- fbc's 99, measured over 'T( w )' with W unrelated
    '' and over an S that casts only to a number (StructorCastCost). Lowering found nothing
    '' either and stopped with TKO0994. Only this shape: a scalar or string argument keeps
    '' lowering's own fallbacks (CharPtrCtorInit_ and the wide ones).
    if (pick = Tko.SYMBOL_NONE) andalso (argT.Count = 1) then
        dim as Tko.TypeId a0 = c.types->Unqualify( cast( Tko.TypeId, argT[0] ) )
        if c.types->Kind( a0 ) = Tko.TK_REFERENCE then a0 = c.types->Unqualify( c.types->Inner( a0 ) )
        if (c.types->Kind( a0 ) = Tko.TK_UDT) andalso (c.types->BaseDistance( a0, t ) < 0) then
            c.diags->Report( Tko.TKO0632, Tko.PointRange( c.ast->Loc( id ) ), c.names->Spelling( c.types->NameOf( t ) ) )
        end if
    end if
end sub

'' EVERY 'T( args )' IN THE UNIT, found as lowering finds one (TypeCtorTypeOf_): a call whose
'' target names a UDT or a typedef of one -- 'Channel( of boolean )( 1 )' included, which
'' Resolve types on its own and Check's call typing never reaches.
private sub DecideCtorCalls_( byref c as Ctx )
    for i as int32 = 1 to c.ast->Count( )
        dim as Tko.NodeId n = cast( Tko.NodeId, i )
        if c.ast->Kind( n ) <> Tko.N_CALL then continue for
        dim as Tko.ListPayload ptr cp = @c.ast->lists[cast( int32, c.ast->nodes[cast( int32, n )].data )]
        if cp->target = Tko.NODE_NONE then continue for
        dim as Tko.Symbol ptr s = c.syms->SymbolAt( c.info->RefOf( cp->target ) )
        if s = nullptr then continue for
        if (s->kind <> cast( uint8, Tko.SYM_UDT )) andalso (s->kind <> cast( uint8, Tko.SYM_TYPEDEF )) then continue for
        dim as Tko.TypeId ct = c.types->Unqualify( c.info->TypeOf_( cp->target ) )
        if (ct = Tko.TYPE_NONE) orelse (c.types->Kind( ct ) <> Tko.TK_UDT) then
            ct = s->type_
            if ct = Tko.TYPE_NONE then continue for
            if c.types->Kind( ct ) <> Tko.TK_UDT then continue for
        end if
        DecideCtorCall_( c, n, cp, ct )
    next
end sub

'' Does UDT 'at' declare an 'operator cast' yielding 'pt' itself?
private function UdtCastsTo_( byref c as Ctx, byval at as Tko.TypeId, byval pt as Tko.TypeId ) as boolean
    dim as Tko.SymbolId cur = Tko.Check.StructorNamed( *c.syms, *c.types, *c.names, at, "cast" )
    dim as int32 guard = 0
    while (cur <> Tko.SYMBOL_NONE) andalso (guard < 4096)
        guard += 1
        dim as Tko.Symbol ptr cs = c.syms->SymbolAt( cur )
        if cs = nullptr then exit while
        dim as Tko.TypeId rt = c.types->Unqualify( cs->type_ )
        if rt <> Tko.TYPE_NONE then
            if c.types->Kind( rt ) = Tko.TK_REFERENCE then rt = c.types->Unqualify( c.types->Inner( rt ) )
            if rt = pt then return true
        end if
        cur = cs->nextOverload
    wend
    return false
end function

'' One argument 'a' for a parameter of UDT 'pt': TKO0660 when two of pt's constructors take it
'' equally -- see DecideCtorConvArgs_.
private sub CtorTieArg_( byref c as Ctx, byval a as Tko.NodeId, byval pt as Tko.TypeId )
    if c.types->Kind( pt ) <> Tko.TK_UDT then exit sub
    dim as Tko.TypeId at = TypeOf_( c, a )
    if at = Tko.TYPE_NONE then exit sub
    at = c.types->Unqualify( at )
    if c.types->Kind( at ) = Tko.TK_REFERENCE then at = c.types->Unqualify( c.types->Inner( at ) )
    if c.types->Kind( at ) <> Tko.TK_UDT then exit sub
    if c.types->BaseDistance( at, pt ) >= 0 then exit sub
    if UdtCastsTo_( c, at, pt ) then exit sub
    dim as Tko.SymbolId first_ = Tko.Check.StructorNamed( *c.syms, *c.types, *c.names, pt, "__ctor" )
    if first_ = Tko.SYMBOL_NONE then exit sub
    dim as containers.Array( of uint32 ) argT
    argT.Push( cast( uint32, at ) )
    dim as int32 ties = 0
    Tko.Check.PickStructor( *c.ast, *c.syms, *c.types, *c.names, *c.info, first_, argT, @ties )
    if ties > 0 then
        c.diags->Report( Tko.TKO0660, Tko.PointRange( c.ast->Loc( a ) ), c.names->Spelling( c.types->NameOf( pt ) ) )
    end if
end sub

'' A UDT ARGUMENT THAT REACHES TWO OF THE PARAMETER TYPE'S CONSTRUCTORS EQUALLY -- fbc's 98,
'' measured over a type casting to 'string' and a parameter type built from 'byref as ustring'
'' or 'byref as wstring' (structpick.tiko TextCastRank_ has the table). The argument was
'' accepted, and lowering, given no single pick, took the first constructor in the chain: the
'' wrong one, with an empty value, or an internal compiler error (TKO0994) where it could not
'' lower that one at all. A cast on the argument yielding the parameter's type itself is a
'' different conversion and is left to its own rules.
private sub DecideCtorConvArgs_( byref c as Ctx )
    for i as int32 = 1 to c.ast->Count( )
        dim as Tko.NodeId n = cast( Tko.NodeId, i )
        if c.ast->Kind( n ) <> Tko.N_CALL then continue for
        dim as Tko.ListPayload ptr cp = @c.ast->lists[cast( int32, c.ast->nodes[cast( int32, n )].data )]
        if (cp->target = Tko.NODE_NONE) orelse (cp->count <= 0) then continue for
        dim as Tko.SymbolId callee = c.info->RefOf( n )
        if callee = Tko.SYMBOL_NONE then callee = c.info->RefOf( cp->target )
        dim as Tko.Symbol ptr s = c.syms->SymbolAt( callee )
        if s = nullptr then continue for
        if s->kind <> cast( uint8, Tko.SYM_PROC ) then continue for
        dim as Tko.NodeId pn = cast( Tko.NodeId, s->payload )
        if (pn = Tko.NODE_NONE) orelse (c.ast->Kind( pn ) <> Tko.N_PROC) then continue for
        dim as Tko.StmtPayload ptr pp = @c.ast->stmts[cast( int32, c.ast->nodes[cast( int32, pn )].data )]
        if (pp->extra and Tko.PF_GENERIC_PROC) <> 0 then continue for
        dim as int32 ai = 0
        for k as int32 = 0 to pp->count - 1
            dim as Tko.NodeId prm = cast( Tko.NodeId, c.ast->children[pp->first + k] )
            if c.ast->Kind( prm ) <> Tko.N_PARAM then continue for
            if ai >= cp->count then exit for
            dim as Tko.NodeId a = cast( Tko.NodeId, c.ast->children[cp->first + ai] )
            ai += 1
            dim as Tko.NodeId pta = c.ast->stmts[cast( int32, c.ast->nodes[cast( int32, prm )].data )].a
            if pta = Tko.NODE_NONE then continue for
            dim as Tko.TypeId pt = c.types->Unqualify( TypeOf_( c, pta ) )
            if c.types->Kind( pt ) = Tko.TK_REFERENCE then pt = c.types->Unqualify( c.types->Inner( pt ) )
            '' A TYPED VARIADIC that packs: every argument from here on is an element of pt -- the
            '' FormatArg a UDT casting only to a number ties on (docs/tiko-params/RFC-0001).
            if (c.ast->nodes[cast( int32, prm )].flags and Tko.NF_VARIADIC) <> 0 then
                dim as boolean spread = (cp->count = ai) andalso IsArrayArgShape_( c, a )
                if spread = false then
                    for v as int32 = ai - 1 to cp->count - 1
                        CtorTieArg_( c, cast( Tko.NodeId, c.ast->children[cp->first + v] ), pt )
                    next
                end if
                exit for
            end if
            if (c.ast->nodes[cast( int32, prm )].flags and Tko.NF_ARRAY) <> 0 then continue for
            CtorTieArg_( c, a, pt )
        next
    next
end sub

'' A UDT ARGUMENT WHOSE POINTER CASTS BOTH REACH AN 'any ptr' PARAMETER -- fbc's 98, measured over
'' casts to 'long ptr' and 'double ptr' and 'sub tk( byval p as any ptr )'. The initialiser and
'' assignment forms are latesweeps2.tiko's (PtrCastFit); a call's argument was accepted and the
'' first cast taken.
private sub DecidePtrCastArgs_( byref c as Ctx )
    for i as int32 = 1 to c.ast->Count( )
        dim as Tko.NodeId n = cast( Tko.NodeId, i )
        if c.ast->Kind( n ) <> Tko.N_CALL then continue for
        dim as Tko.ListPayload ptr cp = @c.ast->lists[cast( int32, c.ast->nodes[cast( int32, n )].data )]
        if (cp->target = Tko.NODE_NONE) orelse (cp->count <= 0) then continue for
        dim as Tko.SymbolId callee = c.info->RefOf( cp->target )
        dim as Tko.Symbol ptr s = c.syms->SymbolAt( callee )
        if s = nullptr then continue for
        if s->kind <> cast( uint8, Tko.SYM_PROC ) then continue for
        '' ONE PROCEDURE ALONE: in an overload set the tie only takes that candidate out -- measured,
        '' casts to 'byte ptr' and 'zstring ptr' against OVERLOADs taking 'any ptr' and 'zstring ptr'
        '' bind the zstring one, and casts to 'byte ptr' and 'ubyte ptr' against 'zstring ptr' and
        '' 'byte ptr' the byte one. overload.tiko scores that (PtrCastIsPick).
        dim as Tko.SymbolId hd = c.syms->LookupLocal( s->parent, s->name )
        if (hd <> Tko.SYMBOL_NONE) andalso (c.syms->SymbolAt( hd )->nextOverload <> Tko.SYMBOL_NONE) then continue for
        dim as Tko.NodeId pn = cast( Tko.NodeId, s->payload )
        if (pn = Tko.NODE_NONE) orelse (c.ast->Kind( pn ) <> Tko.N_PROC) then continue for
        dim as Tko.StmtPayload ptr pp = @c.ast->stmts[cast( int32, c.ast->nodes[cast( int32, pn )].data )]
        dim as int32 ai = 0
        for k as int32 = 0 to pp->count - 1
            dim as Tko.NodeId prm = cast( Tko.NodeId, c.ast->children[pp->first + k] )
            if c.ast->Kind( prm ) <> Tko.N_PARAM then continue for
            if ai >= cp->count then exit for
            dim as Tko.NodeId a = cast( Tko.NodeId, c.ast->children[cp->first + ai] )
            ai += 1
            dim as Tko.NodeId pta = c.ast->stmts[cast( int32, c.ast->nodes[cast( int32, prm )].data )].a
            if pta = Tko.NODE_NONE then continue for
            dim as Tko.TypeId at = TypeOf_( c, a )
            if at = Tko.TYPE_NONE then continue for
            if Tko.Check.PtrCastFit( *c.ast, *c.syms, *c.types, *c.names, at, TypeOf_( c, pta ) ) = 2 then
                c.diags->Report( Tko.TKO0660, Tko.PointRange( c.ast->Loc( a ) ), "operator cast" )
            end if
        next
    next
end sub

'' A BYREF NUMERIC PARAMETER GIVEN AN LVALUE OF ANOTHER NUMERIC TYPE -- fbc's 58, against the overload
'' it CHOSE: measured, 'r( i )' over r( byref x as long ) and r( byval x as double ) with i an
'' INTEGER picks the long one (the closer type) and refuses it, where tiko quietly called the
'' double one. One procedure alone is the same 58. A constant gets a temporary and is fine;
'' integer and its same-width twin are one type (ByrefSameInt_).
private sub DecideByrefNumArgs_( byref c as Ctx )
    for i as int32 = 1 to c.ast->Count( )
        dim as Tko.NodeId n = cast( Tko.NodeId, i )
        if c.ast->Kind( n ) <> Tko.N_CALL then continue for
        dim as Tko.ListPayload ptr cp = @c.ast->lists[cast( int32, c.ast->nodes[cast( int32, n )].data )]
        if (cp->target = Tko.NODE_NONE) orelse (cp->count <= 0) then continue for
        dim as Tko.SymbolId callee = c.info->RefOf( n )
        if callee = Tko.SYMBOL_NONE then callee = c.info->RefOf( cp->target )
        dim as Tko.Symbol ptr s = c.syms->SymbolAt( callee )
        if s = nullptr then continue for
        if s->kind <> cast( uint8, Tko.SYM_PROC ) then continue for
        dim as Tko.NodeId pn = cast( Tko.NodeId, s->payload )
        if (pn = Tko.NODE_NONE) orelse (c.ast->Kind( pn ) <> Tko.N_PROC) then continue for
        dim as Tko.StmtPayload ptr pp = @c.ast->stmts[cast( int32, c.ast->nodes[cast( int32, pn )].data )]
        if (pp->extra and Tko.PF_GENERIC_PROC) <> 0 then continue for
        '' ONE PROCEDURE ALONE is ReportArgMismatch_'s: only a chain of two or more is judged here.
        dim as Tko.SymbolId hd = c.syms->LookupLocal( s->parent, s->name )
        if hd = Tko.SYMBOL_NONE then continue for
        if (c.syms->SymbolAt( hd )->nextOverload = Tko.SYMBOL_NONE) then continue for
        dim as int32 ai = 0
        for k as int32 = 0 to pp->count - 1
            dim as Tko.NodeId prm = cast( Tko.NodeId, c.ast->children[pp->first + k] )
            if c.ast->Kind( prm ) <> Tko.N_PARAM then continue for
            if ai >= cp->count then exit for
            dim as Tko.NodeId a = cast( Tko.NodeId, c.ast->children[cp->first + ai] )
            ai += 1
            if (c.ast->nodes[cast( int32, prm )].flags and Tko.NF_BYREF) = 0 then continue for
            if (c.ast->nodes[cast( int32, prm )].flags and Tko.NF_ARRAY) <> 0 then continue for
            dim as Tko.NodeId pta = c.ast->stmts[cast( int32, c.ast->nodes[cast( int32, prm )].data )].a
            if pta = Tko.NODE_NONE then continue for
            dim as Tko.TypeId pt = TypeOf_( c, pta )
            dim as Tko.TypeId at = TypeOf_( c, a )
            if IsNumericBuiltin_( c, pt ) andalso IsNumericBuiltin_( c, at ) then
                if (c.types->Unqualify( at ) <> c.types->Unqualify( pt )) andalso (ByrefSameInt_( c, at, pt ) = false) then
                    if IsLvalueShape_( c, a ) then
                        c.diags->Report( Tko.TKO0698, Tko.PointRange( c.ast->Loc( a ) ) )
                        exit for
                    end if
                end if
            end if
        next
    next
end sub
