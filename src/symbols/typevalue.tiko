'' typevalue.tiko -- A TYPE NAME WHERE A VALUE IS NEEDED.
''
'' Included from latechecks.tiko, inside its namespace and over its Ctx, exactly as
'' tmpllocal.tiko is; latechecks.tiko is at the line cap.
''
'' A name bound to a TYPE, a TYPEDEF or an ENUM has no value. Check gave it the type it
'' names as its type, so every value position took it: over 'type m as long',
''
''     m = 5             compiled and ran, assigning nothing
''     m += 1            likewise
''     print m           printed whatever lowering made of it
''     dim x as long = m
''
'' and the same over a TYPE or an ENUM name. fbc refuses each one: error 42, "Variable not
'' declared", because to fbc the name is not a variable at all.
''
'' CHECKED AT THE SITES THAT CERTAINLY NEED A VALUE, as the bare-array rule beside it is:
'' an assignment's two sides, a binary operand, a PRINT item, a declaration's
'' initialiser and an argument to a procedure, a procedure pointer or an array -- with or
'' without parentheses. A type name is legal as the subject of a member ('T.K', 'E.A'), as
'' the operand of sizeof/len/typeof, in a cast and in 'new' -- none of which is one of these.
'' 'o IS T' names a type on purpose, and either side may be one: skipped whole.
''
'' THE ARGUMENT SITE was missed until José Roca's report: over windows.bi, 'Foo hInstance'
'' and 'Foo2 hwnd' compiled and passed nothing, because FB names fold case and those spell
'' the typedefs HINSTANCE and HWND. fbc says error 42. A call's head must be the program's
'' -- a procedure, a variable, a parameter or a field -- so a builtin with a type operand
'' never reaches the rule.
''
'' A UDT NAME CAN BE A VALUE: 'var f1 = foo' over a type with a constructor builds one
'' (fbc's dim/auto_var2.bas). So a name that resolves to a UDT is refused only as an
'' assignment's TARGET -- 'U = 5' -- and everywhere else is left to the rules that judge
'' a UDT value. A typedef of a scalar, and an enum, have no value anywhere.
private function IsTypeNameValue_ ( byref c as Ctx, byval n as NodeId, _
                                    byval asTarget as boolean = false ) as boolean
    if n = NODE_NONE then return false
    if c.ast->Kind( n ) <> N_IDENT then return false
    dim as Symbol ptr s = c.syms->SymbolAt( c.info->RefOf( n ) )
    if s = nullptr then return false
    select case cast( SymbolKind, s->kind )
    case SYM_UDT, SYM_TYPEDEF, SYM_ENUM
    case else
        return false
    end select
    if asTarget then return true
    if s->kind = cast( uint8, SYM_ENUM ) then return true
    dim as TypeId t = c.types->Unqualify( c.info->TypeOf_( n ) )
    if t = TYPE_NONE then return false
    return (c.types->Kind( t ) <> TK_UDT)
end function

private sub ReportTypeNameValue_ ( byref c as Ctx, byval n as NodeId )
    dim as IdentPayload ptr ip = _
        c.ast->IdentOf( n )
    c.diags->Report( TKO0971, PointRange( c.ast->Loc( n ) ), c.names->Spelling( ip->name ) )
end sub

'' Whether a call's head is the program's: a procedure, or a value that is called or indexed.
private function IsProgramCallHead_ ( byref c as Ctx, byval sid as SymbolId ) as boolean
    dim as Symbol ptr s = c.syms->SymbolAt( sid )
    if s = nullptr then return false
    select case cast( SymbolKind, s->kind )
    case SYM_PROC, SYM_VARIABLE, SYM_PARAMETER, SYM_FIELD
        return true
    end select
    return false
end function

'' The first argument in a child run that is a type name; true when one was reported.
private function CheckTypeNameArgs_ ( byref c as Ctx, byval first as int32, _
                                      byval count as int32 ) as boolean
    for i as int32 = 0 to count - 1
        dim as NodeId an = cast( NodeId, c.ast->ChildSlot( first + i ) )
        if IsTypeNameValue_( c, an ) then ReportTypeNameValue_( c, an ) : return true
    next
    return false
end function

'' One report per statement: the first operand that is a type name.
sub CheckTypeNameValue_ ( byref c as Ctx, byval id as NodeId, byval k as NodeKind )
    select case k
    case N_AMBIGUOUS
        dim as StmtPayload ptr sp = _
            c.ast->StmtOf( id )
        if IsTypeNameValue_( c, sp->a, (c.info->AmbiguousOf( id ) = AMB_ASSIGN) ) then ReportTypeNameValue_( c, sp->a ) : return
        if IsTypeNameValue_( c, sp->b ) then ReportTypeNameValue_( c, sp->b ) : return
        '' 'Foo hInstance': a parenless call's arguments are the statement's children.
        if c.info->AmbiguousOf( id ) <> AMB_CALL then return
        if sp->a = NODE_NONE then return
        if IsProgramCallHead_( c, c.info->RefOf( sp->a ) ) = false then return
        CheckTypeNameArgs_( c, sp->first, sp->count )
    case N_CALL
        dim as ListPayload ptr lp = _
            c.ast->ListOf( id )
        if lp->count = 0 then return
        dim as SymbolId head = c.info->RefOf( id )
        if (head = SYMBOL_NONE) andalso (lp->target <> NODE_NONE) then head = c.info->RefOf( lp->target )
        if IsProgramCallHead_( c, head ) = false then return
        CheckTypeNameArgs_( c, lp->first, lp->count )
    case N_BINARY
        dim as BinaryPayload ptr bp = _
            c.ast->BinaryOf( id )
        if cast( TokenKind, bp->op ) = KW_IS then return
        if IsTypeNameValue_( c, bp->lhs ) then ReportTypeNameValue_( c, bp->lhs ) : return
        if IsTypeNameValue_( c, bp->rhs ) then ReportTypeNameValue_( c, bp->rhs )
    case N_INTRINSIC
        dim as StmtPayload ptr sp = _
            c.ast->StmtOf( id )
        if cast( TokenKind, sp->op ) <> KW_PRINT then return
        for i as int32 = 0 to sp->count - 1
            dim as NodeId a2 = c.ast->ChildAt( sp->first, i )
            if IsTypeNameValue_( c, a2 ) then ReportTypeNameValue_( c, a2 ) : return
        next
    case N_VAR_ITEM
        dim as StmtPayload ptr sp = _
            c.ast->StmtOf( id )
        if IsTypeNameValue_( c, sp->b ) then ReportTypeNameValue_( c, sp->b )
    end select
end sub
