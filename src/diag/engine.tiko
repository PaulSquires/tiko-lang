'' engine.tiko -- see engine.ti

#import "std/containers"
#include once "diag/engine.ti"
#include once "diag/render.ti"
#include once "diag/machine.ti"
#include once "support/platform.ti"

namespace Tko

const POLICY_DEFAULT as int32 = -1
const POLICY_IGNORE  as int32 = -2

'' Diagnostics go to STDERR. FreeBASIC's 'print #0' is the console, i.e. stdout --
'' which silently sent every diagnostic down the same pipe as --dump-tokens output.
'' 'open err' is the only way to reach stderr, so the handle is opened once, lazily.
dim shared as int32 stderrHandle = 0



constructor DiagnosticEngine( )
    this.sources = nullptr
    this.errors = 0
    this.warnings = 0
    this.suppressedCount = 0
    this.maxErrors = DIAG_DEFAULT_MAX_ERRORS
    this.warningsAsErrors = false
    this.capReported = false
    this.stopAtCap = true
    this.colorMode = COLOR_AUTO
    this.outputFormat = DIAGFMT_FBC
    this.machineOn = false
    this.machineRecs = ""

    InitDiagTable( )
    this.policy.Reserve( DIAG_COUNT )
    for i as int32 = 0 to DIAG_COUNT - 1
        this.policy.Push( POLICY_DEFAULT )
    next
end constructor

sub DiagnosticEngine.Attach( byval src as SourceManager ptr )
    this.sources = src
end sub

'' --------------------------------------------------------------------- policy

sub DiagnosticEngine.Ignore( byval id as DiagId )
    dim as boolean bad = (id <= DIAG_NONE) orelse (id >= DIAG_COUNT)
    if bad then return
    '' A STATEMENT LEFT OUT OF THE BUILD IS ALWAYS SAID (TKO0995, --allow-unlowered): not by
    '' -Wno-, not by '-w none' (LATER-PLAN D step 5).
    if id = TKO0995 then return
    this.policy[id] = POLICY_IGNORE
end sub

sub DiagnosticEngine.Promote( byval id as DiagId, byval s as Severity )
    dim as boolean bad = (id <= DIAG_NONE) orelse (id >= DIAG_COUNT)
    if bad then return
    this.policy[id] = cast( int32, s )
end sub

sub DiagnosticEngine.SetWarningsAsErrors( byval v as boolean )
    this.warningsAsErrors = v
end sub

sub DiagnosticEngine.SetMaxErrors( byval n as int32 )
    if n < 1 then n = 1
    this.maxErrors = n
end sub

sub DiagnosticEngine.SetColorMode( byval newMode as DiagColorMode )
    this.colorMode = newMode
end sub

sub DiagnosticEngine.SetFormat( byval f as DiagOutputFormat )
    this.outputFormat = f
end sub

sub DiagnosticEngine.EnableMachine( )
    this.machineOn = true
end sub

function DiagnosticEngine.MachineText( ) as string
    return this.machineRecs
end function

function DiagnosticEngine.UseColor( ) as boolean
    select case this.colorMode
    case COLOR_ALWAYS : return true
    case COLOR_NEVER  : return false
    case else         : return Tko.Platform.IsTerminal( Tko.Platform.STREAM_ERR )
    end select
end function

function DiagnosticEngine.EffectiveSeverity( byval id as DiagId ) as Severity
    dim as Severity base_ = DiagInfoOf( id )->defaultSev
    dim as boolean inRange = (id > DIAG_NONE) andalso (id < DIAG_COUNT)
    if inRange then
        dim as int32 p = this.policy[id]
        if p >= 0 then base_ = cast( Severity, p )
    end if
    dim as boolean escalate = this.warningsAsErrors andalso (base_ = SEV_WARNING)
    if escalate then return SEV_ERROR
    return base_
end function

'' ------------------------------------------------------------------ reporting

sub DiagnosticEngine.Push _
    ( byval id as DiagId, byval rng as SourceRange, byval hasLoc as boolean, _
      byval a0 as string, byval a1 as string, byval a2 as string )

    dim as boolean inRange = (id > DIAG_NONE) andalso (id < DIAG_COUNT)
    if inRange = false then return

    this.lastDropped = true
    if this.policy[id] = POLICY_IGNORE then
        this.suppressedCount += 1
        return
    end if

    dim as Severity sev = this.EffectiveSeverity( id )

    if sev = SEV_ERROR then
        if this.errors >= this.maxErrors then
            this.errors += 1
            if this.capReported = false then
                this.capReported = true
                dim as Diagnostic cap
                cap.id = TKO0990
                cap.sev = SEV_ERROR
                cap.range = PointRange( LOC_NONE )
                cap.text = *DiagInfoOf( TKO0990 )->format
                cap.hasLocation = false
                this.pending.Push( cap )
            end if
            return
        end if
        this.errors += 1
    elseif sev = SEV_WARNING then
        this.warnings += 1
    end if

    dim as Diagnostic d
    d.id = id
    d.sev = sev
    d.range = rng
    d.text = FormatDiag( *DiagInfoOf( id )->format, a0, a1, a2 )
    d.hasLocation = hasLoc
    d.instFrame = this.ActiveInst( )
    this.pending.Push( d )
    this.lastDropped = false
end sub

'' ------------------------------------------------------------ instantiations

function DiagnosticEngine.AddInstFrame _
    ( byref text as string, byval rng as SourceRange, byval parent as int32 ) as int32

    dim as InstFrame f
    f.text = text
    f.range = rng
    '' A parent is always an EARLIER frame. Holding to that here is what lets Flush walk
    '' the chain without a visited set: every step goes to a smaller number.
    f.parent = iif( (parent > 0) andalso (parent <= this.instFrames.Count), parent, 0 )
    this.instFrames.Push( f )
    return this.instFrames.Count
end function

sub DiagnosticEngine.EnterInst( byval frame as int32 )
    if frame <= 0 then return
    this.instActive.Push( frame )
end sub

sub DiagnosticEngine.LeaveInst( byval frame as int32 )
    if frame <= 0 then return
    if this.instActive.IsEmpty( ) then return
    if this.instActive[this.instActive.Count - 1] = frame then this.instActive.Pop( )
end sub

function DiagnosticEngine.ActiveInst( ) as int32
    if this.instActive.IsEmpty( ) then return 0
    return this.instActive[this.instActive.Count - 1]
end function

'' The chain as notes, innermost first: the instantiation whose body holds the error,
'' then the one that asked for it, out to the line in the program. Capped, because a
'' runaway instantiation is already its own error (TKO0829) and needs no 256 notes.
private sub AppendInstNotes_ _
    ( byref frames as InstFrameVec, byref d as Diagnostic )

    const MAX_INST_NOTES = 16
    dim as int32 f = d.instFrame, shown = 0
    while (f > 0) andalso (f <= frames.Count) andalso (shown < MAX_INST_NOTES)
        dim as DiagNote n
        n.id = TKO0903
        n.range = frames[f - 1].range
        n.text = FormatDiag( *DiagInfoOf( TKO0903 )->format, frames[f - 1].text, "", "" )
        d.notes.Push( n )
        shown += 1
        dim as int32 p = frames[f - 1].parent
        if p >= f then exit while
        f = p
    wend
end sub

sub DiagnosticEngine.NoteMacroUse _
    ( byval bodyLoc as SourceLoc, byval useLoc as SourceLoc, byref nm as string )
    if (bodyLoc = LOC_NONE) orelse (useLoc = LOC_NONE) orelse (bodyLoc = useLoc) then return
    dim as int32 head = -1, seen = 0
    if this.muFirst.TryGet( cast( uint32, bodyLoc ), head ) = false then head = -1
    dim as int32 k = head
    while k >= 0
        if this.muUse[k] = cast( uint32, useLoc ) then return
        seen += 1
        k = this.muNext[k]
    wend
    if seen >= 3 then return
    this.muUse.Push( cast( uint32, useLoc ) )
    this.muNext.Push( head )
    this.muName.Push( nm )
    this.muFirst.Put( cast( uint32, bodyLoc ), this.muUse.Count - 1 )
end sub

'' The use sites of the macro whose body holds the diagnostic's location, as notes.
private sub AppendMacroNotes_( byref e as DiagnosticEngine, byref d as Diagnostic )
    if (d.hasLocation = false) orelse e.muUse.IsEmpty( ) then return
    dim as int32 k = -1
    if e.muFirst.TryGet( cast( uint32, d.range.first ), k ) = false then return
    while k >= 0
        dim as DiagNote n
        n.id = TKO0986
        n.range = PointRange( cast( SourceLoc, e.muUse[k] ) )
        n.text = FormatDiag( *DiagInfoOf( TKO0986 )->format, e.muName[k], "", "" )
        d.notes.Push( n )
        k = e.muNext[k]
    wend
end sub

sub DiagnosticEngine.Report _
    ( byval id as DiagId, byval rng as SourceRange, _
      byval a0 as string = "", byval a1 as string = "", byval a2 as string = "" )

    this.Push( id, rng, (rng.first <> LOC_NONE), a0, a1, a2 )
end sub

sub DiagnosticEngine.ReportGlobal _
    ( byval id as DiagId, byval a0 as string = "", _
      byval a1 as string = "", byval a2 as string = "" )

    this.Push( id, PointRange( LOC_NONE ), false, a0, a1, a2 )
end sub

sub DiagnosticEngine.AddNote _
    ( byval id as DiagId, byval rng as SourceRange, _
      byval a0 as string = "", byval a1 as string = "", byval a2 as string = "" )

    if this.pending.IsEmpty( ) orelse this.lastDropped then return

    dim as DiagNote n
    n.id = id
    n.range = rng
    n.text = FormatDiag( *DiagInfoOf( id )->format, a0, a1, a2 )
    this.pending[this.pending.Count - 1].notes.Push( n )
end sub

'' -------------------------------------------------------------------- output

sub DiagnosticEngine.Flush( )
    if this.pending.IsEmpty( ) orelse this.muted then return

    dim as boolean colour = this.UseColor( )
    if colour then Tko.Platform.EnableAnsi( )

    '' Rendered in report order. Determinism is a project requirement, so this
    '' must never become "sorted by location" or "grouped by file".
    if stderrHandle = 0 then
        dim as int32 fh = freefile
        open err for output as #fh
        stderrHandle = fh
    end if
    dim as int32 h = stderrHandle

    '' The instantiation chain goes on LAST, after every AddNote -- see Diagnostic.
    for i as int32 = 0 to this.pending.Count - 1
        AppendMacroNotes_( this, this.pending[i] )
        if this.pending[i].instFrame > 0 then AppendInstNotes_( this.instFrames, this.pending[i] )
    next

    for each d as Diagnostic in this.pending
        dim as string rendered = Tko.Render.Diagnostic_( d, *this.sources, this.outputFormat, colour )
        if h > 0 then
            print #h, rendered;
        else
            print rendered;                 '' stderr unavailable: better stdout than nothing
        end if
        if this.machineOn then this.machineRecs += Tko.Machine.Records( d, *this.sources )
    next

    this.pending.Clear( )
end sub

sub DiagnosticEngine.Snapshot _
    ( byref pendingAt as int32, byref errorsAt as int32, byref warningsAt as int32, _
      byref suppressedAt as int32 )
    pendingAt = this.pending.Count
    errorsAt = this.errors
    warningsAt = this.warnings
    suppressedAt = this.suppressedCount
end sub

sub DiagnosticEngine.RollBack _
    ( byval pendingAt as int32, byval errorsAt as int32, byval warningsAt as int32, _
      byval suppressedAt as int32 )
    while this.pending.Count > pendingAt
        this.pending.Pop( )
    wend
    this.errors = errorsAt
    this.warnings = warningsAt
    this.suppressedCount = suppressedAt
    if this.errors < this.maxErrors then this.capReported = false
    this.lastDropped = false
end sub

function DiagnosticEngine.ErrorCount( ) as int32
    return this.errors
end function

function DiagnosticEngine.WarningCount( ) as int32
    return this.warnings
end function

function DiagnosticEngine.HasErrors( ) as boolean
    return (this.errors > 0)
end function

function DiagnosticEngine.Stopped( ) as boolean
    return this.capReported andalso this.stopAtCap
end function

end namespace
