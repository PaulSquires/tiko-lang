'' machine.ti -- diagnostics as records a program can read (--diagnostics-file).
''
'' The console rendering (diag/render) is for a person: a caret snippet, colour, a
'' '#line'-presented location. An EDITOR needs something else -- one record per line,
'' fields it can split without a grammar, and a location it can OPEN. The contract is
'' docs/internals/diagnostics-file.md; in short:
''
''     tiko-diagnostics <TAB> 1
''     <kind> <id> <file> <line> <col> <endLine> <endCol> <message>
''     related <id> <file> <line> <col> <endLine> <endCol> <message>
''     end <errors> <warnings> <exitcode>
''
'' Every line ends in LF, on every host. 'file' is the ABSOLUTE PHYSICAL path -- where the
'' bytes are, never a '#line' name -- and 'line' the physical line. 'col' counts
'' CHARACTERS from 1 (a tab is one), so an editor never needs the compiler's tab stop.
'' The end is exclusive. No location is an empty file and four zeros.
''
'' This module only FORMATS. Writing the file is the driver's business: the driver is the
'' only module allowed to touch the filesystem (driver.bi).

#ifndef __TKO_DIAG_MACHINE_BI__
#define __TKO_DIAG_MACHINE_BI__

#include once "tko.ti"
#include once "diag/diagnostic.ti"
#include once "source/manager.ti"

namespace Tko.Machine

    const FORMAT_VERSION as int32 = 1

    '' "tiko-diagnostics" TAB "1" LF
    declare function Header( ) as string

    '' The diagnostic's record and one 'related' record per note, each LF-terminated.
    declare function Records _
        ( byref d as Tko.Diagnostic, byref src as Tko.SourceManager ) as string

    '' "end" TAB errors TAB warnings TAB exitCode LF
    declare function EndRecord _
        ( byval errors as int32, byval warnings as int32, byval exitCode as int32 ) as string

end namespace

#endif
