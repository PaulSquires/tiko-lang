'' engine.ti -- the diagnostic engine.
''
'' Every phase reports here and only here (docs/plan/01 section 1). The engine owns
'' counting, -w / -Werror policy, the error cap, deduplication and ORDER.
''
'' Ordering is deterministic by construction: diagnostics are buffered and flushed in
'' the order they were reported for a unit, so a future parallel build cannot shuffle
'' output (docs/plan/01 section 3). This is designed in now because retrofitting
'' deterministic diagnostic order is miserable.
''
'' Invariants:
''   - A Diagnostic reaches output only through Flush( ).
''   - AddNote( ) attaches to the most recently reported diagnostic; calling it with
''     none outstanding is a no-op, never a crash.
''   - Once the error cap is reached, further errors are counted but not stored, and
''     Stopped( ) turns true: the compile winds down instead of carrying on in silence.

#ifndef __TKO_DIAG_ENGINE_BI__
#define __TKO_DIAG_ENGINE_BI__

#include once "tko.ti"
#include once "diag/diagnostic.ti"
#include once "source/manager.ti"

namespace Tko

    const DIAG_DEFAULT_MAX_ERRORS as long = 20

    type SeverityVec as containers.Array( of long )

    type DiagnosticEngine
        as SourceManager ptr sources
        as DiagVec    pending
        as long       errors
        as long       warnings
        as long       suppressedCount
        as long       maxErrors
        as boolean    warningsAsErrors
        as boolean    capReported
        '' THE CAP STOPS THE COMPILE, not just the output. It only dropped errors, and the
        '' passes ran to the end with nobody listening. True by default; the editor scan
        '' clears it, because a scan harvests the WHOLE unit whatever its errors.
        as boolean    stopAtCap
        '' The last Push was DROPPED -- ignored by -Wno or past the error cap -- so the
        '' notes that follow it belong to nothing and go nowhere (audit F-51): they hung
        '' under TKO0990, or under an unrelated diagnostic reported earlier.
        as boolean    lastDropped
        as DiagColorMode  colorMode
        as DiagOutputFormat outputFormat
        as SeverityVec policy        '' per-DiagId override; -1 = default, -2 = ignore
        '' --diagnostics-file. The records are rendered HERE, at Flush, in the order the
        '' console gets them -- a note only exists once AddNote has run, so rendering at
        '' Push would lose it -- and handed to the driver, which writes the file.
        as boolean    machineOn
        as string     machineRecs
        '' tikoParser.dll: Flush renders nothing and KEEPS the list -- the scan hands it to
        '' its host, and a GUI host has no console for it to go to.
        as boolean    muted
        '' THE INSTANTIATION CHAIN (T16). An error inside a generic's body is reported at
        '' the body, which is where the offending code is -- but the body is checked once
        '' per instantiation, and nothing said WHICH one, so a program with thirty had to be
        '' searched by hand. A pass that checks an instantiated body enters its frame;
        '' anything reported meanwhile carries it, and Flush renders the chain as TKO0903
        '' notes pointing at each line that asked. Stored here because every pass that can
        '' report from inside an instantiation -- resolve, check, visibility -- shares this.
        as InstFrameVec instFrames
        as containers.Array( of long ) instActive

        declare constructor( )
        declare sub Attach( byval src as SourceManager ptr )

        declare sub Report _
            ( byval id as DiagId, byval rng as SourceRange, _
              byval a0 as string = "", byval a1 as string = "", byval a2 as string = "" )

        '' For driver-level messages that have no source location at all.
        declare sub ReportGlobal _
            ( byval id as DiagId, byval a0 as string = "", _
              byval a1 as string = "", byval a2 as string = "" )

        declare sub AddNote _
            ( byval id as DiagId, byval rng as SourceRange, _
              byval a0 as string = "", byval a1 as string = "", byval a2 as string = "" )

        declare sub Flush( )

        '' A new frame, numbered from 1. 'parent' is the frame active when the
        '' instantiation was ASKED FOR -- ActiveInst( ) at that moment -- or 0.
        declare function AddInstFrame _
            ( byref text as string, byval rng as SourceRange, byval parent as long ) as long
        declare sub EnterInst( byval frame as long )     '' 0 is accepted and ignored
        declare sub LeaveInst( byval frame as long )     '' pairs with EnterInst( frame )
        declare function ActiveInst( ) as long

        declare function ErrorCount( ) as long
        '' A SNAPSHOT, and a return to it: everything reported since is forgotten,
        '' counts included. For a pass whose diagnostics the real one repeats -- the
        '' module graph's header scan (audit F-52).
        declare sub Snapshot( byref pendingAt as long, byref errorsAt as long, _
                              byref warningsAt as long, byref suppressedAt as long )
        declare sub RollBack( byval pendingAt as long, byval errorsAt as long, _
                              byval warningsAt as long, byval suppressedAt as long )
        declare function WarningCount( ) as long
        declare function HasErrors( ) as boolean
        '' PAST THE ERROR CAP: the parser sees the end of its input, the walks give up and
        '' the driver compiles no further unit. Cleared again by a RollBack under the cap.
        declare function Stopped( ) as boolean

        declare sub Ignore( byval id as DiagId )
        declare sub Promote( byval id as DiagId, byval s as Severity )
        declare sub SetWarningsAsErrors( byval v as boolean )
        declare sub SetMaxErrors( byval n as long )
        declare sub SetColorMode( byval newMode as DiagColorMode )
        declare sub SetFormat( byval f as DiagOutputFormat )
        declare sub EnableMachine( )
        declare function MachineText( ) as string
        declare function UseColor( ) as boolean

        private:
        declare function EffectiveSeverity( byval id as DiagId ) as Severity
        declare sub Push _
            ( byval id as DiagId, byval rng as SourceRange, byval hasLoc as boolean, _
              byval a0 as string, byval a1 as string, byval a2 as string )
    end type

end namespace

#endif
