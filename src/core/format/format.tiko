'    tkEdit - a minimalist keyboard-driven editor for the tiko compiler
'    Copyright (C) 2016-2026 Paul Squires, PlanetSquires Software
'
'    This Source Code Form is subject to the terms of the Mozilla Public
'    License, v. 2.0. If a copy of the MPL was not distributed with this
'    file, You can obtain one at https://mozilla.org/MPL/2.0/.
'
' format -- the code formatter: PURE TEXT IN, TEXT OUT. Ported from tiko-editor-tiko's edc/format
' (itself the old modFormat.inc); tools/oracle/run-fmt.sh holds the two to the same output over
' 4,584 cases.
'
' ARCHITECTURE: a lossless token list plus an indent stack, not an AST. Every unit of the input
' lands in exactly one token, so concatenating the tokens reproduces the input. Two consequences:
' comments are preserved for free, and the safety check is cheap -- the non-whitespace token
' streams before and after must be equal (TokensMatch). THE FORMATTER NEVER MOVES A LINE BREAK:
' it rewrites whitespace and keyword casing and nothing else; the one rule that adds or removes
' anything is BlankLinesAroundProc (and MaxBlankLines), which is why TokensMatch can be told to
' ignore line breaks.
'
' FAILURE POLICY: format what we can. A line the scanner cannot classify passes through; if a
' safety check fails the ORIGINAL text comes back with Changed = false, so a caller that ignores
' the flag still cannot corrupt a buffer.
'
' The text is UTF-16 (ustring). The lexer looks only at ASCII; any other unit is a one-unit
' operator token that no rule spaces or recases, so the output is the same as the old byte-wise
' engine's once encoded back to UTF-8.
#module "format"

#import "std/containers"
#import "std/strings"
using containers

' ---------------------------------------------------------------- public types

public enum TokenKind explicit
    Ws              ' runs of spaces and tabs
    Word            ' identifier or keyword
    Number          ' 123  1.5  1e-5  &hFF  &o17  &b1010
    Str             ' "..."  including the !"..." and $"..." forms
    Comment         ' ' to end of line, and a Rem statement
    MlComment       ' /' ... '/  (nested; a token stops at the line break)
    Op              ' punctuation and operators
    Cont            ' the trailing _ line-continuation marker
    Directive       ' a # or $ directive NAME, e.g. #include -- not the whole line
    Eol             ' CR LF, LF or CR
end enum

' Casing modes, applied independently to keywords, directives and type names.
public enum CaseMode explicit
    Leave
    Lower
    Upper
    Proper          ' the keyword files' own spelling, else Capitalized
end enum

' Parenthesis interior spacing.
public enum ParenMode explicit
    Leave
    Add             ' Foo( a, b )  -- tiko's house style
    Remove          ' Foo(a, b)
end enum

' The rule set. Defaults are the shipped ones: casing LEAVE and the two line-count rules OFF.
public type FormatRules
    ' indentation
    Reindent             as boolean = true
    IndentCase           as boolean = true    ' Case labels get a level inside Select Case
    ContinuationIndent   as long = 1          ' extra levels for a line continued with _
    ' casing
    CaseKeywords         as CaseMode = CaseMode.Leave
    CaseDirectives       as CaseMode = CaseMode.Leave
    CaseTypes            as CaseMode = CaseMode.Leave
    ' spacing
    SpaceAroundOperators as boolean = true
    SpaceAfterComma      as boolean = true
    ParenSpacing         as ParenMode = ParenMode.Leave
    SpacesBeforeComment  as long = 0          ' 0 = leave trailing-comment spacing alone
    ' blank lines and whitespace
    TrimTrailing         as boolean = true
    MaxBlankLines        as long = 0          ' 0 = leave runs of blank lines alone
    BlankLinesAroundProc as long = -1         ' -1 = leave alone
    ' triggers (stored with the rules, applied by the app)
    FormatOnEnter        as boolean = false
    FormatOnPaste        as boolean = false
end type

public type FormatToken
    Kind as TokenKind
    Text as ustring
end type

public type FormatResult
    Text    as ustring
    Changed as boolean      ' false: Text is the input, unchanged (nothing to do, or refused)
end type

' ---------------------------------------------------------------- private types

enum LineKind explicit
    Plain
    Opener          ' If..Then, For, Sub, Type, Select Case, ...
    Closer          ' End If, Next, Loop, Wend, End Sub, ...
    Middle          ' Else, ElseIf
    CaseLabel       ' Case, Case Else
    Directive       ' # or $ -- pinned to column 0
    Blank
    InMlComment     ' a line inside a /' '/ block: indent left alone
    Continued       ' a line whose predecessor ended with _
end enum

enum Vocab explicit
    None
    Keyword
    Directive
    TypeName
end enum

type FmtBlock
    IsSelect as boolean
    OwnDepth as long        ' the depth the OPENING line was emitted at
end type

type FmtLine
    First     as long       ' first token index
    Last      as long       ' last token index EXCLUDING the EOL token (First - 1 when empty)
    Eol       as ustring    ' "" on a final line with no terminator
    Kind      as LineKind
    InMl      as boolean    ' the line begins inside a block comment
    Out       as ustring    ' the formatted line, filled in by the passes
    Depth     as long
end type

type TokenList as Array( of FormatToken )

' ---------------------------------------------------------------- the formatter

' One Formatter holds the keyword vocabulary; everything else is per call, so one instance can
' serve the editor, the options preview and Format Project alike.
public type Formatter
    declare constructor( )
    ' The three keyword lists (whitespace-separated words, canonical casing). Only the tiko/FB
    ' list is the KEYWORD vocabulary; all three feed Proper casing, first spelling winning.
    declare sub SetKeywords( byref fbList as const ustring, byref winapiList as const ustring, _
                             byref extraList as const ustring )
    ' A whole text. Adds the stability check: the result must be a fixed point.
    declare function FormatText( byref text as const ustring, byref rules as const FormatRules, _
                                 byval indentWidth as long = 4, byval useTabs as boolean = false ) as FormatResult
    ' A run of lines known to sit at block depth startDepth (Format Selection, paste).
    declare function FormatAtDepth( byref text as const ustring, byref rules as const FormatRules, _
                                    byval startDepth as long, byval indentWidth as long = 4, _
                                    byval useTabs as boolean = false ) as FormatResult
    ' The running block depth entering 0-based line n.
    declare function DepthAtLine( byref text as const ustring, byval n as long ) as long
    ' The safety check: equal non-whitespace token streams (words compared without case).
    declare function TokensMatch( byref before as const ustring, byref after as const ustring, _
                                  byval ignoreEol as boolean ) as boolean
  private:
    declare function Classify( byref w as const ustring ) as Vocab
    declare function ApplyCase( byref w as const ustring, byval mode as CaseMode ) as ustring
    declare function IsUnaryContext( byref prevText as const ustring, byval prevKind as long ) as boolean
    declare function BuildBody( byref toks as TokenList, byval first as long, byval last as long, _
                                byref rules as const FormatRules, byval kind as LineKind ) as ustring
    m_keywords as Map( of ustring, boolean )      ' lower-case keyword -> true
    m_proper   as Map( of ustring, ustring )      ' lower-case word -> canonical spelling
    m_types    as Map( of ustring, boolean )      ' intrinsic type names
end type

public function DefaultRules( ) as FormatRules
    dim as FormatRules r
    return r
end function

' ---------------------------------------------------------------- character classes

private function IsDigit( byval c as ulong ) as boolean
    return ( c >= 48 ) andalso ( c <= 57 )
end function

private function IsAlpha( byval c as ulong ) as boolean
    return ( ( c >= 65 ) andalso ( c <= 90 ) ) orelse ( ( c >= 97 ) andalso ( c <= 122 ) )
end function

private function IsWordChar( byval c as ulong ) as boolean
    return IsAlpha( c ) orelse IsDigit( c ) orelse ( c = 95 )
end function

private function IsSpaceOrEol( byval c as ulong ) as boolean
    return ( c = 32 ) orelse ( c = 9 ) orelse ( c = 13 ) orelse ( c = 10 )
end function

private function LowerAscii( byval c as ulong ) as ulong
    if ( c >= 65 ) andalso ( c <= 90 ) then return c + 32
    return c
end function

' The whitespace-separated words of a keyword list.
private function Words( byref s as const ustring ) as Array( of ustring )
    dim as Array( of ustring ) out_
    dim as long n = len( s ), i = 0
    while i < n
        while ( i < n ) andalso IsSpaceOrEol( s[i] )
            i += 1
        wend
        if i >= n then exit while
        dim as long j = i
        while ( j < n ) andalso ( IsSpaceOrEol( s[j] ) = false )
            j += 1
        wend
        out_.Push( mid( s, i + 1, j - i ) )
        i = j
    wend
    return out_
end function

' ---------------------------------------------------------------- vocabulary

constructor Formatter( )
    ' Intrinsic type names: a language fact, not a slice of the user-editable keyword file.
    dim as ustring t = "byte ubyte short ushort integer uinteger long ulong longint ulongint " & _
                       "single double string zstring wstring boolean any pointer ptr " & _
                       "sub function unsigned signed const"
    for each w as ustring in Words( t )
        m_types.Put( w, true )
    next
end constructor

sub Formatter.SetKeywords( byref fbList as const ustring, byref winapiList as const ustring, _
                           byref extraList as const ustring )
    m_keywords.Clear( )
    m_proper.Clear( )
    for each w as ustring in Words( fbList )
        m_keywords.Put( lcase( w ), true )
    next
    ' Only words that CARRY casing earn a Proper entry; the rest fall back to Capitalized.
    dim as ustring all_ = fbList & " " & winapiList & " " & extraList
    for each w as ustring in Words( all_ )
        dim as ustring k = lcase( w )
        if ( w <> k ) andalso ( m_proper.Contains( k ) = false ) then m_proper.Put( k, w )
    next
end sub

function Formatter.Classify( byref w as const ustring ) as Vocab
    if len( w ) = 0 then return Vocab.None
    if ( w[0] = 35 ) orelse ( w[0] = 36 ) then return Vocab.Directive     ' # or $
    dim as ustring k = lcase( w )
    if m_types.Contains( k ) then return Vocab.TypeName
    if m_keywords.Contains( k ) then return Vocab.Keyword
    return Vocab.None
end function

' Proper falls back to Capitalized (the first LETTER, so #include becomes #Include): a file with
' two casing conventions in it is worse than either.
function Formatter.ApplyCase( byref w as const ustring, byval mode as CaseMode ) as ustring
    select case mode
    case CaseMode.Lower
        return lcase( w )
    case CaseMode.Upper
        return ucase( w )
    case CaseMode.Proper
        dim as ustring k = lcase( w )
        dim as ustring spelled
        if m_proper.TryGet( k, spelled ) then return spelled
        for i as long = 0 to len( k ) - 1
            if ( k[i] >= 97 ) andalso ( k[i] <= 122 ) then
                k[i] = k[i] - 32
                exit for
            end if
        next
        return k
    end select
    return w
end function

' ---------------------------------------------------------------- lexer

' A token from s[start] to s[stop - 1].
private sub AddToken( byref toks as TokenList, byval kind as TokenKind, byref s as const ustring, _
                      byval start as long, byval stop_ as long )
    dim as FormatToken t
    t.Kind = kind
    t.Text = mid( s, start + 1, stop_ - start )
    toks.Push( t )
end sub

' The lossless token list: concatenating every token's Text gives s back.
public function Lex( byref s as const ustring ) as TokenList
    dim as TokenList toks
    dim as long n = len( s )
    dim as long i = 0
    dim as long mlDepth = 0               ' /' '/ nesting
    dim as boolean stmtStart = true       ' no significant token yet on this statement

    while i < n
        dim as ulong ch = s[i]
        dim as long start = i

        ' -- inside a nested block comment: up to the line break, tracking nesting
        if mlDepth > 0 then
            while i < n
                dim as ulong c = s[i]
                if ( c = 13 ) orelse ( c = 10 ) then exit while
                if ( c = 47 ) andalso ( i + 1 < n ) andalso ( s[i + 1] = 39 ) then
                    mlDepth += 1 : i += 2 : continue while
                end if
                if ( c = 39 ) andalso ( i + 1 < n ) andalso ( s[i + 1] = 47 ) then
                    mlDepth -= 1 : i += 2
                    if mlDepth = 0 then exit while
                    continue while
                end if
                i += 1
            wend
            if i > start then
                AddToken( toks, TokenKind.MlComment, s, start, i )
                continue while
            end if
            ' nothing consumed: we sit on this line's break -- fall through to the EOL case
        end if

        ' -- end of line
        if ( ch = 13 ) orelse ( ch = 10 ) then
            if ( ch = 13 ) andalso ( i + 1 < n ) andalso ( s[i + 1] = 10 ) then i += 2 else i += 1
            AddToken( toks, TokenKind.Eol, s, start, i )
            stmtStart = true
            continue while
        end if

        ' -- whitespace
        if ( ch = 32 ) orelse ( ch = 9 ) then
            while ( i < n ) andalso ( ( s[i] = 32 ) orelse ( s[i] = 9 ) )
                i += 1
            wend
            AddToken( toks, TokenKind.Ws, s, start, i )
            continue while
        end if

        ' -- opening a block comment
        if ( ch = 47 ) andalso ( i + 1 < n ) andalso ( s[i + 1] = 39 ) then
            mlDepth = 1
            i += 2
            while i < n
                dim as ulong c = s[i]
                if ( c = 13 ) orelse ( c = 10 ) then exit while
                if ( c = 47 ) andalso ( i + 1 < n ) andalso ( s[i + 1] = 39 ) then
                    mlDepth += 1 : i += 2 : continue while
                end if
                if ( c = 39 ) andalso ( i + 1 < n ) andalso ( s[i + 1] = 47 ) then
                    mlDepth -= 1 : i += 2
                    if mlDepth = 0 then exit while
                    continue while
                end if
                i += 1
            wend
            AddToken( toks, TokenKind.MlComment, s, start, i )
            stmtStart = false
            continue while
        end if

        ' -- single-line comment
        if ch = 39 then
            while ( i < n ) andalso ( s[i] <> 13 ) andalso ( s[i] <> 10 )
                i += 1
            wend
            AddToken( toks, TokenKind.Comment, s, start, i )
            continue while
        end if

        ' -- string literal, including the !"..." and $"..." forms
        dim as boolean prefixed = ( ( ch = 33 ) orelse ( ch = 36 ) ) andalso ( i + 1 < n ) andalso ( s[i + 1] = 34 )
        if ( ch = 34 ) orelse prefixed then
            if prefixed then i += 1
            i += 1
            while i < n
                dim as ulong c = s[i]
                if ( c = 13 ) orelse ( c = 10 ) then exit while
                if c = 34 then
                    if ( i + 1 < n ) andalso ( s[i + 1] = 34 ) then      ' "" is an embedded quote
                        i += 2 : continue while
                    end if
                    i += 1
                    exit while
                end if
                i += 1
            wend
            AddToken( toks, TokenKind.Str, s, start, i )
            stmtStart = false
            continue while
        end if

        ' -- &h / &o / &b radix literals
        if ( ch = 38 ) andalso ( i + 1 < n ) then
            dim as ulong c2 = LowerAscii( s[i + 1] )
            if ( c2 = 104 ) orelse ( c2 = 111 ) orelse ( c2 = 98 ) then
                i += 2
                while ( i < n ) andalso IsWordChar( s[i] )
                    i += 1
                wend
                AddToken( toks, TokenKind.Number, s, start, i )
                stmtStart = false
                continue while
            end if
        end if

        ' -- decimal number
        if IsDigit( ch ) orelse ( ( ch = 46 ) andalso ( i + 1 < n ) andalso IsDigit( s[i + 1] ) ) then
            dim as boolean seenDot = false
            while i < n
                dim as ulong c = s[i]
                if IsDigit( c ) then
                    i += 1
                elseif ( c = 46 ) andalso ( seenDot = false ) then
                    seenDot = true : i += 1
                else
                    exit while
                end if
            wend
            ' exponent: its sign belongs to the literal, never spaced as an operator
            if i < n then
                dim as ulong c = LowerAscii( s[i] )
                if ( c = 101 ) orelse ( c = 100 ) then
                    dim as long j = i + 1
                    if ( j < n ) andalso ( ( s[j] = 43 ) orelse ( s[j] = 45 ) ) then j += 1
                    if ( j < n ) andalso IsDigit( s[j] ) then
                        i = j
                        while ( i < n ) andalso IsDigit( s[i] )
                            i += 1
                        wend
                    end if
                end if
            end if
            ' type suffix: ! # & % and the u / l / f family
            while i < n
                dim as ulong c = LowerAscii( s[i] )
                if ( c = 33 ) orelse ( c = 35 ) orelse ( c = 38 ) orelse ( c = 37 ) orelse _
                   ( c = 117 ) orelse ( c = 108 ) orelse ( c = 102 ) then
                    i += 1
                else
                    exit while
                end if
            wend
            AddToken( toks, TokenKind.Number, s, start, i )
            stmtStart = false
            continue while
        end if

        ' -- # or $ directive name, only where a statement starts
        if ( ( ch = 35 ) orelse ( ch = 36 ) ) andalso stmtStart then
            i += 1
            while ( i < n ) andalso IsWordChar( s[i] )
                i += 1
            wend
            AddToken( toks, TokenKind.Directive, s, start, i )
            stmtStart = false
            continue while
        end if

        ' -- word, or a lone trailing underscore = line continuation
        if IsWordChar( ch ) andalso ( IsDigit( ch ) = false ) then
            while ( i < n ) andalso IsWordChar( s[i] )
                i += 1
            wend
            ' a bare _ continues the line only when nothing but whitespace or a comment follows
            if ( i - start = 1 ) andalso ( ch = 95 ) then
                dim as long j = i
                dim as boolean onlyTrailing = true
                while j < n
                    dim as ulong c = s[j]
                    if ( c = 13 ) orelse ( c = 10 ) orelse ( c = 39 ) then exit while
                    if ( c = 32 ) orelse ( c = 9 ) then
                        j += 1 : continue while
                    end if
                    onlyTrailing = false
                    exit while
                wend
                if onlyTrailing then
                    AddToken( toks, TokenKind.Cont, s, start, i )
                    continue while
                end if
            end if
            ' Rem starts a comment only as the first word of a statement
            if stmtStart andalso ( i - start = 3 ) andalso ( lcase( mid( s, start + 1, 3 ) ) = "rem" ) then
                while ( i < n ) andalso ( s[i] <> 13 ) andalso ( s[i] <> 10 )
                    i += 1
                wend
                AddToken( toks, TokenKind.Comment, s, start, i )
                stmtStart = false
                continue while
            end if
            AddToken( toks, TokenKind.Word, s, start, i )
            stmtStart = false
            continue while
        end if

        ' -- operator / punctuation
        dim as ustring two
        if i + 1 < n then two = mid( s, i + 1, 2 )
        select case two
        case "<=", ">=", "<>", "->", "+=", "-=", "*=", "/=", "\=", "^=", "&=", "=>"
            i += 2
        case else
            i += 1
        end select
        AddToken( toks, TokenKind.Op, s, start, i )
        ' a colon ends the statement, so Rem or a # line may follow
        stmtStart = ( i - start = 1 ) andalso ( ch = 58 )
    wend
    return toks
end function

' Everything but whitespace, comments and line breaks.
private function IsSignificant( byval k as TokenKind ) as boolean
    select case k
    case TokenKind.Ws, TokenKind.Comment, TokenKind.MlComment, TokenKind.Eol
        return false
    end select
    return true
end function

private function Skippable( byval k as TokenKind, byval ignoreEol as boolean ) as boolean
    if k = TokenKind.Eol then return ignoreEol
    return IsSignificant( k ) = false
end function

function Formatter.TokensMatch( byref before as const ustring, byref after as const ustring, _
                                byval ignoreEol as boolean ) as boolean
    dim as TokenList a = Lex( before ), b = Lex( after )
    dim as long ia = 0, ib = 0
    do
        while ( ia < a.Count( ) ) andalso Skippable( a[ia].Kind, ignoreEol )
            ia += 1
        wend
        while ( ib < b.Count( ) ) andalso Skippable( b[ib].Kind, ignoreEol )
            ib += 1
        wend
        if ( ia >= a.Count( ) ) andalso ( ib >= b.Count( ) ) then return true
        if ( ia >= a.Count( ) ) orelse ( ib >= b.Count( ) ) then return false
        if a[ia].Kind <> b[ib].Kind then return false
        if a[ia].Kind = TokenKind.Str then
            if a[ia].Text <> b[ib].Text then return false      ' a literal's case is data
        elseif lcase( a[ia].Text ) <> lcase( b[ib].Text ) then
            return false
        end if
        ia += 1
        ib += 1
    loop
end function

' ---------------------------------------------------------------- lines

' The binary operators SpaceAroundOperators applies to (never . -> @ or punctuation).
private function IsBinaryOp( byref op as const ustring ) as boolean
    select case op
    case "=", "+", "-", "*", "/", "\", "^", "<", ">", "<=", ">=", "<>", "&", _
         "+=", "-=", "*=", "/=", "\=", "^=", "&=", "=>"
        return true
    end select
    return false
end function

' A + - * after a value (identifier, literal, closing bracket) is binary; anywhere else unary.
' prevKind -1 = start of line.
function Formatter.IsUnaryContext( byref prevText as const ustring, byval prevKind as long ) as boolean
    if prevKind = -1 then return true
    select case cast( TokenKind, prevKind )
    case TokenKind.Number, TokenKind.Str
        return false
    case TokenKind.Op
        return ( prevText <> ")" ) andalso ( prevText <> "]" )
    case TokenKind.Word
        ' an identifier is a value; a keyword ("Return -1", "Step -1") is not
        return this.Classify( prevText ) <> Vocab.None
    case TokenKind.Directive
        return true
    end select
    return false
end function

' Classify a line from its first significant word(s) -- never from a word found anywhere in it,
' which is what keeps "Dim As Sub() p" and "Exit For" from opening blocks.
private function ClassifyLine( byref toks as TokenList, byval first as long, byval last as long, _
                               byref isSelect as boolean ) as LineKind
    isSelect = false
    if last < first then return LineKind.Blank
    dim as long sig = -1
    dim as ustring w1, w2, w3
    dim as long nWords = 0
    dim as boolean anyContent = false
    for i as long = first to last
        dim as TokenKind k = toks[i].Kind
        if k = TokenKind.Ws then continue for
        anyContent = true
        if ( k = TokenKind.Comment ) orelse ( k = TokenKind.MlComment ) then continue for
        if sig = -1 then sig = i
        if ( k = TokenKind.Word ) andalso ( nWords < 3 ) then
            nWords += 1
            select case nWords
            case 1 : w1 = lcase( toks[i].Text )
            case 2 : w2 = lcase( toks[i].Text )
            case 3 : w3 = lcase( toks[i].Text )
            end select
        end if
    next
    if anyContent = false then return LineKind.Blank
    if sig = -1 then return LineKind.Plain                       ' comment-only line
    if toks[sig].Kind = TokenKind.Directive then return LineKind.Directive
    if toks[sig].Kind <> TokenKind.Word then return LineKind.Plain

    ' the last significant word, for the multi-line "If ... Then" test
    dim as ustring lastWord
    for i as long = last to first step -1
        dim as TokenKind k = toks[i].Kind
        if ( k = TokenKind.Ws ) orelse ( k = TokenKind.Comment ) orelse ( k = TokenKind.MlComment ) _
           orelse ( k = TokenKind.Cont ) then continue for
        if k = TokenKind.Word then lastWord = lcase( toks[i].Text )
        exit for
    next

    select case w1
    case "next", "loop", "wend", "endif"
        return LineKind.Closer
    case "end"
        select case w2
        case "if", "select", "sub", "function", "property", "operator", "type", "enum", "union", _
             "with", "scope", "namespace", "constructor", "destructor", "extern"
            return LineKind.Closer
        end select
        return LineKind.Plain                                    ' a bare End closes nothing
    case "else", "elseif"
        return LineKind.Middle
    case "case"
        return LineKind.CaseLabel
    case "if"
        if lastWord = "then" then return LineKind.Opener         ' "If x Then y" is complete
        return LineKind.Plain
    case "for", "do", "while", "with", "scope", "namespace", "enum", "union", "extern", _
         "sub", "function", "property", "operator", "constructor", "destructor"
        return LineKind.Opener
    case "select"
        isSelect = true
        return LineKind.Opener
    case "type"
        if ( nWords >= 3 ) andalso ( w3 = "as" ) then return LineKind.Plain   ' a typedef
        return LineKind.Opener
    case "public", "private", "static"
        select case w2
        case "sub", "function", "property", "operator", "constructor", "destructor"
            return LineKind.Opener
        end select
    end select
    return LineKind.Plain
end function

' One line's body -- casing and spacing, no indentation. PRESERVE BY DEFAULT: between two tokens
' keep whether the user had whitespace (as one space) and override only where a rule says so.
function Formatter.BuildBody( byref toks as TokenList, byval first as long, byval last as long, _
                              byref rules as const FormatRules, byval kind as LineKind ) as ustring
    dim as Array( of long ) idx
    dim as Array( of boolean ) hadWs
    dim as boolean pendingWs = false
    for i as long = first to last
        if toks[i].Kind = TokenKind.Ws then
            pendingWs = true
            continue for
        end if
        idx.Push( i )
        hadWs.Push( pendingWs )
        pendingWs = false
    next
    if idx.Count( ) = 0 then return ""

    ' a directive line keeps its spacing: "#define SQ(x) ((x)*(x))" is a macro body
    dim as boolean directive = ( kind = LineKind.Directive )
    dim as Array( of ustring ) parts

    for n as long = 0 to idx.Count( ) - 1
        dim as TokenKind k = toks[idx[n]].Kind
        dim as ustring txt = toks[idx[n]].Text

        if k = TokenKind.Word then
            select case this.Classify( txt )
            case Vocab.Keyword : txt = this.ApplyCase( txt, rules.CaseKeywords )
            case Vocab.TypeName : txt = this.ApplyCase( txt, rules.CaseTypes )
            end select
        elseif k = TokenKind.Directive then
            txt = this.ApplyCase( txt, rules.CaseDirectives )
        end if

        if n = 0 then
            parts.Push( txt )
            continue for
        end if

        dim as TokenKind kPrev = toks[idx[n - 1]].Kind
        dim as ustring prev = toks[idx[n - 1]].Text
        dim as boolean sep = hadWs[n]                             ' what the user wrote

        ' two adjacent words must stay apart or they fuse
        if ( ( kPrev = TokenKind.Word ) orelse ( kPrev = TokenKind.Number ) ) andalso _
           ( ( k = TokenKind.Word ) orelse ( k = TokenKind.Number ) ) then sep = true

        if directive = false then
            ' comma and semicolon: never a space before, optionally one after
            if ( k = TokenKind.Op ) andalso ( ( txt = "," ) orelse ( txt = ";" ) ) then
                sep = false
            elseif ( kPrev = TokenKind.Op ) andalso ( ( prev = "," ) orelse ( prev = ";" ) ) then
                if rules.SpaceAfterComma then sep = true
            end if

            if rules.SpaceAroundOperators then
                if ( k = TokenKind.Op ) andalso IsBinaryOp( txt ) then
                    dim as boolean unary = false
                    if ( txt = "-" ) orelse ( txt = "+" ) orelse ( txt = "*" ) then
                        unary = this.IsUnaryContext( prev, kPrev )
                    end if
                    if unary = false then sep = true
                end if
                if ( kPrev = TokenKind.Op ) andalso IsBinaryOp( prev ) then
                    dim as boolean prevUnary = false
                    if ( prev = "-" ) orelse ( prev = "+" ) orelse ( prev = "*" ) then
                        dim as long kPP = -1
                        dim as ustring pp
                        if n >= 2 then
                            kPP = toks[idx[n - 2]].Kind
                            pp = toks[idx[n - 2]].Text
                        end if
                        prevUnary = this.IsUnaryContext( pp, kPP )
                    end if
                    sep = ( prevUnary = false )
                end if
            end if

            ' member access and address-of bind tight
            if ( k = TokenKind.Op ) andalso ( ( txt = "." ) orelse ( txt = "->" ) ) then sep = false
            if ( kPrev = TokenKind.Op ) andalso ( ( prev = "." ) orelse ( prev = "->" ) orelse ( prev = "@" ) ) then sep = false

            select case rules.ParenSpacing
            case ParenMode.Add
                if ( prev = "(" ) andalso ( txt <> ")" ) then sep = true
                if ( txt = ")" ) andalso ( prev <> "(" ) then sep = true
            case ParenMode.Remove
                if prev = "(" then sep = false
                if txt = ")" then sep = false
            end select
        end if

        ' a trailing comment's spacing, on every line kind
        if ( ( k = TokenKind.Comment ) orelse ( k = TokenKind.MlComment ) ) andalso ( rules.SpacesBeforeComment > 0 ) then
            parts.Push( space( rules.SpacesBeforeComment ) )
        elseif sep then
            parts.Push( " " )
        end if
        parts.Push( txt )
    next
    return strings.Join( parts, "" )
end function

private function IndentString( byval depth as long, byval width_ as long, byval useTabs as boolean ) as ustring
    if depth <= 0 then return ""
    if useTabs then return string( depth, 9 )
    if width_ <= 0 then width_ = 4
    return space( depth * width_ )
end function

' The tokens first..last, verbatim.
private function Raw( byref toks as TokenList, byval first as long, byval last as long ) as ustring
    dim as Array( of ustring ) parts
    for i as long = first to last
        parts.Push( toks[i].Text )
    next
    return strings.Join( parts, "" )
end function

private function IsBlankText( byref s as const ustring ) as boolean
    for i as long = 0 to len( s ) - 1
        if ( s[i] <> 32 ) andalso ( s[i] <> 9 ) then return false
    next
    return true
end function

private function RTrimBlanks( byref s as const ustring ) as ustring
    dim as long n = len( s )
    while ( n > 0 ) andalso ( ( s[n - 1] = 32 ) orelse ( s[n - 1] = 9 ) )
        n -= 1
    wend
    return left( s, n )
end function

' Does the line end in a continuation marker (ignoring whitespace and a ' comment)?
private function EndsContinued( byref toks as TokenList, byval first as long, byval last as long ) as boolean
    for i as long = last to first step -1
        dim as TokenKind k = toks[i].Kind
        if ( k = TokenKind.Ws ) orelse ( k = TokenKind.Comment ) then continue for
        return k = TokenKind.Cont
    next
    return false
end function

function Formatter.FormatAtDepth( byref text as const ustring, byref rules as const FormatRules, _
                                  byval startDepth as long, byval indentWidth as long = 4, _
                                  byval useTabs as boolean = false ) as FormatResult
    dim as FormatResult res
    res.Text = text
    res.Changed = false
    if len( text ) = 0 then return res

    dim as TokenList toks = Lex( text )
    if toks.Count( ) = 0 then return res

    ' -- group tokens into lines
    dim as Array( of FmtLine ) lines
    dim as long cur = 0
    while cur < toks.Count( )
        dim as FmtLine ln
        ln.First = cur
        while ( cur < toks.Count( ) ) andalso ( toks[cur].Kind <> TokenKind.Eol )
            cur += 1
        wend
        ln.Last = cur - 1
        if cur < toks.Count( ) then
            ln.Eol = toks[cur].Text
            cur += 1
        end if
        lines.Push( ln )
    wend

    ' -- classify, and walk the indent stack
    dim as Array( of FmtBlock ) stack
    dim as long depth = iif( startDepth < 0, 0, startDepth )
    dim as boolean prevContinued = false
    dim as boolean inMl = false

    for n as long = 0 to lines.Count( ) - 1
        dim as long first = lines[n].First, last = lines[n].Last
        lines[n].InMl = inMl
        dim as boolean endsCont = EndsContinued( toks, first, last )

        ' a block comment left open at the end of this line: the next line starts inside it
        for i as long = first to last
            if toks[i].Kind = TokenKind.MlComment then
                dim as ustring c = toks[i].Text
                dim as long open_ = iif( inMl, 1, 0 )
                dim as long j = 0
                while j < len( c ) - 1
                    if ( c[j] = 47 ) andalso ( c[j + 1] = 39 ) then
                        open_ += 1 : j += 2 : continue while
                    end if
                    if ( c[j] = 39 ) andalso ( c[j + 1] = 47 ) then
                        open_ -= 1 : j += 2 : continue while
                    end if
                    j += 1
                wend
                inMl = ( open_ > 0 )
            end if
        next

        dim as boolean isSelect = false
        dim as LineKind kind
        if lines[n].InMl then
            kind = LineKind.InMlComment
        elseif prevContinued then
            kind = LineKind.Continued
        else
            kind = ClassifyLine( toks, first, last, isSelect )
        end if
        lines[n].Kind = kind

        dim as long lineDepth = depth
        select case kind
        case LineKind.Closer
            if stack.Count( ) > 0 then
                dim as FmtBlock closed = stack.Pop( )
                lineDepth = closed.OwnDepth
                depth = closed.OwnDepth
            else
                ' no opener in view: in a fragment the block opened above it, so step out one
                ' level, clamped at zero (which also makes a stray End If harmless)
                lineDepth = depth - 1
                if lineDepth < 0 then lineDepth = 0
                depth = lineDepth
            end if
        case LineKind.Middle
            if stack.Count( ) > 0 then
                lineDepth = stack[stack.Count( ) - 1].OwnDepth
                depth = lineDepth + 1
            end if
        case LineKind.CaseLabel
            if ( stack.Count( ) > 0 ) andalso stack[stack.Count( ) - 1].IsSelect then
                lineDepth = stack[stack.Count( ) - 1].OwnDepth
                if rules.IndentCase then lineDepth += 1
                depth = lineDepth + 1
            end if
        case LineKind.Directive
            lineDepth = 0               ' pinned, and depth-NEUTRAL
        case LineKind.Continued
            lineDepth = depth + rules.ContinuationIndent
        case LineKind.Opener
            dim as FmtBlock opened
            opened.IsSelect = isSelect
            opened.OwnDepth = lineDepth
            stack.Push( opened )
            depth = lineDepth + 1
        end select
        if lineDepth < 0 then lineDepth = 0
        lines[n].Depth = lineDepth
        prevContinued = endsCont
    next

    ' -- render each line
    for n as long = 0 to lines.Count( ) - 1
        dim as LineKind kind = lines[n].Kind
        dim as long first = lines[n].First, last = lines[n].Last
        if kind = LineKind.InMlComment then
            lines[n].Out = Raw( toks, first, last )     ' prose: never reindented
            continue for
        end if
        if kind = LineKind.Blank then
            if rules.TrimTrailing then lines[n].Out = "" else lines[n].Out = Raw( toks, first, last )
            continue for
        end if
        dim as ustring body = this.BuildBody( toks, first, last, rules, kind )
        if rules.TrimTrailing then body = RTrimBlanks( body )
        if rules.Reindent then
            lines[n].Out = IndentString( lines[n].Depth, indentWidth, useTabs ) & body
        else
            dim as long i = first                        ' keep the user's own leading whitespace
            while ( i <= last ) andalso ( toks[i].Kind = TokenKind.Ws )
                i += 1
            wend
            lines[n].Out = Raw( toks, first, i - 1 ) & body
        end if
    next

    ' -- blank-line policy: the only pass that changes the line count
    dim as boolean countMayChange = ( rules.MaxBlankLines > 0 ) orelse ( rules.BlankLinesAroundProc >= 0 )
    dim as ustring eolDefault = wchr( 13, 10 )
    for each ln as FmtLine in lines
        if len( ln.Eol ) > 0 then
            eolDefault = ln.Eol
            exit for
        end if
    next

    dim as Array( of ustring ) outParts
    if countMayChange = false then
        for each ln as FmtLine in lines
            outParts.Push( ln.Out )
            outParts.Push( ln.Eol )
        next
    else
        dim as long run_ = 0, emitted = 0
        dim as Array( of ustring ) pending
        dim as long pendingBreaks = 0
        for n as long = 0 to lines.Count( ) - 1
            if IsBlankText( lines[n].Out ) then
                run_ += 1
                if ( rules.MaxBlankLines > 0 ) andalso ( run_ > rules.MaxBlankLines ) then continue for
                dim as ustring e = lines[n].Eol
                if len( e ) = 0 then e = eolDefault
                pending.Push( lines[n].Out )
                pending.Push( e )
                for q as long = 0 to len( e ) - 1
                    if e[q] = 10 then pendingBreaks += 1
                next
                continue for
            end if

            ' a top-level procedure or type, not at the top of the file: top up the separation
            if ( rules.BlankLinesAroundProc >= 0 ) andalso ( emitted > 0 ) andalso _
               ( lines[n].Kind = LineKind.Opener ) andalso ( lines[n].Depth = 0 ) then
                dim as long sig = -1
                for i as long = lines[n].First to lines[n].Last
                    dim as TokenKind k = toks[i].Kind
                    if ( k = TokenKind.Ws ) orelse ( k = TokenKind.Comment ) orelse ( k = TokenKind.MlComment ) then continue for
                    sig = i
                    exit for
                next
                if sig >= 0 then
                    select case lcase( toks[sig].Text )
                    case "sub", "function", "type", "property", "operator", "constructor", _
                         "destructor", "public", "private", "static"
                        ' (counts LF only, as the original did: a CR-only file never counts any)
                        for e as long = pendingBreaks + 1 to rules.BlankLinesAroundProc
                            pending.Push( eolDefault )
                        next
                    end select
                end if
            end if

            for each p as ustring in pending
                outParts.Push( p )
            next
            pending.Clear( )
            pendingBreaks = 0
            outParts.Push( lines[n].Out )
            outParts.Push( lines[n].Eol )
            emitted += 1
            run_ = 0
        next
        ' trailing blank lines survive as written
        for each p as ustring in pending
            outParts.Push( p )
        next
    end if
    dim as ustring result = strings.Join( outParts, "" )

    ' -- safety: the program must not have changed
    if this.TokensMatch( text, result, countMayChange ) = false then return res
    res.Changed = ( result <> text )
    res.Text = result
    return res
end function

function Formatter.FormatText( byref text as const ustring, byref rules as const FormatRules, _
                               byval indentWidth as long = 4, byval useTabs as boolean = false ) as FormatResult
    dim as FormatResult once_ = this.FormatAtDepth( text, rules, 0, indentWidth, useTabs )
    if once_.Changed = false then return once_
    ' not a fixed point: refuse, rather than hand back a result that a second run would change
    dim as FormatResult again = this.FormatAtDepth( once_.Text, rules, 0, indentWidth, useTabs )
    if again.Text <> once_.Text then
        dim as FormatResult refused
        refused.Text = text
        refused.Changed = false
        return refused
    end if
    return once_
end function

function Formatter.DepthAtLine( byref text as const ustring, byval n as long ) as long
    if n <= 0 then return 0
    dim as TokenList toks = Lex( text )
    if toks.Count( ) = 0 then return 0
    dim as FormatRules rules
    dim as Array( of FmtBlock ) stack
    dim as long depth = 0, curLine = 0, cur = 0
    dim as boolean prevContinued = false
    while ( cur < toks.Count( ) ) andalso ( curLine < n )
        dim as long start = cur
        while ( cur < toks.Count( ) ) andalso ( toks[cur].Kind <> TokenKind.Eol )
            cur += 1
        wend
        dim as long last = cur - 1
        if cur < toks.Count( ) then cur += 1
        dim as boolean endsCont = EndsContinued( toks, start, last )
        if prevContinued = false then
            dim as boolean isSelect = false
            select case ClassifyLine( toks, start, last, isSelect )
            case LineKind.Closer
                if stack.Count( ) > 0 then depth = stack.Pop( ).OwnDepth
            case LineKind.Middle
                if stack.Count( ) > 0 then depth = stack[stack.Count( ) - 1].OwnDepth + 1
            case LineKind.CaseLabel
                if ( stack.Count( ) > 0 ) andalso stack[stack.Count( ) - 1].IsSelect then
                    depth = stack[stack.Count( ) - 1].OwnDepth + 1
                    if rules.IndentCase then depth += 1
                end if
            case LineKind.Opener
                dim as FmtBlock b
                b.IsSelect = isSelect
                b.OwnDepth = depth
                stack.Push( b )
                depth += 1
            end select
        end if
        prevContinued = endsCont
        curLine += 1
    wend
    return iif( depth < 0, 0, depth )
end function
