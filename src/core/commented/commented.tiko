'
' commented -- a key the user changed but left commented out. settings.toml and keybindings.toml
' are written with every key commented at its default ("# font_size = 11"); editing the value and
' not the '#' changes nothing, silently. EditedComments finds those lines by comparing the file
' with the template it was written from, so saving can say so (Warning).
'
' A key line is "key = value" or "# key = value", the value's own trailing comment dropped. Keys
' under a commented-out table ("# [[builds]]") are a block the user has not taken up and are not
' looked at; a key set for real in its table is not reported either.
#module "commented"

#import "std/containers"
using containers

private function IsKey( byref k as const ustring ) as boolean
    if len( k ) = 0 then return false
    for i as long = 1 to len( k )
        dim as long ch = asc( mid( k, i, 1 ) )
        dim as boolean ok = ((ch >= 65) andalso (ch <= 90)) orelse ((ch >= 97) andalso (ch <= 122)) orelse _
                            ((ch >= 48) andalso (ch <= 57)) orelse (ch = 95) orelse (ch = 45)
        if ok = false then return false
    next
    return true
end function

' The value at the start of s: a quoted string to its closing quote, an array to its ']', else up
' to a '#'. "" when there is none.
private function ValueOf( byref s as const ustring ) as ustring
    if len( s ) = 0 then return ""
    dim as ustring q = left( s, 1 )
    if (q = "'") orelse (q = """") then
        dim as long e = instr( 2, s, q )
        if e = 0 then return s
        return left( s, e )
    end if
    if q = "[" then
        dim as long e = instr( s, "]" )
        if e = 0 then return s
        return left( s, e )
    end if
    dim as long h = instr( s, "#" )
    if h > 0 then return trim( left( s, h - 1 ) )
    return trim( s )
end function

' One line, read: a table header (tbl set), a key line (k, v), or neither. isComment says
' whether it starts with '#'.
private function ReadLine( byref raw as const ustring, byref isComment as boolean, byref isTable as boolean, _
                           byref tbl as ustring, byref k as ustring, byref v as ustring ) as boolean
    dim as ustring s = trim( raw, any !" \t\r" )
    isComment = false
    isTable = false
    if left( s, 1 ) = "#" then
        isComment = true
        s = trim( mid( s, 2 ), any !" \t" )
    end if
    if left( s, 1 ) = "[" then
        dim as long e = instr( s, "]" )
        if e = 0 then return false
        isTable = true
        tbl = trim( mid( s, 2, e - 2 ), any "[] " )
        return true
    end if
    dim as long eq = instr( s, "=" )
    if eq < 2 then return false
    k = trim( left( s, eq - 1 ) )
    if IsKey( k ) = false then return false
    v = ValueOf( trim( mid( s, eq + 1 ) ) )
    return len( v ) > 0
end function

private type KeyLines
    Names   as Array( of ustring )   ' "table.key"
    Values  as Array( of ustring )
    Comment as Array( of boolean )
end type

private function Scan( byref text as const ustring ) as KeyLines
    dim as KeyLines r
    dim as ustring tbl = ""
    dim as boolean dead = false                  ' inside a commented-out table
    dim as long p = 1
    while p <= len( text )
        dim as long e = instr( p, text, chr( 10 ) )
        if e = 0 then e = len( text ) + 1
        dim as ustring ln = mid( text, p, e - p )
        p = e + 1
        dim as boolean isComment, isTable
        dim as ustring t, k, v
        if ReadLine( ln, isComment, isTable, t, k, v ) = false then continue while
        if isTable then
            if isComment then
                dead = true
            else
                dead = false
                tbl = t
            end if
            continue while
        end if
        if dead andalso isComment then continue while
        r.Names.Push( tbl & "." & k )
        r.Values.Push( v )
        r.Comment.Push( isComment )
    wend
    return r
end function

' The keys (bare names, in file order, each once) that text has commented out at a value other
' than template's, and does not also set uncommented.
public function EditedComments( byref text as const ustring, byref template as const ustring ) as Array( of ustring )
    dim as Array( of ustring ) found
    dim as KeyLines tl = Scan( template ), ul = Scan( text )
    for i as long = 0 to ul.Names.Count( ) - 1
        if ul.Comment[i] = false then continue for
        dim as ustring nm = ul.Names[i]
        dim as long at = -1
        for j as long = 0 to tl.Names.Count( ) - 1
            if tl.Comment[j] andalso (tl.Names[j] = nm) then
                at = j
                exit for
            end if
        next
        if (at < 0) orelse (tl.Values[at] = ul.Values[i]) then continue for
        dim as boolean setForReal = false
        for j as long = 0 to ul.Names.Count( ) - 1
            if (ul.Comment[j] = false) andalso (ul.Names[j] = nm) then setForReal = true
        next
        if setForReal then continue for
        dim as ustring bare = mid( nm, instrrev( nm, "." ) + 1 )
        dim as boolean seen = false
        for each f as ustring in found
            if f = bare then seen = true
        next
        if seen = false then found.Push( bare )
    next
    return found
end function

' The status line's words for EditedComments' keys; "" for none.
public function Warning( byref keys as const Array( of ustring ) ) as ustring
    if keys.Count( ) = 0 then return ""
    if keys.Count( ) = 1 then return keys[0] & " is commented out: remove the # to use it"
    return keys[0] & " and " & str( keys.Count( ) - 1 ) & " more are commented out: remove the # to use them"
end function
