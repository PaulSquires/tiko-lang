'    tkEdit - a minimalist keyboard-driven editor for the tiko compiler
'    Copyright (C) 2026 Paul Squires, PlanetSquires Software
'
' commentedsuite -- tkc/commented: an edited commented-out key found, an untouched one, a trailing
' comment, a key also set for real, a commented-out [[table]], one name for two tables; and both
' real templates (settings.toml, keybindings.toml) against themselves and with one line edited.
#module "commentedsuite"

#import "std/containers"
#import "std/strings"
#import "tkc/commented"
#import "tkc/keybind"
#import "tkc/settings"
#import "../tally"
using containers

private function Joined( byref a as const Array( of ustring ) ) as ustring
    dim as ustring s = ""
    for each x as ustring in a
        if len( s ) then s &= ","
        s &= x
    next
    return s
end function

public sub Run( byref c as tally.Checker )
    c.Begin( "commented" )
    dim as ustring nl = chr( 10 )
    dim as ustring tpl = "version = 1" & nl & "[editor]" & nl & "# font_size = 11" & nl & _
                         "# tab_size = 4        # spaces" & nl & "[ui]" & nl & "# font_size = 10" & nl & _
                         "# [[builds]]" & nl & "# name = 'Debug'" & nl
    c.Same( Joined( commented.EditedComments( tpl, tpl ) ), "", "the template itself: nothing" )
    dim as ustring t = strings.Replace( tpl, "# font_size = 11", "# font_size = 14" )
    c.Same( Joined( commented.EditedComments( t, tpl ) ), "font_size", "an edited commented-out key" )
    t = strings.Replace( t, "# font_size = 10", "#font_size=9" )
    c.Same( Joined( commented.EditedComments( t, tpl ) ), "font_size", "edited in two tables: named once" )
    t = strings.Replace( tpl, "# font_size = 11", "# font_size = 14" & nl & "font_size = 14" )
    c.Same( Joined( commented.EditedComments( t, tpl ) ), "", "also set for real: nothing" )
    t = strings.Replace( tpl, "# spaces", "# my own note" )
    c.Same( Joined( commented.EditedComments( t, tpl ) ), "", "only the trailing comment changed: nothing" )
    t = strings.Replace( tpl, "# name = 'Debug'", "# name = 'Fast'" )
    c.Same( Joined( commented.EditedComments( t, tpl ) ), "", "inside a commented-out [[table]]: nothing" )
    t = strings.Replace( tpl, "# tab_size = 4", "# tab_size = 2" )
    t = strings.Replace( t, "# font_size = 11", "# font_size = 12" )
    c.Same( Joined( commented.EditedComments( t, tpl ) ), "font_size,tab_size", "two keys, in file order" )

    c.Same( commented.Warning( commented.EditedComments( tpl, tpl ) ), "", "no warning for none" )
    dim as Array( of ustring ) one, two
    one.Push( "font_size" )
    two.Push( "font_size" ) : two.Push( "tab_size" )
    c.Same( commented.Warning( one ), "font_size is commented out: remove the # to use it", "one key's warning" )
    c.Same( commented.Warning( two ), "font_size and 1 more are commented out: remove the # to use them", "two keys' warning" )

    ' the real templates
    dim as ustring st = settings.Template( )
    c.Same( Joined( commented.EditedComments( st, st ) ), "", "settings.toml's template: nothing" )
    c.Check( instr( st, "# font_size = 11" ) > 0, "settings.toml's template has # font_size = 11" )
    c.Same( Joined( commented.EditedComments( strings.Replace( st, "# font_size = 11", "# font_size = 16" ), st ) ), _
            "font_size", "settings.toml with font_size edited and still commented" )
    dim as keybind.KeyMap km
    dim as ustring kt = km.ToToml( ).ValueOr( "" )
    c.Check( instr( kt, "# FindNext = 'F3'" ) > 0, "keybindings.toml's template has # FindNext = 'F3'" )
    c.Same( Joined( commented.EditedComments( kt, kt ) ), "", "keybindings.toml's template: nothing" )
    c.Same( Joined( commented.EditedComments( strings.Replace( kt, "# FindNext = 'F3'", "# FindNext = 'F6'" ), kt ) ), _
            "FindNext", "keybindings.toml with FindNext edited and still commented" )
end sub
