'    tkEdit - a minimalist keyboard-driven editor for the tiko compiler
'    Copyright (C) 2026 Paul Squires, PlanetSquires Software
'
' fmtsuite -- tkc/format: the old engine's own self-test (Format_RunSelfTest), every group, on the
' ported Formatter. The oracle over the 4,584-case corpus is tools/oracle/run-fmt.sh.
#module "fmtsuite"

#import "std/containers"
#import "tkc/format"
#import "../tally"
using containers

' A pocket keyword list carrying canonical casing, as the real keyword files do.
const KW = "ByVal Dim As If Then Else ElseIf End For To Next Step Select Case Print Return Sub " & _
           "Function Type Scope Exit Do Loop Long ScreenRes"

private function Lossless( byref s as const ustring ) as boolean
    dim as ustring back
    for each t as format.FormatToken in format.Lex( s )
        back &= t.Text
    next
    return back = s
end function

public sub Run( byref c as tally.Checker )
    c.Begin( "format" )
    dim as ustring NL = wchr( 13, 10 )
    dim as format.Formatter f
    f.SetKeywords( KW, "MessageBox", "" )

    ' 1. the lexer is lossless
    scope
        dim as ustring samples( 0 to 8 ) = { _
            "dim as long i = 0" & NL & "if i > 1 then" & NL & "print i" & NL & "end if" & NL, _
            "x = -1 : y = a - b" & NL, _
            "s = ""he said """"hi"""" ok""  ' trailing" & NL, _
            "/' block" & NL & "   still block '/ code" & NL, _
            "#include once ""foo.bi""" & NL, _
            "n = &hFF + &b1010 + 1.5e-3" & NL, _
            "call foo( a, _" & NL & "          b )" & NL, _
            "rem an old style comment" & NL & "Print 1" & NL, _
            "" }
        for i as long = 0 to 8
            c.Check( Lossless( samples( i ) ), "lex is lossless on sample " & i )
        next
        c.Check( Lossless( "x = " & wchr( &h00E9, &h4E2D, &hD83D, &hDE00 ) & " ' " & wchr( &h00E9 ) & NL ), "lex is lossless on non-ASCII" )
    end scope

    ' 2. reindent from block structure
    scope
        dim as format.FormatRules r
        c.Same( f.FormatText( "dim as long i" & NL & "if i > 1 then" & NL & "print i" & NL & "else" & NL & "print 0" & NL & "end if" & NL, r ).Text, _
                "dim as long i" & NL & "if i > 1 then" & NL & "    print i" & NL & "else" & NL & "    print 0" & NL & "end if" & NL, _
                "If/Else/End If indents one level" )
        dim as ustring in2 = "if i > 1 then print i" & NL & "print 2" & NL
        c.Same( f.FormatText( in2, r ).Text, in2, "single-line If does not open a block" )
        c.Same( f.FormatText( "for i = 1 to 10" & NL & "exit for" & NL & "next" & NL, r ).Text, _
                "for i = 1 to 10" & NL & "    exit for" & NL & "next" & NL, "Exit For does not open a block" )
        dim as ustring in4 = "dim as sub() p" & NL & "print 1" & NL
        c.Same( f.FormatText( in4, r ).Text, in4, "Dim As Sub() does not open a block" )
        dim as ustring in5 = "type myint as long" & NL & "print 1" & NL
        c.Same( f.FormatText( in5, r ).Text, in5, "Type typedef does not open a block" )
        c.Same( f.FormatText( "type foo" & NL & "as long x" & NL & "end type" & NL, r ).Text, _
                "type foo" & NL & "    as long x" & NL & "end type" & NL, "Type block indents its fields" )
        c.Same( f.FormatText( "if x then" & NL & "end" & NL & "end if" & NL, r ).Text, _
                "if x then" & NL & "    end" & NL & "end if" & NL, "bare End closes no block" )
    end scope

    ' 3. Select Case, with and without IndentCase
    scope
        dim as format.FormatRules r
        dim as ustring src = "select case x" & NL & "case 1" & NL & "foo" & NL & "case else" & NL & "bar" & NL & "end select" & NL
        r.IndentCase = true
        c.Same( f.FormatText( src, r ).Text, "select case x" & NL & "    case 1" & NL & "        foo" & NL & _
                "    case else" & NL & "        bar" & NL & "end select" & NL, "Select Case with IndentCase on" )
        r.IndentCase = false
        c.Same( f.FormatText( src, r ).Text, "select case x" & NL & "case 1" & NL & "    foo" & NL & _
                "case else" & NL & "    bar" & NL & "end select" & NL, "Select Case with IndentCase off" )
    end scope

    ' 4. directives: column 0 and depth-neutral
    scope
        dim as format.FormatRules r
        c.Same( f.FormatText( "sub foo()" & NL & "    #if defined(__FB_WIN32__)" & NL & "print 1" & NL & "    #else" & NL & _
                              "print 2" & NL & "    #endif" & NL & "end sub" & NL, r ).Text, _
                "sub foo()" & NL & "#if defined(__FB_WIN32__)" & NL & "    print 1" & NL & "#else" & NL & _
                "    print 2" & NL & "#endif" & NL & "end sub" & NL, "# directives pin to column 0, body indents normally" )
        dim as ustring in2 = "#if A" & NL & "if x then" & NL & "#else" & NL & "if y then" & NL & "#endif" & NL & "foo" & NL & "end if" & NL
        c.Check( f.TokensMatch( in2, f.FormatText( in2, r ).Text, false ), "unbalanced #If arms do not corrupt the token stream" )
    end scope

    ' 5. unbalanced blocks never drive the indent negative
    scope
        dim as format.FormatRules r
        dim as ustring src = "end if" & NL & "end if" & NL & "print 1" & NL
        dim as ustring o = f.FormatText( src, r ).Text
        c.Check( instr( o, NL & " " ) = 0, "stray End If leaves no negative or phantom indent" )
        c.Check( f.TokensMatch( src, o, false ), "stray End If preserves the token stream" )
    end scope

    ' 6. tabs vs spaces
    scope
        dim as format.FormatRules r
        dim as ustring src = "if x then" & NL & "foo" & NL & "end if" & NL
        c.Check( instr( f.FormatText( src, r, 4, false ).Text, NL & "    foo" ) > 0, "spaces mode indents with 4 spaces" )
        c.Check( instr( f.FormatText( src, r, 2, false ).Text, NL & "  foo" ) > 0, "indent width is honoured" )
        c.Check( instr( f.FormatText( src, r, 4, true ).Text, NL & wchr( 9 ) & "foo" ) > 0, "tabs mode indents with one tab per level" )
    end scope

    ' 7. keyword casing, split by vocabulary
    scope
        dim as format.FormatRules r
        r.Reindent = false
        dim as ustring src = "DIM as LONG i" & NL
        r.CaseKeywords = format.CaseMode.Lower
        c.Check( instr( f.FormatText( src, r ).Text, "dim" ) > 0, "keywords lowercase" )
        r.CaseKeywords = format.CaseMode.Upper
        c.Check( instr( f.FormatText( src, r ).Text, "DIM" ) > 0, "keywords uppercase" )
        r.CaseKeywords = format.CaseMode.Proper
        c.Check( instr( f.FormatText( "dim byval x" & NL, r ).Text, "ByVal" ) > 0, "Proper Case uses the keyword file's spelling" )
        c.Check( instr( f.FormatText( "IF x THEN" & NL, r ).Text, "If" ) > 0, "Proper Case falls back to Capitalized" )
        r.CaseKeywords = format.CaseMode.Lower
        r.CaseTypes = format.CaseMode.Upper
        dim as ustring mixed = f.FormatText( src, r ).Text
        c.Check( ( instr( mixed, "dim" ) > 0 ) andalso ( instr( mixed, "LONG" ) > 0 ), "types recase independently of keywords" )
        r.CaseKeywords = format.CaseMode.Upper
        dim as ustring o = f.FormatText( "s = ""dim as long"" ' dim as long" & NL, r ).Text
        c.Check( instr( o, """dim as long""" ) > 0, "string literal contents are never recased" )
        c.Check( instr( o, "' dim as long" ) > 0, "comment contents are never recased" )
        ' a WinAPI-list word is no keyword, so even Proper never recases it
        r.CaseKeywords = format.CaseMode.Proper
        c.Same( f.FormatText( "messagebox x" & NL, r ).Text, "messagebox x" & NL, "identifiers outside the keyword list keep their case" )
    end scope

    ' 8. spacing
    scope
        dim as format.FormatRules r
        r.Reindent = false
        c.Same( f.FormatText( "a=b+c" & NL, r ).Text, "a = b + c" & NL, "binary operators are spaced" )
        c.Same( f.FormatText( "foo(a,b)" & NL, r ).Text, "foo(a, b)" & NL, "a space follows a comma" )
        c.Same( f.FormatText( "x=-1" & NL, r ).Text, "x = -1" & NL, "unary minus after = is not spaced" )
        c.Same( f.FormatText( "foo(-1,-2)" & NL, r ).Text, "foo(-1, -2)" & NL, "unary minus after ( and , is not spaced" )
        c.Same( f.FormatText( "x=a-1" & NL, r ).Text, "x = a - 1" & NL, "binary minus after an identifier IS spaced" )
        c.Same( f.FormatText( "x=for_count-1" & NL, r ).Text, "x = for_count - 1" & NL, "binary minus after a keyword-prefixed identifier" )
        c.Same( f.FormatText( "*p=5" & NL, r ).Text, "*p = 5" & NL, "leading pointer deref is not spaced" )
        c.Same( f.FormatText( "x=1.5e-3" & NL, r ).Text, "x = 1.5e-3" & NL, "exponent sign is part of the number" )
        c.Same( f.FormatText( "p->fld=x.y" & NL, r ).Text, "p->fld = x.y" & NL, "member access is never spaced" )
        r.ParenSpacing = format.ParenMode.Add
        c.Same( f.FormatText( "foo(a, b)" & NL, r ).Text, "foo( a, b )" & NL, "paren spacing: add" )
        c.Same( f.FormatText( "foo()" & NL, r ).Text, "foo()" & NL, "paren spacing: empty parens stay empty" )
        r.ParenSpacing = format.ParenMode.Remove
        c.Same( f.FormatText( "foo( a, b )" & NL, r ).Text, "foo(a, b)" & NL, "paren spacing: remove" )
        r.ParenSpacing = format.ParenMode.Leave
        dim as ustring macro_ = "#define SQ(x) ((x)*(x))" & NL
        c.Same( f.FormatText( macro_, r ).Text, macro_, "directive line spacing is left alone" )
        r.SpacesBeforeComment = 2
        c.Same( f.FormatText( "x = 1 ' hi" & NL, r ).Text, "x = 1  ' hi" & NL, "trailing comment spacing" )
    end scope

    ' 9. what the formatter must leave alone
    scope
        dim as format.FormatRules r
        dim as ustring src = "/'" & NL & "      +---+" & NL & "      | x |" & NL & "'/" & NL
        c.Same( f.FormatText( src, r ).Text, src, "block comment interior is not reindented" )
        r.ContinuationIndent = 1
        c.Same( f.FormatText( "if x then" & NL & "foo( a, _" & NL & "b )" & NL & "end if" & NL, r ).Text, _
                "if x then" & NL & "    foo( a, _" & NL & "        b )" & NL & "end if" & NL, "continuation line gets ContinuationIndent extra levels" )
        dim as ustring odd = "if x then" & NL & "@@@ ~~~ ???" & NL & "end if" & NL
        c.Check( f.TokensMatch( odd, f.FormatText( odd, r ).Text, false ), "an unclassifiable line survives intact" )
    end scope

    ' 10. blank-line rules
    scope
        dim as format.FormatRules r
        r.MaxBlankLines = 2
        c.Same( f.FormatText( "a" & NL & NL & NL & NL & NL & "b" & NL, r ).Text, "a" & NL & NL & NL & "b" & NL, "consecutive blank lines are capped" )
        r.MaxBlankLines = 0
        r.BlankLinesAroundProc = 1
        dim as ustring want2 = "dim as long g" & NL & NL & "sub foo()" & NL & "end sub" & NL
        c.Same( f.FormatText( "dim as long g" & NL & "sub foo()" & NL & "end sub" & NL, r ).Text, want2, "a blank line is inserted before a top-level Sub" )
        c.Same( f.FormatText( want2, r ).Text, want2, "existing separation is not doubled" )
        dim as ustring o = f.FormatText( "sub foo()" & NL & "    dim as long i" & NL & "    scope" & NL & "    end scope" & NL & "end sub" & NL, r ).Text
        c.Check( instr( o, NL & NL & "    scope" ) = 0, "a nested Scope gets no blank line inserted" )
    end scope

    ' 11. idempotence and token preservation with every rule on
    scope
        dim as format.FormatRules r
        r.CaseKeywords = format.CaseMode.Upper
        r.CaseTypes = format.CaseMode.Lower
        r.CaseDirectives = format.CaseMode.Lower
        r.ParenSpacing = format.ParenMode.Add
        r.SpacesBeforeComment = 2
        r.MaxBlankLines = 2
        r.BlankLinesAroundProc = 1
        dim as ustring src = "#include once ""windows.bi""" & NL & "" & NL & "type PERSON" & NL & "as zstring*32 name" & NL & _
            "as long age" & NL & "end type" & NL & "function greet( byval p as PERSON ptr ) as long" & NL & _
            "dim as long i,n=0" & NL & "if p=0 then return -1" & NL & "for i=0 to 10" & NL & "select case i" & NL & _
            "case 0" & NL & "n+=1   ' first" & NL & "case else" & NL & "n=n-1" & NL & "end select" & NL & "next" & NL & _
            "print ""done: "" & n" & NL & "return n" & NL & "end function" & NL
        dim as format.FormatResult once_ = f.FormatText( src, r )
        c.Check( once_.Changed, "the realistic sample actually changed" )
        dim as format.FormatResult twice = f.FormatText( once_.Text, r )
        c.Same( twice.Text, once_.Text, "format(format(x)) == format(x)" )
        c.Check( twice.Changed = false, "a second format reports no change" )
        c.Check( f.TokensMatch( src, once_.Text, true ), "the non-whitespace token stream is preserved" )
        c.Check( f.TokensMatch( src, src & "extra" & NL, true ) = false, "token match REJECTS an added token" )
        c.Check( f.TokensMatch( "a = 1" & NL, "a = 2" & NL, false ) = false, "token match REJECTS a changed literal" )
        c.Check( f.TokensMatch( "s = ""Hi""" & NL, "s = ""hi""" & NL, false ) = false, "token match REJECTS a recased STRING" )
        c.Check( f.TokensMatch( "DIM x" & NL, "dim x" & NL, false ), "token match ACCEPTS a recased keyword" )
        c.Check( f.TokensMatch( "a" & NL & "b" & NL, "a b" & NL, false ) = false, "token match REJECTS a swallowed line break" )
    end scope

    ' 12. the engine is pure; depth of a fragment
    scope
        dim as format.FormatRules r
        dim as ustring src = "if x then" & NL & "foo" & NL & "end if" & NL
        c.Same( f.FormatText( src, r ).Text, f.FormatText( src, r ).Text, "the engine is deterministic" )
        c.SameNum( f.DepthAtLine( src, 1 ), 1, "DepthAtLine: inside the If block" )
        c.SameNum( f.DepthAtLine( src, 2 ), 1, "DepthAtLine: entering End If, still inside" )
        c.SameNum( f.DepthAtLine( src, 0 ), 0, "DepthAtLine: 0 at the top of the file" )
        c.Same( f.FormatAtDepth( "foo" & NL & "end if" & NL, r, 1 ).Text, "    foo" & NL & "end if" & NL, _
                "a fragment ending in a closer dedents with no opener in view" )
        dim as ustring stray = "end if" & NL & "print 1" & NL
        c.Same( f.FormatAtDepth( stray, r, 0 ).Text, stray, "a stray closer at depth 0 is clamped" )
        c.Check( f.FormatText( "x = 1" & NL, r ).Changed = false, "an already-formatted text reports no change" )
    end scope
end sub
