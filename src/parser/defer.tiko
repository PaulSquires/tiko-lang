'' defer.tiko -- the 'defer' statement, for the parser.
''
'' Included from parser.tiko, which is at the 1500-line cap, as undef.tiko is.
''
'' 'defer' is CONTEXTUAL in FBC-Modern -- not reserved, so it arrives as an identifier and
'' is recognised by spelling (DeferStatementHead_), exactly as 'each' and 'in' are.
''
'' WHAT FOLLOWS IT ON THE LINE decides the rest. Measured on fbc-modern 1.20, 2026-09-25:
''
''     defer print "x"              the statement is deferred
''     defer                        at the end of the line: error 347, "DEFER requires a
''                                  statement" -- even with a 'sub defer( )' declared
''     defer : print "y"            FIRST ON A LINE, the LABEL 'defer:', and y prints at
''                                  once -- unless a procedure is named defer, which
''                                  makes it 347 like the rest
''     scope : defer : print "y"    not first on the line: 347
''
'' tiko read the statement AFTER the end of the line: a bare 'defer' deferred the next
'' line, one before 'end sub' swallowed it (TKO0405), and 'defer : print "y"' deferred
'' the print. ':' is a TK_EOL too, told apart by TF_COLON.

namespace Tko.Parse

'' 'defer :' is a label only where any 'name :' is one, and only first on its line.
private function DeferIsLabel_( byref p as Tko.ParserState ) as boolean
    if p.pos > 0 then
        dim as Tko.Token pv = p.toks->At( p.pos - 1 )
        if cast( Tko.TokenKind, pv.kind ) <> Tko.TK_EOL then return false
        if (pv.flags and Tko.TF_COLON) <> 0 then return false
    end if
    return IsLabelHere_( p )
end function

private function DeferStmt_ _
    ( byref p as Tko.ParserState, byref consumesLine as boolean ) as Tko.NodeId

    dim as Tko.Token dt = Cur( p )
    Advance( p )
    dim as Tko.StmtPayload sp
    dim as boolean ended = AtEnd( p )
    if ended = false then ended = (Peek( p ) = Tko.TK_EOL)
    if ended then
        '' Nothing is deferred. The end of the line is left for the caller to consume.
        p.diags->Report( Tko.TKO0828, Tko.PointRange( dt.loc ) )
        consumesLine = true
    else
        sp.b = Statement( p )
        consumesLine = false
    end if
    return MakeStmt( p, Tko.N_DEFER, dt.loc, sp )
end function

end namespace
