'' decl.tiko -- declarations.  Included by parser.tiko.

namespace Tko.Parse

'' Defined below: the TEXT of a string literal token, interned. Declared here because
'' VarItem needs it for a variable's ALIAS and is compiled before it.
declare function StringLitText( byref p as Tko.ParserState ) as Tko.InternId

'' AN EMPTY ALIAS OR LIB STRING IS AN ERROR -- fbc's 304 and 305. 'alias ""' would mangle
'' to a name with nothing in it, and 'lib ""' would link against a library with no name.
'' Seven corpus files write one or the other, across a procedure, a variable, a namespace,
'' a type, an enum and an EXTERN block -- so the test lives here and every site calls it.
private sub EmptyAliasCheck _
    ( byref p as Tko.ParserState, byval nm as Tko.InternId, byref tok as Tko.Token, _
      byval isLib as boolean )

    if len( p.names->Spelling( nm ) ) > 0 then return
    dim as Tko.DiagId d = Tko.TKO0672
    if isLib then d = Tko.TKO0673
    p.diags->Report( d, Tko.PointRange( tok.loc ) )
end sub

'' One array bound. '...' is legal HERE and nowhere else, so it is read here rather
'' than in Primary -- loosening the expression grammar to carry it would let '...'
'' through in places FreeBASIC does not have it.
''
'' Measured: 'dim a(0 to ...)' and 'dim a(...)' both work, any dimension may use it and
'' several may, but 'redim a(0 to ...)' is fbc error 76, a TYPE FIELD is error 77, and
'' one with no initializer is error 281. The size comes from the initializer, so there
'' has to be one.

private function BoundExpr( byref p as Tko.ParserState ) as Tko.NodeId
    if Peek( p ) = Tko.TK_ELLIPSIS then
        dim as Tko.Token et = Cur( p )
        Advance( p )
        return NewNodeAt( p, Tko.N_ELLIPSIS, et.loc, 0 )
    end if
    return Expression( p )
end function

function IsDeclarationStart( byval k as Tko.TokenKind ) as boolean
    select case k
    case Tko.KW_DIM, Tko.KW_REDIM, Tko.KW_VAR, Tko.KW_CONST, Tko.KW_STATIC, _
         Tko.KW_SHARED, Tko.KW_COMMON, Tko.KW_EXTERN, Tko.KW_TYPE, Tko.KW_UNION, _
         Tko.KW_ENUM, Tko.KW_DECLARE, Tko.KW_SUB, Tko.KW_FUNCTION, Tko.KW_PROPERTY, _
         Tko.KW_CONSTRUCTOR, Tko.KW_DESTRUCTOR, Tko.KW_OPERATOR, Tko.KW_NAMESPACE, _
         Tko.KW_USING, Tko.KW_OPTION, Tko.KW_PRIVATE, Tko.KW_PUBLIC, _
         Tko.KW_VIRTUAL, Tko.KW_ABSTRACT, Tko.KW_CLASS
        '' VIRTUAL and ABSTRACT were missing, so a member DEFINITION carrying one --
        '' 'virtual sub Base.vs( )' at module level -- never reached the declaration
        '' parser at all, even though the modifier loop inside it already handled both.
        ''
        '' ABSTRACT is included deliberately although fbc rejects a body for one: it does
        '' so SEMANTICALLY (error 224, "Implemented body for an ABSTRACT method"), having
        '' parsed the definition first. Refusing it here would report a syntax error for
        '' something that is not one. The real diagnostic is owed from the checker.
        return true
    end select
    return false
end function

'' A name in declaration position: an identifier, or a keyword being reused as one
'' (which FreeBASIC allows in several places).
'' The RAW spelling of the identifier at the cursor, case as written, or 0.
private function RawSpelling( byref p as Tko.ParserState ) as Tko.InternId
    dim as Tko.Token t = Cur( p )
    if Peek( p ) <> Tko.TK_IDENT then return 0
    if t.length <= 0 then return 0
    dim as Tko.DecodedLoc d : d.offset = p.src->LocOffset( t.loc, d.file )   '' no column: O(1)
    dim as Tko.SourceFile ptr f = p.src->FileAt( d.file )
    if f = nullptr then return 0
    if (d.offset + cast( int32, t.length )) > f->text.Count then return 0
    dim as Tko.InternId raw = p.names->Get( @f->text[d.offset], cast( int32, t.length ) )
    '' ...ONLY IF THOSE BYTES ARE ACTUALLY THIS TOKEN. A token the preprocessor
    '' BUILT -- a '##' paste, or a macro parameter substituted in -- keeps the
    '' location it was expanded at, so the source there spells the INVOCATION and
    '' not the name. 'mkfn( Foo )' over 'function V##_ overload' mangled the
    '' function as MKFN, taking four bytes of the call site because 'Foo_' is four
    '' bytes long; fbc emits '_Z4FOO_u7INTEGER'. fb/vector.bi is 30 procedures of
    '' this shape.
    ''
    '' Checked by COMPARING rather than by trusting a flag: the raw spelling exists
    '' only to preserve CASE, so the two must differ by case alone or the bytes are
    '' not the token's and the interned name is the honest answer.
    if Tko.Text.LowerAscii( p.names->Spelling( raw ) ) <> _
       Tko.Text.LowerAscii( p.names->Spelling( t.literal ) ) then return 0
    return raw
end function

'' 'a.b' as an EXPRESSION node, built without going through the postfix parser -- which
'' cannot be used here because it would take the '( 0 to 9 )' that follows as a CALL and
'' swallow the bounds. The same node shape Postfix builds: an N_BINARY over '.', with
'' its kind changed to N_MEMBER.
private function MakeMemberRef_ _
    ( byref p as Tko.ParserState, byref dotTok as Tko.Token, _
      byval lhs as Tko.NodeId, byval rhs as Tko.NodeId ) as Tko.NodeId

    dim as Tko.BinaryPayload bp
    bp.op = cast( uint16, Tko.TK_DOT )
    bp.lhs = lhs
    bp.rhs = rhs
    p.ast->PushBinary( bp )
    dim as Tko.NodeId n = _
        NewNodeAt( p, Tko.N_BINARY, dotTok.loc, p.ast->BinaryPoolCount( ) - 1 )
    p.ast->SetKind( n, cast( uint16, Tko.N_MEMBER ) )
    return n
end function

'' WHAT THE PREPROCESSOR IS TOLD, and when. 'defined( X )' answers for a declared name
'' as well as a macro -- fbc's rule, measured on all seven kinds -- and the only place
'' this side knows a name has been declared is here, where every declaration reads one.
''
'' MODULE LEVEL ONLY, which is the whole of the scope model. fbc's 'defined' is
'' position-dependent and scope-respecting: a local or a parameter stops being visible
'' when its procedure ends, and a TYPE's FIELD is never visible at all. 'aggDepth'
'' excludes the fields and 'procDepth' the locals; a PARAMETER of a module-level
'' DECLARE is excluded by its own reader passing 'record = false', since procDepth is
'' still zero there.
''
'' Recording one that fbc would not is the dangerous direction: a later '#ifndef' would
'' skip a declaration and say nothing.
#include once "parser/declkind.tiko"

private function DeclName _
    ( byref p as Tko.ParserState, byref outName as Tko.InternId, _
      byval record as boolean = true ) as boolean

    dim as Tko.TokenKind k = Peek( p )
    if k = Tko.TK_IDENT then
        outName = cast( Tko.InternId, Cur( p ).literal )
        if record andalso ((Cur( p ).flags and Tko.TF_BARE_FNMACRO) <> 0) then BareMacroDecl_( p )
        Advance( p )
        if record then NoteDeclaredName_( p, outName )
        return true
    end if
    if Tko.IsKeywordKind( k ) then
        outName = p.names->GetString( Tko.Text.LowerAscii( Tko.TokenKindText( k ) ) )
        Advance( p )
        if record then NoteDeclaredName_( p, outName )
        return true
    end if
    outName = Tko.INTERN_NONE
    return false
end function

'' Array bounds into 'c'. 'dim x()' is a dynamic array with no bounds given. Shared by
'' the named form and by a REDIM's parenthesised target, which reads its bounds the
'' same way after a different head.
private sub ParseArrayBoundsInto _
    ( byref p as Tko.ParserState, byref sp as Tko.StmtPayload, byref t as Tko.Token )

    if Peek( p ) <> Tko.TK_LPAREN then return
    Advance( p )
    dim as Tko.NodeIdVec dims
    if Peek( p ) <> Tko.TK_RPAREN then
        do
            dim as Tko.NodeId lo = BoundExpr( p )
            if Accept( p, Tko.KW_TO ) then
                dim as Tko.Token rt = Cur( p )
                dim as Tko.StmtPayload rp
                rp.a = lo
                rp.b = BoundExpr( p )
                dims.Push( cast( uint32, MakeStmt( p, Tko.N_CASE_RANGE, rt.loc, rp ) ) )
            else
                dims.Push( cast( uint32, lo ) )
            end if
            if Accept( p, Tko.TK_COMMA ) = false then exit do
        loop
    end if
    Expect( p, Tko.TK_RPAREN, ")" )
    sp.c = MakeList( p, Tko.N_BLOCK, t.loc, Tko.NODE_NONE, dims )
end sub

'' 'dim x(0 to 9, 3) as long = 5' -- one item of a declaration list.
''
'' A REDIM target may be PARENTHESISED: 'redim (a)(0 to 1)' is legal on a var-len
'' array, and 'redim (1+1)(0 to 1)' PARSES and is then fbc error 54. Both have to get
'' through the parser or the corpus's COMPILE_ONLY_FAIL files fail for the wrong
'' reason. A dotted target -- 'redim ns.arr(0 to 2)' -- already worked.

private function VarItem _
    ( byref p as Tko.ParserState, byval isRedim as boolean = false ) as Tko.NodeId

    dim as Tko.Token t = Cur( p )
    dim as Tko.StmtPayload sp

    '' 'redim ..a.b.arr( 0 to 2 )' AND 'redim .arr( 0 to 2 )' -- a target that begins
    '' with a DOT. '..' names the global scope and a single leading '.' is the enclosing
    '' one's or an open WITH's; both are ordinary lvalue expressions everywhere else, and
    '' the name reader here demanded an identifier, so the statement did not parse at all.
    ''
    '' The postfix chain must NOT run over the bounds, so the target is read at POSTFIX
    '' precedence and stopped before the '(' -- the same reason the parenthesised form
    '' below reads its group explicitly.
    if isRedim andalso (Peek( p ) = Tko.TK_DOT) then
        dim as Tko.Token dotTok0 = Cur( p )
        Advance( p )
        '' '..' NAMES THE GLOBAL SCOPE; a single '.' is the enclosing scope's or an open
        '' WITH's, which is the same node with no base at all -- exactly what the
        '' expression parser builds for each.
        dim as boolean twoDots = (Peek( p ) = Tko.TK_DOT)
        if twoDots then Advance( p )
        dim as Tko.NodeId dbase = Tko.NODE_NONE
        if twoDots then
            dbase = NewNodeAt( p, Tko.N_GLOBALSCOPE, dotTok0.loc, 0 )
        end if
        '' THE CHAIN IS BUILT BY HAND, not through the postfix parser: that one takes
        '' the '( 0 to 2 )' that follows as a CALL and swallows the bounds -- the same
        '' reason the parenthesised form below reads its group explicitly.
        dim as int32 dguard = 0
        do
            dguard += 1
            if dguard > 64 then exit do
            if (Peek( p ) <> Tko.TK_IDENT) andalso _
               (Tko.IsKeywordKind( Peek( p ) ) = false) then exit do
            dim as Tko.Token memTok = Cur( p )
            dim as Tko.InternId dnm = 0
            DeclName( p, dnm )
            dbase = MakeMemberRef_( p, dotTok0, dbase, MakeIdent( p, memTok ) )
            if Peek( p ) <> Tko.TK_DOT then exit do
            Advance( p )
        loop
        if dbase = Tko.NODE_NONE then return ErrorNode( p, Tko.TKO0406 )
        sp.b = dbase
        sp.extra = cast( uint16, Tko.KW_REDIM )
        ParseArrayBoundsInto( p, sp, t )
        '' ...AND THE 'AS' CLAUSE, which the plain form reads further down and this one
        '' left on the line: 'redim .array1(2 to 2) as integer' is namespace/redim-3.bas.
        if Accept( p, Tko.KW_AS ) then sp.a = TypeRef( p )
        dim as Tko.NodeId dn = MakeStmt( p, Tko.N_VAR_ITEM, t.loc, sp )
        if sp.c <> Tko.NODE_NONE then p.ast->OrFlags( dn, Tko.NF_ARRAY )
        return dn
    end if

    if isRedim andalso (Peek( p ) = Tko.TK_LPAREN) then
        '' The parenthesised group is read EXPLICITLY rather than through the postfix
        '' chain, which would take '(a)(0 to 1)' as a CALL of '(a)' and swallow the
        '' bounds -- the target parsed, the dimensions vanished, and the only sign was
        '' one leftover diagnostic.
        ''
        '' The target goes in 'b', the initializer slot, which a REDIM never uses --
        '' and Resolve returns immediately for a REDIM item, so nothing reads it yet.
        '' 'extra' records that it is a target rather than a value, so a later reader
        '' cannot mistake one for the other.
        Advance( p )                          '' '('
        sp.b = Expression( p )
        Expect( p, Tko.TK_RPAREN, ")" )
        sp.extra = cast( uint16, Tko.KW_REDIM )
        ParseArrayBoundsInto( p, sp, t )
        if Accept( p, Tko.KW_AS ) then sp.a = TypeRef( p )
        dim as Tko.NodeId rn = MakeStmt( p, Tko.N_VAR_ITEM, t.loc, sp )
        if sp.c <> Tko.NODE_NONE then p.ast->OrFlags( rn, Tko.NF_ARRAY )
        return rn
    end if

    dim as Tko.Token headTok = Cur( p )
    '' THE SOURCE SPELLING, CASE PRESERVED. An EXTERN variable inside an
    '' 'extern "C"' block links by exactly what was written -- measured, fbc's
    '' object holds an undefined 'CLSID_ShellLink', while the same declaration
    '' outside a block is 'MYTHING$', uppercased with a suffix. Only a procedure
    '' kept its raw spelling before this.
    sp.rawName = RawSpelling( p )
    if DeclName( p, sp.name ) = false then return ErrorNode( p, Tko.TKO0406 )

    '' 'dim UDT.i as integer' -- a qualified name defines a static member.
    ''
    '' A REDIM IS DIFFERENT: 'redim x.array( 0 to 9 )' names an array THROUGH an
    '' object, and only the LAST name was kept. Lowering then looked up 'array' in the
    '' enclosing scope -- so it declined when nothing of that name was there, and would
    '' have re-dimensioned THE WRONG ARRAY if something was. The chain is built as an
    '' expression here and put in the target slot the parenthesised form already uses,
    '' so both spellings reach lowering the same way. 202 corpus lines write it.
    dim as boolean qualified = false
    dim as Tko.NodeId qexpr = Tko.NODE_NONE
    if isRedim then qexpr = MakeIdent( p, headTok )
    '' THE QUALIFIER IS KEPT. Only the LAST component used to survive, so
    '' 'dim shared as integer T.counter' -- the DEFINITION of a static member --
    '' looked like a module-level 'counter' that nothing had declared, and the
    '' statement declined. The owner goes where a member PROCEDURE's already does.
    dim as string ownerPath = ""
    dim as boolean viaArrow = false
    do
        dim as boolean isDot = (Peek( p ) = Tko.TK_DOT)
        '' 'redim px->array( 1 to 1 )' -- THROUGH A POINTER, which this loop accepted
        '' only with a dot. The arrow ended the item, so the bounds were never read and
        '' the statement declined with no descriptor to re-dimension; five corpus lines
        '' in dim/redim.bas write it, and '(px->array)( 1 to 1 )' beside them already
        '' lowered to exactly the right call.
        ''
        '' A REDIM ONLY. Everywhere else this loop is reading a QUALIFIED DECLARED NAME
        '' -- 'dim shared as integer T.counter' -- and there is no such thing as
        '' declaring one through a pointer.
        dim as boolean isArrow = isRedim andalso (Peek( p ) = Tko.TK_ARROW)
        if (isDot orelse isArrow) = false then exit do
        dim as Tko.Token dotTok = Cur( p )
        Advance( p )
        if isArrow then
            viaArrow = true
        else
            if len( ownerPath ) > 0 then ownerPath += "."
            ownerPath += p.names->Spelling( sp.name )
        end if
        qualified = true
        dim as Tko.Token memberTok = Cur( p )
        DeclName( p, sp.name )
        if qexpr <> Tko.NODE_NONE then
            qexpr = MakeMemberRef_( p, dotTok, qexpr, MakeIdent( p, memberTok ) )
            if isArrow then
                p.ast->OrFlags( qexpr, Tko.NF_ARROW )
            end if
        end if
    loop
    '' NOT THROUGH AN ARROW. An owner name is what makes a qualified DECLARATION find
    '' the type it belongs to, and 'px' is a variable, not a type.
    if qualified andalso (viaArrow = false) then
        sp.ownerName = p.names->GetString( ownerPath )
    end if
    if isRedim andalso qualified andalso (qexpr <> Tko.NODE_NONE) then
        sp.b = qexpr
        sp.extra = cast( uint16, Tko.KW_REDIM )
    end if

    ParseArrayBoundsInto( p, sp, t )

    '' 'extern import _ctype alias "_ctype" as ushort ptr ptr' -- an ALIAS on a
    '' VARIABLE, which is how the CRT headers declare every imported one. Without it
    '' 'alias' was read where 'as' was expected, the declaration came out untyped, and
    '' ctype.bi and stdlib.bi failed on eight lines between them -- taking with them
    '' every corpus file that reaches the C runtime through either.
    ''
    '' Recorded in 'aliasName', which is where a PROCEDURE's alias already goes.
    if Accept( p, Tko.KW_ALIAS ) then
        '' StringLitText does NOT advance -- it reads the token under the cursor -- so
        '' the literal has to be stepped over here, or the 'as' that follows is never
        '' seen and the declaration comes out untyped anyway.
        dim as Tko.Token vAliasTok = Cur( p )
        sp.aliasName = StringLitText( p )
        EmptyAliasCheck( p, sp.aliasName, vAliasTok, false )
        if Peek( p ) = Tko.TK_STRING_LIT then Advance( p )
    end if

    if Accept( p, Tko.KW_AS ) then sp.a = TypeRef( p )

    '' '=' initialiser, or '=>' for a const.
    if (Peek( p ) = Tko.TK_EQ) orelse (Peek( p ) = Tko.TK_FATARROW) then
        Advance( p )
        sp.b = Expression( p )
    end if

    dim as Tko.NodeId n = MakeStmt( p, Tko.N_VAR_ITEM, t.loc, sp )
    if sp.c <> Tko.NODE_NONE then p.ast->OrFlags( n, Tko.NF_ARRAY )
    if qualified then p.ast->OrFlags( n, Tko.NF_QUALIFIED )
    return n
end function

'' 'var (a, b, c) = expr' -- the DESTRUCTURING DECLARATION.
''
'' Desugared here, into ONE 'var' with N+1 items:
''
''     var $dt<n> = expr, a = $dt<n>._1, b = $dt<n>._2, c = $dt<n>._3
''
'' -- which is a shape every later pass already handles completely. The items of one
'' 'var' are declared in order, so the temporary is typed before the names that read
'' it; each name gets its own inferred type from the element it is initialised from;
'' and a STRING element is copy-initialised by the ordinary declaration path, so it
'' owns its data and outlives the temporary. It also gets the once-only evaluation for
'' free: 'expr' appears exactly once, in the temporary's initialiser, so 'var (p, q) =
'' counted( )' calls counted once however many names are on the left.
''
'' The temporary's name carries a '$', which no source identifier can contain, so it
'' cannot collide with anything written; the counter makes nested and repeated uses --
'' two in one loop body -- distinct.
private function VarDestructure _
    ( byref p as Tko.ParserState, byref t as Tko.Token, _
      byref sp as Tko.StmtPayload, byval flags as uint16 ) as Tko.NodeId

    dim as Tko.Token lp = Cur( p )
    Advance( p )        '' '('

    dim as Tko.NodeIdVec names
    dim as Tko.NodeIdVec items
    do
        dim as Tko.InternId nm = Tko.INTERN_NONE
        if DeclName( p, nm ) = false then
            return ErrorNode( p, Tko.TKO0406 )
        end if
        names.Push( cast( uint32, nm ) )
        if Accept( p, Tko.TK_COMMA ) = false then exit do
    loop
    Expect( p, Tko.TK_RPAREN, ")" )
    '' 'var (a) = 1' is fbc's 367 as a 1-tuple type is (measured, errors/tuple-errors.bas).
    if (names.Count < 2) andalso (p.silent = false) then p.diags->Report( Tko.TKO0821, Tko.PointRange( lp.loc ) )
    '' A DESTRUCTURING DECLARATION MUST HAVE AN INITIALISER. There is nothing else
    '' for the element types to come from.
    if Accept( p, Tko.TK_EQ ) = false then
        return ErrorNode( p, Tko.TKO0401, "=" )
    end if
    dim as Tko.NodeId rhs = Expression( p )

    p.destructureSeq += 1
    dim as Tko.InternId tmpName = _
        p.names->GetString( "$dt" & str( p.destructureSeq ) )

    dim as Tko.StmtPayload tp
    tp.name = tmpName
    tp.b = rhs
    items.Push( cast( uint32, MakeStmt( p, Tko.N_VAR_ITEM, lp.loc, tp ) ) )

    for i as int32 = 0 to names.Count - 1
        dim as Tko.IdentPayload bip
        bip.name = tmpName
        p.ast->PushIdent( bip )
        dim as Tko.NodeId base_ = _
            NewNodeAt( p, Tko.N_IDENT, lp.loc, cast( uint32, p.ast->IdentPoolCount( ) - 1 ) )
        dim as Tko.IdentPayload fip
        fip.name = p.names->GetString( "_" & str( i + 1 ) )
        p.ast->PushIdent( fip )
        dim as Tko.NodeId fld = _
            NewNodeAt( p, Tko.N_IDENT, lp.loc, cast( uint32, p.ast->IdentPoolCount( ) - 1 ) )

        dim as Tko.StmtPayload ep
        ep.name = cast( Tko.InternId, names[i] )
        ep.b = MakeMemberRef_( p, lp, base_, fld )
        items.Push( cast( uint32, MakeStmt( p, Tko.N_VAR_ITEM, lp.loc, ep ) ) )
    next

    sp.first = p.ast->ChildPoolCount( )
    sp.count = items.Count
    for i as int32 = 0 to items.Count - 1
        p.ast->PushChild( items[i] )
    next
    dim as Tko.NodeId n = MakeStmt( p, Tko.N_VAR, t.loc, sp )
    p.ast->OrFlags( n, (flags or Tko.NF_DECL_WRITTEN) )
    return n
end function

'' The body of a DESTRUCTURING 'for each (k, v) in c', rewritten.
''
'' The loop itself is left alone: it binds one hidden element, '$fe<n>', exactly as the
'' ordinary form binds one name. All this does is put a 'var' in FRONT of the body that
'' declares each written name from one field of that element --
''
''     var k = $fe<n>._1, v = $fe<n>._2
''
'' -- so nothing after the parser knows the list form exists. Declaring the names
'' INSIDE the body, rather than beside the loop variable, is what gives them per-
'' ITERATION lifetime: the body's scope closes each time round, so a name holding a
'' UDT is constructed and destroyed once per element and the counts balance.
''
'' The ELEMENT is bound once and read N times, so a collection whose Value( ) is
'' expensive -- or has a side effect -- is still called once per iteration.
''
'' The ARITY is not checked here: '_3' on a two-element tuple is an ordinary missing
'' member, diagnosed where every other missing member is.
function ForEachDestructure_ _
    ( byref p as Tko.ParserState, byref t as Tko.Token, byval tmpName as Tko.InternId, _
      byref names as Tko.NodeIdVec, byval body as Tko.NodeId ) as Tko.NodeId

    if names.Count = 0 then return body
    if body = Tko.NODE_NONE then return body
    if p.ast->Kind( body ) <> Tko.N_BLOCK then return body

    dim as Tko.NodeIdVec items
    for i as int32 = 0 to names.Count - 1
        dim as Tko.IdentPayload bip
        bip.name = tmpName
        p.ast->PushIdent( bip )
        dim as Tko.NodeId base_ = _
            NewNodeAt( p, Tko.N_IDENT, t.loc, cast( uint32, p.ast->IdentPoolCount( ) - 1 ) )
        dim as Tko.IdentPayload fip
        fip.name = p.names->GetString( "_" & str( i + 1 ) )
        p.ast->PushIdent( fip )
        dim as Tko.NodeId fld = _
            NewNodeAt( p, Tko.N_IDENT, t.loc, cast( uint32, p.ast->IdentPoolCount( ) - 1 ) )

        dim as Tko.StmtPayload ep
        ep.name = cast( Tko.InternId, names[i] )
        ep.b = MakeMemberRef_( p, t, base_, fld )
        items.Push( cast( uint32, MakeStmt( p, Tko.N_VAR_ITEM, t.loc, ep ) ) )
    next

    dim as Tko.StmtPayload vp
    vp.op = cast( uint16, Tko.KW_VAR )
    vp.first = p.ast->ChildPoolCount( )
    vp.count = items.Count
    for i as int32 = 0 to items.Count - 1
        p.ast->PushChild( items[i] )
    next
    dim as Tko.NodeId decls = MakeStmt( p, Tko.N_VAR, t.loc, vp )

    '' A NEW block, rather than a splice: the children pool is append-only and the
    '' body's own run is already closed, so the declarations cannot be pushed in front
    '' of it in place. The old run is simply left unreferenced.
    dim as Tko.ListPayload ptr bl = _
        p.ast->ListOf( body )
    dim as Tko.NodeIdVec stmts
    stmts.Push( cast( uint32, decls ) )
    for i as int32 = 0 to bl->count - 1
        stmts.Push( p.ast->ChildSlot( bl->first + i ) )
    next
    return MakeList( p, Tko.N_BLOCK, t.loc, Tko.NODE_NONE, stmts )
end function

'' dim / redim / var / static / shared / common / extern, in any legal combination.
private function ParseVarDecl( byref p as Tko.ParserState ) as Tko.NodeId
    dim as Tko.Token t = Cur( p )
    dim as Tko.StmtPayload sp
    sp.op = cast( uint16, Peek( p ) )
    dim as uint16 flags = 0

    '' The leading keywords may stack: 'dim shared', 'static shared', 'redim preserve'.
    do
        dim as Tko.TokenKind k = Peek( p )
        select case k
        case Tko.KW_DIM, Tko.KW_REDIM, Tko.KW_VAR, Tko.KW_COMMON, Tko.KW_EXTERN
            Advance( p ) : if p.staticLocals andalso cbool( (k = Tko.KW_DIM) orelse (k = Tko.KW_VAR) orelse (k = Tko.KW_REDIM) ) then flags or= Tko.NF_STATIC   '' 'sub f( ) static'
        case Tko.KW_SHARED
            flags or= Tko.NF_SHARED
            Advance( p )
        case Tko.KW_STATIC
            flags or= Tko.NF_STATIC
            Advance( p )
        case Tko.KW_PRESERVE
            flags or= Tko.NF_PRESERVE
            Advance( p )
        case Tko.KW_IMPORT, Tko.KW_EXPORT
            '' 'extern import _ctype alias "_ctype" as ushort ptr ptr' -- a DLL-imported
            '' variable, which is how the CRT headers declare every one of theirs. Read
            '' as the NAME, it failed ctype.bi and stdlib.bi. IMPORT is RECORDED (T85):
            '' consumed and dropped, the variable was referenced directly, and lld-link
            '' has no '__imp_' fallback for data -- 'undefined symbol: MyDll_Data'.
            if k = Tko.KW_IMPORT then sp.extra or= Tko.VF_DLLIMPORT
            Advance( p )
        case Tko.KW_BYREF
            '' 'dim byref rb as string = a' -- a REFERENCE variable. Without this the
            '' name was read as 'byref' and the rest of the statement discarded: no
            '' type, no initializer, no 'rb', and NO DIAGNOSTIC. It only surfaced on the
            '' second occurrence, as a redeclaration of 'byref'.
            ''
            '' Measured: fbc accepts it with and without SHARED, and refuses one with no
            '' initializer (error 320, 'Reference not initialized') -- a semantic rule
            '' tiko-lang does not implement yet.
            flags or= Tko.NF_BYREF
            Advance( p )
        case else
            exit do
        end select
    loop

    '' 'dim as long a, b' -- a shared type written before the names.
    dim as Tko.NodeId sharedType = Tko.NODE_NONE
    if Accept( p, Tko.KW_AS ) then sharedType = TypeRef( p )

    '' 'var (a, b) = expr' -- DESTRUCTURING DECLARATION, which had no parse at all:
    '' the '(' was read where a name belongs and the whole statement died as
    '' 'expected an identifier'.
    if (sp.op = cast( uint16, Tko.KW_VAR )) andalso (Peek( p ) = Tko.TK_LPAREN) then
        if sharedType = Tko.NODE_NONE then return VarDestructure( p, t, sp, flags )
    end if

    dim as Tko.NodeIdVec items
    do
        dim as int32 before = p.pos
        '' 'byref' AGAIN, ON A LATER ITEM: 'dim byref r1 as integer = i, byref r2 as
        '' integer = i' is two aliases, and fbc reads the second 'byref' as a modifier
        '' exactly like the first. Only the LEADING one was consumed, by the modifier
        '' loop above, so what followed the comma began at the word 'byref' -- which
        '' DeclName happily takes as a NAME, keywords being legal identifiers in
        '' declaration position. The result was a variable called 'byref' aliasing
        '' nothing and NO r2 at all, with no diagnostic: every later use of r2 was an
        '' unbound name. Recorded on the ITEM, because 'byref' now varies between
        '' items of one declaration.
        dim as boolean itemByref = false
        if Peek( p ) = Tko.KW_BYREF then
            Advance( p )
            itemByref = true
        end if
        dim as Tko.NodeId item = VarItem( p, sp.op = cast( uint16, Tko.KW_REDIM ) )
        if itemByref then p.ast->OrFlags( item, Tko.NF_BYREF )
        items.Push( cast( uint32, item ) )
        '' The item may be an ERROR node, which has no StmtPayload -- indexing its
        '' 'data' as one is a segfault. Error nodes must be checked for, never
        '' assumed away (docs/plan/05 invariant 5).
        dim as boolean isItem = (p.ast->Kind( item ) = Tko.N_VAR_ITEM)
        if isItem andalso (sharedType <> Tko.NODE_NONE) then
            dim as int32 si = cast( int32, p.ast->DataOf( item ) )
            if p.ast->StmtAt( si )->a = Tko.NODE_NONE then p.ast->StmtAt( si )->a = sharedType
        end if
        if isItem = false then exit do
        '' 'var p( ) = f( )' -- A TIKO EXTENSION: the array result moved in, as 'var p = f( )'.
        '' Read as that, and marked KW_VAR so Check keeps TKO0612 for any other initialiser.
        if (sp.op = cast( uint16, Tko.KW_VAR )) andalso ((p.ast->Flags( item ) and Tko.NF_ARRAY) <> 0) then
            dim as Tko.StmtPayload ptr vip = p.ast->StmtOf( item )
            dim as boolean emptyDims = (vip->b <> Tko.NODE_NONE) andalso (vip->c <> Tko.NODE_NONE)
            if emptyDims then emptyDims = (p.ast->Kind( vip->c ) = Tko.N_BLOCK)
            if emptyDims then emptyDims = (p.ast->ListOf( vip->c )->count = 0) andalso (p.ast->Kind( vip->b ) <> Tko.N_INITIALIZER)
            if emptyDims then
                vip->c = Tko.NODE_NONE : vip->extra = cast( uint16, Tko.KW_VAR )
                p.ast->NodeAt( item )->flags and= not Tko.NF_ARRAY
            end if
        end if
        if p.pos = before then exit do
        if Accept( p, Tko.TK_COMMA ) = false then exit do
    loop

    sp.first = p.ast->ChildPoolCount( )
    sp.count = items.Count
    for i as int32 = 0 to items.Count - 1
        p.ast->PushChild( items[i] )
    next

    dim as Tko.NodeId n = MakeStmt( p, Tko.N_VAR, t.loc, sp )
    p.ast->OrFlags( n, (flags or Tko.NF_DECL_WRITTEN) )
    return n
end function

#include once "parser/declconst.tiko"

private function ParseConstDecl( byref p as Tko.ParserState ) as Tko.NodeId
    dim as Tko.Token t = Cur( p )
    Advance( p )
    dim as Tko.StmtPayload sp
    dim as Tko.NodeIdVec items

    '' 'const as ulongint u = 1' -- the TYPE-FIRST form, which DIM has always had and
    '' CONST did not. Without it 'as' was read as the constant's NAME and everything
    '' after it discarded: no type, no value, no 'u', and NO DIAGNOSTIC. It surfaced
    '' only on the second such declaration, as a redeclaration of 'as' -- twenty corpus
    '' files, the largest single line-shape in the largest remaining bucket.
    ''
    '' Measured: fbc accepts 'const as ubyte a = 1, b = 2' too, so the type is shared
    '' across a comma list exactly as it is for DIM.
    dim as Tko.NodeId sharedType = Tko.NODE_NONE
    if Accept( p, Tko.KW_AS ) then sharedType = TypeRef( p )

    do
        dim as Tko.NodeId item = VarItem( p, false )
        items.Push( cast( uint32, item ) )
        '' TOLD TO THE PREPROCESSOR AS EACH ONE IS READ, not at the end: 'const a =
        '' 1, b = a' names the first from the second, and the module-level guard is
        '' the one NoteDeclaredName_ uses -- a field or a local is not something an
        '' '#if' above it can see.
        if (p.aggDepth = 0) andalso (p.stream <> nullptr) then   '' a local too, undone at 'end sub'
            if p.ast->Kind( item ) = Tko.N_VAR_ITEM then
                dim as int32 csi = cast( int32, p.ast->DataOf( item ) )
                dim as int64 cval = 0
                if ConstFoldsToInt_( p, p.ast->StmtAt( csi )->b, cval ) then
                    Tko.PpNoteConst( *cast( Tko.PpStream ptr, p.stream ), _
                                     p.ast->StmtAt( csi )->name, cval, p.ast->Loc( item ), cbool( p.procDepth <> 0 ) )
                else
                    NoteConstStr_( p, p.ast->StmtAt( csi )->name, p.ast->StmtAt( csi )->b )   '' declconst.tiko
                end if
            end if
        end if
        '' An ERROR node has no StmtPayload; indexing its 'data' as one is a segfault.
        if p.ast->Kind( item ) <> Tko.N_VAR_ITEM then exit do
        if sharedType <> Tko.NODE_NONE then
            dim as int32 si = cast( int32, p.ast->DataOf( item ) )
            if p.ast->StmtAt( si )->a = Tko.NODE_NONE then p.ast->StmtAt( si )->a = sharedType
        end if
        if Accept( p, Tko.TK_COMMA ) = false then exit do
    loop
    sp.first = p.ast->ChildPoolCount( )
    sp.count = items.Count
    for i as int32 = 0 to items.Count - 1
        p.ast->PushChild( items[i] )
    next
    return MakeStmt( p, Tko.N_CONST, t.loc, sp )
end function

#include once "parser/declparam.tiko"

private function ParseProc _
    ( byref p as Tko.ParserState, byval declareOnly as boolean ) as Tko.NodeId

    dim as Tko.Token t = Cur( p )
    dim as int32 procTok0 = p.pos
    dim as Tko.StmtPayload sp

    '' 'const function T.F( )' and 'static sub T.S( )' put the modifier BEFORE the
    '' procedure keyword. Const-ness is not cosmetic: it is what makes the mangled
    '' name _ZNK... rather than _ZN..., so a procedure that loses it links wrong.
    dim as Tko.Token vaTok = Cur( p )
    dim as boolean sawVA = false
    do
        dim as Tko.TokenKind mk = Peek( p )
        select case mk
        case Tko.KW_CONST    : sp.extra or= Tko.PF_CONST
        case Tko.KW_STATIC   : sp.extra or= Tko.PF_STATIC
        case Tko.KW_ABSTRACT : sp.extra or= Tko.PF_ABSTRACT
        case Tko.KW_VIRTUAL  : sp.extra or= Tko.PF_VIRTUAL
        case else            : exit do
        end select
        if (mk = Tko.KW_ABSTRACT) orelse (mk = Tko.KW_VIRTUAL) then
            if sawVA = false then vaTok = Cur( p )
            sawVA = true
        end if
        Advance( p )
        '' 'virtual' AND 'abstract' COME LAST. MEASURED: 'const virtual sub' is accepted
        '' while 'virtual const', 'virtual static', 'static virtual' and 'virtual
        '' abstract' are all fbc's error 17 -- so once one of the two has been read, the
        '' only thing that may follow is the procedure keyword itself.
        if sawVA then
            select case Peek( p )
            case Tko.KW_SUB, Tko.KW_FUNCTION, Tko.KW_PROPERTY, Tko.KW_OPERATOR, _
                 Tko.KW_CONSTRUCTOR, Tko.KW_DESTRUCTOR
            case else
                p.diags->Report( Tko.TKO0678, Tko.PointRange( Cur( p ).loc ) ) : p.silent = true   '' its one error
                exit do
            end select
        end if
    loop

    dim as Tko.TokenKind kw = DeclareProcKeyword_( p, declareOnly )   '' declparam.tiko: a stray word is T38's
    if sawVA then
        '' STATIC AND VIRTUAL DO NOT COMBINE, IN EITHER ORDER. 'virtual static' is caught
        '' by the run test above; 'static virtual' reads cleanly and is fbc's error 17
        '' just the same -- a static member has no THIS and so no vtable to dispatch on.
        if (sp.extra and Tko.PF_STATIC) <> 0 then
            p.diags->Report( Tko.TKO0678, Tko.PointRange( vaTok.loc ) )
        end if

        '' A VTABLE SLOT BELONGS TO A TYPE, and the check that it does is DEFERRED to
        '' after the name is read -- see vaNeedsOwner below. 'virtual sub VBase.vs( )' is
        '' a member's DEFINITION written outside the type and is accepted by fbc; only a
        '' name with no owner at all is error 17.
        ''
        '' fbc's error 219 for 'virtual' on a definition whose DECLARATION was not
        '' virtual is deliberately not modelled: it is a question about the declaration,
        '' not about this syntax, and reading it as one refused two of this suite's own
        '' tests -- both of which fbc compiles without a word.

        '' A CONSTRUCTOR CANNOT BE EITHER -- errors 210 and 211: the vptr the lookup
        '' needs is what the constructor itself initialises. A DESTRUCTOR may be VIRTUAL,
        '' which is the ordinary way to delete through a base pointer, but not ABSTRACT
        '' (error 212): it always has a body to run.
        if kw = Tko.KW_CONSTRUCTOR then
            p.diags->Report( Tko.TKO0681, Tko.PointRange( vaTok.loc ) )
        elseif (kw = Tko.KW_DESTRUCTOR) andalso _
               ((sp.extra and Tko.PF_ABSTRACT) <> 0) then
            p.diags->Report( Tko.TKO0681, Tko.PointRange( vaTok.loc ) )
        end if
    end if
    sp.op = cast( uint16, kw )
    Advance( p )

    '' A CALLING CONVENTION SITS WHERE A CONSTRUCTOR'S NAME WOULD BE, and a
    '' constructor has no name. 'declare constructor __thiscall ( )' is legal --
    '' so are cdecl, stdcall and pascal, all four measured against fbc -- and the
    '' name reader below accepts ANY keyword, so it took '__thiscall' as the name
    '' and then as the OWNER: '__thiscall does not name a type here'. Eight corpus
    '' files, and the file is lost from that line on.
    ''
    '' The convention is RECORDED here rather than merely eaten, because the loop
    '' that normally records it runs AFTER the name -- which is where a SUB's
    '' convention sits ('sub foo cdecl ( )') and where a structor's cannot.
    '' ...AND SO DOES ALIAS, in the same place and for the same reason:
    '' 'declare constructor cdecl alias "init"( )' is what structs/ctor_alias.bas
    '' writes, and 'alias' was read as the owning type's name.
    if (kw = Tko.KW_CONSTRUCTOR) orelse (kw = Tko.KW_DESTRUCTOR) then
        while TakeProcPrefix_( p, sp, true )
        wend
    end if

    '' The name may be qualified ('Stack.Push') or absent (constructors).
    dim as boolean qualified = false
    if (Peek( p ) = Tko.TK_IDENT) orelse Tko.IsKeywordKind( Peek( p ) ) then
        sp.rawName = RawSpelling( p )
        DeclName( p, sp.name )
        while Peek( p ) = Tko.TK_DOT
            Advance( p )
            qualified = true
            '' THE WHOLE PATH, dotted, in the one field -- the same shape a qualified
            '' TYPE REFERENCE keeps. Overwriting per component kept only the LAST TWO,
            '' so 'constructor ctor.nested.UDT2( )' arrived with owner 'nested' and no
            '' way to reach it: 'this' stayed untyped AND the procedure mangled as
            '' plain 'UDT2', which links wrong rather than merely typing wrong.
            if sp.ownerName = 0 then
                sp.ownerName = sp.name
            else
                sp.ownerName = p.names->GetString( _
                    p.names->Spelling( sp.ownerName ) & "." & _
                    p.names->Spelling( sp.name ) )
            end if
            sp.rawName = RawSpelling( p )
            DeclName( p, sp.name )
        wend
    else
        ProcNameMissing_( p, kw )
    end if

    '' An operator's name can be a token rather than a word: 'operator +'.
    ''
    '' IT WAS SKIPPED, NOT RECORDED. 'private operator = ( byref a as D, byref b as D )
    '' as boolean' reached Collect with NO NAME AT ALL, so nothing was declared for it,
    '' Resolve set no return type, and the body's 'operator = ( ... )' result assignment
    '' declined for want of a result slot -- while the function itself went out under an
    '' EMPTY mangled name. Every comparison operator in the runtime headers is spelled
    '' this way; fb/decimal.bi alone has six.
    ''
    '' The spelling comes from the token table's TEXT column -- '=' -- rather than from
    '' the source, because RawSpelling only reads identifiers and these are punctuation.
    if kw = Tko.KW_OPERATOR then ReadOperatorName( p, sp )

    '' FBC-Modern generics: 'type Box( of T )' and 'function Max( of T )( ... )'.
    if Peek( p ) = Tko.TK_LPAREN then
        dim as int32 save = p.pos
        Advance( p )
        dim as boolean isGeneric = false
        if Peek( p ) = Tko.TK_IDENT then
            isGeneric = (p.names->Spelling( cast( Tko.InternId, Cur( p ).literal ) ) = "of")
        end if
        if isGeneric then
            '' THE PARAMETER NAMES ARE KEPT, in 'c' -- the same field N_TYPE uses in 'b'
            '' for exactly this. They used to be skipped, and with them went any chance
            '' of instantiating the procedure: its body lowered with every 'as T'
            '' standing for nothing, and produced a function under a name no call site
            '' would ever use. See PF_GENERIC_PROC.
            Advance( p )                  '' past 'of'
            sp.c = ParseTypeParams( p )
            sp.extra or= Tko.PF_GENERIC_PROC
        else
            p.pos = save
        end if
    end if

    '' The qualification can follow the generic arguments:
    '' 'sub SetIterator( of T ).MoveNext( )'. Check again after them.
    ''
    '' AND IT MUST RECORD THE OWNER, exactly as the loop above does. Without that
    '' line 'sub Array( of T ).Push( )' had no ownerName, so Collect opened the body's
    '' scope under the MODULE instead of under the type, BindThis found no enclosing
    '' SCOPEK_TYPE, and 'this' stayed untyped -- every 'this.Reserve( ... )' inside a
    '' generic method was an unlowered call with an untyped base. Two of them per file
    '' for anything that merely includes fb/array.bi.
    while Peek( p ) = Tko.TK_DOT
        Advance( p )
        qualified = true
        if sp.ownerName = 0 then
            sp.ownerName = sp.name
        else
            sp.ownerName = p.names->GetString( _
                p.names->Spelling( sp.ownerName ) & "." & _
                p.names->Spelling( sp.name ) )
        end if
        sp.rawName = RawSpelling( p )
        DeclName( p, sp.name )
    wend
    '' ...and the member after that qualifier may be an OPERATOR's punctuation, which
    '' DeclName cannot read: 'operator Array( of T ).[]'.
    if kw = Tko.KW_OPERATOR then ReadOperatorName( p, sp )

    '' 'sub F cdecl( ... )' and 'declare sub F stdcall alias "g" ( ... )' put the
    '' calling convention and the ALIAS between the name and the parameter list.
    '' Leaving them unconsumed meant ParseParamList saw no '(' and the trailing-
    '' modifier loop below silently ate the ENTIRE parameter list -- so every
    '' parameter of every cdecl procedure in every header went undeclared.
    '' OVERLOAD must precede ALIAS -- fbc rejects the other order.
    do
        dim as boolean ate = false
        '' The convention is RECORDED, not merely eaten. It decides the emitted name on
        '' win32 -- '_H@4' for stdcall against '_G' for cdecl -- and it is checked
        '' against the DECLARE prototype, which fbc refuses to contradict.
        while TakeProcPrefix_( p, sp )
            ate = true
        wend
        if Accept( p, Tko.KW_OVERLOAD ) then
            '' OVERLOAD alone forces mangling, even when nothing else shares the
            '' name: fbc mangles on the KEYWORD, not on there being a second one.
            sp.extra or= Tko.PF_OVERLOAD
            ate = true
        end if
        if Accept( p, Tko.KW_ALIAS ) then
            '' The alias replaces the IDENTIFIER and keeps its case, but the name is
            '' still mangled around it: 'sub F overload alias "lower_case"' is
            '' _Z10lower_casei, not 'lower_case'.
            ''
            '' AN EMPTY ONE IS AN ERROR -- fbc's 304, "ALIAS name string is empty". It
            '' would mangle to a name with nothing in it, and five corpus files write it.
            if Peek( p ) = Tko.TK_STRING_LIT then
                dim as Tko.Token aliasTok = Cur( p )
                sp.aliasName = StringLitText( p )
                EmptyAliasCheck( p, sp.aliasName, aliasTok, false )
                Advance( p )
            end if
            ate = true
        end if
        if Accept( p, Tko.KW_LIB ) then
            sp.extra or= Tko.PF_LIB
            '' ...AND AN EMPTY LIB NAME IS fbc's 305, the same mistake one keyword over.
            if Peek( p ) = Tko.TK_STRING_LIT then
                dim as Tko.Token libTok = Cur( p )
                dim as Tko.InternId lbn = StringLitText( p )
                EmptyAliasCheck( p, lbn, libTok, true )
                '' THE NAME IS KEPT. It was read and discarded, so the clause asked
                '' for a library and nothing linked one -- see ParserState.declLibs.
                if lbn <> 0 then p.declLibs.Push( cast( uint32, lbn ) )
                Advance( p )
            elseif Peek( p ) = Tko.TK_IDENT then
                Advance( p )    '' 'lib SYS' names a '#foreignlib' binding, linked by name
            end if
            ate = true
        end if
        if ate = false then exit do
    loop

    ProcParams_( p, sp, kw, declareOnly )

    '' 'function F( ) BYREF as T' -- A BYREF RESULT. The BYREF sits between the
    '' parameter list and the AS, so Accept( KW_AS ) failed on it and the trailing-
    '' modifier loop below ate the whole return type: EVERY byref-returning function in
    '' the corpus reached Collect with NO RESULT TYPE AT ALL, which is most of
    '' fb/result.bi, fb/optional.bi and every conversion operator declared that way.
    '' Nothing said so -- an untyped result is not a diagnostic.
    dim as boolean byrefRet = ByrefResult_( p )
    '' A SUB HAS NO RESULT: fbc's 17. tiko kept the type and compiled 'return 5' as a bare RETURN
    '' (sys/win's Combo.GetEditSel, FINDINGS 5.14). The type is still read, and dropped.
    dim as Tko.Token subAs = Cur( p )
    if Accept( p, Tko.KW_AS ) then sp.a = ResultTypeRef_( p, sp )
    if (kw = Tko.KW_SUB) andalso (sp.a <> Tko.NODE_NONE) then p.diags->Report( Tko.TKO0598, Tko.PointRange( subAs.loc ) ) : sp.a = Tko.NODE_NONE
    CheckPropertyShape_( p, sp, kw, t.loc )

    '' Trailing modifiers: static, const, export, alias "x", lib "y", cdecl ...
    ''
    '' 'override' IS KEPT. It is a promise that this declaration replaces an inherited
    '' virtual, and fbc checks it -- error 223, "Not overriding any virtual method". The
    '' loop consumed it with everything else, so a broken promise said nothing.
    dim as int32 structPrio = 0
    while (Peek( p ) <> Tko.TK_EOL) andalso (AtEnd( p ) = false)
        if Peek( p ) = Tko.KW_IMPLEMENTS then ProcImplementsClause( p, declareOnly, procTok0 ) : continue while   '' declclass.tiko
        '' Spelled out rather than through IsContextual, which is defined AFTER this
        '' file in parser.tiko: 'override' is not a reserved word, so it arrives as an
        '' identifier and is recognised by its interned spelling.
        if Peek( p ) = Tko.TK_IDENT then
            dim as Tko.InternId onm = cast( Tko.InternId, Cur( p ).literal )
            HeaderIdent_( p, sp, onm )   '' 'override', or junk -- parserend.tiko
        end if
        '' 'BYREF' IS NOT A TRAILING MODIFIER. A byref result is spelled
        '' 'function f( ) BYREF as T' -- the keyword sits between the parameter list and
        '' the AS -- and 'function f( ) as T byref' is fbc error 3, "Expected
        '' End-of-Line". Swallowed with the rest, the wrong spelling compiled clean.
        if Peek( p ) = Tko.KW_BYREF then
            p.diags->Report( Tko.TKO0639, Tko.PointRange( Cur( p ).loc ) )
        end if
        '' A TRAILING 'constructor' OR 'destructor' MAKES A MODULE CONSTRUCTOR, and only
        '' a module-level DEFINITION or a static member may be one. Measured: on a
        '' DECLARE it is fbc's error 3, on a non-static METHOD definition error 17,
        '' while 'sub f( ) constructor' and a static member proc are accepted. The loop
        '' swallowed the word with everything else, so both wrong shapes compiled --
        '' eight corpus files.
        '' A QUALIFIED DEFINITION IS DECLINED HERE. Whether the method is STATIC is
        '' settled by its DECLARATION inside the type, which this parser has not got:
        '' functions/module-ctor-staticmemberproc.bas writes 'declare static sub ctor2( )'
        '' and then 'sub UDT.ctor2( ) constructor' with no STATIC repeated, and fbc
        '' accepts it. Reading the definition's own modifiers refused that file. The
        '' DECLARE half below is syntactic and stays; the member half is owed from the
        '' checker, which has both nodes.
        '' EXPORT IS RECORDED, and was not: the loop listed it among the modifiers it
        '' handles and did nothing with it. So is a trailing STATIC -- PF_STATIC_LOCALS.
        if Peek( p ) = Tko.KW_EXPORT then sp.extra or= Tko.PF_EXPORT
        if Peek( p ) = Tko.KW_STATIC then sp.extra or= Tko.PF_STATIC_LOCALS
        if (Peek( p ) = Tko.KW_CONSTRUCTOR) orelse (Peek( p ) = Tko.KW_DESTRUCTOR) then
            dim as boolean modBad = declareOnly
            if modBad then
                p.diags->Report( Tko.TKO0701, Tko.PointRange( Cur( p ).loc ) )
            else
                '' RECORDED, not just validated. This loop used to check the word and
                '' then Advance past it, so the attribute reached nothing downstream
                '' and the procedure was emitted as an ordinary one that the runtime
                '' never called -- which is why fbcunit registered zero suites.
                if Peek( p ) = Tko.KW_CONSTRUCTOR then
                    sp.extra or= Tko.PF_MODCTOR
                else
                    sp.extra or= Tko.PF_MODDTOR
                end if
                '' ...AND ITS PRIORITY, 'constructor 101', which was swallowed with
                '' the rest. fbc runs lower priorities first and all of them before
                '' the unnumbered ones; a hex literal counts, a constant name is its
                '' error 3. Recorded on the node below, once it exists.
                if HasTok( p, p.pos + 1 ) then
                    if cast( Tko.TokenKind, p.toks->At( p.pos + 1 ).kind ) = Tko.TK_INT_LIT then
                        Advance( p )
                        dim as int64 prio = -1
                        dim as int32 pli = cast( int32, Cur( p ).literal )
                        if pli < p.litPool->Count then prio = (*p.litPool)[pli].intValue
                        if (prio < 101) orelse (prio > 65535) then
                            p.diags->Report( Tko.TKO0422, Tko.PointRange( Cur( p ).loc ) )
                        else
                            structPrio = cast( int32, prio )
                        end if
                    end if
                end if
            end if
        end if
        Advance( p )
    wend

    '' 'operator []' IS NEVER STATIC AND ALWAYS RETURNS SOMETHING. Measured: 'declare
    '' static operator []( ... )' is fbc's error 232 and 'declare operator []( ... )' with
    '' no result type its error 68. Two corpus files each.
    if kw = Tko.KW_OPERATOR then
        if p.names->Spelling( sp.name ) = "[]" then
            if (sp.extra and Tko.PF_STATIC) <> 0 then
                p.diags->Report( Tko.TKO0703, Tko.PointRange( t.loc ) )
            elseif sp.a = Tko.NODE_NONE then
                p.diags->Report( Tko.TKO0704, Tko.PointRange( t.loc ) )
            end if
        end if
    end if

    '' THE DEFERRED VIRTUAL/ABSTRACT OWNER TEST -- see the modifier loop above.
    '' A STRUCTOR NAMES ITS TYPE IN 'name', not through a dotted path, so 'qualified' is
    '' false for one even though it plainly has an owner. 'virtual destructor Shape( )'
    '' written outside the type is the ordinary way to define a virtual destructor, and
    '' generics/container-sharedptr.bas -- which fbc compiles -- writes exactly that.
    dim as boolean vaStructor = (kw = Tko.KW_CONSTRUCTOR) orelse (kw = Tko.KW_DESTRUCTOR)
    dim as boolean vaAtModule = (p.aggDepth = 0)
    dim as boolean vaNoOwner = _
        vaAtModule andalso (qualified = false) andalso (vaStructor = false)
    if sawVA andalso vaNoOwner then
        p.diags->Report( Tko.TKO0679, Tko.PointRange( vaTok.loc ) )
    end if
    '' CONST AND STATIC NEED AN OWNER TOO -- fbc's errors 259 and 258, "CONST/STATIC used
    '' on non-member procedure". Both describe THIS: a free procedure has none. The same
    '' owner test the virtual one uses, and for the same reason.
    '' 'operator new' AND 'operator delete' ARE IMPLICITLY STATIC, so there is no THIS
    '' for CONST to describe -- fbc's error 234. Measured over all four spellings; an
    '' ordinary 'declare const sub m( )' beside them is the legal case.
    if (kw = Tko.KW_OPERATOR) andalso ((sp.extra and Tko.PF_CONST) <> 0) then
        dim as string opnm = Tko.Text.LowerAscii( p.names->Spelling( sp.name ) )
        if (opnm = "new") orelse (opnm = "delete") orelse _
           (opnm = "new[]") orelse (opnm = "delete[]") then
            p.diags->Report( Tko.TKO0684, Tko.PointRange( t.loc ) )
        end if
    end if
    '' ...AND NEITHER HAS A CONSTRUCTOR OR DESTRUCTOR -- fbc's errors 314 and 315, "CONST
    '' used on constructor (not needed)", for 'declare const constructor( )' inside the
    '' type and for 'const constructor UDT( )' defining it. Four corpus files.
    if ((kw = Tko.KW_CONSTRUCTOR) orelse (kw = Tko.KW_DESTRUCTOR)) andalso _
       ((sp.extra and Tko.PF_CONST) <> 0) then
        p.diags->Report( Tko.TKO0734, Tko.PointRange( t.loc ) )
    end if
    if vaNoOwner then
        if (sp.extra and Tko.PF_CONST) <> 0 then
            p.diags->Report( Tko.TKO0682, Tko.PointRange( t.loc ) )
        end if
        if (sp.extra and Tko.PF_STATIC) <> 0 then
            p.diags->Report( Tko.TKO0683, Tko.PointRange( t.loc ) )
        end if
    end if
    '' KNOWN FROM HERE ON, so a later 'name :' is a call and not a label -- fbc's rule,
    '' see IsLabelHere_. A METHOD is a bare name only inside a member body, where it
    '' is 'this.name': 'b : print' in 'sub T.a' calls T.b, and was a label named b.
    dim as boolean isMember = qualified orelse (p.aggDepth > 0)
    if isMember then
        p.memberProcNames.Push( cast( uint32, sp.name ) )
    else
        p.procNames.Push( cast( uint32, sp.name ) )
    end if
    if declareOnly then
        dim as Tko.NodeId dn = MakeStmt( p, Tko.N_PROC, t.loc, sp )
        if qualified then p.ast->OrFlags( dn, Tko.NF_QUALIFIED )
        if byrefRet then p.ast->OrFlags( dn, Tko.NF_BYREF )
        TakeProcImplements( p, dn, procTok0 )
        return dn
    end if

    dim as boolean inGeneric = ((sp.extra and Tko.PF_GENERIC_PROC) <> 0)
    if inGeneric then
        p.genericDepth += 1
        p.genericParams.Push( cast( uint32, sp.c ) )
    end if
    '' See ParserState.procDepth: nothing declared inside a body is told to the
    '' preprocessor, because fbc's 'defined' stops seeing it when the body ends.
    p.procDepth += 1 : dim as boolean outerSL = p.staticLocals : p.staticLocals = ((sp.extra and Tko.PF_STATIC_LOCALS) <> 0) : if p.stream <> nullptr then Tko.PpProcEnter( *cast( Tko.PpStream ptr, p.stream ) )
    if isMember then p.memberDepth += 1
    sp.b = Block( p )
    if isMember then p.memberDepth -= 1
    p.procDepth -= 1 : p.staticLocals = outerSL : if p.stream <> nullptr then Tko.PpProcLeave( *cast( Tko.PpStream ptr, p.stream ) )
    if inGeneric then
        p.genericDepth -= 1
        p.genericParams.Pop( )
    end if
    ExpectEnd( p, kw )
    dim as Tko.NodeId pn = MakeStmt( p, Tko.N_PROC, t.loc, sp )
    p.ast->RecordProcEnd( pn, p.toks->At( p.pos - 1 ).loc )   '' the body's last line
    if structPrio > 0 then
        p.ast->structorPrio.Push( cast( uint32, pn ) )
        p.ast->structorPrio.Push( cast( uint32, structPrio ) )
    end if
    if qualified then p.ast->OrFlags( pn, Tko.NF_QUALIFIED )
    if byrefRet then p.ast->OrFlags( pn, Tko.NF_BYREF )
    '' A QUALIFIED DEFINITION -- 'function Box.Get( ) as T' -- may belong to a generic,
    '' and a GENERIC PROCEDURE is one in its own right. Either way instantiating it has
    '' to parse this body again to get nodes of its own. Nothing else is recorded: an
    '' ordinary procedure is never re-parsed and the table is scanned linearly.
    dim as boolean genProc = ((sp.extra and Tko.PF_GENERIC_PROC) <> 0)
    if qualified orelse genProc then p.ast->RecordTokens( pn, procTok0, p.pos )
    return pn
end function

#include once "parser/lambda.tiko"
#include once "parser/declvis.tiko"


#include once "parser/declfield.tiko"
#include once "parser/declempty.tiko"

'' The member list of a TYPE or UNION, its 'end', and the node. Shared by the named
'' and the ANONYMOUS forms, which differ only in whether a name was read.
private function ParseAggregateBody _
    ( byref p as Tko.ParserState, byref t as Tko.Token, _
      byref sp as Tko.StmtPayload, byval isUnion as boolean ) as Tko.NodeId

    p.aggDepth += 1
    dim as Tko.NodeIdVec members

    '' 'EXTENDS T' IS A FIELD, not a flag. fbc embeds the base as the first member --
    ''
    ''     struct $1A { struct $10fb_Object$ BASE$; int32 F1; };
    ''
    '' -- at offset 0, before everything declared here, and every consequence of
    '' inheritance follows from that one fact: the layout is right without a special
    '' case, an upcast is the identity on the address, and the vptr of a type that
    '' extends 'object' lands at offset 0 because 'object' puts it there.
    ''
    '' The name is 'base', which no user field can collide with -- BASE is a keyword, so
    '' the lexer never produces it as an identifier.
    ''
    '' The typeref is still on the TYPE node as well, because a later pass wanting the
    '' base type should not have to recognise a field by its name.
    '' A CLASS's base, and any type's 'implements' lines, are body lines read first.
    dim as Tko.NodeId implList = AggPrologue( p, t, sp )   '' declclass.tiko
    if sp.c <> Tko.NODE_NONE then
        dim as Tko.StmtPayload bp
        bp.name = p.names->GetString( "base" )
        bp.a = sp.c
        members.Push( cast( uint32, MakeStmt( p, Tko.N_FIELD, t.loc, bp ) ) )
    end if

    '' The access section in force. Measured against fbc rather than assumed:
    ''
    ''   default             PUBLIC
    ''   private:            own members yes, DERIVED no, outside no
    ''   protected:          own members yes, derived YES, outside no
    ''   in a UNION          a syntax error, not a label -- which symmetry would
    ''                       have got wrong, so the label is only read for a TYPE
    ''
    '' A label reaches into a nested anonymous union too, which falls out of keeping
    '' one variable across the whole member loop.
    dim as uint16 vis = 0

    do
        SkipEols( p )
        if AtEnd( p ) then exit do
        '' 'end' CLOSES THE BODY ONLY WHEN 'type', 'union' OR 'enum' FOLLOWS IT. A
        '' FIELD may be called 'end' -- fbc builds 'struct $1P { int64 END; int64 V; };'
        '' for 'end as integer' and prints ' 5  1' -- and the unconditional test closed
        '' the TYPE at that field, so everything after it was read as module-level code
        '' and the whole file desynced. The 'as integer end' spelling worked, which is
        '' what made it look like something other than a member name.
        if Peek( p ) = Tko.KW_END then
            dim as boolean endsBody = true
            if HasTok( p, p.pos + 1 ) then
                select case cast( Tko.TokenKind, p.toks->At( p.pos + 1 ).kind )
                case Tko.KW_TYPE, Tko.KW_UNION, Tko.KW_ENUM, Tko.KW_CLASS, Tko.TK_EOL
                case else
                    endsBody = false
                end select
            end if
            if endsBody then exit do
        end if

        '' AN '#undef' THE PREPROCESSOR PASSED THROUGH is not a member. What it removes
        '' is not a member either, so it is skipped here rather than applied.
        if Peek( p ) = Tko.TK_HASH then
            while (Peek( p ) <> Tko.TK_EOL) andalso (AtEnd( p ) = false)
                Advance( p )
            wend
            continue do
        end if
        if LateBodyLine( p, sp ) then continue do   '' 'implements'/'inherits' after a member

        dim as int32 before = p.pos
        dim as Tko.TokenKind k = Peek( p )

        '' 'private:' and friends. The colon is what tells a LABEL from the PRIVATE
        '' that modifies a procedure, so both tokens are required before either is
        '' consumed -- and 4 corpus files reach the keyword through a macro parameter,
        '' which is why this tests the token and not the source text.
        dim as boolean isVisKw = (k = Tko.KW_PRIVATE) orelse _
                                 (k = Tko.KW_PUBLIC) orelse (k = Tko.KW_PROTECTED)
        if (isUnion = false) andalso isVisKw then
            '' There is no TK_COLON to look for: the lexer turns a ':' statement
            '' separator into a TK_EOL and marks it TF_COLON, because ':' separates
            '' statements exactly as a newline does. So the label is a visibility
            '' keyword followed by an EOL THAT CAME FROM A COLON, and a bare
            '' 'private' on its own line is not one -- fbc says so too, error 203.
            dim as boolean labelled = false
            if HasTok( p, p.pos + 1 ) then
                dim as Tko.Token nx = p.toks->At( p.pos + 1 )
                labelled = (cast( Tko.TokenKind, nx.kind ) = Tko.TK_EOL) andalso _
                           ((nx.flags and Tko.TF_COLON) <> 0)
            end if
            if labelled then
                select case as const k
                case Tko.KW_PRIVATE   : vis = Tko.PF_MEMB_PRIVATE
                case Tko.KW_PROTECTED : vis = Tko.PF_MEMB_PROTECTED
                case else             : vis = 0
                end select
                Advance( p )
                Advance( p )
                continue do
            end if
        end if

        '' 'dim' INSIDE A TYPE DECLARES FIELDS, and nothing else. It went to the
        '' DECLARATION parser instead, which built an N_VAR that the layout pass -- which
        '' reads N_FIELD and only N_FIELD -- never saw: 'type C : dim as integer i, j :
        '' end type' came out with NO FIELDS AT ALL and a size of 1 where fbc says 16.
        '' Every field after such a type sat on top of it, and structs/udt-init-1.bas and
        '' -2.bas declare every member that way.
        ''
        '' Measured over what a TYPE body accepts: 'dim as T x' and 'dim x as T' are
        '' fields, 'dim as T x(0 to 2)' is an array field, 'dim shared' is error 3, and
        '' STATIC and CONST declare no field at all -- a type holding only those is
        '' fbc error 256, "cannot be empty". So only DIM is swallowed here; the other two
        '' keep going to the declaration parser, which is where a static member belongs.
        '' ...AND SO DOES 'redim a( 2 to 6 ) as integer' -- a DYNAMIC array field, sized when the
        '' object is constructed (measured, fbc-int/array.bas). It went to the declaration
        '' parser and became a VARIABLE of the type's scope: no field, no storage.
        dim as boolean redimFld = (k = Tko.KW_REDIM)
        if redimFld andalso HasTok( p, p.pos + 3 ) andalso cbool( cast( Tko.TokenKind, p.toks->At( p.pos + 2 ).kind ) = Tko.TK_LPAREN ) andalso cbool( cast( Tko.TokenKind, p.toks->At( p.pos + 3 ).kind ) = Tko.TK_RPAREN ) then p.diags->Report( Tko.TKO0766, Tko.PointRange( Cur( p ).loc ) )   '' 'redim f( )': fbc's 9
        if (k = Tko.KW_DIM) orelse redimFld then
            Advance( p )
            k = Peek( p )
        end if

        if k = Tko.KW_AS then
            '' 'as long x, y' -- the type comes first and is shared by the names.
            Advance( p )
            dim as Tko.NodeId shared_ = TypeRef( p )
            do
                dim as Tko.Token ft = Cur( p )
                dim as Tko.StmtPayload fp
                if FieldName_( p, fp.name, ft ) = false then
                    NameExpectedHere_( p )
                    exit do
                end if
                '' 'as integer i$' -- a TYPE SUFFIX on a field name is fbc's error 17.
                if (ft.flags and Tko.TF_HAS_SUFFIX) <> 0 then
                    p.diags->Report( Tko.TKO0741, Tko.PointRange( ft.loc ) )
                end if
                '' 'arr() as integer' INSIDE A TYPE -- fbc error 9, "Expected
                '' expression": a dynamic array FIELD must write its rank, '(any)'.
                '' Empty parens read as no bounds at all and left a SCALAR field.
                if cbool( Peek( p ) = Tko.TK_LPAREN ) andalso HasTok( p, p.pos + 1 ) andalso (redimFld = false) then   '' a 'redim' had TKO0766
                    if cast( Tko.TokenKind, p.toks->At( p.pos + 1 ).kind ) = Tko.TK_RPAREN then
                        p.diags->Report( Tko.TKO0721, Tko.PointRange( Cur( p ).loc ), _
                                         p.names->Spelling( fp.name ) )
                    end if
                end if
                ParseArrayBounds( p, fp )
                if fp.count > 0 then fp.op = cast( uint16, iif( redimFld, Tko.KW_REDIM, Tko.KW_DIM ) )
                '' A BITFIELD IN THE TYPE-FIRST SPELLING: 'as ulong a : 3'.
                '' fbc accepts TWO spellings and rejects a third -- measured,
                '' 'a : 3 as ulong' and 'as ulong a : 3' both compile and
                '' 'a as ulong : 3' is its error 14 -- and only the name-first
                '' one read the width here. The type-first field came out an
                '' ORDINARY field of its declared type, so
                ''
                ''     type BF : as ulong a : 3 : as ulong b : 5 : end type
                ''     print sizeof( BF )      fbc: 4      tiko: 8
                ''
                '' -- nothing packed, every field its own unit. A WRONG LAYOUT:
                '' the values read back correctly, so only sizeof and the offset
                '' of everything after it were wrong, and a UDT matched against a
                '' C or Win32 header is wrong at runtime with nothing said.
                ''
                '' The lexer turns ':' into a TK_EOL marked TF_COLON, which is
                '' why this asks IsColonHere rather than accepting a TK_COLON --
                '' the same note the name-first branch carries.
                if IsColonHere( p ) then
                    dim as int32 fsave = p.pos
                    Advance( p )
                    '' ...AND ONLY WHEN A WIDTH FOLLOWS. A ':' after a field is
                    '' normally a STATEMENT SEPARATOR -- 'as integer x : as
                    '' integer y' is two fields on one line -- so a non-numeric
                    '' follower puts the position back and leaves it alone.
                    if Peek( p ) = Tko.TK_INT_LIT then
                        fp.b = Expression( p )
                    else
                        p.pos = fsave
                    end if
                end if
                '' A FIELD INITIALISER, which the loop did not read -- so the '='
                '' was not a comma, the loop stopped, and every declarator AFTER
                '' the first was DROPPED. 'dim as short a = any, b = any' laid out
                '' as TWO BYTES with one field where fbc gives four with two, and
                '' nothing said so: it is a wrong LAYOUT, so every later field sits
                '' at the wrong offset too.
                ''
                '' '= any' IS AN ORDINARY EXPRESSION here -- it parses to an N_IDENT
                '' named 'any', exactly as 'dim as integer i = any' does outside a
                '' type -- so no special case is needed to consume it.
                ''
                '' Only the SHARED-TYPE form takes several: measured, fbc answers
                '' error 3 for 'dim p as short = any, q as short = any' and accepts
                '' 'dim as short p = any, q = any'.
                dim as boolean fEq = Accept( p, Tko.TK_EQ )
                if fEq = false then fEq = Accept( p, Tko.TK_FATARROW )
                '' INTO 'c', NOT 'b'. On an N_FIELD 'b' is the BITFIELD WIDTH, so
                '' 'dim as integer i = 5, j = 6' made i a FIVE-BIT field and put j
                '' on top of it -- 8 bytes with both at offset 0 where fbc gives 16.
                ''
                '' NOTHING READS IT YET: a field DEFAULT is not modelled, here or in
                '' the name-first branch below, so it is parsed and kept rather than
                '' applied. That is the same gap as before this change; what changes
                '' is that the declarators AFTER it are no longer lost.
                if fEq then fp.c = Expression( p )
                fp.a = shared_
                fp.extra or= vis
                members.Push( cast( uint32, MakeStmt( p, Tko.N_FIELD, ft.loc, fp ) ) )
                if Accept( p, Tko.TK_COMMA ) = false then exit do
            loop
            StrayAfterField_( p )
        elseif IsFieldNamedByKeyword( p, k ) then
            '' A FIELD whose name is a keyword that also starts a declaration:
            '' winnt.bi writes 'Function as ULONGLONG' inside two unions, and tiko-lang read
            '' it as a nested FUNCTION declaration, which ran off looking for an
            '' 'end function' and ate the 'end union'.
            ''
            '' Measured, and the accepted set is not guessable -- TYPE and UNION are in
            '' it, ENUM and DECLARE are not:
            ''
            ''   Function Sub Property Type Union   accepted as a field name
            ''   Enum Declare Const Static Dim      fbc rejects
            ''
            '' The '(' and 'as' forms are both accepted by fbc, so both are read here.
            dim as Tko.Token ft = Cur( p )
            dim as Tko.StmtPayload fp
            fp.name = p.names->GetString( _
                Tko.Text.LowerAscii( Tko.TokenKindText( k ) ) )
            Advance( p )
            '' ParseArrayBounds, NOT ParseArrayBoundsInto. The two write the bounds to
            '' DIFFERENT PLACES: a FIELD carries them as the payload's flat first/count
            '' pair, a VARIABLE as a block hanging off 'c'. This branch wrote the
            '' variable shape, which the layout pass does not read, so
            '' 'fix(0 to 2) as integer' -- a field named for a keyword -- laid out as a
            '' SCALAR. Measured against fbc: that type is 40 bytes with 'b' at 32, and
            '' tiko-lang made it 24 with 'b' at 16.
            ParseArrayBounds( p, fp )
            if fp.count > 0 then fp.op = cast( uint16, iif( redimFld, Tko.KW_REDIM, Tko.KW_DIM ) )
            '' 'Shared : 1 as ULONG_PTR' -- the bitfield width, as the name-first branch reads it.
            if IsColonHere( p ) then
                Advance( p )
                fp.b = Expression( p )
            end if
            if Accept( p, Tko.KW_AS ) then fp.a = TypeRef( p )
            FieldInit_( p, fp )                    '' 'Open as boolean = true' (tkEdit TK-002)
            fp.extra or= vis
            members.Push( cast( uint32, MakeStmt( p, Tko.N_FIELD, ft.loc, fp ) ) )
            StrayAfterField_( p )
        elseif IsDeclarationStart( k ) then
            if AutoPropMember( p, members, vis ) then EndOfStatement( p ) : continue do   '' autoprop.tiko
            dim as Tko.NodeId mn = Declaration( p )
            '' Only an N_PROC carries a StmtPayload whose 'extra' is the modifier set;
            '' reaching into stmts[] for any other kind would land on another node's
            '' payload and corrupt it silently.
            dim as boolean tagIt = (vis <> 0) andalso (mn <> Tko.NODE_NONE)
            if tagIt then
                select case p.ast->Kind( mn )
                '' N_CONST and N_VAR belong here with N_PROC: a 'const' or a 'static'
                '' inside a type body is a MEMBER, and 'T.MYCONST' from outside is fbc
                '' error 202 exactly as a private field is. All three carry a
                '' StmtPayload whose 'extra' is the modifier set.
                case Tko.N_PROC, Tko.N_CONST, Tko.N_VAR, Tko.N_ENUM
                    dim as Tko.StmtPayload ptr mp = _
                        p.ast->StmtOf( mn )
                    mp->extra or= vis
                case Tko.N_TYPE
                    ApplyVisibility( p, mn, vis )
                end select
            end if
            members.Push( cast( uint32, mn ) )
        elseif (k = Tko.TK_IDENT) orelse Tko.IsKeywordKind( k ) then
            '' A field: 'name as T' or 'as T name' (the latter via ParseVarDecl).
            dim as Tko.Token ft = Cur( p )
            dim as Tko.StmtPayload fp
            if DeclName( p, fp.name ) then
                '' 'i$ as integer' -- a TYPE SUFFIX on a field name is fbc's error 17.
                if (ft.flags and Tko.TF_HAS_SUFFIX) <> 0 then
                    p.diags->Report( Tko.TKO0741, Tko.PointRange( ft.loc ) )
                end if
                '' 'arr() as integer' INSIDE A TYPE -- fbc error 9, "Expected
                '' expression": a dynamic array FIELD must write its rank, '(any)'.
                '' Empty parens read as no bounds at all and left a SCALAR field.
                if cbool( Peek( p ) = Tko.TK_LPAREN ) andalso HasTok( p, p.pos + 1 ) andalso (redimFld = false) then   '' a 'redim' had TKO0766
                    if cast( Tko.TokenKind, p.toks->At( p.pos + 1 ).kind ) = Tko.TK_RPAREN then
                        p.diags->Report( Tko.TKO0721, Tko.PointRange( Cur( p ).loc ), _
                                         p.names->Spelling( fp.name ) )
                    end if
                end if
                ParseArrayBounds( p, fp )
                if fp.count > 0 then
                    fp.op = cast( uint16, iif( redimFld, Tko.KW_REDIM, Tko.KW_DIM ) )   '' marks 'has bounds'
                end if

                '' A BITFIELD: 'xb0 : 1 as ulong'. The width comes BEFORE the type --
                '' measured, 'a as ulong : 3' is fbc error 14 and only 'a : 3 as ulong'
                '' and the type-first 'as ulong a : 3' are accepted.
                ''
                '' And there is NO TK_COLON TO LOOK FOR. The lexer turns every ':' into
                '' a TK_EOL marked TF_COLON, so the 'Accept( p, TK_COLON )' this
                '' replaces could never fire: the width was never read, the 'as ulong'
                '' after it was never reached, and the field came out with no type at
                '' all -- which is why a UDT of three bitfields laid out as SIZE ZERO.
                if IsColonHere( p ) then
                    Advance( p )
                    fp.b = Expression( p )
                end if
                if Accept( p, Tko.KW_AS ) then fp.a = TypeRef( p )
                '' 'i as integer = 123': the '= value' the type-first form reads (FieldInit_).
                FieldInit_( p, fp )
                '' NO TRAILING WIDTH. 'a as ulong : 3' is fbc error 14, and a ':' after
                '' a field's type is a STATEMENT SEPARATOR -- 'x as integer : y as
                '' integer' is two fields on one line. Reading a width there consumed
                '' the next field as the expression and ran off the end of the TYPE:
                '' three corpus files that fbc accepts reported "expected 'end TYPE'".
                fp.extra or= vis
                members.Push( cast( uint32, MakeStmt( p, Tko.N_FIELD, ft.loc, fp ) ) )
                StrayAfterField_( p )
            end if
        end if

        if p.pos = before then Advance( p )
        EndOfStatement( p )
    loop

    sp.first = p.ast->ChildPoolCount( )
    sp.count = members.Count
    for i as int32 = 0 to members.Count - 1
        p.ast->PushChild( members[i] )
    next

    EmptyAggCheck_( p, sp, isUnion )
    ExpectEnd( p, iif( isUnion, Tko.KW_UNION, iif( (sp.extra and Tko.PF_CLASS) <> 0, Tko.KW_CLASS, Tko.KW_TYPE ) ), t.loc )
    dim as Tko.NodeId n = MakeStmt( p, Tko.N_TYPE, t.loc, sp )
    if implList <> Tko.NODE_NONE then Tko.RecordImplements( *p.ast, n, implList )
    if isUnion then p.ast->OrFlags( n, Tko.NF_IS_UNION )
    '' THE DECREMENT USED TO SIT AFTER THE RETURN, so aggDepth only ever grew: once one
    '' TYPE had been seen anywhere in the unit, a bare anonymous 'union' at module level
    '' was accepted for the rest of the file rather than being the error fbc calls it.
    p.aggDepth -= 1
    return n
end function

'' 'type T field = 1' caps how far each member is aligned. It does NOT reduce the type's
'' own alignment when embedded -- measured -- so it is kept separately rather than
'' folded into the alignment.
''
'' Shared by the named and the ANONYMOUS forms: 'union field = 4' with no name at all is
'' what winnt.bi writes, and reading the clause in only one of the two places left
'' 'field' behind as a MEMBER of the anonymous union.
private sub ParseFieldClause( byref p as Tko.ParserState, byref sp as Tko.StmtPayload )
    if Peek( p ) <> Tko.KW_FIELD then return
    Advance( p )
    if (Accept( p, Tko.TK_EQ ) = false) andalso (Accept( p, Tko.TK_FATARROW ) = false) then return   '' 'field => 1' too (quirk/assignment-token.bas)
    dim as Tko.NodeId nExpr = Expression( p )
    sp.extra and= not cast( uint32, &hFFFF )   '' the packing only: 'extern "c"' may precede it
    '' A CONSTANT, not only a literal: 'field = PK', '( 1 )' and '1 + 0' were ignored (sizeof 8; fbc's 5).
    dim as int64 fv = 0 : if nExpr = Tko.NODE_NONE then return
    if (ConstFoldsToInt_( p, nExpr, fv ) = false) orelse (fv < 0) orelse (fv > 65535) then return
    sp.extra or= cast( uint32, fv )
end sub

'' TYPE / ENUM / NAMESPACE and the top-level Declaration dispatch live in their own
'' file: this one reached the 1500-line cap. Included HERE rather than compiled
'' separately because everything in it calls the helpers above and FreeBASIC has no
'' forward-declaration story that would make the other order work.
#include once "parser/decltype.tiko"

end namespace
