'' ppmodhdr.tiko -- a module's PUBLIC HEADERS: 'public #include' and 'public #cinclude', the
'' macros their conditionals consulted, and the importer's check of them (tiko-vendor
'' RFC-0002 V1, V12; TKO0370 of ADR 0017). #included by ppmodule.tiko.
''
'' A PUBLIC HEADER TRAVELS WHOLE. The importer re-reads it in ITS OWN macro environment, so
'' what the header declares there depends on what the importer has defined -- 'UNICODE'
'' picks the W half of windows.bi -- and on what only the MODULE had: its package's
'' [defines], and the TIKO_LINK_STATIC / TIKO_LINK_DYNAMIC the program's '#import ... link'
'' chose for it. So while the module unit reads the header, every macro a conditional of
'' the header's subtree consults is recorded once, as it was at that first reading, unless
'' the subtree defined or undefined it itself first (an include guard is consulted
'' undefined, then is the header's own). The interface carries the list (tkiemit.tiko):
''
''     #tki require "<module chain>" "<header path>"
''     #tki define NAME body...        the module had it, like this
''     #tki undef NAME                 the module did not have it
''     #include once "<header path>"
''     #tki end
''
'' and the importer, reading the interface, holds its own macros against it:
''
''     both the same, or both undefined     nothing
''     the module had it, the importer not  defined for the header, undefined at '#tki end'
''     anything else                        TKO0370, at the '#import'
''
'' The middle row is V12: a header testing TIKO_LINK_DYNAMIC sees its own package's mode
'' even when another package of the same program is linked statically. A '#macro' block
'' (a body with line ends) and the predefined macros are not recorded: the predefined ones
'' are the target's, the same on both sides, or the unit's own (__FB_OUT_EXE__), which
'' differ by design.

namespace Tko

'' The innermost FILE being read -- a macro expansion's frame names none.
private function PpModHdrFile_( byref e as PpEngine ) as FileId
    for k as int32 = e.frames.Count - 1 to 0 step -1
        if e.frames[k].file <> FILE_NONE then return e.frames[k].file
    next
    return FILE_NONE
end function

'' The public slot of the header whose subtree the innermost file is in, or -1.
private function PpModHdrSlot_( byref e as PpEngine ) as int32
    if e.cfg->moduleFiles = nullptr then return -1
    if e.modst.pubRoots.Count = 0 then return -1
    dim as uint32 f = cast( uint32, PpModHdrFile_( e ) )
    '' The first modHdrFile entry's root, indexed (ppindex.tiko): asked per '#define', per
    '' '#undef' and per name a conditional reads.
    PpModHdrSync_( e )
    dim as int32 root = cast( int32, PpFlagOf_( e.ix.hdrRootOf, f ) ) - 1
    if root < 0 then return -1
    for s as int32 = 0 to e.modst.pubRoots.Count - 1
        if cast( int32, e.modst.pubRoots[s] ) = root then return s
    next
    return -1
end function

private sub PpModGrowMarks_( byref e as PpEngine, byval i as int32 )
    while e.modst.consMark.Count <= i
        e.modst.consMark.Push( 0 )
        e.modst.ownMark.Push( 0 )
    wend
end sub

'' 'public #include' / 'public #cinclude' (V1; T101): the header 'got' travels with the
'' interface whatever the interface names from it. 'what' names the form for TKO0369.
sub PpModMarkPublic _
    ( byref e as PpEngine, byval at as SourceLoc, byval got as FileId, byref what as string )
    dim as string p = e.src->AbsPathOf( got )
    dim as int32 k = PpModHeaderAt_( e, p )
    if (e.modst.isModuleFile = false) orelse (k < 0) then
        Report( e, TKO0369, at, what )
        return
    end if
    for each r as uint32 in e.outp->modHdrPublic
        if r = cast( uint32, k ) then return
    next
    e.outp->modHdrPublic.Push( cast( uint32, k ) )
    '' Thirty-two public headers is a module's whole bit mask; one past it travels unchecked.
    if e.modst.pubRoots.Count < 32 then e.modst.pubRoots.Push( cast( uint32, k ) )
end sub

'' A MACRO AS ITS '#define' LINE READS AFTER THE WORD -- 'name(a, b...) body' -- spaced as
'' the source had it, so '#x' and 'a##b' stay whole. "" for a '#macro' block: its body has
'' line ends, which one line cannot carry.
function PpModMacroText( byref e as PpEngine, byval m as PpMacro ptr ) as string
    dim as string s = e.names->Spelling( m->name )
    if m->optParens then s &= "?"
    if m->isFunc then
        s &= "("
        for i as int32 = 0 to m->params.Count - 1
            if i > 0 then s &= ", "
            s &= e.names->Spelling( cast( InternId, m->params[i] ) )
            if m->isVariadic andalso (i = m->params.Count - 1) then s &= "..."
        next
        s &= ")"
    end if
    dim as int32 prev = -1
    for i as int32 = 0 to m->body.Count - 1
        dim as Token t = m->body[i]
        if Tk( t ) = TK_EOL then
            if (t.flags and TF_COLON) = 0 then return ""
            s &= " :"
            prev = -1
            continue for
        end if
        dim as boolean tight = false
        if (prev >= 0) andalso ((t.flags and TF_SPACE_BEFORE) = 0) then
            dim as DecodedLoc a = e.src->Decode( m->body[prev].loc )
            dim as DecodedLoc b = e.src->Decode( t.loc )
            tight = (a.file = b.file) andalso (a.offset + cast( int32, m->body[prev].length ) = b.offset)
        end if
        if tight = false then s &= " "
        s &= SpellOf( e, t )
        prev = i
    next
    return s
end function

'' TWO DEFINITIONS OF ONE NAME, the same? Parameters and body token by token, literals by
'' value (SameLiteral_, macro.tiko): '#define A 1' read from the interface and from the
'' importer's own header are two pool entries of one value.
private function PpModSameMacro_ _
    ( byref e as PpEngine, byref a as PpMacro, byref b as PpMacro ) as boolean
    if (a.isFunc <> b.isFunc) orelse (a.isVariadic <> b.isVariadic) then return false
    if a.params.Count <> b.params.Count then return false
    for i as int32 = 0 to a.params.Count - 1
        if a.params[i] <> b.params[i] then return false
    next
    if a.body.Count <> b.body.Count then return false
    for i as int32 = 0 to a.body.Count - 1
        if a.body[i].kind <> b.body[i].kind then return false
        dim as TokenKind k = cast( TokenKind, a.body[i].kind )
        if (k = TK_INT_LIT) orelse (k = TK_FLOAT_LIT) orelse (k = TK_STRING_LIT) then
            if SameLiteral_( e, a.body[i].literal, b.body[i].literal ) = false then return false
        elseif k = TK_EOL then
            if (a.body[i].flags and TF_COLON) <> (b.body[i].flags and TF_COLON) then return false
        elseif a.body[i].literal <> b.body[i].literal then
            return false
        end if
    next
    return true
end function

'' A CONDITIONAL READ THE NAME 'id'. Recorded for the public header whose subtree is being
'' read, the first time only, and not once the header has made the name its own.
sub PpModConsult( byref e as PpEngine, byval id as InternId )
    dim as int32 slot = PpModHdrSlot_( e )
    if slot < 0 then return
    dim as int32 i = cast( int32, id )
    if i <= 0 then return
    PpModGrowMarks_( e, i )
    dim as uint32 bit_ = 1ul shl slot
    if ((e.modst.consMark[i] or e.modst.ownMark[i]) and bit_) <> 0 then return
    e.modst.consMark[i] or= bit_
    if i < e.modst.predefMark.Count then
        if e.modst.predefMark[i] <> 0 then return
    end if
    dim as string nm = e.names->Spelling( id )
    if nm = "defined" then return
    dim as string text_ = ""
    dim as PpMacro ptr m = MacroFor( e, id )
    if m <> nullptr then
        if m->builtin <> PPB_NONE then return
        text_ = PpModMacroText( e, m )
        if len( text_ ) = 0 then return
    end if
    e.outp->modConsRoot.Push( e.modst.pubRoots[slot] )
    e.outp->modConsName.Push( nm )
    e.outp->modConsText.Push( text_ )
end sub

'' A '#define' or '#undef' of 'id' read in a public header's subtree: the name is the
'' header's own from here on, and a later conditional over it consults nothing.
sub PpModNoteOwn( byref e as PpEngine, byval id as InternId )
    dim as int32 slot = PpModHdrSlot_( e )
    if slot < 0 then return
    dim as int32 i = cast( int32, id )
    if i <= 0 then return
    PpModGrowMarks_( e, i )
    e.modst.ownMark[i] or= (1ul shl slot)
end sub

'' TKO0370 at the '#import' being read: 'here' is the importer's macro, 'there' the module's.
private sub PpModTkiDiffers_ _
    ( byref e as PpEngine, byref nm as string, byref here as string, byref there as string )
    Report( e, TKO0370, e.modst.importLoc, "'" & nm & "' is " & here, _
            "module '" & e.modst.tkiChain & "' read '" & e.modst.tkiHeader & "' with it " & there )
end sub

private function PpModTkiState_( byref e as PpEngine, byval m as PpMacro ptr ) as string
    if m = nullptr then return "undefined"
    dim as string t = PpModMacroText( e, m )
    dim as int32 sp = instr( t, " " )
    if sp = 0 then return "defined empty"
    return "defined as '" & mid( t, sp + 1 ) & "'"
end function

'' The next quoted string on the line, without its quotes; "" when there is none.
private function PpModTkiString_( byref e as PpEngine ) as string
    dim as Token t
    if PeekOnLine( e, t ) = false then return ""
    if Tk( t ) <> TK_STRING_LIT then return ""
    dim as string s = SpellOf( e, t )
    Advance( e )
    dim as int32 a = instr( s, """" )
    dim as int32 b = instrrev( s, """" )
    if (a = 0) orelse (b <= a) then return ""
    return mid( s, a + 1, b - a - 1 )
end function

'' THE FILE A MACRO WAS DEFINED IN, lower case with forward slashes; "" for none.
private function PpModMacroPath_( byref e as PpEngine, byref m as PpMacro ) as string
    if m.loc = LOC_NONE then return ""
    dim as FileId f = e.src->Decode( m.loc ).file
    if f = FILE_NONE then return ""
    dim as string p = Text.LowerAscii( e.src->AbsPathOf( f ) )
    for i as int32 = 0 to len( p ) - 1
        if p[i] = 92 then p[i] = 47
    next
    return p
end function

'' '#tki hermetic "<package root>"': A MODULE'S OWN HEADER FOLLOWS (tkiemit.tiko). The macros
'' earlier regions parked come back first -- this header may build on them, as com.ti does on
'' win.ti -- unless the reader has defined the name again meanwhile, and the table is noted.
private sub PpModHermStart_( byref e as PpEngine )
    e.modst.hermRestored.Clear( )
    for k as int32 = 0 to e.modst.parkedIds.Count - 1
        dim as InternId id = cast( InternId, e.modst.parkedIds[k] )
        if MacroFor( e, id ) <> nullptr then continue for
        dim as int32 slot = SlotOf( e, id )
        if slot = 0 then continue for
        e.macros[slot - 1] = e.modst.parkedMacs[k]
        e.modst.hermRestored.Push( cast( uint32, id ) )
    next
    e.modst.hermSnapDef.Clear( )
    e.modst.hermSnapLoc.Clear( )
    for i as int32 = 0 to e.macros.Count - 1
        dim as uint32 d = 0
        if e.macros[i].isDefined then d = 1
        e.modst.hermSnapDef.Push( d )
        e.modst.hermSnapLoc.Push( cast( uint32, e.macros[i].loc ) )
    next
end sub

private sub PpModHermPark1_( byref e as PpEngine, byval i as int32 )
    dim as PpMacro ptr m = @e.macros[i]
    dim as uint32 id = cast( uint32, m->name )
    '' parkedIds holds each id once: its index by flag (ppindex.tiko), not by a scan.
    dim as int32 at_ = cast( int32, PpFlagOf_( e.ix.parkedAt, id ) ) - 1
    dim as uint32 df = 0
    if m->loc <> LOC_NONE then df = cast( uint32, e.src->Decode( m->loc ).file )
    e.ix.hermDirty = true
    if at_ < 0 then
        e.modst.parkedIds.Push( id )
        e.modst.parkedMacs.Push( *m )
        e.modst.parkedFile.Push( df )
        PpFlagSet_( e.ix.parkedAt, id, cast( uint32, e.modst.parkedIds.Count ) )
    else
        e.modst.parkedMacs[at_] = *m
        e.modst.parkedFile[at_] = df
    end if
    m->isDefined = false
    FreeTakenName_( e, m->name )
end sub

'' '#tki park': THE REGION HAS ENDED. Every macro it defined, or defined again, in a file under
'' the package root is parked, and so is every one it put back: the reader's own code never
'' sees them, and may define the names itself. A header from inc/ or an -i directory -- the
'' system headers, windows.bi -- keeps its macros, as a header the reader includes itself would.
private sub PpModHermPark_( byref e as PpEngine )
    dim as string root = Text.LowerAscii( e.modst.hermRoot )
    if (len( root ) > 0) andalso (right( root, 1 ) <> "/") then root &= "/"
    for i as int32 = 0 to e.macros.Count - 1
        if len( root ) = 0 then exit for
        dim as PpMacro ptr m = @e.macros[i]
        if m->isDefined = false then continue for
        if m->builtin <> 0 then continue for
        dim as boolean fresh = (i >= e.modst.hermSnapDef.Count)
        if fresh = false then
            fresh = (e.modst.hermSnapDef[i] = 0) orelse (e.modst.hermSnapLoc[i] <> cast( uint32, m->loc ))
        end if
        if fresh = false then continue for
        if left( PpModMacroPath_( e, *m ), len( root ) ) <> root then continue for
        PpModHermPark1_( e, i )
    next
    for each r as uint32 in e.modst.hermRestored
        dim as int32 slot = SlotOf( e, cast( InternId, r ) )
        if slot = 0 then continue for
        if e.macros[slot - 1].isDefined then PpModHermPark1_( e, slot - 1 )
    next
    e.modst.hermRestored.Clear( )
    e.modst.hermRoot = ""
end sub

'' THE FILE THAT FIRST INCLUDED got, for PpModHermSkip's subtree walk.
sub PpModHermNote( byref e as PpEngine, byval from as FileId, byval got as FileId )
    dim as int32 g = cast( int32, got )
    if g <= 0 then return
    while e.modst.inclParent.Count <= g
        e.modst.inclParent.Push( 0 )
    wend
    if e.modst.inclParent[g] = 0 then e.modst.inclParent[g] = cast( uint32, from )
end sub

'' modst.parkedFile GROUPED BY FILE, for PpModHermSkip (ppindex.ti).
private sub PpModHermGroup_( byref e as PpEngine )
    e.ix.hermDirty = false
    e.ix.hermGrpFile.Clear( ) : e.ix.hermGrpHead.Clear( ) : e.ix.hermGrpTail.Clear( ) : e.ix.hermNext.Clear( )
    dim as containers.Map( of uint32, int32 ) grp
    for k as int32 = 0 to e.modst.parkedIds.Count - 1
        dim as uint32 f = e.modst.parkedFile[k]
        dim as int32 g = -1
        e.ix.hermNext.Push( -1 )
        if grp.TryGet( f, g ) then
            e.ix.hermNext[e.ix.hermGrpTail[g]] = k
            e.ix.hermGrpTail[g] = k
        else
            grp.Put( f, e.ix.hermGrpFile.Count )
            e.ix.hermGrpFile.Push( f )
            e.ix.hermGrpHead.Push( k )
            e.ix.hermGrpTail.Push( k )
        end if
    next
end sub

'' AN '#include' THE once RULE SKIPS: the header was read already, perhaps in a module's
'' interface, whose region parked its macros. The reader that includes it itself gets them
'' back -- every parked macro defined in that header or in a file it included -- unless it
'' has defined the name again meanwhile.
''
'' THE WALK UP THE INCLUDE CHAIN IS PER FILE, not per parked macro: the parked macros are grouped
'' by the file each was defined in (PpModHermGroup_), and a group whose file is not under got is
'' passed over whole. Parked ids are distinct, so the order the macros come back in is no matter.
'' It walked every parked macro's chain at every skipped include -- windows.bi's, in a module.
sub PpModHermSkip( byref e as PpEngine, byval got as FileId )
    if e.modst.parkedIds.Count = 0 then return
    if e.ix.hermDirty orelse (e.ix.hermNext.Count <> e.modst.parkedIds.Count) then PpModHermGroup_( e )
    for g as int32 = 0 to e.ix.hermGrpFile.Count - 1
        dim as uint32 f = e.ix.hermGrpFile[g]
        dim as int32 hops = 0
        while (f <> 0) andalso (f <> cast( uint32, got )) andalso (hops < 64)
            if cast( int32, f ) >= e.modst.inclParent.Count then f = 0 : exit while
            f = e.modst.inclParent[cast( int32, f )]
            hops += 1
        wend
        if f <> cast( uint32, got ) then continue for
        dim as int32 k = e.ix.hermGrpHead[g]
        while k >= 0
            dim as InternId id = cast( InternId, e.modst.parkedIds[k] )
            if MacroFor( e, id ) = nullptr then
                dim as int32 slot = SlotOf( e, id )
                if slot > 0 then e.macros[slot - 1] = e.modst.parkedMacs[k]
            end if
            k = e.ix.hermNext[k]
        wend
    next
end sub

'' '#tki ...', which only an interface writes. Anywhere else it is an unknown directive.
sub PpModTki( byref e as PpEngine, byval at as SourceLoc )
    dim as boolean inIface = (e.frames.Count > 0)
    if inIface then inIface = e.frames[e.frames.Count - 1].iface
    dim as Token w
    dim as string verb = ""
    if PeekOnLine( e, w ) then
        if Tk( w ) = TK_IDENT then verb = e.names->Spelling( cast( InternId, w.literal ) )
        if Tk( w ) = KW_END then verb = "end"
    end if
    if inIface = false then
        Report( e, TKO0300, at, "tki" )
        SkipToEol( e )
        return
    end if
    Advance( e )
    select case verb
    case "require"
        e.modst.tkiChain = PpModTkiString_( e )
        e.modst.tkiHeader = PpModTkiString_( e )
        e.modst.tkiRestore.Clear( )
    case "undef"
        dim as Token t
        if PeekOnLine( e, t ) andalso (Tk( t ) = TK_IDENT) then
            dim as PpMacro ptr m = MacroFor( e, cast( InternId, t.literal ) )
            if m <> nullptr then
                PpModTkiDiffers_( e, e.names->Spelling( cast( InternId, t.literal ) ), _
                                  PpModTkiState_( e, m ), "undefined" )
            end if
        end if
    case "define"
        dim as Token t
        if (PeekOnLine( e, t ) = false) orelse (Tk( t ) <> TK_IDENT) then exit select
        dim as InternId id = cast( InternId, t.literal )
        dim as PpMacro ptr m = MacroFor( e, id )
        if m = nullptr then
            PpDefine( e, at, false )
            e.modst.tkiRestore.Push( cast( uint32, id ) )
            return
        end if
        '' The importer has it: read the module's definition into the slot, compare, and put
        '' the importer's back -- it is the one that stays.
        dim as PpMacro saved = *m
        m->isDefined = false
        PpDefine( e, at, false )
        dim as PpMacro ptr theirs = MacroFor( e, id )
        dim as boolean same = false
        dim as string there = "undefined"
        if theirs <> nullptr then
            same = PpModSameMacro_( e, saved, *theirs )
            there = PpModTkiState_( e, theirs )
        end if
        dim as int32 slot = SlotOf( e, id )
        e.macros[slot - 1] = saved
        if same = false then
            PpModTkiDiffers_( e, e.names->Spelling( id ), PpModTkiState_( e, @e.macros[slot - 1] ), there )
        end if
        return
    case "hermetic"
        e.modst.hermRoot = PpModTkiString_( e )
        PpModHermStart_( e )
    case "park"
        PpModHermPark_( e )
    case "end"
        for each r as uint32 in e.modst.tkiRestore
            dim as PpMacro ptr m = MacroFor( e, cast( InternId, r ) )
            if m <> nullptr then m->isDefined = false
            FreeTakenName_( e, cast( InternId, r ) )
        next
        e.modst.tkiRestore.Clear( )
    end select
    SkipToEol( e )
end sub

end namespace
