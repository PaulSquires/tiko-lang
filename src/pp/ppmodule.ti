'' ppmodule.ti -- the preprocessor's per-unit state for '#module', '#import' and
'' '#export' (ADR 0017). See ppmodule.tiko. Engine-private: included by pp.tiko only.

#pragma once

#include once "pp/pp.ti"

namespace Tko

type PpModState
    '' Directives read in the ROOT file so far, '#lang' excepted. '#module' has to be
    '' the first, so the count it sees must be exactly one: itself.
    as long      directives
    '' A token that is not an end of line has been emitted, anywhere.
    as boolean   sawToken
    '' THE HEADER HAS ENDED: '#import' is no longer allowed. Set by the first token, and
    '' by the first directive that is not one the header may contain (RFC-0001 §3).
    as boolean   headerClosed
    as boolean   isModuleFile
    '' TKO0992 is said once per unit, not once per directive.
    as boolean   reportedNotImpl
    '' The first name that the condition about to be pushed consulted and that is not
    '' predefined, as written. PushCond moves it onto the PpCond; see PpModFirstUserIdent.
    as string    pendingUser
    '' InternId -> non-zero: a macro PpDefineBuiltins defined. The -d defines come
    '' after it and are NOT predefined: a header must be decidable from the target.
    as IdVec     predefMark
    '' A MODULE UNIT'S FILES, one after another (PpConfig.moduleFiles): the index of the
    '' file being read, and the undo journal of the macros it defined or undefined itself
    '' -- the slot and the macro as it was before, replayed backwards at the file's end.
    as long      fileIndex
    '' The last root file's end has been handled: PeekTok meets its EOF more than once.
    as boolean   rootEnded
    as IdVec     journalSlot
    '' The module interfaces read in (RFC-0004 §5), whose declarations the parser's
    '' PpNoteDeclared / PpNoteConst do not report.
    as IdVec     ifaceFiles
    '' THE UNIT'S IMPORT ALIASES and the module each names, for 'alias.MACRO( ... )'.
    as IdVec     aliasIds
    as StrVec    aliasChains
    as MacroVec  journalMac
end type

end namespace
