'' pplocal.tiko -- '#if' over a procedure's own declarations: PpProcEnter / PpProcLeave and the
'' local notes they undo, and NoteMacroExpansion_ (TE-005). #included by pp.tiko at the 1500-line
'' cap; PpNoteConst's local branch writes the same log.

sub PpProcEnter( byref st as PpStream )
    if st.engine = nullptr then return
    dim as PpEngine ptr e = cast( PpEngine ptr, st.engine )
    e->procMarks.Push( e->localUndo.Count )
end sub

sub PpProcLeave( byref st as PpStream )
    if st.engine = nullptr then return
    dim as PpEngine ptr e = cast( PpEngine ptr, st.engine )
    if e->procMarks.Count = 0 then return
    dim as int32 mark = e->procMarks.Pop( )
    while e->localUndo.Count > mark
        dim as int64 ov = e->localUndo.Pop( ), om = e->localUndo.Pop( )
        dim as int32 ix = cast( int32, e->localUndo.Pop( ) ), tbl = cast( int32, e->localUndo.Pop( ) )
        if tbl = 1 then
            if ix < e->declaredMark.Count then e->declaredMark[ix] = cast( uint32, om )
        elseif tbl = 3 then
            dim as string os_ = e->localUndoStr.Pop( )
            if ix < e->constStr.Count then e->constStr[ix] = os_
        else
            if ix < e->constMark.Count then e->constMark[ix] = cast( uint32, om ) : e->constVal[ix] = ov
        end if
    wend
end sub

sub PpNoteLocalDeclared( byref st as PpStream, byval nm as InternId, byval kind as int32 )
    if (st.engine = nullptr) orelse (nm = INTERN_NONE) then return
    dim as PpEngine ptr e = cast( PpEngine ptr, st.engine )
    if e->procMarks.Count = 0 then return
    dim as int32 ix = cast( int32, nm )
    dim as int64 om = 0
    if ix < e->declaredMark.Count then om = e->declaredMark[ix]
    e->localUndo.Push( cast( int64, 1 ) ) : e->localUndo.Push( cast( int64, ix ) ) : e->localUndo.Push( om ) : e->localUndo.Push( cast( int64, 0 ) )
    MarkDeclared_( *e, nm, kind )
end sub

'' A LOCAL CONST'S PREVIOUS VALUE, logged before PpNoteConst overwrites it.
private sub UndoLogConst_( byref e as PpEngine, byval nm as InternId )
    if (e.procMarks.Count = 0) orelse (nm = INTERN_NONE) then return
    dim as int32 ix = cast( int32, nm )
    dim as int64 om = 0, ov = 0
    if ix < e.constMark.Count then om = e.constMark[ix] : ov = e.constVal[ix]
    e.localUndo.Push( cast( int64, 2 ) ) : e.localUndo.Push( cast( int64, ix ) ) : e.localUndo.Push( om ) : e.localUndo.Push( ov )
end sub

'' A STRING CONST: its text, by raw InternId, as "=text" ("" is none). A local one logs the old.
sub PpNoteConstStr( byref st as PpStream, byval nm as InternId, byref txt as string, byval isLocal as boolean )
    if (st.engine = nullptr) orelse (nm = INTERN_NONE) then return
    dim as PpEngine ptr e = cast( PpEngine ptr, st.engine )
    dim as int32 ix = cast( int32, nm )
    while e->constStr.Count <= ix
        e->constStr.Push( "" )
    wend
    if isLocal andalso (e->procMarks.Count > 0) then
        e->localUndo.Push( cast( int64, 3 ) ) : e->localUndo.Push( cast( int64, ix ) ) : e->localUndo.Push( cast( int64, 0 ) ) : e->localUndo.Push( cast( int64, 0 ) )
        e->localUndoStr.Push( e->constStr[ix] )
    end if
    e->constStr[ix] = "=" & txt
end sub

function PpConstStrValue( byref e as PpEngine, byval nm as InternId, byref outs as string ) as boolean
    dim as int32 ix = cast( int32, nm )
    if (nm = INTERN_NONE) orelse (ix >= e.constStr.Count) then return false
    if len( e.constStr[ix] ) = 0 then return false
    outs = mid( e.constStr[ix], 2 )
    return true
end function

'' WHERE A MACRO WAS USED, for a diagnostic inside its expansion (tiko-editor TE-005). A token of
'' a macro's body keeps the location of its #define, so an error the parser or a later pass
'' found in an expansion pointed only at the header. PushFrame hands each expansion's tokens to
'' the diagnostic engine with the OUTERMOST use site -- the line in a file, as UseSiteLoc_
'' takes it for __LINE__ -- and the engine renders that site as a note (TKO0986). Here
'' because pp.tiko is at the line cap.
private sub NoteMacroExpansion_ _
    ( byref e as PpEngine, byval toks as TokenVec ptr, byval nm as InternId, byval useLoc as SourceLoc )

    if (toks = nullptr) orelse (e.diags = nullptr) orelse (useLoc = LOC_NONE) then return
    dim as SourceLoc site = useLoc
    for i as int32 = e.frames.Count - 1 to 0 step -1
        if e.frames[i].file <> FILE_NONE then
            for k as int32 = i + 1 to e.frames.Count - 1
                if e.frames[k].useLoc <> LOC_NONE then site = e.frames[k].useLoc : exit for
            next
            exit for
        end if
    next
    dim as string spelled = e.names->Spelling( nm )
    for i as int32 = 0 to toks->Count - 1
        e.diags->NoteMacroUse( (*toks)[i].loc, site, spelled )
    next
end sub
