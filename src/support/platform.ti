'' platform.ti -- the thin layer of OS-specific behaviour the compiler needs.
''
'' Deliberately tiny. Everything that CAN be done portably (paths, file I/O, time) is
'' done through fb/filesystem.bi and fb/chrono.bi instead. What is left is terminal
'' detection, which no portable library can answer.
''
'' Process spawning lands here in Phase 7, and it will use a structured argument
'' vector -- never a shell command string (docs/plan/14 section 7).

#ifndef __TKO_PLATFORM_BI__
#define __TKO_PLATFORM_BI__

#include once "tko.ti"

namespace Tko.Platform

    enum StdStream
        STREAM_OUT = 1
        STREAM_ERR = 2
    end enum

    '' True when the stream is a character device the user is watching. Colour is
    '' emitted only when this is true, so redirected output stays clean.
    declare function IsTerminal( byval s as StdStream ) as boolean

    '' Ask a Windows console to interpret ANSI escapes. No-op elsewhere, and
    '' harmless if it fails -- the caller has already decided colour is wanted.
    declare sub EnableAnsi( )

    '' THE FILE THE RUNNING COMPILER WAS LOADED FROM, as UTF-8 -- the module containing this
    '' code, so inside tikoParser.dll it is the DLL, not the editor. "" when it cannot be
    '' found. command( 0 ) is what the user TYPED: a bare 'tiko' from PATH, which named no
    '' file, so every cache key carried an empty compiler stamp (audit F-38).
    declare function SelfPath( ) as string

    '' THE PROCESS'S PEAK MEMORY SO FAR, in bytes: peak commit (private bytes) on Windows, peak
    '' RSS elsewhere. Monotonic, so the phase after which it jumps is the one that set it --
    '' '--time-passes' prints it per phase (driver/phasetime.ti). 0 when the OS will not say.
    declare function PeakMemory( ) as ulongint

end namespace

#endif
