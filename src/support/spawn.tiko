'' spawn.tiko -- see spawn.ti.

#import "std/containers"
#include once "support/spawn.ti"

#ifdef __FB_WIN32__
    '' By hand, as platform.tiko does: a dozen entry points against windows.bi's 35,000.
    type STARTUPINFOW_
        as uint32      cb
        as wstring ptr lpReserved, lpDesktop, lpTitle
        as uint32      dwX, dwY, dwXSize, dwYSize, dwXCountChars, dwYCountChars
        as uint32      dwFillAttribute, dwFlags
        as uint16     wShowWindow, cbReserved2
        as any ptr    lpReserved2, hStdInput, hStdOutput, hStdError
    end type
    type PROCESS_INFORMATION_
        as any ptr    hProcess, hThread
        as uint32      dwProcessId, dwThreadId
    end type
    extern "windows"
        declare function CreateProcessW_ alias "CreateProcessW" ( byval app as wstring ptr, _
            byval cmd as wstring ptr, byval pa as any ptr, byval ta as any ptr, _
            byval inherit as int32, byval flags as uint32, byval env as any ptr, _
            byval cwd as wstring ptr, byval si as STARTUPINFOW_ ptr, _
            byval pi as PROCESS_INFORMATION_ ptr ) as int32
        declare function WaitForSingleObject_ alias "WaitForSingleObject" _
            ( byval h as any ptr, byval ms as uint32 ) as uint32
        declare function GetExitCodeProcess_ alias "GetExitCodeProcess" _
            ( byval h as any ptr, byval code as uint32 ptr ) as int32
        declare function CloseHandle_ alias "CloseHandle" ( byval h as any ptr ) as int32
        declare function GetStdHandle_ alias "GetStdHandle" ( byval n as uint32 ) as any ptr
        declare function CreateFileW_ alias "CreateFileW" ( byval name_ as wstring ptr, _
            byval access_ as uint32, byval share as uint32, byval sec as any ptr, _
            byval disp as uint32, byval flags as uint32, byval tmpl as any ptr ) as any ptr
        declare function MultiByteToWideChar_ alias "MultiByteToWideChar" ( byval cp as uint32, _
            byval flags as uint32, byval src as zstring ptr, byval srcLen as int32, _
            byval dst as wstring ptr, byval dstLen as int32 ) as int32
    end extern
    const STARTF_USESTDHANDLES_ as uint32 = &h100
    type SECURITY_ATTRIBUTES_
        as uint32    nLength
        as any ptr  lpSecurityDescriptor
        as int32     bInheritHandle
    end type
#else
    extern "c"
        declare function fork_ alias "fork" ( ) as int32
        declare function execvp_ alias "execvp" ( byval file as zstring ptr, _
                                                  byval argv as zstring ptr ptr ) as int32
        declare sub exit__ alias "_exit" ( byval code as int32 )
        declare function waitpid_ alias "waitpid" ( byval pid as int32, byval status as int32 ptr, _
                                                    byval options as int32 ) as int32
        declare function sysconf_ alias "sysconf" ( byval name_ as int32 ) as clong
        declare function sp_open_ alias "open" ( byval p as zstring ptr, byval flags as int32, ... ) as int32
        declare function sp_dup2_ alias "dup2" ( byval a as int32, byval b as int32 ) as int32
    end extern
    const SC_NPROCESSORS_ONLN_ as int32 = 84   '' glibc and musl agree
#endif

namespace Tko.Spawn

sub SplitArgs( byref cmdline as string, byref out_ as Tko.StrVec )
    dim as int32 i = 0, n = len( cmdline )
    while i < n
        while (i < n) andalso ((cmdline[i] = 32) orelse (cmdline[i] = 9))
            i += 1
        wend
        if i >= n then exit while
        dim as string arg = ""
        dim as boolean quoted = false
        while i < n
            dim as uint8 ch = cmdline[i]
            '' HOISTED: a boolean beside two comparisons is warning 38.
            dim as boolean blank = (ch = 32) orelse (ch = 9)
            if blank andalso (quoted = false) then exit while
            if ch = 92 then
                dim as int32 bs = 0
                while (i < n) andalso (cmdline[i] = 92)
                    bs += 1 : i += 1
                wend
                if (i < n) andalso (cmdline[i] = 34) then
                    arg += string( bs \ 2, 92 )
                    if (bs and 1) <> 0 then
                        arg += chr( 34 ) : i += 1
                    end if
                else
                    arg += string( bs, 92 )
                end if
                continue while
            end if
            if ch = 34 then
                quoted = not quoted
            else
                arg += chr( ch )
            end if
            i += 1
        wend
        out_.Push( arg )
    wend
end sub

function QuoteArg( byref s as string ) as string
    dim as string r = """"
    dim as int32 bs = 0
    for i as int32 = 0 to len( s ) - 1
        dim as uint8 ch = s[i]
        if ch = 92 then
            bs += 1
        elseif ch = 34 then
            r += string( bs * 2 + 1, 92 ) & """"
            bs = 0
        else
            if bs > 0 then r += string( bs, 92 )
            bs = 0
            r += chr( ch )
        end if
    next
    return r & string( bs * 2, 92 ) & """"
end function

function Start( byref exe as string, byref args as string, byval quiet as boolean = false ) as Proc
#ifdef __FB_WIN32__
    dim as string cmd = """" & exe & """ " & args
    dim as int32 need = MultiByteToWideChar_( 65001, 0, strptr( cmd ), len( cmd ), nullptr, 0 )
    if need <= 0 then return 0
    dim as wstring ptr w = callocate( (need + 1) * 2 )
    MultiByteToWideChar_( 65001, 0, strptr( cmd ), len( cmd ), w, need )
    dim as STARTUPINFOW_ si
    si.cb = sizeof( STARTUPINFOW_ )
    '' THE SAME STANDARD HANDLES, so clang's own messages land where tiko's do -- a pipe or
    '' a file included, as they did through the C runtime's spawn.
    si.dwFlags = STARTF_USESTDHANDLES_
    si.hStdInput = GetStdHandle_( &hFFFFFFF6ul )
    si.hStdOutput = GetStdHandle_( &hFFFFFFF5ul )
    si.hStdError = GetStdHandle_( &hFFFFFFF4ul )
    '' ...OR NUL, for a child whose output nobody reads: an inheritable handle on the NUL
    '' device, GENERIC_WRITE, shared, OPEN_EXISTING, closed here once the child holds it.
    dim as any ptr hNul = nullptr
    if quiet then
        dim as SECURITY_ATTRIBUTES_ sa
        sa.nLength = sizeof( SECURITY_ATTRIBUTES_ )
        sa.bInheritHandle = 1
        hNul = CreateFileW_( "NUL", &h40000000ul, 3, @sa, 3, 0, nullptr )
        if hNul <> cast( any ptr, -1 ) then
            si.hStdOutput = hNul
            si.hStdError = hNul
        else
            hNul = nullptr
        end if
    end if
    dim as PROCESS_INFORMATION_ pi
    dim as int32 ok = CreateProcessW_( nullptr, w, nullptr, nullptr, 1, 0, nullptr, nullptr, @si, @pi )
    deallocate( w )
    if hNul then CloseHandle_( hNul )
    if ok = 0 then return 0
    CloseHandle_( pi.hThread )
    return cast( Proc, pi.hProcess )
#else
    dim as Tko.StrVec av
    av.Push( exe )
    SplitArgs( args, av )
    dim as zstring ptr ptr argv = callocate( (av.Count + 1) * sizeof( zstring ptr ) )
    for k as int32 = 0 to av.Count - 1
        argv[k] = strptr( av[k] )
    next
    dim as int32 pid = fork_( )
    if pid = 0 then
        '' ...or /dev/null, for a child whose output nobody reads (O_WRONLY).
        if quiet then
            dim as int32 fd = sp_open_( "/dev/null", 1 )
            if fd >= 0 then
                sp_dup2_( fd, 1 )
                sp_dup2_( fd, 2 )
            end if
        end if
        execvp_( argv[0], argv )
        exit__( 127 )
    end if
    deallocate( argv )
    if pid < 0 then return 0
    return cast( Proc, pid )
#endif
end function

function Wait( byval p as Proc ) as int32
    if p = 0 then return -1
#ifdef __FB_WIN32__
    dim as any ptr h = cast( any ptr, p )
    WaitForSingleObject_( h, &hFFFFFFFFul )
    dim as uint32 code = 0
    dim as int32 ok = GetExitCodeProcess_( h, @code )
    CloseHandle_( h )
    if ok = 0 then return -1
    return cast( int32, code )
#else
    dim as int32 status = 0
    if waitpid_( cast( int32, p ), @status, 0 ) <= 0 then return -1
    if (status and &h7F) <> 0 then return -1        '' killed by a signal
    return (status shr 8) and &hFF
#endif
end function

function DefaultJobs( ) as int32
    dim as int32 j = valint( environ( "TKO_JOBS" ) )
    if j > 0 then return j
#ifdef __FB_WIN32__
    j = valint( environ( "NUMBER_OF_PROCESSORS" ) )
#else
    j = cast( int32, sysconf_( SC_NPROCESSORS_ONLN_ ) )
#endif
    if j < 1 then j = 1
    if j > 64 then j = 64
    return j
end function

end namespace
