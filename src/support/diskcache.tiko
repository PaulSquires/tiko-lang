'' diskcache.tiko -- the pieces of an on-disk cache. Moved out of driver/cicache.tiko
'' unchanged when the module cache (ADR 0017, RFC-0005 §4) became their second user.
''
'' A COMMIT IS ATOMIC: every file goes in under a temporary name and is MOVED over its final
'' one -- ReplaceFileW on Windows, rename on POSIX -- so two builds committing one entry at
'' once each leave a whole file, and since the key decides the content, whichever wins is
'' right.

#import "std/containers"
#import "std/fs"
#include once "support/diskcache.ti"
#include once "support/platform.ti"

namespace Tko.DiskCache

function Hash( byref s as string ) as string
    dim as uint64 h = &hCBF29CE484222325ull
    for i as int32 = 0 to len( s ) - 1
        h xor= s[i]
        h *= &h100000001B3ull
    next
    return lcase( hex( h, 16 ) )
end function

function Stamp( byref path_ as string ) as string
    dim as fs.FsResultInfo r = fs.Stat( path_ )
    if r.IsOk( ) = false then return ""
    dim as fs.FileInfo fi = r.Value( )
    if fi.IsFile( ) = false then return ""
    return str( fi.Size( ) ) & chr( 9 ) & str( fi.ModifiedUtc( ) )
end function

'' THE RUNNING COMPILER'S STAMP, from its real path -- Platform.SelfPath -- and "" when it
'' cannot be had. command( 0 ) was what the user typed: a bare 'tiko' from PATH named no
'' file, so every cache key carried an empty stamp and a rebuilt compiler was handed the
'' old one's objects (audit F-38). A cache must not be used without one.
function CompilerStamp( ) as string
    dim as string p = Tko.Platform.SelfPath( )
    if len( p ) = 0 then return ""
    dim as string st = Stamp( p )
    if len( st ) = 0 then return ""
    return p & chr( 9 ) & st
end function

function ReadAll( byref path_ as string, byref text as string ) as boolean
    dim as int32 f = freefile( )
    if open( path_ for binary access read as #f ) <> 0 then return false
    dim as int64 n = lof( f )
    text = space( n )
    if n > 0 then get #f, , text
    close #f
    return true
end function

function Commit( byref path_ as string, byref text as string, byval serial as int32 ) as boolean
    dim as string tmp = path_ & "." & hex( cast( uint64, timer * 1000000.0 ), 12 ) & "." & serial & ".tmp"
    dim as int32 f = freefile( )
    if open( tmp for binary access write as #f ) <> 0 then return false
    if len( text ) then put #f, , text
    close #f
    dim as fs.FsResultBool r = fs.MoveFile( tmp, path_, true )
    if r.IsOk( ) = false then
        fs.RemoveFile( tmp )
        return false
    end if
    return true
end function

function UserCacheDir( byref leaf as string ) as string
#ifdef __FB_WIN32__
    dim as string base_ = environ( "LOCALAPPDATA" )
    if len( base_ ) = 0 then return ""
    return base_ & "\tiko\" & leaf
#else
    dim as string base_ = environ( "XDG_CACHE_HOME" )
    if len( base_ ) = 0 then
        dim as string home = environ( "HOME" )
        if len( home ) = 0 then return ""
        base_ = home & "/.cache"
    end if
    return base_ & "/tiko/" & leaf
#endif
end function

end namespace
