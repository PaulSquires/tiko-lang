'' intern.tiko -- see intern.ti

#import "std/containers"
#include once "support/intern.ti"
#include once "support/text.ti"

namespace Tko

const INTERN_INITIAL_SLOTS as long = 4096
const INTERN_MAX_LOAD_NUM  as long = 7      '' grow past 7/10 occupancy
const INTERN_MAX_LOAD_DEN  as long = 10

function HashBytes( byval p as const ubyte ptr, byval n as long ) as ulong
    dim as ulong h = &h811C9DC5
    for i as long = 0 to n - 1
        h xor= p[i]
        h *= &h01000193
    next
    return h
end function

constructor Interner( )
    this.mask = 0
    this.occupied = 0
    this.Rehash( INTERN_INITIAL_SLOTS )
end constructor

sub Interner.Rehash( byval newSlots as long )
    dim as SlotVec fresh
    fresh.Reserve( newSlots )
    for i as long = 0 to newSlots - 1
        fresh.Push( 0 )
    next

    dim as long newMask = newSlots - 1
    dim as long total = this.entries.Count
    for idx as long = 0 to total - 1
        dim as long slot = cast( long, this.entries[idx].hash ) and newMask
        while fresh[slot] <> 0
            slot = (slot + 1) and newMask
        wend
        fresh[slot] = cast( ulong, idx + 1 )
    next

    swap this.slots, fresh
    this.mask = newMask
end sub

function Interner.Get( byval p as const ubyte ptr, byval n as long ) as InternId
    if n < 0 then n = 0

    dim as ulong h = HashBytes( p, n )
    dim as long slot = cast( long, h ) and this.mask

    while this.slots[slot] <> 0
        dim as long idx = cast( long, this.slots[slot] ) - 1
        dim as boolean sameHash = (this.entries[idx].hash = h)
        dim as boolean sameLen = (this.entries[idx].length = n)
        if sameHash andalso sameLen then
            dim as boolean sameBytes = true
            if n > 0 then sameBytes = (memcmp( this.entries[idx].bytes, p, n ) = 0)
            if sameBytes then return cast( InternId, idx + 1 )
        end if
        slot = (slot + 1) and this.mask
    wend

    '' Miss: copy the bytes into the arena, NUL-terminated for C interop.
    dim as ubyte ptr stored = this.store.Alloc( n + 1, 1 )
    if n > 0 then memcpy( stored, p, n )
    stored[n] = 0

    dim as InternEntry e
    e.bytes = stored
    e.length = n
    e.hash = h
    e.folded = INTERN_NONE
    this.entries.Push( e )

    dim as InternId id = cast( InternId, this.entries.Count )
    this.slots[slot] = cast( ulong, id )
    this.occupied += 1

    if this.occupied * INTERN_MAX_LOAD_DEN > (this.mask + 1) * INTERN_MAX_LOAD_NUM then
        this.Rehash( (this.mask + 1) * 2 )
    end if

    return id
end function

function Interner.GetString( byval s as string ) as InternId
    return this.Get( cast( const ubyte ptr, strptr( s ) ), len( s ) )
end function

function Interner.Spelling( byval id as InternId ) as string
    if id = INTERN_NONE then return ""
    dim as long idx = cast( long, id ) - 1
    dim as long n = this.entries[idx].length
    if n = 0 then return ""
    dim as string r = space( n )
    memcpy( strptr( r ), this.entries[idx].bytes, n )
    return r
end function

function Interner.Bytes( byval id as InternId ) as const ubyte ptr
    if id = INTERN_NONE then return 0
    return this.entries[cast( long, id ) - 1].bytes
end function

function Interner.Length( byval id as InternId ) as long
    if id = INTERN_NONE then return 0
    return this.entries[cast( long, id ) - 1].length
end function

function Interner.Fold( byval id as InternId ) as InternId
    if id = INTERN_NONE then return INTERN_NONE
    dim as long idx = cast( long, id ) - 1
    if this.entries[idx].folded <> INTERN_NONE then return this.entries[idx].folded

    dim as long n = this.entries[idx].length
    dim as InternId result = id
    if n > 0 then
        dim as ubyte ptr tmp = allocate( n )
        Tko.Text.LowerAsciiInto( this.entries[idx].bytes, n, tmp )
        '' Get( ) may push a new entry, which can reallocate the entries array --
        '' so re-index afterwards rather than holding a reference across the call.
        result = this.Get( tmp, n )
        deallocate( tmp )
    end if

    this.entries[idx].folded = result
    return result
end function

function Interner.Count( ) as long
    return this.entries.Count
end function

function Interner.BytesUsed( ) as longint
    return this.store.used
end function

end namespace
