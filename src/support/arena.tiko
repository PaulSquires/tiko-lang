'' arena.tiko -- see arena.ti

#import "std/containers"
#include once "support/arena.ti"

namespace Tko

destructor ByteArena( )
    this.Free( )
end destructor

sub ByteArena.Free( )
    for each b as any ptr in this.blocks
        deallocate( b )
    next
    this.blocks.Clear( )
    this.cur = 0
    this.remaining = 0
    this.reserved = 0
    this.used = 0
end sub

function ByteArena.BlockCount( ) as int32
    return this.blocks.Count
end function

function ByteArena.Alloc _
    ( byval n as int32, byval alignment as int32 = 8 ) as uint8 ptr

    if n <= 0 then n = 1

    '' Round the bump pointer up to the requested alignment before measuring fit,
    '' so a request can never straddle the end of a block.
    dim as uinteger addr = cast( uinteger, this.cur )
    dim as uinteger misalign = addr and cast( uinteger, alignment - 1 )
    dim as int32 pad = 0
    if misalign <> 0 then pad = alignment - cast( int32, misalign )

    if pad + n > this.remaining then
        dim as int32 blockBytes = ARENA_BLOCK_BYTES
        if n + alignment > blockBytes then blockBytes = n + alignment

        dim as uint8 ptr blk = callocate( blockBytes )
        if blk = 0 then
            print "tiko-lang: internal error: out of memory allocating "; blockBytes; " bytes"
            end EXIT_ICE
        end if
        this.blocks.Push( blk )
        this.reserved += blockBytes
        this.cur = blk
        this.remaining = blockBytes

        addr = cast( uinteger, this.cur )
        misalign = addr and cast( uinteger, alignment - 1 )
        pad = 0
        if misalign <> 0 then pad = alignment - cast( int32, misalign )
    end if

    dim as uint8 ptr result = this.cur + pad
    this.cur = result + n
    this.remaining -= (pad + n)
    this.used += n
    return result
end function

function ByteArena.AllocCopy _
    ( byval src as const uint8 ptr, byval n as int32 ) as uint8 ptr

    dim as uint8 ptr dst = this.Alloc( n, 1 )
    if n > 0 then memcpy( dst, src, n )
    return dst
end function

end namespace
