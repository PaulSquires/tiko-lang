'' arena.ti -- block-allocated byte arena.
''
'' The compiler's rule is that nothing in a hot path performs a small heap allocation
'' (docs/plan/14 section 1). Typed node storage uses FB.Array directly; this arena is
'' for variable-size blobs whose ADDRESS must stay stable: interned identifier bytes,
'' diagnostic message text, captured token spellings.
''
'' Invariants:
''   - A pointer returned by Alloc stays valid until Free( ). Blocks are never
''     reallocated, only appended, which is what makes stable addresses possible.
''   - Alloc never returns null; exhaustion is fatal, not a return code.

#ifndef __TKO_ARENA_BI__
#define __TKO_ARENA_BI__

#include once "tko.ti"

namespace Tko

    const ARENA_BLOCK_BYTES as int32 = 65536

    type BlockVec as containers.Array( of any ptr )

    type ByteArena
        as BlockVec  blocks
        as uint8 ptr cur           '' bump pointer into the newest block
        as int32      remaining     '' bytes left in the newest block
        as int64   reserved      '' total bytes obtained from the allocator
        as int64   used          '' total bytes handed out, excluding padding

        declare destructor( )

        '' Alignment must be a power of two.
        declare function Alloc _
            ( byval n as int32, byval alignment as int32 = 8 ) as uint8 ptr

        '' Copy n bytes into the arena and return the copy.
        declare function AllocCopy _
            ( byval src as const uint8 ptr, byval n as int32 ) as uint8 ptr

        declare sub Free( )
        declare function BlockCount( ) as int32
    end type

end namespace

#endif
