'' platform.tiko -- see platform.ti

#import "std/containers"
#include once "support/platform.ti"

#ifdef __FB_WIN32__
    '' Declared by hand rather than including windows.bi: five entry points against
    '' roughly 35,000 declarations is a compile-time difference worth having.
    extern "windows"
        declare function GetStdHandle( byval nStdHandle as uint32 ) as any ptr
        declare function GetFileType( byval hFile as any ptr ) as uint32
        declare function GetConsoleMode( byval hConsole as any ptr, _
                                         byval lpMode as uint32 ptr ) as int32
        declare function SetConsoleMode( byval hConsole as any ptr, _
                                         byval dwMode as uint32 ) as int32
        declare function GetModuleHandleExW( byval flags as uint32, byval addr as any ptr, _
                                             byval hmod as any ptr ptr ) as int32
        declare function GetModuleFileNameW( byval hmod as any ptr, byval buf as wstring ptr, _
                                             byval size as uint32 ) as uint32
        declare function WideCharToMultiByte( byval cp as uint32, byval flags as uint32, _
            byval src as wstring ptr, byval srcLen as int32, byval dst as zstring ptr, _
            byval dstLen as int32, byval def_ as zstring ptr, byval usedDef as int32 ptr ) as int32
    end extern

    const WIN_STD_OUTPUT_HANDLE as uint32 = &hFFFFFFF5    '' (DWORD)-11
    const WIN_STD_ERROR_HANDLE  as uint32 = &hFFFFFFF4    '' (DWORD)-12
    const WIN_FILE_TYPE_CHAR    as uint32 = 2
    const WIN_ENABLE_VT         as uint32 = 4             '' VIRTUAL_TERMINAL_PROCESSING
#else
    extern "c"
        declare function isatty( byval fd as int32 ) as int32
        declare function readlink( byval path_ as zstring ptr, byval buf as zstring ptr, _
                                   byval size as uinteger ) as integer
    end extern
#endif

namespace Tko.Platform

#ifdef __FB_WIN32__
private function HandleFor( byval s as StdStream ) as any ptr
    if s = STREAM_ERR then return GetStdHandle( WIN_STD_ERROR_HANDLE )
    return GetStdHandle( WIN_STD_OUTPUT_HANDLE )
end function
#endif

function IsTerminal( byval s as StdStream ) as boolean
#ifdef __FB_WIN32__
    dim as any ptr h = HandleFor( s )
    if h = nullptr then return false
    return (GetFileType( h ) = WIN_FILE_TYPE_CHAR)
#else
    dim as int32 fd = 1
    if s = STREAM_ERR then fd = 2
    return (isatty( fd ) <> 0)
#endif
end function

function SelfPath( ) as string
#ifdef __FB_WIN32__
    '' FROM_ADDRESS (4) of this very function, UNCHANGED_REFCOUNT (2).
    dim as any ptr hmod = nullptr
    if GetModuleHandleExW( 6, cast( any ptr, @SelfPath ), @hmod ) = 0 then return ""
    dim as wstring * 32768 wbuf
    dim as uint32 n = GetModuleFileNameW( hmod, @wbuf, 32768 )
    if (n = 0) orelse (n >= 32768) then return ""
    dim as int32 need = WideCharToMultiByte( 65001, 0, @wbuf, -1, nullptr, 0, nullptr, nullptr )
    if need <= 1 then return ""
    dim as string u8 = space( need - 1 )
    WideCharToMultiByte( 65001, 0, @wbuf, -1, strptr( u8 ), need, nullptr, nullptr )
    return u8
#else
    dim as zstring * 4097 buf
    dim as integer n = readlink( "/proc/self/exe", @buf, 4096 )
    if n <= 0 then return ""
    return left( buf, n )
#endif
end function

sub EnableAnsi( )
#ifdef __FB_WIN32__
    for s as int32 = STREAM_OUT to STREAM_ERR
        dim as any ptr h = HandleFor( cast( StdStream, s ) )
        if h <> nullptr then
            dim as uint32 mode = 0
            if GetConsoleMode( h, @mode ) <> 0 then
                SetConsoleMode( h, mode or WIN_ENABLE_VT )
            end if
        end if
    next
#endif
end sub

end namespace
