'' dump.tiko -- the textual form of MIR.
''
'' This is not a debugging convenience: docs/plan/13 makes emitted IR a GOLDEN TEST
'' surface, so the text is the thing being asserted on. It is written to be diffable --
'' one instruction per line, fixed order, no addresses or ids that shift when
'' unrelated code changes.

#import "std/containers"
#include once "mir/dump.ti"
#include once "support/irtext.ti"

namespace Tko.Mir

'' The SysV eightbyte classes, spelled. '[I]' one INTEGER eightbyte, '[S,I]' an SSE
'' then an INTEGER, '[M]' MEMORY. Empty when nothing was classified.
private function EbName( byval packed as uint32 ) as string
    if packed = 0 then return ""
    if packed = TKO_EB_MEMORY then return "[M]"
    dim as string r = "["
    dim as uint32 c0 = TKO_EB0( packed )
    dim as uint32 c1 = TKO_EB1( packed )
    if c0 = TKO_EB_SSE then r += "S" else r += "I"
    if c1 <> TKO_EB_NONE then
        if c1 = TKO_EB_SSE then r += ",S" else r += ",I"
    end if
    return r & "]"
end function

'' A FLOAT CONSTANT'S TEXT, WITH THE NON-FINITE ONES SPELLED HERE rather than by the
'' runtime tiko-lang was linked with. 'str( )' of the negative NaN that '0.0 / 0.0'
'' folds to is 'nan' in fbc's libfb (MinGW's printf) and '-nan(ind)' in tiko-rt on the
'' UCRT, so the SELF-BUILT compiler dumped different MIR from the fbc-built one for the
'' same input -- tests/mir/float-const-fold failed under stage2 and nowhere else. These
'' are the spellings the goldens were written with; the sign of a NaN was never shown.
private function FloatConstText_( byval v as float64 ) as string
    if v <> v then return "nan"
    if v > 1.7976931348623157e308 then return "inf"
    if v < -1.7976931348623157e308 then return "-inf"
    return str( v )
end function

private function ValStr _
    ( byref f as MirFunction, byref v as MirValue, byref names as Tko.Interner, _
      byval m as MirModule ptr = nullptr ) as string

    select case v.kind
    case MV_TEMP        : return "%" & str( v.id )
    case MV_CONST_INT
        '' The id field is 32 bits, so a negative constant is read back SIGNED --
        '' otherwise the -1 that means "a var-length string descriptor" prints as
        '' 4294967295. Constants carried inline are limited to 32 bits by that field;
        '' a wider one needs a const instruction, which is what LowerExpr emits.
        return str( cast( int64, cast( int32, v.id ) ) )
    case MV_LOCAL
        if cast( int32, v.id ) < f.locals.Count then
            return "@" & names.Spelling( f.locals[cast( int32, v.id )].name )
        end if
        return "@?" & str( v.id )
    case MV_PARAM       : return "$" & str( v.id )
    case MV_GLOBAL
        '' Named, not numbered: a golden diff should not churn because an unrelated
        '' literal was added ahead of this one in the table.
        if m <> nullptr then
            if cast( int32, v.id ) < m->globals.Count then
                return "@@" & names.Spelling( m->globals[cast( int32, v.id )].name )
            end if
        end if
        return "@@?" & str( v.id )
    case MV_UNDEF       : return "undef"
    case MV_BLOCKADDR   : return "blockaddr b" & str( v.id )
    end select
    return "_"
end function

private function BlockName _
    ( byref f as MirFunction, byval idx as int32, byref names as Tko.Interner ) as string

    if (idx < 0) orelse (idx >= f.blocks.Count) then return "bb?"
    dim as Tko.InternId l = f.blocks[idx].label
    if l = 0 then return "bb" & str( idx )
    return names.Spelling( l )
end function

private function InstStr _
    ( byref f as MirFunction, byref ins as MirInst, byref m as MirModule, _
      byref names as Tko.Interner ) as string

    dim as MirOp op = cast( MirOp, ins.op )
    dim as string s = "    "
    if OpHasResult( op ) andalso (ins.result <> 0) then
        s += "%" & str( ins.result ) & " = "
    end if
    s += OpName( op )

    select case op
    case M_CONST
        s += " " & TypeName( cast( MirType, ins.ty ) ) & " "
        if (ins.ty = cast( uint8, MT_F32 )) orelse (ins.ty = cast( uint8, MT_F64 )) then
            s += FloatConstText_( ins.fimm )
        else
            s += str( ins.imm )
        end if

    case M_FIELD_ADDR
        s += " " & ValStr( f, ins.a, names, @m ) & ", " & str( ins.imm )

    case M_ALLOCA
        dim as int32 li = cast( int32, ins.imm )
        s += " " & TypeName( cast( MirType, ins.ty ) )
        if (li >= 0) andalso (li < f.locals.Count) then
            s += " " & names.Spelling( f.locals[li].name )
        end if

    case M_FUNC_ADDR
        '' The function's NAME, which is what makes the dump readable; the index it
        '' actually carries would say nothing.
        s += " " & TypeName( cast( MirType, ins.ty ) ) & " "
        if cast( int32, ins.callee ) < m.functions.Count then
            s += names.Spelling( m.functions[cast( int32, ins.callee )]->name )
        else
            s += "?" & str( ins.callee )
        end if

    case M_CALL, M_CALL_RTL, M_CALL_IND
        s += " " & TypeName( cast( MirType, ins.ty ) ) & " "
        if op = M_CALL_IND then
            '' The callee is a VALUE here, not a table index.
            s += ValStr( f, ins.a, names, @m )
        elseif cast( int32, ins.callee ) < m.functions.Count then
            s += names.Spelling( m.functions[cast( int32, ins.callee )]->name )
        else
            s += "?" & str( ins.callee )
        end if
        s += "("
        for i as int32 = 0 to ins.count - 1
            if i > 0 then s += ", "
            dim as MirValue av
            dim as int32 slot = (ins.first + i) * 2
            if (slot + 1) < m.argPool.Count then
                av.kind = cast( uint8, m.argPool[slot] )
                av.id = m.argPool[slot + 1]
            end if
            s += ValStr( f, av, names, @m )
        next
        s += ")"
        '' A PAIR RETURN's destination, which the ABI pass put in 'b'.
        if ins.b.kind = cast( uint8, MV_LOCAL ) then
            s += " into " & ValStr( f, ins.b, names, @m )
        end if

    case else
        dim as int32 n = OpArity( op )
        if n >= 1 then s += " " & ValStr( f, ins.a, names, @m )
        if n >= 2 then s += ", " & ValStr( f, ins.b, names, @m )
    end select
    return s
end function

function DumpModule _
    ( byref m as MirModule, byref names as Tko.Interner ) as string

    dim as IrText outp
    '' Globals come first so a function body's diff is not disturbed by one being
    '' added.
    for i as int32 = 0 to m.globals.Count - 1
        if m.globals[i].isData then
            '' A DATA block prints as its entries. TYPE is the datum's CHARACTER
            '' LENGTH, not a datatype, and -1 marks the terminator -- whose NODE is
            '' the next block, or nothing.
            outp += "global data " & names.Spelling( m.globals[i].name ) & " ["
            for k as int32 = 0 to m.globals[i].dataCount - 1
                dim as int32 e = m.globals[i].dataFirst + k
                if k > 0 then outp += ","
                outp += " " & m.dataTypes[e] & " -> "
                if m.dataRefs[e] < 0 then
                    outp += "null"
                else
                    outp += names.Spelling( m.globals[m.dataRefs[e]].name )
                end if
            next
            outp += " ]" & chr( 10 )
        elseif m.globals[i].isPtrTable then
            '' A vtable or an RTTI record: a run of pointer-sized words. '0' is a null
            '' word, '@name' the address of another global, and a bare name a
            '' FUNCTION's address -- which may be declared in another module, so it is
            '' named rather than indexed.
            dim as string pk = "global ptrs "
            if m.globals[i].isExternal then pk = "extern ptrs "
            outp += pk & names.Spelling( m.globals[i].name ) & " ["
            for k as int32 = 0 to m.globals[i].ptrCount - 1
                dim as int32 e = m.globals[i].ptrFirst + k
                if k > 0 then outp += ","
                select case m.ptrKinds[e]
                case 0 : outp += " 0"
                case 1 : outp += " @" & names.Spelling( _
                             m.globals[cast( int32, m.ptrRefs[e] )].name )
                case else : outp += " " & names.Spelling( cast( Tko.InternId, m.ptrRefs[e] ) )
                end select
            next
            outp += " ]" & chr( 10 )
        elseif m.globals[i].isString then
            '' A WIDE LITERAL PRINTS ITS CODE UNITS, not its source text: the text is
            '' the SPELLING, and '!"\u0041"' spells one character with six of them.
            '' Printing the text made a wrong wide literal look right in every
            '' golden.
            ''
            '' Each unit in hex, four digits, so an embedded NUL and a character
            '' above 255 both read back exactly. A unit that is printable ASCII
            '' prints as itself, which keeps the common case legible.
            if m.globals[i].isWide then
                outp += iif( m.globals[i].isUtf16, "global u16str ", "global wstr " ) & _
                        names.Spelling( m.globals[i].name ) & " " & chr( 34 )
                for k as int32 = 0 to m.globals[i].wcharCount - 1
                    dim as uint32 u = m.wcharPool[m.globals[i].wcharFirst + k]
                    if (u >= 32) andalso (u < 127) andalso (u <> 34) andalso _
                       (u <> 92) then
                        outp += chr( cast( int32, u ) )
                    else
                        outp += "\u" & ucase( hex( u, 4 ) )
                    end if
                next
                outp += chr( 34 ) & chr( 10 )
            else
                outp += "global str " & names.Spelling( m.globals[i].name ) & _
                        " " & chr( 34 ) & m.globals[i].bytes & chr( 34 ) & chr( 10 )
            end if
        elseif m.globals[i].isVar then
            '' A DIM SHARED variable. The initialiser is part of the definition, the
            '' way fbc emits 'static int32 H$ = 5;', so it is printed here and not as
            '' a store somewhere.
            outp += "global var " & TypeName( cast( MirType, m.globals[i].ty ) ) & _
                    " " & names.Spelling( m.globals[i].name )
            if m.globals[i].ty = cast( uint8, MT_AGG ) then
                outp += " size " & str( m.globals[i].size )
            end if
            '' AN ADDRESS INITIALISER prints as the thing it points at: '@name' for
            '' another global and a bare name for a FUNCTION, which is the same
            '' spelling a pointer table's words already use. An offset is written
            '' out, so '@a + 8' and '@a' cannot be confused.
            '' A TABLE OF ADDRESSES, one per element: 'dim shared a( ... ) as
            '' zstring ptr = { @"a1", @"a2" }'. The same words a vtable prints,
            '' on a VAR rather than on a table of its own.
            if m.globals[i].ptrCount > 0 then
                '' A MIXED IMAGE prints each address at its byte offset, '+8 @g'; the
                '' data bytes between them are the initialiser's own constants.
                outp += iif( m.globals[i].ptrMixed, " = image [", " = [" )
                for k as int32 = 0 to m.globals[i].ptrCount - 1
                    dim as int32 e = m.globals[i].ptrFirst + k
                    if k > 0 then outp += ","
                    if m.globals[i].ptrMixed then outp += " +" & str( m.ptrOffs[e] )
                    select case m.ptrKinds[e]
                    case 0 : outp += " 0"
                    case 1 : outp += " @" & names.Spelling( _
                                 m.globals[cast( int32, m.ptrRefs[e] )].name )
                    case else
                        outp += " " & names.Spelling( _
                            cast( Tko.InternId, m.ptrRefs[e] ) )
                    end select
                next
                outp += " ]"
            elseif m.globals[i].initReloc >= 0 then
                outp += " = @" & names.Spelling( _
                    m.globals[cast( int32, m.globals[i].initReloc )].name )
                if m.globals[i].initRelocOff <> 0 then
                    outp += " + " & str( m.globals[i].initRelocOff )
                end if
            elseif m.globals[i].initRelocFn <> 0 then
                outp += " = " & names.Spelling( m.globals[i].initRelocFn )
            elseif m.globals[i].hasInit then
                '' A FLOAT initialiser prints as a float: printing initInt for one
                '' would show 0 beside a global that has a value. An AGGREGATE prints
                '' its bytes in hex, which is what it is.
                if len( m.globals[i].initBytes ) > 0 then
                    outp += " = bytes"
                    for bi as int32 = 0 to len( m.globals[i].initBytes ) - 1
                        outp += " " & hex( asc( mid( m.globals[i].initBytes, bi + 1, 1 ) ), 2 )
                    next
                elseif (m.globals[i].ty = cast( uint8, MT_F32 )) orelse _
                       (m.globals[i].ty = cast( uint8, MT_F64 )) then
                    '' A NON-FINITE VALUE PRINTS ITS BITS. 'str( )' renders every NaN
                    '' as 'nan' whatever its sign, and the sign is exactly what a test
                    '' comparing a bit pattern is looking at -- numbers/infnan is that
                    '' test and its own comment says so. INF too, for the same reason:
                    '' the two of them are the values this dump has to be able to tell
                    '' apart.
                    dim as float64 fv = m.globals[i].initFlt
                    if (fv <> fv) orelse (fv > 1.7976931348623157e308) orelse _
                       (fv < -1.7976931348623157e308) then
                        '' IN THE GLOBAL'S OWN WIDTH: an f32 holds a float, and
                        '' printing the double's 64 bits beside it would name a value
                        '' the global cannot hold.
                        if m.globals[i].ty = cast( uint8, MT_F32 ) then
                            dim as float32 sv = cast( float32, fv )
                            dim as uint32 sb = *cptr( uint32 ptr, @sv )
                            outp += " = 0x" & hex( sb, 8 )
                        else
                            dim as uint64 bits_ = *cptr( uint64 ptr, @fv )
                            outp += " = 0x" & hex( bits_, 16 )
                        end if
                    else
                        outp += " = " & str( fv )
                    end if
                else
                    outp += " = " & str( m.globals[i].initInt )
                end if
            end if
            outp += chr( 10 )
        end if
    next
    for fi as int32 = 0 to m.functions.Count - 1
        dim as MirFunction ptr f = m.functions[fi]
        if f = nullptr then continue for

        if f->isModuleCtor then outp += "attribute constructor" & chr( 10 )
        if f->isModuleDtor then outp += "attribute destructor" & chr( 10 )
        outp += iif( f->isDefinition, "func ", "declare " )
        dim as string rty = TypeName( cast( MirType, f->retTy ) )
        if (cast( MirType, f->retTy ) = MT_AGG) andalso (f->retSize > 0) then
            rty += ":" & str( f->retSize ) & EbName( f->retClass )
        end if
        if cast( MirType, f->retTy2 ) <> MT_VOID then
            rty += "," & TypeName( cast( MirType, f->retTy2 ) )
        end if
        outp += rty & " " & names.Spelling( f->name ) & "("
        '' THE PARAMETER'S TYPE, beside its number. The dump used to print '$0, $1'
        '' and nothing else, which is all there was to print; the signature is now
        '' recorded and a golden that cannot see it cannot protect it.
        for i as int32 = 0 to f->paramCount - 1
            if i > 0 then outp += ", "
            dim as string pty = "?"
            if i < f->paramTys.Count then
                pty = TypeName( cast( MirType, f->paramTys[i] ) )
                '' AN AGGREGATE SHOWS ITS SIZE AND ITS SysV EIGHTBYTE CLASSES. Both are
                '' ABI intent that nothing else in the dump reveals, and a classifier
                '' that cannot be READ cannot be checked against the toolchain it has
                '' to agree with.
                if cast( MirType, f->paramTys[i] ) = cast( uint8, MT_AGG ) then
                    '' Only where a size is actually known. A zero is how a DECLINED
                    '' or unrecorded aggregate reads, and annotating that says nothing
                    '' while churning every golden that contains one.
                    if f->paramAggs[i] > 0 then
                        pty += ":" & str( f->paramAggs[i] ) & EbName( f->paramClasses[i] )
                    end if
                end if
            end if
            outp += pty & " $" & str( i )
        next
        if f->isVariadic then
            if f->paramCount > 0 then outp += ", "
            outp += "..."
        end if
        outp += ")"
        select case f->callConv
        case TKO_CC_STDCALL : outp += " stdcall"
        case TKO_CC_PASCAL  : outp += " pascal"
        end select
        if f->isDefinition = false then
            outp += chr( 10 )
            continue for
        end if
        outp += " {" & chr( 10 )

        '' Locals are listed before the blocks so a diff of the body is not disturbed
        '' by a slot being added.
        for i as int32 = 0 to f->locals.Count - 1
            outp += "  local " & TypeName( cast( MirType, f->locals[i].ty ) ) & " " & _
                    names.Spelling( f->locals[i].name )
            if f->locals[i].ty = cast( uint8, MT_AGG ) then
                outp += " size " & str( f->locals[i].size )
            end if
            outp += chr( 10 )
        next

        for bi as int32 = 0 to f->blocks.Count - 1
            dim as MirBlock ptr b = @f->blocks[bi]
            outp += "  " & BlockName( *f, bi, names ) & ":" & chr( 10 )
            for i as int32 = 0 to b->insts.Count - 1
                outp += InstStr( *f, b->insts[i], m, names ) & chr( 10 )
            next
            select case cast( MirTermKind, b->term )
            case MTERM_RET
                if b->cond.kind = cast( uint8, MV_NONE ) then
                    outp += "    ret" & chr( 10 )
                else
                    outp += "    ret " & ValStr( *f, b->cond, names, @m )
                    if b->ret2.kind <> cast( uint8, MV_NONE ) then
                        outp += ", " & ValStr( *f, b->ret2, names, @m )
                    end if
                    outp += chr( 10 )
                end if
            case MTERM_BR
                outp += "    br " & BlockName( *f, b->target, names ) & chr( 10 )
            case MTERM_CONDBR
                outp += "    condbr " & ValStr( *f, b->cond, names, @m ) & ", " & _
                        BlockName( *f, b->target, names ) & ", " & _
                        BlockName( *f, b->target2, names ) & chr( 10 )
            case MTERM_UNREACHABLE
                outp += "    unreachable" & chr( 10 )
            case MTERM_INDIRECTBR
                outp += "    indirectbr " & ValStr( *f, b->cond, names, @m )
                for ti as int32 = 0 to b->indirectTargets.Count - 1
                    outp += ", " & BlockName( *f, _
                        cast( int32, b->indirectTargets[ti] ), names )
                next
                outp += chr( 10 )
            case MTERM_SWITCH
                outp += "    switch " & ValStr( *f, b->cond, names, @m ) & ", " & _
                        BlockName( *f, b->target2, names )
                '' A RUN of consecutive values into one block prints as 'a..b': 'case 1 to
                '' 8192' is 8192 entries, and one line per value buried the rest.
                dim as int32 ti = 0
                while ti < b->indirectTargets.Count
                    dim as int32 tj = ti
                    while (tj + 1 < b->indirectTargets.Count) andalso _
                          (b->indirectTargets[tj + 1] = b->indirectTargets[ti]) andalso _
                          (b->switchVals[tj + 1] = b->switchVals[tj] + 1)
                        tj += 1
                    wend
                    outp += ", " & str( b->switchVals[ti] )
                    if tj > ti then outp += ".." & str( b->switchVals[tj] )
                    outp += ": " & BlockName( *f, cast( int32, b->indirectTargets[ti] ), names )
                    ti = tj + 1
                wend
                outp += chr( 10 )
            case else
                '' Printed rather than hidden: a block with no terminator is exactly
                '' what the verifier exists to catch, and the dump should show it.
                outp += "    <NO TERMINATOR>" & chr( 10 )
            end select
        next
        outp += "}" & chr( 10 )
    next
    return outp
end function

end namespace
