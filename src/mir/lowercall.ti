          declare function SetterUdtArg_( byref c as Ctx, byval sset as Tko.SymbolId, byval idx as int32, byval valNode as Tko.NodeId, byref outv as MirValue ) as boolean
          declare function CtorIndirectUdtArg_( byref c as Ctx, byval ctor as Tko.SymbolId, byval idx as int32, byval argNode as Tko.NodeId, byref outv as MirValue ) as boolean
    declare function LowerProcPtr _
