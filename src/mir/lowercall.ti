          byval isU as boolean = false ) as boolean
    declare function ConcatToTemp_ _
        ( byref c as Ctx, byval e as Tko.NodeId, byref outv as MirValue ) as boolean
    declare function LowerStrOf_ _
        ( byref c as Ctx, byval id as Tko.NodeId, byref outv as MirValue ) as boolean
    '' A byval non-trivial UDT argument's copy, and the lowering that precedes it
    '' -- lowerbyref.tiko.
    declare sub ByvalIndirectRetemp_ _
        ( byref c as Ctx, byref rv as MirValue, byval pty as Tko.TypeId )
    declare function ByvalDefaultArg_ _
        ( byref c as Ctx, byval dv as Tko.NodeId, byval pty as Tko.TypeId ) as MirValue
    '' An address for a byref parameter whose argument is already lowered
    '' -- lowerbyref.tiko.
    declare function ByrefAggTempOf_ _
        ( byref c as Ctx, byref rv as MirValue, byval pty as Tko.TypeId, _
          byref outv as MirValue ) as boolean
    '' The address a byref CONSTRUCTOR argument passes, its own or a temporary's
    '' -- lowerbyref.tiko.
    declare function CtorByrefArgAddr_ _
        ( byref c as Ctx, byval argNode as Tko.NodeId, byval pty as Tko.TypeId, _
          byref outv as MirValue ) as boolean
    '' A CONSTRUCTOR's byref parameter given an rvalue -- lowerbyref.tiko.
    declare function CtorByrefRvalue_ _
        ( byref c as Ctx, byval argNode as Tko.NodeId, byval refT as Tko.TypeId, _
          byref outv as MirValue ) as boolean
    '' A temporary holding an argument that must be passed BYREF and has no address of
    '' its own -- lowercall.tiko.
    declare function ByrefTemp_ _
        ( byref c as Ctx, byval argNode as Tko.NodeId, byval pt as Tko.TypeId ) as MirValue
    '' A 'byref as [const] wstring' constructor argument's wide characters -- lowerbyref.tiko.
    declare function WideRefCtorArg_ _
        ( byref c as Ctx, byval argNode as Tko.NodeId, byval pt as Tko.TypeId, _
          byref outv as MirValue ) as boolean
    '' A wide string argument for a UDT with a 'wstring ptr' constructor -- lowerbyref.tiko --
