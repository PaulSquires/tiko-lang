        declare function UdtPtrCast_( byref c as Ctx, byval au as Tko.TypeId, byval pt as Tko.TypeId, byref isRef as boolean ) as Tko.SymbolId
        declare function ByrefCastInit_( byref c as Ctx, byval slot as int32, byval t as Tko.TypeId, byval init_ as Tko.NodeId, byval selfv as MirValue ptr ) as boolean
    declare function UserCastCharRef_( byref c as Ctx, byval id as Tko.NodeId, byref outv as MirValue ) as boolean
    declare function UserCastToNum_ _
        ( byref c as Ctx, byval id as Tko.NodeId, byref outv as MirValue, _
          byval want as Tko.TypeId = Tko.TYPE_NONE, byval asArg as boolean = false ) as boolean
