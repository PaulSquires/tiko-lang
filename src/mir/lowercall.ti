'' lowercall.ti -- lowering's calls: arguments, BYREF, results, procedure pointers, signatures, substrings.
''
'' One of the cluster headers split out of lowerctx.ti (review ARCH-04): the procedures
'' these files define that fewer than ten mir units call. A unit includes lowerctx.ti
'' and then the cluster headers whose procedures it calls.

#ifndef __TKO_LOWERCALL_BI__
#define __TKO_LOWERCALL_BI__

#include once "mir/lowerctx.ti"

namespace Tko.Mir

declare sub SretResultSlotAfter_( byref c as Ctx, byval t as Tko.TypeId, byval slot as int32 )
declare function UStrToStrTemp_( byref c as Ctx, byval e as Tko.NodeId, byref outv as MirValue ) as boolean
declare function CtorArgLowersLate_( byref c as Ctx, byval a as Tko.NodeId ) as boolean
    declare function EmitImpEqv_ _
        ( byref c as Ctx, byval tk as Tko.TokenKind, byval ty as MirType, _
          byref l as MirValue, byref r as MirValue, byval isBool as boolean = false ) as MirValue
    '' 'str( e )' and 'type<string>( e )' over a wide or UTF-16 e: the narrow conversion.
    '' 'isConv' false when e needed none. lowersub.tiko.
    declare function NarrowConvOf_ _
        ( byref c as Ctx, byval sa as Tko.NodeId, byref outv as MirValue, _
          byref isConv as boolean ) as boolean
    declare function ProcIsStatic_ _
        ( byref c as Ctx, byval defn as Tko.NodeId, byval sid as Tko.SymbolId ) as boolean
    declare function ProcCallConv_ _
        ( byref c as Ctx, byval pn as Tko.NodeId ) as uint8
    '' A call to a pascal procedure, named or through a pascal procedure type.
    declare function CallIsPascal_ _
        ( byref c as Ctx, byval callee as Tko.SymbolId, byval viaPointer as boolean, _
          byval sigT as Tko.TypeId ) as boolean
    '' TKO_PX_* for a parameter of this type -- see lowerstore.tiko.
    declare function ParamExtClass_ _
        ( byref c as Ctx, byval t as Tko.TypeId ) as uint8
    '' Fills a function's signature from the procedure it declares -- see lowerproc.tiko.
    declare sub SignatureFromProc _
        ( byref c as Ctx, byval f as MirFunction ptr, byval pn as Tko.NodeId, _
          byval withSret as boolean, byval withThis as boolean )
    '' A procedure POINTER's signature, as a declaration a call names by index -- lowersig.tiko.
    declare function PtrCallSigIndex_( byref c as Ctx, byval sigT as Tko.TypeId ) as int32
    '' A hidden result's storage: the declared variable on offer, or a temporary; and the
    '' declaration that offers it. lowercallemit.tiko.
    declare function SretResultSlot_ _
        ( byref c as Ctx, byval t as Tko.TypeId, byval registerDtor as boolean, _
          byval sym as Tko.SymbolId ) as int32
    declare function SretInPlaceInit_ _
        ( byref c as Ctx, byval slot as int32, byval t as Tko.TypeId, _
          byval e as Tko.NodeId ) as boolean
    '' An untyped call's result: the result of the procedure its binding names.
    declare function UntypedCallResult_( byref c as Ctx, byval e as Tko.NodeId ) as Tko.TypeId
    '' Another type into a UDT result held in its own slot. lowerprocret.tiko.
    declare function UdtConvResult_ _
        ( byref c as Ctx, byval valueE as Tko.NodeId, byval isReturn as boolean ) as boolean
    declare function FuncAddrOf( byref c as Ctx, byval fsid as Tko.SymbolId, byval structor as boolean = false ) as MirValue
    declare function EmitDirectCall_ _
        ( byref c as Ctx, byval sym as Tko.SymbolId, byval rt as MirType, _
          byref args as containers.Array( of uint32 ), _
          byval withSret as boolean = false ) as MirValue
    declare function MemberCallRetTy_ _
        ( byref c as Ctx, byval sym as Tko.SymbolId ) as MirType
    declare function EmitMemberCallArgs_ _
