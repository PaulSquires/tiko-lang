    declare function CtorInitVariadic_( byref c as Ctx, byval ctor as Tko.SymbolId, byval slot as int32, byval selfv as MirValue ptr, byval cp as Tko.ListPayload ptr ) as boolean
    declare function VariadicOnlyCtor_( byref c as Ctx, byval t as Tko.TypeId ) as Tko.SymbolId
    declare function ParamIsVariadic_( byref c as Ctx, byval callee as Tko.SymbolId, byval idx as int32 ) as boolean
    declare function IsWholeArrayArg_( byref c as Ctx, byval argNode as Tko.NodeId ) as boolean
    declare function PackTypedVariadic_( byref c as Ctx, byval callee as Tko.SymbolId, byval pidx as int32, byval first as int32, byval n as int32, byref outv as MirValue, byval elWant as Tko.TypeId = Tko.TYPE_NONE ) as boolean   '' typed variadics: lowerparam / lowerarrinit / lowercall
    declare function ParamDefaultAt _
        ( byref c as Ctx, byval callee as Tko.SymbolId, byval idx as int32 ) as Tko.NodeId
    declare function PtrCallDecl_ _
