    '' The type a constructor ARGUMENT is chosen by -- see lowercallarg.tiko.
    declare function CtorArgTypeOf_( byref c as Ctx, byval e as Tko.NodeId ) as Tko.TypeId
    declare function LetViaCast_( byref c as Ctx, byval target as Tko.NodeId, byval value as Tko.NodeId, byval atl as Tko.TypeId, byval avt as Tko.TypeId, byval dstp as MirValue ptr = nullptr ) as boolean
    declare function BareTypeNameTemp_( byref c as Ctx, byval e as Tko.NodeId, byref outa as MirValue ) as boolean
    declare function NumberToStrDesc_ _
        ( byref c as Ctx, byval a0 as Tko.NodeId, byref outv as MirValue ) as boolean
    '' THE VARARG CURSOR -- lowercva.tiko.
    declare function LowerCvaStart( byref c as Ctx, byval id as Tko.NodeId ) as boolean
    declare function LowerCvaCopy( byref c as Ctx, byval id as Tko.NodeId ) as boolean
    declare function LowerCvaEnd( byref c as Ctx, byval id as Tko.NodeId ) as boolean
    declare function LowerCvaArg _
