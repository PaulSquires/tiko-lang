          byval rt as MirType, byval args as containers.Array( of uint32 ) ptr, _
          byval vslot as int32 = -1 ) as MirValue
    declare function UserConvToScalar_ _
        ( byref c as Ctx, byval id as Tko.NodeId, byval dstT as Tko.TypeId, _
          byref outv as MirValue, byval asArg as boolean = false ) as boolean
    declare function UserCastNumOverload_ _
        ( byref c as Ctx, byval t as Tko.TypeId, byval want as Tko.TypeId = Tko.TYPE_NONE, byval asArg as boolean = false ) as Tko.SymbolId
    '' lowercallarg.tiko -- 'operator cast( ) as <that UDT>' on the SOURCE's type, and
    '' whether it can be taken. Every position that converts one UDT into another asks
    '' the same pair, so none of them can disagree about when the operator runs.
    declare function UdtCastValue_ _
        ( byref c as Ctx, byval e as Tko.NodeId, byval dstT as Tko.TypeId, _
          byref outv as MirValue, byval constructing as boolean = true ) as boolean
    declare function UdtCastToUdt_ _
        ( byref c as Ctx, byval au as Tko.TypeId, byval pt as Tko.TypeId ) as Tko.SymbolId
