    declare function ProcAddrForWanted_ _
        ( byref c as Ctx, byval id as Tko.NodeId, byref outv as MirValue ) as boolean
    declare function DeclForName_( byref c as Ctx, byval id as Tko.NodeId, byval s as Tko.Symbol ptr ) as Tko.NodeId
    declare function ParamIsAny_( byref c as Ctx, byval t as Tko.TypeId ) as boolean
