'' lowerfor.tiko -- the counted FOR loop.
''
'' Split out of lower.tiko, which is at its size limit. FOR EACH is a different
'' construct and lives in lowerctl.tiko with the other loops.

#import "std/containers"
#include once "lowerctx.ti"

namespace Tko.Mir

using Tko

'' A UDT COUNTER IS THE OPERATOR PROTOCOL. Measured from fbc, for
'' 'for i as T = T(1) to T(3)' over a type declaring 'operator for/step/next':
''
''     _ZN1TC1Eu7INTEGER( &I, 1 )      the counter, constructed from the start value
''     _ZN1TC1Eu7INTEGER( &TMP, 3 )    the limit, constructed ONCE
''     _ZN1Tv03forEv( &I )             operator FOR on the counter
''     goto TEST                       -- the loop is TEST-FIRST
''     BODY:  ...
''     STEP:  _ZN1Tv04stepEv( &I )     operator STEP on the counter
''     TEST:  vr = _ZN1Tv14nextERS_( &I, &TMP )   operator NEXT( counter, limit )
''            if vr <> 0 goto BODY
''
'' What used to block this was a member call that yields a RESULT -- 'operator next'
'' returns an integer and EmitStructorCall is a sub. EmitMemberCallArgs_ answers that
'' now, and it is the same entry point FOR EACH's protocol already calls.
''
'' A WRITTEN STEP DECLINES, and says so rather than guessing: the step-taking
'' overloads are 'operator for( stp )', 'operator step( stp )' and
'' 'operator next( end, stp )' -- the same shape with the step value appended -- but
'' the step's own TYPE need not be the counter's, and nothing here has measured which
'' conversions fbc applies to it. The corpus's two uses are both step-free.
'' Register one of the FOR protocol's objects for destruction at the end of the
'' scope that encloses the loop. Same three pushes FOR EACH makes for its element.
sub RegisterForUdtDtor_ _
    ( byref c as Ctx, byval ct as Tko.TypeId, byval slot as int32 )

    if slot < 0 then return
    dim as Tko.SymbolId dt = _
        StructorWithArity( c, StructorOf( c, ct, "__dtor" ), 0 )
    if dt <> Tko.SYMBOL_NONE then
        c.cleanupNode.Push( cast( uint32, dt ) )
        c.cleanupSlot.Push( slot )
        c.cleanupType.Push( 0 )
    elseif TypeNeedsDtor_( c, ct ) then
        c.cleanupNode.Push( CLEANUP_IMPLICIT_DTOR )
        c.cleanupSlot.Push( slot )
        c.cleanupType.Push( cast( uint32, ct ) )
    end if
end sub

'' ONE INITIALISER FOR ALL THREE OF COUNTER, LIMIT AND STEP. The step already had
'' the three-way answer -- 'T( e )', the converting constructor, then a COPY -- and
'' the counter and the limit stopped after the first two. So an lvalue of the
'' counter's OWN type declined, and declined SILENTLY: 'dim ev = T( 3 ) : for i as
'' T = 1 to ev' linked and ran NO LOOP AT ALL where fbc runs three iterations.
'' Worse, the counter had already been constructed when the LIMIT declined, so the
'' program was left with one extra construction and no loop.
private function ForUdtInit_ _
    ( byref c as Ctx, byval slot as int32, byval ct as Tko.TypeId, _
      byval e as Tko.NodeId, byref dst as MirValue ) as boolean

    if LowerCtorInit( c, slot, ct, e ) then return true
    if LowerConvCtorInit_( c, slot, ct, e, 0 ) then return true
    '' A COPY. fbc emits '_ZN1TC1ERS_( &DST, &SRC )' for an lvalue of the type.
    dim as MirValue sv = LowerAddr( c, e )
    if sv.kind = cast( uint8, MV_NONE ) then return false
    dim as Tko.SymbolId cc = CopyCtorOf_( c, ct )
    if cc <> Tko.SYMBOL_NONE then
        dim as containers.Array( of uint32 ) ccargs
        ccargs.Push( cast( uint32, sv.kind ) )
        ccargs.Push( cast( uint32, sv.id ) )
        EmitStructorCall( c, cc, -1, @dst, @ccargs )
    else
        CallImplicitCopy_( c, ct, dst, sv )
    end if
    return true
end function

private function LowerForUdt_ _
    ( byref c as Ctx, byval sp as Tko.StmtPayload ptr, byref addr as MirValue, _
      byval fromE as Tko.NodeId, byval toE as Tko.NodeId, _
      byval stepE as Tko.NodeId ) as boolean

    if (fromE = Tko.NODE_NONE) orelse (toE = Tko.NODE_NONE) then return false
    if addr.kind <> cast( uint8, MV_LOCAL ) then return false

    dim as Tko.TypeId ct = c.types->Unqualify( c.info->TypeOf_( sp->a ) )
    if ct = Tko.TYPE_NONE then return false
    if c.types->Kind( ct ) <> Tko.TK_UDT then return false

    '' A WRITTEN STEP SELECTS THE OTHER THREE OVERLOADS. Measured from fbc's own C
    '' for 'for cnt as foo = 0 to 4 step stp':
    ''
    ''     _ZN3FOOC1Eu7INTEGER( &CNT, 0 )        the counter
    ''     _ZN3FOOC1Eu7INTEGER( &TMP4, 4 )       the limit, once
    ''     _ZN3FOOC1ERS_( &TMP5, &STP )          THE STEP, once, into a temporary
    ''     _ZN3FOOv13forERS_( &CNT, &TMP5 )      operator for( stp )
    ''     ... body ...
    ''     _ZN3FOOv14stepERS_( &CNT, &TMP5 )     operator step( stp )
    ''     _ZN3FOOv24nextERS_S0_( &CNT, &TMP4, &TMP5 )   operator next( limit, stp )
    ''
    '' -- the step is a COPY, made once, and all three take it. The no-step protocol
    '' is the same shape one argument shorter. Declining a written step declined the
    '' whole loop, and declined it SILENTLY: the program linked and printed nothing
    '' where fbc prints '0 1 2 3 4'.
    dim as boolean hasStep = (stepE <> Tko.NODE_NONE)
    dim as int32 nArg = iif( hasStep, 1, 0 )
    dim as Tko.SymbolId forOp = _
        StructorWithArity( c, StructorOf( c, ct, "for" ), nArg )
    dim as Tko.SymbolId stepOp = _
        StructorWithArity( c, StructorOf( c, ct, "step" ), nArg )
    dim as Tko.SymbolId nextOp = _
        StructorWithArity( c, StructorOf( c, ct, "next" ), nArg + 1 )
    '' ALL THREE OR NONE. A type with only some of them is the checker's error
    '' TKO0746, already reported; lowering half a protocol would emit a loop that
    '' never advances.
    if forOp = Tko.SYMBOL_NONE then return false
    if stepOp = Tko.SYMBOL_NONE then return false
    if nextOp = Tko.SYMBOL_NONE then return false

    '' THE COUNTER, constructed in its own slot from the start expression -- the
    '' same thing 'dim i as T = fromE' does.
    '' ...OR CONVERTED INTO IT. 'for cnt as foo = 0 to 4' over a type with
    '' 'constructor foo( byval rhs as integer )' is not the 'foo( 0 )' shape
    '' LowerCtorInit answers for; it is the converting constructor, and only
    '' LowerConvCtorInit_ finds that. Without it the whole FOR declined -- and
    '' DECLINED SILENTLY: the program linked and printed nothing at all where fbc
    '' prints '0 1 2 3 4'. compound/for_UDT_counter.bas writes it this way.
    if ForUdtInit_( c, addr.id, ct, fromE, addr ) = false then return false

    '' THE LIMIT, constructed ONCE into a temporary. Once, because 'operator next'
    '' is called on every test and re-evaluating 'T( f( ) )' would call f each time.
    dim as int32 lsz = SizeOfType( c, ct )
    if lsz <= 0 then return false
    dim as int32 limSlot = NewTempLocal( c, MT_AGG, lsz )
    if limSlot < 0 then return false
    dim as MirValue limAddr
    limAddr.kind = cast( uint8, MV_LOCAL )
    limAddr.ty = cast( uint8, MT_PTR )
    limAddr.id = limSlot
    if ForUdtInit_( c, limSlot, ct, toE, limAddr ) = false then return false

    '' THE STEP, constructed ONCE into a temporary of its own, for the same reason
    '' the limit is: all three operators read it, on every iteration.
    dim as MirValue stpAddr
    dim as containers.Array( of uint32 ) stpArgs
    if hasStep then
        dim as int32 stpSlot = NewTempLocal( c, MT_AGG, lsz )
        if stpSlot < 0 then return false
        stpAddr.kind = cast( uint8, MV_LOCAL )
        stpAddr.ty = cast( uint8, MT_PTR )
        stpAddr.id = stpSlot
        '' THREE SHAPES, and the corpus writes the third. 'step foo( 1 )' is
        '' LowerCtorInit's; 'step 1' is the converting constructor; and 'step stp'
        '' over a foo is a COPY, which is neither -- fbc emits
        '' '_ZN3FOOC1ERS_( &TMP5, &STP )'. Without the copy the loop declined, and
        '' declined silently: compound/for_UDT_counter.bas writes 'step stp' for
        '' every one of its types.
        if ForUdtInit_( c, stpSlot, ct, stepE, stpAddr ) = false then return false
        stpArgs.Push( cast( uint32, stpAddr.kind ) )
        stpArgs.Push( cast( uint32, stpAddr.id ) )
        EmitMemberCallArgs_( c, forOp, addr, MT_VOID, @stpArgs )
    else
        EmitMemberCall( c, forOp, addr, MT_VOID )
    end if

    '' COUNTER, LIMIT AND STEP ARE DESTROYED AS SCOPE CLEANUPS, in a scope that
    '' encloses the whole loop. Two things were wrong with the dtors that used to
    '' sit inline at the exit block:
    ''
    ''   THE COUNTER WAS NEVER DESTROYED AT ALL -- only the limit and the step were,
    ''   so a loop over a type with a destructor ran one dtor short of fbc.
    ''
    ''   ONLY THE FALL-THROUGH PATH RAN THEM. 'exit do' out of an enclosing loop,
    ''   'return' and 'goto' all leave without passing through the exit block, and
    ''   every one of them leaked all three. compound/for_UDT_counter3.bas counts
    ''   three destructions and got zero.
    ''
    '' A SCOPE answers both: CloseScope emits in reverse registration order, which
    '' is fbc's step-limit-counter, and EmitCleanupsTo is what every non-local exit
    '' already walks.
    PushScope( c, cast( uint32, sp->a ) or SCOPE_KEY_OPT )
    RegisterForUdtDtor_( c, ct, addr.id )
    RegisterForUdtDtor_( c, ct, limSlot )
    if hasStep then RegisterForUdtDtor_( c, ct, stpAddr.id )

    dim as int32 bodyB = NewBlock( c, "for.body" )
    dim as int32 stepB = NewBlock( c, "for.step" )
    dim as int32 testB = NewBlock( c, "for.test" )
    dim as int32 exitB = NewBlock( c, "for.exit" )
    Terminate( c, MTERM_BR, testB, -1, NoVal( ) )

    c.curBlock = bodyB
    c.breakTo.Push( exitB )
    c.contTo.Push( stepB )
    c.loopScope.Push( c.scopeMark.Count )
    c.loopKind.Push( cast( int32, Tko.KW_FOR ) )
    PushScope( c, cast( uint32, sp->b ) )
    LowerBlock( c, sp->b )
    CloseScope( c )
    c.loopScope.Pop( )
    c.loopKind.Pop( )
    c.breakTo.Pop( )
    c.contTo.Pop( )
    Terminate( c, MTERM_BR, stepB, -1, NoVal( ) )

    c.curBlock = stepB
    if hasStep then
        EmitMemberCallArgs_( c, stepOp, addr, MT_VOID, @stpArgs )
    else
        EmitMemberCall( c, stepOp, addr, MT_VOID )
    end if
    Terminate( c, MTERM_BR, testB, -1, NoVal( ) )

    c.curBlock = testB
    dim as containers.Array( of uint32 ) nargs
    nargs.Push( cast( uint32, limAddr.kind ) )
    nargs.Push( cast( uint32, limAddr.id ) )
    if hasStep then
        nargs.Push( cast( uint32, stpAddr.kind ) )
        nargs.Push( cast( uint32, stpAddr.id ) )
    end if
    '' A 'next' RETURNING BYREF hands back the ADDRESS of its answer: 'operator next( .. )
    '' byref as integer' (functions/return-byref.bas). Read as the i32 it was called for,
    '' the address was never zero and the loop never ended. The value behind it is tested.
    dim as boolean nextByref = false
    dim as Tko.Symbol ptr nxs = c.syms->SymbolAt( nextOp )
    dim as Tko.NodeId nxn = Tko.NODE_NONE
    if nxs <> 0 then nxn = cast( Tko.NodeId, nxs->payload )
    if (nxn <> Tko.NODE_NONE) andalso (c.ast->Kind( nxn ) = Tko.N_PROC) then
        nextByref = ((StmtOf( c, nxn )->extra and Tko.PF_BYREF_RESULT) <> 0) orelse _
                    ((c.ast->nodes[cast( int32, nxn )].flags and Tko.NF_BYREF) <> 0)   '' lowerproc.tiko's own test
    end if
    if (nextByref = false) andalso (nxs <> 0) then nextByref = (c.types->Kind( nxs->type_ ) = Tko.TK_REFERENCE)
    dim as MirValue more = _
        EmitMemberCallArgs_( c, nextOp, addr, iif( nextByref, MT_PTR, MT_I32 ), @nargs )
    if more.kind = cast( uint8, MV_NONE ) then
        CloseScope( c )
        return false
    end if
    if nextByref then
        dim as Tko.TypeId nrt = nxs->type_
        if c.types->Kind( nrt ) = Tko.TK_REFERENCE then nrt = c.types->Inner( nrt )
        dim as MirType nmt = LowerType( nrt, *c.types )
        if (nmt = MT_VOID) orelse (nmt = MT_AGG) then nmt = MT_I64
        dim as MirValue nv = LowerExprLoad( c, more, nmt )
        dim as MirInst nz
        nz.op = cast( uint16, M_ICMP_NE )
        nz.ty = cast( uint8, MT_I32 )
        nz.a = nv
        nz.b = ConstInt( c, 0, nmt )
        more = Emit( c, nz )
    end if
    Terminate( c, MTERM_CONDBR, bodyB, exitB, more )

    c.curBlock = exitB
    '' The three temporaries are live across the WHOLE loop, so this is where the
    '' scope holding them closes.
    CloseScope( c )
    return true
end function

sub LowerFor( byref c as Ctx, byval id as Tko.NodeId )
    dim as Tko.StmtPayload ptr sp = StmtOf( c, id )
    '' children are [from, to, step]; any may be absent.
    dim as Tko.NodeId fromE = Tko.NODE_NONE
    dim as Tko.NodeId toE = Tko.NODE_NONE
    dim as Tko.NodeId stepE = Tko.NODE_NONE
    if sp->count >= 1 then fromE = cast( Tko.NodeId, c.ast->children[sp->first] )
    if sp->count >= 2 then toE = cast( Tko.NodeId, c.ast->children[sp->first + 1] )
    if sp->count >= 3 then stepE = cast( Tko.NodeId, c.ast->children[sp->first + 2] )

    dim as MirValue addr = LowerAddr( c, sp->a )
    if addr.kind = cast( uint8, MV_NONE ) then
        SkipHere( c )
        return
    end if
    '' THE COUNTER'S TYPE, from whichever table its address actually names.
    ''
    '' This indexed c.f->locals by addr.id WITHOUT LOOKING AT addr.kind. A SHARED
    '' counter -- 'dim shared idx as integer : for idx = 1 to n' -- puts a GLOBALS
    '' index in addr.id, so the type came off an unrelated local: in practice $tmp0,
    '' the result slot, which means the loop counter took THE ENCLOSING FUNCTION'S
    '' RETURN TYPE. Demonstrated three ways: in a function returning DOUBLE the
    '' counter coerced to f64, and in one returning BOOLEAN it truncated an INTEGER
    '' counter to eight bits. That last one is fbcunit's own suite loop.
    ''
    '' And in a SUB there is no result slot at all, so 'locals' is empty and tiko-lang
    '' SEGFAULTED. The corpus sweep was not reporting that as anything.
    dim as MirType ity = MT_VOID
    if addr.kind = cast( uint8, MV_GLOBAL ) then
        if (addr.id < 0) orelse (addr.id >= c.m->globals.Count) then
            SkipHere( c )
            return
        end if
        ity = cast( MirType, c.m->globals[cast( int32, addr.id )].ty )
    else
        if (addr.id < 0) orelse (addr.id >= c.f->locals.Count) then
            SkipHere( c )
            return
        end if
        ity = cast( MirType, c.f->locals[cast( int32, addr.id )].ty )
    end if
    if ity = MT_VOID then
        SkipHere( c )
        return
    end if

    '' A UDT COUNTER IS THE OPERATOR PROTOCOL, NOT ARITHMETIC -- and everything below
    '' this line assumes a scalar. 'for i as T = T(1) to T(3)' over a type declaring
    '' 'operator for/step/next' was lowered as though T were a number:
    ''
    ''     %12 = load @i          an AGGREGATE loaded as a value
    ''     %14 = icmp.sle %12, %13    two aggregates compared with an integer compare
    ''     %18 = const agg 1          a constant aggregate of value 1
    ''     %19 = add %17, %18         two aggregates ADDED
    ''
    '' -- which is not wrong so much as meaningless. It reported '0 statements not
    '' lowered', it PASSED THE VERIFIER, and then the LLVM emitter met an aggregate with
    '' no storage and died with 'ICE: an aggregate value with no size'. mirsweep never
    '' saw any of it, because --dump-ir stops before codegen; build/icescan.sh is what
    '' found it.
    ''
    '' Declining is not the answer, it is the honest placeholder. fbc's protocol is
    '' measured and written down in HANDOFF: construct the counter and the limit, call
    '' 'operator for' on the counter, TEST FIRST through 'operator next( counter, limit )',
    '' body, 'operator step', test again. Building that needs a member call that yields a
    '' RESULT -- EmitStructorCall is a sub and 'next' returns an integer -- which is the
    '' piece this does not have yet.
    if ity = MT_AGG then
        if LowerForUdt_( c, sp, addr, fromE, toE, stepE ) then return
        SkipHere( c )
        return
    end if

    '' THE COMPARISON'S SIGNEDNESS FOLLOWS THE COUNTER, and the STEP'S DIRECTION
    '' follows the STEP'S OWN TYPE. Both were signed unconditionally, and each half
    '' had its own wrong answer, measured against fbc:
    ''
    ''   a UBYTE counter, 0 to 1, stepping '1u shl 7' -- signed 'sle' read the
    ''       counter's 128 as -128, so it never passed the limit and the loop
    ''       NEVER ENDED.
    ''   the same loop with the step in a UBYTE VARIABLE holding 128 -- the signed
    ''       sign test read 128 as negative, chose the descending arm, and the loop
    ''       ran ZERO times where fbc runs it once.
    ''
    '' A NEGATIVE LITERAL STEP OVER AN UNSIGNED COUNTER still descends -- a UINTEGER
    '' counter running 10 down to 0 with a step of -1 is fbc's descending loop,
    '' because the STEP is signed there even though the counter is not. That is
    '' why the two questions are asked of two different types.
    dim as boolean unsCtr = (IsFloatTy( ity ) = false) andalso _
                            IsUnsignedType( c, c.info->TypeOf_( sp->a ) )

    '' init
    ''
    '' EACH OF THE THREE HEAD EXPRESSIONS LETS ITS TEMPORARIES GO AS SOON AS IT IS STORED.
    '' Measured, fbc's 'for i = takeR( mkH( 1 ) ) to takeR( mkH( 5 ) ) + cnt( ) step
    '' takeR( mkH( 2 ) ) + cnt( )' destroys 1, then 5, then 2, all before the first
    '' iteration, and the limit and the step each see the destructors before them.
    dim as int32 hmark = c.udtTemps.Count
    dim as MirValue init_ = LowerNumArg_( c, fromE, ity )
    if init_.kind <> cast( uint8, MV_NONE ) then
        dim as MirInst st0
        st0.op = cast( uint16, M_STORE )
        st0.ty = cast( uint8, MT_VOID )
        st0.a = addr
        st0.b = init_
        Emit( c, st0 )
    end if
    ReleaseUdtTemps_( c, hmark )

    '' THE LIMIT IS EVALUATED ONCE TOO, and BEFORE the step -- measured against fbc,
    '' which for 'for i = f( ) to g( ) step h( )' emits
    ''
    ''     vr$0 = F( ); I$1 = vr$0;
    ''     vr$1 = G( ); TMP$5$1 = vr$1;
    ''     vr$2 = H( ); TMP$6$1 = vr$2;
    ''
    '' and prints 'fgh' once, not once per iteration. It was lowered INSIDE the head
    '' block, so it ran on every test: a limit with a side effect repeated it, and a
    '' limit naming a variable the body changes never settled. fbcunit writes
    ''
    ''     for fbcu_tests_count as integer = 1 to fbcu_tests_count
    ''
    '' -- the counter SHADOWS the shared name, so re-reading the limit read the
    '' counter and the loop could not terminate.
    ''
    '' A CONSTANT limit is left where it was. It cannot have a side effect and cannot
    '' be reassigned, so hoisting it would only add a slot and a load.
    dim as int32 limSlot = -1
    dim as MirValue limAddr
    if toE <> Tko.NODE_NONE then
        dim as Tko.Check.ConstVal lv = _
            Tko.Check.ConstOf( *c.ast, toE, *c.srcMgr, *c.names, _
                               c.types->target.pointerBits )
        if lv.known = false then
            limSlot = NewTempLocal( c, ity, 8 )
            if limSlot < 0 then
                SkipHere( c )
                return
            end if
            limAddr.kind = cast( uint8, MV_LOCAL )
            limAddr.ty = cast( uint8, MT_PTR )
            limAddr.id = limSlot
            dim as MirValue lv0 = _
                LowerNumArg_( c, toE, ity )
            if lv0.kind = cast( uint8, MV_NONE ) then
                SkipHere( c )
                return
            end if
            dim as MirInst lst
            lst.op = cast( uint16, M_STORE )
            lst.ty = cast( uint8, MT_VOID )
            lst.a = limAddr
            lst.b = lv0
            Emit( c, lst )
            ReleaseUdtTemps_( c, hmark )
        end if
    end if

    '' THE STEP IS EVALUATED ONCE, BEFORE THE LOOP, into a temporary -- which is what
    '' fbc does ('TMP$2$1 = S$0'). It used to be re-lowered inside the step block, so
    '' a step expression with a side effect ran once per iteration.
    dim as boolean haveStep = (stepE <> Tko.NODE_NONE)
    dim as boolean stepConst = false
    dim as boolean negStep = false
    dim as int32 stepSlot = -1
    dim as MirValue stepAddr
    if haveStep then
        dim as Tko.Check.ConstVal sv = Tko.Check.ConstOf( *c.ast, stepE, *c.srcMgr, *c.names, _
                                   c.types->target.pointerBits )
        stepConst = sv.known
        '' A CONSTANT STEP OF AN UNSIGNED TYPE IS NEVER NEGATIVE either -- the same
        '' question the runtime sign test below asks, and the constant path was
        '' asking it of the folded LONGINT: '1ull shl 63' is 2^63, which reads as
        '' negative at 64 bits, so the loop chose the descending arm and ran ZERO
        '' times where fbc runs it once.
        if sv.known then
            negStep = (sv.value < 0)
            if (IsFloatTy( ity ) = false) andalso _
               IsUnsignedType( c, c.info->TypeOf_( stepE ) ) then negStep = false
        end if

        stepSlot = NewTempLocal( c, ity, 8 )
        if stepSlot < 0 then
            SkipHere( c )
            return
        end if
        stepAddr.kind = cast( uint8, MV_LOCAL )
        stepAddr.ty = cast( uint8, MT_PTR )
        stepAddr.id = stepSlot
        dim as MirValue sv0 = LowerNumArg_( c, stepE, ity )
        if sv0.kind = cast( uint8, MV_NONE ) then
            SkipHere( c )
            return
        end if
        dim as MirInst sst
        sst.op = cast( uint16, M_STORE )
        sst.ty = cast( uint8, MT_VOID )
        sst.a = stepAddr
        sst.b = sv0
        Emit( c, sst )
        ReleaseUdtTemps_( c, hmark )
    end if

    '' A RUNTIME STEP needs its SIGN tested once, also before the loop, because the
    '' comparison direction depends on it. fbc computes '-(step >= 0)' into a second
    '' temporary and branches on that at the top of every iteration.
    dim as int32 signSlot = -1
    dim as MirValue signAddr
    if haveStep andalso (stepConst = false) then
        signSlot = NewTempLocal( c, MT_I8, 1 )
        if signSlot < 0 then
            SkipHere( c )
            return
        end if
        signAddr.kind = cast( uint8, MV_LOCAL )
        signAddr.ty = cast( uint8, MT_PTR )
        signAddr.id = signSlot
        dim as MirValue sload = LowerExprLoad( c, stepAddr, ity )
        dim as MirInst scmp
        '' AN UNSIGNED STEP IS NEVER NEGATIVE, so its sign is asked unsigned.
        dim as boolean unsStep = (IsFloatTy( ity ) = false) andalso _
                                 IsUnsignedType( c, c.info->TypeOf_( stepE ) )
        scmp.op = cast( uint16, iif( IsFloatTy( ity ), M_FCMP_GE, _
                                     iif( unsStep, M_ICMP_UGE, M_ICMP_SGE ) ) )
        scmp.ty = cast( uint8, MT_I8 )
        scmp.a = sload
        scmp.b = ZeroOf( c, ity )
        dim as MirValue snn = Emit( c, scmp )
        dim as MirInst sst2
        sst2.op = cast( uint16, M_STORE )
        sst2.ty = cast( uint8, MT_VOID )
        sst2.a = signAddr
        sst2.b = snn
        Emit( c, sst2 )
    end if

    dim as int32 headB = NewBlock( c, "for.head" )
    dim as int32 bodyB = NewBlock( c, "for.body" )
    dim as int32 stepB = NewBlock( c, "for.step" )
    dim as int32 exitB = NewBlock( c, "for.exit" )
    dim as int32 upB = -1
    dim as int32 downB = -1
    if signSlot >= 0 then
        upB = NewBlock( c, "for.up" )
        downB = NewBlock( c, "for.down" )
    end if
    Terminate( c, MTERM_BR, headB, -1, NoVal( ) )

    '' guard: counter <= limit for a rising step, >= for a falling one.
    c.curBlock = headB
    dim as MirValue cur = LowerExprLoad( c, addr, ity )
    '' From the TEMPORARY when there is one, exactly as the step is.
    dim as MirValue lim
    if limSlot >= 0 then
        lim = LowerExprLoad( c, limAddr, ity )
    else
        lim = LowerNumArg_( c, toE, ity )
    end if

    if signSlot >= 0 then
        '' Two tests, chosen at run time. The limit is loaded ONCE, above, and both
        '' arms compare against it.
        dim as MirValue sflag = LowerExprLoad( c, signAddr, MT_I8 )
        Terminate( c, MTERM_CONDBR, upB, downB, sflag )

        c.curBlock = upB
        dim as MirInst cu
        cu.op = cast( uint16, iif( IsFloatTy( ity ), M_FCMP_LE, _
                                   iif( unsCtr, M_ICMP_ULE, M_ICMP_SLE ) ) )
        cu.ty = cast( uint8, MT_I8 )
        cu.a = cur
        cu.b = lim
        Terminate( c, MTERM_CONDBR, bodyB, exitB, Emit( c, cu ) )

        c.curBlock = downB
        dim as MirInst cd
        cd.op = cast( uint16, iif( IsFloatTy( ity ), M_FCMP_GE, _
                                   iif( unsCtr, M_ICMP_UGE, M_ICMP_SGE ) ) )
        cd.ty = cast( uint8, MT_I8 )
        cd.a = cur
        cd.b = lim
        Terminate( c, MTERM_CONDBR, bodyB, exitB, Emit( c, cd ) )
    else
        dim as MirInst cmp
        cmp.op = cast( uint16, iif( IsFloatTy( ity ), _
                                    iif( negStep, M_FCMP_GE, M_FCMP_LE ), _
                                    iif( negStep, iif( unsCtr, M_ICMP_UGE, M_ICMP_SGE ), _
                                                  iif( unsCtr, M_ICMP_ULE, M_ICMP_SLE ) ) ) )
        cmp.ty = cast( uint8, MT_I8 )
        cmp.a = cur
        cmp.b = lim
        dim as MirValue cond = Emit( c, cmp )
        Terminate( c, MTERM_CONDBR, bodyB, exitB, cond )
    end if

    c.curBlock = bodyB
    c.breakTo.Push( exitB )
    c.contTo.Push( stepB )
    c.loopScope.Push( c.scopeMark.Count )
    c.loopKind.Push( cast( int32, Tko.KW_FOR ) )
    PushScope( c, cast( uint32, sp->b ) )
    LowerBlock( c, sp->b )
    CloseScope( c )
    c.loopScope.Pop( )
    c.loopKind.Pop( )
    c.breakTo.Pop( )
    c.contTo.Pop( )
    Terminate( c, MTERM_BR, stepB, -1, NoVal( ) )

    c.curBlock = stepB
    dim as MirValue cur2 = LowerExprLoad( c, addr, ity )
    '' The step comes from the TEMPORARY, not from the expression again.
    dim as MirValue inc
    if stepSlot >= 0 then
        inc = LowerExprLoad( c, stepAddr, ity )
    else
        inc = ConstInt( c, 1, ity )
    end if
    '' A POINTER COUNTER STEPS WITH M_PTR_ADD. A loop over a pointer advanced
    '' with a plain add over two pointers -- 'add ptr %t70, inttoptr (i64 1 to ptr)'
    '' -- which is not an LLVM instruction, the same fault the binary operator had
    '' before 7b. M_PTR_ADD takes a BYTE offset and the step is already scaled by the
    '' pointee, so nothing scales twice.
    dim as MirValue nxt
    if ity = MT_PTR then
        '' ...AND SCALED BY THE POINTEE. M_PTR_ADD takes a BYTE offset, and the step
        '' of a pointer counter is in ELEMENTS: 'for p as short ptr = f to l' walked
        '' one BYTE at a time and printed 10, 5120, 20, 7680 -- every value and the
        '' half of the next one -- where fbc prints 10 20 30 40 50 60.
        dim as MirType offT = MT_I64
        if c.types->target.pointerBits = 32 then offT = MT_I32
        dim as MirValue off = Coerce( c, inc, offT, false )
        dim as int32 pesz = PtrArithElem_( c, c.info->TypeOf_( sp->a ) )
        if pesz > 1 then
            dim as MirInst sc
            sc.op = cast( uint16, M_MUL )
            sc.ty = cast( uint8, offT )
            sc.a = off
            sc.b = ConstInt( c, pesz, offT )
            off = Emit( c, sc )
        end if
        dim as MirInst pa
        pa.op = cast( uint16, M_PTR_ADD )
        pa.ty = cast( uint8, MT_PTR )
        pa.a = cur2
        pa.b = off
        nxt = Emit( c, pa )
    else
        dim as MirInst add_
        add_.op = cast( uint16, M_ADD )
        add_.ty = cast( uint8, ity )
        add_.a = cur2
        add_.b = inc
        nxt = Emit( c, add_ )
    end if
    dim as MirInst st1
    st1.op = cast( uint16, M_STORE )
    st1.ty = cast( uint8, MT_VOID )
    st1.a = addr
    st1.b = nxt
    Emit( c, st1 )
    Terminate( c, MTERM_BR, headB, -1, NoVal( ) )

    c.curBlock = exitB
end sub

end namespace
