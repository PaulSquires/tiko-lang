'' lowerstr.ti -- lowering's strings: narrow, wide and UTF-8 temporaries, descriptors, concatenation, string arguments.
''
'' One of the cluster headers split out of lowerctx.ti (review ARCH-04): the procedures
'' these files define that fewer than ten mir units call. A unit includes lowerctx.ti
'' and then the cluster headers whose procedures it calls.

#ifndef __TKO_LOWERSTR_BI__
#define __TKO_LOWERSTR_BI__

#include once "mir/lowerctx.ti"

namespace Tko.Mir

declare sub FlushStrCopyBacks( byref c as Ctx, byval mark as int32 )
declare sub CopyBackStrArgs( byref c as Ctx, byref nodes as containers.Array( of uint32 ), byref slots as containers.Array( of uint32 ) )
declare function SameLValue _
    ( byref c as Ctx, byval a as Tko.NodeId, byval b as Tko.NodeId ) as boolean
declare function TermReadsLValue_ _
    ( byref c as Ctx, byval target as Tko.NodeId, byval e as Tko.NodeId ) as boolean
declare function WideAssignViaTemp_ _
    ( byref c as Ctx, byref dst as MirValue, byval n as int32, _
      byval target as Tko.NodeId, byval value as Tko.NodeId ) as boolean
