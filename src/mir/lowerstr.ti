    declare function UStrOperandToNarrow_ _
        ( byref c as Ctx, byval sa as Tko.NodeId, byref outv as MirValue ) as boolean
    '' A narrow argument for a 'byref as ustring' parameter outside the ordinary call path:
    '' the ustring temporary fbc builds first. False when neither applies. lowerstrargs.tiko.
    declare function UStrParamArgTemp_ _
        ( byref c as Ctx, byval argNode as Tko.NodeId, byval pt as Tko.TypeId, _
          byref outv as MirValue ) as boolean
          declare function UStrRefArg_( byref c as Ctx, byval e as Tko.NodeId, byval pt as Tko.TypeId, byref outv as MirValue, byref temps as containers.Array( of uint32 ), byref tempTypes as containers.Array( of uint32 ), byref backN as containers.Array( of uint32 ), byref backS as containers.Array( of uint32 ) ) as boolean
    '' ...and its narrow twin, for a 'byref as string' parameter. lowerstrargs.tiko.
    declare function NarrowParamArgTemp_ _
        ( byref c as Ctx, byval argNode as Tko.NodeId, byval pt as Tko.TypeId, _
          byref outv as MirValue ) as boolean
          declare function NarrowRefStrArg_( byref c as Ctx, byval e as Tko.NodeId, byval pt as Tko.TypeId, byref outv as MirValue, byref temps as containers.Array( of uint32 ), byref tempTypes as containers.Array( of uint32 ), byref backN as containers.Array( of uint32 ), byref backS as containers.Array( of uint32 ) ) as boolean
          declare sub StrBackPushNarrow_( byref c as Ctx, byval e as Tko.NodeId, byval slot as int32, byref backN as containers.Array( of uint32 ), byref backS as containers.Array( of uint32 ) )
          declare function LowerStringInit_( byref c as Ctx, byval slot as int32, byval target as Tko.NodeId, byval value as Tko.NodeId ) as boolean
    declare function LowerPrint( byref c as Ctx, byval id as Tko.NodeId ) as boolean
    declare function LowerMidAssign _
        ( byref c as Ctx, byval target as Tko.NodeId, _
          byval value as Tko.NodeId ) as boolean
    declare function LowerDir _
        ( byref c as Ctx, byval id as Tko.NodeId, byref outv as MirValue ) as boolean
    declare sub PushConst( byref args as containers.Array( of uint32 ), byval v as int32 )
    declare function WideStringElems( byref c as Ctx, byval t as Tko.TypeId ) as int32
        declare function LitOnlyChain_( byref c as Ctx, byval id as Tko.NodeId, byval depth as int32 ) as boolean
    declare function LowerStringAssignToSlot _
        ( byref c as Ctx, byval slot as int32, byval value as Tko.NodeId ) as boolean
          declare function LowerStringAssignTo_( byref c as Ctx, byref dst as MirValue, byval target as Tko.NodeId, byval value as Tko.NodeId, byval dstFlavour as int32 ) as boolean
