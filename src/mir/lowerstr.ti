          declare function PtrStrArg_( byref c as Ctx, byval e as Tko.NodeId, byval ppt as Tko.TypeId, byval vararg as boolean, byref outv as MirValue, byref temps as containers.Array( of uint32 ), byref tempTypes as containers.Array( of uint32 ), byref backN as containers.Array( of uint32 ), byref backS as containers.Array( of uint32 ) ) as int32
          declare function PropPtrStrArg_( byref c as Ctx, byval e as Tko.NodeId, byval ppt as Tko.TypeId, byref outv as MirValue ) as int32
    declare function ParamWantsWideRef_ _
        ( byref c as Ctx, byval callee as Tko.SymbolId, byval sigT as Tko.TypeId, _
          byval idx as int32 ) as boolean
    declare function IsNarrowStrArg_( byref c as Ctx, byval t as Tko.TypeId ) as boolean
    declare function IifArmsScalar_ _
