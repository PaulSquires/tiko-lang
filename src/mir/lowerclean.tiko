'' lowerclean.tiko -- the cleanup model: what runs when a scope ends.
''
'' Split out of lower.tiko when that file passed the 1500-line lint cap. The design is
'' docs/plan/08 section 6 and the comments below; nothing moved with it changed.

#import "std/containers"
#include once "mir/lowerall.ti"

namespace Tko.Mir

'' -------------------------------------------------------------- cleanup model

sub PushScope( byref c as Ctx, byval key as uint32 = 0 )
    c.scopeMark.Push( c.cleanupNode.Count )
    c.scopeKey.Push( key )
end sub

'' Whether cleanup entry i DESTROYS ONE UDT OBJECT in its slot: a written destructor (the
'' entry is its symbol) or the synthesised one. Not a defer (slot -1), a string delete (0),
'' an array, a destructor epilogue or a wide delete -- all the other CLEANUP_* markers.
private function EntryDestroysUdt_( byref c as Ctx, byval i as int32 ) as boolean
    if c.cleanupSlot[i] < 0 then return false
    dim as uint32 nd = c.cleanupNode[i]
    if nd = CLEANUP_IMPLICIT_DTOR then return true
    if nd = 0 then return false
    return (nd < CLEANUP_WSTR_DELETE)   '' every CLEANUP_* marker sits at &hFFFFFFFA and above
end function

'' One registered cleanup action, run in place.
private sub EmitCleanupEntry_( byref c as Ctx, byval i as int32 )
    '' THE LOCAL THIS RETURN MOVED OUT is not destroyed on this edge: its bytes are the
    '' caller's object now (RFC 0018 V2, MoveLocalIntoResult_).
    if c.movedOutSlot1 <> 0 then
        if (c.cleanupSlot[i] = c.movedOutSlot1 - 1) andalso EntryDestroysUdt_( c, i ) then return
    end if
    if c.cleanupSlot[i] < 0 then
        '' A bare 'defer' (TKO0828) registered nothing to run -- parser/defer.tiko.
        if c.cleanupNode[i] <> Tko.NODE_NONE then LowerStmt( c, cast( Tko.NodeId, c.cleanupNode[i] ) )
    elseif c.cleanupNode[i] = CLEANUP_DTOR_EPILOGUE then
        '' A DESTRUCTOR'S OWN EPILOGUE -- the fields in reverse, then the base.
        '' Registered as a cleanup action rather than appended after the body,
        '' because a 'return' inside a destructor leaves through here and would
        '' otherwise release nothing. It is registered FIRST, so reverse order runs
        '' it LAST: after every local the body declared.
        ''
        '' The slot holds THIS, which is a POINTER, so it is loaded rather than
        '' having its address taken.
        dim as MirValue ta
        ta.kind = cast( uint8, MV_LOCAL )
        ta.ty = cast( uint8, MT_PTR )
        ta.id = c.cleanupSlot[i]
        dim as MirValue tv = LowerExprLoad( c, ta, MT_PTR )
        if tv.kind <> cast( uint8, MV_NONE ) then
            EmitDtorEpilogue_( c, cast( Tko.TypeId, c.cleanupType[i] ), tv )
        end if
    elseif c.cleanupNode[i] = CLEANUP_DESTROY_ARRAY then
        '' AN ARRAY OF T IS N OBJECTS. The entry names the ARRAY type, which is
        '' where both the element type and the count come from.
        EmitArrayElems_( c, c.cleanupSlot[i], _
                         cast( Tko.TypeId, c.cleanupType[i] ), false )
    elseif c.cleanupNode[i] = CLEANUP_IMPLICIT_DTOR then
        '' THE DESTRUCTOR FBC WRITES FOR YOU. It has no symbol -- there is no
        '' declaration anywhere -- so the entry names the TYPE and the emitted name
        '' comes from that.
        dim as MirValue ia
        ia.kind = cast( uint8, MV_LOCAL )
        ia.ty = cast( uint8, MT_PTR )
        ia.id = c.cleanupSlot[i]
        CallImplicitDtor_( c, cast( Tko.TypeId, c.cleanupType[i] ), ia )
    elseif c.cleanupNode[i] = CLEANUP_DESTRUCT_STR_ARRAY then
        '' A FIXED ARRAY OF VAR-LENGTH STRINGS owns N descriptors, and every one
        '' of them held a buffer nothing was releasing. Measured: fbc builds the
        '' array's descriptor and hands it to fb_ArrayDestructStr -- the same call
        '' ERASE makes over the same shape, which is why the entry carries the
        '' ARRAY type and rebuilds the descriptor here rather than keeping one.
        dim as MirValue sab
        sab.kind = cast( uint8, MV_LOCAL )
        sab.ty = cast( uint8, MT_PTR )
        sab.id = c.cleanupSlot[i]
        dim as MirValue sad
        if SynthFixedArrayDesc( c, sab, _
                                cast( Tko.TypeId, c.cleanupType[i] ), sad ) then
            dim as containers.Array( of uint32 ) saa
            saa.Push( cast( uint32, sad.kind ) )
            saa.Push( cast( uint32, sad.id ) )
            dim as Tko.TypeId sae = _
                c.types->Inner( cast( Tko.TypeId, c.cleanupType[i] ) )
            if IsUStringType( c, sae ) then
                EmitRtl( c, RTL_ARRAY_DESTRUCT_USTR, saa )
            else
                EmitRtl( c, RTL_ARRAY_DESTRUCT_STR, saa )
            end if
        end if
    elseif c.cleanupNode[i] = CLEANUP_WSTR_DELETE then
        '' A WIDE TEMPORARY that must outlive its statement -- a SELECT's subject,
        '' which every case reads -- and still die on a RETURN or EXIT out of a case.
        '' The slot holds the allocation's POINTER, so it is loaded, as
        '' ReleaseWstrTemps_ does.
        dim as MirValue wsa
        wsa.kind = cast( uint8, MV_LOCAL )
        wsa.ty = cast( uint8, MT_PTR )
        wsa.id = c.cleanupSlot[i]
        dim as MirValue wsv = LowerExprLoad( c, wsa, MT_PTR )
        if wsv.kind <> cast( uint8, MV_NONE ) then
            dim as containers.Array( of uint32 ) wsargs
            wsargs.Push( cast( uint32, wsv.kind ) ) : wsargs.Push( cast( uint32, wsv.id ) )
            EmitRtl( c, RTL_WSTR_DELETE, wsargs )
        end if
    elseif c.cleanupNode[i] = CLEANUP_ERASE_ARRAY then
        '' A local DYNAMIC array is erased at scope exit whatever its element
        '' type -- measured; fbc emits fb_ArrayErase / fb_ArrayStrErase /
        '' fb_ArrayEraseObj for every one of them.
        ''
        '' The marker is an IMPOSSIBLE SymbolId rather than a small number.
        '' Cleanup entries are otherwise symbol ids, and 1 is a perfectly valid
        '' one -- using it as a sentinel would have destructed whatever symbol 1
        '' happened to be. That is the pool-confusion mistake this project has
        '' made seven times; not an eighth.
        EmitEraseDynLocal( c, c.cleanupSlot[i] )
    elseif c.cleanupNode[i] = 0 then
        '' A string local is released with fb_StrDelete. This is the
        '' DestroyLocal action the cleanup model was built for and has had
        '' nothing to register until now.
        dim as MirValue addr
        addr.kind = cast( uint8, MV_LOCAL )
        addr.ty = cast( uint8, MT_PTR )
        addr.id = c.cleanupSlot[i]
        dim as containers.Array( of uint32 ) args
        args.Push( cast( uint32, addr.kind ) )
        args.Push( cast( uint32, addr.id ) )
        '' A USTRING IS RELEASED BY fb_UStrDelete. The two descriptors are the same
        '' SIZE, so calling the narrow one on a UTF-16 descriptor lowered, verified
        '' and freed the wrong thing.
        EmitRtl( c, StrRtlFor_( c, c.f->locals[c.cleanupSlot[i]].frontendType, _
                                RTL_STR_DELETE ), args )
    else
        EmitDtorCall( c, cast( Tko.SymbolId, c.cleanupNode[i] ), c.cleanupSlot[i] )
    end if
end sub

'' Emit one scope's actions, innermost registration LAST, without popping: an EXIT or
'' RETURN leaving several scopes needs to run them all and then keep going.
private sub EmitScopeCleanup( byref c as Ctx, byval depth as int32 )
    if (depth < 0) orelse (depth >= c.scopeMark.Count) then return
    dim as int32 from_ = c.scopeMark[depth]
    dim as int32 upto = c.cleanupNode.Count
    if depth + 1 < c.scopeMark.Count then upto = c.scopeMark[depth + 1]
    for i as int32 = upto - 1 to from_ step -1
        EmitCleanupEntry_( c, i )
    next
end sub

'' Every action of every scope from the innermost out to 'outermost', in that order.
'' This is what a RETURN through three scopes needs, and rule 5 of docs/plan/08: a
'' GOTO out of N scopes runs N scopes' cleanups, innermost first.
sub EmitCleanupsTo( byref c as Ctx, byval outermost as int32 )
    for d as int32 = c.scopeMark.Count - 1 to outermost step -1
        EmitScopeCleanup( c, d )
    next
end sub

'' Every action registered from entry 'firstEntry' on, newest first -- what a BACKWARD
'' goto to a label in a scope still open runs: the objects defined after the label, in
'' that scope and in any scope inside it, die before the jump re-runs their definitions.
sub EmitCleanupsFrom( byref c as Ctx, byval firstEntry as int32 )
    if firstEntry < 0 then firstEntry = 0
    for i as int32 = c.cleanupNode.Count - 1 to firstEntry step -1
        EmitCleanupEntry_( c, i )
    next
end sub

private sub PopScope( byref c as Ctx )
    if c.scopeMark.Count = 0 then return
    dim as int32 mark = c.scopeMark[c.scopeMark.Count - 1]
    c.scopeMark.Pop( )
    if c.scopeKey.Count > 0 then c.scopeKey.Pop( )
    '' ALL THREE COLUMNS. The type column was added later and was not popped here, so
    '' it grew for the life of the compilation while the other two shrank -- and every
    '' entry after the first scope read a type belonging to some earlier, unrelated
    '' variable. A local of one type was destroyed by another type's destructor.
    while c.cleanupNode.Count > mark
        c.cleanupNode.Pop( )
        c.cleanupSlot.Pop( )
        if c.cleanupType.Count > mark then c.cleanupType.Pop( )
    wend
end sub

'' A scope that ends by falling out of the bottom runs its own actions and nothing
'' else; the enclosing scopes have not ended.
sub CloseScope( byref c as Ctx )
    EmitScopeCleanup( c, c.scopeMark.Count - 1 )
    PopScope( c )
end sub


'' A CALL'S HIDDEN RESULT OBJECT, destroyed where fbc destroys it.
''
'' Measured: 'print make( ).s' over a type holding a string is
''
''     MAKE( &TMP$3$1 );
''     fb_PrintString( 0, (FBSTRING*)&TMP$3$1, 1 );
''     _ZN1SD1Ev( &TMP$3$1 );
''
'' -- one destructor per call, at the end of the statement. Without it every call
'' returning a string-holding type LEAKED one object, which was recorded and left.
''
'' A LOOP HEAD releases its own before branching, because the condition runs again on
'' every iteration and the slot is reused: waiting for the statement to end would
'' destroy the last one and leak the rest.
'' A TEMPORARY WHOSE CONTENTS HAVE BEEN MOVED OUT is not destroyed: the buffers it
'' held now belong to whatever the bitwise copy wrote them into, and running the
'' destructor would hand that owner freed memory. Measured: 'return (5, "five")'
'' builds the tuple in a temporary and STORES it into the hidden pointer, so with
'' the temporary registered the caller's string was already gone -- 0xC0000374.
sub ForgetUdtTemp_( byref c as Ctx, byval slot as int32 )
    for i as int32 = c.udtTemps.Count - 1 to 0 step -1
        if cast( int32, c.udtTemps[i] ) = slot then
            for k as int32 = i to c.udtTemps.Count - 2
                c.udtTemps[k] = c.udtTemps[k + 1]
                c.udtTempTypes[k] = c.udtTempTypes[k + 1]
            next
            c.udtTemps.Pop( )
            c.udtTempTypes.Pop( )
            return
        end if
    next
end sub

'' THE STRING TEMPORARIES MADE SINCE 'mark', DELETED HERE. Factored out of LowerStmt,
'' which released them at the end of the statement and nowhere else -- so a
'' temporary made inside ONE ARM of an 'iif' was deleted in the JOIN, on the path
'' that never built it. See LowerStringIif_.
sub ReleaseStrTemps_( byref c as Ctx, byval mark as int32 )
    FlushStrCopyBacks( c, mark )
    while c.strTemps.Count > mark
        dim as int32 slot = cast( int32, c.strTemps[c.strTemps.Count - 1] )
        c.strTemps.Pop( )
        '' A dead cursor means the statement ended in a terminator -- a RETURN or
        '' a GOTO -- and anything emitted here would land in no block at all. fbc
        '' has the same hole and leaks the temporary; matching it beats emitting
        '' an instruction with nowhere to go.
        if c.curBlock >= 0 then
            dim as MirValue addr
            addr.kind = cast( uint8, MV_LOCAL )
            addr.ty = cast( uint8, MT_PTR )
            addr.id = slot
            dim as containers.Array( of uint32 ) args
            args.Push( cast( uint32, addr.kind ) ) : args.Push( cast( uint32, addr.id ) )
            EmitRtl( c, StrRtlFor_( c, c.f->locals[slot].frontendType, _
                                    RTL_STR_DELETE ), args )
        end if
    wend
end sub

'' A WIDE temporary's slot holds a POINTER to an allocation, so what is released is
'' the pointer LOADED from it -- not the slot's address, which is where the pointer
'' lives. fbc writes 'fb_WstrDelete( (uint16*)TMP$2$1 )'.
sub ReleaseWstrTemps_( byref c as Ctx, byval mark as int32 )
    while c.wstrTemps.Count > mark
        dim as int32 wslot = cast( int32, c.wstrTemps[c.wstrTemps.Count - 1] )
        c.wstrTemps.Pop( )
        if c.curBlock >= 0 then
            dim as MirValue waddr
            waddr.kind = cast( uint8, MV_LOCAL )
            waddr.ty = cast( uint8, MT_PTR )
            waddr.id = wslot
            dim as MirValue wv = LowerExprLoad( c, waddr, MT_PTR )
            if wv.kind <> cast( uint8, MV_NONE ) then
                dim as containers.Array( of uint32 ) wargs
                wargs.Push( cast( uint32, wv.kind ) ) : wargs.Push( cast( uint32, wv.id ) )
                EmitRtl( c, RTL_WSTR_DELETE, wargs )
            end if
        end if
    wend
end sub

'' ONE UDT OBJECT AT 'addr' DESTROYED: its written destructor, or the synthesised one.
sub DestroyUdtAt_( byref c as Ctx, byval t as Tko.TypeId, byref addr as MirValue )
    dim as Tko.SymbolId dt = StructorWithArity( c, StructorOf( c, t, "__dtor" ), 0 )
    if dt <> Tko.SYMBOL_NONE then
        dim as containers.Array( of uint32 ) none_
        EmitStructorCall( c, dt, -1, @addr, @none_ )
    else
        CallImplicitDtor_( c, t, addr )
    end if
end sub

sub ReleaseUdtTemps_( byref c as Ctx, byval mark as int32 )
    while c.udtTemps.Count > mark
        dim as int32 slot = cast( int32, c.udtTemps[c.udtTemps.Count - 1] )
        dim as Tko.TypeId t = cast( Tko.TypeId, c.udtTempTypes[c.udtTempTypes.Count - 1] )
        c.udtTemps.Pop( )
        c.udtTempTypes.Pop( )
        '' A dead cursor means the statement ended in a terminator, and anything
        '' emitted here would land in no block at all -- the same hole the string
        '' temporaries have, and fbc has it too.
        if c.curBlock >= 0 then
            dim as MirValue a
            a.kind = cast( uint8, MV_LOCAL )
            a.ty = cast( uint8, MT_PTR )
            a.id = slot
            if c.types->IsDynArray( t ) then
                '' AN ARRAY RESULT'S TEMPORARY is erased, not destroyed -- see lowerarrret.tiko.
                EmitEraseDynAt_( c, a, t )
            else
                DestroyUdtAt_( c, t, a )
            end if
        end if
    wend
end sub

'' ---------------------------------------------------- moves (RFC 0018 V2)
''
'' A MOVE IS A RELOCATION. FreeBASIC already moves objects by their bytes -- SWAP and
'' REDIM PRESERVE call no structor (tests/semantic/moves/relocate.bas) -- so where the
'' source cannot be used again, its bytes go to the destination and the source is simply
'' NOT DESTROYED: no copy constructor, no 'let', no destructor for the copy. The source
'' must be one nobody else can reach afterwards: a statement temporary this expression
'' registered, or a local the RETURN being lowered is leaving.

'' Is 'addr' a UDT TEMPORARY OF TYPE t that this expression registered -- on c.udtTemps
'' at or after 'mark'? Only that is an rvalue nobody else holds: a byref-returning call
'' registers nothing, and a temporary of ANOTHER type (an upcast, a field read off a
'' temporary at offset 0) is not the object being asked for.
function UdtTempSince_ _
    ( byref c as Ctx, byval mark as int32, byref addr as MirValue, byval t as Tko.TypeId ) as boolean
    if addr.kind <> cast( uint8, MV_LOCAL ) then return false
    if mark < 0 then mark = 0
    dim as Tko.TypeId ut = c.types->Unqualify( t )
    for k as int32 = mark to c.udtTemps.Count - 1
        if cast( int32, c.udtTemps[k] ) = addr.id then
            return (c.types->Unqualify( cast( Tko.TypeId, c.udtTempTypes[k] ) ) = ut)
        end if
    next
    return false
end function

'' The relocation itself: t's bytes from src to dst, one aggregate load and store. False,
'' with nothing emitted, for a type with no size.
function RelocateUdt_ _
    ( byref c as Ctx, byval t as Tko.TypeId, byref dst as MirValue, byref src as MirValue ) as boolean
    dim as int32 sz = SizeOfType( c, t )
    if sz <= 0 then return false
    dim as MirValue whole = LowerExprLoad( c, src, MT_AGG, sz )
    if whole.kind = cast( uint8, MV_NONE ) then return false
    StoreThrough( c, dst, whole )
    return true
end function

'' DOES ASSIGNING A t RUN ANY 'operator let' SOMEBODY WROTE -- on t, on a base, or on any
'' member at any depth? Then an assignment of a temporary is NOT moved: a written 'let' is
'' code with its own meaning (fbc's own structs/obj_temp2.bas keeps each object's identity
'' through one that does nothing), and C++ never skips a user's assignment operator either.
'' A copy CONSTRUCTOR skipped at a return or an argument is the elision C++ has always
'' allowed; an assignment is not. ANY written 'let' counts, converting ones included --
'' deciding which overload a same-type assignment would pick is not worth being wrong about.
function TypeHasUserLet_( byref c as Ctx, byval t as Tko.TypeId, byval depth as int32 = 0 ) as boolean
    if (t = Tko.TYPE_NONE) orelse (depth > 64) then return false
    t = c.types->Unqualify( t )
    select case c.types->Kind( t )
    case Tko.TK_ARRAY
        return TypeHasUserLet_( c, c.types->Inner( t ), depth + 1 )
    case Tko.TK_UDT, Tko.TK_TUPLE
    case else
        return false
    end select
    if StructorOf( c, t, "let" ) <> Tko.SYMBOL_NONE then return true
    dim as Tko.TypeId bt = c.types->BaseOf( t )
    if (bt <> Tko.TYPE_NONE) andalso (bt <> t) then
        if TypeHasUserLet_( c, bt, depth + 1 ) then return true
    end if
    dim as Tko.Symbol ptr s = c.syms->SymbolAt( UdtSymOf_( c, t ) )
    if s = nullptr then return false
    if s->inner = Tko.SCOPE_NONE then return false
    dim as Tko.SymScope ptr sc = c.syms->ScopeAt( s->inner )
    if sc = nullptr then return false
    dim as Tko.SymbolId cur = sc->firstSym
    dim as int32 guard = 0
    while (cur <> Tko.SYMBOL_NONE) andalso (guard < 100000)
        guard += 1
        dim as Tko.Symbol ptr f = c.syms->SymbolAt( cur )
        if f = nullptr then exit while
        if (f->kind = cast( uint8, Tko.SYM_FIELD )) andalso (f->type_ <> t) then
            if TypeHasUserLet_( c, f->type_, depth + 1 ) then return true
        end if
        cur = f->nextInScope
    wend
    return false
end function

'' 'return r' WHERE r IS A LOCAL OF THIS PROCEDURE: relocate r into the caller's storage
'' and skip r's destructor on this exit edge (c.movedOutSlot1). True when it did.
''
'' THE PROOF THAT r IS AN OWNED LOCAL IS ITS CLEANUP ENTRY. A slot registered to destroy
'' one object of the result's type is a 'dim' of this procedure that is still in scope --
'' a static, a shared, a byref or a byval parameter and 'this' have none, and keep copying
'' (sites.bas C1-C9, M5). A type with no destructor registers nothing and keeps copying
'' too; it owns nothing a move would save. NOT WHEN A DEFER IS PENDING: a deferred
'' statement runs after the return and may still use r, whose bytes are the caller's now.
'' A NAME THAT IS A VARIABLE -- not a parameter, a field, or a paren-less call, which is an
'' N_IDENT too ('return MakeOne'), and whose 'address' would be the procedure's code.
function IsVariableName_( byref c as Ctx, byval id as Tko.NodeId ) as boolean
    if c.ast->Kind( id ) <> Tko.N_IDENT then return false
    dim as Tko.Symbol ptr s = c.syms->SymbolAt( c.info->RefOf( id ) )
    if s = nullptr then return false
    return (s->kind = cast( uint8, Tko.SYM_VARIABLE ))
end function

function MoveLocalIntoResult_ _
    ( byref c as Ctx, byval valueE as Tko.NodeId, byval rt as Tko.TypeId, _
      byref src as MirValue, byref dst as MirValue ) as boolean
    if IsVariableName_( c, valueE ) = false then return false
    if src.kind <> cast( uint8, MV_LOCAL ) then return false
    dim as Tko.TypeId ut = c.types->Unqualify( rt )
    dim as Tko.SymbolId dt = StructorWithArity( c, StructorOf( c, ut, "__dtor" ), 0 )
    dim as boolean found = false
    for i as int32 = 0 to c.cleanupNode.Count - 1
        if c.cleanupSlot[i] < 0 then
            if c.cleanupNode[i] <> Tko.NODE_NONE then return false   '' a pending defer
            continue for
        end if
        if c.cleanupSlot[i] <> src.id then continue for
        if EntryDestroysUdt_( c, i ) = false then return false
        if c.cleanupNode[i] = CLEANUP_IMPLICIT_DTOR then
            if c.types->Unqualify( cast( Tko.TypeId, c.cleanupType[i] ) ) <> ut then return false
        elseif (dt = Tko.SYMBOL_NONE) orelse (cast( Tko.SymbolId, c.cleanupNode[i] ) <> dt) then
            return false
        end if
        found = true
    next
    if found = false then return false
    if RelocateUdt_( c, ut, dst, src ) = false then return false
    '' ...AND r IS ZEROED, so nothing left on the way out shares the caller's buffers. Its
    '' own destructor is skipped, but OTHER cleanups still run after this -- a guard declared
    '' after r whose destructor touches r would otherwise free or rewrite what the caller now
    '' owns. A zeroed FreeBASIC object is an empty one: null pointers, empty strings and
    '' arrays, which is exactly what fbc's own zero-initialisation produces.
    dim as containers.Array( of uint32 ) za
    za.Push( cast( uint32, src.kind ) ) : za.Push( cast( uint32, src.id ) )
    za.Push( cast( uint32, MV_CONST_INT ) ) : za.Push( 0 )
    za.Push( cast( uint32, MV_CONST_INT ) ) : za.Push( cast( uint32, SizeOfType( c, ut ) ) )
    EmitRtl( c, RTL_MEMSET, za )
    c.movedOutSlot1 = src.id + 1
    return true
end function

'' A CALL'S TEMPORARIES, PUT IN THE ORDER FBC MAKES THEM. The arguments are lowered right to
'' left and the receiver last, which is fbc's EVALUATION order, but fbc registers
'' destructors in SOURCE order -- the receiver, the call's hidden result, then each
'' argument left to right with its own temporaries together -- and runs them newest
'' first. Measured:
''
''     mkK( 1 ).m( takeR( mkH( 2 ) ), takeR( mkH( 3 ) ) )    destroys 3, 2, the receiver
''     takeR( mkK( 1 ).mh( takeR( mkH( 2 ) ) ) )             2, the result, the receiver
''     f2( mkH( 1 ) + mkH( 2 ), mkH( 4 ) )                   4, 4, 3, 3, 2, 1
''
'' Everything from 'headMark' on is rewritten in place: the receiver's run (from
'' 'recvMark'), the call's own result (up to 'argMark'), then argument 0's, 1's and so on.
'' 'segFrom[i]' is where argument i's run began; argument 0 was lowered last, so its run
'' ends where the receiver's begins. A list whose marks no longer nest -- something was
'' forgotten out of order -- is left as it is.
sub CallTempsInSourceOrder_ _
    ( byref c as Ctx, byval headMark as int32, byval argMark as int32, _
      byval recvMark as int32, byref segFrom as containers.Array( of uint32 ) )

    dim as int32 n = c.udtTemps.Count
    if n - headMark < 2 then return
    if (headMark > argMark) orelse (argMark > recvMark) orelse (recvMark > n) then return
    dim as int32 prev = recvMark
    for i as int32 = 0 to segFrom.Count - 1
        dim as int32 s = cast( int32, segFrom[i] )
        if (s < argMark) orelse (s > prev) then return
        prev = s
    next

    dim as containers.Array( of uint32 ) ns
    dim as containers.Array( of uint32 ) nt
    for k as int32 = recvMark to n - 1
        ns.Push( c.udtTemps[k] ) : nt.Push( c.udtTempTypes[k] )
    next
    for k as int32 = headMark to argMark - 1
        ns.Push( c.udtTemps[k] ) : nt.Push( c.udtTempTypes[k] )
    next
    for i as int32 = 0 to segFrom.Count - 1
        dim as int32 stop_ = recvMark
        if i > 0 then stop_ = cast( int32, segFrom[i - 1] )
        for k as int32 = cast( int32, segFrom[i] ) to stop_ - 1
            ns.Push( c.udtTemps[k] ) : nt.Push( c.udtTempTypes[k] )
        next
    next
    for k as int32 = 0 to ns.Count - 1
        c.udtTemps[headMark + k] = ns[k]
        c.udtTempTypes[headMark + k] = nt[k]
    next
end sub

end namespace
