'' lowerreassoc.tiko -- FLOAT CONSTANTS ARE REGROUPED THE WAY fbc REGROUPS THEM.
''
'' fbc's AST optimiser rewrites ADD/SUB/MUL chains before any backend sees them, and for
'' SINGLE and DOUBLE the rewrite changes the bits: 'a * 3.3 * 1.7' is 'A * 5.61' in fbc's
'' own C, one ULP from the left-to-right product. HANDOFF 8t/8u has the measured shapes.
'' What is modelled, each measured against fbc before it was written:
''
''   * a constant on the LEFT of '+' or '*' moves right; 'x - c' is 'x + -c'; 'c - x' is
''     '-x + c'; two constants fold -- in DOUBLE, from each literal's own value (a SINGLE
''     literal is its single value, see constfold.bas)
''   * then, over the whole chain, in this order: constant summands are distributed out of
''     a sum that a constant multiplies (bottom-up); constants are accumulated under the
''     nearest '+'/'-'/'*' whose right operand is one, the OUTER constant first; the same
''     again under every '+' and '*'; and '-v + c' becomes 'c - v' for a plain variable
''   * a DIVISION, a NEGATION, a change of type and anything that is not arithmetic stop
''     the accumulation: each is a boundary the passes walk into but never across
''
'' The arithmetic moves, the evaluation does not: every non-constant operand is lowered
'' LEFT TO RIGHT while the chain is built, which is the order fbc's calls run in too.
'' A chain with no constant, or with an operand whose type is not a builtin number, is not
'' taken: the ordinary binary path lowers it exactly as before.

#import "std/containers"
#include once "mir/lowerctx.ti"

namespace Tko.Mir

const RA_LEAF  as long = 0
const RA_CONST as long = 1
const RA_BOP   as long = 2
const RA_NEG   as long = 3

type RaNode
    as long     kind
    as long     op        '' TK_PLUS / TK_MINUS / TK_STAR / TK_SLASH, RA_BOP only
    as long     l = -1    '' RA_BOP, and RA_NEG's operand
    as long     r = -1
    as MirValue v         '' RA_LEAF: already at the chain's type
    as boolean  isVar     '' RA_LEAF: a plain variable, which is all ConstRemNeg rewrites
    as double   cv        '' RA_CONST
end type

type RaTree
    as containers.Array( of RaNode ) nodes
    as MirType ty
end type

'' What one AST node is to the chain. A child is part of the chain only while it is the
'' chain's own arithmetic at the chain's own type; anything else is a boundary.
const RAC_BAD   as long = -1   '' an operand this cannot lower as a number: do not take it
const RAC_LEAF  as long = 0
const RAC_CONST as long = 1
const RAC_BOP   as long = 2
const RAC_NEG   as long = 3
const RAC_PAREN as long = 4

private function RaNumeric_( byref c as Ctx, byval t as Tko.TypeId ) as boolean
    if t = Tko.TYPE_NONE then return false
    dim as Tko.TypeId u = c.types->Unqualify( t )
    if c.types->Kind( u ) <> Tko.TK_BUILTIN then return false
    select case c.types->BuiltinOf( u )
    case Tko.TY_BYTE, Tko.TY_UBYTE, Tko.TY_SHORT, Tko.TY_USHORT, _
         Tko.TY_LONG, Tko.TY_ULONG, Tko.TY_INTEGER, Tko.TY_UINTEGER, _
         Tko.TY_LONGINT, Tko.TY_ULONGINT, Tko.TY_SINGLE, Tko.TY_DOUBLE
        return true
    end select
    return false
end function

'' An integer-typed operand is a constant only as a literal, a named constant or an exact
'' intrinsic ('sgn( -3.3 )', 'cint( 2.5 )' -- measured, both join the accumulation): its
'' own arithmetic is integer arithmetic, which ConstFloatOf would do in double.
private function RaIntConstShape_( byref c as Ctx, byval id as Tko.NodeId ) as boolean
    select case c.ast->Kind( id )
    case Tko.N_INT_LIT, Tko.N_IDENT, Tko.N_CALL
        return true
    case Tko.N_PAREN
        dim as Tko.ListPayload ptr pp = @c.ast->lists[cast( long, c.ast->nodes[cast( long, id )].data )]
        if pp->count <> 1 then return false
        return RaIntConstShape_( c, cast( Tko.NodeId, c.ast->children[pp->first] ) )
    case Tko.N_UNARY
        dim as Tko.UnaryPayload ptr up = @c.ast->unaries[cast( long, c.ast->nodes[cast( long, id )].data )]
        if cast( Tko.TokenKind, up->op ) <> Tko.TK_MINUS then return false
        return RaIntConstShape_( c, up->operand )
    end select
    return false
end function

private function RaClass_ _
    ( byref c as Ctx, byval id as Tko.NodeId, byval mt as MirType, byref d as double ) as long

    dim as Tko.TypeId t = c.info->TypeOf_( id )
    if RaNumeric_( c, t ) = false then return RAC_BAD
    dim as MirType nt = LowerType( t, *c.types )
    dim as boolean isFlt = IsFloatTy( nt )
    if isFlt orelse RaIntConstShape_( c, id ) then
        if Tko.Check.ConstFloatOf( *c.ast, id, d, 0, c.syms, c.info->ScopeOf( id ), c.names ) then
            return RAC_CONST
        end if
    end if
    if nt <> mt then return RAC_LEAF
    select case c.ast->Kind( id )
    case Tko.N_PAREN
        dim as Tko.ListPayload ptr pp = @c.ast->lists[cast( long, c.ast->nodes[cast( long, id )].data )]
        if pp->count = 1 then return RAC_PAREN
    case Tko.N_BINARY
        dim as Tko.BinaryPayload ptr bp = @c.ast->binaries[cast( long, c.ast->nodes[cast( long, id )].data )]
        select case cast( Tko.TokenKind, bp->op )
        case Tko.TK_PLUS, Tko.TK_MINUS, Tko.TK_STAR, Tko.TK_SLASH
            dim as boolean ln = RaNumeric_( c, c.info->TypeOf_( bp->lhs ) )
            dim as boolean rn = RaNumeric_( c, c.info->TypeOf_( bp->rhs ) )
            if ln andalso rn then return RAC_BOP
            return RAC_BAD
        end select
    case Tko.N_UNARY
        dim as Tko.UnaryPayload ptr up = @c.ast->unaries[cast( long, c.ast->nodes[cast( long, id )].data )]
        if cast( Tko.TokenKind, up->op ) = Tko.TK_MINUS then
            if RaNumeric_( c, c.info->TypeOf_( up->operand ) ) then return RAC_NEG
            return RAC_BAD
        end if
    end select
    return RAC_LEAF
end function

private function RaParenInner_( byref c as Ctx, byval id as Tko.NodeId ) as Tko.NodeId
    dim as Tko.ListPayload ptr pp = @c.ast->lists[cast( long, c.ast->nodes[cast( long, id )].data )]
    return cast( Tko.NodeId, c.ast->children[pp->first] )
end function

'' Is the chain worth taking? Needs a constant, a non-constant, and nothing unlowerable.
private sub RaScan_ _
    ( byref c as Ctx, byval id as Tko.NodeId, byval mt as MirType, _
      byref nConst as long, byref nLeaf as long, byref bad as boolean )
    if bad then exit sub
    dim as double d
    select case RaClass_( c, id, mt, d )
    case RAC_BAD   : bad = true
    case RAC_CONST : nConst += 1
    case RAC_LEAF  : nLeaf += 1
    case RAC_PAREN : RaScan_( c, RaParenInner_( c, id ), mt, nConst, nLeaf, bad )
    case RAC_NEG
        dim as Tko.UnaryPayload ptr up = @c.ast->unaries[cast( long, c.ast->nodes[cast( long, id )].data )]
        RaScan_( c, up->operand, mt, nConst, nLeaf, bad )
    case RAC_BOP
        dim as Tko.BinaryPayload ptr bp = @c.ast->binaries[cast( long, c.ast->nodes[cast( long, id )].data )]
        RaScan_( c, bp->lhs, mt, nConst, nLeaf, bad )
        RaScan_( c, bp->rhs, mt, nConst, nLeaf, bad )
    end select
end sub

private function RaNew_( byref t as RaTree, byref n as RaNode ) as long
    t.nodes.Push( n )
    return t.nodes.Count - 1
end function

private function RaConst_( byref t as RaTree, byval d as double ) as long
    dim as RaNode n
    n.kind = RA_CONST
    n.cv = d
    return RaNew_( t, n )
end function

private function RaIsConst_( byref t as RaTree, byval i as long ) as boolean
    return t.nodes[i].kind = RA_CONST
end function

private function RaNeg_( byref t as RaTree, byval x as long ) as long
    if RaIsConst_( t, x ) then return RaConst_( t, -t.nodes[x].cv )
    dim as RaNode n
    n.kind = RA_NEG
    n.l = x
    return RaNew_( t, n )
end function

'' A new 'l op r', normalised as fbc normalises every node it builds.
private function RaBop_ _
    ( byref t as RaTree, byval op as long, byval l as long, byval r as long ) as long
    dim as boolean lc = RaIsConst_( t, l )
    dim as boolean rc = RaIsConst_( t, r )
    if lc andalso rc then
        dim as double a = t.nodes[l].cv
        dim as double b = t.nodes[r].cv
        select case op
        case Tko.TK_PLUS  : return RaConst_( t, a + b )
        case Tko.TK_MINUS : return RaConst_( t, a - b )
        case Tko.TK_STAR  : return RaConst_( t, a * b )
        case else         : return RaConst_( t, a / b )
        end select
    end if
    if lc then
        select case op
        case Tko.TK_PLUS, Tko.TK_STAR
            swap l, r
        case Tko.TK_MINUS
            dim as long nr = RaNeg_( t, r )
            op = Tko.TK_PLUS
            r = l
            l = nr
        end select
    elseif rc andalso (op = Tko.TK_MINUS) then
        op = Tko.TK_PLUS
        r = RaConst_( t, -t.nodes[r].cv )
    end if
    dim as RaNode n
    n.kind = RA_BOP
    n.op = op
    n.l = l
    n.r = r
    return RaNew_( t, n )
end function

'' AST -> tree. Non-constant operands are lowered here, in source order.
private function RaBuild_( byref c as Ctx, byref t as RaTree, byval id as Tko.NodeId ) as long
    dim as double d
    select case RaClass_( c, id, t.ty, d )
    case RAC_CONST
        return RaConst_( t, d )
    case RAC_PAREN
        return RaBuild_( c, t, RaParenInner_( c, id ) )
    case RAC_NEG
        dim as Tko.UnaryPayload ptr up = @c.ast->unaries[cast( long, c.ast->nodes[cast( long, id )].data )]
        dim as long x = RaBuild_( c, t, up->operand )
        if x < 0 then return -1
        return RaNeg_( t, x )
    case RAC_BOP
        dim as Tko.BinaryPayload ptr bp = @c.ast->binaries[cast( long, c.ast->nodes[cast( long, id )].data )]
        dim as long op = cast( long, bp->op )
        dim as Tko.NodeId rhsId = bp->rhs
        dim as long l = RaBuild_( c, t, bp->lhs )
        if l < 0 then return -1
        dim as long r = RaBuild_( c, t, rhsId )
        if r < 0 then return -1
        return RaBop_( t, op, l, r )
    case RAC_LEAF
        dim as MirValue lv = LowerExpr( c, id )
        if lv.kind = cast( ubyte, MV_NONE ) then return -1
        lv = CoerceTy( c, lv, t.ty, c.info->TypeOf_( id ) )
        if lv.kind = cast( ubyte, MV_NONE ) then return -1
        dim as RaNode n
        n.kind = RA_LEAF
        n.v = lv
        if c.ast->Kind( id ) = Tko.N_IDENT then
            dim as Tko.SymbolId sid = c.info->RefOf( id )
            if sid <> Tko.SYMBOL_NONE then
                dim as Tko.Symbol ptr s = c.syms->SymbolAt( sid )
                if s <> 0 then
                    dim as boolean vk = (s->kind = cast( ubyte, Tko.SYM_VARIABLE )) orelse _
                                        (s->kind = cast( ubyte, Tko.SYM_PARAMETER ))
                    n.isVar = vk andalso ((s->flags and Tko.SYMF_BYREF) = 0)
                end if
            end if
        end if
        return RaNew_( t, n )
    end select
    return -1
end function

private function RaIsBop_( byref t as RaTree, byval i as long, byval op as long ) as boolean
    if t.nodes[i].kind <> RA_BOP then return false
    return t.nodes[i].op = op
end function

'' Walks a node's operands with 'pass', storing what comes back.
#macro RA_WALK( pass, t, n )
    if t.nodes[n].l >= 0 then
        dim as long wl = pass( t, t.nodes[n].l )
        t.nodes[n].l = wl
    end if
    if (t.nodes[n].kind = RA_BOP) andalso (t.nodes[n].r >= 0) then
        dim as long wr = pass( t, t.nodes[n].r )
        t.nodes[n].r = wr
    end if
#endmacro

'' ---------------------------------------------------------------- distribution

'' Pulls the constant summands out of a '+' chain, summing them into 'acc'.
private function RaDistSum_( byref t as RaTree, byval n as long, byref acc as long ) as long
    if RaIsBop_( t, n, Tko.TK_PLUS ) = false then return n
    dim as long l = t.nodes[n].l
    dim as long r = t.nodes[n].r
    if RaIsConst_( t, r ) then
        if acc < 0 then acc = r else acc = RaBop_( t, Tko.TK_PLUS, acc, r )
        return RaDistSum_( t, l, acc )
    end if
    dim as long nl = RaDistSum_( t, l, acc )
    t.nodes[n].l = nl
    dim as long nr = RaDistSum_( t, r, acc )
    t.nodes[n].r = nr
    return n
end function

private function RaDistMul_( byref t as RaTree, byval n as long ) as long
    RA_WALK( RaDistMul_, t, n )
    if RaIsBop_( t, n, Tko.TK_STAR ) = false then return n
    dim as long r = t.nodes[n].r
    if RaIsConst_( t, r ) = false then return n
    dim as long acc = -1
    dim as long nl = RaDistSum_( t, t.nodes[n].l, acc )
    t.nodes[n].l = nl
    if acc < 0 then return n
    dim as long prod = RaBop_( t, Tko.TK_STAR, acc, RaConst_( t, t.nodes[r].cv ) )
    return RaBop_( t, Tko.TK_PLUS, n, prod )
end function

'' ---------------------------------------------------------------- accumulation

'' Collects the constant right operands of a '+'/'-' chain into 'acc', the outermost
'' first, inverting under the right side of a '-'.
private function RaAccumAS_ _
    ( byref t as RaTree, byval n as long, byref acc as long, byval sign as long ) as long
    if t.nodes[n].kind <> RA_BOP then return n
    dim as long o = t.nodes[n].op
    if (o <> Tko.TK_PLUS) andalso (o <> Tko.TK_MINUS) then return n
    dim as long l = t.nodes[n].l
    dim as long r = t.nodes[n].r
    dim as long rsign = sign
    if o = Tko.TK_MINUS then rsign = -sign
    if RaIsConst_( t, r ) then
        if acc >= 0 then
            if rsign < 0 then o = iif( o = Tko.TK_PLUS, Tko.TK_MINUS, Tko.TK_PLUS )
            acc = RaBop_( t, o, acc, r )
        else
            acc = r
            if rsign < 0 then acc = RaNeg_( t, acc )
        end if
        return RaAccumAS_( t, l, acc, sign )
    end if
    dim as long nl = RaAccumAS_( t, l, acc, sign )
    t.nodes[n].l = nl
    dim as long nr = RaAccumAS_( t, r, acc, rsign )
    t.nodes[n].r = nr
    return n
end function

private function RaAccumMul_( byref t as RaTree, byval n as long, byref acc as long ) as long
    if RaIsBop_( t, n, Tko.TK_STAR ) = false then return n
    dim as long l = t.nodes[n].l
    dim as long r = t.nodes[n].r
    if RaIsConst_( t, r ) then
        if acc < 0 then acc = r else acc = RaBop_( t, Tko.TK_STAR, acc, r )
        return RaAccumMul_( t, l, acc )
    end if
    dim as long nl = RaAccumMul_( t, l, acc )
    t.nodes[n].l = nl
    dim as long nr = RaAccumMul_( t, r, acc )
    t.nodes[n].r = nr
    return n
end function

'' Under a node whose right operand is a constant.
private function RaAccum1_( byref t as RaTree, byval n as long ) as long
    RA_WALK( RaAccum1_, t, n )
    if t.nodes[n].kind <> RA_BOP then return n
    if RaIsConst_( t, t.nodes[n].r ) = false then return n
    dim as long o = t.nodes[n].op
    dim as long acc = -1
    select case o
    case Tko.TK_PLUS, Tko.TK_MINUS
        n = RaAccumAS_( t, n, acc, 1 )
        if acc >= 0 then n = RaBop_( t, o, n, acc )
    case Tko.TK_STAR
        n = RaAccumMul_( t, n, acc )
        if acc >= 0 then n = RaBop_( t, Tko.TK_STAR, n, acc )
    end select
    return n
end function

'' Under every '+' and '*'.
private function RaAccum2_( byref t as RaTree, byval n as long ) as long
    RA_WALK( RaAccum2_, t, n )
    if t.nodes[n].kind <> RA_BOP then return n
    dim as long acc = -1
    select case t.nodes[n].op
    case Tko.TK_PLUS
        n = RaAccumAS_( t, n, acc, 1 )
        if acc >= 0 then n = RaBop_( t, Tko.TK_PLUS, n, acc )
    case Tko.TK_STAR
        n = RaAccumMul_( t, n, acc )
        if acc >= 0 then n = RaBop_( t, Tko.TK_STAR, n, acc )
    end select
    return n
end function

'' '-v + c' -> 'c - v', for a plain variable only.
private function RaRemNeg_( byref t as RaTree, byval n as long ) as long
    RA_WALK( RaRemNeg_, t, n )
    if RaIsBop_( t, n, Tko.TK_PLUS ) = false then return n
    dim as long l = t.nodes[n].l
    dim as long r = t.nodes[n].r
    if (t.nodes[l].kind <> RA_NEG) orelse (RaIsConst_( t, r ) = false) then return n
    dim as long ll = t.nodes[l].l
    if t.nodes[ll].kind <> RA_LEAF then return n
    if t.nodes[ll].isVar = false then return n
    t.nodes[n].op = Tko.TK_MINUS
    t.nodes[n].l = r
    t.nodes[n].r = ll
    return n
end function

'' ---------------------------------------------------------------- emission

private function RaEmit_( byref c as Ctx, byref t as RaTree, byval n as long ) as MirValue
    dim as MirValue none_
    select case t.nodes[n].kind
    case RA_LEAF
        return t.nodes[n].v
    case RA_CONST
        return ConstFloat( c, t.nodes[n].cv, t.ty )
    case RA_NEG
        dim as MirValue x = RaEmit_( c, t, t.nodes[n].l )
        if x.kind = cast( ubyte, MV_NONE ) then return none_
        dim as MirInst ng
        ng.op = cast( ushort, M_NEG )
        ng.ty = cast( ubyte, t.ty )
        ng.a = x
        return Emit( c, ng )
    case RA_BOP
        dim as MirValue a = RaEmit_( c, t, t.nodes[n].l )
        if a.kind = cast( ubyte, MV_NONE ) then return none_
        dim as MirValue b = RaEmit_( c, t, t.nodes[n].r )
        if b.kind = cast( ubyte, MV_NONE ) then return none_
        dim as MirInst ins
        ins.op = cast( ushort, BinOpFor( cast( Tko.TokenKind, t.nodes[n].op ), t.ty, false ) )
        ins.ty = cast( ubyte, t.ty )
        ins.a = a
        ins.b = b
        return Emit( c, ins )
    end select
    return none_
end function

'' The entry point. False leaves the node to the ordinary binary path, and is only ever
'' answered before anything has been lowered.
function LowerFloatChain _
    ( byref c as Ctx, byval id as Tko.NodeId, byval mt as MirType, byref outv as MirValue ) as boolean

    if IsFloatTy( mt ) = false then return false
    dim as double d
    if RaClass_( c, id, mt, d ) <> RAC_BOP then return false
    dim as long nConst, nLeaf
    dim as boolean bad
    RaScan_( c, id, mt, nConst, nLeaf, bad )
    if bad orelse (nConst = 0) orelse (nLeaf = 0) then return false

    dim as RaTree t
    t.ty = mt
    dim as long root = RaBuild_( c, t, id )
    if root < 0 then
        dim as MirValue none_
        outv = none_
        return true
    end if
    root = RaDistMul_( t, root )
    root = RaAccum1_( t, root )
    root = RaAccum2_( t, root )
    root = RaRemNeg_( t, root )
    outv = RaEmit_( c, t, root )
    return true
end function

end namespace
