'' lowerall.ti -- lowerctx.ti and every cluster header, for a unit that calls into most of
'' them (five or more): one include line in place of lowerctx.ti's, which is what lets a unit
'' at the 1500-line cap take them at all.

#ifndef __TKO_LOWERALL_BI__
#define __TKO_LOWERALL_BI__

#include once "mir/lowerctx.ti"
#include once "mir/lowerstr.ti"
#include once "mir/lowercall.ti"
#include once "mir/lowerstruct.ti"
#include once "mir/lowerctl.ti"
#include once "mir/lowerexpr.ti"
#include once "mir/lowerstore.ti"
#include once "mir/lowerio.ti"
#include once "mir/lowerslice.ti"

#endif
