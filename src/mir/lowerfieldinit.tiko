'' lowerfieldinit.tiko -- 'a as integer = 123' inside a TYPE.
''
'' Split out of lowerimpl.tiko, which the 1500-line cap would not hold both halves of.
'' It belongs beside the synthesised constructor all the same: fbc runs a field's
'' declared value INSIDE the constructor -- implicit or written -- which is what makes
'' one implementation serve 'dim', 'dim shared', a field of another type, an element of
'' an array and 'new' alike.
''
'' The parser recorded the value on the field's node and NOTHING downstream read it
'' back: the field was laid out at the right offset and then initialised by TYPE alone,
'' so 'dim as UDT v' printed whatever the stack held where fbc prints 123, and a SHARED
'' one printed 0. No diagnostic either way.
''
'' WHAT IS NOT DONE, counted rather than hidden: a DYNAMIC ARRAY field, and a nested
'' brace/paren initialiser deeper than one level. The second is not a field limit at
'' all -- 'dim as bar x = ( 111, { ( 222, {1,2,3} ) } )' declines at lower.tiko as a
'' LOCAL too -- and is recorded here only so the decline is not read as one.

#import "std/containers"
#include once "mir/lowerctx.ti"

namespace Tko.Mir

declare function StrSwapKind_ _
    ( byref c as Ctx, byval t as Tko.TypeId, byref n as int64 ) as int32

'' THE '= value' A FIELD WAS DECLARED WITH, or NODE_NONE.
''
'' The parser records it on the N_FIELD payload and Collect records that node on the
'' field symbol, so this is the way back. NOTHING READ IT: 'i as integer = 123' laid
'' out at the right offset and was then initialised by type alone, so 'dim as UDT v'
'' printed whatever the stack held where fbc prints 123 -- and a SHARED one printed 0.
''
'' A BITFIELD IS EXCLUDED because its payload is NOT a node: Resolve overwrites it with
'' the width in bits, and reading that as a node id would index the AST with a 3.
'' The N_FIELD named 'nm' in a type's body, looking into its anonymous nested types.
private function FieldNodeIn_( byref c as Ctx, byval tn as Tko.NodeId, byval nm as Tko.InternId, byval depth as int32 ) as Tko.NodeId
    if (tn = Tko.NODE_NONE) orelse (depth > 8) then return Tko.NODE_NONE
    if c.ast->Kind( tn ) <> Tko.N_TYPE then return Tko.NODE_NONE
    dim as Tko.StmtPayload ptr tp = StmtOf( c, tn )
    for i as int32 = 0 to tp->count - 1
        dim as Tko.NodeId ch = cast( Tko.NodeId, c.ast->children[tp->first + i] )
        if (c.ast->Kind( ch ) = Tko.N_FIELD) andalso (StmtOf( c, ch )->name = nm) then return ch
        if (c.ast->Kind( ch ) = Tko.N_TYPE) andalso (StmtOf( c, ch )->name = 0) then
            dim as Tko.NodeId r = FieldNodeIn_( c, ch, nm, depth + 1 )
            if r <> Tko.NODE_NONE then return r
        end if
    next
    return Tko.NODE_NONE
end function

function FieldInitOf_ _
    ( byref c as Ctx, byval f as Tko.Symbol ptr ) as Tko.NodeId

    if f = 0 then return Tko.NODE_NONE
    '' A BITFIELD'S counts too: the prologue stores it through its unit (BitfieldMemberInit_). Its
    '' 'payload' is its WIDTH (resolve.bas), so its N_FIELD is found in the owning type's body.
    dim as Tko.NodeId n = cast( Tko.NodeId, f->payload )
    if (f->flags and Tko.SYMF_BITFIELD) <> 0 then
        dim as Tko.SymScope ptr fsc = c.syms->ScopeAt( f->parent )
        if fsc = 0 then return Tko.NODE_NONE
        dim as Tko.Symbol ptr ow = c.syms->SymbolAt( fsc->owner )
        if ow = 0 then return Tko.NODE_NONE
        n = FieldNodeIn_( c, cast( Tko.NodeId, ow->declAt ), f->name, 0 )
    end if
    if n = Tko.NODE_NONE then return Tko.NODE_NONE
    if c.ast->Kind( n ) <> Tko.N_FIELD then return Tko.NODE_NONE
    return StmtOf( c, n )->c
end function

'' 'a as T = ANY' -- THE EXPLICIT REQUEST FOR AN UNINITIALISED FIELD, and it suppresses
'' more than a store. Measured, four probes on fbc:
''
''   type t1 : a as long = any : b as long : end type
''       the synthesised constructor memsets ONLY b -- 4 bytes at offset 4, not 8 at 0
''
''   type t3 : a as long = any : b as long = any : end type
''       a constructor is still SYNTHESISED and its body is EMPTY. That is the point:
''       'dim as t3 z' calls it and therefore does NOT memset at the declaration, where
''       a type with no initialisers at all is memset by the CALLER
''
''   type t6 : i as inner = any : ... : end type,  inner having a constructor
''       the constructor is NOT called. 'i' is left alone entirely
''
''   ...but t7's DESTRUCTOR still calls inner's. Construction is suppressed and
''   destruction is not, which is asymmetric and is what fbc does
''
'' So an 'any' field keeps FieldInitOf_ answering non-NONE -- TypeNeedsInit_ reads that,
'' and a constructor must still exist -- while the prologue does nothing for it at all.
''
'' 'any' is a keyword, so no field can be spelled that way and matching the name is safe.
function FieldInitIsAny_( byref c as Ctx, byval id as Tko.NodeId ) as boolean
    if id = Tko.NODE_NONE then return false
    if c.ast->Kind( id ) <> Tko.N_IDENT then return false
    dim as Tko.IdentPayload ptr ip = _
        @c.ast->idents[cast( int32, c.ast->nodes[cast( int32, id )].data )]
    return (Tko.Text.LowerAscii( c.names->Spelling( ip->name ) ) = "any")
end function

'' 'as A a = A( "456" )' -- A CONSTRUCTOR CALL AS A FIELD INITIALISER.
''
'' Measured, and fbc calls the chosen constructor ON THE FIELD ITSELF, building no
'' temporary A at all:
''
''     FBSTRING TMP; memset( &TMP, 0, 24 );
''     fb_StrAssign( &TMP, -1, "456", 4, 0 );
''     _ZN1AC1ER8FBSTRING( (struct $1A*)THIS, &TMP );
''     fb_StrDelete( &TMP );
''
'' -- and A's DEFAULT constructor is NOT called first: the chosen one REPLACES the
'' default initialisation rather than following it. See the matching skip in
'' EmitCtorPrologue_, without which the field is constructed twice and the second run
'' overwrites a string descriptor that already owns a buffer.
''
'' LowerConvCtorInit_ IS NOT THE HELPER, and reaching for it cost a miscompile the first
'' time: with a -1 slot and the field's address it RETURNED TRUE AND EMITTED NOTHING, so
'' _ZN1BC1Ev came out as one dead field.addr and a ret, the field was left uninitialised
'' and the program printed garbage where fbc prints 456. A counted decline had become a
'' silent wrong answer. This is the LowerBaseCtorCall_ shape instead -- lower the
'' arguments, PickCtor over the field type's chain, EmitStructorCall on the field's
'' address -- which is the same machinery 'base( ... )' uses.
'' THE CALL ITSELF, over argument NODES: 'A( "456" )' hands over its list, and a bare
'' '= "456"' hands over the one node. Everything after the argument list is the same.
private function CtorArgsOnAddr_ _
    ( byref c as Ctx, byref addr as MirValue, byval ctors as Tko.SymbolId, _
      byref args as containers.Array( of uint32 ) ) as boolean

    '' Argument VALUES first, then the pick: the types are needed to choose, and the
    '' values must be evaluated in source order whichever overload wins. Same order
    '' LowerBaseCtorCall_ uses, and for the same reason.
    dim as containers.Array( of uint32 ) argT
    dim as containers.Array( of uint32 ) argKind
    dim as containers.Array( of uint32 ) argId
    dim as containers.Array( of uint32 ) strTemps
    dim as containers.Array( of uint32 ) strTempTypes
    for i as int32 = 0 to args.Count - 1
        dim as Tko.NodeId a = cast( Tko.NodeId, args[i] )
        '' A STRING ARGUMENT IS A DESCRIPTOR, not the literal's bytes. 'A( "456" )' over
        '' 'constructor A( byref as string )' passed the literal's global straight
        '' through, so the constructor read a descriptor out of string data and
        '' 'this.s = s' copied nothing -- the program printed an EMPTY line where fbc
        '' prints 456. It lowered, it verified, and only running it said so. fbc builds
        '' a temporary FBSTRING and passes its address.
        ''
        '' ...A REAL ONE, NOT A POOL DESCRIPTOR. This used to borrow one from the runtime
        '' (fb_StrAllocTempDescZEx), and a pool descriptor is released only by a runtime
        '' call that consumes it -- a user constructor that never does leaks the slot.
        '' tracks' grid builds a 'wszText as DWSTRING = ""' per cell, the pool ran dry,
        '' and from then on EVERY temporary string came back empty: '32d' drew as 'd' and
        '' atoi( mid( ... ) ) read the TWS server version as 0. The same rule the call
        '' path follows -- see StrArgOwnDescriptor_: only a var-length lvalue passes its
        '' own descriptor; anything else is assigned into a temporary deleted after the
        '' call, which is fbc's fb_StrAssign / fb_StrDelete pair.
        dim as MirValue av
        dim as Tko.TypeId at = c.info->TypeOf_( a )
        dim as boolean gotArg = false
        if IsStringType( c, at ) then
            if StrArgOwnDescriptor_( c, a, at ) then
                gotArg = StrDescriptorOf_( c, a, av )
            else
                dim as int32 ts = -1
                gotArg = ByvalStrTemp_( c, a, at, av, ts )
                if ts >= 0 then
                    strTemps.Push( cast( uint32, ts ) )
                    strTempTypes.Push( cast( uint32, at ) )
                end if
            end if
        end if
        if gotArg = false then av = LowerExpr( c, a )
        if av.kind = cast( uint8, MV_NONE ) then return false
        argT.Push( cast( uint32, at ) )
        argKind.Push( cast( uint32, av.kind ) )
        argId.Push( cast( uint32, av.id ) )
    next

    dim as Tko.SymbolId pick = PickCtor( c, ctors, argT )
    if pick = Tko.SYMBOL_NONE then return false
    dim as Tko.Symbol ptr ps = c.syms->SymbolAt( pick )
    if ps = 0 then return false
    dim as Tko.NodeId pn = cast( Tko.NodeId, ps->payload )
    if pn = Tko.NODE_NONE then return false

    '' Coerced to the chosen overload's PARAMETER types: MIR has no implicit
    '' conversions, and the overload was picked knowing one would be needed.
    dim as Tko.StmtPayload ptr pp = StmtOf( c, pn )
    dim as int32 ai = 0
    dim as containers.Array( of uint32 ) cargs
    for i as int32 = 0 to pp->count - 1
        dim as Tko.NodeId prm = cast( Tko.NodeId, c.ast->children[pp->first + i] )
        if c.ast->Kind( prm ) <> Tko.N_PARAM then continue for
        if ai >= argT.Count then exit for
        dim as MirValue av
        av.kind = cast( uint8, argKind[ai] )
        av.ty = cast( uint8, LowerType( cast( Tko.TypeId, argT[ai] ), *c.types ) )
        av.id = argId[ai]
        dim as Tko.TypeId pt = c.info->TypeOf_( StmtOf( c, prm )->a )
        '' A NARROW STRING FOR A USTRING PARAMETER IS CONVERTED, into a USTRING temporary
        '' made from the narrow one -- fb_UStrAssignFromA, the call the declaration path
        '' makes through UStrParamArgTemp_. The argument loop above built its temporary at
        '' the ARGUMENT's type, because the pick needs the types, so 'dim shared as T g =
        '' T( "logs/app.log" )' over 'constructor( byref p as ustring )' passed a narrow
        '' descriptor the constructor read as UTF-16: std/logs' FileSink created a file
        '' named with the path's bytes as CJK characters.
        scope
            dim as Tko.TypeId pu = c.types->Unqualify( pt )
            if c.types->Kind( pu ) = Tko.TK_REFERENCE then pu = c.types->Unqualify( c.types->Inner( pu ) )
            dim as Tko.TypeId au = c.types->Unqualify( cast( Tko.TypeId, argT[ai] ) )
            dim as boolean narrowArg = IsStringType( c, au ) andalso (IsUStringType( c, au ) = false)
            '' ...AND A WIDE ONE, through fb_WstrToUStr: 'T( wstr( "x" ) )' handed the wide
            '' literal itself where an FBUSTRING* belongs, and the field came out empty.
            dim as boolean wideArg = IsWideString_( c, au )
            if IsUStringType( c, pu ) andalso (narrowArg orelse wideArg) then
                dim as int32 us = NewTempLocal( c, MT_AGG, c.types->target.stringBytes )
                if us < 0 then return false
                dim as MirValue ud
                ud.kind = cast( uint8, MV_LOCAL ) : ud.ty = cast( uint8, MT_PTR ) : ud.id = us
                ZeroStrDescriptor( c, ud )
                dim as containers.Array( of uint32 ) uargs
                uargs.Push( cast( uint32, ud.kind ) ) : uargs.Push( cast( uint32, ud.id ) )
                PushStrLen_( c, uargs, -1 )
                if wideArg then
                    dim as containers.Array( of uint32 ) wa
                    wa.Push( cast( uint32, av.kind ) ) : wa.Push( cast( uint32, av.id ) )
                    dim as MirValue uv = EmitRtl( c, RTL_WSTR_TO_USTR, wa )
                    if uv.kind = cast( uint8, MV_NONE ) then return false
                    uargs.Push( cast( uint32, uv.kind ) ) : uargs.Push( cast( uint32, uv.id ) )
                    PushStrLen_( c, uargs, -1 )
                    uargs.Push( cast( uint32, MV_CONST_INT ) ) : uargs.Push( 0 )
                    EmitRtl( c, RTL_USTR_ASSIGN, uargs )
                else
                    uargs.Push( cast( uint32, av.kind ) ) : uargs.Push( cast( uint32, av.id ) )
                    PushStrLen_( c, uargs, -1 )
                    uargs.Push( cast( uint32, MV_CONST_INT ) ) : uargs.Push( 0 )
                    uargs.Push( cast( uint32, MV_CONST_INT ) ) : uargs.Push( 0 )
                    EmitRtl( c, RTL_USTR_FROM_A, uargs )
                end if
                strTemps.Push( cast( uint32, us ) )
                strTempTypes.Push( cast( uint32, c.types->Builtin( Tko.TY_USTRING ) ) )
                cargs.Push( cast( uint32, ud.kind ) ) : cargs.Push( cast( uint32, ud.id ) )
                ai += 1
                continue for
            end if
        end scope
        '' A BYREF PARAMETER TAKES AN ADDRESS, and this loop coerced every argument to
        '' the parameter's MIR type instead -- which for a UDT is the AGGREGATE, so the
        '' loaded value went out where the address belongs. See ByrefAggTempOf_ for the
        '' IR and for what the copy costs.
        if (c.ast->nodes[cast( int32, prm )].flags and Tko.NF_BYREF) <> 0 then
            dim as MirValue ba
            if ByrefAggTempOf_( c, av, pt, ba ) then
                cargs.Push( cast( uint32, ba.kind ) ) : cargs.Push( cast( uint32, ba.id ) )
                ai += 1
                continue for
            end if
        end if
        dim as MirValue cv = CoerceTy( c, av, LowerType( pt, *c.types ), pt )
        if cv.kind = cast( uint8, MV_NONE ) then return false
        cargs.Push( cast( uint32, cv.kind ) ) : cargs.Push( cast( uint32, cv.id ) )
        ai += 1
    next
    if ai <> cast( int32, argT.Count ) then return false

    EmitStructorCall( c, pick, -1, @addr, @cargs )

    '' The temporaries die with the call, in reverse -- DeleteStrArgTemps_'s order. That
    '' sub is the call path's own and private to it, so the release is spelled here.
    for k as int32 = strTemps.Count - 1 to 0 step -1
        dim as containers.Array( of uint32 ) dargs
        dargs.Push( cast( uint32, MV_LOCAL ) ) : dargs.Push( strTemps[k] )
        EmitRtl( c, StrRtlFor_( c, cast( Tko.TypeId, strTempTypes[k] ), RTL_STR_DELETE ), dargs )
    next
    return true
end function

function CtorCallOnAddr_ _
    ( byref c as Ctx, byref addr as MirValue, byval ft as Tko.TypeId, _
      byval init as Tko.NodeId ) as boolean

    if c.ast->Kind( init ) <> Tko.N_CALL then return false
    dim as Tko.TypeId ut = c.types->Unqualify( ft )
    if c.types->Kind( ut ) <> Tko.TK_UDT then return false

    dim as Tko.SymbolId ctors = StructorOf( c, ut, "__ctor" )
    if ctors = Tko.SYMBOL_NONE then return false

    dim as Tko.ListPayload ptr cp = _
        @c.ast->lists[cast( int32, c.ast->nodes[cast( int32, init )].data )]
    dim as containers.Array( of uint32 ) args
    for i as int32 = 0 to cp->count - 1
        args.Push( cast( uint32, c.ast->children[cp->first + i] ) )
    next
    return CtorArgsOnAddr_( c, addr, ctors, args )
end function

'' 'host as DWSTRING = "127.0.0.1"' -- A BARE VALUE THAT PICKS A CONVERTING CONSTRUCTOR,
'' or SYMBOL_NONE. Types only, nothing emitted: EmitCtorPrologue_ asks this BEFORE it
'' decides whether to default-construct the field, and the answer has to match what
'' ConvCtorOnAddr_ then does.
''
'' Measured with fbc -gen gcc -r over AfxNova's DWSTRING: a temporary FBSTRING, then
'' _ZN7AFXNOVA8DWSTRINGC1ER8FBSTRINGj on the FIELD, then fb_StrDelete -- and no
'' _ZN7AFXNOVA8DWSTRINGC1Ev before it. The same shape as 'A( "456" )' above, with the
'' value as the one argument. This declined into the aggregate SkipHere instead: the
'' field was default-constructed and the value dropped, so tracks' TWS host was an
'' empty string and it could not connect.
''
'' NOT TAKEN HERE, each left to the path it already had: a paren or tuple list
'' (LowerUdtParenInit_), a call (CtorCallOnAddr_), and a value of the field's own type,
'' which is a copy rather than a conversion.
function FieldConvCtorPick_ _
    ( byref c as Ctx, byval ft as Tko.TypeId, byval init as Tko.NodeId ) as Tko.SymbolId

    if init = Tko.NODE_NONE then return Tko.SYMBOL_NONE
    if FieldInitIsAny_( c, init ) then return Tko.SYMBOL_NONE
    dim as Tko.TypeId ut = c.types->Unqualify( ft )
    if c.types->Kind( ut ) <> Tko.TK_UDT then return Tko.SYMBOL_NONE
    select case c.ast->Kind( init )
    case Tko.N_CALL, Tko.N_TUPLE, Tko.N_PAREN
        return Tko.SYMBOL_NONE
    end select

    dim as Tko.TypeId at = c.info->TypeOf_( init )
    if at = Tko.TYPE_NONE then return Tko.SYMBOL_NONE
    if c.types->Unqualify( at ) = ut then return Tko.SYMBOL_NONE

    dim as Tko.SymbolId ctors = StructorOf( c, ut, "__ctor" )
    if ctors = Tko.SYMBOL_NONE then return Tko.SYMBOL_NONE
    dim as containers.Array( of uint32 ) argT
    argT.Push( cast( uint32, at ) )
    return PickCtor( c, ctors, argT )
end function

private function ConvCtorOnAddr_ _
    ( byref c as Ctx, byref addr as MirValue, byval ft as Tko.TypeId, _
      byval init as Tko.NodeId ) as boolean

    if FieldConvCtorPick_( c, ft, init ) = Tko.SYMBOL_NONE then return false
    dim as containers.Array( of uint32 ) args
    args.Push( cast( uint32, init ) )
    return CtorArgsOnAddr_( c, addr, StructorOf( c, c.types->Unqualify( ft ), "__ctor" ), args )
end function

'' The '= value' stored into one field, after that field's default initialisation.
''
'' fbc runs these inside the constructor -- implicit or written -- which is why they
'' live here rather than at the 'dim' site: 'dim as UDT v', 'dim shared as UDT g' and a
'' UDT FIELD of another UDT all get them from the one place.
''
'' WHAT IS NOT DONE, counted rather than hidden: an aggregate destination -- a string, a
'' fixed or dynamic array, a nested UDT. Each of those is an assignment with a runtime
'' call or an element walk behind it, not a store, and inventing one would compile and
'' be wrong. Those decline, and the decline is counted.
sub EmitFieldInit_ _
    ( byref c as Ctx, byref addr as MirValue, byval ft as Tko.TypeId, _
      byval init as Tko.NodeId )

    if addr.kind = cast( uint8, MV_NONE ) then return
    if init = Tko.NODE_NONE then return
    '' Belt and braces: the prologue skips an 'any' field before it gets here, and
    '' emitting a store for one would be a miscompile rather than a decline.
    if FieldInitIsAny_( c, init ) then return

    '' A STRING FIELD IS ASSIGNED, not stored: the descriptor InitMember_ has just
    '' zeroed owns its buffer, and fb_StrAssign is what fills it. A FIXED-LENGTH one
    '' is bytes with no terminator and goes through the zstring path instead.
    '' StrSwapKind_ RATHER THAN IsStringType, and the difference is the whole point:
    '' 'zstring * 8' is an ARRAY of TY_ZSTRING and IsStringType says no to it, so a
    '' declared 'a as zstring * 8 = "abc"' went to the aggregate decline below and the
    '' field stayed empty where fbc prints abc.
    dim as int64 sn = 0
    dim as int32 sk = StrSwapKind_( c, ft, sn )
    if sk >= 0 then
        '' A USTRING FIELD TAKES THE UTF-16 ENTRY POINTS, and it is decided before the
        '' narrow arms below claim it. 'sym as ustring = "VIX"' went to fb_StrAssign --
        '' narrow bytes in a UTF-16 descriptor -- and read back as bytes E4 A5 96 58 plus
        '' whatever followed: tracks sent that to TWS as the VIX symbol. Measured, fbc writes
        '' 'fb_UStrInit( THIS, -1, (uint16[]){ 'V','I','X',0 }, ... )', the same call a
        '' local 'dim as ustring u = "VIX"' already made here. The descriptor is zeroed by
        '' InitMember_ first, so this is the assignment form; a term that is not neutral
        '' or UTF-16 converts, as it does for a local -- see LowerStringInitToSlot.
        if (sk = 0) andalso IsUStringType( c, ft ) then
            dim as int32 tfU = StrTermFlavour_( c, init )
            if (tfU <> STF_NEUTRAL) andalso (tfU <> STF_UTF16) then
                if LowerStrConvertTerm( c, addr, true, init, false ) = false then SkipHere( c )
                return
            end if
            dim as containers.Array( of uint32 ) uargs
            PushStrArg( uargs, addr )
            if EmitStrTerm( c, uargs, init, true ) = false then
                SkipHere( c )
                return
            end if
            uargs.Push( cast( uint32, MV_CONST_INT ) )
            uargs.Push( cast( uint32, 0 ) )
            EmitRtl( c, RTL_USTR_ASSIGN, uargs )
            return
        end if
        '' A WIDE SOURCE INTO A NARROW DESTINATION IS ITS OWN CALL, and it is tried
        '' first for both flavours: 'k as string = wstr( "fOoBaR" )' has no narrow term
        '' for the concatenation path to find, so it declined and the field stayed
        '' empty where fbc prints fOoBaR.
        '' ...AND A WIDE CHAIN, which Check types STRING: see IsWideChain_.
        if (sk <> 2) andalso (TermIsWide_( c, init ) orelse IsWideChain_( c, init )) then
            if LowerWideToNarrowSlot( c, -1, ft, init, true, @addr ) then return
        end if
        if sk = 0 then
            dim as containers.Array( of uint32 ) sargs
            PushStrArg( sargs, addr )
            if EmitStrTerm( c, sargs, init ) = false then
                SkipHere( c )
                return
            end if
            sargs.Push( cast( uint32, MV_CONST_INT ) )
            sargs.Push( cast( uint32, 0 ) )
            EmitRtl( c, RTL_STR_ASSIGN, sargs )
            return
        end if
        if (sk = 1) orelse (sk = 3) orelse (sk = 4) then
            if LowerZstrAssignTo( c, addr, sn, init, true, (sk = 4) ) then return
        end if
        '' 'wstring * N' -- its own runtime call again, and its own element count.
        dim as int32 wn = WideStringElems( c, ft )
        if wn > 0 then
            if LowerWideAssignTo( c, addr, wn, init ) then return
        end if
        SkipHere( c )
        return
    end if

    '' 'f1(0 to 2) as ubyte = { 1, 2, 3 }' -- A BRACE LIST OVER A FIXED ARRAY FIELD,
    '' which is the same element-by-element walk a local array declaration does. The
    '' only thing that differed was the destination: LowerArrayInit took a frame SLOT,
    '' and a field has an address instead. It takes both now, as the UDT-array path
    '' already did for a static local.
    ''
    '' A FIXED-LENGTH STRING is an array too and was answered above, by StrSwapKind_,
    '' before reaching this.
    if (c.types->IsDynArray( ft ) = false) andalso _
       (c.types->Kind( ft ) = Tko.TK_ARRAY) then
        if LowerArrayInit( c, -1, ft, init, @addr ) then return
        SkipHere( c )
        return
    end if

    '' 'f as Inner = ( 1, 2 )' -- A PAREN FIELD LIST OVER A UDT FIELD, which is the
    '' same walk 'dim as Inner x = ( 1, 2 )' does and takes an address already: the
    '' static-local path needed one first.
    if c.types->Kind( c.types->Unqualify( ft ) ) = Tko.TK_UDT then
        if LowerUdtParenInit_( c, -1, ft, init, @addr ) then return
        if CtorCallOnAddr_( c, addr, ft, init ) then return
        if ConvCtorOnAddr_( c, addr, ft, init ) then return
    end if

    dim as MirType mt = LowerType( ft, *c.types )
    dim as boolean aggregate_ = (mt = MT_VOID) orelse (mt = MT_AGG)
    if aggregate_ = false then aggregate_ = c.types->IsDynArray( ft )
    if aggregate_ = false then aggregate_ = (c.types->Kind( ft ) = Tko.TK_ARRAY)
    if aggregate_ then
        SkipHere( c )
        return
    end if

    dim as MirValue v = LowerExpr( c, init )
    if v.kind = cast( uint8, MV_NONE ) then
        SkipHere( c )
        return
    end if
    v = CoerceTy( c, v, mt, c.info->TypeOf_( init ), ft )
    if v.kind = cast( uint8, MV_NONE ) then return
    dim as MirInst st
    st.op = cast( uint16, M_STORE )
    st.ty = cast( uint8, MT_VOID )
    st.a = addr
    st.b = v
    Emit( c, st )
end sub

end namespace
