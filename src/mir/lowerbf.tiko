'' lowerbf.tiko -- BITFIELDS: reading one, writing one, and the compound form.
''
'' Split out of lowerintr.tiko at the 1500-line lint cap. A bitfield is bits inside a
'' unit its neighbours share, so it has no address of its own: every access is a read
'' of the whole unit, a shift and a mask.

#import "std/containers"
#include once "mir/lowerctx.ti"
#include once "mir/lowercall.ti"
#include once "mir/lowerstruct.ti"
#include once "mir/lowerexpr.ti"

namespace Tko.Mir

'' Declared in lowerctx.ti now that SWAP needs it too.
declare function BitfieldStoreParts_ _
    ( byref c as Ctx, byref addr as MirValue, byval bitOff as int32, _
      byval bitWidth as int32, byval unitTy as MirType, byval unitUns as boolean, _
      byref val as MirValue ) as boolean

'' FIELD fi's UNIT: its byte offset, the field's bit offset and width inside it, the unit's
'' MIR type and signedness. Shared by an access through a member expression (BitfieldParts)
'' and an initialiser that names fields by position (BitfieldFieldStore_).
private function BitfieldUnit_ _
    ( byref c as Ctx, byval fi as int32, byval ftype as Tko.TypeId, byref off as int32, _
      byref bitOff as int32, byref bitWidth as int32, byref unitTy as MirType, _
      byref unitUnsigned as boolean ) as boolean

    off = c.udts->fields[fi].offset
    bitOff = c.udts->fields[fi].bitOffset
    bitWidth = c.udts->fields[fi].bitWidth
    dim as int32 uOff = c.udts->fields[fi].unitOffset
    dim as int32 uLen = c.udts->fields[fi].unitBytes
    if bitWidth <= 0 then return false
    unitTy = LowerType( ftype, *c.types )
    if (unitTy = MT_VOID) orelse (unitTy = MT_AGG) then return false
    '' THE UNIT IS ADDRESSED AT ITS OWN START, not at the field's byte: reading a
    '' four-byte unit from byte 1 of a four-byte structure runs one byte past it, and
    '' writing it rewrites whatever follows. fbc addresses the unit and shifts.
    '' THE RUN'S OWN UNIT when the layout recorded one: the field's type at its aligned
    '' byte cannot hold 'b' in 'ulong a:5, ushort b:12', nor 'd' in 'field=1 : ubyte
    '' a:7, ushort d:10' -- 4095 read back 127 and 1023 read 255.
    dim as int32 usz = c.types->Layout( ftype ).size
    if (uLen = 1) orelse (uLen = 2) orelse (uLen = 4) orelse (uLen = 8) then
        bitOff += (off - uOff) * 8
        off = uOff
        select case uLen
        case 1 : unitTy = MT_I8
        case 2 : unitTy = MT_I16
        case 4 : unitTy = MT_I32
        case else : unitTy = MT_I64
        end select
    elseif usz > 0 then
        dim as int32 unitStart = (off \ usz) * usz
        bitOff += (off - unitStart) * 8
        off = unitStart
    end if
    '' The unit widens to 64 bits by its DECLARED signedness. fbc writes
    '' '(int64)*(uint32*)&A', which zero-extends; sign-extending a ULONG unit whose
    '' top bit is set drags ones down into the shift.
    unitUnsigned = IsUnsignedType( c, ftype )
    return true
end function

'' The unit is addressed at the field's byte offset and read at the field's DECLARED
'' type -- which is what sizes the unit, not what sizes the field.
function BitfieldParts _
    ( byref c as Ctx, byval id as Tko.NodeId, byref addr as MirValue, _
      byref bitOff as int32, byref bitWidth as int32, byref unitTy as MirType, _
      byref unitUnsigned as boolean ) as boolean

    if c.ast->Kind( id ) <> Tko.N_MEMBER then return false
    dim as Tko.SymbolId fsym = c.info->RefOf( id )
    dim as Tko.Symbol ptr fs = c.syms->SymbolAt( fsym )
    if fs = nullptr then return false
    if (fs->flags and Tko.SYMF_BITFIELD) = 0 then return false

    dim as Tko.BinaryPayload ptr mp = _
        c.ast->BinaryOf( id )
    dim as Tko.TypeId bt = c.info->TypeOf_( mp->lhs )
    dim as MirValue base_
    if bt <> Tko.TYPE_NONE then
        if c.types->Kind( bt ) = Tko.TK_POINTER then
            base_ = LowerExpr( c, mp->lhs )
            bt = c.types->Inner( bt )
        else
            base_ = LowerAddr( c, mp->lhs )
        end if
    end if
    if base_.kind = cast( uint8, MV_NONE ) then return false

    dim as int32 ui = c.udts->Find( bt )
    if ui < 0 then return false
    dim as int32 off = 0
    dim as int32 fi = c.udts->FieldIndexIn( ui, fs->name )
    if fi < 0 then return false
    if BitfieldUnit_( c, fi, fs->type_, off, bitOff, bitWidth, unitTy, unitUnsigned ) = false then return false
    dim as MirInst fa
    fa.op = cast( uint16, M_FIELD_ADDR )
    fa.ty = cast( uint8, MT_PTR )
    fa.a = base_
    fa.imm = off
    addr = Emit( c, fa )
    return (addr.kind <> cast( uint8, MV_NONE ))
end function

'' Read a bitfield. Measured from fbc's own C, for a 3-bit field at bit 1:
''
''     V = (int32)((uint64)((int64)*(int32*)&T >> (1ll & 63ll)) & 7ull);
''
'' Widen the unit to 64 bits, shift the field down, mask it -- and NO SIGN EXTENSION,
'' even for a signed declared type: fbc reads a 3-bit 'as long' holding all ones as 7,
'' not as -1. Measured, not assumed; it is the one part of this a C habit gets wrong.
'' The exception is a signed field of an 'extern "c"' record, which reads as C does.
declare function BitfieldReadParts_ _
    ( byref c as Ctx, byval id as Tko.NodeId, byref addr as MirValue, byval bitOff as int32, byval bitWidth as int32, _
      byval unitTy as MirType, byval unitUns as boolean, byref outv as MirValue ) as boolean
function LowerBitfieldRead _
    ( byref c as Ctx, byval id as Tko.NodeId, byref outv as MirValue ) as boolean

    dim as MirValue addr
    dim as int32 bitOff, bitWidth
    dim as MirType unitTy
    dim as boolean unitUns
    if BitfieldParts( c, id, addr, bitOff, bitWidth, unitTy, unitUns ) = false then
        return false
    end if
    return BitfieldReadParts_( c, id, addr, bitOff, bitWidth, unitTy, unitUns, outv )
end function

'' The read, from parts already lowered -- BitfieldCompound_ reads and writes through ONE address.
private function BitfieldReadParts_ _
    ( byref c as Ctx, byval id as Tko.NodeId, byref addr as MirValue, byval bitOff as int32, byval bitWidth as int32, _
      byval unitTy as MirType, byval unitUns as boolean, byref outv as MirValue ) as boolean

    dim as MirValue raw = LowerExprLoad( c, addr, unitTy )
    if raw.kind = cast( uint8, MV_NONE ) then return false
    dim as MirValue wide = Coerce( c, raw, MT_I64, unitUns )

    '' A SIGNED FIELD OF AN 'extern "c"' RECORD SIGN-EXTENDS, as C does: Check types it
    '' INTEGER (every other bitfield is UINTEGER, or BYTE for a boolean), so that type is
    '' the test. Shift the field's top bit up to bit 63, then arithmetically back down:
    '' -1 stored in 'x : 3 as long' reads -1, where fbc's zero extension reads 7.
    dim as Tko.TypeId nty = c.info->TypeOf_( id )
    if (nty <> Tko.TYPE_NONE) andalso (c.types->Kind( nty ) = Tko.TK_BUILTIN) then
        if c.types->BuiltinOf( nty ) = Tko.TY_INTEGER then
            dim as int32 up = 64 - bitOff - bitWidth
            if up > 0 then
                dim as MirInst sl
                sl.op = cast( uint16, M_SHL )
                sl.ty = cast( uint8, MT_I64 )
                sl.a = wide
                sl.b = ConstInt( c, up, MT_I64 )
                wide = Emit( c, sl )
                if wide.kind = cast( uint8, MV_NONE ) then return false
            end if
            if bitWidth < 64 then
                dim as MirInst sr
                sr.op = cast( uint16, M_ASHR )
                sr.ty = cast( uint8, MT_I64 )
                sr.a = wide
                sr.b = ConstInt( c, 64 - bitWidth, MT_I64 )
                wide = Emit( c, sr )
                if wide.kind = cast( uint8, MV_NONE ) then return false
            end if
            outv = Coerce( c, wide, MT_I64 )
            return true
        end if
    end if

    if bitOff > 0 then
        dim as MirInst sh
        sh.op = cast( uint16, M_ASHR )
        sh.ty = cast( uint8, MT_I64 )
        sh.a = wide
        sh.b = ConstInt( c, bitOff, MT_I64 )
        wide = Emit( c, sh )
        if wide.kind = cast( uint8, MV_NONE ) then return false
    end if

    dim as MirInst an
    an.op = cast( uint16, M_AND )
    an.ty = cast( uint8, MT_I64 )
    an.a = wide
    an.b = ConstInt( c, BitMask_( bitWidth ), MT_I64 )
    dim as MirValue masked = Emit( c, an )
    if masked.kind = cast( uint8, MV_NONE ) then return false

    '' A BOOLEAN BITFIELD READS AS A BOOLEAN: set, it is -1, not 1. 'a : 1 as boolean' then
    '' 'x.a = true' and 'dim k as integer = x.a' gave 1, '( x.a = true )' gave 0 and 'if
    '' x.a = -1' was not taken; fbc says -1 to all three. The bit is negated.
    dim as Tko.Symbol ptr bfs = c.syms->SymbolAt( c.info->RefOf( id ) )
    if bfs <> nullptr then
        dim as Tko.TypeId bft = c.types->Unqualify( bfs->type_ )
        if c.types->Kind( bft ) = Tko.TK_BUILTIN then
            if c.types->BuiltinOf( bft ) = Tko.TY_BOOLEAN then
                dim as MirInst ng
                ng.op = cast( uint16, M_NEG )
                ng.ty = cast( uint8, MT_I64 )
                ng.a = masked
                masked = Emit( c, ng )
                if masked.kind = cast( uint8, MV_NONE ) then return false
            end if
        end if
    end if

    '' At the NODE's type, which Check makes UINTEGER for every bitfield -- not at the
    '' unit's. The masked value is never negative, so the widening is exact.
    dim as MirType rty = LowerType( c.info->TypeOf_( id ), *c.types )
    if (rty = MT_VOID) orelse (rty = MT_AGG) then rty = unitTy
    outv = Coerce( c, masked, rty )
    return true
end function

'' Write a bitfield: read the unit, clear the field's bits, or the value in, store back.
''
''     *(uint32*)&A = (uint32)((uint64)((int64)*(uint32*)&A & -15ll) | 10ull);
''
'' -15 is the complement of (7 shl 1) -- the mask for a 3-bit field at bit 1 -- and 10
'' is (5 and 7) shl 1, which fbc has constant-folded. The read-modify-write is what
'' keeps the neighbours packed in the same unit intact, and is the whole reason an
'' ordinary full-width store could not be used here.
'' 'x.a op= v' OVER A BITFIELD: read it, apply the operator, write it back through the
'' masked store the plain assignment already uses.
function BitfieldCompound_ _
    ( byref c as Ctx, byval target as Tko.NodeId, byval value as Tko.NodeId, _
      byval bop as Tko.TokenKind ) as boolean

    dim as MirValue probe
    dim as int32 bo, bw
    dim as MirType ut
    dim as boolean uu
    if BitfieldParts( c, target, probe, bo, bw, ut, uu ) = false then return false

    '' The READ is the ordinary one, and the arithmetic happens in it: a bitfield is
    '' never wider than its declared type, so the unit's type is the working type.
    '' THROUGH THE PROBE'S ADDRESS, read and write alike: 'f( ).a += 1' evaluated f( ) three times --
    '' the probe, the read and the store each lowered the base (expressions/selfbops.bas); fbc once.
    dim as MirValue cur
    if BitfieldReadParts_( c, target, probe, bo, bw, ut, uu, cur ) = false then return false
    dim as MirValue rhs = LowerExprN_( c, value )
    if rhs.kind = cast( uint8, MV_NONE ) then return false
    dim as boolean uns = IsUnsignedType( c, c.info->TypeOf_( target ) )
    cur = Coerce( c, cur, MT_I64, uns )
    rhs = CoerceTy( c, rhs, MT_I64, NumSrcType_( c, value ))

    dim as MirValue res
    if (bop = Tko.KW_IMP) orelse (bop = Tko.KW_EQV) then
        res = EmitImpEqv_( c, bop, MT_I64, cur, rhs )
    else
        dim as MirOp mop = BinOpFor( bop, MT_I64, uns )
        if mop = M_NONE then return false
        dim as MirInst bi
        bi.op = cast( uint16, mop )
        bi.ty = cast( uint8, MT_I64 )
        bi.a = cur
        bi.b = rhs
        res = Emit( c, bi )
    end if
    if res.kind = cast( uint8, MV_NONE ) then return false
    return BitfieldStoreParts_( c, probe, bo, bw, ut, uu, res )
end function

function LowerBitfieldStore _
    ( byref c as Ctx, byval id as Tko.NodeId, byval value as Tko.NodeId ) as boolean

    dim as MirValue addr
    dim as int32 bitOff, bitWidth
    dim as MirType unitTy
    dim as boolean unitUns
    if BitfieldParts( c, id, addr, bitOff, bitWidth, unitTy, unitUns ) = false then
        return false
    end if

    dim as MirValue val = LowerNumArg_( c, value, MT_I64 )
    if val.kind = cast( uint8, MV_NONE ) then return false
    return BitfieldStoreParts_( c, addr, bitOff, bitWidth, unitTy, unitUns, val )
end function

'' The same store from a VALUE that is already lowered, which is what the compound
'' form has: it has read the field and applied the operator itself.
function LowerBitfieldStoreValue_ _
    ( byref c as Ctx, byval id as Tko.NodeId, byref val as MirValue ) as boolean

    dim as MirValue addr
    dim as int32 bitOff, bitWidth
    dim as MirType unitTy
    dim as boolean unitUns
    if BitfieldParts( c, id, addr, bitOff, bitWidth, unitTy, unitUns ) = false then
        return false
    end if
    return BitfieldStoreParts_( c, addr, bitOff, bitWidth, unitTy, unitUns, val )
end function

'' FIELD fi OF THE OBJECT AT base_, a bitfield, from a value already lowered to i64 -- what
'' an initialiser naming fields by position has (lowerudtlit.tiko BitfieldParenInit_).
function BitfieldFieldStore_ _
    ( byref c as Ctx, byref base_ as MirValue, byval fi as int32, byref val as MirValue ) as boolean

    dim as int32 off, bitOff, bitWidth
    dim as MirType unitTy
    dim as boolean unitUns
    if BitfieldUnit_( c, fi, c.udts->fields[fi].type_, off, bitOff, bitWidth, unitTy, unitUns ) = false then
        return false
    end if
    dim as MirInst fa
    fa.op = cast( uint16, M_FIELD_ADDR )
    fa.ty = cast( uint8, MT_PTR )
    fa.a = base_
    fa.imm = off
    dim as MirValue addr = Emit( c, fa )
    if addr.kind = cast( uint8, MV_NONE ) then return false
    return BitfieldStoreParts_( c, addr, bitOff, bitWidth, unitTy, unitUns, val )
end function

private function BitfieldStoreParts_ _
    ( byref c as Ctx, byref addr as MirValue, byval bitOff as int32, _
      byval bitWidth as int32, byval unitTy as MirType, byval unitUns as boolean, _
      byref val as MirValue ) as boolean

    dim as MirValue raw = LowerExprLoad( c, addr, unitTy )
    if raw.kind = cast( uint8, MV_NONE ) then return false
    dim as MirValue wide = Coerce( c, raw, MT_I64, unitUns )

    dim as int64 mask = BitMask_( bitWidth )

    dim as MirInst cl
    cl.op = cast( uint16, M_AND )
    cl.ty = cast( uint8, MT_I64 )
    cl.a = wide
    cl.b = ConstInt( c, not (mask shl bitOff), MT_I64 )
    dim as MirValue cleared = Emit( c, cl )
    if cleared.kind = cast( uint8, MV_NONE ) then return false

    dim as MirInst vm
    vm.op = cast( uint16, M_AND )
    vm.ty = cast( uint8, MT_I64 )
    vm.a = val
    vm.b = ConstInt( c, mask, MT_I64 )
    dim as MirValue vmasked = Emit( c, vm )
    if vmasked.kind = cast( uint8, MV_NONE ) then return false

    if bitOff > 0 then
        dim as MirInst sh
        sh.op = cast( uint16, M_SHL )
        sh.ty = cast( uint8, MT_I64 )
        sh.a = vmasked
        sh.b = ConstInt( c, bitOff, MT_I64 )
        vmasked = Emit( c, sh )
        if vmasked.kind = cast( uint8, MV_NONE ) then return false
    end if

    dim as MirInst orr
    orr.op = cast( uint16, M_OR )
    orr.ty = cast( uint8, MT_I64 )
    orr.a = cleared
    orr.b = vmasked
    dim as MirValue merged = Emit( c, orr )
    if merged.kind = cast( uint8, MV_NONE ) then return false

    dim as MirInst st
    st.op = cast( uint16, M_STORE )
    st.ty = cast( uint8, MT_VOID )
    st.a = addr
    st.b = Coerce( c, merged, unitTy )
    Emit( c, st )
    return true
end function


'' A BITFIELD MEMBER IN THE CONSTRUCTOR PROLOGUE: its initialiser -- or 0 -- through its unit.
'' 'f1:8 as integer = 11' took the ordinary path, which stores a field's whole declared width
'' at its address, so the unit came out 0 0 0 0 where fbc reads 11 22 33 44
'' (structs/ctor_bitfield.bas); a per-field zero fill would clobber its neighbours the same way.
'' False when 'f' is not a bitfield, so the caller carries on.
function BitfieldMemberInit_ _
    ( byref c as Ctx, byref thisPtr as MirValue, byval t as Tko.TypeId, _
      byval f as Tko.Symbol ptr, byval init as Tko.NodeId ) as boolean
    if (f = nullptr) orelse ((f->flags and Tko.SYMF_BITFIELD) = 0) then return false
    dim as int32 ui = c.udts->Find( t )
    if ui < 0 then return false
    dim as int32 fi = c.udts->FieldIndexIn( ui, f->name )
    if fi < 0 then return false
    dim as MirValue v = ConstInt( c, 0, MT_I64 )
    if init <> Tko.NODE_NONE then v = LowerNumArg_( c, init, MT_I64 )
    if v.kind = cast( uint8, MV_NONE ) then return false
    if BitfieldFieldStore_( c, thisPtr, fi, v ) = false then SkipHere( c )
    return true
end function


'' 'swap a, b' WHERE EITHER IS A BITFIELD, each side's base lowered ONCE: its unit address is taken
'' for the read and reused for the write. 'swap f2( ).a, f2( ).b' called f2 four times -- the
'' read and the store each lowered the target -- where fbc calls it twice (swap/sidefx.bas).
'' Everything is read before anything is written: the two may share a unit. False, emitting
'' nothing, when neither side is a bitfield.
function BitfieldSwapOnce_( byref c as Ctx, byval a as Tko.NodeId, byval b as Tko.NodeId ) as boolean
    dim as MirValue aAd, bAd, av, bv
    dim as int32 aBo, aBw, bBo, bBw
    dim as MirType aUt, bUt
    dim as boolean aUu, bUu
    dim as boolean aBf = BitfieldParts( c, a, aAd, aBo, aBw, aUt, aUu )
    if aBf then if BitfieldReadParts_( c, a, aAd, aBo, aBw, aUt, aUu, av ) = false then return false
    dim as boolean bBf = BitfieldParts( c, b, bAd, bBo, bBw, bUt, bUu )
    if bBf then if BitfieldReadParts_( c, b, bAd, bBo, bBw, bUt, bUu, bv ) = false then return false
    if (aBf orelse bBf) = false then return false
    if aBf = false then
        av = LowerExpr( c, a ) : if av.kind = cast( uint8, MV_NONE ) then return false
    end if
    if bBf = false then
        bv = LowerExpr( c, b ) : if bv.kind = cast( uint8, MV_NONE ) then return false
    end if
    if aBf then
        if BitfieldStoreParts_( c, aAd, aBo, aBw, aUt, aUu, Coerce( c, bv, MT_I64, false ) ) = false then return false
    else
        dim as MirValue aa = LowerAddr( c, a ) : if aa.kind = cast( uint8, MV_NONE ) then return false
        StoreThrough( c, aa, bv )
    end if
    if bBf then
        if BitfieldStoreParts_( c, bAd, bBo, bBw, bUt, bUu, Coerce( c, av, MT_I64, false ) ) = false then return false
    else
        dim as MirValue ba = LowerAddr( c, b ) : if ba.kind = cast( uint8, MV_NONE ) then return false
        StoreThrough( c, ba, av )
    end if
    return true
end function

end namespace
