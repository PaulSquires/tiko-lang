'' verify.tiko -- the structural rules MIR must satisfy.
''
'' The rules implemented here are the ones this slice of phase 6 can check. The two
'' that matter most and are NOT here yet are dominance ("every value is defined before
'' use, in a dominating block") and cleanup-edge coverage ("every scope-exit edge
'' passes through its cleanup block") -- the second is the rule docs/plan/09 calls the
'' one that pays for the whole verifier, and it cannot be checked before the cleanup
'' model exists. Claiming a verifier is complete when it is not would be worse than
'' having none, so the gaps are listed rather than glossed.

#import "std/containers"
#include once "mir/verify.ti"

namespace Tko.Mir

private sub Fail _
    ( byref r as VerifyResult, byref where_ as string, byref why as string )

    r.failures += 1
    r.report += "  " & where_ & ": " & why & chr( 10 )
end sub

'' A VALUE THAT NAMES A TEMP MUST NAME ONE IN RANGE AND ALREADY PRODUCED. The range half
'' is new (audit F-45): a temp id past the function's counter indexed past 'defined_'.
'' WHERE AN INSTRUCTION IS, for a failure's message -- 'fn:block:index op'. Spelled only when
'' something fails: built for every instruction up front, it was a string concatenation per
'' instruction of every build (7 million in tiko-lang's self-compile; speed audit).
'' i < 0 is the block itself -- a terminator's operand -- named as the block alone.
private function IW_( byref bn as string, byval i as int32, byval op as MirOp ) as string
    if i < 0 then return bn
    return bn & ":" & str( i ) & " " & OpName( op )
end function

private sub CheckUse_ _
    ( byref r as VerifyResult, byref bn as string, byval i as int32, byval op as MirOp, _
      byref v as MirValue, defined_ as containers.Array( of uint8 ) )

    if v.kind <> cast( uint8, MV_TEMP ) then return
    if cast( int32, v.id ) >= defined_.Count then
        Fail( r, IW_( bn, i, op ), "uses %" & str( v.id ) & " past the function's temp counter" )
    elseif defined_[cast( int32, v.id )] = 0 then
        Fail( r, IW_( bn, i, op ), "uses %" & str( v.id ) & " before it is defined" )
    end if
end sub

function Verify _
    ( byref m as MirModule, byref names as Tko.Interner, _
      byval strict as boolean = false ) as VerifyResult

    dim as VerifyResult r

    for fi as int32 = 0 to m.functions.Count - 1
        dim as MirFunction ptr f = m.functions[fi]
        if f = nullptr then continue for
        if f->isDefinition = false then continue for
        dim as string fn = names.Spelling( f->name )

        if f->blocks.Count = 0 then
            Fail( r, fn, "a definition with no blocks" )
            continue for
        end if

        '' Which temps have been defined. Not dominance -- that needs a CFG walk --
        '' but it does catch a use of a temp that was never produced at all.
        dim as containers.Array( of uint8 ) defined_
        for i as int32 = 0 to f->nextTemp
            defined_.Push( 0 )
        next

        '' ...AND WHICH SLOTS HAVE STORAGE. A slot is named by MV_LOCAL and reserved by
        '' M_ALLOCA, and nothing checked that the second ever happened. The ABI pass
        '' pushed its new allocas into the entry block while the entry block was itself
        '' being rebuilt, the rebuild dropped them, and every rule here still passed --
        '' clang was what noticed, with "use of undefined value '%s10'".
        ''
        '' Collected in a first sweep because an alloca may follow a use in program
        '' ORDER: the entry block is where they all live, but a later block's use is
        '' seen before the entry block is finished being read only if the walk is
        '' single-pass. Two passes is simpler than reasoning about that.
        dim as containers.Array( of uint8 ) allocated_
        for i as int32 = 0 to f->locals.Count
            allocated_.Push( 0 )
        next
        for bi as int32 = 0 to f->blocks.Count - 1
            for ii as int32 = 0 to f->blocks[bi].insts.Count - 1
                dim as MirInst ptr ai = @f->blocks[bi].insts[ii]
                if cast( MirOp, ai->op ) <> M_ALLOCA then continue for
                dim as int32 sl = cast( int32, ai->imm )
                if (sl >= 0) andalso (sl < allocated_.Count) then allocated_[sl] = 1
            next
        next

        for bi as int32 = 0 to f->blocks.Count - 1
            dim as MirBlock ptr b = @f->blocks[bi]
            dim as string bn = fn & ":" & str( bi )

            '' Rule 1: every block ends in exactly one terminator.
            if b->term = cast( uint8, MTERM_NONE ) then
                Fail( r, bn, "block has no terminator" )
            end if

            '' Rule 2: every referenced block exists and belongs to this function.
            dim as MirTermKind tk = cast( MirTermKind, b->term )
            if (tk = MTERM_BR) orelse (tk = MTERM_CONDBR) then
                if (b->target < 0) orelse (b->target >= f->blocks.Count) then
                    Fail( r, bn, "branch target " & str( b->target ) & " does not exist" )
                end if
            end if
            if tk = MTERM_CONDBR then
                if (b->target2 < 0) orelse (b->target2 >= f->blocks.Count) then
                    Fail( r, bn, "false target " & str( b->target2 ) & " does not exist" )
                end if
            end if
            if tk = MTERM_SWITCH then
                if (b->target2 < 0) orelse (b->target2 >= f->blocks.Count) then
                    Fail( r, bn, "switch default " & str( b->target2 ) & " does not exist" )
                end if
                if b->switchVals.Count <> b->indirectTargets.Count then
                    Fail( r, bn, "switch has " & str( b->switchVals.Count ) & " values for " & _
                                 str( b->indirectTargets.Count ) & " targets" )
                end if
                for ti as int32 = 0 to b->indirectTargets.Count - 1
                    dim as int32 st = cast( int32, b->indirectTargets[ti] )
                    if (st < 0) orelse (st >= f->blocks.Count) then
                        Fail( r, bn, "switch target " & str( st ) & " does not exist" )
                    end if
                    for tj as int32 = 0 to ti - 1
                        if b->switchVals[tj] = b->switchVals[ti] then
                            Fail( r, bn, "switch value " & str( b->switchVals[ti] ) & " appears twice" )
                        end if
                    next
                next
            end if

            for i as int32 = 0 to b->insts.Count - 1
                dim as MirInst ptr ins = @b->insts[i]
                dim as MirOp op = cast( MirOp, ins->op )

                '' Rule 6: alloca appears only in the entry block.
                if (op = M_ALLOCA) andalso (bi <> 0) then
                    Fail( r, IW_( bn, i, op ), "alloca outside the entry block" )
                end if

                '' Rule 4, in the form available without a full signature table: an
                '' opcode that produces a value must have a result temp, and one that
                '' does not must not.
                '' A void call is the one result-producing opcode that legitimately
                '' has no result: there is no value to name.
                dim as boolean wantsResult = OpHasResult( op )
                if ins->ty = cast( uint8, MT_VOID ) then wantsResult = false
                if wantsResult then
                    if ins->result = 0 then
                        Fail( r, IW_( bn, i, op ), "result-producing opcode with no result temp" )
                    elseif cast( int32, ins->result ) < defined_.Count then
                        if defined_[cast( int32, ins->result )] <> 0 then
                            Fail( r, IW_( bn, i, op ), "temp %" & str( ins->result ) & " defined twice" )
                        end if
                        defined_[cast( int32, ins->result )] = 1
                    else
                        Fail( r, IW_( bn, i, op ), "temp %" & str( ins->result ) & _
                              " is past the function's temp counter" )
                    end if
                elseif ins->result <> 0 then
                    Fail( r, IW_( bn, i, op ), "opcode with no result carries a result temp" )
                end if

                '' Rule 9c: a slot that is USED must have been ALLOCATED. See the
                '' sweep above for what this is for. A GLOBAL is storage in its own
                '' right and is not allocated by anything here.
                if ins->a.kind = cast( uint8, MV_LOCAL ) then
                    dim as int32 sl = cast( int32, ins->a.id )
                    if (sl >= 0) andalso (sl < allocated_.Count) then
                        if allocated_[sl] = 0 then
                            Fail( r, IW_( bn, i, op ), "uses slot " & str( sl ) & _
                                  " which is never allocated" )
                        end if
                    end if
                end if
                if ins->b.kind = cast( uint8, MV_LOCAL ) then
                    dim as int32 sl = cast( int32, ins->b.id )
                    if (sl >= 0) andalso (sl < allocated_.Count) then
                        if allocated_[sl] = 0 then
                            Fail( r, IW_( bn, i, op ), "uses slot " & str( sl ) & _
                                  " which is never allocated" )
                        end if
                    end if
                end if

                '' Operands that name a temp must name one that exists.
                dim as int32 n = OpArity( op )
                if n >= 1 then CheckUse_( r, bn, i, op, ins->a, defined_ )
                if n >= 2 then CheckUse_( r, bn, i, op, ins->b, defined_ )

                '' A CALL'S ARGUMENTS ARE OPERANDS TOO, held in the module's pool as (kind, id)
                '' pairs, and nothing checked them (audit F-45).
                if (op = M_CALL) orelse (op = M_CALL_RTL) orelse (op = M_CALL_IND) then
                    if (ins->count > 0) andalso _
                       ((ins->first < 0) orelse ((ins->first + ins->count) * 2 > m.argPool.Count)) then
                        Fail( r, IW_( bn, i, op ), "call arguments past the end of the pool" )
                    else
                        for q as int32 = 0 to ins->count - 1
                            dim as MirValue av
                            av.kind = cast( uint8, m.argPool[(ins->first + q) * 2] )
                            av.id = m.argPool[(ins->first + q) * 2 + 1]
                            CheckUse_( r, bn, i, op, av, defined_ )
                        next
                    end if
                end if

                '' Rule 9b: a CALL passes exactly as many arguments as the callee
                '' declares. docs/plan/09 rule 5. It could not be checked while a
                '' function recorded only an arity and the arity of a declaration was
                '' whatever its first call site happened to push -- the two agreed by
                '' construction and the rule was vacuous. Now the signature comes from
                '' the DECLARATION and this is a real check.
                ''
                '' A VARIADIC callee is checked as a MINIMUM: the tail is what it is.
                if (op = M_CALL) orelse (op = M_CALL_RTL) then
                    dim as int32 ci = cast( int32, ins->callee )
                    if (ci >= 0) andalso (ci < m.functions.Count) then
                        dim as MirFunction ptr cf = m.functions[ci]
                        if cf <> nullptr then
                            dim as boolean bad = false
                            if cf->isVariadic then
                                bad = (ins->count < cf->paramCount)
                            else
                                bad = (ins->count <> cf->paramCount)
                            end if
                            if bad then
                                Fail( r, IW_( bn, i, op ), "calls " & names.Spelling( cf->name ) & _
                                    " with " & str( ins->count ) & " arguments, " & _
                                    "which declares " & str( cf->paramCount ) )
                            end if
                        end if
                    end if
                end if

                '' Rule 10: a STORE's value must have the destination slot's type.
                ''
                '' MIR has no implicit conversions, so a mismatch is a WRONG STORE --
                '' 64 bits into a 32-bit slot, emitted and never complained about. One
                '' was found by accident when a member finally got a type and a 'trunc'
                '' appeared beside a store that had never had one; nothing in the
                '' verifier had objected to it, which is what this rule is for.
                ''
                '' A LOCAL or a GLOBAL destination, which are the two that write their
                '' slot's type down. A computed field address has none to compare
                '' against, and guessing would make the rule lie. MT_AGG is excluded on
                '' both sides: an aggregate is copied rather than loaded and stored
                '' whole, so its 'type' is not a width.
                if op = M_STORE then
                    dim as int32 slotTy = -1
                    if ins->a.kind = cast( uint8, MV_LOCAL ) then
                        if (ins->a.id >= 0) andalso (ins->a.id < f->locals.Count) then
                            slotTy = cast( int32, f->locals[ins->a.id].ty )
                        end if
                    elseif ins->a.kind = cast( uint8, MV_GLOBAL ) then
                        if (ins->a.id >= 0) andalso (ins->a.id < m.globals.Count) then
                            if m.globals[ins->a.id].isVar then
                                slotTy = cast( int32, m.globals[ins->a.id].ty )
                            end if
                        end if
                    end if
                    dim as int32 valTy = cast( int32, ins->b.ty )
                    dim as boolean checkable = (slotTy >= 0) andalso _
                        (slotTy <> cast( int32, MT_AGG )) andalso _
                        (valTy <> cast( int32, MT_AGG )) andalso _
                        (valTy <> cast( int32, MT_VOID ))
                    if checkable andalso (slotTy <> valTy) then
                        Fail( r, IW_( bn, i, op ), "stores " & TypeName( cast( MirType, valTy ) ) & _
                                     " into a " & TypeName( cast( MirType, slotTy ) ) & _
                                     " slot" )
                    end if
                end if

                '' A void value can be produced but never consumed.
                if OpHasResult( op ) andalso (ins->ty = cast( uint8, MT_VOID )) then
                    if (op <> M_CALL) andalso (op <> M_CALL_RTL) andalso _
                       (op <> M_CALL_IND) then
                        Fail( r, IW_( bn, i, op ), "non-call opcode produces void" )
                    end if
                end if
            next

            '' THE TERMINATOR'S OPERANDS, checked after the block's instructions have
            '' defined theirs (audit F-45): a branch condition or a returned value that
            '' names no temp, and a RET whose value disagrees with the signature -- 'return 5'
            '' in a sub was IR clang refused, and this said ok.
            if (tk = MTERM_CONDBR) orelse (tk = MTERM_SWITCH) then
                CheckUse_( r, bn, -1, cast( MirOp, 0 ), b->cond, defined_ )
            end if
            if tk = MTERM_RET then
                CheckUse_( r, bn, -1, cast( MirOp, 0 ), b->cond, defined_ )
                CheckUse_( r, bn, -1, cast( MirOp, 0 ), b->ret2, defined_ )
                dim as boolean hasVal = (b->cond.kind <> cast( uint8, MV_NONE ))
                if (f->retTy = cast( uint8, MT_VOID )) andalso hasVal then
                    Fail( r, bn, "a function returning void returns a value" )
                elseif (f->retTy <> cast( uint8, MT_VOID )) andalso (hasVal = false) then
                    Fail( r, bn, "a function returning " & TypeName( cast( MirType, f->retTy ) ) & _
                                 " returns no value" )
                end if
            end if
        next

        '' Rule 9: no block is unreachable from entry -- but only under STRICT.
        '' Reachability is a fixed point over the terminators, cheap here because a
        '' block has at most two successors.
        if strict = false then continue for
        dim as containers.Array( of uint8 ) seen
        for i as int32 = 0 to f->blocks.Count - 1
            seen.Push( 0 )
        next
        seen[0] = 1
        dim as boolean changed = true
        while changed
            changed = false
            for bi as int32 = 0 to f->blocks.Count - 1
                if seen[bi] = 0 then continue for
                dim as MirBlock ptr b = @f->blocks[bi]
                dim as MirTermKind tk = cast( MirTermKind, b->term )
                if (tk = MTERM_BR) orelse (tk = MTERM_CONDBR) then
                    if (b->target >= 0) andalso (b->target < f->blocks.Count) then
                        if seen[b->target] = 0 then
                            seen[b->target] = 1
                            changed = true
                        end if
                    end if
                end if
                if (tk = MTERM_CONDBR) orelse (tk = MTERM_SWITCH) then
                    if (b->target2 >= 0) andalso (b->target2 < f->blocks.Count) then
                        if seen[b->target2] = 0 then
                            seen[b->target2] = 1
                            changed = true
                        end if
                    end if
                end if
                if tk = MTERM_SWITCH then
                    for ti as int32 = 0 to b->indirectTargets.Count - 1
                        dim as int32 st = cast( int32, b->indirectTargets[ti] )
                        if (st >= 0) andalso (st < f->blocks.Count) andalso (seen[st] = 0) then
                            seen[st] = 1
                            changed = true
                        end if
                    next
                end if
            next
        wend
        for bi as int32 = 0 to f->blocks.Count - 1
            if seen[bi] = 0 then
                Fail( r, fn & ":" & str( bi ), "block is unreachable from entry" )
            end if
        next
    next

    return r
end function

end namespace
