'' lowerconcat.tiko -- concatenation assignment, and the small string helpers beside it.
''
'' Split out of lowerstr.tiko at the 1500-line cap and included from it in the same place.



'' THE WIDE HALF OF 's &= v' OVER A NARROW VAR-LENGTH STRING -- see the call site in
'' LowerConcatAssignStmt. The value is built FIRST, as fbc builds it, so
'' 'k &= mid( k, 2 ) & wz' reads k before the append changes it. Measured:
''
''     vr  = fb_WstrConcatAW( (void*)"a", 2ll, WZ )      '' the value, when a chain
''     vr2 = fb_WstrConcatAW( (void*)&B, -1ll, vr )
''     fb_WstrAssignToA( (void*)&B, -1ll, vr2, 0 )
private function NarrowAppendWide_ _
    ( byref c as Ctx, byref dst as MirValue, byval value as Tko.NodeId ) as boolean

    dim as MirValue src
    if ConcatHasWideTerm_( c, value ) then
        if WideConcatToTemp_( c, value, src ) = false then return false
    elseif (WideOperand_( c, value, src ) = false) orelse (src.kind = cast( uint8, MV_NONE )) then
        if UserCastToWide_( c, value, src ) = false then return false
    end if
    if src.kind = cast( uint8, MV_NONE ) then return false
    dim as containers.Array( of uint32 ) args
    PushStrArg( args, dst )
    args.Push( cast( uint32, src.kind ) ) : args.Push( cast( uint32, src.id ) )
    dim as MirValue joined
    if WideConcatStep_( c, args, RTL_WSTR_CONCAT_AW, joined ) = false then return false
    dim as containers.Array( of uint32 ) aargs
    aargs.Push( cast( uint32, dst.kind ) ) : aargs.Push( cast( uint32, dst.id ) )
    PushStrLen_( c, aargs, -1 )
    aargs.Push( cast( uint32, joined.kind ) ) : aargs.Push( cast( uint32, joined.id ) )
    aargs.Push( cast( uint32, MV_CONST_INT ) ) : aargs.Push( 0 )
    EmitRtl( c, RTL_WSTR_ASSIGN_TOA, aargs )
    return true
end function

'' 'a &= b' AND 'a += b' OVER A STRING, which is the same statement: measured, fbc
'' emits 'fb_StrConcatAssign( &S, -1ll, src, len, 0 )' for both spellings.
''
'' The operator was recorded on the statement and then thrown away for '&=': the
'' dispatch treated it as PLAIN, so 's &= "b"' lowered to fb_StrAssign -- an
'' assignment, not an append. It verified, it emitted code, it counted as fully
'' lowered, and it was wrong every time. '+=' declined instead, because the compound
'' path works in the target's MIR type and a string is an aggregate.
''
'' Only the shapes fbc reaches with ONE call are lowered. A fixed 'zstring * N' or
'' 'string * N' destination builds a temporary first -- 'fb_StrConcat( &TMP, Z, 10,
'' "f", 2 )' then 'fb_StrAssign( Z, 10, vr, -1, 0 )' -- and a narrow source appended
'' to a WIDE destination needs a temporary's lifetime as well. Those decline, which
'' is the honest answer where half of the model would be a wrong one.
function LowerConcatAssignStmt _
    ( byref c as Ctx, byval target as Tko.NodeId, byval value as Tko.NodeId, _
      byval op as Tko.TokenKind ) as boolean

    if (op <> Tko.TK_AMPEQ) andalso (op <> Tko.TK_PLUSEQ) then return false
    dim as Tko.TypeId tt = c.info->TypeOf_( target )
    if tt = Tko.TYPE_NONE then return false

    if IsStringType( c, tt ) then
        dim as MirValue dst = LowerAddr( c, target )
        if dst.kind = cast( uint8, MV_NONE ) then return false
        dim as boolean isU = IsUStringType( c, tt )
        '' A CHAIN APPENDED TO A USTRING IS FOLDED, like the three-term self chain it is.
        '' Measured (every ustring row a fold and one assign):
        ''
        ''     t &= " (" & n & ")"   fb_UStrConcat, fb_UStrConcatUA, fb_UStrConcat, fb_UStrAssign
        ''     t &= u2 & "x"         fb_UStrConcat, fb_UStrConcat, fb_UStrAssign
        ''     t &= "a" & s2         fb_UStrConcat, fb_UStrConcatUA, fb_UStrAssign
        ''
        '' while a NARROW destination appends each term in place ('nar &= "a" & s2' is two
        '' fb_StrConcatAssign), which the path below already does. Asking StrTermFlavour_
        '' of the WHOLE chain gave NEUTRAL for 'u2 & "x"', and one fb_UStrConcatAssign of a
        '' narrow build followed: 'Tu', NUL -- fbsqlite's DbError.ToString lost everything
        '' after its first line ('text &= " [" & m_operation & "]"').
        if isU then
            dim as containers.Array( of uint32 ) vterms
            FlattenConcat( c, value, vterms )
            if vterms.Count >= 2 then
                dim as containers.Array( of uint32 ) chain
                chain.Push( cast( uint32, target ) )
                for i as int32 = 0 to vterms.Count - 1
                    chain.Push( vterms[i] )
                next
                return LowerUStrChain( c, dst, true, chain, false )
            end if
        end if
        '' 'u &= q' over a narrow source is fb_UStrConcatUA into a TEMPORARY and then an
        '' assign, not one concat-assign -- measured. Appending the narrow bytes through
        '' the UTF-16 entry point is what this used to do.
        '' 'u &= q' over a narrow source is fb_UStrConcatUA into a TEMPORARY and then
        '' an assign, not one concat-assign -- measured. It is the two-term chain
        '' 'u = u + q', so it goes through the same fold.
        dim as int32 vf = StrTermFlavour_( c, value )

        '' A WIDE SOURCE APPENDED TO A USTRING IS A CONVERSION, not a concat: a
        '' wstring is a bare uint16* and a ustring a DESCRIPTOR, and no entry point
        '' takes one and appends to the other. See WideAppendToU_.
        if isU andalso (vf = STF_WIDE) then
            if WideAppendToU_( c, dst, value ) then return true
        end if

        '' A WIDE VALUE APPENDED TO A NARROW STRING -- a wstring, a 'wstr( )', a UDT
        '' casting to a wstring (AfxNova's DWSTRING) -- has no narrow form, so EmitStrTerm
        '' declined it and the whole statement was DROPPED: tracks' 's &= "host=" &
        '' this.Host & "|"' appended nothing. Measured, fbc builds the value wide, then
        '' 'fb_WstrConcatAW( &S, -1ll, vr )' and 'fb_WstrAssignToA( &S, -1ll, vr2, 0 )'.
        '' A USTRING in the same chain was worse: it lowered narrow over UTF-16 units and
        '' 'h &= u & wz' held "nU w i". It takes the fold 'h = h & u & wz' already takes.
        '' A UDT that ALSO casts to a narrow string stays narrow -- fbc picks that cast.
        if (isU = false) andalso (vf = STF_WIDE) then
            dim as containers.Array( of uint32 ) wterms
            FlattenConcat( c, value, wterms )
            dim as boolean touchesU = false
            dim as boolean wideOnly = false
            dim as boolean hasDual = false
            for i as int32 = 0 to wterms.Count - 1
                dim as Tko.NodeId wt = cast( Tko.NodeId, wterms[i] )
                if IsUStringType( c, c.info->TypeOf_( wt ) ) then touchesU = true
                if TermIsWide_( c, wt ) then
                    dim as Tko.TypeId wtt = c.info->TypeOf_( Unparen_( c, wt ) )
                    if NarrowCastOverload_( c, wtt ) = Tko.SYMBOL_NONE then
                        wideOnly = true
                    else
                        hasDual = true
                    end if
                end if
            next
            if touchesU then
                dim as containers.Array( of uint32 ) uchain
                uchain.Push( cast( uint32, target ) )
                for i as int32 = 0 to wterms.Count - 1
                    uchain.Push( wterms[i] )
                next
                return LowerUStrChain( c, dst, false, uchain, false )
            end if
            '' ...AND NOT BESIDE ONE: fbc takes the narrow cast inside a wide chain as well --
            '' 'b &= du & wz' is "nnarrowwide" -- where WideConcatToTemp_ would take the wide
            '' one. That mix declines rather than guess.
            if wideOnly andalso hasDual then return false
            if wideOnly then return NarrowAppendWide_( c, dst, value )
        end if

        '' A USTRING ANYWHERE IN A CHAIN APPENDED TO A NARROW STRING folds as well. The
        '' flavour of the WHOLE chain is NEUTRAL for 'u & "|"' -- see the USTRING note
        '' above -- so EmitStrTerm built the chain as a ustring and handed its UTF-16
        '' units to fb_StrConcatAssign as narrow bytes: 'g &= u & "|"' held "o<NUL>n<NUL>"
        '' where fbc holds "one|". 'g = g & u & "|"' was always right; this is that fold.
        if isU = false then
            dim as containers.Array( of uint32 ) nterms
            FlattenConcat( c, value, nterms )
            if nterms.Count >= 2 then
                dim as boolean anyU = false
                for i as int32 = 0 to nterms.Count - 1
                    if IsUStringType( c, c.info->TypeOf_( Unparen_( c, cast( Tko.NodeId, nterms[i] ) ) ) ) then anyU = true
                next
                if anyU then
                    dim as containers.Array( of uint32 ) nchain
                    nchain.Push( cast( uint32, target ) )
                    for i as int32 = 0 to nterms.Count - 1
                        nchain.Push( nterms[i] )
                    next
                    return LowerUStrChain( c, dst, false, nchain, false )
                end if
            end if
        end if

        dim as boolean mism = false
        if vf <> STF_NEUTRAL then
            if isU then
                mism = (vf <> STF_UTF16)
            else
                mism = (vf = STF_UTF16)
            end if
        end if
        if mism then
            dim as containers.Array( of uint32 ) two
            two.Push( cast( uint32, target ) )
            two.Push( cast( uint32, value ) )
            if LowerUStrChain( c, dst, isU, two, false ) then return true
            if isU then return LowerNarrowChainToU_( c, dst, two, false )
            return false
        end if
        dim as containers.Array( of uint32 ) args
        PushStrArg( args, dst )
        if EmitStrTerm( c, args, value, isU ) = false then return false
        args.Push( cast( uint32, MV_CONST_INT ) )
        args.Push( 0 )
        EmitRtl( c, iif( isU, RTL_USTR_CONCAT_ASSIGN, RTL_STR_CONCAT_ASSIGN ), args )
        return true
    end if

    '' A FIXED WIDE STRING with a wide source: 'fb_WstrConcatAssign( W, 50ll, W2 )'.
    if IsWideString_( c, tt ) then
        return LowerWideConcatAssign( c, target, WideStringElems( c, tt ), value )
    end if

    '' A FIXED NARROW STRING, and '*zp'. Nothing here took one, so 'z &= "def"' over a
    '' 'zstring * 30' -- or through a 'zstring ptr' -- was DROPPED: 'abc' stayed 'abc'.
    '' Measured, fbc appends to a 'string * N' in place and rebuilds the other two:
    ''
    ''     f &= "cd"     fb_StrConcatAssign( F, <tag>, "cd", 3, -1 )
    ''     z &= "def"    vr = fb_StrConcat( &TMP, Z, 30, "def", 4 )
    ''                   fb_StrAssign( Z, 30, vr, -1, 0 )
    ''
    '' -- the unsized '*zp' passing length 0, as it does everywhere.
    dim as int64 fxn
    dim as int32 fxk = StrSwapKind_( c, tt, fxn )
    if (fxk <> 1) andalso (fxk <> 3) then return false
    if StrTermFlavour_( c, value ) = STF_UTF16 then return false
    if StrTermFlavour_( c, value ) = STF_WIDE then return false
    dim as MirValue fdst = LowerAddr( c, target )
    if fdst.kind = cast( uint8, MV_NONE ) then return false
    if fxk = 3 then
        dim as containers.Array( of uint32 ) fa
        fa.Push( cast( uint32, fdst.kind ) ) : fa.Push( cast( uint32, fdst.id ) )
        PushStrLen_( c, fa, fxn )
        if EmitStrTerm( c, fa, value, false ) = false then return false
        fa.Push( cast( uint32, MV_CONST_INT ) ) : fa.Push( cast( uint32, -1 ) )
        EmitRtl( c, RTL_STR_CONCAT_ASSIGN, fa )
        return true
    end if
    dim as int32 tslot = NewTempLocal( c, MT_AGG, c.types->target.stringBytes )
    if tslot < 0 then return false
    dim as MirValue ftmp
    ftmp.kind = cast( uint8, MV_LOCAL )
    ftmp.ty = cast( uint8, MT_PTR )
    ftmp.id = tslot
    ZeroStrTempAtEntry_( c, ftmp )
    dim as containers.Array( of uint32 ) ca
    ca.Push( cast( uint32, ftmp.kind ) ) : ca.Push( cast( uint32, ftmp.id ) )
    ca.Push( cast( uint32, fdst.kind ) ) : ca.Push( cast( uint32, fdst.id ) )
    PushStrLen_( c, ca, fxn )
    if EmitStrTerm( c, ca, value, false ) = false then return false
    dim as MirValue acc = EmitRtl( c, RTL_STR_CONCAT, ca )
    if acc.kind = cast( uint8, MV_NONE ) then return false
    dim as containers.Array( of uint32 ) aa
    aa.Push( cast( uint32, fdst.kind ) ) : aa.Push( cast( uint32, fdst.id ) )
    PushStrLen_( c, aa, fxn )
    aa.Push( cast( uint32, acc.kind ) ) : aa.Push( cast( uint32, acc.id ) )
    aa.Push( cast( uint32, MV_CONST_INT ) ) : aa.Push( cast( uint32, -1 ) )
    aa.Push( cast( uint32, MV_CONST_INT ) ) : aa.Push( 0 )
    EmitRtl( c, RTL_STR_ASSIGN, aa )
    return true
end function

'' Flatten a left-leaning '+' chain into its terms, in source order.
sub FlattenConcat _
    ( byref c as Ctx, byval id as Tko.NodeId, byref outp as containers.Array( of uint32 ) )

    if id = Tko.NODE_NONE then return
    '' A PARENTHESISED STRING CHAIN IS THE SAME CHAIN: 'a & ( b & c )' is 'a & b & c'.
    '' Left whole it was ONE term, typed STRING by Check whatever it held, so a wide or a
    '' ustring inside went unseen -- measured against fbc, which prints aqbc and xUy:
    ''
    ''     print ( "a" & w ) & "bc"      tiko printed nothing
    ''     print "x" & ( u & "y" )       tiko printed "xU" and a NUL
    ''
    '' '&' is always a concatenation. '+' only when Check types it a string: '( x + 2 ) &
    '' "s"' is ARITHMETIC in the parentheses, and flattened x and 2 would be two terms.
    '' And never a USER OPERATOR, which is a call: '( a + b )' over a UDT whose 'operator +'
    '' returns a string is typed STRING too, and flattened it was two UDT terms.
    '' PARENTHESES ONLY, not Unparen_: it strips 'type<string>( ... )' as well, and over a
    '' wide chain that is a CONVERSION, which flattening would undo.
    dim as Tko.NodeId inner = id
    while c.ast->Kind( inner ) = Tko.N_PAREN
        dim as Tko.ListPayload ptr pp = _
            @c.ast->lists[cast( int32, c.ast->nodes[cast( int32, inner )].data )]
        if pp->count <> 1 then exit while
        inner = cast( Tko.NodeId, c.ast->children[pp->first] )
    wend
    dim as boolean builtinOp = (c.info->RefOf( inner ) = Tko.SYMBOL_NONE)
    dim as boolean parenBin = (inner <> id)
    parenBin = parenBin andalso (c.ast->Kind( inner ) = Tko.N_BINARY)
    if parenBin andalso builtinOp then
        dim as Tko.BinaryPayload ptr ibp = _
            @c.ast->binaries[cast( int32, c.ast->nodes[cast( int32, inner )].data )]
        dim as Tko.TokenKind iop = cast( Tko.TokenKind, ibp->op )
        dim as Tko.TypeId it = c.info->TypeOf_( inner )
        dim as boolean strPlus = IsStringType( c, it ) orelse IsWideString_( c, it )
        strPlus = strPlus orelse IsUStringType( c, it )
        if iop = Tko.TK_AMP then
            id = inner
        elseif (iop = Tko.TK_PLUS) andalso strPlus then
            id = inner
        end if
    end if
    if c.ast->Kind( id ) = Tko.N_BINARY then
        dim as Tko.BinaryPayload ptr bp = _
            @c.ast->binaries[cast( int32, c.ast->nodes[cast( int32, id )].data )]
        '' '&' AND '+' ARE THE SAME OPERATION on strings -- measured: fbc emits
        '' fb_StrAssign followed by fb_StrConcatAssign for both, instruction for
        '' instruction. Only '+' was flattened, so 'b = a & p' declined outright while
        '' 'b = a + p' beside it lowered. ('and' is FreeBASIC's bitwise operator, so
        '' '&' is never ambiguous here.)
        dim as Tko.TokenKind bop = cast( Tko.TokenKind, bp->op )
        '' ...AND NOT A USER OPERATOR HERE EITHER, the rule the parenthesised case above
        '' states: 'dv & ustr' over fbx's DVARIANT is 'operator &( DVARIANT, DVARIANT )', one
        '' call and one DVARIANT term. Split, the chain showed a USTRING term that is not
        '' there, and 'dim s as string = dv & " " & ustr' dropped its initialiser.
        if c.info->RefOf( id ) <> Tko.SYMBOL_NONE then bop = Tko.TK_EOF
        '' ...AND A '+' ONLY WHEN IT IS A STRING '+' -- the rule the parenthesised case above
        '' already followed. '"a" & 1 + 2' is '"a" & ( 1 + 2 )': '+' binds tighter, and its
        '' operands are numbers. Flattened, 1 and 2 became two STRING terms and the program
        '' printed a12 where fbc prints a3 (T94). An UNTYPED '+' still flattens: a wide
        '' concatenation through a UDT's 'cast( ) byref as const wstring' is one Check leaves
        '' without a type (mir/udt-wide-concat-operator).
        if bop = Tko.TK_PLUS then
            dim as Tko.TypeId pt = c.info->TypeOf_( id )
            dim as boolean strP = IsStringType( c, pt ) orelse IsWideString_( c, pt )
            strP = strP orelse IsUStringType( c, pt ) orelse (pt = Tko.TYPE_NONE)
            if strP = false then bop = Tko.TK_EOF
        end if
        if (bop = Tko.TK_PLUS) orelse (bop = Tko.TK_AMP) then
            '' A CONSTANT CHAIN HOLDING A NUL ENDS AT IT: fbc folds '"A" + !"\0" + "B"' to one
            '' literal of three bytes, and anything reading it as a string stops at the NUL --
            '' "A". Joined term by term at run time it was "AB" (pp/macro-eval-str.bas). So the
            '' terms after the first NUL-holding one go; that one's own text already stops at
            '' its NUL. Two are kept whatever happens, for the callers that want a chain.
            dim as string nraw
            dim as boolean nulLit = LitOnlyChain_( c, id, 0 )   '' hoisted: warning 38
            if nulLit then nulLit = ConstStringTextOf_( c, id, nraw, 1 )
            if nulLit then nulLit = (instr( nraw, chr( 0 ) ) > 0)
            if nulLit then
                dim as containers.Array( of uint32 ) sub_
                FlattenConcat( c, bp->lhs, sub_ )
                FlattenConcat( c, bp->rhs, sub_ )
                dim as int32 keep = sub_.Count
                for k as int32 = 0 to sub_.Count - 1
                    dim as string kt
                    if ConstStringTextOf_( c, cast( Tko.NodeId, sub_[k] ), kt, 1 ) andalso (instr( kt, chr( 0 ) ) > 0) then
                        keep = k + 1
                        exit for
                    end if
                next
                if keep < 2 then keep = iif( sub_.Count < 2, sub_.Count, 2 )
                for k as int32 = 0 to keep - 1
                    outp.Push( sub_[k] )
                next
                return
            end if
            FlattenConcat( c, bp->lhs, outp )
            FlattenConcat( c, bp->rhs, outp )
            return
        end if
    end if
    outp.Push( cast( uint32, id ) )
end sub

'' Whether two expressions name the same storage. Only the simple cases are needed:
'' anything else falls back to the general path rather than guessing.
function SameLValue _
    ( byref c as Ctx, byval a as Tko.NodeId, byval b as Tko.NodeId ) as boolean
    if (a = Tko.NODE_NONE) orelse (b = Tko.NODE_NONE) then return false
    if c.ast->Kind( a ) <> c.ast->Kind( b ) then return false
    if c.ast->Kind( a ) <> Tko.N_IDENT then return false
    return c.info->RefOf( a ) = c.info->RefOf( b )
end function

'' DOES THIS TERM READ THE TARGET ANYWHERE, not only as itself. 's = w & mid( s, 5 )' built
'' in place assigned w into s and then took mid( s, 5 ) of the RESULT, so ApexWealth's token
'' redaction kept its first '[redacted]' and lost the rest. Measured, fbc takes the
'' substring first and concatenates into a temporary. The target is recognised as
'' SameLValue recognises it, and a node kind not walked here is not searched.
''
'' A FIELD TARGET IS MATCHED BY ITS ROOT VARIABLE. SameLValue knows only a bare name, so
'' 'st.text = "Z" & mid( st.text, 4 )' found nothing to match and was built in place:
'' "Z" went into st.text and mid( ) read THAT -- measured, fbc prints 'ZB' and tiko
'' printed 'Z'. fb/tuiform.bi's backspace, delete, paste and selection are all
'' 'state->text = left( state->text, p ) & mid( state->text, ... )'. Any use of the
'' root in a later term takes the temporary: over-conservative for 'st.a = x & st.b',
'' which is only slower, never wrong.
private function LValueRoot_( byref c as Ctx, byval n as Tko.NodeId ) as Tko.NodeId
    dim as int32 guard = 0
    while (n <> Tko.NODE_NONE) andalso (guard < 64)
        guard += 1
        dim as uint32 d = c.ast->nodes[cast( int32, n )].data
        select case c.ast->Kind( n )
        case Tko.N_IDENT
            return n
        case Tko.N_MEMBER
            n = c.ast->binaries[cast( int32, d )].lhs
        case Tko.N_DEREF
            n = c.ast->unaries[cast( int32, d )].operand
        case Tko.N_INDEX, Tko.N_CALL
            n = c.ast->lists[cast( int32, d )].target
        case Tko.N_PAREN
            dim as Tko.ListPayload ptr lp = @c.ast->lists[cast( int32, d )]
            if lp->count <> 1 then return Tko.NODE_NONE
            n = cast( Tko.NodeId, c.ast->children[lp->first] )
        case else
            return Tko.NODE_NONE
        end select
    wend
    return Tko.NODE_NONE
end function

function TermReadsLValue_ _
    ( byref c as Ctx, byval target as Tko.NodeId, byval e as Tko.NodeId ) as boolean

    if (target = Tko.NODE_NONE) orelse (e = Tko.NODE_NONE) then return false
    dim as uint32 d = c.ast->nodes[cast( int32, e )].data
    select case c.ast->Kind( e )
    case Tko.N_IDENT
        if SameLValue( c, target, e ) then return true
        dim as Tko.NodeId troot = LValueRoot_( c, target )
        if (troot = Tko.NODE_NONE) orelse (troot = target) then return false
        return SameLValue( c, troot, e )
    case Tko.N_UNARY, Tko.N_ADDROF, Tko.N_DEREF
        return TermReadsLValue_( c, target, c.ast->unaries[cast( int32, d )].operand )
    case Tko.N_BINARY, Tko.N_MEMBER
        if TermReadsLValue_( c, target, c.ast->binaries[cast( int32, d )].lhs ) then return true
        return TermReadsLValue_( c, target, c.ast->binaries[cast( int32, d )].rhs )
    case Tko.N_CALL, Tko.N_INDEX, Tko.N_PAREN, Tko.N_TUPLE
        dim as Tko.ListPayload ptr lp = @c.ast->lists[cast( int32, d )]
        if TermReadsLValue_( c, target, lp->target ) then return true
        for i as int32 = 0 to lp->count - 1
            if TermReadsLValue_( c, target, cast( Tko.NodeId, c.ast->children[lp->first + i] ) ) then return true
        next
    end select
    return false
end function

'' THE WIDE HALF, into a fixed wstring: 'x = ww & mid( x, 5 )'. Measured, fbc takes
'' fb_WstrMid, concatenates into a temporary with fb_WstrConcat and fb_WstrAssigns that;
'' built in place, ww went into x first and mid( x, 5 ) read the result. False, emitting
'' nothing, when no term after the first reads the target.
function WideAssignViaTemp_ _
    ( byref c as Ctx, byref dst as MirValue, byval n as int32, _
      byval target as Tko.NodeId, byval value as Tko.NodeId ) as boolean

    dim as containers.Array( of uint32 ) terms
    FlattenConcat( c, value, terms )
    dim as boolean reads = false
    for i as int32 = 1 to terms.Count - 1
        if TermReadsLValue_( c, target, cast( Tko.NodeId, terms[i] ) ) then reads = true
    next
    if reads = false then return false
    dim as MirValue src
    if WideConcatToTemp_( c, value, src ) = false then return false
    dim as containers.Array( of uint32 ) args
    args.Push( cast( uint32, dst.kind ) ) : args.Push( cast( uint32, dst.id ) )
    args.Push( cast( uint32, MV_CONST_INT ) ) : args.Push( cast( uint32, n ) )
    args.Push( cast( uint32, src.kind ) ) : args.Push( cast( uint32, src.id ) )
    EmitRtl( c, RTL_WSTR_ASSIGN, args )
    return true
end function

'' 'offsetof( T, field )' -- A COMPILE-TIME INTEGER, folded from the measured layout.
''
'' Measured: over a type whose first two fields are INTEGERs, 'offsetof( E, i )' is 16
'' and 'typeof' of it is INTEGER. It takes a TYPE and a FIELD NAME rather than two
'' expressions -- neither argument has a type of its own, and the field name never
'' resolves to anything, which is why nothing else here recognises the shape.
''
'' It was not implemented at all, so every use declined. structs/padding.bas is written
'' almost entirely in terms of it.
function LowerOffsetOf _
    ( byref c as Ctx, byval id as Tko.NodeId, byref outv as MirValue ) as boolean

    if c.ast->Kind( id ) <> Tko.N_CALL then return false
    dim as Tko.ListPayload ptr lp = _
        @c.ast->lists[cast( int32, c.ast->nodes[cast( int32, id )].data )]
    if lp->count <> 2 then return false
    if lp->target = Tko.NODE_NONE then return false
    if c.ast->Kind( lp->target ) <> Tko.N_IDENT then return false
    dim as Tko.IdentPayload ptr ip = _
        @c.ast->idents[cast( int32, c.ast->nodes[cast( int32, lp->target )].data )]
    if Tko.Text.LowerAscii( c.names->Spelling( ip->name ) ) <> "offsetof" then return false

    '' THE TYPE. Written as a bare name, so Resolve bound it to the UDT's own symbol
    '' rather than typing the node.
    dim as Tko.NodeId tn = cast( Tko.NodeId, c.ast->children[lp->first] )
    dim as Tko.TypeId ut = c.info->TypeOf_( tn )
    if ut = Tko.TYPE_NONE then
        dim as Tko.SymbolId ts = c.info->RefOf( tn )
        dim as Tko.Symbol ptr tsy = c.syms->SymbolAt( ts )
        if tsy = nullptr then return false
        ut = tsy->type_
    end if
    if ut = Tko.TYPE_NONE then return false
    ut = c.types->Unqualify( ut )
    if c.types->Kind( ut ) <> Tko.TK_UDT then return false

    '' THE FIELD, by name. It is not an expression and resolves to nothing, so the
    '' spelling is all there is to go on -- which is what the layout store keys on too.
    ''
    '' ...AND A DOTTED PATH IS A WALK. 'offsetof( T, a.b )' parses as an N_MEMBER over
    '' N_IDENTs, so the N_IDENT test below saw a node kind it did not know and DECLINED
    '' SILENTLY -- a compile-time constant that lowered to no value at all, with the
    '' statement around it dropped and no diagnostic. tiko-editor's theme key table is
    '' built entirely out of 'offsetof( THEMEROOT_TYPE, editor.selection.forecolor )':
    '' all 71 rows took the -1 their macro had just defaulted them to, so every colour
    '' in the file reached nothing and the editor painted its built-in defaults.
    ''
    '' The spine is left-nested -- N_MEMBER( N_MEMBER( a, b ), c ) -- so it is walked
    '' from the outside in and the names come out reversed, then applied in order,
    '' each one's offset added and its TYPE becoming the next one's container.
    dim as Tko.NodeId fn = cast( Tko.NodeId, c.ast->children[lp->first + 1] )
    dim as containers.Array( of uint32 ) path
    while c.ast->Kind( fn ) = Tko.N_MEMBER
        dim as Tko.BinaryPayload ptr mbp = _
            @c.ast->binaries[cast( int32, c.ast->nodes[cast( int32, fn )].data )]
        if c.ast->Kind( mbp->rhs ) <> Tko.N_IDENT then return false
        path.Push( cast( uint32, mbp->rhs ) )
        fn = mbp->lhs
    wend
    if c.ast->Kind( fn ) <> Tko.N_IDENT then return false
    path.Push( cast( uint32, fn ) )

    dim as int32 off = 0
    dim as Tko.TypeId cur = ut
    for i as int32 = path.Count - 1 to 0 step -1
        '' A STEP THAT IS NOT A UDT HAS NO FIELDS, so a path that keeps going past one
        '' names nothing -- declined rather than answered with the offset so far.
        if cur = Tko.TYPE_NONE then return false
        cur = c.types->Unqualify( cur )
        if c.types->Kind( cur ) <> Tko.TK_UDT then return false
        dim as Tko.IdentPayload ptr fip = _
            @c.ast->idents[cast( int32, c.ast->nodes[cast( int32, path[i] )].data )]
        dim as boolean found = false
        dim as Tko.TypeId ft = Tko.TYPE_NONE
        off += c.udts->FieldOffsetType( cur, fip->name, found, ft )
        if found = false then return false
        cur = ft
    next
    outv = ConstInt( c, off, MT_I64 )
    return true
end function

'' A USTRING DESTINATION BUILT IN PLACE WHOSE CHAIN RENDERS A NUMBER. Measured, 'v = w & n &
'' "z"' with w not v: fb_UStrAssign( v, w ), fb_StrToUStr( n ), fb_UStrConcatAssign, then
'' ConcatAssign "z"; 'v = n & w': fb_UStrAssignFromA( v, n ), ConcatAssign w. The narrow
'' digits concat-assigned unconverted read as UTF-16 -- '25' came out as U+3532.
''
'' ...AND EVERY OTHER NARROW TERM, the same way. Only the numbers were converted, so 'return
'' k & right( "abc", 2 ) & sp' and 'v = 5 & bs & sp' over a narrow bs appended the narrow
'' bytes as UTF-16 -- "bc" came out as U+6362. A one-character string survived by accident
'' (its NUL made the second byte), which is why it went unseen. A WIDE term goes through
'' fb_WstrToUStr, as a DWSTRING term already did; 'k & wstr( "w" ) & sp' declined (TKO0994).
private function InPlaceTermNarrow_( byref c as Ctx, byval term as Tko.NodeId ) as boolean
    dim as Tko.NodeId t2 = Unparen_( c, term )
    dim as int32 tf = StrTermFlavour_( c, t2 )
    if tf = STF_NARROW then return true
    if tf <> STF_NEUTRAL then return false
    '' A NEUTRAL term is a literal or a string constant, which follows the destination --
    '' or an intrinsic call, which Check left untyped and which is narrow unless it is one
    '' of the ustring twins.
    if c.ast->Kind( t2 ) = Tko.N_STRING_LIT then return false
    dim as string ct
    if ConstStringTextOf_( c, t2, ct ) then return false
    if c.ast->Kind( t2 ) <> Tko.N_CALL then return false
    return (IsUStrIntrinCall_( c, t2 ) = false)
end function

function LowerUStrInPlaceWithNumbers_ _
    ( byref c as Ctx, byref dst as MirValue, byref terms as containers.Array( of uint32 ) ) as boolean

    for i as int32 = 0 to terms.Count - 1
        dim as Tko.NodeId term = cast( Tko.NodeId, terms[i] )
        dim as containers.Array( of uint32 ) args
        PushStrArg( args, dst )
        if IsRenderedNumberTerm_( c, term ) then
            dim as MirValue nv
            if NumberToStrDesc_( c, term, nv ) = false then return false
            if i = 0 then
                PushStrArg( args, nv )
                args.Push( cast( uint32, MV_CONST_INT ) ) : args.Push( 0 )
                args.Push( cast( uint32, MV_CONST_INT ) ) : args.Push( 0 )
                EmitRtl( c, RTL_USTR_FROM_A, args )
                continue for
            end if
            dim as containers.Array( of uint32 ) cv
            PushStrArg( cv, nv )
            dim as MirValue uv = EmitRtl( c, RTL_STR_TO_USTR, cv )
            if uv.kind = cast( uint8, MV_NONE ) then return false
            PushStrArg( args, uv )
        elseif InPlaceTermNarrow_( c, term ) then
            if i = 0 then
                if EmitStrTerm( c, args, term, false ) = false then return false
                args.Push( cast( uint32, MV_CONST_INT ) ) : args.Push( 0 )
                args.Push( cast( uint32, MV_CONST_INT ) ) : args.Push( 0 )
                EmitRtl( c, RTL_USTR_FROM_A, args )
                continue for
            end if
            dim as containers.Array( of uint32 ) ncv
            if EmitStrTerm( c, ncv, term, false ) = false then return false
            dim as MirValue nuv = EmitRtl( c, RTL_STR_TO_USTR, ncv )
            if nuv.kind = cast( uint8, MV_NONE ) then return false
            PushStrArg( args, nuv )
        elseif UdtTermWide_( c, c.info->TypeOf_( Unparen_( c, term ) ) ) orelse _
               (StrTermFlavour_( c, term ) = STF_WIDE) then
            '' A UDT THAT CASTS TO A WSTRING (AfxNova's DWSTRING) is converted first, as
            '' PushChainTerm_ does for the fold: EmitStrTerm has no UTF-16 form for it, so
            '' 't = u & n & dws' declined here with 't = u' already emitted.
            dim as MirValue wu
            if WideTermAsUStr_( c, term, wu ) = false then return false
            PushStrArg( args, wu )
        else
            if EmitStrTerm( c, args, term, true ) = false then return false
        end if
        args.Push( cast( uint32, MV_CONST_INT ) ) : args.Push( 0 )
        EmitRtl( c, iif( i = 0, RTL_USTR_ASSIGN, RTL_USTR_CONCAT_ASSIGN ), args )
    next
    return true
end function

end namespace
