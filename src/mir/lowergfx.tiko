'' lowergfx.tiko -- the graphics statements, lowered.
''
'' The grammar is in parser/gfx.tiko and the measured shape of every call in
'' docs/language/graphics-abi.md. What is here is the translation between them, and
'' almost all of it is the DEFAULTS: what fbc passes for an argument nobody wrote.
''
'' The three that would be guessed wrong:
''
''   COORDINATES ARE SINGLES. Every one is a separate 'float' -- never a struct, never
''   an int -- so an integer literal has to be converted before it is passed.
''
''   AN OMITTED COLOUR IS NOT AN ARGUMENT. It is `0` in the colour slot plus BIT 31 of
''   the coordinate flags, so the runtime can tell "black" from "whatever is current".
''
''   THERE ARE TWO FLAG CONVENTIONS. LINE, GET and PUT put the SECOND point's STEP in
''   bit 0; PSET, CIRCLE, PAINT and DRAW STRING put their single STEP there and carry a
''   base of 4 besides. Conflating them puts every relative coordinate on the wrong
''   point.

#import "std/containers"
#include once "mir/lowerall.ti"

namespace Tko.Mir

'' fbc's own flag bits, which are NOT the parser's -- see parser/gfx.tiko for those.
const GFXF_STEP2   as int32 = &h00000001
const GFXF_STEP1   as int32 = &h00000002
const GFXF_BASE1   as int32 = &h00000004   '' the one-point family's constant base
const GFXF_NOBORDER as int32 = &h40000000
const GFXF_NOCOLOUR as int32 = &h80000000

'' The parser's bits, repeated here rather than shared: the parser and the lowering are
'' separate layers and a shared constant would tie the tree's spelling to the runtime's.
const PGFX_STEP2     as uint16 = &h0004
const PGFX_STEP1     as uint16 = &h0008
const PGFX_BOX       as uint16 = &h0010
const PGFX_BOXFILL   as uint16 = &h0020
const PGFX_FILL      as uint16 = &h0040
const PGFX_SCREEN    as uint16 = &h0080
const PGFX_NOSTART   as uint16 = &h0100
const PGFX_HASTARGET as uint16 = &h0200
const PGFX_PAL_GET   as uint16 = &h0400
const PGFX_PAL_USING as uint16 = &h0800
const PGFX_DRAWSTR   as uint16 = &h1000
const PGFX_VIEWPRINT as uint16 = &h2000

'' The n'th child of a graphics statement, or NOTHING when it was elided.
private function GfxArg _
    ( byref c as Ctx, byval sp as Tko.StmtPayload ptr, byval i as int32 ) as Tko.NodeId

    if (i < 0) orelse (i >= sp->count) then return Tko.NODE_NONE
    dim as Tko.NodeId n = c.ast->ChildAt( sp->first, i )
    if n = Tko.NODE_NONE then return Tko.NODE_NONE
    if c.ast->Kind( n ) = Tko.N_ELIDED then return Tko.NODE_NONE
    return n
end function

'' One coordinate, as the SINGLE fbc passes. An omitted one is 0.0f, which is what fbc
'' writes for 'line -(x,y)' and for a reset 'window'.
private function GfxCoord _
    ( byref c as Ctx, byval sp as Tko.StmtPayload ptr, byval i as int32, _
      byref ok as boolean ) as MirValue

    dim as Tko.NodeId n = GfxArg( c, sp, i )
    if n = Tko.NODE_NONE then return ConstFloat( c, 0.0, MT_F32 )
    dim as MirValue v = LowerExpr( c, n )
    if v.kind = cast( uint8, MV_NONE ) then
        ok = false
        return v
    end if
    return Coerce( c, v, MT_F32, false )
end function

'' One INTEGER option -- a colour, a style, a mode. Returns the default when it was not
'' written, and says so, because an omitted colour also sets a flag bit.
private function GfxInt _
    ( byref c as Ctx, byval sp as Tko.StmtPayload ptr, byval i as int32, _
      byval dflt as int64, byref written as boolean, byref ok as boolean ) as MirValue

    dim as Tko.NodeId n = GfxArg( c, sp, i )
    written = (n <> Tko.NODE_NONE)
    if written = false then return ConstInt( c, dflt, MT_I32 )
    dim as MirValue v = LowerExpr( c, n )
    if v.kind = cast( uint8, MV_NONE ) then
        ok = false
        return v
    end if
    return CoerceTy( c, v, MT_I32, c.info->TypeOf_( n ))
end function

'' The TARGET buffer, or a null pointer. Every graphics statement takes one and fbc
'' passes '(void*)0' when it was not written.
private function GfxTargetVal _
    ( byref c as Ctx, byval sp as Tko.StmtPayload ptr, byref ok as boolean ) as MirValue

    if sp->a = Tko.NODE_NONE then return ConstInt( c, 0, MT_PTR )
    '' AN ARRAY NAMED BARE IS ITS STORAGE -- 'line array, ...', QB's image-in-an-array, of
    '' whatever element type. Measured on fbc-modern: a fixed array passes '(void*)ARRAY$0',
    '' a dynamic one the address of its first element out of the descriptor. LowerExpr has
    '' no value for a whole array, so every such statement declined (gfx/image-expr.bas).
    '' The descriptor's second word is the unbiased buffer start, '@a( lbound( a ) )' at
    '' any element size and rank.
    dim as Tko.TypeId gtt = c.types->Unqualify( c.info->TypeOf_( sp->a ) )
    if (gtt <> Tko.TYPE_NONE) andalso (c.types->Kind( gtt ) = Tko.TK_ARRAY) then
        dim as MirValue ga = LowerAddr( c, sp->a )
        if ga.kind = cast( uint8, MV_NONE ) then
            ok = false
            return ga
        end if
        if c.types->IsDynArray( gtt ) then
            dim as MirInst gf
            gf.op = cast( uint16, M_FIELD_ADDR )
            gf.ty = cast( uint8, MT_PTR )
            gf.a = ga
            gf.imm = c.types->target.pointerBits \ 8
            ga = LowerExprLoad( c, Emit( c, gf ), MT_PTR )
        end if
        return ga
    end if
    '' AN ELEMENT OF A NON-POINTER ARRAY IS WHERE THE IMAGE STARTS: 'draw array( 0 ), ...' over a
    '' ubyte array is fbc's '(void*)ARRAY', the element's ADDRESS. LowerExpr loaded the byte and
    '' passed it as the image pointer -- an access violation (gfx/image-expr.bas).
    if (gtt <> Tko.TYPE_NONE) andalso IsArrayIndex( c, sp->a ) andalso (c.types->Kind( gtt ) <> Tko.TK_POINTER) andalso (c.types->Kind( gtt ) <> Tko.TK_UDT) then
        dim as MirValue gea = LowerAddr( c, sp->a )
        if gea.kind = cast( uint8, MV_NONE ) then
            ok = false
        end if
        return gea
    end if
    '' A UDT TARGET CONVERTS through its 'operator cast' to 'any ptr' -- the exact overload
    '' first, then any other pointer one, never the integer: measured over the four
    '' castOverload* namespaces of gfx/image-expr.bas. LowerExpr loaded the aggregate.
    if (gtt <> Tko.TYPE_NONE) andalso (c.types->Kind( gtt ) = Tko.TK_UDT) then
        dim as MirValue gu
        if UserConvToScalar_( c, sp->a, c.types->Pointer_( c.types->Builtin( Tko.TY_VOID ) ), gu ) = false then
            ok = false
            return gu
        end if
        return Coerce( c, gu, MT_PTR )
    end if
    dim as MirValue v = LowerExpr( c, sp->a )
    if v.kind = cast( uint8, MV_NONE ) then
        ok = false
        return v
    end if
    return Coerce( c, v, MT_PTR )
end function

private sub PushV( byref args as containers.Array( of uint32 ), byref v as MirValue )
    args.Push( cast( uint32, v.kind ) )
    args.Push( cast( uint32, v.id ) )
end sub

'' The two-point coordinate flags: LINE, GET and PUT.
private function GfxFlags2( byval extra as uint16 ) as int32
    dim as int32 f = 0
    if (extra and PGFX_STEP2) <> 0 then f or= GFXF_STEP2
    if (extra and PGFX_STEP1) <> 0 then f or= GFXF_STEP1
    '' 'line -(x,y)' means "from where we are", which fbc spells as the first point
    '' being RELATIVE by (0,0) rather than as a flag of its own.
    if (extra and PGFX_NOSTART) <> 0 then f or= GFXF_STEP1
    return f
end function

'' ...and the one-point flags: PSET, PRESET, CIRCLE, PAINT. The base of 4 is on every
'' one of them and no source form clears it; its meaning was not determined.
private function GfxFlags1( byval extra as uint16 ) as int32
    dim as int32 f = GFXF_BASE1
    if (extra and PGFX_STEP1) <> 0 then f or= GFXF_STEP2
    return f
end function

'' LINE (x1,y1)-(x2,y2), colour, B|BF, style
function LowerGfxLine( byref c as Ctx, byval id as Tko.NodeId ) as boolean
    dim as Tko.StmtPayload ptr sp = StmtOf( c, id )
    dim as boolean ok = true

    dim as MirValue tgt = GfxTargetVal( c, sp, ok )
    dim as MirValue x1 = GfxCoord( c, sp, 0, ok )
    dim as MirValue y1 = GfxCoord( c, sp, 1, ok )
    dim as MirValue x2 = GfxCoord( c, sp, 2, ok )
    dim as MirValue y2 = GfxCoord( c, sp, 3, ok )
    dim as boolean hasCol = false
    dim as MirValue col = GfxInt( c, sp, 4, 0, hasCol, ok )
    '' The style defaults to &hFFFF, a solid line.
    dim as boolean hasSty = false
    dim as MirValue sty = GfxInt( c, sp, 5, 65535, hasSty, ok )
    if ok = false then return false

    '' B and BF are a SEPARATE INTEGER, not a bitmask: 0 plain, 1 B, 2 BF.
    dim as int32 box = 0
    if (sp->extra and PGFX_BOX) <> 0 then box = 1
    if (sp->extra and PGFX_BOXFILL) <> 0 then box = 2

    dim as int32 flags = GfxFlags2( sp->extra )
    if hasCol = false then flags or= GFXF_NOCOLOUR

    dim as containers.Array( of uint32 ) args
    PushV( args, tgt )
    PushV( args, x1 ) : PushV( args, y1 )
    PushV( args, x2 ) : PushV( args, y2 )
    PushV( args, col )
    args.Push( cast( uint32, MV_CONST_INT ) ) : args.Push( cast( uint32, box ) )
    PushV( args, sty )
    args.Push( cast( uint32, MV_CONST_INT ) ) : args.Push( cast( uint32, flags ) )
    EmitRtl( c, RTL_GFX_LINE, args )
    return true
end function

'' PSET / PRESET (x,y), colour -- ONE function, told apart by a trailing -1.
function LowerGfxPset _
    ( byref c as Ctx, byval id as Tko.NodeId, byval isPreset as boolean ) as boolean

    dim as Tko.StmtPayload ptr sp = StmtOf( c, id )
    dim as boolean ok = true
    dim as MirValue tgt = GfxTargetVal( c, sp, ok )
    dim as MirValue x = GfxCoord( c, sp, 0, ok )
    dim as MirValue y = GfxCoord( c, sp, 1, ok )
    dim as boolean hasCol = false
    dim as MirValue col = GfxInt( c, sp, 2, 0, hasCol, ok )
    if ok = false then return false

    dim as int32 flags = GfxFlags1( sp->extra )
    if hasCol = false then flags or= GFXF_NOCOLOUR

    dim as containers.Array( of uint32 ) args
    PushV( args, tgt )
    PushV( args, x ) : PushV( args, y )
    PushV( args, col )
    args.Push( cast( uint32, MV_CONST_INT ) ) : args.Push( cast( uint32, flags ) )
    args.Push( cast( uint32, MV_CONST_INT ) )
    args.Push( cast( uint32, iif( isPreset, -1, 0 ) ) )
    EmitRtl( c, RTL_GFX_PSET, args )
    return true
end function

'' CIRCLE (x,y), r, colour, start, end, aspect, F
''
'' THE ASPECT COMES BEFORE START AND END IN THE CALL, the reverse of the BASIC syntax
'' order, and an omitted end angle is 2*pi rather than 0.
function LowerGfxCircle( byref c as Ctx, byval id as Tko.NodeId ) as boolean
    dim as Tko.StmtPayload ptr sp = StmtOf( c, id )
    dim as boolean ok = true
    dim as MirValue tgt = GfxTargetVal( c, sp, ok )
    dim as MirValue x = GfxCoord( c, sp, 0, ok )
    dim as MirValue y = GfxCoord( c, sp, 1, ok )
    dim as MirValue r = GfxCoord( c, sp, 2, ok )
    dim as boolean hasCol = false
    dim as MirValue col = GfxInt( c, sp, 3, 0, hasCol, ok )

    dim as MirValue st = GfxCoord( c, sp, 4, ok )
    dim as Tko.NodeId en = GfxArg( c, sp, 5 )
    dim as MirValue ev
    '' THE OMITTED END IS A SENTINEL, NOT 2*PI. fbc passes
    '' 'astNewCONSTf( 3.141593*2, FB_DATATYPE_SINGLE )' -- the single
    '' 6.2831859588623047, 0x1.921FB8p+2 in its C -- and gfx_circle.c (and
    '' libtkogfx's raster/circle.ti) draws a whole circle ONLY for that exact value
    '' with start 0. The true single 2*pi, 6.2831854820251465, took the ARC path,
    '' which reduces a 0..2*pi arc to its first point: every 'circle (x, y), r'
    '' drew ONE pixel. Measured with POINT: fbc 44 pixels for r = 8, tiko 1.
    if en = Tko.NODE_NONE then
        ev = ConstFloat( c, 6.2831859588623047, MT_F32 )
    else
        ev = GfxCoord( c, sp, 5, ok )
    end if
    dim as MirValue asp = GfxCoord( c, sp, 6, ok )
    if ok = false then return false

    dim as int32 flags = GfxFlags1( sp->extra )
    if hasCol = false then flags or= GFXF_NOCOLOUR
    dim as int32 fill = iif( (sp->extra and PGFX_FILL) <> 0, -1, 0 )

    dim as containers.Array( of uint32 ) args
    PushV( args, tgt )
    PushV( args, x ) : PushV( args, y ) : PushV( args, r )
    PushV( args, col )
    PushV( args, asp ) : PushV( args, st ) : PushV( args, ev )
    args.Push( cast( uint32, MV_CONST_INT ) ) : args.Push( cast( uint32, fill ) )
    args.Push( cast( uint32, MV_CONST_INT ) ) : args.Push( cast( uint32, flags ) )
    EmitRtl( c, RTL_GFX_ELLIPSE, args )
    return true
end function

'' PAINT (x,y), fill, border
''
'' The third argument is EITHER a colour or a PATTERN STRING, decided by its type. A
'' pattern forces the colour argument to &hFFFF0000 -- measured, and it discards any
'' colour that was written, which cannot happen because the two share the slot.
''
'' The pattern descriptor is ALWAYS passed, never null: with no pattern fbc allocates an
'' empty temporary for it.
function LowerGfxPaint( byref c as Ctx, byval id as Tko.NodeId ) as boolean
    dim as Tko.StmtPayload ptr sp = StmtOf( c, id )
    dim as boolean ok = true
    dim as MirValue tgt = GfxTargetVal( c, sp, ok )
    dim as MirValue x = GfxCoord( c, sp, 0, ok )
    dim as MirValue y = GfxCoord( c, sp, 1, ok )

    dim as Tko.NodeId fillNode = GfxArg( c, sp, 2 )
    dim as boolean isPattern = false
    if fillNode <> Tko.NODE_NONE then
        if c.ast->Kind( fillNode ) = Tko.N_STRING_LIT then
            isPattern = true
        elseif IsStringType( c, c.info->TypeOf_( fillNode ) ) then
            isPattern = true
        end if
    end if

    dim as MirValue col
    dim as MirValue pat
    dim as boolean hasCol = false
    if isPattern then
        col = ConstInt( c, &hFFFF0000, MT_I32 )
        if StrDescriptorOf_( c, fillNode, pat ) = false then return false
        hasCol = true
    else
        col = GfxInt( c, sp, 2, 0, hasCol, ok )
        '' The empty temporary descriptor fbc passes when there is no pattern.
        dim as containers.Array( of uint32 ) ta
        ta.Push( cast( uint32, MV_GLOBAL ) )
        ta.Push( cast( uint32, c.m->AddStringLiteral( "", *c.names ) ) )
        ta.Push( cast( uint32, MV_CONST_INT ) )
        ta.Push( 0 )
        pat = EmitRtl( c, RTL_STR_TEMPZ, ta )
        if pat.kind = cast( uint8, MV_NONE ) then return false
    end if

    dim as boolean hasBorder = false
    dim as MirValue bord = GfxInt( c, sp, 3, 0, hasBorder, ok )
    if ok = false then return false

    dim as int32 flags = GfxFlags1( sp->extra )
    if hasCol = false then flags or= GFXF_NOCOLOUR
    if hasBorder = false then flags or= GFXF_NOBORDER

    dim as containers.Array( of uint32 ) args
    PushV( args, tgt )
    PushV( args, x ) : PushV( args, y )
    PushV( args, col ) : PushV( args, bord )
    PushV( args, pat )
    args.Push( cast( uint32, MV_CONST_INT ) )
    args.Push( cast( uint32, iif( isPattern, 1, 0 ) ) )
    args.Push( cast( uint32, MV_CONST_INT ) ) : args.Push( cast( uint32, flags ) )
    EmitRtl( c, RTL_GFX_PAINT, args )
    return true
end function

'' VIEW [SCREEN] (x1,y1)-(x2,y2), fill, border
''
'' VIEW'S COORDINATES ARE INTEGERS while WINDOW's are singles, which is measured and is
'' the opposite of what the shared syntax suggests. An omitted one is -32768.
function LowerGfxView( byref c as Ctx, byval id as Tko.NodeId ) as boolean
    dim as Tko.StmtPayload ptr sp = StmtOf( c, id )
    dim as boolean ok = true
    dim as boolean w = false
    '' VIEW PRINT [top TO bottom] -- the console's text window, a different statement
    '' and a different entry point. Measured: 'view print 10 to h - 5' is
    '' fb_ConsoleView( 10, H - 5 ) and a bare 'view print' is fb_ConsoleView( 0, 0 ).
    if (sp->extra and PGFX_VIEWPRINT) <> 0 then
        dim as MirValue vtop = GfxInt( c, sp, 0, 0, w, ok )
        dim as MirValue vbot = GfxInt( c, sp, 1, 0, w, ok )
        if ok = false then return false
        dim as containers.Array( of uint32 ) va
        PushV( va, vtop ) : PushV( va, vbot )
        EmitRtl( c, RTL_CONSOLE_VIEW, va )
        return true
    end if
    dim as MirValue x1 = GfxInt( c, sp, 0, -32768, w, ok )
    dim as MirValue y1 = GfxInt( c, sp, 1, -32768, w, ok )
    dim as MirValue x2 = GfxInt( c, sp, 2, -32768, w, ok )
    dim as MirValue y2 = GfxInt( c, sp, 3, -32768, w, ok )
    dim as boolean hasCol = false
    dim as MirValue col = GfxInt( c, sp, 4, 0, hasCol, ok )
    dim as boolean hasBorder = false
    dim as MirValue bord = GfxInt( c, sp, 5, 0, hasBorder, ok )
    if ok = false then return false

    dim as int32 flags = 0
    if (sp->extra and PGFX_SCREEN) <> 0 then flags or= 1
    if hasCol = false then flags or= GFXF_NOCOLOUR
    if hasBorder = false then flags or= GFXF_NOBORDER

    dim as containers.Array( of uint32 ) args
    PushV( args, x1 ) : PushV( args, y1 ) : PushV( args, x2 ) : PushV( args, y2 )
    PushV( args, col ) : PushV( args, bord )
    args.Push( cast( uint32, MV_CONST_INT ) ) : args.Push( cast( uint32, flags ) )
    EmitRtl( c, RTL_GFX_VIEW, args )
    return true
end function

'' WINDOW [SCREEN] (x1,y1)-(x2,y2)
function LowerGfxWindow( byref c as Ctx, byval id as Tko.NodeId ) as boolean
    dim as Tko.StmtPayload ptr sp = StmtOf( c, id )
    dim as boolean ok = true
    dim as MirValue x1 = GfxCoord( c, sp, 0, ok )
    dim as MirValue y1 = GfxCoord( c, sp, 1, ok )
    dim as MirValue x2 = GfxCoord( c, sp, 2, ok )
    dim as MirValue y2 = GfxCoord( c, sp, 3, ok )
    if ok = false then return false
    dim as int32 flags = iif( (sp->extra and PGFX_SCREEN) <> 0, 1, 0 )

    dim as containers.Array( of uint32 ) args
    PushV( args, x1 ) : PushV( args, y1 ) : PushV( args, x2 ) : PushV( args, y2 )
    args.Push( cast( uint32, MV_CONST_INT ) ) : args.Push( cast( uint32, flags ) )
    EmitRtl( c, RTL_GFX_WINDOW, args )
    return true
end function

'' DRAW [target,] command-string
'' DRAW STRING [target,] [STEP] (x,y), text [, colour [, font [, method [, a [, p]]]]]
''
'' Eleven arguments. Measured, four probes:
''
''   draw string (1,2), "a", 7
''     fb_GfxDrawString( 0, 1.0f, 2.0f, 4, vr, 7u, 0, 0, 0, 0, 0 )
''   draw string step(1,2), "a", 7    ...the flag is 5
''   draw string (1,2), "a"           ...it is -2147483644 -- the NO-COLOUR sign
''                                       bit over the same 4
''   draw string img, (0,0), "z", 3   ...the target is the image
''
'' So the flag is exactly the one-point family's: base 4, bit 0 for STEP, the sign
'' bit when the colour is omitted. The FONT is the seventh argument.
''
'' THE METHOD, measured 2026-10-10 over fourteen probes: the eighth argument is PUT's
'' mode number -- 0, TRANS, when none is written, the opposite of PUT's XOR -- the ninth
'' is always null, and CUSTOM's blender and parameter are the tenth and eleventh. A
'' method's VALUE goes in the COLOUR's slot, not a slot of its own:
''
''   draw string (1,2), "E", 7, , alpha, 128     colour 128u, mode 9
''   draw string (1,2), "J", , , alpha, 128      the same, still with the no-colour bit
''   draw string (1,2), "K", 7, , add            colour 255u, mode 7 -- ADD's default
''   draw string (1,2), "H", 7, , add, 99        colour 99u
''   draw string (1,2), "G", 7, , custom, @cb, @k    mode 8, ..., &CB, &K
''
'' ALPHA with a value is mode 9, as it is for PUT.
const PGFX_DSMODE_SHIFT as int32 = 16
declare function PutBlender( byval mode as int32 ) as RtlId
function LowerGfxDrawString_ _
    ( byref c as Ctx, byval id as Tko.NodeId ) as boolean

    dim as Tko.StmtPayload ptr sp = StmtOf( c, id )
    dim as boolean ok = true
    dim as MirValue tgt = GfxTargetVal( c, sp, ok )
    dim as MirValue x = GfxCoord( c, sp, 0, ok )
    dim as MirValue y = GfxCoord( c, sp, 1, ok )
    if ok = false then return false

    dim as Tko.NodeId sn = GfxArg( c, sp, 2 )
    if sn = Tko.NODE_NONE then return false
    dim as MirValue sv
    if NarrowOperandAny_( c, sn, sv ) = false then return false   '' a ustring or wide text too

    dim as boolean hasCol = false
    dim as MirValue col = GfxInt( c, sp, 3, 0, hasCol, ok )
    if ok = false then return false

    '' THE FONT IS A POINTER -- an image holding the glyphs -- and with one the PUTTER is
    '' passed too, the method's blender: measured, 'draw string (1,1), "x", , f' is
    '' '..., (void*)F, 0, (void*)&fb_hPutTrans, ...' and ', f, xor' is mode 5 with
    '' fb_hPutXor. It declined (manual gfx/drawstring-custom; fbc-examples repro ice17).
    dim as Tko.NodeId fn = GfxArg( c, sp, 4 )
    dim as MirValue fontv
    if fn <> Tko.NODE_NONE then
        fontv = LowerExpr( c, fn )
        if fontv.kind = cast( uint8, MV_NONE ) then return false
        fontv = Coerce( c, fontv, MT_PTR )
    end if

    dim as int32 flags = GfxFlags1( sp->extra )
    if hasCol = false then flags or= GFXF_NOCOLOUR

    '' The method: m+1 in four bits, 0 when none was written -- see the header.
    dim as int32 mode = 0
    dim as int32 mbits = cast( int32, (sp->extra shr PGFX_DSMODE_SHIFT) and &hF )
    if mbits <> 0 then mode = mbits - 1
    dim as Tko.NodeId valN = GfxArg( c, sp, 5 )
    dim as Tko.NodeId parN = GfxArg( c, sp, 6 )
    '' Null unless CUSTOM supplies them -- pushed as literals then, as before.
    dim as MirValue blender, cparam
    dim as boolean hasBl = false, hasPar = false
    if mode = 8 then
        if valN <> Tko.NODE_NONE then
            blender = LowerExpr( c, valN )
            if blender.kind = cast( uint8, MV_NONE ) then return false
            blender = Coerce( c, blender, MT_PTR )
            hasBl = true
        end if
        if parN <> Tko.NODE_NONE then
            cparam = LowerExpr( c, parN )
            if cparam.kind = cast( uint8, MV_NONE ) then return false
            cparam = Coerce( c, cparam, MT_PTR )
            hasPar = true
        end if
    elseif parN <> Tko.NODE_NONE then
        return false   '' only CUSTOM takes a parameter
    elseif (mode = 6) orelse (mode = 7) then
        if valN <> Tko.NODE_NONE then
            dim as MirValue av = LowerExpr( c, valN )
            if av.kind = cast( uint8, MV_NONE ) then return false
            col = Coerce( c, av, MT_I32 )
            if mode = 6 then mode = 9
        elseif mode = 7 then
            col = ConstInt( c, 255, MT_I32 )
        end if
    elseif valN <> Tko.NODE_NONE then
        return false   '' a value for a method that takes none
    end if

    dim as containers.Array( of uint32 ) args
    PushV( args, tgt )
    PushV( args, x ) : PushV( args, y )
    args.Push( cast( uint32, MV_CONST_INT ) ) : args.Push( cast( uint32, flags ) )
    PushV( args, sv )
    PushV( args, col )
    if fn <> Tko.NODE_NONE then
        PushV( args, fontv )
    else
        args.Push( cast( uint32, MV_CONST_INT ) ) : args.Push( 0 )         '' no font
    end if
    args.Push( cast( uint32, MV_CONST_INT ) ) : args.Push( cast( uint32, mode ) )
    if fn <> Tko.NODE_NONE then
        PushV( args, FuncAddrOfRtl( c, PutBlender( mode ) ) )
    else
        args.Push( cast( uint32, MV_CONST_INT ) ) : args.Push( 0 )         '' null without a font
    end if
    if hasBl then
        PushV( args, blender )
    else
        args.Push( cast( uint32, MV_CONST_INT ) ) : args.Push( 0 )
    end if
    if hasPar then
        PushV( args, cparam )
    else
        args.Push( cast( uint32, MV_CONST_INT ) ) : args.Push( 0 )
    end if
    EmitRtl( c, RTL_GFX_DRAW_STRING, args )
    return true
end function

function LowerGfxDraw( byref c as Ctx, byval id as Tko.NodeId ) as boolean
    dim as Tko.StmtPayload ptr sp = StmtOf( c, id )
    dim as boolean ok = true
    dim as MirValue tgt = GfxTargetVal( c, sp, ok )
    if ok = false then return false
    dim as Tko.NodeId sn = GfxArg( c, sp, 0 )
    if sn = Tko.NODE_NONE then return false
    dim as MirValue sv
    if NarrowOperandAny_( c, sn, sv ) = false then return false   '' a ustring or wide text too

    dim as containers.Array( of uint32 ) args
    PushV( args, tgt )
    PushV( args, sv )
    EmitRtl( c, RTL_GFX_DRAW, args )
    return true
end function

'' THE IMAGE BUFFER OF A GET OR A PUT: a POINTER is its VALUE, anything else its ADDRESS
'' -- the rule PALETTE ... USING below was measured with. GET took the address first and
'' PUT the value first, so each was wrong for half the shapes:
''
''     get (8,6)-(11,9), img          img as any ptr  ->  fb_GfxGet( .., @img, .. )
''     put (40,40), buf( 0 ), pset    buf as ulong array  ->  the ELEMENT'S VALUE
''
'' and both crashed -- GET wrote the image header and pixels over the pointer variable
'' and whatever followed it. Measured, fbc passes 'IMG$0' for the first and '&BUF$0[0]'
'' for the second. An rvalue with no address -- 'imagecreate( 4, 4 )' -- is a pointer
'' and takes the first arm.
'' A UDT OPERAND WITH A POINTER 'operator cast' IS THAT CAST'S RESULT -- fbc's hMaybeUdt2Ptr
'' (hCheckFbImageExpr, shared by GET, PUT and PALETTE USING) calls the overload that matches
'' 'any ptr'. 'rt' is its result type, which PALETTE's 32/64 choice reads. tiko passed the
'' object's own address, so 'palette get using p' over a type wrapping 'pal as long ptr'
'' wrote 256 entries over the wrapper (gfx/palette.bas, paletteGetUDTPtr). False, emitting
'' nothing, for any other operand.
private function GfxUdtPtrOperand_ _
    ( byref c as Ctx, byval n as Tko.NodeId, byref v as MirValue, byref rt as Tko.TypeId ) as boolean

    dim as Tko.TypeId t = c.info->TypeOf_( n )
    if t = Tko.TYPE_NONE then return false
    t = c.types->Unqualify( t )
    if c.types->Kind( t ) <> Tko.TK_UDT then return false
    dim as Tko.TypeId anyp = c.types->Pointer_( c.types->Builtin( Tko.TY_ANY ) )
    dim as Tko.SymbolId cs = Tko.Check.PtrCastPick( *c.syms, *c.types, *c.names, t, anyp )
    if cs = Tko.SYMBOL_NONE then return false
    if CastYieldsPtr_( c, cs ) = false then return false
    dim as MirValue self_
    if UdtSelfAddr_( c, n, self_ ) = false then return false
    v = EmitMemberCall( c, cs, self_, MT_PTR )
    if v.kind = cast( uint8, MV_NONE ) then return false
    rt = c.syms->SymbolAt( cs )->type_
    return true
end function

private function GfxBufferOperand_( byref c as Ctx, byval n as Tko.NodeId ) as MirValue
    dim as MirValue v
    dim as Tko.TypeId crt
    if GfxUdtPtrOperand_( c, n, v, crt ) then return v
    dim as Tko.TypeId t = c.info->TypeOf_( n )
    if t <> Tko.TYPE_NONE then t = c.types->Unqualify( t )
    if (t <> Tko.TYPE_NONE) andalso (c.types->Kind( t ) = Tko.TK_POINTER) then
        v = LowerExpr( c, n )
    else
        v = LowerAddr( c, n )
        if v.kind = cast( uint8, MV_NONE ) then v = LowerExpr( c, n )
        '' A DYNAMIC ARRAY NAMED BARE IS ITS DATA, not its descriptor -- GfxTargetVal's rule: fbc
        '' passes the buffer start out of the descriptor. GET wrote the image over the
        '' descriptor itself and the frame with it (gfx/image-expr.bas).
        dim as boolean vDyn = false   '' hoisted: warning 38
        if (t <> Tko.TYPE_NONE) andalso (v.kind <> cast( uint8, MV_NONE )) then vDyn = c.types->IsDynArray( t )
        if vDyn then
            dim as MirInst df
            df.op = cast( uint16, M_FIELD_ADDR ) : df.ty = cast( uint8, MT_PTR ) : df.a = v
            df.imm = c.types->target.pointerBits \ 8
            v = LowerExprLoad( c, Emit( c, df ), MT_PTR )
        end if
    end if
    return v
end function

'' GET [target,] (x1,y1)-(x2,y2), destination
''
'' The eighth argument is an ARRAY DESCRIPTOR when the destination is an array element
'' and NULL when it is a plain pointer. tiko-lang passes null always: it has no way to
'' materialise a descriptor over an arbitrary element expression here, and passing a
'' wrong one would be worse than passing none.
function LowerGfxGet( byref c as Ctx, byval id as Tko.NodeId ) as boolean
    dim as Tko.StmtPayload ptr sp = StmtOf( c, id )
    dim as boolean ok = true
    dim as MirValue tgt = GfxTargetVal( c, sp, ok )
    dim as MirValue x1 = GfxCoord( c, sp, 0, ok )
    dim as MirValue y1 = GfxCoord( c, sp, 1, ok )
    dim as MirValue x2 = GfxCoord( c, sp, 2, ok )
    dim as MirValue y2 = GfxCoord( c, sp, 3, ok )
    if ok = false then return false

    dim as Tko.NodeId dn = GfxArg( c, sp, 4 )
    if dn = Tko.NODE_NONE then return false
    dim as MirValue dst = GfxBufferOperand_( c, dn )
    if dst.kind = cast( uint8, MV_NONE ) then return false
    dst = Coerce( c, dst, MT_PTR )

    dim as containers.Array( of uint32 ) args
    PushV( args, tgt )
    PushV( args, x1 ) : PushV( args, y1 ) : PushV( args, x2 ) : PushV( args, y2 )
    PushV( args, dst )
    args.Push( cast( uint32, MV_CONST_INT ) )
    args.Push( cast( uint32, GfxFlags2( sp->extra ) ) )
    args.Push( cast( uint32, MV_CONST_INT ) ) : args.Push( 0 )
    EmitRtl( c, RTL_GFX_GET, args )
    return true
end function

'' The blender each PUT mode carries. Measured: every mode has one, and ALPHA WITH A
'' VALUE is a different mode from ALPHA without -- 9 rather than 6 -- with a different
'' blender again.
private function PutBlender( byval mode as int32 ) as RtlId
    select case mode
    case 0 : return RTL_GFX_PUT_TRANS
    case 1 : return RTL_GFX_PUT_PSET
    case 2 : return RTL_GFX_PUT_PRESET
    case 3 : return RTL_GFX_PUT_AND
    case 4 : return RTL_GFX_PUT_OR
    case 5 : return RTL_GFX_PUT_XOR
    case 6 : return RTL_GFX_PUT_ALPHA
    '' ADD had NO ROW and fell to the default below, so 'put ..., add' blended
    '' with XOR. Measured: fbc emits fb_hPutAdd.
    case 7 : return RTL_H_PUT_ADD
    case 8 : return RTL_GFX_PUT_CUSTOM
    case 9 : return RTL_GFX_PUT_BLEND
    end select
    return RTL_GFX_PUT_XOR
end function

'' PUT [target,] (x,y), source [, mode [, alpha]]
''
'' THE DEFAULT MODE IS XOR, not TRANS -- measured, and the opposite of DRAW STRING's.
'' The four source-rectangle integers are -65536 each, a sentinel for "the whole
'' image"; no 1.10.1 syntax was found that sets them.
function LowerGfxPut( byref c as Ctx, byval id as Tko.NodeId ) as boolean
    dim as Tko.StmtPayload ptr sp = StmtOf( c, id )
    dim as boolean ok = true
    dim as MirValue tgt = GfxTargetVal( c, sp, ok )
    dim as MirValue x = GfxCoord( c, sp, 0, ok )
    dim as MirValue y = GfxCoord( c, sp, 1, ok )
    if ok = false then return false

    dim as Tko.NodeId sn = GfxArg( c, sp, 2 )
    if sn = Tko.NODE_NONE then return false
    dim as MirValue src = GfxBufferOperand_( c, sn )
    if src.kind = cast( uint8, MV_NONE ) then return false
    src = Coerce( c, src, MT_PTR )

    '' THE MODE IS m+1 IN FOUR BITS and 0 means none was written -- see
    '' GfxPutMode. The default is XOR.
    dim as int32 mode = 5
    dim as int32 mbits = cast( int32, (sp->extra shr 12) and &hF )
    if mbits <> 0 then mode = mbits - 1

    '' ALPHA with a level is mode 9; CUSTOM takes a procedure pointer instead. They
    '' share the slot because no form has both.
    dim as Tko.NodeId extraN = GfxArg( c, sp, 3 )
    dim as MirValue alpha = ConstInt( c, -1, MT_I32 )
    dim as MirValue custom = ConstInt( c, 0, MT_PTR )
    if extraN <> Tko.NODE_NONE then
        if mode = 8 then
            dim as MirValue cv = LowerExpr( c, extraN )
            if cv.kind = cast( uint8, MV_NONE ) then return false
            custom = Coerce( c, cv, MT_PTR )
        else
            dim as MirValue av = LowerExpr( c, extraN )
            if av.kind = cast( uint8, MV_NONE ) then return false
            alpha = Coerce( c, av, MT_I32 )
            if mode = 6 then mode = 9
        end if
    end if

    '' CUSTOM's user parameter is slot 4 and the source area slots 5 to 8, each only
    '' when written -- see ParseGfxGetPut. Measured: 'put (1,2), a, (3,4)-(5,6),
    '' custom, @cb, @k' passes 3, 4, 5, 6 and then &K$0 last.
    dim as Tko.NodeId parN = GfxArg( c, sp, 4 )
    dim as MirValue cparam
    if parN <> Tko.NODE_NONE then
        cparam = LowerExpr( c, parN )
        if cparam.kind = cast( uint8, MV_NONE ) then return false
        cparam = Coerce( c, cparam, MT_PTR )
    end if
    dim as boolean hasArea = (GfxArg( c, sp, 5 ) <> Tko.NODE_NONE)
    dim as MirValue area(0 to 3)
    if hasArea then
        for i as int32 = 0 to 3
            dim as boolean aw = false
            area(i) = GfxInt( c, sp, 5 + i, -65536, aw, ok )
        next
        if ok = false then return false
    end if

    dim as MirValue bl = FuncAddrOfRtl( c, PutBlender( mode ) )
    if bl.kind = cast( uint8, MV_NONE ) then return false

    dim as containers.Array( of uint32 ) args
    PushV( args, tgt )
    PushV( args, x ) : PushV( args, y )
    PushV( args, src )
    for i as int32 = 0 to 3
        if hasArea then
            PushV( args, area(i) )
        else
            args.Push( cast( uint32, MV_CONST_INT ) ) : args.Push( cast( uint32, -65536 ) )
        end if
    next
    args.Push( cast( uint32, MV_CONST_INT ) )
    args.Push( cast( uint32, GfxFlags2( sp->extra ) ) )
    args.Push( cast( uint32, MV_CONST_INT ) ) : args.Push( cast( uint32, mode ) )
    PushV( args, bl )
    PushV( args, alpha )
    PushV( args, custom )
    if parN <> Tko.NODE_NONE then
        PushV( args, cparam )
    else
        args.Push( cast( uint32, MV_CONST_INT ) ) : args.Push( 0 )
    end if
    EmitRtl( c, RTL_GFX_PUT, args )
    return true
end function

'' PALETTE, in its three forms. Their omitted arguments do NOT agree with each other:
'' the plain form pads with -1, and PALETTE GET pads with a NULL POINTER rather than a
'' temporary -- the opposite of what SCREENINFO does.
'' Does this palette output want the 64-BIT entry point? Every PALETTE that writes
'' back has a twin -- fb_GfxPaletteGet64, fb_GfxPaletteUsing64,
'' fb_GfxPaletteGetUsing64 -- chosen by the WIDTH of what it writes into, so an
'' 'integer' array takes the 64 form on win64 and the 32 form on win32. That falls out
'' of asking LowerType rather than the spelling.
''
'' The width is the ELEMENT's, not the argument's: an array and a pointer both stand
'' for the thing they hold.
private function PaletteIs64_( byref c as Ctx, byval e as Tko.NodeId ) as boolean
    if e = Tko.NODE_NONE then return false
    dim as Tko.TypeId t = c.info->TypeOf_( e )
    if t = Tko.TYPE_NONE then return false
    select case c.types->Kind( t )
    case Tko.TK_ARRAY, Tko.TK_POINTER
        t = c.types->Inner( t )
    end select
    if t = Tko.TYPE_NONE then return false
    return (LowerType( t, *c.types ) = MT_I64)
end function

'' ...BUT 'PALETTE [GET] USING' CHOOSES BY THE POINTEE'S SIZE: 8 is the 64 form, 4 the 32 form,
'' and any other size INTEGER's width -- fbc's cGfxPalette. Measured on win64: a 'double' or
'' 'byte' array and an 'any ptr' take fb_GfxPaletteGetUsing64, a 'single' array the 32 form;
'' asking for MT_I64 sent all three of the first to the 32 form.
private function PaletteUsingIs64_( byref c as Ctx, byval t as Tko.TypeId ) as boolean
    if t = Tko.TYPE_NONE then return false
    t = c.types->Unqualify( t )
    select case c.types->Kind( t )
    case Tko.TK_ARRAY, Tko.TK_POINTER
        t = c.types->Inner( t )
    end select
    dim as int32 sz = 0
    if t <> Tko.TYPE_NONE then sz = SizeOfType( c, c.types->Unqualify( t ) )
    if (sz <> 4) andalso (sz <> 8) then sz = c.types->target.pointerBits \ 8
    return (sz = 8)
end function

function LowerGfxPalette( byref c as Ctx, byval id as Tko.NodeId ) as boolean
    dim as Tko.StmtPayload ptr sp = StmtOf( c, id )
    dim as boolean ok = true

    if (sp->extra and PGFX_PAL_USING) <> 0 then
        dim as Tko.NodeId an = GfxArg( c, sp, 0 )
        if an = Tko.NODE_NONE then return false
        '' A POINTER ARGUMENT IS ITS VALUE, everything else its ADDRESS. Measured:
        '' 'palette get using pp' over a 'ulong ptr' is 'fb_GfxPaletteGetUsing(
        '' (int32*)PP )', where the array form passes the array's own address. Taking
        '' the address of the pointer VARIABLE would hand the runtime a pointer to a
        '' pointer, which it would then fill with palette entries.
        dim as MirValue av
        dim as Tko.TypeId wt = c.info->TypeOf_( an )
        dim as Tko.TypeId crt = Tko.TYPE_NONE
        if GfxUdtPtrOperand_( c, an, av, crt ) then
            wt = crt                                  '' the cast's pointer decides the width
        elseif c.types->Kind( c.info->TypeOf_( an ) ) = Tko.TK_POINTER then
            av = LowerExpr( c, an )
        else
            av = LowerAddr( c, an )
            if av.kind = cast( uint8, MV_NONE ) then av = LowerExpr( c, an )
        end if
        if av.kind = cast( uint8, MV_NONE ) then return false
        dim as containers.Array( of uint32 ) ua
        PushV( ua, Coerce( c, av, MT_PTR ) )
        '' 'PALETTE GET USING' IS A FOURTH FORM with its own entry point -- reading it
        '' as a GET meant the array was taken for GET's colour index.
        dim as boolean w64 = PaletteUsingIs64_( c, wt )
        if (sp->extra and PGFX_PAL_GET) <> 0 then
            EmitRtl( c, iif( w64, RTL_GFX_PALETTE_GETUSING64, RTL_GFX_PALETTE_GETUSING ), ua )
        else
            EmitRtl( c, iif( w64, RTL_GFX_PALETTE_USING64, RTL_GFX_PALETTE_USING ), ua )
        end if
        return true
    end if

    if (sp->extra and PGFX_PAL_GET) <> 0 then
        dim as boolean w = false
        dim as MirValue n = GfxInt( c, sp, 0, 0, w, ok )
        if ok = false then return false
        dim as containers.Array( of uint32 ) ga
        PushV( ga, n )
        for i as int32 = 1 to 3
            dim as Tko.NodeId on_ = GfxArg( c, sp, i )
            if on_ = Tko.NODE_NONE then
                ga.Push( cast( uint32, MV_CONST_INT ) ) : ga.Push( 0 )
            else
                dim as MirValue oa = LowerAddr( c, on_ )
                if oa.kind = cast( uint8, MV_NONE ) then return false
                PushV( ga, oa )
            end if
        next
        EmitRtl( c, iif( PaletteIs64_( c, GfxArg( c, sp, 1 ) ), _
                         RTL_GFX_PALETTE_GET64, RTL_GFX_PALETTE_GET ), ga )
        return true
    end if

    dim as containers.Array( of uint32 ) pa
    for i as int32 = 0 to 3
        dim as boolean w = false
        dim as MirValue v = GfxInt( c, sp, i, -1, w, ok )
        if ok = false then return false
        PushV( pa, v )
    next
    EmitRtl( c, RTL_GFX_PALETTE, pa )
    return true
end function

'' The dispatcher: which of them this N_INTRINSIC is.
function LowerGfxStmt( byref c as Ctx, byval id as Tko.NodeId ) as boolean
    dim as Tko.StmtPayload ptr sp = StmtOf( c, id )
    select case cast( Tko.TokenKind, sp->op )
    case Tko.KW_LINE   : return LowerGfxLine( c, id )
    case Tko.KW_PSET   : return LowerGfxPset( c, id, false )
    case Tko.KW_PRESET : return LowerGfxPset( c, id, true )
    case Tko.KW_CIRCLE : return LowerGfxCircle( c, id )
    case Tko.KW_PAINT  : return LowerGfxPaint( c, id )
    case Tko.KW_VIEW   : return LowerGfxView( c, id )
    case Tko.KW_WINDOW : return LowerGfxWindow( c, id )
    case Tko.KW_DRAW
        '' DRAW STRING is a different statement sharing the keyword; the parser
        '' marked which one this is.
        if (StmtOf( c, id )->extra and PGFX_DRAWSTR) <> 0 then
            return LowerGfxDrawString_( c, id )
        end if
        return LowerGfxDraw( c, id )
    case Tko.KW_GET    : return LowerGfxGet( c, id )
    case Tko.KW_PUT    : return LowerGfxPut( c, id )
    case Tko.KW_PALETTE : return LowerGfxPalette( c, id )
    case Tko.KW_SCREEN : return LowerGfxScreen( c, id )
    end select
    return false
end function


'' SCREEN mode [, depth [, pages [, flags [, refresh ]]]]
''
'' THE DEPTH DEFAULTS TO THE LITERAL 8 FOR EVERY MODE -- verified across modes 12, 13,
'' 18 and 21, where a per-mode table would be the obvious guess. Everything else is 0.
function LowerGfxScreen( byref c as Ctx, byval id as Tko.NodeId ) as boolean
    dim as Tko.StmtPayload ptr sp = StmtOf( c, id )
    dim as boolean ok = true
    dim as containers.Array( of uint32 ) args
    for i as int32 = 0 to 4
        dim as boolean w = false
        dim as int64 dflt = 0
        if i = 1 then dflt = 8
        dim as MirValue v = GfxInt( c, sp, i, dflt, w, ok )
        if ok = false then return false
        PushV( args, v )
    next
    EmitRtl( c, RTL_GFX_SCREEN, args )
    return true
end function


'' 'imagecreate( w, h [, colour [, depth ]] )' and 'point( x, y [, target ] )', the two
'' graphics EXPRESSIONS. They are keywords rather than declared procedures, so they
'' cannot live in the prelude with the rest of the graphics surface.
''
''   imagecreate( 16, 16 )        fb_GfxImageCreate( 16, 16, 0u, 0, (int32)-2147483648u )
''   imagecreate( 16, 16, 7 )     fb_GfxImageCreate( 16, 16, 7u, 0, 0 )
''
'' AN OMITTED COLOUR IS THE SAME TWO-PART ANSWER THE DRAWING STATEMENTS GIVE: 0 in the
'' colour slot plus a flag bit, here &h80000000 in the FIFTH argument.
''
''   point( 1, 2 )       fb_GfxPoint( (void*)0, 1.0f, 2.0f )
''   point( 0 )          fb_GfxPoint( (void*)0, 0.0f, -8388607.0f )
''   point( 1, 2, img )  fb_GfxPoint( img, 1.0f, 2.0f )
''
'' THE ONE-ARGUMENT FORM IS THE SAME FUNCTION: the axis selector goes in x and y
'' carries a sentinel. And the TARGET, written LAST in BASIC, is passed FIRST.
function LowerGfxExprCall_ _
    ( byref c as Ctx, byval id as Tko.NodeId, byref outv as MirValue ) as boolean

    if c.ast->Kind( id ) <> Tko.N_CALL then return false
    dim as Tko.ListPayload ptr cp = _
        c.ast->ListOf( id )
    if cp->target = Tko.NODE_NONE then return false
    if c.ast->Kind( cp->target ) <> Tko.N_IDENT then return false
    dim as Tko.IdentPayload ptr ip = _
        c.ast->IdentOf( cp->target )
    dim as string nm = LowerSpelling_( c.ix, *c.names, ip->name )

    dim as Tko.StmtPayload lp
    lp.first = cp->first
    lp.count = cp->count
    dim as boolean ok = true

    if nm = "imagecreate" then
        if (cp->count < 2) orelse (cp->count > 4) then return false
        dim as containers.Array( of uint32 ) args
        for i as int32 = 0 to 1
            dim as boolean w = false
            dim as MirValue v = GfxInt( c, @lp, i, 0, w, ok )
            if ok = false then return false
            PushV( args, v )
        next
        dim as boolean hasCol = false
        dim as MirValue col = GfxInt( c, @lp, 2, 0, hasCol, ok )
        if ok = false then return false
        PushV( args, col )
        dim as boolean w3 = false
        dim as MirValue dep = GfxInt( c, @lp, 3, 0, w3, ok )
        if ok = false then return false
        PushV( args, dep )
        dim as int64 flags = 0
        if hasCol = false then flags = &h80000000
        PushV( args, ConstInt( c, flags, MT_I32 ) )
        outv = EmitRtl( c, RTL_GFX_IMAGECREATE, args )
        return (outv.kind <> cast( uint8, MV_NONE ))
    end if

    if nm = "point" then
        if (cp->count < 1) orelse (cp->count > 3) then return false
        dim as MirValue tgt = ConstInt( c, 0, MT_PTR )
        if cp->count = 3 then
            dim as MirValue tv = LowerExpr( c, cast( Tko.NodeId, c.ast->ChildSlot( cp->first + 2 ) ) )
            if tv.kind = cast( uint8, MV_NONE ) then return false
            tgt = Coerce( c, tv, MT_PTR )
        end if
        dim as MirValue x = GfxCoord( c, @lp, 0, ok )
        if ok = false then return false
        dim as MirValue y
        if cp->count >= 2 then
            y = GfxCoord( c, @lp, 1, ok )
            if ok = false then return false
        else
            '' The sentinel that says "this is the one-argument form".
            y = ConstFloat( c, -8388607.0, MT_F32 )
        end if
        dim as containers.Array( of uint32 ) args
        PushV( args, tgt )
        PushV( args, x )
        PushV( args, y )
        outv = EmitRtl( c, RTL_GFX_POINT, args )
        return (outv.kind <> cast( uint8, MV_NONE ))
    end if
    return false
end function

end namespace
