'' lowermath.tiko -- the MATH intrinsic family.
''
'' Split out of lowersub.tiko at the 1500-line lint cap. INCLUDED into the same
'' compilation unit -- it is INCLUDED from inside lowersub.tiko's own
'' 'namespace Tko.Mir', so it opens neither the namespace nor the header again.
'' Nothing in it changed in the move.


'' THE MATH INTRINSICS -- int, fix, frac, abs, sgn, sqr and the transcendentals.
''
'' None of them were lowered, so every one declined. 'ctr1 = 1 + int( (b - a) / s )' is
'' the shape the corpus writes and it was 280 declines in one file.
''
'' THREE DIFFERENT MECHANISMS, and which is which is not guessable -- each was read off
'' fbc's own C:
''
''   sqr sin cos tan asin acos atn log exp   gcc BUILTINS: '__builtin_sqrt( X )'
''   abs                                     a builtin, and a DIFFERENT one per width:
''                                           __builtin_fabs / fabsf / llabs
''   fix frac sgn                            RUNTIME CALLS: fb_FIXDouble, fb_FRACd,
''                                           fb_SGNl -- and SGN returns int32 from all
''                                           three, including the longint form
''   atan2                                   a plain libc call, no builtin prefix
''   int                                     a FLOOR, then the ordinary float-to-integer
''                                           coercion: 'fb_D2L( __builtin_floor( X ) )'
''                                           looks like a fourth case, but fb_D2L is a
''                                           MACRO over nearbyint and that coercion is
''                                           already what Coerce emits
''
'' The builtins are OPCODES rather than runtime entries, because a builtin is declared
'' nowhere -- putting them in the inventory would fail check-rtl, which reads what fbc
'' declares.
function LowerMathCall_ _
    ( byref c as Ctx, byval id as Tko.NodeId, byref outv as MirValue ) as boolean

    if c.ast->Kind( id ) <> Tko.N_CALL then return false
    dim as Tko.ListPayload ptr cp = _
        c.ast->ListOf( id )
    if cp->target = Tko.NODE_NONE then return false
    if c.ast->Kind( cp->target ) <> Tko.N_IDENT then return false
    if (cp->count < 1) orelse (cp->count > 2) then return false
    dim as Tko.IdentPayload ptr ip = _
        c.ast->IdentOf( cp->target )
    dim as string nm = LowerSpelling_( c.ix, *c.names, ip->name )

    dim as Tko.NodeId a0 = cast( Tko.NodeId, c.ast->children[cp->first] )
    dim as Tko.TypeId at = c.info->TypeOf_( a0 )
    if at = Tko.TYPE_NONE then return false

    '' A UDT ARGUMENT IS A USER 'operator sqr' -- or abs, or sgn, or any of them.
    '' fbc allows the whole math family to be overloaded on a type, and
    '' optimizations/inline-ops.bas declares 'operator sqr( byref x as const TSQR )
    '' as single' and calls it. The intrinsic path lowered the UDT, Coerce refused
    '' to make a double of an aggregate and answered NOTHING, and that nothing was
    '' emitted as the operand of an sqrt: 'ICE: an operand with no kind'.
    ''
    '' BY NAME, because nothing BINDS it: 'sqr( t )' parses as a CALL and Check
    '' types the intrinsic, not the operator. The symbol an 'operator sqr' declares
    '' is spelled exactly 'sqr', which is what the parser folds it under.
    '' ...AND WITH NO OPERATOR OF ITS OWN, ITS NUMERIC 'operator cast' (T40). Measured:
    '' fbc's 'sqr( f )' over a type converting itself to double is the square root of
    '' that double, 1.58113883008419 for 2.5. This declined instead, and what was left
    '' printed 3.117401420081966e-312 for 'dim as float64 r = sqr( f )' and truncated
    '' 'print abs( f )'. The converted value stands in for the argument below, and its
    '' type for the argument's type, so each family member sees an ordinary number.
    dim as boolean havePre = false
    dim as MirValue pre
    if c.types->Kind( c.types->Unqualify( at ) ) = Tko.TK_UDT then
        '' A USER OPERATOR RETURNING A UDT is an ordinary call Check has resolved (IntrinsicCallType_,
        '' fbc-examples r3mis01): the scalar result type below is not its result.
        if c.types->Kind( c.types->Unqualify( c.info->TypeOf_( id ) ) ) = Tko.TK_UDT then return false
        '' THE OVERLOAD CHECK CHOSE FIRST: 'operator abs( byref x as D ) as long' over a D that also casts
        '' to long is the call (IntrinsicCallType_), and the name lookup below missed the global
        '' operator, so the builtin ran on the cast -- 3 where fbc prints -300 (beside fbc-examples r3mis01).
        dim as Tko.SymbolId uop = c.info->DecisionOf( id )
        if uop = Tko.SYMBOL_NONE then uop = c.info->RefOf( id )
        '' ...ONLY ONE THAT TAKES THIS UDT: the name's binding is the chain head whatever the argument.
        if uop <> Tko.SYMBOL_NONE then
            if c.syms->SymbolAt( uop )->kind <> cast( uint8, Tko.SYM_PROC ) then
                uop = Tko.SYMBOL_NONE
            else
                dim as Tko.TypeId p0 = c.types->Unqualify( ParamTypeAt( c, uop, 0 ) )
                if c.types->Kind( p0 ) = Tko.TK_REFERENCE then p0 = c.types->Unqualify( c.types->Inner( p0 ) )
                if p0 <> c.types->Unqualify( at ) then uop = Tko.SYMBOL_NONE
            end if
        end if
        if uop = Tko.SYMBOL_NONE then uop = c.syms->Lookup( _
            c.info->ScopeOf( id ), c.names->Fold( c.names->GetString( nm ) ) )
        if uop <> Tko.SYMBOL_NONE then
            dim as MirType urt = LowerType( c.info->TypeOf_( id ), *c.types )
            if urt = MT_VOID then urt = MT_F64
            return LowerUserUnaryOpSym_( c, uop, a0, urt, outv )
        end if
        '' ONLY FOR THE MATHS FAMILY: every call reaches this function, and converting first
        '' emitted the cast twice for 'wants( q )' over a user function -- once here, once
        '' for the real call -- before the name below declined it.
        if instr( " sin cos tan atn asin acos atan2 exp log sqr abs sgn int fix frac ", " " & nm & " " ) = 0 then return false
        dim as Tko.SymbolId cov = UserCastNumOverload_( c, c.types->Unqualify( at ) )
        if cov = Tko.SYMBOL_NONE then return false
        if UserCastToNum_( c, a0, pre ) = false then return false
        if pre.kind = cast( uint8, MV_NONE ) then return false
        havePre = true
        at = c.types->Unqualify( c.syms->SymbolAt( cov )->type_ )
    end if
    dim as MirType amt = LowerType( at, *c.types )
    dim as boolean isFlt = (amt = MT_F32) orelse (amt = MT_F64)
    dim as boolean uns = IsUnsignedType( c, at )

    '' ATAN2 takes two and is the only one that does.
    if nm = "atan2" then
        if cp->count <> 2 then return false
        dim as Tko.NodeId a1 = cast( Tko.NodeId, c.ast->children[cp->first + 1] )
        dim as MirValue v0 = pre
        if havePre = false then v0 = LowerExpr( c, a0 )
        if v0.kind = cast( uint8, MV_NONE ) then return false
        dim as MirValue v1     '' a UDT second argument converts through its numeric cast too (T40)
        if UserCastToNum_( c, a1, v1 ) = false then v1 = LowerExpr( c, a1 )
        if v1.kind = cast( uint8, MV_NONE ) then return false
        '' SINGLE IN, SINGLE OUT, THROUGH A DIFFERENT ENTRY POINT. Measured:
        '' 'atan2( f, f )' over two SINGLEs is 'atan2f( F, F )' returning a float, and
        '' its result goes straight to fb_PrintSingle. Widening both to double and
        '' narrowing the answer back rounds twice, which is a quiet wrong last bit
        '' rather than a decline -- and '#print typeof( atan2( f, f ) )' says SINGLE,
        '' so the type Check gives it now would not have matched either.
        dim as MirType a2t = MT_F64
        dim as RtlId a2r = RTL_ATAN2
        dim as Tko.TypeId rt2 = c.info->TypeOf_( id )
        if rt2 <> Tko.TYPE_NONE then
            if LowerType( rt2, *c.types ) = MT_F32 then
                a2t = MT_F32
                a2r = RTL_ATAN2F
            end if
        end if
        v0 = Coerce( c, v0, a2t, uns )
        v1 = CoerceTy( c, v1, a2t, c.info->TypeOf_( a1 ))
        dim as containers.Array( of uint32 ) aa
        aa.Push( cast( uint32, v0.kind ) ) : aa.Push( cast( uint32, v0.id ) )
        aa.Push( cast( uint32, v1.kind ) ) : aa.Push( cast( uint32, v1.id ) )
        outv = EmitRtl( c, a2r, aa )
        return (outv.kind <> cast( uint8, MV_NONE ))
    end if
    if cp->count <> 1 then return false

    '' AN INTEGER ARGUMENT NEVER REACHES THE RUNTIME. Measured, and each prints what
    '' fbc prints for 'dim as integer i = 3':
    ''
    ''     fix( i )   3      int( i )   3      frac( i )   0
    ''
    '' -- fbc emits no fb_FIX*/fb_FRAC* call at all for these; there is no fractional
    '' part to take. Refusing them instead declined the whole statement, so
    '' 'print fix( i )' was unlowered while 'print abs( i )' beside it was fine.
    '' The ARGUMENT is still lowered: it may have side effects that fbc performs.
    dim as boolean truncFamily = _
        ((nm = "fix") orelse (nm = "int") orelse (nm = "frac"))
    if (isFlt = false) andalso truncFamily then
        dim as MirValue iv = pre
        if havePre = false then iv = LowerExpr( c, a0 )
        if iv.kind = cast( uint8, MV_NONE ) then return false
        dim as MirType iwant = LowerType( c.info->TypeOf_( id ), *c.types )
        if iwant = MT_VOID then iwant = amt
        if nm = "frac" then
            outv = ConstInt( c, 0, iwant )
        else
            outv = Coerce( c, iv, iwant, uns )
        end if
        return (outv.kind <> cast( uint8, MV_NONE ))
    end if

    '' FIX / FRAC / SGN -- the runtime three. SGN is the odd one out twice over: it
    '' accepts integers as well as floats, and its result is int32 whatever went in.
    dim as RtlId r = RTL_NONE
    dim as MirType want = amt
    select case nm
    case "fix"
        if isFlt = false then return false
        r = iif( amt = MT_F32, RTL_FIX_SINGLE, RTL_FIX_DOUBLE )
    case "frac"
        if isFlt = false then return false
        r = iif( amt = MT_F32, RTL_FRAC_SINGLE, RTL_FRAC_DOUBLE )
    case "sgn"
        if amt = MT_F32 then
            r = RTL_SGN_SINGLE
        elseif amt = MT_F64 then
            r = RTL_SGN_DOUBLE
        else
            r = RTL_SGN_LONGINT
            want = MT_I64
        end if
    end select
    if r <> RTL_NONE then
        dim as MirValue v0 = pre
        if havePre = false then v0 = LowerExpr( c, a0 )
        if v0.kind = cast( uint8, MV_NONE ) then return false
        v0 = Coerce( c, v0, want, uns )
        dim as containers.Array( of uint32 ) aa
        aa.Push( cast( uint32, v0.kind ) ) : aa.Push( cast( uint32, v0.id ) )
        outv = EmitRtl( c, r, aa )
        '' fb_SGN* answer an int32; sgn over an integer is INTEGER -- SIGN-extended here, as
        '' a -1 must stay -1 whatever widens it next (difflane seed 235).
        if cbool( nm = "sgn" ) andalso cbool( outv.kind <> cast( uint8, MV_NONE ) ) andalso (isFlt = false) then
            outv = Coerce( c, outv, MT_I64, false )
        end if
        return (outv.kind <> cast( uint8, MV_NONE ))
    end if

    '' The BUILTINS, AT THE ARGUMENT'S WIDTH. A SINGLE argument takes the 'f' routine
    '' and gives a SINGLE back -- measured, fbc-modern's C for each of the nine:
    ''
    ''     r = sqr( s )    R$0 = (double)__builtin_sqrtf( S$0 )
    ''     r = sin( s )    R$0 = (double)__builtin_sinf( S$0 )     ...and cosf, tanf,
    ''                                            atanf, expf, logf, asinf, acosf
    ''
    '' -- and '#print typeof( sqr( s ) )' is SINGLE, which Check already answered. This
    '' said fbc WIDENED a single to double and called the double routine, and did that:
    '' 'dim as double r = sqr( s )' kept 148.7103741862853 where fbc's rounded result is
    '' 148.7103729248047, and a sum of 3.5 million of them drifted in the tenth digit.
    '' Anything else -- an integer or a DOUBLE argument -- is DOUBLE, as before.
    dim as MirOp op = M_NONE
    dim as MirType rty = MT_F64
    select case nm
    case "sqr"  : op = M_SQRT
    case "sin"  : op = M_SIN
    case "cos"  : op = M_COS
    case "tan"  : op = M_TAN
    case "asin" : op = M_ASIN
    case "acos" : op = M_ACOS
    case "atn"  : op = M_ATAN
    case "log"  : op = M_LOG
    case "exp"  : op = M_EXP
    case "abs"
        '' PER WIDTH, and the integer form widens to int64: '__builtin_llabs(
        '' (int64)N )'.
        ''
        '' AN UNSIGNED ARGUMENT GOES THE SAME WAY. This used to refuse one, on the
        '' reasoning that an unsigned value has nothing to take the absolute of --
        '' but fbc does it anyway, and measurably:
        ''
        ''   dim as ulong    a = abs( ul )    A$0 = (uint32)__builtin_llabs( (int64)UL$0 )
        ''   dim as ulongint b = abs( ull )   B$0 = __builtin_llabs( ULL$0 )
        ''
        '' -- widened, llabs, narrowed back. Refusing left it to a path that has no
        '' answer for ABS at all, so every one of them declined:
        '' optimizations/consteval.bas runs the whole unary family over every width.
        if amt = MT_F32 then
            op = M_FABS : rty = MT_F32
        elseif amt = MT_F64 then
            op = M_FABS : rty = MT_F64
        else
            op = M_IABS : rty = MT_I64
        end if
    case "int"
        '' A FLOOR, and then whatever the surrounding expression wants. 'int' over an
        '' INTEGER is the identity and fbc emits nothing for it.
        if isFlt = false then return false
        op = M_FLOOR : rty = amt
    case else
        return false
    end select
    '' abs and int chose their width above; the nine others follow a SINGLE argument.
    if (amt = MT_F32) andalso (rty = MT_F64) then rty = MT_F32

    dim as MirValue v0 = pre
    if havePre = false then v0 = LowerExpr( c, a0 )
    if v0.kind = cast( uint8, MV_NONE ) then return false
    v0 = Coerce( c, v0, rty, uns )
    dim as MirInst ins
    ins.op = cast( uint16, op )
    ins.ty = cast( uint8, rty )
    ins.a = v0
    outv = Emit( c, ins )
    return (outv.kind <> cast( uint8, MV_NONE ))
end function
