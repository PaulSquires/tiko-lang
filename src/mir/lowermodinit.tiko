'' lowermodinit.tiko -- EmitModuleInit_: the module initialiser and finaliser.
'' Split out of lowerimpl.tiko on 2026-09-10 for the 1500-line cap; nothing about the
'' code changed in the move.

#import "std/containers"
#include once "mir/lowerctx.ti"

namespace Tko.Mir

'' lowerfieldinit.tiko
declare function CopyCallResultOnAddr_ _
    ( byref c as Ctx, byref addr as MirValue, byval t as Tko.TypeId, _
      byval init as Tko.NodeId ) as boolean

'' THE MODULE INITIALISER AND FINALISER.
''
'' fbc emits '_GLOBAL__I' and '_GLOBAL__D' carrying GCC's constructor and destructor
'' attributes, runs the globals in DECLARATION order in the first and in EXACT REVERSE
'' in the second -- measured, including the reversal within an array.
''
'' Without them 'dim shared as T g' over a type holding a string left the descriptor
'' uninitialised for the whole program, and the first assignment through it freed
'' whatever was in the image at that address.
sub EmitModuleInit_( byref c as Ctx )
    if c.modInitGlobal.Count = 0 then return

    for pass as int32 = 0 to 1
        dim as boolean isCtor = (pass = 0)
        dim as Tko.InternId nm = c.names->GetString( iif( isCtor, "_GLOBAL__I", "_GLOBAL__D" ) )
        dim as MirFunction ptr f = c.m->AddFunction( nm, MT_VOID )
        f->isDefinition = true
        '' INTERNAL, as fbc emits them (llvm-nm: 't', measured 2026-09-26): every module
        '' with such a global defines both names, so two of them failed the link with
        '' "duplicate symbol: _GLOBAL__I". global_ctors keeps them alive.
        f->isPrivate = true
        f->isModuleCtor = isCtor
        f->isModuleDtor = (isCtor = false)

        dim as MirFunction ptr savedF = c.f
        dim as int32 savedB = c.curBlock
        c.f = f
        c.st->functions += 1
        c.curBlock = NewBlock( c, "entry" )

        dim as int32 n = c.modInitGlobal.Count
        for k as int32 = 0 to n - 1
            dim as int32 i = iif( isCtor, k, n - 1 - k )
            dim as Tko.TypeId gt = cast( Tko.TypeId, c.modInitType[i] )
            if gt = Tko.TYPE_NONE then continue for   '' its folded image is its construction (InitSharedGlobal)
            dim as MirValue ga
            ga.kind = cast( uint8, MV_GLOBAL )
            ga.ty = cast( uint8, MT_PTR )
            ga.id = c.modInitGlobal[i]

            if c.types->Kind( gt ) = Tko.TK_UDT then
                if isCtor then
                    '' A NAMED CONSTRUCTOR FIRST. See the note in InitSharedGlobal: the
                    '' declaration chose one, and the zero-arity lookup below would run
                    '' a different constructor and drop the arguments.
                    dim as Tko.NodeId mic = Tko.NODE_NONE
                    if i < c.modInitCall.Count then
                        mic = cast( Tko.NodeId, c.modInitCall[i] )
                    end if
                    if mic <> Tko.NODE_NONE then
                        if CtorCallOnAddr_( c, ga, gt, mic ) then continue for
                        '' ...OR THROUGH THE LOCAL DECLARATION'S OWN PATH, which passes an ARRAY by
                        '' descriptor: 'dim shared as UDT1 g = UDT1( tmp.array( ) )' built nothing at
                        '' all and the program faulted on g (structs/obj_global_with_temp3.bas).
                        scope
                            dim as int32 sm0 = c.strTemps.Count, wm0 = c.wstrTemps.Count, um0 = c.udtTemps.Count
                            dim as boolean lci = LowerCtorInit( c, -1, gt, mic, @ga )
                            ReleaseUdtTemps_( c, um0 ) : ReleaseWstrTemps_( c, wm0 ) : ReleaseStrTemps_( c, sm0 )
                            if lci then continue for
                        end scope
                        '' ...OR A VALUE FOR A CONVERTING ONE: 'dim shared as DWSTRING g = "abc"'.
                        '' Its temporaries die here, since no statement end follows.
                        dim as int32 sm = c.strTemps.Count, wm = c.wstrTemps.Count, um = c.udtTemps.Count
                        dim as boolean conv = LowerConvCtorInit_( c, -1, gt, mic, @ga )
                        ReleaseUdtTemps_( c, um ) : ReleaseWstrTemps_( c, wm ) : ReleaseStrTemps_( c, sm )
                        if conv then continue for
                        '' ...OR A FUNCTION RETURNING THE TYPE: 'dim shared as __float128 M_PIq =
                        '' strtoflt128( "3.14...Q", 0 )' -- see CopyCallResultOnAddr_.
                        if CopyCallResultOnAddr_( c, ga, gt, mic ) then continue for
                        '' A NAMED INITIALISER NOTHING COULD BUILD is a decline, never a quiet default
                        '' construction in its place.
                        SkipHere( c )
                        continue for
                    end if
                    dim as Tko.SymbolId ct = StructorWithArity( c, StructorOf( c, gt, "__ctor" ), 0 )
                    if ct <> Tko.SYMBOL_NONE then
                        dim as containers.Array( of uint32 ) none1
                        EmitStructorCall( c, ct, -1, @ga, @none1 )
                    elseif TypeNeedsInit_( c, gt ) then
                        CallImplicitCtor_( c, gt, ga )
                    end if
                    '' ...AND A COLLECTION INITIALISER'S CALLS, now that it exists:
                    '' 'dim shared a as Array( of long ) = { 1, 2 }'. symbols/collinit.tiko.
                    if i < c.modInitColl.Count then
                        LowerCollInitCalls_( c, cast( Tko.NodeId, c.modInitColl[i] ) )
                    end if
                else
                    dim as Tko.SymbolId dt = StructorWithArity( c, StructorOf( c, gt, "__dtor" ), 0 )
                    if dt <> Tko.SYMBOL_NONE then
                        dim as containers.Array( of uint32 ) none2
                        EmitStructorCall( c, dt, -1, @ga, @none2 )
                    elseif TypeNeedsDtor_( c, gt ) then
                        CallImplicitDtor_( c, gt, ga )
                    end if
                end if
            else
                '' A LIST OF CONSTRUCTOR CALLS builds its elements first -- ArrayCtorList_.
                if isCtor andalso (i < c.modInitCall.Count) then
                    dim as Tko.NodeId lic = cast( Tko.NodeId, c.modInitCall[i] )
                    if ArrayCtorList_( c, gt, lic ) then
                        EmitArrayCtorList_( c, ga, gt, lic )
                        continue for
                    end if
                end if
                '' AN ARRAY OF THEM, element by element -- and the reversal applies
                '' WITHIN the array too, which is what fbc's own _GLOBAL__D does.
                dim as boolean wants = false
                if isCtor then
                    wants = ArrayElemNeedsInit_( c, gt )
                else
                    wants = ArrayElemNeedsDtor_( c, gt )
                end if
                if wants then EmitArrayElemsAt_( c, ga, gt, isCtor )
            end if
        next

        Terminate( c, MTERM_RET, -1, -1, NoVal( ) )
        c.f = savedF
        c.curBlock = savedB
    next
end sub

'' 'dim shared as bar b( 1 to 3 ) = { bar( 1 ), bar( 2 ), bar( 3 ) }' -- A FIXED ARRAY OF A
'' CONSTRUCTED TYPE, ONE CONSTRUCTOR CALL PER ELEMENT. Measured on fbc-modern: the module
'' initialiser calls each in order on its element, and the finaliser destroys them in
'' reverse (structs/obj_shared_array_ini.bas, obj_global_with_temp.bas). A call is not a
'' byte image, so the aggregate folder declined the declaration. ...AND ANY OTHER VALUE
'' THE ELEMENT CONSTRUCTS FROM -- 'arr()' for a 'constructor( arr() as double )'
'' (structs/ctor_bydesc.bas) -- by LowerUdtElemInit_, the local brace list's own rule.
'' One dimension, no nested field lists; the rest is default-constructed as before.
function ArrayCtorList_ _
    ( byref c as Ctx, byval t as Tko.TypeId, byval init as Tko.NodeId ) as boolean

    if (t = Tko.TYPE_NONE) orelse (init = Tko.NODE_NONE) then return false
    if c.ast->Kind( init ) <> Tko.N_INITIALIZER then return false
    dim as Tko.TypeId at = c.types->Unqualify( t )
    if c.types->Kind( at ) <> Tko.TK_ARRAY then return false
    if c.types->IsDynArray( at ) then return false
    if c.types->types[cast( int32, at )].dims <> 1 then return false
    dim as Tko.TypeId el = c.types->Unqualify( c.types->Inner( at ) )
    if c.types->Kind( el ) <> Tko.TK_UDT then return false
    if StructorOf( c, el, "__ctor" ) = Tko.SYMBOL_NONE then return false
    dim as Tko.ListPayload ptr lp = _
        @c.ast->lists[cast( int32, c.ast->nodes[cast( int32, init )].data )]
    if (lp->count <= 0) orelse (lp->count > c.types->ElemCount( at )) then return false
    for k as int32 = 0 to lp->count - 1
        select case c.ast->Kind( cast( Tko.NodeId, c.ast->children[lp->first + k] ) )
        case Tko.N_TUPLE, Tko.N_PAREN, Tko.N_INITIALIZER
            return false
        end select
    next
    return true
end function

sub EmitArrayCtorList_ _
    ( byref c as Ctx, byref ga as MirValue, byval t as Tko.TypeId, byval init as Tko.NodeId )

    dim as Tko.TypeId at = c.types->Unqualify( t )
    dim as Tko.TypeId el = c.types->Unqualify( c.types->Inner( at ) )
    dim as int32 esz = SizeOfType( c, el )
    dim as Tko.ListPayload ptr lp = _
        @c.ast->lists[cast( int32, c.ast->nodes[cast( int32, init )].data )]
    for k as int32 = 0 to lp->count - 1
        dim as MirInst fa
        fa.op = cast( uint16, M_FIELD_ADDR )
        fa.ty = cast( uint8, MT_PTR )
        fa.a = ga
        fa.imm = k * esz
        dim as MirValue ea = Emit( c, fa )
        '' Each call's temporaries die after it, since no statement end follows.
        dim as int32 sm = c.strTemps.Count, wm = c.wstrTemps.Count, um = c.udtTemps.Count
        dim as boolean ok = (ea.kind <> cast( uint8, MV_NONE ))
        if ok then ok = LowerUdtElemInit_( c, ea, el, cast( Tko.NodeId, c.ast->children[lp->first + k] ) )
        ReleaseUdtTemps_( c, um ) : ReleaseWstrTemps_( c, wm ) : ReleaseStrTemps_( c, sm )
        if ok = false then SkipHere( c )
    next
    EmitArrayElemsAt_( c, ga, at, true, lp->count )
end sub

'' The priority a module structor WROTE, from the parser's side table, or 0 for none.
function StructorPrioOf_( byref c as Ctx, byval id as Tko.NodeId ) as int32
    for i as int32 = 0 to c.ast->structorPrio.Count - 2 step 2
        if cast( Tko.NodeId, c.ast->structorPrio[i] ) = id then
            return cast( int32, c.ast->structorPrio[i + 1] )
        end if
    next
    return 0
end function

end namespace
