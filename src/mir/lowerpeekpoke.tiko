'' lowerpeekpoke.tiko -- PEEK and POKE: the type argument in all three spellings
'' each accepts, the read half and the write half.
''
'' Split out of lowerio.tiko at the 1500-line cap and INCLUDED from it, inside the
'' same namespace. Nothing moved here changed in the move.


'' THE TYPE NAMED IN A PEEK OR POKE'S FIRST ARGUMENT, in all three spellings it has.
''
''   poke ubyte, p, 5            a TYPE KEYWORD, which parses as a NAME
''   poke typeof( b ), p, 5      a TYPEOF, which in an argument list arrives as a CALL
''   type t as ubyte : poke t, p, 5   a NAMED TYPE, and it may be SHADOWED by a
''                                    variable of the same spelling, where only the
''                                    POSITION says which one is meant
''
'' PEEK grew all three and POKE only the first, so 'poke typeof( b ), pb, 123' and
'' 'poke t, @b, 123' both declined while the identical PEEK beside them lowered --
'' quirk/peek-poke.bas writes each spelling on both sides, which is what made the
'' asymmetry visible at all.
private function PeekPokeType_ _
    ( byref c as Ctx, byval tn as Tko.NodeId, byref outT as Tko.TypeId ) as boolean

    dim as Tko.BuiltinType b = PokeTypeName_( c, tn )
    if b <> Tko.TY_NONE then
        outT = c.types->Builtin( b )
        return true
    end if

    dim as Tko.TypeId tt = c.info->TypeOf_( tn )
    if (tt = Tko.TYPE_NONE) andalso (c.ast->Kind( tn ) = Tko.N_CALL) then
        dim as Tko.ListPayload ptr tlp = _
            @c.ast->lists[cast( long, c.ast->nodes[cast( long, tn )].data )]
        if tlp->count = 1 then
            tt = c.info->TypeOf_( cast( Tko.NodeId, c.ast->children[tlp->first] ) )
        end if
    end if

    if c.ast->Kind( tn ) = Tko.N_IDENT then
        dim as Tko.Symbol ptr tsy = c.syms->SymbolAt( c.info->RefOf( tn ) )
        if tsy <> 0 then
            select case tsy->kind
            case Tko.SYM_UDT, Tko.SYM_TYPEDEF
                tt = tsy->type_
            case else
                '' Resolve bound the VARIABLE of that spelling; the TYPE that shadows
                '' it lives in the same scope.
                dim as Tko.IdentPayload ptr tnip = _
                    @c.ast->idents[cast( long, c.ast->nodes[cast( long, tn )].data )]
                dim as Tko.SymbolId tt2 = c.syms->LookupTyped( _
                    tsy->parent, tnip->name, true )
                dim as Tko.Symbol ptr tsy2 = c.syms->SymbolAt( tt2 )
                if tsy2 <> 0 then
                    select case tsy2->kind
                    case Tko.SYM_UDT, Tko.SYM_TYPEDEF
                        tt = tsy2->type_
                    end select
                end if
            end select
        end if
    end if

    if tt = Tko.TYPE_NONE then return false
    outT = tt
    return true
end function

'' POKE.
''
'' Not a runtime call: a typed STORE through an address. Measured --
''
''     poke byte, @p, 5     P$0 = (int8)5;
''     poke integer, @p, 7  P$0 = 7ll;
''     poke @p, 3           P$0 = (uint8)3u;      the two-argument form is UBYTE
''
'' The named type is a TYPEREF argument, not an expression, which is what makes the
'' two forms tell apart: three arguments means the first is the type.
function LowerPoke( byref c as Ctx, byval id as Tko.NodeId ) as boolean
    dim as Tko.StmtPayload ptr sp = StmtOf( c, id )
    if (sp->count < 2) orelse (sp->count > 3) then return false

    '' The TYPE ARGUMENT arrives as an N_IDENT, not an N_TYPEREF: the intrinsic
    '' argument parser reads every argument as an expression, and 'byte' is a keyword
    '' that parses as a name. So it is matched by SPELLING here rather than by node
    '' kind, which is what a type-kind test would have got wrong.
    dim as long base_ = sp->first
    dim as Tko.TypeId dt = c.types->Builtin( Tko.TY_UBYTE )
    if sp->count = 3 then
        if PeekPokeType_( c, cast( Tko.NodeId, c.ast->children[base_] ), dt ) = false then
            return false
        end if
        base_ += 1
    end if

    dim as MirType mt = LowerType( dt, *c.types )
    if (mt = MT_VOID) orelse (mt = MT_AGG) then return false

    dim as MirValue addr = LowerExpr( c, cast( Tko.NodeId, c.ast->children[base_] ) )
    if addr.kind = cast( ubyte, MV_NONE ) then return false
    dim as Tko.NodeId vn = cast( Tko.NodeId, c.ast->children[base_ + 1] )
    dim as MirValue val = LowerExprN_( c, vn )
    if val.kind = cast( ubyte, MV_NONE ) then return false
    val = CoerceTy( c, val, mt, NumSrcType_( c, vn ))

    '' THE DESTINATION MUST BE A POINTER VALUE, not a slot. In this IR 'store @p, v'
    '' means 'into the slot p' and 'store %t, v' means 'through the pointer in %t' --
    '' and '@p' lowers to the slot reference. Materialising it through a zero-offset
    '' field address is the same idiom the wide-string code uses to turn a base into a
    '' pointer temp. Without it 'poke byte, @p, 5' stored an i8 INTO an i64 slot, which
    '' the verifier caught.
    dim as MirValue dst = addr
    if (dst.kind = cast( ubyte, MV_LOCAL )) orelse (dst.kind = cast( ubyte, MV_GLOBAL )) then
        dim as MirInst fa
        fa.op = cast( ushort, M_FIELD_ADDR )
        fa.ty = cast( ubyte, MT_PTR )
        fa.a = addr
        fa.imm = 0
        dst = Emit( c, fa )
        if dst.kind = cast( ubyte, MV_NONE ) then return false
    end if

    '' AND AN INTEGER ADDRESS IS NOT A POINTER EITHER. 'poke b, b' passes an
    '' INTEGER -- the whole point of POKE -- and it reached the store as an i64
    '' temp: "'%t950' defined with type 'i64' but expected 'ptr'", no object at
    '' all. PEEK already coerces its address; the two halves of one intrinsic
    '' pair gave different answers.
    dst = Coerce( c, dst, MT_PTR, false )
    if dst.kind = cast( ubyte, MV_NONE ) then return false

    dim as MirInst st
    st.op = cast( ushort, M_STORE )
    st.ty = cast( ubyte, MT_VOID )
    st.a = dst
    st.b = val
    Emit( c, st )
    return true
end function

'' The BUILTIN named by a POKE's or PEEK's type argument. Only the fixed-width scalars
'' can be poked, which is what fbc accepts.

'' PEEK -- the read half, and the exact mirror of POKE.
''
'' Measured, all four spellings over the same byte:
''
''   peek( @b )                fb_PrintUByte( 0, B$0, 1 )
''   peek( pb )                fb_PrintUByte( 0, *PB$0, 1 )
''   peek( ubyte, pb )         fb_PrintUByte( 0, *PB$0, 1 )
''   peek( typeof( b ), pb )   fb_PrintUByte( 0, *PB$0, 1 )
''   peek( integer, @i )       fb_PrintLongint( 0, (int64)I$0, 1 )
''
'' -- a LOAD of the named type through the pointer, and UBYTE when no type is named.
'' POKE was implemented and PEEK was not, so every read declined:
'' quirk/peek-poke.bas is 22 statements of them.
'' 'peek( T, p )' IS AN LVALUE -- '*(T*)p' -- and fbc emits no load at all for it: the
'' pointer IS the answer, and 'with peek( T, p )' caches it once. So the same walk
'' answers both questions, and 'wantAddr' picks which.
''
'' It was written scalar-only, so a UDT type argument lowered to MT_AGG and bailed
'' before the pointer was ever computed -- and 'peek( T, p ).i' declined with it, which
'' is what made it look like a WITH problem: 'with *cptr( T ptr, p )' beside it lowered.
function LowerPeek _
    ( byref c as Ctx, byval id as Tko.NodeId, byref outv as MirValue, _
      byval wantAddr as boolean ) as boolean

    if c.ast->Kind( id ) <> Tko.N_CALL then return false
    dim as Tko.ListPayload ptr cp = _
        @c.ast->lists[cast( long, c.ast->nodes[cast( long, id )].data )]
    if (cp->count < 1) orelse (cp->count > 2) then return false
    if cp->target = Tko.NODE_NONE then return false
    if c.ast->Kind( cp->target ) <> Tko.N_IDENT then return false
    dim as Tko.IdentPayload ptr tip = _
        @c.ast->idents[cast( long, c.ast->nodes[cast( long, cp->target )].data )]
    if Tko.Text.LowerAscii( c.names->Spelling( tip->name ) ) <> "peek" then return false
    '' ...AND NOT A PROCEDURE OF THE PROGRAM'S OWN that happens to be spelled PEEK --
    '' see IntrinsicCallType_, which types the call by the same rule.
    scope
        dim as Tko.Symbol ptr psym = c.syms->SymbolAt( c.info->RefOf( cp->target ) )
        if psym <> 0 then
            if psym->kind = cast( ubyte, Tko.SYM_PROC ) then return false
        end if
    end scope

    dim as long base_ = cp->first
    dim as Tko.TypeId dt = c.types->Builtin( Tko.TY_UBYTE )
    if cp->count = 2 then
        dim as Tko.NodeId tn = cast( Tko.NodeId, c.ast->children[base_] )
        dim as Tko.BuiltinType b = PokeTypeName_( c, tn )
        if b <> Tko.TY_NONE then
            dt = c.types->Builtin( b )
        else
            '' 'peek( typeof( b ), p )' names the type as a TYPEOF rather than as a
            '' bare keyword, and it is the same argument either way. In an intrinsic
            '' argument list a typeof arrives as a CALL, so the operand is what
            '' carries the type.
            dim as Tko.TypeId tt = c.info->TypeOf_( tn )
            if (tt = Tko.TYPE_NONE) andalso (c.ast->Kind( tn ) = Tko.N_CALL) then
                dim as Tko.ListPayload ptr tlp = _
                    @c.ast->lists[cast( long, c.ast->nodes[cast( long, tn )].data )]
                if tlp->count = 1 then
                    tt = c.info->TypeOf_( _
                        cast( Tko.NodeId, c.ast->children[tlp->first] ) )
                end if
            end if
            '' ...or a NAMED TYPE: 'type array as ubyte' and then
            '' 'peek( array, array( 0 ) )', where only the POSITION says which
            '' 'array' is the type.
            if c.ast->Kind( tn ) = Tko.N_IDENT then
                dim as Tko.Symbol ptr tsy = c.syms->SymbolAt( c.info->RefOf( tn ) )
                if tsy <> 0 then
                    select case tsy->kind
                    case Tko.SYM_UDT, Tko.SYM_TYPEDEF
                        tt = tsy->type_
                    case else
                        '' Resolve bound the VARIABLE of that spelling; the TYPE that
                        '' shadows it lives in the same scope.
                        dim as Tko.IdentPayload ptr tnip = _
                            @c.ast->idents[cast( long, c.ast->nodes[cast( long, tn )].data )]
                        dim as Tko.SymbolId tt2 = c.syms->LookupTyped( _
                            tsy->parent, tnip->name, true )
                        dim as Tko.Symbol ptr tsy2 = c.syms->SymbolAt( tt2 )
                        if tsy2 <> 0 then
                            select case tsy2->kind
                            case Tko.SYM_UDT, Tko.SYM_TYPEDEF
                                tt = tsy2->type_
                            end select
                        end if
                    end select
                end if
            end if
            if tt = Tko.TYPE_NONE then return false
            dt = tt
        end if
        base_ += 1
    end if

    dim as MirType mt = LowerType( dt, *c.types )
    '' A VALUE still has to fit in one: only the ADDRESS is meaningful for an aggregate.
    if wantAddr = false then
        if (mt = MT_VOID) orelse (mt = MT_AGG) then return false
    end if

    dim as MirValue addr = LowerExpr( c, cast( Tko.NodeId, c.ast->children[base_] ) )
    if addr.kind = cast( ubyte, MV_NONE ) then return false
    addr = Coerce( c, addr, MT_PTR, false )
    if addr.kind = cast( ubyte, MV_NONE ) then return false
    if wantAddr then
        outv = addr
        return true
    end if
    outv = LowerExprLoad( c, addr, mt )
    return (outv.kind <> cast( ubyte, MV_NONE ))
end function


private function PokeTypeName_ _
    ( byref c as Ctx, byval n as Tko.NodeId ) as Tko.BuiltinType

    if c.ast->Kind( n ) <> Tko.N_IDENT then return Tko.TY_NONE
    dim as Tko.IdentPayload ptr ip = _
        @c.ast->idents[cast( long, c.ast->nodes[cast( long, n )].data )]
    select case Tko.Text.LowerAscii( c.names->Spelling( ip->name ) )
    case "byte"     : return Tko.TY_BYTE
    case "ubyte"    : return Tko.TY_UBYTE
    case "short"    : return Tko.TY_SHORT
    case "ushort"   : return Tko.TY_USHORT
    case "long"     : return Tko.TY_LONG
    case "ulong"    : return Tko.TY_ULONG
    case "integer"  : return Tko.TY_INTEGER
    case "uinteger" : return Tko.TY_UINTEGER
    case "longint"  : return Tko.TY_LONGINT
    case "ulongint" : return Tko.TY_ULONGINT
    case "single"   : return Tko.TY_SINGLE
    case "double"   : return Tko.TY_DOUBLE
    end select
    return Tko.TY_NONE
end function
