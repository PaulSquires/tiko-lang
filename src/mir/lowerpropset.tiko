'' lowerpropset.tiko -- a property SETTER call, 't.V = x'.
''
'' Split out of lowerswap.tiko at the 1500-line cap and INCLUDED from it, inside the
'' same namespace. Nothing moved here changed in the move.

'' The setter call itself, its arguments built. A VIRTUAL SETTER DISPATCHES TOO (T49); a
'' plain one is called by name, as before.
private sub EmitPropSetCall_ _
    ( byref c as Ctx, byval target as Tko.NodeId, byval sset as Tko.SymbolId, _
      byref self_ as MirValue, byref args as containers.Array( of uint32 ) )
    dim as int32 svs = PropertyVSlot_( c, target, sset )
    if svs >= 0 then
        dim as MirValue sr = EmitMemberCallArgs_( c, sset, self_, MT_VOID, @args, svs )
        exit sub
    end if
    EmitStructorCall( c, sset, -1, @self_, @args )
end sub

'' 't.V = x': the SETTER, called with the value after the receiver.
function LowerPropertySet_ _
    ( byref c as Ctx, byval target as Tko.NodeId, byval value as Tko.NodeId ) as boolean
    dim as MirValue self_
    dim as int32 sFirst, sCount
    dim as Tko.SymbolId sset = PropertyAt_( _
        c, target, 1, self_, sFirst, sCount, value )
    if sset = Tko.SYMBOL_NONE then return false

    '' The parameter's type, so the value is coerced the way the callee expects.
    dim as Tko.Symbol ptr ss = c.syms->SymbolAt( sset )
    if ss = nullptr then return false
    dim as Tko.NodeId pn = cast( Tko.NodeId, ss->payload )
    if pn = Tko.NODE_NONE then return false
    dim as Tko.StmtPayload ptr pp = StmtOf( c, pn )
    '' THE VALUE IS THE LAST PARAMETER, not the first. For an INDEXED setter the
    '' leading ones are the indices, and taking parameter zero for the value coerced
    '' the value to the INDEX's type.
    dim as Tko.TypeId pt = Tko.TYPE_NONE
    dim as int32 np2 = 0
    dim as boolean ptByref = false
    for i as int32 = 0 to pp->count - 1
        dim as Tko.NodeId prm = c.ast->ChildAt( pp->first, i )
        if c.ast->Kind( prm ) = Tko.N_PARAM then
            pt = c.info->TypeOf_( StmtOf( c, prm )->a )
            ptByref = ((c.ast->Flags( prm ) and Tko.NF_BYREF) <> 0)
            np2 += 1
        end if
    next

    dim as containers.Array( of uint32 ) args
    if PushPropIndexArgs_( c, sset, sFirst, sCount, args ) = false then
    end if

    '' A STRING PARAMETER TAKES A DESCRIPTOR, not the bytes.
    ''
    '' The setter is lowered as '__set__E8FBSTRING(ptr, ptr)' and its body hands the
    '' second argument straight to fb_StrAssign, so it must be a DESCRIPTOR. LowerExpr
    '' over a literal answers with the literal's own global -- its BYTES -- and
    '' fb_StrAssign then read a descriptor out of \"zero\", took a garbage length, and
    '' stored nothing: 'a.first = \"zero\"' followed by 'print a.first' printed an
    '' empty line where fbc prints 'zero'. StrDescriptorOf_ is what borrows a
    '' temporary descriptor for a literal, and it is what every other string-argument
    '' site in this compiler already uses.
    dim as MirValue v
    dim as boolean gotV = false
    '' A UDT WITH A WIDE CAST, FOR A WSTRING PARAMETER, passes what its cast returns:
    '' CRegExp's 'property Pattern( byref wszPattern as const wstring )' given a DWSTRING.
    if pt <> Tko.TYPE_NONE then
        dim as Tko.TypeId upt = c.types->Unqualify( pt )
        if c.types->Kind( upt ) = Tko.TK_BUILTIN then
            if (c.types->BuiltinOf( upt ) = Tko.TY_WSTRING) andalso _
               (WideCastOverload_( c, c.info->TypeOf_( value ) ) <> Tko.SYMBOL_NONE) then
                gotV = UserCastToWide_( c, value, v )
            end if
        end if
    end if
    if (gotV = false) andalso (pt <> Tko.TYPE_NONE) then
        if IsStringType( c, pt ) andalso IsUdtValue_( c, value ) then
            '' A UDT THROUGH ITS STRING CAST is built into a string temporary, as a constructor's
            '' argument is (CtorArgValue_): 'b.T2 = s' over 'byref v as string' borrowed the cast's
            '' result and the program crashed. fbc prints the text.
            dim as int32 sslot = -1
            dim as Tko.TypeId snu = c.types->Unqualify( pt )
            if c.types->Kind( snu ) = Tko.TK_REFERENCE then snu = c.types->Unqualify( c.types->Inner( snu ) )
            gotV = ByvalStrTemp_( c, value, snu, v, sslot )
            if gotV andalso (sslot >= 0) then
                c.f->locals[sslot].frontendType = snu
                c.strTemps.Push( cast( uint32, sslot ) )
            end if
        elseif UStrParamArgTemp_( c, value, pt, v ) orelse NarrowParamArgTemp_( c, value, pt, v ) then
            '' ANY OTHER STRING VALUE takes the shared encoders (UStrRefArg_ / NarrowRefStrArg_): a temporary
            '' and fbc's copy-back. 'o.PS = w' over 'byref v as string' handed the 'wstring * 6' BUFFER
            '' where an FBSTRING* belongs and clang refused the module; 'o.PU = s' gave a ustring
            '' parameter a narrow descriptor (tka-probes/phase4/t_propset.bas).
            gotV = true
        elseif IsStringType( c, pt ) then
            gotV = StrDescriptorOf_( c, value, v )
        end if
    end if
    '' A UDT PARAMETER'S VALUE IS CONVERTED OR COPIED, as a call's argument is (SetterUdtArg_): 'o.P = 5'
    '' over 'byref v as V' was dropped, and a byval V with a destructor got the loaded aggregate.
    if (gotV = false) andalso (np2 > 0) then
        if SetterUdtArg_( c, sset, np2 - 1, value, v ) then
            if v.kind = cast( uint8, MV_NONE ) then return false
            gotV = true
        end if
    end if
    '' A BYREF UDT VALUE TAKES AN ADDRESS, and the parameter's own type does not say
    '' so: a reference is transparent to TypeOf_. 'p( 0 ) = a' over a
    '' 'property p( byval i as long, byref v as A )' passed the LOADED aggregate
    '' where the setter's signature wants a pointer.
    if (gotV = false) andalso ptByref andalso (pt <> Tko.TYPE_NONE) then
        if c.types->Kind( c.types->Unqualify( pt ) ) = Tko.TK_UDT then
            dim as MirValue pa = LowerAddr( c, value )
            if pa.kind <> cast( uint8, MV_NONE ) then
                v = pa
                gotV = true
            end if
        end if
    end if
    '' A UDT VALUE FOR A NUMERIC SETTER goes through its numeric cast: 'b.N2 = m' lowered the object,
    '' coerced nothing, declined -- and the numeric store below wrote over the GETTER's address.
    dim as boolean udtVal = (gotV = false) andalso cbool( pt <> Tko.TYPE_NONE )
    if udtVal then udtVal = IsUdtValue_( c, value )
    if udtVal then
        dim as MirType nvt = LowerType( pt, *c.types )
        if (nvt <> MT_VOID) andalso (nvt <> MT_AGG) andalso (nvt <> MT_PTR) then
            v = LowerNumArg_( c, value, nvt )
            gotV = (v.kind <> cast( uint8, MV_NONE ))
        end if
    end if
    '' A BYREF SCALAR takes an address too: the variable's own, or a temporary for an
    '' rvalue, as an ordinary call's argument does. 's.push = m - 1' over 'property
    '' push( byref i as integer )' passed the VALUE where the setter wants a pointer, and
    '' clang refused the module (manual/proguide/recursion_iteration, five files).
    if (gotV = false) andalso ptByref andalso (pt <> Tko.TYPE_NONE) then
        dim as MirType bmt = LowerType( c.types->Unqualify( pt ), *c.types )
        if (bmt <> MT_VOID) andalso (bmt <> MT_AGG) then
            if c.types->Unqualify( c.info->TypeOf_( value ) ) = c.types->Unqualify( pt ) then
                v = LowerAddr( c, value )
            end if
            if v.kind = cast( uint8, MV_NONE ) then v = ByrefTemp_( c, value, pt )
            if v.kind = cast( uint8, MV_NONE ) then return false
            gotV = true
        end if
    end if
    if gotV = false then v = LowerExpr( c, value )
    if v.kind = cast( uint8, MV_NONE ) then return false
    if gotV = false andalso (pt <> Tko.TYPE_NONE) then
        dim as MirType vmt = LowerType( pt, *c.types )
        if (vmt <> MT_VOID) andalso (vmt <> MT_AGG) then
            v = CoerceTy( c, v, vmt, pt)
            if v.kind = cast( uint8, MV_NONE ) then return false
        end if
    end if
    args.Push( cast( uint32, v.kind ) ) : args.Push( cast( uint32, v.id ) )
    EmitPropSetCall_( c, target, sset, self_, args )
    return true
end function

'' The value parameter of a setter -- its LAST parameter -- and whether it is byref.
private function SetterValueParam_ _
    ( byref c as Ctx, byval sset as Tko.SymbolId, byref byref_ as boolean ) as Tko.TypeId
    dim as Tko.Symbol ptr ss = c.syms->SymbolAt( sset )
    if (ss = nullptr) orelse (ss->payload = 0) then return Tko.TYPE_NONE
    dim as Tko.StmtPayload ptr pp = StmtOf( c, cast( Tko.NodeId, ss->payload ) )
    dim as Tko.TypeId pt = Tko.TYPE_NONE
    for i as int32 = 0 to pp->count - 1
        dim as Tko.NodeId prm = c.ast->ChildAt( pp->first, i )
        if c.ast->Kind( prm ) = Tko.N_PARAM then
            pt = c.info->TypeOf_( StmtOf( c, prm )->a )
            byref_ = ((c.ast->Flags( prm ) and Tko.NF_BYREF) <> 0)
        end if
    next
    return pt
end function

'' Whether two accessors' first n parameters -- an indexed property's indices -- have one
'' type each, so the indices lowered once for the getter serve the setter too.
private function PropIndexTypesMatch_ _
    ( byref c as Ctx, byval a as Tko.SymbolId, byval b as Tko.SymbolId, byval n as int32 ) as boolean
    if n = 0 then return true
    dim as Tko.Symbol ptr sa = c.syms->SymbolAt( a )
    dim as Tko.Symbol ptr sb = c.syms->SymbolAt( b )
    if (sa = nullptr) orelse (sb = nullptr) then return false
    dim as Tko.StmtPayload ptr pa = StmtOf( c, cast( Tko.NodeId, sa->payload ) )
    dim as Tko.StmtPayload ptr pb = StmtOf( c, cast( Tko.NodeId, sb->payload ) )
    if (pa->count < n) orelse (pb->count < n) then return false
    for i as int32 = 0 to n - 1
        dim as Tko.NodeId qa = c.ast->ChildAt( pa->first, i )
        dim as Tko.NodeId qb = c.ast->ChildAt( pb->first, i )
        if (c.ast->Kind( qa ) <> Tko.N_PARAM) orelse (c.ast->Kind( qb ) <> Tko.N_PARAM) then return false
        if c.ast->Flags( qa ) <> c.ast->Flags( qb ) then return false
        dim as Tko.TypeId ta = c.types->Unqualify( c.info->TypeOf_( StmtOf( c, qa )->a ) )
        if ta <> c.types->Unqualify( c.info->TypeOf_( StmtOf( c, qb )->a ) ) then return false
    next
    return true
end function

'' 'b.Size += 2' OVER A PROPERTY: the getter, the operator, the setter. LowerCompoundAssign
'' took LowerAddr of the property, which is the GETTER'S CODE ADDRESS, and wrote the sum over
'' it -- a segfault (B-objects-2). fbc-modern 1.20 refuses the statement (error 9, 'Expected
'' expression'); tiko lowers it as 'b.Size = b.Size + 2' with the receiver and any indices
'' lowered ONCE, for both calls. A numeric property only.
'' -1: not a property, the caller carries on. 0: a member procedure this cannot do -- decline,
'' never store through it. 1: done.
function PropertyCompound_ _
    ( byref c as Ctx, byval target as Tko.NodeId, byval value as Tko.NodeId, _
      byval bop as Tko.TokenKind ) as int32

    dim as MirValue self_
    dim as int32 gFirst, gCount, sFirst, sCount
    dim as Tko.SymbolId g = PropertyAt_( c, target, 0, self_, gFirst, gCount, Tko.NODE_NONE, true )
    if g = Tko.SYMBOL_NONE then
        '' A MEMBER NAMING A PROCEDURE is never storage -- declining beats the getter's
        '' code -- unless its result is BYREF: 'w.Value( ) += 1' is the referent.
        dim as Tko.NodeId mem = target
        if c.ast->Kind( mem ) = Tko.N_CALL then mem = c.ast->ListOf( mem )->target
        if (mem = Tko.NODE_NONE) orelse (c.ast->Kind( mem ) <> Tko.N_MEMBER) then return -1
        dim as Tko.Symbol ptr ms = c.syms->SymbolAt( c.info->RefOf( mem ) )
        if ms = nullptr then return -1
        if ms->kind <> cast( uint8, Tko.SYM_PROC ) then return -1
        dim as Tko.NodeId mpn = cast( Tko.NodeId, ms->payload )
        if (mpn <> Tko.NODE_NONE) andalso (c.ast->Kind( mpn ) = Tko.N_PROC) then
            if (c.ast->Flags( mpn ) and Tko.NF_BYREF) <> 0 then return -1
        end if
        return 0
    end if
    dim as Tko.Symbol ptr gs = c.syms->SymbolAt( g )
    if gs = nullptr then return 0
    dim as Tko.TypeId pty = gs->type_
    dim as MirType gmt = LowerType( pty, *c.types )
    if (gmt = MT_VOID) orelse (gmt = MT_AGG) orelse (gmt = MT_PTR) then return 0
    if IsStringType( c, pty ) then return 0
    '' The setter, chosen by the property's own type -- the value it will be handed.
    dim as Tko.SymbolId sset = PropertyAt_( c, target, 1, self_, sFirst, sCount, target )
    if sset = Tko.SYMBOL_NONE then return 0
    if (sCount <> gCount) orelse (PropIndexTypesMatch_( c, g, sset, gCount ) = false) then return 0
    dim as boolean sByref = false
    dim as Tko.TypeId spt = SetterValueParam_( c, sset, sByref )
    if spt = Tko.TYPE_NONE then return 0
    dim as MirType smt = LowerType( c.types->Unqualify( spt ), *c.types )
    if (smt = MT_VOID) orelse (smt = MT_AGG) orelse (smt = MT_PTR) then return 0

    dim as containers.Array( of uint32 ) gargs
    if PushPropIndexArgs_( c, g, gFirst, gCount, gargs ) = false then return 0
    dim as containers.Array( of uint32 ) sargs
    for i as int32 = 0 to gargs.Count - 1
        sargs.Push( gargs[i] )
    next

    '' THE GETTER -- a byref one returns the address of its answer (LowerPropertyGet_).
    dim as boolean gByref = false
    dim as Tko.NodeId gpn = cast( Tko.NodeId, gs->payload )
    if (gpn <> Tko.NODE_NONE) andalso (c.ast->Kind( gpn ) = Tko.N_PROC) then gByref = ((c.ast->Flags( gpn ) and Tko.NF_BYREF) <> 0)
    dim as MirValue cur
    if gByref then
        dim as MirValue gp = EmitMemberCallArgs_( c, g, self_, MT_PTR, @gargs, PropertyVSlot_( c, target, g ) )
        if gp.kind = cast( uint8, MV_NONE ) then return 0
        cur = LowerExprLoad( c, gp, gmt )
    else
        cur = EmitMemberCallArgs_( c, g, self_, gmt, @gargs, PropertyVSlot_( c, target, g ) )
    end if
    if cur.kind = cast( uint8, MV_NONE ) then return 0

    '' THE OPERATOR, in what 'b.Size op value' would be -- LowerCompoundAssign's rule.
    dim as Tko.TypeId rt = Tko.Check.BinaryResult( bop, pty, c.info->TypeOf_( value ), *c.types )
    dim as MirType wt = MT_VOID
    if rt <> Tko.TYPE_NONE then wt = LowerType( rt, *c.types )
    if (wt = MT_VOID) orelse (wt = MT_AGG) orelse (wt = MT_PTR) then
        rt = pty
        wt = gmt
        if bop = Tko.TK_SLASH then wt = iif( gmt = MT_F32, MT_F32, MT_F64 )
        if bop = Tko.TK_CARET then wt = MT_F64
    end if
    cur = CoerceTy( c, cur, wt, pty )
    dim as MirValue rhs : if UserConvToScalar_( c, value, rt, rhs ) = false then rhs = LowerExpr( c, value )
    if rhs.kind = cast( uint8, MV_NONE ) then return 0
    rhs = CoerceTy( c, rhs, wt, c.info->TypeOf_( value ) )
    dim as MirValue res
    if bop = Tko.TK_CARET then
        dim as containers.Array( of uint32 ) pa
        pa.Push( cast( uint32, cur.kind ) ) : pa.Push( cast( uint32, cur.id ) )
        pa.Push( cast( uint32, rhs.kind ) ) : pa.Push( cast( uint32, rhs.id ) )
        res = EmitRtl( c, RTL_POW, pa )
    elseif (bop = Tko.KW_IMP) orelse (bop = Tko.KW_EQV) then
        res = EmitImpEqv_( c, bop, wt, cur, rhs )
    else
        dim as MirOp mop = BinOpFor( bop, wt, IsUnsignedType( c, rt ) )
        if mop = M_NONE then return 0
        dim as MirInst bi
        bi.op = cast( uint16, mop ) : bi.ty = cast( uint8, wt ) : bi.a = cur : bi.b = rhs
        res = Emit( c, bi )
    end if
    if res.kind = cast( uint8, MV_NONE ) then return 0
    dim as MirValue sv = res
    if IsBooleanType( c, rt ) = false then sv = CoerceTy( c, res, gmt, rt, pty )
    sv = CoerceTy( c, sv, smt, pty, spt )
    if sv.kind = cast( uint8, MV_NONE ) then return 0

    '' THE SETTER, with the same receiver and indices; a byref value parameter gets a temporary.
    if sByref then
        dim as int32 bslot = NewTempLocal( c, smt, SizeOfType( c, c.types->Unqualify( spt ) ) )
        if bslot < 0 then return 0
        dim as MirValue ba
        ba.kind = cast( uint8, MV_LOCAL ) : ba.ty = cast( uint8, MT_PTR ) : ba.id = bslot
        StoreThrough( c, ba, sv )
        sv = ba
    end if
    sargs.Push( cast( uint32, sv.kind ) ) : sargs.Push( cast( uint32, sv.id ) )
    EmitPropSetCall_( c, target, sset, self_, sargs )
    return 1
end function
