'' lowerpropset.tiko -- a property SETTER call, 't.V = x'.
''
'' Split out of lowerswap.tiko at the 1500-line cap and INCLUDED from it, inside the
'' same namespace. Nothing moved here changed in the move.

'' The setter call itself, its arguments built. A VIRTUAL SETTER DISPATCHES TOO (T49); a
'' plain one is called by name, as before.
private sub EmitPropSetCall_ _
    ( byref c as Ctx, byval target as Tko.NodeId, byval sset as Tko.SymbolId, _
      byref self_ as MirValue, byref args as containers.Array( of uint32 ) )
    dim as int32 svs = PropertyVSlot_( c, target, sset )
    if svs >= 0 then
        dim as MirValue sr = EmitMemberCallArgs_( c, sset, self_, MT_VOID, @args, svs )
        exit sub
    end if
    EmitStructorCall( c, sset, -1, @self_, @args )
end sub

'' The wide encoding SETTER'S VALUE gets for a 'wstring' parameter -- see LowerPropertySet_. The
'' ustring temporaries the call path makes are released with the statement's other strings.
private function SetterWideArg_ _
    ( byref c as Ctx, byval value as Tko.NodeId, byval pt as Tko.TypeId, byref outv as MirValue ) as boolean
    dim as Tko.TypeId u = c.types->Unqualify( pt )
    if c.types->Kind( u ) = Tko.TK_REFERENCE then u = c.types->Unqualify( c.types->Inner( u ) )
    if c.types->Kind( u ) <> Tko.TK_BUILTIN then return false
    if c.types->BuiltinOf( u ) <> Tko.TY_WSTRING then return false
    dim as containers.Array( of uint32 ) tt, tty
    dim as boolean ok = UdtWideArg_( c, value, outv, tt, tty )
    if ok = false then ok = WideArgOperand_( c, value, outv, tt, tty )
    if (ok = false) andalso IsNarrowStrArg_( c, c.info->TypeOf_( value ) ) then ok = NarrowToWideTemp_( c, value, outv )
    for i as int32 = 0 to tt.Count - 1
        c.f->locals[cast( int32, tt[i] )].frontendType = cast( Tko.TypeId, tty[i] )
        c.strTemps.Push( tt[i] )
    next
    return ok andalso (outv.kind <> cast( uint8, MV_NONE ))
end function

'' 't.V = x': the SETTER, called with the value after the receiver.
function LowerPropertySet_ _
    ( byref c as Ctx, byval target as Tko.NodeId, byval value as Tko.NodeId ) as boolean
    dim as MirValue self_
    dim as int32 sFirst, sCount
    dim as Tko.SymbolId sset = PropertyAt_( _
        c, target, 1, self_, sFirst, sCount, value )
    if sset = Tko.SYMBOL_NONE then return false

    '' The parameter's type, so the value is coerced the way the callee expects.
    dim as Tko.Symbol ptr ss = c.syms->SymbolAt( sset )
    if ss = nullptr then return false
    dim as Tko.NodeId pn = cast( Tko.NodeId, ss->payload )
    if pn = Tko.NODE_NONE then return false
    dim as Tko.StmtPayload ptr pp = StmtOf( c, pn )
    '' THE VALUE IS THE LAST PARAMETER, not the first. For an INDEXED setter the
    '' leading ones are the indices, and taking parameter zero for the value coerced
    '' the value to the INDEX's type.
    dim as Tko.TypeId pt = Tko.TYPE_NONE
    dim as int32 np2 = 0
    dim as boolean ptByref = false
    for i as int32 = 0 to pp->count - 1
        dim as Tko.NodeId prm = c.ast->ChildAt( pp->first, i )
        if c.ast->Kind( prm ) = Tko.N_PARAM then
            pt = c.info->TypeOf_( StmtOf( c, prm )->a )
            ptByref = ((c.ast->Flags( prm ) and Tko.NF_BYREF) <> 0)
            np2 += 1
        end if
    next

    dim as containers.Array( of uint32 ) args
    if PushPropIndexArgs_( c, sset, sFirst, sCount, args ) = false then
    end if

    '' A STRING PARAMETER TAKES A DESCRIPTOR, not the bytes.
    ''
    '' The setter is lowered as '__set__E8FBSTRING(ptr, ptr)' and its body hands the
    '' second argument straight to fb_StrAssign, so it must be a DESCRIPTOR. LowerExpr
    '' over a literal answers with the literal's own global -- its BYTES -- and
    '' fb_StrAssign then read a descriptor out of \"zero\", took a garbage length, and
    '' stored nothing: 'a.first = \"zero\"' followed by 'print a.first' printed an
    '' empty line where fbc prints 'zero'. StrDescriptorOf_ is what borrows a
    '' temporary descriptor for a literal, and it is what every other string-argument
    '' site in this compiler already uses.
    dim as MirValue v
    dim as boolean gotV = false
    '' A UDT WITH A WIDE CAST, FOR A WSTRING PARAMETER, passes what its cast returns:
    '' CRegExp's 'property Pattern( byref wszPattern as const wstring )' given a DWSTRING.
    if pt <> Tko.TYPE_NONE then
        dim as Tko.TypeId upt = c.types->Unqualify( pt )
        if c.types->Kind( upt ) = Tko.TK_BUILTIN then
            if (c.types->BuiltinOf( upt ) = Tko.TY_WSTRING) andalso _
               (WideCastOverload_( c, c.info->TypeOf_( value ) ) <> Tko.SYMBOL_NONE) then
                gotV = UserCastToWide_( c, value, v )
            end if
        end if
    end if
    '' A 'BYREF AS WSTRING' SETTER TAKES WIDE CHARACTERS, encoded as a call's argument is
    '' (lowercall.tiko): a wide lvalue's own address, a ustring's UTF-16 data, a narrow value
    '' widened into a temporary. Nothing here owned the shape, so 't.Name = w' over a 'wstring * 32'
    '' passed the LOADED buffer (clang refused the module, TKO0113), a ustring passed its
    '' descriptor's bytes, and '= "Arial"' passed narrow bytes the setter read as UTF-16 --
    '' sys/win's CWindow.DefaultFontName and CRichEditCtx.Text. fbc-modern 1.20 prints the text
    '' for all three. FINDINGS 5.1.
    if (gotV = false) andalso (pt <> Tko.TYPE_NONE) then
        if SetterWideArg_( c, value, pt, v ) then gotV = true
    end if
    if (gotV = false) andalso (pt <> Tko.TYPE_NONE) then
        if IsStringType( c, pt ) andalso IsUdtValue_( c, value ) then
            '' A UDT THROUGH ITS STRING CAST is built into a string temporary, as a constructor's
            '' argument is (CtorArgValue_): 'b.T2 = s' over 'byref v as string' borrowed the cast's
            '' result and the program crashed. fbc prints the text.
            dim as int32 sslot = -1
            dim as Tko.TypeId snu = c.types->Unqualify( pt )
            if c.types->Kind( snu ) = Tko.TK_REFERENCE then snu = c.types->Unqualify( c.types->Inner( snu ) )
            gotV = ByvalStrTemp_( c, value, snu, v, sslot )
            if gotV andalso (sslot >= 0) then
                c.f->locals[sslot].frontendType = snu
                c.strTemps.Push( cast( uint32, sslot ) )
            end if
        elseif UStrParamArgTemp_( c, value, pt, v ) orelse NarrowParamArgTemp_( c, value, pt, v ) then
            '' ANY OTHER STRING VALUE takes the shared encoders (UStrRefArg_ / NarrowRefStrArg_): a temporary
            '' and fbc's copy-back. 'o.PS = w' over 'byref v as string' handed the 'wstring * 6' BUFFER
            '' where an FBSTRING* belongs and clang refused the module; 'o.PU = s' gave a ustring
            '' parameter a narrow descriptor (tka-probes/phase4/t_propset.bas).
            gotV = true
        elseif IsStringType( c, pt ) then
            gotV = StrDescriptorOf_( c, value, v )
        end if
    end if
    '' A UDT PARAMETER'S VALUE IS CONVERTED OR COPIED, as a call's argument is (SetterUdtArg_): 'o.P = 5'
    '' over 'byref v as V' was dropped, and a byval V with a destructor got the loaded aggregate.
    if (gotV = false) andalso (np2 > 0) then
        if SetterUdtArg_( c, sset, np2 - 1, value, v ) then
            if v.kind = cast( uint8, MV_NONE ) then return false
            gotV = true
        end if
    end if
    '' A BYREF UDT VALUE TAKES AN ADDRESS, and the parameter's own type does not say
    '' so: a reference is transparent to TypeOf_. 'p( 0 ) = a' over a
    '' 'property p( byval i as long, byref v as A )' passed the LOADED aggregate
    '' where the setter's signature wants a pointer.
    if (gotV = false) andalso ptByref andalso (pt <> Tko.TYPE_NONE) then
        if c.types->Kind( c.types->Unqualify( pt ) ) = Tko.TK_UDT then
            dim as MirValue pa = LowerAddr( c, value )
            if pa.kind <> cast( uint8, MV_NONE ) then
                v = pa
                gotV = true
            end if
        end if
    end if
    '' A UDT VALUE FOR A NUMERIC SETTER goes through its numeric cast: 'b.N2 = m' lowered the object,
    '' coerced nothing, declined -- and the numeric store below wrote over the GETTER's address.
    dim as boolean udtVal = (gotV = false) andalso cbool( pt <> Tko.TYPE_NONE )
    if udtVal then udtVal = IsUdtValue_( c, value )
    if udtVal then
        dim as MirType nvt = LowerType( pt, *c.types )
        if (nvt <> MT_VOID) andalso (nvt <> MT_AGG) andalso (nvt <> MT_PTR) then
            v = LowerNumArg_( c, value, nvt )
            gotV = (v.kind <> cast( uint8, MV_NONE ))
        end if
    end if
    '' A BYREF SCALAR takes an address too: the variable's own, or a temporary for an
    '' rvalue, as an ordinary call's argument does. 's.push = m - 1' over 'property
    '' push( byref i as integer )' passed the VALUE where the setter wants a pointer, and
    '' clang refused the module (manual/proguide/recursion_iteration, five files).
    if (gotV = false) andalso ptByref andalso (pt <> Tko.TYPE_NONE) then
        dim as MirType bmt = LowerType( c.types->Unqualify( pt ), *c.types )
        if (bmt <> MT_VOID) andalso (bmt <> MT_AGG) then
            if c.types->Unqualify( c.info->TypeOf_( value ) ) = c.types->Unqualify( pt ) then
                v = LowerAddr( c, value )
            end if
            if v.kind = cast( uint8, MV_NONE ) then v = ByrefTemp_( c, value, pt )
            if v.kind = cast( uint8, MV_NONE ) then return false
            gotV = true
        end if
    end if
    if gotV = false then v = LowerExpr( c, value )
    if v.kind = cast( uint8, MV_NONE ) then return false
    if gotV = false andalso (pt <> Tko.TYPE_NONE) then
        dim as MirType vmt = LowerType( pt, *c.types )
        if (vmt <> MT_VOID) andalso (vmt <> MT_AGG) then
            v = CoerceTy( c, v, vmt, pt)
            if v.kind = cast( uint8, MV_NONE ) then return false
        end if
    end if
    args.Push( cast( uint32, v.kind ) ) : args.Push( cast( uint32, v.id ) )
    EmitPropSetCall_( c, target, sset, self_, args )
    return true
end function

'' The value parameter of a setter -- its LAST parameter -- and whether it is byref.
private function SetterValueParam_ _
    ( byref c as Ctx, byval sset as Tko.SymbolId, byref byref_ as boolean ) as Tko.TypeId
    dim as Tko.Symbol ptr ss = c.syms->SymbolAt( sset )
    if (ss = nullptr) orelse (ss->payload = 0) then return Tko.TYPE_NONE
    dim as Tko.StmtPayload ptr pp = StmtOf( c, cast( Tko.NodeId, ss->payload ) )
    dim as Tko.TypeId pt = Tko.TYPE_NONE
    for i as int32 = 0 to pp->count - 1
        dim as Tko.NodeId prm = c.ast->ChildAt( pp->first, i )
        if c.ast->Kind( prm ) = Tko.N_PARAM then
            pt = c.info->TypeOf_( StmtOf( c, prm )->a )
            byref_ = ((c.ast->Flags( prm ) and Tko.NF_BYREF) <> 0)
        end if
    next
    return pt
end function

'' Whether two accessors' first n parameters -- an indexed property's indices -- have one
'' type each, so the indices lowered once for the getter serve the setter too.
private function PropIndexTypesMatch_ _
    ( byref c as Ctx, byval a as Tko.SymbolId, byval b as Tko.SymbolId, byval n as int32 ) as boolean
    if n = 0 then return true
    dim as Tko.Symbol ptr sa = c.syms->SymbolAt( a )
    dim as Tko.Symbol ptr sb = c.syms->SymbolAt( b )
    if (sa = nullptr) orelse (sb = nullptr) then return false
    dim as Tko.StmtPayload ptr pa = StmtOf( c, cast( Tko.NodeId, sa->payload ) )
    dim as Tko.StmtPayload ptr pb = StmtOf( c, cast( Tko.NodeId, sb->payload ) )
    if (pa->count < n) orelse (pb->count < n) then return false
    for i as int32 = 0 to n - 1
        dim as Tko.NodeId qa = c.ast->ChildAt( pa->first, i )
        dim as Tko.NodeId qb = c.ast->ChildAt( pb->first, i )
        if (c.ast->Kind( qa ) <> Tko.N_PARAM) orelse (c.ast->Kind( qb ) <> Tko.N_PARAM) then return false
        if c.ast->Flags( qa ) <> c.ast->Flags( qb ) then return false
        dim as Tko.TypeId ta = c.types->Unqualify( c.info->TypeOf_( StmtOf( c, qa )->a ) )
        if ta <> c.types->Unqualify( c.info->TypeOf_( StmtOf( c, qb )->a ) ) then return false
    next
    return true
end function

'' 'b.Size += 2' OVER A PROPERTY: the getter, the operator, the setter. LowerCompoundAssign
'' took LowerAddr of the property, which is the GETTER'S CODE ADDRESS, and wrote the sum over
'' it -- a segfault (B-objects-2). fbc-modern 1.20 refuses the statement (error 9, 'Expected
'' expression'); tiko lowers it as 'b.Size = b.Size + 2' with the receiver and any indices
'' lowered ONCE, for both calls. A numeric property only.
'' -1: not a property, the caller carries on. 0: a member procedure this cannot do -- decline,
'' never store through it. 1: done.
function PropertyCompound_ _
    ( byref c as Ctx, byval target as Tko.NodeId, byval value as Tko.NodeId, _
      byval bop as Tko.TokenKind ) as int32

    dim as MirValue self_
    dim as int32 gFirst, gCount, sFirst, sCount
    dim as Tko.SymbolId g = PropertyAt_( c, target, 0, self_, gFirst, gCount, Tko.NODE_NONE, true )
    if g = Tko.SYMBOL_NONE then
        '' A MEMBER NAMING A PROCEDURE is never storage -- declining beats the getter's
        '' code -- unless its result is BYREF: 'w.Value( ) += 1' is the referent.
        dim as Tko.NodeId mem = target
        if c.ast->Kind( mem ) = Tko.N_CALL then mem = c.ast->ListOf( mem )->target
        if (mem = Tko.NODE_NONE) orelse (c.ast->Kind( mem ) <> Tko.N_MEMBER) then return -1
        dim as Tko.Symbol ptr ms = c.syms->SymbolAt( c.info->RefOf( mem ) )
        if ms = nullptr then return -1
        if ms->kind <> cast( uint8, Tko.SYM_PROC ) then return -1
        dim as Tko.NodeId mpn = cast( Tko.NodeId, ms->payload )
        if (mpn <> Tko.NODE_NONE) andalso (c.ast->Kind( mpn ) = Tko.N_PROC) then
            if (c.ast->Flags( mpn ) and Tko.NF_BYREF) <> 0 then return -1
        end if
        return 0
    end if
    dim as Tko.Symbol ptr gs = c.syms->SymbolAt( g )
    if gs = nullptr then return 0
    dim as Tko.TypeId pty = gs->type_
    dim as MirType gmt = LowerType( pty, *c.types )
    if (gmt = MT_VOID) orelse (gmt = MT_AGG) orelse (gmt = MT_PTR) then return 0
    if IsStringType( c, pty ) then return 0
    '' The setter, chosen by the property's own type -- the value it will be handed.
    dim as Tko.SymbolId sset = PropertyAt_( c, target, 1, self_, sFirst, sCount, target )
    if sset = Tko.SYMBOL_NONE then
        '' NO SETTER, BUT A BYREF GETTER: 'vv.X += 2' is the referent's own compound
        '' assignment, as 'vv.X = 5' is its store -- LowerAddr answers the referent. Declining
        '' here left the statement uncompiled (TKO0994, docs/tiko-properties D5); fbc-modern
        '' 1.20 prints the sum.
        dim as Tko.NodeId gdn = cast( Tko.NodeId, gs->payload )
        if (gdn <> Tko.NODE_NONE) andalso (c.ast->Kind( gdn ) = Tko.N_PROC) then
            if (c.ast->Flags( gdn ) and Tko.NF_BYREF) <> 0 then return -1
        end if
        return 0
    end if
    if (sCount <> gCount) orelse (PropIndexTypesMatch_( c, g, sset, gCount ) = false) then return 0
    dim as boolean sByref = false
    dim as Tko.TypeId spt = SetterValueParam_( c, sset, sByref )
    if spt = Tko.TYPE_NONE then return 0
    dim as MirType smt = LowerType( c.types->Unqualify( spt ), *c.types )
    if (smt = MT_VOID) orelse (smt = MT_AGG) orelse (smt = MT_PTR) then return 0

    dim as containers.Array( of uint32 ) gargs
    if PushPropIndexArgs_( c, g, gFirst, gCount, gargs ) = false then return 0
    dim as containers.Array( of uint32 ) sargs
    for i as int32 = 0 to gargs.Count - 1
        sargs.Push( gargs[i] )
    next

    '' THE GETTER -- a byref one returns the address of its answer (LowerPropertyGet_).
    dim as boolean gByref = false
    dim as Tko.NodeId gpn = cast( Tko.NodeId, gs->payload )
    if (gpn <> Tko.NODE_NONE) andalso (c.ast->Kind( gpn ) = Tko.N_PROC) then gByref = ((c.ast->Flags( gpn ) and Tko.NF_BYREF) <> 0)
    dim as MirValue cur
    if gByref then
        dim as MirValue gp = EmitMemberCallArgs_( c, g, self_, MT_PTR, @gargs, PropertyVSlot_( c, target, g ) )
        if gp.kind = cast( uint8, MV_NONE ) then return 0
        cur = LowerExprLoad( c, gp, gmt )
    else
        cur = EmitMemberCallArgs_( c, g, self_, gmt, @gargs, PropertyVSlot_( c, target, g ) )
    end if
    if cur.kind = cast( uint8, MV_NONE ) then return 0

    '' THE OPERATOR, in what 'b.Size op value' would be -- LowerCompoundAssign's rule.
    dim as Tko.TypeId rt = Tko.Check.BinaryResult( bop, pty, c.info->TypeOf_( value ), *c.types )
    dim as MirType wt = MT_VOID
    if rt <> Tko.TYPE_NONE then wt = LowerType( rt, *c.types )
    if (wt = MT_VOID) orelse (wt = MT_AGG) orelse (wt = MT_PTR) then
        rt = pty
        wt = gmt
        if bop = Tko.TK_SLASH then wt = iif( gmt = MT_F32, MT_F32, MT_F64 )
        if bop = Tko.TK_CARET then wt = MT_F64
    end if
    cur = CoerceTy( c, cur, wt, pty )
    dim as MirValue rhs : if UserConvToScalar_( c, value, rt, rhs ) = false then rhs = LowerExpr( c, value )
    if rhs.kind = cast( uint8, MV_NONE ) then return 0
    rhs = CoerceTy( c, rhs, wt, c.info->TypeOf_( value ) )
    dim as MirValue res
    if bop = Tko.TK_CARET then
        dim as containers.Array( of uint32 ) pa
        pa.Push( cast( uint32, cur.kind ) ) : pa.Push( cast( uint32, cur.id ) )
        pa.Push( cast( uint32, rhs.kind ) ) : pa.Push( cast( uint32, rhs.id ) )
        res = EmitRtl( c, RTL_POW, pa )
    elseif (bop = Tko.KW_IMP) orelse (bop = Tko.KW_EQV) then
        res = EmitImpEqv_( c, bop, wt, cur, rhs )
    else
        dim as MirOp mop = BinOpFor( bop, wt, IsUnsignedType( c, rt ) )
        if mop = M_NONE then return 0
        dim as MirInst bi
        bi.op = cast( uint16, mop ) : bi.ty = cast( uint8, wt ) : bi.a = cur : bi.b = rhs
        res = Emit( c, bi )
    end if
    if res.kind = cast( uint8, MV_NONE ) then return 0
    dim as MirValue sv = res
    if IsBooleanType( c, rt ) = false then sv = CoerceTy( c, res, gmt, rt, pty )
    sv = CoerceTy( c, sv, smt, pty, spt )
    if sv.kind = cast( uint8, MV_NONE ) then return 0

    '' THE SETTER, with the same receiver and indices; a byref value parameter gets a temporary.
    if sByref then
        dim as int32 bslot = NewTempLocal( c, smt, SizeOfType( c, c.types->Unqualify( spt ) ) )
        if bslot < 0 then return 0
        dim as MirValue ba
        ba.kind = cast( uint8, MV_LOCAL ) : ba.ty = cast( uint8, MT_PTR ) : ba.id = bslot
        StoreThrough( c, ba, sv )
        sv = ba
    end if
    sargs.Push( cast( uint32, sv.kind ) ) : sargs.Push( cast( uint32, sv.id ) )
    EmitPropSetCall_( c, target, sset, self_, sargs )
    return 1
end function

'' Whether a SWAP operand is a property with a SETTER: 'o.P', 'o.P( i )', or a bare 'P'
'' inside a method. A byref getter with no setter is not one -- LowerAddr already answers
'' its referent, so the ordinary address-first swap is right for it.
private function SwapPropOperand_( byref c as Ctx, byval e as Tko.NodeId ) as boolean
    dim as Tko.NodeId m = e
    if c.ast->Kind( m ) = Tko.N_CALL then m = c.ast->ListOf( m )->target
    if m = Tko.NODE_NONE then return false
    if c.ast->Kind( m ) = Tko.N_IDENT then
        if ImplicitThisProp_( c, m ) = false then return false
    elseif c.ast->Kind( m ) <> Tko.N_MEMBER then
        return false
    end if
    dim as Tko.Symbol ptr s = c.syms->SymbolAt( c.info->RefOf( m ) )
    if s = nullptr then return false
    if (s->kind <> cast( uint8, Tko.SYM_PROC )) orelse (s->payload = 0) then return false
    dim as Tko.NodeId pn = cast( Tko.NodeId, s->payload )
    if c.ast->Kind( pn ) <> Tko.N_PROC then return false
    if StmtOf( c, pn )->op <> cast( uint16, Tko.KW_PROPERTY ) then return false
    dim as Tko.SymbolId h = c.syms->LookupLocal( s->parent, s->name )
    if h = Tko.SYMBOL_NONE then h = c.info->RefOf( m )
    while h <> Tko.SYMBOL_NONE
        dim as Tko.Symbol ptr q = c.syms->SymbolAt( h )
        if q = nullptr then exit while
        if (q->kind = cast( uint8, Tko.SYM_PROC )) andalso (q->payload <> 0) then
            dim as Tko.NodeId qn = cast( Tko.NodeId, q->payload )
            if c.ast->Kind( qn ) = Tko.N_PROC then
                dim as Tko.StmtPayload ptr qp = StmtOf( c, qn )
                if (qp->op = cast( uint16, Tko.KW_PROPERTY )) andalso (qp->a = Tko.NODE_NONE) then return true
            end if
        end if
        h = q->nextOverload
    wend
    return false
end function

'' One side of a property swap, opened: the receiver and the indices lowered ONCE for both
'' its getter and its setter -- or, for an ordinary lvalue, its address.
private function SwapSideOpen_ _
    ( byref c as Ctx, byval e as Tko.NodeId, byref isProp as boolean, _
      byref g as Tko.SymbolId, byref s as Tko.SymbolId, byref self_ as MirValue, _
      byref idx as containers.Array( of uint32 ), byref addr as MirValue ) as boolean
    isProp = SwapPropOperand_( c, e )
    if isProp = false then
        addr = LowerAddr( c, e )
        return (addr.kind <> cast( uint8, MV_NONE ))
    end if
    dim as int32 sFirst, sCount, gFirst, gCount
    s = PropertyAt_( c, e, 1, self_, sFirst, sCount, e )
    if s = Tko.SYMBOL_NONE then return false
    dim as MirValue unused
    g = PropertyAt_( c, e, 0, unused, gFirst, gCount, Tko.NODE_NONE, true )
    if g = Tko.SYMBOL_NONE then return false
    if (sCount <> gCount) orelse (PropIndexTypesMatch_( c, g, s, gCount ) = false) then return false
    return PushPropIndexArgs_( c, g, gFirst, gCount, idx )
end function

'' The side's value, in its own type: the getter (a byref one answers an address), or a load.
private function SwapSideGet_ _
    ( byref c as Ctx, byval e as Tko.NodeId, byval isProp as boolean, byval g as Tko.SymbolId, _
      byref self_ as MirValue, byref idx as containers.Array( of uint32 ), _
      byref addr as MirValue, byval mt as MirType ) as MirValue
    if isProp = false then return LowerExprLoad( c, addr, mt )
    dim as containers.Array( of uint32 ) args
    for i as int32 = 0 to idx.Count - 1
        args.Push( idx[i] )
    next
    dim as Tko.Symbol ptr gs = c.syms->SymbolAt( g )
    dim as Tko.NodeId gpn = cast( Tko.NodeId, gs->payload )
    if (c.ast->Flags( gpn ) and Tko.NF_BYREF) <> 0 then
        dim as MirValue gp = EmitMemberCallArgs_( c, g, self_, MT_PTR, @args, PropertyVSlot_( c, e, g ) )
        if gp.kind = cast( uint8, MV_NONE ) then return gp
        return LowerExprLoad( c, gp, mt )
    end if
    return EmitMemberCallArgs_( c, g, self_, mt, @args, PropertyVSlot_( c, e, g ) )
end function

'' Write 'v' (of frontend type 'vt') into the side: its setter, or a store.
private function SwapSideSet_ _
    ( byref c as Ctx, byval e as Tko.NodeId, byval isProp as boolean, byval s as Tko.SymbolId, _
      byref self_ as MirValue, byref idx as containers.Array( of uint32 ), _
      byref addr as MirValue, byref v as MirValue, byval vt as Tko.TypeId ) as boolean
    if isProp = false then
        dim as Tko.TypeId et = c.info->TypeOf_( e )
        dim as MirValue sv = CoerceTy( c, v, LowerType( et, *c.types ), vt, et )
        if sv.kind = cast( uint8, MV_NONE ) then return false
        StoreThrough( c, addr, sv )
        return true
    end if
    dim as boolean sByref = false
    dim as Tko.TypeId spt = SetterValueParam_( c, s, sByref )
    if spt = Tko.TYPE_NONE then return false
    dim as MirType smt = LowerType( c.types->Unqualify( spt ), *c.types )
    if (smt = MT_VOID) orelse (smt = MT_AGG) then return false
    dim as MirValue sv = CoerceTy( c, v, smt, vt, spt )
    if sv.kind = cast( uint8, MV_NONE ) then return false
    if sByref then
        dim as int32 bslot = NewTempLocal( c, smt, SizeOfType( c, c.types->Unqualify( spt ) ) )
        if bslot < 0 then return false
        dim as MirValue ba
        ba.kind = cast( uint8, MV_LOCAL ) : ba.ty = cast( uint8, MT_PTR ) : ba.id = bslot
        StoreThrough( c, ba, sv )
        sv = ba
    end if
    dim as containers.Array( of uint32 ) args
    for i as int32 = 0 to idx.Count - 1
        args.Push( idx[i] )
    next
    args.Push( cast( uint32, sv.kind ) ) : args.Push( cast( uint32, sv.id ) )
    EmitPropSetCall_( c, e, s, self_, args )
    return true
end function

'' 'swap a.P, b.P' OVER A PROPERTY: get A, get B, set A, set B -- each receiver and index
'' lowered once. The address-first swap took LowerAddr of the property, which is the GETTER'S
'' CODE, and the program crashed (docs/tiko-properties D1). fbc-modern 1.20 refuses the
'' statement (error 99); tiko lowers it, as it lowers 'b.Size += 2' (PropertyCompound_). A
'' scalar property only: a string or UDT one is refused by Check (TKO0681) and never gets here.
'' -1: neither side is a property, the caller carries on. 0: decline. 1: done.
function PropertySwap_ _
    ( byref c as Ctx, byval a as Tko.NodeId, byval b as Tko.NodeId ) as int32
    dim as boolean pa = SwapPropOperand_( c, a ), pb = SwapPropOperand_( c, b )
    if (pa = false) andalso (pb = false) then return -1
    dim as Tko.TypeId ta = c.info->TypeOf_( a ), tb = c.info->TypeOf_( b )
    dim as MirType ma = LowerType( ta, *c.types ), mb = LowerType( tb, *c.types )
    if (ma = MT_VOID) orelse (ma = MT_AGG) orelse (mb = MT_VOID) orelse (mb = MT_AGG) then return 0
    if IsStringType( c, ta ) orelse IsStringType( c, tb ) then return 0
    dim as boolean ia, ib
    dim as Tko.SymbolId ga, sa, gb, sb
    dim as MirValue selfA, selfB, addrA, addrB
    dim as containers.Array( of uint32 ) idxA, idxB
    if SwapSideOpen_( c, a, ia, ga, sa, selfA, idxA, addrA ) = false then return 0
    if SwapSideOpen_( c, b, ib, gb, sb, selfB, idxB, addrB ) = false then return 0
    dim as MirValue va = SwapSideGet_( c, a, ia, ga, selfA, idxA, addrA, ma )
    if va.kind = cast( uint8, MV_NONE ) then return 0
    dim as MirValue vb = SwapSideGet_( c, b, ib, gb, selfB, idxB, addrB, mb )
    if vb.kind = cast( uint8, MV_NONE ) then return 0
    if SwapSideSet_( c, a, ia, sa, selfA, idxA, addrA, vb, tb ) = false then return 0
    if SwapSideSet_( c, b, ib, sb, selfB, idxB, addrB, va, ta ) = false then return 0
    return 1
end function

'' A PROPERTY WITH A SETTER -- 'o.P', 'o.P( i )', a bare 'P' in a method -- for a caller in
'' another unit: see PropStrCatAssign_ (lowerconcat.tiko).
function IsSettableProperty_( byref c as Ctx, byval e as Tko.NodeId ) as boolean
    return SwapPropOperand_( c, e )
end function

'' The SETTER of 'target' called with a value already lowered -- for a string, the address of a
'' descriptor the caller owns. The setter is chosen by the property's own type, as
'' PropertyCompound_ chooses it.
function PropertySetValue_ _
    ( byref c as Ctx, byval target as Tko.NodeId, byref v as MirValue ) as boolean
    dim as MirValue self_
    dim as int32 sFirst, sCount
    dim as Tko.SymbolId sset = PropertyAt_( c, target, 1, self_, sFirst, sCount, target )
    if sset = Tko.SYMBOL_NONE then return false
    dim as containers.Array( of uint32 ) args
    if PushPropIndexArgs_( c, sset, sFirst, sCount, args ) = false then return false
    args.Push( cast( uint32, v.kind ) ) : args.Push( cast( uint32, v.id ) )
    EmitPropSetCall_( c, target, sset, self_, args )
    return true
end function

'' How many parameters a procedure declares.
private function PropParamCount_( byref c as Ctx, byval sid as Tko.SymbolId ) as int32
    dim as Tko.Symbol ptr s = c.syms->SymbolAt( sid )
    if s = nullptr then return 0
    dim as Tko.NodeId pn = cast( Tko.NodeId, s->payload )
    if (pn = Tko.NODE_NONE) orelse (c.ast->Kind( pn ) <> Tko.N_PROC) then return 0
    dim as Tko.StmtPayload ptr pp = StmtOf( c, pn )
    dim as int32 n = 0
    for i as int32 = 0 to pp->count - 1
        if c.ast->Kind( c.ast->ChildAt( pp->first, i ) ) = Tko.N_PARAM then n += 1
    next
    return n
end function

'' The type that owns a member procedure's scope, or TYPE_NONE.
private function OwnerTypeOf_( byref c as Ctx, byval sid as Tko.SymbolId ) as Tko.TypeId
    dim as Tko.Symbol ptr s = c.syms->SymbolAt( sid )
    if s = nullptr then return Tko.TYPE_NONE
    dim as Tko.SymScope ptr sc = c.syms->ScopeAt( s->parent )
    if sc = nullptr then return Tko.TYPE_NONE
    if sc->kind <> cast( uint8, Tko.SCOPEK_TYPE ) then return Tko.TYPE_NONE
    dim as Tko.Symbol ptr ow = c.syms->SymbolAt( sc->owner )
    if ow = nullptr then return Tko.TYPE_NONE
    return ow->type_
end function

'' WHETHER THE PROCEDURE BEING LOWERED MAY CALL SETTER 'sset' -- the copy-back is the setter's call,
'' so it obeys what an assignment would (Sem checked the getter only): a private or protected setter
'' from a procedure of its own type, an init-only one (an auto-property's 'get', 'get, init') from
'' its type's constructor only, a static init-only one never. A setter this cannot reach leaves the
'' argument a temporary, as fbc does for every property -- not an error: FB passes strings byref
'' to read them as often as to write them.
private function SetterUsableHere_( byref c as Ctx, byval sset as Tko.SymbolId ) as boolean
    dim as Tko.Symbol ptr s = c.syms->SymbolAt( sset )
    if s = nullptr then return false
    dim as Tko.NodeId pn = cast( Tko.NodeId, s->payload )
    dim as uint32 ex = 0
    if (pn <> Tko.NODE_NONE) andalso (c.ast->Kind( pn ) = Tko.N_PROC) then ex = StmtOf( c, pn )->extra
    dim as boolean restricted = ((s->flags and (Tko.SYMF_MEMB_PRIVATE or Tko.SYMF_MEMB_PROTECTED)) <> 0)
    dim as boolean initOnly = ((ex and Tko.PF_INIT_ONLY) <> 0)
    if (restricted = false) andalso (initOnly = false) then return true
    if initOnly andalso ((ex and Tko.PF_STATIC) <> 0) then return false
    dim as Tko.TypeId own = OwnerTypeOf_( c, sset )
    if (own = Tko.TYPE_NONE) orelse (OwnerTypeOf_( c, c.curProcSym ) <> own) then return false
    if initOnly = false then return true
    dim as Tko.Symbol ptr me_ = c.syms->SymbolAt( c.curProcSym )
    if me_ = nullptr then return false
    dim as Tko.NodeId mpn = cast( Tko.NodeId, me_->payload )
    if (mpn = Tko.NODE_NONE) orelse (c.ast->Kind( mpn ) <> Tko.N_PROC) then return false
    return (StmtOf( c, mpn )->op = cast( uint16, Tko.KW_CONSTRUCTOR ))
end function

'' A PROPERTY PASSED TO A BYREF PARAMETER IS COPIED BACK (docs/tiko-properties R12, decision Q5): the
'' getter's value goes into a temporary, the callee is given its address -- as before -- and its
'' setter is called with the temporary after the call returns, as VB.NET and Swift do. The write was
'' lost (fbc loses it too). Recorded in the call's copy-back list, flushed by CopyBackUStrArgs_.
'' Not for a 'byref as const' parameter, nor a property with no setter.
sub PropByrefBacks_ _
    ( byref c as Ctx, byval callee as Tko.SymbolId, byval pbase as int32, byval argFirst as int32, _
      byval argCount as int32, byref slotKind as containers.Array( of uint32 ), _
      byref slotId as containers.Array( of uint32 ), byref backN as containers.Array( of uint32 ), _
      byref backS as containers.Array( of uint32 ) )
    if callee = Tko.SYMBOL_NONE then exit sub
    for i as int32 = 0 to slotKind.Count - 1
        if i >= argCount then exit for
        if slotKind[i] <> cast( uint32, MV_LOCAL ) then continue for
        dim as Tko.NodeId an = cast( Tko.NodeId, c.ast->ChildSlot( argFirst + i ) )
        if an = Tko.NODE_NONE then continue for
        if ParamIsByref( c, callee, i + pbase ) = false then continue for
        dim as Tko.TypeId pt = ParamTypeAt( c, callee, i + pbase )
        if pt <> Tko.TYPE_NONE then
            if c.types->Kind( pt ) = Tko.TK_REFERENCE then pt = c.types->Inner( pt )
            if c.types->IsConst( pt ) then continue for
        end if
        if IsSettableProperty_( c, an ) = false then continue for
        dim as MirValue noSelf_
        dim as int32 f0, n0
        if SetterUsableHere_( c, PropertyAt_( c, an, 1, noSelf_, f0, n0, an, true ) ) = false then continue for
        backN.Push( cast( uint32, an ) )
        backS.Push( slotId[i] or PBACK_MARK )
    next
end sub

'' The setter of 'node', given the temporary at 'slot' after the call: a string's descriptor or a
'' byref value parameter by address, a scalar loaded and converted. The receiver and any index are
'' evaluated again, as the string '+=' does (PropStrCatAssign_).
sub PropertyCopyBack_( byref c as Ctx, byval node as Tko.NodeId, byval slot as int32 )
    dim as MirValue self_
    dim as int32 sFirst, sCount
    dim as Tko.SymbolId sset = PropertyAt_( c, node, 1, self_, sFirst, sCount, node )
    if sset = Tko.SYMBOL_NONE then exit sub
    dim as boolean sByref = false
    dim as Tko.TypeId spt = SetterValueParam_( c, sset, sByref )
    if spt = Tko.TYPE_NONE then exit sub
    dim as MirValue tp
    tp.kind = cast( uint8, MV_LOCAL ) : tp.ty = cast( uint8, MT_PTR ) : tp.id = slot
    dim as MirValue v = tp
    dim as Tko.TypeId su = c.types->Unqualify( spt )
    dim as MirType smt = LowerType( su, *c.types )
    if (sByref = false) andalso (IsStringType( c, su ) = false) andalso (smt = MT_AGG) then
        '' A UDT BY VALUE, when it is one the ABI passes in registers and nothing must construct or
        '' destroy: the temporary loaded whole. Any other is not modelled, and keeps fbc's behaviour.
        if TypeNeedsDtor_( c, su ) orelse ParamIsIndirectUdt_( c, sset, PropParamCount_( c, sset ) - 1 ) then exit sub
        v = LowerExprLoad( c, tp, MT_AGG )
    elseif (sByref = false) andalso (IsStringType( c, su ) = false) then
        if smt = MT_VOID then exit sub
        dim as Tko.TypeId pty = c.info->TypeOf_( node )
        v = CoerceTy( c, LowerExprLoad( c, tp, LowerType( c.types->Unqualify( pty ), *c.types ) ), smt, pty, spt )
        if v.kind = cast( uint8, MV_NONE ) then exit sub
    end if
    dim as containers.Array( of uint32 ) args
    if PushPropIndexArgs_( c, sset, sFirst, sCount, args ) = false then exit sub
    args.Push( cast( uint32, v.kind ) ) : args.Push( cast( uint32, v.id ) )
    EmitPropSetCall_( c, node, sset, self_, args )
end sub
