'' events.tiko -- see events.ti.

#import "std/containers"
#include once "build/events.ti"

namespace Tko.Build

function JsonStr( byref s as string ) as string
    dim as string r = chr( 34 )
    for i as int32 = 0 to len( s ) - 1
        dim as int32 ch = s[i]
        select case ch
        case 34 : r &= chr( 92, 34 )
        case 92 : r &= chr( 92, 92 )
        case 10 : r &= chr( 92 ) & "n"
        case 13 : r &= chr( 92 ) & "r"
        case 9  : r &= chr( 92 ) & "t"
        case is < 32
            r &= chr( 92 ) & "u00" & lcase( hex( ch, 2 ) )
        case else
            r &= chr( ch )
        end select
    next
    return r & chr( 34 )
end function

function JsonArr( byref v as Tko.StrVec ) as string
    dim as string r = "["
    for i as int32 = 0 to v.Count - 1
        if i > 0 then r &= ","
        r &= JsonStr( v[i] )
    next
    return r & "]"
end function

sub OnModule _
    ( byval obs as any ptr, byref chain as string, byref dir_ as string, byref pkg as string, _
      byref files as Tko.StrVec, byref imports as Tko.StrVec )

    if obs = nullptr then return
    dim as Observer ptr o = obs
    if o->modChains.Add( chain ) = false then return
    o->modJson.Push( "{""chain"":" & JsonStr( chain ) & ",""package"":" & JsonStr( pkg ) & _
                     ",""dir"":" & JsonStr( dir_ ) & ",""files"":" & JsonArr( files ) & _
                     ",""imports"":" & JsonArr( imports ) & "}" )
end sub

sub OnSearch _
    ( byval obs as any ptr, byref roots as Tko.StrVec, byref pkg as string, _
      byref includes as Tko.StrVec, byref defines as Tko.StrVec )

    if obs = nullptr then return
    dim as Observer ptr o = obs
    o->searchJson = "{""roots"":" & JsonArr( roots ) & ",""pkg"":" & JsonStr( pkg ) & "}"
    o->includesJson = JsonArr( includes )
    o->definesJson = JsonArr( defines )
end sub

'' ONE LINE, LF, NOTHING ELSE ON IT: an editor reads the stream a line at a time. 'print'
'' ends a line with the host's ending, which on Windows is CRLF, so the LF is written by hand.
sub EmitLine( byref obs as Observer, byref body as string )
    if obs.json = false then return
    print "{" & body & "}" & chr( 10 );
end sub

sub OnUnit _
    ( byval obs as any ptr, byref kind as string, byref unitName as string, byref status as string )

    if obs = nullptr then return
    dim as Observer ptr o = obs
    o->units += 1
    EmitLine( *o, """event"":""unit"",""kind"":" & JsonStr( kind ) & ",""unit"":" & _
                  JsonStr( unitName ) & ",""status"":" & JsonStr( status ) )
end sub

sub OnPlan( byval obs as any ptr, byval units as int32 )
    if obs = nullptr then return
    dim as Observer ptr o = obs
    EmitLine( *o, """event"":""plan"",""units"":" & units )
end sub

sub OnArtifact( byval obs as any ptr, byref kind as string, byref path_ as string )
    if obs = nullptr then return
    dim as Observer ptr o = obs
    EmitLine( *o, """event"":""artifact"",""kind"":" & JsonStr( kind ) & ",""path"":" & JsonStr( path_ ) )
end sub

sub OnRuntimeLib( byval obs as any ptr, byref path_ as string )
    if obs = nullptr then return
    dim as Observer ptr o = obs
    '' A '#cmdline' restart runs the link step again: once each.
    for each r as string in o->runtimeLibs
        if r = path_ then return
    next
    o->runtimeLibs.Push( path_ )
    EmitLine( *o, """event"":""runtime-lib"",""path"":" & JsonStr( path_ ) )
end sub

sub OnFinish _
    ( byval obs as any ptr, byval errors as int32, byval warnings as int32, byval rc as int32 )

    if obs = nullptr then return
    dim as Observer ptr o = obs
    o->finished = true
    o->errors = errors
    o->warnings = warnings
    o->exitCode = rc
end sub

end namespace
