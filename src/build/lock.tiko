'' lock.tiko -- see lock.ti.

#import "std/containers"
#include once "build/lock.ti"

#ifdef __FB_WIN32__
    extern "windows"
        declare function W_CreateFileW_ alias "CreateFileW" _
            ( byval name_ as wstring ptr, byval access_ as uint32, byval share as uint32, _
              byval sec as any ptr, byval disp as uint32, byval flags as uint32, _
              byval tmpl as any ptr ) as any ptr
        declare function W_CloseHandle_ alias "CloseHandle" ( byval h as any ptr ) as int32
        declare function W_GetLastError_ alias "GetLastError" ( ) as uint32
        declare function W_MultiByteToWideChar_ alias "MultiByteToWideChar" _
            ( byval cp as uint32, byval flags as uint32, byval src as zstring ptr, byval srcLen as int32, _
              byval dst as wstring ptr, byval dstLen as int32 ) as int32
    end extern
#else
    extern "C"
        declare function C_open_ alias "open" ( byval p as zstring ptr, byval flags as int32, ... ) as int32
        declare function C_flock_ alias "flock" ( byval fd as int32, byval op as int32 ) as int32
        declare function C_close_ alias "close" ( byval fd as int32 ) as int32
        declare function C_unlink_ alias "unlink" ( byval p as zstring ptr ) as int32
    end extern
#endif

namespace Tko.Build

function TakeLock( byref lk as BuildLock, byref path_ as string ) as LockResult
    lk.h = -1
    lk.path_ = path_
    #ifdef __FB_WIN32__
        '' UTF-8 to UTF-16: the path may hold anything a source path holds.
        dim as int32 n = W_MultiByteToWideChar_( 65001, 0, strptr( path_ ), -1, nullptr, 0 )
        if n <= 0 then return LOCK_UNAVAILABLE
        dim as wstring ptr w = callocate( ( n + 1 ) * 2 )
        W_MultiByteToWideChar_( 65001, 0, strptr( path_ ), -1, w, n )
        '' GENERIC_WRITE, share NOTHING, CREATE_ALWAYS, FILE_FLAG_DELETE_ON_CLOSE. A second
        '' open while this handle lives is a sharing violation (32), or access denied (5)
        '' for a file already marked for deletion: both mean another build has it.
        dim as any ptr h = W_CreateFileW_( w, &h40000000ul, 0, nullptr, 2, &h04000080ul, nullptr )
        dim as uint32 le = W_GetLastError_( )
        deallocate( w )
        if h = cast( any ptr, -1 ) then
            if ( le = 32 ) orelse ( le = 5 ) then return LOCK_BUSY
            return LOCK_UNAVAILABLE
        end if
        lk.h = cast( int64, h )
        return LOCK_TAKEN
    #else
        '' O_RDWR | O_CREAT, 0644; then LOCK_EX | LOCK_NB, which fails at once when held.
        dim as int32 fd = C_open_( strptr( path_ ), &h42, &o644 )
        if fd < 0 then return LOCK_UNAVAILABLE
        if C_flock_( fd, 2 or 4 ) <> 0 then
            C_close_( fd )
            return LOCK_BUSY
        end if
        lk.h = fd
        return LOCK_TAKEN
    #endif
end function

sub ReleaseLock( byref lk as BuildLock )
    if lk.h = -1 then return
    #ifdef __FB_WIN32__
        W_CloseHandle_( cast( any ptr, lk.h ) )      '' and the file goes with it
    #else
        '' Unlinked while still held, so no build can lock a name this one is about to drop.
        C_unlink_( strptr( lk.path_ ) )
        C_close_( cast( int32, lk.h ) )
    #endif
    lk.h = -1
end sub

end namespace
