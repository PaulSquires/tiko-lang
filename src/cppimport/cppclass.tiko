'' cppclass.tiko -- the C++ importer's entry points and classes: functions, methods, handle
'' types and their members. See cppint.ti.

#import "std/containers"
#include once "cppimport/cppint.ti"

namespace Tko.CppImport

using Tko.CImport

'' ---------------------------------------------------------------- entries

'' ONE ENTRY POINT: its binding declaration, its shim function and -- for a member, whose symbol
'' tiko mangles -- its mirror declaration. False with 'why' when it cannot be expressed.
'' DOES CLASS ci HOLD A REFERENCE OR A POINTER in a field of its own, of any access? (A constructor
'' taking a std::vector then keeps the vector it was given alive: Adapter_.)
type Holds_
    as CppImp_ ptr x
    as boolean hit
end type

private function HoldsVisit_ cdecl ( byval c as CXCursor, byval parent as CXCursor, byval client as any ptr ) as int32
    dim as Holds_ ptr h = client
    if h->x->api->getCursorKind( c ) = CXCursor_FieldDecl then
        dim as int32 k = Canon_( *h->x, h->x->api->getCursorType( c ) ).kind
        if (k = TY_LREF_) orelse (k = TY_RREF_) orelse (k = TY_POINTER_) then h->hit = true
    end if
    return CXChildVisit_Continue
end function

private function HoldsRefs_( byref x as CppImp_, byval ci as int32 ) as boolean
    if (ci < 0) orelse IsSpec_( x, ci ) then return false
    dim as Holds_ h
    h.x = @x
    x.api->visitChildren( x.clsCur[ci], @HoldsVisit_, @h )
    return h.hit
end function

'' DOES CLASS CURSOR c PUBLICLY DERIVE FROM the class whose USR is 'usr', at any depth?
type Derives_
    as CppImp_ ptr x
    as string usr
    as int32 depth
    as boolean hit
end type

private function DerivesVisit_ cdecl ( byval c as CXCursor, byval parent as CXCursor, byval client as any ptr ) as int32
    dim as Derives_ ptr dv = client
    dim as CppImp_ ptr xp = dv->x
    if xp->api->getCursorKind( c ) <> CXCursor_CXXBaseSpecifier then return CXChildVisit_Continue
    if xp->api->getCXXAccessSpecifier( c ) <> CX_CXXPublic then return CXChildVisit_Continue
    dim as CXCursor bd = xp->api->getTypeDeclaration( Canon_( *xp, xp->api->getCursorType( c ) ) )
    if xp->api->isCursorDefinition( bd ) = 0 then bd = xp->api->getCursorDefinition( bd )
    if Text_( *xp, xp->api->getCursorUSR( bd ) ) = dv->usr then dv->hit = true : return CXChildVisit_Break
    if DerivesFrom_( *xp, bd, dv->usr, dv->depth + 1 ) then dv->hit = true : return CXChildVisit_Break
    return CXChildVisit_Continue
end function

function DerivesFrom_( byref x as CppImp_, byval c as CXCursor, byref usr as string, byval depth as int32 ) as boolean
    if depth > 8 then return false
    dim as Derives_ dv
    dv.x = @x : dv.usr = usr : dv.depth = depth
    x.api->visitChildren( c, @DerivesVisit_, @dv )
    return dv.hit
end function

'' Is a std::vector in this type, by value or reference? (Entry_'s adapter parameters.)
private function VecIn_( byref x as CppImp_, byval t as CXType ) as boolean
    dim as CXType c = Canon_( x, t )
    if (c.kind = TY_LREF_) orelse (c.kind = TY_RREF_) then c = Canon_( x, x.api->getNonReferenceType( c ) )
    if c.kind = TY_POINTER_ then c = Canon_( x, x.api->getPointeeType( c ) )
    select case StdTemplate_( x, c )
    case "vector", "array", "list", "deque", "map", "unordered_map", "optional" : return true
    end select
    return false
end function

function Entry_( byref x as CppImp_, byval c as CXCursor, byval kind as int32, _
                         byval ci as int32, byref decl as string, byref why as string, _
                         byval upto as int32 = -1, byval top as string = "" ) as boolean
    dim as string nm = Text_( x, x.api->getCursorSpelling( c ) )
    '' A MEMBER here is one whose symbol tiko mangles -- a method, a structor, a member operator --
    '' and so one the mirror names. A tiko global operator is an alias, like a free function.
    dim as boolean member = (kind <> K_FREE_) andalso (kind <> K_OPBIN_) andalso (kind <> K_OPUN_)
    if (kind <= K_STATIC_) andalso (left( nm, 8 ) = "operator") andalso (x.nameOverride <> "Invoke") then why = "operator" : return false
    dim as boolean isOp = (kind = K_OPBIN_) orelse (kind = K_OPUN_) orelse (kind = K_OPMEM_)
    dim as string cop = trim( mid( nm, 9 ) )          '' 'operator+=' -> '+='
    dim as int32 ck = x.api->getCursorKind( c )
    dim as boolean cppMember = (ck = CXCursor_CXXMethod) orelse (ck = CXCursor_ConversionFunction)
    dim as boolean methodConst = cppMember andalso (x.api->CXXMethod_isConst( c ) <> 0)
    dim as boolean pod = IsPod_( x, ci )
    if x.api->Cursor_isVariadic( c ) <> 0 then why = "variadic" : return false
    dim as int32 na = x.api->Cursor_getNumArguments( c )
    if na < 0 then why = "no prototype" : return false
    if (upto >= 0) andalso (upto < na) then na = upto
    dim as boolean isConst = (kind = K_METHOD_) andalso methodConst

    dim as string tparams = "", cparams = "", args = "", tsig = "", mparams = "", pubp = ""
    dim as Tko.StrVec av                               '' each argument expression, for an operator
    dim as Tko.StrVec pnames                           '' std::vector adapters (cppvec.tiko)
    dim as containers.Array( of int32 ) pvk, pmode
    dim as boolean adapt = false
    '' A C++ MEMBER OPERATOR AS A tiko GLOBAL ONE takes the object first, as its left operand.
    if ((kind = K_OPBIN_) orelse (kind = K_OPUN_)) andalso cppMember then
        dim as string kw = iif( methodConst, "const ", "" )
        tparams = "byref lhs_ as " & kw & x.clsTikoQ[ci] : tsig = kw & x.clsTikoQ[ci]
        if pod then
            cparams = kw & x.clsCpp[ci] & "* lhs_" : av.Push( "*lhs_" )
        else
            cparams = kw & "tko_cpp_h* lhs_" : av.Push( "*static_cast<" & kw & x.clsCpp[ci] & "*>(lhs_->impl)" )
        end if
    end if
    '' AN ADAPTER'S PARAMETERS ARE LOCALS OF A BODY the binding defines (a method's, cppvec.tiko), where
    '' a parameter named like a member procedure (cxxopts' 'groups') or a type (lodepng's 'state' beside
    '' State) is refused: there they take 'a_' -- known before the loop by the vectors in the signature.
    dim as boolean preAdapt = VecIn_( x, iif( x.ovrOn, x.ovrRes, x.api->getCursorResultType( c ) ) )
    for i as int32 = 0 to na - 1
        if preAdapt then exit for
        preAdapt = VecIn_( x, iif( x.ovrOn andalso (i < x.ovrArgs.Count), x.ovrArgs[i], x.api->getCursorType( x.api->Cursor_getArgument( c, i ) ) ) )
    next
    dim as Tko.StrVec usedPn
    for i as int32 = 0 to na - 1
        dim as CXCursor a = x.api->Cursor_getArgument( c, i )
        dim as string pn = ParamName_( x, a, i )
        if preAdapt then pn = "a_" & pn
        '' A PACK'S EXPANSION names every parameter alike ('args, args'): each after the first takes
        '' its position.
        for j as int32 = 0 to usedPn.Count - 1
            if lcase( usedPn[j] ) = lcase( pn ) then pn &= "_" & i : exit for
        next
        usedPn.Push( pn )
        dim as CXType at_ = x.api->getCursorType( a )
        if x.ovrOn then
            if i >= x.ovrArgs.Count then why = "the instantiated member has fewer parameters" : return false
            at_ = x.ovrArgs[i]
        end if
        dim as TMap_ m = Param_( x, at_, pn )
        if m.ok = false then why = m.why : return false
        if len( tparams ) then tparams &= ", " : cparams &= ", " : tsig &= ","
        if i > 0 then args &= ", " : mparams &= ", " : pubp &= ", "
        tparams &= m.tiko : cparams &= m.ctype : args &= m.arg : mparams &= m.mir
        dim as string pt_ = iif( m.vk1 <> 0, m.pub, m.tiko )
        pubp &= pt_
        tsig &= mid( pt_, instr( pt_, " as " ) + 4 )
        av.Push( m.arg )
        pnames.Push( pn ) : pvk.Push( m.vk1 ) : pmode.Push( m.vmode )
        if m.vk1 <> 0 then adapt = true
    next
    dim as boolean compound = (kind = K_OPMEM_) andalso (top <> "[]") andalso (top <> "cast")
    dim as TMap_ r
    if (kind <> K_CTOR_) andalso (compound = false) then
        r = Result_( x, iif( x.ovrOn, x.ovrRes, x.api->getCursorResultType( c ) ) )
        if r.ok = false then why = r.why : return false
    end if
    if r.vk1 <> 0 then adapt = true
    if adapt then
        if (kind <> K_FREE_) andalso (kind <> K_METHOD_) andalso (kind <> K_STATIC_) andalso (kind <> K_CTOR_) then why = "a std::vector in an operator" : return false
        if r.byrefRet then why = "a reference result beside a std::vector" : return false
    end if

    dim as string tn = iif( kind = K_CTOR_, "constructor", ValueName_( nm ) )
    if len( x.nameOverride ) andalso (kind <> K_CTOR_) then tn = x.nameOverride
    dim as string owner = iif( member, x.clsTikoQ[ci], QualTiko_( x, "" ) )
    dim as string sig = lcase( owner & "." & tn & iif( kind = K_STATIC_, "!", "" ) & "(" & tsig & ")" )
    if isOp then sig = lcase( iif( kind = K_OPMEM_, owner & ".", "" ) & "operator " & top & "(" & tsig & ")" )
    for i as int32 = 0 to x.sigs.Count - 1
        if x.sigs[i] = sig then
            x.twinOfConst = (x.sigConst[i] = "c")
            why = SAME_SIG_
            return false
        end if
    next
    x.sigs.Push( sig )
    x.sigConst.Push( iif( isConst, "c", "" ) )

    dim as string sym = "tko_cpp_" & x.id & "_" & x.n
    x.n += 1
    '' AN ENTRY WHOSE SHIM BODY DID NOT COMPILE (CppShimCheck): its number is spent all the same, so
    '' every other entry keeps the name the failed shim gave it.
    for i as int32 = 0 to x.exclude.Count - 1
        if x.exclude[i] = sym then why = "its C++ body does not compile for this specialization" : return false
    next
    dim as boolean isSub = (len( r.tiko ) = 0)
    '' A MEMBER 'T& operator[]' OF A CLASS T IS A byref RESULT, so 'j["pi"] = v' assigns through it as
    '' C++'s does -- fbc and tiko refuse '=' on a by-value result (TKO0932, measured), and 'dim'
    '' from an operator copies. The handle it returns is a borrowed one in a slot of a ring the shim
    '' keeps per thread (tko_cpp_slot, 64): valid for that statement, not to be kept by 'dim byref'.
    dim as boolean slotRef = false
    if (kind = K_OPMEM_) andalso (top = "[]") andalso (r.sret = SR_REF_) then
        dim as CXType rq = Canon_( x, iif( x.ovrOn, x.ovrRes, x.api->getCursorResultType( c ) ) )
        if (rq.kind = TY_LREF_) andalso (x.api->isConstQualifiedType( x.api->getPointeeType( rq ) ) = 0) then slotRef = true
    end if
    dim as string asR = iif( r.byrefRet orelse slotRef, " byref as ", " as " ) & r.tiko
    if adapt then
        '' THE RAW ENTRY, a free function of the shim taking the object first, and the ADAPTER
        '' tiko calls instead, which the binding defines (cppvec.tiko).
        dim as string rawn = tn & "__" & mid( sym, instrrev( sym, "_" ) + 1 )
        dim as string rawp = tparams
        if (kind = K_METHOD_) orelse (kind = K_CTOR_) then rawp = "byref self_ as " & iif( isConst, "const ", "" ) & x.clsTikoQ[ci] & iif( len( rawp ), ", ", "" ) & rawp
        x.extraGlob.Push( "extern ""C"" : declare " & iif( isSub, "sub ", "function " ) & rawn & " alias """ & sym & _
                          """ ( " & rawp & " )" & iif( isSub, "", " as " & r.tiko ) & " : end extern" )
        dim as string pubR = r.tiko
        if r.vk1 > 0 then pubR = iif( r.vopt, "outcome.Optional( of ", "containers.Array( of " ) & x.vecET[r.vk1 - 1] & " )"
        if r.vk1 < 0 then pubR = x.mapET[-r.vk1 - 1]
        dim as string asP = iif( isSub, "", " as " & pubR )
        dim as string head, nsl = ""
        if member andalso (kind = K_CTOR_) then
            '' A CONSTRUCTOR taking a std::vector (survey): the binding's own constructor copies the
            '' arrays in and calls the raw entry, which constructs into 'this'.
            decl = "declare constructor" & iif( len( pubp ), " ( " & pubp & " )", " ( )" )
            head = "constructor " & ClsRel_( x, ci ) & iif( len( pubp ), "( " & pubp & " )", "( )" )
            nsl = x.clsNsTiko[ci]
        elseif member then
            decl = "declare " & iif( kind = K_STATIC_, "static ", "" ) & iif( isConst, "const ", "" ) & iif( isSub, "sub ", "function " ) & _
                   tn & iif( len( pubp ), " ( " & pubp & " )", " ( )" ) & asP
            head = iif( isSub, "sub ", "function " ) & ClsRel_( x, ci ) & "." & tn & iif( len( pubp ), "( " & pubp & " )", "( )" ) & asP
            nsl = x.clsNsTiko[ci]
        else
            decl = "declare " & iif( isSub, "sub ", "function " ) & tn & " overload" & iif( len( pubp ), " ( " & pubp & " )", " ( )" ) & asP
            head = iif( isSub, "sub ", "function " ) & tn & iif( len( pubp ), "( " & pubp & " )", "( )" ) & asP
            for i as int32 = 0 to x.tikoNs.Count - 1
                nsl &= iif( i > 0, chr( 1 ), "" ) & x.tikoNs[i]
            next
        end if
        Adapter_( x, nsl, head, rawn, iif( (kind = K_METHOD_) orelse (kind = K_CTOR_), "this", "" ), pnames, pvk, pmode, r.vk1, r.tiko, isSub, kind = K_CTOR_, r.vopt, _
                  (kind = K_CTOR_) andalso HoldsRefs_( x, ci ) )
        member = false                         '' the raw entry is an alias, like a free function
    end if
    tparams = iif( len( tparams ), "( " & tparams & " )", "( )" )
    if adapt then
    else
    select case kind
    case K_FREE_
        '' ONE 'extern "C"' PER DECLARATION, INSIDE ITS NAMESPACE: a procedure in a namespace
        '' inside an 'extern "C"' block is still C++-mangled around its alias (measured).
        decl = "extern ""C"" : declare " & iif( isSub, "sub ", "function " ) & tn & " overload alias """ & _
               sym & """ " & tparams & iif( isSub, "", asR ) & " : end extern"
    case K_OPBIN_, K_OPUN_
        decl = "extern ""C"" : declare operator " & top & " alias """ & sym & """ " & tparams & asR & " : end extern"
    case K_OPMEM_
        decl = "declare operator " & top & " alias """ & sym & """ " & tparams & iif( compound, "", asR )
    case K_CTOR_
        decl = "declare constructor alias """ & sym & """ " & tparams
    case else
        decl = "declare " & iif( kind = K_STATIC_, "static ", "" ) & iif( isConst, "const ", "" ) & _
               iif( isSub, "sub ", "function " ) & tn & " alias """ & sym & """ " & tparams & _
               iif( isSub, "", asR )
    end select
    end if

    '' THE SHIM FUNCTION. Its parameters are tiko's: the result slot first, then 'this', then
    '' the arguments (measured, C3.md).
    dim as string pl = ""
    if (r.sret <> SR_NONE_) andalso (slotRef = false) then pl = "tko_cpp_h* ret_"
    '' A POD's 'this' is the object itself, which tiko and C++ lay out the same way.
    dim as string selfT = "tko_cpp_h*"
    if pod then selfT = iif( isConst, "const ", "" ) & x.clsCpp[ci] & "*"
    if (kind = K_METHOD_) orelse (kind = K_CTOR_) orelse (kind = K_OPMEM_) then pl &= iif( len( pl ), ", ", "" ) & selfT & " self_"
    if len( cparams ) then pl &= iif( len( pl ), ", ", "" ) & cparams
    dim as string rt = iif( r.sret <> SR_NONE_, "tko_cpp_h*", iif( isSub orelse (kind = K_CTOR_), "void", r.ctype ) )
    dim as string obj = "(*self_)"
    if (ci >= 0) andalso (pod = false) then obj = "(*static_cast<" & x.clsCpp[ci] & "*>(self_->impl))"
    dim as string callx
    '' A TEMPLATE SPECIALIZATION's arguments, where the call cannot deduce them, are the ones the
    '' '#cppinstantiate' wrote ('get<int>( )'); the rest the call deduces from the shim's exact types
    '' (clang's own spelling of an enum argument, glm's qualifier, is a bare '0' C++ refuses).
    dim as string targs = x.calleeTargs
    select case kind
    case K_FREE_   : callx = iif( len( x.calleeOverride ), x.calleeOverride, QualCpp_( x, nm ) & targs ) & "(" & args & ")"
    case K_STATIC_ : callx = x.clsCpp[ci] & "::" & iif( len( targs ), "template ", "" ) & nm & targs & "(" & args & ")"
    case K_METHOD_
        if pod then
            callx = "self_->" & iif( len( targs ), "template ", "" ) & nm & targs & "(" & args & ")"
        else
            callx = "static_cast<" & iif( isConst, "const ", "" ) & x.clsCpp[ci] & "*>(self_->impl)->" & iif( len( targs ), "template ", "" ) & nm & targs & "(" & args & ")"
        end if
    case K_OPBIN_  : callx = "(" & av[0] & ") " & cop & " (" & av[1] & ")"
    case K_OPUN_   : callx = cop & "(" & av[0] & ")"
    case K_OPMEM_
        if top = "[]" then
            callx = obj & "[" & args & "]"
        elseif top = "cast" then
            callx = "static_cast<" & r.ctype & ">(" & obj & ")"
        else
            callx = obj & " " & cop & " (" & args & ")"
        end if
    end select
    dim as string L = chr( 10 )
    dim as string f = ""
    '' A MEMBER OPERATOR IS LOOKED UP BY POSITION: it has no name of its own in the mirror.
    dim as string key = sym
    if kind = K_OPMEM_ then key = "mop" & x.mop : x.mop += 1
    if member then f = "extern ""C"" " & rt & " " & sym & "(" & pl & ") __asm__(""@@M:" & key & "@@"");" & L
    f &= "extern ""C"" " & rt & " " & sym & "(" & pl & ") {" & L
    if slotRef then f &= "    tko_cpp_h* ret_ = tko_cpp_slot();" & L
    if r.sret <> SR_NONE_ then f &= "    ret_->impl = nullptr; ret_->owned = 0;" & L
    if (kind = K_CTOR_) andalso (pod = false) then f &= "    self_->impl = nullptr; self_->owned = 0;" & L
    f &= "    try { "
    if (kind = K_CTOR_) andalso pod then
        f &= "new (self_) " & x.clsCpp[ci] & "(" & args & "); return;"     '' over tiko's storage
    elseif kind = K_CTOR_ then
        f &= "self_->impl = new " & x.clsCpp[ci] & "(" & args & "); self_->owned = 1; return;"
    elseif r.sret = SR_OWNED_ then
        f &= "ret_->impl = new " & r.rcpp & "(" & callx & "); ret_->owned = 1; return ret_;"
    elseif r.sret = SR_UNIQUE_ then
        f &= "ret_->impl = const_cast<void*>(static_cast<const void*>((" & callx & ").release())); ret_->owned = 1; return ret_;"
    elseif r.sret = SR_SHARED_ then
        f &= "auto tko_sp = " & callx & "; ret_->impl = const_cast<void*>(static_cast<const void*>(tko_sp.get())); ret_->owned = tko_cpp_box<" & r.rcpp & ">(std::const_pointer_cast<" & r.rcpp & ">(tko_sp)); return ret_;"
    elseif r.sret = SR_REF_ then
        f &= "ret_->impl = const_cast<void*>(static_cast<const void*>(&(" & callx & "))); return ret_;"
    elseif r.sret = SR_PTR_ then
        f &= "ret_->impl = const_cast<void*>(static_cast<const void*>(" & callx & ")); return ret_;"
    elseif isSub then
        f &= callx & "; return;"
    else
        f &= "return " & r.wrap0 & callx & r.wrap1 & ";"
    end if
    f &= " } TKO_CPP_CATCH" & L & "    tko_cpp_raise();" & L
    if r.sret <> SR_NONE_ then
        f &= "    return ret_;" & L
    elseif (isSub = false) andalso (kind <> K_CTOR_) then
        f &= "    return " & r.fallback & ";" & L
    end if
    x.shim.Push( f & "}" & L )
    '' The C++ symbol called, when it is this declaration's own (not a pattern's, not a template's).
    if (x.ovrOn = false) andalso (len( x.calleeOverride ) = 0) andalso (len( targs ) = 0) andalso _
       ((ci < 0) orelse (IsSpec_( x, ci ) = false)) then AltName_( x, c )
    if kind = K_OPMEM_ then
        if top = "[]" then
            x.mirBody.Push( "    void operator[](" & mparams & ");" )
        elseif top = "cast" then
            x.mirBody.Push( "    operator " & MirFund_( r.tiko ) & "();" )
        else
            x.mirBody.Push( "    void operator" & cop & "(" & mparams & ");" )
        end if
    elseif member then
        x.mirBody.Push( "    " & iif( kind = K_STATIC_, "static ", "" ) & "void " & sym & "(" & mparams & ")" & _
                        iif( isConst, " const", "" ) & ";" )
    end if
    x.bound += 1
    return true
end function


'' DEFAULT ARGUMENTS: how many trailing parameters have one. Each is an entry point of its own
'' with that many arguments fewer, and C++ supplies the rest -- so the default is C++'s, exactly,
'' and never an expression translated into tiko.
private function ParmVisit_ cdecl ( byval c as CXCursor, byval parent as CXCursor, byval client as any ptr ) as int32
    dim as Members_ ptr mb = client
    if mb->x->api->getCursorKind( c ) = 10 then mb->cur.Push( c )        '' CXCursor_ParmDecl
    return CXChildVisit_Continue
end function

function Defaults_( byref x as CppImp_, byval c as CXCursor ) as int32
    dim as int32 na = x.api->Cursor_getNumArguments( c )
    dim as int32 nd = 0
    '' AN INSTANTIATION'S PARAMETERS do not show their defaults: its template's do (json's parse).
    dim as Members_ ps
    ps.x = @x
    dim as CXCursor tm = x.api->getSpecializedCursorTemplate( c )
    if IsNullCursor_( x, tm ) = false then x.api->visitChildren( tm, @ParmVisit_, @ps )
    for i as int32 = na - 1 to 0 step -1
        '' BY ITS TOKENS, '= value': an expression child is not enough -- 'const mat<2, 2, T, Q>& x'
        '' has two, its template arguments.
        dim as CXCursor pc = x.api->Cursor_getArgument( c, i )
        if ps.cur.Count = na then pc = ps.cur[i]
        if DeclHasInit_( x, pc, false ) = false then exit for
        nd += 1
    next
    return nd
end function

function ArityNote_( byval k as int32, byval na as int32 ) as string
    if k = 0 then return ""
    return " -- first " & (na - k) & " of " & na & " arguments"
end function

'' A FREE FUNCTION, in the namespace being walked.
'' THE OPERATORS tiko can declare, as tiko spells them: a binary or unary one is global, '[]' and
'' a compound assignment are members. 'top' is the tiko operator; -1 when there is none.
function OpKind_( byref cop as string, byval nargs as int32, byval isMember as boolean, _
                  byref top as string ) as int32
    dim as int32 nt = nargs + iif( isMember, 1, 0 )
    select case cop
    case "+", "-", "*", "/", "%", "==", "!=", "<", ">", "<=", ">=", "&", "|", "^", "<<", ">>"
        if nt = 2 then
            select case cop
            case "%"  : top = "mod"
            case "==" : top = "="
            case "!=" : top = "<>"
            case "&"  : top = "and"
            case "|"  : top = "or"
            case "^"  : top = "xor"
            case "<<" : top = "shl"
            case ">>" : top = "shr"
            case else : top = cop
            end select
            return K_OPBIN_
        end if
        if (nt = 1) andalso (cop = "-") then top = "-" : return K_OPUN_
    case "!", "~"
        if nt = 1 then top = "not" : return K_OPUN_
    case "[]"
        if isMember andalso (nargs = 1) then top = "[]" : return K_OPMEM_
    case "+=", "-=", "*=", "/=", "%=", "&=", "|=", "^=", "<<=", ">>="
        if isMember andalso (nargs = 1) then
            select case cop
            case "%="  : top = "mod="
            case "&="  : top = "and="
            case "|="  : top = "or="
            case "^="  : top = "xor="
            case "<<=" : top = "shl="
            case ">>=" : top = "shr="
            case else  : top = cop
            end select
            return K_OPMEM_
        end if
    end select
    return -1
end function

sub Function_( byref x as CppImp_, byval c as CXCursor )
    dim as string decl, why, lastWhy
    dim as string disp = QualCpp_( x, Text_( x, x.api->getCursorDisplayName( c ) ) )
    dim as int32 na = x.api->Cursor_getNumArguments( c )
    dim as string nm = Text_( x, x.api->getCursorSpelling( c ) )
    if left( nm, 8 ) = "operator" then
        '' A FREE OPERATOR is a tiko global one, in the same namespace.
        dim as string top
        dim as int32 ok = OpKind_( trim( mid( nm, 9 ) ), na, false, top )
        if (ok = K_OPBIN_) orelse (ok = K_OPUN_) then
            if Entry_( x, c, ok, -1, decl, why, na, top ) then
                x.bind.Push( Indent_( x ) & decl & "    '' " & disp )
                exit sub
            end if
        else
            why = "operator " & trim( mid( nm, 9 ) )
        end if
        Todo_( x, disp, why )
        exit sub
    end if
    for k as int32 = 0 to Defaults_( x, c )
        dim as boolean ok = Entry_( x, c, K_FREE_, -1, decl, why, na - k )
        if (ok = false) andalso (why = SAME_SIG_) andalso len( TemplateArgsName_( x, c ) ) then
            x.nameOverride = ValueName_( nm ) & TemplateArgsName_( x, c )
            ok = Entry_( x, c, K_FREE_, -1, decl, why, na - k )
            x.nameOverride = ""
        end if
        if ok then
            for g as int32 = 0 to x.extraGlob.Count - 1
                x.bind.Push( Indent_( x ) & x.extraGlob[g] )
            next
            x.extraGlob.Clear( )
            x.bind.Push( Indent_( x ) & decl & "    '' " & disp & ArityNote_( k, na ) )
        elseif why <> lastWhy then
            Todo_( x, disp & ArityNote_( k, na ), why )     '' an arity failing for the same reason: once
            lastWhy = why
        end if
    next
end sub

'' ---------------------------------------------------------------- classes

'' 'GEO::Counter' from a cursor's semantic parents: the mirror's names, and a member's owner.
function MirQual_( byval api as ClangApi ptr, byval c as CXCursor ) as string
    dim as string r = ""
    dim as int32 guard = 0
    while (api->getCursorKind( c ) <> CXCursor_TranslationUnit) andalso (guard < 32)
        dim as string s = ClangText( *api, api->getCursorSpelling( c ) )
        r = iif( len( r ), s & "::" & r, s )
        c = api->getCursorSemanticParent( c )
        guard += 1
    wend
    return r
end function

'' A CLASS'S MEMBERS, its bases' included: a C++ class has its public bases' public members, so
'' the handle has them too, called through the derived class (C++ adjusts 'this'). A name the
'' derived class declares hides every base member of that name, as in C++.
type Members_
    as CppImp_ ptr x
    as containers.Array( of CXCursor ) cur
    as containers.Array( of int32 ) kind
    as boolean userCtor
    as int32 depth              '' 0: the class; 1..: a base
    as Tko.StrVec hidden        '' names declared at a shallower level
    as Tko.StrVec here          '' names this level declares
    as Tko.StrVec seen          '' the bases' USRs, each walked once
    as containers.Array( of CXCursor ) bases
    as Tko.StrVec skipped       '' members left out, as 'display: why'
end type

private sub Take_( byref mb as Members_, byval c as CXCursor, byval kind as int32, byref nm as string )
    mb.here.Push( nm )
    for i as int32 = 0 to mb.hidden.Count - 1
        if mb.hidden[i] = nm then return
    next
    mb.cur.Push( c ) : mb.kind.Push( kind )
end sub

private function MemberVisit_ cdecl _
    ( byval c as CXCursor, byval parent as CXCursor, byval client as any ptr ) as int32
    dim as Members_ ptr mb = client
    dim as CppImp_ ptr xp = mb->x
    dim as int32 k = xp->api->getCursorKind( c )
    dim as boolean pub = (xp->api->getCXXAccessSpecifier( c ) = CX_CXXPublic)
    dim as boolean top = (mb->depth = 0)
    dim as string nm = Text_( *xp, xp->api->getCursorSpelling( c ) )
    select case k
    case CXCursor_Constructor
        if top then
            mb->userCtor = true
            if pub andalso (xp->api->CXXMethod_isDeleted( c ) = 0) andalso _
               (xp->api->CXXConstructor_isCopyConstructor( c ) = 0) andalso _
               (xp->api->CXXConstructor_isMoveConstructor( c ) = 0) then
                mb->cur.Push( c ) : mb->kind.Push( K_CTOR_ )
            end if
        end if
    case CXCursor_CXXMethod
        if pub andalso (xp->api->CXXMethod_isDeleted( c ) = 0) then
            if left( nm, 8 ) = "operator" then
                if top andalso (nm <> "operator=") then mb->cur.Push( c ) : mb->kind.Push( K_OPANY_ )
            else
                Take_( *mb, c, iif( xp->api->CXXMethod_isStatic( c ) <> 0, K_STATIC_, K_METHOD_ ), nm )
            end if
        end if
    case CXCursor_FieldDecl
        if pub then Take_( *mb, c, K_FIELD_, nm )
    case CXCursor_VarDecl
        if pub andalso top then Take_( *mb, c, K_SFIELD_, nm )
    case CXCursor_ConversionFunction
        if pub andalso top then mb->cur.Push( c ) : mb->kind.Push( K_OPANY_ )
    case CXCursor_CXXBaseSpecifier
        if pub then mb->bases.Push( c )
    case CXCursor_FunctionTemplate
        if pub andalso top then mb->skipped.Push( Text_( *xp, xp->api->getCursorDisplayName( c ) ) & ": a member function template" )
    case CXCursor_ClassDecl, CXCursor_StructDecl
        if pub andalso top andalso (xp->api->isCursorDefinition( c ) <> 0) then
            '' A NESTED CLASS is a tiko type nested in this one (CollectNested_) -- unless it was not
            '' collected: an anonymous struct, or one in a class template.
            dim as string usr = Text_( *xp, xp->api->getCursorUSR( c ) )
            dim as boolean got = false
            for i as int32 = 0 to xp->clsUsr.Count - 1
                if xp->clsUsr[i] = usr then got = true : exit for
            next
            if got = false then mb->skipped.Push( nm & ": nested class" )
        end if
    end select
    return CXChildVisit_Continue
end function

private function SpecBaseVisit_ cdecl ( byval c as CXCursor, byval client as any ptr ) as int32
    dim as Members_ ptr mb = client
    if mb->x->api->getCXXAccessSpecifier( c ) = CX_CXXPublic then
        dim as CXCursor bd = mb->x->api->getTypeDeclaration( Canon_( *mb->x, mb->x->api->getCursorType( c ) ) )
        mb->seen.Push( Text_( *mb->x, mb->x->api->getCursorUSR( bd ) ) )
    end if
    return 1                                    '' CXVisit_Continue
end function

private sub Gather_( byref x as CppImp_, byref mb as Members_, byval c as CXCursor )
    dim as int32 b0 = mb.bases.Count, h0 = mb.hidden.Count
    mb.here.Clear( )
    x.api->visitChildren( c, @MemberVisit_, @mb )
    for i as int32 = 0 to mb.here.Count - 1
        mb.hidden.Push( mb.here[i] )
    next
    dim as containers.Array( of CXCursor ) lvl
    for i as int32 = b0 to mb.bases.Count - 1
        lvl.Push( mb.bases[i] )
    next
    for i as int32 = 0 to lvl.Count - 1
        dim as CXType bt = Canon_( x, x.api->getCursorType( lvl[i] ) )
        dim as CXCursor bd = x.api->getTypeDeclaration( bt )
        if x.api->isCursorDefinition( bd ) = 0 then bd = x.api->getCursorDefinition( bd )   '' past 'class xml_node;'
        dim as string usr = Text_( x, x.api->getCursorUSR( bd ) )
        dim as boolean dup = false
        for j as int32 = 0 to mb.seen.Count - 1
            if mb.seen[j] = usr then dup = true
        next
        if dup then continue for
        mb.seen.Push( usr )
        if (x.api->isCursorDefinition( bd ) = 0) orelse (InScope_( x, bd ) = false) then
            if mb.depth = 0 then mb.skipped.Push( Spell_( x, bt ) & ": base class not in this header" )
            continue for
        end if
        mb.depth += 1
        Gather_( x, mb, bd )
        mb.depth -= 1
    next
    while mb.hidden.Count > h0
        mb.hidden.Pop( )
    wend
end sub

'' 'namespace a' ... 'namespace b', where class ci is; the indent to write at, and the closers.
function NsOpen_( byref x as CppImp_, byval ci as int32, byref opened as Tko.StrVec ) as string
    dim as string tns = x.clsNsTiko[ci], ind = ""
    dim as int32 a = 1
    while a <= len( tns )
        dim as int32 b = instr( a, tns, chr( 1 ) )
        if b = 0 then b = len( tns ) + 1
        x.bind.Push( ind & "namespace " & mid( tns, a, b - a ) )
        opened.Push( ind )
        ind &= "    "
        a = b + 1
    wend
    return ind
end function

sub NsClose_( byref x as CppImp_, byref opened as Tko.StrVec )
    for i as int32 = opened.Count - 1 to 0 step -1
        x.bind.Push( opened[i] & "end namespace" )
    next
end sub

'' A STRUCTOR'S SHIM WHOSE BODY DID NOT COMPILE (CppShimCheck): rapidjson's GenericArray<true, ...>
'' declares an operator= whose body assigns through a const reference. It stays declared -- tiko
'' needs every handle's three -- and raises instead.
function Excluded_( byref x as CppImp_, byref sym as string ) as boolean
    for i as int32 = 0 to x.exclude.Count - 1
        if x.exclude[i] = sym then return true
    next
    return false
end function

private function NoBody_( byref what as string ) as string
    return iif( what = "assigned", "", "self_->impl = nullptr; self_->owned = 0; " ) & "tko_cpp_last() = ""this C++ class cannot be " & what & " (its C++ body does not compile)""; tko_cpp_raise();"
end function

'' The class ci is nested in, or -1.
function OuterOf_( byref x as CppImp_, byval ci as int32 ) as int32
    if (ci < 0) orelse (ci >= x.clsOuter.Count) then return -1
    if len( x.clsOuter[ci] ) = 0 then return -1
    return valint( x.clsOuter[ci] )
end function

'' THE BLOCKS CLASS ci IS DECLARED IN: its namespaces, 'extern "C"', and for a nested class a
'' 'partial type' of each class around it, outermost first. The indent its own 'partial type'
'' line takes; ClassClose_ closes them.
function ClassOpen_( byref x as CppImp_, byval ci as int32, byref opened as Tko.StrVec ) as string
    dim as string ind = NsOpen_( x, ci, opened )
    x.bind.Push( ind & "extern ""C""" )
    opened.Push( ind & chr( 1 ) & "end extern" )
    ind &= "    "
    dim as Tko.StrVec chain
    dim as int32 o = OuterOf_( x, ci )
    while o >= 0
        chain.Push( x.clsTiko[o] )
        o = OuterOf_( x, o )
    wend
    for i as int32 = chain.Count - 1 to 0 step -1
        x.bind.Push( ind & "partial type " & chain[i] )
        opened.Push( ind & chr( 1 ) & "end type" )
        ind &= "    "
    next
    return ind
end function

sub ClassClose_( byref x as CppImp_, byref opened as Tko.StrVec )
    for i as int32 = opened.Count - 1 to 0 step -1
        dim as int32 m = instr( opened[i], chr( 1 ) )
        if m > 0 then
            x.bind.Push( left( opened[i], m - 1 ) & mid( opened[i], m + 1 ) )
        else
            x.bind.Push( opened[i] & "end namespace" )
        end if
    next
end sub

'' A qualified name less its namespaces: 'QrSegment.Mode' (tiko), 'QrSegment::Mode' (the mirror).
private function StripNs_( byref q as string, byref nsList as string, byref sep as string ) as string
    if len( nsList ) = 0 then return q
    dim as string pre = ""
    for i as int32 = 1 to len( nsList )
        dim as string ch = mid( nsList, i, 1 )
        pre &= iif( ch = chr( 1 ), sep, ch )
    next
    pre &= sep
    return mid( q, len( pre ) + 1 )
end function

function ClsRel_( byref x as CppImp_, byval ci as int32 ) as string
    return StripNs_( x.clsTikoQ[ci], x.clsNsTiko[ci], "." )
end function

function MirRel_( byref x as CppImp_, byval ci as int32 ) as string
    return StripNs_( x.clsMir[ci], x.clsNsMir[ci], "::" )
end function

function Sym_( byref x as CppImp_ ) as string
    dim as string s = "tko_cpp_" & x.id & "_" & x.n
    x.n += 1
    return s
end function

'' A PUBLIC FIELD is a property: a getter, and a setter unless the field is const. A class-typed
'' field's getter is a borrowed handle of the field itself, so 'p.pos.move( 1, 0 )' moves it.
sub Field_( byref x as CppImp_, byval ci as int32, byval c as CXCursor, byref lines as Tko.StrVec )
    dim as string L = chr( 10 ), why
    dim as string nm = Text_( x, x.api->getCursorSpelling( c ) )
    dim as string disp = "::" & MirQual_( x.api, x.api->getCursorSemanticParent( c ) ) & "::" & nm
    dim as string tn = ValueName_( nm )
    dim as CXType t = x.api->getCursorType( c )
    dim as CXType ct = Canon_( x, t )
    dim as string cpp = x.clsCpp[ci]
    '' TWO FIELDS WHOSE NAMES DIFFER ONLY IN CASE (date's 'm' and 'M') are one tiko name: the later takes '_'.
    dim as boolean taken = true
    while taken
        taken = false
        for i as int32 = 0 to x.sigs.Count - 1
            if x.sigs[i] = lcase( x.clsTikoQ[ci] & "." & tn & "#field" ) then taken = true : tn &= "_" : exit for
        next
    wend
    dim as string owner = lcase( x.clsTikoQ[ci] & "." & tn )
    for i as int32 = 0 to x.sigs.Count - 1
        if (left( x.sigs[i], len( owner ) + 1 ) = owner & "(") orelse (left( x.sigs[i], len( owner ) + 2 ) = owner & "!(") then
            lines.Push( "'' CPP-TODO(a method has this name): " & disp ) : x.todos += 1
            return
        end if
    next
    x.sigs.Push( owner & "#field" ) : x.sigConst.Push( "" )
    dim as TMap_ r
    if (ct.kind = TY_RECORD_) andalso (StrKind_( x, t ) = 0) andalso (len( StdTemplate_( x, ct ) ) = 0) then
        dim as int32 ri = ClassOf_( x, t, why )
        if ri < 0 then lines.Push( "'' CPP-TODO(" & why & "): " & disp ) : x.todos += 1 : return
        if IsPod_( x, ri ) then
            '' A POD FIELD is the field itself, 'byref': 'h.pos.x = 1' writes it.
            r.ok = true : r.tiko = x.clsTikoQ[ri] : r.byrefRet = true : r.ctype = x.clsCpp[ri] & "*"
            '' ...of a 'const T' field too (inja's 'const SourceLocation location'): tiko's const is the
            '' binding's to keep.
            r.wrap0 = "const_cast<" & x.clsCpp[ri] & "*>(&(" : r.wrap1 = "))" : r.fallback = "nullptr"
        else
            r.ok = true : r.tiko = x.clsTikoQ[ri] : r.ctype = "tko_cpp_h*" : r.sret = SR_REF_
        end if
    else
        r = Result_( x, t )
        if r.ok andalso (r.vk1 > 0) andalso (r.vopt = false) andalso (r.sret = SR_NONE_) andalso (StdTemplate_( x, ct ) = "vector") then
            FieldVec_( x, ci, c, r, lines )
            return
        end if
        '' A POINTER TO A CLASS is a borrowed handle of what it points at (survey: box2d's b2JointDef.bodyA,
        '' imgui's ImGuiIO.Fonts); setting it stores the handle's object.
        if r.ok andalso ((r.vk1 <> 0) orelse ((r.sret <> SR_NONE_) andalso (r.sret <> SR_PTR_))) then r.ok = false : r.why = "a standard library field"
        if r.ok = false then lines.Push( "'' CPP-TODO(field: " & r.why & "): " & disp ) : x.todos += 1 : return
    end if
    dim as string obj = "static_cast<" & cpp & "*>(self_->impl)->" & nm
    dim as string sg = Sym_( x )
    if Excluded_( x, sg ) then lines.Push( "'' CPP-TODO(its C++ body does not compile): " & disp ) : x.todos += 1 : return
    '' A CONST GETTER: a field reads through a const object too (survey: semver's version.major).
    lines.Push( "declare const property " & tn & " alias """ & sg & """ ( )" & iif( r.byrefRet, " byref as ", " as " ) & r.tiko & "    '' " & disp )
    dim as string rt = iif( r.sret <> SR_NONE_, "tko_cpp_h*", r.ctype )
    dim as string pl = iif( r.sret <> SR_NONE_, "tko_cpp_h* ret_, tko_cpp_h* self_", "tko_cpp_h* self_" )
    dim as string f = "extern ""C"" " & rt & " " & sg & "(" & pl & ") __asm__(""@@M:" & sg & "@@"");" & L & _
                      "extern ""C"" " & rt & " " & sg & "(" & pl & ") {" & L
    if r.sret <> SR_NONE_ then f &= "    ret_->impl = nullptr; ret_->owned = 0;" & L
    f &= "    try { "
    select case r.sret
    case SR_REF_ : f &= "ret_->impl = const_cast<void*>(static_cast<const void*>(&(" & obj & "))); return ret_;"
    case SR_PTR_ : f &= "ret_->impl = const_cast<void*>(static_cast<const void*>(" & obj & ")); return ret_;"
    case else    : f &= "return " & r.wrap0 & obj & r.wrap1 & ";"
    end select
    f &= " } TKO_CPP_CATCH" & L & "    tko_cpp_raise();" & L & "    return " & iif( r.sret <> SR_NONE_, "ret_", r.fallback ) & ";" & L & "}" & L
    x.shim.Push( f )
    x.mirBody.Push( "    void " & sg & "() const;" )
    x.bound += 1
    '' A const field has no setter -- const through a template argument too (pair<const K, V>.first).
    if (x.api->isConstQualifiedType( t ) <> 0) orelse (x.api->isConstQualifiedType( ct ) <> 0) then return
    '' A POD FIELD'S byref getter is all it gets: beside a setter, fbc refuses 'h.pos.x = 1'
    '' (error 8), and with the getter alone the whole field is written through '*@h.pos'.
    if r.byrefRet then return
    dim as TMap_ m = Param_( x, t, "v_" )
    if m.ok = false then return
    dim as string ss = Sym_( x )
    if Excluded_( x, ss ) then return
    '' A BIT-FIELD takes no reference (fmt's 'align', imgui's 'Colored'): assigned in place.
    dim as string setx = "if (tko_cpp_set(" & obj & ", " & m.arg & ")) return; tko_cpp_last() = ""this field cannot be assigned"";"
    if x.api->Cursor_isBitField( c ) <> 0 then setx = obj & " = " & m.arg & "; return;"
    lines.Push( "declare property " & tn & " alias """ & ss & """ ( " & m.tiko & " )" )
    x.shim.Push( "extern ""C"" void " & ss & "(tko_cpp_h* self_, " & m.ctype & ") __asm__(""@@M:" & ss & "@@"");" & L & _
                 "extern ""C"" void " & ss & "(tko_cpp_h* self_, " & m.ctype & ") {" & L & _
                 "    try { " & setx & " } TKO_CPP_CATCH" & L & _
                 "    tko_cpp_raise();" & L & "}" & L )
    x.mirBody.Push( "    void " & ss & "(" & m.mir & ");" )
end sub

'' A BASE CLASS the binding has a handle for: 'operator cast' to it, a borrowed handle of the
'' base subobject (C++'s own conversion, so any layout), which tiko applies where a base is
'' wanted 'byref ... const'. 'operator cast' ignores its alias: tiko names it 'operator B()'.
sub Cast_( byref x as CppImp_, byval ci as int32, byval ai as int32, byref lines as Tko.StrVec )
    dim as string L = chr( 10 )
    dim as string sx = Sym_( x )
    lines.Push( "declare operator cast alias """ & sx & """ ( ) as " & x.clsTikoQ[ai] & "    '' as its base " & x.clsCpp[ai] )
    '' BY VALUE, NOT THROUGH A RESULT POINTER: tiko gives 'operator cast' no hidden result pointer
    '' whatever the type (fbc's convention, lowercallemit.tiko), so the handle comes back as a plain
    '' 16-byte aggregate -- registers on SysV, a hidden pointer on Win64 -- which is exactly what
    '' C makes of returning the trivial tko_cpp_h.
    dim as string h = "extern ""C"" tko_cpp_h " & sx & "(tko_cpp_h* self_)"
    x.shim.Push( h & " __asm__(""@@M:cast:" & x.clsMir[ci] & ">" & x.clsMir[ai] & "@@"");" & L & h & " {" & L & _
                 "    tko_cpp_h r = { self_->impl ? static_cast<void*>(static_cast<" & x.clsCpp[ai] & "*>(static_cast<" & _
                 x.clsCpp[ci] & "*>(self_->impl))) : nullptr, 0 };" & L & "    return r;" & L & "}" & L )
    x.mirBody.Push( "    operator ::" & x.clsMir[ai] & "();" )
end sub

sub ClassLines_( byref x as CppImp_, byval ci as int32 )
    dim as string L = chr( 10 )
    dim as string cpp = x.clsCpp[ci], tn = x.clsTiko[ci], mq = x.clsMir[ci]
    dim as Members_ mb
    mb.x = @x
    Gather_( x, mb, MemberRoot_( x, ci ) )
    dim as boolean spec = IsSpec_( x, ci )
    dim as boolean abstract_ = (x.api->CXXRecord_isAbstract( x.clsCur[ci] ) <> 0)
    dim as Tko.StrVec lines, glob
    dim as int32 mark = x.mirBody.Count
    x.mirBody.Push( "" )        '' the struct's opening line, written below
    dim as boolean pod = IsPod_( x, ci )

    if pod then
        '' A POD IS COPIED AND DESTROYED AS BYTES, so it has none of a handle's structors -- and a
        '' default constructor only when C++'s does more than zero it: a field initialiser.
        if (mb.userCtor = false) andalso PodHasInit_( x, ci ) then
            dim as string s0 = Sym_( x )
            lines.Push( "declare constructor alias """ & s0 & """ ( )" )
            x.mirBody.Push( "    void " & s0 & "();" )
            x.shim.Push( "extern ""C"" void " & s0 & "(" & cpp & "* self_) __asm__(""@@M:" & s0 & "@@"");" & L & _
                         "extern ""C"" void " & s0 & "(" & cpp & "* self_) { new (self_) " & cpp & "(); }" & L )
            x.sigs.Push( lcase( x.clsTikoQ[ci] & ".constructor()" ) ) : x.sigConst.Push( "" )
        end if
    else
    '' WHAT EVERY HANDLE HAS: the copy constructor, 'let', the destructor -- shim templates that
    '' compile whatever the class allows (prelude) -- and a default constructor when C++ gives
    '' one implicitly. 'let' ignores its alias: tiko names it operator= (measured, C3.md).
    dim as string sc = Sym_( x ), sd = Sym_( x ), sl = Sym_( x )
    lines.Push( "declare constructor alias """ & sc & """ ( byref o_ as const " & x.clsTikoQ[ci] & " )" )
    '' ...whose signature a C++ constructor template can have too: json's iter_impl<json> from
    '' 'const iter_impl<remove_const<json>::type>&' is its own copy constructor's.
    x.sigs.Push( lcase( x.clsTikoQ[ci] & ".constructor(const " & x.clsTikoQ[ci] & ")" ) ) : x.sigConst.Push( "" )
    lines.Push( "declare destructor alias """ & sd & """ ( )" )
    lines.Push( "declare operator let alias """ & sl & """ ( byref o_ as const " & x.clsTikoQ[ci] & " )" )
    x.mirBody.Push( "    void " & sc & "(const " & MirName_( tn ) & "&);" )
    x.mirBody.Push( "    void " & sd & "();" )
    x.mirBody.Push( "    void operator=(const " & MirName_( tn ) & "&);" )
    x.shim.Push( "extern ""C"" void " & sc & "(tko_cpp_h* self_, const tko_cpp_h* o_) __asm__(""@@M:" & sc & "@@"");" & L & _
                 "extern ""C"" void " & sc & "(tko_cpp_h* self_, const tko_cpp_h* o_) { " & _
                 iif( Excluded_( x, sc ), NoBody_( "copied" ), "tko_cpp_copy<" & cpp & ">(self_, o_);" ) & " }" & L )
    x.shim.Push( "extern ""C"" void " & sd & "(tko_cpp_h* self_) __asm__(""@@M:" & sd & "@@"");" & L & _
                 "extern ""C"" void " & sd & "(tko_cpp_h* self_) { tko_cpp_free<" & cpp & ">(self_); }" & L )
    x.shim.Push( "extern ""C"" void " & sl & "(tko_cpp_h* self_, const tko_cpp_h* o_) __asm__(""@@M:let:" & mq & "@@"");" & L & _
                 "extern ""C"" void " & sl & "(tko_cpp_h* self_, const tko_cpp_h* o_) { " & _
                 iif( Excluded_( x, sl ), NoBody_( "assigned" ), "tko_cpp_assign<" & cpp & ">(self_, o_);" ) & " }" & L )
    if (mb.userCtor = false) andalso (abstract_ = false) then
        dim as string s0 = Sym_( x )
        lines.Push( "declare constructor alias """ & s0 & """ ( )" )
        x.mirBody.Push( "    void " & s0 & "();" )
        x.shim.Push( "extern ""C"" void " & s0 & "(tko_cpp_h* self_) __asm__(""@@M:" & s0 & "@@"");" & L & _
                     "extern ""C"" void " & s0 & "(tko_cpp_h* self_) { " & _
                     iif( Excluded_( x, s0 ), NoBody_( "default-constructed" ), "tko_cpp_default<" & cpp & ">(self_);" ) & " }" & L )
        x.sigs.Push( lcase( x.clsTikoQ[ci] & ".constructor()" ) ) : x.sigConst.Push( "" )
    end if
    end if

    '' A POD's pointer-to-handle fields (PodFields_): a property that stores a handle's object.
    for i as int32 = 0 to x.podPtr.Count - 1
        dim as string pe = x.podPtr[i]
        dim as int32 b1 = instr( pe, "|" ), b2 = instr( b1 + 1, pe, "|" )
        if valint( left( pe, b1 - 1 ) ) <> ci then continue for
        dim as string pn = mid( pe, b1 + 1, b2 - b1 - 1 )
        dim as int32 ri = valint( mid( pe, b2 + 1 ) )
        lines.Push( "declare property " & pn & " ( byref tko_val_ as const " & x.clsTikoQ[ri] & " )    '' stores its C++ object in " & pn & "_ptr_" )
        dim as string ns = x.clsNsTiko[ci], d = "", e = ""
        dim as int32 a = 1
        while a <= len( ns )
            dim as int32 q = instr( a, ns, chr( 1 ) )
            if q = 0 then q = len( ns ) + 1
            d &= "namespace " & mid( ns, a, q - a ) & L : e &= "end namespace" & L
            a = q + 1
        wend
        x.defs.Push( d & "property " & ClsRel_( x, ci ) & "." & pn & " ( byref tko_val_ as const " & x.clsTikoQ[ri] & " )" & L & _
                     "    this." & pn & "_ptr_ = tko_val_.impl_" & L & "end property" & L & e )
        '' ...and one for each bound class deriving from it, through its 'operator cast' (C++'s pointer
        '' adjustment): tiko does not convert a property's operand (b2PolygonShape for a b2Shape).
        for rj as int32 = 0 to x.clsUsr.Count - 1
            if (rj = ri) orelse IsPod_( x, rj ) orelse (DerivesFrom_( x, x.clsCur[rj], x.clsUsr[ri], 0 ) = false) then continue for
            lines.Push( "declare property " & pn & " ( byref tko_val_ as const " & x.clsTikoQ[rj] & " )" )
            x.defs.Push( d & "property " & ClsRel_( x, ci ) & "." & pn & " ( byref tko_val_ as const " & x.clsTikoQ[rj] & " )" & L & _
                         "    this." & pn & "_ptr_ = cast( " & x.clsTikoQ[ri] & ", tko_val_ ).impl_" & L & "end property" & L & e )
        next
    next

    '' std::pair's (first, second) constructor: MSVC's are all templates, so the pattern has none to bind.
    if spec andalso (pod = false) andalso IsStdPair_( x, x.clsTmpl[ci] ) then
        dim as CXType pt = x.api->getCursorType( x.clsCur[ci] )
        dim as TMap_ m0 = Param_( x, x.api->Type_getTemplateArgumentAsType( pt, 0 ), "first_" )
        dim as TMap_ m1 = Param_( x, x.api->Type_getTemplateArgumentAsType( pt, 1 ), "second_" )
        if m0.ok andalso m1.ok andalso (m0.vk1 = 0) andalso (m1.vk1 = 0) then
            dim as string sp = Sym_( x )
            lines.Push( "declare constructor alias """ & sp & """ ( " & m0.tiko & ", " & m1.tiko & " )    '' " & cpp & "(first, second)" )
            x.shim.Push( "extern ""C"" void " & sp & "(tko_cpp_h* self_, " & m0.ctype & ", " & m1.ctype & ") __asm__(""@@M:" & sp & "@@"");" & L & _
                         "extern ""C"" void " & sp & "(tko_cpp_h* self_, " & m0.ctype & ", " & m1.ctype & ") {" & L & _
                         "    self_->impl = nullptr; self_->owned = 0;" & L & _
                         "    try { self_->impl = new " & cpp & "(" & m0.arg & ", " & m1.arg & "); self_->owned = 1; return; } TKO_CPP_CATCH" & L & _
                         "    tko_cpp_raise();" & L & "}" & L )
            x.mirBody.Push( "    void " & sp & "(" & m0.mir & ", " & m1.mir & ");" )
            x.bound += 1
        end if
    end if

    '' Methods: a const one before its non-const twin, which tiko cannot tell from it -- the
    '' const one is the one a const handle can call too.
    for pass_ as int32 = 0 to 1
        for i as int32 = 0 to mb.cur.Count - 1
            if (mb.kind[i] = K_FIELD_) orelse (mb.kind[i] = K_SFIELD_) then continue for
            dim as boolean isC = (mb.kind[i] = K_METHOD_) andalso (x.api->CXXMethod_isConst( mb.cur[i] ) <> 0)
            if isC <> (pass_ = 0) then continue for
            dim as string decl, why, lastWhy
            dim as string disp = "::" & MirQual_( x.api, x.api->getCursorSemanticParent( mb.cur[i] ) ) & "::" & _
                                 Text_( x, x.api->getCursorDisplayName( mb.cur[i] ) )
            dim as int32 na = x.api->Cursor_getNumArguments( mb.cur[i] )
            if (mb.kind[i] = K_CTOR_) andalso abstract_ then
                lines.Push( "'' CPP-TODO(abstract class: no constructor): " & disp ) : x.todos += 1
                continue for
            end if
            if spec andalso (ProbeOverride_( x, ci, i ) = false) then
                lines.Push( "'' CPP-TODO(its instantiated type is not known): " & disp ) : x.todos += 1
                continue for
            end if
            if (mb.kind[i] = K_OPANY_) andalso (Text_( x, x.api->getCursorSpelling( mb.cur[i] ) ) = "operator()") then
                '' THE CALL OPERATOR (survey): tiko calls only procedures, so 'sha( "abc" )' is a method,
                '' 'sha.Invoke( "abc" )', with C++'s default arguments as any method's.
                x.nameOverride = "Invoke"
                for k as int32 = 0 to Defaults_( x, mb.cur[i] )
                    if Entry_( x, mb.cur[i], K_METHOD_, ci, decl, why, na - k ) then
                        for g as int32 = 0 to x.extraGlob.Count - 1
                            glob.Push( x.extraGlob[g] )
                        next
                        x.extraGlob.Clear( )
                        lines.Push( decl & "    '' " & disp & ArityNote_( k, na ) )
                    elseif (why <> SAME_SIG_) andalso (why <> lastWhy) then
                        lines.Push( "'' CPP-TODO(" & why & "): " & disp & ArityNote_( k, na ) ) : x.todos += 1
                        lastWhy = why
                    end if
                next
                x.nameOverride = ""
                x.ovrOn = false
                continue for
            end if
            if mb.kind[i] = K_OPANY_ then
                '' A MEMBER OPERATOR: a tiko global one for an operand pair, a member for '[]', a
                '' compound assignment and a conversion to a fundamental.
                dim as string top
                dim as int32 ok = -1
                if x.api->getCursorKind( mb.cur[i] ) = CXCursor_ConversionFunction then
                    dim as string tk, ct
                    if Fund_( x, iif( x.ovrOn, x.ovrRes, x.api->getCursorResultType( mb.cur[i] ) ), tk, ct ) then ok = K_OPMEM_ : top = "cast"
                else
                    ok = OpKind_( trim( mid( Text_( x, x.api->getCursorSpelling( mb.cur[i] ) ), 9 ) ), na, true, top )
                end if
                if ok < 0 then
                    x.ovrOn = false
                    lines.Push( "'' CPP-TODO(operator): " & disp ) : x.todos += 1
                elseif Entry_( x, mb.cur[i], ok, ci, decl, why, na, top ) then
                    if ok = K_OPMEM_ then lines.Push( decl & "    '' " & disp ) else glob.Push( decl & "    '' " & disp )
                elseif why <> SAME_SIG_ then
                    lines.Push( "'' CPP-TODO(" & why & "): " & disp ) : x.todos += 1
                end if
                x.ovrOn = false
                continue for
            end if
            for k as int32 = 0 to Defaults_( x, mb.cur[i] )
                if Entry_( x, mb.cur[i], mb.kind[i], ci, decl, why, na - k ) then
                    for g as int32 = 0 to x.extraGlob.Count - 1
                        glob.Push( x.extraGlob[g] )
                    next
                    x.extraGlob.Clear( )
                    lines.Push( decl & "    '' " & disp & ArityNote_( k, na ) )
                elseif (pass_ = 1) andalso (why = SAME_SIG_) andalso x.twinOfConst then
                    '' the non-const twin of a const method already bound: nothing lost
                elseif why <> lastWhy then
                    lines.Push( "'' CPP-TODO(" & why & "): " & disp & ArityNote_( k, na ) ) : x.todos += 1
                    lastWhy = why
                end if
            next
            x.ovrOn = false
        next
    next
    '' MEMBERS A CALL SHAPE FOUND (D12): template constructors and methods, concrete already.
    x.ovrOn = false
    for i as int32 = 0 to x.extraMem.Count - 1
        dim as CXCursor em = x.extraMem[i]
        dim as string why, decl
        if ClassOf_( x, x.extraCls[i], why ) <> ci then continue for
        dim as int32 ek = x.api->getCursorKind( em ), kk = K_METHOD_, na = x.api->Cursor_getNumArguments( em )
        dim as string emn = Text_( x, x.api->getCursorSpelling( em ) ), top = ""
        dim as string disp = cpp & "::" & Text_( x, x.api->getCursorDisplayName( em ) ) & TemplateArgs_( x, em )
        if ek = CXCursor_Constructor then
            kk = K_CTOR_
        elseif emn = "operator()" then
            kk = K_METHOD_                     '' Invoke (survey: sigslot's emit, a call operator template)
        elseif (ek = CXCursor_ConversionFunction) orelse (left( emn, 8 ) = "operator") then
            kk = OpKind_( trim( mid( emn, 9 ) ), na, true, top )
            if kk < 0 then lines.Push( "'' CPP-TODO(operator): " & disp ) : x.todos += 1 : continue for
        elseif x.api->CXXMethod_isStatic( em ) <> 0 then
            kk = K_STATIC_
        end if
        dim as string lastWhy = ""
        for k as int32 = 0 to iif( (kk = K_OPBIN_) orelse (kk = K_OPUN_) orelse (kk = K_OPMEM_), 0, Defaults_( x, em ) )
            x.calleeTargs = x.extraTargs[i]
            '' Explicit arguments the shape wrote are part of the name: get_long( ), get_double( ).
            if len( x.calleeTargs ) andalso (kk <> K_CTOR_) then x.nameOverride = ValueName_( emn & TargsName_( x.calleeTargs ) )
            if emn = "operator()" then x.nameOverride = "Invoke"
            dim as boolean ok = Entry_( x, em, kk, ci, decl, why, na - k, top )
            x.nameOverride = ""
            if (ok = false) andalso (why = SAME_SIG_) andalso len( TemplateArgsName_( x, em ) ) andalso (kk <> K_CTOR_) then
                x.nameOverride = ValueName_( emn ) & TemplateArgsName_( x, em )
                ok = Entry_( x, em, kk, ci, decl, why, na - k, top )
                x.nameOverride = ""
            end if
            x.calleeTargs = ""
            if ok then
                for g as int32 = 0 to x.extraGlob.Count - 1
                    glob.Push( x.extraGlob[g] )
                next
                x.extraGlob.Clear( )
                if (kk = K_OPBIN_) orelse (kk = K_OPUN_) then glob.Push( decl & "    '' " & disp ) else lines.Push( decl & "    '' " & disp & ArityNote_( k, na ) )
            elseif why <> lastWhy then
                lines.Push( "'' CPP-TODO(" & why & "): " & disp & ArityNote_( k, na ) ) : x.todos += 1
                lastWhy = why
            end if
        next
    next
    if HasRange_( x, ci ) then
        if OuterOf_( x, ci ) >= 0 then
            lines.Push( "'' CPP-TODO(range of a nested class): " & cpp ) : x.todos += 1
        else
            Range_( x, ci, lines )
        end if
    end if
    '' A HANDLE WITH NO DEFAULT CONSTRUCTOR default-constructs EMPTY (impl_ null), as an empty
    '' smart pointer: containers.Array( of T ) needs one, and so does 'dim as T x' before 'x = f( )'.
    if pod = false then
        dim as boolean hasDef = false
        for i as int32 = 0 to x.sigs.Count - 1
            if x.sigs[i] = lcase( x.clsTikoQ[ci] & ".constructor()" ) then hasDef = true
        next
        if hasDef = false then
            dim as string s0 = Sym_( x )
            lines.Push( "declare constructor alias """ & s0 & """ ( )    '' an empty handle: C++ has no default constructor" )
            x.mirBody.Push( "    void " & s0 & "();" )
            x.shim.Push( "extern ""C"" void " & s0 & "(tko_cpp_h* self_) __asm__(""@@M:" & s0 & "@@"");" & L & _
                         "extern ""C"" void " & s0 & "(tko_cpp_h* self_) { self_->impl = nullptr; self_->owned = 0; }" & L )
        end if
    end if
    if spec andalso (pod = false) then
        dim as containers.Array( of CXCursor ) fs
        SpecFields_( x, ci, fs )
        for i as int32 = 0 to fs.Count - 1
            if x.api->getCXXAccessSpecifier( fs[i] ) = CX_CXXPublic then Field_( x, ci, fs[i], lines )
        next
    elseif pod = false then
        for i as int32 = 0 to mb.cur.Count - 1
            if mb.kind[i] = K_FIELD_ then Field_( x, ci, mb.cur[i], lines )
        next
        for g as int32 = 0 to x.extraGlob.Count - 1        '' a vector field's raw entries
            glob.Push( x.extraGlob[g] )
        next
        x.extraGlob.Clear( )
    end if
    for i as int32 = 0 to mb.cur.Count - 1
        if mb.kind[i] <> K_SFIELD_ then continue for
        if spec then
            lines.Push( "'' CPP-TODO(static field of a specialization): " & cpp & "::" & Text_( x, x.api->getCursorSpelling( mb.cur[i] ) ) )
            x.todos += 1
        else
            StaticField_( x, ci, mb.cur[i], lines )
        end if
    next
    '' A SPECIALIZATION'S BASES ARE ITS INSTANTIATION'S: the pattern's are dependent ('GenericValue<
    '' Encoding, Allocator>'), so rapidjson's Document had no cast to its Value.
    if spec then
        mb.seen.Clear( )
        x.api->visitCXXBaseClasses( x.api->getCursorType( x.clsCur[ci] ), @SpecBaseVisit_, @mb )
    end if
    for i as int32 = 0 to mb.seen.Count - 1
        for ai as int32 = 0 to x.clsUsr.Count - 1
            if x.clsUsr[ai] = mb.seen[i] then Cast_( x, ci, ai, lines )
        next
    next
    for i as int32 = 0 to mb.skipped.Count - 1
        dim as string s = mb.skipped[i]
        dim as int32 at = instrrev( s, ": " )
        dim as string why = mid( s, at + 2 )
        dim as string sep = iif( left( why, 10 ) = "base class", " : ", "::" )
        lines.Push( "'' CPP-TODO(" & why & "): " & cpp & sep & left( s, at - 1 ) ) : x.todos += 1
    next

    '' The mirror's struct members, and the range's iterator struct after it: MirUnits_ assembles
    '' them once every class is done, a nested struct inside its outer one.
    dim as string body = ""
    for i as int32 = mark + 1 to x.mirBody.Count - 1
        body &= x.mirBody[i] & L
    next
    while x.mirBody.Count > mark
        x.mirBody.Pop( )
    wend
    x.clsMirBody[ci] = body
    dim as string extra = ""
    for i as int32 = 0 to x.mirExtra.Count - 1
        extra &= x.mirExtra[i]
    next
    x.mirExtra.Clear( )
    x.clsMirExtra[ci] = extra

    '' The members, in the type's second part, and its global operators beside it.
    if lines.Count > 0 then
        dim as Tko.StrVec opened
        dim as string ind = ClassOpen_( x, ci, opened )
        x.bind.Push( ind & "partial type " & tn )
        for i as int32 = 0 to lines.Count - 1
            x.bind.Push( ind & "    " & lines[i] )
        next
        x.bind.Push( ind & "end type" )
        ClassClose_( x, opened )
    end if
    if glob.Count > 0 then
        dim as Tko.StrVec opened
        dim as string ind = NsOpen_( x, ci, opened )
        for i as int32 = 0 to glob.Count - 1
            x.bind.Push( ind & glob[i] )
        next
        NsClose_( x, opened )
    end if
end sub

'' A CLASS'S MIRROR STRUCT, whole: its nested enums, its nested classes' structs (so an outer member
'' may name 'Outer::Inner::E' -- the nested struct is complete before it), then its members.
private function MirStruct_( byref x as CppImp_, byval ci as int32, byref extra as string ) as string
    dim as string L = chr( 10 )
    dim as string s = "struct " & MirName_( x.clsTiko[ci] ) & " {" & L & x.clsNestMir[ci]
    for cj as int32 = 0 to x.clsUsr.Count - 1
        if OuterOf_( x, cj ) = ci then s &= MirStruct_( x, cj, extra ) & L
    next
    extra &= x.clsMirExtra[ci]
    return s & x.clsMirBody[ci] & "};"
end function

'' THE MIRROR'S UNITS: one per class outside any class, its namespaces around it and its extras after.
sub MirUnits_( byref x as CppImp_ )
    for ci as int32 = 0 to x.clsUsr.Count - 1
        if OuterOf_( x, ci ) >= 0 then continue for
        dim as string extra = ""
        dim as string st = MirStruct_( x, ci, extra )
        x.mirBody.Push( MirWrap_( x.clsNsMir[ci], st ) & extra )
        x.mirCls.Push( str( ci ) )
    next
end sub

'' EVERY HANDLE TYPE, then every class's members: see CppImp_.
sub EmitClasses_( byref x as CppImp_ )
    PodCheck_( x )
    for ci as int32 = 0 to x.clsUsr.Count - 1
        '' A POD's fields come later (PodEmitAll_); its nested enums, if any, here.
        dim as boolean pod = IsPod_( x, ci )
        if pod andalso (len( x.clsNestBind[ci] ) = 0) then continue for
        dim as Tko.StrVec opened
        dim as string ind = ClassOpen_( x, ci, opened )
        x.bind.Push( ind & "partial type " & x.clsTiko[ci] & "    '' " & x.clsCpp[ci] )
        if pod = false then
            x.bind.Push( ind & "    as any ptr impl_      '' the C++ object" )
            x.bind.Push( ind & "    as longint owned_     '' 1: this handle deletes it" )
        end if
        dim as string nb = x.clsNestBind[ci]
        dim as int32 a = 1
        while a <= len( nb )
            dim as int32 b = instr( a, nb, chr( 10 ) )
            if b = 0 then b = len( nb ) + 1
            if b > a then x.bind.Push( ind & "    " & mid( nb, a, b - a ) )
            a = b + 1
        wend
        x.bind.Push( ind & "end type" )
        ClassClose_( x, opened )
    next
    PodEmitAll_( x )
    for ci as int32 = 0 to x.clsUsr.Count - 1
        ClassLines_( x, ci )
    next
    MirUnits_( x )
    '' THE LAYOUT CHECKS, once every type is complete.
    for i as int32 = 0 to x.asserts.Count - 1
        x.bind.Push( x.asserts[i] )
    next
end sub

'' A CLASS, with the namespaces it is in given: the walk's own for a class it meets, its template's
'' for a specialization (cpptmpl.tiko).
sub CollectAt_( byref x as CppImp_, byval c as CXCursor, byref tn as string, byref cppQ as string, _
                byref ns as Tko.StrVec, byval tmpl as CXCursor, byval spec as boolean, byval outer as int32 = -1 )
    dim as string usr = Text_( x, x.api->getCursorUSR( c ) )
    for i as int32 = 0 to x.clsUsr.Count - 1
        if x.clsUsr[i] = usr then return
    next
    dim as string nt = "", nmr = "", tq = "", mq = ""
    if outer >= 0 then
        '' NESTED: in its outer class's namespaces, named through it.
        nt = x.clsNsTiko[outer] : nmr = x.clsNsMir[outer]
        tq = x.clsTikoQ[outer] & "." : mq = x.clsMir[outer] & "::"
    else
        for i as int32 = 0 to ns.Count - 1
            if i > 0 then nt &= chr( 1 ) : nmr &= chr( 1 )
            nt &= ns[i] : nmr &= ucase( ns[i] )
            tq &= ns[i] & "." : mq &= ucase( ns[i] ) & "::"
        next
    end if
    '' TWO CLASSES NEVER SHARE A tiko NAME: a second is '<name>_2', and so on.
    dim as string tn0 = tn
    dim as int32 dup = 1
    dim as boolean taken = true
    while taken
        taken = false
        for i as int32 = 0 to x.clsTikoQ.Count - 1
            if lcase( x.clsTikoQ[i] ) = lcase( tq & tn ) then taken = true : exit for
        next
        if taken then dup += 1 : tn = tn0 & "_" & dup
    wend
    x.clsUsr.Push( usr )
    x.clsTiko.Push( tn )
    x.clsTikoQ.Push( tq & tn )
    x.clsCpp.Push( cppQ )
    x.clsMir.Push( mq & MirName_( tn ) )
    x.clsNsTiko.Push( nt )
    x.clsNsMir.Push( nmr )
    x.clsCur.Push( c )
    x.clsTmpl.Push( tmpl )
    x.clsSpec.Push( iif( spec, "1", "" ) )
    x.clsOuter.Push( iif( outer >= 0, str( outer ), "" ) )
    x.clsNestBind.Push( "" )
    x.clsNestMir.Push( "" )
    x.clsMirBody.Push( "" )
    x.clsMirExtra.Push( "" )
    if outer < 0 then x.mirFwd.Push( MirWrap_( nmr, "struct " & MirName_( tn ) & ";" ) )
end sub

'' IS A NAME TAKEN BY A MEMBER of class cursor c? tiko names are case-insensitive, so a nested
'' 'enum Type' and a method 'type()' would be one name: the nested type gives way, '_' at a time.
type Taken_
    as CppImp_ ptr x
    as string nm
    as boolean hit
end type

private function TakenVisit_ cdecl ( byval c as CXCursor, byval parent as CXCursor, byval client as any ptr ) as int32
    dim as Taken_ ptr tk = client
    dim as CppImp_ ptr xp = tk->x
    if xp->api->getCXXAccessSpecifier( c ) <> CX_CXXPublic then return CXChildVisit_Continue
    select case xp->api->getCursorKind( c )
    case CXCursor_CXXMethod, CXCursor_FieldDecl, CXCursor_VarDecl, CXCursor_FunctionTemplate
        if lcase( ValueName_( Text_( *xp, xp->api->getCursorSpelling( c ) ) ) ) = lcase( tk->nm ) then tk->hit = true
    end select
    return CXChildVisit_Continue
end function

private function NestName_( byref x as CppImp_, byval outerCur as CXCursor, byref nm as string ) as string
    dim as Taken_ tk
    tk.x = @x
    tk.nm = TypeName_( nm )
    do
        tk.hit = false
        x.api->visitChildren( outerCur, @TakenVisit_, @tk )
        if tk.hit = false then exit do
        tk.nm &= "_"
    loop
    return tk.nm
end function

'' A CLASS'S NESTED TYPES: its public classes (collected, nested in it) and enums (their lines
'' and names). Not a class template's, nor an anonymous one.
type Nest_
    as CppImp_ ptr x
    as int32 ci
    as CXCursor outerCur
    as containers.Array( of CXCursor ) cls
    as boolean enumsOnly          '' a specialization's: its pattern's enums, matched by spelling
end type

private function NestVisit_ cdecl ( byval c as CXCursor, byval parent as CXCursor, byval client as any ptr ) as int32
    dim as Nest_ ptr ns = client
    dim as CppImp_ ptr xp = ns->x
    dim as int32 k = xp->api->getCursorKind( c )
    if (k <> CXCursor_ClassDecl) andalso (k <> CXCursor_StructDecl) andalso (k <> CXCursor_EnumDecl) then return CXChildVisit_Continue
    if xp->api->getCXXAccessSpecifier( c ) <> CX_CXXPublic then return CXChildVisit_Continue
    if xp->api->isCursorDefinition( c ) = 0 then return CXChildVisit_Continue
    dim as string nm = Text_( *xp, xp->api->getCursorSpelling( c ) )
    if (k = CXCursor_EnumDecl) andalso ((len( nm ) = 0) orelse (instr( nm, "(" ) > 0)) then
        dim as Tko.StrVec al
        AnonEnum_( *xp, c, al )
        for i as int32 = 0 to al.Count - 1
            xp->clsNestBind[ns->ci] = xp->clsNestBind[ns->ci] & al[i] & chr( 10 )
        next
        return CXChildVisit_Continue
    end if
    if (len( nm ) = 0) orelse (instr( nm, "(" ) > 0) then return CXChildVisit_Continue
    if k <> CXCursor_EnumDecl then
        if ns->enumsOnly = false then ns->cls.Push( c )
        return CXChildVisit_Continue
    end if
    dim as int32 ci = ns->ci
    dim as string tn = NestName_( *xp, ns->outerCur, nm )
    dim as Tko.StrVec lines
    if EnumLines_( *xp, c, tn, lines ) = false then return CXChildVisit_Continue
    dim as string nb = xp->clsNestBind[ci]
    for i as int32 = 0 to lines.Count - 1
        nb &= lines[i] & chr( 10 )
    next
    xp->clsNestBind[ci] = nb
    '' A SPECIALIZATION's nested enum is the pattern's declaration: its instantiation is matched by its
    '' C++ spelling (EnumOf_), '::kainjow::mustache::basic_data<std::basic_string<char>>::type'.
    xp->enumUsr.Push( iif( ns->enumsOnly, "spell:" & xp->clsCpp[ci] & "::" & nm, Text_( *xp, xp->api->getCursorUSR( c ) ) ) )
    xp->enumTiko.Push( xp->clsTikoQ[ci] & "." & tn )
    xp->enumCpp.Push( xp->clsCpp[ci] & "::" & nm )
    xp->enumMir.Push( xp->clsMir[ci] & "::" & ucase( tn ) )
    xp->clsNestMir[ci] = xp->clsNestMir[ci] & "    enum " & ucase( tn ) & " : long long {};" & chr( 10 )
    return CXChildVisit_Continue
end function

sub CollectNested_( byref x as CppImp_, byval c as CXCursor, byval ci as int32, byval enumsOnly as boolean = false )
    dim as Nest_ ns
    ns.x = @x
    ns.ci = ci
    ns.outerCur = c
    ns.enumsOnly = enumsOnly
    x.api->visitChildren( c, @NestVisit_, @ns )
    dim as CXCursor none_
    for i as int32 = 0 to ns.cls.Count - 1
        dim as string nm = Text_( x, x.api->getCursorSpelling( ns.cls[i] ) )
        dim as int32 n0 = x.clsUsr.Count
        CollectAt_( x, ns.cls[i], NestName_( x, c, nm ), x.clsCpp[ci] & "::" & nm, x.tikoNs, none_, false, ci )
        if x.clsUsr.Count > n0 then CollectNested_( x, ns.cls[i], n0 )
    next
end sub

sub CollectClass_( byref x as CppImp_, byval c as CXCursor )
    dim as string nm = Text_( x, x.api->getCursorSpelling( c ) )
    if x.api->isCursorDefinition( c ) = 0 then return
    if (len( nm ) = 0) orelse (instr( nm, "(" ) > 0) then return
    '' An explicit specialization ('template<> struct Box<int>') is a specialization: named
    '' 'Box_long' where the API names it (cpptmpl.tiko), not 'Box'.
    if IsNullCursor_( x, x.api->getSpecializedCursorTemplate( c ) ) = false then return
    dim as CXCursor none_
    dim as int32 n0 = x.clsUsr.Count
    '' A CLASS NAMED LIKE A NAMESPACE IT IS IN (delaunator::Delaunator) is one name to tiko: the
    '' class gives way, 'delaunator.Delaunator_'.
    dim as string tn = TypeName_( nm )
    for i as int32 = 0 to x.tikoNs.Count - 1
        if lcase( x.tikoNs[i] ) = lcase( tn ) then tn &= "_" : i = -1
    next
    CollectAt_( x, c, tn, QualCpp_( x, nm ), x.tikoNs, none_, false )
    if x.clsUsr.Count > n0 then CollectNested_( x, c, n0 )
end sub

'' THE TYPES A CLASS'S MEMBERS NAME, for the specializations among them (cpptmpl.tiko NoteType_).
sub DiscoverClass_( byref x as CppImp_, byval ci as int32 )
    dim as Members_ mb
    mb.x = @x
    Gather_( x, mb, MemberRoot_( x, ci ) )
    if IsSpec_( x, ci ) then
        '' A SPECIALIZATION's member types are its probes' (cpptmpl.tiko), its fields its own.
        for i as int32 = 0 to mb.cur.Count - 1
            if (mb.kind[i] <> K_FIELD_) andalso (mb.kind[i] <> K_SFIELD_) andalso ProbeOverride_( x, ci, i ) then
                NoteType_( x, x.ovrRes )
                for a as int32 = 0 to x.ovrArgs.Count - 1
                    NoteType_( x, x.ovrArgs[a] )
                next
            end if
        next
        x.ovrOn = false
        dim as containers.Array( of CXCursor ) fs
        SpecFields_( x, ci, fs )
        for i as int32 = 0 to fs.Count - 1
            NoteType_( x, x.api->getCursorType( fs[i] ) )
        next
        return
    end if
    for i as int32 = 0 to mb.cur.Count - 1
        if (mb.kind[i] = K_FIELD_) orelse (mb.kind[i] = K_SFIELD_) then
            NoteType_( x, x.api->getCursorType( mb.cur[i] ) )
        else
            NoteFunction_( x, mb.cur[i] )
        end if
    next
end sub

'' A specialization's pattern members, in Gather_'s order -- the order its probes are numbered in.
sub SpecMembers_( byref x as CppImp_, byval ci as int32, byref mem as containers.Array( of CXCursor ), _
                  byref kinds as containers.Array( of int32 ) )
    dim as Members_ mb
    mb.x = @x
    Gather_( x, mb, MemberRoot_( x, ci ) )
    for i as int32 = 0 to mb.cur.Count - 1
        mem.Push( mb.cur[i] ) : kinds.Push( mb.kind[i] )
    next
end sub

end namespace
