'' cppint.ti -- the C++ importer's own declarations, shared by its units (cppimport.tiko: the
'' walk, the mirror, the texts and the run; cpptypes.tiko: names and the type mapping;
'' cppclass.tiko: entry points and classes). Not an interface: cppimport.ti is.

#pragma once

#include once "cppimport/cppimport.ti"
#include once "cimport/import.ti"
#include once "lexer/token.ti"

namespace Tko.CppImport

using Tko.CImport

'' clang's CXTypeKind values this file reads (Index.h, LLVM 23; cimport/types.tiko has the same).
const TY_VOID_ = 2, TY_BOOL_ = 3, TY_CHAR_U_ = 4, TY_UCHAR_ = 5, TY_CHAR16_ = 6, TY_CHAR32_ = 7
const TY_USHORT_ = 8, TY_UINT_ = 9, TY_ULONG_ = 10, TY_ULONGLONG_ = 11, TY_CHAR_S_ = 13
const TY_SCHAR_ = 14, TY_SHORT_ = 16, TY_INT_ = 17, TY_LONG_ = 18, TY_LONGLONG_ = 19
const TY_FLOAT_ = 21, TY_DOUBLE_ = 22, TY_POINTER_ = 101, TY_LREF_ = 103, TY_RREF_ = 104
const TY_RECORD_ = 105, TY_ENUM_ = 106, TY_ELABORATED_ = 119, TY_CARRAY_ = 112

const UNIT_NAME_ = "tiko-cppimport.cpp"
const SAME_SIG_ = "same tiko signature as an overload before it"
const MIRROR_NAME_ = "tiko-cppmirror.cpp"
const ERR_CPP_ = 1000          '' the runtime error number of a C++ exception (D5)

'' An entry's kind.
const K_FREE_ = 0, K_METHOD_ = 1, K_STATIC_ = 2, K_CTOR_ = 3, K_FIELD_ = 4
'' Operators (C3b-1): a tiko global binary or unary operator -- from a C++ member operator or a
'' free one -- a tiko member operator ('[]', compound assignment, a conversion), and a member
'' operator not yet sorted into one of those.
const K_OPBIN_ = 5, K_OPUN_ = 6, K_OPMEM_ = 7, K_OPANY_ = 8

'' A handle result: none, an owned copy of the C++ value, or a borrowed reference / pointer.
const SR_NONE_ = 0, SR_OWNED_ = 1, SR_REF_ = 2, SR_PTR_ = 3
'' ...and (C3b-2) a std::unique_ptr result, owned; a std::shared_ptr one, shared.
const SR_UNIQUE_ = 4, SR_SHARED_ = 5

type CppImp_
    as ClangApi ptr api
    as any ptr       tu
    as string        hdrDir       '' the header's directory, '/'-separated, ending '/'
    as boolean       foldCase     '' compare paths without case (Windows)
    as string        id           '' 8 hex digits, from the header's spelling
    as int32          n           '' the next entry number
    as int32          pass        '' 1 enums, 2 classes collected, 3 functions
    as Tko.StrVec    bind         '' binding lines
    as Tko.StrVec    shim         '' shim functions
    as Tko.StrVec    cppNs        '' C++ names of the namespaces being walked
    as Tko.StrVec    tikoNs       '' their tiko names
    as Tko.StrVec    enumUsr      '' enums emitted: USR, tiko, C++ and mirror qualified names
    as Tko.StrVec    enumTiko
    as Tko.StrVec    enumCpp
    as Tko.StrVec    enumMir
    as Tko.StrVec    sigs         '' tiko signatures written, lowercase: an overload tiko
                                  '' cannot tell from another is refused
    as Tko.StrVec    sigConst     '' "c" where sigs[i] is a const method's
    as boolean        twinOfConst  '' the refused one's twin was a const method
    '' CLASSES, collected in pass 2. Every handle type is declared (its two fields) before any
    '' class's members, which follow in a second 'partial type' block of each: so a member may
    '' name any class -- a tiko type can otherwise name one declared below it only through a
    '' pointer (TKO0811), and tinyxml2's XMLNode and XMLElement name each other.
    as Tko.StrVec    clsUsr
    as Tko.StrVec    clsTiko      '' the tiko type's own name
    as Tko.StrVec    clsTikoQ     '' ...qualified, for parameters
    as Tko.StrVec    clsCpp       '' '::geo::Counter'
    as Tko.StrVec    clsMir       '' the mirror's 'GEO::Counter'
    as Tko.StrVec    clsNsTiko    '' the namespaces, chr( 1 )-separated
    as Tko.StrVec    clsNsMir
    as containers.Array( of CXCursor ) clsCur
    '' "1": a POD (C3b-1) -- a tiko value type with the C++ layout, not a handle: trivially
    '' copyable, standard layout, public fields tiko can lay out the same way. cpppod.tiko.
    as Tko.StrVec    clsPod
    '' THE MIRROR: the declarations tiko writes, as C++ over opaque types, for libclang to mangle
    '' under the target's Itanium triple -- each method's name is what the shim must define.
    as Tko.StrVec    mirFwd
    as Tko.StrVec    mirBody
    as int32          bound
    as int32          todos
    as int32          mop          '' the next member operator's mirror key, "mop<n>": a member
                                   '' operator has no name of its own to look the mangling up by
    as Tko.StrVec    asserts      '' the binding's layout checks, after every type
    '' TEMPLATES (C3b-2, cpptmpl.tiko).
    as Tko.StrVec    tmplNames    '' the header's templates, 'geo::Box', and "c" / "f" in tmplKinds
    as Tko.StrVec    tmplKinds
    as Tko.StrVec    needForce    '' specializations named but not complete: the next parse forces them
    as string        calleeOverride '' a function instantiation's C++ name: 'geo::clamp<int>'
    as Tko.StrVec    instBases    '' the '#cppinstantiate' templates' names: 'geo::clamp'
    as containers.Array( of CXCursor ) clsTmpl   '' a specialization's class template (its pattern)
    as Tko.StrVec    clsSpec      '' "1": class ci is a specialization
    as Tko.StrVec    probeNames   '' the probes this parse resolved (cpptmpl.tiko)
    as Tko.StrVec    badProbes    '' ...and those clang reported an error on: unknown, whatever it recovered
    as Tko.StrVec    exclude      '' CppImportOptions.exclude: entries whose shim body did not compile
    as containers.Array( of CXType ) probeTypes
    as boolean        ovrOn        '' Entry_ takes its types from ovrRes / ovrArgs, not the cursor
    as CXType         ovrRes
    as containers.Array( of CXType ) ovrArgs
    '' std::vector (cppvec.tiko): each element type's traits, the adapters, the raw entries' lines.
    as Tko.StrVec    vecEC        '' the element's C++ spelling
    as Tko.StrVec    vecET        '' ...tiko's
    as Tko.StrVec    vecBase      '' the traits' common symbol, 'tko_cpp_<id>_<n>'
    as Tko.StrVec    vecDecls     '' their declarations, at the binding's end
    as Tko.StrVec    defs         '' the adapters, private, after them
    as Tko.StrVec    extraGlob    '' a raw entry's declaration, which Entry_'s caller writes
    as Tko.StrVec    mirExtra     '' a range's iterator struct, after its class's in the mirror
    '' ALIASES (D13) and CALL SHAPES (D12), cpptmpl.tiko.
    as Tko.StrVec    alUsr        '' a specialization an alias names: its USR, the alias, its namespaces
    as Tko.StrVec    alName
    as Tko.StrVec    alNs
    as Tko.StrVec    alCpp        '' every alias's C++ name, 'nlohmann::json'
    as containers.Array( of CXCursor ) extraMem   '' members a call shape found: their class's
    as Tko.StrVec    extraTargs   '' ...and the template arguments the shape wrote, '<int>'
    as containers.Array( of CXType ) extraCls   '' ...and the class the shape named: a base's member is the derived's too
    as string        calleeTargs  '' Entry_'s explicit template arguments for the call
    as string        nameOverride '' Entry_'s tiko name, when an instantiation needs its arguments in it
end type

'' One parameter or result, as the texts that carry it.
type TMap_
    as boolean ok
    as string  why
    as string  tiko       '' parameter: 'byval n as T' / 'byref n as const T'; result: 'T'
    as string  ctype      '' the shim's C type for it
    as string  arg        '' parameter: the C++ argument expression, from the shim parameter
    as string  mir        '' parameter: the mirror's C++ type, which mangles as tiko's does
    as string  wrap0      '' result: around the call
    as string  wrap1
    as string  fallback   '' result: what the shim returns after a raise that came back
    as int32   sret       '' result: SR_*
    as string  rcpp       '' result: the C++ class of an owned handle
    as boolean byrefRet   '' result: 'byref as T' -- the shim returns a pointer to it
    as int32   vk1        '' a std::vector: its traits' index + 1 (cppvec.tiko); 0 none
    as int32   vmode      '' parameter: 1 in (by value, const&), 2 in and out (&)
    as string  pub        '' parameter: the adapter's own, 'byref v as const containers.Array( of T )'
end type

declare function Indent_( byref x as CppImp_ ) as string
declare function Text_( byref x as CppImp_, byval s as CXString ) as string
declare function Fwd_( byref p as string ) as string
declare function InScope_( byref x as CppImp_, byval c as CXCursor ) as boolean
declare function QualTiko_( byref x as CppImp_, byref nm as string ) as string
declare function QualCpp_( byref x as CppImp_, byref nm as string ) as string
declare function QualMir_( byref x as CppImp_, byref nm as string ) as string
declare function MirWrap_( byref nsList as string, byref body as string ) as string
declare sub Todo_( byref x as CppImp_, byref what as string, byref why as string )
declare function Canon_( byref x as CppImp_, byval t as CXType ) as CXType
declare function Spell_( byref x as CppImp_, byval t as CXType ) as string
declare function BareSpell_( byref s as string ) as string
declare function Fund_( byref x as CppImp_, byval t as CXType, byref tk as string, _
                        byref ct as string ) as boolean
declare function MirFund_( byref tk as string ) as string
declare function StrKind_( byref x as CppImp_, byval t as CXType ) as int32
declare function EnumOf_( byref x as CppImp_, byval t as CXType, byref tq as string, _
                          byref cq as string, byref mq as string ) as boolean
declare function ClassOf_( byref x as CppImp_, byval t as CXType, byref why as string ) as int32
declare function Param_( byref x as CppImp_, byval t as CXType, byref nm as string ) as TMap_
declare function Result_( byref x as CppImp_, byval t as CXType ) as TMap_
declare function ValueName_( byref nm as string ) as string
declare function TypeName_( byref nm as string ) as string
declare function MirName_( byref tn as string ) as string
declare function ParamName_( byref x as CppImp_, byval a as CXCursor, byval i as int32 ) as string
declare sub Enum_( byref x as CppImp_, byval c as CXCursor )
declare function Entry_( byref x as CppImp_, byval c as CXCursor, byval kind as int32, _
                         byval ci as int32, byref decl as string, byref why as string, _
                         byval upto as int32 = -1, byval top as string = "" ) as boolean
declare function Defaults_( byref x as CppImp_, byval c as CXCursor ) as int32
declare function ArityNote_( byval k as int32, byval na as int32 ) as string
declare sub Function_( byref x as CppImp_, byval c as CXCursor )
declare function MirQual_( byval api as ClangApi ptr, byval c as CXCursor ) as string
declare function NsOpen_( byref x as CppImp_, byval ci as int32, byref opened as Tko.StrVec ) as string
declare sub NsClose_( byref x as CppImp_, byref opened as Tko.StrVec )
declare function Sym_( byref x as CppImp_ ) as string
declare sub Field_( byref x as CppImp_, byval ci as int32, byval c as CXCursor, byref lines as Tko.StrVec )
declare sub Cast_( byref x as CppImp_, byval ci as int32, byval ai as int32, byref lines as Tko.StrVec )
declare sub ClassLines_( byref x as CppImp_, byval ci as int32 )
declare sub EmitClasses_( byref x as CppImp_ )
declare sub CollectClass_( byref x as CppImp_, byval c as CXCursor )
declare function ResolveMirror_( byref api as ClangApi, byref triple as string, byref mir as string, _
                                 byref shim as string, byref res as CppImportResult ) as boolean
declare function Id_( byref s as string ) as string
declare function Prelude_( ) as string
declare function BindingHead_( byref hdr as string, byref ver as string, byref tgt as string, _
                               byval needsContainers as boolean ) as string

'' cpppod.tiko
declare function IsPod_( byref x as CppImp_, byval ci as int32 ) as boolean
declare function PodCName_( byref x as CppImp_, byval ci as int32 ) as string
declare sub PodCheck_( byref x as CppImp_ )
declare sub PodFields_( byref x as CppImp_, byval ci as int32 )
declare sub PodEmitAll_( byref x as CppImp_ )
declare function PodHasInit_( byref x as CppImp_, byval ci as int32 ) as boolean
'' cpptmpl.tiko
declare function IsNullCursor_( byref x as CppImp_, byval c as CXCursor ) as boolean
declare function InStd_( byref x as CppImp_, byval c as CXCursor ) as boolean
declare function StdTemplate_( byref x as CppImp_, byval t as CXType ) as string
declare function SpecName_( byref x as CppImp_, byval t as CXType ) as string
declare function NsOf_( byref x as CppImp_, byval c as CXCursor, byref ns as Tko.StrVec ) as boolean
declare sub NoteType_( byref x as CppImp_, byval t as CXType )
declare sub NoteFunction_( byref x as CppImp_, byval c as CXCursor )
declare function InstClass_( byref x as CppImp_, byval i as int32 ) as CXType
declare function InstFunction_( byref x as CppImp_, byval i as int32, byref fn as CXCursor ) as boolean
declare sub AliasNote_( byref x as CppImp_, byval c as CXCursor )
declare function AliasOf_( byref x as CppImp_, byval d as CXCursor, byref ns as Tko.StrVec ) as string
declare function ShapeSplit_( byref s as string, byref callee as string, byref args as Tko.StrVec ) as boolean
declare function ShapeKind_( byref x as CppImp_, byref s as string ) as string
declare function ShapeLine_( byref s as string, byref kind as string, byval i as int32 ) as string
declare function ShapeTarget_( byref x as CppImp_, byval i as int32, byref fn as CXCursor ) as boolean
declare function ShapeClass_( byref x as CppImp_, byval i as int32 ) as CXType
declare function TemplateArgs_( byref x as CppImp_, byval c as CXCursor ) as string
declare function ShapeTargs_( byref s as string ) as string
declare function TargsName_( byref targs as string ) as string
declare function TemplateArgsName_( byref x as CppImp_, byval c as CXCursor ) as string
'' cppclass.tiko, classes from anywhere
declare sub CollectAt_( byref x as CppImp_, byval c as CXCursor, byref tn as string, byref cppQ as string, _
                        byref ns as Tko.StrVec, byval tmpl as CXCursor, byval spec as boolean )
declare sub SpecMembers_( byref x as CppImp_, byval ci as int32, byref mem as containers.Array( of CXCursor ), _
                          byref kinds as containers.Array( of int32 ) )
declare function SpecPattern_( byref x as CppImp_, byval ci as int32 ) as CXCursor
declare function IsSpec_( byref x as CppImp_, byval ci as int32 ) as boolean
declare function MemberRoot_( byref x as CppImp_, byval ci as int32 ) as CXCursor
declare function ProbeLines_( byref x as CppImp_, byval ci as int32, byref out_ as Tko.StrVec, byref keys as Tko.StrVec ) as boolean
declare function DeclHasInit_( byref x as CppImp_, byval f as CXCursor, byval brace as boolean ) as boolean
declare sub LoadProbes_( byref x as CppImp_ )
declare function ProbeOverride_( byref x as CppImp_, byval ci as int32, byval j as int32 ) as boolean
declare sub SpecFields_( byref x as CppImp_, byval ci as int32, byref out_ as containers.Array( of CXCursor ) )
declare sub DiscoverClass_( byref x as CppImp_, byval ci as int32 )
'' cppvec.tiko
declare function VecKind_( byref x as CppImp_, byval e as CXType, byref why as string ) as int32
declare function StdParam_( byref x as CppImp_, byval t as CXType, byref nm as string, byref m as TMap_ ) as boolean
declare function StdResult_( byref x as CppImp_, byval t as CXType, byref m as TMap_ ) as boolean
declare function HasRange_( byref x as CppImp_, byval ci as int32 ) as boolean
declare function RangeProbe_( byref x as CppImp_, byval ci as int32 ) as string
declare sub Range_( byref x as CppImp_, byval ci as int32, byref lines as Tko.StrVec )
declare sub Adapter_( byref x as CppImp_, byref nsList as string, byref head as string, byref rawq as string, _
                      byref self_ as string, byref names as Tko.StrVec, byref vks as containers.Array( of int32 ), _
                      byref modes as containers.Array( of int32 ), byval rvk as int32, byref rtiko as string, byval isSub as boolean )
'' cppclass.tiko, operators
declare function OpKind_( byref cop as string, byval nargs as int32, byval isMember as boolean, _
                          byref top as string ) as int32

end namespace
