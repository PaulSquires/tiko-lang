'' cppvars.tiko -- the C++ importer's variables and class extras (the C++ import survey,
'' docs/tiko-cpp/SURVEY.md): a class's static data members, a namespace's variables and constants, the
'' fallback a declared but undefined C++ symbol links to, conversions to a class, derivation. See cppint.ti.

#import "std/containers"
#include once "cppimport/cppint.ti"

namespace Tko.CppImport

using Tko.CImport

'' A FALLBACK FOR A C++ SYMBOL a shim calls (see CppImp_.altNames): only a declaration with no body in
'' the header -- a defined one is in the shim's own object -- and not a template's.
sub AltName_( byref x as CppImp_, byval c as CXCursor )
    if x.coff = false then return
    if IsNullCursor_( x, x.api->getCursorDefinition( c ) ) = false then return
    if IsNullCursor_( x, x.api->getSpecializedCursorTemplate( c ) ) = false then return
    dim as string m = Text_( x, x.api->Cursor_getMangling( c ) )
    if (len( m ) = 0) orelse (instr( m, " " ) > 0) orelse (instr( m, """" ) > 0) then return
    for i as int32 = 0 to x.altNames.Count - 1
        if x.altNames[i] = m then return
    next
    x.altNames.Push( m )
end sub

'' A CONSTANT VARIABLE clang evaluates to an integer or a bool -- a class's 'static constexpr int N = 4',
'' a namespace's 'constexpr std::size_t INVALID_INDEX = ...' -- as a tiko const line; "" otherwise.
function ConstOf_( byref x as CppImp_, byval c as CXCursor, byref tn as string ) as string
    dim as CXType t = x.api->getCursorType( c )
    if x.api->isConstQualifiedType( t ) = 0 then return ""
    dim as string tk, cty
    if Fund_( x, t, tk, cty ) = false then return ""
    if (tk = "single") orelse (tk = "double") then return ""
    dim as any ptr ev = x.api->Cursor_Evaluate( c )
    if ev = nullptr then return ""
    dim as string v = ""
    if x.api->EvalResult_getKind( ev ) = 1 then          '' CXEval_Int
        dim as int64 n = x.api->EvalResult_getAsLongLong( ev )
        if tk = "boolean" then
            v = iif( n <> 0, "true", "false" )
        elseif x.api->EvalResult_isUnsignedInt( ev ) then
            v = str( cast( uint64, n ) )
        else
            v = str( n )
        end if
    end if
    x.api->EvalResult_dispose( ev )
    if len( v ) = 0 then return ""
    return "const " & tn & " as " & tk & " = " & v
end function

'' A NAMESPACE'S VARIABLE (survey: SQLiteCpp's 'extern const int OPEN_READWRITE', stduuid's 'static uuid
'' uuid_namespace_dns'): a constant as a const, anything else a function of no arguments returning
'' it -- tiko calls one without parentheses, 'SQLite.OPEN_READWRITE' -- a class a borrowed handle.
sub Var_( byref x as CppImp_, byval c as CXCursor )
    dim as string L = chr( 10 ), why
    dim as string nm = Text_( x, x.api->getCursorSpelling( c ) )
    if len( nm ) = 0 then return
    dim as string disp = QualCpp_( x, nm )
    dim as string tn = ValueName_( nm )
    '' AN OUT-OF-CLASS DEFINITION of a class template's static member is no namespace variable.
    dim as int32 pk = x.api->getCursorKind( x.api->getCursorSemanticParent( c ) )
    if (pk <> CXCursor_Namespace) andalso (pk <> CXCursor_TranslationUnit) andalso (pk <> CXCursor_LinkageSpec) then return
    '' THE SAME VARIABLE declared twice (SQLiteCpp's 'extern const int OK') is bound once; another whose
    '' name differs only in case takes '_'.
    dim as string vu = "usr:" & Text_( x, x.api->getCursorUSR( c ) )
    for i as int32 = 0 to x.varNames.Count - 1
        if x.varNames[i] = vu then return
    next
    x.varNames.Push( vu )
    dim as boolean taken = true
    while taken
        taken = false
        for i as int32 = 0 to x.varNames.Count - 1
            if x.varNames[i] = lcase( QualTiko_( x, tn ) ) then taken = true : tn &= "_" : exit for
        next
    wend
    x.varNames.Push( lcase( QualTiko_( x, tn ) ) )
    dim as string cl = ConstOf_( x, c, tn )
    if len( cl ) then
        x.bind.Push( Indent_( x ) & cl & "    '' " & disp )
        x.bound += 1
        return
    end if
    dim as CXType t = x.api->getCursorType( c )
    dim as CXType ct = Canon_( x, t )
    dim as TMap_ r
    if (ct.kind = TY_RECORD_) andalso (StrKind_( x, t ) = 0) then
        dim as int32 ri = ClassOf_( x, t, why )
        if ri < 0 then Todo_( x, disp, why ) : return
        if IsPod_( x, ri ) then
            r.ok = true : r.tiko = x.clsTikoQ[ri] : r.byrefRet = true : r.ctype = x.clsCpp[ri] & "*"
            r.wrap0 = "const_cast<" & x.clsCpp[ri] & "*>(&(" : r.wrap1 = "))" : r.fallback = "nullptr"
        else
            r.ok = true : r.tiko = x.clsTikoQ[ri] : r.ctype = "tko_cpp_h*" : r.sret = SR_REF_
        end if
    else
        r = Result_( x, t )
        if r.ok andalso ((r.vk1 <> 0) orelse (r.sret <> SR_NONE_)) then r.ok = false : r.why = "a standard library variable"
        if r.ok = false then Todo_( x, disp, "variable: " & r.why ) : return
    end if
    dim as string sg = Sym_( x )
    if Excluded_( x, sg ) then Todo_( x, disp, "its C++ body does not compile" ) : return
    x.bind.Push( Indent_( x ) & "extern ""C"" : declare function " & tn & " alias """ & sg & """ ( )" & _
                 iif( r.byrefRet, " byref as ", " as " ) & r.tiko & " : end extern    '' " & disp )
    dim as string rt = iif( r.sret <> SR_NONE_, "tko_cpp_h*", r.ctype )
    dim as string pl = iif( r.sret <> SR_NONE_, "tko_cpp_h* ret_", "void" )
    dim as string f = "extern ""C"" " & rt & " " & sg & "(" & pl & ") {" & L
    if r.sret <> SR_NONE_ then f &= "    ret_->impl = nullptr; ret_->owned = 0;" & L
    f &= "    try { "
    if r.sret <> SR_NONE_ then
        f &= "ret_->impl = const_cast<void*>(static_cast<const void*>(&(" & disp & "))); return ret_;"
    else
        f &= "return " & r.wrap0 & disp & r.wrap1 & ";"
    end if
    f &= " } TKO_CPP_CATCH" & L & "    tko_cpp_raise();" & L & "    return " & iif( r.sret <> SR_NONE_, "ret_", r.fallback ) & ";" & L & "}" & L
    x.shim.Push( f )
    x.bound += 1
end sub

'' A STATIC DATA MEMBER (survey). An integer or bool constant clang evaluates ('static constexpr int
'' MAX_VERSION = 40') is a tiko const member: 'qrcodegen.QrCode.MAX_VERSION'. Anything else is a
'' static property through the shim -- a class-typed one a borrowed handle of the object itself
'' (QrSegment::Mode::NUMERIC), a non-const one with a setter.
sub StaticField_( byref x as CppImp_, byval ci as int32, byval c as CXCursor, byref lines as Tko.StrVec )
    dim as string L = chr( 10 ), why
    dim as string nm = Text_( x, x.api->getCursorSpelling( c ) )
    dim as string disp = x.clsCpp[ci] & "::" & nm
    dim as string tn = ValueName_( nm )
    dim as CXType t = x.api->getCursorType( c )
    dim as CXType ct = Canon_( x, t )
    dim as string owner = lcase( x.clsTikoQ[ci] & "." & tn )
    for i as int32 = 0 to x.sigs.Count - 1
        if (left( x.sigs[i], len( owner ) + 1 ) = owner & "(") orelse (left( x.sigs[i], len( owner ) + 2 ) = owner & "!(") then
            lines.Push( "'' CPP-TODO(a method has this name): " & disp ) : x.todos += 1
            return
        end if
    next
    dim as boolean konst = (x.api->isConstQualifiedType( t ) <> 0)
    dim as string cl = ConstOf_( x, c, tn )
    if len( cl ) then
        lines.Push( cl & "    '' " & disp )
        x.bound += 1
        return
    end if
    dim as TMap_ r
    if (ct.kind = TY_RECORD_) andalso (StrKind_( x, t ) = 0) then
        dim as int32 ri = ClassOf_( x, t, why )
        if ri < 0 then lines.Push( "'' CPP-TODO(" & why & "): " & disp ) : x.todos += 1 : return
        if IsPod_( x, ri ) then
            r.ok = true : r.tiko = x.clsTikoQ[ri] : r.byrefRet = true : r.ctype = x.clsCpp[ri] & "*"
            '' ...of a 'const T' field too (inja's 'const SourceLocation location'): tiko's const is the
            '' binding's to keep.
            r.wrap0 = "const_cast<" & x.clsCpp[ri] & "*>(&(" : r.wrap1 = "))" : r.fallback = "nullptr"
        else
            r.ok = true : r.tiko = x.clsTikoQ[ri] : r.ctype = "tko_cpp_h*" : r.sret = SR_REF_
        end if
    else
        r = Result_( x, t )
        if r.ok andalso ((r.vk1 <> 0) orelse (r.sret <> SR_NONE_)) then r.ok = false : r.why = "a standard library field"
        if r.ok = false then lines.Push( "'' CPP-TODO(static field: " & r.why & "): " & disp ) : x.todos += 1 : return
    end if
    dim as string obj = disp
    dim as string sg = Sym_( x )
    if Excluded_( x, sg ) then lines.Push( "'' CPP-TODO(its C++ body does not compile): " & disp ) : x.todos += 1 : return
    lines.Push( "declare static property " & tn & " alias """ & sg & """ ( )" & iif( r.byrefRet, " byref as ", " as " ) & r.tiko & "    '' " & disp )
    dim as string rt = iif( r.sret <> SR_NONE_, "tko_cpp_h*", r.ctype )
    dim as string pl = iif( r.sret <> SR_NONE_, "tko_cpp_h* ret_", "void" )
    dim as string f = "extern ""C"" " & rt & " " & sg & "(" & pl & ") __asm__(""@@M:" & sg & "@@"");" & L & _
                      "extern ""C"" " & rt & " " & sg & "(" & pl & ") {" & L
    if r.sret <> SR_NONE_ then f &= "    ret_->impl = nullptr; ret_->owned = 0;" & L
    f &= "    try { "
    if r.sret <> SR_NONE_ then
        f &= "ret_->impl = const_cast<void*>(static_cast<const void*>(&(" & obj & "))); return ret_;"
    else
        f &= "return " & r.wrap0 & obj & r.wrap1 & ";"
    end if
    f &= " } TKO_CPP_CATCH" & L & "    tko_cpp_raise();" & L & "    return " & iif( r.sret <> SR_NONE_, "ret_", r.fallback ) & ";" & L & "}" & L
    x.shim.Push( f )
    AltName_( x, c )
    x.mirBody.Push( "    static void " & sg & "();" )
    x.bound += 1
    if konst orelse r.byrefRet orelse (r.sret <> SR_NONE_) then return
    dim as TMap_ m = Param_( x, t, "v_" )
    if m.ok = false then return
    dim as string ss = Sym_( x )
    if Excluded_( x, ss ) then return
    lines.Push( "declare static property " & tn & " alias """ & ss & """ ( " & m.tiko & " )" )
    x.shim.Push( "extern ""C"" void " & ss & "(" & m.ctype & ") __asm__(""@@M:" & ss & "@@"");" & L & _
                 "extern ""C"" void " & ss & "(" & m.ctype & ") {" & L & _
                 "    try { if (tko_cpp_set(" & obj & ", " & m.arg & ")) return; tko_cpp_last() = ""this field cannot be assigned""; } TKO_CPP_CATCH" & L & _
                 "    tko_cpp_raise();" & L & "}" & L )
    x.mirBody.Push( "    static void " & ss & "(" & m.mir & ");" )
end sub

'' (owned -1: a temporary, which a copy of a class C++ only moves takes over -- 'dim as document doc =
'' result' with simdjson's move-only document.)
'' A CONVERSION OPERATOR TO A BOUND CLASS ri: 'operator cast' to an owned copy of the converted object (a
'' plain 16-byte aggregate, as Cast_ explains). An rvalue-qualified one converts the object as an rvalue.
sub ConvCast_( byref x as CppImp_, byval ci as int32, byval ri as int32, byval rv as boolean, byref lines as Tko.StrVec )
    dim as string L = chr( 10 ), sym = "cast:" & x.clsMir[ci] & ">" & x.clsMir[ri]
    for i as int32 = 0 to x.sigs.Count - 1
        if x.sigs[i] = lcase( sym ) then return            '' one per target class
    next
    x.sigs.Push( lcase( sym ) ) : x.sigConst.Push( "" )
    dim as string sx = Sym_( x )
    if Excluded_( x, sx ) then return
    lines.Push( "declare operator cast alias """ & sx & """ ( ) as " & x.clsTikoQ[ri] & "    '' C++'s conversion to " & x.clsCpp[ri] & " (a copy)" )
    dim as string obj = iif( rv, "std::move(*static_cast<" & x.clsCpp[ci] & "*>(self_->impl))", "*static_cast<" & x.clsCpp[ci] & "*>(self_->impl)" )
    dim as string h = "extern ""C"" tko_cpp_h " & sx & "(tko_cpp_h* self_)"
    x.shim.Push( h & " __asm__(""@@M:" & sym & "@@"");" & L & h & " {" & L & _
                 "    tko_cpp_h r = { nullptr, 0 };" & L & _
                 "    try { r.impl = new " & x.clsCpp[ri] & "(static_cast<" & x.clsCpp[ri] & ">(" & obj & ")); r.owned = -1; return r; } TKO_CPP_CATCH" & L & _
                 "    tko_cpp_raise();" & L & "    return r;" & L & "}" & L )
    x.mirBody.Push( "    operator ::" & x.clsMir[ri] & "();" )
    x.bound += 1
end sub

'' DOES CLASS CURSOR c PUBLICLY DERIVE FROM the class whose USR is 'usr', at any depth?
type Derives_
    as CppImp_ ptr x
    as string usr
    as int32 depth
    as boolean hit
end type

private function DerivesVisit_ cdecl ( byval c as CXCursor, byval parent as CXCursor, byval client as any ptr ) as int32
    dim as Derives_ ptr dv = client
    dim as CppImp_ ptr xp = dv->x
    if xp->api->getCursorKind( c ) <> CXCursor_CXXBaseSpecifier then return CXChildVisit_Continue
    if xp->api->getCXXAccessSpecifier( c ) <> CX_CXXPublic then return CXChildVisit_Continue
    dim as CXCursor bd = xp->api->getTypeDeclaration( Canon_( *xp, xp->api->getCursorType( c ) ) )
    if xp->api->isCursorDefinition( bd ) = 0 then bd = xp->api->getCursorDefinition( bd )
    if Text_( *xp, xp->api->getCursorUSR( bd ) ) = dv->usr then dv->hit = true : return CXChildVisit_Break
    if DerivesFrom_( *xp, bd, dv->usr, dv->depth + 1 ) then dv->hit = true : return CXChildVisit_Break
    return CXChildVisit_Continue
end function

function DerivesFrom_( byref x as CppImp_, byval c as CXCursor, byref usr as string, byval depth as int32 ) as boolean
    if depth > 8 then return false
    dim as Derives_ dv
    dv.x = @x : dv.usr = usr : dv.depth = depth
    x.api->visitChildren( c, @DerivesVisit_, @dv )
    return dv.hit
end function


type StrCtor_
    as CppImp_ ptr x
    as boolean found
end type

private function StrCtorVisit_ cdecl ( byval c as CXCursor, byval parent as CXCursor, byval client as any ptr ) as int32
    dim as StrCtor_ ptr s = client
    dim as CppImp_ ptr x = s->x
    if x->api->getCursorKind( c ) <> CXCursor_Constructor then return CXChildVisit_Continue
    if x->api->Cursor_getNumArguments( c ) <> 1 then return CXChildVisit_Continue
    if StrKind_( *x, x->api->getNonReferenceType( x->api->getCursorType( x->api->Cursor_getArgument( c, 0 ) ) ) ) > 0 then s->found = true : return CXChildVisit_Break
    return CXChildVisit_Continue
end function

'' A CLASS CONVERTING BOTH TO A STRING AND TO A BOUND CLASS V THAT IS BUILT FROM A STRING (survey:
'' simdjson's padded_string, to string_view and to padded_string_view, which has a constructor from
'' std::string): tiko's overloads, as fbc's (probe: a constructor taking a string beside the copy
'' constructor), prefer the string conversion -- so 'dim as V v = s' would build V from the string,
'' not by C++'s conversion to V (simdjson: the padding lost). The string conversion is left out; the
'' class conversion is the one C++ code relies on.
sub StrCastShadow_( byref x as CppImp_, byref lines as Tko.StrVec )
    dim as boolean conv = false
    for i as int32 = 0 to lines.Count - 1
        dim as int32 at = instr( lines[i], "'' C++'s conversion to " )
        if at = 0 then continue for
        dim as string cn = mid( lines[i], at + 23 )
        cn = left( cn, instr( cn, " (a copy)" ) - 1 )
        for ri as int32 = 0 to x.clsCpp.Count - 1
            if x.clsCpp[ri] <> cn then continue for
            dim as StrCtor_ s
            s.x = @x
            dim as CXCursor dc = x.api->getCursorDefinition( x.clsCur[ri] )
            x.api->visitChildren( iif( IsNullCursor_( x, dc ), x.clsCur[ri], dc ), @StrCtorVisit_, @s )
            if s.found then conv = true
            exit for
        next
        if conv then exit for
    next
    if conv = false then return
    for i as int32 = 0 to lines.Count - 1
        dim as string s = lines[i]
        if (left( ltrim( s ), 29 ) = "declare operator cast alias """) andalso (instr( s, """ ( ) as ustring" ) > 0) then
            dim as int32 at = instr( s, "'' " )
            lines[i] = "'' not bound (a conversion to a string would take precedence over the conversion to a class): " & iif( at > 0, mid( s, at + 3 ), s )
        end if
    next
end sub

end namespace
