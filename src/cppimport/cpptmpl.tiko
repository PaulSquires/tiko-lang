'' cpptmpl.tiko -- the C++ importer's templates (C3b-2, D8, D9). See cppint.ti.
''
'' A CLASS TEMPLATE IS BOUND WHERE IT IS INSTANTIATED. Every specialization the header's own bound
'' API names -- 'Box<double> make( )', a member 'Pair<int, std::string> p' -- is a class like any
'' other, named 'Box_double' (D9) in its template's namespace; one nothing names is asked for with
'' '#cppinstantiate "geo::Box<int>"' (D8). A function template is bound only when asked for:
'' '#cppinstantiate "geo::clamp<int>"' is an overload of 'geo.clamp'.
''
'' AN IMPLICIT SPECIALIZATION A DECLARATION NAMES IS NOT INSTANTIATED: 'Box<double> make( );' does
'' not need the class complete, so clang has no members for it. The run parses again with
'' 'static_assert(sizeof(::geo::Box<double>) > 0)' after the header, which instantiates the class
'' (its member declarations, not their bodies), and does so until nothing new is named.

#import "std/containers"
#include once "cppimport/cppint.ti"

namespace Tko.CppImport

using Tko.CImport

function IsNullCursor_( byref x as CppImp_, byval c as CXCursor ) as boolean
    dim as int32 k = x.api->getCursorKind( c )
    return (k >= 70) andalso (k <= 73)           '' CXCursor_FirstInvalid .. LastInvalid
end function

'' Inside namespace std (or one of its inline namespaces)?
'' Is template cursor tm std::pair?
function IsStdPair_( byref x as CppImp_, byval tm as CXCursor ) as boolean
    if IsNullCursor_( x, tm ) then return false
    return (Text_( x, x.api->getCursorSpelling( tm ) ) = "pair") andalso InStd_( x, tm )
end function

function InStd_( byref x as CppImp_, byval c as CXCursor ) as boolean
    dim as int32 guard = 0
    c = x.api->getCursorSemanticParent( c )
    while (x.api->getCursorKind( c ) <> CXCursor_TranslationUnit) andalso (guard < 16)
        if (x.api->getCursorKind( c ) = CXCursor_Namespace) andalso (Text_( x, x.api->getCursorSpelling( c ) ) = "std") then return true
        c = x.api->getCursorSemanticParent( c )
        guard += 1
    wend
    return false
end function

'' A std class template the importer knows by name -- "vector", "unique_ptr", "shared_ptr" --
'' for a record type that is a specialization of it, else "".
function StdTemplate_( byref x as CppImp_, byval t as CXType ) as string
    dim as CXType c = Canon_( x, t )
    if c.kind <> TY_RECORD_ then return ""
    dim as CXCursor tm = x.api->getSpecializedCursorTemplate( x.api->getTypeDeclaration( c ) )
    if IsNullCursor_( x, tm ) orelse (InStd_( x, tm ) = false) then return ""
    dim as string nm = Text_( x, x.api->getCursorSpelling( tm ) )
    select case nm
    case "vector", "unique_ptr", "shared_ptr", "optional", "array", "map", "unordered_map", "function", "list", "deque" : return nm
    end select
    return ""
end function

'' A template argument as part of a tiko name: 'double', 'long', 'ustring', 'Point', 'Box_long'.
private function ArgName_( byref x as CppImp_, byval t as CXType ) as string
    dim as CXType c = Canon_( x, t )
    dim as string tk, ct, tq, cq, mq, why
    '' 'iter_impl<const basic_json>' is not 'iter_impl<basic_json>': iter_impl_const_json.
    if x.api->isConstQualifiedType( c ) <> 0 then return "const_" & ArgName_( x, x.api->getUnqualifiedType( c ) )
    if StrKind_( x, c ) > 0 then return "ustring"
    select case c.kind
    case TY_POINTER_ : return ArgName_( x, x.api->getPointeeType( c ) ) & "ptr"
    case TY_ENUM_
        if EnumOf_( x, c, tq, cq, mq ) then return mid( tq, instrrev( tq, "." ) + 1 )
    case TY_RECORD_
        dim as CXCursor d = x.api->getTypeDeclaration( c )
        dim as Tko.StrVec ans
        dim as string an = AliasOf_( x, d, ans )
        if len( an ) then return an
        if IsNullCursor_( x, x.api->getSpecializedCursorTemplate( d ) ) = false then return SpecName_( x, c )
        return TypeName_( Text_( x, x.api->getCursorSpelling( d ) ) )
    end select
    if Fund_( x, c, tk, ct ) then return tk
    dim as string s = Spell_( x, c ), r = ""
    for i as int32 = 0 to len( s ) - 1
        if ((s[i] >= 48) andalso (s[i] <= 57)) orelse ((s[i] >= 65) andalso (s[i] <= 90)) orelse _
           ((s[i] >= 97) andalso (s[i] <= 122)) then r &= chr( s[i] )
    next
    return r
end function

'' 'Box<double>' -> 'Box_double', 'Pair<int, std::string>' -> 'Pair_long_ustring', 'Arr<int, 3>' ->
'' 'Arr_long_3' (D9).
private function PrivateArgs_( byref x as CppImp_, byval t as CXType, byval depth as int32 ) as boolean
    if depth > 6 then return false
    dim as CXType c = Canon_( x, t )
    while (c.kind = TY_POINTER_) orelse (c.kind = TY_LREF_) orelse (c.kind = TY_RREF_)
        c = Canon_( x, x.api->getPointeeType( c ) )
    wend
    if c.kind <> TY_RECORD_ then return false
    dim as CXCursor d = x.api->getTypeDeclaration( c )
    dim as int32 acc = x.api->getCXXAccessSpecifier( d )
    if (acc = 3) orelse (acc = 2) then return true          '' CX_CXXPrivate, CX_CXXProtected
    dim as int32 n = x.api->Type_getNumTemplateArguments( c )
    for i as int32 = 0 to n - 1
        dim as CXType a = x.api->Type_getTemplateArgumentAsType( c, i )
        if (a.kind <> 0) andalso PrivateArgs_( x, a, depth + 1 ) then return true
    next
    '' ...OR ITS ENCLOSING CLASS'S: robin_hash<..., KeySelect>::robin_iterator names KeySelect too.
    dim as CXCursor par = x.api->getCursorSemanticParent( d )
    dim as int32 pk = x.api->getCursorKind( par )
    if (pk = CXCursor_ClassDecl) orelse (pk = CXCursor_StructDecl) orelse (pk = CXCursor_ClassTemplate) then
        if PrivateArgs_( x, x.api->getCursorType( par ), depth + 1 ) then return true
    end if
    return false
end function

function SpecName_( byref x as CppImp_, byval t as CXType ) as string
    dim as CXType c = Canon_( x, t )
    dim as CXCursor d = x.api->getTypeDeclaration( c )
    dim as CXCursor tm = x.api->getSpecializedCursorTemplate( d )
    dim as string r = Text_( x, x.api->getCursorSpelling( tm ) )
    dim as int32 n = x.api->Type_getNumTemplateArguments( c )
    for i as int32 = 0 to n - 1
        dim as CXType at_ = x.api->Type_getTemplateArgumentAsType( c, i )
        '' A POLICY ARGUMENT ends the name, and every argument after it (survey: robin_map, phmap,
        '' std::vector's allocator): 'tsl::robin_map<std::string, int>' is robin_map_ustring_long, not
        '' robin_map_ustring_long_hash_ustring_equal_to_ustring_allocator_... -- the defaults a C++
        '' user does not write. A hash, an equality, an ordering, an allocator, traits, a deleter.
        if (i > 0) andalso (Canon_( x, at_ ).kind = TY_RECORD_) then
            dim as CXCursor ad = x.api->getTypeDeclaration( Canon_( x, at_ ) )
            dim as CXCursor atm = x.api->getSpecializedCursorTemplate( ad )
            dim as string pn = lcase( Text_( x, x.api->getCursorSpelling( iif( IsNullCursor_( x, atm ), ad, atm ) ) ) )
            if (instr( pn, "hash" ) > 0) orelse (instr( pn, "equal" ) > 0) orelse (instr( pn, "eq" ) = len( pn ) - 1) orelse _
               (pn = "less") orelse (pn = "greater") orelse (instr( pn, "compare" ) > 0) orelse (instr( pn, "alloc" ) > 0) orelse _
               (instr( pn, "traits" ) > 0) orelse (instr( pn, "delete" ) > 0) then exit for
        end if
        if at_.kind <> 0 then
            r &= "_" & ArgName_( x, at_ )
        else
            dim as int64 v = x.api->Cursor_getTemplateArgumentValue( d, i )
            r &= "_" & iif( v < 0, "m" & str( -v ), str( v ) )
        end if
    next
    return r
end function

'' THE NAMESPACES a declaration is in, tiko-spelled, outermost first. False for one nested in a
'' class: a specialization of a member template is not bound.
function NsOf_( byref x as CppImp_, byval c as CXCursor, byref ns as Tko.StrVec, byval throughClasses as boolean = false ) as boolean
    dim as Tko.StrVec rev
    dim as int32 guard = 0
    c = x.api->getCursorSemanticParent( c )
    while (x.api->getCursorKind( c ) <> CXCursor_TranslationUnit) andalso (guard < 16)
        dim as int32 k = x.api->getCursorKind( c )
        if k = CXCursor_Namespace then
            '' AN ANONYMOUS NAMESPACE's names are internal to their unit: nothing in one is bound.
            if len( Text_( x, x.api->getCursorSpelling( c ) ) ) = 0 then return false
            if x.api->Cursor_isInlineNamespace( c ) = 0 then rev.Push( NsName_( Text_( x, x.api->getCursorSpelling( c ) ) ) )
        elseif (k = CXCursor_ClassDecl) orelse (k = CXCursor_StructDecl) orelse (k = CXCursor_ClassTemplate) orelse _
               (k = 32) then                         '' ClassTemplatePartialSpecialization
            '' A SPECIALIZATION NESTED IN A CLASS (survey: robin_hash<...>::robin_iterator<false>, a map's
            '' iterator) is bound in the namespace around it, when asked: flat, 'robin_iterator_0'.
            if throughClasses = false then return false
        elseif k <> CXCursor_LinkageSpec then
            return false
        end if
        c = x.api->getCursorSemanticParent( c )
        guard += 1
    wend
    for i as int32 = rev.Count - 1 to 0 step -1
        ns.Push( rev[i] )
    next
    return true
end function

'' A TYPE THE BOUND API NAMES, looked into for specializations to bind: through pointers and
'' references, into std::vector / unique_ptr / shared_ptr's element. One that is not complete is
'' asked to be (CppImp_.needForce) and bound on the next parse.
sub NoteType_( byref x as CppImp_, byval t as CXType )
    dim as CXType c = Canon_( x, t )
    select case c.kind
    case TY_POINTER_, TY_LREF_, TY_RREF_
        NoteType_( x, x.api->getPointeeType( c ) )
        return
    case TY_RECORD_
    case else
        return
    end select
    if StrKind_( x, c ) > 0 then return
    if len( StdTemplate_( x, c ) ) then
        NoteType_( x, x.api->Type_getTemplateArgumentAsType( c, 0 ) )
        return
    end if
    dim as CXCursor d = x.api->getTypeDeclaration( c )
    dim as CXCursor tm = x.api->getSpecializedCursorTemplate( d )
    '' std::pair IS BOUND LIKE A LIBRARY'S TEMPLATE (survey: robin_map's and phmap's 'for each kv', 'kv.first',
    '' insert's 'r.second'): std.pair_ustring_long, its first and second properties (StdPairCtor_).
    if IsNullCursor_( x, tm ) then return
    if (InStd_( x, tm ) orelse (InScope_( x, tm ) = false)) andalso (IsStdPair_( x, tm ) = false) then return
    '' An anonymous struct or union (one in a class template, reached through it) has no name to bind by.
    if (instr( Text_( x, x.api->getCursorSpelling( d ) ), "(" ) > 0) orelse (x.api->getCursorKind( d ) = CXCursor_UnionDecl) then return
    '' THE TEMPLATE'S DEFINITION, whose members are the pattern's: the cursor can be a forward
    '' declaration (json's 'template<...> class basic_json;', json_fwd), which has none.
    dim as CXCursor tdef = x.api->getCursorDefinition( tm )
    if IsNullCursor_( x, tdef ) = false then tm = tdef
    dim as string usr = Text_( x, x.api->getCursorUSR( d ) )
    for i as int32 = 0 to x.clsUsr.Count - 1
        if x.clsUsr[i] = usr then return
    next
    '' ONE WHOSE ARGUMENTS NAME A PRIVATE CLASS (survey: robin_map's KeySelect) cannot be spelled in the
    '' shim: an internal, not bound -- what names it is a CPP-TODO.
    if PrivateArgs_( x, c, 0 ) then
        if x.noAccess = false then return
        x.usedNoAccess = true
    end if
    '' Its C++ name, unqualified: the pointee of 'const Box<double>&' spells its 'const'.
    dim as string sp = Spell_( x, c )
    while (left( sp, 6 ) = "const ") orelse (left( sp, 9 ) = "volatile ")
        sp = mid( sp, instr( sp, " " ) + 1 )
    wend
    sp = "::" & sp
    if x.api->Type_getSizeOf( c ) < 0 then
        for i as int32 = 0 to x.needForce.Count - 1
            if x.needForce[i] = sp then return
        next
        x.needForce.Push( sp )
        return
    end if
    dim as Tko.StrVec ns
    dim as string tn = AliasOf_( x, d, ns )         '' its alias's name and namespace, if one names it
    if len( tn ) = 0 then
        if NsOf_( x, d, ns, true ) = false then return
        tn = TypeName_( SpecName_( x, c ) )
        '' A LONG ONE IS CUT, with a hash of the whole to keep it one class's: tiko holds 128
        '' characters of a name, and nanoflann's spelled every defaulted argument and allocator.
        if len( tn ) > 100 then tn = left( tn, 88 ) & "_" & Id_( tn )
    end if
    dim as int32 n0 = x.clsUsr.Count
    CollectAt_( x, d, tn, sp, ns, tm, true )
    '' ITS NESTED ENUMS (survey: mustache's basic_data<std::string>::type), from the pattern.
    if (x.clsUsr.Count > n0) andalso (IsStdPair_( x, tm ) = false) then CollectNested_( x, tm, n0, true )
end sub

'' A FUNCTION'S TYPES, for NoteType_.
sub NoteFunction_( byref x as CppImp_, byval c as CXCursor )
    NoteType_( x, x.api->getCursorResultType( c ) )
    for i as int32 = 0 to x.api->Cursor_getNumArguments( c ) - 1
        NoteType_( x, x.api->getCursorType( x.api->Cursor_getArgument( c, i ) ) )
    next
end sub

'' '#cppinstantiate's targets in the parsed unit: 'using tko_cpp_inst_<i> = ...;' names a class,
'' 'auto* const tko_cpp_fn_<i> = &...;' a function. Found by name among the unit's own cursors.
type InstFind_
    as CppImp_ ptr x
    as string want
    as CXCursor found
    as boolean ok
end type

private function RefVisit_ cdecl ( byval c as CXCursor, byval parent as CXCursor, byval client as any ptr ) as int32
    dim as InstFind_ ptr f = client
    if f->x->api->getCursorKind( c ) = 101 then           '' CXCursor_DeclRefExpr
        f->found = f->x->api->getCursorReferenced( c )
        f->ok = true
        return CXChildVisit_Break
    end if
    return CXChildVisit_Recurse
end function

private function TopVisit_ cdecl ( byval c as CXCursor, byval parent as CXCursor, byval client as any ptr ) as int32
    dim as InstFind_ ptr f = client
    if Text_( *f->x, f->x->api->getCursorSpelling( c ) ) <> f->want then return CXChildVisit_Continue
    dim as int32 k = f->x->api->getCursorKind( c )
    if (k = CXCursor_TypeAliasDecl) orelse (k = 20) then  '' 20: CXCursor_TypedefDecl
        f->found = c
        f->ok = true
        return CXChildVisit_Break
    end if
    if k = CXCursor_VarDecl then
        f->x->api->visitChildren( c, @RefVisit_, f )
        return CXChildVisit_Break
    end if
    return CXChildVisit_Continue
end function

'' The class type a 'tko_cpp_inst_<i>' alias names, or a kind-0 type.
function InstClass_( byref x as CppImp_, byval i as int32 ) as CXType
    dim as InstFind_ f
    f.x = @x
    f.want = "tko_cpp_inst_" & i
    x.api->visitChildren( x.api->getTranslationUnitCursor( x.tu ), @TopVisit_, @f )
    dim as CXType none_
    if f.ok = false then return none_
    return Canon_( x, x.api->getTypedefDeclUnderlyingType( f.found ) )
end function

'' The function a 'tko_cpp_fn_<i>' pointer takes the address of; false when there is none.
function InstFunction_( byref x as CppImp_, byval i as int32, byref fn as CXCursor ) as boolean
    dim as InstFind_ f
    f.x = @x
    f.want = "tko_cpp_fn_" & i
    x.api->visitChildren( x.api->getTranslationUnitCursor( x.tu ), @TopVisit_, @f )
    if f.ok = false then return false
    if x.api->getCursorKind( f.found ) <> CXCursor_FunctionDecl then return false
    fn = f.found
    return true
end function

'' ---------------------------------------------------------------- the members of a specialization

'' A SPECIALIZATION HAS NO MEMBERS libclang will show: its cursor visitor walks an explicit
'' specialization's body and nothing of an instantiation's, implicit or explicit. So its MEMBERS
'' are the pattern's -- the class template's own -- and their TYPES are instantiated by clang
'' through a PROBE: a template with the class template's own parameter list, in its namespace,
'' holding each member's type as a function type spelled as the pattern spells it,
''
''     namespace tpl { template <class T> struct tko_cpp_p_1a2b3c4d { using m3 = T(const Box<T> &); }; }
''     namespace tko_cpp_probe { using p_1a2b3c4d_m3 = ::tpl::tko_cpp_p_1a2b3c4d<double>::m3; }
''
'' and read back on the next parse as 'double(const tpl::Box<double> &)'. A member whose type
'' clang cannot spell there -- a class-scope typedef -- is an error in that probe line alone, which
'' the parse forgives, and that member is a CPP-TODO. Its FIELDS are the instantiation's own,
'' which clang_Type_visitFields does walk.

function SpecPattern_( byref x as CppImp_, byval ci as int32 ) as CXCursor
    return x.clsTmpl[ci]
end function

function IsSpec_( byref x as CppImp_, byval ci as int32 ) as boolean
    if (ci < 0) orelse (ci >= x.clsSpec.Count) then return false
    return x.clsSpec[ci] = "1"
end function

'' The cursor whose children are the class's members: the pattern for a specialization.
function MemberRoot_( byref x as CppImp_, byval ci as int32 ) as CXCursor
    if IsSpec_( x, ci ) then return x.clsTmpl[ci]
    return x.clsCur[ci]
end function

type TParams_
    as CppImp_ ptr x
    as string text
    as string names
    as boolean ok
end type

'' A TEMPLATE PARAMETER AS CLANG PRINTS IT, without its default: 'class T', 'length_t L',
'' 'template <typename U, typename V, typename ...Args> class ObjectType', 'class ...Ts'. Printed, not
'' read from the source: json declares basic_json's parameters through a macro, whose tokens are
'' the macro's definition.
private function TParamVisit_ cdecl ( byval c as CXCursor, byval parent as CXCursor, byval client as any ptr ) as int32
    dim as TParams_ ptr tp = client
    dim as CppImp_ ptr xp = tp->x
    dim as int32 k = xp->api->getCursorKind( c )
    if (k < 27) orelse (k > 29) then return CXChildVisit_Continue
    dim as string nm = Text_( *xp, xp->api->getCursorSpelling( c ) )
    if len( nm ) = 0 then tp->ok = false : return CXChildVisit_Continue       '' an unnamed one: later
    dim as string pp = Text_( *xp, xp->api->getCursorPrettyPrinted( c, nullptr ) ), tx = ""
    dim as int32 depth = 0, tail = 1
    for i as int32 = 1 to len( pp )
        dim as string ch = mid( pp, i, 1 )
        if (ch = "<") orelse (ch = "(") then depth += 1
        if (ch = ">") orelse (ch = ")") then depth -= 1 : if depth = 0 then tail = i + 1
        if (ch = "=") andalso (depth = 0) then exit for
        tx &= ch
    next
    tx = trim( tx )
    tp->text &= iif( len( tp->text ), ", ", "" ) & tx
    '' A PACK names itself with '...' in the pattern -- a template template parameter's own
    '' parameters do not make it one, so only what follows them counts.
    tp->names &= iif( len( tp->names ), ", ", "" ) & nm & iif( instr( mid( tx, tail ), "..." ) > 0, "...", "" )
    return CXChildVisit_Continue
end function

'' THE PROBE LINES for specialization ci, appended to 'out_'. False when its template cannot be
'' probed (a template template parameter, a parameter pack).
'' A PATTERN MEMBER'S TYPE AS THE PROBE CAN SPELL IT: a typedef of the class -- glm's 'col_type',
'' 'length_type' -- is out of the probe's reach, so it is spelled as what it names.
private function SpellPattern_( byref x as CppImp_, byval t as CXType ) as string
    dim as boolean kq = (x.api->isConstQualifiedType( t ) <> 0)
    select case t.kind
    case TY_LREF_, TY_RREF_, TY_POINTER_
        dim as string r = SpellPattern_( x, x.api->getPointeeType( t ) ) & iif( t.kind = TY_LREF_, " &", iif( t.kind = TY_RREF_, " &&", " *" ) )
        return r & iif( kq, " const", "" )
    case 107, TY_ELABORATED_                         '' CXType_Typedef, Elaborated
        dim as CXCursor d = x.api->getTypeDeclaration( t )
        dim as int32 dk = x.api->getCursorKind( d )
        '' A PUBLIC ONE is declared again in the probe (ProbeLines_) and keeps its name -- json's
        '' 'iterator' spelled out is 'iter_impl<...>', a name of nlohmann::detail the probe cannot see.
        if ((dk = 20) orelse (dk = CXCursor_TypeAliasDecl)) andalso (x.api->getCXXAccessSpecifier( d ) <> CX_CXXPublic) then
            select case x.api->getCursorKind( x.api->getCursorSemanticParent( d ) )
            case CXCursor_ClassTemplate, 32, CXCursor_StructDecl, CXCursor_ClassDecl
                return iif( kq, "const ", "" ) & SpellPattern_( x, x.api->getTypedefDeclUnderlyingType( d ) )
            end select
        end if
    end select
    return Spell_( x, t )
end function

private function TypedefVisit_ cdecl ( byval c as CXCursor, byval parent as CXCursor, byval client as any ptr ) as int32
    dim as TParams_ ptr tp = client
    dim as int32 k = tp->x->api->getCursorKind( c )
    if ((k = 20) orelse (k = CXCursor_TypeAliasDecl)) andalso (tp->x->api->getCXXAccessSpecifier( c ) = CX_CXXPublic) then
        tp->text &= chr( 1 ) & Text_( *tp->x, tp->x->api->getCursorSpelling( c ) )
    elseif ((k = CXCursor_EnumDecl) orelse (k = CXCursor_ClassDecl) orelse (k = CXCursor_StructDecl)) andalso _
           (tp->x->api->getCXXAccessSpecifier( c ) = CX_CXXPublic) andalso _
           (len( Text_( *tp->x, tp->x->api->getCursorSpelling( c ) ) ) > 0) andalso _
           (instr( Text_( *tp->x, tp->x->api->getCursorSpelling( c ) ), "(" ) = 0) then
        '' A NESTED ENUM OR CLASS, named in the probe as in the class (survey: mustache's basic_data(type)).
        tp->text &= chr( 1 ) & Text_( *tp->x, tp->x->api->getCursorSpelling( c ) )
    elseif k = 601 then                    '' CXCursor_TypeAliasTemplateDecl
        '' AN ALIAS TEMPLATE, of any access, as clang prints it: 'typename pattern::X' cannot name
        '' a template, and json's items( ) returns its private 'iteration_proxy<iterator>'.
        dim as string pp = Text_( *tp->x, tp->x->api->getCursorPrettyPrinted( c, nullptr ) )
        for i as int32 = 1 to len( pp )
            if (mid( pp, i, 1 ) = chr( 10 )) orelse (mid( pp, i, 1 ) = chr( 13 )) then mid( pp, i, 1 ) = " "
        next
        tp->text &= chr( 1 ) & chr( 3 ) & pp
    end if
    return CXChildVisit_Continue
end function

function ProbeLines_( byref x as CppImp_, byval ci as int32, byref out_ as Tko.StrVec, byref keys as Tko.StrVec ) as boolean
    dim as CXCursor tm = x.clsTmpl[ci]
    dim as TParams_ tp
    tp.x = @x
    tp.ok = true
    x.api->visitChildren( tm, @TParamVisit_, @tp )
    if (tp.ok = false) orelse (len( tp.text ) = 0) then return false
    dim as Tko.StrVec ns
    if NsOf_( x, tm, ns ) = false then return false
    dim as string cpp = x.clsCpp[ci]
    '' THE PROBE IS A PARTIAL SPECIALIZATION over the pattern -- 'Box<T>', or a partial
    '' specialization's own 'vec<3, T, Q>' -- instantiated with the whole type, so C++ deduces the
    '' parameters: glm's vec<3, float> is an instance of vec<3, T, Q>, whose members say T and Q.
    dim as string pattern = Text_( x, x.api->getCursorDisplayName( tm ) )
    if x.api->getCursorKind( tm ) <> 32 then pattern = Text_( x, x.api->getCursorSpelling( tm ) ) & "<" & tp.names & ">"
    dim as string pid = Id_( cpp ), nsq = "", open_ = "", close_ = ""
    for i as int32 = 0 to ns.Count - 1
        nsq &= "::" & ns[i] : open_ &= "namespace " & ns[i] & " { " : close_ &= " }"
    next
    '' The pattern's members, in Gather_'s order: the probes are numbered as ClassLines_ reads them.
    dim as containers.Array( of CXCursor ) mem
    dim as containers.Array( of int32 ) kinds
    SpecMembers_( x, ci, mem, kinds )
    dim as string body = "", uses = ""
    for j as int32 = 0 to mem.Count - 1
        if (kinds[j] = K_FIELD_) orelse (kinds[j] = K_SFIELD_) then continue for
        dim as CXCursor m = mem[j]
        if x.api->Cursor_isVariadic( m ) <> 0 then continue for
        dim as string r = "void"
        if x.api->getCursorKind( m ) <> CXCursor_Constructor then r = SpellPattern_( x, x.api->getCursorResultType( m ) )
        dim as string ps = ""
        for a as int32 = 0 to x.api->Cursor_getNumArguments( m ) - 1
            ps &= iif( a > 0, ", ", "" ) & SpellPattern_( x, x.api->getCursorType( x.api->Cursor_getArgument( m, a ) ) )
        next
        body &= chr( 1 ) & "using m" & j & " = " & r & "(" & ps & ");" & chr( 2 ) & "p_" & pid & "_m" & j
        uses &= " using p_" & pid & "_m" & j & " = " & nsq & "::tko_cpp_p_" & pid & "< " & cpp & " >::m" & j & ";"
    next
    '' ONE MEMBER A LINE, its probe's name beside it in 'keys': an error clang reports on that line
    '' marks that member unknown -- its recovered type (an 'int' for a name it could not find) is
    '' never read.
    out_.Push( open_ & "template <class> struct tko_cpp_p_" & pid & "; template <" & tp.text & "> struct tko_cpp_p_" & pid & _
               "<" & pattern & "> {" ) : keys.Push( "" )
    '' THE CLASS'S OWN TYPEDEFS, declared again in the probe, so the pattern's spellings resolve there
    '' as in the class: json's 'typename object_t::key_type', 'iterator', 'size_type'.
    dim as TParams_ td
    td.x = @x
    x.api->visitChildren( tm, @TypedefVisit_, @td )
    dim as int32 ta = 1
    while ta <= len( td.text )
        dim as int32 tb = instr( ta + 1, td.text, chr( 1 ) )
        if tb = 0 then tb = len( td.text ) + 1
        dim as string tdn = mid( td.text, ta + 1, tb - ta - 1 )
        if left( tdn, 1 ) = chr( 3 ) then
            out_.Push( "    " & mid( tdn, 2 ) & ";" ) : keys.Push( "" )
        else
            out_.Push( "    using " & tdn & " = typename " & pattern & "::" & tdn & ";" ) : keys.Push( "" )
        end if
        ta = tb
    wend
    dim as int32 a = 1
    while a <= len( body )
        dim as int32 b = instr( a + 1, body, chr( 1 ) )
        if b = 0 then b = len( body ) + 1
        dim as string part = mid( body, a + 1, b - a - 1 )
        out_.Push( "    " & left( part, instr( part, chr( 2 ) ) - 1 ) ) : keys.Push( mid( part, instr( part, chr( 2 ) ) + 1 ) )
        a = b
    wend
    out_.Push( "};" & close_ ) : keys.Push( "" )
    out_.Push( "namespace tko_cpp_probe {" & uses & " }" ) : keys.Push( "" )
    return true
end function

private function ProbeVisit_ cdecl ( byval c as CXCursor, byval parent as CXCursor, byval client as any ptr ) as int32
    dim as CppImp_ ptr xp = client
    if xp->api->getCursorKind( c ) = CXCursor_TypeAliasDecl then
        xp->probeNames.Push( Text_( *xp, xp->api->getCursorSpelling( c ) ) )
        '' NOT CANONICAL: the instantiated function type keeps 'std::size_t' as written, which
        '' tiko spells uinteger; its canonical form is 'unsigned long long'.
        xp->probeTypes.Push( xp->api->getTypedefDeclUnderlyingType( c ) )
    end if
    return CXChildVisit_Continue
end function

private function ProbeNsVisit_ cdecl ( byval c as CXCursor, byval parent as CXCursor, byval client as any ptr ) as int32
    dim as CppImp_ ptr xp = client
    if (xp->api->getCursorKind( c ) = CXCursor_Namespace) andalso _
       (Text_( *xp, xp->api->getCursorSpelling( c ) ) = "tko_cpp_probe") then xp->api->visitChildren( c, @ProbeVisit_, xp )
    return CXChildVisit_Continue
end function

'' Every probe this parse resolved, by name.
sub LoadProbes_( byref x as CppImp_ )
    x.probeNames.Clear( )
    x.probeTypes.Clear( )
    x.api->visitChildren( x.api->getTranslationUnitCursor( x.tu ), @ProbeNsVisit_, @x )
end sub

'' MEMBER j's instantiated function type, as the overriding types Entry_ reads; false when it
'' was not probed or clang could not instantiate it.
function ProbeOverride_( byref x as CppImp_, byval ci as int32, byval j as int32 ) as boolean
    x.ovrOn = false
    dim as string want = "p_" & Id_( x.clsCpp[ci] ) & "_m" & j
    for i as int32 = 0 to x.badProbes.Count - 1
        if x.badProbes[i] = want then return false
    next
    for i as int32 = 0 to x.probeNames.Count - 1
        if x.probeNames[i] = want then
            dim as CXType ft = x.probeTypes[i]
            dim as int32 fk = Canon_( x, ft ).kind
            if (fk <> 111) andalso (fk <> 110) then return false             '' FunctionProto / NoProto
            x.ovrArgs.Clear( )
            for a as int32 = 0 to x.api->getNumArgTypes( ft ) - 1
                x.ovrArgs.Push( x.api->getArgType( ft, a ) )
            next
            x.ovrRes = x.api->getResultType( ft )
            x.ovrOn = true
            return true
        end if
    next
    return false
end function

private function SpecFieldVisit_ cdecl ( byval c as CXCursor, byval client as any ptr ) as int32
    dim as containers.Array( of CXCursor ) ptr out_ = client
    out_->Push( c )
    return 1                         '' CXVisit_Continue
end function

'' A specialization's own fields, instantiated, every access.
sub SpecFields_( byref x as CppImp_, byval ci as int32, byref out_ as containers.Array( of CXCursor ) )
    x.api->Type_visitFields( x.api->getCursorType( x.clsCur[ci] ), @SpecFieldVisit_, @out_ )
end sub

'' ---------------------------------------------------------------- aliases (D13)

'' A SPECIALIZATION AN ALIAS NAMES -- 'using json = basic_json<>;', 'typedef vec<3, float, defaultp>
'' vec3;' -- takes the alias's name and namespace, the name the library's users write; the shortest
'' when several name it (glm's vec3 beside highp_vec3). Recorded in pass 2, used when the
'' specialization is bound.
sub AliasNote_( byref x as CppImp_, byval c as CXCursor )
    dim as CXCursor par = x.api->getCursorSemanticParent( c )
    dim as int32 pk = x.api->getCursorKind( par )
    if (pk <> CXCursor_Namespace) andalso (pk <> CXCursor_TranslationUnit) then return
    dim as CXType ut = Canon_( x, x.api->getTypedefDeclUnderlyingType( c ) )
    if ut.kind <> TY_RECORD_ then return
    dim as CXCursor d = x.api->getTypeDeclaration( ut )
    dim as CXCursor tm = x.api->getSpecializedCursorTemplate( d )
    if IsNullCursor_( x, tm ) orelse InStd_( x, tm ) orelse (InScope_( x, tm ) = false) then return
    dim as Tko.StrVec ns
    if NsOf_( x, c, ns ) = false then return
    dim as string nm = TypeName_( Text_( x, x.api->getCursorSpelling( c ) ) )
    dim as string usr = Text_( x, x.api->getCursorUSR( d ) ), nsj = "", cq = ""
    for i as int32 = 0 to ns.Count - 1
        nsj &= iif( i > 0, chr( 1 ), "" ) & ns[i]
    next
    cq = mid( QualCpp_( x, Text_( x, x.api->getCursorSpelling( c ) ) ), 3 )
    x.alCpp.Push( cq )                     '' every alias, for a call shape's class (ShapeKind_)
    for i as int32 = 0 to x.alUsr.Count - 1
        if x.alUsr[i] = usr then
            if len( nm ) < len( x.alName[i] ) then x.alName[i] = nm : x.alNs[i] = nsj
            return
        end if
    next
    x.alUsr.Push( usr ) : x.alName.Push( nm ) : x.alNs.Push( nsj )
end sub

'' The alias name of a specialization's declaration, or "" -- and its namespaces in 'ns'.
function AliasOf_( byref x as CppImp_, byval d as CXCursor, byref ns as Tko.StrVec ) as string
    dim as string usr = Text_( x, x.api->getCursorUSR( d ) )
    for i as int32 = 0 to x.alUsr.Count - 1
        if x.alUsr[i] = usr then
            dim as string nsj = x.alNs[i]
            dim as int32 a = 1
            while a <= len( nsj )
                dim as int32 b = instr( a, nsj, chr( 1 ) )
                if b = 0 then b = len( nsj ) + 1
                ns.Push( mid( nsj, a, b - a ) )
                a = b + 1
            wend
            return x.alName[i]
        end if
    next
    return ""
end function

'' ---------------------------------------------------------------- call shapes (D12)

'' '#cppinstantiate "glm::dot(glm::vec3, glm::vec3)"' -- A CALL WITH ARGUMENT TYPES: clang picks
'' what C++ would call with arguments of those types, which binds it -- a function template
'' deduced, a constructor template ('nlohmann::json(int)'), a member one
'' ('nlohmann::json::get<int>()', 'nlohmann::json::parse(std::string)'), an operator
'' ('glm::operator+(glm::vec3, glm::vec3)'). The call goes into the unit as the operand of a
'' sizeof over 'std::declval' arguments, in a namespace of its own, and the function it calls is
'' read back from there.

'' 'callee(a, b)' -> callee, the argument types; false when it is not a call shape.
function ShapeSplit_( byref s as string, byref callee as string, byref args as Tko.StrVec ) as boolean
    dim as int32 depth = 0, open_ = 0
    for i as int32 = 1 to len( s )
        dim as string ch = mid( s, i, 1 )
        if ch = "<" then depth += 1
        if ch = ">" then depth -= 1
        '' 'operator()' names the call operator: its '()' is no argument list.
        if (ch = "(") andalso (mid( s, i, 2 ) = "()") andalso (right( rtrim( left( s, i - 1 ) ), 8 ) = "operator") then i += 1 : continue for
        if (ch = "(") andalso (depth = 0) then open_ = i : exit for
    next
    if (open_ = 0) orelse (right( trim( s ), 1 ) <> ")") then return false
    callee = trim( left( s, open_ - 1 ) )
    if left( callee, 2 ) = "::" then callee = mid( callee, 3 )
    dim as string inner = mid( trim( s ), open_ + 1, len( trim( s ) ) - open_ - 1 ), cur = ""
    depth = 0
    for i as int32 = 1 to len( inner )
        dim as string ch = mid( inner, i, 1 )
        if (ch = "<") orelse (ch = "(") then depth += 1
        if (ch = ">") orelse (ch = ")") then depth -= 1
        if (ch = ",") andalso (depth = 0) then
            args.Push( trim( cur ) ) : cur = ""
        else
            cur &= ch
        end if
    next
    if len( trim( cur ) ) then args.Push( trim( cur ) )
    return true
end function

'' The last '::' outside template arguments: 'nlohmann::json::get<int>' -> 'nlohmann::json' / 'get<int>'.
private sub LastSeg_( byref q as string, byref pre as string, byref seg as string )
    dim as int32 depth = 0, at_ = 0
    for i as int32 = 1 to len( q ) - 1
        dim as string ch = mid( q, i, 1 )
        if ch = "<" then depth += 1
        if ch = ">" then depth -= 1
        if (depth = 0) andalso (mid( q, i, 2 ) = "::") then at_ = i
    next
    if at_ = 0 then pre = "" : seg = q : return
    pre = left( q, at_ - 1 ) : seg = mid( q, at_ + 2 )
end sub

'' Is 'q' a class of this header: an alias of one, a class, a class template's specialization?
private function IsClassName_( byref x as CppImp_, byref q as string ) as boolean
    if len( q ) = 0 then return false
    for i as int32 = 0 to x.alCpp.Count - 1
        if x.alCpp[i] = q then return true
    next
    for i as int32 = 0 to x.clsCpp.Count - 1
        if x.clsCpp[i] = "::" & q then return true
    next
    '' A TEMPLATE-ID ENDS THE NAME: 'bx::Box<int>' is a class, 'bx::Box<int>::get' is not (survey).
    dim as int32 lt = instr( q, "<" )
    if lt > 0 then
        dim as int32 depth = 0, close_ = 0
        for i as int32 = lt to len( q )
            if mid( q, i, 1 ) = "<" then depth += 1
            if mid( q, i, 1 ) = ">" then depth -= 1 : if depth = 0 then close_ = i : exit for
        next
        if close_ <> len( q ) then return false
    end if
    dim as string b = q
    if instr( b, "<" ) > 0 then b = trim( left( b, instr( b, "<" ) - 1 ) )
    for i as int32 = 0 to x.tmplNames.Count - 1
        if (x.tmplNames[i] = b) andalso (x.tmplKinds[i] = "c") andalso (b <> q) then return true
    next
    return false
end function

'' "SC" a constructor, "SM" a member, "SO" an operator, "SF" a function -- or "" not a shape.
function ShapeKind_( byref x as CppImp_, byref s as string ) as string
    dim as string callee, pre, seg
    dim as Tko.StrVec args
    if ShapeSplit_( s, callee, args ) = false then return ""
    LastSeg_( callee, pre, seg )
    '' A MEMBER OPERATOR is a member: 'rapidjson::Value::operator[](const char*)'.
    if left( seg, 8 ) = "operator" then return iif( IsClassName_( x, pre ), "SM", "SO" )
    if IsClassName_( x, callee ) then return "SC"
    if IsClassName_( x, pre ) then return "SM"
    return "SF"
end function

'' The unit's line for shape i: the call, over 'std::declval' arguments, in its own namespace.
function ShapeLine_( byref s as string, byref kind as string, byval i as int32 ) as string
    dim as string callee, pre, seg, e
    dim as Tko.StrVec args
    ShapeSplit_( s, callee, args )
    LastSeg_( callee, pre, seg )
    '' AN ARGUMENT IS A 'const A&' unless a reference was written: a forwarding parameter then deduces
    '' 'const A&' (json's 'basic_json(CompatibleType&&)'), which tiko passes 'byref ... const'. Written
    '' 'A const&', so a pointer is one too: 'const char* const&', not 'const const char*&'.
    dim as string av = ""
    for j as int32 = 0 to args.Count - 1
        '' ...and a declarator type -- 'void (*)(int)', a callback (survey: sigslot's connect) -- through
        '' add_const: 'void (*)(int) const&' is no type.
        if (right( args[j], 1 ) <> "&") andalso (instr( args[j], "(" ) > 0) then
            args[j] = "std::add_lvalue_reference_t<std::add_const_t<" & args[j] & ">>"
        elseif right( args[j], 1 ) <> "&" then
            args[j] = args[j] & " const&"
        end if
        av &= iif( j > 0, ", ", "" ) & "std::declval<" & args[j] & ">()"
    next
    select case kind
    case "SM"
        e = "std::declval<::" & pre & "&>()." & iif( (instr( seg, "<" ) > 0) andalso (left( seg, 8 ) <> "operator"), "template ", "" ) & seg & "(" & av & ")"
    case "SO"
        dim as string op = trim( mid( seg, 9 ) )
        dim as string d0 = "", d1 = ""
        if args.Count > 0 then d0 = "std::declval<" & args[0] & ">()"
        if args.Count > 1 then d1 = "std::declval<" & args[1] & ">()"
        dim as string a0 = iif( args.Count > 0, args[0], "" )
        if left( a0, 6 ) = "const " then a0 = mid( a0, 7 )            '' the left of '[]' and '+=' is changed
        if right( a0, 7 ) = " const&" then a0 = left( a0, len( a0 ) - 7 )
        if right( a0, 1 ) = "&" then a0 = left( a0, len( a0 ) - 1 )
        if op = "[]" then
            e = "std::declval<" & a0 & "&>()[" & d1 & "]"
        elseif (args.Count = 2) andalso (right( op, 1 ) = "=") andalso (op <> "==") andalso (op <> "!=") andalso (op <> "<=") andalso (op <> ">=") then
            e = "std::declval<" & a0 & "&>() " & op & " " & d1
        elseif args.Count = 2 then
            e = "(" & d0 & ") " & op & " (" & d1 & ")"
        else
            e = op & "(" & d0 & ")"
        end if
    case else
        e = "::" & callee & "(" & av & ")"
    end select
    '' THE CLASS THE SHAPE NAMES, for a constructor or member: 'rapidjson::Document::Accept(...)' is
    '' GenericValue's member, called -- and bound -- through Document.
    dim as string cls = ""
    if kind = "SC" then cls = " using tko_cpp_cls = ::" & callee & ";"
    if kind = "SM" then cls = " using tko_cpp_cls = ::" & pre & ";"
    return "namespace tko_cpp_shape_" & i & " {" & cls & " static_assert(sizeof((void)(" & e & "), 0) > 0, ""tiko: instantiate""); }"
end function

type ShapeFind_
    as CppImp_ ptr x
    as string want
    as CXCursor found
    as boolean ok
end type

private function ShapeCallVisit_ cdecl ( byval c as CXCursor, byval parent as CXCursor, byval client as any ptr ) as int32
    dim as ShapeFind_ ptr f = client
    if f->x->api->getCursorKind( c ) = 103 then              '' CXCursor_CallExpr: calls, operators, constructions
        dim as CXCursor r = f->x->api->getCursorReferenced( c )
        if (IsNullCursor_( *f->x, r ) = false) andalso (Text_( *f->x, f->x->api->getCursorSpelling( r ) ) <> "declval") then
            f->found = r : f->ok = true
            return CXChildVisit_Break
        end if
    end if
    return CXChildVisit_Recurse
end function

private function ShapeNsVisit_ cdecl ( byval c as CXCursor, byval parent as CXCursor, byval client as any ptr ) as int32
    dim as ShapeFind_ ptr f = client
    if (f->x->api->getCursorKind( c ) = CXCursor_Namespace) andalso (Text_( *f->x, f->x->api->getCursorSpelling( c ) ) = f->want) then
        f->x->api->visitChildren( c, @ShapeCallVisit_, f )
        return CXChildVisit_Break
    end if
    return CXChildVisit_Continue
end function

private function ShapeClsVisit_ cdecl ( byval c as CXCursor, byval parent as CXCursor, byval client as any ptr ) as int32
    dim as ShapeFind_ ptr f = client
    if (f->x->api->getCursorKind( c ) = CXCursor_TypeAliasDecl) andalso (Text_( *f->x, f->x->api->getCursorSpelling( c ) ) = "tko_cpp_cls") then
        f->found = c : f->ok = true
        return CXChildVisit_Break
    end if
    return CXChildVisit_Continue
end function

private function ShapeClsNsVisit_ cdecl ( byval c as CXCursor, byval parent as CXCursor, byval client as any ptr ) as int32
    dim as ShapeFind_ ptr f = client
    if (f->x->api->getCursorKind( c ) = CXCursor_Namespace) andalso (Text_( *f->x, f->x->api->getCursorSpelling( c ) ) = f->want) then
        f->x->api->visitChildren( c, @ShapeClsVisit_, f )
        return CXChildVisit_Break
    end if
    return CXChildVisit_Continue
end function

'' The class shape i names (SC, SM), or a kind-0 type.
function ShapeClass_( byref x as CppImp_, byval i as int32 ) as CXType
    dim as ShapeFind_ f
    f.x = @x
    f.want = "tko_cpp_shape_" & i
    x.api->visitChildren( x.api->getTranslationUnitCursor( x.tu ), @ShapeClsNsVisit_, @f )
    dim as CXType none_
    if f.ok = false then return none_
    return Canon_( x, x.api->getTypedefDeclUnderlyingType( f.found ) )
end function

'' What shape i calls: a function, a method, a constructor. False when clang found nothing.
function ShapeTarget_( byref x as CppImp_, byval i as int32, byref fn as CXCursor ) as boolean
    dim as ShapeFind_ f
    f.x = @x
    f.want = "tko_cpp_shape_" & i
    x.api->visitChildren( x.api->getTranslationUnitCursor( x.tu ), @ShapeNsVisit_, @f )
    if f.ok = false then return false
    select case x.api->getCursorKind( f.found )
    case CXCursor_FunctionDecl, CXCursor_CXXMethod, CXCursor_Constructor, CXCursor_ConversionFunction
        fn = f.found
        return true
    end select
    return false
end function

'' THE TEMPLATE ARGUMENTS A CALL SHAPE WROTE on its callee's last name: '<int>' of
'' 'nlohmann::json::get<int>()', "" of 'glm::dot(glm::vec3, glm::vec3)'.
function ShapeTargs_( byref s as string ) as string
    dim as string callee, pre, seg
    dim as Tko.StrVec args
    if ShapeSplit_( s, callee, args ) = false then return ""
    LastSeg_( callee, pre, seg )
    if instr( seg, "<" ) = 0 then return ""
    return mid( seg, instr( seg, "<" ) )
end function

'' EXPLICIT TEMPLATE ARGUMENTS AS PART OF A tiko NAME: '<int>' -> '_long', '<std::string>' ->
'' '_ustring' -- json's 'get<int>( )' and 'get<double>( )' differ only so, and tiko cannot overload on
'' a result: they are get_long( ) and get_double( ).
function TargsName_( byref targs as string ) as string
    dim as string inner = mid( targs, 2, len( targs ) - 2 ), r = "", cur = ""
    inner &= ","
    for i as int32 = 1 to len( inner )
        dim as string ch = mid( inner, i, 1 )
        if ch <> "," then cur &= ch : continue for
        dim as string t = trim( cur ), n = ""
        cur = ""
        select case t
        case "int", "signed", "signed int" : n = "long"
        case "unsigned", "unsigned int" : n = "ulong"
        case "long long", "int64_t", "std::int64_t" : n = "longint"
        case "unsigned long long", "uint64_t", "std::uint64_t" : n = "ulongint"
        case "short" : n = "short"
        case "char", "signed char" : n = "byte"
        case "unsigned char" : n = "ubyte"
        case "float" : n = "single"
        case "double" : n = "double"
        case "bool" : n = "boolean"
        case "std::size_t", "size_t" : n = "uinteger"
        case "std::string", "std::basic_string<char>", "std::string_view" : n = "ustring"
        case else
            '' A CHARACTER ARGUMENT, argparse's scan<'i', int>: the letter, or its code.
            if (len( t ) = 3) andalso (left( t, 1 ) = "'") andalso (right( t, 1 ) = "'") then
                dim as string ch = mid( t, 2, 1 )
                if instr( "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789", ch ) > 0 then
                    t = ch
                else
                    t = "c" & asc( ch )
                end if
            end if
            for j as int32 = len( t ) to 1 step -1
                dim as string c = mid( t, j, 1 )
                if (c = ":") orelse (c = " ") orelse (c = "<") orelse (c = ">") orelse (c = "*") orelse (c = "&") then exit for
                n = c & n
            next
        end select
        r &= "_" & n
    next
    return r
end function

'' A FUNCTION TEMPLATE SPECIALIZATION's arguments as C++ writes them -- '<const std::string &>' --
'' for a call that names them: '->template get<int>( )'. "" when there are none, or one is not a
'' type or an integer (a pack: the call deduces it).
function TemplateArgs_( byref x as CppImp_, byval c as CXCursor ) as string
    dim as int32 n = x.api->Cursor_getNumTemplateArguments( c )
    if n <= 0 then return ""
    dim as string r = ""
    for i as int32 = 0 to n - 1
        select case x.api->Cursor_getTemplateArgumentKind( c, i )
        case 1 : r &= iif( i > 0, ", ", "" ) & Spell_( x, x.api->Cursor_getTemplateArgumentType( c, i ) )
        case 4 : r &= iif( i > 0, ", ", "" ) & str( x.api->Cursor_getTemplateArgumentValue( c, i ) )
        case else : return ""
        end select
    next
    return "<" & r & ">"
end function

'' The same arguments as part of a tiko name: 'get' + '<int>' -> 'get_long'.
function TemplateArgsName_( byref x as CppImp_, byval c as CXCursor ) as string
    dim as int32 n = x.api->Cursor_getNumTemplateArguments( c )
    dim as string r = ""
    for i as int32 = 0 to n - 1
        select case x.api->Cursor_getTemplateArgumentKind( c, i )
        case 1 : r &= "_" & ArgName_( x, x.api->Cursor_getTemplateArgumentType( c, i ) )
        case 4 : r &= "_" & str( x.api->Cursor_getTemplateArgumentValue( c, i ) )
        end select
    next
    return r
end function

end namespace
