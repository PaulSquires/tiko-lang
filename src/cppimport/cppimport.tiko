'' cppimport.tiko -- see cppimport.ti. docs/tiko-cpp C3 (C3-plan.md, C3.md).

#import "std/containers"
#include once "cppimport/cppint.ti"

namespace Tko.CppImport

using Tko.CImport


function Indent_( byref x as CppImp_ ) as string
    return space( 4 * x.cppNs.Count )
end function

function Text_( byref x as CppImp_, byval s as CXString ) as string
    return ClangText( *x.api, s )
end function

function Fwd_( byref p as string ) as string
    dim as string r = p
    for i as int32 = 0 to len( r ) - 1
        if r[i] = asc( "\" ) then r[i] = asc( "/" )
    next
    return r
end function

'' Is the declaration in the header's own directory tree? The library's headers are; the
'' standard library's and the platform's are not, and nothing of theirs is bound.
function InScope_( byref x as CppImp_, byval c as CXCursor ) as boolean
    dim as any ptr f = nullptr
    dim as uint32 ln, col, off
    x.api->getExpansionLocation( x.api->getCursorLocation( c ), @f, @ln, @col, @off )
    if f = nullptr then return false
    dim as string p = Fwd_( Text_( x, x.api->getFileName( f ) ) )
    if x.foldCase then p = lcase( p )
    return left( p, len( x.hdrDir ) ) = x.hdrDir
end function

function QualTiko_( byref x as CppImp_, byref nm as string ) as string
    dim as string r = ""
    for i as int32 = 0 to x.tikoNs.Count - 1
        r &= x.tikoNs[i] & "."
    next
    return r & nm
end function

function QualCpp_( byref x as CppImp_, byref nm as string ) as string
    dim as string r = ""
    for i as int32 = 0 to x.cppNs.Count - 1
        r &= "::" & x.cppNs[i]
    next
    return r & "::" & nm
end function

'' THE MIRROR'S SPELLING OF A NAME tiko mangles. Measured (docs/tiko-cpp C3.md): a namespace outside
'' an 'extern' block and an enum are upper-cased, a type declared in 'extern "C"' keeps its case.
function QualMir_( byref x as CppImp_, byref nm as string ) as string
    dim as string r = ""
    for i as int32 = 0 to x.tikoNs.Count - 1
        r &= ucase( x.tikoNs[i] ) & "::"
    next
    return r & nm
end function

'' 'namespace A { namespace B { <body> } }', the mirror's way of putting something where it is.
function MirWrap_( byref nsList as string, byref body as string ) as string
    dim as string o = "", c = ""
    dim as int32 a = 1
    while a <= len( nsList )
        dim as int32 b = instr( a, nsList, chr( 1 ) )
        if b = 0 then b = len( nsList ) + 1
        o &= "namespace " & mid( nsList, a, b - a ) & " { "
        c &= " }"
        a = b + 1
    wend
    return o & body & c & chr( 10 )
end function

sub Todo_( byref x as CppImp_, byref what as string, byref why as string )
    x.bind.Push( Indent_( x ) & "'' CPP-TODO(" & why & "): " & what )
    x.todos += 1
end sub

'' ---------------------------------------------------------------- names

'' A C++ name as a tiko name: a keyword or a name the runtime holds takes a trailing '_'
'' (EXAMPLES.md: 'swap' is 'swap_'); the shim's alias keeps the real one where it matters.
function ValueName_( byref nm as string ) as string
    if NameReservedValue( nm ) then return nm & "_"
    return nm
end function

function TypeName_( byref nm as string ) as string
    if NameReservedType( nm ) then return nm & "_"
    return nm
end function

'' A TYPE NAMED LIKE A tiko KEYWORD ('Point': POINT) is a keyword token, which keeps no written
'' spelling, so tiko mangles it upper-cased (measured: GEO::POINT::...) -- and the mirror must too.
function MirName_( byref tn as string ) as string
    select case ucase( tn )
    #define KW( k_name, k_spell, k_class ) case k_spell : return ucase( tn )
    TKO_KEYWORD_LIST( KW )
    #undef KW
    end select
    return tn
end function

'' A parameter's name, clear of the shim's own (self_, ret_, o_).
function ParamName_( byref x as CppImp_, byval a as CXCursor, byval i as int32 ) as string
    dim as string pn = NameParam( Text_( x, x.api->getCursorSpelling( a ) ) )
    if len( pn ) = 0 then pn = "p" & i
    if (pn = "self_") orelse (pn = "ret_") orelse (pn = "o_") then pn &= "p"
    return pn
end function

'' ---------------------------------------------------------------- enums

type EnumBody_
    as CppImp_ ptr x
    as boolean unsigned_
    as Tko.StrVec lines
end type

private function EnumConst_ cdecl _
    ( byval c as CXCursor, byval parent as CXCursor, byval client as any ptr ) as int32
    dim as EnumBody_ ptr eb = client
    dim as CppImp_ ptr xp = eb->x
    if xp->api->getCursorKind( c ) = CXCursor_EnumConstantDecl then
        dim as string v
        if eb->unsigned_ then
            v = str( xp->api->getEnumConstantDeclUnsignedValue( c ) )
        else
            v = str( xp->api->getEnumConstantDeclValue( c ) )
        end if
        eb->lines.Push( ValueName_( Text_( *xp, xp->api->getCursorSpelling( c ) ) ) & " = " & v )
    end if
    return CXChildVisit_Continue
end function

'' An ENUM is a tiko enum of the same name -- 'explicit' (members qualified) when the C++ one
'' is scoped. It crosses the shim as a 'long long', since a tiko enum is eight bytes.
sub Enum_( byref x as CppImp_, byval c as CXCursor )
    if x.api->isCursorDefinition( c ) = 0 then return
    dim as string nm = Text_( x, x.api->getCursorSpelling( c ) )
    if (len( nm ) = 0) orelse (instr( nm, "(" ) > 0) then return     '' anonymous
    dim as EnumBody_ eb
    eb.x = @x
    select case Canon_( x, x.api->getEnumDeclIntegerType( c ) ).kind
    case TY_CHAR_U_, TY_UCHAR_, TY_USHORT_, TY_UINT_, TY_ULONG_, TY_ULONGLONG_
        eb.unsigned_ = true
    end select
    x.api->visitChildren( c, @EnumConst_, @eb )
    if eb.lines.Count = 0 then return
    dim as string tn = TypeName_( nm )
    dim as string ind = Indent_( x )
    x.bind.Push( ind & "enum " & tn & iif( x.api->EnumDecl_isScoped( c ) <> 0, " explicit", "" ) )
    for i as int32 = 0 to eb.lines.Count - 1
        x.bind.Push( ind & "    " & eb.lines[i] )
    next
    x.bind.Push( ind & "end enum" )
    x.enumUsr.Push( Text_( x, x.api->getCursorUSR( c ) ) )
    x.enumTiko.Push( QualTiko_( x, tn ) )
    x.enumCpp.Push( QualCpp_( x, nm ) )
    x.enumMir.Push( QualMir_( x, ucase( tn ) ) )
    dim as string ns = ""
    for i as int32 = 0 to x.tikoNs.Count - 1
        if i > 0 then ns &= chr( 1 )
        ns &= ucase( x.tikoNs[i] )
    next
    x.mirFwd.Push( MirWrap_( ns, "enum " & ucase( tn ) & " : long long {};" ) )
end sub

'' ---------------------------------------------------------------- the walk

private function Visit_ cdecl _
    ( byval c as CXCursor, byval parent as CXCursor, byval client as any ptr ) as int32
    dim as CppImp_ ptr xp = client
    dim as int32 k = xp->api->getCursorKind( c )
    if (k = CXCursor_Namespace) orelse (k = CXCursor_LinkageSpec) then
        '' A namespace is walked wherever it is declared: 'std' from a system header holds
        '' nothing in scope, and costs one look at each of its members.
        if k = CXCursor_LinkageSpec then
            xp->api->visitChildren( c, @Visit_, client )
            return CXChildVisit_Continue
        end if
        dim as string nm = Text_( *xp, xp->api->getCursorSpelling( c ) )
        if len( nm ) = 0 then return CXChildVisit_Continue       '' anonymous: internal linkage
        '' A library's own specialisations in 'std' (pugixml's iterator traits) are not its API.
        if (xp->cppNs.Count = 0) andalso (nm = "std") then return CXChildVisit_Continue
        if InScope_( *xp, c ) = false then return CXChildVisit_Continue
        '' AN INLINE NAMESPACE IS ITS PARENT'S (json's 'nlohmann::json_abi_v3_11_3'): C++ names
        '' its members through the parent, and so does tiko.
        if xp->api->Cursor_isInlineNamespace( c ) <> 0 then
            xp->api->visitChildren( c, @Visit_, client )
            return CXChildVisit_Continue
        end if
        dim as int32 mark = xp->bind.Count
        xp->bind.Push( Indent_( *xp ) & "namespace " & TypeName_( nm ) )
        xp->cppNs.Push( nm )
        xp->tikoNs.Push( TypeName_( nm ) )
        xp->api->visitChildren( c, @Visit_, client )
        xp->cppNs.Pop( )
        xp->tikoNs.Pop( )
        if xp->bind.Count = mark + 1 then
            xp->bind.Pop( )
        else
            xp->bind.Push( Indent_( *xp ) & "end namespace" )
        end if
        return CXChildVisit_Continue
    end if
    if InScope_( *xp, c ) = false then return CXChildVisit_Continue
    select case k
    case CXCursor_EnumDecl
        if xp->pass = 1 then Enum_( *xp, c )
    case CXCursor_ClassDecl, CXCursor_StructDecl
        if xp->pass = 2 then CollectClass_( *xp, c )
    case CXCursor_UnionDecl
        if (xp->pass = 3) andalso (xp->api->isCursorDefinition( c ) <> 0) then
            Todo_( *xp, QualCpp_( *xp, Text_( *xp, xp->api->getCursorSpelling( c ) ) ), "union" )
        end if
    case CXCursor_FunctionDecl
        if xp->pass = 3 then Function_( *xp, c )
        if xp->pass = 4 then NoteFunction_( *xp, c )
    case 20, CXCursor_TypeAliasDecl                     '' typedef / using: an alias (D13)
        if xp->pass = 2 then AliasNote_( *xp, c )
    case CXCursor_FunctionTemplate, CXCursor_ClassTemplate
        '' A TEMPLATE is bound where it is instantiated (cpptmpl.tiko): recorded by name, and a
        '' CPP-TODO only when nothing instantiated it.
        dim as string q = QualCpp_( *xp, Text_( *xp, xp->api->getCursorSpelling( c ) ) )
        if xp->pass = 2 then
            xp->tmplNames.Push( mid( q, 3 ) )
            xp->tmplKinds.Push( iif( k = CXCursor_ClassTemplate, "c", "f" ) )
        elseif xp->pass = 3 then
            dim as boolean used = false
            for i as int32 = 0 to xp->instBases.Count - 1
                if xp->instBases[i] = mid( q, 3 ) then used = true
            next
            for i as int32 = 0 to xp->clsCpp.Count - 1
                if left( xp->clsCpp[i], len( q ) + 1 ) = q & "<" then used = true
            next
            if used = false then
                Todo_( *xp, q, iif( k = CXCursor_ClassTemplate, "class template nothing here instantiates", _
                                    "function template" ) & ": #cppinstantiate it" )
            end if
        end if
    end select
    return CXChildVisit_Continue
end function

'' ---------------------------------------------------------------- the mirror

type MirNames_
    as ClangApi ptr api
    as int32 mop
    as Tko.StrVec keys
    as Tko.StrVec names
end type

private function MirVisit_ cdecl _
    ( byval c as CXCursor, byval parent as CXCursor, byval client as any ptr ) as int32
    dim as MirNames_ ptr mn = client
    dim as int32 k = mn->api->getCursorKind( c )
    if (k = CXCursor_CXXMethod) orelse (k = CXCursor_ConversionFunction) then
        dim as string s = ClangText( *mn->api, mn->api->getCursorSpelling( c ) )
        if s = "operator=" then
            s = "let:" & MirQual_( mn->api, mn->api->getCursorSemanticParent( c ) )
        elseif k = CXCursor_ConversionFunction then
            dim as CXType crt = mn->api->getCanonicalType( mn->api->getCursorResultType( c ) )
            if crt.kind = 105 then       '' a record: a cast to a base, named by both classes
                dim as CXCursor td = mn->api->getTypeDeclaration( crt )
                s = "cast:" & MirQual_( mn->api, mn->api->getCursorSemanticParent( c ) ) & ">" & MirQual_( mn->api, td )
            else
                s = "mop" & mn->mop : mn->mop += 1
            end if
        elseif left( s, 8 ) = "operator" then
            '' A MEMBER OPERATOR, by its place: the mirror writes them in the order the shim
            '' numbered them (Entry_), and clang visits them in that order.
            s = "mop" & mn->mop : mn->mop += 1
        end if
        mn->keys.Push( s )
        mn->names.Push( ClangText( *mn->api, mn->api->Cursor_getMangling( c ) ) )
    end if
    return CXChildVisit_Recurse
end function

'' The mirror, parsed for the target's Itanium triple -- windows-x86_64 included, whose
'' 'extern "C++"' names tiko writes as x86_64-w64-windows-gnu's (C1) -- and every "@@M:key@@"
'' in the shim replaced by the name clang gives that member. False when the mirror does not parse
'' or names something it should not.
function ResolveMirror_( byref api as ClangApi, byref triple as string, byref mir as string, _
                                 byref shim as string, byref res as CppImportResult ) as boolean
    dim as string mt = triple
    if instr( mt, "windows-msvc" ) > 0 then mt = "x86_64-w64-windows-gnu"
    dim as Tko.StrVec av
    av.Push( "-x" ) : av.Push( "c++" ) : av.Push( "-std=c++17" ) : av.Push( "--target=" & mt )
    av.Push( "-nostdinc" )
    dim as zstring ptr argv( 0 to av.Count )
    for i as int32 = 0 to av.Count - 1
        argv( i ) = strptr( av[i] )
    next
    dim as string unitName = MIRROR_NAME_
    dim as CXUnsavedFile uf
    uf.Filename = strptr( unitName )
    uf.Contents = strptr( mir )
    uf.Length = len( mir )
    dim as any ptr idx = api.createIndex( 0, 0 )
    dim as any ptr tu = api.parseTranslationUnit( idx, strptr( unitName ), @argv( 0 ), av.Count, @uf, 1, 0 )
    if tu = nullptr then
        api.disposeIndex( idx )
        res.why = "clang could not parse the mirror"
        return false
    end if
    dim as int32 nerr = 0
    for i as int32 = 0 to api.getNumDiagnostics( tu ) - 1
        dim as any ptr d = api.getDiagnostic( tu, i )
        if api.getDiagnosticSeverity( d ) >= 3 then
            nerr += 1
            if res.clangDiags.Count < 10 then res.clangDiags.Push( "mirror: " & ClangText( api, api.formatDiagnostic( d, 3 ) ) )
        end if
        api.disposeDiagnostic( d )
    next
    dim as MirNames_ mn
    mn.api = @api
    if nerr = 0 then api.visitChildren( api.getTranslationUnitCursor( tu ), @MirVisit_, @mn )
    api.disposeTranslationUnit( tu )
    api.disposeIndex( idx )
    if nerr > 0 then res.why = "internal: the mirror has " & nerr & " error(s)" : return false

    for i as int32 = 0 to mn.keys.Count - 1
        dim as string ph = "@@M:" & mn.keys[i] & "@@"
        dim as int32 at = instr( shim, ph )
        while at > 0
            shim = left( shim, at - 1 ) & mn.names[i] & mid( shim, at + len( ph ) )
            at = instr( at, shim, ph )
        wend
    next
    dim as int32 left_ = instr( shim, "@@M:" )
    if left_ > 0 then
        res.why = "internal: the mirror named no symbol for " & mid( shim, left_, instr( left_ + 4, shim, "@@" ) - left_ + 2 )
        return false
    end if
    return true
end function

'' ---------------------------------------------------------------- the texts

'' FNV-1a over the header's spelling: the shim's names are 'tko_cpp_<this>_<n>', so two
'' headers' shims linked into one program do not collide.
function Id_( byref s as string ) as string
    dim as uint32 h = 2166136261u
    for i as int32 = 0 to len( s ) - 1
        h = (h xor s[i]) * 16777619u
    next
    return lcase( hex( h, 8 ) )
end function

'' The shim's prelude: tiko-rt's ustring and error entry points, declared by hand from their
'' tiko definitions (lib/rt/src/ustr, lib/rt/src/err/throw.tiko), and the helpers every entry
'' uses. 'inline' (one copy per program) where state is shared: the last exception's text is
'' one per thread whichever shim threw it, and cpp.What( ) reads it.
function Prelude_( ) as string
    dim as string L = chr( 10 )
    return _
    "// ---- tiko C++ shim prelude (tiko -cppimport) ----" & L & _
    "#include <cstddef>" & L & "#include <cstdint>" & L & "#include <cstdio>" & L & "#include <cstring>" & L & _
    "#include <exception>" & L & "#include <memory>" & L & "#include <new>" & L & "#include <stdexcept>" & L & "#include <string>" & L & _
    "#include <string_view>" & L & "#include <type_traits>" & L & "#include <utility>" & L & _
    "#ifndef TKO_CPP_PRELUDE" & L & "#define TKO_CPP_PRELUDE" & L & _
    "// A binding binds the deprecated members too; calling them is not this shim's warning to give." & L & _
    "#pragma GCC diagnostic ignored ""-Wdeprecated-declarations""" & L & _
    "// A POD returned from an 'extern ""C""' shim function is a C++ type there, and trivially copyable:" & L & _
    "// its C layout and ABI are the C++ ones, which is what tiko calls it with." & L & _
    "#ifdef __clang__" & L & "#pragma clang diagnostic ignored ""-Wreturn-type-c-linkage""" & L & "#endif" & L & _
    "extern ""C"" {" & L & _
    "struct tko_cpp_ustr { std::uint16_t* data; std::intptr_t len; std::intptr_t size; };" & L & _
    "// A handle: the binding's type with 'impl_ as any ptr' and 'owned_ as longint'." & L & _
    "struct tko_cpp_h { void* impl; long long owned; };" & L & _
    "static tko_cpp_h* tko_cpp_slot() { thread_local tko_cpp_h ring[64]; thread_local unsigned n = 0; return &ring[n++ & 63]; }" & L & _
    "std::intptr_t fb_hUtf8ToUtf16(const std::uint8_t* src, std::intptr_t src_bytes, std::uint16_t* dst, std::intptr_t dst_units);" & L & _
    "std::intptr_t fb_hUtf16ToUtf8(const std::uint16_t* src, std::intptr_t src_units, std::uint8_t* dst, std::intptr_t dst_bytes);" & L & _
    "tko_cpp_ustr* fb_hUStrAlloc(tko_cpp_ustr* s, std::intptr_t units);" & L & _
    "tko_cpp_ustr* fb_UStrAllocTempResult(tko_cpp_ustr* src);" & L & _
    "void* fb_ErrorThrowMsg(int err_num, int line_num, const char* mod_name, const char* msg, void* res_label, void* resnext_label);" & L & _
    "}" & L & _
    "// A ustring's UTF-16 as UTF-8. The sign bit of len is the temporary flag." & L & _
    "static inline std::string tko_cpp_to_std(const tko_cpp_ustr* s) {" & L & _
    "    if (!s || !s->data) return std::string();" & L & _
    "    std::intptr_t n = s->len & INTPTR_MAX;" & L & _
    "    std::intptr_t b = fb_hUtf16ToUtf8(s->data, n, nullptr, 0);" & L & _
    "    std::string r((std::size_t)b, '\0');" & L & _
    "    if (b > 0) fb_hUtf16ToUtf8(s->data, n, (std::uint8_t*)&r[0], b);" & L & _
    "    return r;" & L & "}" & L & _
    "// UTF-8 as a ustring RESULT: a temporary descriptor, which is what a tiko function returning" & L & _
    "// ustring hands its caller (measured: the caller fb_UStrInit's from it)." & L & _
    "static inline tko_cpp_ustr* tko_cpp_from_utf8(const char* p, std::size_t b) {" & L & _
    "    tko_cpp_ustr t = { nullptr, 0, 0 };" & L & _
    "    std::intptr_t n = (p && b) ? fb_hUtf8ToUtf16((const std::uint8_t*)p, (std::intptr_t)b, nullptr, 0) : 0;" & L & _
    "    if (n > 0 && fb_hUStrAlloc(&t, n)) {" & L & _
    "        fb_hUtf8ToUtf16((const std::uint8_t*)p, (std::intptr_t)b, t.data, n);" & L & _
    "        t.len = n;" & L & "    }" & L & _
    "    return fb_UStrAllocTempResult(&t);" & L & "}" & L & _
    "template <class S> static inline tko_cpp_ustr* tko_cpp_from(const S& s) { return tko_cpp_from_utf8(s.data(), s.size()); }" & L & _
    "inline std::string& tko_cpp_last() { static thread_local std::string s; return s; }" & L & _
    "#define TKO_CPP_CATCH catch (const std::exception& e) { tko_cpp_last() = e.what(); } catch (...) { tko_cpp_last() = ""unknown C++ exception""; }" & L & _
    "// Raised AFTER the catch has ended, so no C++ object of the shim's is alive: a runtime error" & L & _
    "// with the text, which jumps to an armed ON ERROR handler or ends the program (D5)." & L & _
    "inline void tko_cpp_raise() {" & L & _
    "    static thread_local char buf[1024];" & L & _
    "    std::snprintf(buf, sizeof buf, ""C++ exception: %s"", tko_cpp_last().c_str());" & L & _
    "    fb_ErrorThrowMsg(" & ERR_CPP_ & ", -1, nullptr, buf, nullptr, nullptr);" & L & "}" & L & _
    "// A POD RESULT as the C struct with its fields (cpppod.tiko), byte for byte." & L & _
    "template <class C, class T> inline C tko_cpp_pod(const T& v) { C c; std::memcpy(&c, &v, sizeof c); return c; }" & L & _
    "// A SHARED HANDLE's owned_ holds a std::shared_ptr<T> of its own -- T the handle's class --: greater" & L & _
    "// than 1, an address. Copying the handle copies that shared_ptr; destroying it destroys that (C3b-2)." & L & _
    "template <class T> inline long long tko_cpp_box(const std::shared_ptr<T>& sp) { return reinterpret_cast<long long>(new std::shared_ptr<T>(sp)); }" & L & _
    "template <class T> inline std::shared_ptr<T>* tko_cpp_unbox(long long o) { return reinterpret_cast<std::shared_ptr<T>*>(o); }" & L & _
    "template <class T> inline std::unique_ptr<T> tko_cpp_take(tko_cpp_h* h) {" & L & _
    "    if (h->owned != 1 || !h->impl) throw std::runtime_error(""this handle does not own its C++ object alone: it cannot be given away"");" & L & _
    "    T* p = static_cast<T*>(h->impl); h->impl = nullptr; h->owned = 0; return std::unique_ptr<T>(p);" & L & "}" & L & _
    "// The handle's own shared_ptr, so a 'const std::shared_ptr<T>&' sees the count C++ would: one that" & L & _
    "// owned its object alone shares it from now on; a borrowed one is lent without ownership." & L & _
    "template <class T> inline const std::shared_ptr<T>& tko_cpp_shared(tko_cpp_h* h) {" & L & _
    "    static thread_local std::shared_ptr<T> lent;" & L & _
    "    T* p = static_cast<T*>(h->impl);" & L & _
    "    if (!p) { lent.reset(); return lent; }" & L & _
    "    if (h->owned == 1) h->owned = tko_cpp_box<T>(std::shared_ptr<T>(p));" & L & _
    "    if (h->owned > 1) return *tko_cpp_unbox<T>(h->owned);" & L & _
    "    lent = std::shared_ptr<T>(std::shared_ptr<T>(), p);" & L & _
    "    return lent;" & L & "}" & L & _
    "// THE HANDLE'S LIFE: whatever the class allows, decided by the class (if constexpr), so a" & L & _
    "// class that cannot be copied still compiles and only a copy made from tiko raises." & L & _
    "// A RANGE's iterator: the two C++ iterators a 'for each' walks (C3b-2)." & L & _
    "template <class It> struct tko_cpp_range { It cur, end; };" & L & _
    "template <class T> inline void tko_cpp_free(tko_cpp_h* s) {" & L & _
    "    if (s->owned > 1) { delete tko_cpp_unbox<T>(s->owned); s->impl = nullptr; s->owned = 0; return; }" & L & _
    "    // An abstract class is owned only through a unique_ptr result: deleted when its destructor is virtual." & L & _
    "    if constexpr (std::is_destructible_v<T> && (!std::is_abstract_v<T> || std::has_virtual_destructor_v<T>)) { if (s->owned && s->impl) delete static_cast<T*>(s->impl); }" & L & _
    "    s->impl = nullptr; s->owned = 0;" & L & "}" & L & _
    "template <class T> inline void tko_cpp_default(tko_cpp_h* s) {" & L & _
    "    s->impl = nullptr; s->owned = 0;" & L & _
    "    if constexpr (std::is_default_constructible_v<T>) {" & L & _
    "        try { s->impl = new T(); s->owned = 1; return; } TKO_CPP_CATCH" & L & _
    "    } else { tko_cpp_last() = ""this C++ class has no default constructor""; }" & L & _
    "    tko_cpp_raise();" & L & "}" & L & _
    "template <class T> inline void tko_cpp_copy(tko_cpp_h* s, const tko_cpp_h* o) {" & L & _
    "    s->impl = nullptr; s->owned = 0;" & L & _
    "    if (!o || !o->impl) return;" & L & _
    "    if (o->owned > 1) { s->impl = o->impl; s->owned = tko_cpp_box<T>(*tko_cpp_unbox<T>(o->owned)); return; }" & L & _
    "    if constexpr (std::is_copy_constructible_v<T>) {" & L & _
    "        try { s->impl = new T(*static_cast<const T*>(o->impl)); s->owned = 1; return; } TKO_CPP_CATCH" & L & _
    "    } else {" & L & _
    "        // A borrowed handle of a class that cannot be copied (an interface a reference named)" & L & _
    "        // is copied as the borrow: 'Shape& s = shape_at(0)'." & L & _
    "        if (!o->owned) { s->impl = o->impl; return; }" & L & _
    "        tko_cpp_last() = ""this C++ class cannot be copied"";" & L & _
    "    }" & L & _
    "    tko_cpp_raise();" & L & "}" & L & _
    "template <class T> inline void tko_cpp_assign(tko_cpp_h* s, const tko_cpp_h* o) {" & L & _
    "    if (s == o) return;" & L & _
    "    // Either side shared: the handle is rebound, as a shared_ptr is by '='." & L & _
    "    if (s->owned > 1 || (o && o->owned > 1)) { tko_cpp_free<T>(s); tko_cpp_copy<T>(s, o); return; }" & L & _
    "    try {" & L & _
    "        if constexpr (std::is_copy_assignable_v<T>) {" & L & _
    "            if (s->impl && o && o->impl) { *static_cast<T*>(s->impl) = *static_cast<const T*>(o->impl); return; }" & L & _
    "        }" & L & _
    "        if constexpr (std::is_copy_constructible_v<T>) {" & L & _
    "            T* n = (o && o->impl) ? new T(*static_cast<const T*>(o->impl)) : nullptr;" & L & _
    "            tko_cpp_free<T>(s); s->impl = n; s->owned = (n != nullptr); return;" & L & _
    "        } else if (o && !o->owned) {" & L & _
    "            tko_cpp_free<T>(s); s->impl = o->impl; return;" & L & _
    "        } else { tko_cpp_last() = ""this C++ class cannot be copied""; }" & L & _
    "    } TKO_CPP_CATCH" & L & _
    "    tko_cpp_raise();" & L & "}" & L & _
    "// A FIELD'S SETTER: assigns what the field allows, and reports a field that cannot be." & L & _
    "template <class F, class V> inline bool tko_cpp_set(F& f, V&& v) {" & L & _
    "    if constexpr (std::is_assignable_v<F&, V&&>) { f = std::forward<V>(v); return true; } else { return false; }" & L & "}" & L & _
    "// INLINE AND USED, NOT WEAK: every shim defines it, and a weak definition on COFF is not folded --" & L & _
    "// two #cppinclude's in one program failed 'duplicate symbol: tko_cpp_what'. An inline one is a" & L & _
    "// COMDAT the linker keeps once; 'used' makes a shim emit it although nothing in the shim calls it." & L & _
    "extern ""C"" inline __attribute__((used)) tko_cpp_ustr* tko_cpp_what() { return tko_cpp_from(tko_cpp_last()); }" & L & _
    "#endif" & L & "// ---- end of prelude ----" & L
end function

function BindingHead_( byref hdr as string, byref ver as string, byref tgt as string, _
                       byval needsContainers as boolean ) as string
    dim as string L = chr( 10 )
    '' THE FIRST LINE says what a '#cppinclude' must import for the binding (pp/directive.tiko).
    dim as string need = iif( needsContainers, "'' tiko-cpp-needs: std/containers -- '#import ""std/containers""' before including this file" & L, "" )
    return need & _
    "'' Generated by tiko -cppimport from """ & hdr & """ (" & ver & ", " & tgt & "). Do not edit: regenerate." & L & _
    "'' Every declaration is a function of the C++ shim written beside this file, which must be" & L & _
    "'' compiled for the same target and linked. A C++ exception is runtime error " & ERR_CPP_ & "; cpp.What( )" & L & _
    "'' is its text. A CPP-TODO line is a declaration the importer could not express yet. A class is" & L & _
    "'' a handle type: impl_ is the C++ object, which the handle owns (deletes) when owned_ is 1 --" & L & _
    "'' a value the C++ returned -- and only borrows when C++ returned a reference or pointer." & L & _
    "#pragma once" & L & L & _
    "#ifndef __TKO_CPP_PRELUDE__" & L & "#define __TKO_CPP_PRELUDE__" & L & _
    "namespace cpp" & L & _
    "    extern ""C"" : declare function What alias ""tko_cpp_what"" ( ) as ustring : end extern" & L & _
    "end namespace" & L & "#endif" & L & L
end function

'' ---------------------------------------------------------------- the run

private function Parse_( byref api as ClangApi, byval argv as zstring ptr ptr, byval argc as int32, _
                         byref unitText as string, byref res as CppImportResult, _
                         byref idx as any ptr, byref tu as any ptr, byref errLines as Tko.StrVec ) as boolean
    dim as string unitName = UNIT_NAME_
    dim as CXUnsavedFile uf
    uf.Filename = strptr( unitName )
    uf.Contents = strptr( unitText )
    uf.Length = len( unitText )
    idx = api.createIndex( 0, 0 )
    tu = api.parseTranslationUnit( idx, strptr( unitName ), argv, argc, @uf, 1, CXTranslationUnit_SkipFunctionBodies )
    if tu = nullptr then
        api.disposeIndex( idx ) : idx = nullptr
        res.rc = 1 : res.why = "clang could not start a parse"
        return false
    end if
    dim as int32 nerr = 0
    res.clangDiags.Clear( )
    for i as int32 = 0 to api.getNumDiagnostics( tu ) - 1
        dim as any ptr d = api.getDiagnostic( tu, i )
        if api.getDiagnosticSeverity( d ) >= 3 then
            '' AN ERROR IN THE UNIT'S OWN LINES, past the #include, is a probe or an instantiation
            '' clang could not make: that member or that specialization is not bound, nothing else.
            dim as any ptr f = nullptr
            dim as uint32 ln, col, off
            api.getExpansionLocation( api.getDiagnosticLocation( d ), @f, @ln, @col, @off )
            dim as string fnm = iif( f <> nullptr, ClangText( api, api.getFileName( f ) ), "" )
            if (right( fnm, len( UNIT_NAME_ ) ) <> UNIT_NAME_) orelse (ln <= 1) then
                nerr += 1
                if res.clangDiags.Count < 10 then res.clangDiags.Push( ClangText( api, api.formatDiagnostic( d, 3 ) ) )
            else
                errLines.Push( str( ln ) )
            end if
        end if
        api.disposeDiagnostic( d )
    next
    if nerr > 0 then
        api.disposeTranslationUnit( tu ) : tu = nullptr
        api.disposeIndex( idx ) : idx = nullptr
        res.rc = 1 : res.why = "clang reported " & nerr & " error(s) in the header"
        return false
    end if
    return true
end function

'' '#cppinstantiate "geo::clamp<int>"' as the C++ the unit writes for it: '::geo::clamp<int>'.
private function InstText_( byref s as string ) as string
    dim as string r = trim( s )
    if left( r, 2 ) <> "::" then r = "::" & r
    return r
end function

private function InstBase_( byref s as string ) as string
    dim as string r = trim( s )
    if left( r, 2 ) = "::" then r = mid( r, 3 )
    if instr( r, "(" ) > 0 then r = trim( left( r, instr( r, "(" ) - 1 ) )
    if instr( r, "<" ) > 0 then r = trim( left( r, instr( r, "<" ) - 1 ) )
    return r
end function

'' EVERYTHING AFTER THE LAST PARSE: the classes, the functions, the asked-for function
'' instantiations, and the three texts.
private function Finish_( byref api as ClangApi, byref opts as CppImportOptions, byref x as CppImp_, _
                          byref ikind as Tko.StrVec, byref res as CppImportResult ) as boolean
    dim as string L = chr( 10 )
    for i as int32 = 0 to opts.instantiate.Count - 1
        dim as CXCursor fn
        if ((ikind[i] = "SC") orelse (ikind[i] = "SM")) andalso ShapeTarget_( x, i, fn ) then
            x.extraMem.Push( fn ) : x.extraTargs.Push( ShapeTargs_( opts.instantiate[i] ) ) : x.extraCls.Push( ShapeClass_( x, i ) )
        end if
    next
    EmitClasses_( x )
    x.pass = 3
    api.visitChildren( api.getTranslationUnitCursor( x.tu ), @Visit_, @x )
    for i as int32 = 0 to opts.instantiate.Count - 1
        dim as CXCursor fn
        dim as boolean found = false
        if ikind[i] = "f" then found = InstFunction_( x, i, fn )
        if (ikind[i] = "SF") orelse (ikind[i] = "SO") then found = ShapeTarget_( x, i, fn )
        if found = false then
            if len( ikind[i] ) andalso (ikind[i] <> "c") andalso (ikind[i] <> "SC") andalso (ikind[i] <> "SM") then
                Todo_( x, opts.instantiate[i], "#cppinstantiate: clang found nothing it calls" )
            end if
            continue for
        end if
        dim as Tko.StrVec ns
        if NsOf_( x, fn, ns ) = false then Todo_( x, opts.instantiate[i], "a member function template" ) : continue for
        for j as int32 = 0 to ns.Count - 1
            x.bind.Push( Indent_( x ) & "namespace " & ns[j] )
            x.cppNs.Push( ns[j] ) : x.tikoNs.Push( ns[j] )
        next
        if ikind[i] = "f" then x.calleeOverride = InstText_( opts.instantiate[i] )
        if ikind[i] = "SF" then
            x.calleeTargs = ShapeTargs_( opts.instantiate[i] )
            if len( x.calleeTargs ) then x.nameOverride = ValueName_( Text_( x, api.getCursorSpelling( fn ) ) & TargsName_( x.calleeTargs ) )
        end if
        Function_( x, fn )
        x.calleeOverride = "" : x.calleeTargs = "" : x.nameOverride = ""
        for j as int32 = 0 to ns.Count - 1
            x.cppNs.Pop( ) : x.tikoNs.Pop( )
            x.bind.Push( Indent_( x ) & "end namespace" )
        next
    next

    dim as Tko.StrVec parts
    dim as string ver = api.version
    if instr( ver, " (" ) > 0 then ver = left( ver, instr( ver, " (" ) - 1 )
    parts.Push( BindingHead_( opts.header, ver, opts.targetName, x.vecEC.Count > 0 ) )
    for i as int32 = 0 to x.bind.Count - 1
        parts.Push( x.bind[i] & L )
    next
    '' THE std::vector TRAITS and the ADAPTERS, last: every type is complete by now.
    for i as int32 = 0 to x.vecDecls.Count - 1
        parts.Push( x.vecDecls[i] & L )
    next
    if x.defs.Count > 0 then
        parts.Push( "#pragma push( private, true )" & L )
        for i as int32 = 0 to x.defs.Count - 1
            parts.Push( x.defs[i] )
        next
        parts.Push( "#pragma pop( private )" & L )
    end if
    res.binding = JoinParts( parts )

    parts.Clear( )
    parts.Push( "// Generated by tiko -cppimport from """ & opts.header & """ for " & opts.targetName & _
                ". Do not edit: regenerate." & L )
    parts.Push( "#include """ & opts.header & """" & L )
    parts.Push( Prelude_( ) & L )
    for i as int32 = 0 to x.shim.Count - 1
        parts.Push( x.shim[i] & L )
    next
    res.shim = JoinParts( parts )

    '' THE MEMBERS' NAMES, from the mirror.
    if instr( res.shim, "@@M:" ) > 0 then
        parts.Clear( )
        parts.Push( "struct FBUSTRING;" & L )
        for i as int32 = 0 to x.mirFwd.Count - 1
            parts.Push( x.mirFwd[i] )
        next
        for i as int32 = 0 to x.mirBody.Count - 1
            parts.Push( x.mirBody[i] )
        next
        if ResolveMirror_( api, opts.triple, JoinParts( parts ), res.shim, res ) = false then
            res.rc = 1
            return false
        end if
    end if
    res.bound = x.bound
    res.todos = x.todos
    return true
end function

private sub Args_( byref api as ClangApi, byref opts as CppImportOptions, byref av as Tko.StrVec )
    av.Push( "-x" ) : av.Push( "c++" ) : av.Push( "-std=c++17" )
    '' No error limit: a probe clang cannot instantiate is one forgiven error, and glm has many.
    av.Push( "-ferror-limit=0" )
    av.Push( "--target=" & opts.triple )
    dim as string rdir = ClangResourceDir( api )
    if len( rdir ) then av.Push( "-resource-dir=" & rdir )
    for i as int32 = 0 to opts.includes.Count - 1
        av.Push( "-I" ) : av.Push( opts.includes[i] )
    next
    for i as int32 = 0 to opts.defines.Count - 1
        av.Push( "-D" ) : av.Push( opts.defines[i] )
    next
    if len( opts.sysroot ) then av.Push( "--sysroot=" & opts.sysroot )
    for i as int32 = 0 to opts.copts.Count - 1
        av.Push( opts.copts[i] )
    next
end sub

'' The shim function a shim line is in: the nearest 'extern "C" ... tko_cpp_<id>_<n>(' above it.
private function ShimFn_( byref lines as Tko.StrVec, byval ln as int32 ) as string
    for i as int32 = ln - 1 to 0 step -1
        if i >= lines.Count then continue for
        if left( lines[i], 11 ) <> "extern ""C"" " then continue for
        dim as int32 p = instr( lines[i], "(" )
        dim as int32 a = p - 1
        while (a > 0) andalso (instr( "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_", mid( lines[i], a, 1 ) ) > 0)
            a -= 1
        wend
        dim as string nm = mid( lines[i], a + 1, p - a - 1 )
        if left( nm, 8 ) = "tko_cpp_" then return nm
        return ""
    next
    return ""
end function

'' A diagnostic's line when it is in the shim, else 0.
private function ShimLine_( byref api as ClangApi, byval d as any ptr, byref path as string ) as int32
    dim as any ptr f = nullptr
    dim as uint32 ln, col, off
    api.getExpansionLocation( api.getDiagnosticLocation( d ), @f, @ln, @col, @off )
    if f = nullptr then return 0
    dim as string fnm = lcase( Fwd_( ClangText( api, api.getFileName( f ) ) ) )
    if fnm <> lcase( Fwd_( path ) ) then return 0
    return ln
end function

function CppShimCheck( byref api as ClangApi, byref opts as CppImportOptions, _
                       byref path as string, byref shim as string, byref bad as Tko.StrVec ) as boolean
    if api.ok = false then return false
    dim as Tko.StrVec av, lines
    Args_( api, opts, av )
    '' The shim includes the header as it was named, which '-cppimport' wrote relative to it.
    dim as string hp = Fwd_( opts.header )
    if (left( hp, 1 ) <> "/") andalso (mid( hp, 2, 1 ) <> ":") then hp = Fwd_( curdir( ) ) & "/" & hp
    av.Push( "-I" ) : av.Push( left( hp, instrrev( hp, "/" ) - 1 ) )
    dim as zstring ptr argv( 0 to av.Count )
    for i as int32 = 0 to av.Count - 1
        argv( i ) = strptr( av[i] )
    next
    dim as int32 a = 1
    while a <= len( shim )
        dim as int32 b = instr( a, shim, chr( 10 ) )
        if b = 0 then b = len( shim ) + 1
        lines.Push( mid( shim, a, b - a ) )
        a = b + 1
    wend
    dim as string fn_ = path
    dim as CXUnsavedFile uf
    uf.Filename = strptr( fn_ )
    uf.Contents = strptr( shim )
    uf.Length = len( shim )
    dim as any ptr idx = api.createIndex( 0, 0 )
    dim as any ptr tu = api.parseTranslationUnit( idx, strptr( fn_ ), @argv( 0 ), av.Count, @uf, 1, 0 )
    if tu = nullptr then api.disposeIndex( idx ) : return false
    dim as boolean ok = true
    for i as int32 = 0 to api.getNumDiagnostics( tu ) - 1
        dim as any ptr d = api.getDiagnostic( tu, i )
        if api.getDiagnosticSeverity( d ) >= 3 then
            '' THE ERROR'S OWN LINE, or the shim line a note says it was instantiated from.
            dim as string nm = ShimFn_( lines, ShimLine_( api, d, path ) )
            dim as any ptr cs = api.getChildDiagnostics( d )
            if (len( nm ) = 0) andalso (cs <> nullptr) then
                for j as int32 = 0 to api.getNumDiagnosticsInSet( cs ) - 1
                    nm = ShimFn_( lines, ShimLine_( api, api.getDiagnosticInSet( cs, j ), path ) )
                    if len( nm ) then exit for
                next
            end if
            if len( nm ) = 0 then
                ok = false
            else
                dim as boolean have = false
                for j as int32 = 0 to bad.Count - 1
                    if bad[j] = nm then have = true
                next
                if have = false then bad.Push( nm )
            end if
        end if
        api.disposeDiagnostic( d )
    next
    api.disposeTranslationUnit( tu )
    api.disposeIndex( idx )
    return ok andalso (bad.Count > 0)
end function

function CppImportRun( byref api as ClangApi, byref opts as CppImportOptions, _
                       byref res as CppImportResult ) as boolean
    res.rc = 0
    if api.ok = false then
        res.rc = 3 : res.why = api.why
        return false
    end if

    dim as Tko.StrVec av
    Args_( api, opts, av )
    dim as zstring ptr argv( 0 to av.Count )
    for i as int32 = 0 to av.Count - 1
        argv( i ) = strptr( av[i] )
    next

    '' THE HEADER'S DIRECTORY decides what is in scope; resolved here, absolute.
    dim as string hp = Fwd_( opts.header )
    dim as boolean absolute_ = (left( hp, 1 ) = "/") orelse (mid( hp, 2, 1 ) = ":")
    if absolute_ = false then hp = Fwd_( curdir( ) ) & "/" & hp
    dim as string hd = left( hp, instrrev( hp, "/" ) )

    '' PARSE, LOOK, AND PARSE AGAIN while the bound API names a specialization that is not yet
    '' complete, or a '#cppinstantiate' has not yet been told apart as a class or a function.
    dim as string L = chr( 10 )
    dim as Tko.StrVec forced, ikind, probes, probeKeys, probed, ranged
    for i as int32 = 0 to opts.instantiate.Count - 1
        ikind.Push( "" )
    next
    dim as CppImp_ ptr xp = nullptr
    dim as any ptr idx = nullptr, tu = nullptr
    for round_ as int32 = 1 to 8
        dim as string unitText = "#include """ & hp & """" & L & "#include <utility>" & L
        for i as int32 = 0 to forced.Count - 1
            unitText &= "static_assert(sizeof(" & forced[i] & ") > 0, ""tiko: instantiate"");" & L
        next
        for i as int32 = 0 to probes.Count - 1
            unitText &= probes[i] & L
        next
        for i as int32 = 0 to opts.instantiate.Count - 1
            dim as string sx = InstText_( opts.instantiate[i] )
            if ikind[i] = "c" then
                unitText &= "using tko_cpp_inst_" & i & " = " & sx & ";" & L & _
                            "static_assert(sizeof(tko_cpp_inst_" & i & ") > 0, ""tiko: instantiate"");" & L
            elseif ikind[i] = "f" then
                unitText &= "inline auto* const tko_cpp_fn_" & i & " = &" & sx & ";" & L
            elseif left( ikind[i], 1 ) = "S" then
                unitText &= ShapeLine_( opts.instantiate[i], ikind[i], i ) & L
            end if
        next
        if xp <> nullptr then delete xp : xp = nullptr
        dim as Tko.StrVec errLines
        if Parse_( api, @argv( 0 ), av.Count, unitText, res, idx, tu, errLines ) = false then return false
        xp = new CppImp_
        xp->api = @api
        xp->tu = tu
#ifdef __FB_WIN32__
        xp->foldCase = true
#endif
        xp->hdrDir = iif( xp->foldCase, lcase( hd ), hd )
        xp->id = Id_( lcase( Fwd_( opts.header ) ) )
        for i as int32 = 0 to opts.exclude.Count - 1
            xp->exclude.Push( opts.exclude[i] )
        next
        for i as int32 = 0 to opts.instantiate.Count - 1
            xp->instBases.Push( InstBase_( opts.instantiate[i] ) )
        next
        '' Enums, then the classes collected.
        for p as int32 = 1 to 2
            xp->pass = p
            api.visitChildren( api.getTranslationUnitCursor( tu ), @Visit_, xp )
        next
        LoadProbes_( *xp )
        '' The probe lines start after the two #includes and the forced specializations.
        for i as int32 = 0 to errLines.Count - 1
            dim as int32 pl = valint( errLines[i] ) - 3 - forced.Count
            if (pl >= 0) andalso (pl < probeKeys.Count) then
                if len( probeKeys[pl] ) then xp->badProbes.Push( probeKeys[pl] )
            end if
        next
        dim as boolean again = false
        for i as int32 = 0 to opts.instantiate.Count - 1
            if ikind[i] <> "" then continue for
            '' A CALL SHAPE (D12): 'glm::dot(glm::vec3, glm::vec3)'.
            if instr( opts.instantiate[i], "(" ) > 0 then
                ikind[i] = ShapeKind_( *xp, opts.instantiate[i] )
                if ikind[i] <> "" then again = true : continue for
            end if
            for j as int32 = 0 to xp->tmplNames.Count - 1
                if xp->tmplNames[j] = xp->instBases[i] then ikind[i] = xp->tmplKinds[j] : exit for
            next
            '' AN ALIAS OF A SPECIALIZATION is one too: '#cppinstantiate "rapidjson::Document"'.
            if (ikind[i] = "") andalso (instr( opts.instantiate[i], "<" ) = 0) then
                for j as int32 = 0 to xp->alCpp.Count - 1
                    if xp->alCpp[j] = xp->instBases[i] then ikind[i] = "c" : exit for
                next
            end if
            if ikind[i] = "" then
                res.rc = 1 : res.why = "#cppinstantiate """ & opts.instantiate[i] & """ names no template of this header"
                delete xp : api.disposeTranslationUnit( tu ) : api.disposeIndex( idx )
                return false
            end if
            again = true
        next
        if again = false then
            '' WHAT IS BOUND names what else is: the asked-for instantiations, the functions'
            '' types, every class's members' -- the classes found on the way included.
            for i as int32 = 0 to opts.instantiate.Count - 1
                dim as CXCursor fn
                if ikind[i] = "c" then NoteType_( *xp, InstClass_( *xp, i ) )
                if (ikind[i] = "f") andalso InstFunction_( *xp, i, fn ) then NoteFunction_( *xp, fn )
                if (left( ikind[i], 1 ) = "S") andalso ShapeTarget_( *xp, i, fn ) then
                    NoteFunction_( *xp, fn )
                    if (ikind[i] = "SC") orelse (ikind[i] = "SM") then NoteType_( *xp, ShapeClass_( *xp, i ) )
                end if
            next
            xp->pass = 4
            api.visitChildren( api.getTranslationUnitCursor( tu ), @Visit_, xp )
            dim as int32 ci = 0
            while ci < xp->clsUsr.Count
                DiscoverClass_( *xp, ci )
                ci += 1
            wend
            for i as int32 = 0 to xp->needForce.Count - 1
                dim as boolean have = false
                for j as int32 = 0 to forced.Count - 1
                    if forced[j] = xp->needForce[i] then have = true
                next
                if have = false then forced.Push( xp->needForce[i] ) : again = true
            next
            '' A RANGE's element type, probed once; the types it names noted once it is known.
            for i as int32 = 0 to xp->clsUsr.Count - 1
                if HasRange_( *xp, i ) = false then continue for
                dim as boolean have = false
                for j as int32 = 0 to ranged.Count - 1
                    if ranged[j] = xp->clsCpp[i] then have = true
                next
                if have = false then
                    ranged.Push( xp->clsCpp[i] ) : probes.Push( RangeProbe_( *xp, i ) ) : probeKeys.Push( "" ) : again = true
                else
                    for j as int32 = 0 to xp->probeNames.Count - 1
                        if xp->probeNames[j] = "it_" & Id_( xp->clsCpp[i] ) then NoteType_( *xp, xp->probeTypes[j] )
                    next
                end if
            next
            for i as int32 = 0 to xp->needForce.Count - 1
                dim as boolean have = false
                for j as int32 = 0 to forced.Count - 1
                    if forced[j] = xp->needForce[i] then have = true
                next
                if have = false then forced.Push( xp->needForce[i] ) : again = true
            next
            '' A SPECIALIZATION NOT PROBED YET is probed on the next parse.
            for i as int32 = 0 to xp->clsUsr.Count - 1
                if IsSpec_( *xp, i ) = false then continue for
                dim as boolean have = false
                for j as int32 = 0 to probed.Count - 1
                    if probed[j] = xp->clsCpp[i] then have = true
                next
                if have = false then
                    probed.Push( xp->clsCpp[i] )
                    if ProbeLines_( *xp, i, probes, probeKeys ) then again = true
                end if
            next
        end if
        if (again = false) orelse (round_ = 8) then exit for
        api.disposeTranslationUnit( tu )
        api.disposeIndex( idx )
    next

    dim as boolean ok = Finish_( api, opts, *xp, ikind, res )
    delete xp
    api.disposeTranslationUnit( tu )
    api.disposeIndex( idx )
    return ok
end function

end namespace
