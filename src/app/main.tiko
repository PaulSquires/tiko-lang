'
'   tkEdit                run it
'   tkEdit --selftest     drive the real window at scale 1.0 and 1.75, print what it saw;
'                         exit code = failures, last line " selftest: N passed, M failed"
'' std/* before anything that brings in vendor/SDL3 (Linux: crt/stdio.bi, tkControls FINDINGS)
#import "std/strings"
#import "tkp/platform"
#import "tka/mainwin"
#import "./tests/selftest"
#import "tkControls/tkApp"
#import "tkControls/tkCodeEdit"
using tkApp
using tkHost
using tkCodeEdit

dim as TKAPP_OPTIONS opts = mainwin.AppOptions( )
if tkApp_Init( opts ) = false then
    print "tkEdit: SDL could not start: "; *SDL_GetError( )
    end 1
end if

if command( 1 ) = "--selftest" then
    dim as selftest.Tally t
    selftest.Pass( t, 1.0 )
    selftest.Pass( t, 1.75 )
    tkApp_Shutdown( )
    print strings.Format( "tkEdit [{}] selftest: {} passed, {} failed", platform.OsName( ), t.passed, t.failed )
    end t.failed
end if

dim as mainwin.Window theWindow
if theWindow.Create( ) = false then
    print "tkEdit: the main window could not be created: "; *SDL_GetError( ); " "; tkCodeEdit_LibraryError( )
    end 1
end if
theWindow.Show( )
end tkApp_Run( theWindow.form )
