'
' mainwin -- the main window and the App state it owns (PLAN.md, Window). One editor pane fills
' the window, or two after a split; the status line sits at the bottom; there is no menu. Every
' command goes through Execute( Cmd ).
'
' BUFFERS (D3): every open file is a documents.Document with its own Scintilla view; there is no
' tab bar. Pane 1 shows one buffer through its Main view, pane 2 (after a split) one through its
' Other view -- a second view on the same Scintilla document, so both panes may show one buffer.
' Views of buffers no pane shows are hidden. Docs is the open order, which Ctrl+Tab walks; Mru
' holds the buffers most recently shown first. There is always at least one buffer (an untitled one).
'
' Configuration is files only (D15): settings.toml, keybindings.toml and the theme are opened as
' buffers like any text, and saving one re-applies it at once. A file that does not parse leaves
' the previous values in force and says why in the status line's message panel. settings.toml is
' rewritten to list every key at its value in force when tkEdit starts and before it is opened;
' keybindings.toml every command at its chord, the same way.
#module "mainwin"

#import "std/containers"
#import "std/fs"
#import "std/outcome"
#import "std/process"
#import "std/strings"
#import "tkp/platform"
#import "tkc/appinfo"
#import "tkc/autoinsert"
#import "tkc/build"
#import "tkc/cmdids"
#import "tkc/docencoding"
#import "tkc/format"
#import "tkc/keybind"
#import "tkc/mru"
#import "tkc/navhistory"
#import "tkc/outline"
#import "tkc/project"
#import "tkc/session"
#import "tkc/settings"
#import "tkc/symboldb"
#import "tkc/textsearch"
#import "tkc/textstream"
#import "tkc/themes"
#import "tka/chrome"
#import "tka/documents"
#import "tka/editor"
#import "tka/findstrip"
#import "tka/outputpane"
#import "tka/popuplist"
#import "tks/parser"
#import "tks/runner"
#import "tkControls/tkApp"
#import "tkControls/tkCodeEdit"
#import "tkControls/tkFileDialog"
#import "tkControls/tkKeys"
#import "tkControls/tkListTree"
#import "tkControls/tkMessageBox"
#import "tkControls/tkPaint"
#import "tkControls/tkPopupMenu"
#import "tkControls/tkSplitter"
#import "tkControls/tkStatusBar"
using containers
using outcome
using cmdids
using tkApp
using tkHost
using tkCodeEdit
