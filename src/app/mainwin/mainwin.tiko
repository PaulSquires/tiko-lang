public const FONT_UI = "Inter-Regular.ttf"
public const FONT_UI_BOLD = "Inter-Bold.ttf"
public const FONT_MONO = "JetBrainsMono-Regular.ttf"
public const FONT_GLYPH = "PsIcons.ttf"
public const DEFAULT_CX = 960
public const DEFAULT_CY = 640
public const STATUS_CY = 24              ' one status row, unscaled
public const SPLIT_BAR = 5               ' the bar between the two panes, unscaled
const ID_STATUS = 101
const ID_SPLIT = 103
const ID_FINDSTRIP = 104
const ID_OUTPUT = 105
const BUILD_POLL_MS = 40
const ID_SCRATCH = 106
const SEARCH_LIMIT = 5000              ' Find in Project stops counting there
const ID_VIEW = 200                      ' views are ID_VIEW + n
const DISK_CHECK_MS = 1000

' The status line's panels, left to right (PLAN.md, Window).
public enum StatusPanel explicit
    Buffer = 0          ' the active buffer's name, its full path the tooltip; a click lists the buffers
    Message             ' stretches: build results, config errors; a click shows or hides the output pane
    Position            ' Ln, Col; a click opens Go to Line, or closes it
    Build               ' the build configuration; a click picks one
    Encoding            ' a click picks one
    LineEnding          ' a click converts
end enum

' What the one chooser popup is choosing.
public enum PickKind explicit
    None = 0
    Buffers
    Recent
    Encoding
    LineEnding
    Build
    Bookmarks
    Symbols             ' Ctrl+P: files and definitions
    Functions           ' F4: the procedures of the buffer, or of every open buffer
end enum

' One Find in Project match.
public type SearchHit
    Path   as ustring
    Line   as long                      ' 0-based
    Column as long                      ' character index in the line
    Length as long                      ' characters
end type

' A row of Search Symbol or the functions list: where it goes.
public type SymHit
    Name as ustring
    Kind as ustring                     ' "function", "sub", "type", "enum", "file"
    Path as ustring
    Line as long                        ' 0-based; -1 = a file
    Doc  as documents.Document ptr      ' the buffer it came from, when it did
end type

' One bookmark the Bookmarks list shows.
public type BookmarkHit
    Doc  as documents.Document ptr
    Line as long                        ' 0-based
end type

' The person, as the window asks them things: a message box, a file dialog. The self-test
' answers from a script instead.
public type AskProc as function( byval f as TK_FORM ptr, byref text as const ustring, byval buttons as long ) as long
public type PickProc as function( byval f as TK_FORM ptr, byval kind as long, byref suggest as const ustring ) as ustring
public type DocRef as documents.Document ptr
' Starting a program (Run): argv[0] is the program. The self-test records instead.
public type LaunchProc as function( byref argv as const Array( of ustring ), byref workDir as const ustring ) as boolean

' tkApp's fonts: the bundled ones in <resources>/fonts (D16). The UI font size is read from the
' user's settings.toml here, before any window exists, so it applies from the next start.
public function AppOptions( ) as TKAPP_OPTIONS
    dim as TKAPP_OPTIONS opts
    dim as Optional( of ustring ) res = platform.ResourceDir( )
    if res.HasValue( ) then
        opts.FontDir = fs.PathJoin( res.Value( ), "fonts" ) & "/"     ' tkApp appends the file name
        opts.FontUIFile = FONT_UI
        opts.FontUIBoldFile = FONT_UI_BOLD
        opts.FontMonoFile = FONT_MONO
        opts.GlyphFontFile = FONT_GLYPH
    end if
    dim as fs.FsResultUStr sp = settings.SettingsPath( )
    if sp.IsOk( ) then
        dim as settings.SettingsResult s = settings.LoadSettings( sp.Value( ) )
        if s.IsOk( ) then opts.FontUISize = s.Value( ).UiFontSize
    end if
    opts.ThemeMode = TKAPP_THEME_NONE          ' the theme file decides (Window.ReloadTheme)
    return opts
end function

' A keyword file's words, lower case, one space apart (LexTiko's list format).
private function WordsOf( byref path as const ustring ) as ustring
    dim as textstream.TextFileResult r = textstream.ReadText( path )
    if r.IsOk( ) = false then return ""
    dim as ustring s = lcase( r.Value( ).Text )
    dim as ustring o
    dim as boolean gap = true
    for i as long = 0 to len( s ) - 1
        dim as ulong ch = s[i]
        if (ch = 32) orelse (ch = 9) orelse (ch = 10) orelse (ch = 13) then
            gap = true
        else
            if gap andalso (len( o ) > 0) then o &= " "
            gap = false
            o &= wchr( ch )
        end if
    next
    return o
end function

' <resources>/keywords: tiko.txt (the language), extra.txt (the user's own words).
public function LoadKeywords( byref resourceDir as const ustring ) as editor.Keywords
    dim as editor.Keywords k
    dim as ustring d = fs.PathJoin( resourceDir, "keywords" )
    k.Words1 = WordsOf( fs.PathJoin( d, "tiko.txt" ) )
    k.Words3 = WordsOf( fs.PathJoin( d, "extra.txt" ) )
    return k
end function

private function AskPerson( byval f as TK_FORM ptr, byref text as const ustring, byval buttons as long ) as long
    dim as long icon = MBX_ICON_QUESTION
    if buttons = MBX_BTN_OK then icon = MBX_ICON_INFO
    return tkMessageBox_Show( tkForm_Widget( f ), text, platform.APP_NAME, icon, buttons )
end function

private function LaunchProgram( byref argv as const Array( of ustring ), byref workDir as const ustring ) as boolean
    if argv.Count( ) = 0 then return false
    dim as process.Command c = process.Command( argv[0] )
    for i as long = 1 to argv.Count( ) - 1
        c.Arg( argv[i] )
    next
    if len( workDir ) then c.Cwd( workDir )
    dim as process.Child ptr ch = new process.Child         ' left to run; the OS reaps it
    return ch->Spawn( c ).IsOk( )
end function

private function PickPerson( byval f as TK_FORM ptr, byval kind as long, byref suggest as const ustring ) as ustring
    dim as string filters = "tiko source|tiko;ti;bas;bi;inc|TOML|toml|All files|*"
    dim as ustring where = suggest
    if kind = TKFD_SAVE then return tkFileDialog_SaveFile( tkForm_Host( f ), filters, where )
    return tkFileDialog_OpenFile( tkForm_Host( f ), filters, where )
end function

public type Window
    ' ---- set before Create (the self-test points them elsewhere)
    ConfigDir as ustring                ' settings.toml, keybindings.toml, session.toml, themes/
    Ask as AskProc
    Pick as PickProc
    Launch as LaunchProc

    ' ---- the App state
    ResourceDir as ustring
    HasIcon as boolean                                         ' icons/tkedit.png set as the window icon
    Prefs as settings.EditorSettings
    Keys as keybind.KeyMap
    Theme as themes.Theme
    Words as editor.Keywords
    Look as editor.Look
    Docs as Array( of DocRef )          ' open order
    Mru as Array( of DocRef )           ' most recently shown first
    Pane1 as DocRef
    Pane2 as DocRef                     ' 0 = not split
    Split as session.SplitMode
    SplitRatio as double = 0.5
    InPane2 as boolean                  ' the second pane has the focus
    Recent as mru.RecentList
    CurrentBuild as ustring             ' the build configuration's name
    Message as ustring                  ' the message panel's text
    Chooser as popuplist.Picker
    Choosing as PickKind
    Finder as findstrip.Strip
    FindLo as longint                   ' "Sel": the selection the strip opened over
    FindHi as longint
    Marks as Array( of BookmarkHit )    ' the Bookmarks list's rows

    ' ---- the project (D8) and the build (P4)
    Proj as project.ProjectFile
    ProjOpen as boolean
    Out as outputpane.Pane
    OutputShown as boolean
    Job as runner.Job
    buildTimer as long
    Diags as Array( of build.Diagnostic )
    DiagAt as long = -1
    BuildAct as build.BuildAction
    BuildMain as ustring
    BuildFlags as ustring
    BuildDiagFile as ustring
    BuildProgram as ustring
    BuildDir as ustring
    BuildRaw as ustring
    LogText as ustring
    QuickRunFile as ustring
    LastExe as ustring
    PendingArgs as Array( of ustring )
    Cleaning as boolean
    BuildSucceeded as boolean
    Progress as build.BuildProgress
    RunArgs as ustring                  ' Run's arguments with no project open

    ' ---- code intelligence (P5)
    NoParser as boolean                 ' set before Create: the outline only (the self-test)
    Scanner as parser.Scanner
    Db as symboldb.Database
    Nav as navhistory.History
    scanTimer as long
    scanGen as long
    scanDirty as boolean
    lastEditTicks as ulongint
    ScansInstalled as long
    LastScanError as ustring
    FuncsAll as boolean                 ' F4: every open buffer's procedures
    Hits as Array( of SymHit )          ' the chooser's rows, for Symbols and Functions

    ' ---- P6
    Fmt as format.Formatter
    FormatterReady as boolean
    scratch as editor.CodeView          ' hidden: Find in Project matches each file's text in it
    Found as Array( of SearchHit )      ' the Search tab's rows

    form as TK_FORM ptr
    status as TK_WIDGET ptr
    splitBar as TK_WIDGET ptr
    editMenu as TK_MENU ptr             ' a view's right-click menu
    accel as TK_KEYMAP ptr
    diskTimer as long
    untitled as long
    viewIds as long
    asking as boolean                   ' a disk-change question is up

    declare function Create( byval forcedScale as single = 0 ) as boolean
    declare sub Show( )
    declare sub Destroy( )
    declare sub Layout( )
    declare sub ShowStatus( )
    declare sub ShowTitle( )
    declare function StatusText( byval p as StatusPanel ) as ustring
    declare function StatusTip( byval p as StatusPanel ) as ustring    ' "" = none
    declare function StatusHeight( ) as long
    declare function BottomHeight( ) as long                   ' the status line, and the strip above it
    declare function OutputHeight( ) as long                   ' 0 when the pane is hidden
    declare sub SetMessage( byref s as const ustring )

    ' ---- commands
    declare function Execute( byval id as Cmd ) as boolean       ' FALSE = not available (yet)
    declare function IsImplemented( byval id as Cmd ) as boolean
    declare function ShortcutText( byval id as Cmd ) as ustring  ' "Ctrl+S", "" = none

    ' ---- configuration
    declare function SettingsFile( ) as ustring
    declare function KeysFile( ) as ustring
    declare function SessionFile( ) as ustring
    declare sub ReloadSettings( )
    declare sub SyncSettingsFile( )
    declare sub SyncKeysFile( )
    declare sub ReloadKeys( )
    declare sub ReloadTheme( )
    declare sub ApplyLook( )
    declare function EditableThemeFile( ) as ustring

    ' ---- buffers and panes
    declare function Active( ) as DocRef
    declare function View( ) byref as editor.CodeView           ' the focused pane's view
    declare function ActivePath( ) as ustring
    declare function NewDocument( ) as DocRef
    declare function OpenFile( byref path as const ustring ) as boolean
    declare function FindOpen( byref path as const ustring ) as DocRef
    declare sub ShowDoc( byval d as DocRef )                     ' in the focused pane
    declare sub CycleBuffer( byval forward as boolean )          ' the next in open order, wrapping
    declare function SaveDoc( byval d as DocRef, byval newName as boolean ) as boolean
    declare function CloseDoc( byval d as DocRef ) as boolean   ' FALSE = the person cancelled
    declare function CloseAll( ) as boolean
    declare function SaveAll( ) as boolean
    declare sub ToggleSplit( byval mode as session.SplitMode )
    declare sub FocusPane( byval second as boolean )
    declare sub CheckDisk( )
    declare sub SetEncoding( byval e as docencoding.FileEncoding )
    declare sub SetLineEnding( byval e as docencoding.LineEnd )
    declare sub SaveSession( )
    declare sub RestoreSession( )

    ' ---- find, replace, go to line, bookmarks, typing
    declare sub OpenStrip( byval m as findstrip.StripMode )
    declare sub OnFind( byval a as findstrip.FindAction )
    declare sub ShowFindStatus( )
    declare function FindOptionsNow( ) as editor.FindOptions
    declare sub OnCharAdded( byval hEdit as TK_WIDGET ptr, byval ch as long )
    declare sub OnMarginClick( byval hEdit as TK_WIDGET ptr, byval margin as long, byval position as longint )

    ' ---- projects and builds
    declare function OpenProject( byref path as const ustring ) as boolean
    declare function NewProject( ) as boolean
    declare function SaveProject( ) as boolean
    declare function CloseProject( ) as boolean
    declare sub AddToProject( )
    declare function CompilerPath( ) as ustring
    declare function ActiveBuildConfig( ) as build.BuildConfig
    declare function IsBuilding( ) as boolean
    declare function StartBuild( byval action as build.BuildAction, byval rebuild as boolean = false ) as boolean
    declare sub PollBuild( )
    declare sub FinishBuild( )
    declare sub ClearDiagnostics( )
    declare sub ShowDiagnostics( byref counts as const build.ResultCounts )
    declare sub OpenDiagnostic( byval i as long )
    declare sub StepDiagnostic( byval forward as boolean )
    declare sub RunProgram( byref exe as const ustring )
    declare sub ShowOutput( byval visible as boolean )
    declare sub CycleFocus( )
    declare function OutputHasFocus( ) as boolean
    declare sub JumpTo( byref file as const ustring, byval ln as long, byval col as long, byval selChars as long )
    declare sub CaptureState( byref st as session.SessionState, byref base_ as const ustring )
    declare sub ApplyState( byref st as const session.SessionState, byref base_ as const ustring )

    ' ---- code intelligence
    declare function PkgDir( ) as ustring
    declare function StartScanner( ) as boolean
    declare sub QueueScan( byval d as DocRef )
    declare sub PollScans( )
    declare function ProcsOf( byval d as DocRef ) as Array( of SymHit )
    declare function Here( ) as navhistory.NavEntry
    declare sub GoHistory( byval forward as boolean )
    declare function ScannedFile( byref upper as const ustring ) as ustring
    declare function GoToDefinition( ) as boolean
    declare sub GoFunction( byval forward as boolean )
    declare sub CodeTips( byval hEdit as TK_WIDGET ptr, byval ch as long )
    declare sub ShowCompletionsAt( byval v as editor.CodeView ptr, byval d as DocRef, byval minLen as long )

    ' ---- P6: the formatter, Find in Project
    declare function FormatDocument( ) as boolean
    declare function RunProjectSearch( ) as long
    declare sub OpenSearchHit( byval i as long )
    declare sub GoToCompanion( byval header as boolean )

    ' ---- the chooser popup
    declare sub OpenChooser( byval kind as PickKind )
    declare sub Chosen( byval tag as long )
    declare function DocOfWidget( byval w as TK_WIDGET ptr ) as DocRef
    declare sub ShowEditMenu( byval hEdit as TK_WIDGET ptr, byval x as long, byval y as long )

  private:
    declare sub RebuildAccelerators( )
    declare sub AfterSave( byval d as DocRef )
    declare function FontFile( ) as ustring
    declare function NewView( byref v as editor.CodeView ) as boolean
    declare sub Touch( byval d as DocRef )
    declare sub SyncFocus( )
end type

private function WindowOfHost( byval h as TK_HOST ptr ) as Window ptr
    dim as TK_FORM ptr f = tkForm_FromHost( h )
    if f = 0 then return 0
    return f->Tag
end function

private function WindowOfWidget( byval w as TK_WIDGET ptr ) as Window ptr
    dim as TK_FORM ptr f = tkForm_FromWidget( w )
    if f = 0 then return 0
    return f->Tag
end function

function Window.Create( byval forcedScale as single ) as boolean
    if Ask = 0 then Ask = @AskPerson
    if Pick = 0 then Pick = @PickPerson
    if Launch = 0 then Launch = @LaunchProgram
    ResourceDir = platform.ResourceDir( ).ValueOr( platform.ExeDir( ) )
    if len( ConfigDir ) = 0 then ConfigDir = platform.ConfigDir( ).ValueOr( fs.PathJoin( ResourceDir, "config" ) )
    Words = LoadKeywords( ResourceDir )

    Prefs = settings.DefaultSettings( )
    Theme = themes.DarkTheme( )

    form = tkApp_NewForm( appinfo.WindowTitle( ), DEFAULT_CX, DEFAULT_CY, 0, forcedScale )
    if form = 0 then return false
    form->Tag = @this
    ' the title bar's icon, every platform; on Windows the .exe's own (res/tkEdit.rc) is the taskbar's
    ' and Explorer's, and SDL starts from it
    dim as string icon8 = fs.PathJoin( ResourceDir, "icons", "tkedit.png" )
    dim as SDL_Surface ptr icon = IMG_Load( strptr( icon8 ) )
    if icon then
        HasIcon = SDL_SetWindowIcon( tkForm_Host( form )->win, icon )
        SDL_DestroySurface( icon )
    end if
    dim as TK_WIDGET ptr root = tkForm_Widget( form )

    status = tkStatusBar_Create( root, ID_STATUS )
    for i as long = StatusPanel.Buffer to StatusPanel.LineEnding
        tkStatusBar_AddPanel( status, "" )
    next
    tkStatusBar_SetExpandPanel( status, StatusPanel.Message )
    tkStatusBar_SetClickCallback( status, sub( byval hBar as TK_WIDGET ptr, byval idx as long, byval clicks as long )
        dim as Window ptr mw = WindowOfWidget( hBar )
        if mw = 0 then exit sub
        select case idx
        case StatusPanel.Buffer : mw->OpenChooser( PickKind.Buffers )
        case StatusPanel.Message : mw->Execute( Cmd.OutputPane )
        case StatusPanel.Position
            if mw->Finder.isOpen andalso (mw->Finder.Mode = findstrip.StripMode.GoTo) then
                mw->OnFind( findstrip.FindAction.CloseStrip )
            else
                mw->Execute( Cmd.GoToLine )
            end if
        case StatusPanel.Build : mw->OpenChooser( PickKind.Build )
        case StatusPanel.Encoding : mw->OpenChooser( PickKind.Encoding )
        case StatusPanel.LineEnding : mw->OpenChooser( PickKind.LineEnding )
        end select
    end sub )
    tkStatusBar_SetTooltipCallback( status, function( byval hBar as TK_WIDGET ptr, byval idx as long ) as ustring
        dim as Window ptr mw = WindowOfWidget( hBar )
        if mw = 0 then return ""
        return mw->StatusTip( cast( StatusPanel, idx ) )
    end function )

    ' a view's right-click menu: commands by id, through Execute like their keys
    editMenu = tkPopupMenu_Create( tkForm_Host( form ) )
    tkPopupMenu_AddItem( editMenu, clng( Cmd.Undo ), "Undo" )
    tkPopupMenu_AddItem( editMenu, clng( Cmd.Redo ), "Redo" )
    tkPopupMenu_AddSeparator( editMenu )
    tkPopupMenu_AddItem( editMenu, clng( Cmd.Cut ), "Cut" )
    tkPopupMenu_AddItem( editMenu, clng( Cmd.Copy ), "Copy" )
    tkPopupMenu_AddItem( editMenu, clng( Cmd.Paste ), "Paste" )
    tkPopupMenu_AddSeparator( editMenu )
    tkPopupMenu_AddItem( editMenu, clng( Cmd.IndentBlock ), "Indent Block" )
    tkPopupMenu_AddItem( editMenu, clng( Cmd.UnindentBlock ), "UnIndent Block" )
    tkPopupMenu_AddSeparator( editMenu )
    tkPopupMenu_AddItem( editMenu, clng( Cmd.CommentBlock ), "Comment Block" )
    tkPopupMenu_AddItem( editMenu, clng( Cmd.UncommentBlock ), "UnComment Block" )
    tkPopupMenu_AddSeparator( editMenu )
    tkPopupMenu_AddItem( editMenu, clng( Cmd.SelectAll ), "Select All" )
    tkPopupMenu_SetSelectCallback( editMenu, sub( byval hPopup as TK_MENU ptr, byval id as long )
        dim as Window ptr mw = WindowOfHost( hPopup->pOwner )
        if mw then mw->Execute( cast( Cmd, id ) )
    end sub )

    Out.Create( root, ID_OUTPUT, @this )
    Out.OnActivate = sub( byval owner as any ptr, byval tab_ as outputpane.OutputTab, byval itemIndex as long )
        dim as Window ptr mw = owner
        if tab_ = outputpane.OutputTab.Search then
            mw->OpenSearchHit( itemIndex )
        else
            mw->OpenDiagnostic( itemIndex )
        end if
    end sub
    Finder.Create( root, ID_FINDSTRIP, @this )
    Finder.OnAction = sub( byval owner as any ptr, byval a as findstrip.FindAction )
        cast( Window ptr, owner )->OnFind( a )
    end sub

    this.ReloadSettings( )                      ' the theme and the look with it
    this.SyncSettingsFile( )
    this.ReloadKeys( )                          ' the accelerators with them
    this.SyncKeysFile( )                        ' after: what it warned about stays in the status line
    CurrentBuild = Prefs.DefaultBuild( )
    if NoParser = false then this.StartScanner( )

    dim as DocRef d = this.NewDocument( )
    if d = 0 then return false
    Pane1 = d
    this.Touch( d )

    tkForm_OnSize( form, sub( byval f as TK_FORM ptr, byval cx as long, byval cy as long )
        cast( Window ptr, f->Tag )->Layout( )
    end sub )
    tkForm_OnScaleChanged( form, sub( byval f as TK_FORM ptr, byval fOld as single, byval fNew as single )
        dim as Window ptr mw = f->Tag
        mw->ApplyLook( )                         ' margins are pixels
        mw->Layout( )
    end sub )
    tkForm_OnClose( form, function( byval f as TK_FORM ptr ) as boolean
        dim as Window ptr mw = f->Tag
        mw->SaveSession( )
        if mw->ProjOpen then mw->SaveProject( )
        return mw->CloseAll( )
    end function )
    dim as TK_HOST ptr h = tkForm_Host( form )
    h->OnPreKey = function( byval h as TK_HOST ptr, byval m as TK_MSG ptr ) as boolean
        dim as Window ptr mw = WindowOfHost( h )
        if (mw = 0) orelse (mw->accel = 0) then return false
        ' Esc closes the find strip wherever the focus is -- after a view's own completion list or
        ' calltip, which Esc closes first
        if (m->key = SDLK_ESCAPE) andalso mw->Finder.isOpen then
            if mw->DocOfWidget( tkHost_GetFocus( h ) ) then
                if mw->View( ).CompletionsShown( ) orelse mw->View( ).CallTipShown( ) then return false
            end if
            mw->OnFind( findstrip.FindAction.CloseStrip )
            return true
        end if
        dim as Cmd id = cast( Cmd, tkKeys_Lookup( mw->accel, tkKeys_FromMsg( m ) ) )
        if id = Cmd.None then return false
        select case id
        case Cmd.IndentBlock, Cmd.UnindentBlock
            return false                        ' Scintilla's own Tab and Shift+Tab
        end select
        ' the Edit group's keys belong to a text field when one has the focus (the find strip)
        if (mw->DocOfWidget( tkHost_GetFocus( h ) ) = 0) andalso _
           (mw->Keys.Commands( ).Info( id ).Group = MenuGroup.Edit) then return false
        mw->Execute( id )
        return true
    end function
    h->OnDrop = sub( byval h as TK_HOST ptr, byval m as TK_MSG ptr )
        dim as Window ptr mw = WindowOfHost( h )
        if (mw = 0) orelse (m->msg <> TKM_DROPFILES) then exit sub
        for each p as ustring in strings.Split( m->text, !"\n" )
            dim as ustring f = trim( p, any !" \r" )
            if len( f ) andalso fs.IsFile( f ) then mw->OpenFile( f )
        next
    end sub
    diskTimer = tkApp_SetTimer( DISK_CHECK_MS, sub( byval id as long, byval payload as any ptr )
        cast( Window ptr, payload )->CheckDisk( )
    end sub, @this )
    this.Layout( )
    this.ShowTitle( )
    this.ShowStatus( )
    return true
end function

sub Window.Show( )
    if form = 0 then exit sub
    tkForm_Show( form )
    this.View( ).Focus( )
end sub

sub Window.Destroy( )
    if diskTimer then tkApp_KillTimer( diskTimer )
    diskTimer = 0
    if buildTimer then tkApp_KillTimer( buildTimer )
    buildTimer = 0
    Job.Finish( )
    if scanTimer then tkApp_KillTimer( scanTimer )
    scanTimer = 0
    Scanner.Stop( )
    Chooser.Close( )
    for each d as DocRef in Docs
        d->DestroyViews( )
        delete d
    next
    Docs.Clear( )
    Mru.Clear( )
    Pane1 = 0
    Pane2 = 0
    if accel then tkKeys_MapDestroy( accel )
    accel = 0
    if editMenu then tkPopupMenu_Destroy( editMenu )
    editMenu = 0
    if form then tkForm_Destroy( form )
    form = 0
end sub

function Window.StatusHeight( ) as long
    return tkForm_Scale( form, STATUS_CY )
end function

function Window.BottomHeight( ) as long
    if Finder.isOpen then return this.StatusHeight( ) + Finder.Height( )
    return this.StatusHeight( )
end function

function Window.OutputHeight( ) as long
    if OutputShown = false then return 0
    return tkForm_Scale( form, outputpane.PANE_CY )
end function

' The pane(s), the output pane, the find strip (while open), one status row at the bottom. Every
' view no pane shows is hidden.
sub Window.Layout( )
    if form = 0 then exit sub
    dim as TK_WIDGET ptr root = tkForm_Widget( form )
    dim as long cx = root->cw, cy = root->ch
    dim as long sh = this.StatusHeight( )
    tkWidget_SetPos( status, 0, cy - sh, cx, sh )
    if Finder.isOpen then
        dim as long fh = Finder.Height( )        ' the strip sits on top of the status line (D10)
        tkWidget_SetPos( Finder.frame, 0, cy - sh - fh, cx, fh )
        sh += fh
    end if
    dim as long oh = 0
    if OutputShown then
        oh = tkForm_Scale( form, outputpane.PANE_CY )
        tkWidget_SetPos( Out.frame, 0, cy - sh - oh, cx, oh )
    end if
    tkWidget_Show( Out.frame, OutputShown )
    dim as long top = 0, ah = cy - sh - oh
    dim as TK_WIDGET ptr v1 = 0, v2 = 0
    if Pane1 then v1 = Pane1->Main.Widget( )
    if (Split <> session.SplitMode.None) andalso (Pane2 <> 0) then v2 = Pane2->Other.Widget( )
    for each d as DocRef in Docs
        if d->Main.Exists( ) andalso (d->Main.Widget( ) <> v1) then tkWidget_Show( d->Main.Widget( ), false )
        if d->Other.Exists( ) andalso (d->Other.Widget( ) <> v2) then tkWidget_Show( d->Other.Widget( ), false )
    next
    if v1 = 0 then exit sub
    tkWidget_Show( v1, true )
    if v2 = 0 then
        tkWidget_SetPos( v1, 0, top, cx, ah )
        if splitBar then tkWidget_Show( splitBar, false )
        exit sub
    end if
    dim as long bar = tkForm_Scale( form, SPLIT_BAR )
    tkWidget_Show( v2, true )
    if Split = session.SplitMode.Vertical then
        dim as long w1 = cint( (cx - bar) * SplitRatio )
        tkWidget_SetPos( v1, 0, top, w1, ah )
        tkWidget_SetPos( splitBar, w1, top, bar, ah )
        tkWidget_SetPos( v2, w1 + bar, top, cx - w1 - bar, ah )
        tkSplitter_SetRange( splitBar, tkForm_Scale( form, 60 ), cx - bar - tkForm_Scale( form, 60 ) )
    else
        dim as long h1 = cint( (ah - bar) * SplitRatio )
        tkWidget_SetPos( v1, 0, top, cx, h1 )
        tkWidget_SetPos( splitBar, 0, top + h1, cx, bar )
        tkWidget_SetPos( v2, 0, top + h1 + bar, cx, ah - h1 - bar )
        tkSplitter_SetRange( splitBar, top + tkForm_Scale( form, 40 ), top + ah - bar - tkForm_Scale( form, 40 ) )
    end if
    tkWidget_Show( splitBar, true )
end sub

sub Window.SetMessage( byref s as const ustring )
    Message = s
    this.ShowStatus( )
end sub

sub Window.ShowStatus( )
    if status = 0 then exit sub
    this.SyncFocus( )
    dim as DocRef d = this.Active( )
    if d = 0 then exit sub
    dim as editor.CodeView ptr v = @this.View( )
    dim as ustring name_ = d->DisplayName( )
    if d->IsModified( ) then name_ &= " *"
    tkStatusBar_SetText( status, StatusPanel.Buffer, name_ )
    tkStatusBar_SetText( status, StatusPanel.Message, Message )
    tkStatusBar_SetText( status, StatusPanel.Position, _
                         strings.Format( "Ln {}, Col {}", v->CaretLine( ), v->CaretColumn( ) ) )
    tkStatusBar_SetText( status, StatusPanel.Build, CurrentBuild )
    tkStatusBar_SetText( status, StatusPanel.Encoding, docencoding.EncodingName( d->Enc.Encoding ) )
    dim as ustring eol = "CRLF"
    select case v->LineEnding( )
    case docencoding.LineEnd.Lf : eol = "LF"
    case docencoding.LineEnd.Cr : eol = "CR"
    end select
    tkStatusBar_SetText( status, StatusPanel.LineEnding, eol )
end sub

sub Window.ShowTitle( )
    if form = 0 then exit sub
    dim as DocRef d = this.Active( )
    dim as ustring title = appinfo.WindowTitle( )
    if d then
        dim as ustring nm = d->DisplayName( )
        if ProjOpen then nm &= " [" & Proj.Name( ) & "]"
        title = appinfo.WindowTitle( nm )
    end if
    dim as string t8 = title
    SDL_SetWindowTitle( tkForm_Host( form )->win, strptr( t8 ) )
end sub

function Window.StatusText( byval p as StatusPanel ) as ustring
    if status = 0 then return ""
    return tkStatusBar_GetText( status, p )
end function

' The buffer panel's tooltip: the active buffer's full path (its name while untitled).
function Window.StatusTip( byval p as StatusPanel ) as ustring
    if p <> StatusPanel.Buffer then return ""
    dim as DocRef d = this.Active( )
    if d = 0 then return ""
    if len( d->Path ) then return d->Path
    return d->DisplayName( )
end function

' ================================================================ commands

function Window.ShortcutText( byval id as Cmd ) as ustring
    dim as ustring t = Keys.Effective( id )
    if len( t ) = 0 then return ""
    dim as keybind.ChordResult r = Keys.Vocab( ).ParseChord( t )
    if r.IsOk( ) = false then return ""
    return r.Value( ).ToDisplay( )
end function

' What this phase can do; the rest says so when its key is pressed.
function Window.IsImplemented( byval id as Cmd ) as boolean
    select case id
    case Cmd.FileNew, Cmd.FileOpen, Cmd.FileRecent, Cmd.FileClose, Cmd.FileCloseAll, Cmd.FileSave, _
         Cmd.FileSaveAs, Cmd.FileSaveAll, Cmd.Settings, Cmd.KeyboardShortcuts, Cmd.ThemeFile, Cmd.AppExit
        return true
    case Cmd.Undo, Cmd.Redo, Cmd.Cut, Cmd.Copy, Cmd.Paste, Cmd.SelectAll, Cmd.SelectLine, _
         Cmd.DeleteLine, Cmd.DuplicateLine, Cmd.MoveLineUp, Cmd.MoveLineDown, Cmd.NewLineBelowCurrent, _
         Cmd.CommentBlock, Cmd.UncommentBlock, Cmd.IndentBlock, Cmd.UnindentBlock, _
         Cmd.ToUpperCase, Cmd.ToLowerCase, Cmd.ToMixedCase
        return true
    case Cmd.BufferList, Cmd.BufferNext, Cmd.BufferPrev, Cmd.SplitLeftRight, _
         Cmd.SplitTopBottom, Cmd.CycleFocus, Cmd.ZoomIn, Cmd.ZoomOut, Cmd.ZoomReset, Cmd.FoldToggle, _
         Cmd.FoldBelow, Cmd.FoldAll, Cmd.UnfoldAll, Cmd.BuildConfig
        return true
    case Cmd.FormatDocument, Cmd.FindInProject, Cmd.GoToHeader, Cmd.GoToSource, Cmd.GoToMain
        return true
    case Cmd.CompleteWord, Cmd.GoToDefinition, Cmd.GoBack, Cmd.GoForward, Cmd.GoToNextFunction, _
         Cmd.GoToPrevFunction, Cmd.SearchSymbol, Cmd.FunctionList
        return true
    case Cmd.OutputPane, Cmd.BuildExecute, Cmd.Compile, Cmd.RebuildAll, Cmd.CompileModule, Cmd.QuickRun, _
         Cmd.RunExe, Cmd.NextDiagnostic, Cmd.PrevDiagnostic, Cmd.ProjectNew, Cmd.ProjectOpen, Cmd.ProjectSave, _
         Cmd.ProjectClose, Cmd.ProjectFilesAdd
        return true
    case Cmd.Find, Cmd.Replace, Cmd.FindNext, Cmd.FindPrev, Cmd.ReplaceOne, Cmd.GoToLine, _
         Cmd.BookmarkToggle, Cmd.BookmarkNext, Cmd.BookmarkPrev, Cmd.BookmarkClearAll, Cmd.BookmarksList
        return true
    end select
    return false
end function

function Window.Execute( byval id as Cmd ) as boolean
    if this.IsImplemented( id ) = false then
        dim as cmdids.CommandInfo ci = Keys.Commands( ).Info( id )
        this.SetMessage( ci.Description & ": not available yet" )
        return false
    end if
    this.SyncFocus( )
    dim as editor.CodeView ptr v = @this.View( )
    select case id
    case Cmd.FileNew
        dim as DocRef d = this.NewDocument( )
        if d then this.ShowDoc( d )
    case Cmd.FileOpen
        dim as ustring dir_ = ""
        if len( this.ActivePath( ) ) then dir_ = fs.PathParent( this.ActivePath( ) )
        dim as ustring p = Pick( form, TKFD_OPEN, dir_ )
        if len( p ) then this.OpenFile( p )
    case Cmd.FileRecent : this.OpenChooser( PickKind.Recent )
    case Cmd.FileClose : this.CloseDoc( this.Active( ) )
    case Cmd.FileCloseAll : this.CloseAll( )
    case Cmd.FileSave : this.SaveDoc( this.Active( ), false )
    case Cmd.FileSaveAs : this.SaveDoc( this.Active( ), true )
    case Cmd.FileSaveAll : this.SaveAll( )
    case Cmd.Settings
        if this.FindOpen( this.SettingsFile( ) ) = 0 then this.SyncSettingsFile( )   ' never under an open buffer
        this.OpenFile( this.SettingsFile( ) )
    case Cmd.KeyboardShortcuts
        if this.FindOpen( this.KeysFile( ) ) = 0 then this.SyncKeysFile( )           ' never under an open buffer
        this.OpenFile( this.KeysFile( ) )
    case Cmd.ThemeFile
        dim as ustring f = this.EditableThemeFile( )
        if len( f ) then this.OpenFile( f )
    case Cmd.AppExit : tkForm_Close( form )
    case Cmd.BufferList : this.OpenChooser( PickKind.Buffers )
    case Cmd.BufferNext : this.CycleBuffer( true )
    case Cmd.BufferPrev : this.CycleBuffer( false )
    case Cmd.SplitLeftRight : this.ToggleSplit( session.SplitMode.Vertical )
    case Cmd.SplitTopBottom : this.ToggleSplit( session.SplitMode.Horizontal )
    case Cmd.CycleFocus : this.CycleFocus( )
    case Cmd.FormatDocument : this.FormatDocument( )
    case Cmd.GoToHeader : this.GoToCompanion( true )
    case Cmd.GoToSource : this.GoToCompanion( false )
    case Cmd.GoToMain
        if ProjOpen andalso (len( Proj.MainPath( ) ) > 0) then
            this.JumpTo( Proj.MainPath( ), -1, 0, 0 )
        else
            this.SetMessage( "no project main file" )
        end if
    case Cmd.FindInProject : this.OpenStrip( findstrip.StripMode.Project )
    case Cmd.CompleteWord : this.ShowCompletionsAt( v, this.Active( ), 0 )
    case Cmd.GoToDefinition : this.GoToDefinition( )
    case Cmd.GoBack : this.GoHistory( false )
    case Cmd.GoForward : this.GoHistory( true )
    case Cmd.GoToNextFunction : this.GoFunction( true )
    case Cmd.GoToPrevFunction : this.GoFunction( false )
    case Cmd.SearchSymbol : this.OpenChooser( PickKind.Symbols )
    case Cmd.FunctionList
        FuncsAll = false
        this.OpenChooser( PickKind.Functions )
    case Cmd.OutputPane : this.ShowOutput( OutputShown = false )
    case Cmd.Compile : this.StartBuild( build.BuildAction.Compile )
    case Cmd.BuildExecute : this.StartBuild( build.BuildAction.BuildExecute )
    case Cmd.RebuildAll : this.StartBuild( build.BuildAction.Compile, true )
    case Cmd.CompileModule : this.StartBuild( build.BuildAction.CompileModule )
    case Cmd.QuickRun : this.StartBuild( build.BuildAction.QuickRun )
    case Cmd.RunExe
        if len( LastExe ) = 0 then LastExe = build.OutputFile( this.ActivePath( ), "", platform.CurrentOs( ) )
        this.RunProgram( LastExe )
    case Cmd.NextDiagnostic : this.StepDiagnostic( true )
    case Cmd.PrevDiagnostic : this.StepDiagnostic( false )
    case Cmd.ProjectNew : this.NewProject( )
    case Cmd.ProjectOpen
        dim as ustring dir_ = ""
        if len( this.ActivePath( ) ) then dir_ = fs.PathParent( this.ActivePath( ) )
        dim as ustring pp = Pick( form, TKFD_OPEN, dir_ )
        if len( pp ) then this.OpenProject( pp )
    case Cmd.ProjectSave : this.SaveProject( )
    case Cmd.ProjectClose : this.CloseProject( )
    case Cmd.ProjectFilesAdd : this.AddToProject( )
    case Cmd.BuildConfig : this.OpenChooser( PickKind.Build )
    case Cmd.Find : this.OpenStrip( findstrip.StripMode.Find )
    case Cmd.Replace : this.OpenStrip( findstrip.StripMode.Replace )
    case Cmd.GoToLine : this.OpenStrip( findstrip.StripMode.GoTo )
    case Cmd.FindNext : this.OnFind( findstrip.FindAction.NextMatch )
    case Cmd.FindPrev : this.OnFind( findstrip.FindAction.PrevMatch )
    case Cmd.ReplaceOne
        if Finder.isOpen andalso (Finder.Mode = findstrip.StripMode.Replace) then this.OnFind( findstrip.FindAction.ReplaceOne )
    case Cmd.BookmarkToggle : v->ToggleBookmark( v->CaretLine( ) - 1 )
    case Cmd.BookmarkNext : v->NextBookmark( true )
    case Cmd.BookmarkPrev : v->NextBookmark( false )
    case Cmd.BookmarkClearAll : v->ClearBookmarks( )
    case Cmd.BookmarksList : this.OpenChooser( PickKind.Bookmarks )
    case Cmd.Undo : v->Undo( )
    case Cmd.Redo : v->Redo( )
    case Cmd.Cut : v->Cut( )
    case Cmd.Copy : v->Copy( )
    case Cmd.Paste : v->Paste( )
    case Cmd.SelectAll : v->SelectAll( )
    case Cmd.SelectLine : v->SelectLine( )
    case Cmd.DeleteLine : v->DeleteLine( )
    case Cmd.DuplicateLine : v->DuplicateLine( )
    case Cmd.MoveLineUp : v->MoveLinesUp( )
    case Cmd.MoveLineDown : v->MoveLinesDown( )
    case Cmd.NewLineBelowCurrent : v->NewLineBelow( )
    case Cmd.CommentBlock : v->CommentLines( true )
    case Cmd.UncommentBlock : v->CommentLines( false )
    case Cmd.IndentBlock : v->Indent( )
    case Cmd.UnindentBlock : v->Unindent( )
    case Cmd.ToUpperCase : v->UpperCaseSelection( )
    case Cmd.ToLowerCase : v->LowerCaseSelection( )
    case Cmd.ToMixedCase : v->MixedCaseSelection( )
    case Cmd.ZoomIn : v->ZoomIn( )
    case Cmd.ZoomOut : v->ZoomOut( )
    case Cmd.ZoomReset : v->ZoomReset( )
    case Cmd.FoldToggle : v->FoldToggle( false )
    case Cmd.FoldBelow : v->FoldToggle( true )
    case Cmd.FoldAll : v->FoldAll( true )
    case Cmd.UnfoldAll : v->FoldAll( false )
    end select
    this.ShowStatus( )
    return true
end function

' ================================================================ accelerators

sub Window.RebuildAccelerators( )
    if accel = 0 then accel = tkKeys_MapCreate( )
    tkKeys_Clear( accel )
    for i as long = 0 to Keys.Count( ) - 1
        dim as ustring eff = Keys.Item( i ).Effective( )
        if len( eff ) = 0 then continue for
        ' two commands on one chord: the first in the table keeps it (keybind.OwnerOf's rule)
        dim as string t = eff
        dim as TK_CHORD c
        if tkKeys_Parse( t, c ) andalso (tkKeys_Lookup( accel, c ) = 0) then tkKeys_Bind( accel, c, Keys.Item( i ).Id )
    next
end sub

' ================================================================ configuration

function Window.SettingsFile( ) as ustring
    return fs.PathJoin( ConfigDir, settings.SETTINGS_FILE )
end function

function Window.KeysFile( ) as ustring
    return fs.PathJoin( ConfigDir, keybind.KEYBINDINGS_FILE )
end function

function Window.SessionFile( ) as ustring
    return fs.PathJoin( ConfigDir, session.SESSION_FILE )
end function

function Window.FontFile( ) as ustring
    if (len( Prefs.Font ) > 0) andalso fs.IsFile( Prefs.Font ) then return Prefs.Font
    return fs.PathJoin( ResourceDir, "fonts", FONT_MONO )
end function

sub Window.ApplyLook( )
    Look = chrome.LookOf( Theme, Prefs, Words, this.FontFile( ) )
    for each d as DocRef in Docs
        d->Main.ApplyLook( Look )
        if d->Other.Exists( ) then d->Other.ApplyLook( Look )
    next
end sub

' settings.toml, then the theme it names. A file that does not parse changes nothing.
sub Window.ReloadSettings( )
    dim as settings.SettingsResult r = settings.LoadSettings( this.SettingsFile( ) )
    if r.IsOk( ) then
        Prefs = r.Value( )
        Message = ""
    else
        Message = strings.Format( "{}:{}: {}", settings.SETTINGS_FILE, r.Failure( ).Line( ), r.Failure( ).Detail( ) )
    end if
    dim as boolean known = false
    for each b as settings.BuildConfig in Prefs.Builds
        if b.Name = CurrentBuild then known = true
    next
    if known = false then CurrentBuild = Prefs.DefaultBuild( )
    this.ReloadTheme( )
    this.ShowStatus( )
end sub

' settings.toml rewritten to list every key at the value it reads as, unless it does already. A
' file that does not parse is the person's to fix, and is left alone.
sub Window.SyncSettingsFile( )
    dim as settings.SettingsResult r = settings.LoadSettings( this.SettingsFile( ) )
    if r.IsOk( ) then settings.WriteFile( this.SettingsFile( ), r.Value( ) )
end sub

' keybindings.toml rewritten to list every command at the chord in force, unless it does already
' (first run: written). A file that does not load is the person's to fix, and is left alone.
sub Window.SyncKeysFile( )
    dim as keybind.KeyMap k
    if k.Load( this.KeysFile( ) ).IsOk( ) = false then exit sub
    dim as keybind.TextResult t = k.ToToml( )
    if t.IsOk( ) = false then exit sub
    if fs.IsFile( this.KeysFile( ) ) andalso (fs.ReadAllText( this.KeysFile( ) ).ValueOr( "" ) = t.Value( )) then exit sub
    k.Save( this.KeysFile( ) )
end sub

' keybindings.toml: the key map and the accelerators; warnings and chords
' two commands share go to the message panel.
sub Window.ReloadKeys( )
    dim as keybind.WarningsResult r = Keys.Load( this.KeysFile( ) )
    dim as Array( of ustring ) notes
    if r.IsOk( ) = false then
        notes.Push( r.Failure( ) )
    else
        notes = r.Value( )
    end if
    for i as long = 0 to Keys.Count( ) - 1
        dim as ustring eff = Keys.Item( i ).Effective( )
        if len( eff ) = 0 then continue for
        dim as Optional( of Cmd ) o = Keys.OwnerOf( eff, Keys.Item( i ).Id )
        if o.HasValue( ) andalso (clng( o.Value( ) ) < clng( Keys.Item( i ).Id )) then
            notes.Push( strings.Format( "{} and {} share {}", Keys.Commands( ).Info( o.Value( ) ).Name, Keys.Item( i ).Name, eff ) )
        end if
    next
    this.RebuildAccelerators( )
    if notes.Count( ) = 0 then
        Message = ""
    elseif notes.Count( ) = 1 then
        Message = keybind.KEYBINDINGS_FILE & ": " & notes[0]
    else
        Message = strings.Format( "{}: {} (+{} more)", keybind.KEYBINDINGS_FILE, notes[0], notes.Count( ) - 1 )
    end if
    this.ShowStatus( )
end sub

' The theme settings.toml names: the user's copy, else the shipped one, else the built-in dark.
sub Window.ReloadTheme( )
    dim as ustring path = themes.FindTheme( Prefs.Theme, ConfigDir, ResourceDir )
    if len( path ) = 0 then
        Theme = themes.DarkTheme( )
        if lcase( Prefs.Theme ) <> themes.DEFAULT_THEME then Message = "theme '" & Prefs.Theme & "' not found; using dark"
    else
        dim as themes.ThemeResult r = themes.LoadTheme( path, Prefs.Theme )
        if r.IsOk( ) then
            Theme = r.Value( )
            if Theme.Warnings.Count( ) > 0 then
                Message = strings.Format( "{}.toml: {}", Prefs.Theme, Theme.Warnings[0] )
            end if
        else
            Message = r.Failure( )
        end if
    end if
    tkApp_SetTheme( chrome.PaletteOf( Theme ) )
    this.ApplyLook( )
    tkForm_Invalidate( form )
end sub

' The active theme as a file the user may edit: <config>/themes/<name>.toml, copied from the
' shipped one (or the built-in dark's file) the first time.
function Window.EditableThemeFile( ) as ustring
    dim as ustring dir_ = fs.PathJoin( ConfigDir, themes.THEME_DIR )
    dim as ustring mine = fs.PathJoin( dir_, Prefs.Theme & ".toml" )
    if fs.IsFile( mine ) then return mine
    dim as ustring shipped = themes.FindTheme( Prefs.Theme, "", ResourceDir )
    if len( shipped ) = 0 then shipped = themes.FindTheme( themes.DEFAULT_THEME, "", ResourceDir )
    if len( shipped ) = 0 then
        this.SetMessage( "no theme file to copy" )
        return ""
    end if
    fs.CreateDirAll( dir_ )
    if fs.CopyFile( shipped, mine ).IsOk( ) = false then
        this.SetMessage( "cannot write " & mine )
        return ""
    end if
    return mine
end function

' A saved config file is applied at once (D15).
sub Window.AfterSave( byval d as DocRef )
    dim as ustring p = lcase( d->Path )
    if p = lcase( this.SettingsFile( ) ) then
        this.ReloadSettings( )
    elseif p = lcase( this.KeysFile( ) ) then
        this.ReloadKeys( )
    elseif (p = lcase( Theme.Path )) orelse _
           (p = lcase( fs.PathJoin( ConfigDir, themes.THEME_DIR, Prefs.Theme & ".toml" ) )) then
        this.ReloadTheme( )                     ' the active theme, or the user's new copy of it
    end if
end sub

' ================================================================ buffers and panes

' The second pane's focus follows the keyboard focus whenever it sits in one of the panes.
sub Window.SyncFocus( )
    if form = 0 then exit sub
    dim as TK_WIDGET ptr f = tkHost_GetFocus( tkForm_Host( form ) )
    if f = 0 then exit sub
    if Pane1 andalso (f = Pane1->Main.Widget( )) then InPane2 = false
    if Pane2 andalso Pane2->Other.Exists( ) andalso (f = Pane2->Other.Widget( )) then InPane2 = true
end sub

function Window.Active( ) as DocRef
    if InPane2 andalso (Pane2 <> 0) andalso (Split <> session.SplitMode.None) then return Pane2
    return Pane1
end function

function Window.View( ) byref as editor.CodeView
    if InPane2 andalso (Pane2 <> 0) andalso (Split <> session.SplitMode.None) then return Pane2->Other
    return Pane1->Main
end function

function Window.ActivePath( ) as ustring
    dim as DocRef d = this.Active( )
    if d = 0 then return ""
    return d->Path
end function

function Window.DocOfWidget( byval w as TK_WIDGET ptr ) as DocRef
    if w = 0 then return 0
    for each d as DocRef in Docs
        if d->HasView( w ) then return d
    next
    return 0
end function

' A Scintilla view, styled, reporting caret moves to the status line; hidden until a pane shows it.
function Window.NewView( byref v as editor.CodeView ) as boolean
    viewIds += 1
    if v.Create( tkForm_Widget( form ), ID_VIEW + viewIds ) = false then return false
    v.ApplyLook( Look )
    tkCodeEdit_SetNotifyCallback( v.Widget( ), sub( byval h as TK_WIDGET ptr, byval n as const TKCE_NOTIFICATION ptr )
        dim as Window ptr mw = WindowOfWidget( h )
        if mw = 0 then exit sub
        select case n->code
        case SCN_UPDATEUI : mw->ShowStatus( )
        case SCN_CHARADDED
            mw->OnCharAdded( h, n->ch )
            mw->CodeTips( h, n->ch )
        case SCN_MODIFIED
            if (n->modificationType and (SC_MOD_INSERTTEXT or SC_MOD_DELETETEXT)) then
                mw->scanDirty = true
                mw->lastEditTicks = SDL_GetTicks( )
            end if
        case SCN_MARGINCLICK : mw->OnMarginClick( h, n->margin, n->position )
        end select
    end sub )
    tkCodeEdit_SetContextMenuCallback( v.Widget( ), sub( byval hEdit as TK_WIDGET ptr, byval x as long, byval y as long )
        dim as Window ptr mw = WindowOfWidget( hEdit )
        if mw then mw->ShowEditMenu( hEdit, x, y )
    end sub )
    tkWidget_Show( v.Widget( ), false )
    return true
end function

' The right-click menu at x, y in hEdit, for hEdit's pane: what cannot be done now is greyed.
sub Window.ShowEditMenu( byval hEdit as TK_WIDGET ptr, byval x as long, byval y as long )
    if (editMenu = 0) orelse (this.DocOfWidget( hEdit ) = 0) then exit sub
    tkHost_SetFocus( tkForm_Host( form ), hEdit )
    this.SyncFocus( )
    dim as editor.CodeView ptr v = @this.View( )
    dim as boolean sel = v->SelectionLength( ) > 0
    tkPopupMenu_SetItemEnabled( editMenu, clng( Cmd.Undo ), v->CanUndo( ) )
    tkPopupMenu_SetItemEnabled( editMenu, clng( Cmd.Redo ), v->CanRedo( ) )
    tkPopupMenu_SetItemEnabled( editMenu, clng( Cmd.Cut ), sel )
    tkPopupMenu_SetItemEnabled( editMenu, clng( Cmd.Copy ), sel )
    tkPopupMenu_SetItemEnabled( editMenu, clng( Cmd.Paste ), v->CanPaste( ) )
    dim as TKRECT a
    tkWidget_AbsRect( hEdit, a )
    tkPopupMenu_Show( editMenu, a.left + x, a.top + y )
end sub

' d is the most recently shown buffer now.
sub Window.Touch( byval d as DocRef )
    for i as long = 0 to Mru.Count( ) - 1
        if Mru[i] = d then
            Mru.Remove( i )
            exit for
        end if
    next
    Mru.Insert( 0, d )
end sub

' An empty untitled buffer, not shown yet.
function Window.NewDocument( ) as DocRef
    dim as DocRef d = new documents.Document
    if this.NewView( d->Main ) = false then
        delete d
        return 0
    end if
    untitled += 1
    d->Untitled = "untitled" & untitled
    d->Enc.Encoding = Prefs.NewEncoding
    dim as docencoding.LineEnd e = docencoding.LineEnd.Lf
    select case Prefs.NewLineEnd
    case settings.NewEol.CrLf : e = docencoding.LineEnd.CrLf
    case settings.NewEol.Native
        if platform.CurrentOs( ) = platform.Os.Windows then e = docencoding.LineEnd.CrLf
    end select
    d->Enc.LineEnding = e
    d->Main.SetLineEnding( e, false )
    Docs.Push( d )
    return d
end function

' The open buffer holding path (compared as the file system compares), or 0.
function Window.FindOpen( byref path as const ustring ) as DocRef
    dim as ustring given = path
    dim as ustring want = fs.CanonicalPath( given, true ).ValueOr( given )
    for each d as DocRef in Docs
        if len( d->Path ) = 0 then continue for
        dim as ustring have = fs.CanonicalPath( d->Path, true ).ValueOr( d->Path )
        if platform.CurrentOs( ) = platform.Os.Linux then
            if have = want then return d
        elseif lcase( have ) = lcase( want ) then
            return d
        end if
    next
    return 0
end function

' d in the focused pane (pane 2 through d's second view), focused, most recent.
sub Window.ShowDoc( byval d as DocRef )
    if d = 0 then exit sub
    if InPane2 andalso (Split <> session.SplitMode.None) then
        if d->Other.Exists( ) = false then
            if this.NewView( d->Other ) = false then exit sub
            d->Other.ShareDocument( d->Main )
            d->ApplyHighlight( )
            d->Other.SetFirstLine( d->Main.FirstLine( ) )
        end if
        Pane2 = d
    else
        Pane1 = d
    end if
    this.Touch( d )
    this.Layout( )
    this.View( ).Focus( )
    this.ShowTitle( )
    this.ShowStatus( )
end sub

' The buffer after (or before) the focused pane's in open order, wrapping at either end.
sub Window.CycleBuffer( byval forward as boolean )
    dim as long n = Docs.Count( )
    if n < 2 then exit sub
    dim as long i = 0
    for k as long = 0 to n - 1
        if Docs[k] = this.Active( ) then i = k
    next
    if forward then i = (i + 1) mod n else i = (i + n - 1) mod n
    this.ShowDoc( Docs[i] )
end sub

' Opens path in the focused pane, or shows the buffer it is already in. An untitled, empty,
' unmodified buffer in that pane gives way to it.
function Window.OpenFile( byref path as const ustring ) as boolean
    if project.IsProjectFile( path ) then return this.OpenProject( path )
    dim as DocRef have = this.FindOpen( path )
    if have then
        this.ShowDoc( have )
        return true
    end if
    dim as DocRef cur = this.Active( )
    dim as DocRef d = this.NewDocument( )
    if d = 0 then return false
    untitled -= 1
    dim as documents.TextResult r = d->Load( path )
    if r.IsOk( ) = false then
        Docs.Pop( )
        d->DestroyViews( )
        delete d
        this.SetMessage( fs.PathFileName( path ) & ": " & r.Failure( ) )
        return false
    end if
    Recent.Add( path )
    this.ShowDoc( d )
    this.QueueScan( d )
    if cur andalso cur->IsNew( ) andalso (cur->IsModified( ) = false) andalso (cur->Main.Length( ) = 0) _
       andalso (cur <> Pane1) andalso (cur <> Pane2) then
        this.CloseDoc( cur )
    end if
    Message = ""
    this.ShowStatus( )
    return true
end function

' Save (newName, or no path yet: ask for one). FALSE when nothing was written.
function Window.SaveDoc( byval d as DocRef, byval newName as boolean ) as boolean
    if d = 0 then return false
    dim as ustring path = d->Path
    if newName orelse (len( path ) = 0) then
        dim as ustring suggest = d->DisplayName( )
        if len( d->Path ) then suggest = d->Path
        path = Pick( form, TKFD_SAVE, suggest )
        if len( path ) = 0 then return false
    end if
    dim as boolean accept_ = false
    if d->MustConfirmLoss( ) then
        if Ask( form, d->DisplayName( ) & ": some characters cannot be written as " & _
                docencoding.EncodingName( d->Enc.Encoding ) & " and will be replaced. Save anyway?", _
                MBX_BTN_OKCANCEL ) <> MBX_IDOK then return false
        accept_ = true
    end if
    dim as documents.TextResult r = d->Save( path, accept_ )
    if r.IsOk( ) = false then
        this.SetMessage( fs.PathFileName( path ) & ": " & r.Failure( ) )
        return false
    end if
    Recent.Add( path )
    Message = ""
    this.AfterSave( d )
    this.QueueScan( d )
    this.ShowTitle( )
    this.ShowStatus( )
    return true
end function

function Window.SaveAll( ) as boolean
    for each d as DocRef in Docs
        if d->IsModified( ) andalso (len( d->Path ) > 0) then
            if this.SaveDoc( d, false ) = false then return false
        end if
    next
    return true
end function

' Close d, asking to save it when modified. A pane that showed it shows the most recent other
' buffer; the last buffer closed leaves an untitled one. FALSE = the person cancelled.
function Window.CloseDoc( byval d as DocRef ) as boolean
    if d = 0 then return true
    if d->IsModified( ) then
        select case Ask( form, d->DisplayName( ) & ": save the changes?", MBX_BTN_SAVE_DONTSAVE_CANCEL )
        case MBX_IDYES
            if this.SaveDoc( d, false ) = false then return false
        case MBX_IDNO
        case else
            return false
        end select
    end if
    for i as long = 0 to Mru.Count( ) - 1
        if Mru[i] = d then
            Mru.Remove( i )
            exit for
        end if
    next
    for i as long = 0 to Docs.Count( ) - 1
        if Docs[i] = d then
            Docs.Remove( i )
            exit for
        end if
    next
    dim as DocRef nxt = 0
    if Mru.Count( ) > 0 then nxt = Mru[0]
    if nxt = 0 then
        nxt = this.NewDocument( )
        Mru.Push( nxt )
    end if
    if Pane1 = d then Pane1 = nxt
    if Pane2 = d then
        Pane2 = Pane1
        if Pane2->Other.Exists( ) = false then
            this.NewView( Pane2->Other )
            Pane2->Other.ShareDocument( Pane2->Main )
            Pane2->ApplyHighlight( )
        end if
    end if
    d->DestroyViews( )
    delete d
    this.Layout( )
    this.View( ).Focus( )
    this.ShowTitle( )
    this.ShowStatus( )
    return true
end function

function Window.CloseAll( ) as boolean
    while Docs.Count( ) > 0
        dim as DocRef d = Docs[Docs.Count( ) - 1]
        if (Docs.Count( ) = 1) andalso d->IsNew( ) andalso (d->IsModified( ) = false) then exit while
        if this.CloseDoc( d ) = false then return false
    wend
    return true
end function

' The same mode again unsplits; the other mode switches. A new split shows the active buffer in
' both panes.
sub Window.ToggleSplit( byval mode as session.SplitMode )
    if Split = mode then
        if InPane2 andalso Pane2 then Pane1 = Pane2
        Split = session.SplitMode.None
        InPane2 = false
        if Pane2 andalso Pane2->Other.Exists( ) then Pane2->Other.Destroy( )
        Pane2 = 0
        if splitBar then tkWidget_Destroy( splitBar )
        splitBar = 0
    else
        if Split = session.SplitMode.None then
            Pane2 = this.Active( )
            if Pane2->Other.Exists( ) = false then
                if this.NewView( Pane2->Other ) = false then exit sub
                Pane2->Other.ShareDocument( Pane2->Main )
                Pane2->ApplyHighlight( )
                Pane2->Other.SetFirstLine( Pane2->Main.FirstLine( ) )
                Pane2->Other.SetPosition( Pane2->Main.Position( ) )
            end if
        end if
        Split = mode
        if splitBar then tkWidget_Destroy( splitBar )
        dim as long orient = TKSPLITTER_VERTICAL
        if mode = session.SplitMode.Horizontal then orient = TKSPLITTER_HORIZONTAL
        splitBar = tkSplitter_Create( tkForm_Widget( form ), ID_SPLIT, orient )
        tkSplitter_SetPosChangedCallback( splitBar, sub( byval h as TK_WIDGET ptr, byval newPos as long, byval nPhase as long )
            dim as Window ptr mw = WindowOfWidget( h )
            if mw = 0 then exit sub
            dim as TK_WIDGET ptr root = tkForm_Widget( mw->form )
            dim as long bar = tkForm_Scale( mw->form, SPLIT_BAR )
            if mw->Split = session.SplitMode.Vertical then
                if root->cw > bar then mw->SplitRatio = newPos / (root->cw - bar)
            else
                dim as long ah = root->ch - mw->BottomHeight( ) - mw->OutputHeight( )
                if ah > bar then mw->SplitRatio = newPos / (ah - bar)
            end if
            mw->Layout( )
        end sub )
    end if
    this.Layout( )
    this.View( ).Focus( )
    this.ShowStatus( )
end sub

sub Window.FocusPane( byval second as boolean )
    if (Split = session.SplitMode.None) orelse (Pane2 = 0) then second = false
    InPane2 = second
    this.View( ).Focus( )
    this.Touch( this.Active( ) )
    this.ShowTitle( )
    this.ShowStatus( )
end sub

' Another program wrote (or removed) an open file: an unmodified buffer reloads, a modified one
' asks first. A removed file keeps its text and is not asked about again.
sub Window.CheckDisk( )
    if asking then exit sub
    asking = true
    for each d as DocRef in Docs
        if d->ChangedOnDisk( ) = false then continue for
        if fs.IsFile( d->Path ) = false then
            d->Ignored = documents.StampOf( d->Path )
        elseif d->IsModified( ) = false then
            d->Reload( )
        elseif Ask( form, d->DisplayName( ) & ": changed by another program. Reload it and lose your changes?", _
                    MBX_BTN_YESNO ) = MBX_IDYES then
            d->Reload( )
        else
            d->Ignored = documents.StampOf( d->Path )
        end if
    next
    asking = false
    this.ShowStatus( )
end sub

' A relabel: the text is Unicode, so the bytes change only at the next save (docencoding).
sub Window.SetEncoding( byval e as docencoding.FileEncoding )
    dim as DocRef d = this.Active( )
    if d = 0 then exit sub
    if d->Enc.PlanChange( e, d->Text( ) ) = docencoding.EncodingChange.RelabelLossy then
        if Ask( form, d->DisplayName( ) & ": some characters cannot be written as " & _
                docencoding.EncodingName( e ) & ". Change anyway?", MBX_BTN_OKCANCEL ) <> MBX_IDOK then exit sub
    end if
    d->Enc.ApplyChange( e )
    this.ShowStatus( )
end sub

' Converts every line break of the active buffer, and new lines use e from now on.
sub Window.SetLineEnding( byval e as docencoding.LineEnd )
    dim as DocRef d = this.Active( )
    if d = 0 then exit sub
    d->Enc.LineEnding = e
    d->Main.SetLineEnding( e, true )
    if d->Other.Exists( ) then d->Other.SetLineEnding( e, false )   ' one document: converted once
    this.ShowStatus( )
end sub

' session.toml: the buffers with a path, their places, the split, the build, the recent files.
' What is open, where, into st: paths stored under base_ ("" = absolute). The files st already
' lists (a project's) keep their place and become closed unless a buffer shows them; every other
' buffer with a path is added.
sub Window.CaptureState( byref st as session.SessionState, byref base_ as const ustring )
    for i as long = 0 to st.Files.Count( ) - 1
        st.Files[i].Open = false
    next
    for each d as DocRef in Docs
        if len( d->Path ) = 0 then continue for
        dim as ustring stored = session.StoredPath( base_, d->Path )
        dim as long at = -1
        for i as long = 0 to st.Files.Count( ) - 1
            if lcase( st.Files[i].Path ) = lcase( stored ) then at = i
        next
        if at < 0 then
            dim as session.FileState nf
            nf.Path = stored
            st.Files.Push( nf )
            at = st.Files.Count( ) - 1
        end if
        st.Files[at].Open = true
        st.Files[at].FirstLine = d->Main.FirstLine( )
        st.Files[at].Position = d->Main.Position( )
        st.Files[at].Bookmarks = d->Main.Bookmarks( )
    next
    st.Active = ""
    st.Pane2 = ""
    if Pane1 andalso len( Pane1->Path ) then st.Active = session.StoredPath( base_, Pane1->Path )
    st.Split = Split
    st.SplitRatio = SplitRatio
    if Pane2 andalso len( Pane2->Path ) then st.Pane2 = session.StoredPath( base_, Pane2->Path )
    st.Build = CurrentBuild
end sub

' Opens st's open files (stored under base_), their places, the active one, the split.
sub Window.ApplyState( byref st as const session.SessionState, byref base_ as const ustring )
    if len( st.Build ) then
        for each b as settings.BuildConfig in Prefs.Builds
            if b.Name = st.Build then CurrentBuild = st.Build
        next
    end if
    for each f as session.FileState in st.Files
        dim as ustring full = session.FullPath( base_, f.Path )
        if (f.Open = false) orelse (fs.IsFile( full ) = false) then continue for
        if this.OpenFile( full ) = false then continue for
        dim as DocRef d = this.Active( )
        d->Main.SetBookmarks( f.Bookmarks )
        d->Main.SetPosition( f.Position )
        d->Main.SetFirstLine( f.FirstLine )
    next
    dim as DocRef a = 0
    if len( st.Active ) then a = this.FindOpen( session.FullPath( base_, st.Active ) )
    if a then this.ShowDoc( a )
    if (st.Split <> session.SplitMode.None) andalso (Pane1 <> 0) then
        SplitRatio = st.SplitRatio
        this.ToggleSplit( st.Split )
        dim as DocRef b = 0
        if len( st.Pane2 ) then b = this.FindOpen( session.FullPath( base_, st.Pane2 ) )
        if b then
            InPane2 = true
            this.ShowDoc( b )
            this.FocusPane( false )
        end if
    end if
end sub

' session.toml: what is open outside a project, the recent files, the project that was open.
sub Window.SaveSession( )
    dim as session.SessionState st
    if ProjOpen then
        st.Project = Proj.Path                  ' its own files are the project's to keep
    else
        this.CaptureState( st, "" )
    end if
    st.Build = CurrentBuild
    st.Recent = Recent.Items( )
    session.SaveSession( this.SessionFile( ), st )
end sub

sub Window.RestoreSession( )
    dim as session.SessionResult r = session.LoadSession( this.SessionFile( ) )
    if r.IsOk( ) = false then exit sub
    dim as session.SessionState st = r.Value( )
    if len( st.Project ) andalso fs.IsFile( st.Project ) then
        this.OpenProject( st.Project )
    else
        this.ApplyState( st, "" )
    end if
    Recent.Assign( st.Recent )                  ' opening the files reordered it
    Message = ""
    this.ShowStatus( )
end sub

' ================================================================ the chooser popup

private function Row( byval a as ustring, byval b as ustring, byval c as ustring, _
                      byval tag as long ) as popuplist.PickRow
    dim as popuplist.PickRow r
    r.Cells.Push( a )
    r.Cells.Push( b )
    r.Cells.Push( c )
    r.Key = b
    r.Tag = tag
    return r
end function

' The one popup list, anchored at the bottom of the panes: what kind decides the rows and what a
' pick does (Chosen).
' The short lists over the right-hand status panels: a name and a note, no wider than they need.
private sub Narrow( byref c as popuplist.Picker, byref popW as long )
    c.Columns.Clear( )
    c.Columns.Push( 18 )
    c.Columns.Push( 130 )
    c.Columns.Push( 120 )
    popW = 280
end sub

sub Window.OpenChooser( byval kind as PickKind )
    dim as Array( of popuplist.PickRow ) rows
    dim as long sel = 0
    dim as ustring keep = ""
    if (kind = PickKind.Functions) andalso (Choosing = PickKind.Functions) then keep = Chooser.QueryText( )
    Chooser.Close( )
    Chooser.Filter = true
    Chooser.SeedQuery = keep
    Chooser.MaxRows = 12
    Chooser.Toggle.key = 0
    Chooser.Columns.Clear( )
    Chooser.Columns.Push( 18 )
    Chooser.Columns.Push( 220 )
    Chooser.Columns.Push( 200 )
    dim as long popW = 460
    select case kind
    case PickKind.Symbols
        ' the project's files and the open buffers, then every definition in them
        Hits.Clear( )
        Chooser.Columns.Clear( )
        Chooser.Columns.Push( 64 )
        Chooser.Columns.Push( 300 )
        Chooser.Columns.Push( 240 )
        Chooser.MaxRows = 14
        popW = 620
        dim as Map( of ustring, boolean ) mine
        dim as Array( of ustring ) paths
        if ProjOpen then
            for i as long = 0 to Proj.FileCount( ) - 1
                paths.Push( Proj.FilePath( i ) )
            next
        end if
        for each d as DocRef in Docs
            if len( d->Path ) then paths.Push( d->Path )
        next
        for each pth as ustring in paths
            if mine.Contains( ucase( pth ) ) then continue for
            mine.Put( ucase( pth ), true )
            dim as SymHit hh
            hh.Name = fs.PathFileName( pth )
            hh.Kind = "file"
            hh.Path = pth
            hh.Line = -1
            Hits.Push( hh )
        next
        dim as Map( of ustring, boolean ) scanned
        for each r as symboldb.SymRef in Db.Definitions( )
            dim byref as symboldb.Sym y = Db.Item( r )
            if mine.Contains( ucase( y.File ) ) = false then continue for     ' the user's files only
            scanned.Put( ucase( y.File ), true )
            dim as SymHit hh
            hh.Name = Db.QualifiedName( r )
            select case y.Kind
            case symboldb.SymKind.FunctionProc : hh.Kind = "function"
            case symboldb.SymKind.SubProc : hh.Kind = "sub"
            case symboldb.SymKind.EnumDef : hh.Kind = "enum"
            case else : hh.Kind = "type"
            end select
            hh.Path = this.ScannedFile( y.File )
            hh.Line = y.LineNo - 1
            if y.BodyLine > 0 then hh.Line = y.BodyLine - 1
            Hits.Push( hh )
        next
        for each d as DocRef in Docs                    ' unscanned buffers: the outline
            if (len( d->Path ) > 0) andalso scanned.Contains( ucase( d->Path ) ) then continue for
            for each hh as SymHit in this.ProcsOf( d )
                Hits.Push( hh )
            next
        next
        for i as long = 0 to Hits.Count( ) - 1
            dim as ustring where_ = fs.PathFileName( Hits[i].Path )
            if Hits[i].Line >= 0 then where_ &= ":" & (Hits[i].Line + 1)
            if Hits[i].Kind = "file" then where_ = fs.PathParent( Hits[i].Path )
            rows.Push( Row( Hits[i].Kind, Hits[i].Name, where_, i ) )
        next
    case PickKind.Functions
        ' F4: the active buffer's procedures; F4 again (inside the list) every open buffer's
        Hits.Clear( )
        Chooser.Columns.Clear( )
        Chooser.Columns.Push( 260 )
        Chooser.Columns.Push( 80 )
        Chooser.Columns.Push( 60 )
        if FuncsAll then
            Chooser.Columns.Push( 180 )
            popW = 600
            for each d as DocRef in Mru
                for each hh as SymHit in this.ProcsOf( d )
                    Hits.Push( hh )
                next
            next
        else
            popW = 420
            Hits = this.ProcsOf( this.Active( ) )
        end if
        for i as long = 0 to Hits.Count( ) - 1
            dim as popuplist.PickRow r
            r.Cells.Push( Hits[i].Name )
            r.Cells.Push( Hits[i].Kind )
            r.Cells.Push( str( Hits[i].Line + 1 ) )
            if FuncsAll then
                dim as ustring fname = "untitled"
                if Hits[i].Doc then fname = Hits[i].Doc->DisplayName( )
                r.Cells.Push( fname )
            end if
            r.Tag = i
            rows.Push( r )
        next
        dim as TK_CHORD tc
        dim as string fk = Keys.Effective( Cmd.FunctionList )
        if len( fk ) andalso tkKeys_Parse( fk, tc ) then Chooser.Toggle = tc
        Chooser.OnToggle = sub( byval payload as any ptr, byval tag as long )
            dim as Window ptr mw = payload
            mw->FuncsAll = (mw->FuncsAll = false)
            mw->OpenChooser( PickKind.Functions )
        end sub
    case PickKind.Buffers
        for i as long = 0 to Mru.Count( ) - 1
            dim as DocRef d = Mru[i]
            dim as ustring mark = " "
            if d->IsModified( ) then mark = "*"
            dim as ustring dir_ = ""
            if len( d->Path ) then dir_ = fs.PathParent( d->Path )
            rows.Push( Row( mark, d->DisplayName( ), dir_, i ) )
        next
    case PickKind.Recent
        for i as long = 0 to Recent.Count( ) - 1
            rows.Push( Row( " ", fs.PathFileName( Recent.Item( i ) ), fs.PathParent( Recent.Item( i ) ), i ) )
        next
    case PickKind.Encoding
        Chooser.Filter = false
        Narrow( Chooser, popW )
        for e as long = docencoding.FileEncoding.Ansi to docencoding.FileEncoding.Utf16Bom
            dim as ustring mark = " "
            if (this.Active( ) <> 0) andalso (clng( this.Active( )->Enc.Encoding ) = e) then mark = "*"
            rows.Push( Row( mark, docencoding.EncodingName( cast( docencoding.FileEncoding, e ) ), "", e ) )
        next
    case PickKind.LineEnding
        Chooser.Filter = false
        Narrow( Chooser, popW )
        rows.Push( Row( " ", "CRLF", "Windows", clng( docencoding.LineEnd.CrLf ) ) )
        rows.Push( Row( " ", "LF", "Linux, macOS", clng( docencoding.LineEnd.Lf ) ) )
        rows.Push( Row( " ", "CR", "classic Mac", clng( docencoding.LineEnd.Cr ) ) )
    case PickKind.Bookmarks
        Marks.Clear( )
        for each d as DocRef in Mru
            for each ln as long in d->Main.Bookmarks( )
                dim as BookmarkHit bh
                bh.Doc = d
                bh.Line = ln
                Marks.Push( bh )
                rows.Push( Row( " ", d->DisplayName( ) & ":" & (ln + 1), trim( d->Main.LineTextAt( ln ) ), Marks.Count( ) - 1 ) )
            next
        next
    case PickKind.Build
        Chooser.Filter = false
        Narrow( Chooser, popW )
        for i as long = 0 to Prefs.Builds.Count( ) - 1
            dim as ustring mark = " "
            if Prefs.Builds[i].Name = CurrentBuild then mark = "*"
            rows.Push( Row( mark, Prefs.Builds[i].Name, Prefs.Builds[i].Options, i ) )
        next
    end select
    if (rows.Count( ) = 0) andalso (kind <> PickKind.Functions) then
        this.SetMessage( "nothing to choose from" )
        exit sub
    end if
    Choosing = kind
    Chooser.OnPick = sub( byval payload as any ptr, byval tag as long )
        cast( Window ptr, payload )->Chosen( tag )
    end sub
    Chooser.Payload = @this
    ' the lists of names at the top, centred over the panes; the others above the status panel
    ' they belong to (the buffers' at the left), inside the window. A popup is placed in the
    ' window's own pixels (tkHost_CreatePopup), not the screen's.
    dim as TK_HOST ptr h = tkForm_Host( form )
    dim as long cx = tkForm_Widget( form )->cw
    dim as long w = tkForm_Scale( form, popW )
    if w > cx then w = cx
    dim as long n = rows.Count( )
    if n > Chooser.MaxRows then n = Chooser.MaxRows
    dim as long ph = n * tkForm_Scale( form, popuplist.ROW_CY ) + tkForm_Scale( form, 4 )
    if Chooser.Filter then ph += tkForm_Scale( form, 26 )
    if (kind = PickKind.Symbols) orelse (kind = PickKind.Functions) then
        Chooser.Open( h, rows, (cx - w) \ 2, tkForm_Scale( form, 32 ), w, sel )
    else
        dim as StatusPanel anchor = StatusPanel.Buffer
        select case kind
        case PickKind.Build : anchor = StatusPanel.Build
        case PickKind.Encoding : anchor = StatusPanel.Encoding
        case PickKind.LineEnding : anchor = StatusPanel.LineEnding
        end select
        dim as TKRECT a, rc
        tkWidget_AbsRect( status, a )
        tkStatusBar_GetPanelRect( status, anchor, rc )
        dim as long x = a.left + rc.left
        if x + w > cx then x = cx - w
        if x < 0 then x = 0
        Chooser.Open( h, rows, x, a.top - ph, w, sel )
    end if
end sub

sub Window.Chosen( byval tag as long )
    dim as PickKind kind = Choosing
    Choosing = PickKind.None
    select case kind
    case PickKind.Buffers
        if (tag >= 0) andalso (tag < Mru.Count( )) then this.ShowDoc( Mru[tag] )
    case PickKind.Recent
        dim as ustring p = Recent.Item( tag )
        if len( p ) then this.OpenFile( p )
    case PickKind.Encoding : this.SetEncoding( cast( docencoding.FileEncoding, tag ) )
    case PickKind.LineEnding : this.SetLineEnding( cast( docencoding.LineEnd, tag ) )
    case PickKind.Build
        if (tag >= 0) andalso (tag < Prefs.Builds.Count( )) then CurrentBuild = Prefs.Builds[tag].Name
    case PickKind.Symbols, PickKind.Functions
        if (tag >= 0) andalso (tag < Hits.Count( )) then
            dim as SymHit hh = Hits[tag]
            if len( hh.Path ) then
                this.JumpTo( hh.Path, iif( hh.Line < 0, 0, hh.Line ), 0, 0 )
            elseif hh.Doc then
                this.ShowDoc( hh.Doc )
                this.View( ).GoToLine( hh.Line )
            end if
        end if
    case PickKind.Bookmarks
        if (tag >= 0) andalso (tag < Marks.Count( )) then
            dim as BookmarkHit bh = Marks[tag]
            this.ShowDoc( bh.Doc )
            this.View( ).GoToLine( bh.Line )
        end if
    end select
    this.View( ).Focus( )
    this.ShowStatus( )
end sub

' ================================================================ find, replace, go to line

' The strip's toggles, and the range "Sel" limits a search to.
function Window.FindOptionsNow( ) as editor.FindOptions
    dim as editor.FindOptions o = Finder.Options( )
    o.RangeStart = FindLo
    o.RangeEnd = FindHi
    return o
end function

' The strip above the status line, the phrase seeded from a one-line selection; a multi-line
' selection is remembered for "Sel".
sub Window.OpenStrip( byval m as findstrip.StripMode )
    dim as editor.CodeView ptr v = @this.View( )
    dim as ustring seed = v->SelectedText( )
    dim as boolean multi = (instr( seed, chr( 10 ) ) > 0)
    if multi then
        FindLo = v->SelectionStart( )
        FindHi = v->SelectionEnd( )
    else
        FindLo = 0
        FindHi = 0
    end if
    Finder.Open( m, seed, multi )
    this.Layout( )
    if m = findstrip.StripMode.GoTo then
        Finder.SetStatus( strings.Format( "1 - {}", v->LineCount( ) ) )
    elseif m = findstrip.StripMode.Project then
        if ProjOpen then
            Finder.SetStatus( "Enter searches the project's files" )
        else
            Finder.SetStatus( "Enter searches the open buffers" )
        end if
    else
        this.ShowFindStatus( )
    end if
end sub

' "3 of 10" or "No matches", and every match highlighted.
sub Window.ShowFindStatus( )
    if (Finder.isOpen = false) orelse (Finder.Mode = findstrip.StripMode.GoTo) orelse (Finder.Mode = findstrip.StripMode.Project) then exit sub
    dim as editor.CodeView ptr v = @this.View( )
    dim as ustring p = Finder.Phrase( )
    dim as editor.FindOptions o = this.FindOptionsNow( )
    v->MarkMatches( p, o )
    if len( p ) = 0 then
        Finder.SetStatus( "" )
        exit sub
    end if
    dim as long n = v->CountMatches( p, o )
    if n = 0 then
        Finder.SetStatus( "No matches" )
    else
        Finder.SetStatus( strings.Format( "{} of {}", v->MatchIndex( p, o ), n ) )
    end if
end sub

sub Window.OnFind( byval a as findstrip.FindAction )
    dim as editor.CodeView ptr v = @this.View( )
    dim as ustring p = Finder.Phrase( )
    dim as editor.FindOptions o = this.FindOptionsNow( )
    select case a
    case findstrip.FindAction.Changed
        ' incremental: from where the current match starts, so typing extends it in place
        v->SetPosition( v->Position( ) - v->SelectionLength( ) )
        v->Find( p, o, true )
    case findstrip.FindAction.NextMatch
        if len( p ) = 0 then
            if Finder.isOpen = false then this.OpenStrip( findstrip.StripMode.Find )
            exit sub
        end if
        v->Find( p, o, true )
    case findstrip.FindAction.PrevMatch
        if len( p ) = 0 then exit sub
        v->Find( p, o, false )
    case findstrip.FindAction.ReplaceOne
        dim as longint n0 = v->Length( )
        v->ReplaceCurrent( p, Finder.Replacement( ), o )
        if o.InSelection then FindHi += v->Length( ) - n0
    case findstrip.FindAction.ReplaceEvery
        dim as longint n0 = v->Length( )
        dim as long k = v->ReplaceAll( p, Finder.Replacement( ), o )
        if o.InSelection then FindHi += v->Length( ) - n0
        this.ShowFindStatus( )
        Finder.SetStatus( strings.Format( "{} replaced", k ) )
        this.ShowStatus( )
        exit sub
    case findstrip.FindAction.SearchFiles
        this.RunProjectSearch( )
        exit sub
    case findstrip.FindAction.GoToLine
        ' "42" or "42:7" (line:column, 1-based)
        dim as ustring t = trim( p )
        dim as long colon = instr( t, ":" ), col = 0
        dim as long ln = valint( t )
        if colon > 0 then col = valint( mid( t, colon + 1 ) )
        if (ln >= 1) andalso (ln <= v->LineCount( )) then
            Finder.Close( )
            this.Layout( )
            if col > 0 then col -= 1
            v->GoToLine( ln - 1, col )
            v->Focus( )
            this.ShowStatus( )
        else
            Finder.SetStatus( strings.Format( "1 - {}: no line '{}'", v->LineCount( ), t ) )
        end if
        exit sub
    case findstrip.FindAction.CloseStrip
        v->MarkMatches( "", o )
        Finder.Close( )
        this.Layout( )
        v->Focus( )
        this.ShowStatus( )
        exit sub
    end select
    this.ShowFindStatus( )
    this.ShowStatus( )
end sub

' Enter: the new line indented like the one above (deeper after a block opener), and the block's
' 'end ...' line inserted below when it is owed (tkc/autoinsert; settings auto_indent, auto_end).
sub Window.OnCharAdded( byval hEdit as TK_WIDGET ptr, byval ch as long )
    dim as DocRef d = this.DocOfWidget( hEdit )
    if d = 0 then exit sub
    dim as editor.CodeView ptr v = @d->Main
    if d->Other.Exists( ) andalso (d->Other.Widget( ) = hEdit) then v = @d->Other
    dim as boolean isNewLine = (ch = 10) orelse ((ch = 13) andalso (v->LineEnding( ) = docencoding.LineEnd.Cr))
    if isNewLine = false then exit sub
    if (Prefs.AutoIndent = false) andalso (Prefs.AutoEnd = false) then exit sub
    dim as long ln = v->CaretLine( )                    ' 1-based: the new line
    dim as Array( of ustring ) lines
    dim as long last = v->LineCount( ) - 1
    if last > ln + 400 then last = ln + 400             ' the block's end is near, or owed
    for i as long = 0 to last
        if i < ln - 2 then
            lines.Push( "" )                            ' only from the line above on matters
        else
            lines.Push( v->LineTextAt( i ) )
        end if
    next
    dim as ustring one = space( Prefs.TabSize )
    if Prefs.UseTabs then one = chr( 9 )
    dim as autoinsert.EnterPlan pl = autoinsert.Plan( lines, ln - 2, one, Prefs.AutoIndent, Prefs.AutoEnd )
    if Prefs.AutoIndent then v->SetIndentText( ln - 1, pl.NewIndent )
    if len( pl.EndLine ) then v->InsertLineAfter( ln - 1, pl.EndLine )
end sub

' A click in the bookmark margin toggles the line's bookmark; one in the fold margin folds.
sub Window.OnMarginClick( byval hEdit as TK_WIDGET ptr, byval margin as long, byval position as longint )
    dim as DocRef d = this.DocOfWidget( hEdit )
    if d = 0 then exit sub
    dim as editor.CodeView ptr v = @d->Main
    if d->Other.Exists( ) andalso (d->Other.Widget( ) = hEdit) then v = @d->Other
    dim as long ln = v->LineOf( position )
    if margin = 1 then
        v->ToggleBookmark( ln )
    elseif margin = 2 then
        v->FoldLineAt( ln )
    end if
end sub

' ================================================================ projects

' Opens a .tkedit project: the buffers open now are closed first (asking for unsaved ones), then
' the project's open files come back where they were.
function Window.OpenProject( byref path as const ustring ) as boolean
    dim as project.ProjectResult r = project.LoadProject( path )
    if r.IsOk( ) = false then
        this.SetMessage( r.Failure( ) )
        return false
    end if
    if ProjOpen then
        if this.CloseProject( ) = false then return false
    else
        this.SaveSession( )
        if this.CloseAll( ) = false then return false
    end if
    Proj = r.Value( )
    dim as ustring full = fs.AbsolutePath( Proj.Path ).ValueOr( Proj.Path )
    Proj.Path = full
    ProjOpen = true
    if len( Proj.Build ) then Proj.State.Build = Proj.Build
    this.ApplyState( Proj.State, Proj.Dir_( ) )
    if (Docs.Count( ) = 1) andalso Docs[0]->IsNew( ) andalso (len( Proj.MainPath( ) ) > 0) andalso fs.IsFile( Proj.MainPath( ) ) then
        this.OpenFile( Proj.MainPath( ) )
    end if
    Recent.Add( full )
    LastExe = ""
    this.SetMessage( "project " & Proj.Name( ) )
    this.ShowTitle( )
    return true
end function

' A new project file (asked for) whose main file is the active buffer.
function Window.NewProject( ) as boolean
    dim as DocRef d = this.Active( )
    if (d <> 0) andalso d->IsNew( ) then
        if this.SaveDoc( d, false ) = false then return false
    end if
    dim as ustring mainF = ""
    if d then mainF = d->Path
    dim as ustring suggest = "project" & project.PROJECT_EXT
    if len( mainF ) then suggest = fs.PathJoin( fs.PathParent( mainF ), fs.PathStem( mainF ) & project.PROJECT_EXT )
    dim as ustring path = Pick( form, TKFD_SAVE, suggest )
    if len( path ) = 0 then return false
    if ProjOpen then this.SaveProject( )
    Proj = project.NewProject( path, mainF )
    Proj.Build = CurrentBuild
    ProjOpen = true
    if this.SaveProject( ) = false then
        ProjOpen = false
        return false
    end if
    Recent.Add( Proj.Path )
    this.SetMessage( "project " & Proj.Name( ) & " created" )
    this.ShowTitle( )
    return true
end function

' The project file, with what is open now.
function Window.SaveProject( ) as boolean
    if ProjOpen = false then
        this.SetMessage( "no project is open" )
        return false
    end if
    this.CaptureState( Proj.State, Proj.Dir_( ) )
    Proj.Build = CurrentBuild
    dim as fs.FsResultBool w = project.SaveProject( Proj )
    if w.IsOk( ) = false then
        this.SetMessage( fs.PathFileName( Proj.Path ) & ": " & w.Failure( ).Message( ) )
        return false
    end if
    return true
end function

' Saves the project, then closes its buffers (asking for unsaved ones). FALSE = cancelled.
function Window.CloseProject( ) as boolean
    if ProjOpen = false then return true
    this.SaveProject( )
    if this.CloseAll( ) = false then return false
    ProjOpen = false
    dim as project.ProjectFile none_
    Proj = none_
    LastExe = ""
    this.ClearDiagnostics( )
    this.ShowTitle( )
    this.ShowStatus( )
    return true
end function

' Ctrl+F11: the active buffer joins the project; when it is already in it, a file is asked for.
sub Window.AddToProject( )
    if ProjOpen = false then
        this.SetMessage( "no project is open" )
        exit sub
    end if
    dim as ustring p = this.ActivePath( )
    if (len( p ) = 0) orelse (Proj.IndexOf( p ) >= 0) then
        p = Pick( form, TKFD_OPEN, Proj.Dir_( ) )
        if len( p ) = 0 then exit sub
    end if
    if Proj.Add( p ) then
        this.SaveProject( )
        this.SetMessage( fs.PathFileName( p ) & " added to " & Proj.Name( ) )
    else
        this.SetMessage( fs.PathFileName( p ) & " is already in " & Proj.Name( ) )
    end if
    if this.FindOpen( p ) = 0 then this.OpenFile( p )
end sub

' ================================================================ the build (P4)

function Window.CompilerPath( ) as ustring
    if len( Prefs.Tiko ) andalso fs.IsFile( Prefs.Tiko ) then return Prefs.Tiko
    dim as ustring nm = "tiko"
    if platform.CurrentOs( ) = platform.Os.Windows then nm = "tiko.exe"
    return platform.FindOnPath( nm )
end function

' The configuration the build panel shows, as tkc/build wants it.
function Window.ActiveBuildConfig( ) as build.BuildConfig
    dim as build.BuildConfig c
    for each b as settings.BuildConfig in Prefs.Builds
        if b.Name = CurrentBuild then
            c.Name = b.Name
            c.Options = b.Options
            return c
        end if
    next
    if Prefs.Builds.Count( ) > 0 then
        c.Name = Prefs.Builds[0].Name
        c.Options = Prefs.Builds[0].Options
    end if
    return c
end function

function Window.IsBuilding( ) as boolean
    return Job.IsRunning( ) orelse (buildTimer <> 0)
end function

' What is built: the project's tiko.toml target, else its main file, else the active buffer (a
' Quick Run: a copy of it; Compile Module: 'tiko check' of it). Modified buffers with a path are
' saved first (settings save_before_build). The output arrives through PollBuild.
function Window.StartBuild( byval action as build.BuildAction, byval rebuild as boolean ) as boolean
    if this.IsBuilding( ) then
        this.SetMessage( "a build is running" )
        return false
    end if
    dim as ustring tiko = this.CompilerPath( )
    if len( tiko ) = 0 then
        this.SetMessage( "tiko not found: set [compiler] tiko in settings.toml, or put it on the PATH" )
        return false
    end if
    dim as DocRef d = this.Active( )
    dim as boolean single_ = (action = build.BuildAction.CompileModule) orelse (action = build.BuildAction.QuickRun)
    dim as boolean useTarget = ProjOpen andalso (len( Proj.Target ) > 0) andalso (single_ = false)
    dim as boolean useMain = ProjOpen andalso (len( Proj.Target ) = 0) andalso (len( Proj.Main ) > 0) andalso (single_ = false)
    if (useTarget = false) andalso (useMain = false) andalso (action <> build.BuildAction.QuickRun) then
        if d = 0 then return false
        if len( d->Path ) = 0 then
            if this.SaveDoc( d, false ) = false then return false
        end if
    end if
    if Prefs.SaveBeforeBuild andalso (action <> build.BuildAction.QuickRun) then
        for each x as DocRef in Docs
            if x->IsModified( ) andalso (len( x->Path ) > 0) then this.SaveDoc( x, false )
        next
    end if
    dim as Array( of build.Subsystem ) directives
    dim as ustring projOpts = ""
    if ProjOpen then projOpts = Proj.Options
    BuildFlags = build.ComposeFlags( this.ActiveBuildConfig( ), action, projOpts, strings.Join( Prefs.Includes, ";" ), directives )
    BuildDiagFile = fs.PathJoin( ConfigDir, "build.diagnostics" )
    fs.CreateDirAll( ConfigDir )
    fs.RemoveFile( BuildDiagFile )
    dim as platform.Os os_ = platform.CurrentOs( )
    dim as Array( of ustring ) args, none_
    dim as ustring workDir
    QuickRunFile = ""
    if useTarget then
        args = build.TargetArgs( Proj.Target, Proj.Dir_( ), BuildFlags, none_, BuildDiagFile, os_ )
        ' --profile editor is tiko-editor's managed profile; tiko refuses an unknown one (TKO0163)
        dim as ustring toml = fs.ReadAllText( fs.PathJoin( Proj.Dir_( ), "tiko.toml" ) ).ValueOr( "" )
        if instr( toml, "[profile.editor]" ) = 0 then
            for i as long = 0 to args.Count( ) - 2
                if (args[i] = "--profile") andalso (args[i + 1] = "editor") then
                    args.Remove( i )
                    args.Remove( i )
                    exit for
                end if
            next
        end if
        workDir = Proj.Dir_( )
        BuildMain = Proj.MainPath( )
    elseif action = build.BuildAction.CompileModule then
        args = build.CheckArgs( d->Path, BuildFlags, BuildDiagFile, os_ )
        workDir = fs.PathParent( d->Path )
        BuildMain = d->Path
    else
        dim as ustring src
        if useMain then
            src = Proj.MainPath( )
        else
            src = d->Path
        end if
        BuildMain = src
        if action = build.BuildAction.QuickRun then
            dim as ustring dir_ = ConfigDir
            if len( d->Path ) then dir_ = fs.PathParent( d->Path )
            QuickRunFile = fs.PathJoin( dir_, build.QUICKRUN_FILE )
            fs.WriteAllText( QuickRunFile, d->Text( ) )
            src = QuickRunFile
            BuildMain = QuickRunFile
        end if
        args = build.BuildArgs( src, none_, none_, "", BuildFlags, BuildDiagFile, os_ )
        workDir = fs.PathParent( src )
    end if
    if rebuild then
        ' Rebuild All: 'tiko clean' first, then this build (FinishBuild starts it)
        PendingArgs = args
        args.Clear( )
        args.Push( "clean" )
        if useTarget then
            args.Push( Proj.Target )
            args.Push( "--manifest" )
            args.Push( Proj.Dir_( ) )
        else
            args.Push( BuildMain )
        end if
        Cleaning = true
    end if
    BuildAct = action
    BuildProgram = tiko
    BuildDir = workDir
    BuildRaw = ""
    dim as build.BuildProgress fresh
    Progress = fresh
    LogText = build.CommandLine( tiko, args ) & chr( 10 )
    Out.SetLog( LogText )
    this.ClearDiagnostics( )
    dim as Result( of boolean, ustring ) st = Job.Start( tiko, args, workDir )
    if st.IsOk( ) = false then
        LogText &= st.Failure( ) & chr( 10 )
        Out.SetLog( LogText )
        this.SetMessage( "the build could not start: " & st.Failure( ) )
        return false
    end if
    this.SetMessage( "building..." )
    buildTimer = tkApp_SetTimer( BUILD_POLL_MS, sub( byval id as long, byval payload as any ptr )
        cast( Window ptr, payload )->PollBuild( )
    end sub, @this )
    return true
end function

sub Window.PollBuild( )
    dim as Array( of ustring ) got
    dim as boolean ended = Job.Poll( got )
    if got.Count( ) then
        for each ln as ustring in got
            BuildRaw &= ln & chr( 10 )
            if Progress.Feed( ln ) then
                this.SetMessage( strings.Format( "building... {}/{}", Progress.Done, Progress.Total ) )
            elseif build.IsEventLine( ln ) = false then
                LogText &= ln & chr( 10 )
            end if
        next
        Out.SetLog( LogText )
    end if
    if ended then this.FinishBuild( )
end sub

' The build ended: Results and squiggles from the diagnostics file, the message, the output pane
' with the first error on a failure, the program run when the action asked for it.
sub Window.FinishBuild( )
    if buildTimer then tkApp_KillTimer( buildTimer )
    buildTimer = 0
    if Cleaning then
        Cleaning = false
        LogText &= build.CommandLine( BuildProgram, PendingArgs ) & chr( 10 )
        Out.SetLog( LogText )
        if Job.Start( BuildProgram, PendingArgs, BuildDir ).IsOk( ) then
            buildTimer = tkApp_SetTimer( BUILD_POLL_MS, sub( byval id as long, byval payload as any ptr )
                cast( Window ptr, payload )->PollBuild( )
            end sub, @this )
            exit sub
        end if
    end if
    dim as long code = Job.exitCode
    dim as build.DiagResult dr = build.ReadDiagnostics( BuildDiagFile )
    dim as build.DiagReport rep
    if dr.IsOk( ) then
        rep = dr.Value( )
        if len( QuickRunFile ) andalso (this.Active( ) <> 0) then rep.RenameFile( QuickRunFile, this.Active( )->Path )
    end if
    Diags = rep.Records
    dim as build.ResultCounts counts = build.CountResults( rep, dr.IsOk( ), false, code )
    this.ShowDiagnostics( counts )
    if BuildAct <> build.BuildAction.CompileModule then
        LastExe = build.EventRunPath( BuildRaw )
        if len( LastExe ) = 0 then LastExe = build.OutputFile( BuildMain, BuildFlags, platform.CurrentOs( ) )
        if len( LastExe ) then LastExe = fs.PathToNative( LastExe )      ' tiko's events write /
    end if
    if len( QuickRunFile ) then fs.RemoveFile( QuickRunFile )
    dim as boolean ok = (code = 0) andalso (counts.Errors = 0)
    BuildSucceeded = ok
    dim as ustring msg = "Build OK"
    if ok = false then msg = "Build failed"
    this.SetMessage( strings.Format( "{}  {} errors, {} warnings", msg, counts.Errors, counts.Warnings ) )
    if ok = false then
        this.ShowOutput( true )
        if counts.ShowLog then
            Out.ShowTab( outputpane.OutputTab.CompilerLog )
        else
            Out.ShowTab( outputpane.OutputTab.Results )
            if counts.FirstError >= 0 then this.OpenDiagnostic( counts.FirstError )
        end if
    elseif build.RunsAfterBuild( BuildAct ) then
        this.RunProgram( LastExe )
    end if
end sub

sub Window.ClearDiagnostics( )
    Diags.Clear( )
    DiagAt = -1
    for each d as DocRef in Docs
        d->Main.ClearSquiggles( )
    next
    tkListTree_Clear( Out.results )
end sub

' Results: a header row per file, a row per record; squiggles in the open buffers.
sub Window.ShowDiagnostics( byref counts as const build.ResultCounts )
    tkListTree_BeginUpdate( Out.results )
    tkListTree_Clear( Out.results )
    dim as ustring lastFile = chr( 1 )
    for i as long = 0 to Diags.Count( ) - 1
        dim as build.Diagnostic dg = Diags[i]
        if dg.File <> lastFile then
            lastFile = dg.File
            dim as ustring hdr = fs.PathFileName( dg.File )
            if len( hdr ) = 0 then hdr = "tiko"
            tkListTree_AddHeader( Out.results, hdr, i )
        end if
        dim as ustring where = ""
        if dg.Line > 0 then where = "(" & dg.Line & "," & dg.Col & ")  "
        tkListTree_InsertString( Out.results, tkListTree_GetCount( Out.results ), where & build.RowText( dg ), i )
        if (dg.Line > 0) andalso ((dg.Kind = build.DiagKind.Error) orelse (dg.Kind = build.DiagKind.Warning)) then
            dim as DocRef t = this.FindOpen( dg.File )
            if t then t->Main.AddSquiggle( dg.Line, dg.Col, dg.EndLine, dg.EndCol, dg.Kind = build.DiagKind.Error )
        end if
    next
    if counts.ExitFailure then
        tkListTree_AddString( Out.results, "Build failed (exit code " & Job.exitCode & ")", -1 )
    end if
    tkListTree_EndUpdate( Out.results )
end sub

sub Window.OpenDiagnostic( byval i as long )
    if (i < 0) orelse (i >= Diags.Count( )) then exit sub
    dim as build.Diagnostic dg = Diags[i]
    if (len( dg.File ) = 0) orelse (dg.Line <= 0) then exit sub
    DiagAt = i
    dim as long selChars = 0
    if (dg.EndLine = dg.Line) andalso (dg.EndCol > dg.Col) then selChars = dg.EndCol - dg.Col
    dim as long col = 0
    if dg.Col > 0 then col = dg.Col - 1
    this.JumpTo( dg.File, dg.Line - 1, col, selChars )
    this.SetMessage( build.RowText( dg ) )
end sub

' Alt+PgDn / Alt+PgUp: the next / previous error or warning with a place, wrapping.
sub Window.StepDiagnostic( byval forward as boolean )
    dim as long n = Diags.Count( )
    if n = 0 then
        this.SetMessage( "no diagnostics" )
        exit sub
    end if
    dim as long i = DiagAt
    for k as long = 1 to n
        if forward then
            i += 1
            if i >= n then i = 0
        else
            i -= 1
            if i < 0 then i = n - 1
        end if
        dim as build.Diagnostic dg = Diags[i]
        if (dg.Line > 0) andalso ((dg.Kind = build.DiagKind.Error) orelse (dg.Kind = build.DiagKind.Warning)) then
            this.OpenDiagnostic( i )
            exit sub
        end if
    next
end sub

' The file shown (opened when it is not), the caret at line ln, character column col (0-based),
' selChars characters selected.
sub Window.JumpTo( byref file as const ustring, byval ln as long, byval col as long, byval selChars as long )
    Nav.RecordJump( this.Here( ) )
    dim as DocRef d = this.FindOpen( file )
    if d then
        this.ShowDoc( d )
    elseif this.OpenFile( file ) = false then
        exit sub
    end if
    if ln >= 0 then this.View( ).GoToLine( ln, col, selChars )      ' -1: where it was
    this.View( ).Focus( )
    Nav.NoteArrival( this.Here( ) )
end sub

' Run: a GUI program directly; a console one in a terminal of its own that waits for a key
' (platform.TerminalArgv), with the project's command line.
sub Window.RunProgram( byref exe as const ustring )
    if (len( exe ) = 0) orelse (fs.IsFile( exe ) = false) then
        this.SetMessage( "nothing to run: build it first (" & exe & ")" )
        exit sub
    end if
    dim as ustring cmdline = RunArgs
    if ProjOpen then cmdline = Proj.CommandLine
    dim as Array( of ustring ) args = project.SplitArgs( cmdline )
    dim as ustring dir_ = fs.PathParent( exe )
    dim as boolean gui = instr( " " & lcase( BuildFlags ) & " ", " -s gui " ) > 0
    dim as Array( of ustring ) argv
    if gui andalso (Prefs.RunInTerminal = false) then
        dim as ustring program = exe
        argv.Push( program )
        for each a as ustring in args
            argv.Push( a )
        next
    else
        argv = platform.TerminalArgv( exe, args, dir_, fs.PathJoin( ConfigDir, "run" ) )
        if argv.Count( ) = 0 then
            this.SetMessage( "no terminal program was found to run it in: set $TERMINAL" )
            exit sub
        end if
    end if
    if Launch( argv, dir_ ) then
        this.SetMessage( "running " & fs.PathFileName( exe ) )
    else
        this.SetMessage( "could not start " & fs.PathFileName( exe ) )
    end if
end sub

sub Window.ShowOutput( byval visible as boolean )
    if OutputShown = visible then exit sub
    OutputShown = visible
    this.Layout( )
    if visible = false then this.View( ).Focus( )
end sub

' Ctrl+Tilde: pane 1, pane 2 (when split), the output pane (when shown), round again.
sub Window.CycleFocus( )
    dim as boolean inOut = this.OutputHasFocus( )
    dim as boolean split_ = (Split <> session.SplitMode.None) andalso (Pane2 <> 0)
    if inOut then
        this.FocusPane( false )
    elseif split_ andalso (InPane2 = false) then
        this.FocusPane( true )
    elseif OutputShown then
        Out.Focus( )
    else
        this.FocusPane( false )
    end if
end sub

' The keyboard focus is somewhere inside the output pane (a list's own surface widget included).
function Window.OutputHasFocus( ) as boolean
    if OutputShown = false then return false
    dim as TK_WIDGET ptr f = tkHost_GetFocus( tkForm_Host( form ) )
    while f
        if f = Out.frame then return true
        f = f->pParent
    wend
    return false
end function

' ================================================================ code intelligence (P5)

private function IsIdentCharU( byval c as ulong ) as boolean
    return ((c >= 48) andalso (c <= 57)) orelse ((c >= 65) andalso (c <= 90)) orelse _
           ((c >= 97) andalso (c <= 122)) orelse (c = 95)
end function

' "a.b.word" before the caret -> word "word", qualifier "b".
private sub SplitQualified( byref before as const ustring, byref word as ustring, byref qualifier as ustring )
    dim as long i = len( before )
    while (i > 0) andalso IsIdentCharU( before[i - 1] )
        i -= 1
    wend
    word = mid( before, i + 1 )
    qualifier = ""
    if (i > 0) andalso (before[i - 1] = 46) then            ' "."
        dim as long j = i - 1
        while (j > 0) andalso IsIdentCharU( before[j - 1] )
            j -= 1
        wend
        qualifier = mid( before, j + 1, i - 1 - j )
    end if
end sub

' Sorted case-blind, each name once.
private function SortNames( byref names as const Array( of ustring ) ) as Array( of ustring )
    dim as Array( of ustring ) keys, out_
    for each n as ustring in names
        dim as ustring k = lcase( n )
        dim as long at = keys.Count( )
        while (at > 0) andalso (keys[at - 1] > k)
            at -= 1
        wend
        if (at > 0) andalso (keys[at - 1] = k) then continue for
        keys.Insert( at, k )
        out_.Insert( at, n )
    next
    return out_
end function

' The toolchain's pkg folder beside the compiler: #import "std/..." resolves there.
function Window.PkgDir( ) as ustring
    dim as ustring c = this.CompilerPath( )
    if len( c ) = 0 then return ""
    dim as ustring d = fs.PathParent( c )
    if fs.IsDir( fs.PathJoin( d, "pkg" ) ) then return fs.PathJoin( d, "pkg" )
    if fs.IsDir( fs.PathJoin( fs.PathParent( d ), "pkg" ) ) then return fs.PathJoin( fs.PathParent( d ), "pkg" )
    return ""
end function

' Loads tikoParser from beside the program and starts its worker. FALSE = code intelligence
' runs on the line-based outline only (the reason is in the Log).
function Window.StartScanner( ) as boolean
    if Scanner.running then return true
    if Scanner.Start( platform.ExeDir( ) ) = false then
        LogText &= "code intelligence: " & Scanner.Lib.LastError( ) & chr( 10 )
        Out.SetLog( LogText )
        return false
    end if
    scanTimer = tkApp_SetTimer( 150, sub( byval id as long, byval payload as any ptr )
        cast( Window ptr, payload )->PollScans( )
    end sub, @this )
    return true
end function

' A buffer's scan: its unsaved text when modified, else the file. Untitled buffers are not scanned.
sub Window.QueueScan( byval d as DocRef )
    if (d = 0) orelse (Scanner.running = false) orelse (len( d->Path ) = 0) then exit sub
    dim as parser.ScanOptions o
    for each inc as ustring in Prefs.Includes
        o.Includes.Push( inc )
    next
    o.PkgDir = this.PkgDir( )
    scanGen += 1
    Scanner.Queue( d->Path, d->Text( ), d->IsModified( ), o, scanGen )
end sub

' Installs what came back; rescans the active buffer 0.7 s after typing stops.
sub Window.PollScans( )
    dim as Array( of parser.Finished ) done
    if Scanner.Poll( done ) then
        for each f as parser.Finished in done
            if f.Ok then
                Db.Install( f.Set )
                ScansInstalled += 1
            else
                LastScanError = f.Error
            end if
        next
    end if
    if scanDirty andalso (SDL_GetTicks( ) - lastEditTicks > 700) andalso (Scanner.Pending( ) = 0) then
        scanDirty = false
        this.QueueScan( this.Active( ) )
    end if
end sub

' A buffer's procedures, by line: tikoParser's when it has scanned the file, else the outline's.
function Window.ProcsOf( byval d as DocRef ) as Array( of SymHit )
    dim as Array( of SymHit ) out_
    if d = 0 then return out_
    if (len( d->Path ) > 0) andalso Db.HasFile( d->Path ) then
        for each r as symboldb.SymRef in Db.Procedures( d->Path )
            dim byref as symboldb.Sym y = Db.Item( r )
            dim as SymHit hh
            hh.Name = Db.QualifiedName( r )
            hh.Kind = "sub"
            if y.Kind = symboldb.SymKind.FunctionProc then hh.Kind = "function"
            hh.Path = d->Path
            hh.Line = y.BodyLine - 1
            hh.Doc = d
            out_.Push( hh )
        next
        return out_
    end if
    for each y as outline.Symbol in outline.Scan( d->Text( ) )
        if outline.IsProcedure( y.Kind ) = false then continue for
        dim as SymHit hh
        hh.Name = y.Name
        hh.Kind = outline.KindWord( y.Kind )
        hh.Path = d->Path
        hh.Line = y.Line
        hh.Doc = d
        out_.Push( hh )
    next
    return out_
end function

' Where the caret is, for the jump history.
function Window.Here( ) as navhistory.NavEntry
    dim as DocRef d = this.Active( )
    dim as navhistory.NavEntry none_
    if (d = 0) orelse (len( d->Path ) = 0) then return none_
    dim as editor.CodeView ptr v = @this.View( )
    return navhistory.MakeEntry( d->Path, v->CaretLine( ) - 1, v->Position( ), v->Length( ), v->FirstLine( ) )
end function

' Alt+Left / Alt+Right.
sub Window.GoHistory( byval forward as boolean )
    dim as navhistory.NavEntry e
    if forward then
        e = Nav.Forward( this.Here( ) )
    else
        e = Nav.Back( this.Here( ) )
    end if
    if len( e.File ) = 0 then exit sub
    Nav.Suppress( )
    dim as DocRef d = this.FindOpen( e.File )
    if d then
        this.ShowDoc( d )
    elseif this.OpenFile( e.File ) = false then
        Nav.Unsuppress( )
        exit sub
    end if
    dim as editor.CodeView ptr v = @this.View( )
    if navhistory.UseExactPosition( e, v->Length( ) ) then
        v->SetPosition( e.Position )
    else
        v->GoToLine( e.Line )
    end if
    v->SetFirstLine( e.FirstLine )
    Nav.Unsuppress( )
    this.ShowStatus( )
end sub

' The parser's uppercased path back to the open buffer's or the project's spelling, else the disk's.
function Window.ScannedFile( byref upper as const ustring ) as ustring
    for each d as DocRef in Docs
        if ucase( d->Path ) = ucase( upper ) then return d->Path
    next
    if ProjOpen then
        for i as long = 0 to Proj.FileCount( ) - 1
            if ucase( Proj.FilePath( i ) ) = ucase( upper ) then return Proj.FilePath( i )
        next
    end if
    return symboldb.RealPath( upper )
end function

' F12: the definition of the word under the caret (qualified by what stands before a ".").
function Window.GoToDefinition( ) as boolean
    dim as editor.CodeView ptr v = @this.View( )
    dim as DocRef d = this.Active( )
    if d = 0 then return false
    dim as ustring word = v->WordAtCaret( )
    if len( word ) = 0 then return false
    dim as ustring lineText = v->LineTextAt( v->CaretLine( ) - 1 )
    dim as long at = instr( lineText, word )
    dim as long caretCol = v->CaretColumn( )
    while (at > 0) andalso (at + len( word ) < caretCol)        ' the occurrence that holds the caret
        dim as long nx = instr( at + 1, lineText, word )
        if nx = 0 then exit while
        at = nx
    wend
    dim as ustring w2, qual
    SplitQualified( left( lineText, at - 1 + len( word ) ), w2, qual )
    dim as symboldb.SymRef r = Db.Definition( word, d->Path, v->CaretLine( ), qual )
    if r.IsValid( ) = false then
        ' no scan: the outline of the open buffers
        for each b as DocRef in Docs
            for each hh as SymHit in this.ProcsOf( b )
                if lcase( hh.Name ) = lcase( word ) then
                    this.JumpTo( b->Path, hh.Line, 0, 0 )
                    return true
                end if
            next
        next
        this.SetMessage( "no definition found for " & word )
        return false
    end if
    dim as symboldb.Sym y = Db.Item( r )
    dim as ustring target = this.ScannedFile( y.File )
    if len( target ) = 0 then return false
    dim as long ln = y.LineNo
    if y.BodyLine > 0 then ln = y.BodyLine
    this.JumpTo( target, ln - 1, 0, 0 )
    return true
end function

' Ctrl+PgDn / Ctrl+PgUp: the nearest procedure below (above) the caret's line.
sub Window.GoFunction( byval forward as boolean )
    dim as DocRef d = this.Active( )
    if d = 0 then exit sub
    dim as editor.CodeView ptr v = @this.View( )
    dim as long cur = v->CaretLine( ) - 1, best = -1
    for each hh as SymHit in this.ProcsOf( d )
        if forward then
            if (hh.Line > cur) andalso ((best < 0) orelse (hh.Line < best)) then best = hh.Line
        elseif (hh.Line < cur) andalso (hh.Line > best) then
            best = hh.Line
        end if
    next
    if best < 0 then exit sub
    Nav.RecordJump( this.Here( ) )
    v->GoToLine( best )
    Nav.NoteArrival( this.Here( ) )
    this.ShowStatus( )
end sub

' Completion and calltips while typing (settings codetips): "(" the calltip, ")" gone, "." the
' members, a third identifier character the names that start so (types after "as ").
sub Window.CodeTips( byval hEdit as TK_WIDGET ptr, byval ch as long )
    if Prefs.CodeTips = false then exit sub
    dim as DocRef d = this.DocOfWidget( hEdit )
    if d = 0 then exit sub
    dim as editor.CodeView ptr v = @d->Main
    if d->Other.Exists( ) andalso (d->Other.Widget( ) = hEdit) then v = @d->Other
    dim as long ln = v->CaretLine( )
    if ch = 40 then
        dim as ustring before = v->TextBeforeCaret( )
        dim as ustring word, qual
        SplitQualified( left( before, len( before ) - 1 ), word, qual )
        if len( word ) then
            dim as ustring tip = Db.CallTip( word, qual, d->Path, ln )
            if len( tip ) then v->ShowCallTip( tip )
        end if
        exit sub
    end if
    if ch = 41 then
        v->CancelCallTip( )
        exit sub
    end if
    if ch = 46 then
        dim as ustring before = v->TextBeforeCaret( )
        dim as ustring word, qual
        SplitQualified( left( before, len( before ) - 1 ), word, qual )
        if len( word ) then
            dim as Array( of ustring ) items = Db.MemberNames( word, d->Path, ln )
            if items.Count( ) then v->ShowCompletions( 0, items )
        end if
        exit sub
    end if
    if IsIdentCharU( ch ) = false then exit sub
    if v->CompletionsShown( ) then exit sub                     ' Scintilla filters as typing goes on
    this.ShowCompletionsAt( v, d, 3 )
end sub

' The names that start like the word before the caret: the scan's, the outline's procedures,
' the keywords. minLen: how much must be typed first (Ctrl+Space: 0).
sub Window.ShowCompletionsAt( byval v as editor.CodeView ptr, byval d as DocRef, byval minLen as long )
    dim as ustring before = v->TextBeforeCaret( )
    dim as ustring word, qual
    SplitQualified( before, word, qual )
    if len( word ) < minLen then exit sub
    dim as Array( of ustring ) items
    if len( qual ) then
        items = Db.MemberNames( qual, d->Path, v->CaretLine( ) )
    elseif instr( lcase( right( before, len( word ) + 4 ) ), "as " ) = 1 then
        items = Db.TypeNames( word )
    else
        items = Db.Completions( word, d->Path, v->CaretLine( ) )
        if Db.HasFile( d->Path ) = false then
            for each hh as SymHit in this.ProcsOf( d )
                if lcase( left( hh.Name, len( word ) ) ) = lcase( word ) then items.Push( hh.Name )
            next
        end if
        dim as ustring lw = lcase( word )
        for each k as ustring in strings.Split( Look.Words.Words1, " " )
            if left( k, len( lw ) ) = lw then items.Push( k )
            if items.Count( ) > 300 then exit for
        next
    end if
    items = SortNames( items )
    if items.Count( ) = 0 then exit sub
    if (items.Count( ) = 1) andalso (lcase( items[0] ) = lcase( word )) andalso (minLen > 0) then exit sub
    v->ShowCompletions( len( word ), items )
end sub

' ================================================================ P6: the formatter, Find in Project

' Alt+Shift+F: the active buffer through tkc/format (its default rules, the settings' tab size),
' in one undo step, the view kept where it was.
function Window.FormatDocument( ) as boolean
    if FormatterReady = false then
        Fmt.SetKeywords( Look.Words.Words1, Look.Words.Words2, Look.Words.Words3 )
        FormatterReady = true
    end if
    dim as editor.CodeView ptr v = @this.View( )
    dim as format.FormatResult r = Fmt.FormatText( v->Text( ), format.DefaultRules( ), Prefs.TabSize, Prefs.UseTabs )
    if r.Changed = false then
        this.SetMessage( "already formatted" )
        return false
    end if
    v->ReplaceAllText( r.Text )
    this.SetMessage( "formatted" )
    return true
end function

' Every file of the project (with no project: every open buffer) searched for the strip's phrase
' with its Aa / W / .* -- in a hidden view, so the matching is Find's own. An open buffer's text is
' searched as it stands, unsaved edits included. The Search tab gets a header per file and a row
' per match; the count is the return.
function Window.RunProjectSearch( ) as long
    dim as ustring p = Finder.Phrase( )
    if len( p ) = 0 then return 0
    dim as editor.FindOptions o = Finder.Options( )
    o.InSelection = false
    if scratch.Exists( ) = false then
        if scratch.Create( tkForm_Widget( form ), ID_SCRATCH ) = false then return 0
        tkWidget_Show( scratch.Widget( ), false )
    end if
    ' the files: the project's, then any open buffer not among them
    dim as Array( of ustring ) paths
    dim as Map( of ustring, boolean ) seen
    if ProjOpen then
        for i as long = 0 to Proj.FileCount( ) - 1
            dim as ustring f = Proj.FilePath( i )
            if seen.Contains( ucase( f ) ) then continue for
            seen.Put( ucase( f ), true )
            paths.Push( f )
        next
    end if
    for each d as DocRef in Docs
        if (len( d->Path ) = 0) orelse seen.Contains( ucase( d->Path ) ) then continue for
        seen.Put( ucase( d->Path ), true )
        paths.Push( d->Path )
    next
    Found.Clear( )
    dim as TK_WIDGET ptr list = Out.search
    tkListTree_BeginUpdate( list )
    tkListTree_Clear( list )
    dim as long files_ = 0
    for each f as ustring in paths
        dim as ustring text
        dim as DocRef d = this.FindOpen( f )
        if d then
            text = d->Text( )
        else
            dim as Result( of docencoding.LoadedText, fs.FsError ) lt = docencoding.LoadFile( f )
            if lt.IsOk( ) = false then continue for
            text = lt.Value( ).Text
        end if
        scratch.SetText( text )
        dim as boolean bad = false
        dim as Array( of textsearch.TextMatch ) ms = scratch.MatchesOf( p, o, SEARCH_LIMIT - Found.Count( ), bad )
        if bad then
            tkListTree_EndUpdate( list )
            Finder.SetStatus( "not a valid regular expression" )
            return 0
        end if
        if ms.Count( ) = 0 then continue for
        files_ += 1
        tkListTree_AddHeader( list, strings.Format( "{}  ({})", fs.PathFileName( f ), ms.Count( ) ), -1 )
        for each m as textsearch.TextMatch in ms
            dim as SearchHit hh
            hh.Path = f
            hh.Line = m.Line
            hh.Column = m.Column
            hh.Length = m.Length
            Found.Push( hh )
            tkListTree_InsertString( list, tkListTree_GetCount( list ), _
                                     (m.Line + 1) & ": " & trim( scratch.LineTextAt( m.Line ) ), Found.Count( ) - 1 )
        next
        if Found.Count( ) >= SEARCH_LIMIT then exit for
    next
    tkListTree_EndUpdate( list )
    scratch.SetText( "" )
    dim as ustring msg = strings.Format( "{} matches in {} files", Found.Count( ), files_ )
    if Found.Count( ) >= SEARCH_LIMIT then msg &= " (stopped at the limit)"
    if Found.Count( ) = 0 then
        Finder.SetStatus( "No matches" )
        return 0
    end if
    Finder.Close( )
    this.ShowOutput( true )
    Out.ShowTab( outputpane.OutputTab.Search )
    this.Layout( )
    this.SetMessage( msg )
    this.OpenSearchHit( 0 )
    return Found.Count( )
end function

sub Window.OpenSearchHit( byval i as long )
    if (i < 0) orelse (i >= Found.Count( )) then exit sub
    dim as SearchHit hh = Found[i]
    this.JumpTo( hh.Path, hh.Line, hh.Column, hh.Length )
end sub

' Ctrl+Shift+H / Ctrl+Shift+C: the header beside a source file (x.tiko -> x.ti, x.bas -> x.bi) or
' the source beside a header, opened when it exists.
sub Window.GoToCompanion( byval header as boolean )
    dim as ustring p = this.ActivePath( )
    if len( p ) = 0 then exit sub
    dim as ustring stem = fs.PathJoin( fs.PathParent( p ), fs.PathStem( p ) )
    dim as Array( of ustring ) tries
    if header then
        tries.Push( stem & ".ti" )
        tries.Push( stem & ".bi" )
    else
        tries.Push( stem & ".tiko" )
        tries.Push( stem & ".bas" )
    end if
    for each f as ustring in tries
        if fs.IsFile( f ) then
            this.JumpTo( f, -1, 0, 0 )
            exit sub
        end if
    next
    this.SetMessage( "no " & fs.PathFileName( tries[0] ) )
end sub

