'' llvmtype.ti -- MIR spellings turned into LLVM ones.
''
'' Kept apart from the emitter because these are decisions, not transcription, and each
'' one is written down where it is made rather than inline at forty call sites.

#ifndef __TKO_LLVMTYPE_BI__
#define __TKO_LLVMTYPE_BI__

#include once "tko.ti"
#include once "mir/mir.ti"

namespace Tko.Codegen

    '' The LLVM type for a MIR type. An AGGREGATE needs its SIZE, which MIR keeps
    '' beside the slot rather than in the type, so it is passed in.
    declare function LlvmType _
        ( byval t as Tko.Mir.MirType, byval aggSize as long = 0 ) as string

    '' AN AGGREGATE IS A BYTE ARRAY, not a reconstructed struct.
    ''
    '' LLVM does not need a FreeBASIC UDT's fields to lay it out correctly -- the
    '' frontend's layout pass already decided every offset, and MIR addresses fields by
    '' the byte offsets it computed (M_FIELD_ADDR, M_PTR_ADD). Emitting a real struct
    '' type would hand LLVM a SECOND opinion about the layout, and where the two
    '' disagreed LLVM's would win silently.
    ''
    '' So the object is exactly its storage, and alignment is stated explicitly at every
    '' alloca and every load and store rather than being implied by the type -- '[12 x
    '' i8]' is 1-aligned and the thing it holds usually is not.
    ''
    '' The cost is that a debugger sees a byte array; debug info (phase 11) describes
    '' the real fields separately and does not depend on this.
    declare function AggType( byval sizeBytes as long ) as string

    '' A FLOAT CONSTANT IN HEXADECIMAL, always.
    ''
    '' LLVM accepts a decimal float literal only when it is EXACTLY representable, and
    '' silently means something slightly different when a printed decimal is not the
    '' value that was meant. The hex form is the IEEE-754 bit pattern of a DOUBLE and is
    '' exact by construction -- including for 'float', where LLVM wants the bits of the
    '' double that the float widens to.
    declare function LlvmFloatConst _
        ( byval v as double, byval isSingle as boolean ) as string

    '' A SysV aggregate returned in TWO registers, spelled the way clang spells it:
    '' '{ i64, i32 }' for a twelve-byte struct of integers. See abi.tiko.
    declare function LlvmPairType _
        ( byval t0 as Tko.Mir.MirType, byval t1 as Tko.Mir.MirType ) as string

    '' Opcode spellings: a comparison's predicate (isFloat says fcmp or icmp), a math
    '' opcode's intrinsic without its type suffix, and the libm name of the four that
    '' have no intrinsic.
    declare function CmpPred _
        ( byval op as Tko.Mir.MirOp, byref isFloat as boolean ) as string
    declare function MathIntrinsic( byval op as Tko.Mir.MirOp ) as string
    declare function LibmName( byval op as Tko.Mir.MirOp ) as string

end namespace

#endif
