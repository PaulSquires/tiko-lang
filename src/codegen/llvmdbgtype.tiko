'' llvmdbgtype.tiko -- '-g' TYPES: a TypeId as the DWARF type nodes that describe its
'' storage. Included into llvmdebug.tiko, whose node helpers it shares.
''
'' The shapes are clang's own for the same C, read from 'clang -S -emit-llvm -g' 21.1:
'' a DIBasicType per scalar, DIDerivedType pointer / reference / const / member,
'' DICompositeType structure / union / enumeration / array. The TypeId is memoised and
'' its number RESERVED before its body is written, so a UDT that points at itself
'' refers to its own number rather than recursing.
''
'' THE NAMES ARE FREEBASIC'S ('long', 'integer', 'zstring'), with three exceptions a
'' debugger keys on: a wide character is 'wchar_t' and a UTF-16 unit 'char16_t', or
'' lldb shows a 'wstring * N' as a list of numbers instead of the text.

'' The source spelling of a symbol's name: the identifier at its declaration, when that
'' folds to the symbol's own name, and the folded name otherwise (a macro, a synthesised
'' symbol). Names intern folded, so the source text is the only record of the case.
private function SpellingOf_( byref d as DebugInfo, byval s as Tko.Symbol ptr ) as string
    dim as string folded = d.fe->names->Spelling( s->name )
    if d.sm = 0 then return folded
    dim as Tko.DecodedLoc dl = d.sm->Decode( s->loc )
    dim as Tko.SourceFile ptr sf = d.sm->FileAt( dl.file )
    if sf = 0 then return folded
    '' THE LOCATION IS THE DECLARATION'S, NOT ALWAYS THE NAME'S: a UDT's is its 'type',
    '' a parameter's its 'byval'. So the first identifier ON THAT LINE that folds to the
    '' name is taken, which the name always is.
    '' ...and the WHOLE line is read, from its start: a shared variable's location is
    '' past its name.
    dim as string raw
    dim as int32 i = dl.offset
    if (dl.physLine >= 1) andalso (dl.physLine <= sf->lineStarts.Count) then
        i = sf->lineStarts[dl.physLine - 1]
    end if
    dim as int32 lim = i + 1024
    while (i >= 0) andalso (i < sf->text.Count) andalso (i < lim)
        dim as uint8 ch = sf->text[i]
        if (ch = 10) orelse (ch = 13) then exit while
        dim as boolean isId = ((ch >= 65) andalso (ch <= 90)) orelse _
                              ((ch >= 97) andalso (ch <= 122)) orelse _
                              ((ch >= 48) andalso (ch <= 57)) orelse (ch = 95)
        if isId then
            raw += chr( ch )
        else
            if (len( raw ) > 0) andalso (Tko.Text.LowerAscii( raw ) = folded) then return raw
            raw = ""
        end if
        i += 1
    wend
    if (len( raw ) > 0) andalso (Tko.Text.LowerAscii( raw ) = folded) then return raw
    return folded
end function

private function PtrBits_( byref d as DebugInfo ) as int32
    return d.fe->types->target.pointerBits
end function

'' '!N' for a type node, 'null' for void.
private function TypeRef_( byval ty as int32 ) as string
    if ty <= 0 then return "null"
    return "!" & str( ty )
end function

'' A value MIR passes BY ADDRESS when it is taken by value: a UDT, a string, a dynamic
'' array. A scalar or a pointer in a pointer slot is itself.
private function NeedsIndirection_( byref d as DebugInfo, byval t as Tko.TypeId ) as boolean
    dim as Tko.TypeContext ptr tc = d.fe->types
    dim as Tko.TypeId u = tc->Unqualify( t )
    select case tc->Kind( u )
    case Tko.TK_UDT
        return true
    case Tko.TK_ARRAY
        return tc->IsDynArray( u )
    case Tko.TK_BUILTIN
        dim as Tko.BuiltinType b = tc->BuiltinOf( u )
        return (b = Tko.TY_STRING) orelse (b = Tko.TY_USTRING)
    end select
    return false
end function

'' The declaring symbol of a UDT or an enum.
private function NamedSym_( byref d as DebugInfo, byval t as Tko.TypeId ) as Tko.Symbol ptr
    dim as Tko.TypeContext ptr tc = d.fe->types
    dim as Tko.SymbolId sid = d.fe->syms->LookupLocalTyped( _
        cast( Tko.ScopeId, tc->DeclScopeOf( t ) ), tc->NameOf( t ), true )
    if sid = Tko.SYMBOL_NONE then return 0
    dim as Tko.Symbol ptr s = d.fe->syms->SymbolAt( sid )
    if s = 0 then return 0
    if (s->kind <> cast( uint8, Tko.SYM_UDT )) andalso _
       (s->kind <> cast( uint8, Tko.SYM_ENUM )) then return 0
    return s
end function

private function TypeName_( byref d as DebugInfo, byval t as Tko.TypeId ) as string
    dim as Tko.Symbol ptr s = NamedSym_( d, t )
    if s <> 0 then return SpellingOf_( d, s )
    return d.fe->types->Name( t )
end function

declare function DbgType( byref d as DebugInfo, byval t as Tko.TypeId ) as int32

'' A type as FreeBASIC writes it -- 'long', 'Node ptr', 'zstring * 8' -- for the names
'' a debugger shows: an array's element and a dynamic array's descriptor.
private function DisplayName_( byref d as DebugInfo, byval t as Tko.TypeId ) as string
    dim as Tko.TypeContext ptr tc = d.fe->types
    dim as Tko.TypeId u = tc->Unqualify( t )
    select case tc->Kind( u )
    case Tko.TK_BUILTIN
        return Tko.BuiltinName( tc->BuiltinOf( u ) )
    case Tko.TK_UDT, Tko.TK_ENUM
        return TypeName_( d, u )
    case Tko.TK_POINTER
        return DisplayName_( d, tc->Inner( u ) ) & " ptr"
    end select
    return tc->Name( u )
end function

'' The storage size of a type in BYTES, as layout computes it.
private function SizeBytes_( byref d as DebugInfo, byval t as Tko.TypeId ) as int64
    dim as Tko.TypeContext ptr tc = d.fe->types
    dim as Tko.TypeId u = tc->Unqualify( t )
    select case tc->Kind( u )
    case Tko.TK_UDT
        dim as int32 ui = d.fe->udts->Find( u )
        if ui >= 0 then return d.fe->udts->udts[ui].size
        return 0
    case Tko.TK_ARRAY
        if tc->IsDynArray( u ) then
            dim as int32 rk = tc->DynRank( u )
            if rk <= 0 then rk = 8
            return (PtrBits_( d ) \ 8) * (6 + 3 * rk)
        end if
        return cast( int64, tc->types[cast( int32, u )].elems ) * SizeBytes_( d, tc->Inner( u ) )
    case Tko.TK_TYPEDEF
        return SizeBytes_( d, tc->Inner( u ) )
    end select
    return tc->Layout( u ).size
end function

private function Basic_( byref nm as string, byval bits as int32, byref enc as string ) as string
    return "!DIBasicType(name: " & MetaStr_( nm ) & ", size: " & str( bits ) & _
           ", encoding: " & enc & ")"
end function

'' A typedef called 'nm' over the basic type 'basic' (a node body).
private function Named_( byref d as DebugInfo, byref nm as string, byref basic as string ) as string
    dim as int32 b = NewNode_( d, basic )
    return "!DIDerivedType(tag: DW_TAG_typedef, name: " & MetaStr_( nm ) & ", baseType: !" & _
           str( b ) & ")"
end function

'' 'integer', for the descriptors' counts and an enum's underlying type.
private function IntType_( byref d as DebugInfo ) as int32
    if d.intType = 0 then
        d.intType = DbgType( d, d.fe->types->Builtin( Tko.TY_INTEGER ) )
    end if
    return d.intType
end function

private function Member_( byref d as DebugInfo, byval scope_ as int32, byref nm as string, _
                          byval ty as int32, byval bits as int64, byval offBits as int64 ) as int32
    return NewNode_( d, "!DIDerivedType(tag: DW_TAG_member, name: " & MetaStr_( nm ) & _
                        ", scope: !" & str( scope_ ) & ", baseType: " & TypeRef_( ty ) & _
                        ", size: " & str( bits ) & ", offset: " & str( offBits ) & ")" )
end function

'' A STRING or USTRING: the descriptor, { data, len, size }. 'unit' is the character.
private sub Descriptor_( byref d as DebugInfo, byval id as int32, byref nm as string, _
                         byval unitTy as int32 )
    dim as int32 pb = PtrBits_( d )
    dim as int32 pdata = NewNode_( d, "!DIDerivedType(tag: DW_TAG_pointer_type, baseType: " & _
                                     TypeRef_( unitTy ) & ", size: " & str( pb ) & ")" )
    dim as int32 it = IntType_( d )
    dim as int32 m0 = Member_( d, id, "data", pdata, pb, 0 )
    dim as int32 m1 = Member_( d, id, "len", it, pb, pb )
    dim as int32 m2 = Member_( d, id, "size", it, pb, 2 * pb )
    DefineNode_( d, id, "!DICompositeType(tag: DW_TAG_structure_type, name: " & _
                        MetaStr_( nm ) & ", size: " & str( 3 * pb ) & _
                        ", elements: !{!" & str( m0 ) & ", !" & str( m1 ) & ", !" & _
                        str( m2 ) & "})" )
end sub

private function Builtin_( byref d as DebugInfo, byval id as int32, byval t as Tko.TypeId ) as int32
    dim as Tko.TypeContext ptr tc = d.fe->types
    dim as Tko.BuiltinType b = tc->BuiltinOf( t )
    dim as int32 bits = tc->Layout( t ).size * 8
    dim as string nm = Tko.BuiltinName( b )
    dim as string body_
    select case b
    case Tko.TY_VOID, Tko.TY_ANY
        return 0
    '' THE SCALARS ARE TYPEDEFS NAMED AS FREEBASIC NAMES THEM, over a basic type. lldb
    '' re-spells a basic type in C by its encoding and width -- 'integer' came back as
    '' 'long long', 'ubyte' as 'unsigned char' -- and keeps a typedef's name, which is
    '' also what a debugger front end keys a display format on.
    case Tko.TY_BYTE, Tko.TY_SHORT, Tko.TY_LONG, Tko.TY_INTEGER, Tko.TY_LONGINT
        body_ = Named_( d, nm, Basic_( nm & "$", bits, "DW_ATE_signed" ) )
    case Tko.TY_UBYTE, Tko.TY_USHORT, Tko.TY_ULONG, Tko.TY_UINTEGER, Tko.TY_ULONGINT
        body_ = Named_( d, nm, Basic_( nm & "$", bits, "DW_ATE_unsigned" ) )
    case Tko.TY_SINGLE, Tko.TY_DOUBLE
        body_ = Named_( d, nm, Basic_( nm & "$", bits, "DW_ATE_float" ) )
    case Tko.TY_BOOLEAN
        body_ = Named_( d, nm, Basic_( nm & "$", bits, "DW_ATE_boolean" ) )
    case Tko.TY_ZSTRING, Tko.TY_FIXSTR
        body_ = Basic_( "char", 8, "DW_ATE_signed_char" )
    case Tko.TY_WSTRING
        body_ = Basic_( "wchar_t", tc->target.wcharBytes * 8, "DW_ATE_unsigned" )
    case Tko.TY_FIXUSTR
        body_ = Basic_( "char16_t", 16, "DW_ATE_UTF" )
    case Tko.TY_STRING
        Descriptor_( d, id, "string", DbgType( d, tc->Builtin( Tko.TY_ZSTRING ) ) )
        return id
    case Tko.TY_USTRING
        Descriptor_( d, id, "ustring", DbgType( d, tc->Builtin( Tko.TY_FIXUSTR ) ) )
        return id
    case else
        '' cva_list and anything newer: its bytes, unsigned.
        if bits <= 0 then return -1
        body_ = Basic_( nm, bits, "DW_ATE_unsigned" )
    end select
    DefineNode_( d, id, body_ )
    return id
end function

'' A FIXED ARRAY: one DISubrange per dimension, outermost first -- FreeBASIC is row-major,
'' as C is. A 'zstring * N' is an array too, of N characters with no declared bounds.
private function FixedArray_( byref d as DebugInfo, byval id as int32, byval t as Tko.TypeId ) as int32
    dim as Tko.TypeContext ptr tc = d.fe->types
    dim as int32 et = DbgType( d, tc->Inner( t ) )
    if et < 0 then return -1
    dim as int32 rank = tc->types[cast( int32, t )].dims
    dim as string subs = ""
    dim as string bounds = ""
    for k as int32 = 0 to rank - 1
        dim as boolean k1, k2
        dim as int64 lo = tc->ArrayBound( t, k, false, k1 )
        dim as int64 hi = tc->ArrayBound( t, k, true, k2 )
        if (k1 = false) orelse (k2 = false) then
            subs = ""
            bounds = ""
            exit for
        end if
        bounds += iif( len( bounds ) > 0, ", ", "" ) & str( lo ) & " to " & str( hi )
        dim as int32 sr = NewNode_( d, "!DISubrange(count: " & str( hi - lo + 1 ) & _
                                      ", lowerBound: " & str( lo ) & ")" )
        subs += iif( len( subs ) > 0, ", !", "!" ) & str( sr )
    next
    if len( subs ) = 0 then
        dim as int32 sr = NewNode_( d, "!DISubrange(count: " & _
                                      str( tc->types[cast( int32, t )].elems ) & ")" )
        subs = "!" & str( sr )
    end if
    dim as string arr = "!DICompositeType(tag: DW_TAG_array_type, baseType: " & _
                        TypeRef_( et ) & ", size: " & str( SizeBytes_( d, t ) * 8 ) & _
                        ", elements: !{" & subs & "})"
    '' AN ARRAY WITH DECLARED BOUNDS IS NAMED AS FREEBASIC DECLARES IT: a typedef called
    '' 'long(1 to 3)' over the array. lldb numbers elements from 0 whatever the
    '' subrange's lowerBound says, and DAP carries no bounds at all -- so the type NAME is
    '' how the editor's debugger learns them, and it is what it shows as the type.
    '' ...AND A FIXED-LENGTH STRING AS FREEBASIC WRITES IT, 'zstring * 8' / 'string * 5' /
    '' 'wstring * 8' / 'ustring * 8', so a debugger can tell a NUL-terminated buffer from
    '' a space-padded one: both are arrays of 'char', and only the zstring stops at a NUL.
    dim as string fixNm = ""
    dim as Tko.TypeId el = tc->Unqualify( tc->Inner( t ) )
    if (len( bounds ) = 0) andalso (tc->Kind( el ) = Tko.TK_BUILTIN) then
        select case tc->BuiltinOf( el )
        case Tko.TY_ZSTRING : fixNm = "zstring"
        case Tko.TY_FIXSTR  : fixNm = "string"
        case Tko.TY_WSTRING : fixNm = "wstring"
        case Tko.TY_FIXUSTR : fixNm = "ustring"
        end select
    end if
    if len( fixNm ) > 0 then
        dim as int32 an = NewNode_( d, arr )
        DefineNode_( d, id, "!DIDerivedType(tag: DW_TAG_typedef, name: " & _
                            MetaStr_( fixNm & " * " & str( tc->types[cast( int32, t )].elems ) ) & _
                            ", baseType: !" & str( an ) & ")" )
    elseif len( bounds ) > 0 then
        dim as int32 an = NewNode_( d, arr )
        DefineNode_( d, id, "!DIDerivedType(tag: DW_TAG_typedef, name: " & _
                            MetaStr_( DisplayName_( d, tc->Inner( t ) ) & "(" & bounds & ")" ) & _
                            ", baseType: !" & str( an ) & ")" )
    else
        DefineNode_( d, id, arr )
    end if
    return id
end function

'' A DYNAMIC ARRAY is its descriptor (lib/rt/src/inc/descriptors.ti, src/mir/lowerdesc.tiko):
'' data, ptr, size, element_len, dimensions, flags, then dimtb[rank] { elements, lbound,
'' ubound }. 'data' is typed, so a debugger can show the elements through it.
private function DynArray_( byref d as DebugInfo, byval id as int32, byval t as Tko.TypeId ) as int32
    dim as Tko.TypeContext ptr tc = d.fe->types
    dim as int32 et = DbgType( d, tc->Inner( t ) )
    if et < 0 then return -1
    dim as int32 pb = PtrBits_( d )
    dim as int32 it = IntType_( d )
    dim as int32 rk = tc->DynRank( t )
    if rk <= 0 then rk = 8
    dim as int32 pe = NewNode_( d, "!DIDerivedType(tag: DW_TAG_pointer_type, baseType: " & _
                                  TypeRef_( et ) & ", size: " & str( pb ) & ")" )
    dim as int32 dimT = ReserveNode_( d )
    dim as int32 e0 = Member_( d, dimT, "elements", it, pb, 0 )
    dim as int32 e1 = Member_( d, dimT, "lbound", it, pb, pb )
    dim as int32 e2 = Member_( d, dimT, "ubound", it, pb, 2 * pb )
    DefineNode_( d, dimT, "!DICompositeType(tag: DW_TAG_structure_type, name: ""FBARRAYDIM"", " & _
                          "size: " & str( 3 * pb ) & ", elements: !{!" & str( e0 ) & ", !" & _
                          str( e1 ) & ", !" & str( e2 ) & "})" )
    dim as int32 sr = NewNode_( d, "!DISubrange(count: " & str( rk ) & ")" )
    dim as int32 dimsArr = NewNode_( d, "!DICompositeType(tag: DW_TAG_array_type, baseType: !" & _
                                       str( dimT ) & ", size: " & str( 3 * pb * rk ) & _
                                       ", elements: !{!" & str( sr ) & "})" )
    dim as string ms = ""
    ms += "!" & str( Member_( d, id, "data", pe, pb, 0 ) )
    ms += ", !" & str( Member_( d, id, "ptr", pe, pb, pb ) )
    ms += ", !" & str( Member_( d, id, "size", it, pb, 2 * pb ) )
    ms += ", !" & str( Member_( d, id, "element_len", it, pb, 3 * pb ) )
    ms += ", !" & str( Member_( d, id, "dimensions", it, pb, 4 * pb ) )
    ms += ", !" & str( Member_( d, id, "flags", it, pb, 5 * pb ) )
    ms += ", !" & str( Member_( d, id, "dimtb", dimsArr, 3 * pb * rk, 6 * pb ) )
    DefineNode_( d, id, "!DICompositeType(tag: DW_TAG_structure_type, name: " & _
                        MetaStr_( "FBARRAY(" & DisplayName_( d, tc->Inner( t ) ) & ")" ) & _
                        ", size: " & str( (6 + 3 * rk) * pb ) & ", elements: !{" & ms & "})" )
    return id
end function

'' The unsigned integer of the same width, for a bitfield.
private function Unsigned_( byref d as DebugInfo, byval t as Tko.TypeId ) as Tko.TypeId
    dim as Tko.TypeContext ptr tc = d.fe->types
    if tc->Kind( t ) <> Tko.TK_BUILTIN then return t
    select case tc->BuiltinOf( t )
    case Tko.TY_BYTE    : return tc->Builtin( Tko.TY_UBYTE )
    case Tko.TY_SHORT   : return tc->Builtin( Tko.TY_USHORT )
    case Tko.TY_LONG    : return tc->Builtin( Tko.TY_ULONG )
    case Tko.TY_INTEGER : return tc->Builtin( Tko.TY_UINTEGER )
    case Tko.TY_LONGINT : return tc->Builtin( Tko.TY_ULONGINT )
    end select
    return t
end function

'' A UDT: its fields from the layout store, in declaration order with their offsets.
'' An anonymous union's members arrive already flattened at their real offsets, so they
'' are plain members; 'extends' is the field named 'base', and it is INHERITANCE.
private function Udt_( byref d as DebugInfo, byval id as int32, byval t as Tko.TypeId ) as int32
    dim as Tko.TypeContext ptr tc = d.fe->types
    dim as Tko.Symbol ptr us = NamedSym_( d, t )
    dim as string nm = TypeName_( d, t )
    dim as int32 fl = d.mainFileId, ln = 0
    if us <> 0 then DeclSite_( d, us, fl, ln )
    dim as string tag = "DW_TAG_structure_type"
    if us <> 0 then
        if (us->flags and Tko.SYMF_UNION_KIND) <> 0 then tag = "DW_TAG_union_type"
    end if
    dim as int32 ui = d.fe->udts->Find( t )
    if ui < 0 then
        '' INCOMPLETE -- declared, never defined here: a forward declaration.
        DefineNode_( d, id, "!DICompositeType(tag: " & tag & ", name: " & MetaStr_( nm ) & _
                            ", file: !" & str( fl ) & ", line: " & str( ln ) & _
                            ", flags: DIFlagFwdDecl)" )
        return id
    end if
    dim as Tko.UdtInfo ptr info = @d.fe->udts->udts[ui]
    dim as string ms = ""
    for k as int32 = info->first to info->first + info->count - 1
        dim as Tko.UdtField ptr fd = @d.fe->udts->fields[k]
        '' A BITFIELD READS UNSIGNED, whatever it was declared as: measured, fbc prints
        '' 5 for 'A : 3 as long' holding 5, where a signed 3-bit field would be -3.
        dim as Tko.TypeId fty = fd->type_
        if fd->bitWidth > 0 then fty = Unsigned_( d, fty )
        dim as int32 ft = DbgType( d, fty )
        if ft < 0 then continue for
        dim as int32 mn
        dim as boolean isBase = (fd->name = d.fe->udts->baseName) andalso _
                                (tc->BaseOf( t ) <> Tko.TYPE_NONE)
        if isBase then
            mn = NewNode_( d, "!DIDerivedType(tag: DW_TAG_inheritance, scope: !" & str( id ) & _
                              ", baseType: " & TypeRef_( ft ) & ", offset: " & _
                              str( fd->offset * 8 ) & ")" )
        else
            dim as string fnm = d.fe->names->Spelling( fd->name )
            if us <> 0 then
                dim as Tko.SymbolId fsid = d.fe->syms->LookupLocal( us->inner, fd->name )
                if fsid <> Tko.SYMBOL_NONE then
                    fnm = SpellingOf_( d, d.fe->syms->SymbolAt( fsid ) )
                end if
            end if
            if fd->bitWidth > 0 then
                mn = NewNode_( d, "!DIDerivedType(tag: DW_TAG_member, name: " & MetaStr_( fnm ) & _
                                  ", scope: !" & str( id ) & ", baseType: " & TypeRef_( ft ) & _
                                  ", size: " & str( fd->bitWidth ) & ", offset: " & _
                                  str( fd->offset * 8 + fd->bitOffset ) & _
                                  ", flags: DIFlagBitField, extraData: i64 " & _
                                  str( fd->offset * 8 ) & ")" )
            else
                mn = Member_( d, id, fnm, ft, SizeBytes_( d, fd->type_ ) * 8, fd->offset * 8 )
            end if
        end if
        ms += iif( len( ms ) > 0, ", !", "!" ) & str( mn )
    next
    DefineNode_( d, id, "!DICompositeType(tag: " & tag & ", name: " & MetaStr_( nm ) & _
                        ", file: !" & str( fl ) & ", line: " & str( ln ) & _
                        ", size: " & str( info->size * 8 ) & ", elements: !{" & ms & "})" )
    return id
end function

'' An ENUM: pointer-sized, its enumerators the SYM_ENUMCONSTs of its scope, each value in
'' the symbol's payload.
private function Enum_( byref d as DebugInfo, byval id as int32, byval t as Tko.TypeId ) as int32
    dim as Tko.Symbol ptr es = NamedSym_( d, t )
    dim as int32 fl = d.mainFileId, ln = 0
    dim as string ms = ""
    if es <> 0 then
        DeclSite_( d, es, fl, ln )
        dim as Tko.SymScope ptr sc = d.fe->syms->ScopeAt( es->inner )
        if sc <> 0 then
            dim as Tko.SymbolId k = sc->firstSym
            while k <> Tko.SYMBOL_NONE
                dim as Tko.Symbol ptr cs = d.fe->syms->SymbolAt( k )
                if cs = 0 then exit while
                if cs->kind = cast( uint8, Tko.SYM_ENUMCONST ) then
                    dim as int32 en = NewNode_( d, "!DIEnumerator(name: " & _
                                                  MetaStr_( SpellingOf_( d, cs ) ) & _
                                                  ", value: " & str( cs->payload ) & ")" )
                    ms += iif( len( ms ) > 0, ", !", "!" ) & str( en )
                end if
                k = cs->nextInScope
            wend
        end if
    end if
    DefineNode_( d, id, "!DICompositeType(tag: DW_TAG_enumeration_type, name: " & _
                        MetaStr_( TypeName_( d, t ) ) & ", file: !" & str( fl ) & _
                        ", line: " & str( ln ) & ", baseType: !" & str( IntType_( d ) ) & _
                        ", size: " & str( PtrBits_( d ) ) & ", elements: !{" & ms & "})" )
    return id
end function

'' A PROCEDURE TYPE is the procedure's signature; 'dim f as sub( )' is a POINTER to one,
'' as the type table has it, so it arrives here through TK_POINTER.
private function Proc_( byref d as DebugInfo, byval id as int32, byval t as Tko.TypeId ) as int32
    dim as Tko.TypeContext ptr tc = d.fe->types
    dim as int32 rt = DbgType( d, tc->Inner( t ) )
    dim as string ts = TypeRef_( iif( rt < 0, 0, rt ) )
    for k as int32 = 0 to tc->ProcParamCount( t ) - 1
        dim as int32 pt = DbgType( d, tc->ProcParam( t, k ) )
        ts += ", " & TypeRef_( iif( pt < 0, 0, pt ) )
    next
    DefineNode_( d, id, "!DISubroutineType(types: !{" & ts & "})" )
    return id
end function

'' The DI type of a TypeId: its node number, 0 for void, -1 for a type that cannot be
'' described (a variable of one is simply left out).
function DbgType( byref d as DebugInfo, byval t as Tko.TypeId ) as int32
    if (d.fe = 0) orelse (t = Tko.TYPE_NONE) then return 0
    dim as Tko.TypeContext ptr tc = d.fe->types
    dim as int32 ti = cast( int32, t )
    if (ti < 0) orelse (ti >= tc->types.Count) then return -1
    while d.typeMeta.Count <= ti
        d.typeMeta.Push( 0 )
    wend
    if d.typeMeta[ti] = -2 then return 0
    if d.typeMeta[ti] <> 0 then return d.typeMeta[ti]
    dim as int32 id = ReserveNode_( d )
    d.typeMeta[ti] = id
    dim as int32 r = -1
    if tc->IsConst( t ) then
        dim as int32 bt = DbgType( d, tc->Unqualify( t ) )
        if bt >= 0 then
            DefineNode_( d, id, "!DIDerivedType(tag: DW_TAG_const_type, baseType: " & _
                                TypeRef_( bt ) & ")" )
            r = id
        end if
    else
        select case tc->Kind( t )
        case Tko.TK_BUILTIN
            r = Builtin_( d, id, t )
        case Tko.TK_POINTER, Tko.TK_REFERENCE
            dim as int32 bt = DbgType( d, tc->Inner( t ) )
            if bt < 0 then bt = 0
            dim as string tag = "DW_TAG_pointer_type"
            if tc->Kind( t ) = Tko.TK_REFERENCE then tag = "DW_TAG_reference_type"
            DefineNode_( d, id, "!DIDerivedType(tag: " & tag & ", baseType: " & _
                                TypeRef_( bt ) & ", size: " & str( PtrBits_( d ) ) & ")" )
            r = id
        case Tko.TK_ARRAY
            if tc->IsDynArray( t ) then
                r = DynArray_( d, id, t )
            else
                r = FixedArray_( d, id, t )
            end if
        case Tko.TK_UDT
            r = Udt_( d, id, t )
        case Tko.TK_ENUM
            r = Enum_( d, id, t )
        case Tko.TK_PROC
            r = Proc_( d, id, t )
        case Tko.TK_TYPEDEF
            dim as int32 bt = DbgType( d, tc->Inner( t ) )
            if bt >= 0 then
                DefineNode_( d, id, "!DIDerivedType(tag: DW_TAG_typedef, name: " & _
                                    MetaStr_( tc->Name( t ) ) & ", baseType: " & _
                                    TypeRef_( bt ) & ")" )
                r = id
            end if
        end select
    end if
    '' A NUMBER WAS RESERVED AND NOTHING DEFINED IT: void, or a type left undescribed.
    '' The reservation is left unused -- a gap in the numbering, which LLVM accepts --
    '' and the memo records the answer so the next ask does not reserve another.
    if r <> id then r = iif( r = 0, 0, -1 )
    '' -2 IS VOID, remembered as an answer; 0 means "not asked yet".
    if r = id then
        d.typeMeta[ti] = id
    elseif r = 0 then
        d.typeMeta[ti] = -2
    else
        d.typeMeta[ti] = -1
    end if
    return r
end function
