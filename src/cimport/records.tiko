'' records.tiko -- a C struct or union as a FreeBASIC TYPE or UNION. See import.ti.
''
'' The layout is NOT written into the text: no offsets, no padding fields between members.
'' The text says what C said -- the members, in order, with the alignment the record has
'' -- and tiko lays it out itself. Clang's own layout goes to the manifest, and phase C
'' compares the two. That is the whole reason the importer emits text (0016 §2).
''
'' WHAT A MEMBER CAN BE, and what each becomes:
''
''   a scalar, pointer or record      'name as T'
''   a bit-field                      'name : bits as T'
''   an array                         'name(0 to a, 0 to b) as T'; one dimension of char is
''                                    'name as zstring * N', which is what FreeBASIC means
''                                    by a fixed C string
''   an anonymous member              flattened when it is the parent's own kind -- a struct
''                                    in a struct adds nothing -- and otherwise a nested
''                                    'union' or 'type' block, as FreeBASIC requires
''   a field of an unnamed record     the record is named '<parent>_<field>_t' and emitted
''   type                             first, then the field refers to it
''
'' A RECORD IS REFUSED WHOLE when one member cannot be expressed. Dropping a member would
'' move every member after it, and a record that is nearly right is the one bug the layout
'' check cannot see: it would compare tiko's layout of the wrong record with itself.

#import "std/containers"
#include once "cimport/import.ti"

namespace Tko.CImport

const CXType_ConstantArray_ = 112, CXType_IncompleteArray_ = 114, CXType_Record_ = 105
const CXType_Char_S_ = 13, CXType_Char_U_ = 4, CXType_Elaborated_ = 119
const MAX_MEMBERS = 512
const MAX_ANON_DEPTH = 8

type Kids_
    k( any ) as CXCursor
    as int32 n
end type

private function Collect_ cdecl _
    ( byval c as CXCursor, byval parent as CXCursor, byval client as any ptr ) as int32

    dim as Kids_ ptr kp = client
    if kp->n > ubound( kp->k ) then redim preserve kp->k( kp->n * 2 + 7 )
    kp->k( kp->n ) = c
    kp->n += 1
    return CXChildVisit_Continue
end function

private sub KidsOf_( byref x as CImp, byval c as CXCursor, byref kids as Kids_ )
    kids.n = 0
    x.api->visitChildren( c, @Collect_, @kids )
end sub

private function CollectField_ cdecl ( byval c as CXCursor, byval client as any ptr ) as int32
    dim as Kids_ ptr kp = client
    if kp->n > ubound( kp->k ) then redim preserve kp->k( kp->n * 2 + 7 )
    kp->k( kp->n ) = c
    kp->n += 1
    return CXVisit_Continue
end function

'' A RECORD'S FIELDS AS ITS LAYOUT HAS THEM -- the implicit ones included. Under MS
'' extensions, which windows-x86_64's headers are written for, 'MOUSEHOOKSTRUCT
'' DUMMYSTRUCTNAME;' with the name macro'd away is an anonymous member of a NAMED type,
'' and so is a tagged 'struct _STGMEDIUM_UNION { ... };' with no member name. clang
'' gives each an unnamed field that visitChildren never shows, and the record lost
'' them: tagMOUSEHOOKSTRUCTEX came out 4 bytes where C has 40.
private sub FieldsOf_( byref x as CImp, byval c as CXCursor, byref flds as Kids_ )
    flds.n = 0
    x.api->Type_visitFields( x.api->getCursorType( c ), @CollectField_, @flds )
end sub

function RecordIsUnion( byref x as CImp, byval c as CXCursor ) as boolean
    return (x.api->getCursorKind( c ) = CXCursor_UnionDecl)
end function

'' What one record's text is being assembled into. 'pre' holds records that must come
'' BEFORE it -- the synthetic ones its fields refer to, and named records C declared inside
'' it -- and nothing is pushed to the output until the whole record has succeeded.
type Build_
    as Tko.StrVec body         '' member lines, already indented
    as Tko.StrVec pre          '' whole declarations to emit first
    as Tko.StrVec preMan       '' their manifest lines
    as Tko.StrVec man          '' this record's field manifest lines
    as int32 members
    as int64 lastEnd         '' where C's last member ends, in bytes -- for the tail pad
    as int64 maxAlign        '' the widest member alignment, before any #pragma pack
    as Tko.StrVec seen         '' field names taken, upper-cased
end type

'' ONE RECORD IS ONE FIELD SCOPE, and FreeBASIC's is case-insensitive -- anonymous members
'' included, since their fields are the record's own. winnt.h's _EXCEPTION_REGISTRATION_RECORD
'' has 'Handler' and 'handler' in two anonymous unions; the second is 'handler_2', as
'' fbc-modern writes it, where writing both was a duplicate definition.
private function FieldUnique_( byref b as Build_, byref cname as string, byref cand0 as string ) as string
    dim as string cand = cand0
    dim as int32 k = 2
    do
        dim as string u = ucase( cand )
        dim as boolean taken = false
        for i as int32 = 0 to b.seen.Count - 1
            if b.seen[i] = u then taken = true : exit for
        next
        if taken = false then exit do
        cand = cname & "_" & k
        k += 1
    loop
    b.seen.Push( ucase( cand ) )
    return cand
end function

declare function Members_( byref x as CImp, byval rc as CXCursor, byval outerT as CXType, _
                           byref outerName as string, byval depth as int32, byref ind as string, _
                           byref b as Build_, byref why as string ) as boolean

'' The member's type, with any array dimensions pulled out: 'dims' is '(0 to a, 0 to b)'
'' or "", and 'zlen' is set when the member is one dimension of plain char.
private function MemberType_( byref x as CImp, byval ft as CXType, byref dims as string, _
                              byref zlen as int64, byref why as string ) as string
    dims = ""
    zlen = 0
    dim as CXType t = Unwrap( x, ft )
    if t.kind = CXType_IncompleteArray_ then
        why = "flexible array member -- reach it by pointer arithmetic"
        return ""
    end if
    if t.kind <> CXType_ConstantArray_ then return TypeText( x, ft, why )

    dim as string d
    dim as int32 rank = 0
    dim as CXType et = t
    while et.kind = CXType_ConstantArray_
        dim as int64 n = x.api->getNumElements( et )
        if n <= 0 then
            why = "array of " & n & " elements has no FreeBASIC spelling"
            return ""
        end if
        if rank > 0 then d &= ", "
        d &= "0 to " & (n - 1)
        rank += 1
        et = Unwrap( x, x.api->getElementType( et ) )
    wend
    '' ONE DIMENSION OF char IS A FIXED STRING -- 'zstring * N' is FreeBASIC's spelling of
    '' char[N], the same N bytes, and it reads as text. Two dimensions stay an array.
    if (rank = 1) andalso ((et.kind = CXType_Char_S_) orelse (et.kind = CXType_Char_U_)) then
        zlen = x.api->getNumElements( t )
        return "zstring * " & zlen
    end if
    if et.kind = CXType_Record_ then
        dim as CXCursor ed = x.api->getTypeDeclaration( et )
        if len( CursorName( x, ed ) ) = 0 then
            why = "unnamed record cannot be referred to"
            return ""
        end if
    end if
    dim as string etx = TypeText( x, et, why )
    if len( etx ) = 0 then return ""
    dims = "(" & d & ")"
    return etx
end function

'' A FIELD'S OFFSET, in bits, from the OUTERMOST named record -- which is what tiko's
'' layout reports too, since an anonymous member's fields are the outer record's own.
private function FieldBit_( byref x as CImp, byval outerT as CXType, byval f as CXCursor, _
                            byref name_ as string ) as int64
    dim as int64 o = x.api->Type_getOffsetOf( outerT, strptr( name_ ) )
    if o < 0 then o = x.api->Cursor_getOffsetOfField( f )
    return o
end function

'' A record declared INSIDE another is, in C, a record at file scope. It is emitted as its
'' own declaration, before the record that contains it. (fbc-modern drops these, as
'' "unnamed"; a nested named record reached through a pointer is common in real headers.)
private function Nested_( byref x as CImp, byval c as CXCursor, byref b as Build_, _
                          byref why as string ) as boolean
    dim as string usr = CursorUsr( x, c )
    dim as int32 id = UsrId( x, usr )
    if (UsrState( x, id ) and (US_EMITTED or US_REFUSED)) <> 0 then return true
    if x.api->isCursorDefinition( c ) = 0 then return true
    dim as string nm = UsrFbName( x, id )
    if len( nm ) = 0 then return true
    dim as string saveCur = x.curRecordUsr
    dim as string w
    '' Emitted straight into the output: it stands on its own, and the enclosing record
    '' only refers to it by name.
    if RecordEmit( x, c, nm, w ) = false then
        UsrSet( x, id, US_REFUSED )
        Skip( x, iif( RecordIsUnion( x, c ), "union", "struct" ), nm, w )
    end if
    x.curRecordUsr = saveCur
    return true
end function

'' fbc-modern's prefix: a member of an anonymous member is named as one.
private function FieldWhy_( byval depth as int32, byref cname as string, byref w as string ) as string
    if depth > 0 then return "anonymous member field '" & cname & "': " & w
    return "field '" & cname & "': " & w
end function

'' A member's own alignment, into the record's natural one. Read per member, not per
'' record: clang's record alignment is already capped by '#pragma pack', and telling the
'' two apart is what says whether the record was packed.
private sub MemberAlign_( byref x as CImp, byval ft as CXType, byref b as Build_ )
    dim as int64 a = x.api->Type_getAlignOf( ft )
    if a > b.maxAlign then b.maxAlign = a
end sub

'' The members of record 'rc', appended to b.body at indentation 'ind'. 'outerT' is the
'' outermost named record's type, for offsets; 'outerName' names synthetic records.
private function Members_( byref x as CImp, byval rc as CXCursor, byval outerT as CXType, _
                           byref outerName as string, byval depth as int32, byref ind as string, _
                           byref b as Build_, byref why as string ) as boolean
    if depth > MAX_ANON_DEPTH then
        why = "anonymous records nested more than " & MAX_ANON_DEPTH & " deep"
        return false
    end if
    dim as boolean isUnion = RecordIsUnion( x, rc )

    '' NAMED RECORDS DECLARED INSIDE, first: each is a file-scope record in C, written
    '' before this one. An enum declared inside is file scope too, and decls.tiko emits it;
    '' an unnamed record is the type of a field or an anonymous member, handled with it.
    dim as Kids_ kids
    KidsOf_( x, rc, kids )
    for i as int32 = 0 to kids.n - 1
        dim as CXCursor k = kids.k( i )
        select case x.api->getCursorKind( k )
        case CXCursor_StructDecl, CXCursor_UnionDecl
            if (x.api->Cursor_isAnonymousRecordDecl( k ) = 0) andalso (len( CursorName( x, k ) ) > 0) then
                if Nested_( x, k, b, why ) = false then return false
            end if
        end select
    next

    dim as Kids_ flds
    FieldsOf_( x, rc, flds )
    for i as int32 = 0 to flds.n - 1
        dim as CXCursor k = flds.k( i )
        dim as string cname = CursorName( x, k )
        dim as CXType ft = x.api->getCursorType( k )

        '' AN ANONYMOUS MEMBER: an unnamed field that is not a bit-field. Its fields belong
        '' to the enclosing record -- flattened into a record of its own kind, a nested
        '' 'union' or 'type' block in the other.
        if (len( cname ) = 0) andalso (x.api->Cursor_isBitField( k ) = 0) then
            dim as CXCursor ad = x.api->getTypeDeclaration( x.api->getCanonicalType( ft ) )
            dim as boolean kUnion = RecordIsUnion( x, ad )
            if kUnion = isUnion then
                if Members_( x, ad, outerT, outerName, depth + 1, ind, b, why ) = false then return false
            else
                b.body.Push( ind & iif( kUnion, "union", "type" ) )
                if Members_( x, ad, outerT, outerName, depth + 1, ind & chr( 9 ), b, why ) = false then return false
                b.body.Push( ind & iif( kUnion, "end union", "end type" ) )
            end if
            continue for
        end if

        scope
            dim as string line_
            b.members += 1
            if b.members > MAX_MEMBERS then
                why = "more than " & MAX_MEMBERS & " members"
                return false
            end if

            if x.api->Cursor_isBitField( k ) then
                '' AN UNNAMED BIT-FIELD is padding -- MSVC's winnt.h writes 'int :7' where
                '' MinGW's names it Adummy1 -- and FreeBASIC's bit-fields all have names.
                dim as string cspell = cname
                if len( cname ) = 0 then cname = "__cimport_bits" & b.members : cspell = "-"
                dim as int32 w = x.api->getFieldDeclBitWidth( k )
                if w <= 0 then
                    why = FieldWhy_( depth, cname, "zero-width bit-field has no FreeBASIC spelling" )
                    return false
                end if
                dim as string w2
                dim as string bt = TypeText( x, ft, w2 )
                if len( bt ) = 0 then
                    why = FieldWhy_( depth, cname, w2 )
                    return false
                end if
                dim as string fname = FieldUnique_( b, cname, NameField( cname, false ) )
                line_ = fname & " : " & w & " as " & bt
                MemberAlign_( x, ft, b )
                dim as int64 bbit = FieldBit_( x, outerT, k, cname )
                b.man.Push( "  field " & fname & " " & bbit & " " & w & " " & cspell )
                if (bbit + w + 7) \ 8 > b.lastEnd then b.lastEnd = (bbit + w + 7) \ 8
            else
                dim as CXType fu = Unwrap( x, ft )
                dim as string ftx, dims, w2
                dim as int64 zlen
                '' A FIELD OF AN UNNAMED RECORD TYPE -- 'struct { short lo, hi; } pair' --
                '' names that record after its parent and the field, and emits it first.
                if fu.kind = CXType_Record_ then
                    dim as CXCursor rd = x.api->getTypeDeclaration( fu )
                    if len( CursorName( x, rd ) ) = 0 then
                        dim as int32 rid = UsrId( x, CursorUsr( x, rd ) )
                        dim as string synth = UsrFbName( x, rid )
                        if len( synth ) = 0 then
                            synth = NameClaim( x, NS_TYPE, outerName & "_" & cname & "_t", RK_TYPE )
                            UsrSetName( x, rid, synth )
                        end if
                        dim as string saveCur = x.curRecordUsr
                        dim as string sw
                        if RecordEmit( x, rd, synth, sw ) = false then
                            x.curRecordUsr = saveCur
                            why = FieldWhy_( depth, cname, sw )
                            return false
                        end if
                        x.curRecordUsr = saveCur
                        ftx = synth
                    end if
                end if
                if len( ftx ) = 0 then ftx = MemberType_( x, ft, dims, zlen, w2 )
                if len( ftx ) = 0 then
                    why = FieldWhy_( depth, cname, w2 )
                    return false
                end if
                dim as string fname = FieldUnique_( b, cname, NameField( cname, len( dims ) > 0 ) )
                line_ = fname & dims & " as " & ftx
                MemberAlign_( x, ft, b )
                dim as int64 fbit = FieldBit_( x, outerT, k, cname )
                b.man.Push( "  field " & fname & " " & fbit & " 0 " & cname )
                dim as int64 fend = fbit \ 8 + x.api->Type_getSizeOf( ft )
                if fend > b.lastEnd then b.lastEnd = fend
            end if
            b.body.Push( ind & line_ )
        end scope
    next
    return true
end function

'' EMIT ONE RECORD DEFINITION under 'fbName'. On success the declaration is in x.decls --
'' after anything it needed first -- its manifest entry is written, and it is marked
'' emitted. On failure nothing is emitted and 'why' says which member stopped it.
function RecordEmit( byref x as CImp, byval c as CXCursor, byref fbName as string, _
                     byref why as string ) as boolean
    dim as string usr = CursorUsr( x, c )
    dim as int32 id = UsrId( x, usr )
    if (UsrState( x, id ) and US_EMITTED) <> 0 then return true
    '' A RECORD TIKO CANNOT LAY OUT AS C DOES is refused like any other that has no
    '' FreeBASIC spelling -- and whatever holds one by value goes with it.
    dim as string lfb = lcase( fbName )
    for i as int32 = 0 to x.opts->refuseName.Count - 1
        if lcase( x.opts->refuseName[i] ) = lfb then
            why = x.opts->refuseWhy[i]
            return false
        end if
    next
    x.curRecordUsr = usr

    dim as CXType rt = x.api->getCursorType( c )
    dim as int64 size = x.api->Type_getSizeOf( rt )
    dim as int64 align = x.api->Type_getAlignOf( rt )
    dim as boolean isUnion = RecordIsUnion( x, c )
    dim as Build_ b
    if Members_( x, c, rt, fbName, 0, chr( 9 ), b, why ) = false then return false
    if b.members = 0 then
        why = "record has no importable members"
        return false
    end if

    '' EXTERN "C": THE RECORD IS LAID OUT BY THE TARGET'S C RULE, not fbc's. They differ for
    '' bit-fields -- MSVC opens a new unit whenever the declared type's size changes, SysV
    '' shares a byte with an ordinary member -- and for a packed record's own alignment.
    ''
    '' 'FIELD = N' ONLY FOR A PACKED RECORD: one whose C alignment is below its widest
    '' member's, which only '#pragma pack' or 'packed' does -- pack(1) is 'field = 1'. Any
    '' 'field' clause also stops SysV moving a bit-field to its type's next boundary, as
    '' '#pragma pack' does in C, so writing one on a record that is not packed -- as this did
    '' for every record aligned below eight, when fbc's rule needed the hint -- would put
    '' 'int a:30; int b:5' b at bit 30. A '#pragma pack' that changes no alignment is not
    '' visible here at all, and --verify refuses such a record if it moved a bit-field.
    dim as string head = iif( isUnion, "union ", "type " ) & fbName
    if (align >= 1) andalso (align < b.maxAlign) then head &= " field = " & align
    head &= " extern ""c"""

    '' OVER-ALIGNMENT HAS NO FREEBASIC SPELLING -- FIELD = N only ever lowers alignment --
    '' so the tail padding C adds is written out as a member, which makes sizeof and every
    '' offset right. What stays untrue is that an instance is only 8-byte aligned where C
    '' promises more; the manifest records the true alignment and phase C says so.
    ''
    '' The pad runs from where C's last member ends to clang's size. tiko lays the members
    '' out at C's offsets -- phase C checks that -- so the record then ends exactly at a
    '' multiple of C's alignment, and tiko's own rounding to eight changes nothing.
    if (align > 8) andalso (size > b.lastEnd) then
        b.body.Push( chr( 9 ) & "__cimport_pad(0 to " & (size - b.lastEnd - 1) & ") as ubyte" )
    end if

    dim as string txt = head & chr( 10 )
    for i as int32 = 0 to b.body.Count - 1
        txt &= b.body[i] & chr( 10 )
    next
    txt &= iif( isUnion, "end union", "end type" )
    x.decls.Push( txt )

    '' THE C SPELLING LAST, for build/cimportlayout.sh's clang-compiled oracle: 'struct X',
    '' a typedef's name for a record only a typedef names, '-' for one C cannot spell.
    dim as string cty = ClangText( *x.api, x.api->getTypeSpelling( rt ) )
    if (instr( cty, "(unnamed" ) > 0) orelse (instr( cty, "(anonymous" ) > 0) then cty = "-"
    x.manifest.Push( "record " & fbName & " " & size & " " & align & " " & cty )
    for i as int32 = 0 to b.man.Count - 1
        x.manifest.Push( b.man[i] )
    next
    UsrSet( x, id, US_EMITTED )
    return true
end function

end namespace
