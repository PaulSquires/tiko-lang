'' decls.tiko -- the declaration walk: two passes over the translation unit. See import.ti.
''
'' PASS 1 NAMES EVERYTHING, in the order clang reports it, before a single line is written.
'' A type must be able to refer to a name that is declared further down -- through a
'' pointer, which FreeBASIC accepts only as a forward alias -- and the alias needs the
'' final name. Naming in one pass, in traversal order, is also what makes the renames
'' deterministic: 'size_t' then 'SIZE_T' is SIZE_T_2 on every machine.
''
'' PASS 2 EMITS, in the same order. EVERY declaration clang saw is emitted, from every file
'' the header pulled in -- a binding for sqlite3.h carries stdarg.h's va_list too -- because
'' a declaration can only refer to what precedes it, and C's own order is the one order
'' that is known to satisfy that.

#import "std/containers"
#include once "cimport/import.ti"

namespace Tko.CImport

const CXType_Record__ = 105, CXType_Enum__ = 106, CXType_Void__ = 2
const CXType_ConstantArray__ = 112, CXType_IncompleteArray__ = 114, CXType_VariableArray__ = 115
const CX_SC_Static = 3
const CXCursor_DLLImport = 419

sub Skip( byref x as CImp, byref kind as string, byref name_ as string, byref why as string )
    x.skipKind.Push( kind )
    x.skipName.Push( name_ )
    x.skipWhy.Push( why )
end sub

'' A function with no symbol to link against: static, or inline. Counted, not ledgered --
'' fbc-modern's choice, and a sensible one: a static function is not part of an interface.
private function NoSymbol_( byref x as CImp, byval c as CXCursor ) as boolean
    if x.api->Cursor_getStorageClass( c ) = CX_SC_Static then return true
    if x.api->Cursor_isFunctionInlined( c ) = 0 then return false
    '' ...EXCEPT THE stdio FUNCTIONS THE UCRT DEFINES INLINE AND tiko-rt PROVIDES. On
    '' windows-x86_64 'printf' after '#cinclude once "stdio.h"' was TKO0743, not declared: the
    '' SDK's stdio.h defines the whole family in the header, over __stdio_common_*, with no
    '' symbol in ucrtbase.dll. lib/rt/src/c/msvccrt.c defines each of these; glibc and
    '' MinGW export every one anyway, so there is no target in which the name is unlinkable.
    select case CursorName( x, c )
    case "printf", "vprintf", "fprintf", "vfprintf", "sprintf", "vsprintf", _
         "snprintf", "vsnprintf", "scanf", "vscanf", "fscanf", "vfscanf", _
         "sscanf", "vsscanf"
        return false
    end select
    return true
end function

'' ---------------------------------------------------------------- pass 1: names

declare sub NameNested_( byref x as CImp, byval c as CXCursor )

private sub NameRecord_( byref x as CImp, byval c as CXCursor )
    dim as long id = UsrId( x, CursorUsr( x, c ) )
    dim as boolean def_ = (x.api->isCursorDefinition( c ) <> 0)
    if def_ then UsrSet( x, id, US_DEFINED )
    dim as string nm = CursorName( x, c )
    if (len( nm ) > 0) andalso ((UsrState( x, id ) and US_NAMED) = 0) then
        UsrSetName( x, id, NameClaim( x, NS_TYPE, nm, RK_TYPE ) )
        NoteDecl( x, nm, id )
    end if
    if def_ then NameNested_( x, c )
end sub

private sub NameEnum_( byref x as CImp, byval c as CXCursor )
    dim as long id = UsrId( x, CursorUsr( x, c ) )
    if x.api->isCursorDefinition( c ) then UsrSet( x, id, US_DEFINED )
    dim as string nm = CursorName( x, c )
    if (len( nm ) > 0) andalso ((UsrState( x, id ) and US_NAMED) = 0) then
        UsrSetName( x, id, NameClaim( x, NS_TYPE, nm, RK_TYPE ) )
    end if
    NameNested_( x, c )
end sub

'' Named records and enums declared INSIDE a record are file-scope declarations in C and
'' need names too; so does every enum's constants, which are module-level values.
private function NestedVisit_ cdecl _
    ( byval c as CXCursor, byval parent as CXCursor, byval client as any ptr ) as long
    dim as CImp ptr xp = client
    select case xp->api->getCursorKind( c )
    case CXCursor_StructDecl, CXCursor_UnionDecl
        if len( CursorName( *xp, c ) ) then
            NameRecord_( *xp, c )
        elseif xp->api->isCursorDefinition( c ) then
            '' An anonymous one still holds names of its own below it.
            NameNested_( *xp, c )
        end if
    case CXCursor_EnumDecl
        NameEnum_( *xp, c )
    case CXCursor_EnumConstantDecl
        dim as long id = UsrId( *xp, CursorUsr( *xp, c ) )
        if (UsrState( *xp, id ) and US_NAMED) = 0 then
            UsrSetName( *xp, id, NameClaim( *xp, NS_VALUE, CursorName( *xp, c ), RK_CONST ) )
            '' An enumerator is emitted with its enum; it counts as declared for an alias.
            UsrSet( *xp, id, US_EMITTED )
            NoteDecl( *xp, CursorName( *xp, c ), id )
        end if
    end select
    return CXChildVisit_Continue
end function

private sub NameNested_( byref x as CImp, byval c as CXCursor )
    x.api->visitChildren( c, @NestedVisit_, @x )
end sub

'' A typedef whose underlying type is a record or an enum. Two C idioms decide the name:
''
''   typedef struct { ... } P;      the anonymous record TAKES the typedef's name, and the
''                                  typedef itself emits nothing
''   typedef struct X X;            one entity with two spellings of one name -- the
''                                  record's name serves both
private sub NameTypedef_( byref x as CImp, byval c as CXCursor )
    dim as long id = UsrId( x, CursorUsr( x, c ) )
    if (UsrState( x, id ) and US_NAMED) <> 0 then return
    dim as string nm = CursorName( x, c )
    dim as CXType u = Unwrap( x, x.api->getTypedefDeclUnderlyingType( c ) )
    if (u.kind = CXType_Record__) orelse (u.kind = CXType_Enum__) then
        dim as CXCursor d = x.api->getTypeDeclaration( u )
        dim as long rid = UsrId( x, CursorUsr( x, d ) )
        dim as string dn = CursorName( x, d )
        if len( dn ) = 0 then
            if (UsrState( x, rid ) and US_NAMED) = 0 then
                UsrSetName( x, rid, NameClaim( x, NS_TYPE, nm, RK_TYPE ) )
                UsrSet( x, rid, US_TYPEDEFD )
                UsrSetName( x, id, UsrFbName( x, rid ) )
                UsrSet( x, id, US_TYPEDEFD )
                return
            end if
        elseif dn = nm then
            if (UsrState( x, rid ) and US_NAMED) = 0 then
                UsrSetName( x, rid, NameClaim( x, NS_TYPE, dn, RK_TYPE ) )
            end if
            UsrSetName( x, id, UsrFbName( x, rid ) )
            return
        end if
    end if
    UsrSetName( x, id, NameClaim( x, NS_TYPE, nm, RK_TYPE ) )
    NoteDecl( x, nm, id )
end sub

private function Pass1_ cdecl _
    ( byval c as CXCursor, byval parent as CXCursor, byval client as any ptr ) as long
    dim as CImp ptr xp = client
    select case xp->api->getCursorKind( c )
    case CXCursor_StructDecl, CXCursor_UnionDecl
        NameRecord_( *xp, c )
    case CXCursor_EnumDecl
        NameEnum_( *xp, c )
    case CXCursor_TypedefDecl
        NameTypedef_( *xp, c )
    case CXCursor_FunctionDecl
        '' A STATIC OR INLINE FUNCTION CLAIMS ITS NAME TOO, though nothing is emitted for
        '' it: fbc-modern's does, which is why windows.h's '#define InterlockedIncrement
        '' _InterlockedIncrement' cannot become an alias -- the inline InterlockedIncrement
        '' holds the name.
        dim as long id = UsrId( *xp, CursorUsr( *xp, c ) )
        if (UsrState( *xp, id ) and US_NAMED) = 0 then
            UsrSetName( *xp, id, NameClaim( *xp, NS_VALUE, CursorName( *xp, c ), RK_PROC ) )
            if NoSymbol_( *xp, c ) = false then NoteDecl( *xp, CursorName( *xp, c ), id )
        end if
    case CXCursor_VarDecl
        if xp->api->Cursor_getStorageClass( c ) <> CX_SC_Static then
            dim as long id = UsrId( *xp, CursorUsr( *xp, c ) )
            if (UsrState( *xp, id ) and US_NAMED) = 0 then
                UsrSetName( *xp, id, NameClaim( *xp, NS_VALUE, CursorName( *xp, c ), RK_VAR ) )
                NoteDecl( *xp, CursorName( *xp, c ), id )
            end if
        end if
    case CXCursor_MacroDefinition
        MacroCandidate( *xp, c )
    end select
    return CXChildVisit_Continue
end function

sub DeclPassNames( byref x as CImp )
    x.api->visitChildren( x.api->getTranslationUnitCursor( x.tu ), @Pass1_, @x )
end sub

'' ---------------------------------------------------------------- pass 2: emit

type EnumBody_
    as CImp ptr x
    as boolean unsigned_
    as string body
end type

private function EnumConst_ cdecl _
    ( byval c as CXCursor, byval parent as CXCursor, byval client as any ptr ) as long
    dim as EnumBody_ ptr eb = client
    dim as CImp ptr xp = eb->x
    if xp->api->getCursorKind( c ) = CXCursor_EnumConstantDecl then
        dim as string nm = UsrFbName( *xp, UsrId( *xp, CursorUsr( *xp, c ) ) )
        dim as string v
        if eb->unsigned_ then
            v = str( xp->api->getEnumConstantDeclUnsignedValue( c ) )
        else
            v = str( xp->api->getEnumConstantDeclValue( c ) )
        end if
        eb->body &= chr( 9 ) & nm & " = " & v & chr( 10 )
    end if
    return CXChildVisit_Continue
end function

'' ENUMS ARE NEVER A FREEBASIC ENUM. A FreeBASIC ENUM is 8 bytes on both targets and a C
'' enum is 4, so a field of one would move every field after it. The type becomes an alias
'' of clang's underlying integer and the constants a nameless ENUM block, every value
'' written out -- which also keeps 0x80000000 from being renumbered.
private sub EmitEnum_( byref x as CImp, byval c as CXCursor )
    dim as long id = UsrId( x, CursorUsr( x, c ) )
    if (UsrState( x, id ) and (US_EMITTED or US_REFUSED)) <> 0 then return
    if x.api->isCursorDefinition( c ) = 0 then return
    dim as string nm = UsrFbName( x, id )
    dim as string why
    dim as CXType it = x.api->getEnumDeclIntegerType( c )
    dim as string itx = TypeText( x, it, why )
    if len( itx ) = 0 then
        UsrSet( x, id, US_REFUSED )
        Skip( x, "enum", nm, why )
        return
    end if
    dim as EnumBody_ eb
    eb.x = @x
    select case Unwrap( x, it ).kind
    case 4, 5, 8, 9, 10, 11     '' Char_U UChar UShort UInt ULong ULongLong
        eb.unsigned_ = true
    end select
    x.api->visitChildren( c, @EnumConst_, @eb )
    if len( eb.body ) = 0 then
        UsrSet( x, id, US_REFUSED )
        Skip( x, "enum", nm, "enum has no enumerators" )
        return
    end if

    dim as string txt
    if len( nm ) then txt = "type " & nm & " as " & itx
    if len( eb.body ) then
        if len( txt ) then txt &= chr( 10 )
        txt &= "enum" & chr( 10 ) & eb.body & "end enum"
    end if
    if len( txt ) then x.decls.Push( txt )
    UsrSet( x, id, US_EMITTED )
end sub

'' A typedef. Deferred -- not skipped -- when it names a record by VALUE that is defined
'' further down: C allows 'typedef struct S T;' before S, FreeBASIC does not, and the typedef
'' is emitted as soon as S has been.
private function TypedefText_( byref x as CImp, byval c as CXCursor, byref why as string, _
                               byref deferIt as boolean ) as string
    deferIt = false
    dim as string nm = UsrFbName( x, UsrId( x, CursorUsr( x, c ) ) )
    dim as CXType ut = x.api->getTypedefDeclUnderlyingType( c )
    dim as CXType u = Unwrap( x, ut )
    if u.kind = CXType_Record__ then
        dim as long rid = UsrId( x, CursorUsr( x, x.api->getTypeDeclaration( u ) ) )
        dim as ubyte st = UsrState( x, rid )
        if ((st and US_DEFINED) <> 0) andalso ((st and (US_EMITTED or US_REFUSED)) = 0) then
            deferIt = true
            return ""
        end if
        '' A TYPEDEF OF A SKIPPED RECORD IS STILL WRITTEN, as fbc-modern writes it: FreeBASIC
        '' takes 'type T as S' with S never declared as a forward reference, usable through a
        '' pointer and refused by value -- which is exactly what C can do with it too.
        '' (mingw's 'typedef struct threadlocaleinfostruct threadlocinfo;' is the case.)
        if (st and US_REFUSED) <> 0 then
            dim as string rn = UsrFbName( x, rid )
            if len( rn ) andalso (rn <> nm) then return "type " & nm & " as " & rn
        end if
    end if
    dim as string tt = TypeText( x, ut, why )
    if len( tt ) = 0 then return ""
    if tt = nm then return ""        '' 'typedef X X' of something already named X
    return "type " & nm & " as " & tt
end function

private sub EmitTypedef_( byref x as CImp, byval c as CXCursor )
    dim as string usr = CursorUsr( x, c )
    dim as long id = UsrId( x, usr )
    dim as ubyte st = UsrState( x, id )
    if (st and (US_EMITTED or US_REFUSED)) <> 0 then return
    '' Named an anonymous record or enum: that declaration carries the name.
    if (st and US_TYPEDEFD) <> 0 then
        UsrSet( x, id, US_EMITTED )
        return
    end if
    dim as string nm = UsrFbName( x, id )

    '' THE PUN ON AN OPAQUE RECORD -- 'typedef struct X X;' and no definition anywhere --
    '' is the opaque handle C meant, and FreeBASIC spells it 'type X as any'.
    dim as CXType u = Unwrap( x, x.api->getTypedefDeclUnderlyingType( c ) )
    if u.kind = CXType_Record__ then
        dim as CXCursor d = x.api->getTypeDeclaration( u )
        dim as long rid = UsrId( x, CursorUsr( x, d ) )
        if UsrFbName( x, rid ) = nm then
            if (UsrState( x, rid ) and US_DEFINED) = 0 then
                if (UsrState( x, rid ) and US_EMITTED) = 0 then
                    x.decls.Push( "type " & nm & " as any" )
                    UsrSet( x, rid, US_EMITTED or US_OPAQUE )
                end if
            end if
            UsrSet( x, id, US_EMITTED )
            return
        end if
    end if

    dim as string why
    dim as boolean deferIt
    dim as string txt = TypedefText_( x, c, why, deferIt )
    if deferIt then
        if x.nDeferred > ubound( x.deferred ) then redim preserve x.deferred( x.nDeferred * 2 + 7 )
        x.deferred( x.nDeferred ) = c
        x.nDeferred += 1
        return
    end if
    if len( why ) then
        UsrSet( x, id, US_REFUSED )
        Skip( x, "typedef", nm, why )
        return
    end if
    if len( txt ) then x.decls.Push( txt )
    UsrSet( x, id, US_EMITTED )
end sub

'' A function's parameter list, as a declaration writes it: the C names kept, reserved
'' ones taken '_', unnamed ones left unnamed -- 'byval as HWND', because C gave no name.
private function Params_( byref x as CImp, byval c as CXCursor, byref why as string ) as string
    dim as CXType ft = x.api->getCursorType( c )
    dim as long n = x.api->Cursor_getNumArguments( c )
    dim as string ps
    for i as long = 0 to n - 1
        dim as CXCursor a = x.api->Cursor_getArgument( c, i )
        dim as string pn = NameParam( CursorName( x, a ) )
        '' THE PARAMETER'S OWN TYPE, as written: the function type's copy is canonical for
        '' a builtin -- malloc's 'size_t' came out 'ulongint', memcpy's and wcslen's too.
        '' An array parameter, which C adjusts to a pointer, takes the function type's
        '' adjusted one: 'KEY k' through 'typedef BYTE KEY[16]' is 'BYTE ptr'.
        dim as CXType at = x.api->getCursorType( a )
        select case x.api->getCanonicalType( at ).kind
        case CXType_ConstantArray__, CXType_IncompleteArray__, CXType_VariableArray__
            at = x.api->getArgType( ft, i )
        end select
        dim as string pt = ParamTypeText( x, at, why )
        if len( pt ) = 0 then
            why = "parameter " & (i + 1) & ": " & why
            return ""
        end if
        if i > 0 then ps &= ", "
        if len( pn ) then ps &= "byval " & pn & " as " & pt else ps &= "byval as " & pt
    next
    if x.api->Cursor_isVariadic( c ) then
        if n <= 0 then
            why = "a variadic function with no named parameter has no FreeBASIC spelling"
            return ""
        end if
        ps &= ", ..."
    end if
    return "( " & ps & " )"
end function

private sub EmitFunction_( byref x as CImp, byval c as CXCursor )
    if NoSymbol_( x, c ) then
        dim as long sid = UsrId( x, CursorUsr( x, c ) )
        if (UsrState( x, sid ) and US_REFUSED) = 0 then
            x.nStatic += 1
            UsrSet( x, sid, US_REFUSED )
        end if
        return
    end if
    dim as long id = UsrId( x, CursorUsr( x, c ) )
    if (UsrState( x, id ) and (US_EMITTED or US_REFUSED)) <> 0 then return
    dim as string cname = CursorName( x, c )
    dim as string nm = UsrFbName( x, id )
    dim as string why

    '' The convention is checked through the function's TYPE, the same test a pointer to
    '' one gets -- FnTypeText refuses what x86-64 has no spelling for.
    dim as CXType ft = x.api->getCursorType( c )
    if len( FnTypeText( x, ft, why ) ) = 0 then
        UsrSet( x, id, US_REFUSED )
        Skip( x, "function", nm, why )
        return
    end if
    dim as string ps = Params_( x, c, why )
    if len( ps ) = 0 then
        UsrSet( x, id, US_REFUSED )
        Skip( x, "function", nm, why )
        return
    end if
    dim as CXType rt = x.api->getCursorResultType( c )
    dim as string txt
    if Unwrap( x, rt ).kind = CXType_Void__ then
        txt = "declare sub " & nm & " cdecl alias """ & cname & """ " & ps
    else
        dim as string rs = TypeText( x, rt, why )
        if len( rs ) = 0 then
            UsrSet( x, id, US_REFUSED )
            Skip( x, "function", nm, "result: " & why )
            return
        end if
        txt = "declare function " & nm & " cdecl alias """ & cname & """ " & ps & " as " & rs
    end if
    x.decls.Push( txt )
    UsrSet( x, id, US_EMITTED )
end sub

type DllScan_
    as CImp ptr x
    as boolean found
end type

private function DllScanVisit_ cdecl _
    ( byval c as CXCursor, byval parent as CXCursor, byval client as any ptr ) as long
    dim as DllScan_ ptr ds = client
    if ds->x->api->getCursorKind( c ) = CXCursor_DLLImport then ds->found = true
    return CXChildVisit_Continue
end function

'' A GLOBAL: 'extern name alias "c" as T', or 'extern import' when the header marks it
'' __declspec(dllimport) -- the variable then lives behind an import-table pointer, and the
'' linker needs to know. An array keeps its bounds.
private sub EmitVar_( byref x as CImp, byval c as CXCursor )
    if x.api->Cursor_getStorageClass( c ) = CX_SC_Static then return
    dim as long id = UsrId( x, CursorUsr( x, c ) )
    if (UsrState( x, id ) and (US_EMITTED or US_REFUSED)) <> 0 then return
    dim as string cname = CursorName( x, c )
    dim as string nm = UsrFbName( x, id )
    dim as string why
    dim as CXType vt = x.api->getCursorType( c )
    dim as CXType vu = Unwrap( x, vt )
    dim as string dims
    if vu.kind = CXType_IncompleteArray__ then
        UsrSet( x, id, US_REFUSED )
        Skip( x, "variable", nm, "an array of unknown size has no FreeBASIC spelling" )
        return
    end if
    if vu.kind = CXType_ConstantArray__ then
        dim as string d
        dim as long rank = 0
        while vu.kind = CXType_ConstantArray__
            if rank > 0 then d &= ", "
            d &= "0 to " & (x.api->getNumElements( vu ) - 1)
            rank += 1
            vt = x.api->getElementType( vu )
            vu = Unwrap( x, vt )
        wend
        dims = "(" & d & ")"
    end if
    dim as string tt = TypeText( x, vt, why )
    if len( tt ) = 0 then
        UsrSet( x, id, US_REFUSED )
        Skip( x, "variable", nm, why )
        return
    end if
    dim as DllScan_ ds
    ds.x = @x
    x.api->visitChildren( c, @DllScanVisit_, @ds )
    dim as string kw = "extern "
    if ds.found then kw = "extern import "
    x.decls.Push( kw & nm & dims & " alias """ & cname & """ as " & tt )
    UsrSet( x, id, US_EMITTED )
end sub

private sub EmitRecordAt_( byref x as CImp, byval c as CXCursor )
    if x.api->isCursorDefinition( c ) = 0 then return
    dim as long id = UsrId( x, CursorUsr( x, c ) )
    if (UsrState( x, id ) and (US_EMITTED or US_REFUSED)) <> 0 then return
    dim as string nm = UsrFbName( x, id )
    '' An anonymous record with no typedef to name it is either an anonymous member or the
    '' type of a field; the record that contains it deals with it.
    if len( nm ) = 0 then return
    dim as string why
    dim as string saveCur = x.curRecordUsr
    if RecordEmit( x, c, nm, why ) = false then
        UsrSet( x, id, US_REFUSED )
        Skip( x, iif( RecordIsUnion( x, c ), "union", "struct" ), nm, why )
    end if
    x.curRecordUsr = ""
end sub

private function Pass2_ cdecl _
    ( byval c as CXCursor, byval parent as CXCursor, byval client as any ptr ) as long
    dim as CImp ptr xp = client
    select case xp->api->getCursorKind( c )
    case CXCursor_StructDecl, CXCursor_UnionDecl
        EmitRecordAt_( *xp, c )
    case CXCursor_EnumDecl
        EmitEnum_( *xp, c )
    case CXCursor_TypedefDecl
        EmitTypedef_( *xp, c )
    case CXCursor_FunctionDecl
        EmitFunction_( *xp, c )
    case CXCursor_VarDecl
        EmitVar_( *xp, c )
    end select
    return CXChildVisit_Continue
end function

'' THE DEFERRED TYPEDEFS, after every declaration -- where fbc-modern puts them too. Each
'' round emits whatever has become expressible; the rounds stop when one changes nothing,
'' and what is left is skipped with its reason.
private sub RetryDeferred_( byref x as CImp )
    dim as boolean moved = true
    while moved
        moved = false
        for i as long = 0 to x.nDeferred - 1
            dim as CXCursor c = x.deferred( i )
            dim as long id = UsrId( x, CursorUsr( x, c ) )
            if (UsrState( x, id ) and (US_EMITTED or US_REFUSED)) <> 0 then continue for
            dim as string why
            dim as boolean deferIt
            dim as string txt = TypedefText_( x, c, why, deferIt )
            if deferIt then continue for
            if len( why ) then
                UsrSet( x, id, US_REFUSED )
                Skip( x, "typedef", UsrFbName( x, id ), why )
            else
                if len( txt ) then x.decls.Push( txt )
                UsrSet( x, id, US_EMITTED )
            end if
            moved = true
        next
    wend
    for i as long = 0 to x.nDeferred - 1
        dim as long id = UsrId( x, CursorUsr( x, x.deferred( i ) ) )
        if (UsrState( x, id ) and (US_EMITTED or US_REFUSED)) = 0 then
            UsrSet( x, id, US_REFUSED )
            Skip( x, "typedef", UsrFbName( x, id ), "names a record that never arrived" )
        end if
    next
end sub

sub DeclPassEmit( byref x as CImp )
    x.api->visitChildren( x.api->getTranslationUnitCursor( x.tu ), @Pass2_, @x )
    RetryDeferred_( x )
end sub

end namespace
