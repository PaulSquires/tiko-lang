'' import.tiko -- one import: parse, name, emit, assemble. See import.ti.

#import "std/containers"
#include once "cimport/import.ti"

namespace Tko.CImport

'' Bumped whenever the same input would produce different text -- phase C's cache key
'' carries it, so a changed importer never serves an old binding.
const CIMPORT_SCHEMA = 2

const CXTranslationUnit_Flags_ = CXTranslationUnit_DetailedPreprocessingRecord or _
                                 CXTranslationUnit_SkipFunctionBodies
const UNIT_NAME = "tiko-cimport.c"

'' ---------------------------------------------------------------- the files clang read

type Files_
    as ClangApi ptr api
    as Tko.StrVec names
    as int32 visits           '' every callback, the unit and repeats included
end type

private sub InclusionVisit_ cdecl _
    ( byval included as any ptr, byval stack as CXSourceLocation ptr, _
      byval depth as uint32, byval client as any ptr )
    dim as Files_ ptr fp = client
    '' THE BANNER'S "C files read" COUNTS EVERY INCLUSION, the unit and repeats included --
    '' fbc-modern's figure: 24 for probe.h on win64, where 20 files are distinct. The
    '' dependency list below stays one entry per file.
    fp->visits += 1
    dim as string nm = ClangText( *fp->api, fp->api->getFileName( included ) )
    '' THE UNIT ITSELF IS NOT A DEPENDENCY: it is text this importer wrote, and its name
    '' is not a file.
    if nm = UNIT_NAME then return
    for i as int32 = 0 to fp->names.Count - 1
        if fp->names[i] = nm then return
    next
    fp->names.Push( nm )
end sub

'' ---------------------------------------------------------------- the banner

'' A HEADER NAME WITH NO LOCAL PATH. The binding must be byte-identical on every machine for
'' the same inputs -- that is what makes a checked-in binding diffable across an SDK
'' upgrade -- so a relative name is kept as written and an absolute one is cut to its last
'' component.
private function NoLocalPath_( byref h as string ) as string
    dim as boolean abs_ = false
    if len( h ) >= 1 then abs_ = (h[0] = asc( "/" )) orelse (h[0] = asc( "\" ))
    if len( h ) >= 2 then
        if h[1] = asc( ":" ) then abs_ = true
    end if
    if abs_ = false then return h
    for i as int32 = len( h ) to 1 step -1
        if (h[i - 1] = asc( "/" )) orelse (h[i - 1] = asc( "\" )) then return mid( h, i + 1 )
    next
    return h
end function

private function Pad_( byref s as string, byval n as int32 ) as string
    if len( s ) >= n then return s
    return s & space( n - len( s ) )
end function

'' The whole file: banner, ledgers, crt/long.bi, the extern block, the forward aliases,
'' the declarations. fbc-modern's layout, line for line (import.ti).
'' ONE COPY, NOT ONE PER LINE: windows.h's binding is 2.8 MB in 56,000 pieces, and
'' appending each to a growing string took fourteen seconds.
function JoinParts( byref parts as Tko.StrVec ) as string
    dim as int32 total = 0
    for i as int32 = 0 to parts.Count - 1
        total += len( parts[i] )
    next
    dim as string o = space( total )
    dim as int32 at = 0
    for i as int32 = 0 to parts.Count - 1
        dim as int32 n = len( parts[i] )
        if n > 0 then memcpy( strptr( o ) + at, strptr( parts[i] ), n )
        at += n
    next
    return o
end function

private function Assemble_( byref x as CImp, byval nfiles as int32 ) as string
    dim as string nl = chr( 10 )
    dim as string hdrs
    for i as int32 = 0 to x.opts->headers.Count - 1
        if i > 0 then hdrs &= ", "
        hdrs &= NoLocalPath_( x.opts->headers[i] )
    next

    dim as Tko.StrVec parts
    parts.Push( "'' Generated by tiko -cimport. Do not edit." & nl )
    parts.Push( "''" & nl )
    parts.Push( "''   header      : " & hdrs & nl )
    parts.Push( "''   target      : " & x.opts->targetName & " (" & x.opts->triple & ")" & nl )
    parts.Push( "''   clang       : " & x.api->major & nl )
    parts.Push( "''   importer    : schema " & CIMPORT_SCHEMA & nl )
    parts.Push( "''   C files read: " & nfiles & nl )
    parts.Push( "''" & nl )
    parts.Push( "'' " & x.decls.Count & " declarations." & nl )

    if x.renC.Count > 0 then
        parts.Push( "''" & nl )
        parts.Push( "'' " & x.renC.Count & " names were changed:" & nl )
        for i as int32 = 0 to x.renC.Count - 1
            parts.Push( "''     " & RenameLine( x, i ) & nl )
        next
    end if
    if x.skipName.Count > 0 then
        parts.Push( "''" & nl )
        parts.Push( "'' " & x.skipName.Count & " declarations were skipped:" & nl )
        for i as int32 = 0 to x.skipName.Count - 1
            parts.Push( "''     " & Pad_( x.skipKind[i], 10 ) & Pad_( x.skipName[i], 28 ) & x.skipWhy[i] & nl )
        next
    end if

    parts.Push( nl & "#pragma once" & nl & nl )
    if x.needsCLong then parts.Push( "#include once ""crt/long.bi""" & nl & nl )
    parts.Push( "extern ""C""" & nl & nl )

    '' FORWARD POINTER ALIASES, hoisted above everything that uses one: FreeBASIC accepts a
    '' reference to a record defined further down only through a pointer typedef. Each is
    '' resolved now that the walk is over -- to the record if it arrived; to the record as
    '' an INCOMPLETE type if it was skipped, introduced by an alias of its own (see
    '' PtrToRecord_ in types.tiko); to ANY PTR otherwise.
    if x.fwdLines.Count > 0 then
        parts.Push( "'' forward references" & nl )
        for i as int32 = 0 to x.fwdLines.Count - 1
            dim as int32 id = UsrId( x, x.fwdUsr[i] )
            dim as string nm = x.fwdLines[i]
            dim as uint8 st = UsrState( x, id )
            if ((st and US_EMITTED) <> 0) andalso ((st and US_OPAQUE) = 0) then
                parts.Push( "type " & nm & "__ptr as " & nm & " ptr" & nl )
            elseif (st and US_REFUSED) <> 0 then
                parts.Push( "type " & nm & "__fwd as " & nm & nl )
                parts.Push( "type " & nm & "__ptr as " & nm & " ptr" & nl )
            else
                parts.Push( "type " & nm & "__ptr as any ptr" & nl )
            end if
        next
        parts.Push( nl )
    end if

    for i as int32 = 0 to x.decls.Count - 1
        parts.Push( x.decls[i] & nl )
    next
    parts.Push( nl & "end extern" & nl )
    return JoinParts( parts )
end function

'' ---------------------------------------------------------------- the run

function CImportRun( byref api as ClangApi, byref opts as CImportOptions, _
                     byref res as CImportResult ) as boolean
    res.rc = 0
    if api.ok = false then
        res.rc = 3
        res.why = api.why
        return false
    end if

    '' THE ARGUMENTS OUTLIVE THE PARSE: argv holds pointers into these strings.
    dim as Tko.StrVec av
    av.Push( "-x" ) : av.Push( "c" ) : av.Push( "-std=c11" )
    av.Push( "--target=" & opts.triple )
    dim as string rdir = ClangResourceDir( api )
    if len( rdir ) then av.Push( "-resource-dir=" & rdir )
    for i as int32 = 0 to opts.cincludes.Count - 1
        av.Push( "-I" ) : av.Push( opts.cincludes[i] )
    next
    for i as int32 = 0 to opts.cdefines.Count - 1
        av.Push( "-D" ) : av.Push( opts.cdefines[i] )
    next
    if len( opts.csysroot ) then av.Push( "--sysroot=" & opts.csysroot )
    for i as int32 = 0 to opts.copts.Count - 1
        av.Push( opts.copts[i] )
    next
    dim as zstring ptr argv( 0 to av.Count )
    for i as int32 = 0 to av.Count - 1
        argv( i ) = strptr( av[i] )
    next

    '' ONE IN-MEMORY UNIT holds an #include per header. It is never written to disk. A
    '' header written '<name>' is a system include, as it would be in C.
    dim as string unitText
    for i as int32 = 0 to opts.headers.Count - 1
        dim as string h = opts.headers[i]
        if (len( h ) >= 2) andalso (left( h, 1 ) = "<") andalso (right( h, 1 ) = ">") then
            unitText &= "#include " & h & chr( 10 )
        else
            unitText &= "#include """ & h & """" & chr( 10 )
        end if
    next
    dim as string unitName = UNIT_NAME
    dim as CXUnsavedFile uf
    uf.Filename = strptr( unitName )
    uf.Contents = strptr( unitText )
    uf.Length = len( unitText )

    dim as any ptr idx = api.createIndex( 0, 0 )
    dim as any ptr tu = api.parseTranslationUnit( idx, strptr( unitName ), @argv( 0 ), av.Count, _
                                                  @uf, 1, CXTranslationUnit_Flags_ )
    if tu = nullptr then
        api.disposeIndex( idx )
        res.rc = 1
        res.why = "clang could not start a parse"
        return false
    end if

    '' ANY ERROR ABORTS THE IMPORT. A header that did not parse gives a translation unit
    '' with holes in it, and importing the rest would produce a binding missing whatever
    '' the error hid -- silently.
    dim as int32 nerr = 0
    for i as int32 = 0 to api.getNumDiagnostics( tu ) - 1
        dim as any ptr d = api.getDiagnostic( tu, i )
        if api.getDiagnosticSeverity( d ) >= 3 then
            nerr += 1
            dim as string t = ClangText( api, api.formatDiagnostic( d, 3 ) )
            '' WHICH HEADER WAS MISSING says what fixes it: one the user named (the error is
            '' in the unit itself) wants its directory; one it included wants the target's
            '' system headers.
            if instr( t, "file not found" ) > 0 then
                if left( t, len( UNIT_NAME ) + 1 ) = UNIT_NAME & ":" then
                    res.namedNotFound = true
                else
                    res.notFound = true
                end if
            end if
            if res.clangDiags.Count < 10 then res.clangDiags.Push( t )
        end if
        api.disposeDiagnostic( d )
    next
    if nerr > 0 then
        if nerr > 10 then res.clangDiags.Push( "(" & (nerr - 10) & " more suppressed)" )
        api.disposeTranslationUnit( tu )
        api.disposeIndex( idx )
        res.rc = 1
        dim as string hs
        for i as int32 = 0 to opts.headers.Count - 1
            if i > 0 then hs &= ", "
            hs &= opts.headers[i]
        next
        res.why = hs
        return false
    end if

    dim as Files_ fl
    fl.api = @api
    api.getInclusions( tu, @InclusionVisit_, @fl )
    for i as int32 = 0 to fl.names.Count - 1
        res.deps.Push( fl.names[i] )
    next

    dim as CImp x
    x.api = @api
    x.opts = @opts
    x.tu = tu
    x.unitText = unitText
    for i as int32 = 0 to av.Count - 1
        x.args.Push( av[i] )
    next
    if len( opts.seedState ) then
        if StateSeed( x, opts.seedState ) = false then
            res.rc = 1
            res.why = "internal: the earlier import's state could not be read"
            api.disposeTranslationUnit( tu )
            api.disposeIndex( idx )
            return false
        end if
    end if
    DeclPassNames( x )
    '' A RECORD AN EARLIER #cinclude LEFT OPAQUE, which this one defines: the first
    '' binding said 'type X as any' or took an 'any ptr' for it, and this one would declare
    '' the record -- two types for one C struct. Refused with the order that fixes it.
    dim as string clash = StateConflict( x )
    if len( clash ) then
        res.rc = 4
        res.why = clash
        api.disposeTranslationUnit( tu )
        api.disposeIndex( idx )
        return false
    end if
    DeclPassEmit( x )
    MacroPass( x )
    res.state = StateExport( x )

    res.text = Assemble_( x, fl.visits )
    for i as int32 = 0 to x.manifest.Count - 1
        res.manifest &= x.manifest[i] & chr( 10 )
    next

    api.disposeTranslationUnit( tu )
    api.disposeIndex( idx )
    return true
end function

end namespace
