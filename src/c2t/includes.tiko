'' includes.tiko -- #include, translated. See c2t.ti.
''
'' CLANG SAYS WHAT EACH #include OPENED (clang_getInclusions), so nothing here searches a path:
'' a directive resolved to a header that is not a system header becomes '#include once' of
'' that header's .ti, written relative to the including header -- which is how tiko resolves
'' #include, and what c2t writes beside it when that header is translated in its own run
'' (D14, D16). A system header goes through the table below: nothing, when tiko has its
'' contents built in; tiko's own header, when it has one -- and then the types that header
'' declares may be named in the translation (types.tiko's passthrough); a TODO otherwise.
''
'' RUN BEFORE THE DECLARATIONS, so the passthrough is known when their types are spelled.
''
'' A DECORATION-ONLY HEADER is not included at all: one that declares nothing, includes
'' nothing, and whose every macro a pass reaches is decoration -- SDL3's SDL_begin_code.h and
'' SDL_close_code.h, a bracket pair neither of which can be translated on its own. Its macros
'' are stripped where they are used (clang's semantics), so tiko needs none of them, and
'' defining them would only collide with the library's own names (SDL_MALLOC, SDL_malloc).

#import "std/containers"
#include once "c2t/c2t.ti"
#include once "driver/modresolve.ti"

namespace Tko.C2t

'' ---------------------------------------------------------------- the system headers

'' header -> tiko's header ("" for none needed), and the type names that header lets a
'' translation name ("*": every system name -- windows.bi declares the Win32 API as spelled).
private function SysHeader_( byref key as string, byref tikoInc as string, byref names as string ) as boolean
    tikoInc = ""
    names = ""
    select case key
    case "stddef.h", "stdint.h", "stdbool.h", "stdarg.h", "float.h", "limits.h", _
         "iso646.h", "stdalign.h", "stdnoreturn.h"
        '' FREESTANDING: what they declare is built into tiko, or spelled by c2t itself
        '' (size_t, int32_t, va_list: emitdecl.tiko's table).
    case "stdio.h"  : tikoInc = "crt/stdio.bi"  : names = "FILE fpos_t"
    case "stdlib.h" : tikoInc = "crt/stdlib.bi" : names = "div_t ldiv_t lldiv_t"
    case "string.h" : tikoInc = "crt/string.bi"
    case "time.h"   : tikoInc = "crt/time.bi"   : names = "time_t clock_t tm timespec"
    case "wchar.h"  : tikoInc = "crt/wchar.bi"  : names = "wint_t mbstate_t"
    case "ctype.h"  : tikoInc = "crt/ctype.bi"
    case "errno.h"  : tikoInc = "crt/errno.bi"
    case "math.h"   : tikoInc = "crt/math.bi"
    case "locale.h" : tikoInc = "crt/locale.bi" : names = "lconv"
    case "setjmp.h" : tikoInc = "crt/setjmp.bi" : names = "jmp_buf"
    case "windows.h", "windef.h", "winbase.h", "winuser.h", "wingdi.h", "wtypes.h", "minwindef.h"
        tikoInc = "windows.bi" : names = "*"
    '' OPENGL: tiko's GL/gl.bi and GL/glext.bi (Windows' or Mesa's, chosen by target) declare the
    '' API and its types -- GLenum, GLsizei, PFNGL...PROC -- as spelled. macOS's <OpenGL/...>
    '' spelling of the same headers maps to them too.
    case "gl/gl.h", "opengl/gl.h"
        tikoInc = "GL/gl.bi" : names = "*"
    case "gl/glext.h", "opengl/glext.h"
        tikoInc = "GL/glext.bi" : names = "*"
    case else
        return false
    end select
    return true
end function

'' ---------------------------------------------------------------- what clang included

type IncCtx_
    as Tko.CImport.ClangApi ptr api
    as any ptr tu
    files as Tko.StrVec
    offs as C2tIntVec
    sys as C2tIntVec
    allFiles as Tko.StrVec      '' every file the unit opened, at any depth
    allSys as C2tIntVec
end type

private sub IncVisit_ cdecl _
    ( byval included as any ptr, byval stack as Tko.CImport.CXSourceLocation ptr, _
      byval depth as uint32, byval client as any ptr )
    dim as IncCtx_ ptr x = client
    if depth >= 1 then
        x->allFiles.Push( Tko.CImport.ClangText( *x->api, x->api->getFileName( included ) ) )
        dim as Tko.CImport.CXSourceLocation a0 = x->api->getLocationForOffset( x->tu, included, 0 )
        x->allSys.Push( iif( x->api->Location_isInSystemHeader( a0 ) <> 0, 1, 0 ) )
    end if
    '' ONLY WHAT THE HEADER ITSELF INCLUDES: depth 1, whose one stack entry is the directive.
    if depth <> 1 then return
    dim as uint32 o = 0
    x->api->getExpansionLocation( stack[0], nullptr, nullptr, nullptr, @o )
    x->files.Push( Tko.CImport.ClangText( *x->api, x->api->getFileName( included ) ) )
    x->offs.Push( cast( int32, o ) )
    dim as Tko.CImport.CXSourceLocation l0 = x->api->getLocationForOffset( x->tu, included, 0 )
    x->sys.Push( iif( x->api->Location_isInSystemHeader( l0 ) <> 0, 1, 0 ) )
end sub

'' ---------------------------------------------------------------- paths

private function Slashes_( byref p as string ) as string
    dim as string r = p
    for i as int32 = 0 to len( r ) - 1
        if r[i] = 92 then r[i] = 47
    next
    return r
end function

private sub Parts_( byref p as string, byref v as Tko.StrVec )
    dim as string s = Slashes_( p ) & "/"
    dim as int32 a = 1
    for i as int32 = 1 to len( s )
        if mid( s, i, 1 ) = "/" then
            if i > a then v.Push( mid( s, a, i - a ) )
            a = i + 1
        end if
    next
end sub

'' 'to', relative to the directory 'fromDir' -- both absolute. Windows paths compare without
'' regard to case.
private function RelPath_( byref fromDir as string, byref to_ as string ) as string
    dim as Tko.StrVec a, b
    Parts_( fromDir, a )
    Parts_( to_, b )
    dim as int32 k = 0
    while (k < a.Count) andalso (k < b.Count - 1)
        #ifdef __FB_WIN32__
            if lcase( a[k] ) <> lcase( b[k] ) then exit while
        #else
            if a[k] <> b[k] then exit while
        #endif
        k += 1
    wend
    dim as string r
    for i as int32 = k to a.Count - 1
        r &= "../"
    next
    for i as int32 = k to b.Count - 1
        r &= b[i]
        if i < b.Count - 1 then r &= "/"
    next
    return r
end function

private function TiName_( byref p as string ) as string
    dim as int32 slash = 0
    for i as int32 = len( p ) to 1 step -1
        if mid( p, i, 1 ) = "/" then
            slash = i
            exit for
        end if
        if mid( p, i, 1 ) = "." then return left( p, i - 1 ) & ".ti"
    next
    return p & ".ti"
end function

'' ---------------------------------------------------------------- decoration-only headers

'' Words a decoration macro's body may hold: attributes, storage and inline words, calling
'' conventions, feature tests. One that takes '(' takes its whole parenthesised group.
private function DecorWord_( byref w as string ) as boolean
    select case w
    case "__attribute__", "__attribute", "__declspec", "alignas", "_Alignas", _
         "__has_builtin", "__has_attribute", "__has_feature", "__has_extension", _
         "__has_include", "__has_c_attribute", "__has_cpp_attribute", _
         "static", "extern", "inline", "__inline", "__inline__", "__forceinline", _
         "restrict", "__restrict", "__restrict__", "_Noreturn", "noreturn", "__unaligned", _
         "__cdecl", "_cdecl", "__stdcall", "_stdcall", "__fastcall", "__vectorcall", "__thiscall"
        return true
    end select
    return false
end function

private function InVec_( byref v as Tko.StrVec, byref w as string ) as boolean
    for i as int32 = 0 to v.Count - 1
        if v[i] = w then return true
    next
    return false
end function

'' The next token after i that is not a comment, or n.
private function NextTok_( byref src as C2tSource, byval i as int32, byval n as int32 ) as int32
    i += 1
    while (i < n) andalso (src.toks[i].kind = CT_COMMENT)
        i += 1
    wend
    return i
end function

'' Is the body of #define d decoration? Its own parameters, the header's other macros and
'' implementation-reserved names (SAL's _Check_return_) count as decoration too.
private function DecorBody_( byref src as C2tSource, byref d as C2tDirective, _
                             byref macros as Tko.StrVec ) as boolean
    if d.name_ = "NULL" then return true      '' tiko has no NULL to define; cimport drops it too
    dim as int32 n = d.tok2 + 1
    dim as int32 t = NextTok_( src, d.tok1, n )        '' 'define'
    t = NextTok_( src, t, n )                          '' the name
    if t >= n then return true
    dim as int32 nameTok = t
    t = NextTok_( src, t, n )
    dim as Tko.StrVec params
    '' FUNCTION-LIKE: '(' right against the name.
    if (t < n) andalso (TokText( src, t ) = "(") andalso _
       (src.toks[t].ofs = src.toks[nameTok].ofs + src.toks[nameTok].len_) then
        t = NextTok_( src, t, n )
        while (t < n) andalso (TokText( src, t ) <> ")")
            if src.toks[t].kind = CT_IDENT then params.Push( TokText( src, t ) )
            t = NextTok_( src, t, n )
        wend
        t = NextTok_( src, t, n )
    end if
    while t < n
        dim as string w = TokText( src, t )
        if (w = "[") andalso (NextTok_( src, t, n ) < n) andalso (TokText( src, NextTok_( src, t, n ) ) = "[") then
            '' A C23 ATTRIBUTE: [[ ... ]], whatever it holds.
            dim as int32 depth = 0
            do
                dim as string b = TokText( src, t )
                if b = "[" then depth += 1
                if b = "]" then depth -= 1
                t = NextTok_( src, t, n )
            loop while (t < n) andalso (depth > 0)
            continue while
        end if
        if src.toks[t].kind <> CT_IDENT then return false
        if DecorWord_( w ) then
            dim as int32 u = NextTok_( src, t, n )
            if (u < n) andalso (TokText( src, u ) = "(") then
                dim as int32 depth = 0
                t = u
                do
                    dim as string b = TokText( src, t )
                    if b = "(" then depth += 1
                    if b = ")" then depth -= 1
                    t = NextTok_( src, t, n )
                loop while (t < n) andalso (depth > 0)
                continue while
            end if
        elseif (InVec_( macros, w ) = false) andalso (InVec_( params, w ) = false) then
            if (len( w ) < 2) orelse (w[0] <> 95) then return false
            if (w[1] <> 95) andalso ((w[1] < 65) orelse (w[1] > 90)) then return false
        end if
        t = NextTok_( src, t, n )
    wend
    return true
end function

'' Does the header at path hold only decoration, as this pass reaches it?
private function DecorOnly_( byref e as C2tEmit, byref p as C2tPass, byref path_ as string ) as boolean
    dim as C2tSource src
    if LoadSource( path_, src ) = false then return false
    dim as C2tDirVec dirs
    ScanDirectives( src, dirs )
    '' NOTHING OUTSIDE THE DIRECTIVES but comments: a declaration makes it a real header.
    dim as C2tIntVec inDir
    for i as int32 = 0 to src.toks.Count - 1
        inDir.Push( 0 )
    next
    for k as int32 = 0 to dirs.Count - 1
        for i as int32 = dirs[k].tok1 to dirs[k].tok2
            inDir[i] = 1
        next
    next
    for i as int32 = 0 to src.toks.Count - 1
        if (inDir[i] = 0) andalso (src.toks[i].kind <> CT_COMMENT) then return false
    next
    '' WHAT THIS PASS SKIPS IN IT does not count (another compiler's branch, a doc section).
    dim as C2tIntVec skipped
    dim as any ptr fh = e.api->getFile( p.tu, strptr( path_ ) )
    if fh <> nullptr then
        dim as Tko.CImport.CXSourceRangeList ptr lst = e.api->getSkippedRanges( p.tu, fh )
        if lst <> nullptr then
            for i as int32 = 0 to cast( int32, lst->count ) - 1
                dim as uint32 o = 0
                e.api->getExpansionLocation( e.api->getRangeStart( lst->ranges[i] ), nullptr, nullptr, nullptr, @o )
                skipped.Push( cast( int32, o ) )
                e.api->getExpansionLocation( e.api->getRangeEnd( lst->ranges[i] ), nullptr, nullptr, nullptr, @o )
                skipped.Push( cast( int32, o ) )
            next
            e.api->disposeSourceRangeList( lst )
        end if
    end if
    dim as Tko.StrVec macros
    for k as int32 = 0 to dirs.Count - 1
        if dirs[k].kind = DK_DEFINE then macros.Push( dirs[k].name_ )
    next
    for k as int32 = 0 to dirs.Count - 1
        dim as C2tDirective d = dirs[k]
        dim as int32 o = src.toks[d.tok1].ofs
        dim as boolean live = true
        for i as int32 = 0 to skipped.Count - 2 step 2
            if (o >= skipped[i]) andalso (o < skipped[i + 1]) then
                live = false
                exit for
            end if
        next
        if live = false then continue for
        select case d.kind
        case DK_INCLUDE
            return false
        case DK_DEFINE
            if DecorBody_( src, d, macros ) = false then return false
        case DK_OTHER
            select case d.word
            case "error", "warning"
            case "pragma"
                dim as int32 w = NextTok_( src, NextTok_( src, d.tok1, d.tok2 + 1 ), d.tok2 + 1 )
                if w > d.tok2 then return false
                select case TokText( src, w )
                case "pack", "warning", "once", "nopackwarning", "clang", "GCC"
                case else
                    return false
                end select
            case else
                return false
            end select
        end select
    next
    return true
end function

'' ---------------------------------------------------------------- re-included headers

private function InSkipped_( byref p as C2tPass, byval ofs as int32 ) as boolean
    for i as int32 = 0 to p.skipped.Count - 2 step 2
        if (ofs >= p.skipped[i]) andalso (ofs < p.skipped[i + 1]) then return true
    next
    return false
end function

'' The file the unit opened whose path ends with the written one ('SDL3/SDL_properties.h'),
'' at a '/' -- Windows paths without regard to case. -1 when none, or more than one does.
private function SeenBefore_( byref x as IncCtx_, byref written as string ) as int32
    dim as string w = "/" & Slashes_( written )
    dim as int32 found = -1
    for i as int32 = 0 to x.allFiles.Count - 1
        dim as string f = "/" & Slashes_( x.allFiles[i] )
        if len( f ) < len( w ) then continue for
        dim as string tl = right( f, len( w ) )
        dim as boolean same
        #ifdef __FB_WIN32__
            same = (lcase( tl ) = lcase( w ))
        #else
            same = (tl = w)
        #endif
        if same = false then continue for
        if (found >= 0) andalso (Slashes_( x.allFiles[found] ) <> Slashes_( x.allFiles[i] )) then return -1
        found = i
    next
    return found
end function

'' ---------------------------------------------------------------- the directives

sub IncludeDirectives( byref e as C2tEmit, byref p as C2tPass, byref dirs as C2tDirVec )
    dim as int32 n = dirs.Count
    e.incState.Clear( ) : e.incText.Clear( ) : e.incReason.Clear( ) : e.incWhy.Clear( )
    for k as int32 = 0 to n - 1
        e.incState.Push( 0 ) : e.incText.Push( "" ) : e.incReason.Push( "" ) : e.incWhy.Push( "" )
    next
    dim as IncCtx_ x
    x.api = e.api
    x.tu = p.tu
    e.api->getInclusions( p.tu, @IncVisit_, @x )

    dim as string mainDir = Tko.Modules.DirOfFile( Tko.Modules.AbsPath( e.src->path_ ) )
    for k as int32 = 0 to n - 1
        dim as C2tDirective d = dirs[k]
        if d.kind <> DK_INCLUDE then continue for
        dim as int32 a = e.src->toks[d.tok1].ofs
        dim as int32 z = e.src->toks[d.tok2].ofs + e.src->toks[d.tok2].len_
        dim as int32 hit = -1
        for i as int32 = 0 to x.offs.Count - 1
            if (x.offs[i] >= a) andalso (x.offs[i] < z) then
                hit = i
                exit for
            end if
        next
        dim as string written = d.name_
        if len( written ) >= 2 then written = mid( written, 2, len( written ) - 2 )
        dim as string file_
        dim as boolean isSys
        if hit >= 0 then
            file_ = x.files[hit]
            isSys = (x.sys[hit] <> 0)
        else
            '' NOT INCLUDED IN THIS PASS: inside a branch it does not take (emitmacro.tiko
            '' judges that) -- or a guarded header the unit already entered elsewhere, which
            '' clang does not enter again and so does not list: the file it opened before.
            if InSkipped_( p, a ) then continue for
            dim as int32 f = SeenBefore_( x, written )
            if f >= 0 then
                file_ = x.allFiles[f]
                isSys = (x.allSys[f] <> 0)
            elseif (len( p.forcedText ) > 0) andalso (p.forcedText[a] = 32) then
                '' LEFT OUT OF A BRANCH PASS (c2t.tiko): a header this host does not have. Its
                '' name is all there is -- '<x>' goes through the table, '"x"' is the .ti beside.
                if left( d.name_, 1 ) <> "<" then
                    e.incText[k] = "#include once " & chr( 34 ) & TiName_( Slashes_( written ) ) & chr( 34 )
                    e.incState[k] = 1
                    continue for
                end if
                isSys = true
            else
                continue for
            end if
        end if
        if isSys then
            dim as string key = lcase( Slashes_( written ) )
            dim as string tikoInc, names
            if SysHeader_( key, tikoInc, names ) = false then
                e.incState[k] = 2
                e.incReason[k] = "system-header"
                e.incWhy[k] = "<" & written & "> has no tiko counterpart in c2t's table"
                continue for
            end if
            if len( tikoInc ) then
                e.incText[k] = "#include once " & chr( 34 ) & tikoInc & chr( 34 )
            else
                e.incText[k] = "'' <" & written & ">: built into tiko"
            end if
            e.incState[k] = 1
            '' THE TYPES IT DECLARES may now be named (types.tiko, the c2t passthrough).
            if names = "*" then
                e.x->c2tSysAll = true
            elseif len( names ) then
                dim as string s = names & " "
                dim as int32 st = 1
                for i as int32 = 1 to len( s )
                    if mid( s, i, 1 ) = " " then
                        if i > st then e.x->c2tSysPass.Push( mid( s, st, i - st ) )
                        st = i + 1
                    end if
                next
            end if
        elseif DecorOnly_( e, p, file_ ) then
            e.incText[k] = "'' c2t: " & d.name_ & " holds only decoration macros (stripped where used)"
            e.incState[k] = 1
        else
            dim as string rel = RelPath_( mainDir, Tko.Modules.AbsPath( file_ ) )
            e.incText[k] = "#include once " & chr( 34 ) & TiName_( rel ) & chr( 34 )
            e.incState[k] = 1
        end if
    next
end sub

end namespace
