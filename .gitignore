# build products
/bin/
/build/obj/
# scratch from sweeps, lint and corpus runs -- every build/ dotfile is an output
/build/.*

# stray objects from a manual fbc invocation
*.o
*.a
*.exe
# -gen llvm drops the IR beside the source
*.ll

# editor and OS noise
*.swp
.DS_Store
Thumbs.db

# Scratch probes at the ROOT. Every real source lives under src/, tests/ or tools/,
# and a probe lands here only when a 'cd build/.mc' failed -- which has happened
# three times and been cleaned up three times.
/*.bas
/*.c
/*.exe
__pycache__/
*.pyc

# fbc WRITES ITS C OUTPUT NEXT TO THE SOURCE unless -x names somewhere else, and the
# corpus is compiled with fbc constantly -- to measure what it emits, and by every
# check-*.sh gate. Those .c files are BUILD ARTEFACTS in a directory that must never
# be edited, and 'git add -A' swept 46 of them into a commit before this rule existed.
tests/vendor/**/*.c
tests/vendor/**/*.exe
tests/vendor/**/*.o

# ------------------------------------------------------------------ lib/rt
# The runtime's build products. Its own .gitignore said 'obj/' and 'lib/' when it
# was its own repo at C:\dev\tiko-rt; re-rooted here so the rules cannot reach the
# COMPILER's lib/, which is source (lib/gfx) rather than output.
/lib/rt/obj/
/lib/rt/lib/

# ------------------------------------------------------------- toolchains
# Distributable builds. The TREE and its READMEs are tracked so the layout is
# reviewable; every byte the packaging step drops into it is a build product and
# is not. Listed per payload directory rather than as a blanket /toolchains/**,
# because git cannot re-include a file once its parent directory is excluded.
/toolchains/*/bin/
/toolchains/*/inc/
/toolchains/*/include/
/toolchains/*/lib/
/toolchains/*/tiko
/toolchains/*/tiko.exe
