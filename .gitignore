# build products
/bin/
/build/obj/
# scratch from sweeps, lint and corpus runs -- every build/ dotfile is an output
/build/.*

# stray objects from a manual fbc invocation
*.o
*.a
*.exe
# -gen llvm drops the IR beside the source
*.ll

# editor and OS noise
*.swp
.DS_Store
Thumbs.db

# Scratch probes at the ROOT. Every real source lives under src/, tests/ or tools/,
# and a probe lands here only when a 'cd build/.mc' failed -- which has happened
# three times and been cleaned up three times.
/*.bas
/*.c
/*.exe
__pycache__/
*.pyc

# fbc WRITES ITS C OUTPUT NEXT TO THE SOURCE unless -x names somewhere else, and the
# corpus is compiled with fbc constantly -- to measure what it emits, and by every
# check-*.sh gate. Those .c files are BUILD ARTEFACTS in a directory that must never
# be edited, and 'git add -A' swept 46 of them into a commit before this rule existed.
tests/vendor/**/*.c
tests/vendor/**/*.exe
tests/vendor/**/*.o

# ------------------------------------------------------------------ lib/rt
# The runtime's build products. Its own .gitignore said 'obj/' and 'lib/' when it
# was its own repo at C:\dev\tiko-rt; re-rooted here so the rules cannot reach the
# COMPILER's lib/. That comment used to end 'which is source (lib/gfx) rather
# than output' -- true until 2026-09-05, when lib/gfx gained a build of its own.
# It is now BOTH, which is exactly why these rules stay rooted and specific.
/lib/rt/obj/
/lib/rt/lib/

# ----------------------------------------------------------------- lib/gfx
# Same shape as lib/rt above: build.sh writes the archive into lib/<target>/
# and the logs into obj/, and neither is a source file.
/lib/gfx/obj/
/lib/gfx/lib/

# ------------------------------------------------------------- toolchains
# Packaged toolchains are local build products and are never published here: the
# whole folder is ignored, and the archives ship as GitHub Releases instead.
/toolchains/

# fbc's -gen gcc INTERMEDIATE C, written beside the .bas it came from. The root
# rule above catches a build run from the top; a build of src/ leaves one .c per
# module in place, and 63 of them turned up as untracked files ready to be
# committed. tiko's own sources are .bas and .bi only, so nothing under src/ is a
# real .c -- unlike lib/rt/src/c, lib/gfx/tools and tests/mir/src, which are.
/src/**/*.c

# WHAT THE FILE-ASSERTING TESTS BUILD. tests/driver/dll-output.test and
# output-kinds.test link a real DLL and archive to prove -dll and -lib put the
# right names on disk, so they leave those files behind. The runner deletes them
# BEFORE each run rather than after -- a stale artefact must never let the
# assertion pass -- which means they exist between runs and one got committed.
/tests/driver/*.dll
/tests/driver/*.dll.a
/tests/modules/*.dll
/tests/modules/*.dll.a
/tests/driver/*.a
/tests/driver/*.exe
/tests/driver/*.ll
/tests/driver/*.s

# TEST FIXTURES THAT ARE ARCHIVES. '*.a' above is right for build output and wrong
# for these: tests/pp/foreignlib.test resolves a #foreignlib spec by PROBING the
# filesystem, so the files it probes for are inputs, not artefacts. Without this
# they stay untracked, the test passes here because they exist locally, and it
# fails on a fresh clone -- which the gate cannot see either.
!/tests/pp/src/vendor/*.a

# THE MODULE CACHE (ADR 0017, RFC-0005 §4), which a build writes beside its first root --
# tests/modules fixtures among them.
.tiko/

# A downloaded seed (seed/fetch-seed.sh): an unpacked toolchain, never committed.
/seed/cache/

# Engineering notes and design docs stay local; they are not published.
/docs/
/HANDOFF.md

# Local-only notes kept beside the sources they describe; not published.
/book/README.md
/book/STYLE.md
/inc/PROVENANCE.md

# vendor package binaries: fetched or built by build/vendorfetch.sh, never committed
/pkg/vendor/*/lib/

# a program built inside examples/: the vendor libraries copied beside it
/examples/**/*.dll
/examples/**/*.so
/examples/**/*.so.*
# ...except the WebView2 loader the WebView2 examples need to start, which is not built
!/examples/win64/WebView2 Examples/WebView2Loader.dll

# the PsControls demos: the images two demos write at run time; tiko build's link record
/examples/PsControls/*/sample_icon.png
/examples/PsControls/*/sample.png
/examples/PsControls/*/sample.bmp
/examples/PsControls/**/*.link

# vendor/tkControls: its bundled fonts (fetched, like lib/) and scintk's build output; the
# examples' module cache, screenshots and link records
/pkg/vendor/tkControls/fonts/
/pkg/vendor/tkControls/tkCodeEdit/scintk/bin/
/pkg/vendor/tkControls/tkCodeEdit/scintk/out/
/examples/tkControls/out/
/examples/tkControls/linux-lib/
/examples/tkControls/**/*.bmp
/examples/tkControls/**/*.ttf
/examples/tkControls/**/*.link
