-2 ^ 2        = -4    -(2 ^ 2)          = -4
2 ^ 3 ^ 2     = 64    (2 ^ 3) ^ 2       = 64
7 \ 2 * 2     = 1     7 \ (2 * 2)       = 1
9 mod 5 \ 2   = 1     9 mod (5 \ 2)     = 1
1 shl 2 + 3   = 7     (1 shl 2) + 3     = 7
n and 1 <> 0  = 6     n and (1 <> 0)    = 6
not a = b     = -1    not (a = b)       = -1

"x" & 1 + 2 = "x3" is true
true or false and false   = true
true or (false and false) = true
true orelse false andalso false   = false
(true orelse false) andalso false = false
