#import "std/containers"

'' An array's bounds are read once, before the first pass.
dim queue( any ) as int32
redim queue( 0 to 2 )
queue( 0 ) = 1 : queue( 1 ) = 2 : queue( 2 ) = 3
for each q in queue
    print q;
    if q = 2 then
        redim preserve queue( 0 to 3 )      '' a fourth element...
        queue( 3 ) = 4
    end if
next
print " -"; ubound( queue ) + 1; " elements, the last never visited"

'' To change a collection's shape, collect the changes during the
'' walk and apply them after it.
dim stock as containers.OrderedMap( of ustring, int32 )
stock.Put( "apples", 3 )
stock.Put( "pears", 0 )
stock.Put( "plums", 0 )
stock.Put( "figs", 7 )

dim soldOut as containers.Array( of ustring )
for each item in stock
    if item.value = 0 then soldOut.Push( item.key )
next
for each gone in soldOut
    stock.Remove( gone )
next

for each item in stock
    print item.key; ":"; item.value; " ";
next
print
