#import "std/os"

'' Ctrl-C now sets a flag; the program decides when to stop.
os.CatchInterrupt( )

dim as int32 saved = 0
do while saved < 10
    if os.Interrupted( ) then exit do
    sleep 10                     '' save one record
    saved += 1
loop

print "saved"; saved; " records"
if os.Interrupted( ) then
    print "interrupted by kind"; os.LastInterrupt( )
    os.ExitWith( 130 )
end if
print "no interruption"
