#import "std/fs"

print "Records at a position"
type Score
    player as int32
    points as int32
end type

dim as ustring dir_ = fs.CreateTempDir( "tbe" ).Value( )
dim as fs.RecordFile( of Score ) scores
'' Read and write, and created if it is missing.
scores.Open( fs.PathJoin( dir_, "scores.dat" ) )

dim s as Score
for n as int32 = 1 to 4
    s.player = n
    s.points = n * 100
    scores.Append( s )                  '' returns the new record's number
next
print "records:"; scores.Count( ).Value( ); _
      ", each"; scores.RecordLength( ); " bytes"

'' Straight to record 3, change it, write it back in place.
scores.GetRecord( 3, s )
s.points += 5
scores.PutRecord( 3, s )

for each r in scores                    '' each a Result, in record order
    print "player"; r.Value( ).player; ":"; r.Value( ).points
next

'' There is no record 9: the value is false, and s is left as it was.
print "record 9 there? "; scores.GetRecord( 9, s ).Value( )
scores.Close( )
fs.RemoveDirAll( dir_ )
