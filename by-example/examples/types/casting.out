cast( float64, 7 ) / 2 = 3.5
cast( int32, price ) \ 2 = 3
cint( 2.6 )    = 3
clng( 2.6 )    = 3
clngint( 2.6 ) = 3
cdbl( 1 ) / 3  = 0.3333333333333333
csng( 1 ) / csng( 3 ) = 0.3333333

cast( uint8, 300 )  = 44
cast( int8, 200 )   = -56
cast( uint16, -1 )  = 65535
