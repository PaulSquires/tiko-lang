'' An array can have more than one dimension: one subscript for each.
'' Brace lists nest, one level per dimension, row by row.
dim as int32 grid( 1 to 2, 1 to 3 ) = { { 1, 2, 3 }, { 4, 5, 6 } }

print "rows"; lbound( grid, 1 ); " to"; ubound( grid, 1 ); _
      ", columns"; lbound( grid, 2 ); " to"; ubound( grid, 2 )

for r as int32 = lbound( grid, 1 ) to ubound( grid, 1 )
    for c as int32 = lbound( grid, 2 ) to ubound( grid, 2 )
        print grid( r, c );
    next
    print
next

'' Column totals: the same loops in the other order.
print "column totals:";
for c as int32 = lbound( grid, 2 ) to ubound( grid, 2 )
    dim as int32 sum = 0
    for r as int32 = lbound( grid, 1 ) to ubound( grid, 1 )
        sum += grid( r, c )
    next
    print sum;
next
print

'' A dynamic array can have several dimensions too.
dim as ustring board( any, any )
redim board( 0 to 2, 0 to 2 )
board( 1, 1 ) = "X" : board( 0, 2 ) = "O"
for r as int32 = 0 to 2
    for c as int32 = 0 to 2
        if board( r, c ) = "" then print "."; else print board( r, c );
    next
    print
next
