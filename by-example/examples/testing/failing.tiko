#include once "fbcunit.bi"

'' Meant to count the words in s -- but it counts the spaces.
function WordCount( byval s as ustring ) as int32
    dim as int32 n = 0
    for i as int32 = 1 to len( s )
        if mid( s, i, 1 ) = " " then n += 1
    next
    return n
end function

SUITE( words )
    TEST( counts_words )
        CU_ASSERT_EQUAL( WordCount( "" ), 0 )
        CU_ASSERT_EQUAL( WordCount( "one two three" ), 3 )
        CU_ASSERT_EQUAL( WordCount( "single" ), 1 )
    END_TEST
END_SUITE

end iif( fbcu.run_tests( ), 0, 1 )
