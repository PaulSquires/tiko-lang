'' A contract: what an encoder can do, with no data and no code. Any type
'' can take it on with an 'implements' line.
interface IEncoder
    function Name( ) as ustring
    function Encode( byref key as ustring, byval value as int32 ) as ustring
end interface

'' A plain type: no base, no vtable.
type IniEncoder
    implements IEncoder
    declare function Name( ) as ustring implements IEncoder.Name
    declare function Encode( byref key as ustring, _
                             byval value as int32 ) as ustring _
                             implements IEncoder.Encode
    sep as ustring = "="
end type

function IniEncoder.Name( ) as ustring
    return "ini"
end function

function IniEncoder.Encode( byref key as ustring, _
                            byval value as int32 ) as ustring
    return key & sep & value
end function

'' A class: a type that always extends Object.
class JsonEncoder
    implements IEncoder
    declare function Name( ) as ustring implements IEncoder.Name
    declare function Encode( byref key as ustring, _
                             byval value as int32 ) as ustring _
                             implements IEncoder.Encode
end class

function JsonEncoder.Name( ) as ustring
    return "json"
end function

function JsonEncoder.Encode( byref key as ustring, _
                             byval value as int32 ) as ustring
    return """" & key & """: " & value
end function

'' Written once, against the contract only.
sub Save( byval enc as IEncoder )
    print "as "; enc.Name( ); ":"
    print "  "; enc.Encode( "width", 640 )
    print "  "; enc.Encode( "height", 480 )
end sub

dim as IniEncoder ini
dim as JsonEncoder json
Save( ini )
Save( json )
print "an IEncoder value is"; sizeof( IEncoder ); " bytes"
