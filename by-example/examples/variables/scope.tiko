dim as ustring message = "outer"
print "1: "; message

'' scope ... end scope opens a block. A name declared inside it lives
'' only until end scope, and may hide a name from outside.
scope
    dim as ustring message = "inner"
    dim as int32 temporary = 42
    print "2: "; message; ", temporary ="; temporary

    '' Blocks nest, and the innermost declaration wins.
    scope
        dim as float64 message = 2.5
        print "3:"; message
    end scope

    print "4: "; message
end scope

'' Back outside, the outer variable was never touched.
print "5: "; message

'' Every block works this way: if, for, do and select bodies too.
for i as int32 = 1 to 2
    dim as int32 doubled = i * 2
    print "loop"; i; ":"; doubled
next

'' Assigning, rather than declaring, inside a block changes the outer
'' variable: there is only one message here.
if len( message ) > 0 then
    message = "changed in an if"
end if
print "6: "; message
