'' events.ti -- the event ring behind SCREENEVENT, and GETMOUSE's coordinates.
''
'' Derived from: gfx_core.c (fb_hPostEvent), gfx_event.c (fb_GfxEvent),
'' gfx_getmouse.c, rtlib/fb_event.h.
'' LGPL-2.1-or-later with the static-linking exception.
''
'' THREE BEHAVIOURS HERE ARE NOT THE OBVIOUS ONES.
''
'' 1. THE QUEUE DROPS THE OLDEST EVENT, SILENTLY. When the ring is full a post
''    advances the HEAD as well as the tail, discarding the event that had been
''    waiting longest. It never blocks and never reports overflow, so a program
''    that stops calling SCREENEVENT loses its oldest input and is told nothing.
''    A "return false when full" implementation is the natural guess and is
''    wrong in a way no single-event test can see.
''
'' 2. SCREENEVENT WITHOUT AN ARGUMENT IS A PEEK, NOT A READ. fb_GfxEvent only
''    advances the head `if (event)`. Called with a null pointer it reports
''    whether something is pending and leaves it there. So the no-argument form
''    is a poll that can be called repeatedly, and the one-argument form is what
''    consumes.
''
'' 3. THE QUEUE SIZE IS A MASK, NOT A MODULO. MAX_EVENTS is 128 and every wrap is
''    `(i + 1) and (MAX_EVENTS - 1)`. That is only equivalent to a modulo because
''    the size is a power of two; it is written as a mask here for the same
''    reason it is there.
''
'' AND ONE FOR GETMOUSE: on a mode whose scanlines are doubled, the reported Y is
'' divided by `scanline_size`, so it comes back in MODE coordinates rather than
'' device ones -- but ONLY on success, and ONLY when a y pointer was passed.
'' On failure every output is set to -1, not left alone, and an illegal function
'' call is raised.

#pragma once

#include once "../abi/rtlabi.ti"

'' The mirrored EVENT lives in TkoAbi, not TkoGfx -- it is an ABI type, not a
'' library one, and it is qualified everywhere here for that reason.

namespace TkoGfx

'' rtlib/fb_event.h. A power of two, and the code depends on that.
const MAX_EVENTS = 128

type EventQueue
    head as long
    tail as long
    slot(0 to MAX_EVENTS - 1) as TkoAbi.EVENT
end type

private sub EventQueueInit( byref q as EventQueue )
    q.head = 0
    q.tail = 0
end sub

'' Post one event. Always succeeds -- see note 1.
private sub EventPost( byref q as EventQueue, byref e as TkoAbi.EVENT )
    q.slot(q.tail) = e
    '' about to collide with the head: drop the OLDEST
    if ((q.tail + 1) and (MAX_EVENTS - 1)) = q.head then
        q.head = (q.head + 1) and (MAX_EVENTS - 1)
    end if
    q.tail = (q.tail + 1) and (MAX_EVENTS - 1)
end sub

'' SCREENEVENT. `consume` distinguishes the two forms: 0 peeks, 1 reads.
'' Returns non-zero if an event was available. `out` is written only when one
'' was available AND consume is set, matching the C's `if (e && event)`.
private function EventGet( _
        byref q as EventQueue, byref out as TkoAbi.EVENT, byval consume as long ) as long

    if q.head = q.tail then return 0
    if consume = 0 then return 1          '' peek: pending, but left in place

    out = q.slot(q.head)
    q.head = (q.head + 1) and (MAX_EVENTS - 1)
    return 1
end function

'' How many events are waiting. Not part of the reference's surface -- it exists
'' so a test can assert the ring's state directly rather than inferring it from a
'' sequence of reads, which is how a drop-oldest bug hides.
private function EventCount( byref q as EventQueue ) as long
    return (q.tail - q.head) and (MAX_EVENTS - 1)
end function

'' GETMOUSE's coordinate rule. Returns 0 on success, non-zero on failure, and on
'' failure writes -1 to every output rather than leaving them untouched -- a
'' caller that ignores the return value still sees an unmistakable value.
private function MouseAdjust( _
        byval ok as long, byval scanline_size as long, _
        byref x as long, byref y as long, byref z as long, _
        byref buttons as long, byref clip as long ) as long

    if ok = 0 then
        x = -1 : y = -1 : z = -1 : buttons = -1 : clip = -1
        return 1
    end if

    '' MODE coordinates, not device ones -- only on success. A mode with
    '' doubled scanlines reports half the device Y.
    if scanline_size <> 1 andalso scanline_size > 0 then
        y = y \ scanline_size
    end if
    return 0
end function

end namespace
