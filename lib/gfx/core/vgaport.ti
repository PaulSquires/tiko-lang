'' vgaport.ti -- the VGA DAC port emulation behind INP and OUT.
''
'' Derived from: gfx_vgaemu.c (fb_GfxIn, fb_GfxOut).
'' LGPL-2.1-or-later with the static-linking exception.
''
'' On a graphics screen, INP and OUT are redirected into gfxlib2 through the
'' `inproc` and `outproc` runtime hooks. Only three ports mean anything, and they
'' emulate the VGA colour DAC:
''
''   3C7 / 3C8   set the DAC index (the real chip separates read and write
''               index; this does not -- both ports do exactly the same thing)
''   3C9         the DAC data port: read or write R, then G, then B
''   3DA         input status. Waits for vsync and returns 8
''
'' THE THREE STATE VARIABLES ARE SHARED BETWEEN IN AND OUT.
''
'' `idx`, `shift` and `color` are file statics in the C, and both directions use
'' the same ones. So an INP(&h3C9) in the middle of a three-byte OUT sequence
'' does not read past it -- it ADVANCES the shift the OUT sequence was relying
'' on, and the colour being assembled is finished by the wrong bytes. This is
'' faithfully reproduced, because programs that drive the DAC do interleave and
'' the observable result depends on it.
''
'' They are also never reset by a mode change. A half-finished DAC write
'' survives SCREEN.
''
'' THE SHIFT SEQUENCE IS 2, 10, 18 -- NOT 0, 8, 16. The VGA DAC is 6 bits per
'' channel and the value is parked in the TOP six bits of each byte, so the
'' channel sits at bit 2 of its byte. Reading uses `(v shr shift) and &h3F`,
'' which is why the round trip is lossless.
''
'' THE TWO COMMIT PATHS DISAGREE ABOUT SCALING, and that is the reference's
'' behaviour, not a simplification:
''
''   256-colour   the assembled value is shifted back down and sent through the
''                normal packed-PALETTE path, which scales 6 bits to 8 as
''                (v * 255) \ 63
''   low-colour   the assembled value is stored RAW, so the effective scale is
''                v shl 2
''
'' For a full-intensity channel that is 255 one way and 252 the other. Both
'' round-trip losslessly, so only comparing against the reference finds it.

#pragma once

#include once "palette.ti"
#include once "mode.ti"
#include once "dirty.ti"

namespace TkoGfx

const VGA_PORT_DAC_READ_INDEX  = &h3C7
const VGA_PORT_DAC_WRITE_INDEX = &h3C8
const VGA_PORT_DAC_DATA        = &h3C9
const VGA_PORT_INPUT_STATUS    = &h3DA

'' Shared by both directions -- see the header.
type VgaPortState
    idx   as long
    shift as long
    color as long
end type

'' The C's static initialisers, which are also what a fresh process starts at.
private sub VgaPortInit( byref st as VgaPortState )
    st.idx   = 0
    st.shift = 2
    st.color = 0
end sub

'' Advance to the next DAC entry after a completed three-byte transfer. The wrap
'' is a MASK against the palette size, not a modulo -- every palette size is a
'' power of two, which is the only reason those agree.
private sub VgaPortNext( byref st as VgaPortState, byref p as GfxPalette )
    st.shift = 2
    st.color = 0
    st.idx += 1
    st.idx and= (p.colors - 1)
end sub

'' INP(port). Returns -1 for anything not handled, which includes the DAC data
'' port above 8bpp.
''
'' `vsynced` reports whether the caller should have waited for vsync -- the C
'' calls driver->wait_vsync here when the driver has one. Reporting it rather
'' than doing it keeps this file free of the driver.
private function VgaPortIn( _
        byref st as VgaPortState, byref p as GfxPalette, _
        byval depth as long, byval port as ushort, _
        byref vsynced as long ) as long

    vsynced = 0

    select case cast( long, port )
    case VGA_PORT_DAC_DATA
        '' NOTE the asymmetry with VgaPortOut: the depth check here guards ONLY
        '' this port, so INP(&h3DA) still works above 8bpp. The OUT side rejects
        '' every port at that depth.
        if depth > 8 then return -1
        dim as long v = cast( long, (p.entry(st.idx) shr st.shift) and &h3F )
        st.shift += 8
        if st.shift > 18 then VgaPortNext( st, p )
        return v

    case VGA_PORT_INPUT_STATUS
        vsynced = 1
        return 8
    end select

    return -1
end function

'' OUT port, value. Returns 0 when handled, -1 otherwise.
''
'' `dirtied` reports that every scanline must be marked dirty, which a committed
'' palette change requires -- the pixels did not move but their colours did.
private function VgaPortOut( _
        byref st as VgaPortState, byref p as GfxPalette, _
        byval depth as long, byval port as ushort, byval value as ubyte, _
        byref dirtied as long ) as long

    dirtied = 0
    if depth > 8 then return -1

    select case cast( long, port )
    case VGA_PORT_DAC_READ_INDEX, VGA_PORT_DAC_WRITE_INDEX
        '' Both ports do the same thing here. On real hardware 3C7 is the read
        '' index and 3C8 the write index; gfxlib2 keeps one.
        st.idx = (cast( long, value )) and (p.colors - 1)
        st.shift = 2
        st.color = 0
        return 0

    case VGA_PORT_DAC_DATA
        st.color or= (cast( long, value ) and &h3F) shl st.shift
        st.shift += 8
        if st.shift <= 18 then return 0

        '' third byte -- commit
        if p.colors >= 256 then
            '' back down to three 6-bit channels, then through the scaling path
            PaletteSetPacked( p, st.idx, cast( ulong, (st.color shr 2) and &h3F3F3F ) )
        else
            '' stored RAW here -- see the header on the scaling disagreement
            dim as ulong c = cast( ulong, st.color )
            p.base(st.idx) = c
            dim as long attrs = iif( depth >= 8, 256, 1 shl depth )
            for i as integer = 0 to attrs - 1
                if p.assoc(i) = st.idx then p.entry(i) = c
            next
        end if
        dirtied = 1
        VgaPortNext( st, p )
        return 0
    end select

    return -1
end function

end namespace
