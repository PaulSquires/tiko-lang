'' cells.ti -- the character-cell plane behind SCREEN(), WIDTH, PCOPY and POS.
''
'' Derived from: gfx_readxy.c, gfx_width.c, gfx_page.c, gfx_screen.c
'' (fb_hResetCharCells, fb_hClearCharCells).
'' LGPL-2.1-or-later with the static-linking exception.
''
'' A graphics screen keeps a parallel plane of character cells -- one per text
'' position per PAGE -- recording what character was printed there and in what
'' colours. Pixels alone cannot answer SCREEN(row, col), because two different
'' characters can paint identical pixels and a cell survives being drawn over.
''
'' FOUR THINGS HERE ARE NOT WHAT THEY LOOK LIKE.
''
'' 1. SCREEN(row, col) READS THE WORK PAGE, not the visible one. So after
''    PAGESET 1, 0 the function reports what is on the page being drawn to,
''    which is not what is on screen.
''
'' 2. WIDTH RETURNS THE SIZE IT HAD BEFORE THE CALL, packed as
''    `w or (h shl 16)`. The same packing is the pure-query result when both
''    arguments are absent, so a caller cannot tell "queried" from "changed" by
''    the return value alone.
''
'' 3. WIDTH SILENTLY DOES NOTHING FOR AN UNSUPPORTED SIZE. The requested cell
''    size is derived by DIVISION -- `font_w = screen_w \ w` -- and only three
''    fonts exist (8x8, 8x14, 8x16). Any other quotient leaves the font null and
''    the whole body is skipped: no error, no change, and a return value
''    identical to the successful case. `WIDTH 100, 30` on a 640x480 screen asks
''    for 6x16 cells and is a silent no-op.
''
'' 4. PCOPY IS FLIP, AND IT COPIES TWO DIFFERENT REGIONS. Pixels are copied only
''    within the current VIEW; the character cells are copied for the whole page
''    regardless. So a clipped PCOPY leaves the two planes disagreeing -- which
''    is observable, because SCREEN() then reports characters in a region whose
''    pixels were never copied.
''
'' A NOTE ON THE UNEVEN INITIAL STATE. fb_hResetCharCells calloc's every page
'' but then clears only `context->work_page` to space with the current colours.
'' Every other page keeps ch = 0, not 32. So on a freshly opened multi-page
'' screen, SCREEN(1,1) reads 32 on page 0 and 0 on page 1. Reproduced, because a
'' program that reads a page before writing it can see the difference.

#pragma once

#include once "mode.ti"
#include once "crt/string.bi"

namespace TkoGfx

'' The C uses FB_WCHAR for `ch`, which is 32-bit on the targets here.
type CharCell
    ch as ulong
    fg as ulong
    bg as ulong
end type

'' THE SCREEN'S PAGE LIMIT TOO -- entry/context.ti sizes its page table by it.
'' gfxlib2 has none; a SCREEN asking for more than this is refused rather than
'' given fewer pages than it counts on. Mode 1's default is 8.
const CELL_MAX_PAGES = 64

type CellPlane
    text_w    as long
    text_h    as long
    num_pages as long
    cell(0 to CELL_MAX_PAGES - 1) as CharCell ptr
end type

private function CellAt( _
        byref cp as CellPlane, byval page as long, _
        byval col0 as long, byval row0 as long ) as CharCell ptr
    if (page < 0) orelse (page >= cp.num_pages) then return nullptr
    if cp.cell(page) = nullptr then return nullptr
    if (col0 < 0) orelse (col0 >= cp.text_w) then return nullptr
    if (row0 < 0) orelse (row0 >= cp.text_h) then return nullptr
    return cp.cell(page) + (row0 * cp.text_w) + col0
end function

'' Fill a rectangle of cells. Bounds are 0-based and EXCLUSIVE at x2/y2, which
'' is how fb_hClearCharCells is called with (0, 0, text_w, text_h).
private sub CellsClear( _
        byref cp as CellPlane, _
        byval x1 as long, byval y1 as long, _
        byval x2 as long, byval y2 as long, _
        byval page as long, _
        byval ch as ulong, byval fg as ulong, byval bg as ulong )

    if (page < 0) orelse (page >= cp.num_pages) then exit sub
    if cp.cell(page) = nullptr then exit sub

    for y as integer = y1 to y2 - 1
        for x as integer = x1 to x2 - 1
            dim as CharCell ptr c = CellAt( cp, page, x, y )
            if c <> nullptr then
                c->ch = ch
                c->fg = fg
                c->bg = bg
            end if
        next
    next
end sub

private sub CellsFree( byref cp as CellPlane )
    for i as integer = 0 to CELL_MAX_PAGES - 1
        if cp.cell(i) <> nullptr then
            deallocate( cp.cell(i) )
            cp.cell(i) = nullptr
        end if
    next
    cp.num_pages = 0
end sub

'' Allocate the plane for a mode. Only `work_page` is cleared to spaces -- see
'' the note in the header; the others are left zeroed, matching the reference.
private function CellsReset( _
        byref cp as CellPlane, _
        byval text_w as long, byval text_h as long, _
        byval num_pages as long, byval work_page as long, _
        byval fg as ulong, byval bg as ulong ) as long

    CellsFree( cp )
    if (text_w <= 0) orelse (text_h <= 0) then return 0
    if (num_pages <= 0) orelse (num_pages > CELL_MAX_PAGES) then return 0

    cp.text_w = text_w
    cp.text_h = text_h
    cp.num_pages = num_pages

    dim as uinteger n = cast( uinteger, text_w ) * cast( uinteger, text_h )
    for i as integer = 0 to num_pages - 1
        cp.cell(i) = callocate( n, sizeof( CharCell ) )
        if cp.cell(i) = nullptr then
            CellsFree( cp )
            return 0
        end if
    next

    CellsClear( cp, 0, 0, text_w, text_h, work_page, 32, fg, bg )
    return 1
end function

'' SCREEN(row, col, colorflag).
''
'' NOTE THE ARGUMENT ORDER. The statement is SCREEN(row, col) but the C entry
'' point is fb_GfxReadXY(col, row, ...) -- column first. Taking them in the
'' wrong order still works on a square region and fails everywhere else.
''
'' Out of range returns 0, not an error. Bounds are 1-BASED and INCLUSIVE.
private function CellReadXY( _
        byref cp as CellPlane, byval work_page as long, byval depth as long, _
        byval col as long, byval row as long, byval colorflag as long ) as ulong

    if (col < 1) orelse (col > cp.text_w) then return 0
    if (row < 1) orelse (row > cp.text_h) then return 0

    dim as CharCell ptr c = CellAt( cp, work_page, col - 1, row - 1 )
    if c = nullptr then return 0

    if colorflag = 0 then return c->ch

    if depth <= 4 then
        '' both attributes in one byte, background in the high nibble
        return c->fg + (c->bg shl 4)
    elseif depth <= 8 then
        return c->fg + (c->bg shl 8)
    elseif depth = 16 then
        '' 5-6-5 expanded to 8-8-8 BY BIT REPLICATION, not by shifting alone:
        '' each channel's low bits are refilled from its own high bits so that
        '' full scale maps to 255 rather than 248 or 252. Alpha is forced
        '' opaque. Dropping the replication terms still passes any test whose
        '' colours happen to have zero low bits.
        dim as ulong v = iif( colorflag = 2, c->bg, c->fg )
        return ((v and &h001F) shl 3) or ((v shr 2) and &h7) or _
               ((v and &h07E0) shl 5) or ((v shr 1) and &h300) or _
               ((v and &hF800) shl 8) or ((v shl 3) and &h70000) or _
               &hFF000000
    end if

    return iif( colorflag = 2, c->bg, c->fg )
end function

'' WIDTH w, h -- returns the size held BEFORE the call, packed.
''
'' `changed` reports whether the size actually took effect, which the return
'' value cannot express. A caller that acts on the result must also honour the
'' side effects the reference performs on success: reset the graphics VIEW,
'' reset VIEW PRINT, and clear the screen.
private function CellWidth( _
        byref cp as CellPlane, _
        byval screen_w as long, byval screen_h as long, _
        byval cur_font_w as long, byval cur_font_h as long, _
        byval w as long, byval h as long, _
        byref new_font_w as long, byref new_font_h as long, _
        byref new_w as long, byref new_h as long, _
        byref changed as long ) as ulong

    dim as ulong cur = cast( ulong, cp.text_w ) or (cast( ulong, cp.text_h ) shl 16)
    changed = 0
    new_font_w = cur_font_w
    new_font_h = cur_font_h
    new_w = cp.text_w
    new_h = cp.text_h

    '' pure query
    if (w < 1) andalso (h < 1) then return cur

    dim as long fw, fh
    if w > 0 then
        fw = screen_w \ w
    else
        fw = cur_font_w
        w = cp.text_w
    end if
    if h > 0 then
        fh = screen_h \ h
    else
        fh = cur_font_h
        h = cp.text_h
    end if

    '' Only three fonts exist, all 8 wide. Anything else is a SILENT no-op --
    '' see the header.
    dim as long ok = 0
    if fw = 8 then
        if (fh = 8) orelse (fh = 14) orelse (fh = 16) then ok = 1
    end if
    if ok = 0 then return cur

    new_font_w = fw
    new_font_h = fh
    new_w = w
    new_h = h
    changed = 1
    return cur
end function

'' The cell half of PCOPY / FLIP: the WHOLE page, regardless of the view that
'' clips the pixel copy. See the header.
private function CellPageCopy( _
        byref cp as CellPlane, byval from_page as long, byval to_page as long ) as long

    if (from_page < 0) orelse (from_page >= cp.num_pages) then return 0
    if (to_page < 0) orelse (to_page >= cp.num_pages) then return 0
    if from_page = to_page then return 1
    if (cp.cell(from_page) = nullptr) orelse (cp.cell(to_page) = nullptr) then return 0

    dim as uinteger n = cast( uinteger, cp.text_w ) * cast( uinteger, cp.text_h )
    memcpy( cp.cell(to_page), cp.cell(from_page), n * sizeof( CharCell ) )
    return 1
end function

'' PAGESET's return: the pages held BEFORE the call, work in the low byte and
'' visible in the second. The packing is 8 bits apart here and 16 in WIDTH's --
'' they are not the same convention.
private function CellPageSetResult( _
        byval work_page as long, byval visible_page as long ) as ulong
    return cast( ulong, work_page ) or (cast( ulong, visible_page ) shl 8)
end function

end namespace
