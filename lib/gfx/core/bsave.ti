'' bsave.ti -- the raw BSAVE / BLOAD block format.
''
'' Derived from: gfx_bsave.c (fb_GfxBsaveEx), gfx_bload.c (the 0xFE path).
'' LGPL-2.1-or-later with the static-linking exception.
''
'' THE FORMAT IS FIVE BYTES OF HEADER AND THEN THE BYTES:
''
''   0xFE                    magic, one byte
''   size, 4 bytes           LITTLE-ENDIAN, written a byte at a time
''   size bytes of data
''   [palette]               ONLY when the SCREEN was saved at depth <= 8
''
'' BLOAD dispatches on the FIRST BYTE: 0xFE is this format, 'B' means rewind and
'' parse it as a BMP, anything else is an I/O error. So the magic is a real
'' discriminator, not decoration.
''
'' THE APPENDED PALETTE IS 6-BIT, AND ONLY PRESENT FOR SCREEN SAVES.
'' `color = (device_palette[i] shr 2) and &h3F3F3F` -- the VGA DAC form again,
'' the same one `PALETTE GET i, v` returns. Three bytes per entry, low byte
'' first, so RED FIRST given the palette's own r-low layout. There are
'' `1 shl depth` entries, not 256: a 16-colour mode writes 16.
''
'' Saving an IMAGE writes no palette at all, whatever the depth. That asymmetry
'' is why a loader cannot infer "there is a palette" from the depth alone -- it
'' has to check for remaining bytes, which is what gfxlib2 does with feof().
''
'' NOT HERE: the BMP path, and the SCREEN and palette forms of this one, which
'' are entry/bmpio.ti's -- they need the screen and its palette, which core/ does
'' not see. These two are the buffer-only kernels tools/abtest-bsave.bas checks.

'' NOTE: the parameter is `src_`, not `data` -- DATA is an FB statement keyword
'' and a parameter of that name is an "Illegal specification". Seventh instance
'' of the case-insensitive collision trap in this library.

#pragma once

#include once "palette.ti"

namespace TkoGfx

const BSAVE_MAGIC = &hFE

'' Write a raw BSAVE block. Returns 0 on success.
private function BSaveRaw( _
        byref path as string, byval src_ as any ptr, byval size as ulong ) as long

    if (src_ = 0) andalso (size > 0) then return 1

    dim as long f = freefile
    if open( path, for binary, access write, as #f ) <> 0 then return 1

    dim as ubyte hdr(0 to 4)
    hdr(0) = BSAVE_MAGIC
    hdr(1) = cast( ubyte, size and &hFF )
    hdr(2) = cast( ubyte, (size shr 8) and &hFF )
    hdr(3) = cast( ubyte, (size shr 16) and &hFF )
    hdr(4) = cast( ubyte, (size shr 24) and &hFF )
    dim as ubyte ptr hp = @hdr(0)
    put #f, , *hp, 5

    if size > 0 then
        dim as ubyte ptr p = cptr( ubyte ptr, src_ )
        put #f, , *p, size
    end if

    close #f
    return 0
end function

'' Read a raw BSAVE block into `dest`, copying at most `maxsize` bytes.
'' `got` receives the size recorded in the file, which may exceed maxsize.
'' Returns 0 on success, 1 on I/O failure, 2 if the magic is wrong.
private function BLoadRaw( _
        byref path as string, byval dest as any ptr, byval maxsize as ulong, _
        byref got as ulong ) as long

    got = 0
    dim as long f = freefile
    if open( path, for binary, access read, as #f ) <> 0 then return 1

    dim as ubyte hdr(0 to 4)
    dim as ubyte ptr hp = @hdr(0)
    if get( #f, , *hp, 5 ) <> 0 then
        close #f
        return 1
    end if

    if hdr(0) <> BSAVE_MAGIC then
        close #f
        return 2
    end if

    got = cast( ulong, hdr(1) ) or (cast( ulong, hdr(2) ) shl 8) or _
          (cast( ulong, hdr(3) ) shl 16) or (cast( ulong, hdr(4) ) shl 24)

    dim as ulong n = got
    if n > maxsize then n = maxsize
    if (n > 0) andalso (dest <> 0) then
        dim as ubyte ptr p = cptr( ubyte ptr, dest )
        get #f, , *p, n
    end if

    close #f
    return 0
end function

'' The 6-bit palette block a SCREEN save appends: 1 shl depth entries, three
'' bytes each, red first.
private function BSavePaletteBytes( _
        byref pal as GfxPalette, byval depth as long, byval dest as ubyte ptr ) as long
    if depth > 8 then return 0
    dim as long n = 1 shl depth
    for i as integer = 0 to n - 1
        dim as ulong c = (pal.entry(i) shr 2) and &h3F3F3F
        dest[i*3]     = cast( ubyte, c and &hFF )
        dest[i*3 + 1] = cast( ubyte, (c shr 8) and &hFF )
        dest[i*3 + 2] = cast( ubyte, (c shr 16) and &hFF )
    next
    return n * 3
end function

end namespace
