'' entry/image.ti -- IMAGECREATE, GET and PUT.
''
'' ORIGINAL WORK. Part of libtkogfx: LGPL-2.1-or-later with the static-linking
'' exception.
''
'' MEASURED. graphics-abi.md records GET and PUT; IMAGECREATE's two spellings
'' were probed for this file:
''
''     imagecreate( 16, 16 )              fb_GfxImageCreate( 16,16, 0u, 0, &h80000000 )
''     imagecreate( 16, 16, col, 32 )     fb_GfxImageCreate( 16,16, col, 32, 0 )
''
'' and under -lang fblite or -lang deprecated the SAME call with the SAME
'' arguments becomes fb_GfxImageCreateQB. So the QB form is a dialect's name for
'' one function, not a different one -- which is why it is a forwarder below
'' rather than a copy.
''
'' A DEPTH OF 0 MEANS "THE SCREEN'S", and the depth argument is in BITS while
'' Surface.bpp is in BYTES. Conflating them makes a 32bpp image four pixels
'' wide where it should be one.

#pragma once

namespace TkoGfx

'' Lay a header into a buffer the CALLER owns -- which is what GET does, and the
'' one case core/image.ti's allocator cannot serve.
private sub ImageHeaderWrite( byval img as TkoAbi.PUT_HEADER ptr, _
        byval w as long, byval h as long, byval bpp as long, byval pitch as long )
    img->htype  = TkoAbi.PUT_HEADER_NEW
    img->bpp    = bpp
    img->width  = w
    img->height = h
    img->pitch  = pitch
    img->tex    = 0
    for i as integer = 0 to 7
        img->reserved(i) = 0
    next
end sub

'' The screen's bytes-per-pixel, for a depth argument of 0. Four, always, until
'' paletted framebuffers land -- see entry/context.ti.
private function ScreenBpp( ) as long
    if TheScreen.isOpen then return ScreenCtx.surf.bpp
    return 4
end function

'' PUT's source rectangle sentinel: all four default to -65536, meaning "the
'' whole image". No 1.10.1 syntax was found that sets them.
const PUT_SRCRECT_ALL = -65536

'' PUT modes, measured. Note ALPHA and ALPHA-WITH-A-VALUE are DIFFERENT MODES.
const PUTMODE_TRANS  = 0
const PUTMODE_PSET   = 1
const PUTMODE_PRESET = 2
const PUTMODE_AND    = 3
const PUTMODE_OR     = 4
const PUTMODE_XOR    = 5
const PUTMODE_ALPHA  = 6
const PUTMODE_CUSTOM = 8
const PUTMODE_BLEND  = 9

end namespace

extern "c"

'' IMAGECREATE( w, h [, colour [, depth ]] )
''
'' Returns the header, or NULL. The pixels are filled with `colour` unless it
'' was defaulted, in which case they are the TRANSPARENT (mask) colour of the
'' image's depth -- gfx_image.c: 0 at 8bpp, MASK_COLOR_16 (&hF81F) at 16, and
'' MASK_COLOR_32 or MASK_A_32 (&hFFFF00FF) at 32. Measured, fbc's fresh 32-bit
'' image reads &hFFFF00FF through POINT. This used to ZERO it, on the claim that
'' zero was what made a fresh image vanish under TRANS -- it is the other way
'' round: zero is opaque black to TRANS, so a full-screen overlay built the
'' usual way (imagecreate, draw a frame, PUT ..., TRANS) blacked out everything
'' under it. starshine.bas's whole animation was hidden that way.
''
'' NOT gfxlib2's FILL. Its imagecreate calls pixel_set with a count derived from
'' the NEW image's bpp and a routine bound to the LAST DRAWING TARGET's, so an
'' image of a different depth than the last thing drawn is under-filled -- 173
'' of 1920 bytes left stale, measured in tools/abtest-bpp.bas, and a heap
'' overrun in the 32-into-16 direction. This fills the buffer it just allocated,
'' at the depth it just chose -- every byte of every row, padding included.
function TkoGfxImageCreate alias "fb_GfxImageCreate" ( _
        byval w as long, byval h as long, _
        byval colour as ulong, _
        byval depth as long, _
        byval flags as long ) as any ptr

    if (w <= 0) orelse (h <= 0) then return nullptr

    dim as long bpp
    select case depth
    case 0  : bpp = TkoGfx.ScreenBpp( )
    case 8  : bpp = 1
    case 15, 16 : bpp = 2
    case 24, 32 : bpp = 4
    case else : return nullptr
    end select

    dim as TkoAbi.PUT_HEADER ptr img = TkoGfx.TkoImageNew( w, h, bpp )
    if img = nullptr then return nullptr

    dim as ubyte ptr px = TkoGfx.TkoImagePixels( img )
    dim as long pitch = img->pitch

    dim as ulong fill = colour
    if (flags and TkoGfx.COORD_COLOR_DEF) <> 0 then
        select case bpp
        case 1    : fill = 0
        case 2    : fill = &hF81F
        case else : fill = &hFFFF00FF
        end select
    end if

    '' THE WHOLE PITCH, padding included: gfxlib2 fills (pitch * h) / bpp pixels,
    '' so an 8bpp image's row padding holds the colour too -- and BSAVE copies it
    '' into the file, where a byte-for-byte A/B saw it. Filled at the image's OWN
    '' depth, which is the part of gfxlib2's fill this still does not copy.
    dim as long perRow = pitch \ bpp
    for y as integer = 0 to h - 1
        select case bpp
        case 1
            dim as ubyte ptr r = px + y * pitch
            for x as integer = 0 to perRow - 1 : r[x] = cast( ubyte, fill ) : next
        case 2
            dim as ushort ptr r = cptr( ushort ptr, px + y * pitch )
            for x as integer = 0 to perRow - 1 : r[x] = cast( ushort, fill ) : next
        case else
            dim as ulong ptr r = cptr( ulong ptr, px + y * pitch )
            for x as integer = 0 to perRow - 1 : r[x] = fill : next
        end select
    next

    return img
end function

'' The fblite / deprecated dialects' name for exactly the same call, measured.
function TkoGfxImageCreateQB alias "fb_GfxImageCreateQB" ( _
        byval w as long, byval h as long, _
        byval colour as ulong, _
        byval depth as long, _
        byval flags as long ) as any ptr
    return TkoGfxImageCreate( w, h, colour, depth, flags )
end function

'' IMAGEDESTROY( image )
''
'' NOT IN src/mir/rtl.ti -- tiko has no RTL entry for it -- but fbc emits it and
'' a program that cannot free an image is not a program. Added because the smoke
'' test could not link without it, which is the useful kind of discovery.
''
'' IT IS ALSO THE ONLY PLACE THE CONTEXT CACHE CAN BE TOLD. entry/context.ti
'' defends against a recycled address by comparing the header, which is enough
'' on its own; dropping the entry here means the defence is never even reached
'' for the ordinary destroy-then-create case. gfxlib2 is the counter-example --
'' its IMAGEDESTROY never clears last_target, which is the whole aliasing
'' defect.
sub TkoGfxImageDestroy alias "fb_GfxImageDestroy" ( byval img as any ptr )
    if img = nullptr then exit sub
    TkoGfx.ContextForget( img )
    TkoGfx.TkoImageFree( cptr( TkoAbi.PUT_HEADER ptr, img ) )
end sub

'' GET (x1,y1)-(x2,y2), dest
''
'' (target, x1, y1, x2, y2, dest, flags, array) -> 0 or an error number.
''
'' Flags are convention A, NOT B -- GET is a two-point statement.
''
'' THE ARRAY DESCRIPTOR IS ADVISORY. When the destination is an array element
'' fbc materialises a whole descriptor and passes its address; for a plain
'' pointer it is NULL. It is the only bound available, and with NULL there is
'' none -- a caller who under-sizes a plain buffer is not detectable here, and
'' is not detectable in fbc either.
function TkoGfxGet alias "fb_GfxGet" ( _
        byval target as any ptr, _
        byval fx1 as single, byval fy1 as single, _
        byval fx2 as single, byval fy2 as single, _
        byval dest as any ptr, _
        byval flags as long, _
        byval arr as any ptr ) as long

    dim as TkoGfx.GfxContext ptr c = TkoGfx.ContextFor( target )
    if (c = nullptr) orelse (dest = nullptr) then return FB_RTERROR_ILLEGALFUNCTIONCALL

    dim as long x1, y1, x2, y2
    TkoGfx.CoordA( *c, fx1, fy1, fx2, fy2, flags, x1, y1, x2, y2 )
    if x1 > x2 then swap x1, x2
    if y1 > y2 then swap y1, y2

    '' Clipped to the surface, as gfxlib2 does: a GET partly off-screen returns
    '' the part that exists rather than failing.
    if x1 < 0 then x1 = 0
    if y1 < 0 then y1 = 0
    if x2 >= c->surf.w then x2 = c->surf.w - 1
    if y2 >= c->surf.h then y2 = c->surf.h - 1
    if (x1 > x2) orelse (y1 > y2) then return FB_RTERROR_ILLEGALFUNCTIONCALL

    dim as long w = x2 - x1 + 1
    dim as long h = y2 - y1 + 1
    dim as long bpp = c->surf.bpp
    dim as long pitch = TkoGfx.ImagePitch( w, bpp )

    if arr <> nullptr then
        '' The descriptor's byte size is the one real bound there is.
        dim as TkoAbi.FBARRAY ptr a = cptr( TkoAbi.FBARRAY ptr, arr )
        if a->size < (cast( integer, pitch ) * h + TkoGfx.IMAGE_HEADER_SIZE) then
            return FB_RTERROR_ILLEGALFUNCTIONCALL
        end if
    end if

    dim as TkoAbi.PUT_HEADER ptr img = cptr( TkoAbi.PUT_HEADER ptr, dest )
    TkoGfx.ImageHeaderWrite( img, w, h, bpp, pitch )

    dim as ubyte ptr dpx = cptr( ubyte ptr, dest ) + TkoGfx.IMAGE_HEADER_SIZE
    for y as integer = 0 to h - 1
        dim as ubyte ptr src = TkoGfx.SurfaceRowAddr( c->surf, y1 + y ) + x1 * bpp
        memcpy( dpx + y * pitch, src, w * bpp )
    next

    return 0
end function

'' PUT (x,y), src, mode
''
'' (target, x, y, src, sx1, sy1, sx2, sy2, coordflags, mode, blender, alpha,
''  customproc, customparam) -> 0 or an error number.
''
'' THE DEFAULT MODE IS XOR (5), NOT TRANS. Measured, and it is the opposite of
'' what the manual's ordering suggests.
''
'' The blender pointer fbc passes is IGNORED except for CUSTOM. Every other mode
'' names one of our own fb_hPut* symbols, and calling back out through a pointer
'' to reach a routine in this same archive buys nothing and loses the bpp
'' dispatch. CUSTOM is different: there the pointer is USER CODE and is the
'' whole point.
function TkoGfxPut alias "fb_GfxPut" ( _
        byval target as any ptr, _
        byval fx as single, byval fy as single, _
        byval src as any ptr, _
        byval sx1 as long, byval sy1 as long, _
        byval sx2 as long, byval sy2 as long, _
        byval flags as long, _
        byval mode as long, _
        byval blender as any ptr, _
        byval alpha as long, _
        byval customproc as any ptr, _
        byval customparam as any ptr ) as long

    scope : dim as any ptr ignored = blender : end scope

    dim as TkoGfx.GfxContext ptr c = TkoGfx.ContextFor( target )
    if (c = nullptr) orelse (src = nullptr) then return FB_RTERROR_ILLEGALFUNCTIONCALL

    dim as long sw, sh, sbpp, spitch, ssize
    dim as any ptr spx
    if TkoGfx.TkoImageQuery( cptr( TkoAbi.PUT_HEADER ptr, src ), _
                             sw, sh, sbpp, spitch, spx, ssize ) <> 0 then
        return FB_RTERROR_ILLEGALFUNCTIONCALL
    end if

    '' A source of a different depth than the destination is not convertible
    '' here -- IMAGECONVERTROW is the statement for that -- and silently
    '' blitting one over the other is how the stale-target defect looked.
    if sbpp <> c->surf.bpp then return FB_RTERROR_ILLEGALFUNCTIONCALL

    '' PUT is CONVENTION A with one point, so its STEP is bit 1, not bit 0. See
    '' CoordPut in entry/context.ti for the measurement.
    dim as long dx, dy
    TkoGfx.CoordPut( *c, fx, fy, flags, dx, dy )

    '' The source rectangle, defaulting to the whole image.
    dim as long rx1 = sx1, ry1 = sy1, rx2 = sx2, ry2 = sy2
    if rx1 = TkoGfx.PUT_SRCRECT_ALL then rx1 = 0
    if ry1 = TkoGfx.PUT_SRCRECT_ALL then ry1 = 0
    if rx2 = TkoGfx.PUT_SRCRECT_ALL then rx2 = sw - 1
    if ry2 = TkoGfx.PUT_SRCRECT_ALL then ry2 = sh - 1
    if rx1 > rx2 then swap rx1, rx2
    if ry1 > ry2 then swap ry1, ry2
    if rx1 < 0 then rx1 = 0
    if ry1 < 0 then ry1 = 0
    if rx2 >= sw then rx2 = sw - 1
    if ry2 >= sh then ry2 = sh - 1
    if (rx1 > rx2) orelse (ry1 > ry2) then return FB_RTERROR_ILLEGALFUNCTIONCALL

    '' Clip the DESTINATION rectangle, trimming the source to match rather than
    '' letting a partly off-screen PUT write outside the surface.
    dim as long w = rx2 - rx1 + 1
    dim as long h = ry2 - ry1 + 1

    if dx < 0 then
        rx1 -= dx : w += dx : dx = 0
    end if
    if dy < 0 then
        ry1 -= dy : h += dy : dy = 0
    end if
    if dx + w > c->surf.w then w = c->surf.w - dx
    if dy + h > c->surf.h then h = c->surf.h - dy
    if (w <= 0) orelse (h <= 0) then return 0

    dim as ubyte ptr sp = cptr( ubyte ptr, spx ) + ry1 * spitch + rx1 * sbpp
    dim as ubyte ptr dp = TkoGfx.SurfaceRowAddr( c->surf, dy ) + dx * c->surf.bpp

    '' The blenders take the destination depth from here -- the ABI has no room
    '' for it as a parameter. See entry/putblend.ti.
    TkoGfx.PutBlendBpp = c->surf.bpp

    '' The bitwise modes are bytewise, so a narrow destination is blitted as
    '' (w * bpp) \ 4 dwords. Measured in tools/abtest-putbpp.bas.
    dim as long dwords = (w * c->surf.bpp) \ 4

    select case mode
    case TkoGfx.PUTMODE_TRANS
        TkoPutTrans( sp, dp, w, h, spitch, c->surf.pitch, 0, nullptr, nullptr )
    case TkoGfx.PUTMODE_PSET
        TkoPutPSet( sp, dp, w, h, spitch, c->surf.pitch, 0, nullptr, nullptr )
    case TkoGfx.PUTMODE_PRESET
        TkoPutPReset( sp, dp, dwords, h, spitch, c->surf.pitch, 0, nullptr, nullptr )
    case TkoGfx.PUTMODE_AND
        TkoPutAnd( sp, dp, dwords, h, spitch, c->surf.pitch, 0, nullptr, nullptr )
    case TkoGfx.PUTMODE_OR
        TkoPutOr( sp, dp, dwords, h, spitch, c->surf.pitch, 0, nullptr, nullptr )
    case TkoGfx.PUTMODE_XOR
        TkoPutXor( sp, dp, dwords, h, spitch, c->surf.pitch, 0, nullptr, nullptr )
    case TkoGfx.PUTMODE_ALPHA
        TkoPutAlpha( sp, dp, w, h, spitch, c->surf.pitch, 0, nullptr, nullptr )
    case TkoGfx.PUTMODE_BLEND
        TkoPutBlend( sp, dp, w, h, spitch, c->surf.pitch, alpha, nullptr, nullptr )
    case TkoGfx.PUTMODE_CUSTOM
        if customproc = nullptr then return FB_RTERROR_ILLEGALFUNCTIONCALL
        TkoPutCustom( sp, dp, w, h, spitch, c->surf.pitch, 0, customproc, customparam )
    case else
        return FB_RTERROR_ILLEGALFUNCTIONCALL
    end select

    TkoGfx.DirtyMark( c->surf, dy, h )
    return 0
end function

end extern
