'' entry/bmpio.ti -- BLOAD and BSAVE: the BMP reader, the BMP writer, and the SCREEN
'' forms of the raw block.
''
'' Derived from: gfx_bload.c (load_bmp, gfx_bload), gfx_bsave.c (save_bmp,
'' fb_GfxBsaveEx). LGPL-2.1-or-later with the static-linking exception.
''
'' Until this file, BLOAD read only a raw block into a buffer and BSAVE wrote only
'' a raw block or an IMAGE as a BMP: `bload "picture.bmp"`, `bload f, img`,
'' `bload f, , @pal(0)` and `bsave "shot.bmp", 0` -- four of the FreeBASIC help's
'' six BLOAD/BSAVE examples -- all returned an error. Each path below is gfxlib2's,
'' A/B'd against it byte for byte (files) and hash for hash (framebuffer, palette).
''
'' THE C LIBRARY'S OWN STDIO, not FB file I/O. Three behaviours depend on it:
''
''   - fopen "wb" TRUNCATES. FB's `open ... for binary` does not, so a second
''     BSAVE over a longer file left the tail of the first one behind.
''   - feof() is set only by a read that RAN OUT, not by one that ended exactly at
''     the end. BLOAD of a raw block into the screen reads the palette whenever
''     feof() is still clear -- so a block with no palette after it still "reads"
''     one, entirely from fgetc's -1, and the screen's palette becomes &hFCFCFC.
''     Measured; reproduced.
''   - fread( p, 0, 1, f ) returns 0, which BLOAD and BSAVE both read as a failed
''     read: a zero-size raw block is TkoAbi.FB_RTERROR_FILEIO.
''
'' THE PALETTE HAS THREE SPELLINGS HERE, and each path uses the one gfxlib2 does:
''
''   device      r or (g shl 8) or (b shl 16), 8 bits a channel -- GfxPalette.entry
''   caller's    the same layout at 6 bits a channel, 32 bits an entry, whatever
''               the array was declared as: `dim pal(255) as integer` receives
''               two entries per element on a 64-bit target, as it does in fbc
''   in a file   BMP: blue, green, red, 0.  Raw block: red, green, blue, 6-bit.
''
'' THE QUIRKS KEPT, because a program sees them:
''
''   - BSAVE with a caller's palette writes the BMP's red into the BLUE slot and
''     blue into red (save_bmp's paltmp shifts). BLOAD of that file swaps back
''     only if it also goes through a caller's palette.
''   - An 8-bit BMP loaded onto a truecolour target converts through the DEVICE
''     palette. Without a caller's palette the file's palette is copied into the
''     device first, so the colours are the file's; with one, the device palette
''     is untouched and the colours are whatever the screen had.
''   - RLE8 and RLE4 BMPs are accepted and read as if uncompressed.
''   - A 32-bit BITFIELDS BMP with a 40-byte header has no alpha mask, so every
''     pixel loads with alpha 0.
''   - A raw-block load onto a 32bpp screen reads ONE palette entry: `1 shl 32` is
''     1 on x86, where the shift count is masked to five bits. Deeper ones are
''     capped at 256 here -- gfxlib2 writes 65536 entries into a 256-entry array
''     for a 16bpp screen, and that overrun is not reproduced.
''
'' NOT PORTED: fb_GfxBloadQB (the old-header form) and fb_GfxBsaveEx's bits-per-
'' pixel argument, neither of which tiko emits. Where gfxlib2 dereferences a NULL
'' screen -- BSAVE of the screen with none open -- this returns
'' TkoAbi.FB_RTERROR_ILLEGALFUNCTIONCALL instead of faulting.

#pragma once

#include once "crt/stdio.bi"
#include once "crt/string.bi"

namespace TkoGfx

const BL_BI_RGB       = 0
const BL_BI_BITFIELDS = 3

'' Bytes per pixel of a BMP bit count: 1, 4 and 8 all read a byte at a time.
private function BlBytesPer( byval bc as long ) as long
    return (bc + 7) shr 3
end function

private function BlRead16( byval f as FILE ptr, byref v as ulong ) as long
    dim as ushort t = 0
    if fread( @t, 2, 1, f ) = 0 then return 0
    v = t
    return 1
end function

private function BlRead32( byval f as FILE ptr, byref v as ulong ) as long
    dim as ulong t = 0
    if fread( @t, 4, 1, f ) = 0 then return 0
    v = t
    return 1
end function

'' CONVERT_DEPTH. The C shifts right by `2 * from - to`, which is NEGATIVE for a
'' field narrower than half its target; x86 masks the count to five bits, so this
'' does too rather than handing LLVM a shift it may treat as poison.
private function BlDepth( byval c as ulong, byval from_ as long, byval to_ as long ) as ulong
    if from_ <= to_ then
        return (c shl (to_ - from_)) or (c shr ((2 * from_ - to_) and 31))
    end if
    return c shr (from_ - to_)
end function

'' The bitfield converters. `kind` is the source width in BYTES (2, 3 or 4) and
'' `dbpp` the destination's (2 or 4).
private sub BlConvertBf( _
        byval src as ubyte ptr, byval dst as ubyte ptr, byval w as long, _
        byval kind as long, byval dbpp as long, _
        masks() as ulong, shifts() as long, bits() as long )

    for x as long = 0 to w - 1
        dim as ulong c
        select case kind
        case 2 : c = cptr( ushort ptr, src )[x]
        case 3 : c = src[x * 3] or (cast( ulong, src[x * 3 + 1] ) shl 8) or (cast( ulong, src[x * 3 + 2] ) shl 16)
        case else : c = cptr( ulong ptr, src )[x]
        end select
        dim as ulong r = (c shr shifts(0)) and masks(0)
        dim as ulong g = (c shr shifts(1)) and masks(1)
        dim as ulong b = (c shr shifts(2)) and masks(2)
        if dbpp = 2 then
            r = BlDepth( r, bits(0), 5 )
            g = BlDepth( g, bits(1), 6 )
            b = BlDepth( b, bits(2), 5 )
            cptr( ushort ptr, dst )[x] = cast( ushort, (r shl 11) or (g shl 5) or b )
        else
            r = BlDepth( r, bits(0), 8 )
            g = BlDepth( g, bits(1), 8 )
            b = BlDepth( b, bits(2), 8 )
            dim as ulong a = &hFF
            '' Only the 32-bit source carries alpha, and only through its mask:
            '' no mask reads alpha 0, not opaque.
            if kind = 4 then
                a = (c shr shifts(3)) and masks(3)
                if masks(3) then a = BlDepth( a, bits(3), 8 )
            end if
            cptr( ulong ptr, dst )[x] = (a shl 24) or (r shl 16) or (g shl 8) or b
        end if
    next
end sub

'' The colour mask an 8-bit converter applies on an 8-bit target: the screen's,
'' as IMAGECONVERTROW computes it (entry/info.ti).
private function BlColorMask( ) as ulong
    select case TheScreen.depth
    case 16    : return &hFFFF
    case 32    : return &hFFFFFFFFul
    case else  : return (1 shl TheScreen.depth) - 1
    end select
end function

'' load_bmp. `f` is positioned at the start; `pal` is the caller's array or NULL.
private function BlLoadBmp( _
        byval f as FILE ptr, byval dest as any ptr, byval pal as ulong ptr ) as long

    if TheScreen.isOpen = 0 then return TkoAbi.FB_RTERROR_ILLEGALFUNCTIONCALL

    dim as ulong bfType, bfSize, bfRes1, bfRes2, bfOffBits, biSize
    dim as ulong t16, t32
    dim as long biWidth, biHeight
    dim as ulong biPlanes, biBitCount, biCompression = BL_BI_RGB, biSizeImage = 0
    dim as ulong bfmask(0 to 3)
    bfmask(3) = 0

    if (BlRead16( f, bfType ) = 0) orelse (BlRead32( f, bfSize ) = 0) orelse _
       (BlRead16( f, bfRes1 ) = 0) orelse (BlRead16( f, bfRes2 ) = 0) orelse _
       (BlRead32( f, bfOffBits ) = 0) orelse (BlRead32( f, biSize ) = 0) then
        return TkoAbi.FB_RTERROR_FILEIO
    end if

    select case biSize
    case 12, 40, 56, 108, 124
    case else
        return TkoAbi.FB_RTERROR_FILEIO
    end select

    if biSize = 12 then
        '' OS/2 V1: 16-bit width and height
        dim as ulong bcw, bch
        if (BlRead16( f, bcw ) = 0) orelse (BlRead16( f, bch ) = 0) orelse _
           (BlRead16( f, biPlanes ) = 0) orelse (BlRead16( f, biBitCount ) = 0) then
            return TkoAbi.FB_RTERROR_FILEIO
        end if
        biWidth = bcw
        biHeight = bch
    else
        if (BlRead32( f, t32 ) = 0) then return TkoAbi.FB_RTERROR_FILEIO
        biWidth = cast( long, t32 )
        if (BlRead32( f, t32 ) = 0) then return TkoAbi.FB_RTERROR_FILEIO
        biHeight = cast( long, t32 )
        if (BlRead16( f, biPlanes ) = 0) orelse (BlRead16( f, biBitCount ) = 0) then
            return TkoAbi.FB_RTERROR_FILEIO
        end if
        if biSize >= 20 then
            if BlRead32( f, biCompression ) = 0 then return TkoAbi.FB_RTERROR_FILEIO
            if biSize >= 24 then
                if BlRead32( f, biSizeImage ) = 0 then return TkoAbi.FB_RTERROR_FILEIO
                if biSize >= 56 then
                    '' V3 and later carry the masks in the header itself
                    if fseek( f, 4 * 4, SEEK_CUR ) <> 0 then return TkoAbi.FB_RTERROR_FILEIO
                    for i as long = 0 to 3
                        if BlRead32( f, bfmask(i) ) = 0 then return TkoAbi.FB_RTERROR_FILEIO
                    next
                end if
            end if
        end if
    end if

    if (bfType <> 19778) orelse (biPlanes > 1) orelse (biWidth <= 0) orelse _
       (biHeight = 0) orelse (biCompression > BL_BI_BITFIELDS) then
        return TkoAbi.FB_RTERROR_FILEIO
    end if

    dim as boolean flipped = false
    if biHeight < 0 then
        if (biCompression <> BL_BI_RGB) andalso (biCompression <> BL_BI_BITFIELDS) then
            return TkoAbi.FB_RTERROR_FILEIO
        end if
        flipped = true
        biHeight = -biHeight
    end if

    if bfOffBits = 0 then
        bfOffBits = biSize + 14
        if biBitCount <= 8 then bfOffBits += (1 shl biBitCount)
    end if

    fseek( f, biSize + 14, SEEK_SET )

    '' The palette, into a local first: where it goes is decided later.
    dim as ulong ptab(0 to 255)
    dim as long palette_entries = 0
    if biBitCount <= 8 then
        dim as long entry_size = iif( biSize = 12, 3, 4 )
        palette_entries = 1 shl biBitCount
        for i as long = 0 to palette_entries - 1
            '' Three separate reads, in order: blue, green, red.
            dim as long cb = fgetc( f )
            dim as long cg = fgetc( f )
            dim as long cr = fgetc( f )
            ptab(i) = cast( ulong, (cb shl 16) or (cg shl 8) or cr )
            if pal then ptab(i) = (ptab(i) shr 2) and &h3F3F3F
            if entry_size = 4 then fgetc( f )
        next
    end if

    '' Where the pixels go: the screen's work page, or an image.
    dim as long width_, height_, bpp
    dim as ubyte ptr base_
    dim as long pitch
    if dest then
        dim as TkoAbi.PUT_HEADER ptr hdr = cptr( TkoAbi.PUT_HEADER ptr, dest )
        if hdr->htype = TkoAbi.PUT_HEADER_NEW then
            width_  = iif( cast( long, hdr->width ) < biWidth, cast( long, hdr->width ), biWidth )
            height_ = iif( cast( long, hdr->height ) < biHeight, cast( long, hdr->height ), biHeight )
            bpp = hdr->bpp
            base_ = cptr( ubyte ptr, dest ) + IMAGE_HEADER_SIZE
            pitch = hdr->pitch
        else
            '' THE OLD 4-BYTE HEADER: bpp:3, width:13, height:16. A buffer that holds
            '' neither -- a zeroed ubyte array, the usual case -- is GIVEN a new
            '' header, at the screen's depth and the file's size.
            dim as ulong oh = hdr->htype
            dim as long obpp = oh and 7
            dim as long ow = (oh shr 3) and &h1FFF
            dim as long oht = (oh shr 16) and &hFFFF
            if (obpp = 1) orelse (obpp = 2) orelse (obpp = 4) then
                width_  = iif( ow < biWidth, ow, biWidth )
                height_ = iif( oht < biHeight, oht, biHeight )
                bpp = obpp
                base_ = cptr( ubyte ptr, dest ) + 4
                pitch = ow * obpp
            else
                hdr->htype  = TkoAbi.PUT_HEADER_NEW
                hdr->bpp    = ScreenCtx.surf.bpp
                hdr->width  = biWidth
                hdr->height = biHeight
                hdr->pitch  = ((hdr->width * hdr->bpp) + &hF) and (not &hF)
                width_  = biWidth
                height_ = biHeight
                bpp = hdr->bpp
                base_ = cptr( ubyte ptr, dest ) + IMAGE_HEADER_SIZE
                pitch = hdr->pitch
            end if
        end if
    else
        width_  = iif( ScreenCtx.surf.w < biWidth, ScreenCtx.surf.w, biWidth )
        height_ = iif( ScreenCtx.surf.h < biHeight, ScreenCtx.surf.h, biHeight )
        bpp = ScreenCtx.surf.bpp
        base_ = ScreenCtx.surf.pixels
        pitch = ScreenCtx.surf.pitch
    end if

    dim as long expand = iif( biBitCount < 8, cast( long, biBitCount ), 0 )
    if biCompression = BL_BI_BITFIELDS then
        if biSize < 56 then
            if fread( @bfmask(0), 12, 1, f ) = 0 then return TkoAbi.FB_RTERROR_FILEIO
        end if
    elseif biBitCount <= 16 then
        bfmask(0) = &h7C00
        bfmask(1) = &h3E0
        bfmask(2) = &h1F
    else
        bfmask(0) = &hFF0000
        bfmask(1) = &hFF00
        bfmask(2) = &hFF
        bfmask(3) = &hFF000000ul
    end if

    '' Which converter. 0: none (a refusal), 1: from 8 bits, 2..4: bitfields
    '' from that many bytes.
    dim as long kind = 0
    if biBitCount <= 8 then
        kind = 1
    elseif biBitCount <= 32 then
        if bpp = 1 then return TkoAbi.FB_RTERROR_ILLEGALFUNCTIONCALL
        kind = BlBytesPer( biBitCount )
    else
        return TkoAbi.FB_RTERROR_FILEIO
    end if

    dim as ulong masks(0 to 3)
    dim as long shifts(0 to 3), bits(0 to 3)
    for i as long = 0 to 3
        masks(i) = bfmask(i)
        if masks(i) then
            while ((not masks(i)) and 1) <> 0
                shifts(i) += 1
                masks(i) shr= 1
            wend
            while masks(i) <> 0
                bits(i) += 1
                masks(i) shr= 1
            wend
            masks(i) = bfmask(i) shr shifts(i)
        end if
    next

    dim as long result = TkoAbi.FB_RTERROR_OK
    WindowLock( TheScreen.wnd )

    '' The palette lands BEFORE any pixel converts, so an 8-bit file onto a
    '' truecolour target uses its own colours when there is no caller's array.
    dim as GfxPalette ptr dp = PaletteCurrent( )
    if pal then
        for i as long = 0 to palette_entries - 1 : pal[i] = ptab(i) : next
    elseif dp <> 0 then
        for i as long = 0 to palette_entries - 1 : dp->entry(i) = ptab(i) : next
        PaletteLutRebuild( )
    end if

    dim as long size = ((biWidth * BlBytesPer( biBitCount )) + 3) and (not 3)
    dim as ubyte ptr buffer = callocate( size + 1 )
    dim as long padding
    select case expand
    case 1 : padding = 4 - (((biWidth + 7) shr 3) and 3)
    case 4 : padding = 4 - (((biWidth + 1) shr 1) and 3)
    case else : padding = 4 - ((biWidth * BlBytesPer( biBitCount )) and 3)
    end select
    padding and= 3
    fseek( f, bfOffBits, SEEK_SET )

    dim as ulong cmask = BlColorMask( )
    dim as long i = iif( flipped, 0, biHeight - 1 )
    while iif( flipped, i < biHeight, i >= 0 )
        if expand then
            dim as long colour = 0
            for j as long = 0 to biWidth - 1
                if (j mod (8 \ expand)) = 0 then
                    colour = fgetc( f )
                    if colour < 0 then
                        result = TkoAbi.FB_RTERROR_FILEIO
                        exit while
                    end if
                end if
                buffer[j] = cast( ubyte, colour shr (8 - expand) )
                colour = (colour shl expand) and &hFF
            next
            for j as long = 0 to padding - 1 : fgetc( f ) : next
        elseif fread( buffer, size, 1, f ) = 0 then
            result = TkoAbi.FB_RTERROR_FILEIO
            exit while
        end if
        if i < height_ then
            dim as ubyte ptr row = base_ + cast( integer, i ) * pitch
            if kind = 1 then
                select case bpp
                case 1 : Convert8to8( buffer, row, width_, cmask )
                case 2 : if dp then Convert8to16( buffer, cptr( ushort ptr, row ), width_, *dp )
                case else : if dp then Convert8to32( buffer, cptr( ulong ptr, row ), width_, *dp )
                end select
            else
                BlConvertBf( buffer, row, width_, kind, iif( bpp = 2, 2, 4 ), masks(), shifts(), bits() )
            end if
        end if
        i += iif( flipped, 1, -1 )
    wend

    '' SET_DIRTY( ctx, 0, h ): a no-op for an image, and for a hidden page.
    if dest = 0 then DirtyMark( ScreenCtx.surf, 0, ScreenCtx.surf.h )
    WindowUnlock( TheScreen.wnd )
    deallocate( buffer )
    return result
end function

'' gfx_bload.
private function BlLoad( byref fn as string, byval dest as any ptr, byval pal as ulong ptr ) as long
    RtlErrorSetNum( TkoAbi.FB_RTERROR_OK )
    if (dest = 0) andalso (TheScreen.isOpen = 0) then
        RtlErrorSetNum( TkoAbi.FB_RTERROR_ILLEGALFUNCTIONCALL )
        return TkoAbi.FB_RTERROR_ILLEGALFUNCTIONCALL
    end if

    dim as FILE ptr f = fopen( fn, "rb" )
    if f = 0 then
        RtlErrorSetNum( TkoAbi.FB_RTERROR_FILENOTFOUND )
        return TkoAbi.FB_RTERROR_FILENOTFOUND
    end if

    dim as long result = TkoAbi.FB_RTERROR_OK
    dim as ulong size = 0
    dim as long id = fgetc( f ) and &hFF
    select case id
    case &hFD
        '' QB's block: four bytes of segment and offset, then a 16-bit size
        fgetc( f ) : fgetc( f ) : fgetc( f ) : fgetc( f )
        dim as long lo = fgetc( f )
        dim as long hi = fgetc( f )
        size = cast( ulong, lo or (hi shl 8) )
    case &hFE
        dim as long b0 = fgetc( f )
        dim as long b1 = fgetc( f )
        dim as long b2 = fgetc( f )
        dim as long b3 = fgetc( f )
        size = cast( ulong, b0 or (b1 shl 8) or (b2 shl 16) or (b3 shl 24) )
    case asc( "B" )
        '' A BMP -- and its result is returned WITHOUT setting ERR, which stays 0.
        rewind( f )
        result = BlLoadBmp( f, dest, pal )
        fclose( f )
        return result
    case else
        result = TkoAbi.FB_RTERROR_FILEIO
    end select

    if result = TkoAbi.FB_RTERROR_OK then
        if dest = 0 then
            WindowLock( TheScreen.wnd )
            dim as ulong cap = cast( ulong, ScreenCtx.surf.pitch * ScreenCtx.surf.h )
            if size > cap then size = cap
            if (fread( ScreenCtx.surf.pixels, size, 1, f ) = 0) andalso (feof( f ) = 0) then
                result = TkoAbi.FB_RTERROR_FILEIO
            end if
            DirtyMark( ScreenCtx.surf, 0, ScreenCtx.surf.h )
            if feof( f ) = 0 then
                '' See the file header: this runs for a block with no palette too.
                dim as long n = 1 shl (TheScreen.depth and 31)
                if n > 256 then n = 256
                dim as GfxPalette ptr dp = PaletteCurrent( )
                for i as long = 0 to n - 1
                    dim as long c0 = fgetc( f )
                    dim as long c1 = fgetc( f )
                    dim as long c2 = fgetc( f )
                    dim as ulong colour = cast( ulong, c0 or (c1 shl 8) or (c2 shl 16) )
                    if pal then
                        pal[i] = colour
                    elseif dp then
                        dp->entry(i) = (colour shl 2) and &hFCFCFC
                    end if
                next
                if (pal = 0) andalso (dp <> 0) then PaletteLutRebuild( )
            end if
            WindowUnlock( TheScreen.wnd )
        else
            if (fread( dest, size, 1, f ) = 0) andalso (feof( f ) = 0) then
                result = TkoAbi.FB_RTERROR_FILEIO
            end if
        end if
    end if
    fclose( f )
    RtlErrorSetNum( result )
    return result
end function

private sub BlPutLE( byval p as ubyte ptr, byval at as long, byval v as ulong, byval n as long )
    for k as long = 0 to n - 1
        p[at + k] = cast( ubyte, (v shr (8 * k)) and &hFF )
    next
end sub

'' save_bmp. `src` is an image or NULL for the screen; `pal` the caller's 6-bit
'' array or NULL for the device palette.
private function BlSaveBmp( byval f as FILE ptr, byval src as any ptr, byval pal as ulong ptr ) as long
    dim as long w, h, inbpp, inpitch
    dim as ubyte ptr s
    if src then
        dim as TkoAbi.PUT_HEADER ptr hdr = cptr( TkoAbi.PUT_HEADER ptr, src )
        if hdr->htype = TkoAbi.PUT_HEADER_NEW then
            w = hdr->width
            h = hdr->height
            s = cptr( ubyte ptr, src ) + IMAGE_HEADER_SIZE
            inbpp = hdr->bpp
            inpitch = hdr->pitch
        else
            dim as ulong oh = hdr->htype
            w = (oh shr 3) and &h1FFF
            h = (oh shr 16) and &hFFFF
            s = cptr( ubyte ptr, src ) + 4
            inbpp = oh and 7
            if inbpp = 0 then
                if TheScreen.isOpen = 0 then return TkoAbi.FB_RTERROR_ILLEGALFUNCTIONCALL
                inbpp = ScreenCtx.surf.bpp
            end if
            inpitch = w * inbpp
        end if
    else
        if TheScreen.isOpen = 0 then return TkoAbi.FB_RTERROR_ILLEGALFUNCTIONCALL
        w = ScreenCtx.surf.w
        h = ScreenCtx.surf.h
        s = ScreenCtx.surf.pixels
        inbpp = ScreenCtx.surf.bpp
        inpitch = ScreenCtx.surf.pitch
    end if

    if (w <= 0) orelse (h <= 0) orelse (s = 0) orelse (inpitch < w * inbpp) then
        return TkoAbi.FB_RTERROR_ILLEGALFUNCTIONCALL
    end if

    '' fb_GfxBsave passes 0 bits per pixel: the default for each input depth.
    dim as long outbpp
    select case inbpp
    case 1 : outbpp = 1
    case 2 : outbpp = 3
    case 4 : outbpp = 4
    case else : return TkoAbi.FB_RTERROR_ILLEGALFUNCTIONCALL
    end select

    dim as long outpitch, offbits, clrused
    select case outbpp
    case 1 : outpitch = (w + 3) and (not 3) : offbits = 54 + 256 * 4 : clrused = 256
    case 3 : outpitch = ((w * 3) + 3) and (not 3) : offbits = 54 : clrused = 0
    case else : outpitch = w * 4 : offbits = 54 : clrused = 0
    end select
    dim as long sizeimage = outpitch * h

    '' The 54-byte header, a byte at a time: the fields are not naturally aligned.
    dim as ubyte hd(0 to 53)
    BlPutLE( @hd(0), 0, &h4D42, 2 )
    BlPutLE( @hd(0), 2, offbits + sizeimage, 4 )
    BlPutLE( @hd(0), 10, offbits, 4 )
    BlPutLE( @hd(0), 14, 40, 4 )
    BlPutLE( @hd(0), 18, w, 4 )
    BlPutLE( @hd(0), 22, h, 4 )
    BlPutLE( @hd(0), 26, 1, 2 )
    BlPutLE( @hd(0), 28, outbpp * 8, 2 )
    BlPutLE( @hd(0), 34, sizeimage, 4 )
    BlPutLE( @hd(0), 38, &hB12, 4 )
    BlPutLE( @hd(0), 42, &hB12, 4 )
    BlPutLE( @hd(0), 46, clrused, 4 )
    BlPutLE( @hd(0), 50, clrused, 4 )
    if fwrite( @hd(0), 54, 1, f ) = 0 then return TkoAbi.FB_RTERROR_FILEIO

    '' The palette, as save_bmp builds it. With a caller's array its shifts put
    '' red where blue belongs -- see the file header.
    dim as ulong ptab(0 to 255)
    if inbpp = 1 then
        if pal = 0 then
            dim as GfxPalette ptr dp = PaletteCurrent( )
            if dp then
                for i as long = 0 to 255 : ptab(i) = dp->entry(i) : next
            end if
        else
            for i as long = 0 to 255
                ptab(i) = ((pal[i] and &h3F0000) shr 14) or _
                             ((pal[i] and &h003F00) shl 2) or _
                             ((pal[i] and &h00003F) shl 18)
            next
        end if
        if outbpp = 1 then
            for i as long = 0 to 255
                fputc( (ptab(i) shr 16) and &hFF, f )
                fputc( (ptab(i) shr 8) and &hFF, f )
                fputc( ptab(i) and &hFF, f )
                fputc( 0, f )
            next
        end if
    end if

    '' One buffer for every row and never cleared between them, as in the C: a
    '' 32 -> 24 row writes four bytes a pixel three apart, so the last pixel's
    '' alpha lands in the row's padding, and that is what the file holds.
    dim as ubyte ptr buffer = callocate( outpitch + 15 )
    s += cast( integer, h - 1 ) * inpitch
    for y as long = h to 1 step -1
        dim as ubyte ptr p = buffer
        select case inbpp
        case 1
            '' The whole source PITCH, padding included -- and an image's padding
            '' is filled at IMAGECREATE, so it is in the file.
            memcpy( p, s, inpitch )
        case 2
            for x as long = 0 to w - 1
                dim as ulong c = cptr( ushort ptr, s )[x]
                p[0] = cast( ubyte, ((c and &h001F) shl 3) or ((c and &h001F) shr 2) )
                p[1] = cast( ubyte, ((c and &h07E0) shr 3) or ((c and &h07E0) shr 9) )
                p[2] = cast( ubyte, ((c and &hF800) shr 8) or ((c and &hF800) shr 13) )
                p += 3
            next
        case else
            for x as long = 0 to w - 1
                *cptr( ulong ptr, p ) = cptr( ulong ptr, s )[x]
                p += outbpp
            next
        end select
        if fwrite( buffer, outpitch, 1, f ) = 0 then
            deallocate( buffer )
            return TkoAbi.FB_RTERROR_FILEIO
        end if
        s -= inpitch
    next
    deallocate( buffer )
    return TkoAbi.FB_RTERROR_OK
end function

'' fb_GfxBsaveEx, at the default depth.
private function BlSave( _
        byref fn as string, byval src as any ptr, byval size as ulong, _
        byval pal as ulong ptr ) as long

    RtlErrorSetNum( TkoAbi.FB_RTERROR_OK )
    dim as FILE ptr f = fopen( fn, "wb" )
    if f = 0 then
        RtlErrorSetNum( TkoAbi.FB_RTERROR_FILENOTFOUND )
        return TkoAbi.FB_RTERROR_FILENOTFOUND
    end if

    '' The LAST '.' in the whole name, and "bmp" after it in any case.
    dim as long dotAt = instrrev( fn, "." )
    dim as boolean isBmp = (dotAt > 0) andalso (lcase( mid( fn, dotAt + 1 ) ) = "bmp")

    dim as long result = TkoAbi.FB_RTERROR_OK
    if isBmp then
        result = BlSaveBmp( f, src, pal )
    else
        if (size = 0) andalso (src <> 0) then
            '' an image to a raw block: refused, after the file was created empty
            fclose( f )
            RtlErrorSetNum( TkoAbi.FB_RTERROR_ILLEGALFUNCTIONCALL )
            return TkoAbi.FB_RTERROR_ILLEGALFUNCTIONCALL
        end if

        '' The size AS GIVEN goes in the header, even when less is written.
        fputc( &hFE, f )
        fputc( size and &hFF, f )
        fputc( (size shr 8) and &hFF, f )
        fputc( (size shr 16) and &hFF, f )
        fputc( (size shr 24) and &hFF, f )

        if src = 0 then
            if TheScreen.isOpen = 0 then
                result = TkoAbi.FB_RTERROR_ILLEGALFUNCTIONCALL
            else
                WindowLock( TheScreen.wnd )
                dim as ulong cap = cast( ulong, ScreenCtx.surf.pitch * ScreenCtx.surf.h )
                if size > cap then size = cap
                if fwrite( ScreenCtx.surf.pixels, size, 1, f ) = 0 then result = TkoAbi.FB_RTERROR_FILEIO
                WindowUnlock( TheScreen.wnd )
                if TheScreen.depth <= 8 then
                    dim as GfxPalette ptr dp = PaletteCurrent( )
                    for i as long = 0 to (1 shl TheScreen.depth) - 1
                        dim as ulong colour = 0
                        if pal then
                            colour = pal[i]
                        elseif dp then
                            colour = (dp->entry(i) shr 2) and &h3F3F3F
                        end if
                        fputc( colour and &hFF, f )
                        fputc( (colour shr 8) and &hFF, f )
                        fputc( (colour shr 16) and &hFF, f )
                    next
                end if
            end if
        elseif fwrite( src, size, 1, f ) = 0 then
            result = TkoAbi.FB_RTERROR_FILEIO
        end if
    end if

    fclose( f )
    RtlErrorSetNum( result )
    return result
end function

'' SCREENLIST's list. gfxlib2 asks every driver's fetch_modes for the depth and
'' keeps the sorted union; see TkoGfxScreenList for what that comes to here.
dim shared as long ptr SlList
dim shared as long SlSize
dim shared as long SlCurrent

private sub SlAdd( byval mode as long )
    for i as long = 0 to SlSize - 1
        if SlList[i] = mode then exit sub
    next
    SlList = reallocate( SlList, (SlSize + 1) * sizeof( long ) )
    SlList[SlSize] = mode
    SlSize += 1
end sub

'' mode_sorter: by width, then by height.
private function SlBefore( byval m1 as long, byval m2 as long ) as boolean
    if (m1 shr 16) <> (m2 shr 16) then return (m1 shr 16) < (m2 shr 16)
    return (m1 and &hFFFF) < (m2 and &hFFFF)
end function

private sub SlSort( )
    for i as long = 1 to SlSize - 1
        dim as long v = SlList[i]
        dim as long j = i - 1
        while j >= 0
            if SlBefore( v, SlList[j] ) = false then exit while
            SlList[j + 1] = SlList[j]
            j -= 1
        wend
        SlList[j + 1] = v
    next
end sub

end namespace
