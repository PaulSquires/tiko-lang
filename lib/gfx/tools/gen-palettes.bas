'' gen-palettes.bas -- extract each mode's default palette from gfxlib2.
''
'' ORIGINAL WORK. Part of libtkogfx: LGPL-2.1-or-later with the static-linking
'' exception.
''
'' The CGA, EGA and VGA default palettes live in gfxlib2's gfxdata/ as binary
'' blobs. Hand-transcribing 256 RGB triples is exactly the sort of task that
'' produces one wrong entry nobody notices for a year.
''
'' So they are EXTRACTED instead: open each mode, read every entry back through
'' PALETTE GET, and emit an FB source file. Same approach as the ABI offsets --
'' generate from the reference, check the generated file into the tree so the
'' build needs no extraction step, and re-generate in the gate so it cannot go
'' stale.
''
'' Emits to the path given as argument 1.
''
'' TWO TABLES ARE EXTRACTED, because gfxlib2 keeps two.
''
''   device palette   what the driver is handed and what PALETTE GET reads.
''   base registers   `__fb_gfx->palette[]`, the REGISTER FILE that the
''                    two-argument `PALETTE attr, reg` form indirects through
''                    on the low-colour modes.
''
'' The base file is invisible to PALETTE GET, so it is extracted through the
'' indirection itself: `PALETTE 0, j` copies base[j] into device 0 without
'' touching base, so reading device 0 back yields base[j]. One screen per mode
'' suffices -- the probe mutates only attribute 0.
''
'' Base is extracted ONLY for modes whose palette is smaller than 256. On a
'' 256-colour mode the two-argument form takes the OTHER branch entirely (6-bit
'' DAC scaling, no indirection), so there is no register file to read.
''
'' Note this reads the DEVICE palette, which is what a mode's defaults land in.
'' For modes with a colour association (CGA/EGA), the device palette already has
'' the association applied -- which is the table we actually want, because it is
'' what the driver is handed.

#include once "../core/mode.bi"
const PALETTE_MAX = 256
#include once "fbgfx.bi"

using TkoGfx
using FB

if command( 1 ) = "" then
    print "usage: gen-palettes <outfile>"
    end 2
end if

dim as string acc

acc += "'' palette-data.bi -- GENERATED by tools/gen-palettes.bas. DO NOT EDIT." + chr(10)
acc += "''" + chr(10)
acc += "'' ORIGINAL WORK (the extraction). The DATA is gfxlib2's default palettes," + chr(10)
acc += "'' read out of the reference rather than transcribed by hand." + chr(10)
acc += "'' LGPL-2.1-or-later with the static-linking exception." + chr(10)
acc += "''" + chr(10)
acc += "'' Each entry is stored in gfxlib2's own layout: r or (g shl 8) or (b shl 16)," + chr(10)
acc += "'' so RED IS THE LOW BYTE. See core/palette.bi." + chr(10)
acc += "''" + chr(10)
acc += "'' Regenerate:  tools/gen-palettes.bas <out>" + chr(10)
acc += "'' Verify:      tools/abtest-palette.bas (re-extracts and compares)" + chr(10)
acc += chr(10)
acc += "#pragma once" + chr(10) + chr(10)
acc += "#include once " + chr(34) + "mode.bi" + chr(34) + chr(10) + chr(10)
acc += "namespace TkoGfx" + chr(10) + chr(10)

'' One flat array of every mode's defaults, plus an index. A jagged array would
'' need a second allocation per mode for no benefit at these sizes.
dim as string tbl, idx
dim as long total = 0

idx += "'' Offset of each mode's defaults into DefaultPaletteData, and its size." + chr(10)
idx += "dim shared as long DefaultPaletteOfs(0 to " & (NUM_MODES - 1) & ") = { _" + chr(10)

dim as long ofs(0 to NUM_MODES - 1)
dim as long cnt(0 to NUM_MODES - 1)
dim as string btbl
dim as long btotal = 0
dim as long bofs(0 to NUM_MODES - 1)
dim as long bcnt(0 to NUM_MODES - 1)
dim as string atbl
dim as long atotal = 0
dim as long aofs(0 to NUM_MODES - 1)
dim as long acnt(0 to NUM_MODES - 1)
dim as ulong DefaultDevice(0 to PALETTE_MAX - 1)
dim as ulong DefaultBase(0 to PALETTE_MAX - 1)
for m as integer = 0 to NUM_MODES - 1
    bofs(m) = -1 : bcnt(m) = 0
    aofs(m) = -1 : acnt(m) = 0
next

for mode as integer = 0 to NUM_MODES - 1
    ofs(mode) = -1
    cnt(mode) = 0
    if ModeSupported( mode ) = 0 then continue for

    dim as long colors = ModePaletteColors( mode )
    screen mode
    ofs(mode) = total
    cnt(mode) = colors
    for i as integer = 0 to colors - 1
        dim as long r, g, b
        palette get i, r, g, b
        dim as ulong packed = cast( ulong, r and &hFF ) or _
                              (cast( ulong, g and &hFF ) shl 8) or _
                              (cast( ulong, b and &hFF ) shl 16)
        DefaultDevice(i) = packed
        if (total mod 8) = 0 then tbl += "    "
        tbl += "&h" + hex( packed, 6 )
        total += 1
        if total < 100000 then tbl += ", "
        if (total mod 8) = 0 then tbl += "_" + chr(10)
    next

    '' base register file -- see the header. Low-colour modes only.
    if colors < 256 then
        bofs(mode) = btotal
        bcnt(mode) = colors
        for j as integer = 0 to colors - 1
            dim as long r, g, b
            '' indirection probe: attribute 0 now shows register j
            palette 0, j
            palette get 0, r, g, b
            dim as ulong packed = cast( ulong, r and &hFF ) or _
                                  (cast( ulong, g and &hFF ) shl 8) or _
                                  (cast( ulong, b and &hFF ) shl 16)
            DefaultBase(j) = packed
            if (btotal mod 8) = 0 then btbl += "    "
            btbl += "&h" + hex( packed, 6 )
            btotal += 1
            btbl += ", "
            if (btotal mod 8) = 0 then btbl += "_" + chr(10)
        next

        '' The default ASSOCIATION: which register each attribute points at.
        '' Not directly readable, so it is INVERTED out of the two tables --
        '' device[i] is by construction base[assoc[i]].
        ''
        '' The inversion is only valid if the register colours are distinct, so
        '' that is CHECKED rather than assumed: a duplicate makes the answer
        '' ambiguous and the generator fails loudly instead of emitting a
        '' plausible wrong table.
        aofs(mode) = atotal
        acnt(mode) = colors
        for i as integer = 0 to colors - 1
            dim as ulong want = DefaultDevice(i)
            dim as long found = -1
            dim as long hits = 0
            for j as integer = 0 to colors - 1
                if DefaultBase(j) = want then
                    if found < 0 then found = j
                    hits += 1
                end if
            next
            if found < 0 then
                print "gen-palettes: mode "; mode; " attribute "; i; _
                      " has no matching register -- cannot invert"
                end 2
            end if
            if hits > 1 then
                '' Ambiguous ONLY if the duplicates disagree about the answer.
                '' Identity is the tie-break gfxlib2 itself uses for the modes
                '' whose association is the identity table.
                if DefaultBase(i) = want then found = i
            end if
            if (atotal mod 16) = 0 then atbl += "    "
            atbl += str( found )
            atotal += 1
            atbl += ", "
            if (atotal mod 16) = 0 then atbl += "_" + chr(10)
        next
    end if
    screen 0
next

if right( atbl, 2 ) = ", " then atbl = left( atbl, len( atbl ) - 2 )
if right( atbl, 3 ) = ", _" + chr(10) then atbl = left( atbl, len( atbl ) - 3 )
if right( atbl, 1 ) <> "_" then atbl += " _"

if right( btbl, 2 ) = ", " then btbl = left( btbl, len( btbl ) - 2 )
if right( btbl, 3 ) = ", _" + chr(10) then btbl = left( btbl, len( btbl ) - 3 )
if right( btbl, 1 ) <> "_" then btbl += " _"

'' trim the trailing separator
if right( tbl, 2 ) = ", " then tbl = left( tbl, len( tbl ) - 2 )
if right( tbl, 3 ) = ", _" + chr(10) then tbl = left( tbl, len( tbl ) - 3 )
if right( tbl, 1 ) <> "_" then tbl += " _"

for mode as integer = 0 to NUM_MODES - 1
    idx += "    " & ofs(mode)
    if mode < NUM_MODES - 1 then idx += ","
    idx += " _" + chr(10)
next
idx += " }" + chr(10) + chr(10)

idx += "dim shared as long DefaultPaletteCount(0 to " & (NUM_MODES - 1) & ") = { _" + chr(10)
for mode as integer = 0 to NUM_MODES - 1
    idx += "    " & cnt(mode)
    if mode < NUM_MODES - 1 then idx += ","
    idx += " _" + chr(10)
next
idx += " }" + chr(10) + chr(10)

acc += idx
acc += "'' " & total & " entries across every supported mode." + chr(10)
acc += "dim shared as ulong DefaultPaletteData(0 to " & (total - 1) & ") = { _" + chr(10)
acc += tbl + chr(10) + " }" + chr(10) + chr(10)

acc += "'' The BASE REGISTER FILE per mode -- what `PALETTE attr, reg` indirects" + chr(10)
acc += "'' through. -1 means the mode has no register file (256-colour modes take" + chr(10)
acc += "'' the DAC-scaling branch instead)." + chr(10)
acc += "dim shared as long DefaultPaletteBaseOfs(0 to " & (NUM_MODES - 1) & ") = { _" + chr(10)
for mode as integer = 0 to NUM_MODES - 1
    acc += "    " & bofs(mode)
    if mode < NUM_MODES - 1 then acc += ","
    acc += " _" + chr(10)
next
acc += " }" + chr(10) + chr(10)
acc += "dim shared as long DefaultPaletteBaseCount(0 to " & (NUM_MODES - 1) & ") = { _" + chr(10)
for mode as integer = 0 to NUM_MODES - 1
    acc += "    " & bcnt(mode)
    if mode < NUM_MODES - 1 then acc += ","
    acc += " _" + chr(10)
next
acc += " }" + chr(10) + chr(10)
acc += "'' " & btotal & " base register entries." + chr(10)
acc += "dim shared as ulong DefaultPaletteBase(0 to " & (btotal - 1) & ") = { _" + chr(10)
acc += btbl + chr(10) + " }" + chr(10) + chr(10)

acc += "'' The default ATTRIBUTE -> REGISTER association, inverted out of the two" + chr(10)
acc += "'' tables above. Identity on the modes with no association; the CGA and EGA" + chr(10)
acc += "'' modes are the ones where it is not." + chr(10)
acc += "dim shared as long DefaultPaletteAssocOfs(0 to " & (NUM_MODES - 1) & ") = { _" + chr(10)
for mode as integer = 0 to NUM_MODES - 1
    acc += "    " & aofs(mode)
    if mode < NUM_MODES - 1 then acc += ","
    acc += " _" + chr(10)
next
acc += " }" + chr(10) + chr(10)
acc += "dim shared as long DefaultPaletteAssoc(0 to " & (atotal - 1) & ") = { _" + chr(10)
acc += atbl + chr(10) + " }" + chr(10) + chr(10)
acc += "end namespace" + chr(10)

dim as long f = freefile
if open( command(1), for output, as #f ) <> 0 then
    print "gen-palettes: cannot write "; command(1)
    end 2
end if
print #f, acc;
close #f

print "gen-palettes: wrote "; command(1); " -- "; total; " device + "; btotal; " base entries"
end 0
