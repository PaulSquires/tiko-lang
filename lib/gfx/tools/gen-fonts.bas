'' gen-fonts.bas -- extract the console fonts from gfxlib2 by rendering them.
''
'' ORIGINAL WORK. Part of libtkogfx: LGPL-2.1-or-later with the static-linking
'' exception.
''
'' gfxlib2 keeps three fonts (8, 14 and 16 pixels tall, all 8 wide) as binary
'' blobs in gfxdata/. Rather than transcribe 3 x 256 x h bytes, this renders
'' every character onto a screen and reads the bits back -- the same
'' generate-don't-transcribe approach used for the palettes.
''
'' The render is done with foreground 1 on background 0 at 8bpp, so a pixel is
'' the bit. Bits are packed LSB-FIRST within a byte, which is the order
'' fb_GfxPrintBuffer uses: it starts with mask 1 at the LEFTMOST pixel and
'' shifts left. Packing MSB-first would mirror every glyph horizontally.
''
'' Emits to the path given as argument 1.

#include once "../core/mode.bi"
#include once "fbgfx.bi"

using TkoGfx
using FB

if command( 1 ) = "" then
    print "usage: gen-fonts <outfile>"
    end 2
end if

'' one mode per font height
dim as long fontmode(0 to 2) = { 13, 9, 11 }     '' 8-tall, 14-tall, 16-tall
dim as long fontheight(0 to 2) = { 8, 14, 16 }

dim as string acc, tbl
dim as long total = 0
dim as long ofs(0 to 2)

acc += "'' font-data.bi -- GENERATED by tools/gen-fonts.bas. DO NOT EDIT." + chr(10)
acc += "''" + chr(10)
acc += "'' ORIGINAL WORK (the extraction). The DATA is gfxlib2's console fonts," + chr(10)
acc += "'' read out of the reference by rendering, not transcribed." + chr(10)
acc += "'' LGPL-2.1-or-later with the static-linking exception." + chr(10)
acc += "''" + chr(10)
acc += "'' Three fonts, all 8 pixels wide: 8, 14 and 16 tall. One byte per row," + chr(10)
acc += "'' bits packed LSB-FIRST -- bit 0 is the LEFTMOST pixel, matching" + chr(10)
acc += "'' fb_GfxPrintBuffer's mask-1-shifted-left loop." + chr(10)
acc += "''" + chr(10)
acc += "'' Regenerate:  tools/gen-fonts.bas <out>" + chr(10)
acc += "'' Verify:      tools/abtest-print.bas (re-renders and compares)" + chr(10)
acc += chr(10) + "#pragma once" + chr(10) + chr(10)
acc += "namespace TkoGfx" + chr(10) + chr(10)

for fi as integer = 0 to 2
    dim as long mode = fontmode(fi)
    dim as long fh = fontheight(fi)
    screen mode
    color 1, 0
    cls

    ofs(fi) = total

    for ch as integer = 0 to 255
'' CLEAR THE CELL FIRST. PRINT is normally opaque and repaints the whole
        '' cell, but at least one character -- chr(255) -- draws NOTHING, so
        '' without a clear its slot captures the PREVIOUS character's bitmap.
        '' That produced a font where 255 was a copy of 254, and showed up as the
        '' only failing character in abtest-print.
        line (0, 0)-(7, fh - 1), 0, BF
        locate 1, 1, 0

        '' A TRAILING SPACE, so the buffer is never one byte long.
        ''
        '' A ONE-BYTE PRINT OF chr(255) IS NOT A GLYPH -- gfxlib2's console-write
        '' hook reads that exact shape as the text CARET and draws a row of
        '' foreground across the bottom of the cell instead of the character.
        '' Printing chr(255) alone therefore extracted the caret and stored it as
        '' font data: 00 00 00 00 00 00 00 FF where the real glyph is blank.
        ''
        '' That is what abtest-print's "unresolved divergence" was. It was read as
        '' "PRINT is transparent for this one character", which fitted the
        '' observation -- the rows above the caret keep whatever was under them --
        '' and was the wrong explanation. RFC-0011 section 9.14.
        ''
        '' The space lands in the NEXT cell, and only the first is read back.
        print chr( ch ) + " ";

        dim as ubyte ptr fbp = cptr( ubyte ptr, screenptr( ) )
        dim as long pitch
        dim as long a, b, c, d, e
        screeninfo a, b, c, d, pitch, e

        for row as integer = 0 to fh - 1
            dim as ubyte bits = 0
            dim as ubyte ptr line_ = fbp + row * pitch
            for bx as integer = 0 to 7
                if line_[bx] <> 0 then bits or= cast( ubyte, 1 shl bx )
            next
            if (total mod 12) = 0 then tbl += "    "
            tbl += "&h" + hex( bits, 2 )
            total += 1
            tbl += ","
            if (total mod 12) = 0 then tbl += " _" + chr(10)
        next
    next
    screen 0
next

if right( tbl, 1 ) = "," then tbl = left( tbl, len( tbl ) - 1 )
if right( tbl, 3 ) = ", _" + chr(10) then tbl = left( tbl, len( tbl ) - 3 )
if right( tbl, 1 ) <> "_" then tbl += " _"

acc += "'' Byte offset of each font's data, and its height." + chr(10)
acc += "dim shared as long FontDataOfs(0 to 2) = { _" + chr(10)
for i as integer = 0 to 2
    acc += "    " & ofs(i)
    if i < 2 then acc += ","
    acc += " _" + chr(10)
next
acc += " }" + chr(10) + chr(10)
acc += "dim shared as long FontHeight(0 to 2) = { 8, 14, 16 }" + chr(10) + chr(10)
acc += "'' " & total & " bytes: 256 characters x (8 + 14 + 16) rows." + chr(10)
acc += "dim shared as ubyte FontData(0 to " & (total - 1) & ") = { _" + chr(10)
acc += tbl + chr(10) + " }" + chr(10) + chr(10)
acc += "end namespace" + chr(10)

dim as long f = freefile
if open( command(1), for output, as #f ) <> 0 then
    print "gen-fonts: cannot write "; command(1)
    end 2
end if
print #f, acc;
close #f

print "gen-fonts: wrote "; command(1); " -- "; total; " bytes"
end 0
