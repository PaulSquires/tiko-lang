'' line.ti -- LINE at 8, 16 and 32 bpp, with the 16-bit style mask.
''
'' Derived from: gfx_line.c (fb_GfxDrawLine). LGPL-2.1-or-later with the
'' static-linking exception.
''
'' PIXEL-EXACTNESS IS THE POINT. A Bresenham line has several defensible
'' formulations that differ by a pixel on ties, so this follows gfxlib2's own
'' one step for step rather than a textbook variant:
''
''   - three branches: vertical (dx=0), horizontal (dy=0), diagonal
''   - dx/dy are captured BEFORE clipping, so the gradient is the unclipped one
''   - d starts at  (dx >= dy) ? dy*2 - dx : dy - dx*2,  then dx and dy double
''   - the loop ends when x reaches x2+ax or y reaches y2+ay, not at x2/y2
''   - clipped starts re-enter the line with the `skip` correction, so a clipped
''     line draws the same pixels as the unclipped one would have
''
'' THE 16-BIT STYLE MASK: bit 15 is the first pixel, and the mask rotates right
'' one bit per pixel step (gfxlib2's RORW1). A clipped start advances the
'' rotation by the pixels skipped, and a line drawn in reverse -- a vertical or
'' horizontal one is always drawn top-down / left-to-right -- reverses the mask
'' and re-bases the rotation, so the pattern stays anchored at (x1, y1). Solid
'' lines (&hFFFF) set every bit, so they draw what they always did.
''   (gfx/line.bas: 'line (i, i) - (63, i), c, , &b1000000011110000'.)
''
'' ONE BODY, THREE INSTANCES. The Bresenham arithmetic does not depend on the
'' pixel width, only the STORE does, so the body is a #macro instantiated for
'' ubyte, ushort and ulong -- the same shape raster/pixelfmt.ti uses. Calling a
'' depth-dispatching PSetAny per pixel would have been three lines instead of
'' this, and would put a `select case` inside the inner loop of every line the
'' library draws; RFC-0001 section 7 is explicit that these loops are where the
'' only available vectorisation lives.
''
'' DrawLine32's generated code is textually what it was before the template, so
'' tools/abtest-line.bas gates it unchanged.
''
'' Types are LONG (32-bit) deliberately, matching the C `int`. The d accumulator
'' is scaled by 2 and by coordinate deltas, and matching C's width keeps the
'' arithmetic identical on the paths where it could ever wrap.

#pragma once

#include once "pixel.ti"
#include once "pixelfmt.ti"   '' PutPixel8 / PutPixel16
#include once "../core/dirty.ti"

namespace TkoGfx

private function LineMid( byval lo as long, byval v as long, byval hi as long ) as long
    if v < lo then return lo
    if v > hi then return hi
    return v
end function

'' The 16 bits mirrored -- gfx_line.c's reverse_mask.
private function LineReverseMask( byval mask as long ) as long
    mask = ((mask shr 1) and &h5555) or ((mask and &h5555) shl 1)
    mask = ((mask shr 2) and &h3333) or ((mask and &h3333) shl 2)
    mask = ((mask shr 4) and &h0F0F) or ((mask and &h0F0F) shl 4)
    mask = ((mask shr 8) and &h00FF) or ((mask and &h00FF) shl 8)
    return mask
end function

'' A 16-bit rotate right by 'n' (0..15) -- fb.h's RORW / RORW1 on the low word.
private function LineRorW( byval v as long, byval n as long ) as long
    n and= 15
    if n = 0 then return v and &hFFFF
    return ((v shr n) or (v shl (16 - n))) and &hFFFF
end function

#macro TKO_DEFINE_LINE( suffix, elem )

'' A line from (x1,y1) to (x2,y2), clipped to the surface's clip box, in the
'' 16-bit 'style' pattern.
private sub DrawLine##suffix( _
        byref s as Surface, _
        byval x1 as long, byval y1 as long, _
        byval x2 as long, byval y2 as long, _
        byval col as ulong, _
        byval style_ as ulong = &hFFFF )

    dim as long style = cast( long, style_ and &hFFFF )
    dim as long rot = 0, bit_

    if SurfaceClipEmpty( s ) then exit sub

    dim as long xmin = s.clip_x1, xmax = s.clip_x2
    dim as long ymin = s.clip_y1, ymax = s.clip_y2

    '' Entirely outside on one side? Cheap reject, same four tests as gfxlib2.
    if (x1 < xmin) andalso (x2 < xmin) then exit sub
    if (x1 > xmax) andalso (x2 > xmax) then exit sub
    if (y1 < ymin) andalso (y2 < ymin) then exit sub
    if (y1 > ymax) andalso (y2 > ymax) then exit sub

    '' Gradient is taken from the UNCLIPPED endpoints.
    dim as long dx = x2 - x1
    dim as long dy = y2 - y1

    x2 = LineMid( xmin, x2, xmax )
    y2 = LineMid( ymin, y2, ymax )

    dim as long x, y, d, ax, ay, skip

    if dx = 0 then
        '' ---- vertical ----
        if y1 < ymin then
            rot += ymin - y1
            y1 = ymin
        elseif y1 > ymax then
            rot += y1 - ymax
            y1 = ymax
        end if
        if y1 > y2 then
            style = LineReverseMask( style )
            rot = (not rot) + y2 - y1
            swap y1, y2
        end if
        bit_ = &h8000 shr (rot and &hF)
        y = y1
        while y <= y2
            if (style and bit_) <> 0 then PutPixel##suffix( s, x1, y, col )
            bit_ = LineRorW( bit_, 1 )
            y += 1
        wend
        DirtyMarkSpan( s, y1, y2 )

    elseif dy = 0 then
        '' ---- horizontal ----
        if x1 < xmin then
            rot += xmin - x1
            x1 = xmin
        elseif x1 > xmax then
            rot += x1 - xmax
            x1 = xmax
        end if
        if x1 > x2 then
            style = LineReverseMask( style )
            rot = (not rot) + x2 - x1
            swap x1, x2
        end if
        bit_ = &h8000 shr (rot and &hF)
        dim as elem ptr row = cptr( elem ptr, SurfaceRowAddr( s, y1 ) )
        x = x1
        while x <= x2
            if (style and bit_) <> 0 then row[x] = cast( elem, col )
            bit_ = LineRorW( bit_, 1 )
            x += 1
        wend
        DirtyMark( s, y1, 1 )

    else
        '' ---- diagonal ----
        ax = 1 : ay = 1
        if dx < 0 then
            dx = -dx
            ax = -1
        end if
        if dy < 0 then
            dy = -dy
            ay = -1
        end if

        if dx >= dy then
            d = dy * 2 - dx
        else
            d = dy - dx * 2
        end if
        dx *= 2
        dy *= 2

        x = LineMid( xmin, x1, xmax )
        d += ax * (x - x1) * dy

        y = LineMid( ymin, y1, ymax )
        d -= ay * (y - y1) * dx

        '' the pattern starts where the clipped line does
        if dx >= dy then
            rot += ax * (x - x1)
        else
            rot += ay * (y - y1)
        end if

        '' The loop terminates one step PAST the endpoint.
        x2 += ax
        y2 += ay

        if dx >= dy then
            '' shallow: x advances every step
            if d >= dy then
                skip = (d - dy) \ dx + 1
                y += ay * skip
                d -= skip * dx
                if (y < ymin) orelse (y > ymax) then exit sub
            elseif d < (dy - dx) then
                skip = ((dy - dx) - d) \ dy + 1
                x += ax * skip
                d += skip * dy
                rot += skip
                if (x < xmin) orelse (x > xmax) then exit sub
            end if

            bit_ = &h8000 shr (rot and &hF)
            dim as long fromy = y
            while (x <> x2) andalso (y <> y2)
                if (style and bit_) <> 0 then PutPixel##suffix( s, x, y, col )
                bit_ = LineRorW( bit_, 1 )
                if d >= 0 then
                    y += ay
                    d -= dx
                end if
                d += dy
                x += ax
            wend
            DirtyMarkSpan( s, fromy, y2 - ay )
        else
            '' steep: y advances every step
            if d < -dx then
                skip = (-d - dx) \ dy + 1
                x += ax * skip
                d += skip * dy
                if (x < xmin) orelse (x > xmax) then exit sub
            elseif d > (dy - dx) then
                skip = (d - (dy - dx)) \ dx + 1
                y += ay * skip
                d -= skip * dx
                rot += skip
                if (y < ymin) orelse (y > ymax) then exit sub
            end if

            bit_ = &h8000 shr (rot and &hF)
            dim as long fromy = y
            while (x <> x2) andalso (y <> y2)
                if (style and bit_) <> 0 then PutPixel##suffix( s, x, y, col )
                bit_ = LineRorW( bit_, 1 )
                if d <= 0 then
                    x += ax
                    d += dy
                end if
                d -= dx
                y += ay
            wend
            DirtyMarkSpan( s, fromy, y2 - ay )
        end if
    end if
end sub

#endmacro

TKO_DEFINE_LINE( 8, ubyte )
TKO_DEFINE_LINE( 16, ushort )
TKO_DEFINE_LINE( 32, ulong )

'' Draw at whatever depth the surface is. The entry layer calls this; the
'' abtests call the suffixed instances directly, because a test that named the
'' dispatcher could not say which depth it had actually exercised.
private sub DrawLineAny( _
        byref s as Surface, _
        byval x1 as long, byval y1 as long, _
        byval x2 as long, byval y2 as long, _
        byval col as ulong, _
        byval style as ulong = &hFFFF )
    select case s.bpp
    case 1 : DrawLine8( s, x1, y1, x2, y2, col, style )
    case 2 : DrawLine16( s, x1, y1, x2, y2, col, style )
    case else : DrawLine32( s, x1, y1, x2, y2, col, style )
    end select
end sub

end namespace
