'' driver.ti -- the presenter interface and its registry.
''
'' Derived from: fb_gfx.h (GFXDRIVER), gfx_screen.c (set_mode's driver walk),
'' win32/gfx_win32.c and unix/gfx_unix.c (the driver lists).
'' LGPL-2.1-or-later with the static-linking exception.
''
'' A driver owns the WINDOW and the presentation of pixels; it does not draw.
'' Everything above it renders into a Surface, marks dirty scanlines, and the
'' driver's update() moves the changed span onto the device.
''
'' The member list mirrors GFXDRIVER's fifteen, in order, because SCREENCONTROL
'' GET_DRIVER_NAME and the driver-name selection are part of the public surface
'' we have to match. Several are legitimately NULL -- gfxlib2 checks before
'' calling, and so must we.
''
'' SELECTION IS NOT "FIRST THAT LOADS". gfxlib2 walks its list trying each driver
'' TWICE -- once with the requested refresh rate, once with 0 -- and then repeats
'' the whole list with the fullscreen flag toggled. An explicit name from the
'' FBGFX environment variable or SCREENCONTROL SET_DRIVER_NAME filters the list
'' first. Getting this wrong means a mode that gfxlib2 opens fails here, which
'' looks like a driver bug rather than a selection bug.

#pragma once

#include once "../core/surface.ti"
#include once "../core/dirty.ti"

namespace TkoGfx

type DrvInitProc     as function cdecl ( byval title as zstring ptr, byval w as long, byval h as long, byval depth as long, byval refresh as long, byval flags as long ) as long
type DrvVoidProc     as sub cdecl ( )
type DrvPaletteProc  as sub cdecl ( byval index as long, byval r as long, byval g as long, byval b as long )
type DrvGetMouseProc as function cdecl ( byval x as long ptr, byval y as long ptr, byval z as long ptr, byval buttons as long ptr, byval clip as long ptr ) as long
type DrvSetMouseProc as sub cdecl ( byval x as long, byval y as long, byval cursor as long, byval clip as long )
type DrvTitleProc    as sub cdecl ( byval title as zstring ptr )
type DrvWindowPosProc as function cdecl ( byval x as long, byval y as long ) as long
type DrvFetchModesProc as function cdecl ( byval depth as long, byval size as long ptr ) as long ptr

type Driver
    name             as zstring ptr

    '' Required. init returns 0 on success, -1 on failure, exactly as gfxlib2's
    '' does -- and exit may be called even after a FAILED init, so it must
    '' tolerate a half-built state.
    init             as DrvInitProc
    exit_            as DrvVoidProc
    lock_            as DrvVoidProc
    unlock_          as DrvVoidProc

    set_palette      as DrvPaletteProc
    wait_vsync       as DrvVoidProc          '' nullable
    get_mouse        as DrvGetMouseProc      '' nullable
    set_mouse        as DrvSetMouseProc      '' nullable
    set_window_title as DrvTitleProc         '' nullable
    set_window_pos   as DrvWindowPosProc     '' nullable
    fetch_modes      as DrvFetchModesProc    '' nullable
    flip             as DrvVoidProc          '' OpenGL only
    poll_events      as DrvVoidProc          '' OpenGL only
    update           as DrvVoidProc          '' push dirty scanlines to the device
end type

'' The registry. Small and fixed: there will never be many drivers, and a static
'' array avoids an allocation on a path that runs before anything is set up.
const MAX_DRIVERS = 8

type DriverRegistry
    count as long
    list(0 to MAX_DRIVERS - 1) as Driver ptr
end type

private sub DriverRegister( byref reg as DriverRegistry, byval d as Driver ptr )
    if d = nullptr then exit sub
    if reg.count >= MAX_DRIVERS then exit sub
    reg.list(reg.count) = d
    reg.count += 1
end sub

'' Find by name, case-insensitively, as gfxlib2 matches SET_DRIVER_NAME.
private function DriverFind( _
        byref reg as DriverRegistry, byref nm as string ) as Driver ptr
    dim as string want = ucase( nm )
    for i as integer = 0 to reg.count - 1
        if reg.list(i) <> nullptr andalso reg.list(i)->name <> nullptr then
            if ucase( *reg.list(i)->name ) = want then return reg.list(i)
        end if
    next
    return nullptr
end function

end namespace
