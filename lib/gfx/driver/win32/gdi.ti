'' gdi.ti -- the Win32 GDI presenter.
''
'' Derived from: win32/gfx_driver_gdi.c, win32/gfx_win32.c.
'' LGPL-2.1-or-later with the static-linking exception.
''
'' Split deliberately into two halves:
''
''   GdiBlitSpan   pure pixels -> HDC. No window, no thread, no global state.
''                 Testable against a memory DC, and tools/probe-gdi.bas does
''                 exactly that.
''   the driver    window class, background thread, message pump. NOT testable
''                 headlessly; needs the author's interactive pass.
''
'' Splitting them is the point. Nearly everything that goes wrong in a GDI
'' presenter goes wrong in the first half -- and that half can be checked by
'' machine.
''
'' THE DIB IS TOP-DOWN. biHeight is NEGATIVE. A Windows DIB defaults to
'' bottom-up, where row 0 of the buffer is the BOTTOM of the image; a framebuffer
'' is top-down. Get this wrong and everything renders vertically mirrored, which
'' looks like a coordinate bug in the rasterizer rather than a format bug in the
'' presenter. gfxlib2 sets `biHeight = -h` for the same reason.
''
'' THE STRIDE MUST BE 4-BYTE ALIGNED. GDI requires it; gfxlib2 rounds with
'' `(pitch + 3) & ~3`. At 32bpp any sane pitch already is, but a surface pointed
'' at a sub-rectangle need not be, and a mismatch shears the image diagonally.

#pragma once

#include once "../driver.ti"
#include once "windows.bi"

namespace TkoGfx

'' Fill a BITMAPINFOHEADER for a top-down DIB matching this surface.
'' EXPAND A PALETTED ROW RANGE INTO A 32BPP MIRROR.
''
'' An 8bpp surface cannot be handed to SetDIBitsToDevice as it stands:
'' GdiDescribe writes a bare BITMAPINFOHEADER, and at biBitCount 8 the DIB needs
'' a 256-entry RGBQUAD colour table immediately after it, which BITMAPINFO's
'' declaration here has no room for. Growing the struct is one option; expanding
'' to 32bpp is the other, and it is the one taken because it needs nothing from
'' GDI that is not already proven -- the same SetDIBitsToDevice call, the same
'' top-down negative height, the same dirty-span arithmetic.
''
'' THE LUT IS THE CALLER'S. This layer does not know what a palette is;
'' entry/palette.ti owns the table and hands down 256 packed 0x00BBGGRR values.
'' A NULL lut is a caller error and draws nothing rather than reading garbage.
private sub GdiExpand8( _
        byref dst as Surface, byref src as Surface, _
        byval lut as ulong ptr, _
        byval y1 as long, byval y2 as long )

    if (lut = nullptr) orelse (dst.pixels = nullptr) orelse (src.pixels = nullptr) then exit sub
    if y1 < 0 then y1 = 0
    if y2 > src.h - 1 then y2 = src.h - 1

    for y as integer = y1 to y2
        dim as ubyte ptr sr = SurfaceRowAddr( src, y )
        dim as ulong ptr dr = cptr( ulong ptr, SurfaceRowAddr( dst, y ) )
        for x as integer = 0 to src.w - 1
            dr[x] = lut[ sr[x] ]
        next
    next
end sub

private sub GdiDescribe( byref bmi as BITMAPINFO, byref s as Surface )
    bmi.bmiHeader.biSize        = sizeof( BITMAPINFOHEADER )
    bmi.bmiHeader.biWidth       = s.w
    bmi.bmiHeader.biHeight      = -s.h        '' NEGATIVE: top-down. See above.
    bmi.bmiHeader.biPlanes      = 1
    bmi.bmiHeader.biBitCount    = cshort( s.bpp * 8 )
    bmi.bmiHeader.biCompression = BI_RGB
    bmi.bmiHeader.biSizeImage   = 0
end sub

'' Blit scanlines y1..y2 (inclusive) of `s` to `hdc` at the same y.
''
'' Returns the number of rows actually sent, or 0. One call per present, as
'' gfxlib2 does -- it finds the first and last dirty rows and issues a single
'' SetDIBitsToDevice rather than one per run, because the call overhead dwarfs
'' the cost of a few clean rows.
private function GdiBlitSpan( _
        byval hdc as HDC, _
        byref s as Surface, _
        byval y1 as long, _
        byval y2 as long ) as long

    if hdc = nullptr orelse s.pixels = nullptr then return 0
    if y1 < 0 then y1 = 0
    if y2 > s.h - 1 then y2 = s.h - 1
    if y1 > y2 then return 0

    dim as BITMAPINFO bmi
    GdiDescribe( bmi, s )

    dim as long rows = y2 - y1 + 1

    '' The source points at row y1, and the DIB is described as `rows` tall
    '' rather than the full surface -- otherwise StartScan/cLines would be
    '' interpreted against the whole image and the destination would slide.
    bmi.bmiHeader.biHeight = -rows

    dim as ubyte ptr src = s.pixels + cast( integer, y1 ) * s.pitch

    if SetDIBitsToDevice( hdc, 0, y1, s.w, rows, 0, 0, 0, rows, _
                          src, @bmi, DIB_RGB_COLORS ) = 0 then
        return 0
    end if

    return rows
end function

'' Present whatever is dirty, then clear it. This is the driver's update().
private function GdiPresentDirty( byval hdc as HDC, byref s as Surface ) as long
    dim as long y1, y2
    if DirtySpan( s, y1, y2 ) = 0 then return 0
    dim as long rows = GdiBlitSpan( hdc, s, y1, y2 )
    if rows > 0 then DirtyClear( s )
    return rows
end function

end namespace
