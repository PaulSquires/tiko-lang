'' mem.ti -- the NULL and MEM drivers.
''
'' NULL is derived from gfx_driver_null.c. MEM is ORIGINAL WORK.
'' LGPL-2.1-or-later with the static-linking exception.
''
'' NULL is gfxlib2's fallback: a mode that opens, draws nowhere, and always
'' succeeds. It exists so a program can run headless without special-casing.
''
'' MEM is what NULL should have been for testing. It presents into a plain
'' buffer and RECORDS WHAT IT PRESENTED -- how many times update() ran, and the
'' scanline span each time. That makes the presentation path testable without a
'' window, a display server, or a human:
''
''   - did a primitive mark the rows it actually touched?
''   - did the presenter blit the span it was told to?
''   - did a second present after no drawing do nothing?
''
'' None of those are observable through a real driver without screen-scraping,
'' and all of them are exactly where presentation bugs live. gfxlib2 has no
'' equivalent, which is part of why its dirty handling is only checkable by eye.

#pragma once

#include once "driver.ti"

namespace TkoGfx

'' ---------------------------------------------------------------- NULL driver

private function NullInit cdecl ( byval title as zstring ptr, byval w as long, byval h as long, byval depth as long, byval refresh as long, byval flags as long ) as long
    return 0        '' always succeeds
end function

private sub NullNop cdecl ( )
end sub

private sub NullPalette cdecl ( byval index as long, byval r as long, byval g as long, byval b as long )
end sub

dim shared as Driver DriverNull = ( _
    @"NULL", @NullInit, @NullNop, @NullNop, @NullNop, @NullPalette, _
    0, 0, 0, 0, 0, 0, 0, 0, @NullNop )

'' ----------------------------------------------------------------- MEM driver

type MemState
    target      as Surface ptr    '' what update() reads from
    presents    as long           '' how many times update() has run
    last_y1     as long           '' span of the most recent present
    last_y2     as long
    last_rows   as long           '' rows in that span, 0 if nothing was dirty
    total_rows  as long           '' rows presented since reset
end type

dim shared as MemState MemLog

private sub MemReset( byval target as Surface ptr )
    MemLog.target     = target
    MemLog.presents   = 0
    MemLog.last_y1    = -1
    MemLog.last_y2    = -1
    MemLog.last_rows  = 0
    MemLog.total_rows = 0
end sub

private function MemInit cdecl ( byval title as zstring ptr, byval w as long, byval h as long, byval depth as long, byval refresh as long, byval flags as long ) as long
    return 0
end function

private sub MemNop cdecl ( )
end sub

private sub MemPalette cdecl ( byval index as long, byval r as long, byval g as long, byval b as long )
end sub

'' Present: blit the dirty span, then clear it -- the same order every real
'' driver uses. Clearing before the blit would lose any row dirtied by another
'' thread in between, which is precisely the race the graphics lock exists for.
private sub MemUpdate cdecl ( )
    MemLog.presents += 1
    MemLog.last_rows = 0
    MemLog.last_y1 = -1
    MemLog.last_y2 = -1

    if MemLog.target = 0 then exit sub

    dim as long y1, y2
    if DirtySpan( *MemLog.target, y1, y2 ) then
        MemLog.last_y1    = y1
        MemLog.last_y2    = y2
        MemLog.last_rows  = y2 - y1 + 1
        MemLog.total_rows += MemLog.last_rows
        DirtyClear( *MemLog.target )
    end if
end sub

dim shared as Driver DriverMem = ( _
    @"MEM", @MemInit, @MemNop, @MemNop, @MemNop, @MemPalette, _
    0, 0, 0, 0, 0, 0, 0, 0, @MemUpdate )

end namespace
