'' assert.tiko -- ASSERT and ASSERTWARN, narrow and wide: four entry points over
'' two fbc members.
''
'' THE TWO DIFFER IN WHERE THE MESSAGE GOES AND WHETHER THE PROGRAM SURVIVES.
''
''   ASSERT      formats into fbc's shared __fb_errmsg buffer, hands the pointer
''               to __fb_ctx.errmsg so fb_hRtExit prints it, and ENDS THE PROGRAM
''   ASSERTWARN  prints straight to stderr and returns
''
'' So the message reaches the user by two entirely different routes, and only one
'' of them needs the context field -- which is why the wide forms can share one
'' conversion helper and still end up in different places.
''
'' THE WIDE FORMS CONVERT AND DELEGATE. fbc's reason is worth keeping: it avoids
'' needing fwprintf, "which would only make things unnecessarily complex,
'' especially since it doesn't exist on DJGPP". The buffer is 1024 bytes and is
'' terminated by hand, because fb_wstr_ConvToA is given a limit one short of it.

#include once "inc/descriptors.ti"
#include once "inc/ctx.ti"
#include once "inc/fmt.ti"
#include once "inc/sysbind.ti"

extern "rtlib"
	declare sub tkrt_End alias "fb_End" ( byval errlevel as int32 )
end extern

extern "c"   '' NON-FBCALL: fb_unicode.h declares the converter plainly.
	declare function tkrt_ConvToA alias "fb_wstr_ConvToA" _
		( byval dst as zstring ptr, byval dst_chars as integer, _
		  byval src as wstring ptr ) as integer
end extern

const TKORT_ASSERT_BUFSIZE = 1024

'' The format string, with a real newline. Built as a literal rather than
'' concatenated at the call site: `@"..." + chr(10)` makes a STRING expression
'' and the @ then applies to the wrong thing.
#define TKORT_ASSERT_FMT !"%s(%d): assertion failed at %s: %s\n"

extern "rtlib"

'' ASSERT: format, publish, die.
sub tkort_Assert alias "fb_Assert" _
	( byval filename as zstring ptr, byval linenum as int32, _
	  byval funcname as zstring ptr, byval expression as zstring ptr )

	'' Into fbc's OWN buffer, not one of ours -- fb_hRtExit reads that address
	'' after this function has handed control to fb_End.
	tkrt_snprintf( @__fb_errmsg, FB_ERRMSG_SIZE, _
	               TKORT_ASSERT_FMT, filename, linenum, funcname, expression )

	'' snprintf terminates, but fbc writes the last byte anyway -- insurance
	'' against a truncating implementation.
	(@__fb_errmsg)[FB_ERRMSG_SIZE - 1] = 0

	TKORT_CTX_ERRMSG() = @__fb_errmsg

	tkrt_End( 1 )

end sub

'' ASSERTWARN: stderr, and carry on. It does NOT touch __fb_ctx.errmsg -- the
'' program is still running, so there is no exit path to hand a message to.
sub tkort_AssertWarn alias "fb_AssertWarn" _
	( byval filename as zstring ptr, byval linenum as int32, _
	  byval funcname as zstring ptr, byval expression as zstring ptr )

	fprintf( stderr, TKORT_ASSERT_FMT, filename, linenum, funcname, expression )

end sub

private sub hConvToA( byval buffer as zstring ptr, byval expression as wstring ptr )
	tkrt_ConvToA( buffer, TKORT_ASSERT_BUFSIZE - 1, expression )
	buffer[TKORT_ASSERT_BUFSIZE - 1] = 0
end sub

sub tkort_AssertW alias "fb_AssertW" _
	( byval filename as zstring ptr, byval linenum as int32, _
	  byval funcname as zstring ptr, byval expression as wstring ptr )
	dim as zstring * TKORT_ASSERT_BUFSIZE buffer
	hConvToA( @buffer, expression )
	tkort_Assert( filename, linenum, funcname, @buffer )
end sub

sub tkort_AssertWarnW alias "fb_AssertWarnW" _
	( byval filename as zstring ptr, byval linenum as int32, _
	  byval funcname as zstring ptr, byval expression as wstring ptr )
	dim as zstring * TKORT_ASSERT_BUFSIZE buffer
	hConvToA( @buffer, expression )
	tkort_AssertWarn( filename, linenum, funcname, @buffer )
end sub

end extern
