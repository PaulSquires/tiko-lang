'' file2.tiko -- EOF, LOC, LEN, FREEFILE, CLOSE and the put-back buffer:
'' twelve entry points over six fbc members.
''
'' THREE MORE RULES THAT PRODUCE A PLAUSIBLE ANSWER RATHER THAN AN ERROR:
''
''   EOF IS TRUE FOR ANYTHING IT CANNOT ANSWER. A closed handle, a missing hooks
''   table and a missing pfnEof all report END OF FILE -- so a loop reading until
''   EOF terminates on a broken handle instead of spinning. FB_TRUE is -1, not 1.
''
''   LOC DIVIDES BY 128 IN SEQUENTIAL MODE. A QB quirk carried forward: for
''   INPUT and OUTPUT the location is in 128-byte blocks, while BINARY and RANDOM
''   report what TELL gave. Same function, two units.
''
''   CLOSE #0 IS AN ERROR. QBASIC returned no error and old FB closed every file.

#include once "inc/descriptors.ti"
#include once "inc/file.ti"
#include once "inc/sysbind.ti"

#ifdef ENABLE_MT
	extern "rtlib"
		declare sub fb_Lock alias "fb_Lock" ( )
		declare sub fb_Unlock alias "fb_Unlock" ( )
	end extern
	#define IOLOCK()   fb_Lock()
	#define IOUNLOCK() fb_Unlock()
#else
	#define IOLOCK()
	#define IOUNLOCK()
#endif

'' FB_TRUE / FB_FALSE are already FreeBASIC's own -- -1 and 0, the same values
'' fb.h defines -- so they are used rather than redeclared.
const FB_RTERROR_OK = 0
const FB_RTERROR_ILLEGALFUNCTIONCALL = 1
const FB_RTERROR_FILEIO = 3
const FB_FILE_ENCOD_ASCII = 0


extern "rtlib"
	declare function tkrt_ErrorSetNum alias "fb_ErrorSetNum" ( byval e as int32 ) as int32
	declare sub tkrt_FileReset alias "fb_FileReset" ( )
end extern

extern "c"   '' NON-FBCALL: an *Ex form and two libc calls.
	declare function tkrt_FileTellEx alias "fb_FileTellEx" ( byval h as FB_FILE ptr ) as int64
	'' The 64-bit seek/tell pair. Not in fbc's crt bindings under these names on
	'' every target, so they are declared here with local aliases.
'' _fseeki64 / _ftelli64 ON THE MICROSOFT ABI. There is no fseeko in the UCRT:
'' the 64-bit seek pair is spelled with a leading underscore and an i64 suffix
'' there. Same signature and same meaning, a different name. TKORT_MSVC comes
'' from build.sh -- see src/sys/sys.ti for why fbc cannot tell us itself.
#ifdef TKORT_MSVC
	declare function tkrt_fseeko cdecl alias "_fseeki64" _
		( byval f as FILE ptr, byval off as int64, byval whence as int32 ) as int32
	declare function tkrt_ftello cdecl alias "_ftelli64" ( byval f as FILE ptr ) as int64
#else
	declare function tkrt_fseeko cdecl alias "fseeko" _
		( byval f as FILE ptr, byval off as int64, byval whence as int32 ) as int32
	declare function tkrt_ftello cdecl alias "ftello" ( byval f as FILE ptr ) as int64
#endif
end extern

extern "c"   '' NON-FBCALL: the *Ex forms take a handle.

'' Every path that cannot answer says TRUE.
function tkort_FileEofEx alias "fb_FileEofEx" ( byval h as FB_FILE ptr ) as int32

	if( TKORT_HANDLE_USED( h ) = 0 ) then return FB_TRUE

	IOLOCK()

	if( h->hooks = 0 ) then
		IOUNLOCK()
		return FB_TRUE
	end if
	if( h->hooks->pfnEof = 0 ) then
		IOUNLOCK()
		return FB_TRUE
	end if

	'' A PENDING PUT-BACK CHARACTER MEANS NOT-EOF even when the OS says the file
	'' is exhausted: it has been read but not consumed.
	if( h->putback_size <> 0 ) then
		IOUNLOCK()
		return FB_FALSE
	end if

	dim as int32 res = h->hooks->pfnEof( h )

	IOUNLOCK()
	return res

end function

'' LOC goes through TELL and then UNDOES its 1-based conversion, so the two are
'' not independent -- a change to TELL's arithmetic moves LOC with it.
function tkort_FileLocationEx alias "fb_FileLocationEx" ( byval h as FB_FILE ptr ) as int64

	if( TKORT_HANDLE_USED( h ) = 0 ) then return 0

	IOLOCK()

	dim as int64 pos_ = tkrt_FileTellEx( h )
	if( pos_ <> 0 ) then
		pos_ -= 1
		'' THE QB QUIRK: sequential modes report 128-byte blocks.
		if( (h->mode = FB_FILE_MODE_INPUT) orelse (h->mode = FB_FILE_MODE_OUTPUT) ) then
			pos_ \= 128
		end if
	end if

	IOUNLOCK()
	return pos_

end function

'' The handle is ZEROED after the hook succeeds, which is what makes
'' FB_HANDLE_USED false for it afterwards and what FREEFILE looks for.
function tkort_FileCloseEx alias "fb_FileCloseEx" ( byval h as FB_FILE ptr ) as int32

	IOLOCK()

	if( TKORT_HANDLE_USED( h ) = 0 ) then
		IOUNLOCK()
		return tkrt_ErrorSetNum( FB_RTERROR_ILLEGALFUNCTIONCALL )
	end if

	dim as int32 result = h->hooks->pfnClose( h )
	if( result <> 0 ) then
		IOUNLOCK()
		return result
	end if

	memset( h, 0, sizeof( FB_FILE ) )

	IOUNLOCK()
	return tkrt_ErrorSetNum( FB_RTERROR_OK )

end function

end extern

extern "c"   '' NON-FBCALL: the *Ex form takes a handle.

'' PUT BACK. The buffer is FOUR BYTES and overflowing it is an I/O error rather
'' than a silent drop.
''
'' NOTE THE BUFFER HOLDS wchar, NOT the file's encoding. When the file is not
'' ASCII the narrow source is widened on the way in, so the size test is against
'' chars * sizeof( wstring ) -- which means UNGET twice on a wide file already
'' overflows a four-byte buffer on Linux, where a wchar is four bytes.
function tkort_FilePutBackEx alias "fb_FilePutBackEx" _
	( byval h as FB_FILE ptr, byval src as any ptr, byval chars as uinteger ) as int32

	if( TKORT_HANDLE_USED( h ) = 0 ) then
		return tkrt_ErrorSetNum( FB_RTERROR_ILLEGALFUNCTIONCALL )
	end if

	IOLOCK()

	dim as int32 res = tkrt_ErrorSetNum( FB_RTERROR_OK )

	dim as uinteger bytes = chars
	if( h->encod <> FB_FILE_ENCOD_ASCII ) then bytes = chars * sizeof( wstring )

	'' A NAMED FOUR, NOT sizeof( h->putback_buffer ). FreeBASIC's sizeof on an
	'' ARRAY MEMBER does not yield the array's size, so the test silently
	'' rejected pushes that fit: after one character, a three-character push
	'' returned FILEIO where fbc returns success. The differential caught it on
	'' the overflow case, which is the only place the two answers differ.
	if( (h->putback_size + bytes) > TKORT_PUTBACK_BYTES ) then
		res = tkrt_ErrorSetNum( FB_RTERROR_FILEIO )
	else
		'' Existing characters shift up: the newest goes at the front.
		if( h->putback_size <> 0 ) then
			memmove( @h->putback_buffer(bytes), @h->putback_buffer(0), h->putback_size )
		end if

		if( h->encod = FB_FILE_ENCOD_ASCII ) then
			memcpy( @h->putback_buffer(0), src, bytes )
		else
			dim as uint8 ptr s = cptr( uint8 ptr, src )
			dim as wstring ptr d = cptr( wstring ptr, @h->putback_buffer(0) )
			for i as uinteger = 0 to chars - 1
				d[i] = s[i]
			next
		end if

		h->putback_size += bytes
	end if

	IOUNLOCK()
	return res

end function

end extern

extern "rtlib"

function tkort_FileEof alias "fb_FileEof" ( byval fnum as int32 ) as int32
	return tkort_FileEofEx( TKORT_FILE_TO_HANDLE( fnum ) )
end function

function tkort_FileLocation alias "fb_FileLocation" ( byval fnum as int32 ) as int64
	return tkort_FileLocationEx( TKORT_FILE_TO_HANDLE( fnum ) )
end function

'' CLOSE #0 is rejected. The commented call is fbc's own record of the road not
'' taken -- old FB closed every file here.
function tkort_FileClose alias "fb_FileClose" ( byval fnum as int32 ) as int32
	if( fnum = 0 ) then
		'' tkrt_FileReset( )
		return tkrt_ErrorSetNum( FB_RTERROR_ILLEGALFUNCTIONCALL )
	end if
	return tkort_FileCloseEx( TKORT_FILE_TO_HANDLE( fnum ) )
end function

'' CLOSE with no arguments closes everything, as in QB.
function tkort_FileCloseAll alias "fb_FileCloseAll" ( ) as int32
	tkrt_FileReset( )
	return tkrt_ErrorSetNum( FB_RTERROR_OK )
end function

function tkort_FilePutBack alias "fb_FilePutBack" _
	( byval fnum as int32, byval src as any ptr, byval chars as uinteger ) as int32
	return tkort_FilePutBackEx( TKORT_FILE_TO_HANDLE( fnum ), src, chars )
end function

'' FREEFILE walks the table for the first entry with no hooks, and returns the
'' 1-BASED file number rather than the index. 0 means the table is full.
function tkort_FileFree alias "fb_FileFree" ( ) as int32
	IOLOCK()
	for i as int32 = 1 to (FB_MAX_FILES - FB_RESERVED_FILES)
		dim as FB_FILE ptr h = TKORT_FILE_TO_HANDLE( i )
		if( h->hooks = 0 ) then
			IOUNLOCK()
			return i
		end if
	next
	IOUNLOCK()
	return 0
end function

end extern

'' fb_FileLenEx IS ALSO NON-FBCALL, even though it takes a FILENAME rather than a
'' handle -- the *Ex suffix marks the internal tier, not the argument type.
'' Third instance of the two-tier rule in this module family, and win32 is again
'' the only target that can see it: _fb_FileLenEx@4 against _fb_FileLenEx.
extern "c"   '' NON-FBCALL: fb_file.h declares it plainly.

'' LEN( filename ) opens the file just to measure it, and SETS THE ERROR NUMBER
'' BOTH WAYS -- OK on success, ILLEGALFUNCTIONCALL on any failure -- so a caller
'' checking ERR afterwards sees a definite answer rather than a stale one.
function tkort_FileLenEx alias "fb_FileLenEx" ( byval filename as zstring ptr ) as int64

	dim as FILE ptr fp = fopen( filename, "rb" )
	if( fp <> 0 ) then
		if( tkrt_fseeko( fp, 0, 2 ) = 0 ) then          '' SEEK_END
			dim as int64 length = tkrt_ftello( fp )
			if( length <> -1 ) then
				fclose( fp )
				tkrt_ErrorSetNum( FB_RTERROR_OK )
				return length
			end if
		end if
		fclose( fp )
	end if

	tkrt_ErrorSetNum( FB_RTERROR_ILLEGALFUNCTIONCALL )
	return 0

end function

end extern

extern "rtlib"

function tkort_FileLen alias "fb_FileLen" ( byval filename as zstring ptr ) as int64
	return tkort_FileLenEx( filename )
end function

end extern
