'' printusg.tiko -- PRINT USING: ten entry points over one fbc member.
''
'' THE FORMAT STRING IS PARSED INCREMENTALLY AND STATEFULLY, one argument at a
'' time, out of a per-thread context. fb_PrintUsingInit stores the string;
'' every value entry point consumes as much of it as its own field needs; and
'' the literal text between fields is flushed by fb_PrintUsingFmtStr, which is
'' called BEFORE and AFTER each field. The format is NOT re-parsed per call,
'' and the cursor position between calls IS the state.
''
'' WHEN THE FORMAT RUNS OUT IT RESTARTS FROM THE BEGINNING. That is why a
'' single "###" formats every value in a list. The restart happens at the top
'' of each value entry point, not at the end of the previous one.
''
'' THE NUMERIC FORMATTER BUILDS ITS OUTPUT BACKWARDS, from the end of a 2049
'' byte buffer toward the front, because padding, the sign, the dollar and the
'' overflow '%' are all decided AFTER the digits are known. p starts at the end
'' and every emission decrements it; the result is the tail of the buffer.
''
'' EVERYTHING IS COMPUTED IN A 64-BIT INTEGER MANTISSA PLUS A DECIMAL EXPONENT.
'' No sprintf, no floating point in the formatting itself -- a double is
'' converted to (mantissa, exponent) once, by hand, and every subsequent
'' decision is integer arithmetic. That is what makes the output independent of
'' locale and of the two different printf implementations on Windows.
''
'' FREEBASIC IS CASE-INSENSITIVE, SO A LOCAL CANNOT SHADOW A CONSTANT.
'' In C the local `val_isneg` and the macro `VAL_ISNEG` are different names;
'' here they are the SAME name, and the local is reported as a duplicated
'' definition and then as "cannot modify a constant" at every assignment.
'' The three affected locals are isneg_, isfloat_ and issng_.
''
'' SEVERAL QB QUIRKS ARE REPRODUCED DELIBERATELY:
''   - a truncated "#INF"/"#NAN" text is padded from the string "$000", so a
''     one-digit field prints nothing rather than a plausible "1"
''   - the '%' overflow marker is added where QB would have silently produced
''     a wrong number
''   - a positive number with no explicit sign blanks its first digit, so
''     positives and negatives line up
''   - "&" for a BOOLEAN prints true/false through the same digit machinery,
''     using the mantissa as a placeholder for the character count

#include once "inc/descriptors.ti"
#include once "inc/print.ti"
#include once "inc/wstr.ti"
#include once "inc/rterror.ti"
#include once "inc/iolock.ti"
#include once "inc/sysbind.ti"

const BUFFERLEN   = 2048
const MIN_EXPDIGS = 3
const MAX_EXPDIGS = 5

'' The buffer minus everything that is not a digit: two '%', a sign, a dollar,
'' a decimal point, the exponent digits and the stray carets.
const MAX_DIGS = BUFFERLEN - 2 - 1 - 1 - 1 - MAX_EXPDIGS - (MIN_EXPDIGS - 1)

const CHAR_ZERO       = 48
const CHAR_DOT        = 46
const CHAR_COMMA      = 44
const CHAR_TOOBIG     = 37          '' '%'
const CHAR_PLUS       = 43
const CHAR_MINUS      = 45
const CHAR_STAR       = 42
const CHAR_DOLLAR     = 36
const CHAR_SPACE      = 32
const CHAR_WTF        = 33          '' '!' -- the buffer-underrun marker
const CHAR_EXP_SINGLE = 69          '' 'E'

const SNG_AUTODIGS = 7
const DBL_AUTODIGS = 15
const DBL_MAXDIGS  = 16

'' Packed ASCII, consumed one byte at a time by the digit loops. The digits of
'' the placeholder value stand in for these characters.
const CHARS_NAN   as uint64 = (35 shl 24) or (78 shl 16) or (65 shl 8) or 78     '' #NAN
const CHARS_INF   as uint64 = (35 shl 24) or (73 shl 16) or (78 shl 8) or 70     '' #INF
const CHARS_IND   as uint64 = (35 shl 24) or (73 shl 16) or (78 shl 8) or 68     '' #IND
'' The QB glitch: a truncated text "rounds up" into these characters.
const CHARS_TRUNC as uint64 = (36 shl 24) or (48 shl 16) or (48 shl 8) or 48     '' $000
const CHARS_TRUE  as uint64 = (116 shl 24) or (114 shl 16) or (117 shl 8) or 101
const CHARS_FALSE as uint64 = (102ull shl 32) or (97 shl 24) or (108 shl 16) or (115 shl 8) or 101

const VAL_ISNEG   = &h1
const VAL_ISINF   = &h2
const VAL_ISIND   = &h4
const VAL_ISNAN   = &h8
const VAL_ISFLOAT = &h10
const VAL_ISSNG   = &h20
const VAL_ISBOOL  = &h40

const FB_TLSKEY_PRINTUSG as int32 = 3

type FB_PRINTUSGCTX field = 1
	as int32        chars       '' C int
	as zstring ptr ptr_
	as FBSTRING    fmtstr
end type

extern "rtlib"
	declare function fb_TlsGetCtx alias "fb_TlsGetCtx" _
		( byval idx as int32, byval length as uinteger, byval dtor as any ptr ) as any ptr
	declare function tkrt_ErrorSetNum alias "fb_ErrorSetNum" ( byval errnum as int32 ) as int32
	declare function tkrt_StrAssign alias "fb_StrAssign" _
		( byval dst as any ptr, byval dst_size as integer, byval src as any ptr, _
		  byval src_size as integer, byval fillrem as int32 ) as int32
	declare sub tkrt_StrDelete alias "fb_StrDelete" ( byval s as FBSTRING ptr )
	declare function tkrt_DelTemp alias "fb_hStrDelTemp" ( byval s as FBSTRING ptr ) as int32
	declare sub tkrt_PrintFixString alias "fb_PrintFixString" _
		( byval fnum as int32, byval s as zstring ptr, byval mask as int32 )
	declare sub tkrt_PrintVoid alias "fb_PrintVoid" ( byval fnum as int32, byval mask as int32 )
	declare sub tkrt_PrintWstr alias "fb_PrintWstr" _
		( byval fnum as int32, byval s as wstring ptr, byval mask as int32 )
	declare sub tkrt_PrintUStr alias "fb_PrintUStr" _
		( byval fnum as int32, byval s as FBUSTRING ptr, byval mask as int32 )
end extern

'' fb_PRINTUSGCTX_Destructor is NULL in fbc -- the descriptor is freed by
'' fb_PrintUsingEnd, not by thread teardown.
private function hCtx( ) as FB_PRINTUSGCTX ptr
	return cptr( FB_PRINTUSGCTX ptr, _
		fb_TlsGetCtx( FB_TLSKEY_PRINTUSG, sizeof( FB_PRINTUSGCTX ), 0 ) )
end function

'' Powers of ten by squaring. n is 0..19; 10^19 still fits an unsigned 64.
private function hPow10( byval n as int32 ) as uint64
	dim as uint64 ret = 1, a = 10
	while( n > 0 )
		if( (n and 1) <> 0 ) then ret *= a
		a *= a
		n shr= 1
	wend
	return ret
end function

'' floor(log10(a)) for a > 0, and 0 for a = 0. The staircase of comparisons is
'' fbc's, and it is reproduced rather than replaced by a loop because the
'' result feeds digit counts that must agree exactly.
private function hLog10( byval a as uint64 ) as int32
	dim as int32 ret = 0, a32 = any
	dim as uint64 a64 = a

	while( a64 >= 100000000ull )
		a64 \= 100000000ull
		ret += 8
	wend

	a32 = cast( int32, a64 )
	if( a32 >= 10000 ) then ret += 4 else a32 *= 10000
	if( a32 >= 1000000 ) then ret += 2 else a32 *= 100
	if( a32 >= 10000000 ) then ret += 1

	return ret
end function

private function hNumDigits( byval a as uint64 ) as int32
	return hLog10( a ) + 1
end function

'' a / 10^n, ROUNDED HALF UP. The rounding is what makes a truncated field
'' round rather than chop, and it is applied at every scaling step.
private function hDivPow10( byval a as uint64, byval n as int32 ) as uint64
	dim as uint64 b = any, ret = any
	if( n > 19 ) then return 0
	b = hPow10( n )
	ret = a \ b
	if( (a mod b) >= ((b + 1) \ 2) ) then ret += 1
	return ret
end function

extern "rtlib"

'' Stores the format string and rewinds the cursor to its start.
function tkort_PrintUsingInit alias "fb_PrintUsingInit" ( byval fmtstr as FBSTRING ptr ) as int32
	dim as FB_PRINTUSGCTX ptr ctx = any

	TKORT_IOLOCK()
	ctx = hCtx( )
	'' -1 for both sizes: a var-len assignment, which takes ownership of the
	'' temp fmtstr rather than copying into a fixed buffer.
	tkrt_StrAssign( @ctx->fmtstr, -1, fmtstr, -1, 0 )
	ctx->ptr_ = ctx->fmtstr.data
	ctx->chars = FB_STRSIZE( @ctx->fmtstr )
	TKORT_IOUNLOCK()

	return tkrt_ErrorSetNum( FB_RTERROR_OK )
end function

end extern

'' Flushes the literal text up to the next FIELD, consuming it from the cursor.
''
'' THE FIELD DETECTION IS TWO AND THREE CHARACTERS DEEP, not one. A single '*'
'' or '$' is literal text; only "**" and "$$" begin a field. A '+' begins one
'' only when followed by '#', "$$", "**" or ".#". Deciding on the first
'' character alone would swallow every dollar sign in a format string.
''
'' '_' ESCAPES THE NEXT CHARACTER, so "_#" prints a '#' instead of starting a
'' numeric field -- and a trailing '_' with nothing after it prints itself.
private function hFmtStr( byval fnum as int32 ) as int32
	dim as FB_PRINTUSGCTX ptr ctx = hCtx( )
	dim as zstring * BUFFERLEN + 1 buffer = any
	dim as int32 c = any, nc = any, nnc = any, length = 0, doexit = any

	if( ctx->ptr_ = 0 ) then ctx->chars = 0

	while( (ctx->chars > 0) andalso (length < BUFFERLEN) )
		c = ctx->ptr_[0]
		if( ctx->chars > 1 ) then nc = ctx->ptr_[1] else nc = -1
		if( ctx->chars > 2 ) then nnc = ctx->ptr_[2] else nnc = -1

		doexit = 0
		select case c
		case 42                             '' '*' -- only "**" starts a field
			if( nc = 42 ) then doexit = 1
		case 36                             '' '$' -- only "$$"
			if( nc = 36 ) then doexit = 1
		case 43                             '' '+'
			if( nc = 35 ) then
				doexit = 1
			elseif( (nc = 36) andalso (nnc = 36) ) then
				doexit = 1
			elseif( (nc = 42) andalso (nnc = 42) ) then
				doexit = 1
			elseif( (nc = 46) andalso (nnc = 35) ) then
				doexit = 1
			end if
		case 33, 92, 38, 35                 '' '!'  '\'  '&'  '#'
			doexit = 1
		case 46                             '' '.' -- only ".#"
			if( nc = 35 ) then doexit = 1
		case 95                             '' '_' -- escape the next character
			if( ctx->chars > 1 ) then
				c = nc
				ctx->ptr_ += 1
				ctx->chars -= 1
			end if
		end select

		if( doexit ) then exit while

		buffer[length] = c
		length += 1

		ctx->ptr_ += 1
		ctx->chars -= 1
	wend

	if( length > 0 ) then
		buffer[length] = 0
		tkrt_PrintFixString( fnum, @buffer, 0 )
	end if

	return tkrt_ErrorSetNum( FB_RTERROR_OK )
end function

extern "rtlib"

'' Flushes any trailing literal text, then drops the format string.
function tkort_PrintUsingEnd alias "fb_PrintUsingEnd" ( byval fnum as int32 ) as int32
	dim as FB_PRINTUSGCTX ptr ctx = any

	hFmtStr( fnum )

	TKORT_IOLOCK()
	ctx = hCtx( )
	tkrt_StrDelete( @ctx->fmtstr )
	ctx->ptr_ = 0
	ctx->chars = 0
	TKORT_IOUNLOCK()

	return tkrt_ErrorSetNum( FB_RTERROR_OK )
end function

end extern

extern "rtlib"

'' The narrow string field. THREE FIELD SHAPES:
''   "!"      one character
''   "&"      the whole string, no padding
''   "\  \"   a fixed width -- TWO backslashes plus the spaces BETWEEN them,
''            so "\\" is width 2 and "\ \" is width 3
''
'' THE WIDTH IS COUNTED BY WALKING, not by searching for the closing '\'. The
'' scanner sets strchars = 1 on the opening backslash and increments it for
'' each following space; the closing backslash adds one more. A field made of
'' anything other than spaces between the backslashes is therefore not a field
'' at all, and falls through to literal text.
''
'' EMBEDDED NULs BECOME SPACES in the padded output. That is QB behaviour and
'' it is visible whenever a fixed-length string is shorter than its buffer.
function tkort_PrintUsingStr alias "fb_PrintUsingStr" _
	( byval fnum as int32, byval s as FBSTRING ptr, byval mask as int32 ) as int32

	dim as FB_PRINTUSGCTX ptr ctx = hCtx( )
	dim as zstring * BUFFERLEN + 1 buffer = any
	dim as int32 c = any, nc = any, strchars = any, doexit = any, i = any

	'' Restart when the format has been consumed -- this is what makes one
	'' field format a whole argument list.
	if( ctx->chars = 0 ) then
		ctx->ptr_ = ctx->fmtstr.data
		ctx->chars = FB_STRSIZE( @ctx->fmtstr )
	end if

	hFmtStr( fnum )

	strchars = -1

	if( ctx->ptr_ = 0 ) then ctx->chars = 0

	while( ctx->chars > 0 )
		c = ctx->ptr_[0]
		if( ctx->chars > 1 ) then nc = ctx->ptr_[1] else nc = -1

		doexit = 1
		select case c
		case 33                             '' '!'
			if( FB_STRSIZE( s ) >= 1 ) then
				buffer[0] = s->data[0]
			else
				buffer[0] = 32
			end if
			buffer[1] = 0
			tkrt_PrintFixString( fnum, @buffer, 0 )
			ctx->ptr_ += 1
			ctx->chars -= 1

		case 38                             '' '&'
			tkrt_PrintFixString( fnum, s->data, 0 )
			ctx->ptr_ += 1
			ctx->chars -= 1

		case 92                             '' '\'
			if( (strchars <> -1) orelse (nc = 32) orelse (nc = 92) ) then
				if( strchars > 0 ) then
					strchars += 1

					if( FB_STRSIZE( s ) < strchars ) then
						'' Shorter than the field: print it, then pad the
						'' remainder with spaces in a SECOND write.
						tkrt_PrintFixString( fnum, s->data, 0 )
						strchars -= FB_STRSIZE( s )
						for i = 0 to strchars - 1
							buffer[i] = 32
						next
						buffer[strchars] = 0
					else
						memcpy( @buffer, s->data, strchars )
						buffer[strchars] = 0
					end if

					'' NULs become spaces -- see the header.
					for i = 0 to strchars - 1
						if( buffer[i] = 0 ) then buffer[i] = 32
					next

					tkrt_PrintFixString( fnum, @buffer, 0 )
					ctx->ptr_ += 1
					ctx->chars -= 1
				else
					strchars = 1
					doexit = 0
				end if
			end if

		case 32                             '' ' ' -- widens an open field
			if( strchars > -1 ) then
				strchars += 1
				doexit = 0
			end if
		end select

		if( doexit ) then exit while

		ctx->ptr_ += 1
		ctx->chars -= 1
	wend

	hFmtStr( fnum )

	if( (mask and FB_PRINT_ISLAST) <> 0 ) then
		if( (mask and FB_PRINT_NEWLINE) <> 0 ) then
			tkrt_PrintVoid( fnum, FB_PRINT_NEWLINE )
		end if
		tkrt_StrDelete( @ctx->fmtstr )
	end if

	tkrt_DelTemp( s )

	return tkrt_ErrorSetNum( FB_RTERROR_OK )
end function

end extern

extern "rtlib"

'' The wide string field. Same grammar as the narrow one, but the field width
'' counts WCHARs, and the whole-string case hands the source pointer straight
'' to fb_PrintWstr rather than copying.
function tkort_PrintUsingWstr alias "fb_PrintUsingWstr" _
	( byval fnum as int32, byval s as wstring ptr, byval mask as int32 ) as int32

	dim as FB_PRINTUSGCTX ptr ctx = hCtx( )
	dim as wstring * BUFFERLEN + 1 buffer = any
	dim as int32 c = any, nc = any, strchars = any, doexit = any, i = any, length = any
	dim as uint32 wc = any

	if( ctx->chars = 0 ) then
		ctx->ptr_ = ctx->fmtstr.data
		ctx->chars = FB_STRSIZE( @ctx->fmtstr )
	end if

	hFmtStr( fnum )

	strchars = -1
	length = FB_WSTR_LEN( s )

	if( ctx->ptr_ = 0 ) then ctx->chars = 0

	while( ctx->chars > 0 )
		c = ctx->ptr_[0]
		if( ctx->chars > 1 ) then nc = ctx->ptr_[1] else nc = -1

		doexit = 1
		select case c
		case 33                             '' '!'
			if( length >= 1 ) then
				wc = s[0]                   '' through a ulong -- see inc/wstr.ti
				buffer[0] = wc
			else
				buffer[0] = 32
			end if
			buffer[1] = 0
			tkrt_PrintWstr( fnum, @buffer, 0 )
			ctx->ptr_ += 1
			ctx->chars -= 1

		case 38                             '' '&'
			tkrt_PrintWstr( fnum, s, 0 )
			ctx->ptr_ += 1
			ctx->chars -= 1

		case 92                             '' '\'
			if( (strchars <> -1) orelse (nc = 32) orelse (nc = 92) ) then
				if( strchars > 0 ) then
					strchars += 1

					if( length < strchars ) then
						tkrt_PrintWstr( fnum, s, 0 )
						strchars -= length
						for i = 0 to strchars - 1
							buffer[i] = 32
						next
						buffer[strchars] = 0
					else
						for i = 0 to strchars - 1
							wc = s[i]
							buffer[i] = wc
						next
						buffer[strchars] = 0
					end if

					for i = 0 to strchars - 1
						wc = buffer[i]
						if( wc = 0 ) then buffer[i] = 32
					next

					tkrt_PrintWstr( fnum, @buffer, 0 )
					ctx->ptr_ += 1
					ctx->chars -= 1
				else
					strchars = 1
					doexit = 0
				end if
			end if

		case 32
			if( strchars > -1 ) then
				strchars += 1
				doexit = 0
			end if
		end select

		if( doexit ) then exit while

		ctx->ptr_ += 1
		ctx->chars -= 1
	wend

	hFmtStr( fnum )

	if( (mask and FB_PRINT_ISLAST) <> 0 ) then
		if( (mask and FB_PRINT_NEWLINE) <> 0 ) then
			tkrt_PrintVoid( fnum, FB_PRINT_NEWLINE )
		end if
		tkrt_StrDelete( @ctx->fmtstr )
	end if

	'' NO TEMP DELETE, unlike the narrow form: wide temps are owned elsewhere.
	return tkrt_ErrorSetNum( FB_RTERROR_OK )
end function

end extern

'' Emit a run of code units through a STACK descriptor.
''
'' Wrapping the run and handing it to fb_PrintUStr keeps the encoding decision
'' -- a real Windows console takes the wide path, everything else gets UTF-8 --
'' in one place. The descriptor is NOT from the temp pool and its len carries
'' no temp bit, so nothing frees it.
private sub hPrintUnits( byval fnum as int32, byval p as FB_UCHAR ptr, byval units as integer )
	dim as FBUSTRING d = any
	d.data = p
	d.len = units
	d.size = units
	tkrt_PrintUStr( fnum, @d, 0 )
end sub

extern "rtlib"

'' The USTRING field. FIELD WIDTHS COUNT CODE UNITS.
''
'' THIS PARSES INTO AN FB_UCHAR BUFFER RATHER THAN DELEGATING to the narrow
'' form after a UTF-8 conversion, which would have been far less code. It
'' cannot: the narrow form counts BYTES, so "\   \" applied to five accented
'' characters would consume ten bytes of a five-unit field and truncate. Worse,
'' the truncation would depend on where the output was going, since only the
'' redirected path is UTF-8 -- the same program would format differently into a
'' file than onto a console.
function tkort_PrintUsingUStr alias "fb_PrintUsingUStr" _
	( byval fnum as int32, byval s as FBUSTRING ptr, byval mask as int32 ) as int32

	dim as FB_PRINTUSGCTX ptr ctx = hCtx( )
	dim as FB_UCHAR buffer(0 to BUFFERLEN)
	dim as FB_UCHAR ptr sptr = any
	dim as int32 c = any, nc = any, strchars = any, doexit = any, i = any
	dim as integer length = any

	if( ctx->chars = 0 ) then
		ctx->ptr_ = ctx->fmtstr.data
		ctx->chars = FB_STRSIZE( @ctx->fmtstr )
	end if

	hFmtStr( fnum )

	strchars = -1

	if( s = 0 ) then
		sptr = 0 : length = 0
	elseif( s->data = 0 ) then
		sptr = 0 : length = 0
	else
		sptr = s->data
		length = FB_USTRSIZE( s )
	end if

	if( ctx->ptr_ = 0 ) then ctx->chars = 0

	while( ctx->chars > 0 )
		c = ctx->ptr_[0]
		if( ctx->chars > 1 ) then nc = ctx->ptr_[1] else nc = -1

		doexit = 1
		select case c
		case 33                             '' '!'
			'' ONE CODE UNIT, so this can halve a surrogate pair. That is the
			'' same answer WSTRING gives on Windows and the same one MID
			'' gives here -- a property of UTF-16, not of this routine.
			if( length >= 1 ) then buffer(0) = sptr[0] else buffer(0) = 32
			buffer(1) = 0
			hPrintUnits( fnum, @buffer(0), 1 )
			ctx->ptr_ += 1
			ctx->chars -= 1

		case 38                             '' '&'
			hPrintUnits( fnum, sptr, length )
			ctx->ptr_ += 1
			ctx->chars -= 1

		case 92                             '' '\'
			if( (strchars <> -1) orelse (nc = 32) orelse (nc = 92) ) then
				if( strchars > 0 ) then
					strchars += 1

					if( length < strchars ) then
						hPrintUnits( fnum, sptr, length )
						strchars -= length
						for i = 0 to strchars - 1
							buffer(i) = 32
						next
					else
						for i = 0 to strchars - 1
							buffer(i) = sptr[i]
						next
					end if

					for i = 0 to strchars - 1
						if( buffer(i) = 0 ) then buffer(i) = 32
					next

					hPrintUnits( fnum, @buffer(0), strchars )
					ctx->ptr_ += 1
					ctx->chars -= 1
				else
					strchars = 1
					doexit = 0
				end if
			end if

		case 32
			if( strchars > -1 ) then
				strchars += 1
				doexit = 0
			end if
		end select

		if( doexit ) then exit while

		ctx->ptr_ += 1
		ctx->chars -= 1
	wend

	hFmtStr( fnum )

	if( (mask and FB_PRINT_ISLAST) <> 0 ) then
		if( (mask and FB_PRINT_NEWLINE) <> 0 ) then
			tkrt_PrintVoid( fnum, FB_PRINT_NEWLINE )
		end if
		tkrt_StrDelete( @ctx->fmtstr )
	end if

	return tkrt_ErrorSetNum( FB_RTERROR_OK )
end function

end extern

'' ------------------------------------------------------------------ number
''
'' hPrintNumber takes a value already decomposed into an unsigned 64-bit
'' MANTISSA and a decimal EXPONENT, plus flags. Everything below is integer
'' arithmetic on that pair.
''
'' THE BUFFER IS FILLED BACKWARDS. p starts past the end and every emission
'' decrements it, because the padding, sign, dollar and '%' are only decided
'' once the digits are known. ADD_CHAR guards against running off the front:
'' the guard writes '!' rather than corrupting memory, which is a visible
'' wrong answer instead of an invisible one.
#macro ADD_CHAR( c )
	scope
		if( p >= @buffer(0) ) then
			*p = cast( uint8, (c) )
			p -= 1
		elseif( p = @buffer(0) ) then
			*p = CHAR_WTF
		end if
	end scope
#endmacro

private function hPrintNumber( byval fnum as int32, byval val_ as uint64, _
                               byval val_exp as int32, byval flags as int32, _
                               byval mask as int32 ) as int32

	dim as FB_PRINTUSGCTX ptr ctx = hCtx( )
	dim as uint8 buffer(0 to BUFFERLEN)
	dim as uint8 ptr p = any
	dim as int32 val_digs = any, val_zdigs = any
	dim as uint64 val0 = any
	dim as int32 val_digs0 = any, val_exp0 = any
	dim as int32 isneg_ = any, isfloat_ = any, issng_ = any
	dim as int32 c = any, lc = any
	dim as int32 doexit = any, padchar = any, intdigs = any, decdigs = any, expdigs = any
	dim as int32 adddollar = any, addcommas = any, signatend = any, signatstart = any
	dim as int32 plussign = any, toobig = any
	dim as int32 intdigs2 = any, expsignchar = any, totdigs = any, decpoint = any
	dim as int32 isamp = any, i = any
	dim as uint64 chars_ = 0

	if( ctx->chars = 0 ) then
		ctx->ptr_ = ctx->fmtstr.data
		ctx->chars = FB_STRSIZE( @ctx->fmtstr )
	end if

	hFmtStr( fnum )

	padchar     = CHAR_SPACE
	intdigs     = 0
	decdigs     = -1            '' -1 means "no decimal point seen"
	expdigs     = 0
	adddollar   = 0
	addcommas   = 0
	signatend   = 0
	signatstart = 0
	plussign    = 0
	toobig      = 0
	isamp       = 0
	lc = -1

	if( ctx->ptr_ = 0 ) then ctx->chars = 0

	'' ---- parse the numeric field ----
	while( ctx->chars > 0 )
		'' A trailing sign or an '&' ends the field immediately.
		if( signatend orelse isamp ) then exit while

		c = ctx->ptr_[0]
		doexit = 0

		select case c
		case 35                             '' '#'
			if( expdigs <> 0 ) then
				doexit = 1
			elseif( decdigs <> -1 ) then
				decdigs += 1
			else
				intdigs += 1
			end if

		case 46                             '' '.'
			if( (decdigs <> -1) orelse (expdigs <> 0) ) then
				doexit = 1
			else
				decdigs = 0
			end if

		case 42                             '' '*'
			'' Two at the very start switch the padding to asterisks. The
			'' FIRST one also counts as a digit position, and so does the
			'' second -- "**#" is three positions wide, not one.
			if( (intdigs = 0) andalso (decdigs = -1) ) then
				padchar = CHAR_STAR
				intdigs += 1
			elseif( (intdigs = 1) andalso (lc = 42) ) then
				intdigs += 1
			else
				doexit = 1
			end if

		case 36                             '' '$'
			if( lc = 42 ) then
				'' "**$" -- the dollar follows the two asterisks.
				adddollar = 1
			elseif( (intdigs = 0) andalso (decdigs = -1) ) then
				if( adddollar = 0 ) then
					adddollar = 1
				else
					'' The SECOND '$' is a digit position; the first is not.
					intdigs += 1
				end if
			else
				doexit = 1
			end if

		case 44                             '' ','
			if( (decdigs <> -1) orelse (expdigs <> 0) ) then
				doexit = 1
			else
				addcommas = 1
				intdigs += 1
			end if

		case 43, 45                         '' '+' / '-'
			if( signatstart ) then
				doexit = 1
			elseif( (intdigs = 0) andalso (decdigs = -1) ) then
				if( c = 43 ) then plussign = 1
				signatstart = 1
			elseif( (expdigs = 0) orelse (expdigs >= MIN_EXPDIGS) ) then
				'' At the end -- but only when the carets so far are either
				'' none or a real exponent. Otherwise they are literal text.
				if( c = 43 ) then plussign = 1
				signatend = 1
			else
				doexit = 1
			end if

		case 94                             '' '^'
			if( expdigs < MAX_EXPDIGS ) then
				expdigs += 1
			else
				doexit = 1
			end if

		case 38                             '' '&' -- STR-like, natural form
			if( (intdigs = 0) andalso (decdigs = -1) andalso (signatstart = 0) ) then
				isamp = 1
			else
				doexit = 1
			end if

		case else
			doexit = 1
		end select

		if( doexit ) then exit while

		ctx->ptr_ += 1
		ctx->chars -= 1
		lc = c
	wend

	'' ---- classify the value ----
	isneg_ = iif( (flags and VAL_ISNEG) <> 0, 1, 0 )
	isfloat_ = iif( (flags and VAL_ISFLOAT) <> 0, 1, 0 )
	issng_ = iif( (flags and VAL_ISSNG) <> 0, 1, 0 )

	if( (flags and (VAL_ISINF or VAL_ISIND or VAL_ISNAN)) <> 0 ) then
		if( (flags and VAL_ISINF) <> 0 ) then
			chars_ = CHARS_INF
		elseif( (flags and VAL_ISIND) <> 0 ) then
			chars_ = CHARS_IND
		elseif( (flags and VAL_ISNAN) <> 0 ) then
			chars_ = CHARS_NAN
		end if
		'' 1.1234 is a PLACEHOLDER whose digits are replaced by the text
		'' above, one character per digit position. The value is never
		'' printed; only its shape matters.
		val_ = 11234
		val_exp = -4
	end if

	if( isamp andalso ((flags and VAL_ISBOOL) <> 0) ) then
		'' "&" on a BOOLEAN prints true/false through the same digit
		'' machinery, again using the mantissa only to count characters.
		if( val_ <> 0 ) then
			chars_ = CHARS_TRUE
			val_ = 1234
			isneg_ = 0
		else
			chars_ = CHARS_FALSE
			val_ = 12345
		end if
		val_exp = 0
	end if

	if( val_ <> 0 ) then val_digs = hNumDigits( val_ ) else val_digs = 0
	val_zdigs = 0

	'' ---- "&": choose the field from the VALUE, not the format ----
	if( isamp ) then
		if( issng_ ) then
			if( val_digs > SNG_AUTODIGS ) then
				val_ = hDivPow10( val_, val_digs - SNG_AUTODIGS )
				val_exp += val_digs - SNG_AUTODIGS
				val_digs = SNG_AUTODIGS
			end if

			if( val_ = 0 ) then
				val_digs = 0
				val_exp = -decdigs
			elseif( val_ = hPow10( val_digs ) ) then
				'' Rounding up carried into the next power of ten.
				val_ = 1
				val_exp += val_digs
				val_digs = 1
			end if
		end if

		if( isfloat_ ) then
			while( (val_digs > 1) andalso ((val_ mod 10) = 0) )
				val_ \= 10
				val_digs -= 1
				val_exp += 1
			wend
		end if

		if( val_digs + val_exp > 0 ) then
			intdigs = val_digs + val_exp
		else
			intdigs = 1
		end if

		if( val_exp < 0 ) then decdigs = -val_exp

		if( isfloat_ ) then
			'' Switch to scientific when fixed point would be unreasonable.
			if( (intdigs > 16) orelse (issng_ andalso (intdigs > 7)) orelse _
			    (val_digs + val_exp - 1 < -MIN_EXPDIGS) ) then
				intdigs = 1
				decdigs = val_digs - 1
				expdigs = 2 + hNumDigits( abs( val_digs + val_exp - 1 ) )
				if( expdigs < MIN_EXPDIGS + 1 ) then expdigs = MIN_EXPDIGS
			end if
		end if

		if( isneg_ ) then signatstart = 1
	end if

	'' Crop to what the buffer can hold, taking it out of the decimals first.
	if( intdigs + 1 + decdigs > MAX_DIGS ) then
		decdigs -= ((intdigs + 1 + decdigs) - MAX_DIGS)
		if( decdigs < -1 ) then
			intdigs -= (-1 - decdigs)
			decdigs = -1
		end if
	end if

	if( decdigs <= -1 ) then
		decpoint = 0
		decdigs = 0
	else
		decpoint = 1
	end if

	'' ---- emit, backwards ----
	p = @buffer(BUFFERLEN)
	ADD_CHAR( 0 )

	if( signatend ) then
		if( isneg_ ) then
			ADD_CHAR( CHAR_MINUS )
		else
			ADD_CHAR( iif( plussign, CHAR_PLUS, CHAR_SPACE ) )
		end if
	elseif( isneg_ andalso (signatstart = 0) ) then
		'' An implicit '-' STEALS A DIGIT POSITION, which is why a negative
		'' number in a "###" field has one fewer digit than a positive one.
		signatstart = 1
		intdigs -= 1
	end if

	'' ---- fixed point ----
	if( expdigs < MIN_EXPDIGS ) then
		'' Carets that never reached MIN_EXPDIGS are literal text, emitted
		'' here because the buffer is being filled from the right.
		while( expdigs > 0 )
			ADD_CHAR( 94 )                  '' '^'
			expdigs -= 1
		wend

		val0 = val_
		val_digs0 = val_digs
		val_exp0 = val_exp

		if( val_exp < -decdigs ) then
			'' Scale and ROUND so that val_exp reaches -decdigs exactly.
			val_exp += (-decdigs - val_exp0)
			val_digs -= (-decdigs - val_exp0)
			val_ = hDivPow10( val_, -decdigs - val_exp0 )

			if( val_ = 0 ) then
				val_digs = 0
				val_exp = -decdigs
			elseif( val_ = hPow10( val_digs ) ) then
				val_ = 1
				val_exp += val_digs
				val_digs = 1
			end if
		end if

		intdigs2 = val_digs + val_exp
		if( intdigs2 < 0 ) then intdigs2 = 0
		if( addcommas ) then intdigs2 += (intdigs2 - 1) \ 3

		'' Compare the two representations and take whichever needs fewer
		'' digits. MIN_EXPDIGS is the allowance for the exponent itself.
		if( intdigs2 > intdigs + MIN_EXPDIGS ) then
			expdigs = MIN_EXPDIGS
			toobig = 1
			val_ = val0
			val_digs = val_digs0
			val_exp = val_exp0
			val_zdigs = 0
		else
			if( intdigs2 > intdigs ) then
				'' Slightly too wide: widen the field and mark it with '%'
				'' rather than truncating the number.
				intdigs = intdigs2
				toobig = 1
			end if

			if( val_exp > -decdigs ) then
				'' Trailing zeroes implied by the exponent become explicit.
				val_zdigs = val_exp - -decdigs
				val_exp = -decdigs
			end if
		end if
	end if

	'' ---- floating point ----
	if( expdigs > 0 ) then
		addcommas = 0                       '' commas are unused in f-p form

		if( (intdigs = -1) orelse ((intdigs = 0) andalso (decdigs = 0)) ) then
			intdigs += 1
			'' QB could prepend two independent '%'s; one is enough.
			toobig = 1
		end if

		totdigs = intdigs + decdigs         '' the two are treated alike
		val_exp += decdigs                  '' move the point to the end

		'' A POSITIVE NUMBER WITH NO EXPLICIT SIGN BLANKS ITS FIRST DIGIT, so
		'' positives and negatives line up -- QB behaviour, and the reason a
		'' "&" value is exempt.
		if( (isamp = 0) andalso (isneg_ = 0) andalso _
		    (signatstart = 0) andalso (signatend = 0) ) then
			if( (intdigs >= 1) andalso (totdigs > 1) ) then totdigs -= 1
		end if

		if( val_ = 0 ) then
			val_exp = 0
			val_zdigs = decdigs
		elseif( val_digs < totdigs ) then
			val_zdigs = totdigs - val_digs
			val_exp -= val_zdigs
		elseif( val_digs > totdigs ) then
			val_ = hDivPow10( val_, val_digs - totdigs )
			val_exp += (val_digs - totdigs)
			val_digs = totdigs
			val_zdigs = 0
			if( val_ >= hPow10( val_digs ) ) then
				val_ \= 10
				val_exp += 1
			end if
		else
			val_zdigs = 0
		end if

		if( val_exp < 0 ) then
			expsignchar = CHAR_MINUS
			val_exp = -val_exp
		else
			expsignchar = CHAR_PLUS
		end if

		while( expdigs > 3 )
			ADD_CHAR( CHAR_ZERO + (val_exp mod 10) )
			val_exp \= 10
			expdigs -= 1
		wend

		if( val_exp > 9 ) then
			'' More exponent digits than the field allows. QB cropped these;
			'' fbc emits them all and adds a '%'.
			do
				ADD_CHAR( CHAR_ZERO + (val_exp mod 10) )
				val_exp \= 10
			loop while( val_exp > 9 )
			ADD_CHAR( CHAR_ZERO + val_exp )
			ADD_CHAR( CHAR_TOOBIG )
		else
			ADD_CHAR( CHAR_ZERO + val_exp )
		end if

		expdigs -= 1
		ADD_CHAR( expsignchar )
		ADD_CHAR( CHAR_EXP_SINGLE )         '' QB used 'D' for doubles
		expdigs -= 2
	end if

	'' INF/IND/NAN whose text does not fit the field.
	if( (chars_ <> 0) andalso (val_digs < 5) andalso ((flags and VAL_ISBOOL) = 0) ) then
		'' QB would not add the '%', and "#" would then print an
		'' innocent-looking "1". QB also corrupted the string data when
		'' truncated, so deviating here is deliberate.
		toobig = 1
		if( val_digs > 1 ) then
			chars_ = CHARS_TRUNC shr (8 * (5 - val_digs))
		else
			chars_ = 0
		end if
	end if

	'' ---- decimals ----
	if( decpoint ) then
		while( decdigs > 0 )
			if( val_zdigs > 0 ) then
				ADD_CHAR( CHAR_ZERO )
				val_zdigs -= 1
			elseif( val_digs > 0 ) then
				if( chars_ <> 0 ) then
					'' One character of "#INF"/"true"/... per digit position.
					ADD_CHAR( chars_ and &hff )
					chars_ shr= 8
				else
					ADD_CHAR( CHAR_ZERO + cast( int32, val_ mod 10 ) )
				end if
				val_ \= 10
				val_digs -= 1
			else
				ADD_CHAR( CHAR_ZERO )
			end if
			decdigs -= 1
		wend
		ADD_CHAR( CHAR_DOT )
	end if

	'' ---- integer part ----
	'' The comma test is `(i and 3) = 3`, NOT `i mod 3`, because i counts
	'' emitted positions INCLUDING the commas themselves -- every fourth
	'' position is a comma, which is every third digit.
	i = 0
	do
		if( addcommas andalso ((i and 3) = 3) andalso (val_digs > 0) ) then
			ADD_CHAR( CHAR_COMMA )
		elseif( val_zdigs > 0 ) then
			ADD_CHAR( CHAR_ZERO )
			val_zdigs -= 1
		elseif( val_digs > 0 ) then
			if( chars_ <> 0 ) then
				ADD_CHAR( chars_ and &hff )
				chars_ shr= 8
			else
				ADD_CHAR( CHAR_ZERO + cast( int32, val_ mod 10 ) )
			end if
			val_ \= 10
			val_digs -= 1
		else
			'' A field with at least one position always shows a leading 0.
			if( (i = 0) andalso (intdigs > 0) ) then
				ADD_CHAR( CHAR_ZERO )
			else
				exit do
			end if
		end if
		i += 1
		intdigs -= 1
	loop

	'' Block form, not single-line: ADD_CHAR expands to a SCOPE, which a
	'' single-line IF cannot contain -- the error lands on the function's
	'' `end function` as "expected END IF", thirty lines away.
	if( adddollar ) then
		ADD_CHAR( CHAR_DOLLAR )
	end if

	if( signatstart ) then
		if( isneg_ ) then
			ADD_CHAR( CHAR_MINUS )
		else
			'' padchar, not a space: under "**" a positive sign position is
			'' filled with an asterisk.
			ADD_CHAR( iif( plussign, CHAR_PLUS, padchar ) )
		end if
	end if

	while( intdigs > 0 )
		ADD_CHAR( padchar )
		intdigs -= 1
	wend

	while( toobig > 0 )
		ADD_CHAR( CHAR_TOOBIG )
		toobig -= 1
	wend

	'' p points one BELOW the first character written, so step forward once.
	p += 1
	tkrt_PrintFixString( fnum, cptr( zstring ptr, p ), 0 )

	hFmtStr( fnum )

	if( (mask and (FB_PRINT_NEWLINE or FB_PRINT_PAD)) <> 0 ) then
		tkrt_PrintVoid( fnum, mask and (FB_PRINT_NEWLINE or FB_PRINT_PAD) )
	end if

	if( (mask and FB_PRINT_ISLAST) <> 0 ) then
		tkrt_StrDelete( @ctx->fmtstr )
	end if

	return tkrt_ErrorSetNum( FB_RTERROR_OK )
end function

'' ------------------------------------------------- double -> (mantissa, exp)
''
'' IEEE-754 BY HAND, NOT log10/pow. Pulling the exponent and mantissa out of
'' the bits and then walking the binary exponent down to zero -- multiplying by
'' 5 when there is headroom, dividing by 5 when there is not -- keeps every
'' step exact in 64 bits. The obvious floating-point route (log10 then pow)
'' loses a digit at the extremes and would make the answer depend on the host's
'' libm.
private function hScaleDoubleToULL( byval value as float64, byval pval_exp as int32 ptr ) as uint64
	dim as uint64 val_ull = any
	dim as int32 digs = any, pow2 = any, pow10 = any, scale = any

	val_ull = *cptr( uint64 ptr, @value )
	pow2 = cast( int32, (val_ull shr 52) and &h7ff ) - 1023
	val_ull and= (1ull shl 52) - 1

	if( pow2 > -1023 ) then
		val_ull or= (1ull shl 52)           '' normalised: restore the hidden bit
	else
		pow2 += 1                           '' denormal: no hidden bit
	end if
	pow2 -= 52

	pow10 = 0

	while( pow2 > 0 )
		if( val_ull < (1ull shl 63) ) then
			val_ull *= 2
			pow2 -= 1
		else
			'' No headroom to double, so divide by 5 and count a power of ten
			'' instead. Rounded to nearest; val_ull is far larger than 3, so
			'' the -3 cannot underflow.
			val_ull = (val_ull - 3) \ 5 + 1
			pow10 += 1
			pow2 -= 1
		end if
	wend

	while( pow2 < 0 )
		if( val_ull <= &h3333333333333333ull ) then
			val_ull *= 5                    '' headroom: keep the precision
			pow10 -= 1
			pow2 += 1
		else
			'' Halve, rounding to EVEN -- not half-up, which would bias every
			'' value that lands exactly between two representations.
			val_ull = val_ull \ 2 + (val_ull and (val_ull \ 2) and 1)
			pow2 += 1
		end if
	wend

	digs = hNumDigits( val_ull )
	if( digs > DBL_MAXDIGS ) then
		scale = digs - DBL_MAXDIGS
		val_ull = hDivPow10( val_ull, scale )
		pow10 += scale
	end if

	*pval_exp = pow10
	return val_ull
end function

'' The IEEE predicates, over the bit pattern rather than over comparisons: a
'' comparison with NaN is false in both directions and would classify it as
'' neither negative nor positive.
private function hBits( byval d as float64 ) as int64
	return *cptr( int64 ptr, @d )
end function

private function hIsNeg( byval d as float64 ) as int32
	'' THE SIGN BIT, not `d < 0`: this reports -0.0 as negative, which is what
	'' makes PRINT USING emit "-0" for it.
	if( hBits( d ) < 0 ) then return 1
	return 0
end function

private function hIsZero( byval d as float64 ) as int32
	if( (hBits( d ) and &h7fffffffffffffffll) = 0 ) then return 1
	return 0
end function

private function hIsFinite( byval d as float64 ) as int32
	if( (hBits( d ) and &h7ff0000000000000ll) < &h7ff0000000000000ll ) then return 1
	return 0
end function

private function hIsInf( byval d as float64 ) as int32
	if( (hBits( d ) and &h7fffffffffffffffll) = &h7ff0000000000000ll ) then return 1
	return 0
end function

'' The x87 "indefinite" NaN specifically -- a distinct output from a plain NaN.
private function hIsInd( byval d as float64 ) as int32
	if( hBits( d ) = cast( int64, &hfff8000000000000ull ) ) then return 1
	return 0
end function

private function hIsNan( byval d as float64 ) as int32
	if( hIsFinite( d ) orelse hIsInf( d ) orelse hIsInd( d ) ) then return 0
	return 1
end function

extern "rtlib"

function tkort_PrintUsingDouble alias "fb_PrintUsingDouble" _
	( byval fnum as int32, byval value as float64, byval mask as int32 ) as int32
	dim as int32 val_exp = 0, flags = VAL_ISFLOAT
	dim as uint64 val_ull = 1

	if( hIsNeg( value ) ) then flags or= VAL_ISNEG

	if( hIsZero( value ) ) then
		val_ull = 0
		val_exp = 0
	elseif( hIsFinite( value ) ) then
		value = abs( value )
		val_ull = hScaleDoubleToULL( value, @val_exp )
	else
		if( hIsInf( value ) ) then
			flags or= VAL_ISINF
		elseif( hIsInd( value ) ) then
			flags or= VAL_ISIND
		elseif( hIsNan( value ) ) then
			flags or= VAL_ISNAN
		end if
	end if

	return hPrintNumber( fnum, val_ull, val_exp, flags, mask )
end function

'' SINGLE goes through the SAME double scaler -- the difference is only the
'' VAL_ISSNG flag, which caps "&" at 7 significant digits.
function tkort_PrintUsingSingle alias "fb_PrintUsingSingle" _
	( byval fnum as int32, byval value_f as float32, byval mask as int32 ) as int32
	dim as int32 val_exp = 0, flags = VAL_ISFLOAT or VAL_ISSNG
	dim as uint64 val_ull = 1
	dim as float64 value = cdbl( value_f )

	if( hIsNeg( value ) ) then flags or= VAL_ISNEG

	if( hIsZero( value ) ) then
		val_ull = 0
		val_exp = 0
	elseif( hIsFinite( value ) ) then
		value = abs( value )
		val_ull = hScaleDoubleToULL( value, @val_exp )
	else
		if( hIsInf( value ) ) then
			flags or= VAL_ISINF
		elseif( hIsInd( value ) ) then
			flags or= VAL_ISIND
		elseif( hIsNan( value ) ) then
			flags or= VAL_ISNAN
		end if
	end if

	return hPrintNumber( fnum, val_ull, val_exp, flags, mask )
end function

function tkort_PrintUsingULongint alias "fb_PrintUsingULongint" _
	( byval fnum as int32, byval value_ull as uint64, byval mask as int32 ) as int32
	return hPrintNumber( fnum, value_ull, 0, 0, mask )
end function

function tkort_PrintUsingLongint alias "fb_PrintUsingLongint" _
	( byval fnum as int32, byval val_ll as int64, byval mask as int32 ) as int32
	dim as int32 flags = any
	dim as uint64 val_ull = any

	if( val_ll < 0 ) then
		flags = VAL_ISNEG
		'' Negating LLONG_MIN overflows as a signed value; the unsigned
		'' result is still the right magnitude.
		val_ull = cast( uint64, -val_ll )
	else
		flags = 0
		val_ull = cast( uint64, val_ll )
	end if

	return hPrintNumber( fnum, val_ull, 0, flags, mask )
end function

'' VAL_ISNEG on TRUE is not a sign -- it is how the "&" path above tells the
'' two words apart before it overwrites the mantissa.
function tkort_PrintUsingBoolean alias "fb_PrintUsingBoolean" _
	( byval fnum as int32, byval val_ as int8, byval mask as int32 ) as int32
	dim as int32 flags = VAL_ISBOOL
	dim as uint64 val_ull = any

	if( val_ <> 0 ) then
		flags or= VAL_ISNEG
		val_ull = 1ull
	else
		val_ull = 0ull
	end if

	return hPrintNumber( fnum, val_ull, 0, flags, mask )
end function

end extern
