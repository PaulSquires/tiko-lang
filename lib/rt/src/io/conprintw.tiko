'' conprintw.tiko -- fb_ConsolePrintBufferWstr, fb_ConsolePrintBufferWstrEx and
'' (Windows only) fb_hConsoleStreamOutW: the bottom of every wide PRINT. Three
'' symbols on Windows, two on POSIX, one fbc member (io_printbuff_wstr.o).
''
'' THE TWO PLATFORMS ARE BOTH HERE, unlike the narrow pair, because the POSIX
'' half is forty lines and does not deserve a file. They still share nothing:
''
''   Windows  the same three-path structure as src/io/conprintwin.tiko --
''            redirected, UTF-16 stream, cells -- with the W forms of every
''            console call. This half is where fb_hConsoleStreamOutW itself
''            lives, so the narrow file calls INTO this one.
''   POSIX    convert to UTF-8, wrap in the ISO-2022 escape, fputs it, and
''            track the cursor by hand.
''
'' THE STREAM PATH IS THE POINT OF THIS FILE. The cell path spends exactly one
'' cell per CHARACTER, which is right for Latin text and wrong for every
'' double-width glyph: CJK text overlapped its neighbour because the runtime
'' advanced one cell where the font painted two. WriteConsoleW is the API that
'' knows how wide a character is, so when the geometry permits, the text is
'' handed to the console as a stream and the console owns wrapping, scrolling,
'' tab stops and the cursor.
''
'' IT REFUSES IN EXACTLY TWO CASES, and both are real rather than caution:
''
''   VIEW PRINT   confines output to a sub-rectangle and scrolls only that band.
''                A stream write cannot be told about a rectangle -- the console
''                would wrap at the buffer edge and scroll the whole screen.
''   a window narrower than the buffer
''                the console wraps at the BUFFER's right edge and the runtime
''                at the WINDOW's. Only when the two coincide do they agree.
''
'' AND IT SETTLES THE DEFERRED SCROLL FIRST. The cell path parks the cursor on
'' the last cell of a line it filled exactly, remembering the scroll it owes in
'' __fb_con.scrollWasOff. Handing the cursor to the console with that debt
'' outstanding starts the stream on the wrong row, so FB_CON_CORRECT_POSITION's
'' zero-length FORCE_ADJUST print is issued before the first WriteConsoleW.
''
'' POSIX: THE SHADOW IS NARROW AND THE OUTPUT IS NOT. __fb_con.char_buffer is a
'' byte per cell, so the wide text is converted twice -- once with
'' fb_wstr_ConvToA into the shadow (lossily, clipped to the cells left on
'' screen) and once with fb_WCharToUTF into the bytes actually written. fbc's
'' own comment calls the narrow shadow a FIXME; it is reproduced, not fixed.
''
'' alloca IS REPLACED BY malloc/free, as in src/io/conprintwin.tiko, and with the
'' same consequence: alloca cannot fail and malloc can. On POSIX a failed
'' allocation falls back to the uninitialised-console path (a plain fwrite),
'' which prints the text without updating the shadow -- fbc has no such branch
'' because it cannot reach it.

#include once "inc/descriptors.ti"
#include once "inc/console.ti"
#include once "inc/conhooks.ti"
#include once "inc/iolock.ti"
#include once "inc/print.ti"
#include once "inc/file.ti"
#include once "inc/sysbind.ti"

extern "c"   '' NON-FBCALL: rtlib internals, all declared plain.
	declare function tkrt_wstr_ConvToA alias "fb_wstr_ConvToA" _
		( byval dst as zstring ptr, byval dst_chars as integer, byval src as wstring ptr ) as integer
	declare function tkrt_WCharToUTF alias "fb_WCharToUTF" _
		( byval encod as int32, byval src as wstring ptr, byval chars as integer, _
		  byval dst as zstring ptr, byval bytes as integer ptr ) as zstring ptr
end extern

'' THE LENGTH OF A wstring, COUNTED HERE. fb_wstr_Len is a `static __inline__`
'' in fb_unicode.h and the archive exports no symbol for it, so binding it as a
'' function compiles and archives cleanly and then fails to link -- the trap it
'' sprang once already.
private function tkort_wlen( byval s as wstring ptr ) as uinteger
	if( s = nullptr ) then return 0
	dim as uinteger n = 0
	while( s[n] <> 0 )
		n += 1
	wend
	return n
end function

#ifdef __FB_WIN32__

'' ======================================================================= WIN32

'' CHAR_INFO and SMALL_RECT, as in src/io/conprintwin.tiko. Declared again rather
'' than shared through a header because each is four lines and the narrow file's
'' copy stores a BYTE in the union where this one stores a WCHAR -- naming one
'' type for both would hide that.
type TKORT_CHARINFOW
	as uint16 ch
	as uint16 attr
end type

#assert sizeof( TKORT_CHARINFOW ) = 4

type TKORT_SMALLRECTW
	as int16 Left_, Top_, Right_, Bottom_
end type

#assert sizeof( TKORT_SMALLRECTW ) = 8

type TKORT_PRINTINFOW
	as fb_Rect  rWindow
	as fb_Coord BufferSize
	as uint16   wAttributes
	as any ptr  hOutput
	as int32     fViewSet
end type

extern "c"   '' NON-FBCALL: kernel32 imports, not rtlib entry points.
	declare function w_WriteFile stdcall alias "WriteFile" _
		( byval h as any ptr, byval buf as any ptr, byval n as uint32, _
		  byval wrote as uint32 ptr, byval ov as any ptr ) as int32
	declare function w_WriteConsoleW stdcall alias "WriteConsoleW" _
		( byval h as any ptr, byval buf as any ptr, byval n as uint32, _
		  byval wrote as uint32 ptr, byval reserved as any ptr ) as int32
	declare function w_WriteConsoleOutputW stdcall alias "WriteConsoleOutputW" _
		( byval h as any ptr, byval buf as any ptr, byval size_ as uint32, _
		  byval pos as uint32, byval region as any ptr ) as int32
	declare function w_ScrollConsoleScreenBufferW stdcall alias "ScrollConsoleScreenBufferW" _
		( byval h as any ptr, byval scroll_ as any ptr, byval clip as any ptr, _
		  byval dest as uint32, byval fill as any ptr ) as int32
	declare function w_FillConsoleOutputAttribute stdcall alias "FillConsoleOutputAttribute" _
		( byval h as any ptr, byval attr as uint16, byval n as uint32, _
		  byval c as uint32, byval got as uint32 ptr ) as int32
	declare function w_FillConsoleOutputCharacterW stdcall alias "FillConsoleOutputCharacterW" _
		( byval h as any ptr, byval ch as uint16, byval n as uint32, _
		  byval c as uint32, byval got as uint32 ptr ) as int32
	declare function w_SetConsoleWindowInfo stdcall alias "SetConsoleWindowInfo" _
		( byval h as any ptr, byval absolute as int32, byval rect as any ptr ) as int32
end extern

extern "c"   '' NON-FBCALL: rtlib internals, all declared plain.
	declare sub tkrt_ConsoleGetView alias "fb_ConsoleGetView" _
		( byval top_ as int32 ptr, byval bot as int32 ptr )
	declare sub tkrt_ConPrintTTYWstr alias "fb_ConPrintTTYWstr" _
		( byval handle as fb_ConHooks ptr, byval pachText as wstring ptr, _
		  byval TextLength as uinteger, byval is_text_mode as int32 )
	declare sub tkrt_ConsolePrintBufferEx alias "fb_ConsolePrintBufferEx" _
		( byval buffer as any ptr, byval length_ as uinteger, byval mask as int32 )
end extern

'' ---------------------------------------------------------------- the hooks
''
'' Byte-for-byte the narrow file's pair with the W console calls substituted.
'' They are `static` in fbc and file-local here.

private sub tkort_HookConScrollW cdecl _
	( byval handle as fb_ConHooks ptr, byval x1 as int32, byval y1 as int32, _
	  byval x2 as int32, byval y2 as int32, byval rows as int32 )

	dim as TKORT_PRINTINFOW ptr pInfo = cast( TKORT_PRINTINFOW ptr, handle->Opaque )
	dim as any ptr hnd = pInfo->hOutput
	dim as int32 iBufferHeight = any, iScrollHeight = any
	dim as int32 iClearFrom = any, iClearTo = any, iClearPos = any
	dim as TKORT_SMALLRECTW srScroll
	dim as int32 destX = any, destY = any

	if( pInfo->fViewSet = 0 ) then
		'' Slide the window down while there are unused rows below; only then
		'' does the screen buffer itself have to move.
		if( (handle->Border.Bottom_ + 1) < pInfo->BufferSize.Y_ ) then
			dim as int32 remaining_ = pInfo->BufferSize.Y_ - handle->Border.Bottom_ - 1
			dim as int32 move_size = iif( remaining_ < rows, remaining_, rows )

			handle->Border.Top_ += move_size
			handle->Border.Bottom_ += move_size

			rows -= move_size
			if( rows = 0 ) then exit sub
		end if

		destX = 0 : destY = 0
		srScroll.Right_ = cast( int16, pInfo->BufferSize.X_ - 1 )
		srScroll.Bottom_ = cast( int16, pInfo->BufferSize.Y_ - 1 )
		iBufferHeight = pInfo->BufferSize.Y_
	else
		destX = handle->Border.Left_
		destY = handle->Border.Top_
		srScroll.Right_ = cast( int16, handle->Border.Right_ )
		srScroll.Bottom_ = cast( int16, handle->Border.Bottom_ )
		iBufferHeight = handle->Border.Bottom_ - handle->Border.Top_ + 1
	end if

	if( iBufferHeight <= rows ) then
		'' Nothing survives a scroll of the whole height: clear rather than
		'' move, and srScroll.Left_/Top_ are never read.
		iClearFrom = handle->Border.Top_
		iClearTo = handle->Border.Bottom_ + 1
	else
		dim as TKORT_CHARINFOW FillChar

		srScroll.Left_ = cast( int16, destX )
		srScroll.Top_ = cast( int16, destY + rows )

		iScrollHeight = srScroll.Bottom_ - srScroll.Top_ + 1
		if( iScrollHeight < rows ) then
			iClearFrom = destY + iScrollHeight
			iClearTo = srScroll.Bottom_ + 1
		else
			iClearFrom = 0 : iClearTo = 0
		end if

		FillChar.attr = pInfo->wAttributes
		FillChar.ch = 32

		w_ScrollConsoleScreenBufferW( hnd, @srScroll, nullptr, _
		                              TKORT_COORD( destX, destY ), @FillChar )
	end if

	if( iClearFrom <> iClearTo ) then
		dim as int16 cx1 = cast( int16, handle->Border.Left_ )
		dim as uint16 attr = pInfo->wAttributes
		dim as uint32 width_ = handle->Border.Right_ - cx1 + 1
		dim as uint32 written = any

		iClearPos = iClearFrom
		while( iClearPos <> iClearTo )
			w_FillConsoleOutputAttribute( hnd, attr, width_, _
			                              TKORT_COORD( cx1, iClearPos ), @written )
			w_FillConsoleOutputCharacterW( hnd, 32, width_, _
			                               TKORT_COORD( cx1, iClearPos ), @written )
			iClearPos += 1
		wend
	end if

	handle->Coord_.Y_ = handle->Border.Bottom_
end sub

private function tkort_HookConWriteW cdecl _
	( byval handle as fb_ConHooks ptr, byval buffer as any ptr, _
	  byval length_ as uinteger ) as int32

	dim as TKORT_PRINTINFOW ptr pInfo = cast( TKORT_PRINTINFOW ptr, handle->Opaque )
	dim as any ptr hnd = pInfo->hOutput
	dim as wstring ptr pachText = cast( wstring ptr, buffer )
	dim as uint16 wAttributes = pInfo->wAttributes
	dim as TKORT_SMALLRECTW srWriteRegion
	dim as int32 result_ = any

	'' malloc, NOT alloca -- see the file header.
	dim as TKORT_CHARINFOW ptr lpBuffer = _
		cast( TKORT_CHARINFOW ptr, malloc( sizeof( TKORT_CHARINFOW ) * length_ ) )
	if( lpBuffer = nullptr ) then return 0

	srWriteRegion.Left_ = cast( int16, handle->Coord_.X_ )
	srWriteRegion.Top_ = cast( int16, handle->Coord_.Y_ )
	srWriteRegion.Right_ = cast( int16, handle->Coord_.X_ + length_ - 1 )
	srWriteRegion.Bottom_ = cast( int16, handle->Coord_.Y_ )

	'' GUARDED, because FreeBASIC's FOR is not C's. C's `for( i=0; i!=length; ++i )`
	'' does nothing when length is 0; `for i = 0 to length_ - 1` over an UNSIGNED
	'' counter would wrap to 0xFFFF... and run essentially forever. The console
	'' call still happens, exactly as it does in fbc, with an empty region.
	if( length_ <> 0 ) then
		for i as uinteger = 0 to length_ - 1
			lpBuffer[i].attr = wAttributes
			lpBuffer[i].ch = pachText[i]
		next
	end if

	result_ = w_WriteConsoleOutputW( hnd, lpBuffer, _
	                                 TKORT_COORD( length_, 1 ), _
	                                 TKORT_COORD( 0, 0 ), _
	                                 @srWriteRegion )
	free( lpBuffer )
	return result_
end function

'' ------------------------------------------------------------- the stream path

extern "c"   '' NON-FBCALL: declared plain in win32/fb_private_console.h, and
             '' the archive agrees -- no @N on win32.

'' Returns FALSE when the caller must fall back to the cell path. See the file
'' header for the two cases and why each is real.
function tkort_hConsoleStreamOutW alias "fb_hConsoleStreamOutW" _
	( byval text as wstring ptr, byval chars as uinteger ) as int32

	dim as uint8 sbi( 0 to CSBI_SIZE_ - 1 ) = any
	dim as any ptr hnd = TKORT_OUT_HANDLE()
	dim as int32 view_top = any, view_bottom = any
	dim as int32 win_left = any, win_top = any, win_cols = any, win_rows = any
	dim as uint32 written = any
	dim as uinteger remaining_ = chars
	dim as wstring ptr p = text

	if( (text = nullptr) orelse (chars = 0) ) then return 0

	if( w_GetConsoleScreenBufferInfo( hnd, @sbi(0) ) = 0 ) then return 0

	tkrt_ConsoleGetView( @view_top, @view_bottom )
	tkrt_hConsoleGetWindow( @win_left, @win_top, @win_cols, @win_rows )

	'' VIEW PRINT active -- the console cannot be told about a sub-rectangle.
	if( (view_top <> 1) orelse (view_bottom <> win_rows) ) then return 0

	'' The window's right edge and the buffer's must coincide, or the two
	'' disagree about where a line wraps.
	if( (win_left <> 0) orelse _
	    (win_cols <> cast( int32, *cptr( int16 ptr, @sbi(CSBI_DWSIZE_X_) ) )) ) then return 0

	'' SETTLE THE DEFERRED SCROLL before handing the cursor over. This is
	'' FB_CON_CORRECT_POSITION, spelled out.
	if( TKORT_CON_SCROLLOFF() <> 0 ) then
		tkrt_ConsolePrintBufferEx( nullptr, 0, FB_PRINT_FORCE_ADJUST )
	end if

	while( remaining_ <> 0 )
		if( w_WriteConsoleW( hnd, p, remaining_, @written, nullptr ) = 0 ) then exit while
		'' A successful call that wrote nothing would loop forever.
		if( written = 0 ) then exit while
		p += written
		remaining_ -= written
	wend

	tkrt_hUpdateConsoleWindow( )

	return 1
end function

'' ------------------------------------------------------------- the two exports

sub tkort_ConsolePrintBufferWstrEx alias "fb_ConsolePrintBufferWstrEx" _
	( byval buffer as wstring ptr, byval chars as uinteger, byval mask as int32 )

	dim as wstring ptr pachText = buffer
	dim as uinteger nchars = chars
	dim as int32 win_left = any, win_top = any, win_cols = any, win_rows = any
	dim as int32 view_top = any, view_bottom = any
	dim as TKORT_PRINTINFOW info
	dim as fb_ConHooks hooks

	if( (mask and FB_PRINT_FORCE_ADJUST) = 0 ) then
		if( nchars = 0 ) then exit sub
	end if

	TKORT_IOLOCK()

	'' REDIRECTED: the UTF-16 code units go out as RAW BYTES, not converted --
	'' a wide PRINT into a pipe produces a UTF-16LE stream with no BOM.
	if( TKORT_CON_WINDOW_EMPTY() ) then
		dim as uint32 dwBytesWritten = any
		dim as uint32 bytes_ = nchars * 2
		dim as uint8 ptr pb = cast( uint8 ptr, pachText )

		while( bytes_ <> 0 )
			if( w_WriteFile( TKORT_OUT_HANDLE(), pb, bytes_, @dwBytesWritten, nullptr ) = 0 ) then
				exit while
			end if
			'' fbc advances the WIDE pointer by a BYTE count here, which
			'' overshoots by a factor of two on any short write. Reproduced:
			'' WriteFile to a pipe or a file does not short-write in practice,
			'' so the defect is unreachable, and diverging would be a rewrite.
			pb += dwBytesWritten * 2
			bytes_ -= dwBytesWritten
		wend

		TKORT_IOUNLOCK()
		exit sub
	end if

	'' THE STREAM PATH, if the geometry allows it. See the file header.
	if( tkort_hConsoleStreamOutW( pachText, nchars ) <> 0 ) then
		TKORT_IOUNLOCK()
		exit sub
	end if

	tkrt_ConsoleGetView( @view_top, @view_bottom )
	tkrt_hConsoleGetWindow( @win_left, @win_top, @win_cols, @win_rows )

	hooks.Opaque         = @info
	hooks.Scroll_        = @tkort_HookConScrollW
	hooks.Write_         = @tkort_HookConWriteW
	hooks.Border.Left_   = win_left
	hooks.Border.Top_    = win_top + view_top - 1
	hooks.Border.Right_  = win_left + win_cols - 1
	hooks.Border.Bottom_ = win_top + view_bottom - 1

	info.hOutput         = TKORT_OUT_HANDLE()
	info.rWindow.Left_   = win_left
	info.rWindow.Top_    = win_top
	info.rWindow.Right_  = win_left + win_cols - 1
	info.rWindow.Bottom_ = win_top + win_rows - 1
	info.fViewSet        = iif( (hooks.Border.Top_ <> info.rWindow.Top_) orelse _
	                            (hooks.Border.Bottom_ <> info.rWindow.Bottom_), 1, 0 )

	scope
		dim as uint8 screen_info( 0 to CSBI_SIZE_ - 1 ) = any

		if( w_GetConsoleScreenBufferInfo( TKORT_OUT_HANDLE(), @screen_info(0) ) = 0 ) then
			hooks.Coord_.X_ = hooks.Border.Left_
			hooks.Coord_.Y_ = hooks.Border.Top_
			info.BufferSize.X_ = FB_SCRN_DEFAULT_WIDTH
			info.BufferSize.Y_ = FB_SCRN_DEFAULT_HEIGHT
			info.wAttributes = 7
		else
			hooks.Coord_.X_ = *cptr( int16 ptr, @screen_info(CSBI_CURSOR_X_) )
			hooks.Coord_.Y_ = *cptr( int16 ptr, @screen_info(CSBI_CURSOR_Y_) )
			info.BufferSize.X_ = *cptr( int16 ptr, @screen_info(CSBI_DWSIZE_X_) )
			info.BufferSize.Y_ = *cptr( int16 ptr, @screen_info(CSBI_DWSIZE_Y_) )
			info.wAttributes = *cptr( uint16 ptr, @screen_info(CSBI_ATTRIBUTES_) )
		end if

		if( TKORT_CON_SCROLLOFF() <> 0 ) then
			TKORT_CON_SCROLLOFF() = 0
			hooks.Coord_.Y_ += 1
			hooks.Coord_.X_ = hooks.Border.Left_
			TKORT_CONCHECKSCROLL( @hooks )
		end if

		tkrt_ConPrintTTYWstr( @hooks, pachText, nchars, 1 )

		if( (hooks.Coord_.X_ <> hooks.Border.Left_) orelse _
		    (hooks.Coord_.Y_ <> (hooks.Border.Bottom_ + 1)) ) then
			TKORT_CONCHECKSCROLL( @hooks )
		else
			TKORT_CON_SCROLLOFF() = 1
			hooks.Coord_.X_ = hooks.Border.Right_
			hooks.Coord_.Y_ = hooks.Border.Bottom_
		end if

		w_SetConsoleCursorPosition( info.hOutput, _
		                            TKORT_COORD( hooks.Coord_.X_, hooks.Coord_.Y_ ) )
	end scope

	if( (hooks.Border.Top_ <> win_top) andalso (info.fViewSet = 0) ) then
		dim as TKORT_SMALLRECTW srWindow
		srWindow.Left_ = cast( int16, hooks.Border.Left_ )
		srWindow.Top_ = cast( int16, hooks.Border.Top_ )
		srWindow.Right_ = cast( int16, hooks.Border.Right_ )
		srWindow.Bottom_ = cast( int16, hooks.Border.Bottom_ )
		w_SetConsoleWindowInfo( info.hOutput, 1, @srWindow )
	end if

	tkrt_hUpdateConsoleWindow( )

	TKORT_IOUNLOCK()
end sub

sub tkort_ConsolePrintBufferWstr alias "fb_ConsolePrintBufferWstr" _
	( byval buffer as wstring ptr, byval mask as int32 )

	tkort_ConsolePrintBufferWstrEx( buffer, tkort_wlen( buffer ), mask )
end sub

end extern

#else

'' ======================================================================== POSIX

'' ISO-2022: enter UTF-8, and return to the previous encoding. Emitted as
'' INDIVIDUAL BYTES rather than as an escaped literal -- src/io/conprint.tiko
'' records what a literal produced instead, and it was two wrong bytes with
'' nothing to say so.
const ESC_     = 27
const PERCENT_ = 37
const BIG_G_   = 71
const AT_SIGN_ = 64

extern "c"   '' NON-FBCALL: internal, declared plain in fb_private_console.h.
	declare sub tkrt_RecheckConsoleSize2 alias "fb_hRecheckConsoleSize" ( byval force as int32 )
end extern

extern "c"   '' NON-FBCALL: fb_console.h declares both plainly.

sub tkort_ConsolePrintBufferWstrEx alias "fb_ConsolePrintBufferWstrEx" _
	( byval buffer as wstring ptr, byval chars as uinteger, byval mask as int32 )

	dim as uinteger avail = any, avail_len = any
	dim as integer bytes_ = any
	dim as zstring ptr temp = any
	dim as wstring ptr p = buffer
	dim as uinteger remaining_ = chars

	'' NOT INITIALISED: a pipe, or a program that has not printed to a real
	'' terminal yet. THE CODE UNITS GO OUT RAW -- fbc's own comment marks this
	'' as a FIXME and asks whether it should convert; it does not, and neither
	'' does this.
	if( TKORT_CON_L( TKORT_CON_INITED ) = 0 ) then
		fwrite( buffer, sizeof( wstring ), chars, stdout )
		fflush( stdout )
		exit sub
	end if

	'' Four bytes per code unit is the most UTF-8 can need, plus the NUL.
	'' malloc rather than alloca -- see the file header, including the failure
	'' branch below, which fbc cannot reach.
	temp = cast( zstring ptr, malloc( chars * 4 + 1 ) )
	if( temp = nullptr ) then
		fwrite( buffer, sizeof( wstring ), chars, stdout )
		fflush( stdout )
		exit sub
	end if

	'' The GRAPHICS background lock, not the I/O one -- fb_hRecheckConsoleSize
	'' touches state the gfx driver also reads.
	tkrt_BgLock()
	tkrt_RecheckConsoleSize2( -1 )
	tkrt_BgUnlock()

	dim as int32 w = TKORT_CON_L( TKORT_CON_W )
	dim as int32 h = TKORT_CON_L( TKORT_CON_H )

	'' Cells left on screen, from the cursor. One-based coordinates, hence the
	'' two subtractions.
	dim as integer offset_ = ((TKORT_CON_L( TKORT_CON_CURY ) - 1) * w) + _
	                          TKORT_CON_L( TKORT_CON_CURX ) - 1
	avail = (w * h) - offset_
	avail_len = chars
	if( avail < avail_len ) then avail_len = avail

	'' THE SHADOW IS A BYTE PER CELL, so the wide text is converted down for it
	'' and converted again, properly, for the wire. See the file header.
	tkrt_wstr_ConvToA( temp, cast( integer, avail_len ), buffer )

	memcpy( TKORT_CON_P( TKORT_CON_CHARBUF ) + offset_, temp, avail_len )
	memset( TKORT_CON_P( TKORT_CON_ATTRBUF ) + offset_, _
	        TKORT_CON_L( TKORT_CON_FGCOLOR ) or (TKORT_CON_L( TKORT_CON_BGCOLOR ) shl 4), _
	        avail_len )

	'' And now the real conversion, of ALL the characters rather than the
	'' clipped count -- the terminal scrolls, the shadow does not.
	tkrt_WCharToUTF( FB_FILE_ENCOD_UTF8, buffer, cast( integer, chars ), temp, @bytes_ )
	temp[bytes_] = 0

	fputc( ESC_, stdout )
	fputc( PERCENT_, stdout )
	fputc( BIG_G_, stdout )

	fputs( temp, stdout )

	fputc( ESC_, stdout )
	fputc( PERCENT_, stdout )
	fputc( AT_SIGN_, stdout )

	'' THE CURSOR IS UPDATED THROUGH THE CONTEXT, one step per code unit, and
	'' it STICKS at the bottom row rather than scrolling the shadow.
	while( remaining_ <> 0 )
		TKORT_CON_L( TKORT_CON_CURX ) += 1
		if( (p[0] = 10) orelse (TKORT_CON_L( TKORT_CON_CURX ) >= w) ) then
			TKORT_CON_L( TKORT_CON_CURX ) = 1
			TKORT_CON_L( TKORT_CON_CURY ) += 1
			if( TKORT_CON_L( TKORT_CON_CURY ) > h ) then TKORT_CON_L( TKORT_CON_CURY ) = h
		end if
		p += 1
		remaining_ -= 1
	wend

	free( temp )
	fflush( stdout )
end sub

sub tkort_ConsolePrintBufferWstr alias "fb_ConsolePrintBufferWstr" _
	( byval buffer as wstring ptr, byval mask as int32 )

	tkort_ConsolePrintBufferWstrEx( buffer, tkort_wlen( buffer ), mask )
end sub

end extern

#endif
