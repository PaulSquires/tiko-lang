'' core.tiko -- the profiler's string storage, hash tables, global context and
'' options: twenty-nine symbols over one fbc member.
''
'' MOST OF THESE ARE NOT fb_-PREFIXED. STRING_TABLE_*, STRING_HASH_*, and
'' PROFILER_GLOBAL_* are plain C names that fbc's profile_calls.o calls
'' directly, so they are as much part of the ABI as any fb_ entry point and
'' have to be exported under exactly those names.
''
'' THE STRING TABLE IS AN ARENA, NOT AN ALLOCATOR. Strings are bump-allocated
'' into 10240-byte blocks and never individually freed; the whole chain goes at
'' shutdown. Each entry is a STRING_INFO header immediately followed by its
'' bytes, so `info + 1` IS the string -- that pointer arithmetic is the
'' interface between the two halves and appears in fbc's code too.
''
'' EVERY ALLOCATION SIZE IS ROUNDED UP TO A MULTIPLE OF 4, because the arena is
'' walked by stepping `index += info->size` and a misaligned STRING_INFO would
'' be read at an odd offset on the next pass.
''
'' THE HASH IS OPEN-ADDRESSED ACROSS BLOCKS, NOT CHAINED WITHIN ONE. A
'' collision does not probe the next slot; it moves to the next BLOCK and tries
'' the same index there, allocating a block when it runs out. So the table
'' grows in 997-slot planes and a lookup walks the chain of planes.
''
'' THE STRUCTS ARE NOT BYTE-PACKED. fbc's profile_calls.o reads them with the C
'' compiler's layout, and `field = 1` here would shift every field it touches.

#include once "inc/descriptors.ti"
#include once "inc/profile.ti"
#include once "inc/rterror.ti"
#include once "inc/iolock.ti"
#include once "inc/fmt.ti"
#include once "inc/sysbind.ti"

extern "c"   '' NON-FBCALL: fb_hGetExeName is declared plain in fb_system.h.
	declare function tkrt_GetExeName alias "fb_hGetExeName" _
		( byval dst as zstring ptr, byval length as integer ) as zstring ptr
end extern

extern "rtlib"
	declare function tkrt_ErrorSetNum alias "fb_ErrorSetNum" ( byval errnum as long ) as long
end extern

'' The launch timestamp, "MM-DD-YYYY, HH:MM:SS".
''
'' EVERY FIELD IS TAKEN MODULO ITS OWN WIDTH -- month and day mod 100, year mod
'' 10000 -- so a struct tm with an out-of-range field cannot overflow the
'' 32-byte buffer. That is fbc's guard and it is kept, not simplified away.
''
'' tm_mon is 0-BASED and tm_year is YEARS SINCE 1900; both corrections are
'' applied here and getting either wrong yields a date that still looks like a
'' date.
private sub tkort_hStampLaunchTime( byval prof as FB_PROFILER_GLOBAL ptr )
	dim as time_t rawtime = 0
	dim as tm ptr ptm = any

	time_( @rawtime )
	ptm = localtime( @rawtime )
	if( ptm = 0 ) then exit sub

	tkrt_snprintf( @prof->launch_time, 32, @"%02d-%02d-%04d, %02d:%02d:%02d", _
		cast( long, (1 + ptm->tm_mon) mod 100 ), _
		cast( long, ptm->tm_mday mod 100 ), _
		cast( long, (1900 + ptm->tm_year) mod 10000 ), _
		cast( long, ptm->tm_hour mod 100 ), _
		cast( long, ptm->tm_min mod 100 ), _
		cast( long, ptm->tm_sec mod 100 ) )
	prof->launch_time[31] = 0
end sub

'' The one global. NOT in __fb_ctx: the profiler is optional and its context is
'' created on first use, so it is a file-scope pointer exactly as in fbc.
dim shared as FB_PROFILER_GLOBAL ptr fb_profiler = 0

'' NON-FBCALL: every one of these is declared plain in fb_profile.h -- the
'' non-fb_ names have no FBCALL marker either, and win32 must not decorate them.
extern "c"   '' NON-FBCALL: fb_profile.h declares all of these plain.

'' Jenkins one-at-a-time. Reproduced exactly, shifts included: the hash decides
'' which block a string lands in, so a different mixing function changes the
'' table layout that fbc's profile_calls.o walks.
function tkort_ProfileHashName alias "fb_ProfileHashName" ( byval p as zstring ptr ) as ulong
	dim as ulong hash_ = 0
	dim as byte sc = any
	dim as integer i = 0

	while( p[i] <> 0 )
		'' THE BYTE IS SIGN-EXTENDED BEFORE THE UNSIGNED ADD. fbc writes
		'' `hash += (unsigned int)*p` over a `const char *`, and plain char
		'' is SIGNED on x86 -- so 0xFF contributes 0xFFFFFFFF, not 0xFF.
		'' Reading it as unsigned gives a different hash for every byte
		'' above 0x7F, which changes which block a string lands in and so
		'' every metric the profiler reports. Caught by the differential on
		'' a three-byte high-ASCII name; nothing below 0x80 would show it.
		sc = p[i]
		hash_ += cast( ulong, cast( long, sc ) )
		hash_ += hash_ shl 10
		hash_ xor= hash_ shr 6
		i += 1
	wend
	hash_ += hash_ shl 3
	hash_ xor= hash_ shr 11
	hash_ += hash_ shl 15
	return hash_
end function

'' Bump-allocate `length` bytes plus a header. Returns NULL when the request
'' cannot fit a whole block -- callers treat that as "give up", not "grow".
function tkort_STRING_TABLE_alloc alias "STRING_TABLE_alloc" _
	( byval strings as STRING_TABLE ptr, byval length_ as long ) as STRING_INFO ptr

	dim as STRING_INFO ptr info = any
	dim as STRING_INFO_TB_ ptr tb = any
	dim as long entsize = any

	'' Rounded up to a multiple of 4 -- see the header.
	entsize = sizeof( STRING_INFO ) + ((length_ + 3) and (not 3))

	if( entsize > STRING_INFO_TB_SIZE ) then return 0

	if( entsize > (STRING_INFO_TB_SIZE - strings->tb->bytes_used) ) then
		tb = calloc( 1, sizeof( STRING_INFO_TB_ ) )
		if( tb = 0 ) then return 0
		tb->bytes_used = 0
		'' Blocks are numbered from the head DOWN, and the newest block is
		'' pushed on the front -- so ids increase as the chain is walked
		'' backwards, which is the order the report prints.
		tb->string_tb_id = strings->tb->string_tb_id + 1
		tb->nxt = strings->tb
		strings->tb = tb
	end if

	info = cptr( STRING_INFO ptr, @strings->tb->data(strings->tb->bytes_used) )
	info->entbytes = entsize
	strings->tb->bytes_used += entsize
	return info
end function

sub tkort_STRING_TABLE_constructor alias "STRING_TABLE_constructor" ( byval strings as STRING_TABLE ptr )
	dim as STRING_INFO_TB_ ptr tb = any
	if( strings = 0 ) then exit sub
	tb = calloc( 1, sizeof( STRING_INFO_TB_ ) )
	if( tb <> 0 ) then
		tb->bytes_used = 0
		tb->string_tb_id = 1
		tb->nxt = 0
	end if
	'' Assigned even when the allocation failed, so the field is NULL rather
	'' than uninitialised -- every caller tests it.
	strings->tb = tb
end sub

sub tkort_STRING_TABLE_destructor alias "STRING_TABLE_destructor" ( byval strings as STRING_TABLE ptr )
	dim as STRING_INFO_TB_ ptr tb = any, tb_next = any
	if( strings = 0 ) then exit sub
	tb = strings->tb
	while( tb <> 0 )
		tb_next = tb->nxt
		free( tb )
		tb = tb_next
	wend
end sub

'' LENGTH INCLUDES THE TERMINATOR, and strncpy copies exactly that many bytes,
'' so the stored string is always NUL-terminated in place.
function tkort_STRING_TABLE_add alias "STRING_TABLE_add" _
	( byval strings as STRING_TABLE ptr, byval src as zstring ptr, _
	  byval hashkey as ulong ) as STRING_INFO ptr

	dim as STRING_INFO ptr info = any
	dim as long nbytes = cast( long, strlen( src ) ) + 1

	info = tkort_STRING_TABLE_alloc( strings, nbytes )
	if( info <> 0 ) then
		info->strbytes = nbytes
		info->hashkey = hashkey
		'' info + 1 IS the string -- see the header.
		strncpy( cptr( zstring ptr, info + 1 ), src, nbytes )
	end if
	return info
end function

'' Walks the arena by stepping over each entry's own size.
function tkort_STRING_TABLE_max_len alias "STRING_TABLE_max_len" _
	( byval strings as STRING_TABLE ptr ) as long
	dim as STRING_INFO_TB_ ptr tb = any
	dim as STRING_INFO ptr info = any
	dim as long max_len = 0 : dim as integer index_ = any

	if( strings = 0 ) then return 0
	tb = strings->tb
	while( tb <> 0 )
		index_ = 0
		while( index_ < tb->bytes_used )
			info = cptr( STRING_INFO ptr, @tb->data(index_) )
			if( info->strbytes > max_len ) then max_len = info->strbytes
			index_ += info->entbytes
		wend
		tb = tb->nxt
	wend
	return max_len
end function

end extern

extern "c"   '' NON-FBCALL: the hash internals, declared plain.

'' A COLLISION MOVES TO THE NEXT BLOCK, not the next slot -- see the header.
'' Returns NULL when the whole chain is occupied at this index.
function tkort_STRING_HASH_TB_find alias "STRING_HASH_TB_find" _
	( byval tb as STRING_HASH_TB_ ptr, byval src as zstring ptr, _
	  byval hashkey as ulong ) as STRING_INFO ptr

	dim as STRING_INFO ptr info = any
	dim as long hash_index = cast( long, hashkey mod STRING_HASH_TB_SIZE )

	while( tb <> 0 )
		info = tb->items(hash_index)
		if( info <> 0 ) then
			if( (info->hashkey = hashkey) andalso _
			    (strcmp( cptr( zstring ptr, info + 1 ), src ) = 0) ) then
				return info
			end if
		else
			'' AN EMPTY SLOT ENDS THE SEARCH. Insertion fills the first
			'' empty slot at this index, so a later block cannot hold the
			'' key if an earlier one is free here.
			exit while
		end if
		tb = tb->nxt
	wend
	return 0
end function

function tkort_STRING_HASH_TABLE_find alias "STRING_HASH_TABLE_find" _
	( byval hash_ as STRING_HASH_TABLE_ ptr, byval src as zstring ptr, _
	  byval hashkey as ulong ) as STRING_INFO ptr
	return tkort_STRING_HASH_TB_find( hash_->tb, src, hashkey )
end function

sub tkort_STRING_HASH_TABLE_constructor alias "STRING_HASH_TABLE_constructor" _
	( byval hash_ as STRING_HASH_TABLE_ ptr, byval strings as STRING_TABLE ptr )
	if( hash_ = 0 ) then exit sub
	'' The first block is allocated LAZILY, on the first add.
	hash_->tb = 0
	hash_->strings = strings
end sub

sub tkort_STRING_HASH_TABLE_destructor alias "STRING_HASH_TABLE_destructor" _
	( byval hash_ as STRING_HASH_TABLE_ ptr )
	dim as STRING_HASH_TB_ ptr tb = any, tb_next = any
	if( hash_ = 0 ) then exit sub
	tb = hash_->tb
	while( tb <> 0 )
		tb_next = tb->nxt
		free( tb )
		tb = tb_next
	wend
	'' Cleared, unlike STRING_TABLE_destructor which leaves its head dangling
	'' -- the two are not symmetric and the difference is fbc's.
	hash_->tb = 0
end sub

'' Find-or-insert. The string is copied into the arena on insert, so the
'' caller's buffer need not outlive the call.
function tkort_STRING_HASH_TABLE_add alias "STRING_HASH_TABLE_add" _
	( byval hash_ as STRING_HASH_TABLE_ ptr, byval src as zstring ptr, _
	  byval hashkey as ulong ) as STRING_INFO ptr

	dim as STRING_HASH_TB_ ptr tb = hash_->tb
	dim as STRING_INFO ptr info = any
	dim as long hash_index = cast( long, hashkey mod STRING_HASH_TB_SIZE )

	if( tb = 0 ) then
		tb = calloc( 1, sizeof( STRING_HASH_TB_ ) )
		hash_->tb = tb
	end if

	while( tb <> 0 )
		info = tb->items(hash_index)
		if( info <> 0 ) then
			if( (info->hashkey = hashkey) andalso _
			    (strcmp( cptr( zstring ptr, info + 1 ), src ) = 0) ) then
				return info
			end if
		else
			info = tkort_STRING_TABLE_add( hash_->strings, src, hashkey )
			tb->items(hash_index) = info
			return info
		end if
		if( tb->nxt = 0 ) then
			tb->nxt = calloc( 1, sizeof( STRING_HASH_TB_ ) )
		end if
		tb = tb->nxt
	wend
	return 0
end function

'' Insert an EXISTING entry into a second table without copying it. That is how
'' the ignores list and the per-thread tables share one arena.
function tkort_STRING_HASH_TABLE_add_info alias "STRING_HASH_TABLE_add_info" _
	( byval hash_ as STRING_HASH_TABLE_ ptr, byval new_info as STRING_INFO ptr ) as STRING_INFO ptr

	dim as STRING_HASH_TB_ ptr tb = hash_->tb
	dim as STRING_INFO ptr info = any
	dim as long hash_index = cast( long, new_info->hashkey mod STRING_HASH_TB_SIZE )

	if( tb = 0 ) then
		tb = calloc( 1, sizeof( STRING_HASH_TB_ ) )
		hash_->tb = tb
	end if

	while( tb <> 0 )
		info = tb->items(hash_index)
		if( info <> 0 ) then
			'' Compared by POINTER, not by content: both tables point into
			'' the same arena, so identity is the right test and a strcmp
			'' would be slower and no more correct.
			if( info = new_info ) then return info
		else
			tb->items(hash_index) = new_info
			return new_info
		end if
		if( tb->nxt = 0 ) then
			tb->nxt = calloc( 1, sizeof( STRING_HASH_TB_ ) )
		end if
		tb = tb->nxt
	wend
	return 0
end function

sub tkort_STRING_HASH_constructor alias "STRING_HASH_constructor" _
	( byval hash_ as STRING_HASH_ ptr, byval strings_hash as STRING_HASH_TABLE_ ptr )
	if( hash_ = 0 ) then exit sub
	'' The inner table borrows the OUTER one's arena, not its own.
	tkort_STRING_HASH_TABLE_constructor( @hash_->hash_, strings_hash->strings )
	hash_->strings_hash = strings_hash
end sub

sub tkort_STRING_HASH_destructor alias "STRING_HASH_destructor" ( byval hash_ as STRING_HASH_ ptr )
	if( hash_ = 0 ) then exit sub
	tkort_STRING_HASH_TABLE_destructor( @hash_->hash_ )
	hash_->strings_hash = 0
end sub

'' Adds to the SHARED table first, then records the same entry locally.
sub tkort_STRING_HASH_add alias "STRING_HASH_add" _
	( byval hash_ as STRING_HASH_ ptr, byval src as zstring ptr, byval hashkey as ulong )
	dim as STRING_INFO ptr info = tkort_STRING_HASH_TABLE_add( hash_->strings_hash, src, hashkey )
	if( info <> 0 ) then tkort_STRING_HASH_TABLE_add_info( @hash_->hash_, info )
end sub

function tkort_STRING_HASH_find alias "STRING_HASH_find" _
	( byval hash_ as STRING_HASH_ ptr, byval src as zstring ptr, _
	  byval hashkey as ulong ) as STRING_INFO ptr
	return tkort_STRING_HASH_TB_find( hash_->hash_.tb, src, hashkey )
end function

function tkort_PROFILER_add_ignore alias "PROFILER_add_ignore" _
	( byval prof as FB_PROFILER_GLOBAL ptr, byval src as zstring ptr, _
	  byval hashkey as ulong ) as zstring ptr
	dim as STRING_INFO ptr info = tkort_STRING_HASH_TABLE_add( @prof->ignores_hash, src, hashkey )
	'' Returns the STRING, not the header -- and does not check for NULL,
	'' which matches fbc: a failed add yields a pointer to offset 12 of NULL
	'' and the caller discards it.
	return cptr( zstring ptr, info + 1 )
end function

end extern

extern "c"   '' NON-FBCALL: the metrics helpers, declared plain.

'' NOTE string_max_len IS NOT CLEARED. Every other field is, and this one is
'' left alone so a caller can accumulate a maximum across several calls --
'' fb_hPROFILER_METRICS_Strings only ever raises it.
sub tkort_METRICS_Clear alias "fb_hPROFILER_METRICS_Clear" _
	( byval metrics as FB_PROFILER_METRICS ptr )
	if( metrics = 0 ) then exit sub
	metrics->nthreads = 0
	metrics->string_bytes_allocated = 0
	metrics->string_bytes_used = 0
	metrics->string_bytes_free = 0
	metrics->string_count_blocks = 0
	metrics->string_count_strings = 0
	metrics->hash_bytes_allocated = 0
	metrics->hash_count_blocks = 0
	metrics->hash_count_items = 0
	metrics->hash_count_slots = 0
	metrics->procs_bytes_allocated = 0
	metrics->procs_count_blocks = 0
	metrics->procs_count_items = 0
	metrics->procs_count_slots = 0
end sub

'' ACCUMULATES rather than assigns, so it can be called for several tables.
sub tkort_METRICS_Strings alias "fb_hPROFILER_METRICS_Strings" _
	( byval metrics as FB_PROFILER_METRICS ptr, byval strings as STRING_TABLE ptr )
	dim as STRING_INFO_TB_ ptr tb = any
	dim as STRING_INFO ptr info = any
	dim as integer index_ = any

	if( metrics = 0 ) then exit sub
	if( strings = 0 ) then exit sub

	tb = strings->tb
	while( tb <> 0 )
		metrics->string_bytes_allocated += sizeof( STRING_INFO_TB_ )
		metrics->string_bytes_used += tb->bytes_used
		'' "free" is measured against the WHOLE struct, header included, so
		'' used + free is slightly more than the data area. fbc's arithmetic.
		metrics->string_bytes_free += sizeof( STRING_INFO_TB_ ) - tb->bytes_used
		metrics->string_count_blocks += 1

		index_ = 0
		while( index_ < tb->bytes_used )
			info = cptr( STRING_INFO ptr, @tb->data(index_) )
			if( info->strbytes > metrics->string_max_len ) then
				metrics->string_max_len = info->strbytes
			end if
			metrics->string_count_strings += 1
			index_ += info->entbytes
		wend
		tb = tb->nxt
	wend
end sub

sub tkort_METRICS_HashTable alias "fb_hPROFILER_METRICS_HashTable" _
	( byval metrics as FB_PROFILER_METRICS ptr, byval hash_ as STRING_HASH_TABLE_ ptr )
	dim as STRING_HASH_TB_ ptr tb = any
	dim as long i = any

	if( metrics = 0 ) then exit sub
	if( hash_ = 0 ) then exit sub

	tb = hash_->tb
	while( tb <> 0 )
		metrics->hash_bytes_allocated += sizeof( STRING_HASH_TB_ )
		metrics->hash_count_blocks += 1
		for i = 0 to STRING_HASH_TB_SIZE - 1
			if( tb->items(i) <> 0 ) then metrics->hash_count_items += 1
			metrics->hash_count_slots += 1
		next
		tb = tb->nxt
	wend
end sub

'' The ignores table is counted into the SAME hash totals as the strings table.
sub tkort_METRICS_Global alias "fb_hPROFILER_METRICS_Global" _
	( byval metrics as FB_PROFILER_METRICS ptr, byval global_ as FB_PROFILER_GLOBAL ptr )
	tkort_METRICS_Strings( metrics, @global_->strings )
	tkort_METRICS_HashTable( metrics, @global_->strings_hash )
	tkort_METRICS_HashTable( metrics, @global_->ignores_hash )
end sub

'' IDEMPOTENT: a second call returns the existing context rather than leaking
'' the first. Both profilers call this, and either may run first.
function tkort_PROFILER_GLOBAL_create alias "PROFILER_GLOBAL_create" ( ) as FB_PROFILER_GLOBAL ptr
	if( fb_profiler <> 0 ) then return fb_profiler

	fb_profiler = calloc( 1, sizeof( FB_PROFILER_GLOBAL ) )
	if( fb_profiler <> 0 ) then
		tkort_STRING_TABLE_constructor( @fb_profiler->strings )
		tkort_STRING_HASH_TABLE_constructor( @fb_profiler->strings_hash, @fb_profiler->strings )
		tkort_STRING_HASH_TABLE_constructor( @fb_profiler->ignores_hash, @fb_profiler->strings )
		fb_profiler->filename[0] = 0
		fb_profiler->launch_time[0] = 0
		tkort_hStampLaunchTime( fb_profiler )
	end if
	return fb_profiler
end function

sub tkort_PROFILER_GLOBAL_destroy alias "PROFILER_GLOBAL_destroy" ( )
	if( fb_profiler = 0 ) then exit sub
	tkort_STRING_HASH_TABLE_destructor( @fb_profiler->strings_hash )
	tkort_STRING_HASH_TABLE_destructor( @fb_profiler->ignores_hash )
	tkort_STRING_TABLE_destructor( @fb_profiler->strings )
	free( fb_profiler )
	fb_profiler = 0
end sub

end extern

'' ------------------------------------------------------- the public options
''
'' These six ARE FBCALL, unlike everything above -- fb_profile.h marks them and
'' leaves the internals plain, so the two halves of this file need different
'' EXTERN blocks and win32 decorates only this one.
''
'' ALL OF THEM TAKE THE PROFILER LOCK, not the I/O lock, and all of them are
'' no-ops when no profiler exists: a program built without -profile can call
'' them and gets a benign answer rather than a crash.

'' Copy with validation. REJECTS an empty source and one that fills the buffer,
'' so a truncated path is never written.
private function hProfileCopyFilename( byval dst as zstring ptr, byval src as zstring ptr, _
                                       byval length_ as long ) as long
	dim as integer len_ = any

	if( fb_profiler = 0 ) then return tkrt_ErrorSetNum( FB_RTERROR_ILLEGALFUNCTIONCALL )
	if( dst = 0 ) then return tkrt_ErrorSetNum( FB_RTERROR_ILLEGALFUNCTIONCALL )
	if( src = 0 ) then return tkrt_ErrorSetNum( FB_RTERROR_ILLEGALFUNCTIONCALL )

	len_ = cast( integer, strlen( src ) )
	'' Measured against PROFILER_MAX_PATH, NOT against `length` -- the check
	'' is about the source being a sane path, and the copy below is what is
	'' bounded by the destination.
	if( (len_ < 1) orelse (len_ >= PROFILER_MAX_PATH - 1) ) then
		return tkrt_ErrorSetNum( FB_RTERROR_ILLEGALFUNCTIONCALL )
	end if

	strncpy( dst, src, length_ )
	dst[length_ - 1] = 0
	return tkrt_ErrorSetNum( FB_RTERROR_OK )
end function

extern "rtlib"

function tkort_ProfileSetFileName alias "fb_ProfileSetFileName" _
	( byval filename as zstring ptr ) as long
	dim as long ret = any
	TKORT_PROFLOCK()
	if( (fb_profiler <> 0) andalso (filename <> 0) ) then
		ret = hProfileCopyFilename( @fb_profiler->filename, filename, PROFILER_MAX_PATH )
	else
		ret = tkrt_ErrorSetNum( FB_RTERROR_ILLEGALFUNCTIONCALL )
	end if
	TKORT_PROFUNLOCK()
	return ret
end function

'' WITH NO NAME SET, THE DEFAULT IS DERIVED FROM THE EXECUTABLE -- exe name
'' plus ".prf" -- and only falls back to "profile.txt" when even that fails.
function tkort_ProfileGetFileName alias "fb_ProfileGetFileName" _
	( byval filename as zstring ptr, byval length_ as long ) as long
	dim as long ret = any
	dim as zstring * PROFILER_MAX_PATH buffer = any
	dim as zstring ptr fname = any

	TKORT_PROFLOCK()
	if( (fb_profiler <> 0) andalso (filename <> 0) andalso (length_ > 0) ) then
		if( fb_profiler->filename[0] <> 0 ) then
			fname = @fb_profiler->filename
		else
			fname = tkrt_GetExeName( @buffer, PROFILER_MAX_PATH - 1 )
			if( fname <> 0 ) then
				strcat( @buffer, DEFAULT_PROFILE_EXT )
				fname = @buffer
			else
				fname = @DEFAULT_PROFILE_FILE
			end if
		end if
		ret = hProfileCopyFilename( filename, fname, length_ )
	else
		ret = tkrt_ErrorSetNum( FB_RTERROR_ILLEGALFUNCTIONCALL )
	end if
	TKORT_PROFUNLOCK()
	return ret
end function

'' Returns 0 when there is no profiler, which is indistinguishable from
'' PROFILE_OPTION_REPORT_DEFAULT -- and deliberately so.
function tkort_ProfileGetOptions alias "fb_ProfileGetOptions" ( ) as long
	dim as long options = 0
	TKORT_PROFLOCK()
	if( fb_profiler <> 0 ) then options = fb_profiler->options
	TKORT_PROFUNLOCK()
	return options
end function

'' Returns the PREVIOUS options, so a caller can restore them.
function tkort_ProfileSetOptions alias "fb_ProfileSetOptions" ( byval options as long ) as long
	dim as long previous_options = 0
	TKORT_PROFLOCK()
	if( fb_profiler <> 0 ) then
		previous_options = fb_profiler->options
		fb_profiler->options = options
	end if
	TKORT_PROFUNLOCK()
	return previous_options
end function

sub tkort_ProfileIgnore alias "fb_ProfileIgnore" ( byval procname as zstring ptr )
	dim as ulong hashkey = any
	TKORT_PROFLOCK()
	if( (fb_profiler <> 0) andalso (procname <> 0) ) then
		hashkey = tkort_ProfileHashName( procname )
		tkort_PROFILER_add_ignore( fb_profiler, procname, hashkey )
	end if
	TKORT_PROFUNLOCK()
end sub

'' NO LOCK: it hands back the pointer, and every caller locks around what it
'' then does with it.
function tkort_ProfileGetGlobalProfiler alias "fb_ProfileGetGlobalProfiler" ( ) as FB_PROFILER_GLOBAL ptr
	return fb_profiler
end function

end extern
