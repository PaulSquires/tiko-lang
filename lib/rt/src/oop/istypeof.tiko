'' oop/istypeof.tiko -- the IS operator.
''
'' Walks the RTTI chain from the object's own type up through its bases and
'' answers on the first match. A NULL object IS nothing, which is fbc's answer
'' and not an error.
''
'' BY STRCMP, NOT BY ADDRESS. An object and the type it is tested against can be
'' declared in different DLLs, each carrying its own copy of the RTTI record, so
'' comparing pointers answers FALSE for a type that genuinely matches. That is
'' why the record holds an id string at all.
''
'' THE RTTI IS AT A NEGATIVE OFFSET FROM THE VPTR. A constructor stores the
'' vtable address PLUS sizeof( TKORT_BASEVT ), so a vptr always names the first
'' method slot and the header sits behind it. Subtracting the same amount is how
'' the header is reached, and it is the shape of every UDT vtable fbc emits --
'' not a peculiarity of the root object.
''
'' fb_IsTypeOf RETURNS FB's TRUE, which is -1 and not 1. It is declared 'as long'
'' in fb_oop.h and the value reaches user code as a BOOLEAN, where any non-zero
'' would test true -- but the value is also printable, and fbc's is -1.

#include once "../sys/sys.ti"
#include once "../inc/oop.ti"

extern "rtlib"
	function tkort_IsTypeOf alias "fb_IsTypeOf" _
		( byval obj as TKORT_OBJECT ptr, byval typeRTTI as TKORT_RTTI ptr ) as int32

		if( obj = 0 ) then return 0
		if( typeRTTI = 0 ) then return 0

		dim as TKORT_BASEVT ptr vt = cast( TKORT_BASEVT ptr, _
			cast( uint8 ptr, obj->pVT ) - sizeof( TKORT_BASEVT ) )
		dim as TKORT_RTTI ptr objRTTI = vt->pRTTI

		while( objRTTI <> 0 )
			if( strcmp( objRTTI->id, typeRTTI->id ) = 0 ) then return -1
			objRTTI = objRTTI->pRTTIBase
		wend

		return 0
	end function
end extern
