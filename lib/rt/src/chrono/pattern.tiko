'' pattern.tiko -- custom date/time pattern formatting and strict parsing.
'' Two entry points over one fbc member.
''
'' PATTERN LETTERS ARE THE .NET/JAVA FAMILY (yyyy-MM-dd HH:mm:ss), which is
'' what C#, Java, Rust's chrono, ICU and every spreadsheet use.
''
'' THE MONTH AND DAY NAMES ARE INVARIANT ENGLISH, from the tables below, NOT
'' the OS locale. That is the entire point of this file: a pattern formatter
'' whose output changes with the machine's locale cannot be used to write a
'' file. Locale-dependent formatting is a different layer.
''
'' No sprintf, no locale, no allocation.
''
'' THE DAY TABLES ARE INDEXED 0 = MONDAY, matching fb_DtDayOfWeek's ISO 1..7.
'' Indexing them from Sunday would shift every weekday name by one and still
'' produce a plausible-looking date.
''
'' A ONE-CHARACTER PATTERN IS A NAMED FORMAT, NOT A FIELD. "d" is the short
'' date, not a one-digit day. That is a known wart inherited from C#, and it is
'' reproduced rather than fixed.
''
'' AN UNRECOGNISED LETTER IS A PATTERN ERROR, NOT A LITERAL. Passing it through
'' would turn a typo into wrong output; failing turns it into a caught bug.
'' Literal text goes in single quotes, or behind a backslash.

#include once "inc/chrono.ti"
#include once "inc/sysbind.ti"

const DT_PAT_OFFSET_UNSPECIFIED = 32767
const DT_PAT_ERR = -1

extern "rtlib"
	declare sub tkrt_DtToCivil alias "fb_DtToCivil" _
		( byval ticks as int64, byval y as int32 ptr, byval mo as int32 ptr, _
		  byval d as int32 ptr, byval h as int32 ptr, byval mi as int32 ptr, _
		  byval s as int32 ptr, byval sub_ as int64 ptr )
	declare sub tkrt_DtCivilFromDays alias "fb_DtCivilFromDays" _
		( byval days as int32, byval y as int32 ptr, byval mo as int32 ptr, byval d as int32 ptr )
	declare function tkrt_DtDayOfWeek alias "fb_DtDayOfWeek" ( byval days as int32 ) as int32
	declare function tkrt_DtDayOfYear alias "fb_DtDayOfYear" _
		( byval y as int32, byval mo as int32, byval d as int32 ) as int32
	declare function tkrt_DtDaysFromCivil alias "fb_DtDaysFromCivil" _
		( byval y as int32, byval mo as int32, byval d as int32 ) as int32
	declare function tkrt_DtDaysInYear alias "fb_DtDaysInYear" ( byval y as int32 ) as int32
	declare function tkrt_DtIsValidTicks alias "fb_DtIsValidTicks" ( byval t as int64 ) as int32
	declare function tkrt_DtIsoWeek alias "fb_DtIsoWeek" _
		( byval y as int32, byval mo as int32, byval d as int32, byval iy as int32 ptr ) as int32
	declare function tkrt_DtFromCivil alias "fb_DtFromCivil" _
		( byval y as int32, byval mo as int32, byval d as int32, byval h as int32, _
		  byval mi as int32, byval s as int32, byval sub_ as int64, _
		  byval out_ as int64 ptr ) as int32
	declare function tkrt_DtIsoFormat alias "fb_DtIsoFormat" _
		( byval ticks as int64, byval off as int32, byval buf as uint8 ptr, _
		  byval buflen as int32 ) as int32
	declare function tkrt_DtIsoParse alias "fb_DtIsoParse" _
		( byval s as uint8 ptr, byval l as int32, byval t as int64 ptr, _
		  byval o as int32 ptr ) as int32
end extern

'' Name tables. Stored as a fixed grid rather than a pointer array so the whole
'' thing is one static object with no relocations to initialise.
type TKORT_NAME16
	as zstring * 16 s
end type

dim shared as TKORT_NAME16 hMonthFull(0 to 11)
dim shared as TKORT_NAME16 hMonthAbbr(0 to 11)
dim shared as TKORT_NAME16 hDayFull(0 to 6)
dim shared as TKORT_NAME16 hDayAbbr(0 to 6)
dim shared as int32 hNamesReady = 0

private sub hInitNames( )
	if( hNamesReady ) then exit sub
	hMonthFull(0).s = "January"   : hMonthFull(1).s = "February"
	hMonthFull(2).s = "March"     : hMonthFull(3).s = "April"
	hMonthFull(4).s = "May"       : hMonthFull(5).s = "June"
	hMonthFull(6).s = "July"      : hMonthFull(7).s = "August"
	hMonthFull(8).s = "September" : hMonthFull(9).s = "October"
	hMonthFull(10).s = "November" : hMonthFull(11).s = "December"

	hMonthAbbr(0).s = "Jan" : hMonthAbbr(1).s = "Feb" : hMonthAbbr(2).s = "Mar"
	hMonthAbbr(3).s = "Apr" : hMonthAbbr(4).s = "May" : hMonthAbbr(5).s = "Jun"
	hMonthAbbr(6).s = "Jul" : hMonthAbbr(7).s = "Aug" : hMonthAbbr(8).s = "Sep"
	hMonthAbbr(9).s = "Oct" : hMonthAbbr(10).s = "Nov" : hMonthAbbr(11).s = "Dec"

	'' 0 = Monday -- see the header.
	hDayFull(0).s = "Monday"   : hDayFull(1).s = "Tuesday"
	hDayFull(2).s = "Wednesday": hDayFull(3).s = "Thursday"
	hDayFull(4).s = "Friday"   : hDayFull(5).s = "Saturday"
	hDayFull(6).s = "Sunday"

	hDayAbbr(0).s = "Mon" : hDayAbbr(1).s = "Tue" : hDayAbbr(2).s = "Wed"
	hDayAbbr(3).s = "Thu" : hDayAbbr(4).s = "Fri" : hDayAbbr(5).s = "Sat"
	hDayAbbr(6).s = "Sun"

	hNamesReady = 1
end sub

private function hIsAlpha( byval c as uint32 ) as int32
	if( (c >= 97) andalso (c <= 122) ) then return 1
	if( (c >= 65) andalso (c <= 90) ) then return 1
	return 0
end function

private function hIsDigit( byval c as uint32 ) as int32
	if( (c >= 48) andalso (c <= 57) ) then return 1
	return 0
end function

'' Length of the nrun of identical characters at p.
private function hRun( byval p as uint8 ptr, byval pend as uint8 ptr ) as int32
	dim as uint8 ptr q = p
	while( q < pend )
		if( *q <> *p ) then exit while
		q += 1
	wend
	return cast( int32, q - p )
end function

'' Right-aligned decimal, zero-padded to minDigits. Zero prints as "0".
private function hPatNum( byval buf as uint8 ptr, byval v as int64, _
                          byval minDigits as int32 ) as int32
	dim as uint8 tmp(0 to 23)
	dim as int32 k = 0, n = 0

	if( v = 0 ) then
		tmp(k) = 48 : k += 1
	end if
	while( v > 0 )
		tmp(k) = 48 + cast( int32, v mod 10 ) : k += 1
		v \= 10
	wend
	while( k < minDigits )
		tmp(k) = 48 : k += 1
	wend
	while( k > 0 )
		k -= 1
		buf[n] = tmp(k) : n += 1
	wend
	return n
end function

private function hPatStr( byval buf as uint8 ptr, byval s as zstring ptr ) as int32
	dim as int32 n = 0
	while( s[n] <> 0 )
		buf[n] = s[n]
		n += 1
	wend
	return n
end function

'' Returns characters written, or DT_PAT_ERR on a pattern error.
private function hPatFormatCore( byval ticks as int64, byval offMin as int32, _
                                 byval pat as uint8 ptr, byval patlen as int32, _
                                 byval buf as uint8 ptr, byval buflen as int32 ) as int32
	dim as uint8 ptr p = pat, pend = pat + patlen
	dim as int32 n = 0
	dim as int32 y = any, mo = any, d = any, h = any, mi = any, s = any
	dim as int64 sub_ = any, v = any
	dim as int32 days = any, nrun = any, i = any, h12 = any, w = any
	dim as int32 a = any, sign_ = any, iy = any
	dim as uint32 c = any

	hInitNames( )
	days = cast( int32, ticks \ FB_DT_TICKS_PER_DAY )
	tkrt_DtToCivil( ticks, @y, @mo, @d, @h, @mi, @s, @sub_ )

	while( p < pend )
		c = *p

		'' A blanket headroom check, once per token: the widest single field
		'' is a full month name, and 64 covers every one of them.
		if( n + 64 > buflen ) then return DT_PAT_ERR

		if( c = 39 ) then                       '' '  -- a quoted literal nrun
			p += 1
			do
				if( p >= pend ) then return DT_PAT_ERR    '' unterminated
				if( *p = 39 ) then
					p += 1
					'' '' inside a quoted nrun is ONE apostrophe.
					if( p < pend ) then
						if( *p = 39 ) then
							buf[n] = 39 : n += 1
							p += 1
							continue do
						end if
					end if
					exit do
				end if
				buf[n] = *p : n += 1
				p += 1
				if( n + 8 > buflen ) then return DT_PAT_ERR
			loop
			continue while
		end if

		if( c = 92 ) then                       '' \ -- escapes exactly one
			p += 1
			if( p >= pend ) then return DT_PAT_ERR
			buf[n] = *p : n += 1
			p += 1
			continue while
		end if

		if( hIsAlpha( c ) = 0 ) then
			buf[n] = c : n += 1
			p += 1
			continue while
		end if

		nrun = hRun( p, pend )
		p += nrun

		select case c
		case 121                                '' 'y'
			'' "yy" is the LAST TWO DIGITS; "y" is the whole year unpadded;
			'' anything longer is zero-padded to its own nrun length.
			if( nrun = 2 ) then
				n += hPatNum( buf + n, y mod 100, 2 )
			elseif( nrun = 1 ) then
				n += hPatNum( buf + n, y, 1 )
			else
				n += hPatNum( buf + n, y, nrun )
			end if

		case 77                                 '' 'M'
			if( nrun = 1 ) then
				n += hPatNum( buf + n, mo, 1 )
			elseif( nrun = 2 ) then
				n += hPatNum( buf + n, mo, 2 )
			elseif( nrun = 3 ) then
				n += hPatStr( buf + n, @hMonthAbbr(mo - 1).s )
			elseif( nrun = 4 ) then
				n += hPatStr( buf + n, @hMonthFull(mo - 1).s )
			else
				return DT_PAT_ERR
			end if

		case 100                                '' 'd'
			'' "d"/"dd" are the DAY OF MONTH; "ddd"/"dddd" are the WEEKDAY
			'' NAME. Same letter, two unrelated meanings, decided by nrun
			'' length -- and the nrun-3 case is a name, not a zero-padded 3.
			if( nrun = 1 ) then
				n += hPatNum( buf + n, d, 1 )
			elseif( nrun = 2 ) then
				n += hPatNum( buf + n, d, 2 )
			elseif( nrun = 3 ) then
				n += hPatStr( buf + n, @hDayAbbr(tkrt_DtDayOfWeek( days ) - 1).s )
			elseif( nrun = 4 ) then
				n += hPatStr( buf + n, @hDayFull(tkrt_DtDayOfWeek( days ) - 1).s )
			else
				return DT_PAT_ERR
			end if

		case 68                                 '' 'D' -- day of year
			n += hPatNum( buf + n, tkrt_DtDayOfYear( y, mo, d ), nrun )

		case 81                                 '' 'Q' -- quarter
			if( nrun <> 1 ) then return DT_PAT_ERR
			n += hPatNum( buf + n, ((mo - 1) \ 3) + 1, 1 )

		case 119                                '' 'w' -- ISO week
			if( nrun > 2 ) then return DT_PAT_ERR
			n += hPatNum( buf + n, tkrt_DtIsoWeek( y, mo, d, 0 ), nrun )

		case 89                                 '' 'Y' -- ISO WEEK-YEAR
			'' Not the calendar year: 2021-01-01 is week 53 of 2020, so "Y"
			'' and "yyyy" legitimately disagree at a year boundary.
			iy = y
			tkrt_DtIsoWeek( y, mo, d, @iy )
			n += hPatNum( buf + n, iy, nrun )

		case 103                                '' 'g' -- era
			n += hPatStr( buf + n, @"A.D." )

		case 72                                 '' 'H' -- 24-hour
			if( nrun > 2 ) then return DT_PAT_ERR
			n += hPatNum( buf + n, h, nrun )

		case 104                                '' 'h' -- 12-hour
			'' 00:00 is 12 AM and 12:00 is 12 PM: hour mod 12, with 0 mapped
			'' to 12. Plain `h mod 12` prints midnight as 0.
			h12 = h mod 12
			if( h12 = 0 ) then h12 = 12
			if( nrun > 2 ) then return DT_PAT_ERR
			n += hPatNum( buf + n, h12, nrun )

		case 109                                '' 'm'
			if( nrun > 2 ) then return DT_PAT_ERR
			n += hPatNum( buf + n, mi, nrun )

		case 115                                '' 's'
			if( nrun > 2 ) then return DT_PAT_ERR
			n += hPatNum( buf + n, s, nrun )

		case 102                                '' 'f' -- FIXED subseconds
			if( nrun > 7 ) then return DT_PAT_ERR
			v = sub_
			for i = 7 to nrun + 1 step -1
				v \= 10
			next
			n += hPatNum( buf + n, v, nrun )

		case 70                                 '' 'F' -- TRIMMED subseconds
			if( nrun > 7 ) then return DT_PAT_ERR
			v = sub_
			for i = 7 to nrun + 1 step -1
				v \= 10
			next
			w = nrun
			while( (w > 0) andalso ((v mod 10) = 0) )
				v \= 10
				w -= 1
			wend
			if( w > 0 ) then
				n += hPatNum( buf + n, v, w )
			elseif( n > 0 ) then
				'' THE VANISHING FIELD TAKES THE DECIMAL POINT WITH IT, or
				'' "HH:mm:ss.FFF" leaves a trailing dot on a whole second.
				if( buf[n - 1] = 46 ) then n -= 1
			end if

		case 116                                '' 't' -- AM/PM
			if( nrun = 1 ) then
				buf[n] = iif( h < 12, 65, 80 ) : n += 1
			elseif( nrun = 2 ) then
				buf[n] = iif( h < 12, 65, 80 ) : n += 1
				buf[n] = 77 : n += 1
			else
				return DT_PAT_ERR
			end if

		case 122                                '' 'z' -- numeric offset
			'' An unspecified offset emits NOTHING and is not an error.
			if( offMin = DT_PAT_OFFSET_UNSPECIFIED ) then continue while
			sign_ = iif( offMin < 0, 1, 0 )
			a = iif( offMin < 0, -offMin, offMin )
			buf[n] = iif( sign_, 45, 43 ) : n += 1
			if( nrun = 1 ) then
				n += hPatNum( buf + n, a \ 60, 1 )
			elseif( nrun = 2 ) then
				n += hPatNum( buf + n, a \ 60, 2 )
			elseif( nrun = 3 ) then
				n += hPatNum( buf + n, a \ 60, 2 )
				buf[n] = 58 : n += 1
				n += hPatNum( buf + n, a mod 60, 2 )
			else
				return DT_PAT_ERR
			end if

		case 75                                 '' 'K' -- ISO-style zone
			if( nrun <> 1 ) then return DT_PAT_ERR
			if( offMin = DT_PAT_OFFSET_UNSPECIFIED ) then continue while
			if( offMin = 0 ) then
				buf[n] = 90 : n += 1            '' 'Z'
			else
				sign_ = iif( offMin < 0, 1, 0 )
				a = iif( offMin < 0, -offMin, offMin )
				buf[n] = iif( sign_, 45, 43 ) : n += 1
				n += hPatNum( buf + n, a \ 60, 2 )
				buf[n] = 58 : n += 1
				n += hPatNum( buf + n, a mod 60, 2 )
			end if

		case else
			'' See the header: a typo is an error, not literal text.
			return DT_PAT_ERR
		end select
	wend

	return n
end function

'' Shift to UTC for the "u" and "R" constant formats. A value with NO offset is
'' taken at face value rather than guessed at, and a shift that would leave the
'' representable range is abandoned rather than clamped.
private function hPatToUtc( byval ticks as int64, byval offMin as int32 ) as int64
	dim as int64 r = any
	if( offMin = DT_PAT_OFFSET_UNSPECIFIED ) then return ticks
	if( offMin = 0 ) then return ticks
	r = ticks - cast( int64, offMin ) * FB_DT_TICKS_PER_MINUTE
	if( tkrt_DtIsValidTicks( r ) = 0 ) then return ticks
	return r
end function

extern "rtlib"

function tkort_DtPatFormat alias "fb_DtPatFormat" _
	( byval ticks as int64, byval offMin as int32, byval pat as uint8 ptr, _
	  byval patlen as int32, byval buf as uint8 ptr, byval buflen as int32 ) as int32

	dim as int32 n = any, L = any
	dim as zstring ptr expand = 0

	if( buf = 0 ) then return DT_PAT_ERR
	if( buflen < 8 ) then return DT_PAT_ERR
	buf[0] = 0
	if( pat = 0 ) then return DT_PAT_ERR
	if( patlen < 0 ) then return DT_PAT_ERR
	if( tkrt_DtIsValidTicks( ticks ) = 0 ) then return DT_PAT_ERR

	'' A ONE-CHARACTER PATTERN IS A NAMED FORMAT -- see the header.
	if( patlen = 1 ) then
		select case pat[0]
		case 111, 79                            '' 'o' / 'O'
			'' Byte-identical to the ISO emitter by DELEGATION, not by a
			'' second copy of the same layout.
			return tkrt_DtIsoFormat( ticks, offMin, buf, buflen )
		case 115                                '' 's' -- sortable
			expand = @"yyyy-MM-dd'T'HH:mm:ss"
		case 100                                '' 'd' -- short date
			expand = @"yyyy-MM-dd"
		case 84                                 '' 'T' -- long time
			expand = @"HH:mm:ss"
		case 117                                '' 'u' -- universal
			ticks = hPatToUtc( ticks, offMin )
			expand = @"yyyy-MM-dd HH:mm:ss'Z'"
		case 82                                 '' 'R' -- RFC 1123, for HTTP
			'' ALWAYS GMT, ALWAYS ENGLISH, and the value is converted to UTC
			'' FIRST. Emitting a local time under a "GMT" label is the
			'' classic HTTP-header bug.
			ticks = hPatToUtc( ticks, offMin )
			expand = @"ddd, dd MMM yyyy HH:mm:ss 'GMT'"
		end select

		if( expand <> 0 ) then
			L = 0
			while( expand[L] <> 0 )
				L += 1
			wend
			n = hPatFormatCore( ticks, offMin, expand, L, buf, buflen )
			if( n < 0 ) then
				buf[0] = 0
				return DT_PAT_ERR
			end if
			buf[n] = 0
			return n
		end if
	end if

	n = hPatFormatCore( ticks, offMin, pat, patlen, buf, buflen )
	if( n < 0 ) then
		buf[0] = 0
		return DT_PAT_ERR
	end if
	buf[n] = 0
	return n
end function

end extern

'' ----------------------------------------------------------------- parse

type FB_DTPARTS
	as int32     year_, month_, day_
	as int32     hour24, hour12, minute_, second_
	as int64  sub_
	as int32     ampm                            '' -1 none, 0 AM, 1 PM
	as int32     off
	as int32     doy
	as int32     wday                            '' from ddd/dddd, cross-checked
	as int32     hasYear, hasMonth, hasDay, hasHour24, hasHour12
	as int32     hasMin, hasSec, hasDoy
end type

'' Set a field, FAILING if it is already set to a DIFFERENT value. Repeating a
'' field consistently is fine; contradicting it is not -- so "2025-03-04" under
'' "yyyy-MM-dd" with a second, disagreeing day is rejected rather than taking
'' the last one.
private function hSet( byval slot as int32 ptr, byval has as int32 ptr, byval v as int32 ) as int32
	if( (*has <> 0) andalso (*slot <> v) ) then return 1
	*slot = v
	*has = 1
	return 0
end function

'' Case-insensitive match against a name table, advancing pos on success.
'' Returns the 1-BASED index through out_.
private function hMatchName( byval s as uint8 ptr, byval slen as int32, byval pos_ as integer ptr, _
                             byval tbl as TKORT_NAME16 ptr, byval cnt as int32, _
                             byval out_ as int32 ptr ) as int32
	dim as int32 i = any, j = any
	dim as uint32 a = any, b = any
	dim as zstring ptr w = any

	for i = 0 to cnt - 1
		w = @tbl[i].s
		j = 0
		while( w[j] <> 0 )
			if( *pos_ + j >= slen ) then exit while
			a = s[*pos_ + j]
			b = w[j]
			if( (a >= 65) andalso (a <= 90) ) then a += 32
			if( (b >= 65) andalso (b <= 90) ) then b += 32
			if( a <> b ) then exit while
			j += 1
		wend
		if( w[j] = 0 ) then
			'' THE TABLES ARE SEARCHED IN ORDER, so "Jun" cannot be shadowed
			'' by an earlier prefix -- no month abbreviation is a prefix of
			'' another, which is what makes first-match correct here.
			*pos_ += j
			*out_ = i + 1
			return 0
		end if
	next
	return 1
end function

'' Exactly `fixed` digits when fixed > 0, otherwise 1..maxd.
private function hReadNum( byval s as uint8 ptr, byval slen as int32, byval pos_ as integer ptr, _
                           byval fixed as int32, byval maxd as int32, byval out_ as int32 ptr ) as int32
	dim as int32 v = 0, n = 0, i = any

	if( fixed > 0 ) then
		if( *pos_ + fixed > slen ) then return 1
		for i = 0 to fixed - 1
			if( hIsDigit( s[*pos_ + i] ) = 0 ) then return 1
			v = v * 10 + (s[*pos_ + i] - 48)
		next
		*pos_ += fixed
		*out_ = v
		return 0
	end if

	while( (*pos_ < slen) andalso (n < maxd) )
		if( hIsDigit( s[*pos_] ) = 0 ) then exit while
		v = v * 10 + (s[*pos_] - 48)
		*pos_ += 1
		n += 1
	wend
	if( n = 0 ) then return 1
	*out_ = v
	return 0
end function

'' Does the token at p consume digits? Used for the adjacent-variable-width
'' ambiguity check below. MMM and dddd are NAMES, not numbers.
private function hTokenIsNumeric( byval p as uint8 ptr, byval pend as uint8 ptr ) as int32
	if( p >= pend ) then return 0
	select case *p
	case 121, 77, 100, 68, 81, 119, 89, 72, 104, 109, 115, 102, 70
		if( (*p = 77) andalso (hRun( p, pend ) >= 3) ) then return 0
		if( (*p = 100) andalso (hRun( p, pend ) >= 3) ) then return 0
		return 1
	end select
	return 0
end function

extern "rtlib"

'' Strict parse. RETURNS 0 ON SUCCESS, 1 ON AN INPUT MISMATCH, 2 ON A PATTERN
'' ERROR -- three outcomes, not two, because "this pattern cannot work" and
'' "this input does not match" need different fixes.
function tkort_DtPatParse alias "fb_DtPatParse" _
	( byval s as uint8 ptr, byval slen as int32, byval pat as uint8 ptr, _
	  byval patlen as int32, byval out_ticks as int64 ptr, _
	  byval out_off as int32 ptr ) as int32

	dim as FB_DTPARTS pt = any
	dim as uint8 ptr p = pat, pend = pat + patlen
	'' integer, not long: it is a position within the input string, and the
	'' index-width rule applies to it even though every value it holds is
	'' small -- the type is what the lint checks, not the range.
	dim as integer pos_ = 0
	dim as int64 ticks = any, acc = any
	dim as int32 nrun = any, v = any, i = any, got = any
	dim as int32 sign_ = any, hh = any, mm = any, h = any, dy = any
	dim as int32 yy = any, mm2 = any, dd = any
	dim as uint32 c = any, a = any, b = any

	hInitNames( )

	if( out_ticks <> 0 ) then *out_ticks = FB_DT_INVALID_TICKS
	if( out_off <> 0 ) then *out_off = DT_PAT_OFFSET_UNSPECIFIED
	if( s = 0 ) then return 1
	if( pat = 0 ) then return 1
	if( slen < 0 ) then return 1
	if( patlen <= 0 ) then return 1

	'' Constant formats. "o"/"O" round-trips through the ISO parser; "R" and
	'' "u" are FORMAT-ONLY and are rejected -- "GMT" and a trailing "Z" carry
	'' no offset that could be recovered.
	if( patlen = 1 ) then
		select case pat[0]
		case 111, 79
			return tkrt_DtIsoParse( s, slen, out_ticks, out_off )
		case 115 : pat = @"yyyy-MM-dd'T'HH:mm:ss"
		case 100 : pat = @"yyyy-MM-dd"
		case 84  : pat = @"HH:mm:ss"
		case else
			return 2
		end select
		patlen = 0
		while( pat[patlen] <> 0 )
			patlen += 1
		wend
		p = pat
		pend = pat + patlen
	end if

	pt.year_ = 1 : pt.month_ = 1 : pt.day_ = 1
	pt.hour24 = 0 : pt.hour12 = 0 : pt.minute_ = 0 : pt.second_ = 0
	pt.sub_ = 0 : pt.ampm = -1 : pt.off = DT_PAT_OFFSET_UNSPECIFIED
	pt.doy = 0 : pt.wday = 0
	pt.hasYear = 0 : pt.hasMonth = 0 : pt.hasDay = 0
	pt.hasHour24 = 0 : pt.hasHour12 = 0
	pt.hasMin = 0 : pt.hasSec = 0 : pt.hasDoy = 0

	while( p < pend )
		c = *p

		if( c = 39 ) then                       '' quoted literal
			p += 1
			do
				if( p >= pend ) then return 2
				if( *p = 39 ) then
					p += 1
					if( p < pend ) then
						if( *p = 39 ) then
							if( pos_ >= slen ) then return 1
							if( s[pos_] <> 39 ) then return 1
							pos_ += 1 : p += 1
							continue do
						end if
					end if
					exit do
				end if
				if( pos_ >= slen ) then return 1
				if( s[pos_] <> *p ) then return 1
				pos_ += 1 : p += 1
			loop
			continue while
		end if

		if( c = 92 ) then                       '' backslash escape
			p += 1
			if( p >= pend ) then return 2
			if( pos_ >= slen ) then return 1
			if( s[pos_] <> *p ) then return 1
			pos_ += 1 : p += 1
			continue while
		end if

		if( hIsAlpha( c ) = 0 ) then
			'' A LITERAL '.' IMMEDIATELY BEFORE AN F RUN IS OPTIONAL, so a
			'' pattern that formats the dot away also parses without it.
			'' That is what keeps "HH:mm:ss.FFF" round-tripping both ways.
			if( c = 46 ) then
				if( p + 1 < pend ) then
					if( *(p + 1) = 70 ) then
						if( pos_ < slen ) then
							if( s[pos_] = 46 ) then pos_ += 1
						end if
						p += 1
						continue while
					end if
				end if
			end if
			if( pos_ >= slen ) then return 1
			if( s[pos_] <> c ) then return 1
			pos_ += 1 : p += 1
			continue while
		end if

		nrun = hRun( p, pend )

		'' A VARIABLE-WIDTH NUMERIC FIELD FOLLOWED BY ANOTHER NUMERIC FIELD
		'' cannot be parsed unambiguously -- "dM" on "123" could be 1/23 or
		'' 12/3. Rejected as a PATTERN error, so it fails on every input
		'' rather than on the 3rd of December.
		if( (nrun = 1) andalso hTokenIsNumeric( p, pend ) andalso _
		    (c <> 102) andalso (c <> 70) ) then
			if( hTokenIsNumeric( p + nrun, pend ) ) then return 2
		end if

		p += nrun

		select case c
		case 121                                '' 'y'
			'' TWO-DIGIT YEARS ARE REJECTED ON INPUT. There is no century
			'' inference rule here, and guessing one is how "70" becomes
			'' either 1970 or 2070 depending on the decade.
			if( nrun = 2 ) then return 2
			if( hReadNum( s, slen, @pos_, iif( nrun >= 4, nrun, 0 ), 5, @v ) ) then return 1
			if( hSet( @pt.year_, @pt.hasYear, v ) ) then return 1

		case 77                                 '' 'M'
			if( nrun <= 2 ) then
				if( hReadNum( s, slen, @pos_, iif( nrun = 2, 2, 0 ), 2, @v ) ) then return 1
			elseif( nrun = 3 ) then
				if( hMatchName( s, slen, @pos_, @hMonthAbbr(0), 12, @v ) ) then return 1
			elseif( nrun = 4 ) then
				if( hMatchName( s, slen, @pos_, @hMonthFull(0), 12, @v ) ) then return 1
			else
				return 2
			end if
			if( hSet( @pt.month_, @pt.hasMonth, v ) ) then return 1

		case 100                                '' 'd'
			if( nrun <= 2 ) then
				if( hReadNum( s, slen, @pos_, iif( nrun = 2, 2, 0 ), 2, @v ) ) then return 1
				if( hSet( @pt.day_, @pt.hasDay, v ) ) then return 1
			elseif( nrun = 3 ) then
				if( hMatchName( s, slen, @pos_, @hDayAbbr(0), 7, @v ) ) then return 1
				pt.wday = v
			elseif( nrun = 4 ) then
				if( hMatchName( s, slen, @pos_, @hDayFull(0), 7, @v ) ) then return 1
				pt.wday = v
			else
				return 2
			end if

		case 68                                 '' 'D'
			if( hReadNum( s, slen, @pos_, iif( nrun >= 3, 3, 0 ), 3, @v ) ) then return 1
			if( hSet( @pt.doy, @pt.hasDoy, v ) ) then return 1

		case 72                                 '' 'H'
			if( hReadNum( s, slen, @pos_, iif( nrun = 2, 2, 0 ), 2, @v ) ) then return 1
			if( hSet( @pt.hour24, @pt.hasHour24, v ) ) then return 1

		case 104                                '' 'h'
			if( hReadNum( s, slen, @pos_, iif( nrun = 2, 2, 0 ), 2, @v ) ) then return 1
			if( hSet( @pt.hour12, @pt.hasHour12, v ) ) then return 1

		case 109                                '' 'm'
			if( hReadNum( s, slen, @pos_, iif( nrun = 2, 2, 0 ), 2, @v ) ) then return 1
			if( hSet( @pt.minute_, @pt.hasMin, v ) ) then return 1

		case 115                                '' 's'
			if( hReadNum( s, slen, @pos_, iif( nrun = 2, 2, 0 ), 2, @v ) ) then return 1
			if( hSet( @pt.second_, @pt.hasSec, v ) ) then return 1

		case 102, 70                            '' 'f' / 'F'
			if( nrun > 7 ) then return 2
			got = 0
			acc = 0
			while( (got < nrun) andalso (pos_ < slen) )
				if( hIsDigit( s[pos_] ) = 0 ) then exit while
				acc = acc * 10 + (s[pos_] - 48)
				pos_ += 1
				got += 1
			wend
			'' 'f' is FIXED WIDTH and must be fully present; 'F' may be absent.
			if( (c = 102) andalso (got <> nrun) ) then return 1
			for i = got to 6
				acc *= 10
			next
			pt.sub_ = acc

		case 116                                '' 't'
			if( pos_ >= slen ) then return 1
			a = s[pos_]
			if( (a >= 97) andalso (a <= 122) ) then a -= 32
			if( a = 65 ) then
				pt.ampm = 0
			elseif( a = 80 ) then
				pt.ampm = 1
			else
				return 1
			end if
			pos_ += 1
			if( nrun = 2 ) then
				if( pos_ >= slen ) then return 1
				b = s[pos_]
				if( (b >= 97) andalso (b <= 122) ) then b -= 32
				if( b <> 77 ) then return 1
				pos_ += 1
			elseif( nrun > 2 ) then
				return 2
			end if

		case 122, 75                            '' 'z' / 'K'
			mm = 0
			if( (c = 75) andalso (nrun <> 1) ) then return 2
			if( pos_ >= slen ) then
				'' 'K' MAY MATCH NOTHING -- an absent zone is not an error.
				if( c = 75 ) then continue while
				return 1
			end if
			if( c = 75 ) then
				if( (s[pos_] = 90) orelse (s[pos_] = 122) ) then
					pos_ += 1
					pt.off = 0
					continue while
				end if
			end if
			if( (s[pos_] <> 43) andalso (s[pos_] <> 45) ) then
				if( c = 75 ) then continue while
				return 1
			end if
			sign_ = iif( s[pos_] = 45, -1, 1 )
			pos_ += 1
			if( hReadNum( s, slen, @pos_, iif( (nrun >= 2) orelse (c = 75), 2, 0 ), 2, @hh ) ) then return 1
			if( pos_ < slen ) then
				if( s[pos_] = 58 ) then
					pos_ += 1
					if( hReadNum( s, slen, @pos_, 2, 2, @mm ) ) then return 1
				end if
			end if
			if( mm > 59 ) then return 1
			pt.off = sign_ * (hh * 60 + mm)
			if( pt.off < -1080 ) then return 1
			if( pt.off > 1080 ) then return 1

		case 81, 119, 89, 103                   '' 'Q' 'w' 'Y' 'g'
			'' FORMAT-ONLY: a quarter or a week number cannot reconstruct a
			'' date, and an era carries no information. Accepting and
			'' ignoring them would silently drop part of the input.
			return 2

		case else
			return 2
		end select
	wend

	'' THE INPUT MUST BE FULLY CONSUMED -- trailing characters are an error.
	if( pos_ <> slen ) then return 1

	if( pt.hasHour12 ) then
		if( (pt.hour12 < 1) orelse (pt.hour12 > 12) ) then return 1
		h = pt.hour12 mod 12
		if( pt.ampm = 1 ) then h += 12
		'' With NO AM/PM marker, a bare 12 means NOON, not midnight.
		if( (pt.ampm = -1) andalso (pt.hour12 = 12) ) then h = 12
		if( pt.hasHour24 andalso (pt.hour24 <> h) ) then return 1
		pt.hour24 = h
	end if

	if( pt.hasDoy ) then
		if( pt.doy < 1 ) then return 1
		if( pt.doy > tkrt_DtDaysInYear( pt.year_ ) ) then return 1
		dy = tkrt_DtDaysFromCivil( pt.year_, 1, 1 ) + pt.doy - 1
		tkrt_DtCivilFromDays( dy, @yy, @mm2, @dd )
		'' A day-of-year that CONTRADICTS an explicit month or day fails
		'' rather than overriding it.
		if( pt.hasMonth andalso (pt.month_ <> mm2) ) then return 1
		if( pt.hasDay andalso (pt.day_ <> dd) ) then return 1
		pt.month_ = mm2
		pt.day_ = dd
	end if

	if( tkrt_DtFromCivil( pt.year_, pt.month_, pt.day_, pt.hour24, _
	                      pt.minute_, pt.second_, pt.sub_, @ticks ) ) then return 1

	'' A NAMED WEEKDAY IS CROSS-CHECKED against the date it accompanies:
	'' "Monday 2025-03-04" fails, because that is a Tuesday.
	if( pt.wday <> 0 ) then
		if( tkrt_DtDayOfWeek( tkrt_DtDaysFromCivil( pt.year_, pt.month_, pt.day_ ) ) <> pt.wday ) then
			return 1
		end if
	end if

	if( out_ticks <> 0 ) then *out_ticks = ticks
	if( out_off <> 0 ) then *out_off = pt.off
	return 0
end function

end extern
