'' core.tiko -- the chrono kernel: civil calendar <-> tick conversion.
'' Fifteen entry points over one fbc member.
''
'' Pure. No OS call, no allocation, no locale, no global. Proleptic Gregorian
'' throughout, so every year from 1 to 9999 uses the same rules.
''
'' THE TWO CONVERSION PRIMITIVES ARE CLOSED FORM, NOT LOOPS. Shift the year to
'' start in March so the leap day lands last, then do arithmetic on the
'' 146097-day 400-year cycle. This is a different algorithm from the one in
'' dt/serial.tiko, which walks year by year from 1900 -- the two coexist because
'' they implement different, incompatible epochs, and neither is a cleanup
'' opportunity for the other.
''
'' EVERY DIVISION HERE IS C'S TRUNCATING DIVISION, and several inputs are
'' negative, so the `era` and `doy` expressions carry explicit bias terms to
'' get floor behaviour out of truncation. FreeBASIC's `\` truncates the same
'' way, so those biases are reproduced verbatim rather than "simplified" into
'' a floor that would silently change the answer for year <= 0.
''
'' fb_DtToCivil DOES THE SAME CORRECTION BY HAND for the time of day: after
'' `ticks mod TICKS_PER_DAY`, a negative remainder is pushed positive and the
'' day count decremented. Without it, any instant before the epoch decodes to
'' a negative hour.

#include once "inc/chrono.ti"

extern "rtlib"

function tkort_DtIsLeapYear alias "fb_DtIsLeapYear" ( byval year as int32 ) as int32
	'' `mod 4`, not `and 3`, unlike fb_hTimeLeap in dt/serial.tiko: this
	'' kernel's year range starts at 1, so the negative case the bitwise
	'' test guards against cannot arise, and the two files differ on purpose.
	if( (year mod 400) = 0 ) then return 1
	if( (year mod 100) = 0 ) then return 0
	if( (year mod 4) = 0 ) then return 1
	return 0
end function

'' Returns 0 -- not 28, not an error -- for a month outside 1..12. Callers use
'' that as the range test.
function tkort_DtDaysInMonth alias "fb_DtDaysInMonth" _
	( byval year as int32, byval month as int32 ) as int32
	static as int32 days(0 to 11) = { 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31 }
	if( (month < 1) orelse (month > 12) ) then return 0
	if( month = 2 ) then return 28 + tkort_DtIsLeapYear( year )
	return days(month - 1)
end function

function tkort_DtDaysInYear alias "fb_DtDaysInYear" ( byval year as int32 ) as int32
	return 365 + tkort_DtIsLeapYear( year )
end function

'' Days since 0001-01-01. Day 0 IS 0001-01-01, so this is not the same origin
'' as fb_DateSerial's 1899-12-30 and the two must never be mixed.
function tkort_DtDaysFromCivil alias "fb_DtDaysFromCivil" _
	( byval year as int32, byval month as int32, byval day_ as int32 ) as int32

	dim as int32 era = any, yoe = any, doy = any, doe = any

	'' March-based year: the leap day becomes the LAST day of the year, so
	'' the 4/100/400 rules need no special case below.
	if( month <= 2 ) then year -= 1

	'' The -399 bias makes truncating division behave as floor for negatives.
	if( year >= 0 ) then
		era = year \ 400
	else
		era = (year - 399) \ 400
	end if

	yoe = year - era * 400                                    '' 0 .. 399
	if( month > 2 ) then
		doy = (153 * (month - 3) + 2) \ 5 + day_ - 1          '' 0 .. 365
	else
		doy = (153 * (month + 9) + 2) \ 5 + day_ - 1
	end if
	doe = yoe * 365 + yoe \ 4 - yoe \ 100 + doy               '' 0 .. 146096

	return era * DT_DAYS_PER_ERA + doe - DT_ERA_SHIFT
end function

'' The exact inverse. Any of the three outputs may be NULL.
sub tkort_DtCivilFromDays alias "fb_DtCivilFromDays" _
	( byval days as int32, byval year as int32 ptr, _
	  byval month as int32 ptr, byval day_ as int32 ptr )

	dim as int32 era = any, doe = any, yoe = any, doy = any, mp = any
	dim as int32 y = any, m = any, d = any

	days += DT_ERA_SHIFT

	if( days >= 0 ) then
		era = days \ DT_DAYS_PER_ERA
	else
		era = (days - (DT_DAYS_PER_ERA - 1)) \ DT_DAYS_PER_ERA
	end if

	doe = days - era * DT_DAYS_PER_ERA                        '' 0 .. 146096
	yoe = (doe - doe \ 1460 + doe \ 36524 - doe \ 146096) \ 365
	y   = yoe + era * 400
	doy = doe - (365 * yoe + yoe \ 4 - yoe \ 100)             '' 0 .. 365
	mp  = (5 * doy + 2) \ 153                                 '' 0 .. 11
	d   = doy - (153 * mp + 2) \ 5 + 1                        '' 1 .. 31
	if( mp < 10 ) then m = mp + 3 else m = mp - 9             '' 1 .. 12
	if( m <= 2 ) then y += 1

	if( year  <> 0 ) then *year  = y
	if( month <> 0 ) then *month = m
	if( day_  <> 0 ) then *day_  = d
end sub

'' 1 = Monday .. 7 = Sunday. Day 0 is 0001-01-01, a MONDAY -- so this numbering
'' is ISO's, and it is NOT the same as fb_Weekday's 1 = Sunday.
function tkort_DtDayOfWeek alias "fb_DtDayOfWeek" ( byval days as int32 ) as int32
	dim as int32 r = days mod 7
	if( r < 0 ) then r += 7
	return r + 1
end function

function tkort_DtDayOfYear alias "fb_DtDayOfYear" _
	( byval year as int32, byval month as int32, byval day_ as int32 ) as int32
	return tkort_DtDaysFromCivil( year, month, day_ ) _
	     - tkort_DtDaysFromCivil( year, 1, 1 ) + 1
end function

end extern

'' Weekday of 31 December of `year`, 0..6. The standard ISO helper. STATIC in
'' fbc, so there is no symbol for it and none is exported here.
private function hDtIsoP( byval year as int32 ) as int32
	return (year + year \ 4 - year \ 100 + year \ 400) mod 7
end function

extern "rtlib"

'' 52 or 53. A year has 53 ISO weeks when it starts on a Thursday, or when the
'' PREVIOUS year started on a Wednesday and this one is a leap year -- the two
'' arms of the test below, in that order.
function tkort_DtIsoWeeksInYear alias "fb_DtIsoWeeksInYear" ( byval year as int32 ) as int32
	if( hDtIsoP( year ) = 4 ) then return 53
	if( hDtIsoP( year - 1 ) = 3 ) then return 53
	return 52
end function

'' ISO week number, with the ISO YEAR reported separately through out_iso_year.
''
'' THE ISO YEAR IS NOT THE CALENDAR YEAR. 2021-01-01 is week 53 OF 2020, and
'' 2019-12-30 is week 1 OF 2020. Returning only the week number loses which
'' year it belongs to, which is why the second output exists -- and why it must
'' be filled on the ordinary path too, not just the two boundary arms.
function tkort_DtIsoWeek alias "fb_DtIsoWeek" _
	( byval year as int32, byval month as int32, byval day_ as int32, _
	  byval out_iso_year as int32 ptr ) as int32

	dim as int32 doy = any, dow = any, week = any, iso_year = any

	doy = tkort_DtDayOfYear( year, month, day_ )
	dow = tkort_DtDayOfWeek( tkort_DtDaysFromCivil( year, month, day_ ) )

	'' Week 1 is the week containing the first Thursday of the year.
	week = (doy - dow + 10) \ 7
	iso_year = year

	if( week < 1 ) then
		'' Last week of the previous ISO year.
		iso_year = year - 1
		week = tkort_DtIsoWeeksInYear( iso_year )
	elseif( week > tkort_DtIsoWeeksInYear( year ) ) then
		'' Week 1 of the next ISO year.
		iso_year = year + 1
		week = 1
	end if

	if( out_iso_year <> 0 ) then *out_iso_year = iso_year
	return week
end function

function tkort_DtIsValidDate alias "fb_DtIsValidDate" _
	( byval year as int32, byval month as int32, byval day_ as int32 ) as int32
	if( (year < FB_DT_MIN_YEAR) orelse (year > FB_DT_MAX_YEAR) ) then return 0
	if( (month < 1) orelse (month > 12) ) then return 0
	if( (day_ < 1) orelse (day_ > tkort_DtDaysInMonth( year, month )) ) then return 0
	return 1
end function

'' NO LEAP SECONDS: 60 is not a valid second. That is a decision, not an
'' oversight -- the tick representation has no room for one.
function tkort_DtIsValidTime alias "fb_DtIsValidTime" _
	( byval hour as int32, byval minute as int32, byval second as int32, _
	  byval subsecond_ticks as int64 ) as int32
	if( (hour < 0) orelse (hour > 23) ) then return 0
	if( (minute < 0) orelse (minute > 59) ) then return 0
	if( (second < 0) orelse (second > 59) ) then return 0
	if( (subsecond_ticks < 0) orelse (subsecond_ticks >= FB_DT_TICKS_PER_SECOND) ) then return 0
	return 1
end function

function tkort_DtIsValidTicks alias "fb_DtIsValidTicks" ( byval ticks as int64 ) as int32
	if( (ticks >= FB_DT_MIN_TICKS) andalso (ticks <= FB_DT_MAX_TICKS) ) then return 1
	return 0
end function

'' RETURNS 0 ON SUCCESS AND 1 ON FAILURE -- the C convention, not a boolean.
'' out_ticks is set to FB_DT_INVALID_TICKS FIRST, so a caller that ignores the
'' return value still sees a sentinel rather than a stale or half-built value.
function tkort_DtFromCivil alias "fb_DtFromCivil" _
	( byval year as int32, byval month as int32, byval day_ as int32, _
	  byval hour as int32, byval minute as int32, byval second as int32, _
	  byval subsecond_ticks as int64, byval out_ticks as int64 ptr ) as int32

	if( out_ticks <> 0 ) then *out_ticks = FB_DT_INVALID_TICKS

	if( tkort_DtIsValidDate( year, month, day_ ) = 0 ) then return 1
	if( tkort_DtIsValidTime( hour, minute, second, subsecond_ticks ) = 0 ) then return 1

	if( out_ticks <> 0 ) then
		*out_ticks = cast( int64, tkort_DtDaysFromCivil( year, month, day_ ) ) * FB_DT_TICKS_PER_DAY _
		           + cast( int64, hour ) * FB_DT_TICKS_PER_HOUR _
		           + cast( int64, minute ) * FB_DT_TICKS_PER_MINUTE _
		           + cast( int64, second ) * FB_DT_TICKS_PER_SECOND _
		           + subsecond_ticks
	end if

	return 0
end function

sub tkort_DtToCivil alias "fb_DtToCivil" _
	( byval ticks as int64, byval year as int32 ptr, byval month as int32 ptr, _
	  byval day_ as int32 ptr, byval hour as int32 ptr, byval minute as int32 ptr, _
	  byval second as int32 ptr, byval subsecond_ticks as int64 ptr )

	dim as int32 days = any
	dim as int64 tod = any

	days = cast( int32, ticks \ FB_DT_TICKS_PER_DAY )
	tod  = ticks mod FB_DT_TICKS_PER_DAY
	if( tod < 0 ) then
		'' Truncation gives a negative remainder; the calendar needs floor.
		tod += FB_DT_TICKS_PER_DAY
		days -= 1
	end if

	tkort_DtCivilFromDays( days, year, month, day_ )

	if( hour   <> 0 ) then *hour   = cast( int32, tod \ FB_DT_TICKS_PER_HOUR )
	if( minute <> 0 ) then *minute = cast( int32, tod \ FB_DT_TICKS_PER_MINUTE mod 60 )
	if( second <> 0 ) then *second = cast( int32, tod \ FB_DT_TICKS_PER_SECOND mod 60 )
	if( subsecond_ticks <> 0 ) then *subsecond_ticks = tod mod FB_DT_TICKS_PER_SECOND
end sub

'' counts * 10^7 / freq, without overflowing.
''
'' THE OBVIOUS ORDER OVERFLOWS. At a 10 MHz QPC frequency, counts * 10^7 passes
'' a signed 64-bit integer after about 25.6 hours of uptime -- well inside what
'' a real program sees. fbc uses __int128 where the compiler has one;
'' FreeBASIC has no 128-bit type, so this is always the split form.
''
'' THE SPLIT IS EXACT, NOT AN APPROXIMATION:
''     floor(c*T/f) = (c\f)*T + floor((c mod f)*T/f)
'' and (c mod f) < f, so the remaining product cannot overflow for any
'' plausible frequency. It is the same answer as the 128-bit path, not a
'' near-enough one.
function tkort_DtTicksFromCounts alias "fb_DtTicksFromCounts" _
	( byval counts as int64, byval freq as int64 ) as int64

	dim as int64 whole = any, rem_ = any

	if( freq <= 0 ) then return 0
	if( counts < 0 ) then return 0

	whole = counts \ freq
	rem_  = counts mod freq
	return whole * FB_DT_TICKS_PER_SECOND _
	     + (rem_ * FB_DT_TICKS_PER_SECOND) \ freq
end function

end extern
