'' tostr.tiko -- STR$ for WSTRING: seven entry points over four fbc members.
''
'' FORMATTED NARROW, THEN WIDENED -- and that is a correctness choice, not a
'' convenience.
''
'' fbc formats these with swprintf, which on MinGW is #defined to _snwprintf.
'' The two are NOT the same function: C99's swprintf always NUL-terminates and
'' returns the length it would have written, while _snwprintf writes NOTHING at
'' the end on truncation and returns a negative number. Reproducing "swprintf"
'' faithfully therefore means reproducing two different functions depending on
'' the target, in code whose whole job is to be identical everywhere.
''
'' The output of "%.7g", "%.16g", "%d" and "%lld" is PURE ASCII in every locale
'' that supplies a decimal point of any kind, and both runtimes run in the same
'' locale -- so formatting with the narrow snprintf and widening character by
'' character produces byte-identical text with none of the truncation ambiguity.
'' The differential is what checks that claim rather than the argument for it.
''
'' The results are plain mallocs the caller frees with fb_WstrDelete: no
'' descriptor, no length field, and NULL for failure.

#include once "inc/descriptors.ti"
#include once "inc/wstr.ti"
#include once "inc/sysbind.ti"
#include once "inc/fmt.ti"

'' The widening step. The source is ASCII, so each byte becomes one code unit
'' and the store goes through a width-correct pointer -- indexing a wstring ptr
'' and assigning works, but the read side of that idiom does not (inc/wstr.ti),
'' so one accessor is used for both.
#if defined( __FB_WIN32__ ) or defined( __FB_WIN64__ )
	type TKORT_WTS_UNIT as uint16
#else
	type TKORT_WTS_UNIT as uint32
#endif

private function hWidenTemp( byval src as zstring ptr ) as wstring ptr

	dim as integer n = cast( integer, strlen( src ) )

	dim as wstring ptr dst = FB_WSTR_ALLOCTEMP( n )
	if( dst = nullptr ) then return nullptr

	dim as TKORT_WTS_UNIT ptr d = cptr( TKORT_WTS_UNIT ptr, dst )
	for i as integer = 0 to n - 1
		d[i] = cptr( uint8 ptr, src )[i]
	next
	d[n] = 0

	return dst

end function

'' Same trailing-dot rule as the narrow side.
private function hFloatToW _
	( byval num as float64, byval cap as integer, byval fmt as zstring ptr ) as wstring ptr

	dim as zstring * 64 buf
	tkrt_snprintf( @buf, 64, fmt, num )

	dim as integer n = cast( integer, strlen( @buf ) )
	if( n > 0 ) then
		if( buf[n - 1] = asc( "." ) ) then buf[n - 1] = 0
	end if

	return hWidenTemp( @buf )

end function

private function hIntToW( byval fmt as zstring ptr, byval num as int64 ) as wstring ptr
	dim as zstring * 64 buf
	tkrt_snprintf( @buf, 64, fmt, num )
	return hWidenTemp( @buf )
end function

extern "rtlib"

function tkort_IntToWstr alias "fb_IntToWstr" ( byval num as int32 ) as wstring ptr
	return hIntToW( @"%d", num )
end function

function tkort_UIntToWstr alias "fb_UIntToWstr" ( byval num as uint32 ) as wstring ptr
	return hIntToW( @"%u", cast( int64, num ) )
end function

function tkort_LongintToWstr alias "fb_LongintToWstr" ( byval num as int64 ) as wstring ptr
	return hIntToW( @"%lld", num )
end function

function tkort_ULongintToWstr alias "fb_ULongintToWstr" ( byval num as uint64 ) as wstring ptr
	return hIntToW( @"%llu", cast( int64, num ) )
end function

function tkort_FloatToWstr alias "fb_FloatToWstr" ( byval num as float32 ) as wstring ptr
	return hFloatToW( num, 7 + 8, @"%.7g" )
end function

function tkort_DoubleToWstr alias "fb_DoubleToWstr" ( byval num as float64 ) as wstring ptr
	return hFloatToW( num, 16 + 8, @"%.16g" )
end function

end extern

'' fb_FloatExToWstr -- the wide twin of fb_hFloat2Str, and it carries the same
'' ADDBLANK contract: the text goes at buffer[1] and the RETURNED POINTER says
'' whether the leading blank was used. NON-FBCALL, into a caller-supplied buffer.
''
'' NOTE THE ONE ASYMMETRY WITH THE NARROW VERSION: fb_hFloat2Str treats a failed
'' or truncated conversion as an error, empties the buffer and returns NULL.
'' This one has no such check in fbc -- it formats and carries on. Reproduced,
'' not harmonised.
const FB_F2A_ADDBLANK_W = 1

extern "c"   '' NON-FBCALL: fb_unicode.h declares it without the macro.

function tkort_FloatExToWstr alias "fb_FloatExToWstr" _
	( byval val_ as float64, byval buffer as wstring ptr, _
	  byval digits as int32, byval mask as int32 ) as wstring ptr

	dim as TKORT_WTS_UNIT ptr b = cptr( TKORT_WTS_UNIT ptr, buffer )
	dim as integer base_ = 0
	if( (mask and FB_F2A_ADDBLANK_W) <> 0 ) then base_ = 1

	dim as zstring * 64 fmtstr, buf
	tkrt_sprintf( @fmtstr, @"%%.%dg", digits )
	tkrt_snprintf( @buf, 16 + 8 + 1, @fmtstr, val_ )

	dim as integer n = cast( integer, strlen( @buf ) )
	if( n > 0 ) then
		if( buf[n - 1] = asc( "." ) ) then
			buf[n - 1] = 0
			n -= 1
		end if
	end if

	for i as integer = 0 to n - 1
		b[base_ + i] = cptr( uint8 ptr, @buf )[i]
	next
	b[base_ + n] = 0

	if( (mask and FB_F2A_ADDBLANK_W) <> 0 ) then
		if( buf[0] <> asc( "-" ) ) then
			b[0] = asc( " " )
			return buffer
		end if
		return cptr( wstring ptr, @b[1] )
	end if

	return buffer

end function

end extern
