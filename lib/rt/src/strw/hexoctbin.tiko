	if( sizeof( any ptr ) = 8 ) then
		return tkort_WstrOctEx_l( cast( ulongint, cast( uinteger, p ) ), 0 )
	else
		return tkort_WstrOctEx_i( cast( ulong, cast( uinteger, p ) ), 0 )
	end if
end function
function tkort_WstrOctEx_p alias "fb_WstrOctEx_p" _
	( byval p as any ptr, byval digits as long ) as wstring ptr
	if( sizeof( any ptr ) = 8 ) then
		return tkort_WstrOctEx_l( cast( ulongint, cast( uinteger, p ) ), digits )
	else
		return tkort_WstrOctEx_i( cast( ulong, cast( uinteger, p ) ), digits )
	end if
