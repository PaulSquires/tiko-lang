'' ------------------------------------------------------------------- BIN

function tkort_WstrBinEx_l alias "fb_WstrBinEx_l" _
	( byval num as ulongint, byval digits as long ) as wstring ptr
	return hRadixW( num, digits, 1, 1, 0 )
end function
function tkort_WstrBin_l alias "fb_WstrBin_l" ( byval num as ulongint ) as wstring ptr
	return tkort_WstrBinEx_l( num, 0 )
end function
function tkort_WstrBinEx_b alias "fb_WstrBinEx_b" _
	( byval num as ubyte, byval digits as long ) as wstring ptr
	return tkort_WstrBinEx_l( num, digits )
end function
function tkort_WstrBin_b alias "fb_WstrBin_b" ( byval num as ubyte ) as wstring ptr
	return tkort_WstrBinEx_l( num, 0 )
end function
function tkort_WstrBinEx_s alias "fb_WstrBinEx_s" _
	( byval num as ushort, byval digits as long ) as wstring ptr
	return tkort_WstrBinEx_l( num, digits )
end function
function tkort_WstrBin_s alias "fb_WstrBin_s" ( byval num as ushort ) as wstring ptr
	return tkort_WstrBinEx_l( num, 0 )
end function
function tkort_WstrBinEx_i alias "fb_WstrBinEx_i" _
	( byval num as ulong, byval digits as long ) as wstring ptr
	return tkort_WstrBinEx_l( num, digits )
end function
function tkort_WstrBin_i alias "fb_WstrBin_i" ( byval num as ulong ) as wstring ptr
	return tkort_WstrBinEx_l( num, 0 )
end function

'' ------------------------------------------------------- the pointer forms
''
'' WIDTH-DEPENDENT BY DESIGN: an ANY PTR prints its natural width, so the
'' 64-bit host forwards to the 64-bit routine and the 32-bit one does not pad.
'' Branch on sizeof rather than #ifdef, so the half that is dead here still
'' compiles and type-checks.
''
'' AND THE DEAD HALF IS WHY THE CAST GOES THROUGH POINTER WIDTH FIRST:
'' `cast( ulongint, p )` is error 20 on win32, where the pointer is 32 bits.

function tkort_WstrHex_p alias "fb_WstrHex_p" ( byval p as any ptr ) as wstring ptr
	if( sizeof( any ptr ) = 8 ) then
		return tkort_WstrHexEx_l( cast( ulongint, cast( uinteger, p ) ), 0 )
	else
		return tkort_WstrHexEx_i( cast( ulong, cast( uinteger, p ) ), 0 )
	end if
end function
function tkort_WstrHexEx_p alias "fb_WstrHexEx_p" _
	( byval p as any ptr, byval digits as long ) as wstring ptr
	if( sizeof( any ptr ) = 8 ) then
		return tkort_WstrHexEx_l( cast( ulongint, cast( uinteger, p ) ), digits )
	else
		return tkort_WstrHexEx_i( cast( ulong, cast( uinteger, p ) ), digits )
	end if
end function

