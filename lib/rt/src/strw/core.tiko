'' core.tiko -- the WSTRING core: alloc, delete, assign, concat, concat-assign.
''
'' A WSTRING IS A BARE POINTER. There is no descriptor, no length field and no
'' temp pool -- every length here is measured by walking to the NUL, and a
'' "temporary" is just a malloc the caller is expected to hand to fb_WstrDelete.
'' That is the whole structural difference from both STRING and USTRING, and it
'' is why this family has no ownership rules to get wrong and no allocation
'' counts to match: there is one allocation per operation, always.
''
'' FB_WCHAR IS 2 BYTES ON WINDOWS AND 4 ON LINUX. Every size below goes through
'' TKORT_WCHAR_SIZE, never a literal 2, and nothing reinterprets a wstring buffer
'' as UTF-16 -- that is the trap RFC-0003 section 5.5 names, and this workspace
'' has shipped it twice.
''
'' TWO QUIRKS REPRODUCED RATHER THAN CORRECTED, both in fb_WstrConcatAssign:
'' see the notes at the site. The contract is "behaves identically to libfb".

#include once "inc/descriptors.ti"
#include once "inc/wstr.ti"
#include once "inc/sysbind.ti"

extern "rtlib"

'' Room for `chars` characters plus the terminator. A non-positive count yields
'' NULL rather than an empty allocation -- callers test the pointer.
function tkort_WstrAlloc alias "fb_WstrAlloc" ( byval chars as integer ) as wstring ptr
	if( chars <= 0 ) then return nullptr
	return FB_WSTR_ALLOCTEMP( chars )
end function

sub tkort_WstrDelete alias "fb_WstrDelete" ( byval s as wstring ptr )
	if( s = nullptr ) then exit sub
	FB_WSTR_DEL( s )
end sub

'' dst_chars is the DECLARED capacity INCLUDING the terminator, which is how the
'' compiler passes a WSTRING * N length. A value of 0 or less means "no declared
'' capacity" and the destination is assumed large enough -- the same assumption C
'' makes for a bare pointer.
function tkort_WstrAssign alias "fb_WstrAssign" _
	( byval dst as wstring ptr, byval dst_chars as integer, byval src as wstring ptr ) as wstring ptr

	if( dst = nullptr ) then return dst

	dim as integer src_chars = 0
	if( src <> nullptr ) then src_chars = FB_WSTR_LEN( src )

	if( src_chars = 0 ) then
		'' An empty source CLEARS the destination rather than leaving it alone.
		dst[0] = 0
	else
		if( dst_chars > 0 ) then
			dst_chars -= 1                     '' less the terminator
			if( dst_chars < src_chars ) then src_chars = dst_chars
		end if
		FB_WSTR_COPY( dst, src, src_chars )
	end if

	return dst

end function

'' `a + b`. The result is a fresh allocation the caller frees with
'' fb_WstrDelete -- there is no temp pool on this side to release it for them.
''
'' TWO EMPTY OPERANDS YIELD NULL, not an empty wstring. That is what makes
'' `w = "" + ""` produce a null pointer, and it is the same rule fb_WstrLeft and
'' the rest follow: on this family, "empty" and "absent" are the same value.
function tkort_WstrConcat alias "fb_WstrConcat" _
	( byval str1 as wstring ptr, byval str2 as wstring ptr ) as wstring ptr

	dim as integer l1 = 0, l2 = 0
	if( str1 <> nullptr ) then l1 = FB_WSTR_LEN( str1 )
	if( str2 <> nullptr ) then l2 = FB_WSTR_LEN( str2 )

	if( (l1 + l2) = 0 ) then return nullptr

	dim as wstring ptr dst = FB_WSTR_ALLOCTEMP( l1 + l2 )
	if( dst = nullptr ) then return nullptr

	'' The non-terminating form for both halves, then one terminator at the end:
	'' terminating after the first half would put a NUL in the middle.
	FB_WSTR_MOVE( dst, str1, l1 )
	FB_WSTR_MOVE( @dst[l1], str2, l2 )
	dst[l1 + l2] = 0

	return dst

end function

'' dst &= src.
function tkort_WstrConcatAssign alias "fb_WstrConcatAssign" _
	( byval dst as wstring ptr, byval dst_chars as integer, byval src as wstring ptr ) as wstring ptr

	if( dst = nullptr ) then return dst
	if( src = nullptr ) then return dst

	dim as integer src_len = FB_WSTR_LEN( src )
	if( src_len = 0 ) then return dst

	dim as integer dst_len = FB_WSTR_LEN( dst )

	'' QUIRK 1, REPRODUCED: a destination with NO declared capacity
	'' (dst_chars <= 0) appends NOTHING AT ALL. The copy sits inside the
	'' capacity test, so `w &= x` through a bare WSTRING PTR is silently a
	'' no-op. Every other family assumes a bare pointer is large enough and
	'' appends; this one does not.
	if( dst_chars > 0 ) then
		dst_chars -= 1                         '' less the terminator

		'' QUIRK 2, REPRODUCED: the room left is computed as
		'' dst_chars - dst_len and is NOT floored at zero, so an already-full
		'' destination gives a NEGATIVE count. FB_WSTR_COPY treats that as
		'' "copy nothing", which lands the terminator at dst[dst_len] -- i.e.
		'' the append truncates to nothing rather than corrupting the buffer.
		'' Sound by accident rather than by construction, and left as fbc has it.
		if( src_len > (dst_chars - dst_len) ) then src_len = dst_chars - dst_len

		FB_WSTR_COPY( @dst[dst_len], src, src_len )
	end if

	return dst

end function

end extern
