'' conv.tiko -- STRING <-> WSTRING, eight entry points over three fbc members.
''
'' THIS FAMILY GOES THROUGH THE C LOCALE -- mbstowcs on the way in, wcstombs on
'' the way out -- so the same STRING produces different WSTRINGs on different
'' machines and codepages. src/ustr/conv.tiko deliberately does not: a USTRING is
'' UTF-8 on every target. The two must not be made to agree, because each is
'' right for what its type is for, and this is the fourth place in the port where
'' the two wide families make deliberately opposite choices.
''
'' THE 4x GUESS. There is no way to ask wcstombs how long the result will be
'' without converting, so fbc allocates 4 BYTES PER CHARACTER and takes the
'' over-allocation. Reproduced exactly: the size it leaves in the descriptor is
'' observable through fbc-int/string.bi, so a tighter guess would be a visible
'' divergence rather than an improvement (RFC-0004 section 4).

#include once "inc/descriptors.ti"
#include once "inc/wstr.ti"
#include once "inc/ctx.ti"
#include once "inc/sysbind.ti"

extern "c"   '' NON-FBCALL: fb_unicode.h declares both converters plainly.
	declare function tkrt_ConvFromA alias "fb_wstr_ConvFromA" _
		( byval dst as wstring ptr, byval dst_chars as integer, byval src as zstring ptr ) as integer
end extern

extern "rtlib"
	declare function tkrt_DelTemp alias "fb_hStrDelTemp" ( byval s as FBSTRING ptr ) as int32
	declare function tkrt_AllocTemp alias "fb_hStrAllocTemp" _
		( byval s as FBSTRING ptr, byval length as integer ) as FBSTRING ptr
	declare function tkrt_StrAlloc alias "fb_hStrAlloc" _
		( byval s as FBSTRING ptr, byval length as integer ) as FBSTRING ptr
	declare function tkrt_StrRealloc alias "fb_hStrRealloc" _
		( byval s as FBSTRING ptr, byval length as integer, byval k as int32 ) as FBSTRING ptr
	declare sub tkrt_StrDelete alias "fb_StrDelete" ( byval s as FBSTRING ptr )
end extern

'' 4 bytes per character: UTF-8 needs up to four on Linux, and Windows has
'' double-byte encodings of its own. A worst case, not an estimate.
#define ALEN_FOR_WLEN( wlen ) ((wlen) * 4)

'' The ASCII fallback for when wcstombs fails outright -- everything above 127
'' becomes '?'.
''
'' AND IT IS SURROGATE-AWARE ON A 16-BIT TARGET ONLY. Where FB_WCHAR is 2 bytes
'' an astral character occupies TWO of them, so the high half is detected and its
'' low half SKIPPED -- one '?' per character rather than two. Where FB_WCHAR is
'' 4 bytes there are no surrogates to skip. Branching on sizeof rather than
'' #ifdef keeps the dead half compiling.
private function hNoMultibyte _
	( byval dst as zstring ptr, byval dst_chars as integer, byval src as wstring ptr ) as integer

	dim as integer w = 0, i = 0

	while( w < dst_chars )
		dim as uint32 c = src[i]
		i += 1
		if( c = 0 ) then exit while
		if( c > 127 ) then
			if( sizeof( wstring ) = 2 ) then
				if( (c >= &hD800) andalso (c <= &hDBFF) ) then i += 1
			end if
			c = asc( "?" )
		end if
		dst[w] = c
		w += 1
	wend

	dst[w] = 0
	return w

end function

extern "c"   '' NON-FBCALL: fb_unicode.h declares fb_wstr_ConvToA without it.

'' dst_chars is the room EXCLUDING the terminator, so the buffer must hold
'' dst_chars + 1. Returns the count written, excluding the terminator, which is
'' always written.
function tkort_wstr_ConvToA alias "fb_wstr_ConvToA" _
	( byval dst as zstring ptr, byval dst_chars as integer, byval src as wstring ptr ) as integer

	if( src = 0 ) then
		dst[0] = 0
		return 0
	end if

	dim as integer chars = cast( integer, wcstombs( dst, src, dst_chars + 1 ) )

	if( chars >= 0 ) then
		'' wcstombs does NOT terminate when the text exactly fills the buffer,
		'' so it is done by hand -- which cuts off the last character. fbc's
		'' behaviour, including the dst_chars - 1 it then reports, reproduced
		'' rather than corrected: a caller reading the count would otherwise see
		'' tiko-rt and fbc disagree by one on a truncating conversion.
		if( chars = (dst_chars + 1) ) then
			dst[dst_chars] = 0
			return dst_chars - 1
		end if
		return chars
	end if

	return hNoMultibyte( dst, dst_chars, src )

end function

end extern

extern "rtlib"

'' WSTRING -> STRING, as a temporary.
''
'' THE MEASURE PASS IS wcstombs( NULL, ... ), AND IT FAILS on any character the C
'' locale cannot spell -- one CJK character under cp1252 is enough, so a VALID program
'' reaches it. fbc does not check: (size_t)-1 is not 0, fb_hStrAllocTemp is called
'' with -1, and the result has length 2^63-1 over a corrupted heap. That was
'' reproduced here as parity; crash parity is not compatibility (audit F-61). A failed
'' measure now takes the ASCII fallback's length, one byte per character at most, and
'' fb_wstr_ConvToA's own fallback writes '?' for what cannot be spelt.
function tkort_WstrToStr alias "fb_WstrToStr" ( byval src as wstring ptr ) as FBSTRING ptr

	if( src = 0 ) then return TKORT_NULLSTR()

	dim as integer chars = cast( integer, wcstombs( 0, src, 0 ) )
	if( chars < 0 ) then chars = FB_WSTR_LEN( src )
	if( chars = 0 ) then return TKORT_NULLSTR()

	dim as FBSTRING ptr dst = tkrt_AllocTemp( 0, chars )
	if( dst = 0 ) then return TKORT_NULLSTR()

	tkort_wstr_ConvToA( dst->data, chars, src )
	return dst

end function

'' STRING -> WSTRING, into a caller-provided buffer.
function tkort_WstrAssignFromA alias "fb_WstrAssignFromA" _
	( byval dst as wstring ptr, byval dst_chars as integer, _
	  byval src as any ptr, byval src_size as integer ) as wstring ptr

	if( dst <> 0 ) then
		dim as zstring ptr src_ptr = any
		dim as integer src_chars = any
		FB_STRSETUP_FIX( src, src_size, src_ptr, src_chars )

		'' A capacity of 0 means "no declared size" and the source length is
		'' used -- as in C, a bare pointer is assumed large enough.
		if( dst_chars = 0 ) then
			dst_chars = src_chars
		else
			dst_chars -= 1                 '' less the terminator
		end if

		tkrt_ConvFromA( dst, dst_chars, src_ptr )
	end if

	'' The source is consumed even when the destination is NULL.
	if( src_size = FB_STRSIZEVARLEN ) then tkrt_DelTemp( cptr( FBSTRING ptr, src ) )

	return dst

end function

'' WSTRING -> STRING, assignment, over all four destination forms.
function tkort_WstrAssignToAEx alias "fb_WstrAssignToAEx" _
	( byval dst as any ptr, byval dst_chars as integer, byval src as wstring ptr, _
	  byval fill_rem as int32, byval is_init as int32 ) as any ptr

	if( dst = 0 ) then return dst

	dim as integer src_chars = 0
	if( src <> 0 ) then src_chars = FB_WSTR_LEN( src )

	if( dst_chars = FB_STRSIZEVARLEN ) then

		dim as FBSTRING ptr dstr = cptr( FBSTRING ptr, dst )

		if( src_chars = 0 ) then
			'' is_init decides whether there is anything valid to free: an
			'' initialising assignment reaches an UNINITIALISED descriptor.
			if( is_init = 0 ) then
				tkrt_StrDelete( dstr )
			else
				dstr->data = 0
				dstr->len  = 0
				dstr->size = 0
			end if
		else
			dst_chars = ALEN_FOR_WLEN( src_chars )
			if( is_init = 0 ) then
				if( FB_STRSIZE( dst ) <> dst_chars ) then
					tkrt_StrRealloc( dstr, dst_chars, 0 )
				end if
			else
				tkrt_StrAlloc( dstr, dst_chars )
			end if

			'' THE LENGTH IS SET FROM WHAT WAS ACTUALLY WRITTEN, not from the 4x
			'' guess -- the buffer stays over-allocated and only `len` shrinks to
			'' the truth. That is why `size` and `len` disagree after this call.
			dim as integer written = tkort_wstr_ConvToA( dstr->data, dst_chars, src )
			FB_STRSETLEN( dstr, written )
		end if

	elseif( (dst_chars and FB_STRISFIXED) <> 0 ) then

		'' STRING * N -- SPACE-padded, which is the narrow convention and the
		'' opposite of what USTRING * N does with its remainder.
		dim as integer written = 0
		dst_chars and= FB_STRSIZEMSK

		if( src_chars > 0 ) then
			if( dst_chars < src_chars ) then src_chars = dst_chars
			written = tkort_wstr_ConvToA( cptr( zstring ptr, dst ), dst_chars, src )
		end if

		if( (dst_chars - written) > 0 ) then
			memset( cptr( uint8 ptr, dst ) + written, 32, dst_chars - written )
		end if

	else

		'' Fixed-length ZSTRING * N, or a bare ZSTRING PTR.
		if( src_chars = 0 ) then
			if( (fill_rem <> 0) andalso (dst_chars > 0) ) then
				memset( dst, 0, dst_chars )
			else
				cptr( zstring ptr, dst )[0] = 0
			end if
		elseif( dst_chars = 0 ) then
			'' A bare pointer: as in C, assume it is large enough.
			dst_chars = ALEN_FOR_WLEN( src_chars )
			tkort_wstr_ConvToA( cptr( zstring ptr, dst ), dst_chars, src )
		else
			dst_chars -= 1                 '' the terminator
			dim as integer written = tkort_wstr_ConvToA( cptr( zstring ptr, dst ), dst_chars, src )

			'' The fill starts ONE PAST the terminator, so the terminator
			'' survives and only the tail behind it is zeroed. There is room for
			'' dst_chars + 1, which is what makes that legal.
			if( (fill_rem <> 0) andalso (written < dst_chars) ) then
				memset( cptr( uint8 ptr, dst ) + written + 1, 0, dst_chars - written )
			end if
		end if

	end if

	return dst

end function

function tkort_WstrAssignToA alias "fb_WstrAssignToA" _
	( byval dst as any ptr, byval dst_chars as integer, byval src as wstring ptr, _
	  byval fill_rem as int32 ) as any ptr
	return tkort_WstrAssignToAEx( dst, dst_chars, src, fill_rem, 0 )
end function

function tkort_WstrAssignToA_Init alias "fb_WstrAssignToA_Init" _
	( byval dst as any ptr, byval dst_chars as integer, byval src as wstring ptr, _
	  byval fill_rem as int32 ) as any ptr
	return tkort_WstrAssignToAEx( dst, dst_chars, src, fill_rem, 1 )
end function

'' ------------------------------------------------- mixed concatenation
''
'' "wstring + string" and "string + wstring". THE NARROW OPERAND IS CONVERTED and
'' the result is a WSTRING, so text does not degrade to bytes in a mixed
'' expression -- the same direction fb_UStrConcatAU takes for ustrings.
''
'' THE TWO ARE NOT MIRROR IMAGES, and the asymmetry is real rather than untidy:
''
''   WA  the wide half is copied FIRST, at a known length, and the narrow half
''       is converted straight into the tail. fb_wstr_ConvFromA terminates.
''
''   AW  the narrow half is converted FIRST, and its RETURN VALUE -- the count
''       actually written, which the locale may make smaller than the byte count
''       -- decides where the wide half goes. Then the wide half is moved with
''       str2_len + 1 characters, carrying its terminator along rather than
''       writing one.
''
'' So WA trusts the length it computed and AW trusts the length it was told.

function tkort_WstrConcatWA alias "fb_WstrConcatWA" _
	( byval str1 as wstring ptr, byval str2 as any ptr, byval str2_size as integer ) as wstring ptr

	dim as integer str1_len = 0
	if( str1 <> 0 ) then str1_len = FB_WSTR_LEN( str1 )

	dim as zstring ptr str2_ptr = any
	dim as integer str2_len = any
	FB_STRSETUP_FIX( str2, str2_size, str2_ptr, str2_len )

	dim as wstring ptr dst = 0

	if( (str1_len + str2_len) <> 0 ) then
		dst = FB_WSTR_ALLOCTEMP( str1_len + str2_len )
		if( dst <> 0 ) then
			FB_WSTR_MOVE( dst, str1, str1_len )
			tkrt_ConvFromA( @dst[str1_len], str2_len, str2_ptr )
		end if
	end if

	if( str2_size = FB_STRSIZEVARLEN ) then tkrt_DelTemp( cptr( FBSTRING ptr, str2 ) )

	return dst

end function

function tkort_WstrConcatAW alias "fb_WstrConcatAW" _
	( byval str1 as any ptr, byval str1_size as integer, byval str2 as wstring ptr ) as wstring ptr

	dim as zstring ptr str1_ptr = any
	dim as integer str1_len = any
	FB_STRSETUP_FIX( str1, str1_size, str1_ptr, str1_len )

	dim as integer str2_len = 0
	if( str2 <> 0 ) then str2_len = FB_WSTR_LEN( str2 )

	dim as wstring ptr dst = 0

	if( (str1_len + str2_len) <> 0 ) then
		dst = FB_WSTR_ALLOCTEMP( str1_len + str2_len )
		if( dst <> 0 ) then
			'' The RETURN VALUE, not str1_len: the conversion decides where the
			'' wide half starts.
			str1_len = tkrt_ConvFromA( dst, str1_len, str1_ptr )
			if( str2_len > 0 ) then
				'' + 1 carries the terminator across rather than writing one.
				FB_WSTR_MOVE( @dst[str1_len], str2, str2_len + 1 )
			end if
		end if
	end if

	if( str1_size = FB_STRSIZEVARLEN ) then tkrt_DelTemp( cptr( FBSTRING ptr, str1 ) )

	return dst

end function

end extern
