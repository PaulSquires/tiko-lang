'' vallng.tiko -- fb_hStr2Longint / fb_VALLNG (str_convfrom_lng.o) and
''               fb_hStr2ULongint / fb_VALULNG (str_convfrom_ulng.o).
''
'' THESE TWO ARE PLATFORM-CONDITIONAL, and it is the only place in the string
'' core that is. fbc's source:
''
''     if( radix != 10 ) {
''         p += skip;
''     #ifdef HOST_MINGW
''         return fb_hStrRadix2Longint( p, len - skip, radix );
''     #endif
''     }
''     return (long long)strtoull( p, NULL, radix );
''
'' So on WINDOWS a prefixed value goes through the hand-rolled radix parser and
'' returns there; on LINUX the same input falls through to strtoull with the
'' chosen radix. The two disagree on overflow: fb_hStrRadix2Longint WRAPS
'' silently, strtoull SATURATES at ULLONG_MAX and sets ERANGE. `&hFFFFFFFFFFFFFFFF`
'' is therefore a different number on the two platforms, from the same source.
''
'' Reproduced with __FB_WIN32__ rather than normalised. win32 and win64 are both
'' MinGW here; linux-x86_64 is not. Writing the Windows form unconditionally
'' would have passed both Windows gates and failed Linux -- the same shape as the
'' chr(0) bug, which also passed 10.2 million assertions on two targets before
'' Linux caught it in five.
''
'' The 32-bit siblings (valint.tiko) have NO such conditional: fb_hStr2Int always
'' returns through fb_hStrRadix2Int, on every platform.

#include once "inc/descriptors.ti"

extern "rtlib"
	declare function tkrt_SkipChar alias "fb_hStrSkipChar" _
		( byval s as zstring ptr, byval length as integer, byval c as int32 ) as zstring ptr
	declare function tkrt_Radix2Longint alias "fb_hStrRadix2Longint" _
		( byval s as zstring ptr, byval length as integer, byval radix as int32 ) as int64
	declare function tkrt_DelTemp alias "fb_hStrDelTemp" _
		( byval s as FBSTRING ptr ) as int32
end extern

extern "rtlib"

'' Shared prologue: skip spaces, recognise a prefix, and report both the
'' remaining text and the radix. Returns 0 when there is nothing left to parse.
#macro TKORT_VAL_PROLOGUE( src, length, up, p, radix, skip, bail )
	dim as zstring ptr p = tkrt_SkipChar( src, length, 32 )
	length -= cast( integer, cptr( uint8 ptr, p ) - cptr( uint8 ptr, src ) )
	if( length < 1 ) then return bail
	dim as uint8 ptr up = cptr( uint8 ptr, p )
	dim as int32 radix = 10
	dim as integer skip = 2
#endmacro

function tkort_hStr2Longint alias "fb_hStr2Longint" _
	( byval src as zstring ptr, byval length as integer ) as int64

	TKORT_VAL_PROLOGUE( src, length, up, p, radix, skip, 0 )

	if( (length >= 2) andalso (up[0] = asc("&")) ) then
		select case as const up[1]
		case asc("h"), asc("H")
			radix = 16
		case asc("o"), asc("O")
			radix = 8
		case asc("b"), asc("B")
			radix = 2
		case else
			radix = 8
			skip = 1
		end select

		if( radix <> 10 ) then
			p = cptr( zstring ptr, up + skip )
			#ifdef __FB_WIN32__
				'' Windows only -- see the note above.
				return tkrt_Radix2Longint( p, length - skip, radix )
			#endif
		end if
	end if

	'' strtoull, not strtoll: out of range WRAPS instead of saturating.
	return cast( int64, strtoull( p, nullptr, radix ) )

end function

function tkort_VALLNG alias "fb_VALLNG" ( byval s as FBSTRING ptr ) as int64

	if( s = nullptr ) then return 0

	dim as int64 v = 0
	if( s->data <> nullptr ) then
		if( FB_STRSIZE( s ) <> 0 ) then
			v = tkort_hStr2Longint( s->data, FB_STRSIZE( s ) )
		end if
	end if

	tkrt_DelTemp( s )

	return v

end function

function tkort_hStr2ULongint alias "fb_hStr2ULongint" _
	( byval src as zstring ptr, byval length as integer ) as uint64

	TKORT_VAL_PROLOGUE( src, length, up, p, radix, skip, 0 )

	if( (length >= 2) andalso (up[0] = asc("&")) ) then
		select case as const up[1]
		case asc("h"), asc("H")
			radix = 16
		case asc("o"), asc("O")
			radix = 8
		case asc("b"), asc("B")
			radix = 2
		case else
			radix = 8
			skip = 1
		end select

		if( radix <> 10 ) then
			p = cptr( zstring ptr, up + skip )
			#ifdef __FB_WIN32__
				return cast( uint64, tkrt_Radix2Longint( p, length - skip, radix ) )
			#endif
		end if
	end if

	return strtoull( p, nullptr, radix )

end function

function tkort_VALULNG alias "fb_VALULNG" ( byval s as FBSTRING ptr ) as uint64

	if( s = nullptr ) then return 0

	dim as uint64 v = 0
	if( s->data <> nullptr ) then
		if( FB_STRSIZE( s ) <> 0 ) then
			v = tkort_hStr2ULongint( s->data, FB_STRSIZE( s ) )
		end if
	end if

	tkrt_DelTemp( s )

	return v

end function

end extern
