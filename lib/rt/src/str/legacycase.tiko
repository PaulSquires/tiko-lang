'' legacycase.tiko -- fb_UCASE (legacy_str_ucase.o) and fb_LCASE
'' (legacy_str_lcase.o).
''
'' One line each. Both forward to fb_StrUcase2 / fb_StrLcase2 with mode 0, and
'' those stay fbc's: wide.tiko records why -- the `mode` argument cannot be
'' separated by probing, because modes 0, 1 and 2 behave identically on ASCII,
'' and guessing it would be a contract bug. Now that the sources are readable
'' that could be settled, but the two-line members are worth taking on their own
'' and the Ucase2 pair is a separate batch.
''
'' Two more members for two forwarders, same as fb_HEX/OCT/BIN.

#include once "inc/descriptors.ti"

'' Declared under LOCAL names: fbc reserves fb_StrUcase2 and fb_StrLcase2 in its
'' rtlLookupTB table with their own signatures, so redeclaring them verbatim is a
'' type mismatch at the call site -- the same reservation that forces every
'' definition in this project to be `tkort_X alias "fb_X"`.
extern "rtlib"
	declare function tkrt_Ucase2 alias "fb_StrUcase2" _
		( byval s as FBSTRING ptr, byval mode as int32 ) as FBSTRING ptr
	declare function tkrt_Lcase2 alias "fb_StrLcase2" _
		( byval s as FBSTRING ptr, byval mode as int32 ) as FBSTRING ptr
end extern

extern "rtlib"

function tkort_UCASE alias "fb_UCASE" ( byval s as FBSTRING ptr ) as FBSTRING ptr
	return tkrt_Ucase2( s, 0 )
end function

function tkort_LCASE alias "fb_LCASE" ( byval s as FBSTRING ptr ) as FBSTRING ptr
	return tkrt_Lcase2( s, 0 )
end function

end extern
