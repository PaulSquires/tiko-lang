'' trim.tiko -- fb_TRIM, fb_LTRIM and fb_RTRIM.
''
'' The ASCII counterpart of wide.tiko's three trims, and NOT a transliteration of
'' them: the two families agree on which characters they remove and disagree on
'' what they return for an empty result.
''
'' MEASURED, NOT ASSUMED (PROVENANCE.md -- no .c body was opened):
''
''   PROBE-30, AND ITS CORRECTION: the left end trims 0x20; the right end trims
''     0x20 AND 0x00. Given chr(32,9,10,11,12,13) + "X" + the
''     reverse, fb_TRIM answered `09 0A 0B 0C 0D 58 0D 0C 0B 0A 09` -- tab, LF,
''     vertical tab, form feed and CR all survive. Classic BASIC TRIM, not
''     isspace(). This matches PROBE-19's finding for the wide trims.
''
''   PROBE-31: AN EMPTY RESULT IS THE SHARED EMPTY DESCRIPTOR, NOT NULL.
''     TRIM("     "), TRIM("") and TRIM(NULL) all return &__fb_ctx.null_desc.
''     THE WIDE TRIMS RETURN NULL FOR THE SAME CASE. Two families, two answers,
''     and only measurement separates them -- copying wide.tiko's `return 0` here
''     would have handed fbc-generated code a null descriptor to dereference.
''
''   PROBE-31: A NO-OP TRIM STILL COPIES. TRIM("abcdef") returns a fresh
''     temporary, never the source descriptor back.
''
''   PROBE-32/33: ALL THREE CONSUME A TEMPORARY OPERAND. Screened first from
''     fbc's own object -- str_trim.o, str_ltrim.o and str_rtrim.o each list
''     fb_hStrDelTemp_NoLock among their undefined symbols -- then confirmed by
''     running it: TRIM of a temporary leaves the source len 0, data NULL.

#include once "inc/descriptors.ti"
#include once "inc/ctx.ti"

extern "rtlib"
	declare function fb_hStrAllocTemp alias "fb_hStrAllocTemp" _
		( byval s as FBSTRING ptr, byval length as integer ) as FBSTRING ptr
	declare function tkrt_DelTemp alias "fb_hStrDelTemp" _
		( byval s as FBSTRING ptr ) as long
	declare sub fb_hStrCopy alias "fb_hStrCopy" _
		( byval dst as zstring ptr, byval src as zstring ptr, byval bytes as integer )
end extern

extern "rtlib"

'' LOCK GRANULARITY DIVERGES FROM fbc, DELIBERATELY. fbc's members call the
'' _NoLock helpers inside one critical section spanning the whole operation;
'' these call the locking ones, so alloc and release are two separate sections.
'' Nothing observable spans them -- the temporary being allocated and the operand
'' being released are unrelated slots, and each helper leaves the pool
'' consistent. Recorded because it is a difference, not because it is a defect.
private function hTrim _
	( _
		byval s as FBSTRING ptr, byval doLeft as integer, byval doRight as integer _
	) as FBSTRING ptr

	if( s = 0 ) then return TKORT_NULLSTR( )

	dim as zstring ptr p = s->data
	dim as integer n = FB_STRSIZE( s )

	if( (p = 0) orelse (n <= 0) ) then
		tkrt_DelTemp( s )
		return TKORT_NULLSTR( )
	end if

	dim as integer lo = 0
	dim as integer hi = n

	'' THE TWO ENDS DO NOT TRIM THE SAME SET.
	''
	''     left   0x20 only
	''     right  0x20 AND 0x00
	''
	'' fbc's own string/trim.bas states it in a comment beside the cases that
	'' prove it: "default is to trim chr(32) from left and right and chr(0) only
	'' from right". Measured to agree:
	''
	''     TRIM( 00 61 62 63 00 )       -> 00 61 62 63
	''     TRIM( 20 00 616263 00 20 )   -> 00 61 62 63
	''     LTRIM( 00 61 62 63 00 )      -> unchanged
	''
	'' PROBE-30 missed this because it asked about the WHITESPACE FAMILY -- tab,
	'' LF, vertical tab, form feed, CR -- which is a category that comes from C,
	'' not from this runtime. NUL was never a candidate, and a NUL inside a
	'' printed string is invisible, so nothing in the output would have hinted.
	if( doLeft ) then
		while( (lo < hi) andalso (cptr( ubyte ptr, p )[lo] = 32) )
			lo += 1
		wend
	end if

	if( doRight ) then
		dim as ubyte c = any
		do while( hi > lo )
			c = cptr( ubyte ptr, p )[hi - 1]
			'' Two comparisons on separate lines, not one ORELSE chain: mixing a
			'' boolean and a non-boolean operand in ANDALSO/ORELSE is fbc warning
			'' 38, and the chain here would carry three.
			if( c <> 32 ) then
				if( c <> 0 ) then exit do
			end if
			hi -= 1
		loop
	end if

	dim as integer outn = hi - lo

	if( outn <= 0 ) then
		tkrt_DelTemp( s )
		return TKORT_NULLSTR( )
	end if

	dim as FBSTRING ptr r = fb_hStrAllocTemp( 0, outn )
	if( r = 0 ) then
		'' The pool is dry. Release the operand anyway: refusing to would turn
		'' one exhausted pool into a permanently exhausted one.
		tkrt_DelTemp( s )
		return TKORT_NULLSTR( )
	end if

	fb_hStrCopy( r->data, @p[lo], outn )

	'' After the copy, never before -- `p` points into the source's data.
	'' CALL DelTemp UNCONDITIONALLY: it already decides all three ownership
	'' cases, and a caller that re-implements the guard will eventually disagree
	'' with it (see basic.tiko).
	tkrt_DelTemp( s )

	return r

end function

function tkort_TRIM alias "fb_TRIM" ( byval s as FBSTRING ptr ) as FBSTRING ptr
	return hTrim( s, -1, -1 )
end function

function tkort_LTRIM alias "fb_LTRIM" ( byval s as FBSTRING ptr ) as FBSTRING ptr
	return hTrim( s, -1, 0 )
end function

function tkort_RTRIM alias "fb_RTRIM" ( byval s as FBSTRING ptr ) as FBSTRING ptr
	return hTrim( s, 0, -1 )
end function

end extern
