'' base.tiko -- fb_HEX, fb_OCT, fb_BIN (str_base.o).
''
'' Three one-line forwarders. fbc's str_base.c does nothing but call fb_HEX_i,
'' fb_OCT_i and fb_BIN_i, which live in other members (str_hex.c and friends) and
'' stay fbc's for now -- confirmed by str_base.o's undefined symbols, which are
'' exactly those three names and nothing else.
''
'' Worth owning anyway: it is a whole archive member for three symbols, it costs
'' nothing, and it removes three names from the remaining list.

#include once "inc/descriptors.ti"

extern "rtlib"
	declare function fb_HEX_i alias "fb_HEX_i" ( byval num as int32 ) as FBSTRING ptr
	declare function fb_OCT_i alias "fb_OCT_i" ( byval num as int32 ) as FBSTRING ptr
	declare function fb_BIN_i alias "fb_BIN_i" ( byval num as int32 ) as FBSTRING ptr
end extern

extern "rtlib"

function tkort_HEX alias "fb_HEX" ( byval num as int32 ) as FBSTRING ptr
	return fb_HEX_i( num )
end function

function tkort_OCT alias "fb_OCT" ( byval num as int32 ) as FBSTRING ptr
	return fb_OCT_i( num )
end function

function tkort_BIN alias "fb_BIN" ( byval num as int32 ) as FBSTRING ptr
	return fb_BIN_i( num )
end function

end extern
