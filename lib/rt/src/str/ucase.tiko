'' ucase.tiko -- fb_StrUcase2 (str_ucase.o).
''
'' THE `mode` ARGUMENT, WHICH COULD NOT BE PROBED. wide.tiko records that modes
'' 0, 1 and 2 behave identically on ASCII, so no probe could separate them and
'' guessing would have been a contract bug. It is not a guess any more:
''
''     mode = 1        ASCII ONLY. Hardcoded 97..122 -> subtract 32. Nothing
''                     outside a..z is touched, whatever the locale says.
''     anything else   LOCALE-AWARE. islower() / toupper() from the CRT, so the
''                     answer depends on the process locale.
''
'' fb_UCASE (legacycase.tiko) passes 0, so the plain UCASE is the locale path.
''
'' TWO NULL CASES, AND THEY DIFFER:
''
''     src = NULL        return the shared empty. NO lock is taken and NOTHING
''                       is consumed -- there is no descriptor to consume.
''     src->data = NULL  return the shared empty, but the source IS consumed.
''
'' The allocation uses fb_hStrAllocTemp_NoLock because the lock is already held.

#include once "inc/descriptors.ti"
#include once "inc/ctx.ti"

extern "rtlib"
	declare function fb_hStrAllocTemp_NoLock alias "fb_hStrAllocTemp_NoLock" _
		( byval s as FBSTRING ptr, byval length as integer ) as FBSTRING ptr
	declare function tkrt_DelTempNoLock alias "fb_hStrDelTemp_NoLock" _
		( byval s as FBSTRING ptr ) as int32
	declare sub fb_StrLock alias "fb_StrLock" ( )
	declare sub fb_StrUnlock alias "fb_StrUnlock" ( )
end extern

#ifdef ENABLE_MT
	#define STRLOCK()   fb_StrLock()
	#define STRUNLOCK() fb_StrUnlock()
#else
	#define STRLOCK()
	#define STRUNLOCK()
#endif

extern "rtlib"

function tkort_StrUcase2 alias "fb_StrUcase2" _
	( byval src as FBSTRING ptr, byval mode as int32 ) as FBSTRING ptr

	if( src = nullptr ) then return TKORT_NULLSTR( )

	STRLOCK()

	dim as FBSTRING ptr dst = nullptr
	dim as integer length = 0

	if( src->data <> nullptr ) then
		length = FB_STRSIZE( src )
		dst = fb_hStrAllocTemp_NoLock( nullptr, length )
	end if

	if( dst <> nullptr ) then
		'' SIGNED. fbc walks the source with `char *s` and does `c = *s++`, and
		'' char is SIGNED on x86 -- so a byte of 200 reaches islower/toupper as
		'' -56, not 200. Reading through a `ubyte ptr` here gave different
		'' answers for every byte above 127 and the differential caught it on
		'' the high-byte case. The mode-1 range tests are unaffected either way,
		'' because a negative value fails both bounds just as 200 does.
		dim as int8 ptr s = cptr( int8 ptr, src->data )
		dim as uint8 ptr d = cptr( uint8 ptr, dst->data )
		dim as int32 c = any

		if( mode = 1 ) then
			for i as integer = 0 to length - 1
				c = s[i]
				if( (c >= 97) andalso (c <= 122) ) then c -= (97 - 65)
				d[i] = cast( uint8, c )
			next
		else
			for i as integer = 0 to length - 1
				c = s[i]
			'' THE CLASSIFIER TAKES AN UNSIGNED CHAR VALUE OR EOF, AND 0xFF IS BOTH.
			''
			'' C says an is*/to* argument must be EOF or representable as UNSIGNED
			'' CHAR. fbc walks the source with a SIGNED char, so byte 224 reaches
			'' islower as -32 and byte 255 reaches it as -1 -- and -1 is EOF, for
			'' which islower is DEFINED to answer false. Those are two different
			'' situations that look like one:
			''
			''     islower( -32 )   MinGW 2 (true)   MSVC 0 (FALSE)   undefined, differs
			''     islower( -1  )   MinGW 0          MSVC 0           EOF, agrees
			''     islower( 224 )   MinGW 2          MSVC 2
			''     toupper( 255 )   MinGW 9F         MSVC 9F          the tables AGREE
			''
			'' So fbc's behaviour is: classify as UNSIGNED, except that 0xFF is left
			'' alone because it arrives as EOF. Passing the unsigned value for every
			'' byte fixed the accented characters on MSVC and CHANGED 0xFF on BOTH
			'' targets -- 'y' with a diaeresis became 9F where fbc leaves FF. The
			'' win64 gate did not see that; build/diff.sh's swap-case-mid did.
			''
			'' THE SOURCE IS STILL READ SIGNED, which is what makes the EOF case
			'' reachable at all and is measured in the note above.
				if( c <> -1 ) then
					dim as int32 uc = c and &hFF
					if( islower( uc ) ) then c = toupper( uc )
				end if
				d[i] = cast( uint8, c )
			next
		end if

		d[length] = 0
	else
		dst = TKORT_NULLSTR( )
	end if

	tkrt_DelTempNoLock( src )

	STRUNLOCK()

	return dst

end function

end extern
