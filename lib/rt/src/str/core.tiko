'' core.tiko -- the string allocator and the temporary-descriptor pool.
''
'' This is str_core.o's exact symbol set, all ten of them. It matters more than
'' its size suggests: every other string entry point in libfb allocates through
'' fb_hStrAlloc / fb_hStrRealloc, and every string temporary in a compiled
'' program passes through the pool. Merging this module puts tiko-rt on the hot
'' path of the entire string library while that library is still fbc's C.
''
'' Its own fb_ dependencies, from nm over fbc's archive:
''     fb_StrDelete          -- still fbc's
''     fb_hListInit / AllocElem / FreeElem  -- already ours (src/support/list.tiko)
''
'' ===========================================================================
'' WHAT WAS MEASURED, AND HOW (PROVENANCE.md -- str_core.c was not opened)
''
'' PROBE-13, the growth law. Swept len 0..1200 through the C runtime and read
'' `size` back out of the descriptor fbc-int/string.bi publishes. 38 steps, all
'' fitting exactly:
''
''     size = 0                      when len = 0
''     size = ((len + 31) \ 32) * 36 otherwise
''
'' 32-character granules at 36 bytes each. Reproduced here EXACTLY and
'' deliberately, including the three bytes of slack per granule: allocation
'' policy is most of what a concatenation benchmark measures, so a "better"
'' policy here would make Gate 4 compare two allocators instead of two
'' languages (RFC-0004 section 4).
''
'' PROBE-12 also showed the pointer does NOT move while the granule count is
'' unchanged (len 1..12 all stay in one 36-byte block) and DOES move when it
'' changes, including on shrink. So realloc is driven by the granule count, not
'' by the length.
''
'' PROBE-14:
''   fb_hStrCopy ( dst, "abcd", 4 ) -> 61 62 63 64 00   -- terminates
''   fb_hStrCopyN( dst, "abcd", 4 ) -> 61 62 63 64 EE   -- does not
''   Neither stops at a NUL in the source; both are raw byte copies.
''   fb_hStrAllocTempDesc() returns data=NULL len=0 size=0, temp bit CLEAR.
''   fb_hStrAllocTemp(d,10) sets the temp bit and size=36.
''   fb_hStrDelTempDesc and fb_hStrDelTemp both return 0.
''
'' PROBE-15: fb_hStrAllocTemp( NULL, 20 ) returns a fully-formed temporary --
'' descriptor from the pool, data allocated, temp bit set. So AllocTemp touches
'' the pool, which is why the _NoLock twins exist: a caller already holding the
'' string lock would otherwise deadlock on it.
''
'' NOT established, and therefore left as the safest reading:
''   - what fbc does when the 256-entry pool is exhausted -- MEASURED since: an
''     empty string. Ours grows the pool instead (the spill blocks below, review
''     RT-01), a deliberate divergence; tests/driver/dll-string-results covers it.
''   - whether fbc range-checks a descriptor against the pool table on delete.
''     Ours does, because a temporary that did NOT come from the pool must not
''     be pushed onto its free list.
'' ===========================================================================

#include once "inc/descriptors.ti"
#include once "inc/list.ti"
#include once "inc/sysbind.ti"

'' fb_StrLock / fb_StrUnlock are FBCALL and remain fbc's. Under a
'' single-threaded build fb.h defines FB_STRLOCK() to nothing, and so do we:
'' the calls must vanish entirely, not become calls to an empty function.
#ifdef ENABLE_MT
	extern "rtlib"
		declare sub fb_StrLock alias "fb_StrLock" ( )
		declare sub fb_StrUnlock alias "fb_StrUnlock" ( )
	end extern
	#define STRLOCK()   fb_StrLock()
	#define STRUNLOCK() fb_StrUnlock()
#else
	#define STRLOCK()
	#define STRUNLOCK()
#endif

'' The pool. Fixed at 256 entries (FB_STR_TMPDESCRIPTORS) -- not a growing
'' allocator, and its exhaustion behaviour is part of the contract.
dim shared as FB_STR_TMPDESC tkort_tmpTable( 0 to FB_STR_TMPDESCRIPTORS - 1 )
dim shared as FB_LIST        tkort_tmpList
dim shared as integer        tkort_tmpReady
dim shared as integer        tkort_tmpWarned     '' exhaustion reported once -- see hPoolAlloc

'' SPILL BLOCKS (review RT-01, 2026-10-24). The table above is fbc's 256 descriptors, and
'' fbc answers an EMPTY string once they are spent. Two things spend them: a temporary
'' the compiler forgot to release, and a DLL's string results -- the host frees the data
'' but releases the descriptor to ITS OWN runtime, which does not know it, so a tiko DLL
'' returned "" from its 257th call on (sum 2196 = 1+...+256, measured; fbc the same).
'' tiko diverges here on purpose: a spent table gets another block of 256 from the heap,
'' with its own free list, and the result is right. A block is never given back. Whether
'' a descriptor is ours stays a range check -- one per block.
type TKORT_STR_SPILL
	as FB_LIST            lst
	as FB_STR_TMPDESC ptr tbl
end type
dim shared as TKORT_STR_SPILL ptr ptr tkort_tmpSpill
dim shared as integer        tkort_tmpSpillN, tkort_tmpSpillCap

'' ALLOCATE, NOT CALLOCATE.
''
'' Nothing here needs a zeroed block: the caller writes the characters and this
'' module writes the terminator. The first version used callocate, and the very
'' first benchmark run came out 2.60x slower than C -- almost all of it the
'' memset that calloc does and malloc does not, over blocks that reach 8 KB in
'' the concat benchmark.
''
'' Worth recording as a method note as much as a fix: the first Gate 4 number
'' this project ever produced was dominated by an implementation choice, not by
'' the language. A benchmark that is not chased down to its cause is just a
'' number with a story attached.

'' TWO LAWS, NOT ONE. fb_hStrAlloc and fb_hStrRealloc round to DIFFERENT
'' granules, and using one for both is wrong in a way almost nothing observes.
''
'' Measured by calling each entry point directly with a fresh descriptor
'' (PROBE-22, PROBE-23):
''
''   fb_hStrAlloc      len 1..32 -> 32, 33..64 -> 64, 65..96 -> 96   (x32)
''   fb_hStrRealloc    len 1..32 -> 36, 33..64 -> 72, 65..96 -> 108  (x36)
''                     -- identical for keepdata TRUE and FALSE
''
'' PROBE-13 measured only the x36 law, because it swept `s = string(n,"a")` and
'' assignment goes through fb_hStrRealloc. Nothing in the descriptor differential
'' can see the fb_hStrAlloc law at all, which is why it survived this long.
''
'' Both return size 0 for length 0 -- and both still return a REAL data pointer
'' there. See hAllocBlock.
private function hAllocSize( byval length as integer ) as integer
	if( length <= 0 ) then return 0
	return ((length + 31) \ 32) * 32
end function

private function hReallocSize( byval length as integer ) as integer
	if( length <= 0 ) then return 0
	return ((length + 31) \ 32) * 36
end function

'' Lazily initialised: str_core.o exports no init entry point, so there is
'' nowhere else for this to happen. Callers must hold the string lock.
private sub hPoolEnsure( )
	if( tkort_tmpReady = 0 ) then
		fb_hListInit( @tkort_tmpList, @tkort_tmpTable(0), _
		              sizeof( FB_STR_TMPDESC ), FB_STR_TMPDESCRIPTORS )
		tkort_tmpReady = 1
	end if
end sub

'' Is this descriptor one of ours? A temporary that did not come from the pool
'' must never be pushed onto its free list. Range check over the table, which is
'' contiguous by construction.
private function hFromPool( byval s as FBSTRING ptr ) as integer
	if( s = nullptr ) then return 0
	'' The upper bound is the END of the table, not the address of the last
	'' element: a descriptor lives at elem + offsetof(desc), so the last
	'' element's descriptor is PAST @tkort_tmpTable(255) and a naive
	'' `<= @table(last)` rejects it -- one entry in 256, which would have been
	'' a lovely bug to find later.
	dim as uint8 ptr lo = cptr( uint8 ptr, @tkort_tmpTable(0) )
	dim as uint8 ptr hi = lo + (sizeof( FB_STR_TMPDESC ) * FB_STR_TMPDESCRIPTORS)
	dim as uint8 ptr p  = cptr( uint8 ptr, s )
	return (p >= lo) andalso (p < hi)
end function

'' The spill block holding s, or -1.
private function hSpillOf( byval s as FBSTRING ptr ) as integer
	dim as uint8 ptr p = cptr( uint8 ptr, s )
	for k as integer = 0 to tkort_tmpSpillN - 1
		dim as uint8 ptr lo = cptr( uint8 ptr, tkort_tmpSpill[k]->tbl )
		dim as uint8 ptr hi = lo + (sizeof( FB_STR_TMPDESC ) * FB_STR_TMPDESCRIPTORS)
		if( (p >= lo) andalso (p < hi) ) then return k
	next
	return -1
end function

'' Ours to release: the table's, or a spill block's.
private function hOurs( byval s as FBSTRING ptr ) as integer
	if( hFromPool( s ) ) then return -1
	if( (s = nullptr) orelse (tkort_tmpSpillN = 0) ) then return 0
	return (hSpillOf( s ) >= 0)
end function

private function hSpillAlloc( ) as FB_LISTELEM ptr
	for k as integer = 0 to tkort_tmpSpillN - 1
		dim as FB_LISTELEM ptr e = fb_hListAllocElem( @tkort_tmpSpill[k]->lst )
		if( e <> nullptr ) then return e
	next
	if( tkort_tmpSpillN = tkort_tmpSpillCap ) then
		dim as integer ncap = iif( tkort_tmpSpillCap = 0, 8, tkort_tmpSpillCap * 2 )
		dim as any ptr np = reallocate( tkort_tmpSpill, ncap * sizeof( TKORT_STR_SPILL ptr ) )
		if( np = nullptr ) then return nullptr
		tkort_tmpSpill = np
		tkort_tmpSpillCap = ncap
	end if
	dim as TKORT_STR_SPILL ptr b = callocate( 1, sizeof( TKORT_STR_SPILL ) )
	if( b = nullptr ) then return nullptr
	b->tbl = callocate( FB_STR_TMPDESCRIPTORS, sizeof( FB_STR_TMPDESC ) )
	if( b->tbl = nullptr ) then
		deallocate( b )
		return nullptr
	end if
	fb_hListInit( @b->lst, b->tbl, sizeof( FB_STR_TMPDESC ), FB_STR_TMPDESCRIPTORS )
	tkort_tmpSpill[tkort_tmpSpillN] = b
	tkort_tmpSpillN += 1
	'' Said once, on stderr: a leaking temporary is a compiler bug worth knowing about,
	'' and a DLL's results are the expected cause. The run goes on, and is right.
	if( tkort_tmpWarned = 0 ) then
		tkort_tmpWarned = 1
		fprintf( stderr, !"tiko-rt: the string temporary pool was exhausted and has grown\n" )
	end if
	return fb_hListAllocElem( @b->lst )
end function

private function hPoolAlloc( ) as FBSTRING ptr
	hPoolEnsure( )
	dim as FB_LISTELEM ptr e = fb_hListAllocElem( @tkort_tmpList )
	if( e = nullptr ) then e = hSpillAlloc( )
	if( e = nullptr ) then return nullptr              '' out of memory
	dim as FB_STR_TMPDESC ptr t = cptr( FB_STR_TMPDESC ptr, e )
	t->desc.data = nullptr
	t->desc.len  = 0
	t->desc.size = 0
	return @t->desc
end function

private sub hPoolFree( byval s as FBSTRING ptr )
	dim as uint8 ptr p = cptr( uint8 ptr, s ) - offsetof( FB_STR_TMPDESC, desc )
	if( hFromPool( s ) ) then
		fb_hListFreeElem( @tkort_tmpList, cptr( FB_LISTELEM ptr, p ) )
		exit sub
	end if
	if( (s = nullptr) orelse (tkort_tmpSpillN = 0) ) then exit sub
	dim as integer k = hSpillOf( s )
	if( k >= 0 ) then fb_hListFreeElem( @tkort_tmpSpill[k]->lst, cptr( FB_LISTELEM ptr, p ) )
end sub

'' --------------------------------------------------------- the entry points

extern "rtlib"

function tkort_hStrAllocTempDesc alias "fb_hStrAllocTempDesc" ( ) as FBSTRING ptr
	STRLOCK()
	dim as FBSTRING ptr s = hPoolAlloc( )
	STRUNLOCK()
	return s
end function

'' Returns 0 if this descriptor came from the pool and was released, -1 if it
'' did not -- in which case NOTHING is done and the caller still owns it.
''
'' PROBE-14 saw only 0 because it only ever passed a pool descriptor. PROBE-16
'' asked the harder question:
''
''     pool descriptor      -> 0
''     caller's descriptor  -> -1
''     NULL                 -> -1
''
'' Returning 0 unconditionally is what the first version of this file did, and
'' it crashed every program: fbc's fb_StrDelete took 0 to mean "released" for
'' descriptors that were never ours, and skipped its own cleanup. Gate 2 would
'' have caught it; the allocator differential caught it in thirty seconds.
function tkort_hStrDelTempDesc alias "fb_hStrDelTempDesc" _
	( byval s as FBSTRING ptr ) as int32

	'' The spill count read unlocked only ever grows from 0, so a stale 0 sends a
	'' table-less descriptor the same way it always went.
	if( (hFromPool( s ) = 0) andalso (tkort_tmpSpillN = 0) ) then return -1

	STRLOCK()
	dim as integer ours = hOurs( s )
	if( ours ) then hPoolFree( s )
	STRUNLOCK()
	return iif( ours, 0, -1 )

end function

'' Give `s` a data block for `length` characters.
''
'' **IT MUST NOT LOOK AT WHAT `s` ALREADY HOLDS.** `fb_StrInit` -- the
'' `dim as string a = "xy"` path -- calls this with a descriptor that has never
'' been initialised, so `s->data` and `s->size` are whatever was on the stack.
''
'' The first version of this function was "defensively" written to free any
'' existing block first, and its comment claimed that was the safer choice. It
'' was free() on a garbage stack pointer. The symptom was that
'' `dim as string a = "xy"` crashed while `dim as string a : a = "xy"` was
'' perfectly fine -- which is what finally located it.
''
'' Freeing the old block is fb_hStrRealloc's job, and only fb_hStrRealloc knows
'' the descriptor is valid.
function tkort_hStrAlloc alias "fb_hStrAlloc" _
	( byval s as FBSTRING ptr, byval length as integer ) as FBSTRING ptr

	if( s = nullptr ) then return nullptr

	dim as integer want = hAllocSize( length )

	'' NO ZERO-LENGTH SHORTCUT. A length of 0 still gets a real one-byte block.
	''
	'' The first version returned `data = NULL, size = 0` here, on the reasoning
	'' that an empty string owns nothing -- which is true of a SETTLED variable
	'' (`s = ""` really does end up with a null data pointer) but is not true of
	'' what fb_hStrAlloc hands back. fbc's callers write the terminator
	'' unconditionally: `fb_StrUcase2` ends with `movb $0x0,(%rax)`, and with a
	'' null `rax` that is a segfault.
	''
	'' It cost a Linux gate run to find, and the crash was nowhere near the
	'' cause: the visible failures were dozens of WIDE-string assertions in
	'' expressions/iif.bas, and the actual fault was in a narrow ucase on a
	'' zstring. Running the same test file on its own passed.
	''
	'' `size` still reports 0, which is what the growth-law differential measures
	'' and what fbc reports; only the pointer is real.
	s->data = cptr( zstring ptr, allocate( want + 1 ) )
	if( s->data = nullptr ) then
		s->size = 0
		s->len  = 0
		return nullptr
	end if

	s->size = want
	s->len  = length
	s->data[length] = 0
	return s

end function

'' Resize a descriptor that IS valid. This is the only entry point allowed to
'' look at the existing block, and therefore the only one that may free it.
''
'' PROBE-12 showed the block is kept while the granule count is unchanged
'' (appending one character at a time does not reallocate 32 times) and moves
'' when it changes, including on shrink.
function tkort_hStrRealloc alias "fb_hStrRealloc" _
	( byval s as FBSTRING ptr, byval length as integer, byval keepdata as int32 ) as FBSTRING ptr

	'' NOTE: the parameter is `keepdata`, not `preserve` -- PRESERVE is a
	'' FreeBASIC keyword (REDIM PRESERVE) and is error 59 as a parameter name.

	if( s = nullptr ) then return nullptr

	dim as integer want = hReallocSize( length )

	'' THE EMPTY-DESCRIPTOR SHORTCUT EXISTS ONLY FOR THE ASSIGN MODE.
	''
	'' fbc's allocator depends on the MODE, not on whether there is a block yet.
	'' Measured, per 1,000 iterations:
	''
	''     assign_grow / temp_churn (not keepdata)  fbc: 1000 malloc,  0 realloc
	''     append / concat_assign_growing (keepdata) fbc:    0 malloc, 54 realloc
	''
	'' so the append path's FIRST allocation is realloc(NULL, n), not malloc(n).
	''
	'' AND IT CANNOT BE WRITTEN AS ITS OWN BRANCH. An earlier version had
	'' `if s->data = 0 then ... reallocate( 0, want + 1 )`, which is correct C
	'' and correct FreeBASIC and still came out WRONG: inside that branch the
	'' pointer is provably null, and LLVM's InstCombine folds realloc(null, n)
	'' into malloc(n). alloc-count then reported
	''
	''     append   fbc: 0 malloc 54 realloc    tiko-rt: 2 malloc 52 realloc
	''
	'' -- ONLY IN RELEASE. The fold does not happen at -O0, so Debug was green
	'' and Release was not, and nothing in the source had changed between them.
	''
	'' The fix is structural rather than a barrier: the keepdata mode reaches
	'' ONE realloc call site below, with a pointer the optimiser cannot prove is
	'' null, and the empty case is folded into the ordinary grow rule.
	if( (s->data = nullptr) andalso (keepdata = 0) ) then
		'' No zero-length shortcut here: length 0 still gets a real one-byte
		'' block, exactly as fb_hStrAlloc does. Measured -- fbc's
		'' fb_hStrRealloc( fresh, 0, either mode ) returns size 0 and a NON-NULL
		'' pointer, and its callers write the terminator regardless.
		s->data = cptr( zstring ptr, allocate( want + 1 ) )
		if( s->data = nullptr ) then
			s->size = 0
			FB_STRSETLEN( s, 0 )
			return nullptr
		end if
		s->size = want
		FB_STRSETLEN( s, length )
		s->data[length] = 0
		return s
	end if

	'' NOTE: shrinking to length 0 does NOT free the block and null the pointer.
	'' It reports size 0 and keeps a valid buffer, which is what fbc does. The
	'' null data pointer a settled empty variable ends up with comes from the
	'' assignment path calling fb_StrDelete, not from here.

	'' GROW ONLY WHEN THE BLOCK IS ACTUALLY TOO SMALL.
	''
	'' `size` is the usable capacity in characters, and `len` is allowed to
	'' reach it exactly -- measured against the C runtime, which produces
	'' len=144 size=144, len=288 size=288, len=432 size=432 while appending.
	'' The terminator then sits at data[size], which is why the block is
	'' allocated with one spare byte.
	''
	'' The first version tested `s->size <> want` instead, which reallocates
	'' whenever the granule count changes -- roughly twice as often on a growing
	'' append, and it needlessly SHRANK the block on the way down. That single
	'' comparison was the whole of a 2.1x regression on `acc = acc + piece`,
	'' while every other benchmark was at parity or faster. It is a difference in
	'' allocation policy, not in code generation, and no amount of looking at the
	'' emitted IR would have found it.
	'' THE TWO MODES RESIZE DIFFERENTLY, and that is the whole of the last
	'' allocation-count divergence.
	''
	''   keepdata (append/grow)  keep the block while it still fits. Measured:
	''       fbc appends to len=144 in a size=144 block, 288 in 288, 432 in 432,
	''       without moving the pointer. This is what stops `s &= x` from
	''       reallocating on every pass.
	''
	''   not keepdata (assign)   always resize to granule(len), INCLUDING
	''       downwards. `s = big1` after s held 512 characters shrinks 576 -> 252
	''       in fbc and did not in tiko-rt, which is where 1000 allocator
	''       operations per 1000 iterations went missing.
	''
	'' Reproduced rather than improved, deliberately: keeping the larger block is
	'' almost certainly cheaper, and adopting it here would make Gate 4 compare
	'' two allocation policies again (RFC-0004 section 4).
	'' CORRECTED 2026-08-29. The assign arm was `want <> s->size`, which shrinks
	'' on ANY granule change. Measured over a dense grid of (starting size,
	'' requested length) in both modes -- 11,000-odd cases, zero mismatches --
	'' the real rule has a 12.5% SHRINK HYSTERESIS:
	''
	''     grow    length > size                    (both modes)
	''     shrink  want < size - (size >> 3)        (assign mode only)
	''
	'' So realloc( 20 ) against a size-32 block keeps 32, while the same call
	'' against a size-72 block drops to 36. The old rule turned the first of
	'' those into 36 and nothing noticed for fifteen gate runs, because every
	'' differential written up to that point reached this function either from a
	'' fresh descriptor or from a block far larger than the request -- and both
	'' of those agree with the wrong rule.
	''
	'' It surfaced from fb_WstrAssignToAEx, which reassigns a var-len string
	'' whose block came from fb_hStrAlloc's x32 law while the request rounds by
	'' x36: the one arrangement where `want > size` and the length still fits.
	''
	'' NOTE THIS IS THE SAME HYSTERESIS ustr_core USES, which is not a
	'' coincidence -- fbc's own comment calls the ustring allocator a direct port
	'' of this one. Having written the wide version first and the narrow version
	'' from probes, the two disagreed and only the wide one was right.
	dim as integer resize = any
	if( keepdata <> 0 ) then
		'' `s->data = 0` is part of the GROW test rather than a branch of its
		'' own -- see the note above on the realloc(null) fold. A fresh
		'' descriptor has size 0, so this is only reached for length 0, where
		'' the block still has to exist for the terminator.
		resize = ((length > s->size) orelse (s->data = nullptr))
	else
		dim as integer grow_ = (length > s->size)
		dim as integer shrink_ = (want < (s->size - (s->size shr 3)))
		resize = (grow_ orelse shrink_)
	end if

	if( resize ) then
		if( keepdata <> 0 ) then
			dim as any ptr p = reallocate( s->data, want + 1 )
			if( p = nullptr ) then return nullptr
			s->data = cptr( zstring ptr, p )
		else
			deallocate( s->data )
			s->data = cptr( zstring ptr, allocate( want + 1 ) )
			if( s->data = nullptr ) then
				s->size = 0
				FB_STRSETLEN( s, 0 )
				return nullptr
			end if
		end if
		s->size = want
	end if

	FB_STRSETLEN( s, length )
	s->data[length] = 0
	return s

end function

'' A temporary: descriptor from the pool if the caller did not supply one, data
'' allocated, and the temp bit SET -- which is what distinguishes it from an
'' ordinary string and what fb_StrDelete keys off (PROBE-15).
function tkort_hStrAllocTemp_NoLock alias "fb_hStrAllocTemp_NoLock" _
	( byval s as FBSTRING ptr, byval length as integer ) as FBSTRING ptr

	dim as integer owned = 0

	if( s = nullptr ) then
		s = hPoolAlloc( )
		if( s = nullptr ) then return nullptr
		owned = 1
	end if

	'' NOTE: the x36 law, not fb_hStrAlloc's x32.
	''
	'' fb_hStrAllocTemp does NOT allocate the way fb_hStrAlloc does. Measured:
	'' fb_hStrAllocTemp( d, 10 ) reports size 36, while fb_hStrAlloc( d, 10 )
	'' reports 32. Routing this through fb_hStrAlloc gives a temporary one
	'' granule too small in `size`, and because fb_StrAssign STEALS a
	'' temporary's buffer rather than copying it, that wrong size then becomes
	'' the size of an ordinary variable -- which is how a mistake in a temp
	'' allocator shows up as a wrong growth law for `s = string(n,"a")`.
	if( tkort_hStrRealloc( s, length, 0 ) = nullptr ) then
		if( owned ) then hPoolFree( s )
		return nullptr
	end if

	'' Set the flag AFTER the allocation: hStrAlloc goes through FB_STRSETLEN,
	'' which preserves whatever the bit already was.
	s->len or= FB_TEMPSTRBIT
	return s

end function

function tkort_hStrAllocTemp alias "fb_hStrAllocTemp" _
	( byval s as FBSTRING ptr, byval length as integer ) as FBSTRING ptr
	STRLOCK()
	dim as FBSTRING ptr r = tkort_hStrAllocTemp_NoLock( s, length )
	STRUNLOCK()
	return r
end function

'' Free the temporary's data, then release its descriptor if -- and only if --
'' the descriptor came from our pool.
''
'' THE RETURN VALUE AND THE FREEING ARE INDEPENDENT, which is the thing the
'' first version got wrong. PROBE-16 measured `DelTemp( a caller's temp ) -> -1`
'' and it was read as "so it does nothing". It is not: the allocation-count
'' differential shows fbc performing 1000 frees per 1000 temporaries on exactly
'' that path, while tiko-rt performed **zero**. A straight leak -- 1000 blocks
'' allocated and never released.
''
'' It could not have been caught any other way. The gate passed, every output
'' matched, and every descriptor differential said IDENTICAL, because a leak
'' changes nothing a program can observe. RFC-0004 section 4 says exactly this
'' about Gate 3 and it went unbuilt until it was needed.
''
'' So: -1 means "the descriptor was not mine to release", not "I did nothing".
'' The data is freed either way, when the temp bit says the temporary owns it.
function tkort_hStrDelTemp_NoLock alias "fb_hStrDelTemp_NoLock" _
	( byval s as FBSTRING ptr ) as int32

	if( s = nullptr ) then return -1

	'' NOT A TEMPORARY -> NOT OURS TO TOUCH. Leave it entirely alone.
	''
	'' This gate is the whole contract and it took two wrong versions to find.
	'' fbc calls fb_hStrDelTemp on THREE descriptors per `len(a + b)`: the two
	'' operands and the result. Only the result carries the temp bit.
	''
	''   version 1  returned -1 for anything not from our pool, without freeing.
	''              Correct for the operands, and a LEAK for the result whenever
	''              fbc supplied its own descriptor -- 1000 allocations, 0 frees.
	''   version 2  freed and zeroed unconditionally. It plugged the leak and
	''              ZEROED THE OPERANDS' DESCRIPTORS -- live strings, wiped.
	''   this one   keys on the temp bit, which is what actually says "this
	''              temporary owns its data". Operands survive; the result is
	''              freed; and fbc's call counts line up with its own runtime's.
	''
	'' The tell was never a wrong answer. It was fb_hStrAllocTemp being called
	'' ONCE per thousand iterations instead of a thousand times: with the
	'' operands' descriptors zeroed, the caller stopped asking for a buffer.
	'' TWO SEPARATE QUESTIONS, and conflating them is what went wrong twice:
	''
	''   does this temporary OWN its data?   -> the temp bit. PROBE-17: a
	''       literal-backed temporary points at a string literal and leaves the
	''       bit clear, so freeing it is free() on a literal.
	''   is this descriptor OURS to release? -> whether it came from the pool.
	''
	'' Gating the whole function on the temp bit exhausted the 256-entry pool,
	'' because literal-backed descriptors ARE ours and were never handed back.
	'' Gating it on the pool leaked the data. Each question governs its own half.
	dim as integer mine = hOurs( s )

	if( (FB_ISTEMP( s ) = 0) andalso (mine = 0) ) then
		'' Neither a temporary nor ours: a live string belonging to someone
		'' else. fbc calls this on all three descriptors of `len(a + b)` -- the
		'' two operands and the result -- and only the result is a temporary.
		'' Touching the operands wipes live data.
		return -1
	end if

	if( FB_ISTEMP( s ) ) then
		if( s->data <> nullptr ) then deallocate( s->data )
		s->data = nullptr
		s->len  = 0
		s->size = 0
	end if

	if( mine = 0 ) then return -1
	hPoolFree( s )
	return 0

end function

function tkort_hStrDelTemp alias "fb_hStrDelTemp" ( byval s as FBSTRING ptr ) as int32
	STRLOCK()
	dim as int32 r = tkort_hStrDelTemp_NoLock( s )
	STRUNLOCK()
	return r
end function

'' Raw byte copies. The ONLY difference is the terminator (PROBE-14); neither
'' stops at a NUL in the source.
sub tkort_hStrCopy alias "fb_hStrCopy" _
	( byval dst as zstring ptr, byval src as zstring ptr, byval bytes as integer )
	if( (dst = nullptr) orelse (bytes < 0) ) then exit sub
	if( (src <> nullptr) andalso (bytes > 0) ) then memcpy( dst, src, bytes )
	dst[bytes] = 0
end sub

sub tkort_hStrCopyN alias "fb_hStrCopyN" _
	( byval dst as zstring ptr, byval src as zstring ptr, byval bytes as integer )
	if( (dst = nullptr) orelse (src = nullptr) orelse (bytes <= 0) ) then exit sub
	memcpy( dst, src, bytes )
end sub

end extern
