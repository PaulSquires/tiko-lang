'' valint.tiko -- fb_hStr2Int / fb_VALINT (str_convfrom_int.o) and
''               fb_hStr2UInt / fb_VALUINT (str_convfrom_uint.o).
''
'' THE SIGNED AND UNSIGNED FORMS ARE NOT THE SAME SHAPE, and the difference is
'' the sort that a mirror-image rewrite gets wrong:
''
''   fb_hStr2Int   sets radix = 0, and RETURNS EARLY through fb_hStrRadix2Int
''                 when a prefix is found. The decimal fall-through is reached
''                 only when there was no prefix at all.
''
''   fb_hStr2UInt  sets radix = 10, ADVANCES p past the prefix, and falls through
''                 to ONE strtoul call carrying the chosen radix.
''
'' Same answers, different structure -- and the unsigned form therefore never
'' calls the hand-rolled radix parser, so `&hFFzz` stops where strtoul stops
'' rather than where fb_hStrRadix2Int stops. They agree anyway because both stop
'' at the first invalid digit.
''
'' BOTH USE strtoul FOR DECIMAL, NOT atoi. fbc's comment: "atoi() saturates
'' values outside [-2^31, 2^31) so use strtoul() instead" -- so an out-of-range
'' decimal WRAPS rather than clamping, and the signed form returns the wrapped
'' bit pattern.

#include once "inc/descriptors.ti"

extern "rtlib"
	declare function tkrt_SkipChar alias "fb_hStrSkipChar" _
		( byval s as zstring ptr, byval length as integer, byval c as int32 ) as zstring ptr
	declare function tkrt_Radix2Int alias "fb_hStrRadix2Int" _
		( byval s as zstring ptr, byval length as integer, byval radix as int32 ) as int32
	declare function tkrt_DelTemp alias "fb_hStrDelTemp" _
		( byval s as FBSTRING ptr ) as int32
end extern

extern "rtlib"

function tkort_hStr2Int alias "fb_hStr2Int" _
	( byval src as zstring ptr, byval length as integer ) as int32

	dim as zstring ptr p = tkrt_SkipChar( src, length, 32 )

	length -= cast( integer, cptr( uint8 ptr, p ) - cptr( uint8 ptr, src ) )
	if( length < 1 ) then return 0

	dim as uint8 ptr up = cptr( uint8 ptr, p )

	if( (length >= 2) andalso (up[0] = asc("&")) ) then
		dim as int32 radix = 0
		dim as integer skip = 2

		select case as const up[1]
		case asc("h"), asc("H")
			radix = 16
		case asc("o"), asc("O")
			radix = 8
		case asc("b"), asc("B")
			radix = 2
		case else
			radix = 8
			skip = 1
		end select

		if( radix <> 0 ) then
			return tkrt_Radix2Int( cptr( zstring ptr, up + skip ), length - skip, radix )
		end if
	end if

	'' strtoul, not atoi: out of range WRAPS instead of saturating.
	return cast( int32, strtoul( p, nullptr, 10 ) )

end function

function tkort_VALINT alias "fb_VALINT" ( byval s as FBSTRING ptr ) as int32

	if( s = nullptr ) then return 0

	dim as int32 v = 0
	if( s->data <> nullptr ) then
		if( FB_STRSIZE( s ) <> 0 ) then
			v = tkort_hStr2Int( s->data, FB_STRSIZE( s ) )
		end if
	end if

	tkrt_DelTemp( s )

	return v

end function

function tkort_hStr2UInt alias "fb_hStr2UInt" _
	( byval src as zstring ptr, byval length as integer ) as uint32

	dim as zstring ptr p = tkrt_SkipChar( src, length, 32 )

	length -= cast( integer, cptr( uint8 ptr, p ) - cptr( uint8 ptr, src ) )
	if( length < 1 ) then return 0

	dim as uint8 ptr up = cptr( uint8 ptr, p )
	dim as int32 radix = 10

	if( (length >= 2) andalso (up[0] = asc("&")) ) then
		dim as integer skip = 2

		select case as const up[1]
		case asc("h"), asc("H")
			radix = 16
		case asc("o"), asc("O")
			radix = 8
		case asc("b"), asc("B")
			radix = 2
		case else
			radix = 8
			skip = 1
		end select

		'' Advance and fall through -- no early return, unlike the signed form.
		if( radix <> 10 ) then p = cptr( zstring ptr, up + skip )
	end if

	return cast( uint32, strtoul( p, nullptr, radix ) )

end function

function tkort_VALUINT alias "fb_VALUINT" ( byval s as FBSTRING ptr ) as uint32

	if( s = nullptr ) then return 0

	dim as uint32 v = 0
	if( s->data <> nullptr ) then
		if( FB_STRSIZE( s ) <> 0 ) then
			v = tkort_hStr2UInt( s->data, FB_STRSIZE( s ) )
		end if
	end if

	tkrt_DelTemp( s )

	return v

end function

end extern
