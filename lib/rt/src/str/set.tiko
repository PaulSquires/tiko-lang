'' set.tiko -- fb_StrLset, fb_StrRset, fb_StrLsetANA, fb_StrRsetANA (str_set.o).
''
'' LSET and RSET place a source string into a destination of FIXED width,
'' padding with spaces and truncating what does not fit. Four entry points in one
'' member: the plain pair take an FBSTRING destination, the ANA pair take a raw
'' buffer and its size.
''
'' THE ASYMMETRIES ARE THE WHOLE CONTRACT, and none is in the signatures.
''
'' 1. THE PLAIN FORMS REQUIRE dst->data; THE ANA FORMS DO NOT. fb_StrLset tests
''    `dst != NULL && dst->data != NULL`; fb_StrLsetANA tests only `dst != NULL`,
''    because there the pointer IS the buffer.
''
'' 2. THE PLAIN FORMS CONSUME BOTH OPERANDS; THE ANA FORMS CONSUME ONLY src.
''    An ANA destination is not a descriptor and has no temp bit to honour.
''
'' 3. LSET TERMINATES, RSET DOES NOT. fb_StrLset writes `dst->data[slen+len] = 0`
''    after padding; fb_StrRset writes no terminator at all. Neither ANA form
''    terminates. That is not an oversight to tidy up -- a fixed-length
''    destination is exactly `dlen` bytes and a terminator would run past it.
''
'' 4. LSET COPIES WITH fb_hStrCopy, LSET-ANA WITH fb_hStrCopyN. The N form is
''    the one that does not terminate.
''
'' 5. THE DESTINATION LENGTH COMES FROM DIFFERENT PLACES: FB_STRSIZE( dst ) for
''    the plain forms, `dst_size and FB_STRSIZEMSK` for the ANA forms -- the
''    fixed-length size with its flag bits masked off, not a descriptor read.
''
'' Padding is 0x20 in every case, and only when the source is SHORTER than the
'' destination; a longer source is truncated with no padding.

#include once "inc/descriptors.ti"

extern "rtlib"
	declare sub fb_hStrCopy alias "fb_hStrCopy" _
		( byval dst as zstring ptr, byval src as zstring ptr, byval bytes as integer )
	declare sub fb_hStrCopyN alias "fb_hStrCopyN" _
		( byval dst as zstring ptr, byval src as zstring ptr, byval bytes as integer )
	declare function tkrt_DelTemp alias "fb_hStrDelTemp" _
		( byval s as FBSTRING ptr ) as int32
end extern

extern "rtlib"

sub tkort_StrLset alias "fb_StrLset" _
	( byval dst as FBSTRING ptr, byval src as FBSTRING ptr )

	dim as integer ok = 0
	if( dst <> nullptr ) then
		if( dst->data <> nullptr ) then
			if( src <> nullptr ) then ok = 1
		end if
	end if

	if( ok <> 0 ) then
		dim as integer slen = FB_STRSIZE( src )
		dim as integer dlen = FB_STRSIZE( dst )

		if( dlen > 0 ) then
			dim as integer n = dlen
			if( dlen > slen ) then n = slen

			fb_hStrCopy( dst->data, src->data, n )

			n = dlen - slen
			if( n > 0 ) then
				memset( @dst->data[slen], 32, n )
				'' LSET terminates; RSET does not.
				dst->data[slen + n] = 0
			end if
		end if
	end if

	tkrt_DelTemp( src )
	tkrt_DelTemp( dst )

end sub

sub tkort_StrLsetANA alias "fb_StrLsetANA" _
	( byval dst as any ptr, byval dst_size as integer, byval src as FBSTRING ptr )

	if( (dst <> nullptr) andalso (src <> nullptr) ) then
		dim as integer slen = FB_STRSIZE( src )
		dim as integer dlen = dst_size and FB_STRSIZEMSK

		if( dlen > 0 ) then
			dim as integer n = dlen
			if( dlen > slen ) then n = slen

			fb_hStrCopyN( dst, src->data, n )

			n = dlen - slen
			if( n > 0 ) then
				memset( cptr( uint8 ptr, dst ) + slen, 32, n )
			end if
		end if
	end if

	'' Only src. The destination is a raw buffer, not a descriptor.
	tkrt_DelTemp( src )

end sub

sub tkort_StrRset alias "fb_StrRset" _
	( byval dst as FBSTRING ptr, byval src as FBSTRING ptr )

	dim as integer ok = 0
	if( dst <> nullptr ) then
		if( dst->data <> nullptr ) then
			if( src <> nullptr ) then ok = 1
		end if
	end if

	if( ok <> 0 ) then
		dim as integer slen = FB_STRSIZE( src )
		dim as integer dlen = FB_STRSIZE( dst )

		if( dlen > 0 ) then
			'' Pad on the LEFT, then place the source after the padding.
			dim as integer padlen = dlen - slen
			if( padlen > 0 ) then
				memset( dst->data, 32, padlen )
			else
				padlen = 0
			end if

			dim as integer n = dlen
			if( dlen > slen ) then n = slen

			fb_hStrCopy( @dst->data[padlen], src->data, n )
		end if
	end if

	tkrt_DelTemp( src )
	tkrt_DelTemp( dst )

end sub

sub tkort_StrRsetANA alias "fb_StrRsetANA" _
	( byval dst as any ptr, byval dst_size as integer, byval src as FBSTRING ptr )

	if( (dst <> nullptr) andalso (src <> nullptr) ) then
		dim as integer slen = FB_STRSIZE( src )
		dim as integer dlen = dst_size and FB_STRSIZEMSK

		if( dlen > 0 ) then
			dim as integer padlen = dlen - slen
			if( padlen > 0 ) then
				memset( dst, 32, padlen )
			else
				padlen = 0
			end if

			dim as integer n = dlen
			if( dlen > slen ) then n = slen

			fb_hStrCopyN( cptr( uint8 ptr, dst ) + padlen, src->data, n )
		end if
	end if

	tkrt_DelTemp( src )

end sub

end extern
