'' radix.tiko -- fb_hStrRadix2Int (str_convfrom_rad.o) and fb_hStrRadix2Longint
'' (str_convfrom_radlng.o).
''
'' Hand-rolled digit loops for radix 16, 8 and 2, used by the VAL family once a
'' `&H` / `&O` / `&B` prefix has been recognised. Two fbc members, identical bar
'' the accumulator width; one file here.
''
'' THREE PROPERTIES THAT ARE NOT ERRORS, and would be easy to "fix" into a
'' divergence:
''
'' 1. PARSING STOPS AT THE FIRST BAD DIGIT and returns what it has. `&hFFzz`
''    gives 65535, not an error and not 0.
'' 2. OVERFLOW WRAPS SILENTLY. The accumulator is a plain int / long long and
''    `v = v * 16 + c` is left to overflow.
'' 3. AN UNKNOWN RADIX RETURNS 0 through the `default:` arm -- it does not fall
''    back to decimal.
''
'' The hex arm accepts a..f, A..F and 0..9 in that order; the order is
'' immaterial to the result but the RANGES are exact, so `g` and `:` both stop
'' the loop.

#include once "inc/descriptors.ti"

extern "rtlib"

function tkort_hStrRadix2Int alias "fb_hStrRadix2Int" _
	( byval src as zstring ptr, byval length as integer, byval radix as int32 ) as int32

	dim as int32 v = 0
	dim as int32 c = any
	dim as uint8 ptr p = cptr( uint8 ptr, src )

	select case as const radix
	case 16
		do
			length -= 1
			if( length < 0 ) then exit do
			c = *p : p += 1
			if( (c >= 97) andalso (c <= 102) ) then
				c -= 87
			elseif( (c >= 65) andalso (c <= 70) ) then
				c -= 55
			elseif( (c >= 48) andalso (c <= 57) ) then
				c -= 48
			else
				exit do
			end if
			v = (v * 16) + c
		loop

	case 8
		do
			length -= 1
			if( length < 0 ) then exit do
			c = *p : p += 1
			if( (c >= 48) andalso (c <= 55) ) then
				v = (v * 8) + (c - 48)
			else
				exit do
			end if
		loop

	case 2
		do
			length -= 1
			if( length < 0 ) then exit do
			c = *p : p += 1
			if( (c >= 48) andalso (c <= 49) ) then
				v = (v * 2) + (c - 48)
			else
				exit do
			end if
		loop

	case else
		'' Not decimal -- zero.
	end select

	return v

end function

function tkort_hStrRadix2Longint alias "fb_hStrRadix2Longint" _
	( byval src as zstring ptr, byval length as integer, byval radix as int32 ) as int64

	dim as int64 v = 0
	dim as int32 c = any
	dim as uint8 ptr p = cptr( uint8 ptr, src )

	select case as const radix
	case 16
		do
			length -= 1
			if( length < 0 ) then exit do
			c = *p : p += 1
			if( (c >= 97) andalso (c <= 102) ) then
				c -= 87
			elseif( (c >= 65) andalso (c <= 70) ) then
				c -= 55
			elseif( (c >= 48) andalso (c <= 57) ) then
				c -= 48
			else
				exit do
			end if
			v = (v * 16) + c
		loop

	case 8
		do
			length -= 1
			if( length < 0 ) then exit do
			c = *p : p += 1
			if( (c >= 48) andalso (c <= 55) ) then
				v = (v * 8) + (c - 48)
			else
				exit do
			end if
		loop

	case 2
		do
			length -= 1
			if( length < 0 ) then exit do
			c = *p : p += 1
			if( (c >= 48) andalso (c <= 49) ) then
				v = (v * 2) + (c - 48)
			else
				exit do
			end if
		loop

	case else
	end select

	return v

end function

end extern
