'' rnd.tiko -- RND, RND32, RANDOMIZE and the PRNG state: four entry points over
'' one fbc member.
''
'' FIVE GENERATORS BEHIND ONE PAIR OF FUNCTION POINTERS. The state block holds
'' rndproc/rndproc32, and RANDOMIZE swaps them -- so fb_Rnd never branches on
'' the algorithm. Reproducing that indirection matters because fb_RndGetState
'' hands the whole block out and callers read those pointers.
''
'' RND WORKS WITHOUT RANDOMIZE. The pointers start at a STARTUP pair that
'' seeds on first use and then re-dispatches, so the first RND initialises the
'' generator and returns a number from it. That is why the initial pointers are
'' part of the state's definition, not an implementation detail.
''
'' THE DEFAULT ALGORITHM DEPENDS ON THE DIALECT: MTWIST for -lang fb, CRT for
'' fblite and deprecated, QB for -lang qb. Read from __fb_ctx.lang, which is
'' why this file needs a measured context offset.
''
'' RND(0) RETURNS THE LAST VALUE, and `last_num` is updated by fb_Rnd ONLY --
'' never by fb_Rnd32 or by the generators directly, and never reset. Two of the
'' five generators do not even consult it: FAST recomputes from its seed and QB
'' recomputes from its own, so RND(0) after RND32 differs between algorithms.
''
'' NEGATIVE ARGUMENTS ARE A QB-ONLY RESEED. hRnd_QB treats n < 0 as "reseed
'' from the bit pattern of n"; every other generator ignores the sign.

#include once "inc/descriptors.ti"
#include once "inc/ctx.ti"
#include once "inc/iolock.ti"
#include once "inc/sysbind.ti"

'' RAND_MAX IS A PLATFORM CONSTANT AND CHANGES THE VALUES CRT PRODUCES.
''
'' fbc's crt bindings define it for win32 only (&h7FFF, the MSVCRT value);
'' glibc's is 2147483647. hRnd_CRT divides by RAND_MAX + 1, so the CRT
'' generator's output legitimately differs between the two -- it is rand()'s
'' range, not a choice this file makes, and hard-coding either value would be
'' wrong on the other target.
#if defined( __FB_WIN32__ ) or defined( __FB_WIN64__ )
	const TKORT_RAND_MAX = &h7FFF
#else
	const TKORT_RAND_MAX = 2147483647
#endif

const FB_RND_AUTO   = 0
const FB_RND_CRT    = 1
const FB_RND_FAST   = 2
const FB_RND_MTWIST = 3
const FB_RND_QB     = 4
const FB_RND_REAL   = 5

const FB_RND_MAX_STATE = 624
const MAX_STATE = FB_RND_MAX_STATE
const PERIOD    = 397
const INITIAL_SEED = 327680

type FB_RNDPROC   as function cdecl ( byval n as single ) as double
type FB_RNDPROC32 as function cdecl ( ) as ulong

'' The state block, handed out whole by fb_RndGetState. NOT byte-packed: it
'' mirrors what the C compiler laid out and callers read its fields.
type FB_RNDSTATE
	as ulong        algorithm
	as ulong        length_
	as FB_RNDPROC   rndproc
	as FB_RNDPROC32 rndproc32
	'' A union of a 64- and a 32-bit seed in C. Declared as the 64-bit member
	'' with a macro for the low half, because FreeBASIC's union would need a
	'' name and the field is read by offset from the other side.
	as ulongint     iseed64
	as ulong ptr    index32
	as ulong        state32( 0 to FB_RND_MAX_STATE - 1 )
end type

#define TKORT_ISEED32( c ) *cptr( ulong ptr, @(c).iseed64 )

extern "rtlib"
	declare function tkrt_Timer alias "fb_Timer" ( ) as double
	declare sub tkort_Randomize alias "fb_Randomize" ( byval seed as double, byval algorithm as long )
	declare function tkort_Rnd alias "fb_Rnd" ( byval n as single ) as double
	declare function tkort_Rnd32 alias "fb_Rnd32" ( ) as ulong
end extern

declare function hRnd_Startup cdecl ( byval n as single ) as double
declare function hRnd_Startup32 cdecl ( ) as ulong
'' CDECL IS EXPLICIT, like its two neighbours above. A declaration outside an
'' EXTERN block that names no convention takes the TARGET's default, which is
'' stdcall on win32 and cdecl everywhere else -- see build/lint.sh check 3b.
declare sub hRndCtxInitMTWIST32 cdecl ( byval seed as ulongint )

'' The generator state. A file-scope static in fbc; the initial function
'' pointers are the STARTUP pair -- see the header.
dim shared as FB_RNDSTATE ctx_

'' Updated by fb_Rnd only, never reset. See the header.
dim shared as double last_num = 0.0

dim shared as long ctx_inited = 0

private sub hEnsureCtx( )
	if( ctx_inited ) then exit sub
	ctx_.algorithm = FB_RND_AUTO
	ctx_.length_ = 0
	ctx_.rndproc = @hRnd_Startup
	ctx_.rndproc32 = @hRnd_Startup32
	ctx_.iseed64 = 0
	ctx_.index32 = 0
	ctx_inited = 1
end sub

'' Numerical Recipes 7.1: seed, then a linear congruential fill.
#define FBRNDFAST32( a ) ( ((a) * 1664525ul) + 1013904223ul )

private sub hFillFAST32( byval buffer as ulong ptr, byval length32 as ulong, byval iseed32 as ulong )
	dim as ulong i = any
	buffer[0] = iseed32
	for i = 1 to length32 - 1
		buffer[i] = FBRNDFAST32( buffer[i - 1] )
	next
end sub

'' ------------------------------------------------------------- FB_RND_CRT

private function hRnd_CRT32 cdecl ( ) as ulong
	return rand( )
end function

private function hRnd_CRT cdecl ( byval n as single ) as double
	if( n = 0.0 ) then return last_num
	'' 1/(RAND_MAX+1), so the result is in [0,1) and never reaches 1.
	return cdbl( hRnd_CRT32( ) ) * (1.0 / (cdbl( TKORT_RAND_MAX ) + 1.0))
end function

private sub hRndCtxInitCRT32( byval seed as ulong )
	ctx_.algorithm = FB_RND_CRT
	ctx_.length_ = 0
	ctx_.index32 = 0
	ctx_.rndproc = @hRnd_CRT
	ctx_.rndproc32 = @hRnd_CRT32
	srand( seed )
end sub

'' ------------------------------------------------------------ FB_RND_FAST

private function hRnd_FAST32 cdecl ( ) as ulong
	TKORT_ISEED32( ctx_ ) = FBRNDFAST32( TKORT_ISEED32( ctx_ ) )
	return TKORT_ISEED32( ctx_ )
end function

private function hRnd_FAST cdecl ( byval n as single ) as double
	'' NOT last_num: FAST recomputes from its own seed, so RND(0) here can
	'' differ from the last value fb_Rnd returned. See the header.
	if( n = 0.0 ) then return cdbl( TKORT_ISEED32( ctx_ ) ) / 4294967296.0
	return cdbl( hRnd_FAST32( ) ) / 4294967296.0
end function

private sub hRndCtxInitFAST32( byval seed as ulong )
	ctx_.algorithm = FB_RND_FAST
	ctx_.length_ = 0
	ctx_.index32 = 0
	TKORT_ISEED32( ctx_ ) = seed
	ctx_.rndproc = @hRnd_FAST
	ctx_.rndproc32 = @hRnd_FAST32
end sub

'' ---------------------------------------------------------- FB_RND_MTWIST
''
'' Mersenne Twister MT19937. The state is regenerated 624 numbers at a time in
'' THREE loops, not one: the first runs while i + PERIOD is in range, the
'' second wraps the index by subtracting MAX_STATE, and the last element is
'' done alone because it pairs with element 0. Folding them into one loop with
'' a modulo gives the same numbers but is not what fbc compiled.

private function hRnd_MTWIST32 cdecl ( ) as ulong
	dim as ulong i = any, v = any
	static as ulong xor_mask(0 to 1) = { 0, &h9908B0DF }

	if( ctx_.index32 = 0 ) then
		hRndCtxInitMTWIST32( INITIAL_SEED )
	end if

	if( ctx_.index32 >= @ctx_.state32(0) + MAX_STATE ) then
		for i = 0 to MAX_STATE - PERIOD - 1
			v = (ctx_.state32(i) and &h80000000) or (ctx_.state32(i + 1) and &h7FFFFFFF)
			ctx_.state32(i) = ctx_.state32(i + PERIOD) xor (v shr 1) xor xor_mask(v and 1)
		next
		for i = MAX_STATE - PERIOD to MAX_STATE - 2
			v = (ctx_.state32(i) and &h80000000) or (ctx_.state32(i + 1) and &h7FFFFFFF)
			ctx_.state32(i) = ctx_.state32(i + PERIOD - MAX_STATE) xor (v shr 1) xor xor_mask(v and 1)
		next
		v = (ctx_.state32(MAX_STATE - 1) and &h80000000) or (ctx_.state32(0) and &h7FFFFFFF)
		ctx_.state32(MAX_STATE - 1) = ctx_.state32(PERIOD - 1) xor (v shr 1) xor xor_mask(v and 1)
		ctx_.index32 = @ctx_.state32(0)
	end if

	v = *ctx_.index32
	ctx_.index32 += 1
	'' The tempering shifts, which are part of MT19937 and not optional.
	v xor= (v shr 11)
	v xor= ((v shl 7) and &h9D2C5680)
	v xor= ((v shl 15) and &hEFC60000)
	v xor= (v shr 18)
	return v
end function

private function hRnd_MTWIST cdecl ( byval n as single ) as double
	if( n = 0.0 ) then return last_num
	return cdbl( hRnd_MTWIST32( ) ) / 4294967296.0
end function

private sub hRndCtxInitMTWIST32 cdecl ( byval seed as ulongint )
	ctx_.algorithm = FB_RND_MTWIST
	ctx_.length_ = MAX_STATE
	'' Positioned at the END, so the first call regenerates immediately.
	ctx_.index32 = @ctx_.state32(0) + MAX_STATE
	ctx_.rndproc = @hRnd_MTWIST
	ctx_.rndproc32 = @hRnd_MTWIST32
	hFillFAST32( @ctx_.state32(0), MAX_STATE, cast( ulong, seed ) )
end sub

'' -------------------------------------------------------------- FB_RND_QB
''
'' The QuickBASIC generator: a 24-BIT linear congruential, masked to &hFFFFFF.
'' The narrow width is the point -- it reproduces QB's sequence exactly.

private function hRnd_QB32 cdecl ( ) as ulong
	TKORT_ISEED32( ctx_ ) = ((TKORT_ISEED32( ctx_ ) * &hFD43FDul) + &hC39EC3ul) and &hFFFFFFul
	return TKORT_ISEED32( ctx_ )
end function

private function hRnd_QB cdecl ( byval n as single ) as double
	dim as ulong s = any

	'' SINGLE division, not double: the result is computed in single and then
	'' widened, so the low bits differ from a double division.
	if( n = 0.0 ) then return cdbl( csng( TKORT_ISEED32( ctx_ ) ) / csng( &h1000000 ) )

	'' A NEGATIVE ARGUMENT RESEEDS from the bit pattern of n -- QB only.
	if( n < 0.0 ) then
		s = *cptr( ulong ptr, @n )
		TKORT_ISEED32( ctx_ ) = s + (s shr 24)
	end if

	return cdbl( csng( hRnd_QB32( ) ) / csng( &h1000000 ) )
end function

private sub hRndCtxInitQB32( byval seed as ulong )
	ctx_.algorithm = FB_RND_QB
	ctx_.length_ = 0
	ctx_.index32 = 0
	TKORT_ISEED32( ctx_ ) = seed
	ctx_.rndproc = @hRnd_QB
	ctx_.rndproc32 = @hRnd_QB32
end sub

'' ------------------------------------------------------------ FB_RND_REAL
''
'' The only generator that is not deterministic: it fills the whole 624-word
'' state from the OS entropy source and hands out the words one at a time,
'' refilling when they run out.
''
'' WHEN THE OS SOURCE IS UNAVAILABLE IT FALLS BACK TO MTWIST -- and does so by
'' calling fb_Randomize, which REPLACES the generator permanently. So a single
'' failed refill silently downgrades every later RND for the life of the
'' process. That is fbc's documented behaviour, not an accident.

#if defined( __FB_WIN32__ ) or defined( __FB_WIN64__ )
	'' advapi32, which fbc's driver already links -- verified by compiling a
	'' program that calls RND and checking it links with no extra -l.
	const PROV_RSA_FULL = 1
	'' stdcall on win32 and plain on win64, which is what EXTERN "rtlib"
	'' already means here -- the lint is right that EXTERN "windows" is never
	'' the answer, and these are OS imports rather than rtlib entry points, so
	'' each carries its own explicit convention instead.
	extern "c"   '' NON-FBCALL: advapi32 imports, not rtlib entry points.
		declare function CryptAcquireContextA stdcall alias "CryptAcquireContextA" _
			( byval phProv as any ptr, byval szContainer as zstring ptr, _
			  byval szProvider as zstring ptr, byval dwProvType as ulong, _
			  byval dwFlags as ulong ) as long
		declare function CryptGenRandom stdcall alias "CryptGenRandom" _
			( byval hProv as any ptr, byval dwLen as ulong, byval pbBuffer as ubyte ptr ) as long
		declare function CryptReleaseContext stdcall alias "CryptReleaseContext" _
			( byval hProv as any ptr, byval dwFlags as ulong ) as long
	end extern
#else
	'' NOT console io: these are the POSIX file descriptors, named open/read/
	'' close, which the freestanding lint reasonably flags on sight. They are
	'' here to read /dev/urandom and nothing else.
	extern "c"   '' NON-FBCALL: libc file descriptors, for /dev/urandom.
		declare function fdopen_ alias "open" ( byval path as zstring ptr, byval flags as long, ... ) as long
		declare function fdread_ alias "read" ( byval fd as long, byval buf as any ptr, byval n as uinteger ) as integer
		declare function fdclose_ alias "close" ( byval fd as long ) as long
	end extern
	const O_RDONLY = 0
#endif

private function hRefillRealRndNumber( ) as long
	dim as long success = 0

	#if defined( __FB_WIN32__ ) or defined( __FB_WIN64__ )
		dim as any ptr provider = 0
		if( CryptAcquireContextA( @provider, 0, 0, PROV_RSA_FULL, 0 ) <> 0 ) then
			success = CryptGenRandom( provider, MAX_STATE * 4, cptr( ubyte ptr, @ctx_.state32(0) ) )
			CryptReleaseContext( provider, 0 )
		end if
	#else
		dim as long urandom = fdopen_( @"/dev/urandom", O_RDONLY )
		if( urandom <> -1 ) then
			if( fdread_( urandom, @ctx_.state32(0), MAX_STATE * 4 ) = MAX_STATE * 4 ) then
				success = 1
			end if
			fdclose_( urandom )
		end if
	#endif

	if( success <> 0 ) then ctx_.index32 = @ctx_.state32(0)
	return success
end function

private function hRnd_REAL32 cdecl ( ) as ulong
	dim as ulong v = any
	if( ctx_.index32 = (@ctx_.state32(0) + MAX_STATE) ) then
		if( hRefillRealRndNumber( ) = 0 ) then
			'' Permanent downgrade -- see the header.
			tkort_Randomize( -1.0, FB_RND_MTWIST )
			return hRnd_MTWIST32( )
		end if
	end if
	v = *ctx_.index32
	ctx_.index32 += 1
	return v
end function

private function hRnd_REAL cdecl ( byval n as single ) as double
	if( n = 0.0 ) then return last_num
	return cdbl( hRnd_REAL32( ) ) / 4294967296.0
end function

private sub hRndCtxInitREAL32( byval seed as ulongint )
	ctx_.algorithm = FB_RND_REAL
	ctx_.length_ = MAX_STATE
	ctx_.index32 = @ctx_.state32(0) + MAX_STATE
	ctx_.rndproc = @hRnd_REAL
	ctx_.rndproc32 = @hRnd_REAL32
	'' Seeded deterministically anyway, because a failed refill leaves this
	'' state in place until the fallback replaces it.
	hFillFAST32( @ctx_.state32(0), MAX_STATE, cast( ulong, seed ) )
end sub

'' --------------------------------------------------------------- startup

private sub hStartup( )
	select case TKORT_CTX_LANG()
	case FB_LANG_QB
		hRndCtxInitQB32( INITIAL_SEED )
	case FB_LANG_FB_FBLITE, FB_LANG_FB_DEPRECATED
		'' Seeded with 1, NOT with the timer: fblite matches C's default
		'' srand(1) so a program's sequence is reproducible.
		hRndCtxInitCRT32( 1 )
	case else
		tkort_Randomize( 0.0, FB_RND_AUTO )
	end select
end sub

private function hRnd_Startup32 cdecl ( ) as ulong
	hStartup( )
	'' Re-dispatched through the PUBLIC entry point, so the new pointers are
	'' picked up and the lock is taken again -- fbc does the same.
	return tkort_Rnd32( )
end function

private function hRnd_Startup cdecl ( byval n as single ) as double
	hStartup( )
	return tkort_Rnd( n )
end function

private function hGetAlgorithm( byval algorithm as long ) as long
	if( algorithm = FB_RND_AUTO ) then
		select case TKORT_CTX_LANG()
		case FB_LANG_QB                        : algorithm = FB_RND_QB
		case FB_LANG_FB_FBLITE, FB_LANG_FB_DEPRECATED : algorithm = FB_RND_CRT
		case else                              : algorithm = FB_RND_MTWIST
		end select
	end if
	return algorithm
end function

'' ----------------------------------------------------------- the public API

extern "rtlib"

'' seed = -1 means "unpredictable": the TIMER's two halves are XORed, which
'' changes far more often than once a second. Every algorithm but QB then takes
'' the INTEGER value of that.
sub tkort_Randomize alias "fb_Randomize" ( byval seed as double, byval algorithm as long )
	dim as ulong i0 = any, i1 = any, s = any
	dim as double d = any

	hEnsureCtx( )
	TKORT_MATHLOCK()

	if( seed = -1.0 ) then
		d = tkrt_Timer( )
		i0 = cptr( ulong ptr, @d )[0]
		i1 = cptr( ulong ptr, @d )[1]
		seed = cdbl( i0 xor i1 )
	end if

	ctx_.algorithm = hGetAlgorithm( algorithm )

	select case ctx_.algorithm
	case FB_RND_CRT
		hRndCtxInitCRT32( cast( ulong, seed ) )
		'' One value is drawn and DISCARDED, so the first RND after
		'' RANDOMIZE is the second value of the sequence.
		tkort_Rnd32( )

	case FB_RND_FAST
		hRndCtxInitFAST32( cast( ulong, seed ) )

	case FB_RND_QB
		'' QB seeds from the HIGH word of the double's bit pattern, folds it
		'' with a 16-bit shift and keeps the previous seed's low byte -- so
		'' RANDOMIZE with the same value twice does not give the same
		'' sequence unless the previous state also matched.
		d = seed
		s = cptr( ulong ptr, @d )[1]
		s xor= (s shr 16)
		s = ((s and &hFFFF) shl 8) or (TKORT_ISEED32( ctx_ ) and &hFF)
		hRndCtxInitQB32( s )

	case FB_RND_REAL
		hRndCtxInitREAL32( cast( ulong, seed ) )

	case else
		hRndCtxInitMTWIST32( cast( ulong, seed ) )
	end select

	TKORT_MATHUNLOCK()
end sub

function tkort_Rnd alias "fb_Rnd" ( byval n as single ) as double
	hEnsureCtx( )
	TKORT_MATHLOCK()
	'' last_num is written HERE and nowhere else -- see the header.
	last_num = ctx_.rndproc( n )
	TKORT_MATHUNLOCK()
	return last_num
end function

function tkort_Rnd32 alias "fb_Rnd32" ( ) as ulong
	dim as ulong result = any
	hEnsureCtx( )
	TKORT_MATHLOCK()
	result = ctx_.rndproc32( )
	TKORT_MATHUNLOCK()
	return result
end function

'' Hands out the whole block, function pointers included, so a caller can save
'' and restore a generator's exact position.
function tkort_RndGetState alias "fb_RndGetState" ( ) as FB_RNDSTATE ptr
	hEnsureCtx( )
	return @ctx_
end function

end extern
