'' timerset.tiko -- TIMER, and the two clock setters behind TIME$= and DATE$=.
'' Three symbols across three fbc members.
''
'' TIMER MEANS SOMETHING DIFFERENT ON EACH PLATFORM, and this is the one to know
'' before using it for anything but subtraction:
''
''   Windows  QueryPerformanceCounter / QueryPerformanceFrequency -- a MONOTONIC
''            counter since an arbitrary origin (boot, usually). The absolute
''            value is meaningless.
''   POSIX    gettimeofday -- SECONDS SINCE THE EPOCH, wall clock, and therefore
''            not monotonic. It jumps when NTP steps the clock, and it goes
''            BACKWARDS across a DST correction on a machine keeping local time.
''
'' So `t2 - t1` is right everywhere and `TIMER` alone is a wall clock on Linux
'' and a stopwatch on Windows. That is fbc's behaviour on both, not a choice made
'' here.
''
'' THE FREQUENCY IS CACHED IN A FILE-STATIC AND THE CACHE IS NOT THREAD-SAFE.
'' Two threads calling TIMER for the first time simultaneously can both see
'' TIMER_NONE and both query -- harmless, because they compute the same value and
'' the write is a single aligned store. Reproduced as-is; a lock here would be a
'' difference, not a fix.
''
'' AND THE FALLBACK IS GetTickCount, whose resolution is ~15ms and which WRAPS
'' after 49.7 days. It fires only when QueryPerformanceFrequency fails, which on
'' anything since Windows XP it does not.
''
'' THE TWO SETTERS NEED PRIVILEGE AND USUALLY FAIL. SetLocalTime wants
'' SE_SYSTEMTIME_NAME and settimeofday wants CAP_SYS_TIME, so TIME$="..." from an
'' ordinary process returns -1 on both. The interesting behaviour is therefore
'' the FAILURE path, and that is what the differential can actually check.
''
'' fb_hSetDate's POSIX BODY IS ARITHMETICALLY WRONG AND IS REPRODUCED. Three
'' separate defects, all of them fbc's:
''
''   1. `(i / 400) == 0` is INTEGER division, so it is true only for years
''      0..399 -- never in the loop's range. It was meant to be `% 400`, and the
''      Gregorian 400-year rule is therefore never applied.
''   2. Every year is 31536000 seconds (365 days) and a leap year adds a day by
''      incrementing `d`, the DAY-OF-MONTH parameter -- so the leap correction is
''      accumulated into the wrong variable and then multiplied by 86400 once at
''      the end. That happens to give the same total, but only because the
''      multiply is linear; it also means `d` is destroyed for any later use.
''   3. `tv.tv_sec += m * month_len[m-1]` multiplies the month NUMBER by the
''      length of THAT month, instead of summing the lengths of the months
''      before it. March (m=3) is charged 3 × 31 days, not 31 + 28.
''
'' Fixing any of them would make DATE$= set a different date under tiko-rt than
'' under fbc. The whole point of this project is that it does not.

#include once "inc/descriptors.ti"

#ifdef __FB_WIN32__

	'' SYSTEMTIME: eight WORDs, and the order is year, month, DAY-OF-WEEK, day.
	'' The day-of-week slot in the middle is the trap -- a struct written as
	'' y/m/d in the obvious order sets the day into wDayOfWeek and is ignored.
	type SYSTEMTIME_
		as ushort wYear, wMonth, wDayOfWeek, wDay
		as ushort wHour, wMinute, wSecond, wMilliseconds
	end type

	#assert sizeof( SYSTEMTIME_ ) = 16

	extern "c"   '' NON-FBCALL: kernel32, `stdcall` per declaration.
		declare sub w_GetLocalTime stdcall alias "GetLocalTime" ( byval st as SYSTEMTIME_ ptr )
		declare function w_SetLocalTime stdcall alias "SetLocalTime" ( byval st as SYSTEMTIME_ ptr ) as long
		declare function w_QueryPerformanceCounter stdcall alias "QueryPerformanceCounter" _
			( byval c as longint ptr ) as long
		declare function w_QueryPerformanceFrequency stdcall alias "QueryPerformanceFrequency" _
			( byval c as longint ptr ) as long
		declare function w_GetTickCount stdcall alias "GetTickCount" ( ) as ulong
	end extern

	const TIMER_NONE    = 0
	const TIMER_NORMAL  = 1
	const TIMER_HIGHRES = 2

	'' FILE-STATIC, and deliberately not guarded -- see the file header.
	dim shared as long tkort_timer_kind = TIMER_NONE
	dim shared as double tkort_timer_freq

#else

	type TIMEVAL_
		as longint tv_sec
		as longint tv_usec
	end type

	#assert sizeof( TIMEVAL_ ) = 16

	extern "c"   '' NON-FBCALL: libc.
		declare function u_gettimeofday alias "gettimeofday" _
			( byval tv as TIMEVAL_ ptr, byval tz as any ptr ) as long
		declare function u_settimeofday alias "settimeofday" _
			( byval tv as TIMEVAL_ ptr, byval tz as any ptr ) as long
	end extern

	'' The month lengths in SECONDS, exactly as fbc spells them -- 31, 28, 31,
	'' 30 ... days. February is 28 and there is no leap variant, which is part
	'' of defect 3 in the file header.
	dim shared as long tkort_month_len( 0 to 11 ) = { _
		2678400, 2419200, 2678400, 2592000, 2678400, 2592000, _
		2678400, 2678400, 2592000, 2678400, 2592000, 2678400 }

#endif

extern "rtlib"   '' FBCALL: fb_datetime.h decorates fb_Timer, and the win32
                 '' archive spells it `_fb_Timer@0`.

function tkort_Timer alias "fb_Timer" ( ) as double

	#ifdef __FB_WIN32__
		dim as longint count = any

		'' FIRST CALL DECIDES, and the decision is cached forever.
		if( tkort_timer_kind = TIMER_NONE ) then
			if( w_QueryPerformanceFrequency( @count ) <> 0 ) then
				'' THE RECIPROCAL IS CACHED, not the frequency -- so the hot
				'' path multiplies instead of dividing.
				tkort_timer_freq = 1.0 / cast( double, count )
				tkort_timer_kind = TIMER_HIGHRES
			else
				tkort_timer_kind = TIMER_NORMAL
			end if
		end if

		if( tkort_timer_kind = TIMER_NORMAL ) then
			'' ~15ms RESOLUTION AND WRAPS AT 49.7 DAYS. Unreachable in practice.
			return cast( double, w_GetTickCount( ) ) * 0.001
		end if

		w_QueryPerformanceCounter( @count )
		return cast( double, count ) * tkort_timer_freq
	#else
		'' SECONDS SINCE THE EPOCH -- a wall clock, not a stopwatch. The
		'' multiply-then-scale rather than a direct divide is fbc's, and it
		'' matters: it loses low bits differently than tv_sec + tv_usec/1e6
		'' would, and the differential compares the printed digits.
		dim as TIMEVAL_ tv = any
		u_gettimeofday( @tv, 0 )
		return ((cast( double, tv.tv_sec ) * 1000000.0) + cast( double, tv.tv_usec )) * 0.000001
	#endif
end function

end extern

extern "c"   '' NON-FBCALL: fb_datetime.h declares both setters plainly, and the
             '' win32 archive confirms no `@N`.

'' READS THE CURRENT LOCAL TIME AND WRITES BACK three fields -- so the date and
'' the milliseconds survive, and a machine whose clock is being stepped between
'' the read and the write loses the difference.
function tkort_hSetTime alias "fb_hSetTime" _
	( byval h as long, byval m as long, byval s as long ) as long

	#ifdef __FB_WIN32__
		dim as SYSTEMTIME_ st = any
		w_GetLocalTime( @st )

		st.wHour = cast( ushort, h )
		st.wMinute = cast( ushort, m )
		st.wSecond = cast( ushort, s )

		'' NO RANGE CHECK. An hour of 99 is handed to SetLocalTime, which
		'' refuses it and gives -1 -- which is the same answer an unprivileged
		'' process gets for a VALID time, so the caller cannot tell the two
		'' apart. fbc's, reproduced.
		if( w_SetLocalTime( @st ) = 0 ) then return -1
		return 0
	#else
		'' TRUNCATE TO MIDNIGHT, THEN ADD. `tv_sec % 86400` is the seconds since
		'' midnight UTC -- not local midnight -- so on a machine that is not on
		'' UTC this sets a time offset by the zone. fbc's, and the reason
		'' TIME$= on Linux is documented as approximate.
		dim as TIMEVAL_ tv = any
		u_gettimeofday( @tv, 0 )
		tv.tv_sec -= (tv.tv_sec mod 86400)
		tv.tv_sec += (h * 3600) + (m * 60) + s
		if( u_settimeofday( @tv, 0 ) <> 0 ) then return -1
		return 0
	#endif
end function

'' THE POSIX HALF IS ARITHMETICALLY WRONG IN THREE WAYS AND IS COPIED FAITHFULLY
'' -- see the file header, which names each one. Do not "fix" any of them.
function tkort_hSetDate alias "fb_hSetDate" _
	( byval y as long, byval m as long, byval d as long ) as long

	#ifdef __FB_WIN32__
		dim as SYSTEMTIME_ st = any
		w_GetLocalTime( @st )

		'' wDayOfWeek IS LEFT AS IT WAS and SetLocalTime ignores it, which is
		'' the only reason writing a stale day-of-week is harmless.
		st.wYear = cast( ushort, y )
		st.wMonth = cast( ushort, m )
		st.wDay = cast( ushort, d )

		if( w_SetLocalTime( @st ) = 0 ) then return -1
		return 0
	#else
		if( y < 1970 ) then return -1

		dim as TIMEVAL_ tv = any
		u_gettimeofday( @tv, 0 )

		'' The time of day is kept and everything else rebuilt.
		dim as longint secs = tv.tv_sec mod 86400
		tv.tv_sec = 0

		'' DEFECT 1 and DEFECT 2: `(i \ 400) = 0` is integer division and is
		'' never true here, and the leap day is added to `d` rather than to the
		'' seconds. Both are fbc's.
		for i as long = 1970 to y - 1
			tv.tv_sec += 31536000
			if( ((i mod 4) = 0) orelse ((i \ 400) = 0) ) then d += 1
		next

		'' DEFECT 3: the month NUMBER times the length of THAT month, instead of
		'' the sum of the preceding months.
		tv.tv_sec += (cast( longint, m ) * tkort_month_len( m - 1 ))

		if( ((y mod 4) = 0) orelse ((y \ 400) = 0) ) then d += 1

		tv.tv_sec += (cast( longint, d ) * 86400) + secs
		if( u_settimeofday( @tv, 0 ) <> 0 ) then return -1
		return 0
	#endif
end function

end extern
