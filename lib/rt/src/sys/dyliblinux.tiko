'' dyliblinux.tiko -- sys/dylib's shared-object filename conventions on Linux.
''
'' #INCLUDED by sys/dylib.tiko's POSIX branch, never compiled on its own and not
'' in build/sources.txt. It provides one table,
''
''     tkort_libfmt( ) as zstring ptr
''
'' the snprintf formats fb_DylibLoad tries in order, each applied to the name
'' the caller wrote, terminated by a 0 entry.
''
'' The Darwin sibling (dylibdarwin.tiko, M5) must provide the same table; fbc's
'' own Darwin list tries "lib%s.dylib" before "lib%s.so" and "./lib%s.dylib"
'' before "./lib%s.so".
''
'' NOTE: the "hlib" spellings below are what the runtime has shipped since
'' 70f420058, and fbc's table (and this file's includer's header) say "lib".
'' Moved here unchanged -- M4 changes no behaviour -- and reported, not fixed.

#if defined( __FB_LINUX__ )

'' The filename conventions, tried in order. A trailing 0 terminates the table.
dim shared as zstring ptr tkort_libfmt( 0 to 6 ) = { _
	@"%s", @"hlib%s", @"hlib%s.so", @"./%s", @"./hlib%s", @"./hlib%s.so", 0 }

#endif
