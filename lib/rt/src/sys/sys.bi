#ifndef __TKORT_SYS_BI__
#define __TKORT_SYS_BI__

'' sys.bi -- tiko-rt's OS and libc surface.
''
'' THE C LIBRARY IS inc/sysbind.bi: tiko's own binding, generated by lib/rt/build/genbind.sh
'' with tiko's -cimport (decision 0016, phase E) and cut to what the runtime names, plus the
'' streams, errno and jmp_buf that no importer carries. Until then this file included fbc's
'' crt/*.bi -- under decision R6 as amended by PROBE-6, when #cinclude could not yet carry
'' the job -- and 61 of those 80 headers may not be redistributed, which is what kept a
'' toolchain from being published (docs/architecture/decisions/0015 section 2.4).
''
'' crt/long.bi is the one fbc header still named: it carries no such notice, and the
'' binding uses its clong and culong.
''
'' windows.bi IS NOT INCLUDED any more. It declared nothing the runtime used -- every Win32
'' call tiko-rt makes is declared where it is made -- and it pulled in crt/stdarg.bi.
'' ...BUT ITS LIBRARIES ARE KEPT. Every object that included this file named them in its
'' .fbctinf, which is how a program linking the runtime has been getting kernel32, user32,
'' advapi32 and the rest; dropping windows.bi dropped all seven from 386 of 420 objects.
'' Same seven, same order, so each object's section is what it was.

#include once "inc/sysbind.bi"

#if defined( __FB_WIN32__ )
	#inclib "kernel32"
	#inclib "gdi32"
	#inclib "msimg32"
	#inclib "user32"
	#inclib "version"
	#inclib "advapi32"
	#inclib "imm32"
#endif

'' -------------------------------------------------------------- invariants
''
'' Asserted here rather than assumed, on every target, because each one is a
'' silent-corruption bug if it is ever false. RFC-0003 section 5.7.

#assert sizeof( any ptr ) = sizeof( integer )   '' integer is pointer-width

#endif '' __TKORT_SYS_BI__
