'' query.tiko -- the read-only half of the array descriptor: element and byte
'' counts, the LBOUND/UBOUND accessors, the fbc-int descriptor getter, and the
'' reset that dynamic local arrays get on scope entry. Eight entry points over
'' five fbc members.
''
'' LBOUND AND UBOUND DISAGREE ON PURPOSE FOR A MISSING DIMENSION. LBOUND gives
'' 0, UBOUND gives -1. That is not two different error conventions; it is one
'' convention, chosen so lbound > ubound identifies an unallocated array while
'' @array(lbound(array)) still computes an address rather than faulting. Return
'' -1 from both and every "is it allocated" test in FB silently inverts.
''
'' DIMENSION 0 IS NOT AN ERROR, it queries the dimension table itself.
'' LBOUND( a, 0 ) is always 1, even for an unallocated array -- it does not
'' consult the descriptor at all. UBOUND( a, 0 ) is the dimension count, but
'' ONLY when allocated, and 0 otherwise. So the two special cases are not
'' symmetric either, and the asymmetry is again what makes lbound > ubound
'' report "unallocated" at the dimTb level too.
''
'' fb_ArrayLen DIVIDES SIZE BY ELEMENT LENGTH; it does not multiply out the
'' dimension table. fbc changed this deliberately and left the old version in
'' a comment. The two disagree the moment size is not an exact multiple --
'' which is the case REDIM PRESERVE can produce.
''
'' fb_ArrayResetDesc CLEARS THE POINTERS BUT KEEPS element_len AND dimensions,
'' and masks flags down to the three that were fixed when the descriptor was
'' allocated. Those three are compile-time facts about the variable, not state;
'' clearing them loses the FIXED_DIM/FIXED_LEN decisions permanently and the
'' next REDIM then allocates the wrong shape.

#include once "inc/descriptors.ti"
#include once "inc/sysbind.ti"

'' NON-FBCALL: fb_array.h declares the two calc helpers plain.
extern "c"   '' NON-FBCALL: internal helpers, no FBCALL marker in fb_array.h.

'' Elements implied by a caller-supplied bound pair table. NOTE THE TABLE
'' FORMAT IS NOT dimTb: it is two flat arrays, lbound[] and ubound[], the shape
'' fb_ArrayRedimEx receives from its varargs.
function tkort_ArrayCalcElements alias "fb_hArrayCalcElements" _
	( byval dimensions as uinteger, byval lboundTB as integer ptr, _
	  byval uboundTB as integer ptr ) as uinteger

	'' WHILE, NOT FOR. dimensions is UNSIGNED, so `for i = 1 to dimensions-1`
	'' underflows to a near-infinite loop when dimensions is 0, where C's
	'' `i < dimensions` simply does not run. Every loop in this file is
	'' written as the C comparison for that reason.
	dim as uinteger i = 1
	dim as uinteger elements = (uboundTB[0] - lboundTB[0]) + 1
	while( i < dimensions )
		elements *= (uboundTB[i] - lboundTB[i]) + 1
		i += 1
	wend
	return elements
end function

'' The offset from base_ptr to index_ptr, negated. Folding every dimension's
'' lower bound into one displacement is what lets an indexed access be a plain
'' scaled add with no per-access bound subtraction.
function tkort_ArrayCalcDiff alias "fb_hArrayCalcDiff" _
	( byval dimensions as uinteger, byval lboundTB as integer ptr, _
	  byval uboundTB as integer ptr ) as integer

	dim as uinteger i = 0, elements = any
	dim as integer diff = 0

	'' dimensions is unsigned, so this is the `<= 0` test in the C.
	if( dimensions = 0 ) then return 0

	'' Again while, not for: dimensions - 1 is the unsigned bound, and
	'' `to dimensions - 2` would underflow for a one-dimensional array --
	'' the single most common case there is.
	while( i < dimensions - 1 )
		elements = (uboundTB[i+1] - lboundTB[i+1]) + 1
		diff = (diff + lboundTB[i]) * elements
		i += 1
	wend

	diff += lboundTB[dimensions - 1]
	return -diff
end function

end extern

extern "rtlib"

'' Elements, from the ALLOCATION, not the dimension table -- see the header.
function tkort_ArrayLen alias "fb_ArrayLen" ( byval array_ as FBARRAY ptr ) as uinteger
	if( array_ = 0 ) then return 0
	if( array_->base_ptr = 0 ) then return 0
	return array_->size \ array_->element_len
end function

function tkort_ArraySize alias "fb_ArraySize" ( byval array_ as FBARRAY ptr ) as uinteger
	if( array_ = 0 ) then return 0
	if( array_->base_ptr = 0 ) then return 0
	return array_->size
end function

'' The fbc-int accessor. It really is the identity: the point is that the
'' symbol exists so FB code can obtain a descriptor pointer without the
'' compiler having to expose the layout.
function tkort_ArrayGetDesc alias "fb_ArrayGetDesc" ( byval array_ as FBARRAY ptr ) as FBARRAY ptr
	return array_
end function

'' Dimension is 1-based on the way in; 0 queries the dimension table itself.
function tkort_ArrayLBound alias "fb_ArrayLBound" _
	( byval array_ as FBARRAY ptr, byval dimension as integer ) as integer

	dimension -= 1

	'' dimTb's own lbound. Answered WITHOUT touching the descriptor, so it
	'' holds for an unallocated array too.
	if( dimension = -1 ) then return 1

	'' 0, not -1, and deliberately different from UBOUND -- see the header.
	if( array_->index_ptr = 0 ) then return 0
	if( dimension < 0 ) then return 0
	if( cuint( dimension ) >= array_->dimensions ) then return 0

	return array_->dimTb(dimension).lbound_
end function

function tkort_ArrayUBound alias "fb_ArrayUBound" _
	( byval array_ as FBARRAY ptr, byval dimension as integer ) as integer

	dimension -= 1

	if( dimension = -1 ) then
		'' The dimension count IS known for an unallocated array, but
		'' fbc reports 0 there anyway, which is what puts it below
		'' LBOUND's constant 1 and marks the array unallocated.
		if( array_->index_ptr <> 0 ) then return cast( integer, array_->dimensions )
		return 0
	end if

	if( array_->index_ptr = 0 ) then return -1
	if( dimension < 0 ) then return -1
	if( cuint( dimension ) >= array_->dimensions ) then return -1

	return array_->dimTb(dimension).ubound_
end function

'' Scope-entry reset for a dynamic local array. element_len and dimensions
'' SURVIVE, and flags is masked down to the three compile-time bits.
sub tkort_ArrayResetDesc alias "fb_ArrayResetDesc" ( byval array_ as FBARRAY ptr )
	array_->index_ptr = 0
	array_->base_ptr = 0
	array_->size = 0
	'' element_len and dimensions are NOT cleared -- fbc leaves both
	'' assignments commented out, and they are the descriptor's shape.
	array_->flags and= (FBARRAY_FLAGS_DIMENSIONS or _
	                    FBARRAY_FLAGS_FIXED_DIM or _
	                    FBARRAY_FLAGS_FIXED_LEN)
	'' `dimensions` entries, never FB_MAXDIMENSIONS: the descriptor may have
	'' been allocated smaller than the declared dimTb.
	memset( @array_->dimTb(0), 0, array_->dimensions * sizeof( FBARRAYDIM ) )
end sub

end extern
