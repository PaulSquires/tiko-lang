'' concat.tiko -- ustr_concat.o: `a + b` and `a &= b`.
''
'' fb_UStrConcat WRITES INTO A TEMP DESCRIPTOR, and that is not incidental. The
'' temp bit is what lets the eventual fb_UStrAssign STEAL the buffer instead of
'' copying it; breaking that pairing is what turns `a = b + c + d` quadratic.
''
'' fb_UStrConcatAssign GROWS IN PLACE for a var-len destination, which is the
'' whole reason the allocator in src/ustr/core.tiko grows geometrically: keeping
'' the block while the text still fits is what makes appending in a loop
'' amortised O(1) rather than one realloc per pass.

#include once "inc/descriptors.ti"
#include once "inc/ustr.ti"
#include once "inc/ctx.ti"

#ifdef ENABLE_MT
	extern "rtlib"
		declare sub fb_StrLock alias "fb_StrLock" ( )
		declare sub fb_StrUnlock alias "fb_StrUnlock" ( )
	end extern
	#define STRLOCK()   fb_StrLock()
	#define STRUNLOCK() fb_StrUnlock()
#else
	#define STRLOCK()
	#define STRUNLOCK()
#endif

extern "rtlib"
	declare function tkrt_UAllocTempDesc alias "fb_hUStrAllocTempDesc" ( ) as FBUSTRING ptr
	declare function tkrt_UDelTempDesc alias "fb_hUStrDelTempDesc" ( byval s as FBUSTRING ptr ) as long
	declare function tkrt_UAllocTempNoLock alias "fb_hUStrAllocTemp_NoLock" _
		( byval s as FBUSTRING ptr, byval units as integer ) as FBUSTRING ptr
	declare function tkrt_UDelTempNoLock alias "fb_hUStrDelTemp_NoLock" _
		( byval s as FBUSTRING ptr ) as long
	declare sub tkrt_UDelete alias "fb_UStrDelete" ( byval s as FBUSTRING ptr )
	declare function tkrt_UAlloc alias "fb_hUStrAlloc" _
		( byval s as FBUSTRING ptr, byval units as integer ) as FBUSTRING ptr
	declare function tkrt_URealloc alias "fb_hUStrRealloc" _
		( byval s as FBUSTRING ptr, byval units as integer, byval k as long ) as FBUSTRING ptr
end extern

'' Release a var-len operand. EVERY entry point that takes one must do this:
'' LEN( a + b ) hands in a temporary built for the call and nothing else will
'' free it. On the narrow side the same omission leaked 1,000 blocks per 1,000
'' iterations while every output matched and every gate passed.
private sub hRelTemp( byval src as any ptr, byval src_size as integer )
	if( src_size = FB_USTRSIZEVARLEN ) then
		tkrt_UDelTempNoLock( cptr( FBUSTRING ptr, src ) )
	end if
end sub

extern "rtlib"

function tkort_UStrConcat alias "fb_UStrConcat" _
	( byval dst as FBUSTRING ptr, _
	  byval str1 as any ptr, byval str1_size as integer, _
	  byval str2 as any ptr, byval str2_size as integer ) as FBUSTRING ptr

	STRLOCK()

	dim as FB_UCHAR ptr p1 = any, p2 = any
	dim as integer l1 = any, l2 = any
	FB_USTRSETUP( str1, str1_size, p1, l1 )
	FB_USTRSETUP( str2, str2_size, p2, l2 )

	dst = tkrt_UAllocTempNoLock( dst, l1 + l2 )

	if( dst <> 0 ) then
		if( dst->data <> 0 ) then
			tkrt_UStrCopyN( dst->data, p1, l1 )
			'' NOT CopyN for the tail: this one terminates the result.
			tkrt_UStrCopy( dst->data + l1, p2, l2 )
		end if
	end if

	hRelTemp( str1, str1_size )
	hRelTemp( str2, str2_size )

	STRUNLOCK()
	return dst

end function

'' dst &= src.
function tkort_UStrConcatAssign alias "fb_UStrConcatAssign" _
	( byval dst as any ptr, byval dst_size as integer, _
	  byval src as any ptr, byval src_size as integer, _
	  byval fill_rem as long ) as any ptr

	STRLOCK()

	'' A NULL destination still CONSUMES the source.
	if( dst = 0 ) then
		hRelTemp( src, src_size )
		STRUNLOCK()
		return dst
	end if

	dim as FB_UCHAR ptr src_ptr = any
	dim as integer src_len = any
	FB_USTRSETUP( src, src_size, src_ptr, src_len )

	if( src_len > 0 ) then
		if( dst_size = FB_USTRSIZEVARLEN ) then
			dim as FBUSTRING ptr dstr = cptr( FBUSTRING ptr, dst )
			dim as integer dst_len = FB_USTRSIZE( dstr )

			'' keepdata TRUE -- the existing text has to survive the grow, and
			'' the mode also chooses the ALLOCATOR (src/ustr/core.tiko).
			if( tkrt_URealloc( dstr, dst_len + src_len, 1 ) <> 0 ) then
				tkrt_UStrCopy( dstr->data + dst_len, src_ptr, src_len )
			end if
		else
			'' Fixed-length or raw pointer: append up to the capacity, clamp.
			dim as FB_UCHAR ptr dst_ptr = cptr( FB_UCHAR ptr, dst )
			dim as integer cap = any

			if( (dst_size and FB_STRISFIXED) <> 0 ) then
				cap = dst_size and FB_STRSIZEMSK
			elseif( dst_size = 0 ) then
				'' A bare pointer carries no capacity, so there is nothing to
				'' clamp against and it is assumed large enough -- the same
				'' assumption C makes, and the same one the narrow side makes.
				cap = -1
			else
				cap = dst_size - 1
			end if

			dim as integer dst_len = tkrt_UStrLen( dst_ptr )

			if( cap >= 0 ) then
				dim as integer room = cap - dst_len
				if( room < 0 ) then room = 0
				if( src_len > room ) then src_len = room
			end if

			if( src_len > 0 ) then tkrt_UStrCopy( dst_ptr + dst_len, src_ptr, src_len )

			'' The fill starts ONE PAST the terminator hUStrCopy just wrote, and
			'' runs to the last usable index -- so the terminator survives and
			'' the tail behind it is zeroed. The +1 is deliberate, not an
			'' off-by-one.
			if( (fill_rem <> 0) andalso (cap >= 0) ) then
				dim as integer rem_ = cap - (dst_len + src_len)
				if( rem_ > 0 ) then tkrt_UStrFill( @dst_ptr[dst_len + src_len + 1], 0, rem_ )
			end if
		end if
	end if

	hRelTemp( src, src_size )

	STRUNLOCK()
	return dst

end function

end extern
