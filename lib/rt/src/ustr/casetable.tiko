'' Binary search over the runs. The tables are sorted and non-overlapping by
'' construction -- the generator walks the BMP in order -- so a miss means the
'' unit has no mapping and is returned unchanged.
private function hLookup _
	( byval tb as TKORT_UCASE_RUN ptr, byval n as integer, byval c as FB_UCHAR ) as FB_UCHAR

	dim as integer lo = 0, hi = n - 1

	while( lo <= hi )
		dim as integer mid_ = lo + ((hi - lo) shr 1)
		if( c < tb[mid_].lo ) then
			hi = mid_ - 1
		elseif( c > tb[mid_].hi ) then
			lo = mid_ + 1
		else
			'' The add is done in a WIDER signed type: delta can be negative and
			'' c is unsigned, so adding them at 16 bits would wrap before the cast.
			return cast( FB_UCHAR, cast( integer, c ) + tb[mid_].delta )
		end if
	wend

	return c

end function

#define TKORT_IS_SUR( c ) ( ((c) >= &hD800) andalso ((c) <= &hDFFF) )

extern "c"   '' NON-FBCALL: fb_ustring.h declares both without FBCALL.

function tkort_hUStrToUpper alias "fb_hUStrToUpper" ( byval c as FB_UCHAR ) as FB_UCHAR
	if( TKORT_IS_SUR( c ) ) then return c
	return hLookup( @tkort_ucase_upper(0), ubound( tkort_ucase_upper ) + 1, c )
end function

function tkort_hUStrToLower alias "fb_hUStrToLower" ( byval c as FB_UCHAR ) as FB_UCHAR
	if( TKORT_IS_SUR( c ) ) then return c
	return hLookup( @tkort_ucase_lower(0), ubound( tkort_ucase_lower ) + 1, c )
end function

end extern
