'' assign.tiko -- ustr_assign.o: fb_UStrAssignEx and its two thin callers.
''
'' TWO DELIBERATE DIFFERENCES FROM THE NARROW ASSIGN, and both are in the
'' fixed-length branch:
''
''   1. A fixed-length USTRING * N is NUL-TERMINATED and its remainder is
''      ZEROED, following WSTRING * N and ZSTRING * N. It does NOT space-pad the
''      way STRING * N does -- that padding is a QB-compatibility artifact and is
''      wrong for a Unicode text buffer. The trim helpers strip trailing NULs and
''      depend on this: leave stale units behind the terminator and TRIM of a
''      fixed ustring starts returning them.
''   2. There is no "fixed-len zstring vs zstring ptr" split, because a raw
''      FB_UCHAR PTR has only one meaning here.
''
'' THE TEMP-STEALING FAST PATH IS CARRIED OVER UNCHANGED AND MATTERS MOST. When
'' the source is a var-len TEMPORARY, its buffer is MOVED into the destination --
'' three field assignments and a descriptor release, no copy. Without it,
'' `a = b + c + d` copies the whole accumulating string at every step.

#include once "inc/descriptors.ti"
#include once "inc/ustr.ti"
#include once "inc/ctx.ti"

#ifdef ENABLE_MT
	extern "rtlib"
		declare sub fb_StrLock alias "fb_StrLock" ( )
		declare sub fb_StrUnlock alias "fb_StrUnlock" ( )
	end extern
	#define STRLOCK()   fb_StrLock()
	#define STRUNLOCK() fb_StrUnlock()
#else
	#define STRLOCK()
	#define STRUNLOCK()
#endif

extern "rtlib"
	declare function tkrt_UAllocTempDesc alias "fb_hUStrAllocTempDesc" ( ) as FBUSTRING ptr
	declare function tkrt_UDelTempDesc alias "fb_hUStrDelTempDesc" ( byval s as FBUSTRING ptr ) as long
	declare function tkrt_UAllocTempNoLock alias "fb_hUStrAllocTemp_NoLock" _
		( byval s as FBUSTRING ptr, byval units as integer ) as FBUSTRING ptr
	declare function tkrt_UDelTempNoLock alias "fb_hUStrDelTemp_NoLock" _
		( byval s as FBUSTRING ptr ) as long
	declare sub tkrt_UDelete alias "fb_UStrDelete" ( byval s as FBUSTRING ptr )
	declare function tkrt_UAlloc alias "fb_hUStrAlloc" _
		( byval s as FBUSTRING ptr, byval units as integer ) as FBUSTRING ptr
	declare function tkrt_URealloc alias "fb_hUStrRealloc" _
		( byval s as FBUSTRING ptr, byval units as integer, byval k as long ) as FBUSTRING ptr
end extern

'' Release a var-len operand. EVERY entry point that takes one must do this:
'' LEN( a + b ) hands in a temporary built for the call and nothing else will
'' free it. On the narrow side the same omission leaked 1,000 blocks per 1,000
'' iterations while every output matched and every gate passed.
private sub hRelTemp( byval src as any ptr, byval src_size as integer )
	if( src_size = FB_USTRSIZEVARLEN ) then
		tkrt_UDelTempNoLock( cptr( FBUSTRING ptr, src ) )
	end if
end sub

extern "rtlib"

function tkort_UStrAssignEx alias "fb_UStrAssignEx" _
	( byval dst as any ptr, byval dst_size as integer, _
	  byval src as any ptr, byval src_size as integer, _
	  byval fill_rem as long, byval is_init as long ) as any ptr

	STRLOCK()

	'' A NULL destination still CONSUMES the source.
	if( dst = 0 ) then
		hRelTemp( src, src_size )
		STRUNLOCK()
		return dst
	end if

	dim as FB_UCHAR ptr src_ptr = any
	dim as integer src_len = any
	FB_USTRSETUP( src, src_size, src_ptr, src_len )

	if( dst_size = FB_USTRSIZEVARLEN ) then

		dim as FBUSTRING ptr dstr = cptr( FBUSTRING ptr, dst )

		if( src_len = 0 ) then
			'' is_init decides whether there is anything valid to free. An
			'' initialising assignment reaches an UNINITIALISED descriptor --
			'' `dim as ustring u = ""` -- so calling UStrDelete there would be
			'' free() on whatever was on the stack. The narrow side crashed on
			'' exactly this and the symptom was that `dim as string a = "xy"`
			'' faulted while `dim as string a : a = "xy"` was fine.
			if( is_init = 0 ) then
				tkrt_UDelete( dstr )
			else
				dstr->data = 0
				dstr->len  = 0
				dstr->size = 0
			end if
		else
			dim as integer steal = 0
			if( src_size = FB_USTRSIZEVARLEN ) then
				if( FB_UISTEMP( src ) ) then steal = -1
			end if

			if( steal ) then
				'' MOVE, don't copy.
				if( is_init = 0 ) then tkrt_UDelete( dstr )

				dstr->data = src_ptr
				dstr->len  = src_len
				dstr->size = cptr( FBUSTRING ptr, src )->size

				'' Ownership has moved; leave nothing that could be freed twice.
				cptr( FBUSTRING ptr, src )->data = 0
				cptr( FBUSTRING ptr, src )->len  = 0
				cptr( FBUSTRING ptr, src )->size = 0

				'' DelTempDesc, not DelTemp: the data now belongs to dst, so only
				'' the descriptor goes back to the pool. Calling DelTemp here
				'' would free the buffer that was just handed over.
				tkrt_UDelTempDesc( cptr( FBUSTRING ptr, src ) )

				STRUNLOCK()
				return dst
			end if

			if( is_init = 0 ) then
				'' Only resize when the length actually differs -- the allocator
				'' has a shrink hysteresis and re-deciding it here would fight it.
				if( FB_USTRSIZE( dst ) <> src_len ) then
					tkrt_URealloc( dstr, src_len, 0 )
				end if
			else
				tkrt_UAlloc( dstr, src_len )
			end if

			if( dstr->data <> 0 ) then tkrt_UStrCopy( dstr->data, src_ptr, src_len )
		end if

	elseif( (dst_size and FB_STRISFIXED) <> 0 ) then

		'' USTRING * N. dst_size counts USABLE units, excluding the terminator;
		'' the buffer physically holds one more.
		dim as FB_UCHAR ptr dst_ptr = cptr( FB_UCHAR ptr, dst )
		dst_size and= FB_STRSIZEMSK

		if( src_len > dst_size ) then src_len = dst_size
		if( src_len > 0 ) then tkrt_UStrCopyN( dst_ptr, src_ptr, src_len )
		dst_ptr[src_len] = 0

		if( fill_rem <> 0 ) then
			dim as integer rem_ = dst_size - src_len
			if( rem_ > 0 ) then tkrt_UStrFill( @dst_ptr[src_len + 1], 0, rem_ )
		end if

	else

		'' A raw FB_UCHAR PTR.
		dim as FB_UCHAR ptr dst_ptr = cptr( FB_UCHAR ptr, dst )

		if( src_len = 0 ) then
			*dst_ptr = 0
		else
			'' dst_size = 0 means "no declared capacity", and as in C a bare
			'' pointer is then assumed large enough.
			if( dst_size = 0 ) then
				dst_size = src_len
			else
				dst_size -= 1                  '' less the terminator
				if( dst_size < src_len ) then src_len = dst_size
			end if
			tkrt_UStrCopy( dst_ptr, src_ptr, src_len )
		end if

		if( fill_rem <> 0 ) then
			dst_size -= src_len
			if( dst_size > 0 ) then tkrt_UStrFill( @dst_ptr[src_len], 0, dst_size )
		end if

	end if

	hRelTemp( src, src_size )

	STRUNLOCK()
	return dst

end function

function tkort_UStrAssign alias "fb_UStrAssign" _
	( byval dst as any ptr, byval dst_size as integer, _
	  byval src as any ptr, byval src_size as integer, byval fill_rem as long ) as any ptr
	return tkort_UStrAssignEx( dst, dst_size, src, src_size, fill_rem, 0 )
end function

function tkort_UStrInit alias "fb_UStrInit" _
	( byval dst as any ptr, byval dst_size as integer, _
	  byval src as any ptr, byval src_size as integer, byval fill_rem as long ) as any ptr
	return tkort_UStrAssignEx( dst, dst_size, src, src_size, fill_rem, 1 )
end function

end extern
