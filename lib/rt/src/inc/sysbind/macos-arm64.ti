'' macos-arm64.ti -- tiko-rt's C library binding for macos-arm64. HAND-DERIVED, not generated.
''
'' RFC-0001 sec. 4 (docs/tiko-macos): until tiko runs on the Mac (M6), lib/rt/build/genbind.sh
'' cannot import the macOS SDK's headers, and they may not be copied to Windows. So this is
'' linux-x86_64.ti with glibc's one layout taken out: every prototype here is ISO C or POSIX
'' and has the same C signature on Darwin arm64 (LP64; wchar_t is 4 bytes, measured; BSD's
'' struct tm has tm_gmtoff and tm_zone in glibc's order). glibc's __sFILE becomes Darwin's
'' opaque __sFILE: the runtime only ever holds a FILE ptr. Regenerate natively in M6 and diff.

#pragma once

#include once "crt/long.bi"

extern "C"   '' NON-FBCALL: the C library, not rtlib entry points.

type size_t as culong
type wchar_t as long
declare function atoi cdecl alias "atoi" ( byval __nptr as const zstring ptr ) as long
declare function strtod cdecl alias "strtod" ( byval __nptr as const zstring ptr, byval __endptr as zstring ptr ptr ) as double
declare function strtof cdecl alias "strtof" ( byval __nptr as const zstring ptr, byval __endptr as zstring ptr ptr ) as single
declare function strtol cdecl alias "strtol" ( byval __nptr as const zstring ptr, byval __endptr as zstring ptr ptr, byval __base as long ) as clong
declare function strtoul cdecl alias "strtoul" ( byval __nptr as const zstring ptr, byval __endptr as zstring ptr ptr, byval __base as long ) as culong
declare function strtoull cdecl alias "strtoull" ( byval __nptr as const zstring ptr, byval __endptr as zstring ptr ptr, byval __base as long ) as ulongint
type __off_t as clong
type __off64_t as clong
type __time_t as clong
type __ssize_t as clong
type ssize_t as __ssize_t
type time_t as __time_t
declare function rand cdecl alias "rand" (  ) as long
declare sub srand cdecl alias "srand" ( byval __seed as ulong )
declare function malloc cdecl alias "malloc" ( byval __size as size_t ) as any ptr
declare function calloc cdecl alias "calloc" ( byval __nmemb as size_t, byval __size as size_t ) as any ptr
declare function realloc cdecl alias "realloc" ( byval __ptr as any ptr, byval __size as size_t ) as any ptr
declare sub free cdecl alias "free" ( byval __ptr as any ptr )
declare function atexit cdecl alias "atexit" ( byval __func as sub cdecl(  ) ) as long
type __compar_fn_t as function cdecl( byval as const any ptr, byval as const any ptr ) as long
declare sub qsort cdecl alias "qsort" ( byval __base as any ptr, byval __nmemb as size_t, byval __size as size_t, byval __compar as __compar_fn_t )
declare function mbstowcs cdecl alias "mbstowcs" ( byval __pwcs as wstring ptr, byval __s as const zstring ptr, byval __n as size_t ) as size_t
declare function wcstombs cdecl alias "wcstombs" ( byval __s as zstring ptr, byval __pwcs as const wstring ptr, byval __n as size_t ) as size_t
declare function memcpy cdecl alias "memcpy" ( byval __dest as any ptr, byval __src as const any ptr, byval __n as size_t ) as any ptr
declare function memmove cdecl alias "memmove" ( byval __dest as any ptr, byval __src as const any ptr, byval __n as size_t ) as any ptr
declare function memset cdecl alias "memset" ( byval __s as any ptr, byval __c as long, byval __n as size_t ) as any ptr
declare function memcmp cdecl alias "memcmp" ( byval __s1 as const any ptr, byval __s2 as const any ptr, byval __n as size_t ) as long
declare function memchr cdecl alias "memchr" ( byval __s as const any ptr, byval __c as long, byval __n as size_t ) as any ptr
declare function strcpy cdecl alias "strcpy" ( byval __dest as zstring ptr, byval __src as const zstring ptr ) as zstring ptr
declare function strncpy cdecl alias "strncpy" ( byval __dest as zstring ptr, byval __src as const zstring ptr, byval __n as size_t ) as zstring ptr
declare function strcat cdecl alias "strcat" ( byval __dest as zstring ptr, byval __src as const zstring ptr ) as zstring ptr
declare function strncat cdecl alias "strncat" ( byval __dest as zstring ptr, byval __src as const zstring ptr, byval __n as size_t ) as zstring ptr
declare function strcmp cdecl alias "strcmp" ( byval __s1 as const zstring ptr, byval __s2 as const zstring ptr ) as long
declare function strncmp cdecl alias "strncmp" ( byval __s1 as const zstring ptr, byval __s2 as const zstring ptr, byval __n as size_t ) as long
declare function strchr cdecl alias "strchr" ( byval __s as const zstring ptr, byval __c as long ) as zstring ptr
declare function strrchr cdecl alias "strrchr" ( byval __s as const zstring ptr, byval __c as long ) as zstring ptr
declare function strpbrk cdecl alias "strpbrk" ( byval __s as const zstring ptr, byval __accept as const zstring ptr ) as zstring ptr
declare function strlen cdecl alias "strlen" ( byval __s as const zstring ptr ) as culong
'' Darwin's FILE is struct __sFILE; nothing in the runtime reads or sizes it, so it stays opaque.
type __sFILE extern "c"
	__opaque as ubyte
end type
declare function fclose cdecl alias "fclose" ( byval __stream as __sFILE ptr ) as long
declare function fflush cdecl alias "fflush" ( byval __stream as __sFILE ptr ) as long
declare function fopen cdecl alias "fopen" ( byval __filename as const zstring ptr, byval __modes as const zstring ptr ) as __sFILE ptr
declare function freopen cdecl alias "freopen" ( byval __filename as const zstring ptr, byval __modes as const zstring ptr, byval __stream as __sFILE ptr ) as __sFILE ptr
declare function setvbuf cdecl alias "setvbuf" ( byval __stream as __sFILE ptr, byval __buf as zstring ptr, byval __modes as long, byval __n as size_t ) as long
declare function fprintf cdecl alias "fprintf" ( byval __stream as __sFILE ptr, byval __format as const zstring ptr, ... ) as long
declare function sprintf cdecl alias "sprintf" ( byval __s as zstring ptr, byval __format as const zstring ptr, ... ) as long
declare function fgetc cdecl alias "fgetc" ( byval __stream as __sFILE ptr ) as long
declare function getc cdecl alias "getc" ( byval __stream as __sFILE ptr ) as long
declare function fputc cdecl alias "fputc" ( byval __c as long, byval __stream as __sFILE ptr ) as long
declare function putc cdecl alias "putc" ( byval __c as long, byval __stream as __sFILE ptr ) as long
declare function fgets cdecl alias "fgets" ( byval __s as zstring ptr, byval __n as long, byval __stream as __sFILE ptr ) as zstring ptr
declare function fputs cdecl alias "fputs" ( byval __s as const zstring ptr, byval __stream as __sFILE ptr ) as long
declare function ungetc cdecl alias "ungetc" ( byval __c as long, byval __stream as __sFILE ptr ) as long
declare function fread cdecl alias "fread" ( byval __ptr as any ptr, byval __size as size_t, byval __n as size_t, byval __stream as __sFILE ptr ) as culong
declare function fwrite cdecl alias "fwrite" ( byval __ptr as const any ptr, byval __size as size_t, byval __n as size_t, byval __s as __sFILE ptr ) as culong
declare function feof cdecl alias "feof" ( byval __stream as __sFILE ptr ) as long
declare function wcsncmp cdecl alias "wcsncmp" ( byval __s1 as const wstring ptr, byval __s2 as const wstring ptr, byval __n as size_t ) as long
declare function wcschr cdecl alias "wcschr" ( byval __wcs as const wstring ptr, byval __wc as wchar_t ) as long ptr
declare function wcscspn cdecl alias "wcscspn" ( byval __wcs as const wstring ptr, byval __reject as const wstring ptr ) as size_t
declare function wcsstr cdecl alias "wcsstr" ( byval __haystack as const wstring ptr, byval __needle as const wstring ptr ) as wstring ptr
declare function wcslen cdecl alias "wcslen" ( byval __s as const wstring ptr ) as culong
declare function islower cdecl alias "islower" ( byval as long ) as long
declare function isupper cdecl alias "isupper" ( byval as long ) as long
declare function tolower cdecl alias "tolower" ( byval __c as long ) as long
declare function toupper cdecl alias "toupper" ( byval __c as long ) as long
type tm extern "c"
	tm_sec as long
	tm_min as long
	tm_hour as long
	tm_mday as long
	tm_mon as long
	tm_year as long
	tm_wday as long
	tm_yday as long
	tm_isdst as long
	tm_gmtoff as clong
	tm_zone as const zstring ptr
end type
declare function time_ cdecl alias "time" ( byval __timer as time_t ptr ) as time_t
declare function localtime cdecl alias "localtime" ( byval __timer as const time_t ptr ) as tm ptr
declare function ctime cdecl alias "ctime" ( byval __timer as const time_t ptr ) as zstring ptr
declare function log10 cdecl alias "log10" ( byval __x as double ) as double
declare function modf cdecl alias "modf" ( byval __x as double, byval __iptr as double ptr ) as double
declare function pow cdecl alias "pow" ( byval __x as double, byval __y as double ) as double
declare function ceil cdecl alias "ceil" ( byval __x as double ) as double
declare function fabs cdecl alias "fabs" ( byval __x as double ) as double
declare function floor cdecl alias "floor" ( byval __x as double ) as double
declare function y1 cdecl alias "y1" ( byval as double ) as double
declare function rint cdecl alias "rint" ( byval __x as double ) as double
declare function write_ cdecl alias "write" ( byval __fd as long, byval __buf as const any ptr, byval __n as size_t ) as ssize_t
type FILE as __sFILE

end extern
