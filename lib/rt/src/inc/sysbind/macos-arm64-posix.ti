'' ---- time

type struct_timespec
    tv_sec as int64
    tv_nsec as int64
end type
#assert sizeof( struct_timespec ) = 16
#assert offsetof( struct_timespec, tv_sec ) = 0
#assert offsetof( struct_timespec, tv_nsec ) = 8
type struct_timeval
    tv_sec as int64
    tv_usec as int32
    __pad0( 0 to 3 ) as uint8
end type
#assert sizeof( struct_timeval ) = 16
