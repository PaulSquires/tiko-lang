type struct_kevent
    ident as uint64
    filter as int16
    flags as uint16
    fflags as uint32
    data as int64
    udata as any ptr
end type
#assert sizeof( struct_kevent ) = 32
#assert offsetof( struct_kevent, ident ) = 0
#assert offsetof( struct_kevent, filter ) = 8
#assert offsetof( struct_kevent, flags ) = 10
#assert offsetof( struct_kevent, fflags ) = 12
#assert offsetof( struct_kevent, data ) = 16
#assert offsetof( struct_kevent, udata ) = 24
type struct_msghdr
    msg_name as any ptr
    msg_namelen as uint32
    __pad0( 0 to 3 ) as uint8
    msg_iov as any ptr
    msg_iovlen as int32
    __pad1( 0 to 3 ) as uint8
    msg_control as any ptr
    msg_controllen as uint32
    msg_flags as int32
end type
#assert sizeof( struct_msghdr ) = 48
#assert offsetof( struct_msghdr, msg_name ) = 0
#assert offsetof( struct_msghdr, msg_namelen ) = 8
#assert offsetof( struct_msghdr, msg_iov ) = 16
#assert offsetof( struct_msghdr, msg_iovlen ) = 24
#assert offsetof( struct_msghdr, msg_control ) = 32
#assert offsetof( struct_msghdr, msg_controllen ) = 40
#assert offsetof( struct_msghdr, msg_flags ) = 44
type struct_statfs
    __pad0( 0 to 63 ) as uint8
    f_flags as uint32
    __pad1( 0 to 3 ) as uint8
    f_fstypename as zstring * 16
    f_mntonname as zstring * 1024
    f_mntfromname as zstring * 1024
    __pad2( 0 to 31 ) as uint8
end type
#assert sizeof( struct_statfs ) = 2168
#assert offsetof( struct_statfs, f_flags ) = 64
#assert offsetof( struct_statfs, f_fstypename ) = 72
#assert offsetof( struct_statfs, f_mntonname ) = 88
#assert offsetof( struct_statfs, f_mntfromname ) = 1112

end namespace
