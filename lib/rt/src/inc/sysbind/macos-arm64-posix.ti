'' ---- sockets

type struct_in_addr
    s_addr as uint32
end type
#assert sizeof( struct_in_addr ) = 4
#assert offsetof( struct_in_addr, s_addr ) = 0
type struct_in6_addr
    s6_addr( 0 to 15 ) as uint8
end type
#assert sizeof( struct_in6_addr ) = 16
#assert offsetof( struct_in6_addr, s6_addr ) = 0
type struct_sockaddr
    sa_len as uint8
    sa_family as uint8
    __pad0( 0 to 13 ) as uint8
end type
#assert sizeof( struct_sockaddr ) = 16
#assert offsetof( struct_sockaddr, sa_len ) = 0
#assert offsetof( struct_sockaddr, sa_family ) = 1
type struct_sockaddr_in
    sin_len as uint8
    sin_family as uint8
    sin_port as uint16
    sin_addr as struct_in_addr
    __pad0( 0 to 7 ) as uint8
end type
#assert sizeof( struct_sockaddr_in ) = 16
#assert offsetof( struct_sockaddr_in, sin_len ) = 0
#assert offsetof( struct_sockaddr_in, sin_family ) = 1
#assert offsetof( struct_sockaddr_in, sin_port ) = 2
#assert offsetof( struct_sockaddr_in, sin_addr ) = 4
type struct_sockaddr_in6
    sin6_len as uint8
    sin6_family as uint8
    sin6_port as uint16
    sin6_flowinfo as uint32
    sin6_addr as struct_in6_addr
    sin6_scope_id as uint32
end type
#assert sizeof( struct_sockaddr_in6 ) = 28
#assert offsetof( struct_sockaddr_in6, sin6_len ) = 0
#assert offsetof( struct_sockaddr_in6, sin6_family ) = 1
#assert offsetof( struct_sockaddr_in6, sin6_port ) = 2
#assert offsetof( struct_sockaddr_in6, sin6_flowinfo ) = 4
#assert offsetof( struct_sockaddr_in6, sin6_addr ) = 8
#assert offsetof( struct_sockaddr_in6, sin6_scope_id ) = 24
type struct_sockaddr_un
    sun_len as uint8
    sun_family as uint8
    sun_path as zstring * 104
end type
#assert sizeof( struct_sockaddr_un ) = 106
#assert offsetof( struct_sockaddr_un, sun_len ) = 0
#assert offsetof( struct_sockaddr_un, sun_family ) = 1
#assert offsetof( struct_sockaddr_un, sun_path ) = 2
type struct_sockaddr_storage
    ss_len as uint8
    ss_family as uint8
    __pad0( 0 to 125 ) as uint8
end type
#assert sizeof( struct_sockaddr_storage ) = 128
#assert offsetof( struct_sockaddr_storage, ss_len ) = 0
#assert offsetof( struct_sockaddr_storage, ss_family ) = 1
type struct_addrinfo
    ai_flags as int32
    ai_family as int32
    ai_socktype as int32
    ai_protocol as int32
    ai_addrlen as uint32
    __pad0( 0 to 3 ) as uint8
    ai_canonname as zstring ptr
    ai_addr as any ptr
    ai_next as any ptr
end type
#assert sizeof( struct_addrinfo ) = 48
#assert offsetof( struct_addrinfo, ai_flags ) = 0
#assert offsetof( struct_addrinfo, ai_family ) = 4
#assert offsetof( struct_addrinfo, ai_socktype ) = 8
#assert offsetof( struct_addrinfo, ai_protocol ) = 12
#assert offsetof( struct_addrinfo, ai_addrlen ) = 16
#assert offsetof( struct_addrinfo, ai_canonname ) = 24
#assert offsetof( struct_addrinfo, ai_addr ) = 32
#assert offsetof( struct_addrinfo, ai_next ) = 40
type struct_linger
    l_onoff as int32
    l_linger as int32
end type
#assert sizeof( struct_linger ) = 8
#assert offsetof( struct_linger, l_onoff ) = 0
#assert offsetof( struct_linger, l_linger ) = 4
