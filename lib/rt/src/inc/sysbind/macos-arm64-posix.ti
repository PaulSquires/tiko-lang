type nfds_t as uint32
type tcflag_t as uint64
type speed_t as uint64
type cc_t as uint8
type rlim_t as uint64
type pthread_t as any ptr
type pthread_key_t as uint64

'' ---- opaque types: size and alignment only

type sigset_t
    __opaque( 0 to 0 ) as uint32
end type
#assert sizeof( sigset_t ) = 4
type pthread_mutex_t
    __opaque( 0 to 7 ) as uint64
end type
#assert sizeof( pthread_mutex_t ) = 64
type pthread_mutexattr_t
    __opaque( 0 to 1 ) as uint64
end type
#assert sizeof( pthread_mutexattr_t ) = 16
type pthread_cond_t
    __opaque( 0 to 5 ) as uint64
end type
#assert sizeof( pthread_cond_t ) = 48
type pthread_condattr_t
    __opaque( 0 to 1 ) as uint64
end type
#assert sizeof( pthread_condattr_t ) = 16
type pthread_attr_t
    __opaque( 0 to 7 ) as uint64
end type
#assert sizeof( pthread_attr_t ) = 64
type pthread_once_t
    __opaque( 0 to 1 ) as uint64
end type
#assert sizeof( pthread_once_t ) = 16
type jmp_buf
    __opaque( 0 to 47 ) as uint32
end type
#assert sizeof( jmp_buf ) = 192
type fd_set
    __opaque( 0 to 31 ) as uint32
end type
#assert sizeof( fd_set ) = 128
type fenv_t
    __opaque( 0 to 1 ) as uint64
end type
#assert sizeof( fenv_t ) = 16
type posix_spawn_file_actions_t
    __opaque( 0 to 0 ) as uint64
end type
#assert sizeof( posix_spawn_file_actions_t ) = 8
type posix_spawnattr_t
    __opaque( 0 to 0 ) as uint64
end type
#assert sizeof( posix_spawnattr_t ) = 8
