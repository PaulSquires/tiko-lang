#ifndef __TKORT_DESCRIPTORS_BI__
#define __TKORT_DESCRIPTORS_BI__

'' descriptors.ti -- the layouts fbc-generated code shares with the runtime.
''
'' Byte-identical is not a goal here, it is the contract: fbc hardcodes these
'' sizes when it lays out a stack frame, so a descriptor that is one field wider
'' than fbc believes makes every local after it the wrong variable.
''
'' Source: fb_string.h, fb_ustring.h, fb_array.h, fb_error.h and fb.h, plus
'' fbc-int/{string,array}.bi. Documented in docs/tiko-rt/RFC-0002 section 3.
'' No .c body was opened (PROVENANCE.md).

#include once "inc/config.ti"
#include once "sys/sys.ti"

'' ============================================================== FBSTRING
''
'' 12 bytes on 32-bit, 24 on 64-bit.
''
'' `len` CARRIES FB_TEMPSTRBIT IN ITS SIGN BIT. Reading it raw looks correct
'' until a temporary descriptor reaches the code, and on some paths a temporary
'' never appears in testing -- which is how this becomes a bug found by a user.
'' Use FB_STRSIZE.

type FBSTRING field = 1
	as zstring ptr  data      '' the characters
	as integer      len       '' length, with the temp flag in the sign bit
	as integer      size      '' size of the allocated block
end type

'' ============================================================= FBUSTRING
''
'' Same shape, different unit. len and size count UTF-16 CODE UNITS, not bytes.
'' FBSTRING gets away with byte == char; here the two differ by a factor of two,
'' and one misplaced `* 2` is heap corruption.
''
'' FB_UCHAR is USHORT on EVERY target -- deliberately not wchar_t, which is
'' 2 bytes on Windows and 4 on Linux.

type FB_UCHAR as uint16

type FBUSTRING field = 1
	as FB_UCHAR ptr data      '' the code units
	as integer      len       '' length in CODE UNITS, temp flag in the sign bit
	as integer      size      '' allocated CODE UNITS, excluding the terminator
end type

'' ================================================================ FBARRAY
''
'' fb_array.h names the first two fields `data` and `ptr`; fbc-int/array.bi
'' names the same offsets `index_ptr` and `base_ptr`. The FreeBASIC names are
'' used here. fb_array.h notes that the first field MUST be at offset 0.

type FBARRAYDIM field = 1
	as uinteger elements
	as integer  lbound_
	as integer  ubound_
end type

const FBARRAY_FLAGS_DIMENSIONS as uinteger = &h0000000f  '' entries ALLOCATED in dimTb
const FBARRAY_FLAGS_FIXED_DIM  as uinteger = &h00000010
const FBARRAY_FLAGS_FIXED_LEN  as uinteger = &h00000020
const FBARRAY_FLAGS_RESERVED   as uinteger = &hffffffc0

'' NOTE ON dimTb: fb_array.h declares it [1] and fbc-int/array.bi declares it
'' (0 to FB_MAXDIMENSIONS-1). NEITHER is the allocation. fbc may allocate a
'' SMALLER descriptor with fewer than 8 entries when the dimension count is
'' known at compile time, so code must respect `dimensions` and never
'' FB_MAXDIMENSIONS. tiko-rt must reproduce the allocation behaviour too,
'' because the descriptor's size is observable through sizeof on a UDT that
'' contains an array.
type FBARRAY field = 1
	as any ptr   index_ptr    '' @array(0,0,...) -- "data" in fb_array.h, offset 0
	as any ptr   base_ptr     '' lowest-bound address -- "ptr" in fb_array.h
	as uinteger  size         '' byte size of allocated contents
	as uinteger  element_len  '' byte size of one element
	as uinteger  dimensions
	as uinteger  flags
	as FBARRAYDIM dimTb(0 to FB_MAXDIMENSIONS - 1)
end type

'' ========================================================== internal lists
''
'' The temp-descriptor pool is an intrusive free list of fixed capacity
'' (FB_STR_TMPDESCRIPTORS = 256), not a general allocator. Its exhaustion
'' behaviour is part of the contract.

'' A type may reference ITSELF by pointer inside its own body; a `type X as X`
'' forward declaration ahead of the definition is error 4, not a courtesy.
type FB_LISTELEM field = 1
	as FB_LISTELEM ptr prev
	as FB_LISTELEM ptr next
end type

type FB_LIST field = 1
	as int32             cnt      '' C int, not integer -- this one really is 32-bit
	as FB_LISTELEM ptr  head
	as FB_LISTELEM ptr  tail
	as FB_LISTELEM ptr  fhead    '' first free element
end type

type FB_STR_TMPDESC field = 1
	as FB_LISTELEM elem
	as FBSTRING    desc
end type

type FB_USTR_TMPDESC field = 1
	as FB_LISTELEM elem
	as FBUSTRING   desc
end type

'' ============================================================== error state

type FB_ERRHANDLER as sub( )

type FB_ERRORCTX field = 1
	as FB_ERRHANDLER handler
	as int32          err_num     '' C int
	as int32          line_num    '' C int
	as zstring ptr   mod_name
	as zstring ptr   fun_name
	as any ptr       res_lbl
	as any ptr       resnxt_lbl
	'' THE NON-LOCAL JUMP'S LANDING PAD. ON ERROR GOTO installs a handler in one
	'' procedure and the throw may be in another; LLVM cannot branch across
	'' functions, so the compiler setjmps HERE and fb_ErrorThrowMsg longjmps into
	'' it -- src/c/errjmp.c, and the compiler's LowerOnError_.
	''
	'' IN THE CONTEXT rather than in C, because a '__declspec(thread)' in the
	'' archive wants '_tls_index' and tiko links no CRT startup to define it. The
	'' context is already per thread, which is the property the buffer needs.
	''
	'' OVER-SIZED AND HAND-ALIGNED: 528 bytes against Windows x64's 256-byte
	'' jmp_buf and glibc's 200, and fb_ErrorJmpBuf rounds the address up to 16
	'' because this type is 'field = 1' and setjmp saves xmm registers.
	as int32          jmp_armed
	as uint8         jmp_raw(0 to 527)
end type

'' ================================================================== macros
''
'' #macro, not a procedure, and not by preference: fbc has no inliner, so a
'' one-line helper called from 65 string entry points is 65 real calls.
'' RFC-0003 section 5.2, RFC-0004 section 3.3.

#define FB_ISTEMP( s )   ( (cptr( FBSTRING ptr, s )->len and FB_TEMPSTRBIT) <> 0 )
#define FB_STRSIZE( s )  ( cptr( FBSTRING ptr, s )->len and (not FB_TEMPSTRBIT) )

#define FB_UISTEMP( s )  ( (cptr( FBUSTRING ptr, s )->len and FB_TEMPSTRBIT) <> 0 )
#define FB_USTRSIZE( s ) ( cptr( FBUSTRING ptr, s )->len and (not FB_TEMPSTRBIT) )

'' Set a length WITHOUT disturbing the temp flag. The flag lives in the field
'' being written, so a plain assignment silently clears it.
#macro FB_STRSETLEN( s, newlen )
	cptr( FBSTRING ptr, s )->len = _
		((newlen) and (not FB_TEMPSTRBIT)) or (cptr( FBSTRING ptr, s )->len and FB_TEMPSTRBIT)
#endmacro

#macro FB_USTRSETLEN( s, newlen )
	cptr( FBUSTRING ptr, s )->len = _
		((newlen) and (not FB_TEMPSTRBIT)) or (cptr( FBUSTRING ptr, s )->len and FB_TEMPSTRBIT)
#endmacro

'' ------------------------------------------------------ the four arg forms
''
'' Every string entry point takes (s, size) and must decode four cases. This is
'' the most-repeated logic in the whole string library and one wrong branch is
'' silent corruption. RFC-0002 section 4.
''
''   size = FB_STRSIZEVARLEN (-1)   var-len STRING, s is a descriptor
''   size and FB_STRISFIXED         fixed-len STRING * N
''   size = 0                       ZSTRING PTR, length unknown
''   otherwise                      fixed-len ZSTRING * N
''
'' FIX and DYN DIFFER IN EXACTLY ONE BRANCH -- the last. FIX measures with
'' strlen; DYN takes size - 1, the declared size without the terminating NUL.
'' Which one an entry point uses is part of ITS contract, and the header is the
'' only place that records it: do not choose by taste.

#macro FB_STRSETUP_FIX( s, sz, ptr_, len_ )
	if( (s) = nullptr ) then
		ptr_ = nullptr : len_ = 0
	elseif( (sz) = FB_STRSIZEVARLEN ) then
		ptr_ = cptr( FBSTRING ptr, s )->data : len_ = FB_STRSIZE( s )
	elseif( ((sz) and FB_STRISFIXED) <> 0 ) then
		ptr_ = cptr( zstring ptr, s ) : len_ = (sz) and FB_STRSIZEMSK
	else
		'' BOTH remaining cases measure with strlen. This is what makes FIX
		'' differ from DYN, and it is not a typo.
		ptr_ = cptr( zstring ptr, s ) : len_ = strlen( cptr( zstring ptr, s ) )
	end if
#endmacro

#macro FB_STRSETUP_DYN( s, sz, ptr_, len_ )
	if( (s) = nullptr ) then
		ptr_ = nullptr : len_ = 0
	elseif( (sz) = FB_STRSIZEVARLEN ) then
		ptr_ = cptr( FBSTRING ptr, s )->data : len_ = FB_STRSIZE( s )
	elseif( ((sz) and FB_STRISFIXED) <> 0 ) then
		ptr_ = cptr( zstring ptr, s ) : len_ = (sz) and FB_STRSIZEMSK
	elseif( (sz) = 0 ) then
		ptr_ = cptr( zstring ptr, s ) : len_ = strlen( cptr( zstring ptr, s ) )
	else
		'' fixed-len ZSTRING * N: the DECLARED size, less the terminator.
		ptr_ = cptr( zstring ptr, s ) : len_ = (sz) - 1
	end if
#endmacro

'' ============================================================== invariants
''
'' fbc hardcodes the descriptor sizes when laying out a stack frame. If any of
'' these is false, every string variable in every compiled program is the wrong
'' size, and nothing else in this library matters.

#assert sizeof( FBSTRING )   = 3 * sizeof( any ptr )
#assert sizeof( FBUSTRING )  = 3 * sizeof( any ptr )
#assert sizeof( FB_UCHAR )   = 2                      '' a code unit, on EVERY target
#assert sizeof( FBARRAYDIM ) = 3 * sizeof( integer )
#assert offsetof( FBSTRING, data ) = 0
#assert offsetof( FBARRAY, index_ptr ) = 0            '' fb_array.h: must be at 0

#endif '' __TKORT_DESCRIPTORS_BI__
