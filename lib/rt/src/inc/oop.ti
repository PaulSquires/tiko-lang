#ifndef __TKORT_OOP_BI__
#define __TKORT_OOP_BI__

'' oop.ti -- the three OBJECT layouts, taken from fb_oop.h.
''
'' A header is the permitted source for a layout (PROVENANCE.md R2), and these
'' three are pointers only, so there is nothing target-dependent in them: every
'' field is one pointer wide on both remaining targets.
''
'' 'stdlistVT' and 'nullPtr' are never read here. They are present because their
'' SIZE is: pRTTI sits one pointer into the vtable header, and the vptr a
'' constructor stores is biased past that header, so dropping either field would
'' move both and every IS test would read the wrong word.

type TKORT_RTTI
	as any ptr        stdlistVT
	as zstring ptr    id
	as TKORT_RTTI ptr pRTTIBase
end type

type TKORT_BASEVT
	as any ptr        nullPtr
	as TKORT_RTTI ptr pRTTI
end type

type TKORT_OBJECT
	as TKORT_BASEVT ptr pVT
end type

'' INTERFACES (docs/tiko-interfaces/TIKO_INTERFACE_OOP_DESIGN.md §9). The compiler emits these as
'' pointer tables, internal to each unit:
''
''   interface descriptor   { id }                    the interface's mangled name, as an RTTI id
''   class descriptor       { rtti, vptrFlag, iface0, itab0, iface1, itab1, ..., null, null }
''
'' 'vptrFlag' is non-null when the class has a vptr, so the object's own vtable -- word 0,
'' 'nullPtr', is the DYNAMIC type's class descriptor -- is the one to ask. An itable carries its
'' class descriptor at itab[-1]; every 'itab' here is biased, as a stored vptr is, to slot 0.
type TKORT_IFACEDESC
	as zstring ptr    id
end type

type TKORT_CLASSDESC
	as TKORT_RTTI ptr rtti
	as any ptr        vptrFlag
	'' then the map: (TKORT_IFACEDESC ptr, itab) pairs, ended by a null pair
end type

#endif '' __TKORT_OOP_BI__
