'' fsdefs.ti -- the filesystem module's shared layouts and constants.
''
'' EXTRACTED BECAUSE THEY WERE ABOUT TO BE COPIED A FOURTH TIME. FB_FSINFO,
'' FB_FSDIRENT, FB_FSVOLUME and FB_FSCHANGE cross the ABI in both directions:
'' the FB layer allocates them by the size fb_FsSizeof* reports, and the C side
'' fills them in. Every duplicate is a place the two can drift apart silently,
'' and fbc's own filesystem.fsinfo_dir suite only cross-checks the sizeof --
'' which a field of the WRONG TYPE at the RIGHT offset would still pass.
''
'' THESE STRUCTS ARE NOT BYTE-PACKED. They mirror what the C compiler laid out,
'' and `field = 1` here would change every sizeof the hooks report -- which is
'' precisely the drift the hooks exist to catch.

#pragma once

#include once "inc/descriptors.ti"

const FB_FS_MAXNAME = 260
const FB_FS_MAXPATH = 512

'' A cursor that has run out. NOT an error: the enumeration APIs return it as
'' their ordinary end condition, which is why it is negative and outside the
'' FB_FS_* code range.
const FB_FS_EXHAUSTED = -1

const FB_FSKIND_NONE  = 0
const FB_FSKIND_FILE  = 1
const FB_FSKIND_DIR   = 2
const FB_FSKIND_LINK  = 3
const FB_FSKIND_OTHER = 4

const FB_FSFLAG_READONLY  = 1
const FB_FSFLAG_HIDDEN    = 2
const FB_FSFLAG_HAS_CTIME = 4
const FB_FSFLAG_HAS_ATIME = 8

const FB_FSVOL_READONLY = 1
const FB_FSVOL_CASESENS = 2
const FB_FSVOL_LINKS    = 4

const FB_FSCHANGE_CREATED      = 0
const FB_FSCHANGE_DELETED      = 1
const FB_FSCHANGE_MODIFIED     = 2
const FB_FSCHANGE_RENAMED_FROM = 3
const FB_FSCHANGE_RENAMED_TO   = 4
'' Events were DROPPED and the consumer must rescan. An EVENT rather than an
'' error, because a caller that ignores errors would silently miss the rescan.
const FB_FSCHANGE_OVERFLOW     = 5

'' 0001-01-01 to 1601-01-01 and to 1970-01-01, in 100 ns ticks.
const FB_FS_TICKS_TO_FILETIME   = 504911232000000000ll
const FB_FS_TICKS_TO_UNIX_EPOCH = 621355968000000000ll

type FB_FSINFO
	as ulongint  size_
	as longint   mtime, ctime, atime      '' ticks; 0 when absent
	as ulong     native_attrs             '' dwFileAttributes / st_mode
	as long      kind                     '' FB_FSKIND_*
	as long      flags                    '' FB_FSFLAG_*
end type

type FB_FSDIRENT
	as FB_UCHAR  name( 0 to FB_FS_MAXNAME - 1 )
	as long      namelen
	as long      kind
	as long      has_info
	as FB_FSINFO info
end type

type FB_FSVOLUME
	as FB_UCHAR  root( 0 to FB_FS_MAXPATH - 1 )
	as FB_UCHAR  name( 0 to FB_FS_MAXNAME - 1 )
	as FB_UCHAR  fstype( 0 to FB_FS_MAXNAME - 1 )
	as long      rootlen, namelen, fstypelen
	as ulong     maxcomp
	as long      flags
end type

type FB_FSCHANGE
	as FB_UCHAR  path( 0 to FB_FS_MAXPATH - 1 )
	as long      pathlen
	as long      kind
end type

type FB_FSSPACE
	as ulongint  total          '' capacity of the volume
	as ulongint  freebytes      '' free, IGNORING quota
	as ulongint  avail          '' free TO THIS USER, honouring quota
end type
