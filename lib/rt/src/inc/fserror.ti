'' fserror.ti -- the FB_FS_* result codes.
''
'' CROSS-CHECKED, ONE ASSERTION PER CODE, by fbc's own filesystem.error suite,
'' because a silent divergence here would be total and invisible: every
'' filesystem entry point returns one of these and nothing else would fail.

#pragma once

const FB_FS_OK              = 0
const FB_FS_NOT_FOUND       = 1
const FB_FS_ACCESS_DENIED   = 2
const FB_FS_ALREADY_EXISTS  = 3
const FB_FS_NOT_A_DIRECTORY = 4
const FB_FS_IS_A_DIRECTORY  = 5
const FB_FS_DIR_NOT_EMPTY   = 6
const FB_FS_INVALID_PATH    = 7
const FB_FS_NAME_TOO_LONG   = 8
const FB_FS_LOOP            = 9
const FB_FS_NO_SPACE        = 10
const FB_FS_READ_ONLY       = 11
const FB_FS_IN_USE          = 12
const FB_FS_CROSS_DEVICE    = 13
const FB_FS_INTERRUPTED     = 14
const FB_FS_UNSUPPORTED     = 15
const FB_FS_UNKNOWN         = 16

'' APPENDED, never inserted (C:\dev\docs\tiko-fs\RFC-0001 section 4): every value above
'' stays what it was, so a stored code and the message table's order both survive.
const FB_FS_CLOSED           = 17
const FB_FS_UNEXPECTED_EOF   = 18
const FB_FS_NOT_SEEKABLE     = 19
const FB_FS_INVALID_DATA     = 20
const FB_FS_TOO_LARGE        = 21
const FB_FS_WOULD_BLOCK      = 22
const FB_FS_TOO_MANY_LINKS   = 23
const FB_FS_BROKEN_PIPE      = 24
const FB_FS_INVALID_ARGUMENT = 25
const FB_FS_CODE_MAX         = FB_FS_INVALID_ARGUMENT
