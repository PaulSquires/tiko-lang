'' core.tiko -- fb_ThreadCreate and fb_ThreadWait. Two entry points over one fbc
'' member, split by platform.
''
'' _beginthreadex, NOT CreateThread, ON MINGW. The CRT keeps per-thread state --
'' errno, strtok's cursor, the locale conversion buffers -- and a thread started
'' with CreateThread never gets it allocated or released. It works right up until
'' something in the runtime touches errno on a worker, which is most of the
'' filesystem layer. fbc chooses _beginthreadex under HOST_MINGW for exactly this
'' reason and tiko-rt's Windows targets are all MinGW.
''
'' THE FBTHREAD IS FREED BY WHICHEVER OF EXIT AND DETACH HAPPENS SECOND, and
'' that is the only reason fb_AtomicSetThreadFlags exists. threadproc sets
'' EXITED and frees the structure if DETACHED was already set; fb_ThreadDetach
'' sets DETACHED and frees it if EXITED was already set. Both read the value the
'' flags held BEFORE their own bit went in, so exactly one of them sees the other
'' -- a plain "if( flags & X )" after a separate store would let both see it or
'' neither.
''
'' THE PROXY IS NOT OPTIONAL. It is what sets the thread's own FBTHREAD self
'' pointer before the user's proc runs, and what tears the TLS table down after
'' it returns. A user proc handed straight to the OS would leak every per-thread
'' block the runtime allocated for it.
''
'' fb_ThreadWait REFUSES three cases and returns instead of blocking forever:
'' the main thread, a detached thread, and the calling thread itself. Each of
'' those waits can never be satisfied.

#include once "inc/thread.ti"
#include once "inc/sysbind.ti"

type FB_THREADPROC as sub cdecl ( byval param as any ptr )

type FBTHREADINFO
	as FB_THREADPROC proc_
	as any ptr       param
	as FBTHREAD ptr  thread
end type

#if defined( __FB_WIN32__ ) or defined( __FB_WIN64__ )

extern "c"   '' NON-FBCALL: the msvcrt thread starter, not an rtlib entry point.
	declare function c_beginthreadex alias "_beginthreadex" _
		( byval sec as any ptr, byval stack as uint32, byval proc_ as any ptr, _
		  byval arg as any ptr, byval flags as uint32, byval tid as uint32 ptr ) as uinteger
end extern

'' The proxy. stdcall, because that is what _beginthreadex expects on win32 and
'' what WINAPI expands to; on win64 the convention is the same for every call so
'' the annotation is free.
private function hThreadProc stdcall ( byval param as any ptr ) as uint32
	dim as FBTHREADINFO ptr info = param
	dim as FBTHREAD ptr thread = info->thread
	dim as FB_FBTHREADCTX ptr ctx = any
	dim as int32 flags = any

	ctx = TKORT_TLSGET_FBTHREAD()
	if( ctx <> nullptr ) then ctx->self_ = thread

	info->proc_( info->param )
	free( info )

	fb_TlsFreeCtxTb( )

	flags = fb_AtomicSetThreadFlags( @thread->flags, FBTHREAD_EXITED )

	'' already detached: nobody will ever wait on this, so free it here
	if( (flags and FBTHREAD_DETACHED) <> 0 ) then free( thread )

	return 1
end function

extern "rtlib"

function tkort_ThreadCreate alias "fb_ThreadCreate" _
	( byval proc_ as FB_THREADPROC, byval param as any ptr, byval stack_size as integer ) as FBTHREAD ptr

	dim as FBTHREAD ptr thread = any
	dim as FBTHREADINFO ptr info = any
	dim as uint32 thrdaddr = any

	thread = malloc( sizeof( FBTHREAD ) )
	if( thread = nullptr ) then return nullptr

	info = malloc( sizeof( FBTHREADINFO ) )
	if( info = nullptr ) then
		free( thread )
		return nullptr
	end if

	info->proc_ = proc_
	info->param = param
	info->thread = thread
	thread->flags = 0

	'' The last argument cannot be NULL or the call fails on Windows 9x, which
	'' is why fbc passes a scratch variable it never reads.
	thread->id = cast( any ptr, c_beginthreadex( nullptr, cast( uint32, stack_size ), _
		cast( any ptr, @hThreadProc ), info, 0, @thrdaddr ) )

	if( thread->id = nullptr ) then
		free( thread )
		free( info )
		return nullptr
	end if

	return thread
end function

sub tkort_ThreadWait alias "fb_ThreadWait" ( byval thread as FBTHREAD ptr )
	dim as FB_FBTHREADCTX ptr ctx = any

	if( thread = nullptr ) then exit sub
	if( (thread->flags and (FBTHREAD_MAIN or FBTHREAD_DETACHED)) <> 0 ) then exit sub

	ctx = TKORT_TLSGET_FBTHREAD()
	if( ctx <> nullptr ) then
		if( thread = ctx->self_ ) then exit sub
	end if

	w_WaitForSingleObject( thread->id, INFINITE_ )

	'' Never forget to close the handle, or the system keeps a zombie thread.
	w_CloseHandle( thread->id )

	free( thread )
end sub

end extern

#else

'' The proxy returns a pointer because that is pthread_create's signature; the
'' value is never read.
private function hThreadProc cdecl ( byval param as any ptr ) as any ptr
	dim as FBTHREADINFO ptr info = param
	dim as FBTHREAD ptr thread = info->thread
	dim as FB_FBTHREADCTX ptr ctx = any
	dim as int32 flags = any

	ctx = TKORT_TLSGET_FBTHREAD()
	if( ctx <> nullptr ) then ctx->self_ = thread

	info->proc_( info->param )
	free( info )

	fb_TlsFreeCtxTb( )

	flags = fb_AtomicSetThreadFlags( @thread->flags, FBTHREAD_EXITED )

	if( (flags and FBTHREAD_DETACHED) <> 0 ) then free( thread )

	'' NOT NULL: a POSIX thread whose start routine returns NULL is treated by
	'' some runtimes as a request to exit( ), which would take the process down
	'' with the worker. fbc returns 1 for the same reason.
	return cast( any ptr, 1 )
end function

extern "rtlib"

function tkort_ThreadCreate alias "fb_ThreadCreate" _
	( byval proc_ as FB_THREADPROC, byval param as any ptr, byval stack_size as integer ) as FBTHREAD ptr

	dim as FBTHREAD ptr thread = any
	dim as FBTHREADINFO ptr info = any
	dim as uint8 attr( 0 to TKORT_PTHREAD_ATTR_SIZE - 1 ) = any
	dim as uinteger want = cast( uinteger, stack_size )

	thread = malloc( sizeof( FBTHREAD ) )
	if( thread = nullptr ) then return nullptr

	info = malloc( sizeof( FBTHREADINFO ) )
	if( info = nullptr ) then
		free( thread )
		return nullptr
	end if

	info->proc_ = proc_
	info->param = param
	info->thread = thread
	thread->flags = 0

	if( u_pthread_attr_init( @attr(0) ) <> 0 ) then
		free( thread )
		free( info )
		return nullptr
	end if

	'' CLAMPED UP, NOT PASSED THROUGH. Callers routinely ask for less than
	'' PTHREAD_STACK_MIN -- fbc's own THREADCREATE default is 0 -- and
	'' pthread_attr_setstacksize REJECTS anything below it, which would make
	'' every such thread fail to start.
	if( want < TKORT_PTHREAD_STACK_MIN ) then want = TKORT_PTHREAD_STACK_MIN
	u_pthread_attr_setstacksize( @attr(0), want )

	if( u_pthread_create( @thread->id, @attr(0), cast( any ptr, @hThreadProc ), info ) <> 0 ) then
		free( thread )
		free( info )
		thread = nullptr
	end if

	u_pthread_attr_destroy( @attr(0) )
	return thread
end function

sub tkort_ThreadWait alias "fb_ThreadWait" ( byval thread as FBTHREAD ptr )
	dim as FB_FBTHREADCTX ptr ctx = any

	if( thread = nullptr ) then exit sub
	if( (thread->flags and (FBTHREAD_MAIN or FBTHREAD_DETACHED)) <> 0 ) then exit sub

	ctx = TKORT_TLSGET_FBTHREAD()
	if( ctx <> nullptr ) then
		if( thread = ctx->self_ ) then exit sub
	end if

	u_pthread_join( thread->id, nullptr )

	free( thread )
end sub

end extern

#endif
