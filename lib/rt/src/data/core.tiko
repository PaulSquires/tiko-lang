'' core.tiko -- the DATA cursor: fb_DataRestore, fb_DataNext, and the
'' __fb_data_ptr global itself.
''
'' TAKING THIS MEMBER MEANS TAKING THE GLOBAL. data.o defines three symbols --
'' two functions and __fb_data_ptr, which is a B (bss) symbol -- and the gate's
'' merge replaces members whole. Defining only the functions would delete the
'' cursor that every compiled program's READ references. So it is defined here.
''
'' ================================================== THE LINK ENTRIES
''
'' A DATA table is an array of descriptors, and separate DATA statements are
'' chained: an entry whose length is FB_DATATYPE_LINK (-1) is not an item at all
'' but a POINTER TO THE NEXT TABLE.
''
'' So advancing is TWO steps, and both are needed:
''
''     step one element forward   -- ordinary progress within a table
''     then SKIP EVERY LINK       -- possibly several in a row, possibly to NULL
''
'' The skip is a LOOP rather than a single test because two tables can be joined
'' end to end, leaving consecutive links. Following just one leaves the cursor
'' pointing at a link, whose `length` of -1 is neither OFS nor the WSTR flag --
'' so the next READ would take the narrow arm and parse a POINTER as text.
''
'' RESTORE ALSO SKIPS. The label a program restores to may itself be a link, and
'' fb_DataRestore runs the same loop rather than assuming the target is an item.
''
'' NOTE fb_DataNext DOES NOT LOCK. Its callers hold the lock already -- every
'' reader in read.tiko takes it around the whole operation -- and fbc's comment
'' says so explicitly. Adding a lock here would be a nested acquire on a
'' recursive mutex, which works, but the asymmetry is deliberate and marked.

#include once "inc/descriptors.ti"

#ifdef ENABLE_MT
	extern "rtlib"
		declare sub fb_Lock alias "fb_Lock" ( )
		declare sub fb_Unlock alias "fb_Unlock" ( )
	end extern
	#define IOLOCK()   fb_Lock()
	#define IOUNLOCK() fb_Unlock()
#else
	#define IOLOCK()
	#define IOUNLOCK()
#endif

'' PACKED, AS fbc's IS -- the pointer at offset 2 -- EXCEPT ON DARWIN, where ld64 refuses an
'' unaligned pointer in arm64 data ('pointer not aligned', docs/tiko-macos M8): there the
'' compiler emits the record unpacked, the pointer at 8 (codegen/llvmglobal.tiko).
#ifdef __FB_DARWIN__
type FB_DATADESC
	as int16    length
	as any ptr  item
end type
#else
type FB_DATADESC field = 1
	as int16    length
	as any ptr  item
end type
#endif

const FB_DATATYPE_LINK = -1

'' The cursor. A B symbol in fbc -- zero-initialised, not explicitly assigned --
'' and every compiled program's READ refers to it by name.
'' DECLARE INSIDE THE BLOCK, DEFINE OUTSIDE IT. FreeBASIC has no `alias` on a
'' `dim shared`, so a C-visible global is spelled as an EXTERN declaration in an
'' EXTERN "C" block followed by a matching definition -- the block supplies the
'' linkage and the definition supplies the storage.
extern "c"   '' NON-FBCALL: this is DATA, not a procedure.
	extern tkort_data_ptr alias "__fb_data_ptr" as FB_DATADESC ptr
end extern

dim shared as FB_DATADESC ptr tkort_data_ptr

'' Skip links until an item or the end. A LOOP, not a test -- see the header.
private sub hSkipLink( )
	while( tkort_data_ptr <> nullptr )
		if( tkort_data_ptr->length <> FB_DATATYPE_LINK ) then exit while
		tkort_data_ptr = cptr( FB_DATADESC ptr, tkort_data_ptr->item )
	wend
end sub

extern "rtlib"

sub tkort_DataRestore alias "fb_DataRestore" ( byval labeladdr as FB_DATADESC ptr )
	IOLOCK()
	tkort_data_ptr = labeladdr
	'' The label may itself be a link.
	hSkipLink( )
	IOUNLOCK()
end sub

end extern

'' NON-FBCALL, and NOT LOCKED: the callers hold it. fb_data.h declares it plainly.
extern "c"   '' NON-FBCALL: fb_data.h declares fb_DataNext without the macro.

sub tkort_DataNext alias "fb_DataNext" ( )
	if( tkort_data_ptr <> nullptr ) then
		tkort_data_ptr += 1
		hSkipLink( )
	end if
end sub

end extern
