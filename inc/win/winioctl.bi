type _DEVICE_WRITE_AGGREGATION_DESCRIPTOR
   AS DWORD       Version          ' // keep compatible with STORAGE_DESCRIPTOR_HEADER
   AS DWORD       Size             ' // keep compatible with STORAGE_DESCRIPTOR_HEADER
