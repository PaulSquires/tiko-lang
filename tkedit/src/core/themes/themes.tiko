'
' themes -- themes/<name>.toml (PLAN.md D9, docs/tkEdit/CONFIG.md): the window's colours, the
' editor's and the tiko lexer's styles. Colours are "#rrggbb", held as &hRRGGBB. A syntax entry is
' a colour or a table { fg, bg, bold, italic }. A missing key keeps DarkTheme's value; a bad one
' keeps it too and adds a warning. The app turns a Theme into an editor look and a tk palette.
'
' A theme is looked up by name: <config>/themes/<name>.toml (the user's) first, then
' <resources>/themes/<name>.toml (shipped). An unknown name is DarkTheme.
#module "themes"

#import "std/fs"
#import "std/config"
#import "std/containers"
#import "std/outcome"
#import "std/strings"
#import "tkc/bundled"
using containers
using outcome

public const THEME_DIR = "themes"
public const DEFAULT_THEME = "dark"

' One style: -1 = the default style's colour.
public type StyleSpec
    Fore   as long = -1
    Back   as long = -1
    Bold   as boolean
    Italic as boolean
end type

public type Theme
    Name as ustring
    Path as ustring                      ' the file it came from; "" = built in
    ' [ui]
    Bg as long
    Fg as long
    StatusBar as long
    StatusBarFg as long
    Popup as long
    PopupSel as long
    Accent as long
    Border as long
    ' [editor]
    EdBg as long
    EdFg as long
    Caret as long
    CaretLine as long
    Selection as long
    Gutter as long
    GutterFg as long
    Fold as long
    IndentGuide as long
    Brace as long
    FindMatch as long
    ErrorColor as long
    WarningColor as long
    Bookmark as long
    Breakpoint as long          ' the breakpoint marker (debugger)
    ExecLine as long            ' the arrow on the line the debugger stopped at
    ExecLineBack as long        ' and that line's background
    ' [syntax]
    Default_ as StyleSpec
    Comment as StyleSpec
    Number_ as StyleSpec
    Keyword as StyleSpec
    Keyword2 as StyleSpec
    Keyword3 as StyleSpec
    Keyword4 as StyleSpec
    String_ as StyleSpec
    Preprocessor as StyleSpec
    Operator_ as StyleSpec
    Identifier as StyleSpec
    ' what the last parse found wrong (bad colours, unknown keys); never fatal
    Warnings as Array( of ustring )
    declare function IsDark( ) as boolean      ' by the window background's luminance
end type

public type ThemeResult as Result( of Theme, ustring )

private function Spec( byval fore as long, byval italic as boolean = false ) as StyleSpec
    dim as StyleSpec s
    s.Fore = fore
    s.Italic = italic
    return s
end function

' The shipped dark theme, built in (themes/dark.toml holds the same values).
public function DarkTheme( ) as Theme
    dim as Theme t
    t.Name = DEFAULT_THEME
    t.Bg = &h1E1E1E : t.Fg = &hD4D4D4
    t.StatusBar = &h252526 : t.StatusBarFg = &hCCCCCC
    t.Popup = &h252526 : t.PopupSel = &h04395E
    t.Accent = &h0E639C : t.Border = &h3C3C3C
    t.EdBg = &h1E1E1E : t.EdFg = &hD4D4D4
    t.Caret = &hAEAFAD : t.CaretLine = &h2A2D2E : t.Selection = &h264F78
    t.Gutter = &h1E1E1E : t.GutterFg = &h858585 : t.Fold = &h1E1E1E
    t.IndentGuide = &h404040 : t.Brace = &h515C6A : t.FindMatch = &h623315
    t.ErrorColor = &hF14C4C : t.WarningColor = &hCCA700 : t.Bookmark = &h0E639C
    t.Breakpoint = &hE51400 : t.ExecLine = &hFFCC00 : t.ExecLineBack = &h4B4B18
    t.Default_ = Spec( &hD4D4D4 )
    t.Comment = Spec( &h6A9955, true )
    t.Number_ = Spec( &hB5CEA8 )
    t.Keyword = Spec( &h569CD6 )
    t.Keyword2 = Spec( &h4EC9B0 )
    t.Keyword3 = Spec( &hDCDCAA )
    t.Keyword4 = Spec( &h9CDCFE )
    t.String_ = Spec( &hCE9178 )
    t.Preprocessor = Spec( &hC586C0 )
    t.Operator_ = Spec( &hD4D4D4 )
    t.Identifier = Spec( &hD4D4D4 )
    return t
end function

function Theme.IsDark( ) as boolean
    dim as long r = (this.Bg shr 16) and &hFF, g = (this.Bg shr 8) and &hFF, b = this.Bg and &hFF
    return (r * 299 + g * 587 + b * 114) < 128000
end function

' "#rrggbb" -> &hRRGGBB; -1 when it is not one.
public function ParseColor( byref s as const ustring ) as long
    if (len( s ) <> 7) orelse (left( s, 1 ) <> "#") then return -1
    dim as long v = 0
    for i as long = 1 to 6
        dim as long ch = asc( mid( s, i + 1, 1 ) )
        dim as long d
        select case ch
        case 48 to 57 : d = ch - 48             ' 0-9
        case 65 to 70 : d = ch - 55             ' A-F
        case 97 to 102 : d = ch - 87            ' a-f
        case else : return -1
        end select
        v = v * 16 + d
    next
    return v
end function

public function FormatColor( byval c as long ) as ustring
    return "#" & lcase( right( "000000" & hex( c and &hFFFFFF ), 6 ) )
end function

' Table t's colour key k into slot; a bad value warns and leaves the slot as it was.
private sub ReadColor( byref t as config.TomlValue, byref k as const ustring, byref slot as long, _
                       byref where_ as const ustring, byref warn as Array( of ustring ) )
    dim as Optional( of config.TomlValue ) o = t.Get( k )
    if o.HasValue( ) = false then exit sub
    dim as Optional( of ustring ) s = o.Value( ).AsString( )
    dim as long c = -1
    if s.HasValue( ) then c = ParseColor( s.Value( ) )
    if c < 0 then
        warn.Push( where_ & "." & k & ": not a ""#rrggbb"" colour; ignored" )
    else
        slot = c
    end if
end sub

private sub ReadStyle( byref t as config.TomlValue, byref k as const ustring, byref slot as StyleSpec, _
                       byref warn as Array( of ustring ) )
    dim as Optional( of config.TomlValue ) o = t.Get( k )
    if o.HasValue( ) = false then exit sub
    dim as config.TomlValue v = o.Value( )
    if v.Kind( ) = config.TOML_STRING then
        dim as long c = ParseColor( v.AsString( ).ValueOr( "" ) )
        if c < 0 then
            warn.Push( "syntax." & k & ": not a ""#rrggbb"" colour; ignored" )
        else
            slot.Fore = c
            slot.Back = -1
            slot.Bold = false
            slot.Italic = false
        end if
    elseif v.Kind( ) = config.TOML_TABLE then
        dim as StyleSpec s
        ReadColor( v, "fg", s.Fore, "syntax." & k, warn )
        ReadColor( v, "bg", s.Back, "syntax." & k, warn )
        s.Bold = v.Get( "bold" ).ValueOr( config.TomlValue.FromBool( false ) ).AsBool( ).ValueOr( false )
        s.Italic = v.Get( "italic" ).ValueOr( config.TomlValue.FromBool( false ) ).AsBool( ).ValueOr( false )
        if s.Fore < 0 then s.Fore = slot.Fore
        slot = s
    else
        warn.Push( "syntax." & k & ": a colour or { fg, bg, bold, italic }; ignored" )
    end if
end sub

' Every key of table t not in the space-separated list `known` is a warning.
private sub WarnUnknown( byref t as config.TomlValue, byref known as const ustring, byref where_ as const ustring, _
                         byref warn as Array( of ustring ) )
    dim as ustring k = " " & known & " "
    for i as long = 0 to t.Count( ) - 1
        if instr( k, " " & t.KeyAt( i ) & " " ) = 0 then warn.Push( where_ & "." & t.KeyAt( i ) & ": unknown key; ignored" )
    next
end sub

' Text over DarkTheme. Fails only when it is not TOML.
public function ParseTheme( byref text as const ustring, byref name_ as const ustring ) as ThemeResult
    dim as config.ConfigResultToml r = config.ParseToml( text )
    if r.IsOk( ) = false then return Fail( of Theme, ustring )( r.Failure( ).Message( ) )
    dim as config.TomlValue root = r.Value( )
    dim as Theme t = DarkTheme( )
    t.Name = name_
    dim as Array( of ustring ) w
    dim as config.TomlValue u = root.Get( "ui" ).ValueOr( config.TomlValue.NewTable( ) )
    ReadColor( u, "bg", t.Bg, "ui", w )
    ReadColor( u, "fg", t.Fg, "ui", w )
    ReadColor( u, "statusbar", t.StatusBar, "ui", w )
    ReadColor( u, "statusbar_fg", t.StatusBarFg, "ui", w )
    ReadColor( u, "popup", t.Popup, "ui", w )
    ReadColor( u, "popup_sel", t.PopupSel, "ui", w )
    ReadColor( u, "accent", t.Accent, "ui", w )
    ReadColor( u, "border", t.Border, "ui", w )
    WarnUnknown( u, "bg fg statusbar statusbar_fg popup popup_sel accent border", "ui", w )
    dim as config.TomlValue e = root.Get( "editor" ).ValueOr( config.TomlValue.NewTable( ) )
    ReadColor( e, "bg", t.EdBg, "editor", w )
    ReadColor( e, "fg", t.EdFg, "editor", w )
    ReadColor( e, "caret", t.Caret, "editor", w )
    ReadColor( e, "caret_line", t.CaretLine, "editor", w )
    ReadColor( e, "selection", t.Selection, "editor", w )
    ReadColor( e, "gutter", t.Gutter, "editor", w )
    ReadColor( e, "gutter_fg", t.GutterFg, "editor", w )
    ReadColor( e, "fold", t.Fold, "editor", w )
    ReadColor( e, "indent_guide", t.IndentGuide, "editor", w )
    ReadColor( e, "brace", t.Brace, "editor", w )
    ReadColor( e, "find_match", t.FindMatch, "editor", w )
    ReadColor( e, "error", t.ErrorColor, "editor", w )
    ReadColor( e, "warning", t.WarningColor, "editor", w )
    ReadColor( e, "bookmark", t.Bookmark, "editor", w )
    ReadColor( e, "breakpoint", t.Breakpoint, "editor", w )
    ReadColor( e, "exec_line", t.ExecLine, "editor", w )
    ReadColor( e, "exec_line_bg", t.ExecLineBack, "editor", w )
    WarnUnknown( e, "bg fg caret caret_line selection gutter gutter_fg fold indent_guide brace find_match error warning bookmark " & _
                 "breakpoint exec_line exec_line_bg", "editor", w )
    dim as config.TomlValue s = root.Get( "syntax" ).ValueOr( config.TomlValue.NewTable( ) )
    ReadStyle( s, "default", t.Default_, w )
    ReadStyle( s, "comment", t.Comment, w )
    ReadStyle( s, "number", t.Number_, w )
    ReadStyle( s, "keyword", t.Keyword, w )
    ReadStyle( s, "keyword2", t.Keyword2, w )
    ReadStyle( s, "keyword3", t.Keyword3, w )
    ReadStyle( s, "keyword4", t.Keyword4, w )
    ReadStyle( s, "string", t.String_, w )
    ReadStyle( s, "preprocessor", t.Preprocessor, w )
    ReadStyle( s, "operator", t.Operator_, w )
    ReadStyle( s, "identifier", t.Identifier, w )
    WarnUnknown( s, "default comment number keyword keyword2 keyword3 keyword4 string preprocessor operator identifier", "syntax", w )
    for i as long = 0 to root.Count( ) - 1
        select case root.KeyAt( i )
        case "name", "ui", "editor", "syntax"
        case else : w.Push( root.KeyAt( i ) & ": unknown key; ignored" )
        end select
    next
    t.Warnings = w
    return Ok( of Theme, ustring )( t )
end function

public function LoadTheme( byref path as const ustring, byref name_ as const ustring ) as ThemeResult
    dim as fs.FsResultUStr r = bundled.ReadAllText( path )     ' a file, or a bundled: name
    if r.IsOk( ) = false then return Fail( of Theme, ustring )( r.Failure( ).Message( ) )
    dim as ThemeResult t = ParseTheme( r.Value( ), name_ )
    if t.IsOk( ) = false then return Fail( of Theme, ustring )( path & ": " & t.Failure( ) )
    dim as Theme v = t.Value( )
    v.Path = path
    return Ok( of Theme, ustring )( v )
end function

' The file a theme name means: the user's copy wins over the shipped one -- a folder's when
' resourceDir names one, else the copy tkEdit carries (tkc/bundled, "bundled:themes/<name>.toml");
' "" = none.
public function FindTheme( byref name_ as const ustring, byref configDir as const ustring, _
                           byref resourceDir as const ustring ) as ustring
    dim as ustring f = name_ & ".toml"
    dim as ustring u = fs.PathJoin( configDir, THEME_DIR, f )
    if (len( configDir ) > 0) andalso fs.IsFile( u ) then return u
    if len( resourceDir ) > 0 then
        dim as ustring s = fs.PathJoin( resourceDir, THEME_DIR, f )
        if fs.IsFile( s ) then return s
    end if
    return bundled.Locate( THEME_DIR & "/" & f, "" )
end function
