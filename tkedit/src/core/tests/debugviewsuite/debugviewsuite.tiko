'    tkEdit - a minimalist keyboard-driven editor for the tiko compiler
'    Copyright (C) 2026 Paul Squires, PlanetSquires Software
'
' debugviewsuite -- tkc/debugview: array groups (shape and bounds), the sort's comparison and
' clicks, the changed-value memory across stops, the expanded-node memory, the expression under
' the mouse. From frmDebug's own self-test.
#module "debugviewsuite"

#import "tkc/debugview"
#import "../tally"

public sub Run( byref c as tally.Checker )
    c.Begin( "debugview" )
    ' ---- groups
    c.Check( debugview.GroupSpan( 100 ) = 0, "100 elements: listed directly" )
    c.Check( debugview.GroupSpan( 101 ) = 100, "101: groups of 100" )
    c.Check( debugview.GroupSpan( 10000 ) = 100, "10,000: 100 groups of 100" )
    c.Check( debugview.GroupSpan( 10001 ) = 10000, "10,001: a level more (groups of 10,000)" )
    c.Check( debugview.GroupSpan( 1000000 ) = 10000, "1,000,000: 100 groups of 10,000" )
    dim as longint lo, hi
    c.Check( debugview.GroupBounds( 0, 250, 100, 0, lo, hi ) andalso (lo = 0) andalso (hi = 99), "group 0 of 250: 0 .. 99" )
    c.Check( debugview.GroupBounds( 0, 250, 100, 2, lo, hi ) andalso (lo = 200) andalso (hi = 249), "the last group is short: 200 .. 249" )
    c.Check( debugview.GroupBounds( 0, 250, 100, 3, lo, hi ) = false, "no group past the end" )
    c.Check( debugview.GroupBounds( 500, 300, 100, 1, lo, hi ) andalso (lo = 600) andalso (hi = 699), "a sub-group starts at its parent's first index" )
    dim as long n = 0
    dim as longint g = 0, lastHi = -1
    do while debugview.GroupBounds( 0, 1000000, debugview.GroupSpan( 1000000 ), g, lo, hi )
        n += 1 : g += 1 : lastHi = hi
    loop
    c.Check( (n = 100) andalso (lastHi = 999999), "1,000,000: 100 groups, the last ends at 999,999" )
    ' ---- the sort
    c.Check( debugview.SortLess( "abc", "ABD", false ), "case-blind ascending" )
    c.Check( debugview.SortLess( "b", "a", true ), "descending" )
    c.Check( debugview.SortLess( "A", "a", false ) = false, "equal keys: neither first (stable)" )
    c.Check( debugview.SortLess( "10", "9", false ), "text, not numbers: '10' before '9'" )
    dim as debugview.SortState s
    c.Check( s.Col = -1, "unsorted at first" )
    s.Click( 1 )
    c.Check( (s.Col = 1) andalso (s.Desc = false), "a click sorts ascending" )
    s.Click( 1 )
    c.Check( s.Desc, "again: descending" )
    s.Click( 2 )
    c.Check( (s.Col = 2) andalso (s.Desc = false), "another column: ascending" )
    ' ---- changed values
    dim as debugview.ValueMemory m
    c.Check( m.Changed( "L0:i", "1" ) = false, "first sight: appeared, not changed" )
    m.Roll( )
    c.Check( m.Changed( "L0:i", "2" ), "next stop, another value: changed" )
    c.Check( m.Changed( "L0:i", "2" ), "within the stop it still compares with the previous stop" )
    c.Check( m.Changed( "G:g", "7" ) = false, "a new key in the stop: not changed" )
    m.Roll( )
    c.Check( m.Changed( "L0:i", "2" ) = false, "the stop after, the same value: not changed" )
    c.Check( m.Changed( "", "x" ) = false, "an empty key is never changed" )
    m.Reset( )
    c.Check( m.Changed( "L0:i", "9" ) = false, "after Reset nothing has changed" )
    ' ---- expanded nodes
    dim as debugview.ExpandMemory e
    e.Add( "L0:pt" ) : e.Add( "L0:pt" ) : e.Add( "" )
    c.Check( (e.Paths.Count( ) = 1) andalso e.Has( "L0:pt" ) andalso (e.Has( "L0:arr" ) = false), "paths kept once, empty ignored" )
    ' ---- the expression under the mouse
    c.Same( debugview.ExprFromLine( "x = rec.inner.ix + 1", 15 ), "rec.inner.ix", "the whole dotted path from its last part" )
    c.Same( debugview.ExprFromLine( "x = rec.inner.ix + 1", 6 ), "rec", "from its head: only the head" )
    c.Same( debugview.ExprFromLine( "print total", 8 ), "total", "a plain name" )
    c.Same( debugview.ExprFromLine( "a = b + 1", 3 ), "", "not on an identifier" )
    c.Same( debugview.ExprFromLine( "a = 123", 6 ), "", "a number is no expression" )
    c.Same( debugview.ExprFromLine( "x", 5 ), "", "past the end" )
    ' ---- why a session did not start
    c.Check( debugview.IsMacPermission( "process exited with status -1 (this is a non-interactive debug session, cannot get permission to debug processes.)" ), _
             "macOS debugserver's refusal (measured) is the permission one" )
    c.Check( debugview.IsMacPermission( "lldb-dap did not answer" ) = false, "another failure is not" )
end sub
