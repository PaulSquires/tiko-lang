' fontwriter -- one TrueType font made of glyphs taken from others (docs/tkDesigner/GLYPHS.md, V4):
' the project's glyphs.ttf, every glyph its forms use and nothing else, each at the code the
' project numbered it (appGlyphs.tkglyphs [codes]).
'
' Reads TrueType-outline fonts ('glyf'; a CFF font is refused, V6). A glyph is taken as its
' outline: a composite one is flattened into the points of its parts, so the new font has simple
' glyphs only. Every glyph is scaled to the FIRST font's units-per-em, about the baseline, so a
' glyph from that font is the same shape it was; its advance scales with it. No hinting.
' Writes head, hhea, maxp, OS/2, hmtx, cmap (formats 4 and 12), loca (long), glyf, name, post 3.0.
#module "fontwriter"

#import "std/containers"
#import "std/fs"
using containers

public type GlyphTake
    Path as ustring                    ' the font it comes from
    Code as ulong                      ' its code point there
    Target as ulong                    ' its code in the new font
end type

' ---- reading -------------------------------------------------------------------------------------

type SrcFont_
    Path as ustring
    D as Array( of ubyte )
    Upem as long
    Ascent as long
    Descent as long
    LocaLong as boolean
    NumGlyphs as long
    NumHMetrics as long
    OffGlyf as long
    OffLoca as long
    OffHmtx as long
    OffCmap as long
end type

private function U8_( byref d as Array( of ubyte ), byval o as long ) as long
    if (o < 0) orelse (o >= d.Count( )) then return 0
    return d[o]
end function

private function U16_( byref d as Array( of ubyte ), byval o as long ) as long
    return (U8_( d, o ) shl 8) or U8_( d, o + 1 )
end function

private function S16_( byref d as Array( of ubyte ), byval o as long ) as long
    dim as long v = U16_( d, o )
    if v >= 32768 then v -= 65536
    return v
end function

private function U32_( byref d as Array( of ubyte ), byval o as long ) as ulong
    return (culng( U16_( d, o ) ) shl 16) or culng( U16_( d, o + 2 ) )
end function

' A F2Dot14 (composite glyph scales).
private function F2Dot14_( byref d as Array( of ubyte ), byval o as long ) as double
    return S16_( d, o ) / 16384.0
end function

' The tables a glyph needs, found; false (problem says why) for no font, a CFF one, or a broken one.
private function LoadFont_( byref path as const ustring, byref f as SrcFont_, byref problem as ustring ) as boolean
    f.Path = path
    f.D.Clear( )
    if fs.ReadAllBytes( path, f.D ).IsOk( ) = false then
        problem = fs.PathFileName( path ) & ": can't be read"
        return false
    end if
    dim as long n = U16_( f.D, 4 )
    dim as long offHead = -1, offHhea = -1, offMaxp = -1
    f.OffGlyf = -1 : f.OffLoca = -1 : f.OffHmtx = -1 : f.OffCmap = -1
    for i as long = 0 to n - 1
        dim as long rec = 12 + 16 * i
        dim as string tag = chr( U8_( f.D, rec ), U8_( f.D, rec + 1 ), U8_( f.D, rec + 2 ), U8_( f.D, rec + 3 ) )
        dim as long off = clng( U32_( f.D, rec + 8 ) )
        select case tag
        case "head" : offHead = off
        case "hhea" : offHhea = off
        case "maxp" : offMaxp = off
        case "glyf" : f.OffGlyf = off
        case "loca" : f.OffLoca = off
        case "hmtx" : f.OffHmtx = off
        case "cmap" : f.OffCmap = off
        end select
    next
    if (f.OffGlyf < 0) orelse (f.OffLoca < 0) then
        problem = fs.PathFileName( path ) & ": not TrueType outlines (a CFF font is not taken yet)"
        return false
    end if
    if (offHead < 0) orelse (offHhea < 0) orelse (offMaxp < 0) orelse (f.OffHmtx < 0) orelse (f.OffCmap < 0) then
        problem = fs.PathFileName( path ) & ": a table is missing"
        return false
    end if
    f.Upem = U16_( f.D, offHead + 18 )
    f.LocaLong = (S16_( f.D, offHead + 50 ) <> 0)
    f.Ascent = S16_( f.D, offHhea + 4 )
    f.Descent = S16_( f.D, offHhea + 6 )
    f.NumHMetrics = U16_( f.D, offHhea + 34 )
    f.NumGlyphs = U16_( f.D, offMaxp + 4 )
    if (f.Upem <= 0) orelse (f.NumGlyphs <= 0) orelse (f.NumHMetrics <= 0) then
        problem = fs.PathFileName( path ) & ": its head / hhea / maxp make no sense"
        return false
    end if
    return true
end function

' The glyph of a code point: the (3,10) format 12 table first, then a format 4 one; 0 for none.
private function GlyphOf_( byref f as SrcFont_, byval cp as ulong ) as long
    dim byref as Array( of ubyte ) d = f.D
    dim as long c = f.OffCmap, nt = U16_( d, c + 2 )
    dim as long off12 = -1, off4 = -1
    for i as long = 0 to nt - 1
        dim as long pid = U16_( d, c + 4 + 8 * i ), eid = U16_( d, c + 6 + 8 * i )
        dim as long o = c + clng( U32_( d, c + 8 + 8 * i ) )
        dim as long fmt = U16_( d, o )
        if (fmt = 12) andalso (off12 < 0) then off12 = o
        if (fmt = 4) andalso ((off4 < 0) orelse ((pid = 3) andalso (eid = 1))) then off4 = o
    next
    if off12 >= 0 then
        dim as long ng = clng( U32_( d, off12 + 12 ) )
        for g as long = 0 to ng - 1
            dim as long r = off12 + 16 + 12 * g
            dim as ulong s_ = U32_( d, r ), e = U32_( d, r + 4 )
            if (cp >= s_) andalso (cp <= e) then return clng( U32_( d, r + 8 ) + (cp - s_) )
        next
    end if
    if (off4 >= 0) andalso (cp <= &hFFFF) then
        dim as long segX2 = U16_( d, off4 + 6 ), segs = segX2 \ 2
        dim as long ends_ = off4 + 14, starts = ends_ + segX2 + 2, deltas = starts + segX2, ranges = deltas + segX2
        for s as long = 0 to segs - 1
            dim as long e = U16_( d, ends_ + 2 * s )
            if clng( cp ) > e then continue for
            dim as long st = U16_( d, starts + 2 * s )
            if clng( cp ) < st then return 0
            dim as long delta = U16_( d, deltas + 2 * s ), ro = U16_( d, ranges + 2 * s )
            if ro = 0 then return (clng( cp ) + delta) and &hFFFF
            dim as long gi = U16_( d, ranges + 2 * s + ro + 2 * (clng( cp ) - st) )
            if gi = 0 then return 0
            return (gi + delta) and &hFFFF
        next
    end if
    return 0
end function

' Where a glyph's data is in 'glyf', and how long; len 0 for an empty glyph.
private sub GlyphSpan_( byref f as SrcFont_, byval gid as long, byref at as long, byref size as long )
    at = 0 : size = 0
    if (gid < 0) orelse (gid >= f.NumGlyphs) then exit sub
    dim as long a, b
    if f.LocaLong then
        a = clng( U32_( f.D, f.OffLoca + 4 * gid ) ) : b = clng( U32_( f.D, f.OffLoca + 4 * gid + 4 ) )
    else
        a = U16_( f.D, f.OffLoca + 2 * gid ) * 2 : b = U16_( f.D, f.OffLoca + 2 * gid + 2 ) * 2
    end if
    at = f.OffGlyf + a
    size = b - a
    if size < 0 then size = 0
end sub

private function Advance_( byref f as SrcFont_, byval gid as long ) as long
    dim as long i = gid
    if i >= f.NumHMetrics then i = f.NumHMetrics - 1
    return U16_( f.D, f.OffHmtx + 4 * i )
end function

' ---- outlines --------------------------------------------------------------------------------------

type Outline_
    Ends as Array( of long )           ' each contour's last point
    X as Array( of double )
    Y as Array( of double )
    OnCurve as Array( of boolean )
end type

' Glyph gid's points into o, through the transform (a b c d: x' = a*x + c*y + dx, y' = b*x + d*y + dy).
private sub Decode_( byref f as SrcFont_, byval gid as long, byref o as Outline_, byval a as double, byval b as double, _
                     byval c as double, byval dd as double, byval dx as double, byval dy as double, byval depth as long )
    if depth > 8 then exit sub
    dim as long at, size
    GlyphSpan_( f, gid, at, size )
    if size < 10 then exit sub
    dim byref as Array( of ubyte ) d = f.D
    dim as long nc = S16_( d, at )
    if nc >= 0 then
        dim as long base_ = o.X.Count( ), p = at + 10
        dim as Array( of long ) ends_
        for i as long = 0 to nc - 1
            ends_.Push( U16_( d, p ) )
            p += 2
        next
        dim as long np = 0
        if nc > 0 then np = ends_[nc - 1] + 1
        p += 2 + U16_( d, p )                          ' the instructions, skipped
        dim as Array( of long ) flags
        while flags.Count( ) < np
            dim as long fl = U8_( d, p )
            p += 1
            flags.Push( fl )
            if fl and 8 then
                dim as long rep = U8_( d, p )
                p += 1
                for r as long = 1 to rep
                    flags.Push( fl )
                next
            end if
        wend
        dim as Array( of long ) xs, ys
        dim as long v = 0
        for i as long = 0 to np - 1
            dim as long fl = flags[i]
            if fl and 2 then
                if fl and 16 then v += U8_( d, p ) else v -= U8_( d, p )
                p += 1
            elseif (fl and 16) = 0 then
                v += S16_( d, p )
                p += 2
            end if
            xs.Push( v )
        next
        v = 0
        for i as long = 0 to np - 1
            dim as long fl = flags[i]
            if fl and 4 then
                if fl and 32 then v += U8_( d, p ) else v -= U8_( d, p )
                p += 1
            elseif (fl and 32) = 0 then
                v += S16_( d, p )
                p += 2
            end if
            ys.Push( v )
        next
        for i as long = 0 to np - 1
            o.X.Push( a * xs[i] + c * ys[i] + dx )
            o.Y.Push( b * xs[i] + dd * ys[i] + dy )
            o.OnCurve.Push( (flags[i] and 1) <> 0 )
        next
        for each e as long in ends_
            o.Ends.Push( base_ + e )
        next
        exit sub
    end if
    ' a composite: each part, through its own transform and then this one
    dim as long p = at + 10
    do
        dim as long fl = U16_( d, p ), part = U16_( d, p + 2 )
        p += 4
        dim as double ox, oy
        if fl and 1 then
            ox = S16_( d, p ) : oy = S16_( d, p + 2 ) : p += 4
        else
            dim as long bx = U8_( d, p ), by_ = U8_( d, p + 1 )
            if bx >= 128 then bx -= 256
            if by_ >= 128 then by_ -= 256
            ox = bx : oy = by_ : p += 2
        end if
        if (fl and 2) = 0 then ox = 0 : oy = 0         ' points matched, not offsets: not taken
        dim as double pa = 1, pb = 0, pc = 0, pd = 1
        if fl and 8 then
            pa = F2Dot14_( d, p ) : pd = pa : p += 2
        elseif fl and 64 then
            pa = F2Dot14_( d, p ) : pd = F2Dot14_( d, p + 2 ) : p += 4
        elseif fl and 128 then
            pa = F2Dot14_( d, p ) : pb = F2Dot14_( d, p + 2 ) : pc = F2Dot14_( d, p + 4 ) : pd = F2Dot14_( d, p + 6 ) : p += 8
        end if
        ' part, then this glyph's transform
        Decode_( f, part, o, a * pa + c * pb, b * pa + dd * pb, a * pc + c * pd, b * pc + dd * pd, _
                 a * ox + c * oy + dx, b * ox + dd * oy + dy, depth + 1 )
        if (fl and 32) = 0 then exit do
    loop
end sub

private function Round_( byval v as double ) as long
    return clng( int( v + 0.5 ) )                       ' halves up, as the font's own units would
end function

' Does the font at path have a glyph at cp? (A test's question of a font written here.)
public function HasGlyph( byref path as const ustring, byval cp as ulong ) as boolean
    dim as SrcFont_ f
    dim as ustring why
    if LoadFont_( path, f, why ) = false then return false
    return GlyphOf_( f, cp ) <> 0
end function

' ---- writing -----------------------------------------------------------------------------------------

private sub W8_( byref b as Array( of ubyte ), byval v as long )
    b.Push( cubyte( v and 255 ) )
end sub

private sub W16_( byref b as Array( of ubyte ), byval v as long )
    W8_( b, v shr 8 ) : W8_( b, v )
end sub

private sub W32_( byref b as Array( of ubyte ), byval v as ulong )
    W16_( b, clng( (v shr 16) and &hFFFF ) ) : W16_( b, clng( v and &hFFFF ) )
end sub

private sub Put16_( byref b as Array( of ubyte ), byval at as long, byval v as long )
    b[at] = cubyte( (v shr 8) and 255 ) : b[at + 1] = cubyte( v and 255 )
end sub

private sub Put32_( byref b as Array( of ubyte ), byval at as long, byval v as ulong )
    Put16_( b, at, clng( (v shr 16) and &hFFFF ) ) : Put16_( b, at + 2, clng( v and &hFFFF ) )
end sub

private function CheckSum_( byref b as Array( of ubyte ), byval at as long, byval size as long ) as ulong
    dim as ulong s = 0
    dim as long n = (size + 3) \ 4
    for i as long = 0 to n - 1
        dim as ulong w = 0
        for k as long = 0 to 3
            dim as long o = at + 4 * i + k
            w = (w shl 8) or culng( iif( o < at + size, U8_( b, o ), 0 ) )
        next
        s += w
    next
    return s
end function

' A simple glyph's bytes, every coordinate a 16-bit delta, no repeats: plain and enough.
private sub Encode_( byref o as Outline_, byref out_ as Array( of ubyte ), byref xMin as long, byref yMin as long, _
                     byref xMax as long, byref yMax as long )
    out_.Clear( )
    dim as long np = o.X.Count( )
    if (np = 0) orelse (o.Ends.Count( ) = 0) then exit sub
    dim as Array( of long ) xs, ys
    for i as long = 0 to np - 1
        xs.Push( Round_( o.X[i] ) ) : ys.Push( Round_( o.Y[i] ) )
    next
    xMin = xs[0] : xMax = xs[0] : yMin = ys[0] : yMax = ys[0]
    for i as long = 1 to np - 1
        if xs[i] < xMin then xMin = xs[i]
        if xs[i] > xMax then xMax = xs[i]
        if ys[i] < yMin then yMin = ys[i]
        if ys[i] > yMax then yMax = ys[i]
    next
    W16_( out_, o.Ends.Count( ) )
    W16_( out_, xMin ) : W16_( out_, yMin ) : W16_( out_, xMax ) : W16_( out_, yMax )
    for each e as long in o.Ends
        W16_( out_, e )
    next
    W16_( out_, 0 )                                     ' no instructions
    for i as long = 0 to np - 1
        W8_( out_, iif( o.OnCurve[i], 1, 0 ) )
    next
    dim as long prev = 0
    for i as long = 0 to np - 1
        W16_( out_, xs[i] - prev ) : prev = xs[i]
    next
    prev = 0
    for i as long = 0 to np - 1
        W16_( out_, ys[i] - prev ) : prev = ys[i]
    next
    while (out_.Count( ) mod 4) <> 0
        W8_( out_, 0 )
    wend
end sub

private sub NameRecord_( byref recs as Array( of ubyte ), byref strs as Array( of ubyte ), byval id as long, byref s as const ustring )
    W16_( recs, 3 ) : W16_( recs, 1 ) : W16_( recs, &h409 ) : W16_( recs, id )
    W16_( recs, len( s ) * 2 ) : W16_( recs, strs.Count( ) )
    for i as long = 1 to len( s )
        W16_( strs, asc( mid( s, i, 1 ) ) )
    next
end sub

' The new font into out_: takes in order, each at its Target code; family names it. False, with
' problem, when no take could be read; a take whose font or glyph is missing is left out and named
' in problem (true is still returned when others went in).
public function Build( byref takes as Array( of GlyphTake ), byref family as const ustring, byref out_ as Array( of ubyte ), _
                       byref problem as ustring ) as boolean
    out_.Clear( )
    problem = ""
    ' the fonts, each read once
    dim as Array( of SrcFont_ ) fonts
    dim as Array( of long ) fontOf
    for each t as GlyphTake in takes
        dim as long fi = -1
        for k as long = 0 to fonts.Count( ) - 1
            if fs.PathEquals( fonts[k].Path, t.Path ) then fi = k
        next
        if fi < 0 then
            dim as SrcFont_ f
            dim as ustring why
            if LoadFont_( t.Path, f, why ) then
                fonts.Push( f )
                fi = fonts.Count( ) - 1
            else
                if len( problem ) = 0 then problem = why
            end if
        end if
        fontOf.Push( fi )
    next
    if fonts.Count( ) = 0 then
        if len( problem ) = 0 then problem = "no glyphs"
        return false
    end if
    dim as long upem = fonts[0].Upem
    ' glyph 0 is .notdef (empty); then each take that has a glyph
    dim as Array( of ubyte ) glyf, one
    dim as Array( of long ) loca, adv, lsb, codes, gids
    dim as long fxMin = 32767, fyMin = 32767, fxMax = -32768, fyMax = -32768
    dim as long asc_ = 0, desc_ = 0, maxPts = 0, maxCts = 0, advMax = 0
    loca.Push( 0 ) : loca.Push( 0 )                     ' .notdef: from 0 to 0
    adv.Push( upem \ 2 ) : lsb.Push( 0 )
    for i as long = 0 to takes.Count( ) - 1
        dim as long fi = fontOf[i]
        if fi < 0 then continue for
        dim byref as SrcFont_ f = fonts[fi]
        dim as long gid = GlyphOf_( f, takes[i].Code )
        if gid = 0 then
            if len( problem ) = 0 then problem = fs.PathFileName( f.Path ) & ": no glyph at U+" & hex( takes[i].Code )
            continue for
        end if
        dim as double s = upem / f.Upem
        dim as Outline_ o
        Decode_( f, gid, o, s, 0, 0, s, 0, 0, 0 )
        dim as long x0 = 0, y0 = 0, x1 = 0, y1 = 0
        Encode_( o, one, x0, y0, x1, y1 )
        for each byt as ubyte in one
            glyf.Push( byt )
        next
        loca.Push( glyf.Count( ) )
        dim as long a = Round_( Advance_( f, gid ) * s )
        adv.Push( a ) : lsb.Push( iif( one.Count( ) > 0, x0, 0 ) )
        if a > advMax then advMax = a
        if one.Count( ) > 0 then
            if x0 < fxMin then fxMin = x0
            if y0 < fyMin then fyMin = y0
            if x1 > fxMax then fxMax = x1
            if y1 > fyMax then fyMax = y1
            if o.X.Count( ) > maxPts then maxPts = o.X.Count( )
            if o.Ends.Count( ) > maxCts then maxCts = o.Ends.Count( )
        end if
        dim as long fa = Round_( f.Ascent * s ), fd = Round_( f.Descent * s )
        if fa > asc_ then asc_ = fa
        if fd < desc_ then desc_ = fd
        codes.Push( clng( takes[i].Target ) ) : gids.Push( 0 )
    next
    dim as long ng = loca.Count( ) - 1                   ' glyphs: .notdef + the taken (loca has one more)
    if ng = 1 then
        if len( problem ) = 0 then problem = "no glyphs"
        return false
    end if
    ' every taken glyph's index is its place after .notdef
    for k as long = 0 to gids.Count( ) - 1
        gids[k] = k + 1
    next
    if fxMin > fxMax then fxMin = 0 : fyMin = 0 : fxMax = 0 : fyMax = 0
    if asc_ = 0 then asc_ = Round_( upem * 0.8 )
    if desc_ = 0 then desc_ = -Round_( upem * 0.2 )
    ' codes in order, for the cmap
    for i as long = 0 to codes.Count( ) - 1
        for j as long = i + 1 to codes.Count( ) - 1
            if codes[j] < codes[i] then
                swap codes[i], codes[j]
                swap gids[i], gids[j]
            end if
        next
    next

    ' the tables
    dim as Array( of ubyte ) tHead, tHhea, tMaxp, tOs2, tHmtx, tCmap, tLoca, tName, tPost
    W32_( tHead, &h10000 ) : W32_( tHead, &h10000 ) : W32_( tHead, 0 ) : W32_( tHead, &h5F0F3CF5 )
    W16_( tHead, &hB ) : W16_( tHead, upem )
    for k as long = 1 to 16 : W8_( tHead, 0 ) : next      ' created, modified
    W16_( tHead, fxMin ) : W16_( tHead, fyMin ) : W16_( tHead, fxMax ) : W16_( tHead, fyMax )
    W16_( tHead, 0 ) : W16_( tHead, 8 ) : W16_( tHead, 2 ) : W16_( tHead, 1 ) : W16_( tHead, 0 )

    dim as long minLsb = 0, minRsb = 0
    for g as long = 1 to ng - 1
        if loca[g + 1] > loca[g] then
            if lsb[g] < minLsb then minLsb = lsb[g]
        end if
    next
    W32_( tHhea, &h10000 ) : W16_( tHhea, asc_ ) : W16_( tHhea, desc_ ) : W16_( tHhea, 0 )
    W16_( tHhea, advMax ) : W16_( tHhea, minLsb ) : W16_( tHhea, minRsb ) : W16_( tHhea, fxMax )
    W16_( tHhea, 1 ) : W16_( tHhea, 0 ) : W16_( tHhea, 0 )
    for k as long = 1 to 4 : W16_( tHhea, 0 ) : next
    W16_( tHhea, 0 ) : W16_( tHhea, ng )

    W32_( tMaxp, &h10000 ) : W16_( tMaxp, ng ) : W16_( tMaxp, maxPts ) : W16_( tMaxp, maxCts )
    W16_( tMaxp, 0 ) : W16_( tMaxp, 0 ) : W16_( tMaxp, 2 )
    for k as long = 1 to 8 : W16_( tMaxp, 0 ) : next

    dim as long first_ = codes[0], last_ = codes[codes.Count( ) - 1]
    W16_( tOs2, 4 ) : W16_( tOs2, upem ) : W16_( tOs2, 400 ) : W16_( tOs2, 5 ) : W16_( tOs2, 0 )
    for k as long = 1 to 10 : W16_( tOs2, 0 ) : next       ' sub/superscript, strikeout, family class
    for k as long = 1 to 10 : W8_( tOs2, 0 ) : next        ' panose
    W32_( tOs2, 0 ) : W32_( tOs2, &h10000000 ) : W32_( tOs2, 0 ) : W32_( tOs2, 0 )   ' Private Use Area
    W8_( tOs2, 84 ) : W8_( tOs2, 73 ) : W8_( tOs2, 75 ) : W8_( tOs2, 79 )            ' 'TIKO'
    W16_( tOs2, &h40 ) : W16_( tOs2, iif( first_ > &hFFFF, &hFFFF, first_ ) ) : W16_( tOs2, iif( last_ > &hFFFF, &hFFFF, last_ ) )
    W16_( tOs2, asc_ ) : W16_( tOs2, desc_ ) : W16_( tOs2, 0 )
    W16_( tOs2, asc_ ) : W16_( tOs2, -desc_ )
    W32_( tOs2, 1 ) : W32_( tOs2, 0 )
    W16_( tOs2, 0 ) : W16_( tOs2, 0 ) : W16_( tOs2, 0 ) : W16_( tOs2, 32 ) : W16_( tOs2, 0 )

    for g as long = 0 to ng - 1
        W16_( tHmtx, adv[g] ) : W16_( tHmtx, lsb[g] )
    next

    ' cmap: (3,1) format 4 for the codes up to U+FFFF, (3,10) format 12 for all, one run per code
    dim as Array( of ubyte ) f4, f12
    dim as Array( of long ) c4, g4
    for i as long = 0 to codes.Count( ) - 1
        if codes[i] <= &hFFFE then c4.Push( codes[i] ) : g4.Push( gids[i] )
    next
    dim as long segs = c4.Count( ) + 1, sr = 1, es = 0
    while sr * 2 <= segs
        sr *= 2 : es += 1
    wend
    sr *= 2
    W16_( f4, 4 ) : W16_( f4, 16 + 8 * segs ) : W16_( f4, 0 ) : W16_( f4, segs * 2 ) : W16_( f4, sr ) : W16_( f4, es ) : W16_( f4, segs * 2 - sr )
    for i as long = 0 to c4.Count( ) - 1 : W16_( f4, c4[i] ) : next
    W16_( f4, &hFFFF ) : W16_( f4, 0 )
    for i as long = 0 to c4.Count( ) - 1 : W16_( f4, c4[i] ) : next
    W16_( f4, &hFFFF )
    for i as long = 0 to c4.Count( ) - 1 : W16_( f4, (g4[i] - c4[i]) and &hFFFF ) : next
    W16_( f4, 1 )
    for i as long = 0 to segs - 1 : W16_( f4, 0 ) : next
    W16_( f12, 12 ) : W16_( f12, 0 ) : W32_( f12, 16 + 12 * codes.Count( ) ) : W32_( f12, 0 ) : W32_( f12, codes.Count( ) )
    for i as long = 0 to codes.Count( ) - 1
        W32_( f12, codes[i] ) : W32_( f12, codes[i] ) : W32_( f12, gids[i] )
    next
    W16_( tCmap, 0 ) : W16_( tCmap, 2 )
    W16_( tCmap, 3 ) : W16_( tCmap, 1 ) : W32_( tCmap, 20 )
    W16_( tCmap, 3 ) : W16_( tCmap, 10 ) : W32_( tCmap, 20 + f4.Count( ) )
    for each byt as ubyte in f4 : tCmap.Push( byt ) : next
    for each byt as ubyte in f12 : tCmap.Push( byt ) : next

    for each l as long in loca
        W32_( tLoca, l )
    next

    dim as ustring ps
    for i as long = 1 to len( family )
        dim as ustring ch = mid( family, i, 1 )
        dim as long a = asc( ch )
        if ((a >= 48) andalso (a <= 57)) orelse ((a >= 65) andalso (a <= 90)) orelse ((a >= 97) andalso (a <= 122)) then ps &= ch
    next
    if len( ps ) = 0 then ps = "Glyphs"
    dim as Array( of ubyte ) recs, strs
    NameRecord_( recs, strs, 1, family )
    NameRecord_( recs, strs, 2, "Regular" )
    NameRecord_( recs, strs, 3, family & " Regular" )
    NameRecord_( recs, strs, 4, family & " Regular" )
    NameRecord_( recs, strs, 6, ps & "-Regular" )
    W16_( tName, 0 ) : W16_( tName, 5 ) : W16_( tName, 6 + recs.Count( ) )
    for each byt as ubyte in recs : tName.Push( byt ) : next
    for each byt as ubyte in strs : tName.Push( byt ) : next

    W32_( tPost, &h30000 ) : W32_( tPost, 0 ) : W16_( tPost, -Round_( upem * 0.1 ) ) : W16_( tPost, Round_( upem * 0.05 ) )
    for k as long = 1 to 5 : W32_( tPost, 0 ) : next

    ' the file: the directory (tags in order), each table 4-aligned, then head's checkSumAdjustment
    dim as string tags( 0 to 9 ) = { "OS/2", "cmap", "glyf", "head", "hhea", "hmtx", "loca", "maxp", "name", "post" }
    dim as long nt = 10, srT = 1, esT = 0
    while srT * 2 <= nt
        srT *= 2 : esT += 1
    wend
    srT *= 16
    W32_( out_, &h10000 ) : W16_( out_, nt ) : W16_( out_, srT ) : W16_( out_, esT ) : W16_( out_, nt * 16 - srT )
    dim as long dirAt = out_.Count( )
    for k as long = 1 to nt * 16 : W8_( out_, 0 ) : next
    dim as long headAt = 0
    for k as long = 0 to nt - 1
        dim as Array( of ubyte ) ptr t
        select case tags( k )
        case "OS/2" : t = @tOs2
        case "cmap" : t = @tCmap
        case "glyf" : t = @glyf
        case "head" : t = @tHead
        case "hhea" : t = @tHhea
        case "hmtx" : t = @tHmtx
        case "loca" : t = @tLoca
        case "maxp" : t = @tMaxp
        case "name" : t = @tName
        case else : t = @tPost
        end select
        dim as long at = out_.Count( ), size = t->Count( )
        if tags( k ) = "head" then headAt = at
        for i as long = 0 to size - 1 : out_.Push( (*t)[i] ) : next
        while (out_.Count( ) mod 4) <> 0 : W8_( out_, 0 ) : wend
        dim as long r = dirAt + 16 * k
        for i as long = 0 to 3 : out_[r + i] = cubyte( asc( mid( tags( k ), i + 1, 1 ) ) ) : next
        Put32_( out_, r + 4, CheckSum_( out_, at, size ) )
        Put32_( out_, r + 8, at )
        Put32_( out_, r + 12, size )
    next
    Put32_( out_, headAt + 8, &hB1B0AFBAul - CheckSum_( out_, 0, out_.Count( ) ) )
    return true
end function
