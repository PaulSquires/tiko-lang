' catalog -- every control type the designer knows: tkMeta's table, plus Custom, a labelled stand-in
' for a control the designer can't create because it's the program's own. It's drawn as a label and
' promoted to a named type and module: at run time that type is what gets created.
#module "catalog"

#import "vendor/tkControls/tkMeta"
#import "vendor/tkControls/tkLabel"
using tkMeta
using tkLabel
using tkHost

public const as string CUSTOM_TYPE = "Custom"

private function CreateStandIn( byval hParent as TK_WIDGET ptr, byval id as long, byref arg as const ustring ) as TK_WIDGET ptr
    dim as TK_WIDGET ptr w = tkLabel_Create( hParent, id )
    tkLabel_SetAlign( w, LBL_ALIGN_CENTER )
    return w
end function

' Which list of entries a control type has, if any.
public enum ItemsKind explicit
    ItemsNone = 0
    ItemsMenu
    ItemsToolbar
    ItemsStatus
    ItemsColumns
    ItemsList
    ItemsPages
    ItemsIcons
end enum

' An entry handler's parameters, by the kind of control: a status bar panel's is told how many clicks
' (2 for a double click); a menu or toolbar entry's takes none.
public function ItemHandlerParams( byval kind_ as ItemsKind ) as ustring
    if kind_ = ItemsKind.ItemsStatus then return "byval clicks as long"
    return ""
end function

' The event of the control that reaches its entries' handlers, "" for none: a menu's Command, a
' toolbar's, an icon panel's or a status bar's Click.
public function ItemDispatchEvent( byval kind_ as ItemsKind ) as ustring
    select case kind_
    case ItemsKind.ItemsMenu : return "Command"
    case ItemsKind.ItemsToolbar, ItemsKind.ItemsIcons, ItemsKind.ItemsStatus : return "Click"
    end select
    return ""
end function

' ---- the form's own events, in the order the inspector lists them ----
public function FormEventCount( ) as long
    return 7
end function

public function FormEventName( byval i as long ) as ustring
    select case i
    case 0 : return "Load"
    case 1 : return "Close"
    case 2 : return "Resize"
    case 3 : return "KeyDown"
    case 4 : return "Paint"
    case 5 : return "Destroy"
    case 6 : return "ThemeChanged"
    end select
    return ""
end function

public function IsFormEvent( byref ev as const ustring ) as boolean
    for i as long = 0 to FormEventCount( ) - 1
        if FormEventName( i ) = ev then return true
    next
    return false
end function

' A form event handler's parameters. Resize: the client in pixels, after the layout. KeyDown: a key
' no control claimed. Paint: the form's background, under its controls.
public function FormEventParams( byref ev as const ustring ) as ustring
    select case ev
    case "Close"   : return "byref Cancel as boolean"
    case "Resize"  : return "byval cx as long, byval cy as long"
    case "KeyDown" : return "byval keyCode as long, byval mods as long, byref Handled as boolean"
    case "Paint"   : return "byval pPaint as TK_PAINT ptr"
    end select
    return ""
end function

' ---- types an event names that are another module's than its control's ----
' A DatePicker's date events name TKDATE (tkCalendar's); a ListTree's header events name
' TKCOLUMNHEADER_* (tkColumnHeader's). Both the generated file and the user's need that module in
' scope: a public #import of it by the control's module isn't enough for the names.
public function ForeignTypeCount( ) as long
    return 2
end function

' The type's spelling in upper case, as it follows "AS " (TKDATE alone: TKDATEPICKER_* is not it).
public function ForeignTypePrefix( byval i as long ) as ustring
    select case i
    case 0 : return "TKDATE "
    case 1 : return "TKCOLUMNHEADER_"
    end select
    return ""
end function

public function ForeignTypeModule( byval i as long ) as ustring
    select case i
    case 0 : return "tkCalendar"
    case 1 : return "tkColumnHeader"
    end select
    return ""
end function

' The procedure that adds one entry of a text-only list (ItemsList): a combo's item, a select bar's panel.
public function ItemsAddProc( byref typeName as const ustring ) as ustring
    if typeName = "SelectBar" then return "tkSelectBar_AddPanel"
    if typeName = "TabBar" then return "tkTabBar_AddTab"
    return "tkComboBox_AddItem"
end function

public function ItemsKindOf( byref typeName as const ustring ) as ItemsKind
    select case typeName
    case "MenuBar"    : return ItemsKind.ItemsMenu
    case "Toolbar"    : return ItemsKind.ItemsToolbar
    case "IconPanel"  : return ItemsKind.ItemsIcons
    case "StatusBar"  : return ItemsKind.ItemsStatus
    case "ListTree"   : return ItemsKind.ItemsColumns
    case "ComboBox"   : return ItemsKind.ItemsList
    case "SelectBar"  : return ItemsKind.ItemsList
    case "TabBar"     : return ItemsKind.ItemsList
    case "TabControl" : return ItemsKind.ItemsPages
    end select
    return ItemsKind.ItemsNone
end function

public function Find( byref name_ as const ustring ) as TKMETA_CONTROL ptr
    if name_ <> CUSTOM_TYPE then return tkMeta_Find( name_ )
    static as TKMETA_CONTROL standIn
    if standIn.Create = 0 then
        standIn.Name = CUSTOM_TYPE
        standIn.Category = "Custom"
        standIn.Width_ = 120
        standIn.Height_ = 60
        standIn.Create = @CreateStandIn
    end if
    return @standIn
end function
