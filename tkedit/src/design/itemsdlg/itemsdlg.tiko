' itemsdlg -- the one editor behind a form's menus, toolbars, status bars, list columns, combo items
' and tab pages: a list on the left with its order buttons under it, Add and Remove on the right above
' a group box (titled with the selected item's text) of its fields. What the fields are depends on the
' control; everything else is the same. The small buttons are glyphs, their words in tooltips.
#module "itemsdlg"

#import "std/containers"
#import "tkc/i18n"
#import "vendor/tkControls/tkApp"
#import "vendor/tkControls/tkListTree"
#import "vendor/tkControls/tkButton"
#import "vendor/tkControls/tkLabel"
#import "vendor/tkControls/tkTextBox"
#import "vendor/tkControls/tkComboBox"
#import "vendor/tkControls/tkGroupBox"
#import "vendor/tkControls/tkCheckBox"
#import "vendor/tkControls/tkTheme"
#import "../model"
#import "../catalog"
#import "../validate"
using containers
using tkApp
using tkListTree
using tkButton
using tkLabel
using tkTextBox
using tkComboBox
using tkGroupBox
using tkCheckBox
using tkTheme
using tkHost
using tkPaint
using model

const as long ROW_CY = 32
const as long LABEL_CX = 90
const as long MAX_FIELDS = 5
const as long GLYPH_CX = 40         ' a glyph button's width (design units)

' Fluent UI System Icons codepoints, all in tkEdit's PsIcons
public const as ulong GLYPH_ADD = &hF109       ' add
public const as ulong GLYPH_DELETE = &hF34C    ' delete (a bin)
public const as ulong GLYPH_UP = &hF19B        ' arrow up
public const as ulong GLYPH_DOWN = &hF148      ' arrow down
public const as ulong GLYPH_LEFT = &hF15B      ' arrow left: outdent
public const as ulong GLYPH_RIGHT = &hF181     ' arrow right: indent
public const as ulong GLYPH_EDIT = &hF3DD      ' edit (a pencil): the item's handler, in the code

public type ItemField
    Key as ustring          ' Text, Key, Glyph, Handler, Kind, Width, Stretch
    Label as TK_WIDGET ptr
    Edit as TK_WIDGET ptr
    IsCombo as boolean
    IsCheck as boolean      ' a check box (Stretch); its label is empty, the box carries the words
end type

public type ItemsEditor
    Kind as long
    Win as TK_FORM ptr
    Items as Array( of FormItem )
    List as TK_WIDGET ptr
    Group as TK_WIDGET ptr      ' the selected item's fields, under its text
    BtnAdd as TK_WIDGET ptr
    BtnDel as TK_WIDGET ptr
    BtnUp as TK_WIDGET ptr
    BtnDown as TK_WIDGET ptr
    BtnIn as TK_WIDGET ptr
    BtnOut as TK_WIDGET ptr
    BtnOk as TK_WIDGET ptr
    BtnCancel as TK_WIDGET ptr
    BtnHandler as TK_WIDGET ptr ' beside the Handler box: OK, then the handler in the code
    Fields as Array( of ItemField )
    ControlName as ustring      ' whose entries these are
    GoToHandler as ustring      ' set by the pencil: the handler to show once the entries are in
    Current as long = -1
    Accepted as boolean
    IsModal as boolean
    Loading as boolean

    declare sub Open( byval owner as TK_FORM ptr, byval kind_ as long, byref items_ as Array( of FormItem ), byref title as const ustring )
    declare function RunModal( ) as boolean
    declare sub Close( )
    declare sub AddField( byref key_ as const ustring, byref caption as const ustring, byref options as const ustring = "" )
    declare sub AddCheck( byref key_ as const ustring, byref caption as const ustring )
    declare sub Layout( )
    declare sub FillList( )
    declare function RowText( byval i as long ) as ustring
    declare sub ShowItem( byval i as long )
    declare sub FieldChanged( byval w as TK_WIDGET ptr )
    declare sub AddItem( )
    declare sub DeleteItem( )
    declare sub Move( byval delta as long )
    declare sub Indent( byval delta as long )
    declare sub Finish( byval ok as boolean )
    declare sub ShowCaption( )
    declare sub SyncSeparator( )
    declare sub SeedDefaults( )
    declare function DefaultHandler( byval i as long ) as ustring
    declare sub EditHandler( )
end type

' The owner (tkEdit) to the front BEFORE a modal dialog's window is hidden: hiding the active window
' let Windows activate some other program's window now and then.
private sub RaiseOwner_( byval f as TK_FORM ptr )
    if (f <> 0) andalso (f->pOwner <> 0) then SDL_RaiseWindow( f->pOwner->host->win )
end sub

private function DlgOf( byval w as TK_WIDGET ptr ) as ItemsEditor ptr
    dim as TK_FORM ptr f = tkForm_FromWidget( w )
    if f = 0 then return 0
    return f->Tag
end function

private sub OnPick( byval h as TK_WIDGET ptr, byval row as integer )
    dim as ItemsEditor ptr d = DlgOf( h )
    if (d <> 0) andalso (d->Loading = false) then d->ShowItem( row )
end sub

private sub OnTextChanged( byval h as TK_WIDGET ptr )
    dim as ItemsEditor ptr d = DlgOf( h )
    if d then d->FieldChanged( h )
end sub

private sub OnCheckChanged( byval h as TK_WIDGET ptr, byval isChecked as boolean )
    dim as ItemsEditor ptr d = DlgOf( h )
    if d then d->FieldChanged( h )
end sub

private sub OnComboChanged( byval h as TK_WIDGET ptr, byval a as long, byval b as long )
    dim as ItemsEditor ptr d = DlgOf( h )
    if d then d->FieldChanged( h )
end sub

private sub OnButton( byval h as TK_WIDGET ptr, byval id as long )
    dim as ItemsEditor ptr d = DlgOf( h )
    if d = 0 then exit sub
    select case h
    case d->BtnAdd    : d->AddItem( )
    case d->BtnDel    : d->DeleteItem( )
    case d->BtnUp     : d->Move( -1 )
    case d->BtnDown   : d->Move( 1 )
    case d->BtnIn     : d->Indent( 1 )
    case d->BtnOut    : d->Indent( -1 )
    case d->BtnOk     : d->Finish( true )
    case d->BtnCancel : d->Finish( false )
    case d->BtnHandler : d->EditHandler( )
    end select
end sub

private function MakeButton_( byval parent as TK_WIDGET ptr, byref text as const ustring ) as TK_WIDGET ptr
    dim as TK_WIDGET ptr b = tkButton_Create( parent, 1 )
    dim as ustring t = text
    tkButton_SetText( b, t )
    tkButton_SetClickCallback( b, @OnButton )
    return b
end function

' A small button that is one glyph; tip is its word, shown on hover.
private function MakeGlyphButton_( byval parent as TK_WIDGET ptr, byval cp as ulong, byref tip as const ustring ) as TK_WIDGET ptr
    dim as TK_WIDGET ptr b = tkButton_Create( parent, 1 )
    tkButton_SetGlyphFont( b, tkForm_Font( tkForm_FromWidget( parent ), TKFONT_GLYPH_LARGE ) )   ' else it draws in the text font
    tkButton_SetGlyphLeft( b, wchr( cp ) )
    tkButton_SetTooltipText( b, tip )
    tkButton_SetClickCallback( b, @OnButton )
    return b
end function

sub ItemsEditor.AddField( byref key_ as const ustring, byref caption as const ustring, byref options as const ustring = "" )
    dim as TK_WIDGET ptr root_ = Group          ' the fields live in the group box
    dim as ItemField f
    f.Key = key_
    f.Label = tkLabel_Create( root_, 1 )
    tkLabel_SetText( f.Label, caption )
    if len( options ) then
        f.IsCombo = true
        f.Edit = tkComboBox_Create( root_, Fields.Count( ) + 20 )
        dim as ustring t = options & ","
        dim as long a = 1, b = instr( a, t, "," )
        while b > 0
            tkComboBox_AddItem( f.Edit, mid( t, a, b - a ) )
            a = b + 1
            b = instr( a, t, "," )
        wend
        tkComboBox_SetSelChangeCallback( f.Edit, @OnComboChanged )
    else
        f.Edit = tkTextBox_Create( root_, Fields.Count( ) + 20, false )
        tkTextBox_SetChangeCallback( f.Edit, @OnTextChanged )
    end if
    Fields.Push( f )
end sub

' A check box field: an empty label beside it keeps the column, the box carries the words.
sub ItemsEditor.AddCheck( byref key_ as const ustring, byref caption as const ustring )
    dim as ItemField f
    f.Key = key_
    f.IsCheck = true
    f.Label = tkLabel_Create( Group, 1 )
    f.Edit = tkCheckBox_Create( Group, Fields.Count( ) + 20 )
    tkCheckBox_SetText( f.Edit, caption )
    tkCheckBox_SetCheckChangedCallback( f.Edit, @OnCheckChanged )
    Fields.Push( f )
end sub

' A window of its own, not yet modal: the tests drive it this way, and RunModal adds the loop.
sub ItemsEditor.Open( byval owner as TK_FORM ptr, byval kind_ as long, byref items_ as Array( of FormItem ), byref title as const ustring )
    Kind = kind_
    Items = items_
    ControlName = title
    dim as ustring t = title
    Win = tkApp_NewForm( t, 560, 420, owner, tkForm_Host( owner )->fScaleForced )
    if Win = 0 then exit sub
    Win->Tag = @this
    ' the title bar's close: the owner up first, then the modal loop ends as Cancel
    tkForm_OnClose( Win, function( byval f as TK_FORM ptr ) as boolean
        RaiseOwner_( f )
        return true
    end function )
    dim as TK_WIDGET ptr root_ = tkForm_Widget( Win )
    List = tkListTree_Create( root_, 1 )
    tkListTree_SetPaintCallback( List, @tkListTree_PaintRowDefault )   ' a tkListTree draws no row by itself
    tkListTree_SetSelChangeCallback( List, @OnPick )
    tkListTree_SetBorderWidth( List, 1 )
    BtnAdd = MakeGlyphButton_( root_, GLYPH_ADD, i18n.Tr( "designer.item_add", "Add" ) )
    BtnDel = MakeGlyphButton_( root_, GLYPH_DELETE, i18n.Tr( "designer.item_remove", "Remove" ) )
    BtnUp = MakeGlyphButton_( root_, GLYPH_UP, i18n.Tr( "designer.item_up", "Up" ) )
    BtnDown = MakeGlyphButton_( root_, GLYPH_DOWN, i18n.Tr( "designer.item_down", "Down" ) )
    Group = tkGroupBox_Create( root_, 1 )
    BtnOk = MakeButton_( root_, i18n.Tr( "designer.ok", "OK" ) )
    BtnCancel = MakeButton_( root_, i18n.Tr( "designer.cancel", "Cancel" ) )

    dim as ustring textLabel = i18n.Tr( "designer.item_text", "Text" )
    dim as ustring handlerLabel = i18n.Tr( "designer.item_handler", "Handler" )
    dim as ustring widthLabel = i18n.Tr( "designer.width", "Width" )
    select case kind_
    case catalog.ItemsKind.ItemsMenu, catalog.ItemsKind.ItemsPopup
        BtnIn = MakeGlyphButton_( root_, GLYPH_RIGHT, i18n.Tr( "designer.item_in", "Indent" ) )
        BtnOut = MakeGlyphButton_( root_, GLYPH_LEFT, i18n.Tr( "designer.item_out", "Outdent" ) )
        this.AddField( "Text", textLabel )
        this.AddField( "Key", i18n.Tr( "designer.item_key", "Shortcut" ) )
        this.AddField( "Handler", handlerLabel )
    case catalog.ItemsKind.ItemsToolbar
        this.AddField( "Kind", i18n.Tr( "designer.item_kind", "Kind" ), "command,toggle,separator,split,dropdown" )
        this.AddField( "Text", textLabel )
        this.AddField( "Glyph", i18n.Tr( "designer.item_glyph", "Glyph" ) )
        this.AddField( "Handler", handlerLabel )
    case catalog.ItemsKind.ItemsIcons
        ' an icon: no caption (its tip comes from the Tooltip event)
        this.AddField( "Kind", i18n.Tr( "designer.item_kind", "Kind" ), "toggle,command,separator" )
        this.AddField( "Glyph", i18n.Tr( "designer.item_glyph", "Glyph" ) )
        this.AddField( "Handler", handlerLabel )
    case catalog.ItemsKind.ItemsStatus
        ' a panel: its text and width, a handler for its clicks, and whether it takes the spare width
        this.AddField( "Text", textLabel )
        this.AddField( "Width", widthLabel )
        this.AddField( "Handler", handlerLabel )
        this.AddCheck( "Stretch", i18n.Tr( "designer.item_stretch", "Stretch" ) )
    case catalog.ItemsKind.ItemsColumns
        this.AddField( "Text", textLabel )
        this.AddField( "Width", widthLabel )
    case else
        this.AddField( "Text", textLabel )
    end select
    ' a pencil beside the Handler box, as an event row has in the Properties panel
    for each f as ItemField in Fields
        if f.Key = "Handler" then BtnHandler = MakeGlyphButton_( Group, GLYPH_EDIT, i18n.Tr( "designer.open_code", "Open code" ) )
    next

    tkForm_OnSize( Win, sub( byval f as TK_FORM ptr, byval cx as long, byval cy as long )
        if f->Tag then cast( ItemsEditor ptr, f->Tag )->Layout( )
    end sub )
    this.FillList( )
    if Items.Count( ) then this.ShowItem( 0 ) else this.ShowItem( -1 )
    tkForm_Show( Win )
    this.Layout( )
end sub

function ItemsEditor.RunModal( ) as boolean
    IsModal = true
    tkForm_ShowModalKeep( Win )
    IsModal = false
    return Accepted
end function

sub ItemsEditor.Close( )
    if Win then tkForm_Destroy( Win )
    Win = 0
end sub

sub ItemsEditor.Finish( byval ok as boolean )
    Accepted = ok
    if IsModal then
        RaiseOwner_( Win )
        tkForm_EndModal( Win, iif( ok, 1, 0 ) )
    end if
end sub

sub ItemsEditor.Layout( )
    if Win = 0 then exit sub
    dim as TK_WIDGET ptr root_ = tkForm_Widget( Win )
    dim as long g = tkForm_Scale( Win, 8 ), gap = tkForm_Scale( Win, 4 ), bw = tkForm_Scale( Win, 80 )
    dim as long bh = tkForm_Scale( Win, 28 ), rh = tkForm_Scale( Win, ROW_CY ), gw = tkForm_Scale( Win, GLYPH_CX )
    dim as long cw = root_->cw, ch = root_->ch
    dim as long listW = cw * 42 \ 100
    dim as long bottom = ch - g - bh                    ' OK and Cancel
    dim as long orderY = bottom - g - bh                ' the list's order buttons, under it

    ' left: the list (bordered), then Up, Down and -- for a menu -- Outdent, Indent
    tkWidget_SetPos( List, g, g, listW, orderY - g - g )
    dim as TK_WIDGET ptr order_( 0 to 3 ) = { BtnUp, BtnDown, BtnOut, BtnIn }
    dim as long x = g
    for k as long = 0 to 3
        if order_( k ) then
            tkWidget_SetPos( order_( k ), x, orderY, gw, bh )
            x += gw + gap
        end if
    next

    ' right: Add and Remove, then the group box of fields under them
    dim as long fx = 2 * g + listW, fw = cw - fx - g
    tkWidget_SetPos( BtnAdd, fx, g, gw, bh )
    tkWidget_SetPos( BtnDel, fx + gw + gap, g, gw, bh )
    dim as long gy = 2 * g + bh, n = Fields.Count( )
    ' the box sized once to read its frame and caption, then to fit its rows
    tkWidget_SetPos( Group, fx, gy, fw, 4 * rh )
    dim as TKRECT inner
    tkGroupBox_GetClientRect( Group, inner )
    dim as long frameH = 4 * rh - (inner.bottom - inner.top)
    tkWidget_SetPos( Group, fx, gy, fw, frameH + n * rh )
    tkGroupBox_GetClientRect( Group, inner )
    dim as long lw = tkForm_Scale( Win, LABEL_CX ), fy = inner.top
    for each f as ItemField in Fields
        tkWidget_SetPos( f.Label, inner.left, fy, lw, bh )
        dim as long ew = inner.right - inner.left - lw
        if (f.Key = "Handler") andalso (BtnHandler <> 0) then
            ew -= gw + gap
            tkWidget_SetPos( BtnHandler, inner.right - gw, fy, gw, bh )
        end if
        tkWidget_SetPos( f.Edit, inner.left + lw, fy, ew, bh )
        fy += rh
    next

    tkWidget_SetPos( BtnOk, cw - 2 * bw - 2 * g, bottom, bw, bh )
    tkWidget_SetPos( BtnCancel, cw - bw - g, bottom, bw, bh )
end sub

' A new menu bar's starting point: File, Edit and Help with their usual commands and shortcuts, in
' tkEdit's language. No handlers: the program's author names them.
private sub MenuItem_( byref a as Array( of FormItem ), byref text as const ustring, byval level as long, byref key_ as const ustring = "" )
    dim as FormItem it
    it.Text = text
    it.Level = level
    it.Key = key_
    it.Origin = -1
    a.Push( it )
end sub

public function DefaultMenu( ) as Array( of FormItem )
    dim as Array( of FormItem ) a
    MenuItem_( a, i18n.Tr( "designer.menu_file", "File" ), 0 )
    MenuItem_( a, i18n.Tr( "designer.menu_new", "New" ), 1, "Primary+N" )
    MenuItem_( a, i18n.Tr( "designer.menu_open", "Open..." ), 1, "Primary+O" )
    MenuItem_( a, i18n.Tr( "designer.menu_save", "Save" ), 1, "Primary+S" )
    MenuItem_( a, i18n.Tr( "designer.menu_save_as", "Save As..." ), 1, "Primary+Shift+S" )
    MenuItem_( a, "-", 1 )
    MenuItem_( a, i18n.Tr( "designer.menu_exit", "Exit" ), 1 )
    MenuItem_( a, i18n.Tr( "designer.menu_edit", "Edit" ), 0 )
    MenuItem_( a, i18n.Tr( "designer.menu_undo", "Undo" ), 1, "Primary+Z" )
    MenuItem_( a, i18n.Tr( "designer.menu_redo", "Redo" ), 1, "Primary+Y" )
    MenuItem_( a, "-", 1 )
    MenuItem_( a, i18n.Tr( "designer.menu_cut", "Cut" ), 1, "Primary+X" )
    MenuItem_( a, i18n.Tr( "designer.menu_copy", "Copy" ), 1, "Primary+C" )
    MenuItem_( a, i18n.Tr( "designer.menu_paste", "Paste" ), 1, "Primary+V" )
    MenuItem_( a, "-", 1 )
    MenuItem_( a, i18n.Tr( "designer.menu_select_all", "Select All" ), 1, "Primary+A" )
    MenuItem_( a, i18n.Tr( "designer.menu_help", "Help" ), 0 )
    MenuItem_( a, i18n.Tr( "designer.menu_about", "About" ), 1 )
    return a
end function

' An empty menu editor filled with DefaultMenu, the first entry selected.
sub ItemsEditor.SeedDefaults( )
    if (Kind <> catalog.ItemsKind.ItemsMenu) orelse (Items.Count( ) > 0) then exit sub
    Items = DefaultMenu( )
    Current = 0
    this.FillList( )
    this.ShowItem( 0 )
end sub

' The group box's title: the selected item's text, as the list shows it but not indented.
sub ItemsEditor.ShowCaption( )
    if Group = 0 then exit sub
    if (Current >= 0) andalso (Current < Items.Count( )) then
        tkGroupBox_SetText( Group, ltrim( this.RowText( Current ) ) )
    else
        tkGroupBox_SetText( Group, "" )
    end if
end sub

function ItemsEditor.RowText( byval i as long ) as ustring
    dim as ustring s
    for k as long = 1 to Items[i].Level
        s &= "    "
    next
    if Items[i].Kind = "separator" then return s & "---"
    ' an icon has no caption: its kind, and its handler once it has one
    if Kind = catalog.ItemsKind.ItemsIcons then
        if len( Items[i].Handler ) then return s & Items[i].Kind & "  " & Items[i].Handler
        return s & Items[i].Kind
    end if
    if len( Items[i].Text ) = 0 then return s & "(" & i18n.Tr( "designer.item_empty", "empty" ) & ")"
    return s & Items[i].Text
end function

sub ItemsEditor.FillList( )
    Loading = true
    tkListTree_BeginUpdate( List )
    tkListTree_Clear( List )
    for i as long = 0 to Items.Count( ) - 1
        tkListTree_AddString( List, this.RowText( i ), i )
    next
    tkListTree_EndUpdate( List )
    if (Current >= 0) andalso (Current < Items.Count( )) then tkListTree_SetCurSel( List, Current )
    Loading = false
end sub

sub ItemsEditor.ShowItem( byval i as long )
    Current = i
    Loading = true
    for each f as ItemField in Fields
        dim as ustring v
        if (i >= 0) andalso (i < Items.Count( )) then
            select case f.Key
            case "Text"    : v = Items[i].Text
            case "Key"     : v = Items[i].Key
            case "Glyph"   : v = Items[i].Glyph
            case "Handler" : v = Items[i].Handler
            case "Kind"    : v = Items[i].Kind
            case "Width"
                if Items[i].Width then v = str( Items[i].Width )
            end select
        end if
        if f.IsCheck then
            tkCheckBox_SetChecked( f.Edit, (i >= 0) andalso (i < Items.Count( )) andalso Items[i].Stretch )
        elseif f.IsCombo then
            tkComboBox_SetCurSel( f.Edit, tkComboBox_FindItemByText( f.Edit, v ) )
        else
            tkTextBox_SetText( f.Edit, v )
        end if
    next
    if (i >= 0) andalso (i < Items.Count( )) then tkListTree_SetCurSel( List, i )
    this.ShowCaption( )
    Loading = false
    this.SyncSeparator( )
end sub

sub ItemsEditor.FieldChanged( byval w as TK_WIDGET ptr )
    if Loading orelse (Current < 0) orelse (Current >= Items.Count( )) then exit sub
    for each f as ItemField in Fields
        if (f.Edit = w) andalso f.IsCheck then
            ' Stretch: several panels may share the spare width
            Items[Current].Stretch = tkCheckBox_GetChecked( f.Edit )
        elseif f.Edit = w then
            dim as ustring v
            if f.IsCombo then v = tkComboBox_GetText( f.Edit ) else v = tkTextBox_GetText( f.Edit )
            select case f.Key
            case "Text"    : Items[Current].Text = v
            case "Key"     : Items[Current].Key = v
            case "Glyph"   : Items[Current].Glyph = v
            case "Handler" : Items[Current].Handler = v
            case "Kind"    : Items[Current].Kind = v
            case "Width"   : Items[Current].Width = valint( v )
            end select
        end if
    next
    tkListTree_SetText( List, Current, this.RowText( Current ) )
    this.ShowCaption( )
    this.SyncSeparator( )
end sub

' A menu separator (text "-") is a line, not a command: its Shortcut and Handler boxes are off and
' empty, and the item keeps neither.
sub ItemsEditor.SyncSeparator( )
    if catalog.IsMenuKind( Kind ) = false then exit sub
    dim as boolean has = (Current >= 0) andalso (Current < Items.Count( ))
    dim as boolean sep = has andalso (trim( Items[Current].Text ) = "-")
    if sep then
        Items[Current].Key = ""
        Items[Current].Handler = ""
    end if
    dim as boolean was = Loading
    Loading = true
    for each f as ItemField in Fields
        if (f.Key = "Key") orelse (f.Key = "Handler") then
            if sep andalso (len( tkTextBox_GetText( f.Edit ) ) > 0) then tkTextBox_SetText( f.Edit, "" )
            tkWidget_Enable( f.Edit, sep = false )
            tkWidget_Enable( f.Label, sep = false )
        end if
    next
    if BtnHandler then tkWidget_Enable( BtnHandler, sep = false )
    Loading = was
end sub

' A word of an item's text as part of a name: its letters, digits and underscores ("Save As..." is
' "SaveAs", "&Open" is "Open").
private function NamePart_( byref s as const ustring ) as ustring
    dim as ustring o
    for k as long = 1 to len( s )
        dim as ustring ch = mid( s, k, 1 )
        if ((ch >= "a") andalso (ch <= "z")) orelse ((ch >= "A") andalso (ch <= "Z")) orelse ((ch >= "0") andalso (ch <= "9")) orelse (ch = "_") then o &= ch
    next
    return o
end function

' The name the pencil gives an item with no handler. A menu's is its path, File > Save As... being
' File_SaveAs; any other entry's is the control's name and its text (tbr_Go). Never a name another
' entry here already calls, nor one tiko keeps for itself.
function ItemsEditor.DefaultHandler( byval i as long ) as ustring
    dim as ustring n
    if catalog.IsMenuKind( Kind ) then
        n = NamePart_( Items[i].Text )
        dim as long lvl = Items[i].Level
        for j as long = i - 1 to 0 step -1
            if lvl = 0 then exit for
            if Items[j].Level < lvl then
                dim as ustring part = NamePart_( Items[j].Text )
                if len( part ) then n = iif( len( n ), part & "_" & n, part )
                lvl = Items[j].Level
            end if
        next
        if len( n ) = 0 then n = ControlName & "_Item" & (i + 1)
    else
        dim as ustring part = NamePart_( Items[i].Text )
        if len( part ) = 0 then part = "Item" & (i + 1)
        n = ControlName & "_" & part
    end if
    if (validate.IsIdentifier( n ) = false) orelse validate.IsReserved( n ) then n = ControlName & "_" & n
    ' one of its own: a number after it while another entry already calls that name
    dim as ustring want = n
    dim as long k = 2
    dim as boolean taken = true
    while taken
        taken = false
        for j as long = 0 to Items.Count( ) - 1
            if (j <> i) andalso (lcase( Items[j].Handler ) = lcase( n )) then taken = true
        next
        if taken then
            n = want & k
            k += 1
        end if
    wend
    return n
end function

' The pencil: an entry with no handler is given one (DefaultHandler), then the editor closes as OK
' does and the host shows that handler in the code.
sub ItemsEditor.EditHandler( )
    if (Current < 0) orelse (Current >= Items.Count( )) then exit sub
    if catalog.IsMenuKind( Kind ) andalso (trim( Items[Current].Text ) = "-") then exit sub
    if len( trim( Items[Current].Handler ) ) = 0 then
        Items[Current].Handler = this.DefaultHandler( Current )
        dim as boolean was = Loading
        Loading = true
        for each f as ItemField in Fields
            if f.Key = "Handler" then tkTextBox_SetText( f.Edit, Items[Current].Handler )
        next
        Loading = was
    end if
    GoToHandler = trim( Items[Current].Handler )
    this.Finish( true )
end sub

sub ItemsEditor.AddItem( )
    dim as FormItem it
    it.Text = i18n.Tr( "designer.item_new", "New" )
    it.Origin = -1
    if Kind = catalog.ItemsKind.ItemsToolbar then it.Kind = "command"
    if Kind = catalog.ItemsKind.ItemsIcons then it.Kind = "toggle" : it.Text = ""
    dim as long at_ = Items.Count( )
    if (Current >= 0) andalso (Current < Items.Count( )) then
        at_ = Current + 1
        it.Level = Items[Current].Level
    end if
    Items.Insert( at_, it )
    Current = at_
    this.FillList( )
    this.ShowItem( at_ )
end sub

' A menu with items under it takes them along.
sub ItemsEditor.DeleteItem( )
    if (Current < 0) orelse (Current >= Items.Count( )) then exit sub
    dim as long lvl = Items[Current].Level
    Items.Remove( Current )
    while (Current < Items.Count( ))
        if Items[Current].Level <= lvl then exit while
        Items.Remove( Current )
    wend
    if Current >= Items.Count( ) then Current = Items.Count( ) - 1
    this.FillList( )
    this.ShowItem( Current )
end sub

sub ItemsEditor.Move( byval delta as long )
    dim as long j = Current + delta
    if (Current < 0) orelse (j < 0) orelse (j >= Items.Count( )) then exit sub
    dim as FormItem t = Items[Current]
    Items[Current] = Items[j]
    Items[j] = t
    Current = j
    this.FillList( )
    this.ShowItem( j )
end sub

sub ItemsEditor.Indent( byval delta as long )
    if (Current < 0) orelse (Current >= Items.Count( )) then exit sub
    dim as long n = Items[Current].Level + delta
    if n < 0 then n = 0
    if n > 2 then n = 2
    Items[Current].Level = n
    tkListTree_SetText( List, Current, this.RowText( Current ) )
end sub
