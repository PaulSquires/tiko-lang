' An IconPanel's icons (kind, glyph, handler: reached through Click) and its three new events.
sub IconPanelSuite( )
    dim as ustring item = LF & "[[control.items]]" & LF
    dim as ustring src = "format = 1" & LF & LF & "[form]" & LF & "caption = ""I""" & LF & "width = 300" & LF & "height = 200" & LF _
        & Ctl( "ip", "IconPanel" ) _
        & LF & "[control.events]" & LF & "Paint = ""ip_Paint""" & LF & "Message = ""ip_Message""" & LF & "Tooltip = ""ip_Tip""" & LF _
        & item & "kind = ""toggle""" & LF & "glyph = ""A""" & LF & "handler = ""ip_Files""" & LF _
        & item & "kind = ""separator""" & LF _
        & item & "kind = ""command""" & LF & "glyph = ""B""" & LF
    Check( catalog.ItemsKindOf( "IconPanel" ) = catalog.ItemsKind.ItemsIcons, "iconpanel: its icons are an items list" )
    Check( catalog.ItemDispatchEvent( catalog.ItemsKind.ItemsIcons ) = "Click", "iconpanel: an icon's handler runs through Click" )
    dim as FormDoc d
    Check( ReadForm( src, d ), "iconpanel: the form parses" )
    Accepted( src, "iconpanel: icons and events" )
    Check( d.Controls[0].Items.Count( ) = 3, "iconpanel: three icons read" )
    dim as ustring g = codegen.Generate( d, "frmI", "frmI.tkform", src )
    HasLine( g, "tkIconPanel_AddItem( ip.Handle, IP_KIND_TOGGLE, ""A"", 1000 )", "iconpanel: a toggle icon" )
    HasLine( g, "tkIconPanel_AddItem( ip.Handle, IP_KIND_SEPARATOR, """", 1001 )", "iconpanel: a separator" )
    HasLine( g, "tkIconPanel_AddItem( ip.Handle, IP_KIND_COMMAND, ""B"", 1002 )", "iconpanel: a command icon" )
    HasLine( g, "case 1000 : f->ip_Files( )", "iconpanel: an icon's handler dispatched" )
    HasLine( g, "tkIconPanel_SetClickCallback( ip.Handle, @Thunk_ip_Click )", "iconpanel: the dispatcher is installed" )
    HasLine( g, "declare sub ip_Tip( byval idx as long, byref Text as ustring )", "iconpanel: Tooltip declared" )
    Check( instr( g, "tkForms_ObjectOf( p->hIconPanel )" ) > 0, "iconpanel: Paint finds its form through the paint info" )
    HasLine( g, "tkIconPanel_SetPaintItemCallback( ip.Handle, @Thunk_ip_Paint )", "iconpanel: Paint installed" )
    Check( instr( g, "tkForms_ObjectOf( m->hIconPanel )" ) > 0, "iconpanel: Message finds its form through the message info" )
    Refused( Header( ) & Ctl( "ip", "IconPanel" ) & item & "kind = ""split""" & LF, "no icon panel item kind" )
    Check( codegen.IconKindValue( "" ) = IP_KIND_TOGGLE andalso codegen.IconKindValue( "command" ) = IP_KIND_COMMAND, "iconpanel: a kind's value (toggle by default)" )
end sub

' A StatusBar's three new events: Paint, Message and Tooltip, beside a panel's own handler.
sub StatusBarSuite( )
    dim as ustring item = LF & "[[control.items]]" & LF
    dim as ustring src = "format = 1" & LF & LF & "[form]" & LF & "caption = ""S""" & LF & "width = 300" & LF & "height = 200" & LF _
        & Ctl( "sbr", "StatusBar" ) _
        & LF & "[control.events]" & LF & "Paint = ""sbr_Paint""" & LF & "Message = ""sbr_Message""" & LF & "Tooltip = ""sbr_Tip""" & LF _
        & item & "text = ""Ready""" & LF & "handler = ""sbr_Ready""" & LF
    dim as FormDoc d
    Check( ReadForm( src, d ), "statusbar: the form parses" )
    Accepted( src, "statusbar: Paint, Message and Tooltip" )
    dim as ustring g = codegen.Generate( d, "frmS", "frmS.tkform", src )
    HasLine( g, "declare sub sbr_Tip( byval idx as long, byref Text as ustring )", "statusbar: Tooltip declared" )
    HasLine( g, "tkStatusBar_SetTooltipCallback( sbr.Handle, @Thunk_sbr_Tooltip )", "statusbar: Tooltip installed" )
    Check( instr( g, "tkForms_ObjectOf( p->hStatusBar )" ) > 0, "statusbar: Paint finds its form through the paint info" )
    HasLine( g, "tkStatusBar_SetPaintCallback( sbr.Handle, @Thunk_sbr_Paint )", "statusbar: Paint installed" )
    Check( instr( g, "tkForms_ObjectOf( m->hStatusBar )" ) > 0, "statusbar: Message finds its form through the message info" )
    HasLine( g, "case 0 : f->sbr_Ready( clicks )", "statusbar: a panel's handler still dispatched" )
end sub

' [control.colors] (THEMES.md, TH4): values, migration of the old colour properties, refusals.
sub ColorsSuite( )
    dim as ustring src = Header( ) & Ctl( "l", "Label", "parent = """"" & LF & "x = 0" & LF & "y = 0" & LF & "w = 10" & LF & "h = 10" & LF ) _
        & LF & "[control.props]" & LF & "Text = ""a""" & LF & "BackColor = ""&h80102030""" & LF & "TextColor = ""&hFF336699""" & LF
    dim as FormDoc d
    Check( ReadForm( src, d ), "an old form with colour properties reads" )
    dim as FormControl c = d.Controls[0]
    Check( (FindSetting( c.Props, "TextColor" ) < 0) andalso (FindSetting( c.Props, "BackColor" ) < 0) andalso (FindSetting( c.Props, "Text" ) >= 0), _
        "its colour properties leave [control.props]" )
    Check( SettingOr( c.Colors, "TextColor" ) = "#336699" andalso SettingOr( c.Colors, "BackColor" ) = "#10203080", _
        "and become fields, alpha last", SettingOr( c.Colors, "BackColor" ) )
    dim as ustring t = formfile.Render( d )
    Check( instr( t, "[control.colors]" & LF & "TextColor = ""#336699""" & LF & "BackColor = ""#10203080""" & LF ) > 0, _
        "written in struct order on the next save", t )
    dim as FormDoc d2
    ReadForm( t, d2 )
    Check( formfile.Render( d2 ) = t, "and that round-trips" )

    dim as ustring tb = Header( ) & Ctl( "t", "TextBox", "parent = """"" & LF & "x = 0" & LF & "y = 0" & LF & "w = 10" & LF & "h = 10" & LF ) _
        & LF & "[control.props]" & LF & "CueBannerColor = ""&hFF808080""" & LF
    dim as FormDoc d3
    ReadForm( tb, d3 )
    Check( SettingOr( d3.Controls[0].Colors, "CueColor" ) = "#808080", "TextBox's CueBannerColor is its CueColor" )
    dim as ustring pic = Header( ) & Ctl( "p", "Picture", "parent = """"" & LF & "x = 0" & LF & "y = 0" & LF & "w = 10" & LF & "h = 10" & LF ) _
        & LF & "[control.props]" & LF & "BackColor = ""&hFF808080""" & LF
    dim as FormDoc d4
    ReadForm( pic, d4 )
    Check( (FindSetting( d4.Controls[0].Props, "BackColor" ) >= 0) andalso (d4.Controls[0].Colors.Count( ) = 0), _
        "a control with no colour struct keeps its property" )

    dim as ustring base_ = Header( ) & Ctl( "b", "Button", "parent = """"" & LF & "x = 0" & LF & "y = 0" & LF & "w = 10" & LF & "h = 10" & LF ) & LF & "[control.colors]" & LF
    Accepted( base_ & "style = ""Primary""" & LF & "BackColor = ""#c62828""" & LF & "ForeColor = ""@SelectedText""" & LF, "a style, a colour, a role" )
    dim as FormDoc d5
    ReadForm( base_ & "BackColor = ""#c62828ff""" & LF, d5 )
    Check( SettingOr( d5.Controls[0].Colors, "BackColor" ) = "#C62828", "upper case, an alpha of FF dropped" )
    Refused( base_ & "BackColor = ""red""" & LF, "is not a colour" )
    Refused( base_ & "BackColor = ""@Surfce""" & LF, "'Surfce' is not a theme role" )
    Refused( base_ & "BackColor = { dark = ""#000000"" }" & LF, "is not a colour" )
    Refused( base_ & "BackColor = { dark = ""#000000"", light = ""#FFFFFF"", other = ""#FFFFFF"" }" & LF, "unknown key 'other'" )
    Refused( base_ & "TextColour = ""#000000""" & LF, "Button has no colour 'TextColour'" )
    Refused( base_ & "style = ""2 bad""" & LF, "is not a style name" )
    Refused( Header( ) & Ctl( "p", "Picture", "parent = """"" & LF & "x = 0" & LF & "y = 0" & LF & "w = 10" & LF & "h = 10" & LF ) _
        & LF & "[control.colors]" & LF & "BackColor = ""#000000""" & LF, "Picture has no colours a theme sets" )
end sub

' The .tktheme file and its generated module (THEMES.md, TH4).
function ThemeProblems( byref text as const ustring ) as Array( of ustring )
    dim as themefile.ThemeDoc d
    dim as ustring e
    dim as Array( of ustring ) p
    if themefile.Parse( text, d, e ) = false then
        p.Push( e )
        return p
    end if
    themefile.Check( d, p )
    return p
end function

sub ThemeRefused( byref text as const ustring, byref want as const ustring )
    dim as Array( of ustring ) p = ThemeProblems( text )
    dim as boolean found = false
    for each s as ustring in p
        if instr( s, want ) then found = true
    next
    dim as ustring got = "(none)"
    if p.Count( ) then got = p[0]
    Check( found, "theme refused: " & want, got )
end sub

sub ThemeSuite( byval bAccept as boolean )
    const as string dir_ = "tests/golden/appTheme/"
    dim as ustring none
    dim as ustring golden = fs.ReadAllText( dir_ & "appTheme.tktheme" ).ValueOr( none )
    Check( len( golden ) > 0, "the golden theme was found" )
    dim as themefile.ThemeDoc d
    dim as ustring e
    Check( themefile.Parse( golden, d, e ), "the golden theme parses", e )
    dim as Array( of ustring ) p
    themefile.Check( d, p )
    dim as ustring first_
    if p.Count( ) then first_ = p[0]
    Check( p.Count( ) = 0, "and checks clean", first_ )
    dim as ustring t = themefile.Render( d )
    Check( t = golden, "canonical text comes back byte for byte", t )
    Check( d.Dark.Extra.Count( ) = 2, "tkEdit's own tables are kept", str( d.Dark.Extra.Count( ) ) )
    Check( (d.Styles.Count( ) = 2) andalso (d.Styles[1].Types.Count( ) = 1), "styles and a style's type block" )

    ' messy in, one spelling out
    dim as ustring messy = "format = 1" & CRLF & "[light]" & CRLF & "Accent = '#00ff00'" & CRLF & "[dark]" & CRLF _
        & "Window = ""#10203080""" & CRLF & "Text = ""#ffffffff""" & CRLF & "Surface = ""#000000""" & CRLF & "name = 'M'" & CRLF
    dim as themefile.ThemeDoc dm
    themefile.Parse( "name = 'M'" & CRLF & messy, dm, e )
    dim as ustring tm = themefile.Render( dm )
    Check( tm = "format = 1" & LF & "name = ""M""" & LF & LF & "[dark]" & LF & "Window = ""#102030""" & LF & "Surface = ""#000000""" & LF _
        & "Text = ""#FFFFFF""" & LF & LF & "[light]" & LF & "Accent = ""#00FF00""" & LF, _
        "roles in theme order, upper case, FF dropped, Window made opaque", tm )

    dim as ustring g = themefile.Generate( d, "appTheme", "appTheme.tktheme", golden )
    if bAccept then fs.WriteAllText( dir_ & "appTheme.design.tiko", g )
    dim as ustring gg = fs.ReadAllText( dir_ & "appTheme.design.tiko" ).ValueOr( none )
    Check( g = gg, "the theme generator matches its golden", len( g ) & " vs " & len( gg ) )
    HasLine( g, "t = tkTheme_Derive( t, &hFF1E88E5ul )", "the file's accent" )
    HasLine( g, "t = tkTheme_Derive( t, &hFF1565C0ul )", "a variant's own accent" )
    HasLine( g, "t.Surface = &hFF2A2F3Aul", "a role the variant sets" )
    HasLine( g, "s.CornerRadius = 4", "the shape" )
    HasLine( g, "o.FontUIFile = ""Inter-Regular.ttf""", "the fonts" )
    HasLine( g, "gStyles_( 1 ).remap( TKROLE_SURFACE ) = tkTheme_SrcRole( 0, TKROLE_ERROR )", "a style's remap" )
    HasLine( g, "gStyles_( 1 ).remap( TKROLE_SURFACEHOT ) = tkTheme_SrcDerive( 0, TKDERIVE_HOT, TKROLE_SURFACE )", "the hot face follows the style's" )
    HasLine( g, "gTypes_( 1 ).TypeName = ""Button"" : gTypes_( 1 ).StyleName = ""Danger""", "a style's type block" )
    HasLine( g, "tkApp_SetThemePair( Dark( ), Light( ) )", "both variants installed" )
    Check( instr( themefile.DefaultText( "Default" ), "name = ""Default""" ) > 0, "a new theme is the presets, named" )

    ThemeRefused( "format = 2", "format 2" )
    ThemeRefused( "format = 1" & LF & "name = ""x""" & LF & "[dark]" & LF & "Surfce = ""#000000""" & LF, "'Surfce' is not a theme role" )
    ThemeRefused( "format = 1" & LF & "name = ""x""" & LF & "[dark]" & LF & "Surface = ""@Accent""" & LF, "is not a theme role" )
    ThemeRefused( "format = 1" & LF & "name = ""x""" & LF & "[dark]" & LF & "Surface = ""blue""" & LF, "is not a colour" )
    ThemeRefused( "format = 1" & LF & "name = ""x""" & LF & "[controls.Buttn]" & LF & "BackColor = ""#000000""" & LF, "'Buttn' is not a control with theme colours" )
    ThemeRefused( "format = 1" & LF & "name = ""x""" & LF & "[controls.Picture]" & LF & "BackColor = ""#000000""" & LF, "'Picture' is not a control with theme colours" )
    ThemeRefused( "format = 1" & LF & "name = ""x""" & LF & "[controls.Button]" & LF & "BackColour = ""#000000""" & LF, "Button has no colour 'BackColour'" )
    ThemeRefused( "format = 1" & LF & "name = ""x""" & LF & "[styles.""2nd""]" & LF & "Surface = ""@Accent""" & LF, "is not a style name" )
    ThemeRefused( "format = 1" & LF & "name = ""x""" & LF & "[styles.A]" & LF & "Surface = ""@Accent""" & LF & "[styles.a]" & LF & "Text = ""@Accent""" & LF, "is there twice" )
    ThemeRefused( "format = 1" & LF & "name = ""x""" & LF & "[shape]" & LF & "CornerRadius = -2" & LF, "CornerRadius is -1" )
    ThemeRefused( "format = 1" & LF & "name = ""x""" & LF & "[fonts]" & LF & "ui = { face = ""a"" }" & LF, "unknown key 'face'" )
    ThemeRefused( "format = 1" & LF & "[dark]" & LF, "the theme has no name" )
end sub

' The Theme Center's core (TH5): shipped themes, Resolve, contrast, main.tiko made to install a theme.
sub ThemeCenterCore( )
    ' every shipped theme is canonical, clean, and resolves; High Contrast passes AA in both variants
    for each nm as ustring in Names( "Default", "HighContrast", "Ocean" )
        dim as ustring none
        dim as ustring text = fs.ReadAllText( "../../themes/" & nm & ".tktheme" ).ValueOr( none )
        dim as themefile.ThemeDoc d
        dim as ustring e
        dim as Array( of ustring ) p
        dim as boolean ok = themefile.Parse( text, d, e )
        if ok then themefile.Check( d, p )
        Check( ok andalso (p.Count( ) = 0) andalso (themefile.Render( d ) = text), "shipped theme " & nm & ": canonical and clean", e )
    next
    for each nm as ustring in Names( "Forest", "Ember", "Violet" )
        dim as ustring none
        dim as ustring text = fs.ReadAllText( "../../themes/" & nm & ".tktheme" ).ValueOr( none )
        dim as themefile.ThemeDoc d
        dim as ustring e
        Check( themefile.Parse( text, d, e ) andalso (themefile.Render( d ) = text), "shipped theme " & nm & ": canonical", e )
    next
    dim as ustring none
    dim as themefile.ThemeDoc hc
    dim as ustring e
    themefile.Parse( fs.ReadAllText( "../../themes/HighContrast.tktheme" ).ValueOr( none ), hc, e )
    for v as long = 0 to 1
        dim as Array( of ustring ) faults
        themefile.ContrastFaults( themefile.Resolve( hc, v = 0 ), faults )
        dim as ustring first_
        if faults.Count( ) then first_ = faults[0]
        Check( faults.Count( ) = 0, "High Contrast passes its own AA check, " & iif( v = 0, "dark", "light" ), first_ )
    next

    ' Resolve is what the generated Dark( ) / Light( ) build
    dim as themefile.ThemeDoc d
    Check( tkTheme_Equal( themefile.Resolve( d, true ), tkTheme_Dark( ) ) andalso tkTheme_Equal( themefile.Resolve( d, false ), tkTheme_Light( ) ), _
        "an empty theme resolves to the presets" )
    d.Accent = "#E65100"
    PutSetting( d.Dark.Roles, "Surface", "#123456" )
    dim as TKTHEME_COLORS r = themefile.Resolve( d, true )
    Check( (r.Accent = tkTheme_Derive( tkTheme_Dark( ), &hFFE65100ul ).Accent) andalso (r.Surface = &hFF123456ul), "the accent derived, then the roles" )
    dim as Array( of ustring ) faults
    dim as TKTHEME_COLORS bad = tkTheme_Dark( )
    bad.Text = bad.Surface
    themefile.ContrastFaults( bad, faults )
    dim as ustring f0
    if faults.Count( ) then f0 = faults[0]
    Check( instr( f0, "Text on Surface: 1.0:1 (needs 4.5)" ) = 1, "a contrast fault says which pair and how far", f0 )

    ' the preview's tables agree with what the generated module installs
    dim as themefile.ThemeDoc g
    themefile.Parse( fs.ReadAllText( "tests/golden/appTheme/appTheme.tktheme" ).ValueOr( none ), g, e )
    dim as themefile.ThemeTables tb
    tb.Build( g )
    Check( (tb.Styles.Count( ) = 2) andalso (tb.Styles[1].Name = "Danger") andalso (tb.Styles[1].remap( TKROLE_SURFACE ).arg = TKROLE_ERROR), "styles as tables" )
    Check( tb.Styles[1].remap( TKROLE_SURFACEHOT ).kind = TKSRC_DERIVE, "with simple mode for roles" )
    Check( (tb.Types.Count( ) = 2) andalso (tb.Types[1].StyleName = "Danger") andalso (tb.Types[1].n = 4) andalso (tb.Types[1].pSrc->value = &hFFB71C1Cul), _
        "type recipes as tables, pointing at their entries" )

    ' main.tiko made to install the theme
    dim as ustring m = "' app" & LF & "#import ""vendor/tkControls/tkApp""" & LF & "#import ""./frmMain""" & LF & "using tkApp" & LF & LF _
        & "dim as TKAPP_OPTIONS opts" & LF & "if tkApp_Init( opts ) = false then end 1" & LF & "dim as frmMain.Form f" & LF
    dim as ustring o
    Check( themefile.InstallIntoMain( m, o ) = 1, "a new-project main takes the theme" )
    Check( o = "' app" & LF & "#import ""vendor/tkControls/tkApp""" & LF & "#import ""./appTheme""" & LF & "#import ""./frmMain""" & LF & "using tkApp" & LF & LF _
        & "dim as TKAPP_OPTIONS opts" & LF & "appTheme.ApplyOptions( opts )" & LF & "if tkApp_Init( opts ) = false then end 1" & LF & "appTheme.Install( )" & LF _
        & "dim as frmMain.Form f" & LF, "import, ApplyOptions before Init, Install after", o )
    Check( themefile.InstallIntoMain( o, m ) = 0, "and only once" )
    Check( themefile.InstallIntoMain( "print 1" & LF, o ) = -1, "a main with no tkApp_Init is left to the user" )
end sub

' The Colors dialog's core (TH6): where a control's colour comes from.
sub ColorSources( )
    dim as ustring none, e
    dim as themefile.ThemeDoc g
    themefile.Parse( fs.ReadAllText( "tests/golden/appTheme/appTheme.tktheme" ).ValueOr( none ), g, e )
    dim as TKMETA_CONTROL ptr m = tkMeta_Find( "Button" )
    dim as Array( of Setting ) own
    PutSetting( own, "BackColor", "#C62828" )
    dim as long sBack = tkMeta_ColorSlot( m, "BackColor" ), sBackHot = tkMeta_ColorSlot( m, "BackColorHot" )
    dim as long sBorder = tkMeta_ColorSlot( m, "BorderColor" ), sBorderHot = tkMeta_ColorSlot( m, "BorderColorHot" )
    dim as long sFore = tkMeta_ColorSlot( m, "ForeColor" ), sRing = tkMeta_ColorSlot( m, "FocusRingColor" )
    Check( themefile.SourceOf( g, m, "", own, sBack, true ) = themefile.FROM_CONTROL, "a field set on the control" )
    Check( themefile.SourceOf( g, m, "", own, sBackHot, true ) = themefile.FROM_DERIVED, "its part's Hot follows it" )
    dim as Array( of Setting ) none_
    Check( themefile.SourceOf( g, m, "", none_, sBorder, true ) = themefile.FROM_TYPE, "[controls.Button] gives every Button its border" )
    Check( themefile.SourceOf( g, m, "", none_, sBorderHot, true ) = themefile.FROM_TYPE, "and the border's states, by simple mode" )
    Check( themefile.SourceOf( g, m, "Danger", none_, sBorder, true ) = themefile.FROM_STYLE, "a style's block for the type beats the type's" )
    Check( themefile.SourceOf( g, m, "Primary", none_, sBack, true ) = themefile.FROM_STYLE, "a style's remap reaches the face" )
    Check( themefile.SourceOf( g, m, "Primary", none_, sFore, true ) = themefile.FROM_STYLE, "and the text" )
    Check( themefile.SourceOf( g, m, "Primary", none_, sRing, true ) = themefile.FROM_THEME, "a role the style leaves is the theme's" )
    Check( themefile.SourceOf( g, m, "NoSuchStyle", none_, sBack, true ) = themefile.FROM_THEME, "an unknown style is no style" )
    Check( themefile.SourceOf( g, m, "Primary", own, sBack, true ) = themefile.FROM_CONTROL, "the control's own beats its style" )
end sub

' TH8: the fixtures examples/tkControls/tkThemeFile compares tkTheme_Load against -- every shipped
' theme, the golden, the sample's and a Mixed one -- each a copy of its .tktheme plus the module this
' generator makes from it. --accept rewrites them; otherwise they must be current.
sub ThemeLoadFixtures( byval bAccept as boolean )
    const as string fx = "../../../examples/tkControls/tkThemeFile/fixtures/"
    dim as ustring fixNames( 0 to 8 ) = { "Default", "HighContrast", "Ocean", "Forest", "Ember", "Violet", "Golden", "Sample", "Mixed" }
    dim as ustring srcs( 0 to 8 ) = { "../../themes/Default.tktheme", "../../themes/HighContrast.tktheme", "../../themes/Ocean.tktheme", _
        "../../themes/Forest.tktheme", "../../themes/Ember.tktheme", "../../themes/Violet.tktheme", "tests/golden/appTheme/appTheme.tktheme", _
        "../../../examples/tkControls/tkDesigned/appTheme/appTheme.tktheme", "" }
    for i as long = 0 to 8
        dim as ustring none, e
        dim as ustring md = "th" & fixNames( i ), dir_ = fx & md & "/"
        dim as ustring themePath = dir_ & md & ".tktheme"
        dim as ustring text
        if len( srcs( i ) ) then
            text = fs.ReadAllText( srcs( i ) ).ValueOr( none )
            if bAccept then
                fs.CreateDirAll( dir_ )
                fs.WriteAllText( themePath, text )
            end if
            Check( fs.ReadAllText( themePath ).ValueOr( none ) = text, "load fixture " & md & ": the theme is current", srcs( i ) )
        else
            text = fs.ReadAllText( themePath ).ValueOr( none )
        end if
        dim as themefile.ThemeDoc d
        dim as Array( of ustring ) p
        dim as boolean ok = (len( text ) > 0) andalso themefile.Parse( text, d, e )
        if ok then themefile.Check( d, p )
        dim as ustring first_ = e
        if p.Count( ) then first_ = p[0]
        Check( ok andalso (p.Count( ) = 0), "load fixture " & md & ": parses and checks clean", first_ )
        dim as ustring g = themefile.Generate( d, md, md & ".tktheme", text )
        if bAccept then fs.WriteAllText( dir_ & md & ".design.tiko", g )
        Check( fs.ReadAllText( dir_ & md & ".design.tiko" ).ValueOr( none ) = g, "load fixture " & md & ": the generated module is current" )
    next
end sub

' [fonts] embed: the four fonts inside the program -- the file round trip, the generated #embed and
' "mem:" registrations (defaults for empty slots, each file once), where a font is found, the copy.
sub EmbedFontsSuite( )
    dim as ustring none
    dim as ustring text = "format = 1" & LF & "name = ""E""" & LF & LF & "[dark]" & LF & LF & "[light]" & LF & LF _
        & "[fonts]" & LF & "embed = true" & LF & "ui = { file = ""My.ttf"", size = 11 }" & LF
    dim as themefile.ThemeDoc d
    dim as ustring e
    Check( themefile.Parse( text, d, e ), "embed: parses", e )
    Check( d.EmbedFonts andalso (d.Problems.Count( ) = 0), "embed: read as true, no problem" )
    Check( themefile.Render( d ) = text, "embed: one canonical text", themefile.Render( d ) )
    dim as Array( of ustring ) files = themefile.EmbeddedFonts( d )
    Check( (files.Count( ) = 4) andalso (files[0] = "My.ttf") andalso (files[1] = "Inter-Bold.ttf"), "embed: the theme's UI font, then the defaults" )
    dim as ustring g = themefile.Generate( d, "appTheme", "appTheme.tktheme", text )
    Check( instr( g, "#embed gFont0_ ""fonts/My.ttf""" ) > 0, "embed: #embed from fonts/", g )
    Check( instr( g, "#embed gFont3_ ""fonts/CascadiaMono-Regular.ttf""" ) > 0, "embed: a default slot embedded too" )
    Check( instr( g, "tkHost_AddFontData( ""mem:My.ttf"", @gFont0_( 0 ), ubound( gFont0_ ) + 1 )" ) > 0, "embed: registered as mem:" )
    Check( (instr( g, "o.FontDir = ""mem:""" ) > 0) andalso (instr( g, "o.FontUIFile = ""My.ttf""" ) > 0) _
           andalso (instr( g, "o.FontUISize = 11" ) > 0), "embed: the options look there" )
    ' off: no #embed, as before
    d.EmbedFonts = false
    Check( instr( themefile.Generate( d, "appTheme", "appTheme.tktheme", text ), "#embed" ) = 0, "embed off: nothing embedded" )
    d.EmbedFonts = true
    ' the same file in two slots is embedded once
    d.UIBold = "My.ttf"
    Check( themefile.EmbeddedFonts( d ).Count( ) = 3, "embed: one file in two slots, once" )
    d.UIBold = ""

    ' where a font comes from, and the copy into appTheme/fonts
    const as string root_ = "tests/bin/embed"
    fs.RemoveDirAll( root_ )
    fs.CreateDirAll( root_ & "/proj/appTheme" )
    fs.CreateDirAll( root_ & "/pkg/vendor/tkControls/fonts" )
    dim as ustring themeDir = root_ & "/proj/appTheme", pkgDir = root_ & "/pkg"
    fs.WriteAllText( root_ & "/proj/My.ttf", "my font" )
    dim as ustring bundledFonts( 0 to 2 ) = { "Inter-Bold.ttf", "FluentSystemIcons-Regular.ttf", "CascadiaMono-Regular.ttf" }
    for i as long = 0 to 2
        fs.WriteAllText( pkgDir & "/vendor/tkControls/fonts/" & bundledFonts( i ), "bundled " & bundledFonts( i ) )
    next
    Check( instr( themefile.FontSource( "My.ttf", themeDir, pkgDir ), "proj" ) > 0, "embed: a project font is found in the project folder" )
    Check( instr( themefile.FontSource( "Inter-Bold.ttf", themeDir, pkgDir ), "pkg" ) > 0, "embed: a bundled one in the toolchain" )
    Check( themefile.FontSource( "Nope.ttf", themeDir, pkgDir ) = "", "embed: an unknown one nowhere" )
    dim as Array( of ustring ) problems
    themefile.CopyEmbeddedFonts( d, themeDir, pkgDir, problems )
    Check( problems.Count( ) = 0, "embed: the copy has no problem" )
    Check( fs.ReadAllText( themeDir & "/fonts/My.ttf" ).ValueOr( none ) = "my font", "embed: the project font copied into fonts/" )
    Check( fs.IsFile( themeDir & "/fonts/CascadiaMono-Regular.ttf" ), "embed: and the defaults" )
    ' a file already in fonts/ is kept (it may be the user's own)
    fs.WriteAllText( themeDir & "/fonts/My.ttf", "edited" )
    themefile.CopyEmbeddedFonts( d, themeDir, pkgDir, problems )
    Check( fs.ReadAllText( themeDir & "/fonts/My.ttf" ).ValueOr( none ) = "edited", "embed: a font already in fonts/ is kept" )
    d.MonoFile = "Missing.ttf"
    dim as Array( of ustring ) p2
    themefile.CopyEmbeddedFonts( d, themeDir, pkgDir, p2 )
    Check( (p2.Count( ) = 1) andalso (instr( p2[0], "Missing.ttf" ) > 0), "embed: a font not found is named" )
end sub

