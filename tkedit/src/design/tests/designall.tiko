    dim as ustring g = codegen.Generate( d, "frmB", "frmB.tkform", src )
    HasLine( g, "declare sub tbr_Tip( byval idx as long, byref Text as ustring )", "toolbar: Tooltip declared" )
    HasLine( g, "tkToolbar_SetTooltipCallback( tbr.Handle, @Thunk_tbr_Tooltip )", "toolbar: Tooltip installed" )
    Check( instr( g, "tkForms_ObjectOf( p->hToolbar )" ) > 0, "toolbar: Paint finds its form through the paint info" )
    HasLine( g, "tkToolbar_SetPaintItemCallback( tbr.Handle, @Thunk_tbr_Paint )", "toolbar: Paint installed" )
    Check( instr( g, "tkForms_ObjectOf( m->hToolbar )" ) > 0, "toolbar: Message finds its form through the message info" )
    HasLine( g, "case 1000 : f->tbr_Go( )", "toolbar: an item's handler still dispatched" )
