' helppass -- the Help menu in the real window (author 2026-11-27): the last menu, its four rows and
' F1; Keyword Help's address from the selection or the word at the caret (pressed as F1); the web
' site and wiki rows; About's dialog laid out (the bird, the version, the two link lines, OK).
' NoBrowser: every address is only recorded (mw.LastUrl), no browser opens.
#module "selftest"

#import "std/containers"
#import "std/strings"
#import "tkc/appinfo"
#import "tkc/cmdids"
#import "tkc/wikihelp"
#import "tka/aboutdlg"
#import "tka/documents"
#import "tka/mainwin"
#import "vendor/tkControls/tkApp"
#import "vendor/tkControls/tkTest"
#import "vendor/tkControls/tkLabel"
#import "vendor/tkControls/tkPicture"
#import "vendor/tkControls/tkMenuBar"
#import "vendor/tkControls/tkPopupMenu"
using containers
using cmdids
using tkApp
using tkHost
using tkTest
using tkLabel
using tkPicture
using tkPaint
using tkMenuBar
using tkPopupMenu

' Is widget w inside its parent's client area, and is a below b (no overlap)?
private function Inside_( byval w as TK_WIDGET ptr, byval cw as long, byval ch as long ) as boolean
    return (w->x >= 0) andalso (w->y >= 0) andalso (w->x + w->cw <= cw) andalso (w->y + w->ch <= ch) andalso (w->cw > 0) andalso (w->ch > 0)
end function

public sub HelpPass( byref t as Tally, byval sc as single )
    dim as mainwin.Window mw
    mw.ConfigDir = FreshConfig( )
    mw.Ask = @ScriptedAsk
    mw.Pick = @ScriptedPick
    mw.NoBrowser = true
    t.Check( mw.Create( sc ), P( sc, "help: main window created" ) )
    if mw.form = 0 then exit sub
    mw.Show( )
    dim as TK_HOST ptr h = tkForm_Host( mw.form )
    tkTest_PumpFor( h, 150 )

    ' ---- the last menu: Keyword Help (F1), a separator, the web site, the wiki, a separator, About
    dim as long gHelp = clng( MenuGroup.Help )
    t.Check( (tkMenuBar_GetItemCount( mw.menuBar ) = gHelp + 1) andalso (tkMenuBar_GetItemText( mw.menuBar, gHelp ) = "Help"), _
             P( sc, strings.Format( "help: Help is the last of {} menus", tkMenuBar_GetItemCount( mw.menuBar ) ) ) )
    ClickMenuTitle( mw, gHelp )
    dim as TK_MENU ptr hm = tkMenuBar_GetDropDown( mw.menuBar, gHelp )
    dim as long ki = iif( hm <> 0, hm->FindItem( clng( Cmd.HelpKeyword ) ), -1 )
    t.Check( (hm <> 0) andalso tkPopupMenu_IsOpen( hm ) andalso (tkPopupMenu_GetItemCount( hm ) = 6) andalso (ki = 0) andalso _
             (hm->items(ki).wszAccel = "F1") andalso (MenuRow( Cmd.HelpWebsite ) = 2) andalso (MenuRow( Cmd.HelpAbout ) = 5), _
             P( sc, "help: the menu holds Keyword Help (F1), a separator, Website, Wiki, a separator, About" ) )
    t.Check( tkPopupMenu_GetItemEnabled( hm, Cmd.HelpKeyword ) andalso tkPopupMenu_GetItemEnabled( hm, Cmd.HelpWebsite ) andalso _
             tkPopupMenu_GetItemEnabled( hm, Cmd.HelpWiki ) andalso tkPopupMenu_GetItemEnabled( hm, Cmd.HelpAbout ), _
             P( sc, "help: every row works on the start panel" ) )
    ClickMenuRow( mw, hm, Cmd.HelpWiki )
    t.Check( mw.LastUrl = wikihelp.WIKI_URL, P( sc, "help: the Wiki row opens the wiki (" & mw.LastUrl & ")" ) )
    mw.Execute( Cmd.HelpWebsite )
    t.Check( mw.LastUrl = "https://tiko-lang.net", P( sc, "help: Website opens tiko-lang.net (" & mw.LastUrl & ")" ) )
    mw.Execute( Cmd.HelpKeyword )
    t.Check( mw.LastUrl = wikihelp.WIKI_URL, P( sc, "help: F1 on the start panel: the wiki's home (" & mw.LastUrl & ")" ) )

    ' ---- F1 in a buffer: the word at the caret, a member's library page, the selection
    mw.Execute( Cmd.FileNew )
    Chord( h, SDLK_RETURN, SDL_SCANCODE_RETURN, 0 )
    mw.View( ).SetText( "print x" & chr( 10 ) & "m.Put( k, v )" & chr( 10 ) & "select   case n" & chr( 10 ) & "zzqq" & chr( 10 ) )
    mw.View( ).GoToLine( 0, 2 )
    Chord( h, SDLK_F1, SDL_SCANCODE_F1, 0 )
    t.Check( mw.LastUrl = wikihelp.WIKI_URL & "/Print", P( sc, "help: F1 inside print: its page (" & mw.LastUrl & ")" ) )
    mw.View( ).GoToLine( 1, 4 )
    mw.Execute( Cmd.HelpKeyword )
    t.Check( strings.StartsWith( mw.LastUrl, wikihelp.WIKI_URL & "/Modern-" ), P( sc, "help: on m.Put: a library page (" & mw.LastUrl & ")" ) )
    mw.View( ).GoToLine( 2, 0, 13 )
    mw.Execute( Cmd.HelpKeyword )
    t.Check( mw.LastUrl = wikihelp.WIKI_URL & "/procedures-Select-Case", P( sc, "help: a selection: its words (" & mw.LastUrl & ")" ) )
    mw.View( ).GoToLine( 3, 1 )
    mw.Execute( Cmd.HelpKeyword )
    t.Check( mw.LastUrl = wikihelp.WIKI_URL & "/Keyword-Index#z", P( sc, "help: no page: the index at its letter (" & mw.LastUrl & ")" ) )

    ' ---- About: the bird at the left, the lines down the right, OK under them
    mw.OpenAbout( )
    dim as aboutdlg.AboutDialog ptr a = mw.AboutDlg
    t.Check( (a <> 0) andalso (a->Win <> 0), P( sc, "about: the dialog opened" ) )
    if (a <> 0) andalso (a->Win <> 0) then
        dim as TK_HOST ptr ah = tkForm_Host( a->Win )
        tkTest_PumpFor( ah, 60 )
        dim as TK_WIDGET ptr root_ = tkForm_Widget( a->Win )
        dim as long cw = root_->cw, ch = root_->ch
        t.Check( tkPicture_HasImage( a->Pic ) andalso Inside_( a->Pic, cw, ch ), P( sc, "about: the bird is shown" ) )
        t.Check( (tkLabel_GetText( a->Title ) = "tkEdit") andalso (instr( tkLabel_GetText( a->Version ), appinfo.VersionText( ) ) > 0), _
                 P( sc, "about: tkEdit and its version (" & tkLabel_GetText( a->Version ) & ")" ) )
        t.Check( (tkLabel_GetLinkCount( a->Site ) = 1) andalso (tkLabel_GetLinkUrl( a->Site, 0 ) = wikihelp.SITE_URL) andalso _
                 (tkLabel_GetLinkText( a->Site, 0 ) = "tiko-lang.net") andalso (tkLabel_GetLinkCount( a->Repo ) = 1) andalso _
                 (tkLabel_GetLinkUrl( a->Repo, 0 ) = wikihelp.REPO_URL), P( sc, "about: the web site and GitHub are links" ) )
        ' every line inside, each below the one before, to the right of the bird; OK below them all
        dim as TK_WIDGET ptr lines_(0 to 5) = { a->Title, a->Version, a->Tagline, a->Copyright, a->Site, a->Repo }
        dim as boolean geomOk = true
        dim as ustring why
        for i as long = 0 to 5
            if Inside_( lines_(i), cw, ch ) = false then geomOk = false : why &= " line " & i & " outside"
            if lines_(i)->x < a->Pic->x + a->Pic->cw then geomOk = false : why &= " line " & i & " over the bird"
            if (i > 0) andalso (lines_(i)->y < lines_(i - 1)->y + lines_(i - 1)->ch) then geomOk = false : why &= " line " & i & " overlaps"
        next
        if (Inside_( a->BtnOk, cw, ch ) = false) orelse (a->BtnOk->y < a->Repo->y + a->Repo->ch) then geomOk = false : why &= " OK"
        t.Check( geomOk, P( sc, "about: laid out inside, no overlaps" & why ) )
        ' the link sits inside its label, after "Website: "
        dim as TKRECT lr
        t.Check( tkLabel_GetLinkRect( a->Site, 0, lr ) andalso (lr.left > 0) andalso (lr.right <= a->Site->cw), _
                 P( sc, strings.Format( "about: the address is a link after its words ({}..{} of {})", lr.left, lr.right, a->Site->cw ) ) )
    end if
    mw.CloseAbout( )
    t.Check( mw.AboutDlg = 0, P( sc, "about: closed" ) )

    for each d as DocRef in mw.Docs
        d->Main.SetSavePoint( )
    next
    mw.Destroy( )
end sub
