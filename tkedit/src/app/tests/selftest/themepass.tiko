' themepass -- the Theme Center (docs/tkDesigner/THEMES.md, TH5) on a new GUI project, through real
' events: the gallery, an accent, High Contrast's own AA check, Dark and Light, a role and its reset,
' the corner radius, a style, Save (main.tiko made to install the theme), Save to Library, Close.
' Tabs are switched by tkTabControl_SetCurSel: that is the tab control's, not what is tested here.
#module "selftest"

#import "std/containers"
#import "std/fs"
#import "tkc/cmdids"
#import "tka/documents"
#import "tka/mainwin"
#import "tkd/themecenter"
#import "tkd/themefile"
#import "tkd/model"
#import "tkc/build"
#import "tkp/platform"
#import "vendor/tkControls/tkApp"
#import "vendor/tkControls/tkTest"
#import "vendor/tkControls/tkPaint"
#import "vendor/tkControls/tkListTree"
#import "vendor/tkControls/tkTextBox"
#import "vendor/tkControls/tkButton"
#import "vendor/tkControls/tkLabel"
#import "vendor/tkControls/tkSelectBar"
#import "vendor/tkControls/tkTabControl"
#import "vendor/tkControls/tkTabBar"
#import "vendor/tkControls/tkGroupBox"
#import "vendor/tkControls/tkComboBox"
#import "vendor/tkControls/tkCheckBox"
#import "vendor/tkControls/tkPanel"
#import "vendor/tkControls/tkTheme"
using containers
using cmdids
using tkApp
using tkListTree
using tkTextBox
using tkButton
using tkLabel
using tkSelectBar
using tkTabControl
using tkTabBar
using tkGroupBox
using tkComboBox
using tkCheckBox
using tkPanel
using tkTheme
using tkHost
using tkTest
using tkPaint
using model

' Click into a text box, replace what's there by typing.
private sub TypeInto( byval h as TK_HOST ptr, byval box as TK_WIDGET ptr, byref text as const ustring )
    PressIn( h, box )
    Chord( h, SDLK_A, SDL_SCANCODE_A, TK_KMOD_PRIMARY )
    if len( text ) then
        dim as ustring t = text
        tkTest_PushText( h, t )
    else
        Chord( h, SDLK_DELETE, SDL_SCANCODE_DELETE, 0 )
    end if
    tkTest_PumpFor( h, 40 )
end sub

private function GalleryRow( byval list as TK_WIDGET ptr, byref nm as const ustring ) as long
    for r as long = 0 to tkListTree_GetCount( list ) - 1
        if tkListTree_GetText( list, r ) = nm then return r
    next
    return -1
end function

private sub ClickVariant( byval h as TK_HOST ptr, byval sel as TK_WIDGET ptr, byval idx as long )
    dim as TKRECT rc, a
    tkSelectBar_GetPanelRect( sel, idx, rc )
    tkWidget_AbsRect( sel, a )
    dim as long x = a.left + (rc.left + rc.right) \ 2, y = a.top + (rc.top + rc.bottom) \ 2
    tkTest_PushMotion( h, x, y )
    tkTest_PumpFor( h, 15 )
    tkTest_Click( h, x, y )
    tkTest_PumpFor( h, 40 )
end sub

public sub ThemePass( byref t as Tally, byval sc as single )
    dim as ustring tk = TestCompiler( )
    t.Check( len( tk ) > 0, P( sc, "theme: a tiko compiler ($TKEDIT_TIKO)" ) )
    if len( tk ) = 0 then exit sub
    dim as mainwin.Window mw
    mw.ConfigDir = FreshConfig( )
    mw.Ask = @ScriptedAsk
    mw.Pick = @ScriptedPick
    mw.Launch = @ScriptedLaunch
    t.Check( mw.Create( sc ), P( sc, "theme: main window created" ) )
    if mw.form = 0 then exit sub
    mw.Show( )
    dim as TK_HOST ptr h = tkForm_Host( mw.form )
    tkTest_PumpFor( h, 150 )
    ' builds with the test's compiler, and on Linux the SDL libraries' path (as finishpass)
    mw.Prefs.Tiko = tk
    dim as ustring ldPath = environ( "LD_LIBRARY_PATH" )
    if len( ldPath ) = 0 then ldPath = LinkPathForBuilds( )
    if (platform.CurrentOs( ) = platform.Os.Linux) andalso (len( ldPath ) > 0) then
        for i as long = 0 to mw.Prefs.Builds.Count( ) - 1
            mw.Prefs.Builds[i].Options &= " -p " & ldPath
        next
    end if
    dim as ustring proj = fs.PathJoin( Files( ), "themeproj" & cint( sc * 100 ) )
    fs.RemoveDirAll( proj )
    t.Check( mw.NewFormProject( proj ), P( sc, "theme: a new GUI project" ) )
    tkTest_PumpFor( h, 100 )
    t.Check( mw.CanRun( Cmd.FormTheme ), P( sc, "Form > Project Theme... with a project open" ) )
    mw.Execute( Cmd.FormTheme )
    tkTest_PumpFor( h, 120 )
    dim as themecenter.ThemeDialog ptr dlg = mw.ThemeDlg
    t.Check( (dlg <> 0) andalso (dlg->Win <> 0), P( sc, "the Theme Center opens" ) )
    if (dlg = 0) orelse (dlg->Win = 0) then
        mw.Destroy( )
        exit sub
    end if
    dim as TK_HOST ptr th = tkForm_Host( dlg->Win )
    tkTest_PumpFor( th, 80 )
    t.Check( dlg->Doc.Name = "Default", P( sc, "on the project's appTheme: " & dlg->Doc.Name ) )
    t.Check( tkListTree_GetCount( dlg->Gallery ) = 6, P( sc, "the gallery: six shipped themes, " & tkListTree_GetCount( dlg->Gallery ) ) )
    t.Check( tkTabBar_GetText( tkTabControl_GetTabBar( dlg->Tabs ), 0 ) = "Theme", _
             P( sc, "the first page is Theme: " & tkTabBar_GetText( tkTabControl_GetTabBar( dlg->Tabs ), 0 ) ) )
    t.Check( tkListTree_GetText( dlg->Gallery, tkListTree_GetCurSel( dlg->Gallery ) ) = "Default", P( sc, "the gallery selects the theme being edited" ) )
    ' the check box, option and toggle sit in a group box, inside its frame, between the buttons and the text box
    dim as TKRECT inner
    tkGroupBox_GetClientRect( dlg->PvGroup, inner )
    dim as boolean inBox = true
    dim as TK_WIDGET ptr boxed( 0 to 2 ) = { dlg->PvCheck, dlg->PvOption, dlg->PvToggle }
    for i as long = 0 to 2
        dim as TK_WIDGET ptr w = boxed( i )
        if (w->pParent <> dlg->PvGroup) orelse (w->x < inner.left) orelse (w->y < inner.top) _
           orelse (w->x + w->cw > inner.right) orelse (w->y + w->ch > inner.bottom) then inBox = false
    next
    t.Check( inBox, P( sc, "the preview's check box, option and toggle are inside its group box" ) )
    t.Check( (dlg->PvGroup->y > dlg->PvStyled->y + dlg->PvStyled->ch) andalso (dlg->PvText->y > dlg->PvGroup->y + dlg->PvGroup->ch), _
             P( sc, "the group box sits between the buttons and the text box: " & dlg->PvGroup->y & " " & dlg->PvGroup->ch & " " & dlg->PvText->y ) )
    t.Check( tkGroupBox_GetText( dlg->PvGroup ) = "Options", P( sc, "the group box's caption: " & tkGroupBox_GetText( dlg->PvGroup ) ) )
    dim as TKBUTTON_COLORS bc

    ' ---- an accent: the preview follows, derived as the program will. Before one is typed the box shows
    ' the presets' accent (shown only) and a swatch of it
    dim as ulong presetAccent = tkTheme_Dark( ).Accent
    dim as ustring presetText = "#" & right( "000000" & hex( presetAccent and &hFFFFFFul ), 6 )
    t.Check( (tkTextBox_GetText( dlg->TxtAccent ) = presetText) andalso (len( dlg->Doc.Accent ) = 0), _
             P( sc, "no accent of its own: the box shows the presets', stored nowhere: " & tkTextBox_GetText( dlg->TxtAccent ) ) )
    t.Check( tkPanel_GetBackColor( dlg->AccentSwatch ) = (presetAccent or &hFF000000ul), P( sc, "and its swatch" ) )
    TypeInto( th, dlg->TxtAccent, "#E65100" )
    t.Check( tkPanel_GetBackColor( dlg->AccentSwatch ) = (tkTheme_Derive( tkTheme_Dark( ), &hFFE65100ul ).Accent or &hFF000000ul), _
             P( sc, "a typed accent: the swatch follows: " & hex( tkPanel_GetBackColor( dlg->AccentSwatch ) ) ) )
    t.Check( dlg->Doc.Accent = "#E65100", P( sc, "an accent typed: " & dlg->Doc.Accent ) )
    tkButton_GetColors( dlg->PvButton, @bc )
    t.Check( bc.FocusRingColor = tkTheme_Derive( tkTheme_Dark( ), &hFFE65100ul ).FocusRing, P( sc, "the preview's focus ring is the derived accent: " & hex( bc.FocusRingColor ) ) )
    t.Check( tkTheme_Get( ).Accent <> tkTheme_Derive( tkTheme_Dark( ), &hFFE65100ul ).Accent, P( sc, "tkEdit's own theme is untouched" ) )

    ' ---- moving through the gallery takes each theme: the name, the accent and the preview follow
    dim as long row = GalleryRow( dlg->Gallery, "Ocean" )
    ClickRow( th, dlg->Gallery, row )
    t.Check( (dlg->Doc.Name = "Ocean") andalso (tkTextBox_GetText( dlg->TxtName ) = "Ocean"), P( sc, "Ocean selected: the Name box says so: " & tkTextBox_GetText( dlg->TxtName ) ) )
    t.Check( tkTextBox_GetText( dlg->TxtAccent ) = dlg->Doc.Accent, P( sc, "and the Accent box has its accent: " & tkTextBox_GetText( dlg->TxtAccent ) ) )
    tkButton_GetColors( dlg->PvButton, @bc )
    t.Check( bc.FocusRingColor = tkTheme_Derive( tkTheme_Dark( ), &hFF0277BDul ).FocusRing, P( sc, "and the preview wears it: " & hex( bc.FocusRingColor ) ) )

    ' ---- High Contrast from the gallery: its own AA check passes, in both variants
    row = GalleryRow( dlg->Gallery, "High Contrast" )
    t.Check( row >= 0, P( sc, "High Contrast is in the gallery" ) )
    ClickRow( th, dlg->Gallery, row )
    t.Check( dlg->Doc.Name = "High Contrast", P( sc, "High Contrast selected: " & dlg->Doc.Name ) )
    t.Check( tkLabel_GetText( dlg->LblContrast ) = "Contrast: every pair passes AA", P( sc, "dark: " & tkLabel_GetText( dlg->LblContrast ) ) )
    tkButton_GetColors( dlg->PvButton, @bc )
    t.Check( (bc.BackColor = &hFF000000ul) andalso (bc.BorderColor = &hFFFFFFFFul), _
             P( sc, "the preview wears it, its [controls.Button] border too: " & hex( bc.BackColor ) & " " & hex( bc.BorderColor ) ) )
    ClickVariant( th, dlg->SelVariant, 1 )
    t.Check( dlg->IsDark = false, P( sc, "Light chosen" ) )
    t.Check( tkLabel_GetText( dlg->LblContrast ) = "Contrast: every pair passes AA", P( sc, "light: " & tkLabel_GetText( dlg->LblContrast ) ) )
    tkButton_GetColors( dlg->PvButton, @bc )
    t.Check( (bc.BackColor = &hFFFFFFFFul) andalso (bc.BorderColor = &hFF000000ul), P( sc, "the light variant in the preview: " & hex( bc.BackColor ) ) )

    ' ---- a role in the variant shown, then given back
    tkTabControl_SetCurSel( dlg->Tabs, 1 )
    tkTest_PumpFor( th, 40 )
    ' the box shows the colour in force (High Contrast sets Surface itself) and a swatch of it beside;
    ' selecting a row stores nothing
    dim as ustring rolesBefore = themefile.Render( dlg->Doc )
    ClickRow( th, dlg->Roles, TKROLE_SURFACE )
    dim as ulong inherited = themefile.Resolve( dlg->Doc, false ).Surface
    dim as ustring inheritedText = "#" & right( "000000" & hex( inherited and &hFFFFFFul ), 6 )
    t.Check( tkTextBox_GetText( dlg->TxtRole ) = inheritedText, P( sc, "Surface selected: the box shows its colour: " & tkTextBox_GetText( dlg->TxtRole ) & " want " & inheritedText ) )
    t.Check( themefile.Render( dlg->Doc ) = rolesBefore, P( sc, "selecting a role stores nothing" ) )
    t.Check( dlg->RoleSwatch->isVisible andalso (tkPanel_GetBackColor( dlg->RoleSwatch ) = (inherited or &hFF000000ul)), _
             P( sc, "and the swatch is that colour: " & hex( tkPanel_GetBackColor( dlg->RoleSwatch ) ) ) )
    TypeInto( th, dlg->TxtRole, "#123456" )
    t.Check( tkPanel_GetBackColor( dlg->RoleSwatch ) = &hFF123456ul, P( sc, "a typed colour: the swatch follows" ) )
    t.Check( SettingOr( dlg->Doc.Light.Roles, "Surface" ) = "#123456", P( sc, "a role set in Light: " & SettingOr( dlg->Doc.Light.Roles, "Surface" ) ) )
    tkButton_GetColors( dlg->PvButton, @bc )
    t.Check( bc.BackColor = &hFF123456ul, P( sc, "and the preview's face follows it" ) )
    t.Check( instr( tkLabel_GetText( dlg->LblContrast ), "Text on Surface" ) = 1, P( sc, "a poor pair is reported: " & tkLabel_GetText( dlg->LblContrast ) ) )
    PressIn( th, dlg->BtnRoleReset )
    t.Check( (FindSetting( dlg->Doc.Light.Roles, "Surface" ) >= 0) = false, P( sc, "Reset gives the role back to the theme" ) )
    ' with the role given back, the box shows what the theme now gives it, as #RRGGBB, stored nowhere
    dim as ulong given = themefile.Resolve( dlg->Doc, false ).Surface
    dim as ustring givenText = "#" & right( "000000" & hex( given and &hFFFFFFul ), 6 )
    t.Check( tkTextBox_GetText( dlg->TxtRole ) = givenText, P( sc, "and the box shows the theme's colour: " & tkTextBox_GetText( dlg->TxtRole ) & " want " & givenText ) )
    t.Check( tkPanel_GetBackColor( dlg->RoleSwatch ) = (given or &hFF000000ul), P( sc, "and so does the swatch" ) )

    ' ---- the corner radius, by the keyboard on its spinner
    tkTabControl_SetCurSel( dlg->Tabs, 2 )
    tkTest_PumpFor( th, 40 )
    PressIn( th, dlg->NudRadius )
    Chord( th, SDLK_UP, SDL_SCANCODE_UP, 0 )
    Chord( th, SDLK_UP, SDL_SCANCODE_UP, 0 )
    Chord( th, SDLK_UP, SDL_SCANCODE_UP, 0 )
    tkTest_PumpFor( th, 40 )
    t.Check( dlg->Doc.CornerRadius = 2, P( sc, "corner radius -1 + 3: " & dlg->Doc.CornerRadius ) )
    t.Check( tkButton_GetCornerCurvature( dlg->PvButton ) = tkHost_Scale( th, 4 ), P( sc, "the preview's corners follow: " & tkButton_GetCornerCurvature( dlg->PvButton ) ) )
    ' Build the fonts into the program: on for this project, so the build below embeds them
    t.Check( dlg->ChkEmbed->isVisible, P( sc, "a project's theme offers to build its fonts in" ) )
    PressIn( th, dlg->ChkEmbed )
    t.Check( dlg->Doc.EmbedFonts, P( sc, "ticked: [fonts] embed" ) )

    ' ---- a style: Add, rename, then its role rows (Face, Text, Border, Accent; the rest behind Show all roles).
    ' A row's drop-down is set by SetCurSel plus its change handler: the drop-down is the combo box's own test.
    ' Its items: 0 = from the theme, 1 = a fixed colour, 2 + r = role r. The variant shown is Light here.
    tkTabControl_SetCurSel( dlg->Tabs, 3 )
    tkTest_PumpFor( th, 40 )
    t.Check( dlg->BtnStyleDel->cw >= tkHost_Scale( th, 80 ), P( sc, "Remove has room for its word: " & dlg->BtnStyleDel->cw ) )
    ' master over detail: Add, Remove and Name on one line, the list under them, the role rows under that,
    ' Show all roles last and inside the page (it was clipped)
    t.Check( (dlg->TxtStyleName->y = dlg->BtnStyleAdd->y) andalso (dlg->StyleList->y >= dlg->BtnStyleAdd->y + dlg->BtnStyleAdd->ch), _
             P( sc, "Add, Remove and Name on one line, the list under them" ) )
    t.Check( dlg->StyleFrame->y >= dlg->StyleList->y + dlg->StyleList->ch, P( sc, "the role rows under the list: " & dlg->StyleFrame->y ) )
    t.Check( (dlg->StyleList->cw = dlg->StyleFrame->cw) andalso (dlg->StyleList->ch <= 5 * tkHost_Scale( th, 28 )), _
             P( sc, "a short list, as wide as the rows: " & dlg->StyleList->ch ) )
    t.Check( dlg->ChkAllRoles->y + dlg->ChkAllRoles->ch <= dlg->ChkAllRoles->pParent->ch, _
             P( sc, "Show all roles fits on the page: " & (dlg->ChkAllRoles->y + dlg->ChkAllRoles->ch) & " of " & dlg->ChkAllRoles->pParent->ch ) )
    t.Check( dlg->SrCombo( 1 )->cw >= tkHost_Scale( th, 200 ), P( sc, "a drop-down wide enough for @SelectedText: " & dlg->SrCombo( 1 )->cw ) )
    t.Check( (tkListTree_GetBorderWidth( dlg->StyleList ) = 1) andalso (dlg->StyleRows->pParent = dlg->StyleFrame) _
             andalso (tkPanel_GetBorderStyle( dlg->StyleFrame ) = PNL_BORDER_LINE), P( sc, "the list and the rows each have a line border" ) )
    ' the bottom buttons: Cancel, and every word fits its button (Save to Library was cut short)
    t.Check( tkButton_GetText( dlg->BtnClose ) = "Cancel", P( sc, "the dialog's last button says Cancel: " & tkButton_GetText( dlg->BtnClose ) ) )
    dim as long cut_ = 0
    dim as TK_WIDGET ptr bottoms( 0 to 2 ) = { dlg->BtnLibrary, dlg->BtnSave, dlg->BtnClose }
    for i as long = 0 to 2
        dim as long iw, ih
        tkButton_GetIdealSize( bottoms( i ), iw, ih )
        if iw > bottoms( i )->cw then cut_ += 1
    next
    t.Check( cut_ = 0, P( sc, "Save to Library, Save and Cancel fit their buttons: " & cut_ & " cut" ) )
    PressIn( th, dlg->BtnStyleAdd )
    t.Check( (dlg->Doc.Styles.Count( ) = 1) andalso (dlg->Doc.Styles[0].Name = "Style1"), P( sc, "Add makes Style1" ) )
    TypeInto( th, dlg->TxtStyleName, "Primary" )
    t.Check( dlg->Doc.Styles[0].Name = "Primary", P( sc, "renamed: " & dlg->Doc.Styles[0].Name ) )
    dim as TKTHEME_COLORS lt = themefile.Resolve( dlg->Doc, false )
    tkButton_GetColors( dlg->PvStyled, @bc )
    t.Check( dlg->PvStyled->isVisible andalso (bc.BackColor = lt.Accent), P( sc, "the preview's second button wears it: " & hex( bc.BackColor ) ) )
    t.Check( dlg->PvStyledCheck->isVisible andalso dlg->PvStyledToggle->isVisible, P( sc, "and a check box and a toggle in it" ) )
    t.Check( dlg->SrCombo( 3 )->isVisible andalso (dlg->SrCombo( 4 )->isVisible = false), P( sc, "four role rows shown" ) )
    t.Check( tkComboBox_GetCurSel( dlg->SrCombo( 0 ) ) = 2 + TKROLE_ACCENT, P( sc, "Face reads @Accent: " & tkComboBox_GetCurSel( dlg->SrCombo( 0 ) ) ) )
    t.Check( tkPanel_GetBackColor( dlg->SrSwatch( 0 ) ) = (lt.Accent or &hFF000000ul), P( sc, "and its swatch is the Accent: " & hex( tkPanel_GetBackColor( dlg->SrSwatch( 0 ) ) ) ) )
    t.Check( tkComboBox_GetCurSel( dlg->SrCombo( 2 ) ) = 0, P( sc, "Border is the theme's own" ) )
    ' Face -> @Error
    tkComboBox_SetCurSel( dlg->SrCombo( 0 ), 2 + TKROLE_ERROR )
    dlg->StyleRowChanged( 0 )
    t.Check( SettingOr( dlg->Doc.Styles[0].Roles, "Surface" ) = "@Error", P( sc, "Face set to @Error: " & SettingOr( dlg->Doc.Styles[0].Roles, "Surface" ) ) )
    tkButton_GetColors( dlg->PvStyled, @bc )
    t.Check( bc.BackColor = lt.Error, P( sc, "and the styled button follows: " & hex( bc.BackColor ) ) )
    ' Border -> a fixed colour: the one it shows now, written into the drop-down's item
    tkComboBox_SetCurSel( dlg->SrCombo( 2 ), 1 )
    dlg->StyleRowChanged( 2 )
    dim as ustring fixedBorder = SettingOr( dlg->Doc.Styles[0].Roles, "Border" )
    t.Check( (left( fixedBorder, 1 ) = "#") andalso (tkComboBox_GetItemText( dlg->SrCombo( 2 ), 1 ) = fixedBorder), _
             P( sc, "Border fixed at its colour: " & fixedBorder & " / " & tkComboBox_GetItemText( dlg->SrCombo( 2 ), 1 ) ) )
    t.Check( dlg->SrReset( 2 )->isEnabled, P( sc, "its Reset is on" ) )
    PressIn( th, dlg->SrReset( 2 ) )
    t.Check( (FindSetting( dlg->Doc.Styles[0].Roles, "Border" ) >= 0) = false, P( sc, "Reset gives Border back to the theme" ) )
    t.Check( (tkComboBox_GetCurSel( dlg->SrCombo( 2 ) ) = 0) andalso (dlg->SrReset( 2 )->isEnabled = false), P( sc, "and the row says so" ) )
    ' Show all roles
    PressIn( th, dlg->ChkAllRoles )
    tkTest_PumpFor( th, 30 )
    t.Check( dlg->SrCombo( TKROLE_COUNT - 1 )->isVisible, P( sc, "Show all roles shows all 23 rows" ) )
    dim as long clipped = 0
    for k as long = 0 to TKROLE_COUNT - 1
        dim as long iw, ih
        tkLabel_GetIdealSize( dlg->SrLabel( k ), iw, ih )
        if iw > dlg->SrLabel( k )->cw then clipped += 1
    next
    t.Check( clipped = 0, P( sc, "every role's name fits its label: " & clipped & " clipped" ) )
    PressIn( th, dlg->ChkAllRoles )
    tkTest_PumpFor( th, 30 )
    t.Check( dlg->SrCombo( 4 )->isVisible = false, P( sc, "and unticked, four again" ) )

    ' ---- Save: the theme, its module, and a main that didn't install it made to
    dim as ustring mainPath = fs.PathJoin( proj, "main.tiko" ), none
    dim as ustring nl = wchr( 10 )
    ' main.tiko closed, so its new text is the file's (an open one takes it in its buffer instead)
    dim as DocRef openMain = mw.FindOpen( mainPath )
    if openMain then
        openMain->Main.SetSavePoint( )
        mw.CloseDoc( openMain )
        tkTest_PumpFor( h, 30 )
    end if
    fs.WriteAllText( mainPath, "#import ""vendor/tkControls/tkApp""" & nl & "#import ""./frmMain""" & nl & "using tkApp" & nl & nl _
        & "dim as TKAPP_OPTIONS options" & nl & "if tkApp_Init( options ) = false then end 1" & nl & "dim as frmMain.Form mainForm" & nl _
        & "mainForm.Build( )" & nl & "end tkApp_Run( mainForm.Wnd )" & nl )
    dim as ustring docText = themefile.Render( dlg->Doc )
    PressIn( th, dlg->BtnSave )
    tkTest_PumpFor( h, 60 )
    t.Check( mw.ThemeDlg = 0, P( sc, "Save closes the dialog" ) )
    dim as ustring themePath = fs.PathJoin( proj, "appTheme", "appTheme.tktheme" )
    dim as ustring saved = fs.ReadAllText( themePath ).ValueOr( none )
    t.Check( saved = docText, P( sc, "Save writes the theme" ) )
    t.Check( instr( fs.ReadAllText( fs.PathJoin( proj, "appTheme", "appTheme.design.tiko" ) ).ValueOr( none ), "gStyles_( 0 ).Name = ""Primary""" ) > 0, _
             P( sc, "and its module" ) )
    dim as ustring mainNow = fs.ReadAllText( mainPath ).ValueOr( none )
    t.Check( (instr( mainNow, "appTheme.ApplyOptions( options )" ) > 0) andalso (instr( mainNow, "appTheme.Install( )" ) > 0) _
             andalso (instr( mainNow, "#import ""./appTheme""" ) > 0), P( sc, "and main.tiko installs it" ) )
    ' the four fonts copied beside the module, and embedded from there
    dim as ustring fontsDir = fs.PathJoin( proj, "appTheme", "fonts" )
    t.Check( fs.IsFile( fs.PathJoin( fontsDir, "Inter-Regular.ttf" ) ) andalso fs.IsFile( fs.PathJoin( fontsDir, "Inter-Bold.ttf" ) ) _
             andalso fs.IsFile( fs.PathJoin( fontsDir, "FluentSystemIcons-Regular.ttf" ) ) andalso fs.IsFile( fs.PathJoin( fontsDir, "CascadiaMono-Regular.ttf" ) ), _
             P( sc, "Save copies the four fonts into appTheme/fonts" ) )
    t.Check( instr( fs.ReadAllText( fs.PathJoin( proj, "appTheme", "appTheme.design.tiko" ) ).ValueOr( none ), "#embed gFont0_ ""fonts/Inter-Regular.ttf""" ) > 0, _
             P( sc, "and the module embeds them" ) )
    mw.StartBuild( build.BuildAction.Compile, false )
    dim as boolean waited = WaitBuild( mw )
    t.Check( waited andalso mw.BuildSucceeded, P( sc, "the project builds with it: " & right( mw.BuildRaw, 400 ) ) )

    ' ---- open again: it reads what Save wrote
    mw.Execute( Cmd.FormTheme )
    tkTest_PumpFor( h, 80 )
    dlg = mw.ThemeDlg
    t.Check( (dlg <> 0) andalso (dlg->Win <> 0), P( sc, "the Theme Center opens again" ) )
    if (dlg = 0) orelse (dlg->Win = 0) then
        mw.Destroy( )
        exit sub
    end if
    th = tkForm_Host( dlg->Win )
    tkTest_PumpFor( th, 60 )
    t.Check( themefile.Render( dlg->Doc ) = saved, P( sc, "on the theme Save wrote" ) )

    ' ---- Save to Library: a shipped theme's name is refused; a new name makes a copy the gallery lists
    PressIn( th, dlg->BtnLibrary )
    tkTest_PumpFor( th, 40 )
    t.Check( fs.IsFile( fs.PathJoin( mw.ConfigDir, "themes", "High Contrast.tktheme" ) ) = false, P( sc, "Save to Library refuses a shipped theme's name" ) )
    t.Check( instr( tkLabel_GetText( dlg->LblContrast ), "already a theme named 'High Contrast'" ) > 0, P( sc, "and says so: " & tkLabel_GetText( dlg->LblContrast ) ) )
    t.Check( tkListTree_GetCount( dlg->Gallery ) = 6, P( sc, "the gallery is unchanged: " & tkListTree_GetCount( dlg->Gallery ) ) )
    TypeInto( th, dlg->TxtName, "My Contrast" )
    PressIn( th, dlg->BtnLibrary )
    tkTest_PumpFor( th, 40 )
    t.Check( fs.IsFile( fs.PathJoin( mw.ConfigDir, "themes", "My Contrast.tktheme" ) ), P( sc, "Save to Library" ) )
    t.Check( tkListTree_GetCount( dlg->Gallery ) = 7, P( sc, "and the gallery has it: " & tkListTree_GetCount( dlg->Gallery ) ) )
    PressIn( th, dlg->BtnLibrary )
    tkTest_PumpFor( th, 40 )
    t.Check( tkListTree_GetCount( dlg->Gallery ) = 7, P( sc, "saving it again updates its copy: " & tkListTree_GetCount( dlg->Gallery ) ) )
    ' a library file named like a shipped theme (tkEdit's own copy of one) is not listed twice
    fs.WriteAllText( fs.PathJoin( mw.ConfigDir, "themes", "Default.tktheme" ), "format = 1" & wchr( 10 ) & "name = ""Default""" & wchr( 10 ) )
    dlg->FillGallery( )
    t.Check( tkListTree_GetCount( dlg->Gallery ) = 7, P( sc, "a library Default isn't listed beside the shipped one: " & tkListTree_GetCount( dlg->Gallery ) ) )
    t.Check( fs.ReadAllText( themePath ).ValueOr( none ) = saved, P( sc, "the project's file is where it was" ) )

    ' ---- Cancel: closes, and the rename to My Contrast is not written
    PressIn( th, dlg->BtnClose )
    tkTest_PumpFor( h, 40 )
    t.Check( mw.ThemeDlg = 0, P( sc, "Cancel closes the dialog" ) )
    t.Check( fs.ReadAllText( themePath ).ValueOr( none ) = saved, P( sc, "and saves nothing" ) )

    ' ---- again: Close, then the window's own close button, then a third open (a freed form was
    ' shown on the second open when the close button had been used)
    mw.Execute( Cmd.FormTheme )
    tkTest_PumpFor( h, 80 )
    t.Check( (mw.ThemeDlg <> 0) andalso (mw.ThemeDlg->Win <> 0), P( sc, "the Theme Center opens a second time" ) )
    if (mw.ThemeDlg <> 0) andalso (mw.ThemeDlg->Win <> 0) then
        tkForm_Close( mw.ThemeDlg->Win )       ' what the title bar's X does
        for k as long = 1 to 5
            tkApp_Pump( )
        next
        t.Check( mw.ThemeDlg = 0, P( sc, "the window's close button closes it, and tkEdit hears so" ) )
    end if
    mw.Execute( Cmd.FormTheme )
    tkTest_PumpFor( h, 80 )
    t.Check( (mw.ThemeDlg <> 0) andalso (mw.ThemeDlg->Win <> 0), P( sc, "and it opens a third time" ) )
    if mw.ThemeDlg then
        PressIn( tkForm_Host( mw.ThemeDlg->Win ), mw.ThemeDlg->BtnClose )
        tkTest_PumpFor( h, 40 )
    end if
    t.Check( mw.ThemeDlg = 0, P( sc, "closed again" ) )
    for each dd as DocRef in mw.Docs
        dd->Main.SetSavePoint( )
    next
    mw.Destroy( )
end sub
