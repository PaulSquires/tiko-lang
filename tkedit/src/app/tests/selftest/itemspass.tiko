' itemspass -- the Form Designer's editor for menus, toolbars, status bars, columns, combo items and
' tab pages, through real events. The window is driven open, not modally, so this pass can go on.
#module "selftest"

#import "std/containers"
#import "std/fs"
#import "std/strings"
#import "tkc/cmdids"
#import "tka/documents"
#import "tka/mainwin"
#import "tkd/canvas"
#import "tkd/catalog"
#import "tkd/itemsdlg"
#import "tkd/model"
#import "tkd/panels"
#import "vendor/tkControls/tkApp"
#import "vendor/tkControls/tkTest"
#import "vendor/tkControls/tkPaint"
#import "vendor/tkControls/tkListTree"
#import "vendor/tkControls/tkTextBox"
#import "vendor/tkControls/tkMenuBar"
#import "vendor/tkControls/tkToolbar"
#import "vendor/tkControls/tkStatusBar"
#import "vendor/tkControls/tkComboBox"
#import "vendor/tkControls/tkTabControl"
#import "vendor/tkControls/tkLayout"
#import "vendor/tkControls/tkGroupBox"
#import "vendor/tkControls/tkCheckBox"
#import "vendor/tkControls/tkButton"
using containers
using cmdids
using tkApp
using tkHost
using tkTest
using tkPaint
using tkListTree
using tkGroupBox
using tkCheckBox
using tkButton
using tkTextBox
using tkMenuBar
using tkToolbar
using tkStatusBar
using tkComboBox
using tkTabControl
using tkLayout
using model

dim shared as ustring gItemsAsked
dim shared as ustring gItemsEvent

private sub RecordItems( byval o as any ptr, byval c as canvas.FormCanvas ptr, byref n as const ustring, byref e as const ustring, byval jump as boolean )
    gItemsAsked = n
    gItemsEvent = e
end sub

private sub PressIn( byval h as TK_HOST ptr, byval w as TK_WIDGET ptr )
    tkTest_PushMotion( h, tkTest_CX( w ), tkTest_CY( w ) )
    tkTest_PumpFor( h, 15 )
    tkTest_Click( h, tkTest_CX( w ), tkTest_CY( w ) )
    tkTest_PumpFor( h, 30 )
end sub

' The dialog's field for key_, cleared and typed into.
private sub TypeField( byval h as TK_HOST ptr, byval d as itemsdlg.ItemsEditor ptr, byref key_ as const ustring, byref text as ustring )
    for each f as itemsdlg.ItemField in d->Fields
        if f.Key = key_ then
            PressIn( h, f.Edit )
            Chord( h, SDLK_A, SDL_SCANCODE_A, TK_KMOD_PRIMARY )
            tkTest_PushText( h, text )
            tkTest_PumpFor( h, 30 )
        end if
    next
end sub

' The Stretch check box of an items editor (status bars only).
private function stretchBoxOf( byval d as itemsdlg.ItemsEditor ptr ) as TK_WIDGET ptr
    for each f as itemsdlg.ItemField in d->Fields
        if f.Key = "Stretch" then return f.Edit
    next
    return 0
end function

public sub ItemsPass( byref t as Tally, byval sc as single )
    dim as mainwin.Window mw
    mw.ConfigDir = FreshConfig( )
    mw.Ask = @ScriptedAsk
    mw.Pick = @ScriptedPick
    t.Check( mw.Create( sc ), P( sc, "items: main window created" ) )
    if mw.form = 0 then exit sub
    mw.Show( )
    dim as TK_HOST ptr h = tkForm_Host( mw.form )
    tkTest_PumpFor( h, 150 )
    dim as ustring dir_ = fs.PathJoin( Files( ), "items" & cint( sc * 100 ) )
    fs.RemoveDirAll( dir_ )
    fs.CreateDirAll( dir_ )
    dim as ustring path = fs.PathJoin( dir_, "frmI.tkform" )
    dim as ustring nl = wchr( 10 )
    fs.WriteAllText( path, "format = 1" & nl & nl & "[form]" & nl & "caption = ""I""" & nl & "width = 400" & nl & "height = 300" & nl )
    mw.OpenFile( path )
    tkTest_PumpFor( h, 100 )
    dim as DocRef d = mw.FindOpen( path )
    dim as canvas.FormCanvas ptr c = d->Designer
    if c = 0 then
        t.Check( false, P( sc, "items: a surface" ) )
        mw.Destroy( )
        exit sub
    end if
    dim as panels.DesignPanels ptr ps = @mw.Palettes

    ' ---- a menu bar docks itself along the top, a status bar along the bottom
    dim as TKRECT rs = c->SurfaceRect( ), rg
    tkWidget_AbsRect( c->Glass, rg )
    dim as long ox = rg.left + rs.left, oy = rg.top + rs.top
    ' a menu bar just placed asks for its editor at once, marked "new" (the host seeds it with the
    ' standard menu and runs it modally -- recorded here instead)
    dim as canvas.CanvasWireSub keepPlace = c->OnEditItems
    c->OnEditItems = @RecordItems
    gItemsAsked = ""
    gItemsEvent = ""
    c->Tool = "MenuBar"
    ClickPx( h, ox + tkHost_Scale( h, 100 ), oy + tkHost_Scale( h, 100 ) )
    tkTest_PumpFor( h, 60 )
    dim as long i = FindControl( c->Doc, "MenuBar1" )
    t.Check( i >= 0, P( sc, "a menu bar placed" ) )
    t.Check( c->Doc.Controls[i].Dock = TK_DOCK_TOP, P( sc, "docked top by itself" ) )
    t.Check( (gItemsAsked = "MenuBar1") andalso (gItemsEvent = "new"), P( sc, "and its editor asked for, new: " & gItemsAsked & " " & gItemsEvent ) )
    gItemsAsked = ""
    c->Tool = "StatusBar"
    ClickPx( h, ox + tkHost_Scale( h, 100 ), oy + tkHost_Scale( h, 150 ) )
    tkTest_PumpFor( h, 60 )
    t.Check( c->Doc.Controls[FindControl( c->Doc, "StatusBar1" )].Dock = TK_DOCK_BOTTOM, P( sc, "a status bar docked bottom" ) )
    t.Check( gItemsAsked = "", P( sc, "a status bar opens no editor by itself" ) )
    c->OnEditItems = keepPlace

    ' the inspector's row asks to edit the selected control's entries
    c->SelectOnly( "MenuBar1" )
    tkTest_PumpFor( h, 60 )
    dim as long row = -1
    for r as long = 0 to ps->Rows.Count( ) - 1
        if ps->Rows[r].Key = "@Items" then row = r
    next
    t.Check( row >= 0, P( sc, "an Edit items row" ) )
    dim as canvas.CanvasWireSub keep = c->OnEditItems
    c->OnEditItems = @RecordItems
    gItemsAsked = ""
    if row >= 0 then PressIn( h, ps->Rows[row].Edit )
    t.Check( gItemsAsked = "MenuBar1", P( sc, "its button asks for that control: " & gItemsAsked ) )
    c->OnEditItems = keep
    Chord( h, SDLK_ESCAPE, SDL_SCANCODE_ESCAPE, 0 )

    ' ---- the editor: File > Open, a separator, Exit
    dim as ustring text0 = d->Text( )
    mw.OpenItems( c, "MenuBar1" )
    tkTest_PumpFor( h, 80 )
    dim as itemsdlg.ItemsEditor ptr dlg = mw.ItemsDlg
    t.Check( dlg <> 0, P( sc, "the editor opens" ) )
    if dlg = 0 then
        mw.Destroy( )
        exit sub
    end if
    dim as TK_HOST ptr dh = tkForm_Host( dlg->Win )
    t.Check( dlg->BtnIn <> 0, P( sc, "a menu can be indented" ) )
    ' the layout: a bordered list with Up, Down, Outdent, Indent under it; Add and Remove above the
    ' group box of fields; the buttons are glyphs the glyph font holds, their words as tooltips
    t.Check( tkListTree_GetBorderWidth( dlg->List ) = 1, P( sc, "the list has a border" ) )
    dim as long ly = dlg->List->y + dlg->List->ch
    t.Check( (dlg->BtnUp->y > ly) andalso (dlg->BtnDown->y = dlg->BtnUp->y) andalso (dlg->BtnOut->y = dlg->BtnUp->y) andalso (dlg->BtnIn->y = dlg->BtnUp->y) _
             andalso (dlg->BtnUp->x < dlg->BtnDown->x) andalso (dlg->BtnDown->x < dlg->BtnOut->x) andalso (dlg->BtnOut->x < dlg->BtnIn->x), _
             P( sc, "Up, Down, Outdent, Indent in a row under the list" ) )
    t.Check( (dlg->BtnAdd->y + dlg->BtnAdd->ch <= dlg->Group->y) andalso (dlg->BtnDel->y = dlg->BtnAdd->y) andalso (dlg->BtnAdd->x >= dlg->List->x + dlg->List->cw), _
             P( sc, "Add and Remove above the group box, right of the list" ) )
    dim as boolean inGroup = true
    for each f as itemsdlg.ItemField in dlg->Fields
        if (f.Edit->pParent <> dlg->Group) orelse (f.Label->pParent <> dlg->Group) then inGroup = false
    next
    t.Check( inGroup, P( sc, "the fields are in the group box" ) )
    dim as TTF_Font ptr gf = tkForm_Font( dlg->Win, TKFONT_GLYPH_LARGE )
    t.Check( (gf <> 0) andalso TTF_FontHasGlyph( gf, itemsdlg.GLYPH_ADD ) andalso TTF_FontHasGlyph( gf, itemsdlg.GLYPH_DELETE ) _
             andalso TTF_FontHasGlyph( gf, itemsdlg.GLYPH_UP ) andalso TTF_FontHasGlyph( gf, itemsdlg.GLYPH_DOWN ) _
             andalso TTF_FontHasGlyph( gf, itemsdlg.GLYPH_LEFT ) andalso TTF_FontHasGlyph( gf, itemsdlg.GLYPH_RIGHT ), _
             P( sc, "the six glyphs are in the glyph font" ) )
    t.Check( (tkButton_GetTooltipText( dlg->BtnAdd ) = "Add") andalso (tkButton_GetTooltipText( dlg->BtnIn ) = "Indent"), P( sc, "with their words as tooltips" ) )
    PressIn( dh, dlg->BtnAdd )
    t.Check( dlg->Items.Count( ) = 1, P( sc, "Add adds" ) )
    dim as ustring s = "File"
    TypeField( dh, dlg, "Text", s )
    t.Check( dlg->Items[0].Text = "File", P( sc, "the field edits the item: " & dlg->Items[0].Text ) )
    t.Check( tkListTree_GetText( dlg->List, 0 ) = "File", P( sc, "and the list shows it" ) )
    t.Check( tkGroupBox_GetText( dlg->Group ) = "File", P( sc, "and the group box is titled with it: " & tkGroupBox_GetText( dlg->Group ) ) )
    PressIn( dh, dlg->BtnAdd )
    s = "Open"
    TypeField( dh, dlg, "Text", s )
    PressIn( dh, dlg->BtnIn )
    t.Check( dlg->Items[1].Level = 1, P( sc, "Indent" ) )
    s = "Primary+O"
    TypeField( dh, dlg, "Key", s )
    s = "OnOpen"
    TypeField( dh, dlg, "Handler", s )
    t.Check( (dlg->Items[1].Key = "Primary+O") andalso (dlg->Items[1].Handler = "OnOpen"), P( sc, "a shortcut and a handler" ) )
    PressIn( dh, dlg->BtnAdd )
    s = "Exit"
    TypeField( dh, dlg, "Text", s )
    t.Check( dlg->Items[2].Level = 1, P( sc, "a new item takes the level of the one before" ) )
    PressIn( dh, dlg->BtnUp )
    t.Check( dlg->Items[1].Text = "Exit", P( sc, "Up" ) )
    PressIn( dh, dlg->BtnDown )
    t.Check( dlg->Items[2].Text = "Exit", P( sc, "Down" ) )
    ' a throwaway, removed
    PressIn( dh, dlg->BtnAdd )
    PressIn( dh, dlg->BtnDel )
    t.Check( dlg->Items.Count( ) = 3, P( sc, "Remove" ) )

    PressIn( dh, dlg->BtnOk )
    t.Check( dlg->Accepted, P( sc, "OK accepts" ) )
    mw.FinishItems( true )
    tkTest_PumpFor( h, 80 )
    i = FindControl( c->Doc, "MenuBar1" )
    t.Check( c->Doc.Controls[i].Items.Count( ) = 3, P( sc, "the entries are in the form" ) )
    t.Check( tkMenuBar_GetItemCount( c->WidgetOf( "MenuBar1" ) ) = 1, P( sc, "and the surface's bar shows File" ) )
    dim as DocRef code = mw.FindOpen( fs.PathJoin( dir_, "frmI.tiko" ) )
    t.Check( (code <> 0) andalso (instr( code->Text( ), "sub Form.OnOpen( )" ) > 0), P( sc, "a named handler gets a body" ) )
    t.Check( mw.Active( ) = d, P( sc, "and the form stays in front" ) )
    Chord( h, SDLK_Z, SDL_SCANCODE_Z, TK_KMOD_PRIMARY )
    tkTest_PumpFor( h, 50 )
    t.Check( d->Text( ) = text0, P( sc, "one undo takes it all back" ) )
    Chord( h, SDLK_Z, SDL_SCANCODE_Z, TK_KMOD_PRIMARY or SDL_KMOD_SHIFT )
    tkTest_PumpFor( h, 50 )

    ' ---- Cancel changes nothing
    dim as ustring text1 = d->Text( )
    mw.OpenItems( c, "MenuBar1" )
    tkTest_PumpFor( h, 60 )
    PressIn( tkForm_Host( mw.ItemsDlg->Win ), mw.ItemsDlg->BtnAdd )
    PressIn( tkForm_Host( mw.ItemsDlg->Win ), mw.ItemsDlg->BtnCancel )
    t.Check( mw.ItemsDlg->Accepted = false, P( sc, "Cancel" ) )
    mw.FinishItems( false )
    tkTest_PumpFor( h, 50 )
    t.Check( d->Text( ) = text1, P( sc, "changes nothing" ) )

    ' ---- a second menu bar: its editor seeded with the standard menu (what placing one opens), then OK
    c->OnEditItems = @RecordItems
    c->Tool = "MenuBar"
    ClickPx( h, ox + tkHost_Scale( h, 100 ), oy + tkHost_Scale( h, 120 ) )
    tkTest_PumpFor( h, 60 )
    c->OnEditItems = keepPlace
    t.Check( gItemsAsked = "MenuBar2", P( sc, "a second menu bar asks too: " & gItemsAsked ) )
    mw.OpenItems( c, "MenuBar2" )
    tkTest_PumpFor( h, 60 )
    mw.ItemsDlg->SeedDefaults( )
    dim as itemsdlg.ItemsEditor ptr sd = mw.ItemsDlg
    t.Check( (sd->Items.Count( ) = 18) andalso (sd->Items[0].Text = "File") andalso (sd->Items[0].Level = 0), P( sc, "seeded: File first, " & sd->Items.Count( ) & " entries" ) )
    t.Check( (sd->Items[1].Text = "New") andalso (sd->Items[1].Level = 1) andalso (sd->Items[1].Key = "Primary+N"), P( sc, "File > New, Primary+N" ) )
    t.Check( (sd->Items[5].Text = "-") andalso (sd->Items[7].Text = "Edit") andalso (sd->Items[16].Text = "Help"), P( sc, "a separator, then Edit, then Help" ) )
    t.Check( tkGroupBox_GetText( sd->Group ) = "File", P( sc, "the first entry selected: " & tkGroupBox_GetText( sd->Group ) ) )
    ' a separator has no Shortcut or Handler: both boxes off and empty; a command's are on
    dim as TK_WIDGET ptr keyBox = 0, handlerBox = 0
    for each f as itemsdlg.ItemField in sd->Fields
        if f.Key = "Key" then keyBox = f.Edit
        if f.Key = "Handler" then handlerBox = f.Edit
    next
    sd->ShowItem( 5 )
    t.Check( (keyBox->isEnabled = false) andalso (handlerBox->isEnabled = false), P( sc, "a separator's Shortcut and Handler are off" ) )
    sd->ShowItem( 1 )
    t.Check( keyBox->isEnabled andalso handlerBox->isEnabled andalso (tkTextBox_GetText( keyBox ) = "Primary+N"), P( sc, "a command's are on" ) )
    ' New typed into a separator: its shortcut goes, and the boxes turn off
    dim as ustring sepText = "-"
    TypeField( tkForm_Host( sd->Win ), sd, "Text", sepText )
    t.Check( (sd->Items[1].Text = "-") andalso (sd->Items[1].Key = "") andalso (sd->Items[1].Handler = ""), P( sc, "made a separator: its shortcut is dropped: " & sd->Items[1].Key ) )
    t.Check( (tkTextBox_GetText( keyBox ) = "") andalso (keyBox->isEnabled = false), P( sc, "and its Shortcut box is empty and off" ) )
    PressIn( tkForm_Host( sd->Win ), sd->BtnOk )
    mw.FinishItems( true )
    tkTest_PumpFor( h, 80 )
    t.Check( c->Doc.Controls[FindControl( c->Doc, "MenuBar2" )].Items.Count( ) = 18, P( sc, "OK puts them in the form" ) )
    t.Check( tkMenuBar_GetItemCount( c->WidgetOf( "MenuBar2" ) ) = 3, P( sc, "and the bar shows File, Edit, Help: " & tkMenuBar_GetItemCount( c->WidgetOf( "MenuBar2" ) ) ) )
    ' seeding never replaces entries a menu already has
    mw.OpenItems( c, "MenuBar1" )
    tkTest_PumpFor( h, 40 )
    dim as long had = mw.ItemsDlg->Items.Count( )
    mw.ItemsDlg->SeedDefaults( )
    t.Check( mw.ItemsDlg->Items.Count( ) = had, P( sc, "a menu with entries isn't seeded" ) )
    mw.FinishItems( false )
    tkTest_PumpFor( h, 40 )

    ' ---- a bad shortcut is refused
    text1 = d->Text( )                 ' the form as it now stands, MenuBar2 included
    mw.OpenItems( c, "MenuBar1" )
    tkTest_PumpFor( h, 60 )
    mw.ItemsDlg->Items[1].Key = "Banana+Q"
    mw.FinishItems( true )
    tkTest_PumpFor( h, 50 )
    t.Check( d->Text( ) = text1, P( sc, "a bad shortcut is refused" ) )
    t.Check( instr( mw.Message, "shortcut" ) > 0, P( sc, "with a message: " & mw.Message ) )

    ' ---- a combo's items, a status bar's panels: each with its own fields
    c->Tool = "ComboBox"
    ClickPx( h, ox + tkHost_Scale( h, 100 ), oy + tkHost_Scale( h, 100 ) )
    tkTest_PumpFor( h, 60 )
    mw.OpenItems( c, "ComboBox1" )
    tkTest_PumpFor( h, 60 )
    t.Check( (mw.ItemsDlg->Fields.Count( ) = 1) andalso (mw.ItemsDlg->BtnIn = 0), P( sc, "a combo's items have only text" ) )
    dim as FormItem it1
    it1.Text = "One"
    mw.ItemsDlg->Items.Push( it1 )
    mw.FinishItems( true )
    tkTest_PumpFor( h, 60 )
    t.Check( tkComboBox_GetCount( c->WidgetOf( "ComboBox1" ) ) = 1, P( sc, "the real combo has it" ) )
    mw.OpenItems( c, "StatusBar1" )
    tkTest_PumpFor( h, 60 )
    ' a panel: Text, Width, a Handler for its clicks, and Stretch (stretching panels share the spare width)
    dim as itemsdlg.ItemsEditor ptr sbd = mw.ItemsDlg
    t.Check( sbd->Fields.Count( ) = 4, P( sc, "a status panel has text, width, handler and Stretch: " & sbd->Fields.Count( ) ) )
    dim as TK_HOST ptr sh = tkForm_Host( sbd->Win )
    dim as TK_WIDGET ptr stretchBox = 0
    for each f as itemsdlg.ItemField in sbd->Fields
        if f.Key = "Stretch" then stretchBox = f.Edit
    next
    PressIn( sh, sbd->BtnAdd )
    dim as ustring sv = "Ready"
    TypeField( sh, sbd, "Text", sv )
    PressIn( sh, sbd->BtnAdd )
    sv = "Line 1"
    TypeField( sh, sbd, "Text", sv )
    sv = "OnLinePanel"
    TypeField( sh, sbd, "Handler", sv )
    PressIn( sh, stretchBox )
    t.Check( sbd->Items[1].Stretch andalso (sbd->Items[0].Stretch = false), P( sc, "Stretch ticked on the second panel" ) )
    sbd->ShowItem( 0 )
    PressIn( sh, stretchBox )
    t.Check( sbd->Items[0].Stretch andalso sbd->Items[1].Stretch, P( sc, "ticked on the first too: both stretch" ) )
    PressIn( sh, sbd->BtnOk )
    mw.FinishItems( true )
    tkTest_PumpFor( h, 60 )
    dim as long sbi = FindControl( c->Doc, "StatusBar1" )
    t.Check( tkStatusBar_GetCount( c->WidgetOf( "StatusBar1" ) ) = 2, P( sc, "the real status bar has them" ) )
    t.Check( FindSetting( c->Doc.Controls[sbi].Props, "ExpandPanel" ) < 0, P( sc, "no ExpandPanel property: Stretch is the panels' own" ) )
    t.Check( (c->Doc.Controls[sbi].Items.Count( ) = 2) andalso c->Doc.Controls[sbi].Items[0].Stretch andalso c->Doc.Controls[sbi].Items[1].Stretch _
             andalso (c->Doc.Controls[sbi].Items[1].Handler = "OnLinePanel"), P( sc, "the form keeps both stretches and the handler" ) )
    t.Check( instr( d->Text( ), "stretch = true" ) > 0, P( sc, "written to the .tkform" ) )
    t.Check( tkStatusBar_GetPanelStretch( c->WidgetOf( "StatusBar1" ), 0 ) andalso tkStatusBar_GetPanelStretch( c->WidgetOf( "StatusBar1" ), 1 ), _
             P( sc, "and the surface's bar stretches both" ) )
    dim as DocRef sbCode = mw.FindOpen( fs.PathJoin( dir_, "frmI.tiko" ) )
    t.Check( (sbCode <> 0) andalso (instr( sbCode->Text( ), "sub Form.OnLinePanel( byval clicks as long )" ) > 0), P( sc, "the panel's handler gets a body that is told the clicks" ) )
    ' opened again, the first panel shows Stretch
    mw.OpenItems( c, "StatusBar1" )
    tkTest_PumpFor( h, 40 )
    mw.ItemsDlg->ShowItem( 0 )
    t.Check( tkCheckBox_GetChecked( stretchBoxOf( mw.ItemsDlg ) ), P( sc, "reopened: the first panel's Stretch is ticked" ) )
    mw.FinishItems( false )
    tkTest_PumpFor( h, 40 )

    ' ---- tab pages: controls go with their page, and a page in use can't go
    c->Tool = "TabControl"
    ClickPx( h, ox + tkHost_Scale( h, 40 ), oy + tkHost_Scale( h, 150 ) )
    tkTest_PumpFor( h, 60 )
    mw.OpenItems( c, "TabControl1" )
    tkTest_PumpFor( h, 60 )
    t.Check( mw.ItemsDlg->Items.Count( ) = 1, P( sc, "a new tab control has one page" ) )
    dim as FormItem pg
    pg.Text = "Second"
    pg.Origin = -1
    mw.ItemsDlg->Items.Push( pg )
    mw.FinishItems( true )
    tkTest_PumpFor( h, 60 )
    t.Check( tkTabControl_GetPageCount( c->WidgetOf( "TabControl1" ) ) = 2, P( sc, "two pages on the real control" ) )
    c->Tool = "Button"
    dim as TKRECT rpg
    tkWidget_AbsRect( tkTabControl_GetPage( c->WidgetOf( "TabControl1" ), 0 ), rpg )
    ClickPx( h, rpg.left + tkHost_Scale( h, 8 ), rpg.top + tkHost_Scale( h, 8 ) )
    tkTest_PumpFor( h, 60 )
    t.Check( c->Doc.Controls[FindControl( c->Doc, "Button1" )].Page = 0, P( sc, "a button on the first page" ) )
    mw.OpenItems( c, "TabControl1" )
    tkTest_PumpFor( h, 60 )
    dim as FormItem a0 = mw.ItemsDlg->Items[0]
    mw.ItemsDlg->Items[0] = mw.ItemsDlg->Items[1]
    mw.ItemsDlg->Items[1] = a0
    mw.FinishItems( true )
    tkTest_PumpFor( h, 60 )
    t.Check( c->Doc.Controls[FindControl( c->Doc, "Button1" )].Page = 1, P( sc, "swapping pages moves the button with its page" ) )
    dim as ustring text2 = d->Text( )
    mw.OpenItems( c, "TabControl1" )
    tkTest_PumpFor( h, 60 )
    mw.ItemsDlg->Items.Remove( 1 )
    mw.FinishItems( true )
    tkTest_PumpFor( h, 50 )
    t.Check( d->Text( ) = text2, P( sc, "a page that holds controls can't go" ) )
    t.Check( instr( mw.Message, "still holds" ) > 0, P( sc, "and says so: " & mw.Message ) )

    ' ---- a deleted menu takes its handlers' empty bodies
    c->SelectOnly( "MenuBar1" )
    tkTest_PumpFor( h, 30 )
    tkHost_SetFocus( h, c->Glass )
    Chord( h, SDLK_DELETE, SDL_SCANCODE_DELETE, 0 )
    t.Check( instr( code->Text( ), "OnOpen" ) = 0, P( sc, "deleting a menu removes its empty handlers" ) )

    for each dd as DocRef in mw.Docs
        dd->Main.SetSavePoint( )
    next
    mw.Destroy( )
end sub
