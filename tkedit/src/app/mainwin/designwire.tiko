' designwire -- the Form Designer's joins to the code: handlers made and jumped to, renames carried
' through, the generated file written. Every change to code goes through its open buffer, never the
' disk: the disk watcher reloads with SetText, and that would take the person's undo with it.
#module "mainwin"

#import "std/containers"
#import "std/fs"
#import "std/strings"
#import "tkc/i18n"
#import "tkc/docencoding"
#import "tkc/project"
#import "tkc/themes"
#import "tka/documents"
#import "tks/parser"
#import "tkd/canvas"
#import "tkd/catalog"
#import "tkd/model"
#import "tkd/edits"
#import "tkd/validate"
#import "tkd/formfile"
#import "tkd/codegen"
#import "tkd/reconcile"
#import "tkd/itemsdlg"
#import "tkd/themefile"
#import "tkd/resfile"
#import "tkd/resdlg"
#import "tkd/themecenter"
#import "tkd/colorsdlg"
#import "vendor/tkControls/tkMeta"
#import "vendor/tkControls/tkApp"
#import "vendor/tkControls/tkLayout"
#import "vendor/tkControls/tkFileDialog"
#import "vendor/tkControls/tkMessageBox"
using containers
using tkMeta
using tkApp
using tkHost
using tkLayout
using tkFileDialog
using tkMessageBox
using model

private function CodePathOf_( byref formPath as const ustring ) as ustring
    return left( formPath, len( formPath ) - 7 ) & ".tiko"
end function

private function DesignPathOf_( byref formPath as const ustring ) as ustring
    return left( formPath, len( formPath ) - 7 ) & ".design.tiko"
end function

function Window.DocOfCanvas( byval c as canvas.FormCanvas ptr ) as DocRef
    for each d as DocRef in Docs
        if d->Designer = c then return d
    next
    return 0
end function

' Opens path in a buffer without showing it, or finds the one it's in.
function Window.OpenQuietly( byref path as const ustring ) as DocRef
    dim as DocRef have = this.FindOpen( path )
    if have then return have
    dim as DocRef d = this.NewDocument( )
    if d = 0 then return 0
    untitled -= 1
    dim as documents.TextResult r = d->Load( path )
    if r.IsOk( ) = false then
        Docs.Pop( )
        d->DestroyViews( )
        delete d
        return 0
    end if
    this.LayoutTabs( )
    this.Layout( )
    return d
end function

' The form's file of code, in a buffer; created if there's none yet.
function Window.CodeDocOf( byval formDoc as DocRef ) as DocRef
    dim as ustring path = CodePathOf_( formDoc->Path )
    if (this.FindOpen( path ) = 0) andalso (fs.IsFile( path ) = false) then
        if fs.WriteAllText( path, reconcile.NewCodeFile( fs.PathStem( formDoc->Path ) ) ).IsOk( ) = false then
            this.SetMessage( fs.PathFileName( path ) & ": " & i18n.Tr( "message.cannot_create", "can't be created" ) )
            return 0
        end if
        ' the module is the two files together; the scanner and the compiler need both from here on
        this.WriteGenerated( formDoc )
    end if
    return this.OpenQuietly( path )
end function

' One undoable edit of a buffer.
sub Window.PutCodeText( byval d as DocRef, byref newText as const ustring )
    d->ApplyFormText( newText )
end sub

' Makes sure `event_` of control name_ ("" is the form) has a handler with a body; jump: and go there.
sub Window.WireHandler( byval c as canvas.FormCanvas ptr, byref name_ as const ustring, byref event_ as const ustring, byval jump as boolean )
    dim as DocRef d = this.DocOfCanvas( c )
    if d = 0 then exit sub
    dim as long i = -1
    if len( name_ ) then i = FindControl( c->Doc, name_ )
    if (len( name_ ) > 0) andalso (i < 0) then exit sub

    dim as ustring ev = event_, handler, params, moduleName
    if i >= 0 then
        dim as TKMETA_CONTROL ptr m = catalog.Find( c->Doc.Controls[i].TypeName )
        if len( ev ) = 0 then ev = m->DefaultEvent
        if len( ev ) = 0 then
            this.SetMessage( strings.Format( i18n.Tr( "message.no_default_event", "{} has no default event" ), m->Name ) )
            exit sub
        end if
        dim as TKMETA_EVENT ptr e = tkMeta_FindEvent( m, ev )
        if e = 0 then exit sub
        params = e->Params
        moduleName = m->Module_
        handler = SettingOr( c->Doc.Controls[i].Events, ev )
        if len( handler ) = 0 then handler = c->Doc.Controls[i].Name & "_" & ev
    else
        if len( ev ) = 0 then ev = "Load"
        params = catalog.FormEventParams( ev )
        handler = SettingOr( c->Doc.Events, ev )
        if len( handler ) = 0 then handler = "Form_" & ev
    end if

    ' bind it first: the form may refuse the name
    dim as boolean isBound
    if i >= 0 then
        isBound = (FindSetting( c->Doc.Controls[i].Events, ev ) >= 0)
    else
        isBound = (FindSetting( c->Doc.Events, ev ) >= 0)
    end if
    if isBound = false then
        dim as FormDoc trial = c->Doc
        if i >= 0 then
            PutSetting( trial.Controls[i].Events, ev, handler )
        else
            PutSetting( trial.Events, ev, handler )
        end if
        dim as ustring fault = c->ApplyEdit( trial, false, "" )
        if len( fault ) then
            this.SetMessage( fault )
            exit sub
        end if
    end if

    dim as DocRef code = this.CodeDocOf( d )
    if code = 0 then exit sub
    dim as ustring text = code->Text( )
    dim as long a, b, bodyLine
    if reconcile.FindBody( text, handler, a, b ) then
        bodyLine = a + 1
    else
        dim as ustring t2 = text
        ' a parameter that isn't a plain tiko type comes from the control's own module
        for each mo as ustring in reconcile.ImportsFor( params, moduleName )
            t2 = reconcile.EnsureImport( t2, mo )
        next
        dim as ustring withStub = reconcile.AddStub( t2, handler, params, bodyLine )
        this.PutCodeText( code, withStub )
    end if
    if jump then
        this.ShowDoc( code )
        code->Main.GoToLine( bodyLine, 4 )
        code->Main.Focus( )
    end if
end sub

' The editor for control name_'s entries, in its window. It's the caller's to run or drive.
sub Window.OpenItems( byval c as canvas.FormCanvas ptr, byref name_ as const ustring )
    dim as long i = FindControl( c->Doc, name_ )
    if i < 0 then exit sub
    dim as long kind_ = catalog.ItemsKindOf( c->Doc.Controls[i].TypeName )
    if kind_ = catalog.ItemsKind.ItemsNone then exit sub
    dim as Array( of FormItem ) items
    if kind_ = catalog.ItemsKind.ItemsPages then
        for p as long = 0 to c->Doc.Controls[i].Pages.Count( ) - 1
            dim as FormItem it
            it.Text = c->Doc.Controls[i].Pages[p]
            it.Origin = p
            items.Push( it )
        next
    else
        items = c->Doc.Controls[i].Items
    end if
    ' a status bar from before panels stretched themselves: its ExpandPanel property shows as that
    ' panel's Stretch, and OK moves it there for good
    if kind_ = catalog.ItemsKind.ItemsStatus then
        dim as boolean any_ = false
        for each it as FormItem in items
            if it.Stretch then any_ = true
        next
        dim as long ep = FindSetting( c->Doc.Controls[i].Props, "ExpandPanel" )
        if (any_ = false) andalso (ep >= 0) then
            dim as long k = valint( c->Doc.Controls[i].Props[ep].Value )
            if (k >= 0) andalso (k < items.Count( )) then items[k].Stretch = true
        end if
    end if
    ItemsDlg = new itemsdlg.ItemsEditor
    ItemsOf = c
    ItemsName = name_
    ItemsDlg->Open( form, kind_, items, name_ )
end sub

' The editor's OK or Cancel: its entries into the form, as one change, and bodies for new handlers.
sub Window.FinishItems( byval apply_ as boolean )
    if ItemsDlg = 0 then exit sub
    dim as itemsdlg.ItemsEditor ptr dlg = ItemsDlg
    dim as canvas.FormCanvas ptr c = ItemsOf
    ItemsDlg = 0
    dim as Array( of FormItem ) items = dlg->Items
    dim as long kind_ = dlg->Kind
    dim as ustring wanted = dlg->GoToHandler      ' the pencil: that handler, once the entries are in
    dlg->Close( )
    delete dlg
    ' the keyboard goes back to the form: Undo from here undoes this
    if c->Glass then tkHost_SetFocus( c->Glass->pHost, c->Glass )
    if apply_ = false then exit sub
    dim as long i = FindControl( c->Doc, ItemsName )
    if i < 0 then exit sub
    dim as FormDoc trial = c->Doc
    if kind_ = catalog.ItemsKind.ItemsPages then
        dim as ustring why = edits.ApplyPages( trial, i, items )
        if len( why ) then
            this.SetMessage( ItemsName & ": " & why )
            exit sub
        end if
    else
        trial.Controls[i].Items = items
    end if
    ' Stretch lives on the panels now: an old ExpandPanel property would make its panel the only one
    if kind_ = catalog.ItemsKind.ItemsStatus then
        dim as long ep = FindSetting( trial.Controls[i].Props, "ExpandPanel" )
        if ep >= 0 then trial.Controls[i].Props.Remove( ep )
    end if
    if kind_ <> catalog.ItemsKind.ItemsPages then
        ' a kept (orphaned) handler named again is called again: no longer an orphan
        for each it as FormItem in items
            for k as long = trial.Orphans.Count( ) - 1 to 0 step -1
                if (len( it.Handler ) > 0) andalso (lcase( trial.Orphans[k].Handler ) = lcase( it.Handler )) then trial.Orphans.Remove( k )
            next
        next
        ' handlers the entries no longer call, as an Events row's: a renamed entry's body takes the new
        ' name (when that has no body yet); any other empty body goes, one with code keeps its
        ' declaration (an orphan) so the file still compiles
        dim as Array( of Setting ) dropped = reconcile.DroppedItemHandlers( c->Doc.Controls[i].Items, items, trial )
        if dropped.Count( ) then
            dim as ustring bad = validate.FirstNewProblem( c->Doc, trial )
            if len( bad ) then
                this.SetMessage( bad )
                exit sub
            end if
            for each s as Setting in dropped
                dim as boolean renamed = false
                if len( s.Value ) then renamed = this.HandlerRenamed( c, s.Key, s.Value )
                if renamed = false then
                    if this.HandlerGone( c, s.Key ) then
                        dim as FormOrphan o
                        o.Handler = s.Key
                        o.Params = catalog.ItemHandlerParams( kind_ )
                        trial.Orphans.Push( o )
                    end if
                end if
            next
        end if
    end if
    dim as ustring fault = c->ApplyEdit( trial, true, "" )
    if len( fault ) then
        this.SetMessage( fault )
        exit sub
    end if
    dim as DocRef d = this.DocOfCanvas( c )
    if (d = 0) orelse (kind_ = catalog.ItemsKind.ItemsPages) then exit sub
    for each it as FormItem in items
        if len( it.Handler ) then
            dim as DocRef code = this.CodeDocOf( d )
            if code = 0 then exit for
            dim as long a, b, bodyLine
            if reconcile.FindBody( code->Text( ), it.Handler, a, b ) = false then
                this.PutCodeText( code, reconcile.AddStub( code->Text( ), it.Handler, catalog.ItemHandlerParams( kind_ ), bodyLine ) )
            end if
        end if
    next
    if len( wanted ) then
        dim as DocRef code = this.CodeDocOf( d )
        dim as long a, b
        if (code <> 0) andalso reconcile.FindBody( code->Text( ), wanted, a, b ) then
            this.ShowDoc( code )
            code->Main.GoToLine( a + 1, 4 )
            code->Main.Focus( )
        end if
    end if
end sub

' ---- a control's [control.colors]: the Colors dialog ----------------------------------------------------

' The project's theme for a form's previews and its surface; "" (the presets) outside a project.
function Window.ProjectThemePath( ) as ustring
    if ProjOpen = false then return ""
    return fs.PathJoin( fs.PathParent( Proj.Path ), "appTheme", "appTheme.tktheme" )
end function

' Every open form (and Test Form) in the project's theme as it is now.
sub Window.RefreshFormThemes( )
    for each d as DocRef in Docs
        if d->Designer then
            d->Designer->ThemePath = this.ProjectThemePath( )
            d->Designer->ApplyProjectTheme( )
        end if
    next
    if Preview then
        Preview->ThemePath = this.ProjectThemePath( )
        Preview->ApplyProjectTheme( )
    end if
end sub

sub Window.OpenColors( byval c as canvas.FormCanvas ptr, byref name_ as const ustring )
    if ColorsDlg then exit sub
    dim as long i = FindControl( c->Doc, name_ )
    if i < 0 then exit sub
    dim as FormControl ctl = c->Doc.Controls[i]
    ColorsDlg = new colorsdlg.ColorsDialog
    ColorsOf = c
    ColorsName = name_
    ColorsDlg->Open( form, ctl.TypeName, ctl.StyleName, ctl.Colors, this.ProjectThemePath( ), _
                     name_ & " - " & i18n.Tr( "designer.colors", "Colors" ) )
    if ColorsDlg->Win = 0 then
        delete ColorsDlg
        ColorsDlg = 0
    end if
end sub

' OK: the dialog's style and colours into the control, as one change (one undo step).
sub Window.FinishColors( byval apply_ as boolean )
    if ColorsDlg = 0 then exit sub
    dim as colorsdlg.ColorsDialog ptr dlg = ColorsDlg
    dim as canvas.FormCanvas ptr c = ColorsOf
    ColorsDlg = 0
    dim as ustring style_ = dlg->StyleName
    dim as Array( of Setting ) colors = dlg->Colors
    dlg->Close( )
    delete dlg
    if c->Glass then tkHost_SetFocus( c->Glass->pHost, c->Glass )
    if apply_ = false then exit sub
    dim as long i = FindControl( c->Doc, ColorsName )
    if i < 0 then exit sub
    dim as FormDoc trial = c->Doc
    trial.Controls[i].StyleName = style_
    trial.Controls[i].Colors = colors
    dim as ustring fault = c->ApplyEdit( trial, true, "" )
    if len( fault ) then this.SetMessage( fault )
end sub

sub Window.EditColors( byval c as canvas.FormCanvas ptr, byref name_ as const ustring )
    this.OpenColors( c, name_ )
    if ColorsDlg then this.FinishColors( ColorsDlg->RunModal( ) )
end sub

' seed: a menu bar just placed -- the editor opens on the standard menu (File, Edit, Help).
sub Window.EditItems( byval c as canvas.FormCanvas ptr, byref name_ as const ustring, byval seed as boolean = false )
    this.OpenItems( c, name_ )
    if ItemsDlg = 0 then exit sub
    if seed then ItemsDlg->SeedDefaults( )
    this.FinishItems( ItemsDlg->RunModal( ) )
end sub

' ---- Test Form: the form as it is now, in a window of its own, working but wired to nothing ----

sub Window.CloseTestForm( )
    if PreviewForm then tkForm_Destroy( PreviewForm )   ' TestFormGone runs from its OnDestroy
end sub

sub Window.TestFormGone( )
    if Preview then
        ' its widgets went with the window
        if Preview->Layout then tkLayout_Destroy( Preview->Layout )
        Preview->Layout = 0
        Preview->Frame = 0
        delete Preview
    end if
    Preview = 0
    PreviewForm = 0
end sub

sub Window.TestForm( )
    dim as DocRef d = this.Active( )
    if (d = 0) orelse (d->Designer = 0) then exit sub
    this.CloseTestForm( )
    dim as FormDoc ref_ = d->Designer->Doc
    dim as ustring title = ref_.Caption
    PreviewForm = tkApp_NewForm( title, ref_.ClientW, ref_.ClientH, form, tkForm_Host( form )->fScaleForced )
    if PreviewForm = 0 then exit sub
    PreviewForm->Tag = @this
    Preview = new canvas.FormCanvas
    Preview->Live = true
    ' in the project's theme, the variant the design surface shows
    Preview->ThemePath = this.ProjectThemePath( )
    Preview->PreviewSet = true
    Preview->PreviewDark = d->Designer->ShowsDark( )
    Preview->Create( tkForm_Widget( PreviewForm ), 1 )
    dim as TK_WIDGET ptr r = tkForm_Widget( PreviewForm )
    tkWidget_SetPos( Preview->Frame, 0, 0, r->cw, r->ch )
    Preview->LoadText( d->Text( ) )
    tkForm_OnSize( PreviewForm, sub( byval f as TK_FORM ptr, byval cx as long, byval cy as long )
        dim as Window ptr mw = f->Tag
        if mw->Preview then tkWidget_SetPos( mw->Preview->Frame, 0, 0, cx, cy )
    end sub )
    tkForm_OnDestroy( PreviewForm, sub( byval f as TK_FORM ptr )
        cast( Window ptr, f->Tag )->TestFormGone( )
    end sub )
    tkForm_Host( PreviewForm )->OnPreKey = function( byval h as TK_HOST ptr, byval m as TK_MSG ptr ) as boolean
        if m->key <> SDLK_ESCAPE then return false
        tkForm_Close( tkForm_FromHost( h ) )
        return true
    end function
    tkForm_Show( PreviewForm )
end sub

' ---- new forms and projects ---------------------------------------------------------------------

private function IsFormName_( byref s as const ustring ) as boolean
    return validate.IsIdentifier( s ) andalso (validate.IsReserved( s ) = false) andalso (lcase( s ) <> "form")
end function

private function WriteNew_( byref path as const ustring, byref text as const ustring ) as boolean
    return fs.WriteAllText( path, text ).IsOk( )
end function

' A form's three files in their own folder: <folder>/<name>/<name>.tkform and the rest.
private function CreateFormFiles_( byref folder as const ustring, byref name_ as const ustring ) as ustring
    dim as ustring dir_ = fs.PathJoin( folder, name_ )
    fs.CreateDirAll( dir_ )
    dim as ustring formPath = fs.PathJoin( dir_, name_ & ".tkform" )
    dim as FormDoc doc
    doc.Caption = name_
    doc.ClientW = 480
    doc.ClientH = 320
    dim as ustring text = formfile.Render( doc )
    if WriteNew_( formPath, text ) = false then return ""
    if WriteNew_( fs.PathJoin( dir_, name_ & ".tiko" ), reconcile.NewCodeFile( name_ ) ) = false then return ""
    if WriteNew_( fs.PathJoin( dir_, name_ & ".design.tiko" ), codegen.Generate( doc, name_, name_ & ".tkform", text ) ) = false then return ""
    return formPath
end function

' wanted: the new form's .tkform path, or "" to ask. The form gets a folder of its own, named for it.
function Window.NewForm( byref wanted as const ustring ) as boolean
    dim as ustring picked = wanted
    if len( picked ) = 0 then
        dim as ustring where = "frmNew.tkform"
        if len( this.ActivePath( ) ) then where = fs.PathJoin( fs.PathParent( this.ActivePath( ) ), "frmNew.tkform" )
        picked = Pick( form, TKFD_SAVE, where )
        if len( picked ) = 0 then return false
    end if
    dim as ustring name_ = fs.PathStem( picked )
    if IsFormName_( name_ ) = false then
        this.SetMessage( strings.Format( i18n.Tr( "message.bad_form_name", "{}: a form's name has to be an identifier" ), name_ ) )
        return false
    end if
    dim as ustring folder = fs.PathParent( picked )
    ' already being saved into a folder of that name: use it
    if lcase( fs.PathFileName( folder ) ) = lcase( name_ ) then folder = fs.PathParent( folder )
    if fs.IsFile( fs.PathJoin( folder, name_, name_ & ".tkform" ) ) then
        this.SetMessage( strings.Format( i18n.Tr( "message.form_exists", "{} already exists" ), name_ ) )
        return false
    end if
    dim as ustring formPath = CreateFormFiles_( folder, name_ )
    if len( formPath ) = 0 then
        this.SetMessage( name_ & ": " & i18n.Tr( "message.cannot_create", "can't be created" ) )
        return false
    end if
    return this.OpenFile( formPath )
end function

' The form itself, its code or its generated half: none of them is a program of its own.
function Window.IsFormFile( byref path as const ustring ) as boolean
    dim as ustring lp = lcase( path )
    if (right( lp, 7 ) = ".tkform") orelse (right( lp, 12 ) = ".design.tiko") then return true
    if right( lp, 5 ) <> ".tiko" then return false
    return fs.IsFile( left( path, len( path ) - 5 ) & ".tkform" )
end function

' The .tkform of the form in front, by way of its code too; "" when what's in front isn't one.
function Window.FormInFront( ) as ustring
    dim as ustring p = this.ActivePath( )
    if this.IsFormFile( p ) = false then
        dim as DocRef d = this.SourceDoc( )
        if d = 0 then return ""
        p = d->Path
        if this.IsFormFile( p ) = false then return ""
    end if
    dim as ustring lp = lcase( p )
    if right( lp, 12 ) = ".design.tiko" then
        p = left( p, len( p ) - 12 ) & ".tkform"
    elseif right( lp, 5 ) = ".tiko" then
        p = left( p, len( p ) - 5 ) & ".tkform"
    end if
    if fs.IsFile( p ) then return p
    return ""
end function

' A package name that works for local modules: letters, digits and _ only.
private function PackageName_( byref s as const ustring ) as ustring
    dim as ustring o
    for i as long = 1 to len( s )
        dim as ustring c = mid( s, i, 1 )
        dim as long a = asc( c )
        if ((a >= 48) andalso (a <= 57)) orelse ((a >= 65) andalso (a <= 90)) orelse ((a >= 97) andalso (a <= 122)) orelse (a = 95) then
            o &= c
        else
            o &= "_"
        end if
    next
    return o
end function

private function GuiManifest_( byref pkg as const ustring ) as ustring
    return strings.Replace( project.NewManifestText( pkg, pkg, "main.tiko" ), "# subsystem = 'console'", "subsystem = 'gui'     " )
end function

' The main that shows one form, in the project's theme (appTheme: its fonts before Init, the rest after),
' with the project's resources (appResources) named before either.
private function FormMain_( byref pkg as const ustring, byref formName as const ustring ) as ustring
    dim as ustring nl = wchr( 10 )
    return "' " & pkg & ": starts the program and shows its first form." & nl _
        & "#import ""vendor/tkControls/tkApp""" & nl _
        & "#import ""./appResources""" & nl _
        & "#import ""./appTheme""" & nl _
        & "#import ""./" & formName & """" & nl _
        & "using tkApp" & nl & nl _
        & "dim as TKAPP_OPTIONS options" & nl _
        & "appResources.Register( )" & nl _
        & "appTheme.ApplyOptions( options )" & nl _
        & "if tkApp_Init( options ) = false then end 1" & nl _
        & "appTheme.Install( )" & nl _
        & "dim as " & formName & ".Form mainForm" & nl _
        & "mainForm.Build( )" & nl _
        & "end tkApp_Run( mainForm.Wnd )" & nl
end function

' The project's resources: appResources/appResources.tkres, none yet, and its module. One already
' there is kept.
private function CreateResourceFiles_( byref dir_ as const ustring ) as boolean
    dim as ustring folder = fs.PathJoin( dir_, resfile.RES_MODULE )
    dim as ustring path = fs.PathJoin( folder, resfile.RES_MODULE & ".tkres" )
    if fs.IsFile( path ) then return true
    fs.CreateDirAll( folder )
    dim as ustring text = resfile.DefaultText( )
    dim as resfile.ResourceDoc doc
    dim as ustring e
    if resfile.Parse( text, doc, e ) = false then return false
    if WriteNew_( path, text ) = false then return false
    return WriteNew_( fs.PathJoin( folder, resfile.RES_MODULE & ".design.tiko" ), _
                      resfile.Generate( doc, resfile.RES_MODULE, resfile.RES_MODULE & ".tkres", text ) )
end function

' The open project's appResources/appResources.tkres ("" with no project open).
function Window.ResourcesPath( ) as ustring
    if ProjOpen = false then return ""
    return fs.PathJoin( fs.PathParent( Proj.Path ), resfile.RES_MODULE, resfile.RES_MODULE & ".tkres" )
end function

' appResources.design.tiko from a .tkres's text. False, with a message, when it has a problem.
function Window.WriteResourcesGenerated( byref path as const ustring, byref text as const ustring ) as boolean
    dim as resfile.ResourceDoc doc
    dim as ustring e
    dim as Array( of ustring ) problems
    if resfile.Parse( text, doc, e ) = false then
        problems.Push( e )
    else
        resfile.Check( doc, fs.PathParent( path ), problems )
    end if
    if problems.Count( ) then
        this.SetMessage( fs.PathFileName( path ) & ": " & problems[0] )
        return false
    end if
    dim as ustring generated = resfile.Generate( doc, fs.PathStem( path ), fs.PathFileName( path ), text )
    dim as ustring target = left( path, instrrev( path, "." ) - 1 ) & ".design.tiko", none
    if fs.IsFile( target ) then
        if codegen.WithoutCr( fs.ReadAllText( target ).ValueOr( none ) ) = generated then return true
    end if
    if fs.WriteAtomic( target, generated ).IsOk( ) = false then
        this.SetMessage( fs.PathFileName( target ) & ": " & i18n.Tr( "message.cannot_create", "can't be created" ) )
        return false
    end if
    return true
end function

' After a build: the resources not built in, copied beside the program (resources/), where its
' Register looks first. A copy already there and as new is kept.
sub Window.CopyResourceFiles( byref exePath as const ustring )
    dim as ustring path = this.ResourcesPath( ), none
    if (len( path ) = 0) orelse (len( exePath ) = 0) orelse (fs.IsFile( path ) = false) then exit sub
    dim as resfile.ResourceDoc doc
    dim as ustring e
    if resfile.Parse( fs.ReadAllText( path ).ValueOr( none ), doc, e ) = false then exit sub
    dim as ustring dst = fs.PathJoin( fs.PathParent( exePath ), resfile.BESIDE_DIR )
    for each x as resfile.Resource in doc.Items
        if x.Embed then continue for
        dim as ustring src = fs.PathJoin( fs.PathParent( path ), resfile.FILES_DIR, x.File )
        if fs.IsFile( src ) = false then continue for
        fs.CreateDirAll( dst )
        fs.CopyFile( src, fs.PathJoin( dst, x.File ), true )
    next
end sub

' ---- the Resource Center ---------------------------------------------------------------------------

private function ResAsk_( byval owner as any ptr, byref text as const ustring ) as boolean
    dim as Window ptr w = owner
    return w->Ask( w->form, text, MBX_BTN_YESNO ) = MBX_IDYES
end function

private function ResPick_( byval owner as any ptr ) as ustring
    dim as Window ptr w = owner
    return w->Pick( w->form, PICK_RESOURCES, "" )
end function

private function ResUsed_( byval owner as any ptr, byref nm as const ustring ) as ustring
    return cast( Window ptr, owner )->ResourceUsers( nm )
end function

' The project's forms and theme files on disk (not under out/, files/ or a dot folder).
private sub ProjectRefFiles_( byref dir_ as const ustring, byref out_ as Array( of ustring ), byval depth as long )
    if depth > 8 then exit sub
    for each r in fs.ReadDir( dir_ )
        if r.IsOk( ) = false then continue for
        dim as fs.DirEntry e = r.Value( )
        dim as ustring nm = e.Name( ), l = lcase( e.Name( ) )
        if e.IsDirectory( ) then
            if (left( nm, 1 ) <> ".") andalso (l <> "out") andalso (l <> resfile.FILES_DIR) then ProjectRefFiles_( fs.PathJoin( dir_, nm ), out_, depth + 1 )
        elseif (right( l, 7 ) = ".tkform") orelse (right( l, 8 ) = ".tktheme") then
            out_.Push( fs.PathJoin( dir_, nm ) )
        end if
    next
end sub

private function OpenDocAt_( byref docs as Array( of DocRef ), byref path as const ustring ) as DocRef
    for each d as DocRef in docs
        if (len( d->Path ) > 0) andalso fs.PathEquals( d->Path, path ) then return d
    next
    return 0
end function

private sub UsersAdd_( byref o as ustring, byref one as const ustring )
    if len( o ) then o &= ", "
    o &= one
end sub

' How many times text has "res:nm" in quotes.
private function CountRefs_( byref text as const ustring, byref nm as const ustring ) as long
    dim as ustring t = lcase( text ), q = lcase( """" & resfile.RefOf( nm ) & """" )
    dim as long n = 0, at = instr( t, q )
    while at > 0
        n += 1
        at = instr( at + len( q ), t, q )
    wend
    return n
end function

' What refers to "res:nm", comma-separated ("" = none): a form's control as "Form1.tkform: Button1.ImageLeft"
' (its icon as "Form1.tkform: Icon"), a theme or any other use by file name. An open file is read as
' it stands in its buffer. The property a "..." is picking for now is left out: Select replaces it.
function Window.ResourceUsers( byref nm as const ustring ) as ustring
    if ProjOpen = false then return ""
    dim as Array( of ustring ) files
    ProjectRefFiles_( fs.PathParent( Proj.Path ), files, 0 )
    dim as ustring o, none
    for each p as ustring in files
        dim as DocRef d = OpenDocAt_( Docs, p )
        dim as ustring text
        if d then text = d->Text( ) else text = fs.ReadAllText( p ).ValueOr( none )
        if resfile.Refers( text, nm ) = false then continue for
        dim as ustring fname = fs.PathFileName( p )
        dim as long found = 0
        dim as FormDoc fd
        dim as ustring e
        if (lcase( right( p, 7 ) ) = ".tkform") andalso formfile.Parse( text, fd, e ) then
            ' by control and property; the "..." picking now (ResPickCanvas, ResPickProp) is not one
            dim as boolean picking = (d <> 0) andalso (ResPickCanvas <> 0) andalso (d->Designer = ResPickCanvas)
            dim as ustring ref_ = lcase( resfile.RefOf( nm ) )
            if lcase( fd.Icon ) = ref_ then
                found += 1
                if (picking andalso (ResPickCanvas->Selected.Count( ) = 0) andalso (ResPickProp = "@Icon")) = false then
                    UsersAdd_( o, fname & ": Icon" )
                end if
            end if
            for each fc as FormControl in fd.Controls
                for each s as Setting in fc.Props
                    if lcase( s.Value ) <> ref_ then continue for
                    found += 1
                    if picking andalso (s.Key = ResPickProp) andalso ResPickCanvas->IsSelected( fc.Name ) then continue for
                    UsersAdd_( o, fname & ": " & fc.Name & "." & s.Key )
                next
            next
        end if
        ' a use not found above (a theme, a place this doesn't look): the file by name
        if CountRefs_( text, nm ) > found then UsersAdd_( o, fname )
    next
    return o
end function

' Every resource of the open project known to this process by its name, as a file: the canvas and
' the Test Form show "res:<name>" as the program will. Names from before are taken back first.
sub Window.RegisterProjectResources( )
    for each n as ustring in ResRegistered
        tkHost_RemoveResource( n )
    next
    ResRegistered.Clear( )
    dim as ustring path = this.ResourcesPath( ), none, e
    if (len( path ) = 0) orelse (fs.IsFile( path ) = false) then exit sub
    dim as resfile.ResourceDoc doc
    if resfile.Parse( fs.ReadAllText( path ).ValueOr( none ), doc, e ) = false then exit sub
    for each x as resfile.Resource in doc.Items
        dim as string nm = resfile.RefOf( x.Name )
        tkHost_AddResourceFile( nm, fs.PathJoin( fs.PathParent( path ), resfile.FILES_DIR, x.File ) )
        ResRegistered.Push( nm )
    next
end sub

' The Resource Center. kind_: "" to manage; "image" / "font" to pick one (current: the value the
' property has). True on OK / Select; picked is then "res:<name>", or "" for (none).
function Window.EditResources( byref kind_ as const ustring, byref current as const ustring, byref picked as ustring, _
                               byval owner_ as TK_FORM ptr = 0 ) as boolean
    picked = ""
    if (ProjOpen = false) orelse (ResDlg <> 0) then
        if ProjOpen = false then this.SetMessage( i18n.Tr( "designer.res_needs_project", "Resources belong to a project: open or make one first" ) )
        return false
    end if
    dim as ustring projDir = fs.PathParent( Proj.Path )
    if CreateResourceFiles_( projDir ) = false then
        this.SetMessage( resfile.RES_MODULE & ": " & i18n.Tr( "message.cannot_create", "can't be created" ) )
        return false
    end if
    ResDlg = new resdlg.ResourceDialog
    ResDlg->Owner = @this
    ResDlg->Ask = @ResAsk_
    ResDlg->PickFiles = @ResPick_
    ResDlg->UsedBy = @ResUsed_
    ResDlg->Open( iif( owner_ <> 0, owner_, form ), fs.PathParent( this.ResourcesPath( ) ), kind_, current )
    if ResDlg->Win = 0 then
        delete ResDlg
        ResDlg = 0
        return false
    end if
    dim as boolean ok = ResDlg->RunModal( )
    dim as resdlg.ResourceDialog ptr dlg = ResDlg
    ResDlg = 0
    ' Close picks nothing, but the Center's changes stay (author)
    if ok orelse dlg->Changed( ) then this.ApplyResources( *dlg )
    picked = dlg->Picked
    if (ok = false) andalso (len( kind_ ) > 0) then
        ' a property whose resource was removed there is left at (none), not an orphan
        dim as ustring nm = resfile.NameOfRef( current )
        for each s as Setting in dlg->Renames
            if lcase( s.Key ) = lcase( nm ) then nm = s.Value
        next
        if (len( nm ) > 0) andalso (resfile.Find( dlg->Doc, nm ) < 0) then
            picked = ""
            ok = true
        end if
    end if
    dlg->Close( )
    delete dlg
    return ok
end function

' OK: the .tkres and its module written, renames carried into the project's forms and theme,
' removed files deleted, main made to register them, and this process told the new names.
sub Window.ApplyResources( byref dlg as resdlg.ResourceDialog )
    dim as ustring path = this.ResourcesPath( ), none
    dim as ustring text = resfile.ToText( dlg.Doc )
    dim as DocRef open_ = OpenDocAt_( Docs, path )
    if open_ then
        open_->Main.ReplaceAllText( text )
        this.SaveDoc( open_, false )
    elseif fs.WriteAtomic( path, text ).IsOk( ) = false then
        this.SetMessage( fs.PathFileName( path ) & ": " & i18n.Tr( "message.cannot_create", "can't be created" ) )
        exit sub
    end if
    this.WriteResourcesGenerated( path, text )
    for each f as ustring in dlg.Removed
        fs.RemoveFile( fs.PathJoin( fs.PathParent( path ), resfile.FILES_DIR, f ) )
    next
    this.RegisterProjectResources( )

    ' renames: open forms through their canvas (one undo step each), others in their text
    dim as long changed = 0
    if dlg.Renames.Count( ) then
        dim as Array( of ustring ) files
        ProjectRefFiles_( fs.PathParent( Proj.Path ), files, 0 )
        for each p as ustring in files
            dim as DocRef d = OpenDocAt_( Docs, p )
            if (d <> 0) andalso (d->Designer <> 0) then
                dim as canvas.FormCanvas ptr c = d->Designer
                dim as FormDoc trial = c->Doc
                dim as long n = 0
                for each s as Setting in dlg.Renames
                    dim as ustring was = lcase( resfile.RefOf( s.Key ) ), now_ = resfile.RefOf( s.Value )
                    if lcase( trial.Icon ) = was then trial.Icon = now_ : n += 1
                    for k as long = 0 to trial.Controls.Count( ) - 1
                        for j as long = 0 to trial.Controls[k].Props.Count( ) - 1
                            if lcase( trial.Controls[k].Props[j].Value ) = was then trial.Controls[k].Props[j].Value = now_ : n += 1
                        next
                    next
                next
                if n then
                    dim as ustring fault = c->ApplyEdit( trial, true, "" )
                    if len( fault ) then this.SetMessage( fault ) else changed += n
                end if
            else
                dim as ustring t0
                if d then t0 = d->Text( ) else t0 = fs.ReadAllText( p ).ValueOr( none )
                dim as ustring t1 = t0
                for each s as Setting in dlg.Renames
                    dim as long n
                    t1 = resfile.RenameRefs( t1, s.Key, s.Value, n )
                    changed += n
                next
                if t1 <> t0 then
                    if d then
                        d->Main.ReplaceAllText( t1 )
                    else
                        fs.WriteAtomic( p, t1 )
                    end if
                end if
            end if
        next
    end if

    ' the project's main registers them, as a new project's does
    dim as ustring mainPath = fs.PathJoin( fs.PathParent( Proj.Path ), "main.tiko" ), outText
    dim as DocRef mainDoc = OpenDocAt_( Docs, mainPath )
    dim as ustring mainText
    if mainDoc then mainText = mainDoc->Text( ) else mainText = fs.ReadAllText( mainPath ).ValueOr( none )
    dim as boolean byHand = false
    if len( mainText ) then
        select case resfile.InstallIntoMain( codegen.WithoutCr( mainText ), outText )
        case 1
            if mainDoc then mainDoc->Main.ReplaceAllText( outText ) else fs.WriteAtomic( mainPath, outText )
        case -1
            byHand = true
        end select
    end if
    for each d as DocRef in Docs
        if d->Designer then d->Designer->Rebuild( )
    next
    if byHand then
        this.SetMessage( i18n.Tr( "designer.res_main_by_hand", "main.tiko: add appResources.Register( ) before tkApp_Init" ) )
    elseif changed then
        this.SetMessage( strings.Format( i18n.Tr( "designer.res_renamed", "Resources saved; {} references renamed" ), changed ) )
    else
        this.SetMessage( i18n.Tr( "designer.res_saved", "Resources saved" ) )
    end if
end sub

' The project's theme: appTheme/appTheme.tktheme, the presets named "Default", and its module.
private function CreateThemeFiles_( byref dir_ as const ustring ) as boolean
    dim as ustring folder = fs.PathJoin( dir_, "appTheme" )
    dim as ustring path = fs.PathJoin( folder, "appTheme.tktheme" )
    if fs.IsFile( path ) then return true
    fs.CreateDirAll( folder )
    dim as ustring text = themefile.DefaultText( "Default" )
    dim as themefile.ThemeDoc doc
    dim as ustring e
    if themefile.Parse( text, doc, e ) = false then return false
    if WriteNew_( path, text ) = false then return false
    return WriteNew_( fs.PathJoin( folder, "appTheme.design.tiko" ), themefile.Generate( doc, "appTheme", "appTheme.tktheme", text ) )
end function

' appTheme.design.tiko (or any X.design.tiko) from a .tktheme's text. False, with a message, when the
' theme has a problem.
function Window.WriteThemeGenerated( byref path as const ustring, byref text as const ustring ) as boolean
    dim as themefile.ThemeDoc doc
    dim as ustring e
    dim as Array( of ustring ) problems
    if themefile.Parse( text, doc, e ) = false then
        problems.Push( e )
    else
        themefile.Check( doc, problems )
    end if
    if problems.Count( ) then
        this.SetMessage( fs.PathFileName( path ) & ": " & problems[0] )
        return false
    end if
    ' [fonts] embed: the fonts copied beside the module first, where its #embed lines read them at build time
    if doc.EmbedFonts then
        themefile.CopyEmbeddedFonts( doc, fs.PathParent( path ), this.PkgDir( ), problems )
        if problems.Count( ) then
            this.SetMessage( fs.PathFileName( path ) & ": " & problems[0] )
            return false
        end if
    end if
    dim as ustring generated = themefile.Generate( doc, fs.PathStem( path ), fs.PathFileName( path ), text )
    dim as ustring target = left( path, instrrev( path, "." ) - 1 ) & ".design.tiko", none
    if fs.IsFile( target ) then
        if codegen.WithoutCr( fs.ReadAllText( target ).ValueOr( none ) ) = generated then return true
    end if
    if fs.WriteAtomic( target, generated ).IsOk( ) = false then
        this.SetMessage( fs.PathFileName( target ) & ": " & i18n.Tr( "message.cannot_create", "can't be created" ) )
        return false
    end if
    return true
end function

' A project around a form that has none: tiko.toml and a main beside the form's folder, because that
' folder is a module. A tiko.toml already there is opened as it stands.
function Window.NewProjectForForm( byref formPath as const ustring ) as boolean
    dim as ustring formDir = fs.PathParent( formPath ), formName = fs.PathStem( formPath )
    if lcase( fs.PathFileName( formDir ) ) <> lcase( formName ) then
        this.SetMessage( formName & ": " & i18n.Tr( "message.cannot_create", "can't be created" ) )
        return false
    end if
    dim as ustring dir_ = fs.PathParent( formDir )
    dim as ustring manifest = fs.PathJoin( dir_, project.MANIFEST_FILE )
    dim as ustring mainPath = fs.PathJoin( dir_, "main.tiko" )
    if fs.IsFile( manifest ) = false then
        if fs.Exists( mainPath ) then
            this.SetMessage( strings.Format( i18n.Tr( "message.form_exists", "{} already exists" ), mainPath ) )
            return false
        end if
        dim as ustring pkg = PackageName_( fs.PathFileName( dir_ ) )
        if (WriteNew_( manifest, GuiManifest_( pkg ) ) = false) orelse (WriteNew_( mainPath, FormMain_( pkg, formName ) ) = false) _
           orelse (CreateThemeFiles_( dir_ ) = false) orelse (CreateResourceFiles_( dir_ ) = false) then
            this.SetMessage( pkg & ": " & i18n.Tr( "message.cannot_create", "can't be created" ) )
            return false
        end if
    end if
    if this.OpenProject( manifest ) = false then return false
    return this.OpenFile( formPath )
end function

' The folder a new project goes in, made. folder: that folder, or "" to ask. False: cancelled, or
' there's a project there already.
function Window.NewProjectFolder( byref folder as const ustring, byref dir_ as ustring, byref manifest as ustring ) as boolean
    dir_ = folder
    if len( dir_ ) = 0 then
        dir_ = Pick( form, TKFD_SAVE, "myapp" )
        if len( dir_ ) = 0 then return false
    end if
    manifest = fs.PathJoin( dir_, project.MANIFEST_FILE )
    if fs.Exists( manifest ) then
        this.SetMessage( strings.Format( i18n.Tr( "message.form_exists", "{} already exists" ), manifest ) )
        return false
    end if
    fs.CreateDirAll( dir_ )
    return true
end function

' File > New > Console Project: a manifest and the Console Program starter as main.tiko.
function Window.NewConsoleProject( byref folder as const ustring ) as boolean
    dim as ustring dir_, manifest
    if this.NewProjectFolder( folder, dir_, manifest ) = false then return false
    dim as ustring pkg = fs.PathFileName( dir_ )
    dim as ustring mainPath = fs.PathJoin( dir_, "main.tiko" )
    dim as boolean ok = WriteNew_( manifest, project.NewManifestText( pkg, pkg, "main.tiko" ) )
    ok = ok andalso WriteNew_( mainPath, StarterText( NEWITEM_CONSOLE ) )
    if ok = false then
        this.SetMessage( pkg & ": " & i18n.Tr( "message.cannot_create", "can't be created" ) )
        return false
    end if
    if this.OpenProject( manifest ) = false then return false
    return this.OpenFile( mainPath )
end function

' File > New > GUI Application. folder: the new project's folder, or "" to ask. A program with
' one form, ready to build and run.
function Window.NewFormProject( byref folder as const ustring ) as boolean
    dim as ustring dir_, manifest
    if this.NewProjectFolder( folder, dir_, manifest ) = false then return false
    dim as ustring pkg = fs.PathFileName( dir_ )
    dim as boolean ok = WriteNew_( manifest, GuiManifest_( pkg ) )
    ok = ok andalso WriteNew_( fs.PathJoin( dir_, "main.tiko" ), FormMain_( pkg, "frmMain" ) )
    ok = ok andalso CreateThemeFiles_( dir_ )
    ok = ok andalso CreateResourceFiles_( dir_ )
    dim as ustring formPath = CreateFormFiles_( dir_, "frmMain" )
    if (ok = false) orelse (len( formPath ) = 0) then
        this.SetMessage( pkg & ": " & i18n.Tr( "message.cannot_create", "can't be created" ) )
        return false
    end if
    if this.OpenProject( manifest ) = false then return false
    return this.OpenFile( formPath )
end function

' A control went and took these handlers with it. An empty body goes too; one with code in it stays,
' and the answer true keeps its declaration so that the file still compiles.
function Window.HandlerGone( byval c as canvas.FormCanvas ptr, byref handler as const ustring ) as boolean
    dim as DocRef d = this.DocOfCanvas( c )
    if d = 0 then return false
    dim as ustring path = CodePathOf_( d->Path )
    if (this.FindOpen( path ) = 0) andalso (fs.IsFile( path ) = false) then return false
    dim as DocRef code = this.OpenQuietly( path )
    if code = 0 then return false
    dim as ustring text = code->Text( )
    dim as long a, b
    if reconcile.FindBody( text, handler, a, b ) = false then return false
    if reconcile.IsEmptyBody( text, a, b ) = false then return true
    this.PutCodeText( code, reconcile.RemoveLines( text, a, b ) )
    return false
end function

' An Events row now calls newName instead of oldName, which nothing else on the form calls: the
' body and its uses in the code take the new name -- not when newName already has a body of its own
' (the row was pointed at another handler), and not when oldName has none. True: renamed.
function Window.HandlerRenamed( byval c as canvas.FormCanvas ptr, byref oldName as const ustring, byref newName as const ustring ) as boolean
    dim as DocRef d = this.DocOfCanvas( c )
    if d = 0 then return false
    dim as ustring path = CodePathOf_( d->Path )
    if (this.FindOpen( path ) = 0) andalso (fs.IsFile( path ) = false) then return false
    dim as DocRef code = this.OpenQuietly( path )
    if code = 0 then return false
    dim as ustring text = code->Text( )
    dim as long a, b
    if (lcase( oldName ) <> lcase( newName )) andalso reconcile.FindBody( text, newName, a, b ) then return false
    if reconcile.FindBody( text, oldName, a, b ) = false then return false
    dim as FormDoc noForm                        ' a handler's name alone: no control-prefixed names follow it
    this.PutCodeText( code, reconcile.RenameInCode( text, oldName, newName, noForm ) )
    return true
end function

sub Window.ControlRenamed( byval c as canvas.FormCanvas ptr, byref oldName as const ustring, byref newName as const ustring )
    dim as DocRef d = this.DocOfCanvas( c )
    if d = 0 then exit sub
    dim as ustring path = CodePathOf_( d->Path )
    if (this.FindOpen( path ) = 0) andalso (fs.IsFile( path ) = false) then exit sub
    dim as DocRef code = this.OpenQuietly( path )
    if code then this.PutCodeText( code, reconcile.RenameInCode( code->Text( ), oldName, newName, c->Doc ) )
end sub

' Handlers whose bodies were deleted by hand come off the form, and the person is told.
sub Window.ReconcileDesigner( byval d as DocRef )
    if (d = 0) orelse (d->Designer = 0) then exit sub
    dim as ustring path = CodePathOf_( d->Path )
    dim as DocRef code = this.FindOpen( path )
    if (code = 0) andalso (fs.IsFile( path ) = false) then exit sub
    dim as ustring text
    if code then
        text = code->Text( )
    else
        dim as ustring none
        text = fs.ReadAllText( path ).ValueOr( none )
    end if
    dim as FormDoc trial = d->Designer->Doc
    dim as Array( of ustring ) unbound
    if reconcile.ReconcileForm( trial, text, unbound ) then
        dim as ustring fault = d->Designer->ApplyEdit( trial, false, "" )
        if len( fault ) then
            this.SetMessage( fault )
        elseif unbound.Count( ) then
            SaveNote = strings.Format( i18n.Tr( "message.handler_unbound", "no code for {}: unbound" ), strings.Join( unbound, ", " ) )
        end if
    end if
end sub

' frmX.design.tiko from the form as it stands. False, with a message, when the form has a problem.
function Window.WriteGenerated( byval d as DocRef ) as boolean
    if (d = 0) orelse (d->Designer = 0) orelse (len( d->Path ) = 0) then return true
    dim as ustring moduleName = fs.PathStem( d->Path )
    dim as Array( of ustring ) problems
    validate.Check( d->Designer->Doc, moduleName, problems )
    if problems.Count( ) then
        this.SetMessage( fs.PathFileName( d->Path ) & ": " & problems[0] )
        return false
    end if
    dim as ustring generated = codegen.Generate( d->Designer->Doc, moduleName, fs.PathFileName( d->Path ), d->Text( ) )
    dim as ustring target = DesignPathOf_( d->Path ), none
    if fs.IsFile( target ) then
        if codegen.WithoutCr( fs.ReadAllText( target ).ValueOr( none ) ) = generated then return true
    end if
    ' atomically, so a failure leaves the old file whole
    if fs.WriteAtomic( target, generated ).IsOk( ) = false then
        this.SetMessage( fs.PathFileName( target ) & ": " & i18n.Tr( "message.cannot_create", "can't be created" ) )
        return false
    end if
    return true
end function

' Before a build: every open form's code matches, and its generated file is current.
function Window.PrepareForms( ) as boolean
    dim as boolean ok = true
    for each d as DocRef in Docs
        if d->Designer then
            this.ReconcileDesigner( d )
            if Prefs.SaveBeforeBuild andalso d->IsModified( ) then
                if this.SaveDoc( d, false ) = false then ok = false
            elseif this.WriteGenerated( d ) = false then
                ok = false
            end if
        elseif lcase( right( d->Path, 8 ) ) = ".tktheme" then
            ' an open theme: saved first when the user wants that (AfterSave generates), else generated
            if Prefs.SaveBeforeBuild andalso d->IsModified( ) then
                if this.SaveDoc( d, false ) = false then ok = false
            elseif this.WriteThemeGenerated( d->Path, d->Text( ) ) = false then
                ok = false
            end if
        elseif lcase( right( d->Path, 6 ) ) = ".tkres" then
            if Prefs.SaveBeforeBuild andalso d->IsModified( ) then
                if this.SaveDoc( d, false ) = false then ok = false
            elseif this.WriteResourcesGenerated( d->Path, d->Text( ) ) = false then
                ok = false
            end if
        end if
    next
    ' the project's resources, when no buffer has them: from the disk
    dim as ustring resPath = this.ResourcesPath( ), none
    if len( resPath ) andalso fs.IsFile( resPath ) then
        dim as boolean isOpen = false
        for each d as DocRef in Docs
            if (len( d->Path ) > 0) andalso fs.PathEquals( d->Path, resPath ) then isOpen = true
        next
        if isOpen = false then
            if this.WriteResourcesGenerated( resPath, fs.ReadAllText( resPath ).ValueOr( none ) ) = false then ok = false
        end if
    end if
    if len( SaveNote ) then
        this.SetMessage( SaveNote )
        SaveNote = ""
    end if
    return ok
end function

' Between a form and its code. From a form to frmX.tiko; from frmX.tiko or frmX.design.tiko to the form.
sub Window.ToggleFormView( )
    dim as DocRef d = this.Active( )
    if d = 0 then exit sub
    if d->Designer then
        dim as DocRef code = this.CodeDocOf( d )
        if code then
            this.ShowDoc( code )
            this.QueueScan( code )
        end if
        exit sub
    end if
    if len( d->Path ) = 0 then exit sub
    dim as ustring base_ = d->Path
    if lcase( right( base_, 12 ) ) = ".design.tiko" then
        base_ = left( base_, len( base_ ) - 12 )
    elseif lcase( right( base_, 5 ) ) = ".tiko" then
        base_ = left( base_, len( base_ ) - 5 )
    else
        exit sub
    end if
    dim as ustring formPath = base_ & ".tkform"
    if fs.IsFile( formPath ) then
        this.OpenFile( formPath )
    else
        this.SetMessage( i18n.Tr( "message.no_form", "no form goes with this file" ) )
    end if
end sub

' A form's code file sees its generated half, unsaved changes included.
sub Window.AddFormOverlay( byval d as DocRef, byref o as parser.ScanOptions )
    dim as ustring p = d->Path
    if lcase( right( p, 5 ) ) <> ".tiko" then exit sub
    dim as ustring base_ = left( p, len( p ) - 5 )
    if lcase( right( base_, 7 ) ) = ".design" then base_ = left( base_, len( base_ ) - 7 )
    dim as ustring formPath = base_ & ".tkform"
    if fs.IsFile( formPath ) = false then exit sub
    o.ModuleRoot = true
    dim as DocRef f = this.FindOpen( formPath )
    if f = 0 then exit sub
    if f->Designer = 0 then exit sub
    dim as ustring moduleName = fs.PathStem( formPath )
    dim as Array( of ustring ) problems
    validate.Check( f->Designer->Doc, moduleName, problems )
    if problems.Count( ) then exit sub
    o.OverlayPaths.Push( base_ & ".design.tiko" )
    o.OverlayTexts.Push( codegen.Generate( f->Designer->Doc, moduleName, fs.PathFileName( formPath ), f->Text( ) ) )
end sub

' ---- the Theme Center: the project's appTheme --------------------------------------------------------

private sub ThemeSaved_( byval tc as themecenter.ThemeDialog ptr )
    dim as Window ptr mw = tc->Host
    if mw then tc->Saved = mw->SaveTheme( tc )
end sub

' A project theme's font slot "...": the Resource Center over the Theme Center, picking a font.
private function ThemePickFont_( byval tc as themecenter.ThemeDialog ptr, byref current as const ustring, byref picked as ustring ) as boolean
    return cast( Window ptr, tc->Host )->EditResources( "font", current, picked, tc->Win )
end function

private sub ThemeClosed_( byval tc as themecenter.ThemeDialog ptr )
    dim as Window ptr mw = tc->Host
    if mw then mw->CloseThemeCenter( )
end sub

' Form > Project Theme...: the project's appTheme/appTheme.tktheme in the Theme Center (the
' presets, named "Default", when the project has none yet).
sub Window.OpenThemeCenter( )
    if ProjOpen = false then exit sub
    this.OpenThemeCenterOn( this.ProjectThemePath( ), false )
end sub

' The Theme Center on a theme: the project's appTheme, or (forEditor) tkEdit's own -- whose Save
' writes the file and applies it, no module and no main.
sub Window.OpenThemeCenterOn( byref path as const ustring, byval forEditor as boolean )
    if ThemeDlg then
        if ThemeDlg->Win then tkForm_Show( ThemeDlg->Win )
        exit sub
    end if
    ThemeDlg = new themecenter.ThemeDialog
    ThemeDlg->Host = @this
    ThemeDlg->ForEditor = forEditor
    ThemeDlg->OnSave = @ThemeSaved_
    ThemeDlg->OnClose = @ThemeClosed_
    if forEditor = false then ThemeDlg->OnPickFont = @ThemePickFont_
    dim as ustring title
    if forEditor then title = i18n.Tr( "designer.theme_editor_title", "tkEdit Theme" )
    ThemeDlg->Open( form, path, fs.PathJoin( ConfigDir, themes.THEME_DIR ), title )
end sub

sub Window.CloseThemeCenter( )
    if ThemeDlg = 0 then exit sub
    dim as themecenter.ThemeDialog ptr d = ThemeDlg
    ThemeDlg = 0
    ' tkEdit active BEFORE the dialog's window goes: destroying the active window let Windows activate
    ' some other program's window now and then
    this.Raise( )
    d->Close( )
    delete d
end sub

' The Theme Center's Save: the theme where it came from, and -- in the project -- its generated
' module, and main.tiko made to install it (through its buffer when it is open). Save to Library
' writes the file only. False, with a message, when the theme can't be built.
function Window.SaveTheme( byval tc as themecenter.ThemeDialog ptr ) as boolean
    dim as Array( of ustring ) problems = tc->Problems( )
    if problems.Count( ) then
        this.SetMessage( fs.PathFileName( tc->Path ) & ": " & problems[0] )
        return false
    end if
    dim as ustring text = themefile.Render( tc->Doc )
    fs.CreateDirAll( fs.PathParent( tc->Path ) )
    ' an open buffer of the file takes the text, so its undo and the disk agree
    dim as DocRef open_ = 0
    for each d as DocRef in Docs
        if (len( d->Path ) > 0) andalso fs.PathEquals( d->Path, tc->Path ) then open_ = d
    next
    if open_ then
        open_->Main.ReplaceAllText( text )
        if this.SaveDoc( open_, false ) = false then return false
    elseif fs.WriteAtomic( tc->Path, text ).IsOk( ) = false then
        this.SetMessage( fs.PathFileName( tc->Path ) & ": " & i18n.Tr( "message.cannot_create", "can't be created" ) )
        return false
    end if
    if tc->SavingToLibrary then
        this.SetMessage( strings.Format( i18n.Tr( "designer.theme_saved", "{} saved" ), tc->Path ) )
        return true
    end if
    if tc->ForEditor then
        this.ReloadTheme( )
        this.SetMessage( strings.Format( i18n.Tr( "designer.theme_saved", "{} saved" ), tc->Path ) )
        return true
    end if
    if this.WriteThemeGenerated( tc->Path, text ) = false then return false
    ' the project's main installs the theme, as a new project's does
    if ProjOpen then
        dim as ustring mainPath = fs.PathJoin( fs.PathParent( Proj.Path ), "main.tiko" ), none, outText
        dim as DocRef mainDoc = 0
        for each d as DocRef in Docs
            if (len( d->Path ) > 0) andalso fs.PathEquals( d->Path, mainPath ) then mainDoc = d
        next
        dim as ustring mainText
        if mainDoc then mainText = mainDoc->Text( ) else mainText = fs.ReadAllText( mainPath ).ValueOr( none )
        if len( mainText ) then
            select case themefile.InstallIntoMain( codegen.WithoutCr( mainText ), outText )
            case 1
                if mainDoc then
                    mainDoc->Main.ReplaceAllText( outText )
                else
                    fs.WriteAtomic( mainPath, outText )
                end if
            case -1
                this.SetMessage( i18n.Tr( "designer.theme_main_by_hand", "main.tiko: add appTheme.ApplyOptions and appTheme.Install around tkApp_Init" ) )
                return true
            end select
        end if
    end if
    this.RefreshFormThemes( )
    this.SetMessage( strings.Format( i18n.Tr( "designer.theme_saved", "{} saved" ), tc->Path ) )
    return true
end function
