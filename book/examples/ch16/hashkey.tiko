#import "std/containers"
using FB

type Point_
    as int32 x, y
end type

operator = ( byref a as Point_, byref b as Point_ ) as boolean
    return ( a.x = b.x ) andalso ( a.y = b.y )
end operator

'' The hash contract: re-open FB and add one overload. It needs
'' 'private', as the header's own do.
namespace FB
    private function HashOf overload ( byref p as Point_ ) as ulongint
        return HashOf( p.x ) * 31 + HashOf( p.y )
    end function
end namespace

dim seen as containers.Map( of Point_, ustring )
dim as Point_ a = ( 1, 2 ), b = ( 1, 2 )
seen[ a ] = "first"
print "keys: " & seen.Count & "   lookup: " & seen[ b ]
