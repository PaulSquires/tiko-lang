'' ex16-01.tiko -- CUBE, and an argument with a side effect.
#define CUBE( x ) ( ( x ) * ( x ) * ( x ) )

function NextTwo( ) as int32
    static as int32 calls = 0
    calls += 1
    print "NextTwo called:"; calls
    return 2
end function

print "CUBE( 1 + 1 ) ="; CUBE( 1 + 1 )
print "100 \ CUBE( 2 ) ="; 100 \ CUBE( 2 )

'' The argument is pasted in three times, so it runs three times.
var c = CUBE( NextTwo( ) )
print "CUBE( NextTwo( ) ) ="; c
