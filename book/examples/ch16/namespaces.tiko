namespace Geo
    const ORIGIN = 0

    function Area( byval w as float64, byval h as float64 ) as float64
        return w * h
    end function

    namespace Units
        const CM_PER_M = 100
    end namespace
end namespace

'' A namespace can be reopened, here or in another file.
namespace Geo
    function Perimeter( byval w as float64, _
                        byval h as float64 ) as float64
        return 2 * ( w + h )
    end function
end namespace

print "area, perimeter and centimetres per metre:"
print Geo.Area( 2, 3 ), Geo.Perimeter( 2, 3 )
print Geo.Units.CM_PER_M

sub Report( )
    using Geo
    print Area( 4, 5 ), Units.CM_PER_M
end sub

Report( )
