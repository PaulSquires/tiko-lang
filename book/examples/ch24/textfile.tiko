'' Write a text file, add to it, read it back a line at a time.
var f = freefile( )                   '' a file number nobody is using
open "notes.txt" for output as #f     '' creates, or empties, the file
print #f, "first line"
print #f, "second line"
close #f

f = freefile( )
open "notes.txt" for append as #f     '' keeps what is there
print #f, "third line"
close #f

f = freefile( )
open "notes.txt" for input as #f
dim as ustring text
dim as int32 n = 0
do until eof( f )
    line input #f, text
    n += 1
    print n; ": "; text
loop
close #f
kill "notes.txt"
