'' A random-access file: fixed-size records, read and written by number.
type Item
    id as int32
    qty as int32
    label as string * 8       '' fixed width: every record the same
end type

var f = freefile( )
open "stock.dat" for random as #f len = sizeof( Item )

dim it as Item
for n as int32 = 1 to 3
    it.id = n
    it.qty = n * 10
    it.label = "part" & n
    put #f, n, it                 '' record n, wherever it falls
next
print "records:"; lof( f ) \ sizeof( Item ); _
      ", each"; sizeof( Item ); " bytes"

get #f, 2, it                     '' straight to record 2
print "record 2:"; it.qty; " "; rtrim( it.label )
it.qty -= 5
put #f, 2, it                     '' update it in place
get #f, 2, it
print "record 2 now:"; it.qty; ", position"; loc( f )
close #f
kill "stock.dat"
