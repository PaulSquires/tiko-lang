#import "std/fs"

'' Exercise 24-2: sell stock, refusing to go below zero.
type Item
    id as int32
    qty as int32
end type

function Sell( byref f as fs.File, byval rec as int32, _
               byval n as int32 ) as boolean
    dim it as Item
    dim as int64 at = ( rec - 1 ) * sizeof( Item )
    var got = f.ReadAt( at, cptr( ubyte ptr, @it ), sizeof( Item ) )
    if got.IsOk( ) = false then return false
    if it.qty < n then return false
    it.qty -= n
    return f.WriteAt( at, cptr( ubyte ptr, @it ), sizeof( Item ) ).IsOk( )
end function

dim o as fs.OpenOptions
o.Read = true
o.Write = true
o.Create = true
dim f as fs.File
f.Open( "ex.dat", o )
dim it as Item
it.id = 1 : it.qty = 5
f.WriteAt( 0, cptr( ubyte ptr, @it ), sizeof( Item ) )
print Sell( f, 1, 3 ); Sell( f, 1, 3 )
f.ReadAt( 0, cptr( ubyte ptr, @it ), sizeof( Item ) )
print "left:"; it.qty
f.Close( )
fs.RemoveFile( "ex.dat" )
