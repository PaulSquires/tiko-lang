'' Exercise 24-2: sell stock, refusing to go below zero.
type Item
    id as int32
    qty as int32
end type

function Sell( byval f as int32, byval rec as int32, _
               byval n as int32 ) as boolean
    dim it as Item
    get #f, rec, it
    if it.qty < n then return false
    it.qty -= n
    put #f, rec, it
    return true
end function

var f = freefile( )
open "ex.dat" for random as #f len = sizeof( Item )
dim it as Item
it.id = 1 : it.qty = 5 : put #f, 1, it
print Sell( f, 1, 3 ); Sell( f, 1, 3 )
get #f, 1, it
print "left:"; it.qty
close #f
kill "ex.dat"
