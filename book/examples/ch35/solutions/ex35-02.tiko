'' Exercise 35-2: a word count for the status bar. A word is a run of
'' characters that are not spaces, tabs or line breaks.
#import "../textfile"

function CountWords( byref text as const ustring ) as int32
    dim as int32 n
    dim as boolean inWord = false
    for i as int32 = 1 to len( text )
        select case asc( text, i )
        case 32, 9, 10, 13
            inWord = false
        case else
            if inWord = false then n += 1
            inWord = true
        end select
    next
    return n
end function

dim as ustring samples( ... ) = { "", "one", "  two  words ", _
    !"three\nlines\r\nhere", !"tab\tseparated\t\t" }
for each s as ustring in samples
    print CountWords( textfile.ToLf( s ) ); " words,"; len( s ); _
          " characters"
next
