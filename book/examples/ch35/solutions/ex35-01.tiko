'' Exercise 35-1: Find Previous. The offset of the last match that
'' ends at or before `before`, wrapping around to the bottom; -1 when
'' there is none.
#import "../textfile"

function FindPrevious( byref text as const ustring, _
                       byref needle as const ustring, _
                       byval before as int32, _
                       byval matchCase as boolean ) as int32
    if len( needle ) = 0 orelse len( needle ) > len( text ) then
        return -1
    end if
    dim as ustring hay = text, pin = needle
    if matchCase = false then
        hay = lcase( hay )
        pin = lcase( pin )
    end if
    '' instrrev's start is where the match may BEGIN, counted from 1.
    dim as int32 last = before - len( pin ) + 1
    dim as int32 at = 0
    if last >= 1 then at = instrrev( hay, pin, last )
    if at = 0 then at = instrrev( hay, pin )
    return at - 1
end function

dim as ustring text = !"one two\nTwo three\ntwo"
print "text: "; len( text ); " characters"
'' From the end, then each time from the start of the last match.
dim as int32 at = len( text )
for i as int32 = 1 to 4
    at = FindPrevious( text, "two", at, false )
    print "previous 'two':"; at
next
print "exact case 'Two':"; _
      FindPrevious( text, "Two", len( text ), true )
print "'four':"; FindPrevious( text, "four", len( text ), false )
'' The same text through textfile.FindNext, for comparison.
print "next 'two' from 0:"; textfile.FindNext( text, "two", 0, false )
