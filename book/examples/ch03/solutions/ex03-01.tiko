'' ex03-01.tiko -- type maxima, and where overflow bites.
#import "std/numeric"

print "int8  max " & 127
print "int16 max " & 32767
print "int32 max " & 2147483647
print "int64 max " & 9223372036854775807

dim as int32 top = 2147483647

'' The ARITHMETIC does not wrap: it is done wider than int32.
print "top + 1 as an expression: " & ( top + 1 )

'' Storing the result back into an int32 is where the value is lost.
dim as int32 back = top + 1
print "stored back into int32  : " & back

'' AddChecked says so instead: an Optional with nothing in it.
var checked = numeric.AddChecked( top, 1 )
print "AddChecked has a value  : " & checked.HasValue( )
