'' ex12-02.tiko -- three views of one value.
''
'' A temperature is stored once, in kelvin. Every other scale is a
'' property computed from it, so the three can never disagree -- and
'' the one setter that matters refuses impossible values.

type Temperature
    declare property Kelvin( ) as float64
    declare property Kelvin( byval k as float64 )
    declare property Celsius( ) as float64
    declare property Celsius( byval c as float64 )
    declare property Fahrenheit( ) as float64
    declare property Fahrenheit( byval f as float64 )
  private:
    k_ as float64
end type

property Temperature.Kelvin( ) as float64
    return k_
end property

property Temperature.Kelvin( byval k as float64 )
    if k < 0 then k = 0          '' nothing is colder than 0 K
    k_ = k
end property

'' The other setters convert and go through Kelvin, so the check
'' lives in exactly one place.
property Temperature.Celsius( ) as float64
    return k_ - 273.15
end property

property Temperature.Celsius( byval c as float64 )
    this.Kelvin = c + 273.15
end property

property Temperature.Fahrenheit( ) as float64
    return this.Celsius * 9 / 5 + 32
end property

property Temperature.Fahrenheit( byval f as float64 )
    this.Celsius = ( f - 32 ) * 5 / 9
end property

dim as Temperature t
t.Celsius = 100
print "100 C ="; t.Fahrenheit; " F ="; t.Kelvin; " K"

t.Fahrenheit = 32
print " 32 F ="; t.Celsius; " C"

t.Celsius = -1000
print "asked for -1000 C, got "; t.Celsius; " C ="; t.Kelvin; " K"
