'' ex12-01.tiko -- money in whole cents.
''
'' Cents are an int64, so adding prices is exact. The operators make
'' Money read like a number while refusing what a number allows but
'' money does not: there is no Money * Money.

type Money
    cents as int64
    declare operator cast( ) as string
end type

function Dollars( byval d as int64, byval c as int64 ) as Money
    dim as Money m
    m.cents = d * 100 + iif( d < 0, -c, c )
    return m
end function

operator + ( byref a as Money, byref b as Money ) as Money
    dim as Money r
    r.cents = a.cents + b.cents
    return r
end operator

operator - ( byref a as Money, byref b as Money ) as Money
    dim as Money r
    r.cents = a.cents - b.cents
    return r
end operator

'' Scaling by a COUNT makes sense; multiplying money by money does not.
operator * ( byref a as Money, byval n as int32 ) as Money
    dim as Money r
    r.cents = a.cents * n
    return r
end operator

operator < ( byref a as Money, byref b as Money ) as boolean
    return a.cents < b.cents
end operator

operator = ( byref a as Money, byref b as Money ) as boolean
    return a.cents = b.cents
end operator

operator Money.cast( ) as string
    dim as int64 v = abs( cents )
    dim as string sign = iif( cents < 0, "-", "" )
    dim as string pence = right( "0" & ( v mod 100 ), 2 )
    return sign & "$" & ( v \ 100 ) & "." & pence
end operator

dim as Money coffee = Dollars( 3, 75 )
dim as Money cake = Dollars( 4, 5 )
dim as Money budget = Dollars( 20, 0 )

dim as Money order_ = coffee * 3 + cake
print "3 coffees and a cake: "; order_
print "left in the budget:   "; budget - order_
print "over budget?          "; budget < order_

'' A thousand ten-cent additions, exactly.
dim as Money dime = Dollars( 0, 10 ), total
for i as int32 = 1 to 1000 : total = total + dime : next
print "1000 dimes: "; total; ",  exactly $100: "; _
      total = Dollars( 100, 0 )
print "refund:     "; Dollars( 0, 0 ) - coffee
