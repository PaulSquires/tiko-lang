#import "std/containers"

dim text( 0 to 8 ) as ustring = _
    { "to", "be", "or", "not", "to", "be", "that", "is", "it" }

dim counts as containers.Map( of ustring, int32 )
for each word in text
    counts[ word ] += 1           '' a missing key starts at 0
next
print counts.Count( ); " distinct words"

'' TryGet reads without inserting.
dim as int32 n
if counts.TryGet( "be", n ) then print "be:"; n
if counts.TryGet( "maybe", n ) = false then print "maybe: absent"

'' A Map has no order; sort the keys to print them in one.
var keys = counts.Keys( )
containers.Sort( keys )
for each k in keys
    print k; "="; counts[ k ]; " ";
next
print
