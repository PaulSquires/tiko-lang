#import "std/containers"

type Cell
    row as int32
    col as int32
end type

'' A key needs '=' ...
operator = ( byref a as Cell, byref b as Cell ) as boolean
    return ( a.row = b.row ) andalso ( a.col = b.col )
end operator

'' ...and a HashOf overload, added to the library's namespace, FB.
'' Hash only what '=' compares: equal keys must hash equally.
namespace FB
    function HashOf overload ( byref k as Cell ) as uint64
        return HashOf( k.row ) xor ( HashOf( k.col ) shl 1 )
    end function
end namespace

dim terrain as containers.Map( of Cell, ustring )
dim spot as Cell = type( 2, 3 )
terrain[ spot ] = "forest"

dim probe as Cell = type( 2, 3 )            '' a different variable
dim found as ustring
if terrain.TryGet( probe, found ) then print "( 2, 3 ) is "; found
