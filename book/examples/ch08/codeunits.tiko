'' codeunits.tiko -- what len actually counts, in each type.
''
'' The text is built from explicit bytes so that nothing here depends
'' on how this file was saved: these ARE the UTF-8 bytes for the two
'' strings, written out one at a time.

'' "cafe" with an e-acute: 63 61 66 C3 A9
dim as string cafeBytes = chr( &h63 ) & chr( &h61 ) & chr( &h66 ) & _
                          chr( &hC3 ) & chr( &hA9 )

'' "a", U+1F600 GRINNING FACE, "b": 61 F0 9F 98 80 62
dim as string faceBytes = chr( &h61 ) & _
                          chr( &hF0 ) & chr( &h9F ) & chr( &h98 ) & _
                          chr( &h80 ) & chr( &h62 )

dim as ustring cafe = cafeBytes
dim as ustring face = faceBytes

print "cafe: as string (UTF-8 bytes) len ="; len( cafeBytes )
print "      as ustring (code units) len ="; len( cafe )
print "      code units:";
for i as int32 = 1 to len( cafe ) : print asc( cafe, i ); : next
print

print "face: as string (UTF-8 bytes) len ="; len( faceBytes )
print "      as ustring (code units) len ="; len( face )
print "      code units:";
for i as int32 = 1 to len( face ) : print asc( face, i ); : next
print
print "      -- 55357 and 56832 are ONE character, stored as a pair"

'' Converting back is lossless.
dim as string roundTrip = face
print "round trip back to string: len ="; len( roundTrip ); _
      "  equal = "; cbool( roundTrip = faceBytes )
