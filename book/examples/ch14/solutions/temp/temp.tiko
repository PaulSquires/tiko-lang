#module "temp"

public function CToF( byval c as float64 ) as float64
    return Round1_( c * 9 / 5 + 32 )
end function

public function FToC( byval f as float64 ) as float64
    return Round1_( ( f - 32 ) * 5 / 9 )
end function

function Round1_( byval x as float64 ) as float64
    return int( x * 10 + 0.5 ) / 10
end function
