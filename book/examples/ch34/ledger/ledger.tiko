'' ANCHOR: head
#module "ledger"
#import "std/chrono"
#import "std/money"
#import "std/containers"
#import "std/strings"
'' This module is the only place that imports SQLite, and nothing
'' from it is public. Linked statically, it is inside the program.
#import "vendor/sqlite3" link static
'' ANCHOR_END: head

'' ANCHOR: model
'' One line of the ledger. Money in is positive, money out negative.
public type Txn
    as longint id
    as chrono.LocalDate day
    as ustring payee
    as ustring category
    as money.Decimal amount
end type

'' One month of the report.
public type MonthTotals
    as money.Decimal income
    as money.Decimal spending       '' zero or negative
end type

'' Months by "YYYY-MM". A generic is named through an alias.
public type MonthMap as containers.OrderedMap( of ustring, MonthTotals )
'' ANCHOR_END: model

'' ANCHOR: conn
'' The program's one database. OpenLedger and CloseLedger bracket it.
private dim shared as sqlite3 ptr db

'' What SQLite says went wrong with the last call on the connection.
function LastError( ) as ustring
    dim as string msg = *sqlite3_errmsg( db )
    return msg
end function

'' Run SQL that returns no rows: "" or SQLite's reason.
function RunSql( byref sql as ustring ) as ustring
    if sqlite3_exec( db, sql, nullptr, nullptr, nullptr ) <> SQLITE_OK _
            then return LastError( )
    return ""
end function

'' Compile SQL into st: "" or SQLite's reason.
function Prepare( byref sql as ustring, _
                  byref st as sqlite3_stmt ptr ) as ustring
    if sqlite3_prepare_v2( db, sql, -1, @st, nullptr ) <> SQLITE_OK _
            then return LastError( )
    return ""
end function

'' A column of the current row as text. SQLite's text is UTF-8, and a
'' string holding UTF-8 converts to a ustring correctly.
function ColText( byval st as sqlite3_stmt ptr, _
                  byval col as int32 ) as ustring
    dim as string bytes
    var p = sqlite3_column_text( st, col )
    if p <> nullptr then bytes = *cast( zstring ptr, p )
    return bytes
end function
'' ANCHOR_END: conn

'' ANCHOR: parse
'' Check four fields of text and build a Txn from them: "" if they make
'' a transaction, else what is wrong. The import and the entry form
'' both come through here, so they refuse exactly the same things.
public function ParseTxn _
    ( byref day as ustring, byref payee as ustring, _
      byref category as ustring, byref amount as ustring, _
      byref t as Txn ) as ustring
    '' TryParseIso also reads the compact 20260105. A ledger keeps one
    '' spelling, so the dashes are required.
    dim as boolean dashed = len( day ) = 10 andalso _
                            mid( day, 5, 1 ) = "-" andalso _
                            mid( day, 8, 1 ) = "-"
    if dashed = false orelse _
       chrono.LocalDate.TryParseIso( day, t.day ) = false then
        return "'" & day & "' is not a date (YYYY-MM-DD)"
    end if
    t.payee = trim( payee )
    if len( t.payee ) = 0 then return "the payee is empty"
    t.category = lcase( trim( category ) )
    if len( t.category ) = 0 then t.category = "other"
    var d = money.DecimalParse( trim( amount ) )
    if d.HasValue( ) = false then
        return "'" & amount & "' is not an amount"
    end if
    if d.Value( ).Scale( ) > 2 then
        return "'" & amount & "' has more than two decimal places"
    end if
    t.amount = d.Value( )
    return ""
end function
'' ANCHOR_END: parse

'' ANCHOR: schema
'' The schema, one step per version. A step that has shipped is never
'' edited -- some database has already run it -- so a change to the
'' schema is always a new step at the end.
const LATEST_SCHEMA = 2

function SchemaStep( byval v as int32 ) as ustring
    select case v
    case 1
        return "create table txn( " & _
               "id integer primary key, " & _
               "day text not null, " & _
               "payee text not null, " & _
               "category text not null, " & _
               "amount text not null )"
    case 2
        return "create index txn_day on txn( day )"
    end select
    return ""
end function

'' The version the file is at, in v: "" or why it cannot be read --
'' "file is not a database", for a file that is something else.
function ReadVersion( byref v as int32 ) as ustring
    dim st as sqlite3_stmt ptr
    var why = Prepare( "pragma user_version", st )
    if len( why ) > 0 then return why
    defer sqlite3_finalize( st )
    if sqlite3_step( st ) <> SQLITE_ROW then return LastError( )
    v = sqlite3_column_int( st, 0 )
    return ""
end function

public function SchemaVersion( ) as int32
    dim as int32 v = -1
    ReadVersion( v )
    return v
end function

'' Bring the schema up to date, one transaction per step, so a failure
'' leaves the database at the last version that completed.
function Migrate( ) as ustring
    dim as int32 current
    var why = ReadVersion( current )
    if len( why ) > 0 then return why
    if current > LATEST_SCHEMA then
        return "the database is from a newer tledger (schema " & _
               str( current ) & ")"
    end if
    for v as int32 = current + 1 to LATEST_SCHEMA
        why = RunSql( "begin" )
        if len( why ) = 0 then why = RunSql( SchemaStep( v ) )
        if len( why ) = 0 then
            why = RunSql( "pragma user_version = " & v )
        end if
        if len( why ) = 0 then why = RunSql( "commit" )
        if len( why ) > 0 then
            RunSql( "rollback" )        '' undo whatever the step did
            return "schema step " & str( v ) & ": " & why
        end if
    next
    return ""
end function
'' ANCHOR_END: schema

'' ANCHOR: open
public sub CloseLedger( )
    sqlite3_close( db )             '' closing a null connection is fine
    db = nullptr
end sub

'' Open (or create) a ledger file, or ":memory:" for one that is gone
'' when the program ends. Returns "" or why it could not.
public function OpenLedger( byref path as ustring ) as ustring
    if sqlite3_open( path, @db ) <> SQLITE_OK then
        var why = LastError( )
        CloseLedger( )
        return why
    end if
    return Migrate( )
end function
'' ANCHOR_END: open

'' ANCHOR: store
'' Dates are stored as ISO text, which sorts in date order; amounts as
'' the Decimal's own text, which is exact. SQL never does arithmetic on
'' them: sum( ) would turn them into binary floating point.
function Insert( byref t as Txn ) as ustring
    dim st as sqlite3_stmt ptr
    var why = Prepare( "insert into txn( day, payee, category, " & _
                       "amount ) values( ?, ?, ?, ? )", st )
    if len( why ) > 0 then return why
    defer sqlite3_finalize( st )
    sqlite3_bind_text( st, 1, t.day.ToIsoString( ), -1, _
                       SQLITE_TRANSIENT )
    sqlite3_bind_text( st, 2, t.payee, -1, SQLITE_TRANSIENT )
    sqlite3_bind_text( st, 3, t.category, -1, SQLITE_TRANSIENT )
    sqlite3_bind_text( st, 4, t.amount.ToString( ), -1, _
                       SQLITE_TRANSIENT )
    if sqlite3_step( st ) <> SQLITE_DONE then return LastError( )
    t.id = sqlite3_last_insert_rowid( db )
    return ""
end function

public function AddTxn( byref t as Txn ) as ustring
    return Insert( t )
end function

'' Every transaction, oldest first.
public function ListTxns( byref txns as containers.Array( of Txn ) ) _
                          as ustring
    dim st as sqlite3_stmt ptr
    var why = Prepare( "select id, day, payee, category, amount " & _
                       "from txn order by day, id", st )
    if len( why ) > 0 then return why
    defer sqlite3_finalize( st )
    var rc = sqlite3_step( st )
    do while rc = SQLITE_ROW
        dim t as Txn
        t.id = sqlite3_column_int64( st, 0 )
        t.day = chrono.LocalDate.ParseIso( ColText( st, 1 ) )
        t.payee = ColText( st, 2 )
        t.category = ColText( st, 3 )
        var amount = money.DecimalParse( ColText( st, 4 ) )
        t.amount = amount.Value( )
        txns.Push( t )
        rc = sqlite3_step( st )
    loop
    if rc <> SQLITE_DONE then return LastError( )
    return ""
end function
'' ANCHOR_END: store

'' ANCHOR: import
'' Field i of a CSV record, or "" when the record is shorter.
function FieldAt( byref rec as strings.CsvRow, byval i as int32 ) _
                as ustring
    if i < 0 orelse i >= rec.fields.Count( ) then return ""
    return rec.fields[ i ]
end function

'' Check every record and insert the good ones, in one transaction
'' that is committed only if every record was good.
function AddRecords _
    ( byref path as ustring, _
      byref rows as containers.Array( of strings.CsvRow ), _
      byref problems as containers.Array( of ustring ) ) as int32
    '' Row 0 is the header: it says which column holds what.
    dim as int32 cDate = -1, cPayee = -1, cCategory = -1, cAmount = -1
    for c as int32 = 0 to rows[ 0 ].fields.Count( ) - 1
        select case lcase( trim( FieldAt( rows[ 0 ], c ) ) )
        case "date": cDate = c
        case "payee": cPayee = c
        case "category": cCategory = c
        case "amount": cAmount = c
        end select
    next
    if cDate < 0 orelse cPayee < 0 orelse cAmount < 0 then
        problems.Push( path & ": the header needs date, payee " & _
                       "and amount" )
        return 0
    end if

    var why = RunSql( "begin" )
    if len( why ) > 0 then
        problems.Push( path & ": " & why )
        return 0
    end if
    dim as int32 added = 0
    for r as int32 = 1 to rows.Count( ) - 1
        var day = FieldAt( rows[ r ], cDate )
        var payee = FieldAt( rows[ r ], cPayee )
        var category = FieldAt( rows[ r ], cCategory )
        var amount = FieldAt( rows[ r ], cAmount )
        '' A blank line -- most often the last one -- is a record with
        '' every field empty. It is not a mistake, and adds nothing.
        if len( day & payee & category & amount ) = 0 then continue for
        dim t as Txn
        why = ParseTxn( day, payee, category, amount, t )
        if len( why ) = 0 then why = Insert( t )
        if len( why ) > 0 then
            '' Row r is record r + 1 of the file: the header was 1.
            problems.Push( path & ":" & str( r + 1 ) & ": " & why )
        else
            added += 1
        end if
    next
    if problems.Count( ) = 0 then
        why = RunSql( "commit" )
        if len( why ) > 0 then problems.Push( path & ": " & why )
    end if
    if problems.Count( ) > 0 then
        RunSql( "rollback" )            '' keep none of the file
        return 0
    end if
    return added
end function

'' Load a bank's CSV export (date,payee,category,amount). All or
'' nothing: one bad record and no record is kept, so the file can be
'' fixed and loaded again without making duplicates. Returns the number
'' of rows added; problems get one message per bad record.
public function ImportCsv _
    ( byref path as ustring, _
      byref problems as containers.Array( of ustring ) ) as int32
    '' The file's bytes, as they are: UTF-8, which SplitCsv reads.
    dim as string text
    dim f as int32 = freefile
    if open( path for binary access read as #f ) <> 0 then
        problems.Push( path & ": cannot be read" )
        return 0
    end if
    text = space( lof( f ) )
    get #f, , text
    close #f

    var rows = strings.SplitCsv( text )
    '' A file with no records -- a header alone, or nothing at all --
    '' adds nothing, and is not a mistake.
    if rows.Count( ) < 2 then return 0
    return AddRecords( path, rows, problems )
end function
'' ANCHOR_END: import

'' ANCHOR: report
'' Income and spending per month, keyed "YYYY-MM". An OrderedMap keeps
'' its keys sorted, so the months come out in calendar order.
public sub SumByMonth( byref txns as containers.Array( of Txn ), _
                       byref months as MonthMap )
    for each t in txns
        var key = left( t.day.ToIsoString( ), 7 )
        if t.amount.IsNegative( ) then
            months[ key ].spending = months[ key ].spending + t.amount
        else
            months[ key ].income = months[ key ].income + t.amount
        end if
    next
end sub

'' The report over the whole ledger: "" or why it could not be read.
public function MonthlyReport( byref months as MonthMap ) as ustring
    dim txns as containers.Array( of Txn )
    var why = ListTxns( txns )
    if len( why ) = 0 then SumByMonth( txns, months )
    return why
end function

'' Money as the reports print it. Every field is set, so the text is
'' the same whatever the locale of the machine running the program.
public function FormatMoney( byref d as money.Decimal ) as ustring
    dim as money.MoneyFormat mf = d
    mf.Symbol = "$"
    mf.DecimalPoint = "."
    mf.ThousandsSep = ","
    mf.Grouping = "3;0"             '' threes, repeated: 1,234,567
    mf.FracDigits = 2
    mf.SymbolPrecedes = true
    mf.SpaceBySymbol = false
    mf.Negative = money.MONEY_NEG_MINUS
    return mf.ToString( )
end function
'' ANCHOR_END: report
