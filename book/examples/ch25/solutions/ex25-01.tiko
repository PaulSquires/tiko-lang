#import "std/chrono"

'' Working days from 'first' up to, not including, 'last'.
function WorkingDays( byval first as chrono.LocalDate, _
                      byval last as chrono.LocalDate ) as int32
    dim as int32 count = 0
    var d = first
    do while d < last
        if d.DayOfWeek( ) <= 5 then count += 1
        d = d.AddDays( 1 )
    loop
    return count
end function

var a = chrono.LocalDate( 2025, 3, 3 )
print "one week: "; WorkingDays( a, a.AddDays( 7 ) )
print "March:    "; WorkingDays( chrono.LocalDate( 2025, 3, 1 ), _
                                   chrono.LocalDate( 2025, 4, 1 ) )
print "2025:     "; WorkingDays( chrono.LocalDate( 2025, 1, 1 ), _
                                   chrono.LocalDate( 2026, 1, 1 ) )
print "same day: "; WorkingDays( a, a )
