#import "std/chrono"

var d = chrono.DateTime( 2025, 3, 4, 14, 30, 5, 0 ).WithOffset( 60 )

'' Custom patterns: invariant English, never the machine's locale.
print d.ToString( "dddd, d MMMM yyyy" )
print d.ToString( "dd/MM/yy h:mm tt" )
print d.ToString( "yyyy-MM-dd'T'HH:mm:ssK" )
print d.ToString( "R" )

'' An unknown letter is an error, not a literal: quote the T.
dim text as ustring
print "TryFormat with a bare T: "; _
      d.TryFormat( "yyyy-MM-ddTHH:mm", text )

'' Parsing with a pattern says which number is the day.
dim p as chrono.DateTime
if chrono.DateTime.TryParseExact( "04.03.2025 17:45", _
                                  "dd.MM.yyyy HH:mm", p ) then
    print "parsed: "; p.ToIsoString( )
end if

'' Redundant fields are cross-checked: 4 March 2025 is a Tuesday.
print "Monday 04.03.2025: "; chrono.DateTime.TryParseExact( _
      "Monday 04.03.2025", "dddd dd.MM.yyyy", p )
