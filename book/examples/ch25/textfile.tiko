#import "std/fs"

'' Write a text file, add to it, read it back a line at a time.
scope
    dim f as fs.File
    f.Create( "notes.txt" )               '' creates, or empties, the file
    dim w as fs.TextWriter = fs.TextWriter( f )
    w.WriteLine( "first line" )
    w.WriteLine( "second line" )
end scope                                 '' the file closes here

scope
    dim f as fs.File
    f.OpenAppend( "notes.txt" )           '' keeps what is there
    dim w as fs.TextWriter = fs.TextWriter( f )
    w.WriteLine( "third line" )
end scope

dim as int32 n = 0
for each ln in fs.ReadLines( "notes.txt" )
    n += 1
    print n; ": "; ln.Value( )
next
fs.RemoveFile( "notes.txt" )
