#import "std/fs"

'' A file of fixed-size records, read and written by number.
type Item
    id as int32
    qty as int32
    label as string * 8       '' fixed width: every record the same
end type

dim stock as fs.RecordFile( of Item )
stock.Open( "stock.dat" )                 '' read and write; created if missing

dim it as Item
for n as int32 = 1 to 3
    it.id = n
    it.qty = n * 10
    it.label = "part" & n
    stock.Append( it )                    '' becomes record n
next
print "records:"; stock.Count( ).Value( ); _
      ", each"; stock.RecordLength( ); " bytes"

stock.GetRecord( 2, it )
print "record 2:"; it.qty; " "; rtrim( it.label )
it.qty -= 5
stock.PutRecord( 2, it )
stock.GetRecord( 2, it )
print "record 2 now:"; it.qty
print "record 4 there? "; stock.GetRecord( 4, it ).Value( )
stock.Close( )
fs.RemoveFile( "stock.dat" )
