'' A name no other use of the macro can collide with.
#macro TIMES_TWO( v )
    __FB_UNIQUEID_PUSH__( tmp )
    var __FB_UNIQUEID__( tmp ) = v
    print "twice"; v; " is"; __FB_UNIQUEID__( tmp ) * 2
    __FB_UNIQUEID_POP__( tmp )
#endmacro
