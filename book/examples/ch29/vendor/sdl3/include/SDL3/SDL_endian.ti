'' #error Unsupported endianness
'' C2T-TODO(conditional) SDL_endian.h:201 -- tiko would take this branch where clang does not
'' #endif /**/
#elseif defined(__MAVERICK__)
/' For Maverick, float words are always little-endian. '/
#define SDL_FLOATWORDORDER SDL_LIL_ENDIAN
#elseif (((0 orelse defined(__thumb__)) andalso ((defined(__VFP_FP__)) = 0)) andalso ((defined(__ARM_EABI__)) = 0))
/' For FPA, float words are always big-endian. '/
#define SDL_FLOATWORDORDER SDL_BIG_ENDIAN
#else
/' By default, assume that floats words follow the memory system mode. '/
#define SDL_FLOATWORDORDER SDL_BYTEORDER
#endif /' SDL_WIKI_DOCUMENTATION_SECTION '/
