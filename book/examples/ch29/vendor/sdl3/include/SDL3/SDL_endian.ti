'' SDL_FORCE_INLINE Uint64 SDL_Swap64(Uint64 x)
'' {
''   __asm__("bswapq %0": "=r"(x):"0"(x));
''     return x;
'' }
#endif
#elseif (defined(__WATCOMC__) andalso defined(__386__))
'' C2T-NOTE(inline) SDL_endian.h:365 -- inline: links only if the library exports 'SDL_Swap64'
declare function SDL_Swap64( byval as Uint64 ) as Uint64
'' C2T-TODO(unsupported) SDL_endian.h:366 -- #pragma has no tiko translation
'' #pragma aux SDL_Swap64 = \
''   "bswap eax"     \
''   "bswap edx"     \
''   "xchg eax,edx"  \
''   parm [eax edx]  \
''   modify [eax edx];
#else
#if defined(TIKO_OS_WINDOWS)
'' C2T-NOTE(inline) SDL_endian.h:373 -- inline: links only if the library exports 'SDL_Swap64'
declare function SDL_Swap64( byval x as Uint64 ) as Uint64
#elseif defined(TIKO_OS_LINUX)
'' C2T-TODO(static-inline) SDL_endian.h:373 -- static inline function 'SDL_Swap64': no symbol to link against; port the body by hand
'' SDL_FORCE_INLINE Uint64 SDL_Swap64(Uint64 x)
'' {
''     Uint32 hi, lo;
''
''     /* Separate into high and low 32-bit values and swap them */
''     lo = SDL_static_cast(Uint32, x & 0xFFFFFFFF);
''     x >>= 32;
''     hi = SDL_static_cast(Uint32, x & 0xFFFFFFFF);
''     x = SDL_Swap32(lo);
''     x <<= 32;
''     x |= SDL_Swap32(hi);
''     return (x);
'' }
#endif
#endif
#endif

/'*
 * Byte-swap a floating point number.
 *
 * This will always byte-swap the value, whether it's currently in the native
 * byteorder of the system or not. You should use SDL_SwapFloatLE or
 * SDL_SwapFloatBE instead, in most cases.
 *
 * Note that this is a forced-inline function in a header, and not a public
 * API function available in the SDL library (which is to say, the code is
 * embedded in the calling program and the linker and dynamic loader will not
 * be able to find this function inside SDL itself).
 *
 * \param x the value to byte-swap.
 * \returns x, with its bytes in the opposite endian order.
 *
 * \threadsafety It is safe to call this function from any thread.
 *
 * \since This function is available since SDL 3.2.0.
 '/
#if defined(TIKO_OS_WINDOWS)
'' C2T-NOTE(inline) SDL_endian.h:408 -- inline: links only if the library exports 'SDL_SwapFloat'
declare function SDL_SwapFloat( byval x as float32 ) as float32
#elseif defined(TIKO_OS_LINUX)
'' C2T-TODO(static-inline) SDL_endian.h:408 -- static inline function 'SDL_SwapFloat': no symbol to link against; port the body by hand
'' SDL_FORCE_INLINE float SDL_SwapFloat(float x)
'' {
''     union {
''         float f;
''         Uint32 ui32;
''     } swapper;
''     swapper.f = x;
''     swapper.ui32 = SDL_Swap32(swapper.ui32);
''     return swapper.f;
'' }
#endif

