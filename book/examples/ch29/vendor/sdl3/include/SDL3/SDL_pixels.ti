    SDL_COLORSPACE_BT2020_FULL = 571483657    /'*< Equivalent to DXGI_COLOR_SPACE_YCBCR_FULL_G22_LEFT_P2020 '/
        /' SDL_DEFINE_COLORSPACE(SDL_COLOR_TYPE_YCBCR,
                                 SDL_COLOR_RANGE_FULL,
