    SDL_COLORSPACE_HDR10 = 301999616    /'*< Equivalent to DXGI_COLOR_SPACE_RGB_FULL_G2084_NONE_P2020  '/
        /' SDL_DEFINE_COLORSPACE(SDL_COLOR_TYPE_RGB,
                                 SDL_COLOR_RANGE_FULL,
                                 SDL_COLOR_PRIMARIES_BT2020,
