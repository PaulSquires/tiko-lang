                                 SDL_CHROMA_LOCATION_LEFT), '/

    SDL_COLORSPACE_RGB_DEFAULT = 301991328            /'*< The default colorspace for RGB surfaces if no colorspace is specified '/
    SDL_COLORSPACE_YUV_DEFAULT = 554703046                     /'*< The default colorspace for YUV surfaces if no colorspace is specified '/
end enum
#elseif defined(TIKO_OS_LINUX)
