    SDL_COLORSPACE_JPEG = 570426566    /'*< Equivalent to DXGI_COLOR_SPACE_YCBCR_FULL_G22_NONE_P709_X601 '/
        /' SDL_DEFINE_COLORSPACE(SDL_COLOR_TYPE_YCBCR,
