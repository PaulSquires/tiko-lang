 '/
declare function SDL_hid_get_indexed_string( byval dev as SDL_hid_device ptr, byval string_index as int32, byval string_ as wstring ptr, byval maxlen as uinteger ) as int32

/'*
 * Get the device info from a HID device.
 *
 * \param dev a device handle returned from SDL_hid_open().
