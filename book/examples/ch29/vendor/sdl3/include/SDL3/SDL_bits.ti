#elseif defined(TIKO_OS_LINUX)
'' C2T-TODO(static-inline) SDL_bits.h:132 -- static inline function 'SDL_HasExactlyOneBitSet32': no symbol to link against; port the body by hand
'' SDL_FORCE_INLINE bool SDL_HasExactlyOneBitSet32(Uint32 x)
