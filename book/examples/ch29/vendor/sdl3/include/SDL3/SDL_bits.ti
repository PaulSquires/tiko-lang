 * be able to find this function inside SDL itself).
 *
 * \param x the 32-bit value to examine.
 * \returns the index of the most significant bit, or -1 if the value is 0.
 *
 * \threadsafety It is safe to call this function from any thread.
 *
 * \since This function is available since SDL 3.2.0.
 '/
#if defined(TIKO_OS_WINDOWS)
'' C2T-NOTE(inline) SDL_bits.h:65 -- inline: links only if the library exports 'SDL_MostSignificantBitIndex32'
declare function SDL_MostSignificantBitIndex32( byval x as Uint32 ) as int32
#elseif defined(TIKO_OS_LINUX)
'' C2T-TODO(static-inline) SDL_bits.h:65 -- static inline function 'SDL_MostSignificantBitIndex32': no symbol to link against; port the body by hand
'' SDL_FORCE_INLINE int SDL_MostSignificantBitIndex32(Uint32 x)
'' {
'' #if defined(__GNUC__) && (__GNUC__ >= 4 || (__GNUC__ == 3 && __GNUC_MINOR__ >= 4))
''     /* Count Leading Zeroes builtin in GCC.
''      * http://gcc.gnu.org/onlinedocs/gcc-4.3.4/gcc/Other-Builtins.html
''      */
''     if (x == 0) {
''         return -1;
''     }
''     return 31 - __builtin_clz(x);
'' #elif defined(__WATCOMC__) && defined(__386__)
''     if (x == 0) {
''         return -1;
''     }
''     return _SDL_bsr_watcom(x);
'' #elif defined(_MSC_VER) && _MSC_VER >= 1400
''     unsigned long index;
''     if (_BitScanReverse(&index, x)) {
''         return (int)index;
''     }
''     return -1;
'' #else
''     /* Based off of Bit Twiddling Hacks by Sean Eron Anderson
''      * <seander@cs.stanford.edu>, released in the public domain.
''      * http://graphics.stanford.edu/~seander/bithacks.html#IntegerLog
''      */
''     const Uint32 b[] = {0x2, 0xC, 0xF0, 0xFF00, 0xFFFF0000};
''     const int    S[] = {1, 2, 4, 8, 16};
''
''     int msbIndex = 0;
''     int i;
''
''     if (x == 0) {
''         return -1;
''     }
''
''     for (i = 4; i >= 0; i--)
