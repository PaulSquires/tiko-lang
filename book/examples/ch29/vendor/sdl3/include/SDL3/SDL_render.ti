 *
 * \since This function is available since SDL 3.4.0.
 *
 * \sa SDL_RenderTexture
 * \sa SDL_RenderTexture9Grid
 '/
declare function SDL_RenderTexture9GridTiled( byval renderer as SDL_Renderer ptr, byval texture as SDL_Texture ptr, byval srcrect as const SDL_FRect ptr, byval left_width as float32, byval right_width as float32, byval top_height as float32, byval bottom_height as float32, byval scale as float32, byval dstrect as const SDL_FRect ptr, byval tileScale as float32 ) as boolean

/'*
