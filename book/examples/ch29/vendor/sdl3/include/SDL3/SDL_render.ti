declare function SDL_GetDefaultTextureScaleMode( byval renderer as SDL_Renderer ptr, byval scale_mode as SDL_ScaleMode ptr ) as boolean

/'*
 * A structure specifying the parameters of a GPU render state.
 *
 * \since This struct is available since SDL 3.4.0.
 *
 * \sa SDL_CreateGPURenderState
 '/
type SDL_GPURenderStateCreateInfo
    fragment_shader as SDL_GPUShader ptr /'*< The fragment shader to use when this render state is active '/

    num_sampler_bindings as Sint32  /'*< The number of additional fragment samplers to bind when this render state is active '/
    sampler_bindings as const SDL_GPUTextureSamplerBinding ptr   /'*< Additional fragment samplers to bind when this render state is active '/

    num_storage_textures as Sint32  /'*< The number of storage textures to bind when this render state is active '/
    storage_textures as SDL_GPUTexture const ptr ptr    /'*< Storage textures to bind when this render state is active '/

    num_storage_buffers as Sint32   /'*< The number of storage buffers to bind when this render state is active '/
    storage_buffers as SDL_GPUBuffer const ptr ptr      /'*< Storage buffers to bind when this render state is active '/

    props as SDL_PropertiesID       /'*< A properties ID for extensions. Should be 0 if no extensions are needed. '/
end type

/'*
 * A custom GPU render state.
 *
 * \since This struct is available since SDL 3.4.0.
 *
 * \sa SDL_CreateGPURenderState
 * \sa SDL_SetGPURenderStateFragmentUniforms
 * \sa SDL_SetGPURenderState
 * \sa SDL_DestroyGPURenderState
 '/
type SDL_GPURenderState__fwd as SDL_GPURenderState

/'*
 * Create custom GPU render state.
 *
 * \param renderer the renderer to use.
 * \param createinfo a struct describing the GPU render state to create.
 * \returns a custom GPU render state or NULL on failure; call SDL_GetError()
 *          for more information.
 *
