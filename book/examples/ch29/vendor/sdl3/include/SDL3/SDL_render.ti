 '/
declare function SDL_RenderCoordinatesFromWindow( byval renderer as SDL_Renderer ptr, byval window_x as float32, byval window_y as float32, byval x as float32 ptr, byval y as float32 ptr ) as boolean

/'*
 * Get a point in window coordinates when given a point in render coordinates.
