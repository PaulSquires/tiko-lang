/'*
 * Valid key modifiers (possibly OR'd together).
 *
 * \since This datatype is available since SDL 3.2.0.
 '/
type SDL_Keymod as Uint16

#define SDL_KMOD_NONE &h0000u   /'*< no modifier is applicable. '/
#define SDL_KMOD_LSHIFT &h0001u /'*< the left Shift key is down. '/
#define SDL_KMOD_RSHIFT &h0002u /'*< the right Shift key is down. '/
#define SDL_KMOD_LEVEL5 &h0004u /'*< the Level 5 Shift key is down. '/
#define SDL_KMOD_LCTRL &h0040u  /'*< the left Ctrl (Control) key is down. '/
#define SDL_KMOD_RCTRL &h0080u  /'*< the right Ctrl (Control) key is down. '/
#define SDL_KMOD_LALT &h0100u   /'*< the left Alt key is down. '/
#define SDL_KMOD_RALT &h0200u   /'*< the right Alt key is down. '/
#define SDL_KMOD_LGUI &h0400u   /'*< the left GUI key (often the Windows key) is down. '/
#define SDL_KMOD_RGUI &h0800u   /'*< the right GUI key (often the Windows key) is down. '/
#define SDL_KMOD_NUM &h1000u    /'*< the Num Lock key (may be located on an extended keypad) is down. '/
#define SDL_KMOD_CAPS &h2000u   /'*< the Caps Lock key is down. '/
#define SDL_KMOD_MODE &h4000u   /'*< the !AltGr key is down. '/
#define SDL_KMOD_SCROLL &h8000u /'*< the Scroll Lock key is down. '/
#define SDL_KMOD_CTRL (SDL_KMOD_LCTRL or SDL_KMOD_RCTRL)    /'*< Any Ctrl key is down. '/
#define SDL_KMOD_SHIFT (SDL_KMOD_LSHIFT or SDL_KMOD_RSHIFT) /'*< Any Shift key is down. '/
#define SDL_KMOD_ALT (SDL_KMOD_LALT or SDL_KMOD_RALT)       /'*< Any Alt key is down. '/
#define SDL_KMOD_GUI (SDL_KMOD_LGUI or SDL_KMOD_RGUI)       /'*< Any GUI key is down. '/

end extern
