'' A Windows program with no console window: the GUI subsystem.
#cmdline "-s gui"
#include once "windows.bi"

'' A real program would create a window here. This one shows that it
'' was started without a console, and writes to its standard output,
'' which still works when something has redirected it.
print "has a console window: "; cbool( GetConsoleWindow( ) <> 0 )
