'' ex06-01.tiko -- FizzBuzz. if/elseif is the natural shape here, because each
'' test is a different question; select case suits one value against many.
for i as int32 = 1 to 15
    if ( i mod 15 ) = 0 then
        print "FizzBuzz"
    elseif ( i mod 3 ) = 0 then
        print "Fizz"
    elseif ( i mod 5 ) = 0 then
        print "Buzz"
    else
        print i
    end if
next
