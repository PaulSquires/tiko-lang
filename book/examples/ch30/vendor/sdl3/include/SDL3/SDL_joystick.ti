type SDL_VirtualJoystickDesc
    version as Uint32   /'*< the version of this interface '/
    type as Uint16      /'*< `SDL_JoystickType` '/
    padding as Uint16   /'*< unused '/
    vendor_id as Uint16 /'*< the USB vendor ID of this joystick '/
    product_id as Uint16  /'*< the USB product ID of this joystick '/
    naxes as Uint16     /'*< the number of axes on this joystick '/
    nbuttons as Uint16  /'*< the number of buttons on this joystick '/
    nballs as Uint16    /'*< the number of balls on this joystick '/
    nhats as Uint16     /'*< the number of hats on this joystick '/
    ntouchpads as Uint16  /'*< the number of touchpads on this joystick, requires `touchpads` to point at valid descriptions '/
    nsensors as Uint16  /'*< the number of sensors on this joystick, requires `sensors` to point at valid descriptions '/
    padding2(0 to 1) as Uint16 /'*< unused '/
    button_mask as Uint32 /'*< A mask of which buttons are valid for this controller
                             e.g. (1 << SDL_GAMEPAD_BUTTON_SOUTH) '/
    axis_mask as Uint32 /'*< A mask of which axes are valid for this controller
                             e.g. (1 << SDL_GAMEPAD_AXIS_LEFTX) '/
    name as const zstring ptr   /'*< the name of the joystick '/
    touchpads as const SDL_VirtualJoystickTouchpadDesc ptr   /'*< A pointer to an array of touchpad descriptions, required if `ntouchpads` is > 0 '/
    sensors as const SDL_VirtualJoystickSensorDesc ptr  /'*< A pointer to an array of sensor descriptions, required if `nsensors` is > 0 '/

    userdata as any ptr /'*< User data pointer passed to callbacks '/
    Update as sub cdecl( byval as any ptr ) /'*< Called when the joystick state should be updated '/
    SetPlayerIndex as sub cdecl( byval as any ptr, byval as int32 )   /'*< Called when the player index is set '/
    Rumble as function cdecl( byval as any ptr, byval as Uint16, byval as Uint16 ) as boolean          /'*< Implements SDL_RumbleJoystick() '/
    RumbleTriggers as function cdecl( byval as any ptr, byval as Uint16, byval as Uint16 ) as boolean /'*< Implements SDL_RumbleJoystickTriggers() '/
    SetLED as function cdecl( byval as any ptr, byval as Uint8, byval as Uint8, byval as Uint8 ) as boolean /'*< Implements SDL_SetJoystickLED() '/
    SendEffect as function cdecl( byval as any ptr, byval as const any ptr, byval as int32 ) as boolean /'*< Implements SDL_SendJoystickEffect() '/
    SetSensorsEnabled as function cdecl( byval as any ptr, byval as boolean ) as boolean /'*< Implements SDL_SetGamepadSensorEnabled() '/
    Cleanup as sub cdecl( byval as any ptr ) /'*< Cleans up the userdata when the joystick is detached '/
end type

