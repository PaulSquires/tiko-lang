/'*
 * A structure holding a calendar date and time broken down into its
 * components.
 *
 * \since This struct is available since SDL 3.2.0.
 '/
type SDL_DateTime
    year as int32              /'*< Year '/
    month as int32             /'*< Month [01-12] '/
    day as int32               /'*< Day of the month [01-31] '/
    hour as int32              /'*< Hour [0-23] '/
    minute as int32            /'*< Minute [0-59] '/
    second as int32            /'*< Seconds [0-60] '/
    nanosecond as int32        /'*< Nanoseconds [0-999999999] '/
    day_of_week as int32       /'*< Day of the week [0-6] (0 being Sunday) '/
    utc_offset as int32        /'*< Seconds east of UTC '/
end type

/'*
 * The preferred date format of the current system locale.
 *
 * \since This enum is available since SDL 3.2.0.
 *
 * \sa SDL_GetDateTimeLocalePreferences
 '/
#if defined(TIKO_OS_WINDOWS)
type SDL_DateFormat as int32
enum
    SDL_DATE_FORMAT_YYYYMMDD = 0  /'*< Year/Month/Day '/
    SDL_DATE_FORMAT_DDMMYYYY = 1  /'*< Day/Month/Year '/
    SDL_DATE_FORMAT_MMDDYYYY = 2  /'*< Month/Day/Year '/
end enum
#elseif defined(TIKO_OS_LINUX)
type SDL_DateFormat as uint32
enum
    SDL_DATE_FORMAT_YYYYMMDD = 0  /'*< Year/Month/Day '/
    SDL_DATE_FORMAT_DDMMYYYY = 1  /'*< Day/Month/Year '/
    SDL_DATE_FORMAT_MMDDYYYY = 2  /'*< Month/Day/Year '/
end enum
#endif

/'*
 * The preferred time format of the current system locale.
 *
 * \since This enum is available since SDL 3.2.0.
