/'*
 * The macro used when an assertion is enabled.
 *
 * This isn't for direct use by apps, but this is the code that is inserted
 * when an SDL_assert is enabled.
 *
 * The `do {} while(0)` avoids dangling else problems:
 *
 * ```c
 * if (x) SDL_assert(y); else blah();
 * ```
 *
 * ... without the do/while, the "else" could attach to this macro's "if". We
 * try to handle just the minimum we need here in a macro...the loop, the
 * static vars, and break points. The heavy lifting is handled in
 * SDL_ReportAssertion().
 *
 * \param condition the condition to assert.
 *
 * \since This macro is available since SDL 3.2.0.
 '/
'' C2T-TODO(function-like-macro) SDL_assert.h:410 -- '{' after the expression
'' #define SDL_enabled_assert(condition) \
''     do { \
''         while ( !(condition) ) { \
''             static struct SDL_AssertData sdl_assert_data = { false, 0, #condition, NULL, 0, NULL, NULL }; \
''             const SDL_AssertState sdl_assert_state = SDL_ReportAssertion(&sdl_assert_data, SDL_FUNCTION, SDL_ASSERT_FILE, SDL_LINE); \
''             if (sdl_assert_state == SDL_ASSERTION_RETRY) { \
''                 continue; /* go again. */ \
''             } else if (sdl_assert_state == SDL_ASSERTION_BREAK) { \
''                 SDL_AssertBreakpoint(); \
''             } \
''             break; /* not retrying. */ \
''         } \
''     } while (SDL_NULL_WHILE_LOOP_CONDITION)

#ifdef SDL_WIKI_DOCUMENTATION_SECTION

/'*
 * An assertion test that is normally performed only in debug builds.
 *
 * This macro is enabled when the SDL_ASSERT_LEVEL is >= 2, otherwise it is
 * disabled. This is meant to only do these tests in debug builds, so they can
 * tend to be more expensive, and they are meant to bring everything to a halt
 * when they fail, with the programmer there to assess the problem.
 *
 * In short: you can sprinkle these around liberally and assume they will
 * evaporate out of the build when building for end-users.
 *
 * When assertions are disabled, this wraps `condition` in a `sizeof`
 * operator, which means any function calls and side effects will not run, but
 * the compiler will not complain about any otherwise-unused variables that
 * are only referenced in the assertion.
 *
 * One can set the environment variable "SDL_ASSERT" to one of several strings
 * ("abort", "break", "retry", "ignore", "always_ignore") to force a default
 * behavior, which may be desirable for automation purposes. If your platform
 * requires GUI interfaces to happen on the main thread but you're debugging
 * an assertion in a background thread, it might be desirable to set this to
 * "break" so that your debugger takes control as soon as assert is triggered,
 * instead of risking a bad UI interaction (deadlock, etc) in the application.
 *
 * \param condition boolean value to test.
 *
 * \threadsafety It is safe to call this macro from any thread.
 *
 * \since This macro is available since SDL 3.2.0.
 '/
'' C2T-TODO(function-like-macro) SDL_assert.h:456 -- '{' after the expression
'' #define SDL_assert(condition) if (assertion_enabled && (condition)) { trigger_assertion; }

/'*
 * An assertion test that is performed even in release builds.
 *
 * This macro is enabled when the SDL_ASSERT_LEVEL is >= 1, otherwise it is
 * disabled. This is meant to be for tests that are cheap to make and
 * extremely unlikely to fail; generally it is frowned upon to have an
 * assertion failure in a release build, so these assertions generally need to
 * be of more than life-and-death importance if there's a chance they might
 * trigger. You should almost always consider handling these cases more
 * gracefully than an assert allows.
 *
 * When assertions are disabled, this wraps `condition` in a `sizeof`
 * operator, which means any function calls and side effects will not run, but
 * the compiler will not complain about any otherwise-unused variables that
 * are only referenced in the assertion.
 *
 * One can set the environment variable "SDL_ASSERT" to one of several strings
 * ("abort", "break", "retry", "ignore", "always_ignore") to force a default
 * behavior, which may be desirable for automation purposes. If your platform
 * requires GUI interfaces to happen on the main thread but you're debugging
 * an assertion in a background thread, it might be desirable to set this to
 * "break" so that your debugger takes control as soon as assert is triggered,
 * instead of risking a bad UI interaction (deadlock, etc) in the application.
 * *
 *
 * \param condition boolean value to test.
 *
 * \threadsafety It is safe to call this macro from any thread.
 *
 * \since This macro is available since SDL 3.2.0.
 '/
'' C2T-NOTE(unchecked) SDL_assert.h:489 -- 'SDL_disabled_assert' not declared here: a program using the macro declares it
#define SDL_assert_release(condition) SDL_disabled_assert((condition))

/'*
 * An assertion test that is performed only when built with paranoid settings.
 *
 * This macro is enabled when the SDL_ASSERT_LEVEL is >= 3, otherwise it is
 * disabled. This is a higher level than both release and debug, so these
 * tests are meant to be expensive and only run when specifically looking for
 * extremely unexpected failure cases in a special build.
 *
 * When assertions are disabled, this wraps `condition` in a `sizeof`
 * operator, which means any function calls and side effects will not run, but
 * the compiler will not complain about any otherwise-unused variables that
 * are only referenced in the assertion.
 *
 * One can set the environment variable "SDL_ASSERT" to one of several strings
 * ("abort", "break", "retry", "ignore", "always_ignore") to force a default
 * behavior, which may be desirable for automation purposes. If your platform
 * requires GUI interfaces to happen on the main thread but you're debugging
 * an assertion in a background thread, it might be desirable to set this to
 * "break" so that your debugger takes control as soon as assert is triggered,
 * instead of risking a bad UI interaction (deadlock, etc) in the application.
 *
 * \param condition boolean value to test.
 *
 * \threadsafety It is safe to call this macro from any thread.
 *
 * \since This macro is available since SDL 3.2.0.
 '/
'' C2T-NOTE(unchecked) SDL_assert.h:518 -- 'SDL_disabled_assert' not declared here: a program using the macro declares it
#define SDL_assert_paranoid(condition) SDL_disabled_assert((condition))

/' Enable various levels of assertions. '/
#elseif (SDL_ASSERT_LEVEL = 0)   /' assertions disabled '/
'' C2T-NOTE(unchecked) SDL_assert.h:522 -- 'SDL_disabled_assert' not declared here: a program using the macro declares it
#   define SDL_assert(condition) SDL_disabled_assert((condition))
'' C2T-NOTE(unchecked) SDL_assert.h:523 -- 'SDL_disabled_assert' not declared here: a program using the macro declares it
#   define SDL_assert_release(condition) SDL_disabled_assert((condition))
'' C2T-NOTE(unchecked) SDL_assert.h:524 -- 'SDL_disabled_assert' not declared here: a program using the macro declares it
#   define SDL_assert_paranoid(condition) SDL_disabled_assert((condition))
#elseif (SDL_ASSERT_LEVEL = 1)  /' release settings. '/
'' C2T-NOTE(unchecked) SDL_assert.h:526 -- 'SDL_disabled_assert' not declared here: a program using the macro declares it
#   define SDL_assert(condition) SDL_disabled_assert((condition))
'' C2T-NOTE(unchecked) SDL_assert.h:527 -- 'SDL_enabled_assert' not declared here: a program using the macro declares it
#   define SDL_assert_release(condition) SDL_enabled_assert((condition))
'' C2T-NOTE(unchecked) SDL_assert.h:528 -- 'SDL_disabled_assert' not declared here: a program using the macro declares it
#   define SDL_assert_paranoid(condition) SDL_disabled_assert((condition))
#elseif (SDL_ASSERT_LEVEL = 2)  /' debug settings. '/
'' C2T-NOTE(unchecked) SDL_assert.h:530 -- 'SDL_enabled_assert' not declared here: a program using the macro declares it
#   define SDL_assert(condition) SDL_enabled_assert((condition))
'' C2T-NOTE(unchecked) SDL_assert.h:531 -- 'SDL_enabled_assert' not declared here: a program using the macro declares it
#   define SDL_assert_release(condition) SDL_enabled_assert((condition))
'' C2T-NOTE(unchecked) SDL_assert.h:532 -- 'SDL_disabled_assert' not declared here: a program using the macro declares it
#   define SDL_assert_paranoid(condition) SDL_disabled_assert((condition))
#elseif (SDL_ASSERT_LEVEL = 3)  /' paranoid settings. '/
'' C2T-NOTE(unchecked) SDL_assert.h:534 -- 'SDL_enabled_assert' not declared here: a program using the macro declares it
#   define SDL_assert(condition) SDL_enabled_assert((condition))
'' C2T-NOTE(unchecked) SDL_assert.h:535 -- 'SDL_enabled_assert' not declared here: a program using the macro declares it
#   define SDL_assert_release(condition) SDL_enabled_assert((condition))
'' C2T-NOTE(unchecked) SDL_assert.h:536 -- 'SDL_enabled_assert' not declared here: a program using the macro declares it
#   define SDL_assert_paranoid(condition) SDL_enabled_assert((condition))
#else
