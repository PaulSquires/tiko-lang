#elseif ((defined(_DEBUG) orelse defined(DEBUG)) orelse (defined(__GNUC__) andalso ((defined(__OPTIMIZE__)) = 0)))
#define SDL_ASSERT_LEVEL 2
#else
#define SDL_ASSERT_LEVEL 1
