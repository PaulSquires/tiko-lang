/'*
 * Multiply two integers, checking for overflow.
 *
 * If `a * b` would overflow, return false.
 *
 * Otherwise store `a * b` via ret and return true.
 *
 * \param a the multiplicand.
 * \param b the multiplier.
 * \param ret on non-overflow output, stores the multiplication result, may
 *            not be NULL.
 * \returns false on overflow, true if result is multiplied without overflow.
 *
 * \threadsafety It is safe to call this function from any thread.
 *
 * \since This function is available since SDL 3.2.0.
 '/
#if defined(TIKO_OS_WINDOWS)
'' C2T-NOTE(inline) SDL_stdinc.h:6095 -- inline: links only if the library exports 'SDL_size_mul_check_overflow'
declare function SDL_size_mul_check_overflow( byval a as uinteger, byval b as uinteger, byval ret as uinteger ptr ) as boolean
#elseif defined(TIKO_OS_LINUX)
'' C2T-TODO(static-inline) SDL_stdinc.h:6095 -- static inline function 'SDL_size_mul_check_overflow': no symbol to link against; port the body by hand
'' SDL_FORCE_INLINE bool SDL_size_mul_check_overflow(size_t a, size_t b, size_t *ret)
'' {
''     if (a != 0 && b > SDL_SIZE_MAX / a) {
''         return false;
''     }
''     *ret = a * b;
''     return true;
'' }
#endif

