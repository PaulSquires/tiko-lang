'' C2T-NOTE(inline) SDL_stdinc.h:6109 -- inline: links only if the library exports 'SDL_size_mul_check_overflow_builtin'
declare function SDL_size_mul_check_overflow_builtin( byval a as uinteger, byval b as uinteger, byval ret as uinteger ptr ) as boolean
#elseif defined(TIKO_OS_LINUX)
'' C2T-TODO(static-inline) SDL_stdinc.h:6109 -- static inline function 'SDL_size_mul_check_overflow_builtin': no symbol to link against; port the body by hand
