/' force builds using Clang's static analysis tools to use literal C runtime
   here, since there are possibly tests that are ineffective otherwise. '/
#if (defined(__clang_analyzer__) andalso ((defined(SDL_DISABLE_ANALYZE_MACROS)) = 0))

/' The analyzer knows about strlcpy even when the system doesn't provide it '/
#if (((defined(HAVE_STRLCPY)) = 0) andalso ((defined(strlcpy)) = 0))
declare function strlcpy( byval dst as zstring ptr, byval src as const zstring ptr, byval size as uinteger ) as uinteger
#endif

/' The analyzer knows about strlcat even when the system doesn't provide it '/
#if (((defined(HAVE_STRLCAT)) = 0) andalso ((defined(strlcat)) = 0))
declare function strlcat( byval dst as zstring ptr, byval src as const zstring ptr, byval size as uinteger ) as uinteger
#endif

#if (((defined(HAVE_WCSLCPY)) = 0) andalso ((defined(wcslcpy)) = 0))
declare function wcslcpy( byval dst as wstring ptr, byval src as const wstring ptr, byval size as uinteger ) as uinteger
#endif

#if (((defined(HAVE_WCSLCAT)) = 0) andalso ((defined(wcslcat)) = 0))
declare function wcslcat( byval dst as wstring ptr, byval src as const wstring ptr, byval size as uinteger ) as uinteger
#endif

#if (((defined(HAVE_STRTOK_R)) = 0) andalso ((defined(strtok_r)) = 0))
declare function strtok_r( byval str_ as zstring ptr, byval delim as const zstring ptr, byval saveptr as zstring ptr ptr ) as zstring ptr
#endif

#ifndef TIKO_OS_WINDOWS
/' strdup is not ANSI but POSIX, and its prototype might be hidden... '/
/' not for windows: might conflict with string.h where strdup may have
 * dllimport attribute: https://github.com/libsdl-org/SDL/issues/12948 '/
declare function strdup( byval str_ as const zstring ptr ) as zstring ptr
#endif

