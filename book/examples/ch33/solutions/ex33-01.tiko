'' Exercise 32-1: how many lines match in each file, as 'path: count'.
#import "../search"
#import "std/containers"

dim opts as search.Options
opts.pattern = "dog"
dim files as containers.Array( of ustring )
dim problems as containers.Array( of ustring )
search.FindFiles( "../sample", "", files, problems )
for each path in files
    dim hits as containers.Array( of search.Hit )
    if search.SearchFile( path, opts, hits ).IsOk( ) then
        print path; ":"; hits.Count( )
    end if
next
