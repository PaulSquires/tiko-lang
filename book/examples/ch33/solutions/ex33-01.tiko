'' Exercise 33-1: spending by category, largest first, over the
'' whole ledger.
#import "../ledger"
#import "../ui"
#import "std/containers"
#import "std/money"

ledger.OpenLedger( ":memory:" )
dim problems as containers.Array( of ustring )
ledger.ImportCsv( "../bank.csv", problems )

dim txns as ui.TxnArray
ledger.ListTxns( txns )
dim byCat as containers.OrderedMap( of ustring, money.Decimal )
for each t in txns
    if t.amount.IsNegative( ) then
        byCat[ t.category ] = byCat[ t.category ] + t.amount
    end if
next

'' Most negative first: a simple selection, the map is small.
dim cats as containers.Array( of ustring )
for each kv in byCat
    cats.Push( kv.key )
next
for i as int32 = 0 to cats.Count( ) - 2
    for j as int32 = i + 1 to cats.Count( ) - 1
        if byCat[ cats[ j ] ] < byCat[ cats[ i ] ] then
            swap cats[ i ], cats[ j ]
        end if
    next
next
for each c in cats
    print left( c & space( 12 ), 12 ); ui.MoneyCell( byCat[ c ], 12 )
next
ledger.CloseLedger( )
