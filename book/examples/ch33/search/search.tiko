'' ANCHOR: head
#module "search"
#import "std/fs"
#import "std/containers"
'' ANCHOR_END: head

'' ANCHOR: types
'' What one run of tsearch was asked to do.
public type Options
    as ustring pattern
    as containers.Array( of ustring ) roots
    as boolean ignoreCase
    as boolean lineNumbers
    as boolean filesOnly
    as ustring nameGlob             '' "" matches every file name
end type

'' One matching line.
public type Hit
    as int32 lineNo
    as ustring text
end type
'' ANCHOR_END: types

'' ANCHOR: display
'' A path as tsearch prints it: '/' between components everywhere.
'' Only Windows separates them with '\'; on Linux a '\' is part of
'' a file name, and stays as it is.
function DisplayPath( byref path as ustring ) as ustring
    dim as ustring p = path
    #ifdef __FB_WIN32__
    for i as int32 = 0 to len( p ) - 1
        if p[ i ] = asc( "\" ) then p[ i ] = asc( "/" )
    next
    #endif
    return p
end function
'' ANCHOR_END: display

'' ANCHOR: parse
'' Read the arguments into opts. Returns "" when they make sense, and
'' otherwise what is wrong with them, for the usage message. An empty
'' argument is refused: it is almost always a variable left unset.
public function ParseArgs _
    ( byref args as containers.Array( of ustring ), _
      byref opts as Options ) as ustring
    dim as int32 i = 0
    do while i < args.Count( )
        var a = args[ i ]
        if len( a ) = 0 then return "an argument is empty"
        select case a
        case "-i" : opts.ignoreCase = true
        case "-n" : opts.lineNumbers = true
        case "-l" : opts.filesOnly = true
        case "-g"
            i += 1
            if i >= args.Count( ) then return "-g needs a pattern"
            if len( args[ i ] ) = 0 then return "-g needs a pattern"
            opts.nameGlob = args[ i ]
        case else
            if left( a, 1 ) = "-" then return "unknown option " & a
            if len( opts.pattern ) = 0 then
                opts.pattern = a
            else
                opts.roots.Push( a )
            end if
        end select
        i += 1
    loop
    if len( opts.pattern ) = 0 then return "no pattern given"
    if opts.roots.Count( ) = 0 then opts.roots.Push( "." )
    return ""
end function
'' ANCHOR_END: parse

'' ANCHOR: match
'' Does line contain pattern? lcase lowers every letter that has a
'' single lower-case form, not only A to Z.
public function LineMatches( byref line_ as ustring, _
                             byref pattern as ustring, _
                             byval ignoreCase as boolean ) as boolean
    if ignoreCase then
        return instr( lcase( line_ ), lcase( pattern ) ) > 0
    end if
    return instr( line_, pattern ) > 0
end function
'' ANCHOR_END: match

'' ANCHOR: find
'' Does a file name match the -g glob? The POSIX grammar, on every
'' platform, so the answer is the same on Windows and Linux.
function NameMatches( byref nm as ustring, _
                      byref nameGlob as ustring ) as boolean
    if len( nameGlob ) = 0 then return true
    return fs.MatchPattern( nm, nameGlob, fs.FB_PATH_POSIX )
end function

'' Appends to files every file under root whose name matches nameGlob,
'' as display paths in sorted order, so the output depends neither on
'' the order the file system returns them nor on the platform. Returns
'' how many it appended. What could not be read goes into problems,
'' one message each, naming the path that failed.
public function FindFiles _
    ( byref root as ustring, byref nameGlob as ustring, _
      byref files as containers.Array( of ustring ), _
      byref problems as containers.Array( of ustring ) ) as int32
    dim found as containers.Array( of ustring )
    if fs.IsFile( root ) then
        found.Push( DisplayPath( root ) )
    else
        for each r in fs.WalkDir( root )
            if r.IsOk( ) = false then
                var e = r.Failure( )
                problems.Push( DisplayPath( e.Path( ) ) & ": " & _
                               e.Message( ) )
            elseif r.Value( ).IsFile( ) then
                if NameMatches( r.Value( ).Name( ), nameGlob ) then
                    found.Push( DisplayPath( r.Value( ).Path( ) ) )
                end if
            end if
        next
    end if
    containers.Sort( found )
    for each f in found
        files.Push( f )
    next
    return found.Count( )
end function
'' ANCHOR_END: find

'' ANCHOR: searchfile
'' The matching lines of one file. A file that cannot be read is an
'' FsError in the Result, for the caller to report.
public function SearchFile( byref path as ustring, _
                            byref opts as Options, _
                            byref hits as containers.Array( of Hit ) ) _
                            as fs.FsResultLong
    dim lines as containers.Array( of ustring )
    var got = fs.ReadAllLines( path, lines )
    if got.IsOk( ) = false then return got
    for i as int32 = 0 to lines.Count( ) - 1
        if LineMatches( lines[ i ], opts.pattern, opts.ignoreCase ) then
            dim h as Hit
            h.lineNo = i + 1
            h.text = lines[ i ]
            hits.Push( h )
        end if
    next
    return got
end function
'' ANCHOR_END: searchfile
