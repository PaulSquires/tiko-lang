len            = 19
left( s, 3 )   = [The]
right( s, 3 )  = [fox]
mid( s, 5, 5 ) = [quick]
mid( s, 11 )   = [brown fox]
instr( s, "brown" )  = 11
instr( 5, s, "o" )   = 13
instrrev( s, "o" )   = 18
instr( s, "zebra" )  = 0   <- not found
ucase = [THE QUICK BROWN FOX]
lcase = [the quick brown fox]
trim  = [spaces]
ltrim = [spaces   ]
rtrim = [   spaces]
trim any = [core]
space( 3 )        = [   ]
string( 5, "-" )   = [-----]
chr( 65 )         = [A]
asc( "A" )        =65
