'' slices.tiko -- naming part of a string without copying it.

dim as ustring s = "hello, world"

dim as uslice word = s[7 to 11]    '' units 7 to 11, both included
print "word           = ["; word; "]"
print "len( word )    = "; str( len( word ) )
print "word[0]        = "; str( word[0] )   '' a code unit
print "word[1 to 3]   = ["; word[1 to 3]; "]"
print "s[0 to 4]      = ["; s[0 to 4]; "]"
print "mid( s, 1, 5 ) = ["; mid( s, 1, 5 ); "]"

'' A slice compares, joins and prints like the text it names.
print "word = ""world"" is "; cbool( word = "world" )
print "<" & word & ">"

'' Assigning it to a ustring makes an owned copy.
dim as ustring copy = word
copy &= "!"
print "copy = ["; copy; "]  s = ["; s; "]"

'' A slice of a mutable string writes straight into it.
word[0] = asc( "W" )
print "s is now ["; s; "]"

'' An empty slice: hi is one less than lo.
print "s[3 to 2] has "; str( len( s[3 to 2] ) ); " units"
