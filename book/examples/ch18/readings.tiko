'' A small program to stop inside: build it with -g.
type Reading
    sensor as ustring
    value as float64
end type

function Total( rs( ) as Reading ) as float64
    dim sum as float64
    for i as int32 = lbound( rs ) to ubound( rs )
        sum += rs( i ).value
    next
    return sum
end function

dim rs( 1 to 3 ) as Reading
rs( 1 ).sensor = "north" : rs( 1 ).value = 3.5
rs( 2 ).sensor = "south" : rs( 2 ).value = 4.0
rs( 3 ).sensor = "east"  : rs( 3 ).value = 5.5
dim label as ustring = "total"
print label; Total( rs( ) )
