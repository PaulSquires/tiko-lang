'' The stacks module's tests: a program of their own.
#import "./stacks"
#include once "fbcunit.bi"

SUITE( lifo )
    TEST( starts_empty )
        dim s as stacks.Stack
        CU_ASSERT_EQUAL( s.Count( ), 0 )
    END_TEST

    TEST( pops_in_reverse )
        dim s as stacks.Stack
        s.Push( 1 ) : s.Push( 2 ) : s.Push( 3 )
        CU_ASSERT_EQUAL( s.Pop( ), 3 )
        CU_ASSERT_EQUAL( s.Pop( ), 2 )
        CU_ASSERT_EQUAL( s.Count( ), 1 )
    END_TEST
END_SUITE

SUITE( peeking )
    TEST( leaves_the_top )
        dim s as stacks.Stack
        s.Push( 7 )
        CU_ASSERT_EQUAL( s.Peek( ), 7 )
        CU_ASSERT_EQUAL( s.Count( ), 1 )
    END_TEST
END_SUITE

end iif( fbcu.run_tests( ), 0, 1 )
