'' Exercise 18-1: tests for Clamp, including both edges.
#include once "fbcunit.bi"

function Clamp( byval v as int32, byval lo as int32, _
                byval hi as int32 ) as int32
    if v < lo then return lo
    if v > hi then return hi
    return v
end function

SUITE( clamping )
    TEST( inside_is_unchanged )
        CU_ASSERT_EQUAL( Clamp( 5, 0, 10 ), 5 )
    END_TEST

    TEST( edges_are_inside )
        CU_ASSERT_EQUAL( Clamp( 0, 0, 10 ), 0 )
        CU_ASSERT_EQUAL( Clamp( 10, 0, 10 ), 10 )
    END_TEST

    TEST( outside_is_pulled_in )
        CU_ASSERT_EQUAL( Clamp( -3, 0, 10 ), 0 )
        CU_ASSERT_EQUAL( Clamp( 99, 0, 10 ), 10 )
    END_TEST
END_SUITE

end iif( fbcu.run_tests( ), 0, 1 )
