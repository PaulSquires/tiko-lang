'' Exercise 20-1: count the words at least minLen long, with ForEach
'' and a closure that captures its count byref and its limit byval.
#import "std/containers"

dim words as containers.Array( of ustring ) = _
    { "a", "closure", "is", "a", "value", "with", "captures" }
dim as int32 minLen = 4, longWords = 0
containers.ForEach( words, _
    sub[ byval minLen, byref longWords ]( byref w as ustring )
        if len( w ) >= minLen then longWords += 1
    end sub )
print longWords; " words of"; minLen; " letters or more"
