'' The loop reads an array's bounds once, before the first pass.
dim queue( any ) as int32
redim queue( 0 to 2 )
queue( 0 ) = 1 : queue( 1 ) = 2 : queue( 2 ) = 3

for each q in queue
    print q;
    if q = 2 then
        redim preserve queue( 0 to 3 )   '' a fourth element...
        queue( 3 ) = 4
    end if
next
print
print "elements now:"; ubound( queue ) + 1   '' ...never visited
