'' widths.tiko -- each type states its size in bytes.
print "int8    " & sizeof( int8 )   & "   uint8   " & sizeof( uint8 )
print "int16   " & sizeof( int16 )  & "   uint16  " & sizeof( uint16 )
print "int32   " & sizeof( int32 )  & "   uint32  " & sizeof( uint32 )
print "int64   " & sizeof( int64 )  & "   uint64  " & sizeof( uint64 )
print "float32 " & sizeof( float32 ) & "   float64 " & sizeof( float64 )
print
print "integer " & sizeof( integer ) & "   -- pointer-sized"
print "long    " & sizeof( long ) & "   -- 32 bits, despite the name"
