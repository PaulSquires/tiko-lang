
#import "std/memory"
type Shape extends object
    declare virtual destructor( )
end type
destructor Shape( )
    print "shape gone"
end destructor

type Circle extends Shape
    r as float64
    declare destructor( )
end type
destructor Circle( )
    print "circle gone"
end destructor

scope
    var c = memory.MakeShared( of Circle )( )
    var s = memory.SpCast( of Circle, Shape )( c )   '' derived to base
    c.Reset( )
    print "the Shape handle is the last owner"
end scope
