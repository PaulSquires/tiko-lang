'' Total sales per region, largest first, from an in-memory table.
#import "db/sqlite"

dim db as sqlite.Database
db.OpenMemory( )
db.Execute( "create table sale( region text, amount integer )" )

dim as ustring regions( ... ) = { "north", "south", "north", "east", _
                                  "south", "north" }
dim as int64 amounts( ... ) = { 120, 80, 45, 200, 30, 15 }
for i as int32 = 0 to ubound( regions )
    db.Execute( "insert into sale values( ?, ? )", _
                sqlite.Args( regions( i ), amounts( i ) ) )
next

var rows = db.Query( "select region, sum( amount ) as total, " & _
                     "count(*) as n from sale group by region " & _
                     "order by total desc" )
for each r in rows.Value( )
    print left( r[ "region" ].AsText( ) & space( 8 ), 8 ); _
          r[ "total" ].AsInt64( ); " in"; r[ "n" ].AsInt64( ); " sales"
next
