'' SQLite's own C interface, from the toolchain's vendor package.
#import "vendor/sqlite3"

'' SQLite reports failure as a result code; this turns one into a stop.
sub Check( byval rc as int32, byval db as sqlite3 ptr )
    if rc <> SQLITE_OK andalso rc <> SQLITE_DONE then
        print "SQLite error"; rc; ": "; *sqlite3_errmsg( db )
        end 1
    end if
end sub

dim db as sqlite3 ptr
Check( sqlite3_open( ":memory:", @db ), db )
Check( sqlite3_exec( db, "create table contact( " & _
    "id integer primary key, name text not null, email text )", _
    nullptr, nullptr, nullptr ), db )

'' Values go in as parameters, never pasted into the SQL text.
dim as string names( ... ) = { "Grace", "Ada", "Edsger" }
dim as string emails( ... ) = { "grace@example.org", _
                                "ada@example.org", "" }
dim ins as sqlite3_stmt ptr
Check( sqlite3_prepare_v2( db, _
    "insert into contact( name, email ) values( ?, ? )", _
    -1, @ins, nullptr ), db )
for i as int32 = 0 to ubound( names )
    sqlite3_bind_text( ins, 1, names( i ), -1, SQLITE_TRANSIENT )
    sqlite3_bind_text( ins, 2, emails( i ), -1, SQLITE_TRANSIENT )
    Check( sqlite3_step( ins ), db )
    sqlite3_reset( ins )
next
sqlite3_finalize( ins )
print "last id:"; sqlite3_last_insert_rowid( db )

'' A query is stepped through one row at a time.
dim sel as sqlite3_stmt ptr
Check( sqlite3_prepare_v2( db, "select id, name, email from " & _
    "contact where email <> '' order by name", -1, @sel, nullptr ), db )
do while sqlite3_step( sel ) = SQLITE_ROW
    print sqlite3_column_int64( sel, 0 ); "  "; _
          *cast( zstring ptr, sqlite3_column_text( sel, 1 ) ); "  "; _
          *cast( zstring ptr, sqlite3_column_text( sel, 2 ) )
loop
sqlite3_finalize( sel )

'' A transaction: everything in it happens, or nothing does.
Check( sqlite3_exec( db, "begin", nullptr, nullptr, nullptr ), db )
Check( sqlite3_exec( db, "delete from contact", _
    nullptr, nullptr, nullptr ), db )
Check( sqlite3_exec( db, "rollback", nullptr, nullptr, nullptr ), db )
Check( sqlite3_prepare_v2( db, "select count(*) from contact", _
    -1, @sel, nullptr ), db )
sqlite3_step( sel )
print "after the rollback:"; sqlite3_column_int( sel, 0 ); " contacts"
sqlite3_finalize( sel )

'' A failure is a result code, and the connection keeps the message.
dim errMsg as zstring ptr
if sqlite3_exec( db, "insert into contact( email ) values( 'x' )", _
        nullptr, nullptr, @errMsg ) <> SQLITE_OK then
    print "refused: "; *errMsg
    sqlite3_free( errMsg )
end if
sqlite3_close( db )
