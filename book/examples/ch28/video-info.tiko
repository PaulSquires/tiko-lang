'' What an MPEG-1 file holds, every frame and sample of it decoded:
'' pl_mpeg, a vendor package.
#import "vendor/pl_mpeg"

'' Open by name: pl_mpeg opens and reads the file itself.
dim plm as plm_t ptr = plm_create_with_filename( "clip.mpg" )
if plm = nullptr then print "cannot open clip.mpg" : end 1
if plm_probe( plm, 1024 * 1024 ) = 0 then
    print "not MPEG-1 video and MP2 audio" : end 1
end if
print plm_get_width( plm ) & "x" & plm_get_height( plm ) & ", " & _
      plm_get_framerate( plm ) & " fps, audio " & _
      plm_get_samplerate( plm ) & " Hz, " & _
      plm_get_duration( plm ) & " s"

'' Video, a frame a call. Audio is off meanwhile, so the demuxer does
'' not keep its packets for a decoder nobody calls.
plm_set_audio_enabled( plm, 0 )
dim frames as integer
dim frame as plm_frame_t ptr = plm_decode_video( plm )
while frame
    '' frame->y, ->cb, ->cr: its planes, pl_mpeg's until the next call
    frames += 1
    frame = plm_decode_video( plm )
wend
print frames & " frames"

'' Audio, from the start: blocks of 1152 stereo float32 sample frames.
plm_rewind( plm )
plm_set_audio_enabled( plm, 1 )
plm_set_video_enabled( plm, 0 )
dim sampleFrames as ulongint
dim samples as plm_samples_t ptr = plm_decode_audio( plm )
while samples
    sampleFrames += samples->count
    samples = plm_decode_audio( plm )
wend
print sampleFrames & " audio sample frames"
plm_destroy( plm )
