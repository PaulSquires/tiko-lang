'' foreachudt.tiko -- for each, by value, over an array of records.
''
'' Chapter 8 taught this form for numbers. It is equally valid for a
'' type you define, and prints 1 2 3.

type Point
    x as int32
    y as int32
end type

dim as Point pts( 1 to 3 )
for i as int32 = 1 to 3 : pts( i ).x = i : next

for each p as Point in pts
    print p.x;
next
print
