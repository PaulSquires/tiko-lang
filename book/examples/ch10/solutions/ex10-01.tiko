'' ex10-01.tiko -- a growable buffer that doubles when it fills.
''
'' Growing by one element per append copies the whole buffer every
'' time. Doubling copies it only when it fills, so appending n items
'' costs O(n) in total instead of O(n^2).

type IntBuffer
    items    as int32 ptr
    count    as int32
    capacity as int32
end type

sub AddItem( byref b as IntBuffer, byval v as int32 )
    if b.count = b.capacity then
        dim as int32 newCap = iif( b.capacity = 0, 4, b.capacity * 2 )
        dim as int32 ptr grown = reallocate( b.items, _
                                             newCap * sizeof( int32 ) )
        if grown = 0 then
            print "out of memory"
            end 1
        end if
        b.items = grown
        b.capacity = newCap
        print "  grew to"; newCap
    end if
    b.items[b.count] = v
    b.count += 1
end sub

sub Release( byref b as IntBuffer )
    deallocate( b.items )
    b.items = 0
    b.count = 0
    b.capacity = 0
end sub

dim as IntBuffer b
for i as int32 = 1 to 20
    AddItem( b, i * 3 )
next

print "count"; b.count; ", capacity"; b.capacity
print "first"; b.items[0]; ", last"; b.items[b.count - 1]
Release( b )
print "released: items is null: "; cbool( b.items = 0 )
