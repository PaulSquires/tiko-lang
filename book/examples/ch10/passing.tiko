'' passing.tiko -- a type you define is passed by reference unless
'' you say otherwise. Chapter 7 said so; this is the proof.

type Point
    x as int32
    y as int32
end type

sub NoKeyword( p as Point )         '' the default
    p.x = 99
end sub

sub Copied( byval p as Point )      '' a private copy
    p.x = 77
end sub

function Shifted( byval p as Point, byval dx as int32 ) as Point
    p.x += dx                       '' changes the copy ...
    return p                        '' ... and hands it back
end function

dim as Point a = ( 1, 2 )

NoKeyword( a )
print "after NoKeyword:"; a.x; "   <- the caller's Point changed"

a.x = 1
Copied( a )
print "after Copied:   "; a.x

dim as Point b = Shifted( a, 10 )
print "Shifted gave";  b.x; ", and a is still"; a.x
