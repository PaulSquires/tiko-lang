function Sieve( byval n as int32 ) as int32
    dim flags( 0 to n ) as uint8
    dim as int32 count = 0
    for i as int32 = 2 to n
        if flags( i ) = 0 then
            count += 1
            for j as int64 = i * i to n step i
                flags( j ) = 1
            next
        end if
    next
    return count
end function
dim as float64 t0 = timer
dim as int32 c = 0
for k as int32 = 1 to 20
    c = Sieve( 10000000 )
next
print c; timer - t0
