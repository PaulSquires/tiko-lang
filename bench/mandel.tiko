function Mandel( byval w as int32, byval h as int32, byval maxit as int32 ) as int64
    dim as int64 total = 0
    for y as int32 = 0 to h - 1
        for x as int32 = 0 to w - 1
            dim as float64 cr = x * 3.0 / w - 2.0, ci = y * 2.0 / h - 1.0
            dim as float64 zr = 0, zi = 0
            dim as int32 i = 0
            do while i < maxit andalso zr * zr + zi * zi <= 4.0
                dim as float64 t = zr * zr - zi * zi + cr
                zi = (zr + zr) * zi + ci
                zr = t
                i += 1
            loop
            total += i
        next
    next
    return total
end function
dim as float64 t0 = timer
dim as int64 r = Mandel( 2000, 1500, 500 )
print r; timer - t0
