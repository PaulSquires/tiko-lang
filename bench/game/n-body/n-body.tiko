'' n-body: integrate the orbits of the Jovian planets.

#import "std/strings"

const PI = 3.141592653589793
const SOLAR_MASS = 4 * PI * PI
const DAYS_PER_YEAR = 365.24
const NBODIES = 5

type Body
    as float64 x, y, z, vx, vy, vz, mass
end type

dim shared bodies( 0 to NBODIES - 1 ) as Body = { _
    ( 0, 0, 0, 0, 0, 0, SOLAR_MASS ), _
    ( 4.84143144246472090e+00, -1.16032004402742839e+00, -1.03622044471123109e-01, _
      1.66007664274403694e-03 * DAYS_PER_YEAR, 7.69901118419740425e-03 * DAYS_PER_YEAR, _
      -6.90460016972063023e-05 * DAYS_PER_YEAR, 9.54791938424326609e-04 * SOLAR_MASS ), _
    ( 8.34336671824457987e+00, 4.12479856412430479e+00, -4.03523417114321381e-01, _
      -2.76742510726862411e-03 * DAYS_PER_YEAR, 4.99852801234917238e-03 * DAYS_PER_YEAR, _
      2.30417297573763929e-05 * DAYS_PER_YEAR, 2.85885980666130812e-04 * SOLAR_MASS ), _
    ( 1.28943695621391310e+01, -1.51111514016986312e+01, -2.23307578892655734e-01, _
      2.96460137564761618e-03 * DAYS_PER_YEAR, 2.37847173959480950e-03 * DAYS_PER_YEAR, _
      -2.96589568540237556e-05 * DAYS_PER_YEAR, 4.36624404335156298e-05 * SOLAR_MASS ), _
    ( 1.53796971148509165e+01, -2.59193146099879641e+01, 1.79258772950371181e-01, _
      2.68067772490389322e-03 * DAYS_PER_YEAR, 1.62824170038242295e-03 * DAYS_PER_YEAR, _
      -9.51592254519715870e-05 * DAYS_PER_YEAR, 5.15138902046611451e-05 * SOLAR_MASS ) _
}

sub Advance( byval dt as float64 )
    for i as int32 = 0 to NBODIES - 1
        dim byref as Body b = bodies( i )
        for j as int32 = i + 1 to NBODIES - 1
            dim byref as Body c = bodies( j )
            dim as float64 dx = b.x - c.x, dy = b.y - c.y, dz = b.z - c.z
            dim as float64 d2 = dx * dx + dy * dy + dz * dz
            dim as float64 mag = dt / ( d2 * sqr( d2 ) )
            dim as float64 bm = b.mass * mag, cm = c.mass * mag
            b.vx -= dx * cm
            b.vy -= dy * cm
            b.vz -= dz * cm
            c.vx += dx * bm
            c.vy += dy * bm
            c.vz += dz * bm
        next
    next
    for i as int32 = 0 to NBODIES - 1
        dim byref as Body b = bodies( i )
        b.x += dt * b.vx
        b.y += dt * b.vy
        b.z += dt * b.vz
    next
end sub

function Energy( ) as float64
    dim as float64 e = 0.0
    for i as int32 = 0 to NBODIES - 1
        dim byref as Body b = bodies( i )
        e += 0.5 * b.mass * ( b.vx * b.vx + b.vy * b.vy + b.vz * b.vz )
        for j as int32 = i + 1 to NBODIES - 1
            dim byref as Body c = bodies( j )
            dim as float64 dx = b.x - c.x, dy = b.y - c.y, dz = b.z - c.z
            e -= ( b.mass * c.mass ) / sqr( dx * dx + dy * dy + dz * dz )
        next
    next
    return e
end function

sub OffsetMomentum( )
    dim as float64 px = 0.0, py = 0.0, pz = 0.0
    for i as int32 = 0 to NBODIES - 1
        px += bodies( i ).vx * bodies( i ).mass
        py += bodies( i ).vy * bodies( i ).mass
        pz += bodies( i ).vz * bodies( i ).mass
    next
    bodies( 0 ).vx = -px / SOLAR_MASS
    bodies( 0 ).vy = -py / SOLAR_MASS
    bodies( 0 ).vz = -pz / SOLAR_MASS
end sub

dim as int32 n = iif( len( command( 1 ) ) > 0, valint( command( 1 ) ), 1000 )
OffsetMomentum( )
print strings.Format( !"{:.9f}\n", Energy( ) );
for i as int32 = 1 to n
    Advance( 0.01 )
next
print strings.Format( !"{:.9f}\n", Energy( ) );
