/* 1 when PTHREAD_MUTEX_INITIALIZER is all zero bytes, so a zero-filled 'dim shared' mutex is
   a valid unlocked one (glibc); 0 when it carries a signature word (Darwin), and such a mutex
   needs pthread_mutex_init or the initializer's bytes. */
static int posixgen_mutex_initializer_is_zero( void )
{
    static const pthread_mutex_t m = PTHREAD_MUTEX_INITIALIZER;
    for( size_t i = 0; i < sizeof m; i++ )
        if( ( (const unsigned char *)&m )[i] != 0 ) return 0;
    return 1;
}

