# tiko-lang.net web root. Published by build/publish-site.sh from build/site/.htaccess.
# Every page and file here is UTF-8. Without a charset, browsers read ai-cheatsheet.md and
# llms.txt (text/plain) as windows-1252; the server ignores AddCharset, so the default is set.
AddDefaultCharset UTF-8

# Every visit fetches the current site: browsers and the host's CDN must revalidate each file
# (a 304 when it has not changed) instead of serving a copy cached for up to a week.
<IfModule mod_headers.c>
Header set Cache-Control "no-cache"
Header unset Expires
</IfModule>
